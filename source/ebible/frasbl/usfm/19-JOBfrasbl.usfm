\p
\v 3 \w Alors|strong="H3068"\w* \w Job|strong="H3068"\w* \w répondit|strong="H6030"\w* \w au|strong="H3068"\w* \w SEIGNEUR|strong="H3068"\w* :   
\q1
\v 4 « \w Voici|strong="H2005"\w*, \w je|strong="H7725"\w* \w suis|strong="H7725"\w* bien \w peu|strong="H7043"\w* \w de|strong="H3027"\w* \w chose|strong="H7043"\w*. \w Que|strong="H3027"\w* \w te|strong="H3027"\w* répondrais-je ?  
\q2 \w Je|strong="H3068"\w* \w mets|strong="H7760"\w* \w ma|strong="H7725"\w* \w main|strong="H3027"\w* \w sur|strong="H3027"\w* \w ma|strong="H7725"\w* \w bouche|strong="H6310"\w*.   
