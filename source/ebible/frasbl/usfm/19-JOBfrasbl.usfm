\q1
\v 13 Cache-les \w tous|strong="H3162"\w* \w ensemble|strong="H3162"\w* \w dans|strong="H6440"\w* \w la|strong="H6440"\w* \w poussière|strong="H6083"\w*.  
\q2 \w Enferme|strong="H2280"\w* \w leurs|strong="H6440"\w* \w visages|strong="H6440"\w* \w dans|strong="H6440"\w* \w le|strong="H6440"\w* \w lieu|strong="H6440"\w* \w caché|strong="H2934"\w*.   
\q1
\v 14 \w Alors|strong="H1571"\w* \w je|strong="H3588"\w* reconnaîtrai devant \w toi|strong="H3588"\w*  
\q2 \w que|strong="H3588"\w* \w ta|strong="H3588"\w* propre \w main|strong="H3225"\w* \w droite|strong="H3225"\w* \w peut|strong="H1571"\w* \w te|strong="H3588"\w* \w sauver|strong="H3467"\w*.   
\b  
\q1
\v 15 « Regarde \w donc|strong="H2009"\w* \w le|strong="H6213"\w* béhémoth, \w que|strong="H4994"\w* j'\w ai|strong="H6213"\w* \w fait|strong="H6213"\w* tout \w comme|strong="H6213"\w* \w toi|strong="H6213"\w*.  
\q2 \w Il|strong="H2009"\w* mange \w de|strong="H6213"\w* l'\w herbe|strong="H2682"\w* \w comme|strong="H6213"\w* \w le|strong="H6213"\w* \w bœuf|strong="H1241"\w*.   
\q1
\v 16 Regarde \w donc|strong="H2009"\w*, sa \w force|strong="H3581"\w* \w est|strong="H3581"\w* dans ses \w reins|strong="H4975"\w*.  
\q2 Sa \w vigueur|strong="H3581"\w* \w est|strong="H3581"\w* dans les \w muscles|strong="H8306"\w* \w de|strong="H3581"\w* son ventre.   
\q1
\v 17 Il dresse \w sa|strong="H2654"\w* \w queue|strong="H2180"\w* \w comme|strong="H3644"\w* un cèdre.  
\q2 Les \w nerfs|strong="H1517"\w* \w de|strong="H2654"\w* ses \w cuisses|strong="H6344"\w* \w sont|strong="H6344"\w* \w entrelacés|strong="H8276"\w*.   
\q1
\v 18 Ses \w os|strong="H6106"\w* \w sont|strong="H6106"\w* comme \w des|strong="H6106"\w* tubes \w de|strong="H6106"\w* bronze.  
\q2 Ses \w membres|strong="H6106"\w* \w sont|strong="H6106"\w* comme \w des|strong="H6106"\w* \w barres|strong="H4300"\w* \w de|strong="H6106"\w* \w fer|strong="H1270"\w*.   
\b  
\q1
\v 19 \w Il|strong="H1931"\w* \w est|strong="H1931"\w* \w la|strong="H6213"\w* \w première|strong="H7225"\w* \w des|strong="H6213"\w* \w œuvres|strong="H1870"\w* \w de|strong="H6213"\w* \w Dieu|strong="H6213"\w*.  
\q2 \w Celui|strong="H1931"\w* \w qui|strong="H1931"\w* l'\w a|strong="H3068"\w* \w fait|strong="H6213"\w* l'\w a|strong="H3068"\w* \w pourvu|strong="H5066"\w* \w de|strong="H6213"\w* \w son|strong="H6213"\w* \w épée|strong="H2719"\w*.   
\q1
\v 20 Assurément, \w les|strong="H5375"\w* \w montagnes|strong="H2022"\w* produisent \w sa|strong="H5375"\w* nourriture,  
\q2 \w là|strong="H5375"\w* \w où|strong="H8033"\w* s'ébattent \w tous|strong="H3605"\w* \w les|strong="H5375"\w* \w animaux|strong="H2416"\w* \w des|strong="H2416"\w* \w champs|strong="H7704"\w*.   
\q1
\v 21 Il se \w couche|strong="H7901"\w* \w sous|strong="H8478"\w* \w les|strong="H8478"\w* \w lotus|strong="H6628"\w*,  
\q2 \w dans|strong="H7901"\w* \w le|strong="H8478"\w* \w secret|strong="H5643"\w* \w des|strong="H8478"\w* \w roseaux|strong="H7070"\w* \w et|strong="H7901"\w* \w des|strong="H8478"\w* \w marécages|strong="H1207"\w*.   
\q1
\v 22 \w Les|strong="H5437"\w* \w lotus|strong="H6628"\w* \w le|strong="H5437"\w* \w couvrent|strong="H5526"\w* \w de|strong="H5158"\w* leur \w ombre|strong="H6752"\w*.  
\q2 \w Les|strong="H5437"\w* \w saules|strong="H6155"\w* \w du|strong="H6155"\w* \w torrent|strong="H5158"\w* l'\w environnent|strong="H5437"\w*.   
\q1
\v 23 \w Voici|strong="H2005"\w*, \w si|strong="H3588"\w* \w un|strong="H3588"\w* \w fleuve|strong="H5104"\w* déborde, \w il|strong="H3588"\w* \w ne|strong="H3808"\w* tremble \w pas|strong="H3808"\w*.  
\q2 \w Il|strong="H3588"\w* \w reste|strong="H3808"\w* confiant, \w même|strong="H3588"\w* \w si|strong="H3588"\w* \w le|strong="H6310"\w* \w Jourdain|strong="H3383"\w* \w se|strong="H3588"\w* gonfle jusqu'\w à|strong="H3588"\w* \w sa|strong="H6310"\w* \w gueule|strong="H6310"\w*.   
\q1
\v 24 \w Le|strong="H3947"\w* capturera-t-on pendant qu'\w il|strong="H3947"\w* \w est|strong="H5869"\w* \w sur|strong="H5869"\w* \w ses|strong="H3947"\w* gardes,  
\q2 \w ou|strong="H5869"\w* \w lui|strong="H5869"\w* percera-t-on \w le|strong="H3947"\w* nez \w avec|strong="H3947"\w* \w un|strong="H3947"\w* \w piège|strong="H4170"\w* ?   
\b  
\c 41  
\b  
\q1
\v 1 « Peux-tu tirer \w le|strong="H2904"\w* Léviathan\f + \fr 41.1 \ft Le Léviathan est le nom d'un crocodile ou d'une créature similaire.\f* \w avec|strong="H1571"\w* un hameçon,  
\q2 ou lui maintenir \w la|strong="H1571"\w* langue \w avec|strong="H1571"\w* \w une|strong="H1571"\w* corde ?   
\q1
\v 2 Peux-tu \w lui|strong="H6440"\w* \w passer|strong="H3808"\w* \w une|strong="H3808"\w* corde \w dans|strong="H6440"\w* \w le|strong="H6440"\w* \w nez|strong="H6440"\w*,  
\q2 \w ou|strong="H3588"\w* \w lui|strong="H6440"\w* percer \w la|strong="H6440"\w* mâchoire \w avec|strong="H6440"\w* \w un|strong="H6440"\w* crochet ?   
\q1
\v 3 T'adressera-t-il \w de|strong="H3605"\w* nombreuses supplications,  
\q2 \w ou|strong="H3605"\w* \w te|strong="H4310"\w* parlera-t-il \w avec|strong="H7999"\w* douceur ?   
\q1
\v 4 Conclura-t-il \w une|strong="H3808"\w* \w alliance|strong="H1697"\w* \w avec|strong="H1697"\w* \w toi|strong="H3808"\w*,  
\q2 \w pour|strong="H1697"\w* \w que|strong="H1697"\w* \w tu|strong="H2790"\w* \w le|strong="H2790"\w* prennes \w comme|strong="H1697"\w* serviteur \w à|strong="H1697"\w* toujours ?   
\q1
\v 5 Joueras-tu \w avec|strong="H6440"\w* \w lui|strong="H6440"\w* \w comme|strong="H3830"\w* \w avec|strong="H6440"\w* \w un|strong="H6440"\w* oiseau ?  
\q2 \w Ou|strong="H6440"\w* \w l|strong="H6440"\w*'attacheras-tu \w pour|strong="H6440"\w* \w tes|strong="H6440"\w* \w jeunes|strong="H6440"\w* filles ?   
\q1
\v 6 \w Les|strong="H6440"\w* marchands feront-ils \w de|strong="H6440"\w* \w lui|strong="H6440"\w* \w un|strong="H6440"\w* \w objet|strong="H6440"\w* \w d|strong="H6440"\w*'échange ?  
\q2 \w Le|strong="H6440"\w* partageront-ils entre \w les|strong="H6440"\w* négociants ?   
\q1
\v 7 Peux-tu cribler sa peau \w de|strong="H6862"\w* harpons,  
\q2 ou sa tête \w de|strong="H6862"\w* lances \w de|strong="H6862"\w* pêcheur ?   
\q1
\v 8 Pose \w ta|strong="H3808"\w* main sur \w lui|strong="H7307"\w*.  
\q2 Souviens-toi \w du|strong="H7307"\w* combat, \w et|strong="H3808"\w* \w tu|strong="H3808"\w* \w ne|strong="H3808"\w* recommenceras \w plus|strong="H3808"\w*.   
\q1
\v 9 Voici, l'espoir \w de|strong="H3808"\w* \w le|strong="H3808"\w* maîtriser est vain.  
\q2 \w Ne|strong="H3808"\w* serait-on \w pas|strong="H3808"\w* terrassé \w rien|strong="H3808"\w* qu'\w à|strong="H3808"\w* \w sa|strong="H3808"\w* vue ?   
\b  
\q1
\v 10 Nul n'\w est|strong="H5869"\w* assez audacieux \w pour|strong="H5869"\w* oser \w le|strong="H5869"\w* réveiller.  
\q2 \w Qui|strong="H5869"\w* donc pourrait \w se|strong="H5869"\w* tenir \w devant|strong="H5869"\w* moi ?   
\q1
\v 11 Qui m'\w a|strong="H3068"\w* donné \w le|strong="H1980"\w* premier, \w pour|strong="H1980"\w* \w que|strong="H6310"\w* \w je|strong="H6310"\w* doive \w le|strong="H1980"\w* rembourser ?  
\q2 \w Tout|strong="H1980"\w* ce qui \w est|strong="H6310"\w* sous \w le|strong="H1980"\w* ciel m'appartient.   
\b  
\q1
\v 12 \w Je|strong="H3068"\w* \w ne|strong="H3318"\w* garderai pas \w le|strong="H3318"\w* silence \w sur|strong="H3318"\w* \w ses|strong="H3318"\w* membres,  
\q2 ni \w sur|strong="H3318"\w* \w sa|strong="H3318"\w* \w grande|strong="H3318"\w* \w force|strong="H3318"\w*, ni \w sur|strong="H3318"\w* \w la|strong="H3318"\w* beauté \w de|strong="H3318"\w* \w sa|strong="H3318"\w* stature.   
\q1
\v 13 \w Qui|strong="H5315"\w* \w peut|strong="H5315"\w* arracher \w son|strong="H3318"\w* vêtement extérieur ?  
\q2 \w Qui|strong="H5315"\w* s'approchera \w de|strong="H3318"\w* \w sa|strong="H6310"\w* double mâchoire ?   
\q1
\v 14 \w Qui|strong="H6440"\w* peut ouvrir \w les|strong="H6440"\w* \w portes|strong="H6440"\w* \w de|strong="H6440"\w* \w sa|strong="H6440"\w* \w gueule|strong="H6440"\w* ?  
\q2 Autour \w de|strong="H6440"\w* \w ses|strong="H6440"\w* dents règne \w la|strong="H6440"\w* terreur.   
\q1
\v 15 \w Ses|strong="H5921"\w* puissantes écailles font \w sa|strong="H5921"\w* fierté,  
\q2 imbriquées \w comme|strong="H3332"\w* \w par|strong="H5921"\w* \w un|strong="H5921"\w* sceau étroit.   
\b  
\q1
\v 16 Elles \w sont|strong="H3820"\w* si proches l'\w une|strong="H3644"\w* \w de|strong="H3820"\w* l'autre,  
\q2 que l'air \w ne|strong="H3820"\w* \w peut|strong="H3820"\w* passer \w entre|strong="H3820"\w* elles.   
\q1
\v 17 Elles \w sont|strong="H2398"\w* reliées \w les|strong="H1481"\w* unes aux autres.  
\q2 Elles adhèrent ensemble, \w de|strong="H7613"\w* sorte qu'on ne peut \w les|strong="H1481"\w* séparer.   
\q1
\v 18 Ses éternuements \w font|strong="H2719"\w* jaillir \w la|strong="H6965"\w* \w lumière|strong="H6965"\w*.  
\q2 Ses yeux \w sont|strong="H2719"\w* \w comme|strong="H6965"\w* \w les|strong="H6965"\w* paupières \w de|strong="H6965"\w* l'aurore.   
\q1
\v 19 \w De|strong="H6086"\w* \w sa|strong="H2803"\w* gueule jaillissent \w des|strong="H6086"\w* torches enflammées.  
\q2 \w Des|strong="H6086"\w* étincelles \w de|strong="H6086"\w* feu s'\w en|strong="H6086"\w* échappent.   
\q1
\v 20 \w De|strong="H1121"\w* \w ses|strong="H1121"\w* narines \w sort|strong="H1121"\w* \w une|strong="H1121"\w* fumée,  
\q2 \w comme|strong="H1121"\w* d'\w une|strong="H1121"\w* marmite bouillante \w sur|strong="H1121"\w* \w un|strong="H1121"\w* \w feu|strong="H1121"\w* \w de|strong="H1121"\w* roseaux.   
\q1
\v 21 \w Son|strong="H2803"\w* souffle embrase \w les|strong="H2803"\w* charbons.  
\q2 \w Une|strong="H2803"\w* flamme sort \w de|strong="H2803"\w* \w sa|strong="H2803"\w* gueule.   
\q1
\v 22 \w La|strong="H5921"\w* force réside \w dans|strong="H5921"\w* \w son|strong="H5921"\w* cou.  
\q2 \w La|strong="H5921"\w* terreur bondit devant \w lui|strong="H5921"\w*.   
\q1
\v 23 \w Les|strong="H7760"\w* replis \w de|strong="H3220"\w* \w sa|strong="H7760"\w* chair \w sont|strong="H3220"\w* soudés ensemble.  
\q2 \w Ils|strong="H7760"\w* \w sont|strong="H3220"\w* fermes \w sur|strong="H7760"\w* lui.  
\q2 \w Ils|strong="H7760"\w* ne peuvent \w être|strong="H7760"\w* ébranlés.   
\q1
\v 24 \w Son|strong="H2803"\w* cœur est dur \w comme|strong="H2803"\w* \w la|strong="H2803"\w* pierre,  
\q2 oui, dur \w comme|strong="H2803"\w* \w la|strong="H2803"\w* meule inférieure.   
\q1
\v 25 \w Quand|strong="H5921"\w* \w il|strong="H6083"\w* \w se|strong="H6083"\w* dresse, \w les|strong="H6213"\w* puissants \w sont|strong="H6213"\w* terrifiés.  
\q2 \w Ils|strong="H6213"\w* reculent devant \w ses|strong="H6213"\w* assauts.   
\q1
\v 26 \w Si|strong="H7200"\w* \w on|strong="H1121"\w* l'attaque \w avec|strong="H1121"\w* l'épée, \w elle|strong="H1931"\w* \w ne|strong="H1121"\w* \w peut|strong="H4428"\w* triompher ;  
\q2 \w ni|strong="H1121"\w* \w la|strong="H7200"\w* lance, \w ni|strong="H1121"\w* \w le|strong="H7200"\w* javelot, \w ni|strong="H1121"\w* \w la|strong="H7200"\w* \w flèche|strong="H1121"\w*.   
\q1
\v 27 Il considère le fer comme de la paille,  
\q2 et le bronze comme du bois pourri.   
\q1
\v 28 La flèche ne le fait pas fuir.  
\q2 Les pierres de la fronde sont pour lui comme de la balle.   
\q1
\v 29 Les massues sont considérées comme du chaume.  
\q2 Il se rit du sifflement du javelot.   
\q1
\v 30 Son ventre est garni de tessons pointus,  
\q2 il laisse une trace dans la boue comme un traîneau à dépiquer.   
\q1
\v 31 Il fait bouillir l'abîme comme une marmite.  
\q2 Il fait de la mer comme un vase d'onguent.   
\q1
\v 32 Il laisse un sillage lumineux derrière lui.  
\q2 On croirait que l'abîme \w a|strong="H3068"\w* des cheveux blancs.   
\q1
\v 33 Sur la terre, il n'\w a|strong="H3068"\w* pas son pareil,  
\q2 lui qui \w a|strong="H3068"\w* été créé sans crainte.   
\q1
\v 34 Il regarde en face tout ce qui est élevé.  
\q2 Il est le roi de tous les fils de l'orgueil. »   
\b  
\c 42  
\p
