\q2 oui, \w deux|strong="H8147"\w* \w fois|strong="H8147"\w*, mais \w je|strong="H3808"\w* n'\w ajouterai|strong="H3254"\w* \w rien|strong="H3808"\w*. »   
\b  
\p
\v 6 \w Alors|strong="H3068"\w* \w le|strong="H3068"\w* \w SEIGNEUR|strong="H3068"\w* \w répondit|strong="H6030"\w* \w à|strong="H3068"\w* \w Job|strong="H3068"\w* \w du|strong="H3068"\w* \w milieu|strong="H3068"\w* \w de|strong="H3068"\w* \w la|strong="H3068"\w* \w tempête|strong="H5591"\w* :   
\q1
\v 7 « Prépare-toi maintenant \w comme|strong="H3045"\w* \w un|strong="H7592"\w* \w homme|strong="H1397"\w*.  
\q2 \w Je|strong="H3068"\w* vais t'\w interroger|strong="H7592"\w*, \w et|strong="H3045"\w* \w tu|strong="H3045"\w* \w me|strong="H3045"\w* répondras.   
\q1
\v 8 Iras-tu jusqu'\w à|strong="H4941"\w* \w annuler|strong="H6565"\w* \w mon|strong="H6565"\w* \w jugement|strong="H4941"\w* ?  
\q2 \w Me|strong="H4941"\w* \w condamneras-tu|strong="H4941"\w* \w pour|strong="H4941"\w* te \w justifier|strong="H6663"\w* ?   
\q1
\v 9 Ou as-tu un \w bras|strong="H2220"\w* \w comme|strong="H3644"\w* \w celui|strong="H6963"\w* \w de|strong="H6963"\w* \w Dieu|strong="H6963"\w* ?  
\q2 Peux-tu tonner avec \w une|strong="H3644"\w* \w voix|strong="H6963"\w* \w comme|strong="H3644"\w* \w la|strong="H6963"\w* sienne ?   
\b  
\q1
\v 10 « Pare-toi donc d'excellence \w et|strong="H1935"\w* \w de|strong="H3847"\w* \w dignité|strong="H1935"\w*.  
\q2 Revêts-toi \w de|strong="H3847"\w* \w gloire|strong="H1926"\w* \w et|strong="H1935"\w* \w de|strong="H3847"\w* \w majesté|strong="H1935"\w*.   
\q1
\v 11 Déverse \w la|strong="H7200"\w* \w fureur|strong="H5678"\w* \w de|strong="H7200"\w* \w ta|strong="H7200"\w* \w colère|strong="H5678"\w*.  
\q2 \w Regarde|strong="H7200"\w* \w tout|strong="H3605"\w* \w homme|strong="H3605"\w* \w orgueilleux|strong="H1343"\w*, \w et|strong="H7200"\w* abaisse-le.   
\q1
\v 12 \w Regarde|strong="H7200"\w* \w tout|strong="H3605"\w* \w homme|strong="H3605"\w* \w orgueilleux|strong="H1343"\w*, \w et|strong="H7200"\w* humilie-le.  
