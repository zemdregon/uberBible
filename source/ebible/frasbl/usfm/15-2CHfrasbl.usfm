\p
\v 5 « \w La|strong="H6440"\w* \w maison|strong="H1004"\w* \w que|strong="H3588"\w* \w je|strong="H3588"\w* \w bâtis|strong="H1129"\w* \w sera|strong="H8064"\w* grande, \w car|strong="H3588"\w* \w notre|strong="H3588"\w* \w Dieu|strong="H3588"\w* \w est|strong="H6440"\w* \w plus|strong="H3808"\w* \w grand|strong="H6440"\w* \w que|strong="H3588"\w* \w tous|strong="H3588"\w* \w les|strong="H6440"\w* \w dieux|strong="H6440"\w*.  
