\v 1 \w Simón|strong="G4826"\w* \w Pedro|strong="G4074"\w*, \w siervo|strong="G1401"\w* \w y|strong="G2532"\w* apóstol \w de|strong="G1722"\w* \w Jesucristo|strong="G2424"\w*, \w a|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w por|strong="G1722"\w* \w la|strong="G3588"\w* \w justicia|strong="G1343"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w Salvador|strong="G4990"\w* \w Jesucristo|strong="G2424"\w* han alcanzado \w una|strong="G3588"\w* \w fe|strong="G4102"\w* tan preciosa \w como|strong="G2532"\w* \w la|strong="G3588"\w* \w nuestra|strong="G3588"\w*:  
\v 2 \w Que|strong="G3588"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w y|strong="G2532"\w* \w la|strong="G3588"\w* \w paz|strong="G1515"\w* \w se|strong="G2532"\w* les multipliquen mediante \w el|strong="G3588"\w* \w conocimiento|strong="G1922"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w*.  
\v 3 \w Su|strong="G3588"\w* divino \w poder|strong="G1411"\w* nos ha concedido \w todas|strong="G3956"\w* \w las|strong="G3588"\w* cosas \w que|strong="G3588"\w* necesitamos \w para|strong="G4314"\w* vivir \w con|strong="G4314"\w* devoción \w a|strong="G4314"\w* Dios, mediante \w el|strong="G3588"\w* \w conocimiento|strong="G1922"\w* \w de|strong="G1223"\w* \w aquel|strong="G3588"\w* \w que|strong="G3588"\w* nos \w llamó|strong="G2564"\w* \w por|strong="G1223"\w* \w su|strong="G3588"\w* \w propia|strong="G2398"\w* \w gloria|strong="G1391"\w* \w y|strong="G2532"\w* excelencia.  
\v 4 \w Por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1722"\w* \w estas|strong="G3778"\w* \w cosas|strong="G3739"\w* nos ha dado \w preciosas|strong="G5093"\w* \w y|strong="G2532"\w* \w grandísimas|strong="G3176"\w* \w promesas|strong="G1862"\w*, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w por|strong="G1223"\w* \w ellas|strong="G3588"\w* ustedes lleguen \w a|strong="G1722"\w* \w ser|strong="G1096"\w* \w partícipes|strong="G2844"\w* \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w naturaleza|strong="G5449"\w* \w divina|strong="G2304"\w*, \w habiendo|strong="G1096"\w* escapado \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w corrupción|strong="G5356"\w* \w que|strong="G3588"\w* \w hay|strong="G3588"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w mundo|strong="G2889"\w* \w a|strong="G1722"\w* \w causa|strong="G1223"\w* \w de|strong="G1722"\w* \w los|strong="G3588"\w* malos \w deseos|strong="G1939"\w*.  
\v 5 \w Por|strong="G1722"\w* \w esto|strong="G3778"\w* mismo, esfuércense \w por|strong="G1722"\w* añadir \w a|strong="G1722"\w* \w su|strong="G3588"\w* \w fe|strong="G4102"\w*, virtud; \w a|strong="G1722"\w* \w su|strong="G3588"\w* virtud, \w conocimiento|strong="G1108"\w*;  
\v 6 \w al|strong="G3588"\w* \w conocimiento|strong="G1108"\w*, dominio propio; \w al|strong="G3588"\w* dominio propio, \w paciencia|strong="G5281"\w*; \w a|strong="G1722"\w* \w la|strong="G3588"\w* \w paciencia|strong="G5281"\w*, devoción \w a|strong="G1722"\w* Dios;  
\v 7 \w a|strong="G1722"\w* \w la|strong="G3588"\w* devoción \w a|strong="G1722"\w* Dios, afecto fraternal; \w y|strong="G1161"\w* \w al|strong="G3588"\w* afecto fraternal, amor.  
\v 8 \w Porque|strong="G1063"\w* \w si|strong="G2532"\w* \w estas|strong="G3778"\w* cosas \w abundan|strong="G4121"\w* \w en|strong="G1519"\w* ustedes, \w no|strong="G3756"\w* \w los|strong="G3588"\w* dejarán ser inútiles \w ni|strong="G3761"\w* improductivos \w en|strong="G1519"\w* \w el|strong="G3588"\w* \w conocimiento|strong="G1922"\w* \w de|strong="G1519"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*.  
\v 9 \w Pero|strong="G1063"\w* \w el|strong="G3588"\w* \w que|strong="G3588"\w* carece \w de|strong="G3588"\w* \w estas|strong="G3778"\w* \w cosas|strong="G3739"\w* \w está|strong="G3778"\w* \w ciego|strong="G5185"\w*, \w es|strong="G3739"\w* corto \w de|strong="G3588"\w* vista \w y|strong="G1063"\w* ha \w olvidado|strong="G3024"\w* \w que|strong="G3588"\w* fue purificado \w de|strong="G3588"\w* \w sus|strong="G3588"\w* \w antiguos|strong="G3819"\w* pecados.  
\v 10 \w Por|strong="G1063"\w* \w lo|strong="G3588"\w* tanto, hermanos, esfuércense \w aún|strong="G2532"\w* \w más|strong="G2532"\w* \w por|strong="G1063"\w* asegurar \w su|strong="G3588"\w* llamado \w y|strong="G2532"\w* \w su|strong="G3588"\w* \w elección|strong="G1589"\w*. \w Porque|strong="G1063"\w* \w si|strong="G2532"\w* \w hacen|strong="G4160"\w* \w estas|strong="G3778"\w* cosas, \w no|strong="G3756"\w* tropezarán \w jamás|strong="G3588"\w*,  
