\p
\v 12 \w Por|strong="G1722"\w* eso, \w siempre|strong="G3588"\w* les \w recordaré|strong="G5279"\w* \w estas|strong="G3778"\w* cosas, \w aunque|strong="G2532"\w* \w ya|strong="G2532"\w* \w las|strong="G3588"\w* \w saben|strong="G1492"\w* \w y|strong="G2532"\w* están firmes \w en|strong="G1722"\w* \w la|strong="G3588"\w* verdad \w que|strong="G3588"\w* ahora tienen.  
\v 13 \w Me|strong="G1722"\w* parece \w justo|strong="G1342"\w* \w que|strong="G3588"\w*, \w mientras|strong="G1909"\w* \w esté|strong="G3778"\w* \w en|strong="G1722"\w* \w este|strong="G3778"\w* cuerpo mortal, \w los|strong="G3588"\w* estimule recordándoselas,  
\v 14 \w pues|strong="G2532"\w* \w sé|strong="G1492"\w* \w que|strong="G3754"\w* pronto tendré \w que|strong="G3754"\w* dejar \w este|strong="G3588"\w* cuerpo, tal \w como|strong="G2531"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w* \w me|strong="G1473"\w* \w lo|strong="G3588"\w* ha dado a \w conocer|strong="G1492"\w*.  
\v 15 \w También|strong="G2532"\w* me esforzaré para \w que|strong="G3588"\w*, \w después|strong="G3326"\w* \w de|strong="G3588"\w* \w mi|strong="G1699"\w* \w partida|strong="G1841"\w*, ustedes puedan recordar \w estas|strong="G3778"\w* cosas \w en|strong="G3588"\w* todo momento.   
\p
\v 16 \w Porque|strong="G1063"\w* cuando \w les|strong="G1565"\w* dimos a conocer \w el|strong="G3588"\w* \w poder|strong="G1411"\w* \w y|strong="G2532"\w* \w la|strong="G3588"\w* \w venida|strong="G3952"\w* \w de|strong="G3588"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*, \w no|strong="G3756"\w* estábamos \w siguiendo|strong="G1811"\w* cuentos ingeniosamente inventados, sino \w que|strong="G3588"\w* \w fuimos|strong="G1096"\w* testigos oculares \w de|strong="G3588"\w* \w su|strong="G3588"\w* \w majestad|strong="G3168"\w*.  
\v 17 \w Él|strong="G3588"\w* \w recibió|strong="G2983"\w* \w honor|strong="G5092"\w* \w y|strong="G2532"\w* \w gloria|strong="G1391"\w* \w de|strong="G3844"\w* \w parte|strong="G3739"\w* \w de|strong="G3844"\w* \w Dios|strong="G2316"\w* \w el|strong="G3588"\w* \w Padre|strong="G3962"\w* cuando desde \w la|strong="G3588"\w* majestuosa \w gloria|strong="G1391"\w* \w se|strong="G2532"\w* \w le|strong="G1519"\w* dirigió \w esta|strong="G3778"\w* \w voz|strong="G5456"\w*: “\w Este|strong="G3778"\w* \w es|strong="G3739"\w* \w mi|strong="G3588"\w* \w Hijo|strong="G5207"\w* amado, \w en|strong="G1519"\w* \w quien|strong="G3739"\w* \w me|strong="G1473"\w* complazco”.  
\v 18 \w Nosotros|strong="G2249"\w* mismos oímos esa \w voz|strong="G5456"\w* \w que|strong="G3588"\w* venía \w del|strong="G3588"\w* \w cielo|strong="G3772"\w* \w cuando|strong="G1722"\w* \w estábamos|strong="G1510"\w* \w con|strong="G1722"\w* \w él|strong="G3588"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w monte|strong="G3735"\w* santo.   
\p
\v 19 \w Esto|strong="G3739"\w* nos \w hace|strong="G4160"\w* estar \w más|strong="G2532"\w* seguros \w de|strong="G1722"\w* \w las|strong="G3588"\w* \w palabras|strong="G3056"\w* \w de|strong="G1722"\w* \w los|strong="G3588"\w* profetas, \w a|strong="G1722"\w* \w las|strong="G3588"\w* \w cuales|strong="G3739"\w* ustedes \w hacen|strong="G4160"\w* \w bien|strong="G2573"\w* \w en|strong="G1722"\w* prestar atención, \w como|strong="G5613"\w* \w a|strong="G1722"\w* \w una|strong="G3588"\w* \w lámpara|strong="G3088"\w* \w que|strong="G3588"\w* brilla \w en|strong="G1722"\w* \w un|strong="G3588"\w* \w lugar|strong="G5117"\w* oscuro, \w hasta|strong="G2193"\w* \w que|strong="G3588"\w* despunte \w el|strong="G3588"\w* \w día|strong="G2250"\w* \w y|strong="G2532"\w* \w el|strong="G3588"\w* lucero \w de|strong="G1722"\w* \w la|strong="G3588"\w* mañana amanezca \w en|strong="G1722"\w* \w sus|strong="G3588"\w* \w corazones|strong="G2588"\w*.  
\v 20 \w Ante|strong="G4412"\w* \w todo|strong="G3956"\w*, tengan muy presente \w que|strong="G3754"\w* \w ninguna|strong="G3756"\w* \w profecía|strong="G4394"\w* \w de|strong="G3754"\w* la \w Escritura|strong="G1124"\w* surge \w de|strong="G3754"\w* la \w interpretación|strong="G1955"\w* privada \w de|strong="G3754"\w* \w nadie|strong="G3756"\w*,  
\v 21 \w porque|strong="G1063"\w* la \w profecía|strong="G4394"\w* \w no|strong="G3756"\w* ha tenido \w su|strong="G2316"\w* origen \w en|strong="G5259"\w* la \w voluntad|strong="G2307"\w* humana, sino \w que|strong="G1063"\w* los profetas \w hablaron|strong="G2980"\w* \w de|strong="G5259"\w* parte \w de|strong="G5259"\w* \w Dios|strong="G2316"\w*, impulsados \w por|strong="G5259"\w* el \w Espíritu|strong="G4151"\w* Santo.   
\c 2  
\p
\v 1 \w Pero|strong="G1161"\w* \w hubo|strong="G1096"\w* \w también|strong="G2532"\w* falsos profetas \w entre|strong="G1722"\w* \w el|strong="G3588"\w* \w pueblo|strong="G2992"\w*, \w así|strong="G2532"\w* \w como|strong="G5613"\w* \w habrá|strong="G1096"\w* falsos maestros \w entre|strong="G1722"\w* ustedes. \w Ellos|strong="G3588"\w* \w introducirán|strong="G3919"\w* \w en|strong="G1722"\w* \w secreto|strong="G1096"\w* herejías destructivas, \w y|strong="G2532"\w* hasta negarán \w al|strong="G3588"\w* \w Señor|strong="G1203"\w* \w que|strong="G3588"\w* \w los|strong="G3588"\w* rescató, \w trayendo|strong="G1863"\w* \w sobre|strong="G1722"\w* \w sí|strong="G1438"\w* mismos \w una|strong="G3588"\w* destrucción repentina.  
\v 2 \w Muchos|strong="G4183"\w* \w seguirán|strong="G1811"\w* \w sus|strong="G3588"\w* prácticas inmorales, \w y|strong="G2532"\w* \w por|strong="G1223"\w* \w causa|strong="G1223"\w* \w de|strong="G1223"\w* \w ellos|strong="G3588"\w* \w el|strong="G3588"\w* \w camino|strong="G3598"\w* \w de|strong="G1223"\w* \w la|strong="G3588"\w* verdad será difamado.  
\v 3 Llevados \w por|strong="G1722"\w* \w la|strong="G3588"\w* \w avaricia|strong="G4124"\w*, \w estos|strong="G3588"\w* maestros \w los|strong="G3588"\w* explotarán \w a|strong="G1722"\w* ustedes \w con|strong="G1722"\w* \w palabras|strong="G3056"\w* engañosas. \w Su|strong="G3588"\w* condena, decretada desde hace \w mucho|strong="G3756"\w* tiempo, \w no|strong="G3756"\w* \w se|strong="G2532"\w* hace esperar, \w y|strong="G2532"\w* \w su|strong="G3588"\w* destrucción \w no|strong="G3756"\w* \w está|strong="G3588"\w* dormida.   
\p
\v 4 \w Porque|strong="G1063"\w* \w si|strong="G1487"\w* \w Dios|strong="G2316"\w* \w no|strong="G3756"\w* \w perdonó|strong="G5339"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* ángeles \w que|strong="G3588"\w* pecaron, \w sino|strong="G1487"\w* \w que|strong="G3588"\w* \w los|strong="G3588"\w* arrojó \w al|strong="G3588"\w* infierno \w y|strong="G1063"\w* \w los|strong="G3588"\w* \w entregó|strong="G3860"\w* \w a|strong="G1519"\w* prisiones \w de|strong="G1519"\w* \w oscuridad|strong="G2217"\w*, \w para|strong="G1519"\w* ser reservados \w para|strong="G1519"\w* \w el|strong="G3588"\w* \w juicio|strong="G2920"\w*;  
\v 5 \w y|strong="G2532"\w* \w si|strong="G2532"\w* \w no|strong="G3756"\w* \w perdonó|strong="G5339"\w* al \w mundo|strong="G2889"\w* antiguo, sino \w que|strong="G2532"\w* protegió a \w Noé|strong="G3575"\w*, \w predicador|strong="G2783"\w* de la \w justicia|strong="G1343"\w*, \w y|strong="G2532"\w* a otras siete personas, cuando trajo el \w diluvio|strong="G2627"\w* sobre el \w mundo|strong="G2889"\w* de \w los|strong="G2532"\w* impíos;  
\v 6 \w y|strong="G2532"\w* \w si|strong="G2532"\w* \w condenó|strong="G2632"\w* a la destrucción a las \w ciudades|strong="G4172"\w* de \w Sodoma|strong="G4670"\w* \w y|strong="G2532"\w* \w Gomorra|strong="G1116"\w*, reduciéndolas a cenizas \w y|strong="G2532"\w* poniéndolas \w como|strong="G2532"\w* \w ejemplo|strong="G5262"\w* de lo \w que|strong="G2532"\w* le sucedería a \w los|strong="G2532"\w* \w que|strong="G2532"\w* viven \w sin|strong="G2532"\w* Dios;  
\v 7 \w y|strong="G2532"\w* rescató \w al|strong="G3588"\w* \w justo|strong="G1342"\w* \w Lot|strong="G3091"\w*, \w que|strong="G3588"\w* estaba angustiado \w por|strong="G1722"\w* \w la|strong="G3588"\w* vida desenfrenada \w de|strong="G1722"\w* esos malvados  
\v 8 (\w pues|strong="G1063"\w* ese hombre \w justo|strong="G1342"\w*, mientras vivía \w entre|strong="G1722"\w* \w ellos|strong="G3588"\w*, sufría \w día|strong="G2250"\w* tras \w día|strong="G2250"\w* \w en|strong="G1722"\w* \w su|strong="G3588"\w* \w alma|strong="G5590"\w* noble \w al|strong="G3588"\w* ver \w y|strong="G2532"\w* oír \w los|strong="G3588"\w* \w hechos|strong="G2041"\w* perversos \w de|strong="G1537"\w* \w ellos|strong="G3588"\w*);  
\v 9 \w si|strong="G1161"\w* esto es \w así|strong="G1161"\w*, \w entonces|strong="G1161"\w* \w el|strong="G1161"\w* \w Señor|strong="G2962"\w* \w sabe|strong="G1492"\w* rescatar \w de|strong="G1537"\w* las pruebas \w a|strong="G1519"\w* los \w que|strong="G1519"\w* viven \w con|strong="G1537"\w* devoción, \w y|strong="G1161"\w* \w sabe|strong="G1492"\w* \w también|strong="G1161"\w* \w reservar|strong="G5083"\w* \w a|strong="G1519"\w* los injustos \w para|strong="G1519"\w* ser castigados \w en|strong="G1519"\w* \w el|strong="G1161"\w* \w día|strong="G2250"\w* \w del|strong="G1537"\w* \w juicio|strong="G2920"\w*,  
\v 10 especialmente \w a|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* dejan llevar \w por|strong="G1722"\w* pasiones impuras \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w carne|strong="G4561"\w* \w y|strong="G2532"\w* \w desprecian|strong="G2706"\w* \w la|strong="G3588"\w* autoridad \w de|strong="G1722"\w* Dios. \w Atrevidos|strong="G5113"\w* \w y|strong="G2532"\w* arrogantes, \w no|strong="G3756"\w* tienen miedo \w de|strong="G1722"\w* insultar \w a|strong="G1722"\w* \w los|strong="G3588"\w* seres celestiales,  
\v 11 mientras \w que|strong="G3844"\w* \w los|strong="G2532"\w* ángeles, \w aunque|strong="G2532"\w* \w son|strong="G1510"\w* \w mayores|strong="G3173"\w* \w en|strong="G2596"\w* \w fuerza|strong="G1411"\w* \w y|strong="G2532"\w* \w poder|strong="G1411"\w*, \w no|strong="G3756"\w* \w pronuncian|strong="G5342"\w* \w ningún|strong="G3756"\w* \w juicio|strong="G2920"\w* insultante \w contra|strong="G2596"\w* ellos \w en|strong="G2596"\w* la presencia \w del|strong="G3844"\w* \w Señor|strong="G2962"\w*.  
\v 12 \w Pero|strong="G1161"\w* \w esos|strong="G3778"\w* individuos, \w como|strong="G5613"\w* \w animales|strong="G2226"\w* irracionales \w que|strong="G3588"\w* \w se|strong="G2532"\w* guían \w por|strong="G1722"\w* instinto \w y|strong="G2532"\w* nacen \w para|strong="G1519"\w* ser atrapados \w y|strong="G2532"\w* destruidos, hablan mal \w de|strong="G1722"\w* \w cosas|strong="G3739"\w* \w que|strong="G3588"\w* no entienden, \w y|strong="G2532"\w* \w también|strong="G2532"\w* perecerán \w en|strong="G1722"\w* \w su|strong="G3588"\w* propia \w corrupción|strong="G5356"\w*.  
\v 13 \w Así|strong="G2532"\w* recibirán \w el|strong="G3588"\w* \w pago|strong="G3408"\w* \w por|strong="G1722"\w* \w sus|strong="G3588"\w* injusticias, \w ya|strong="G2532"\w* \w que|strong="G3588"\w* consideran \w un|strong="G3588"\w* placer \w el|strong="G3588"\w* entregarse \w a|strong="G1722"\w* \w sus|strong="G3588"\w* vicios \w a|strong="G1722"\w* plena luz \w del|strong="G3588"\w* \w día|strong="G2250"\w*. Son \w manchas|strong="G3470"\w* \w y|strong="G2532"\w* defectos \w que|strong="G3588"\w* \w se|strong="G2532"\w* deleitan \w en|strong="G1722"\w* \w sus|strong="G3588"\w* engaños mientras comen \w con|strong="G1722"\w* ustedes.  
