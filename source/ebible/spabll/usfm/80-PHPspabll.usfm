\v 1 \w Pablo|strong="G3972"\w* \w y|strong="G2532"\w* \w Timoteo|strong="G5095"\w*, \w siervos|strong="G1401"\w* \w de|strong="G1722"\w* \w Jesucristo|strong="G2424"\w*, \w a|strong="G1722"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* santos \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w que|strong="G3588"\w* están \w en|strong="G1722"\w* \w la|strong="G3588"\w* ciudad \w de|strong="G1722"\w* \w Filipos|strong="G5375"\w*, junto \w con|strong="G1722"\w* \w los|strong="G3588"\w* \w obispos|strong="G1985"\w* \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w diáconos|strong="G1249"\w*:  
