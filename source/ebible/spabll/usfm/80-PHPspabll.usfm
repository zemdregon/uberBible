\c 2  
\p
\v 1 \w Por|strong="G1722"\w* tanto, \w si|strong="G1487"\w* sienten \w algún|strong="G5100"\w* ánimo \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w*, \w si|strong="G1487"\w* hay \w algún|strong="G5100"\w* \w consuelo|strong="G3874"\w* \w en|strong="G1722"\w* su amor, \w si|strong="G1487"\w* hay \w alguna|strong="G5100"\w* \w comunión|strong="G2842"\w* \w en|strong="G1722"\w* \w el|strong="G5100"\w* \w Espíritu|strong="G4151"\w*, \w si|strong="G1487"\w* hay \w alguna|strong="G5100"\w* ternura \w y|strong="G2532"\w* compasión,  
\v 2 colmen \w mi|strong="G3588"\w* \w alegría|strong="G5479"\w* \w teniendo|strong="G2192"\w* \w un|strong="G1520"\w* mismo pensar, \w un|strong="G1520"\w* mismo amor, unidos \w en|strong="G3588"\w* alma \w y|strong="G2443"\w* propósito.  
\v 3 \w No|strong="G3367"\w* hagan \w nada|strong="G3367"\w* \w por|strong="G2596"\w* rivalidad o \w por|strong="G2596"\w* orgullo, sino \w con|strong="G2596"\w* \w humildad|strong="G5012"\w*, considerando \w cada|strong="G2596"\w* \w uno|strong="G2596"\w* \w a|strong="G2596"\w* \w los|strong="G3588"\w* demás \w como|strong="G2596"\w* \w superiores|strong="G5242"\w* \w a|strong="G2596"\w* \w sí|strong="G1438"\w* mismo.  
\v 4 \w Ninguno|strong="G3361"\w* busque únicamente \w su|strong="G3588"\w* propio bien, \w sino|strong="G3361"\w* \w también|strong="G2532"\w* \w el|strong="G3588"\w* bien \w de|strong="G3588"\w* \w los|strong="G3588"\w* \w otros|strong="G2087"\w*.   
