\v 3 \w En|strong="G1722"\w* \w su|strong="G3588"\w* viaje, \w cuando|strong="G1722"\w* \w se|strong="G1096"\w* acercaba \w a|strong="G1722"\w* \w Damasco|strong="G1154"\w*, \w de|strong="G1537"\w* repente \w lo|strong="G3588"\w* \w rodeó|strong="G4015"\w* \w el|strong="G3588"\w* resplandor \w de|strong="G1537"\w* \w una|strong="G3588"\w* \w luz|strong="G5457"\w* \w del|strong="G3588"\w* \w cielo|strong="G3772"\w*.  
