\v 12 \w Con|strong="G2532"\w* \w esto|strong="G3588"\w*, alborotaron \w al|strong="G3588"\w* \w pueblo|strong="G2992"\w*, \w a|strong="G1519"\w* \w los|strong="G3588"\w* \w ancianos|strong="G4245"\w* \w y|strong="G2532"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* maestros \w de|strong="G1519"\w* \w la|strong="G3588"\w* ley. Cayeron \w sobre|strong="G1519"\w* \w él|strong="G3588"\w*, \w lo|strong="G3588"\w* arrestaron \w y|strong="G2532"\w* \w lo|strong="G3588"\w* llevaron ante \w el|strong="G3588"\w* \w Consejo|strong="G4892"\w*.  
\v 13 \w Presentaron|strong="G2476"\w* \w testigos|strong="G3144"\w* \w falsos|strong="G5571"\w*, \w que|strong="G3588"\w* declararon: “\w Este|strong="G3778"\w* hombre \w no|strong="G3756"\w* deja \w de|strong="G2596"\w* \w hablar|strong="G2980"\w* \w en|strong="G2596"\w* \w contra|strong="G2596"\w* \w de|strong="G2596"\w* \w este|strong="G3778"\w* \w lugar|strong="G5117"\w* santo \w y|strong="G2532"\w* \w de|strong="G2596"\w* \w la|strong="G3588"\w* \w ley|strong="G3551"\w*.  
