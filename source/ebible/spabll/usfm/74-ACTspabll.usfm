\c 27  
\p
\v 1 \w Cuando|strong="G5613"\w* \w se|strong="G2532"\w* decidió \w que|strong="G3588"\w* debíamos viajar \w en|strong="G1519"\w* barco \w a|strong="G1519"\w* \w Italia|strong="G2482"\w*, \w entregaron|strong="G3860"\w* \w a|strong="G1519"\w* \w Pablo|strong="G3972"\w* \w y|strong="G2532"\w* \w a|strong="G1519"\w* \w otros|strong="G2087"\w* prisioneros \w a|strong="G1519"\w* \w un|strong="G5100"\w* oficial romano \w llamado|strong="G3686"\w* \w Julio|strong="G2457"\w*, \w que|strong="G3588"\w* pertenecía \w al|strong="G3588"\w* regimiento \w de|strong="G1519"\w* Augusto.  
\v 2 Nos \w subimos|strong="G1910"\w* \w a|strong="G1519"\w* \w un|strong="G3588"\w* \w barco|strong="G4143"\w* \w de|strong="G1519"\w* \w la|strong="G3588"\w* ciudad \w de|strong="G1519"\w* Adramitio \w que|strong="G3588"\w* \w estaba|strong="G3195"\w* \w por|strong="G1519"\w* salir \w hacia|strong="G1519"\w* \w los|strong="G3588"\w* puertos \w de|strong="G1519"\w* \w la|strong="G3588"\w* provincia \w de|strong="G1519"\w* Asia, \w y|strong="G1161"\w* zarpamos. Nos acompañaba Aristarco, \w un|strong="G3588"\w* \w macedonio|strong="G3110"\w* \w de|strong="G1519"\w* \w Tesalónica|strong="G2331"\w*.  
