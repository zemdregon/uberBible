\v 1 \w En|strong="G1722"\w* \w aquellos|strong="G3588"\w* \w días|strong="G2250"\w*, \w al|strong="G3588"\w* multiplicarse \w el|strong="G3588"\w* número \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w*, surgió \w una|strong="G3588"\w* queja \w de|strong="G1722"\w* \w los|strong="G3588"\w* judíos helenistas\f + \fr 6:1 \ft Los helenistas utilizaban la lengua y la cultura griega, aunque también eran de origen hebreo.\f* \w contra|strong="G4314"\w* \w los|strong="G3588"\w* \w hebreos|strong="G1445"\w*, \w de|strong="G1722"\w* \w que|strong="G3754"\w* \w sus|strong="G3588"\w* \w viudas|strong="G5503"\w* eran desatendidas \w en|strong="G1722"\w* \w la|strong="G3588"\w* distribución diaria \w de|strong="G1722"\w* \w los|strong="G3588"\w* alimentos.  
\v 2 \w Entonces|strong="G1161"\w* \w los|strong="G3588"\w* \w doce|strong="G1427"\w* \w convocaron|strong="G4341"\w* \w a|strong="G1161"\w* toda \w la|strong="G3588"\w* asamblea \w de|strong="G3588"\w* \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* \w y|strong="G1161"\w* \w dijeron|strong="G3004"\w*: “\w No|strong="G3756"\w* \w está|strong="G3588"\w* \w bien|strong="G1161"\w* \w que|strong="G3588"\w* \w nosotros|strong="G2249"\w* descuidemos \w el|strong="G3588"\w* ministerio \w de|strong="G3588"\w* \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* para servir \w las|strong="G3588"\w* \w mesas|strong="G5132"\w*.  
