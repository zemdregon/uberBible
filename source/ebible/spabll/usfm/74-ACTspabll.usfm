\v 30 \w Cornelio|strong="G2883"\w* \w le|strong="G1722"\w* contestó: “Hace \w cuatro|strong="G5067"\w* \w días|strong="G2250"\w* \w a|strong="G1722"\w* \w esta|strong="G3778"\w* misma \w hora|strong="G5610"\w*, \w a|strong="G1722"\w* \w las|strong="G3588"\w* tres \w de|strong="G1722"\w* \w la|strong="G3588"\w* tarde,\f + \fr 10:30 \ft 15:00 h.\f* \w yo|strong="G1473"\w* \w estaba|strong="G2476"\w* \w orando|strong="G4336"\w* \w en|strong="G1722"\w* \w mi|strong="G3588"\w* \w casa|strong="G3624"\w*. \w De|strong="G1722"\w* repente apareció ante \w mí|strong="G3588"\w* \w un|strong="G3588"\w* hombre \w con|strong="G1722"\w* \w ropa|strong="G2066"\w* \w brillante|strong="G2986"\w*,  
