\v 14 \w Y|strong="G2532"\w* ahora \w está|strong="G3588"\w* \w aquí|strong="G5602"\w*, \w con|strong="G3844"\w* \w autoridad|strong="G1849"\w* \w de|strong="G3844"\w* \w los|strong="G3588"\w* jefes \w de|strong="G3844"\w* \w los|strong="G3588"\w* sacerdotes, \w para|strong="G3844"\w* arrestar \w a|strong="G3844"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w invocan|strong="G1941"\w* \w tu|strong="G4771"\w* \w nombre|strong="G3686"\w*”.   
