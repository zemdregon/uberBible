\mt2 La carta del Apóstol San Pablo a  
\mt1 Tito  
\c 1  
\p
\v 1 \w Pablo|strong="G3972"\w*, \w siervo|strong="G1401"\w* \w de|strong="G2596"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* apóstol \w de|strong="G2596"\w* \w Jesucristo|strong="G2424"\w*, llamado \w para|strong="G2596"\w* llevar \w a|strong="G2596"\w* \w los|strong="G3588"\w* \w elegidos|strong="G1588"\w* \w de|strong="G2596"\w* \w Dios|strong="G2316"\w* \w a|strong="G2596"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w* \w y|strong="G2532"\w* \w al|strong="G3588"\w* pleno \w conocimiento|strong="G1922"\w* \w de|strong="G2596"\w* \w la|strong="G3588"\w* \w verdad|strong="G4102"\w* \w que|strong="G3588"\w* es \w conforme|strong="G2596"\w* \w a|strong="G2596"\w* \w la|strong="G3588"\w* \w piedad|strong="G2150"\w*,  
\v 2 \w con|strong="G1909"\w* \w la|strong="G3588"\w* \w esperanza|strong="G1680"\w* \w de|strong="G1909"\w* \w la|strong="G3588"\w* \w vida|strong="G2222"\w* eterna, \w la|strong="G3588"\w* \w cual|strong="G3739"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* no miente, \w prometió|strong="G1861"\w* \w desde|strong="G1909"\w* \w antes|strong="G4253"\w* \w del|strong="G3588"\w* principio \w de|strong="G1909"\w* \w los|strong="G3588"\w* \w tiempos|strong="G5550"\w*,  
\v 3 \w y|strong="G1161"\w* \w a|strong="G1722"\w* \w su|strong="G3588"\w* debido \w tiempo|strong="G2540"\w* reveló \w su|strong="G3588"\w* \w palabra|strong="G3056"\w* mediante \w la|strong="G3588"\w* \w predicación|strong="G2782"\w* \w que|strong="G3588"\w* se \w me|strong="G1473"\w* confió \w por|strong="G1722"\w* mandato \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*;  
\v 4 \w a|strong="G2596"\w* \w Tito|strong="G5103"\w*, \w mi|strong="G3588"\w* \w verdadero|strong="G1103"\w* \w hijo|strong="G5043"\w* \w en|strong="G2596"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w* \w que|strong="G3588"\w* compartimos: \w Gracia|strong="G5485"\w*, misericordia \w y|strong="G2532"\w* \w paz|strong="G1515"\w* \w de|strong="G2596"\w* parte \w de|strong="G2596"\w* \w Dios|strong="G2316"\w* \w Padre|strong="G3962"\w* \w y|strong="G2532"\w* \w de|strong="G2596"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*.   
\p
\v 5 \w Te|strong="G4771"\w* dejé \w en|strong="G1722"\w* \w Creta|strong="G2914"\w* \w por|strong="G1722"\w* \w esta|strong="G3778"\w* \w razón|strong="G2596"\w*: \w para|strong="G2443"\w* \w que|strong="G3588"\w* pusieras \w en|strong="G1722"\w* orden \w lo|strong="G3588"\w* \w que|strong="G3588"\w* faltaba \w y|strong="G2532"\w* nombraras \w ancianos|strong="G4245"\w* \w en|strong="G1722"\w* \w cada|strong="G2596"\w* \w ciudad|strong="G4172"\w*, tal \w como|strong="G5613"\w* \w te|strong="G4771"\w* \w ordené|strong="G1299"\w*.  
\v 6 \w El|strong="G5100"\w* anciano debe \w ser|strong="G2192"\w* intachable, esposo \w de|strong="G1722"\w* \w una|strong="G1520"\w* sola \w mujer|strong="G1135"\w*; sus \w hijos|strong="G5043"\w* deben \w ser|strong="G2192"\w* creyentes, \w y|strong="G1510"\w* \w no|strong="G3361"\w* estar acusados \w de|strong="G1722"\w* mala conducta \w ni|strong="G2228"\w* \w ser|strong="G2192"\w* rebeldes.  
\v 7 \w Porque|strong="G1063"\w* \w el|strong="G3588"\w* \w obispo|strong="G1985"\w*, \w como|strong="G5613"\w* encargado \w de|strong="G3588"\w* \w la|strong="G3588"\w* obra \w de|strong="G3588"\w* \w Dios|strong="G2316"\w*, \w debe|strong="G1163"\w* ser intachable: \w no|strong="G3361"\w* arrogante, \w no|strong="G3361"\w* \w de|strong="G3588"\w* mal genio, \w no|strong="G3361"\w* dado \w a|strong="G5613"\w* \w la|strong="G3588"\w* embriaguez, \w no|strong="G3361"\w* violento \w ni|strong="G3361"\w* codicioso \w de|strong="G3588"\w* ganancias deshonestas.  
\v 8 Al contrario, debe ser hospitalario, amante del bien, sensato, \w justo|strong="G1342"\w*, \w santo|strong="G3741"\w* y disciplinado.  
\v 9 Debe apegarse \w a|strong="G1722"\w* \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w fiel|strong="G4103"\w*, \w según|strong="G2596"\w* \w la|strong="G3588"\w* \w enseñanza|strong="G1319"\w* recibida, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w también|strong="G2532"\w* \w pueda|strong="G1415"\w* animar \w a|strong="G1722"\w* \w otros|strong="G3588"\w* \w con|strong="G1722"\w* \w la|strong="G3588"\w* \w sana|strong="G5198"\w* \w doctrina|strong="G1322"\w* \w y|strong="G2532"\w* \w convencer|strong="G1651"\w* \w a|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* oponen.   
\p
\v 10 \w Porque|strong="G1063"\w* \w hay|strong="G3588"\w* \w muchos|strong="G4183"\w* rebeldes, charlatanes \w y|strong="G2532"\w* \w engañadores|strong="G5423"\w*, especialmente \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w son|strong="G1510"\w* \w de|strong="G1537"\w* \w la|strong="G3588"\w* \w circuncisión|strong="G4061"\w*,  
\v 11 a \w quienes|strong="G3739"\w* \w es|strong="G3739"\w* \w necesario|strong="G1163"\w* taparles la boca; pues están arruinando familias \w enteras|strong="G3650"\w*, \w enseñando|strong="G1321"\w* \w cosas|strong="G3739"\w* \w que|strong="G3739"\w* \w no|strong="G3361"\w* \w deben|strong="G1163"\w* \w para|strong="G5484"\w* obtener \w ganancias|strong="G2771"\w* deshonestas.  
\v 12 \w Uno|strong="G5100"\w* \w de|strong="G1537"\w* \w ellos|strong="G1537"\w*, \w su|strong="G2398"\w* \w propio|strong="G2398"\w* \w profeta|strong="G4396"\w*, \w dijo|strong="G3004"\w*: “\w Los|strong="G5100"\w* \w cretenses|strong="G2912"\w* son siempre \w mentirosos|strong="G5583"\w*, \w malas|strong="G2556"\w* \w bestias|strong="G2342"\w*, glotones perezosos”.  
\v 13 \w Este|strong="G3778"\w* \w testimonio|strong="G3141"\w* \w es|strong="G3739"\w* verdadero. \w Por|strong="G1223"\w* \w eso|strong="G1223"\w*, \w repréndelos|strong="G1651"\w* \w con|strong="G1722"\w* severidad, \w para|strong="G2443"\w* \w que|strong="G3588"\w* sean \w sanos|strong="G5198"\w* \w en|strong="G1722"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w*,  
\v 14 \w y|strong="G2532"\w* \w no|strong="G3361"\w* presten atención a \w las|strong="G3588"\w* \w fábulas|strong="G3454"\w* judías \w ni|strong="G2532"\w* a \w los|strong="G3588"\w* \w mandamientos|strong="G1785"\w* \w de|strong="G3588"\w* hombres \w que|strong="G3588"\w* \w se|strong="G2532"\w* apartan \w de|strong="G3588"\w* \w la|strong="G3588"\w* verdad.  
\v 15 Para \w los|strong="G3588"\w* puros, \w todas|strong="G3956"\w* \w las|strong="G3588"\w* cosas son puras; \w pero|strong="G1161"\w* para \w los|strong="G3588"\w* corruptos \w e|strong="G2532"\w* incrédulos \w no|strong="G3762"\w* \w hay|strong="G3588"\w* \w nada|strong="G3762"\w* \w puro|strong="G2513"\w*, \w porque|strong="G1161"\w* tanto \w su|strong="G3588"\w* \w mente|strong="G3563"\w* \w como|strong="G2532"\w* \w su|strong="G3588"\w* \w conciencia|strong="G4893"\w* están corrompidas.  
\v 16 Afirman \w conocer|strong="G1492"\w* \w a|strong="G4314"\w* \w Dios|strong="G2316"\w*, \w pero|strong="G1161"\w* \w con|strong="G4314"\w* \w sus|strong="G3588"\w* acciones \w lo|strong="G3588"\w* niegan; \w son|strong="G1510"\w* abominables, desobedientes \w e|strong="G2532"\w* incapaces \w de|strong="G4314"\w* \w hacer|strong="G2041"\w* nada bueno.   
\c 2  
\p
\v 1 \w Pero|strong="G1161"\w* \w tú|strong="G4771"\w*, enseña \w lo|strong="G3588"\w* \w que|strong="G3588"\w* \w está|strong="G3588"\w* \w de|strong="G3588"\w* acuerdo \w con|strong="G3739"\w* \w la|strong="G3588"\w* \w sana|strong="G5198"\w* \w doctrina|strong="G1319"\w*.  
\v 2 A \w los|strong="G3588"\w* hombres mayores, enséñales a ser sobrios, respetables, sensatos, \w sanos|strong="G5198"\w* \w en|strong="G3588"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w*, \w en|strong="G3588"\w* \w el|strong="G3588"\w* amor \w y|strong="G1510"\w* \w en|strong="G3588"\w* \w la|strong="G3588"\w* \w paciencia|strong="G5281"\w*.  
\v 3 \w Asimismo|strong="G5615"\w*, \w a|strong="G1722"\w* las mujeres mayores, \w a|strong="G1722"\w* \w que|strong="G3361"\w* se comporten \w con|strong="G1722"\w* reverencia, \w que|strong="G3361"\w* \w no|strong="G3361"\w* sean \w calumniadoras|strong="G1228"\w* \w ni|strong="G3366"\w* esclavas del \w mucho|strong="G4183"\w* \w vino|strong="G3631"\w*, \w sino|strong="G3361"\w* \w que|strong="G3361"\w* enseñen lo bueno,  
\v 4 \w para|strong="G2443"\w* \w que|strong="G3588"\w* instruyan \w a|strong="G2443"\w* \w las|strong="G3588"\w* jóvenes \w a|strong="G2443"\w* amar \w a|strong="G2443"\w* \w sus|strong="G3588"\w* esposos \w y|strong="G1510"\w* \w a|strong="G2443"\w* \w sus|strong="G3588"\w* hijos,  
\v 5 \w a|strong="G2443"\w* ser \w prudentes|strong="G4998"\w*, puras, dedicadas \w a|strong="G2443"\w* \w su|strong="G3588"\w* hogar, bondadosas \w y|strong="G2443"\w* sumisas \w a|strong="G2443"\w* \w sus|strong="G3588"\w* propios esposos, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w nadie|strong="G3361"\w* hable mal \w de|strong="G3588"\w* \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w*.   
\p
\v 6 \w De|strong="G3588"\w* \w la|strong="G3588"\w* misma manera, anima a \w los|strong="G3588"\w* jóvenes a ser sensatos.  
\v 7 \w En|strong="G1722"\w* \w todo|strong="G3956"\w*, sé \w tú|strong="G3588"\w* mismo \w un|strong="G3588"\w* \w ejemplo|strong="G5179"\w* \w de|strong="G4012"\w* \w buenas|strong="G2570"\w* \w obras|strong="G2041"\w*. \w Al|strong="G3588"\w* \w enseñar|strong="G1319"\w*, muestra integridad, seriedad,  
\v 8 \w y|strong="G2443"\w* \w un|strong="G3588"\w* mensaje \w sano|strong="G5199"\w* e intachable, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* se oponen se avergüencen \w al|strong="G3588"\w* \w no|strong="G3367"\w* \w tener|strong="G2192"\w* \w nada|strong="G3367"\w* malo \w que|strong="G3588"\w* \w decir|strong="G3004"\w* \w de|strong="G1537"\w* \w nosotros|strong="G2249"\w*.   
\p
\v 9 Exhorta \w a|strong="G1722"\w* los \w siervos|strong="G1401"\w* \w a|strong="G1722"\w* \w que|strong="G3361"\w* se sometan \w a|strong="G1722"\w* \w sus|strong="G2398"\w* propios \w amos|strong="G1203"\w*, \w que|strong="G3361"\w* traten \w de|strong="G1722"\w* agradarles \w en|strong="G1722"\w* \w todo|strong="G3956"\w*, \w que|strong="G3361"\w* \w no|strong="G3361"\w* les respondan mal,  
\v 10 \w y|strong="G2443"\w* \w que|strong="G3588"\w* \w no|strong="G3361"\w* les roben, \w sino|strong="G3361"\w* \w que|strong="G3588"\w* demuestren ser completamente confiables, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w en|strong="G1722"\w* \w todo|strong="G3956"\w* hagan lucir \w la|strong="G3588"\w* \w doctrina|strong="G1319"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*.  
\v 11 \w Porque|strong="G1063"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* se ha manifestado para traer \w salvación|strong="G4992"\w* a \w todos|strong="G3956"\w* \w los|strong="G3588"\w* hombres,  
\v 12 \w enseñándonos|strong="G3811"\w* \w que|strong="G3588"\w*, renunciando \w a|strong="G1722"\w* \w la|strong="G3588"\w* maldad \w y|strong="G2532"\w* \w a|strong="G1722"\w* \w los|strong="G3588"\w* \w deseos|strong="G1939"\w* \w mundanos|strong="G2886"\w*, \w vivamos|strong="G2198"\w* \w en|strong="G1722"\w* \w este|strong="G3588"\w* mundo \w con|strong="G1722"\w* prudencia, justicia \w y|strong="G2532"\w* devoción \w a|strong="G1722"\w* Dios,  
\v 13 mientras aguardamos \w la|strong="G3588"\w* bendita \w esperanza|strong="G1680"\w* \w y|strong="G2532"\w* \w la|strong="G3588"\w* \w gloriosa|strong="G1391"\w* \w manifestación|strong="G2015"\w* \w de|strong="G3588"\w* \w nuestro|strong="G2249"\w* \w gran|strong="G3173"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w Salvador|strong="G4990"\w* \w Jesucristo|strong="G2424"\w*.  
\v 14 \w Él|strong="G3739"\w* \w se|strong="G1438"\w* entregó \w por|strong="G5228"\w* \w nosotros|strong="G2249"\w* \w para|strong="G2443"\w* rescatarnos \w de|strong="G1325"\w* \w toda|strong="G3956"\w* maldad \w y|strong="G2532"\w* purificar \w para|strong="G2443"\w* \w sí|strong="G1438"\w* mismo un \w pueblo|strong="G2992"\w* \w que|strong="G3739"\w* \w le|strong="G1438"\w* pertenezca, dispuesto \w a|strong="G2443"\w* \w hacer|strong="G2041"\w* \w el|strong="G3739"\w* \w bien|strong="G2570"\w*.   
\p
\v 15 Enseña \w estas|strong="G3778"\w* cosas; anima \w y|strong="G2532"\w* \w reprende|strong="G1651"\w* \w con|strong="G3326"\w* \w toda|strong="G3956"\w* \w autoridad|strong="G2003"\w*. \w Que|strong="G2532"\w* \w nadie|strong="G3367"\w* \w te|strong="G4771"\w* menosprecie.   
\c 3  
\p
\v 1 \w Recuérdales|strong="G5279"\w* \w a|strong="G4314"\w* \w todos|strong="G3956"\w* que \w se|strong="G1438"\w* sometan \w a|strong="G4314"\w* los gobernantes \w y|strong="G1510"\w* \w a|strong="G4314"\w* las autoridades, que sean obedientes \w y|strong="G1510"\w* que estén siempre dispuestos \w a|strong="G4314"\w* \w hacer|strong="G2041"\w* \w el|strong="G1438"\w* bien;  
\v 2 que \w no|strong="G3367"\w* hablen mal \w de|strong="G4314"\w* \w nadie|strong="G3367"\w*, que sean pacíficos \w y|strong="G1510"\w* amables, \w mostrando|strong="G1731"\w* humildad \w hacia|strong="G4314"\w* \w todas|strong="G3956"\w* las personas.  
\v 3 \w Porque|strong="G1063"\w* \w también|strong="G2532"\w* \w nosotros|strong="G2249"\w* \w en|strong="G1722"\w* \w otro|strong="G4218"\w* tiempo \w éramos|strong="G1510"\w* necios, desobedientes, \w engañados|strong="G4105"\w* \w y|strong="G2532"\w* esclavos \w de|strong="G1722"\w* toda clase \w de|strong="G1722"\w* pasiones \w y|strong="G2532"\w* placeres. Vivíamos \w en|strong="G1722"\w* \w malicia|strong="G2549"\w* \w y|strong="G2532"\w* \w envidia|strong="G5355"\w*; \w éramos|strong="G1510"\w* odiosos \w y|strong="G2532"\w* nos odiábamos unos \w a|strong="G1722"\w* otros.  
\v 4 \w Pero|strong="G1161"\w* \w cuando|strong="G3753"\w* \w se|strong="G2532"\w* manifestó \w la|strong="G3588"\w* \w bondad|strong="G5544"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*, \w y|strong="G2532"\w* \w su|strong="G3588"\w* \w amor|strong="G5363"\w* \w por|strong="G3588"\w* \w la|strong="G3588"\w* humanidad,  
\v 5 \w él|strong="G3588"\w* nos \w salvó|strong="G4982"\w*, \w no|strong="G3756"\w* \w por|strong="G1223"\w* nuestras propias \w obras|strong="G2041"\w* \w de|strong="G1537"\w* \w justicia|strong="G1343"\w*, sino \w por|strong="G1223"\w* \w su|strong="G3588"\w* \w misericordia|strong="G1656"\w*. Nos \w salvó|strong="G4982"\w* mediante \w el|strong="G3588"\w* lavamiento \w de|strong="G1537"\w* \w la|strong="G3588"\w* \w regeneración|strong="G3824"\w* \w y|strong="G2532"\w* \w de|strong="G1537"\w* \w la|strong="G3588"\w* renovación \w por|strong="G1223"\w* \w el|strong="G3588"\w* \w Espíritu|strong="G4151"\w* Santo,  
\v 6 \w el|strong="G3588"\w* \w cual|strong="G3739"\w* \w derramó|strong="G1632"\w* \w sobre|strong="G1909"\w* \w nosotros|strong="G2249"\w* \w en|strong="G1909"\w* \w abundancia|strong="G4146"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1909"\w* \w Jesucristo|strong="G2424"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*.  
\v 7 \w Así|strong="G2596"\w*, \w habiendo|strong="G1096"\w* \w sido|strong="G1096"\w* \w justificados|strong="G1344"\w* \w por|strong="G2596"\w* \w su|strong="G3588"\w* \w gracia|strong="G5485"\w*, hemos \w llegado|strong="G1096"\w* \w a|strong="G2596"\w* \w ser|strong="G1096"\w* \w herederos|strong="G2818"\w* \w con|strong="G2596"\w* \w la|strong="G3588"\w* \w esperanza|strong="G1680"\w* \w de|strong="G2596"\w* tener \w vida|strong="G2222"\w* eterna.  
\v 8 \w Palabra|strong="G3056"\w* \w fiel|strong="G4103"\w* \w es|strong="G3778"\w* \w esta|strong="G3778"\w*, \w y|strong="G2532"\w* \w quiero|strong="G1014"\w* \w que|strong="G3588"\w* insistas \w con|strong="G2532"\w* firmeza \w en|strong="G4012"\w* \w estas|strong="G3778"\w* cosas, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* han \w creído|strong="G4100"\w* \w en|strong="G4012"\w* \w Dios|strong="G2316"\w* \w se|strong="G2532"\w* esfuercen \w en|strong="G4012"\w* \w hacer|strong="G2041"\w* \w buenas|strong="G2570"\w* \w obras|strong="G2041"\w*. \w Estas|strong="G3778"\w* cosas \w son|strong="G1510"\w* excelentes \w y|strong="G2532"\w* \w de|strong="G4012"\w* gran beneficio \w para|strong="G2443"\w* todos.  
\v 9 \w Pero|strong="G1161"\w* \w evita|strong="G4026"\w* las discusiones \w necias|strong="G3474"\w*, las \w genealogías|strong="G1076"\w*, \w los|strong="G2532"\w* \w pleitos|strong="G2054"\w* \w y|strong="G2532"\w* las peleas \w por|strong="G1063"\w* la ley, \w porque|strong="G1063"\w* \w son|strong="G1510"\w* inútiles \w y|strong="G2532"\w* no sirven para nada.  
\v 10 Al \w que|strong="G2532"\w* cause divisiones, adviértele \w una|strong="G1520"\w* \w y|strong="G2532"\w* \w otra|strong="G1208"\w* vez; \w después|strong="G3326"\w* de eso, evítalo,  
\v 11 \w pues|strong="G2532"\w* \w ya|strong="G2532"\w* \w sabes|strong="G1492"\w* \w que|strong="G3754"\w* \w tal|strong="G5108"\w* persona \w se|strong="G1492"\w* ha descarriado \w y|strong="G2532"\w* \w sus|strong="G3588"\w* propios pecados \w la|strong="G3588"\w* condenan.   
\p
