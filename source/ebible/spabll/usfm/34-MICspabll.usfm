\id MIC  
\h MIQUEAS 
\toc3 Miqueas 
\toc1 MIQUEAS 
\toc2 MIQUEAS 
\mt1 Miqueas  
\c 1  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w que|strong="H5921"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* Miqueas \w de|strong="H5921"\w* Moreset \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Jotam, Acaz \w y|strong="H5921"\w* Ezequías, \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H5921"\w* visión \w que|strong="H5921"\w* \w tuvo|strong="H1961"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w y|strong="H5921"\w* Jerusalén.   
\q1
\v 2 ¡\w Escuchen|strong="H8085"\w*, \w pueblos|strong="H5971"\w* \w todos|strong="H3605"\w*!  
\q2 Presten atención, tierra y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H5971"\w* \w hay|strong="H1961"\w* en \w ella|strong="H3605"\w*.  
\q1 \w Que|strong="H5971"\w* \w el|strong="H3605"\w* Señor Yahvé \w sea|strong="H1961"\w* \w testigo|strong="H5707"\w* \w contra|strong="H1961"\w* ustedes,  
\q2 \w el|strong="H3605"\w* Señor desde su \w santo|strong="H6944"\w* \w templo|strong="H1964"\w*.   
\q1
\v 3 \w Porque|strong="H3588"\w* miren, Yahvé \w sale|strong="H3318"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w lugar|strong="H4725"\w*;  
\q2 \w él|strong="H5921"\w* bajará \w y|strong="H3588"\w* caminará \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* alturas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.   
\q1
\v 4 Las montañas se derriten \w bajo|strong="H8478"\w* sus pies  
\q2 y los \w valles|strong="H6010"\w* se parten \w como|strong="H8478"\w* la cera \w ante|strong="H6440"\w* el fuego,  
\q2 \w como|strong="H8478"\w* el \w agua|strong="H4325"\w* \w que|strong="H4325"\w* corre \w por|strong="H8478"\w* un despeñadero.   
\b  
\q1
\v 5 \w Todo|strong="H3605"\w* \w esto|strong="H2063"\w* sucede por \w la|strong="H3605"\w* rebeldía de \w Jacob|strong="H3290"\w*  
\q2 y por \w los|strong="H3605"\w* \w pecados|strong="H2403"\w* de \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*.  
\q1 ¿\w Cuál|strong="H4310"\w* \w es|strong="H2063"\w* \w la|strong="H3605"\w* rebeldía de \w Jacob|strong="H3290"\w*?  
\q2 ¿\w No|strong="H3808"\w* \w es|strong="H2063"\w* \w Samaria|strong="H8111"\w*?  
\q1 ¿\w Y|strong="H3068"\w* cuáles \w son|strong="H3808"\w* \w los|strong="H3605"\w* lugares de culto pagano en \w Judá|strong="H3063"\w*?  
\q2 ¿\w No|strong="H3808"\w* \w es|strong="H2063"\w* Jerusalén?   
\q1
\v 6 Por eso, convertiré \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w* en un montón de ruinas,  
\q2 en tierra para plantar viñedos.  
\q1 Arrojaré sus piedras al \w valle|strong="H1516"\w*  
\q2 y dejaré al desnudo sus cimientos.   
\q1
\v 7 \w Todos|strong="H3605"\w* sus \w ídolos|strong="H6091"\w* serán hechos pedazos,  
\q2 \w todos|strong="H3605"\w* sus salarios \w de|strong="H3588"\w* prostitución serán quemados  
\q2 \w y|strong="H3588"\w* destruiré \w todas|strong="H3605"\w* sus imágenes;  
\q1 \w porque|strong="H3588"\w* \w ella|strong="H3605"\w* \w los|strong="H3605"\w* \w juntó|strong="H6908"\w* \w como|strong="H3588"\w* paga \w de|strong="H3588"\w* prostituta,  
\q2 \w y|strong="H3588"\w* \w como|strong="H3588"\w* paga \w de|strong="H3588"\w* prostituta \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* ser usados.   
\b  
\q1
\v 8 \w Por|strong="H5921"\w* \w esto|strong="H2063"\w* \w me|strong="H5921"\w* lamentaré \w y|strong="H5921"\w* lloraré;  
\q2 \w andaré|strong="H3212"\w* descalzo \w y|strong="H5921"\w* \w desnudo|strong="H6174"\w*.  
\q2 Aullaré \w como|strong="H5921"\w* \w los|strong="H5921"\w* chacales  
\q2 \w y|strong="H5921"\w* gemiré \w como|strong="H5921"\w* \w los|strong="H5921"\w* avestruces.   
\q1
\v 9 \w Porque|strong="H3588"\w* \w su|strong="H3588"\w* herida \w es|strong="H3588"\w* incurable;  
\q2 \w el|strong="H3588"\w* mal ha \w llegado|strong="H5060"\w* \w hasta|strong="H5704"\w* \w Judá|strong="H3063"\w*.  
\q1 \w Se|strong="H5971"\w* ha extendido \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* \w de|strong="H3588"\w* \w mi|strong="H3389"\w* \w pueblo|strong="H5971"\w*,  
\q2 \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* misma Jerusalén.   
\q1
\v 10 No lo cuenten en Gat,  
\q2 ni se pongan \w a|strong="H3068"\w* llorar.  
\q2 En Bet-le-afrá revuélquense en el \w polvo|strong="H6083"\w*.   
\q1
\v 11 Sigan su camino, \w habitantes|strong="H3427"\w* \w de|strong="H4480"\w* Safir, desnudos y avergonzados.  
\q2 \w Los|strong="H3427"\w* \w que|strong="H4480"\w* viven \w en|strong="H4480"\w* Zaánan \w no|strong="H3808"\w* \w se|strong="H4480"\w* atreven \w a|strong="H3068"\w* \w salir|strong="H3318"\w*.  
\q2 \w El|strong="H5674"\w* lamento \w de|strong="H4480"\w* Bet-ezel les \w quitará|strong="H3947"\w* su protección.   
\q1
\v 12 \w Porque|strong="H3588"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* Marot esperan ansiosos \w el|strong="H3588"\w* \w bien|strong="H2896"\w*,  
\q2 \w pero|strong="H3588"\w* \w el|strong="H3588"\w* \w mal|strong="H7451"\w* ha bajado \w de|strong="H3588"\w* parte \w de|strong="H3588"\w* Yahvé hasta \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* \w de|strong="H3588"\w* Jerusalén.   
\q1
\v 13 Enganchen \w los|strong="H3427"\w* caballos al \w carro|strong="H4818"\w*, \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* Laquis;  
\q2 ustedes fueron \w el|strong="H1931"\w* \w principio|strong="H7225"\w* del \w pecado|strong="H2403"\w* \w para|strong="H3588"\w* \w la|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w*,  
\q2 \w porque|strong="H3588"\w* \w en|strong="H3588"\w* ustedes \w se|strong="H1931"\w* \w hallaron|strong="H4672"\w* las maldades \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.   
\q1
\v 14 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, den regalos \w de|strong="H5921"\w* despedida \w a|strong="H3068"\w* Moreset-gat.  
\q2 \w Las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* Aczib serán un engaño \w para|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\q1
\v 15 \w Todavía|strong="H5750"\w* traeré \w a|strong="H3068"\w* un conquistador \w contra|strong="H3478"\w* ustedes, \w habitantes|strong="H3427"\w* \w de|strong="H5750"\w* \w Maresá|strong="H4762"\w*;  
\q2 la \w gloria|strong="H3519"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w* llegará \w hasta|strong="H5704"\w* Adulam.   
\q1
\v 16 Ráquense \w la|strong="H5921"\w* cabeza  
\q2 \w y|strong="H3588"\w* córtense \w el|strong="H5921"\w* cabello \w por|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w que|strong="H3588"\w* \w tanto|strong="H5921"\w* aman;  
\q1 háganse una calva tan grande \w como|strong="H3588"\w* \w la|strong="H5921"\w* \w del|strong="H4480"\w* buitre,  
\q2 \w porque|strong="H3588"\w* \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* han ido \w al|strong="H5921"\w* exilio lejos \w de|strong="H4480"\w* ustedes.   
\c 2  
\p
\v 1 ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w hacen|strong="H6213"\w* planes malvados  
\q2 \w y|strong="H3588"\w* traman \w la|strong="H5921"\w* \w maldad|strong="H7451"\w* \w en|strong="H5921"\w* sus \w camas|strong="H4904"\w*!  
\q1 \w En|strong="H5921"\w* \w cuanto|strong="H3588"\w* amanece, \w la|strong="H5921"\w* ponen \w en|strong="H5921"\w* práctica,  
\q2 \w porque|strong="H3588"\w* \w tienen|strong="H3426"\w* \w el|strong="H5921"\w* \w poder|strong="H3027"\w* \w en|strong="H5921"\w* sus \w manos|strong="H3027"\w*.   
\q1
\v 2 Codician \w campos|strong="H7704"\w* y se apoderan de ellos;  
\q2 quieren \w casas|strong="H1004"\w* y se las \w quitan|strong="H1497"\w* \w a|strong="H3068"\w* sus dueños.  
\q1 Oprimen al \w hombre|strong="H1397"\w* y \w a|strong="H3068"\w* su \w familia|strong="H1004"\w*,  
\q2 \w a|strong="H3068"\w* las personas y \w a|strong="H3068"\w* su patrimonio.   
\q1
\v 3 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé:  
\q1 “Miren, \w yo|strong="H3588"\w* estoy planeando \w contra|strong="H5921"\w* \w esta|strong="H2063"\w* gente un \w castigo|strong="H7451"\w*  
\q2 \w del|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* podrán librar \w su|strong="H1931"\w* \w cuello|strong="H6677"\w*.  
\q2 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w caminarán|strong="H3212"\w* \w con|strong="H5921"\w* orgullo,  
\q2 \w porque|strong="H3588"\w* vendrán \w tiempos|strong="H6256"\w* muy \w malos|strong="H7451"\w*.   
\q1
\v 4 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w se|strong="H1931"\w* burlará \w de|strong="H5921"\w* ustedes;  
\q2 cantarán \w este|strong="H1931"\w* triste lamento:  
\q2 ‘¡Estamos totalmente arruinados!  
\q2 \w El|strong="H1931"\w* patrimonio \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* ha sido repartido.  
\q2 ¡\w Cómo|strong="H5921"\w* \w nos|strong="H5921"\w* \w lo|strong="H1931"\w* \w quita|strong="H5375"\w*! Entrega nuestros \w campos|strong="H7704"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* traidores’”.   
\q1
\v 5 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* \w nadie|strong="H3808"\w* \w que|strong="H3808"\w* reparta tierras \w para|strong="H1961"\w* ustedes  
\q2 en la asamblea de Yahvé.   
\q1
\v 6 “¡\w No|strong="H3808"\w* nos vengan con profecías!” —dicen ellos.  
\q2 “\w No|strong="H3808"\w* \w se|strong="H3808"\w* debe profetizar sobre esas cosas;  
\q2 la desgracia \w no|strong="H3808"\w* nos \w va|strong="H3068"\w* \w a|strong="H3068"\w* alcanzar”.   
\q1
\v 7 Ustedes, \w que|strong="H3808"\w* \w se|strong="H3808"\w* llaman \w casa|strong="H1004"\w* \w de|strong="H5973"\w* \w Jacob|strong="H3290"\w*,  
\q2 ¿creen \w que|strong="H3808"\w* \w el|strong="H5973"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5973"\w* Yahvé \w ha|strong="H3808"\w* perdido la paciencia?  
\q2 ¿\w Es|strong="H1697"\w* \w así|strong="H5973"\w* \w como|strong="H5973"\w* \w él|strong="H5973"\w* actúa?  
\q2 ¿Acaso mis \w palabras|strong="H1697"\w* \w no|strong="H3808"\w* benefician al \w que|strong="H3808"\w* vive \w con|strong="H5973"\w* rectitud?   
\q1
\v 8 Pero hace poco mi \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* ha levantado \w como|strong="H8008"\w* un enemigo;  
\q2 \w a|strong="H3068"\w* los \w que|strong="H5971"\w* \w pasan|strong="H5674"\w* tranquilos, \w como|strong="H8008"\w* los \w que|strong="H5971"\w* \w vuelven|strong="H7725"\w* \w de|strong="H5971"\w* la \w guerra|strong="H4421"\w*,  
\q2 ustedes les quitan la capa y \w el|strong="H5674"\w* abrigo.   
\q1
\v 9 \w A|strong="H3068"\w* \w las|strong="H5921"\w* mujeres \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w las|strong="H5921"\w* echan \w de|strong="H5921"\w* sus \w casas|strong="H1004"\w* queridas;  
\q2 \w a|strong="H3068"\w* sus \w niños|strong="H5768"\w* \w les|strong="H5921"\w* \w quitan|strong="H3947"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w* \w la|strong="H5921"\w* bendición \w que|strong="H5921"\w* yo \w les|strong="H5921"\w* di.   
\q1
\v 10 ¡\w Levántense|strong="H6965"\w* \w y|strong="H3588"\w* váyanse!  
\q2 \w Este|strong="H2063"\w* ya \w no|strong="H3808"\w* \w es|strong="H3588"\w* \w su|strong="H3588"\w* lugar \w de|strong="H3588"\w* \w descanso|strong="H4496"\w*,  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3588"\w* impureza \w de|strong="H3588"\w* \w este|strong="H2063"\w* lugar causa destrucción,  
\q2 ¡una destrucción terrible!   
\q1
\v 11 \w Si|strong="H3863"\w* un hombre \w mentiroso|strong="H8267"\w* y \w falso|strong="H8267"\w* les dijera:  
\q2 “Les \w voy|strong="H1980"\w* \w a|strong="H3068"\w* profetizar \w que|strong="H5971"\w* \w habrá|strong="H1961"\w* mucho \w vino|strong="H3196"\w* y cerveza”,  
\q2 ¡\w ese|strong="H2088"\w* \w sería|strong="H1961"\w* el \w profeta|strong="H5197"\w* ideal \w para|strong="H1961"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*!   
\q1
\v 12 “\w Ciertamente|strong="H6908"\w* \w los|strong="H3605"\w* reuniré \w a|strong="H3068"\w* \w todos|strong="H3605"\w* ustedes, \w Jacob|strong="H3290"\w*;  
\q2 \w recogeré|strong="H6908"\w* al \w resto|strong="H7611"\w* de \w Israel|strong="H3478"\w*.  
\q1 \w Los|strong="H3605"\w* \w juntaré|strong="H6908"\w* como \w ovejas|strong="H6629"\w* \w en|strong="H8432"\w* \w un|strong="H3162"\w* corral,  
\q2 como \w un|strong="H3162"\w* \w rebaño|strong="H6629"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de sus pastos;  
\q2 \w el|strong="H3605"\w* lugar se llenará de gente”.   
\q1
\v 13 \w El|strong="H5674"\w* que abre \w el|strong="H5674"\w* camino \w irá|strong="H5927"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos;  
\q2 abrirán la brecha, \w pasarán|strong="H5674"\w* \w por|strong="H6440"\w* la \w puerta|strong="H8179"\w* y \w saldrán|strong="H3318"\w* \w por|strong="H6440"\w* ella.  
\q2 Su \w rey|strong="H4428"\w* \w pasará|strong="H5674"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos,  
\q2 con Yahvé \w a|strong="H3068"\w* la \w cabeza|strong="H7218"\w*.   
\c 3  
\p
\v 1 Entonces dije:  
\q1 “\w Escuchen|strong="H8085"\w* \w ahora|strong="H4994"\w*, líderes de \w Jacob|strong="H3290"\w*,  
\q2 y gobernantes de la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*:  
\q2 ¿\w No|strong="H3808"\w* deberían ser ustedes los \w que|strong="H3808"\w* \w conozcan|strong="H3045"\w* la \w justicia|strong="H4941"\w*?   
\q1
\v 2 Pero ustedes odian \w lo|strong="H5921"\w* \w bueno|strong="H2896"\w*  
\q2 \w y|strong="H5921"\w* aman \w lo|strong="H5921"\w* \w malo|strong="H7451"\w*;  
\q2 \w a|strong="H3068"\w* \w mi|strong="H5921"\w* pueblo \w le|strong="H5921"\w* arrancan \w la|strong="H5921"\w* \w piel|strong="H5785"\w*  
\q2 \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w carne|strong="H7607"\w* \w de|strong="H5921"\w* sus \w huesos|strong="H6106"\w*;   
\q2
\v 3 ustedes \w se|strong="H5921"\w* comen \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*,  
\q2 \w les|strong="H5921"\w* quitan \w la|strong="H5921"\w* \w piel|strong="H5785"\w*,  
\q2 \w les|strong="H5921"\w* rompen \w los|strong="H5921"\w* \w huesos|strong="H6106"\w*  
\q2 \w y|strong="H5921"\w* \w los|strong="H5921"\w* pican \w como|strong="H5921"\w* \w carne|strong="H1320"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w olla|strong="H5518"\w*,  
\q2 \w como|strong="H5921"\w* \w carne|strong="H1320"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* caldero”.   
\q1
\v 4 \w Entonces|strong="H6256"\w* \w clamarán|strong="H2199"\w* \w a|strong="H3068"\w* Yahvé,  
\q2 pero \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w les|strong="H1992"\w* \w responderá|strong="H6030"\w*.  
\q1 En \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* esconderá \w de|strong="H6440"\w* \w ellos|strong="H1992"\w* \w su|strong="H1931"\w* \w rostro|strong="H6440"\w*,  
\q2 \w por|strong="H6440"\w* todas \w las|strong="H1992"\w* maldades \w que|strong="H1931"\w* cometieron.   
\p
\v 5 \w Así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* \w que|strong="H3808"\w* \w engañan|strong="H8582"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*: “Mientras tienen algo \w que|strong="H3808"\w* comer, anuncian: ‘¡\w Paz|strong="H7965"\w*!’, pero \w al|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w da|strong="H5414"\w* \w de|strong="H5921"\w* comer, \w le|strong="H5921"\w* declaran \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*”:   
\q1
\v 6 “\w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w para|strong="H5921"\w* ustedes será \w noche|strong="H3915"\w* \w en|strong="H5921"\w* vez \w de|strong="H5921"\w* \w visión|strong="H2377"\w*,  
\q2 \w y|strong="H5921"\w* oscuridad \w en|strong="H5921"\w* vez \w de|strong="H5921"\w* revelación.  
\q2 \w El|strong="H5921"\w* \w sol|strong="H8121"\w* \w se|strong="H5921"\w* pondrá \w sobre|strong="H5921"\w* esos \w profetas|strong="H5030"\w*  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w se|strong="H5921"\w* volverá negro \w para|strong="H5921"\w* \w ellos|strong="H5921"\w*.   
\q1
