\v 31 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* ordenó: “\w Haz|strong="H6213"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w dice|strong="H1696"\w*: mátalo allí mismo \w y|strong="H5921"\w* sepúltalo. \w Así|strong="H1696"\w* quitarás \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w familia|strong="H1004"\w* \w la|strong="H5921"\w* culpa \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w que|strong="H5921"\w* \w Joab|strong="H3097"\w* \w derramó|strong="H8210"\w* \w injustamente|strong="H2600"\w*.  
\v 32 Yahvé hará \w que|strong="H4480"\w* Joab \w pague|strong="H7725"\w* \w por|strong="H5921"\w* sus propios crímenes, \w pues|strong="H4480"\w* \w sin|strong="H3808"\w* \w que|strong="H4480"\w* \w mi|strong="H5921"\w* padre \w David|strong="H1732"\w* \w lo|strong="H3808"\w* supiera, \w él|strong="H5921"\w* asesinó \w a|strong="H3068"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w hombres|strong="H1121"\w* \w mejores|strong="H2896"\w* \w y|strong="H5921"\w* \w más|strong="H4480"\w* \w justos|strong="H6662"\w* \w que|strong="H4480"\w* \w él|strong="H5921"\w*: \w a|strong="H3068"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Ner|strong="H5369"\w*, \w general|strong="H8269"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w Amasa|strong="H6021"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Jeter|strong="H3500"\w*, \w general|strong="H8269"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*.  
\v 33 La culpa \w de|strong="H5973"\w* sus muertes recaerá \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w sobre|strong="H1961"\w* \w Joab|strong="H3097"\w* \w y|strong="H5704"\w* sus descendientes; pero Yahvé \w dará|strong="H7725"\w* \w paz|strong="H7965"\w* \w eterna|strong="H5769"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w a|strong="H3068"\w* su \w descendencia|strong="H2233"\w*, \w a|strong="H3068"\w* su \w familia|strong="H1004"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* su \w trono|strong="H3678"\w*”.   
