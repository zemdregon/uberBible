\v 34 \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joyadá fue y \w mató|strong="H4191"\w* \w a|strong="H3068"\w* Joab, y lo \w sepultaron|strong="H6912"\w* \w en|strong="H6912"\w* su \w casa|strong="H1004"\w*, \w en|strong="H6912"\w* \w el|strong="H1121"\w* \w desierto|strong="H4057"\w*.  
\v 35 \w En|strong="H5921"\w* \w lugar|strong="H8478"\w* \w de|strong="H5921"\w* Joab, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w puso|strong="H5414"\w* \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w* \w al|strong="H5921"\w* frente \w del|strong="H5921"\w* \w ejército|strong="H6635"\w*, \w y|strong="H5921"\w* \w puso|strong="H5414"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w* \w en|strong="H5921"\w* \w lugar|strong="H8478"\w* \w de|strong="H5921"\w* Abiatar.   
\p
\v 36 \w Después|strong="H3427"\w* \w el|strong="H3427"\w* \w rey|strong="H4428"\w* \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* Simei y le dijo: “Constrúyete una \w casa|strong="H1004"\w* \w en|strong="H3318"\w* Jerusalén y \w quédate|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w ahí|strong="H8033"\w*; \w no|strong="H3808"\w* \w salgas|strong="H3318"\w* de la ciudad para \w nada|strong="H3808"\w*.  
\v 37 \w El|strong="H3588"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* \w salgas|strong="H3318"\w* \w y|strong="H3588"\w* cruces \w el|strong="H3588"\w* \w arroyo|strong="H5158"\w* Cedrón, \w ten|strong="H3045"\w* \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* \w morirás|strong="H4191"\w* \w y|strong="H3588"\w* tú mismo \w serás|strong="H1961"\w* \w el|strong="H3588"\w* único culpable”.   
\p
\v 38 Simei le respondió: “Me parece \w bien|strong="H2896"\w*. \w Haré|strong="H6213"\w* exactamente \w lo|strong="H1697"\w* \w que|strong="H1697"\w* usted me ha ordenado”. \w Y|strong="H3068"\w* Simei \w vivió|strong="H3117"\w* en Jerusalén \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w*.   
\p
\v 39 Pero \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w después|strong="H1961"\w*, \w dos|strong="H8147"\w* esclavos \w de|strong="H1121"\w* Simei \w se|strong="H1961"\w* escaparon y \w se|strong="H1961"\w* \w fueron|strong="H1961"\w* con Aquís \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maaca, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Gat. \w Cuando|strong="H1961"\w* le avisaron \w a|strong="H3068"\w* Simei \w que|strong="H1121"\w* sus esclavos \w estaban|strong="H1961"\w* en Gat,  
\v 40 él se \w levantó|strong="H6965"\w*, ensilló su burro y se \w fue|strong="H3212"\w* \w a|strong="H3068"\w* Gat para buscarlos. \w Fue|strong="H3212"\w* y los trajo de regreso.  
\v 41 \w Cuando|strong="H3588"\w* \w Salomón|strong="H8010"\w* se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* Simei \w había|strong="H3588"\w* salido \w de|strong="H3588"\w* Jerusalén \w para|strong="H3588"\w* \w ir|strong="H1980"\w* \w a|strong="H3068"\w* Gat \w y|strong="H3588"\w* \w que|strong="H3588"\w* ya estaba \w de|strong="H3588"\w* regreso,   
\p
\v 42 \w lo|strong="H1697"\w* \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w y|strong="H3588"\w* le dijo: “¿Acaso \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w hice|strong="H7650"\w* jurar \w por|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* \w te|strong="H3588"\w* advertí \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* salieras \w a|strong="H3068"\w* cualquier otra parte morirías \w sin|strong="H3808"\w* remedio?  
\v 43 ¿\w Por|strong="H5921"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* cumpliste \w el|strong="H5921"\w* \w juramento|strong="H7621"\w* \w que|strong="H3808"\w* \w le|strong="H5921"\w* hiciste \w a|strong="H3068"\w* Yahvé \w ni|strong="H3808"\w* obedeciste mis órdenes?”.  
\v 44 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* añadió: “\w Tú|strong="H6213"\w* \w sabes|strong="H3045"\w* muy bien \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w mal|strong="H7451"\w* \w que|strong="H3045"\w* le \w hiciste|strong="H6213"\w* \w a|strong="H3068"\w* mi padre \w David|strong="H1732"\w*. Ahora Yahvé \w hará|strong="H6213"\w* \w que|strong="H3045"\w* \w tu|strong="H6213"\w* propia \w maldad|strong="H7451"\w* recaiga sobre ti.  
\v 45 \w En|strong="H5704"\w* cambio, el \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w será|strong="H1961"\w* bendecido \w y|strong="H5704"\w* el \w trono|strong="H3678"\w* \w de|strong="H6440"\w* \w David|strong="H1732"\w* \w quedará|strong="H1961"\w* \w firme|strong="H3559"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w ante|strong="H6440"\w* Yahvé”.  
\v 46 Entonces \w el|strong="H1121"\w* \w rey|strong="H4428"\w* le dio una \w orden|strong="H6680"\w* \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joyadá, y este fue y \w mató|strong="H4191"\w* \w a|strong="H3068"\w* Simei. Así \w el|strong="H1121"\w* \w reino|strong="H4467"\w* quedó bajo \w el|strong="H1121"\w* control total \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*.   
\c 3  
\p
\v 1 \w Salomón|strong="H8010"\w* \w hizo|strong="H1129"\w* una alianza matrimonial \w con|strong="H5704"\w* el \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Egipto|strong="H4714"\w*. Se \w casó|strong="H3947"\w* \w con|strong="H5704"\w* la \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w* \w y|strong="H5704"\w* la \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w* \w mientras|strong="H5704"\w* terminaba \w de|strong="H5704"\w* construir su propio palacio, el \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé \w y|strong="H5704"\w* la muralla \w alrededor|strong="H5439"\w* \w de|strong="H5704"\w* Jerusalén.  
\v 2 \w En|strong="H5704"\w* ese \w tiempo|strong="H3117"\w*, \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* todavía \w ofrecía|strong="H2076"\w* \w sacrificios|strong="H2076"\w* \w en|strong="H5704"\w* \w los|strong="H1992"\w* \w altares|strong="H1116"\w* \w de|strong="H3588"\w* \w las|strong="H1992"\w* colinas, \w porque|strong="H3588"\w* \w aún|strong="H5704"\w* \w no|strong="H3808"\w* \w se|strong="H1992"\w* \w había|strong="H3588"\w* construido un \w templo|strong="H1004"\w* \w en|strong="H5704"\w* honor \w al|strong="H5704"\w* \w nombre|strong="H8034"\w* \w de|strong="H3588"\w* Yahvé.  
\v 3 \w Salomón|strong="H8010"\w* amaba \w a|strong="H3068"\w* Yahvé y seguía las instrucciones de \w su|strong="H1931"\w* padre \w David|strong="H1732"\w*; sin embargo, \w él|strong="H1931"\w* también \w ofrecía|strong="H2076"\w* \w sacrificios|strong="H2076"\w* y quemaba incienso \w en|strong="H3212"\w* \w los|strong="H1931"\w* \w altares|strong="H1116"\w* de las colinas.  
\v 4 \w El|strong="H1931"\w* \w rey|strong="H4428"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Gabaón|strong="H1391"\w* \w para|strong="H5921"\w* ofrecer \w sacrificios|strong="H2076"\w*, \w porque|strong="H3588"\w* \w ese|strong="H1931"\w* \w era|strong="H1931"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w más|strong="H3588"\w* importante. \w Allí|strong="H8033"\w* \w Salomón|strong="H8010"\w* \w ofreció|strong="H2076"\w* mil \w holocaustos|strong="H5930"\w*.  
\v 5 Esa \w noche|strong="H3915"\w*, en \w Gabaón|strong="H1391"\w*, Yahvé \w se|strong="H4100"\w* le \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w* en un \w sueño|strong="H2472"\w* y \w Dios|strong="H3068"\w* le dijo: “\w Pídeme|strong="H7592"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* quieras \w que|strong="H4100"\w* yo te \w dé|strong="H5414"\w*”.   
\p
\v 6 \w Salomón|strong="H8010"\w* respondió: “Usted mostró un \w gran|strong="H1419"\w* amor \w por|strong="H5921"\w* su servidor \w David|strong="H1732"\w*, \w mi|strong="H5921"\w* padre, \w porque|strong="H5921"\w* \w él|strong="H5921"\w* \w se|strong="H5921"\w* condujo \w delante|strong="H6440"\w* \w de|strong="H5921"\w* usted \w con|strong="H5973"\w* verdad, \w justicia|strong="H6666"\w* \w y|strong="H5921"\w* rectitud \w de|strong="H5921"\w* \w corazón|strong="H3824"\w*. Usted ha mantenido \w ese|strong="H2088"\w* \w gran|strong="H1419"\w* amor \w hacia|strong="H6213"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* ha concedido \w que|strong="H5921"\w* un \w hijo|strong="H1121"\w* suyo \w se|strong="H5921"\w* siente \w hoy|strong="H3117"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*.  
\v 7 \w Ahora|strong="H6258"\w*, Yahvé \w Dios|strong="H3068"\w* mío, usted me \w ha|strong="H3808"\w* puesto \w a|strong="H3068"\w* mí, su servidor, \w como|strong="H8478"\w* \w rey|strong="H4427"\w* \w en|strong="H3318"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* mi padre \w David|strong="H1732"\w*. Pero yo soy muy joven y \w no|strong="H3808"\w* \w sé|strong="H3045"\w* \w cómo|strong="H8478"\w* actuar.  
\v 8 Su servidor está aquí \w en|strong="H8432"\w* \w medio|strong="H8432"\w* del \w pueblo|strong="H5971"\w* \w que|strong="H3808"\w* usted eligió, un \w pueblo|strong="H5971"\w* tan \w numeroso|strong="H7227"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* puede \w contar|strong="H5608"\w* \w ni|strong="H3808"\w* calcular.  
\v 9 \w Por|strong="H3588"\w* eso, dele \w a|strong="H3068"\w* \w su|strong="H3588"\w* servidor un \w corazón|strong="H3820"\w* \w con|strong="H3588"\w* \w entendimiento|strong="H3820"\w* \w para|strong="H3588"\w* \w gobernar|strong="H8199"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w para|strong="H3588"\w* saber distinguir \w entre|strong="H3588"\w* \w el|strong="H3588"\w* \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w mal|strong="H7451"\w*. \w Porque|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* \w podrá|strong="H3201"\w* \w gobernar|strong="H8199"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w suyo|strong="H5971"\w* tan \w grande|strong="H3515"\w*?”.   
\p
\v 10 Al Señor \w le|strong="H5869"\w* \w agradó|strong="H3190"\w* \w que|strong="H3588"\w* \w Salomón|strong="H8010"\w* hubiera hecho \w esta|strong="H2088"\w* petición.  
\v 11 \w Por|strong="H3282"\w* eso Dios le dijo: “Como me has pedido \w esto|strong="H2088"\w*, y \w no|strong="H3808"\w* \w pediste|strong="H7592"\w* \w para|strong="H3282"\w* ti una \w vida|strong="H5315"\w* larga, \w ni|strong="H3808"\w* \w riquezas|strong="H6239"\w*, \w ni|strong="H3808"\w* la muerte \w de|strong="H1697"\w* tus enemigos, \w sino|strong="H3808"\w* entendimiento \w para|strong="H3282"\w* administrar \w justicia|strong="H4941"\w*,  
\v 12 voy \w a|strong="H3068"\w* concederte \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w has|strong="H5414"\w* pedido. Te \w daré|strong="H5414"\w* un \w corazón|strong="H3820"\w* \w sabio|strong="H2450"\w* y prudente, \w como|strong="H3644"\w* \w nadie|strong="H3808"\w* \w lo|strong="H1697"\w* \w ha|strong="H3808"\w* tenido \w antes|strong="H6440"\w* \w ni|strong="H3808"\w* \w lo|strong="H1697"\w* \w tendrá|strong="H1961"\w* \w después|strong="H1961"\w* \w de|strong="H6440"\w* ti.  
\v 13 \w También|strong="H1571"\w* te \w daré|strong="H5414"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w pediste|strong="H7592"\w*: \w riquezas|strong="H6239"\w* \w y|strong="H1571"\w* honor, \w de|strong="H5414"\w* modo \w que|strong="H3808"\w* en \w toda|strong="H3605"\w* tu \w vida|strong="H3117"\w* \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* \w entre|strong="H3808"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w nadie|strong="H3808"\w* \w como|strong="H1571"\w* tú.  
\v 14 \w Y|strong="H3068"\w* si sigues mis \w caminos|strong="H1870"\w* y cumples mis leyes y \w mandamientos|strong="H4687"\w*, como lo hizo tu padre \w David|strong="H1732"\w*, yo te daré una \w vida|strong="H3117"\w* larga”.   
\p
\v 15 \w Cuando|strong="H5650"\w* \w Salomón|strong="H8010"\w* \w despertó|strong="H3364"\w*, se dio cuenta \w de|strong="H6440"\w* \w que|strong="H3605"\w* \w había|strong="H5975"\w* sido un \w sueño|strong="H2472"\w*. Regresó \w a|strong="H3068"\w* Jerusalén, se presentó \w ante|strong="H6440"\w* \w el|strong="H3605"\w* arca del \w pacto|strong="H1285"\w* del Señor, \w ofreció|strong="H6213"\w* \w holocaustos|strong="H5930"\w* y sacrificios \w de|strong="H6440"\w* paz, y dio un \w banquete|strong="H4960"\w* para \w todos|strong="H3605"\w* sus servidores.   
\p
\v 16 Tiempo después, \w dos|strong="H8147"\w* prostitutas fueron \w a|strong="H3068"\w* presentarse \w ante|strong="H6440"\w* el \w rey|strong="H4428"\w*.  
\v 17 Una \w de|strong="H5973"\w* ellas dijo: “Señor mío, \w esta|strong="H2063"\w* mujer y yo vivimos \w en|strong="H5973"\w* \w la|strong="H2063"\w* misma \w casa|strong="H1004"\w*. Yo tuve un \w hijo|strong="H3205"\w* \w estando|strong="H3427"\w* ella allí \w conmigo|strong="H5973"\w*.  
\v 18 Tres \w días|strong="H3117"\w* \w después|strong="H1961"\w* \w de|strong="H2108"\w* \w mi|strong="H1961"\w* parto, ella \w también|strong="H1571"\w* dio \w a|strong="H3068"\w* luz. Estábamos solas; \w no|strong="H1961"\w* \w había|strong="H1961"\w* nadie \w más|strong="H1571"\w* \w con|strong="H1571"\w* nosotras en \w la|strong="H1571"\w* \w casa|strong="H1004"\w*.  
\v 19 Pero una \w noche|strong="H3915"\w*, \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* mujer \w murió|strong="H4191"\w* \w porque|strong="H5921"\w* \w ella|strong="H5921"\w* \w se|strong="H5921"\w* acostó \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 20 Entonces ella se \w levantó|strong="H6965"\w* \w a|strong="H3068"\w* medianoche, mientras yo dormía, y me \w quitó|strong="H3947"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* \w estaba|strong="H7901"\w* \w a|strong="H3068"\w* mi lado. Lo puso \w en|strong="H8432"\w* su cama y puso \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w muerto|strong="H4191"\w* junto \w a|strong="H3068"\w* mí.  
\v 21 \w Cuando|strong="H1961"\w* me levanté por la \w mañana|strong="H1242"\w* \w para|strong="H1961"\w* amamantar \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w hijo|strong="H1121"\w*, vi \w que|strong="H3808"\w* \w estaba|strong="H1961"\w* \w muerto|strong="H4191"\w*. Pero al fijarme bien con la luz del \w día|strong="H1121"\w*, me di cuenta \w de|strong="H1121"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w era|strong="H1961"\w* \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w que|strong="H3808"\w* \w yo|strong="H2009"\w* \w había|strong="H1961"\w* tenido”.   
\p
\v 22 \w Pero|strong="H3588"\w* \w la|strong="H3588"\w* otra mujer \w dijo|strong="H1696"\w*: “¡\w No|strong="H3808"\w*! \w El|strong="H3588"\w* niño \w que|strong="H3588"\w* \w vive|strong="H2416"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* mío, \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w muerto|strong="H4191"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* tuyo”.  
\p \w Y|strong="H3068"\w* \w la|strong="H3588"\w* primera insistía: “¡\w No|strong="H3808"\w*! \w El|strong="H3588"\w* \w muerto|strong="H4191"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* tuyo, \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w vive|strong="H2416"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* mío”. \w Así|strong="H2063"\w* discutían \w delante|strong="H6440"\w* del \w rey|strong="H4428"\w*.   
\p
\v 23 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* dijo: “Una dice: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* mi \w hijo|strong="H1121"\w*, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w está|strong="H2063"\w* \w vivo|strong="H2416"\w*; \w el|strong="H3588"\w* tuyo \w es|strong="H2088"\w* \w el|strong="H3588"\w* \w muerto|strong="H4191"\w*”. \w La|strong="H2063"\w* otra dice: “\w No|strong="H3808"\w*, tu \w hijo|strong="H1121"\w* \w es|strong="H2088"\w* \w el|strong="H3588"\w* \w muerto|strong="H4191"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* mío \w es|strong="H2088"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w vive|strong="H2416"\w*””.   
\p
\v 24 Entonces el \w rey|strong="H4428"\w* ordenó: “Tráiganme una \w espada|strong="H2719"\w*”.  
\p \w Y|strong="H3068"\w* le \w llevaron|strong="H3947"\w* una \w espada|strong="H2719"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.   
\p
\v 25 Luego dijo: “Partan \w al|strong="H4428"\w* niño \w vivo|strong="H2416"\w* en \w dos|strong="H8147"\w*, y denle la mitad \w a|strong="H3068"\w* una y la otra mitad \w a|strong="H3068"\w* la otra”.   
\p
\v 26 \w Entonces|strong="H3588"\w* \w la|strong="H5921"\w* madre \w del|strong="H5921"\w* niño \w vivo|strong="H2416"\w*, conmovida profundamente \w por|strong="H5921"\w* \w el|strong="H5921"\w* amor \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*, \w le|strong="H5921"\w* suplicó \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “¡\w Por|strong="H5921"\w* favor, \w mi|strong="H5921"\w* señor! Dele \w a|strong="H3068"\w* \w ella|strong="H5921"\w* \w el|strong="H5921"\w* niño \w vivo|strong="H2416"\w*, ¡\w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w mate|strong="H4191"\w*!”.  
\p \w Pero|strong="H3588"\w* \w la|strong="H5921"\w* otra decía: “\w Ni|strong="H3808"\w* \w para|strong="H5921"\w* \w mí|strong="H5921"\w* \w ni|strong="H3808"\w* \w para|strong="H5921"\w* \w ti|strong="H5921"\w*. ¡\w Que|strong="H3588"\w* \w lo|strong="H3808"\w* partan!”.   
\p
\v 27 Entonces \w el|strong="H1931"\w* \w rey|strong="H4428"\w* decidió: “Entréguenle \w el|strong="H1931"\w* niño \w vivo|strong="H2416"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* primera mujer. \w No|strong="H3808"\w* \w lo|strong="H1931"\w* maten, \w porque|strong="H3808"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* verdadera madre”.   
\p
\v 28 \w Todo|strong="H3605"\w* \w Israel|strong="H3478"\w* se enteró \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w sentencia|strong="H4941"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w había|strong="H3588"\w* dictado, \w y|strong="H3588"\w* sintieron un gran respeto \w por|strong="H3588"\w* \w él|strong="H3588"\w*, \w pues|strong="H3588"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* Dios le \w había|strong="H3588"\w* dado \w sabiduría|strong="H2451"\w* \w para|strong="H3588"\w* impartir \w justicia|strong="H4941"\w*.   
\c 4  
\p
\v 1 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* gobernó \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 2 Estos eran sus altos funcionarios: \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sadoc|strong="H6659"\w* \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w sacerdote|strong="H3548"\w*;  
\v 3 Elihoref y Ahías, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Sisa, eran secretarios; Josafat \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahilud \w era|strong="H1121"\w* \w el|strong="H1121"\w* historiador;  
\v 4 \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Joyadá estaba \w al|strong="H5921"\w* mando \w del|strong="H5921"\w* \w ejército|strong="H6635"\w*; \w Sadoc|strong="H6659"\w* \w y|strong="H5921"\w* Abiatar eran \w sacerdotes|strong="H3548"\w*;  
\v 5 \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Natán \w era|strong="H1121"\w* \w el|strong="H5921"\w* jefe \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w gobernadores|strong="H5324"\w* distritales; \w Zabud|strong="H2071"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Natán \w era|strong="H1121"\w* \w sacerdote|strong="H3548"\w* \w y|strong="H5921"\w* consejero personal \w del|strong="H5921"\w* \w rey|strong="H4428"\w*;  
\v 6 Ahisar \w estaba|strong="H1004"\w* \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* palacio; \w y|strong="H5921"\w* Adoniram \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Abda dirigía \w el|strong="H5921"\w* trabajo obligatorio.   
\p
\v 7 \w Salomón|strong="H8010"\w* nombró \w a|strong="H3068"\w* \w doce|strong="H8147"\w* \w gobernadores|strong="H5324"\w* distritales \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* abastecer \w de|strong="H5921"\w* comida \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su \w familia|strong="H1004"\w*. \w Cada|strong="H3605"\w* uno \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w era|strong="H1961"\w* responsable \w de|strong="H5921"\w* proveer \w los|strong="H5921"\w* alimentos durante un \w mes|strong="H2320"\w* \w al|strong="H5921"\w* \w año|strong="H8141"\w*.  
\v 8 Estos son sus \w nombres|strong="H8034"\w*: Ben Jur, en la región montañosa de Efraín;  
\v 9 Ben Dequer, en Macaz, Saalbim, Bet Semes y Elón de Bet Janán;  
\v 10 Ben Jésed, en Arubot, incluyendo Soco y \w toda|strong="H3605"\w* \w la|strong="H3605"\w* región de Jéfer;  
\v 11 Ben Abinadab, en \w toda|strong="H3605"\w* \w la|strong="H3605"\w* provincia de \w Dor|strong="H1756"\w* (\w él|strong="H3605"\w* \w estaba|strong="H1961"\w* casado con Tafat, \w hija|strong="H1323"\w* de \w Salomón|strong="H8010"\w*);  
\v 12 Baaná \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* Ahilud, \w en|strong="H5704"\w* Taanac, Meguido \w y|strong="H5704"\w* \w toda|strong="H3605"\w* Bet Seán, \w que|strong="H5704"\w* está junto \w a|strong="H3068"\w* Saretán, \w abajo|strong="H8478"\w* \w de|strong="H8478"\w* \w Jezreel|strong="H3157"\w*, \w desde|strong="H5704"\w* Bet Seán \w hasta|strong="H5704"\w* Abel Mejolá \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w más|strong="H5704"\w* allá \w de|strong="H8478"\w* Jocmeam;  
\v 13 Ben Guéber, en Ramot \w de|strong="H1121"\w* \w Galaad|strong="H1568"\w* (incluyendo \w los|strong="H1121"\w* campamentos \w de|strong="H1121"\w* \w Jair|strong="H2971"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* en \w Galaad|strong="H1568"\w* y la región \w de|strong="H1121"\w* Argob en \w Basán|strong="H1316"\w*, con sus \w sesenta|strong="H8346"\w* \w ciudades|strong="H5892"\w* \w grandes|strong="H1419"\w*, amuralladas y con \w cerrojos|strong="H1280"\w* \w de|strong="H1121"\w* bronce);  
\v 14 Ahinadab \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Idó, en \w Mahanaim|strong="H4266"\w*;  
\v 15 Ahimaas, en Neftalí (\w él|strong="H1931"\w* \w se|strong="H1931"\w* \w casó|strong="H3947"\w* \w con|strong="H1571"\w* Basemat, \w hija|strong="H1323"\w* de \w Salomón|strong="H8010"\w*);  
\v 16 Baaná \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jusay, en Aser y en Bealot;  
\v 17 Josafat \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Parúa, en Isacar;  
\v 18 Simei \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Elá, en \w Benjamín|strong="H1144"\w*;  
\v 19 Guéber \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Urí, en la región \w de|strong="H1121"\w* \w Galaad|strong="H1568"\w*, \w el|strong="H1121"\w* territorio \w de|strong="H1121"\w* Sejón, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amorreos, y \w de|strong="H1121"\w* \w Og|strong="H5747"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Basán|strong="H1316"\w*. \w Él|strong="H1121"\w* \w era|strong="H1121"\w* \w el|strong="H1121"\w* único gobernador en esa región.   
\p
\v 20 \w La|strong="H5921"\w* población \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* era tan numerosa \w como|strong="H5921"\w* \w la|strong="H5921"\w* arena \w del|strong="H5921"\w* \w mar|strong="H3220"\w*; \w todos|strong="H7230"\w* vivían felices, comiendo \w y|strong="H5921"\w* \w bebiendo|strong="H8354"\w*.  
\v 21 Salomón gobernaba todos los reinos desde el río Éufrates hasta la tierra de los filisteos y la frontera con Egipto. Estos reinos le pagaban impuestos y estuvieron bajo su dominio mientras él vivió.  
\v 22 Las provisiones diarias para el palacio de Salomón eran: seis mil seiscientos kilos de harina fina y trece mil doscientos kilos de harina corriente;  
\v 23 diez bueyes de los más gordos, veinte bueyes de pasto y cien ovejas, además de ciervos, gacelas, corzos y aves de corral bien engordadas.  
\v 24 El dominio de Salomón se extendía sobre todos los reinos al oeste del Éufrates, desde Tifsa hasta Gaza, y disfrutaba de paz en todas sus fronteras.  
\v 25 Durante el reinado de Salomón, todos los habitantes de Judá \w e|strong="H3068"\w* Israel, desde Dan hasta Beerseba, vivieron seguros, cada uno disfrutando de su propio viñedo y de su propia higuera.  
\v 26 Salomón tenía cuatro mil establos para los caballos de sus carros, y doce mil jinetes.  
\v 27 Los gobernadores distritales abastecían al rey Salomón y \w a|strong="H3068"\w* todos los que se sentaban \w a|strong="H3068"\w* su mesa, cada uno en el mes que le correspondía, asegurándose de que no faltara nada.  
\v 28 También llevaban cebada y paja para los caballos de los carros y para los caballos de paso, entregándolas donde se necesitaba, según su turno.  
\v 29 Dios le dio \w a|strong="H3068"\w* Salomón una sabiduría y una inteligencia excepcionales, y un conocimiento tan vasto como la arena del mar.  
\v 30 La sabiduría de Salomón era superior \w a|strong="H3068"\w* la de todos los sabios del oriente y de Egipto.  
\v 31 Fue el hombre más sabio de su época, más que Etán el ezraíta, y más que Hemán, Calcol y Dardá, los hijos de Mahol. Su fama se extendió por todas las naciones vecinas.  
\v 32 Compuso tres mil proverbios y escribió mil cinco canciones.  
\v 33 Podía hablar con autoridad sobre las plantas, desde el cedro del Líbano hasta el hisopo que crece en las grietas de los muros. También enseñaba sobre los animales, las aves, los reptiles y los peces.  
\v 34 De todas las naciones venían personas para escuchar la sabiduría de Salomón, enviados por los reyes de todo el mundo que habían oído hablar de su inteligencia.   
\c 5  
\p
\v 1 Hiram, rey \w de|strong="H4480"\w* Tiro, \w siempre|strong="H3605"\w* \w había|strong="H1961"\w* \w sido|strong="H1961"\w* amigo \w de|strong="H4480"\w* David. \w Por|strong="H4480"\w* eso, \w cuando|strong="H3117"\w* supo \w que|strong="H4480"\w* \w Salomón|strong="H8010"\w* \w había|strong="H1961"\w* \w sido|strong="H1961"\w* ungido rey \w para|strong="H5704"\w* suceder \w a|strong="H3068"\w* su padre, le envió \w a|strong="H3068"\w* sus servidores.  
\v 2 \w Entonces|strong="H3117"\w* \w Salomón|strong="H8010"\w* le mandó \w este|strong="H1961"\w* mensaje \w a|strong="H3068"\w* Hiram:  
\v 3 “Usted sabe que mi padre David no pudo construir un templo en honor al nombre de Yahvé su Dios, debido \w a|strong="H3068"\w* las guerras en que se vio envuelto por todas partes, hasta que Yahvé puso \w a|strong="H3068"\w* sus enemigos bajo su dominio.  
\v 4 \w Pero|strong="H3588"\w* ahora Yahvé \w mi|strong="H1961"\w* Dios \w me|strong="H3588"\w* ha dado \w paz|strong="H7965"\w* \w por|strong="H3588"\w* \w todos|strong="H3605"\w* \w lados|strong="H5676"\w*; \w no|strong="H3588"\w* tengo enemigos \w ni|strong="H5704"\w* problemas \w a|strong="H3068"\w* \w la|strong="H1931"\w* vista.  
\v 5 \w Por|strong="H8478"\w* \w lo|strong="H5704"\w* tanto, me he propuesto construir un templo \w en|strong="H5704"\w* honor \w al|strong="H5704"\w* nombre \w de|strong="H8478"\w* Yahvé mi Dios, tal \w como|strong="H5704"\w* Yahvé se \w lo|strong="H5704"\w* prometió \w a|strong="H3068"\w* mi padre David \w cuando|strong="H3117"\w* le dijo: “Tu hijo, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* yo \w pondré|strong="H3427"\w* \w en|strong="H5704"\w* \w el|strong="H3605"\w* trono \w para|strong="H5704"\w* \w que|strong="H5704"\w* te suceda, será \w quien|strong="H3605"\w* construya \w el|strong="H3605"\w* templo \w en|strong="H5704"\w* mi honor”.  
\v 6 Por eso, le pido \w que|strong="H1961"\w* ordene \w a|strong="H3068"\w* sus trabajadores \w que|strong="H1961"\w* corten \w para|strong="H1961"\w* \w mí|strong="H1961"\w* cedros del Líbano. Mis servidores trabajarán junto con \w los|strong="H1961"\w* de usted, y yo le pagaré \w a|strong="H3068"\w* sus trabajadores el salario \w que|strong="H1961"\w* usted me pida. \w Como|strong="H1961"\w* usted sabe, nadie entre \w nosotros|strong="H8147"\w* sabe cortar madera tan bien \w como|strong="H1961"\w* \w los|strong="H1961"\w* de Sidón”.   
\p
\v 7 Cuando Hiram escuchó \w el|strong="H3605"\w* mensaje \w de|strong="H1697"\w* \w Salomón|strong="H8010"\w*, \w se|strong="H3808"\w* puso muy feliz y exclamó: “¡Bendito sea hoy Yahvé, \w que|strong="H3808"\w* le dio \w a|strong="H3068"\w* \w David|strong="H4428"\w* un hijo sabio para gobernar \w a|strong="H3068"\w* \w esta|strong="H5324"\w* gran nación!”.  
\v 8 Luego Hiram le mandó decir \w a|strong="H3068"\w* Salomón: “He recibido su mensaje. Haré todo lo \w que|strong="H1961"\w* me pide en cuanto \w a|strong="H3068"\w* la madera de cedro y de pino.  
\v 9 \w Mis|strong="H5414"\w* trabajadores bajarán \w los|strong="H5921"\w* troncos \w desde|strong="H5921"\w* \w el|strong="H5921"\w* Líbano \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*. Yo \w los|strong="H5921"\w* \w haré|strong="H5414"\w* amarrar \w para|strong="H5921"\w* formar balsas \w y|strong="H5921"\w* \w las|strong="H5921"\w* llevaré \w por|strong="H5921"\w* \w mar|strong="H3220"\w* \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* lugar \w que|strong="H5921"\w* usted \w me|strong="H5921"\w* indique. Allí \w las|strong="H5921"\w* soltaré \w para|strong="H5921"\w* \w que|strong="H5921"\w* usted \w se|strong="H5921"\w* \w haga|strong="H5414"\w* cargo \w de|strong="H5921"\w* \w ellas|strong="H5921"\w*. \w A|strong="H3068"\w* cambio, usted cumplirá \w mi|strong="H5921"\w* deseo \w de|strong="H5921"\w* proveer alimentos \w para|strong="H5921"\w* \w mi|strong="H5921"\w* familia”.   
\p
\v 10 Así \w que|strong="H1121"\w* Hiram le entregó \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w* \w toda|strong="H3605"\w* \w la|strong="H2451"\w* madera \w de|strong="H1121"\w* cedro y \w de|strong="H1121"\w* pino \w que|strong="H1121"\w* \w él|strong="H3605"\w* quiso.  
\v 11 Salomón, por su parte, le entregaba \w a|strong="H3068"\w* Hiram cuatro millones \w de|strong="H1121"\w* kilos \w de|strong="H1121"\w* trigo y cuatrocientos mil litros \w de|strong="H1121"\w* aceite \w de|strong="H1121"\w* oliva puro \w cada|strong="H3605"\w* año, \w para|strong="H1961"\w* \w el|strong="H3605"\w* sustento \w de|strong="H1121"\w* su familia.  
\v 12 Yahvé le dio sabiduría \w a|strong="H3068"\w* Salomón, tal \w como|strong="H1961"\w* \w se|strong="H1961"\w* lo \w había|strong="H1961"\w* prometido. Entre Hiram y Salomón \w hubo|strong="H1961"\w* paz y ambos firmaron un tratado.   
\p
\v 13 \w El|strong="H5921"\w* rey Salomón reclutó \w a|strong="H3068"\w* treinta mil trabajadores \w de|strong="H4480"\w* todo Israel.  
\v 14 \w Los|strong="H3605"\w* enviaba \w al|strong="H4428"\w* Líbano en grupos \w de|strong="H5971"\w* diez mil \w por|strong="H4428"\w* mes; pasaban un mes en \w el|strong="H3605"\w* Líbano y dos meses en su casa. Adoniram estaba \w a|strong="H3068"\w* cargo \w de|strong="H5971"\w* este grupo \w de|strong="H5971"\w* trabajadores.  
\v 15 \w Salomón|strong="H8010"\w* también \w tenía|strong="H1961"\w* \w a|strong="H3068"\w* setenta mil hombres transportando materiales \w y|strong="H3588"\w* \w a|strong="H3068"\w* ochenta mil cortadores \w de|strong="H3588"\w* piedra \w en|strong="H3588"\w* \w la|strong="H3588"\w* región montañosa.  
\v 16 Además de estos, había tres mil trescientos capataces que dirigían \w a|strong="H3068"\w* los trabajadores y supervisaban la obra.  
\v 17 \w Por|strong="H3588"\w* orden del rey, extrajeron grandes bloques \w de|strong="H3588"\w* piedra \w de|strong="H3588"\w* \w la|strong="H3588"\w* mejor calidad \w para|strong="H5704"\w* \w poner|strong="H5414"\w* \w los|strong="H3588"\w* cimientos del \w templo|strong="H1004"\w* \w con|strong="H3588"\w* piedras talladas.  
\v 18 Los constructores \w de|strong="H7451"\w* Salomón, los \w de|strong="H7451"\w* Hiram y los hombres \w de|strong="H7451"\w* Biblos tallaron las piedras y prepararon la madera y el material \w para|strong="H6258"\w* construir el templo.   
\c 6  
\p
\v 1 Cuatrocientos \w ochenta|strong="H8084"\w* \w años|strong="H8141"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w que|strong="H1931"\w* \w los|strong="H1121"\w* israelitas \w salieron|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w reinado|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H5921"\w* ziv (\w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w* \w del|strong="H5921"\w* \w año|strong="H8141"\w*), \w Salomón|strong="H8010"\w* comenzó \w a|strong="H3068"\w* construir \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 2 El \w templo|strong="H1004"\w* que el \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* construyó para Yahvé medía \w veintisiete|strong="H6242"\w* metros de largo, nueve de ancho y trece y medio de alto.  
\v 3 \w El|strong="H5921"\w* vestíbulo \w que|strong="H5921"\w* \w estaba|strong="H1004"\w* frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* nave central \w del|strong="H5921"\w* \w templo|strong="H1964"\w* medía nueve metros \w de|strong="H5921"\w* largo, \w lo|strong="H5921"\w* mismo \w que|strong="H5921"\w* \w el|strong="H5921"\w* ancho \w del|strong="H5921"\w* \w templo|strong="H1964"\w*, \w y|strong="H5921"\w* cuatro metros \w y|strong="H5921"\w* medio \w de|strong="H5921"\w* fondo.  
\v 4 Al \w templo|strong="H1004"\w* le \w hizo|strong="H6213"\w* \w ventanas|strong="H2474"\w* con rejillas fijas.  
\v 5 \w Contra|strong="H5921"\w* \w las|strong="H5921"\w* paredes exteriores \w de|strong="H5921"\w* \w la|strong="H5921"\w* nave central \w y|strong="H5921"\w* \w del|strong="H5921"\w* santuario interior, Salomón construyó una estructura \w de|strong="H5921"\w* varios pisos \w con|strong="H5921"\w* habitaciones laterales \w todo|strong="H5439"\w* \w alrededor|strong="H5439"\w*.  
\v 6 \w El|strong="H3588"\w* piso inferior medía dos metros \w con|strong="H3588"\w* veinte \w de|strong="H3588"\w* ancho, \w el|strong="H3588"\w* piso intermedio dos metros \w con|strong="H3588"\w* setenta, \w y|strong="H3588"\w* \w el|strong="H3588"\w* tercer piso tres metros \w con|strong="H3588"\w* \w diez|strong="H7651"\w*. \w En|strong="H3588"\w* \w la|strong="H3588"\w* parte exterior \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w pared|strong="H7023"\w* del \w templo|strong="H1004"\w* se \w hicieron|strong="H5414"\w* salientes \w para|strong="H3588"\w* \w que|strong="H3588"\w* las vigas \w de|strong="H3588"\w* \w los|strong="H3588"\w* pisos \w no|strong="H3588"\w* se empotraran \w en|strong="H3588"\w* las paredes del \w templo|strong="H1004"\w*.  
\v 7 Para \w la|strong="H3605"\w* construcción del \w templo|strong="H1004"\w* \w se|strong="H3808"\w* usaron bloques de piedra ya tallados desde \w la|strong="H3605"\w* cantera; por eso, \w mientras|strong="H3605"\w* \w se|strong="H3808"\w* construía, \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w escuchó|strong="H8085"\w* \w el|strong="H3605"\w* ruido de martillos, hachas \w ni|strong="H3808"\w* de \w ninguna|strong="H3605"\w* otra \w herramienta|strong="H3627"\w* de \w hierro|strong="H1270"\w*.  
\v 8 \w La|strong="H5921"\w* entrada \w al|strong="H5921"\w* piso inferior \w estaba|strong="H1004"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w lado|strong="H3802"\w* sur \w del|strong="H4480"\w* \w templo|strong="H1004"\w*. Una escalera \w de|strong="H4480"\w* caracol llevaba \w al|strong="H5921"\w* piso intermedio, \w y|strong="H5921"\w* otra \w al|strong="H5921"\w* tercer piso.  
\v 9 Así Salomón terminó de construir el \w templo|strong="H1004"\w* y lo techó con vigas y tablas de cedro.  
\v 10 \w Las|strong="H5921"\w* habitaciones laterales \w que|strong="H5921"\w* construyó \w alrededor|strong="H5921"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* tenían dos metros \w con|strong="H5921"\w* veinte \w de|strong="H5921"\w* alto \w y|strong="H5921"\w* estaban unidas \w al|strong="H5921"\w* \w edificio|strong="H1004"\w* principal \w con|strong="H5921"\w* vigas \w de|strong="H5921"\w* cedro.   
\p
\v 11 Entonces Yahvé le dijo \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*:  
\v 12 “\w En|strong="H3212"\w* cuanto \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H1697"\w* me \w estás|strong="H2088"\w* construyendo: si sigues mis leyes, obedeces mis decretos y cumples \w todos|strong="H3605"\w* mis \w mandamientos|strong="H4687"\w*, \w yo|strong="H6213"\w* cumpliré \w por|strong="H1697"\w* medio \w de|strong="H1697"\w* ti \w la|strong="H8104"\w* promesa \w que|strong="H1697"\w* le \w hice|strong="H6213"\w* \w a|strong="H3068"\w* \w tu|strong="H6213"\w* padre \w David|strong="H1732"\w*.  
\v 13 Viviré \w entre|strong="H8432"\w* \w los|strong="H1121"\w* israelitas y \w nunca|strong="H3808"\w* \w abandonaré|strong="H5800"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 14 \w Salomón|strong="H8010"\w* terminó de construir el \w templo|strong="H1004"\w*.  
\v 15 Forró las paredes interiores \w con|strong="H5704"\w* tablas \w de|strong="H5704"\w* cedro, cubriéndolas \w desde|strong="H5704"\w* el suelo \w hasta|strong="H5704"\w* el techo; el piso \w lo|strong="H5704"\w* \w cubrió|strong="H6823"\w* \w con|strong="H5704"\w* tablas \w de|strong="H5704"\w* pino.  
\v 16 \w En|strong="H4480"\w* la parte posterior \w del|strong="H4480"\w* \w templo|strong="H1004"\w* reservó un espacio \w de|strong="H4480"\w* nueve metros \w de|strong="H4480"\w* largo \w y|strong="H5704"\w* \w lo|strong="H5704"\w* forró \w de|strong="H4480"\w* cedro, \w del|strong="H4480"\w* suelo \w al|strong="H4480"\w* techo, \w para|strong="H5704"\w* instalar allí el \w santuario|strong="H6944"\w* interior, es decir, el Lugar \w Santísimo|strong="H6944"\w*.  
\v 17 \w La|strong="H1931"\w* nave central \w que|strong="H1931"\w* \w estaba|strong="H1961"\w* frente al santuario medía dieciocho metros de largo.  
\v 18 Por dentro, \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w estaba|strong="H1004"\w* \w todo|strong="H3605"\w* forrado de cedro con tallas de \w figuras|strong="H4734"\w* de calabazas y flores abiertas. No se \w veía|strong="H7200"\w* \w nada|strong="H3605"\w* de piedra; \w todo|strong="H3605"\w* era madera de cedro.  
\v 19 Salomón \w preparó|strong="H3559"\w* el santuario interior \w en|strong="H8432"\w* el centro del \w templo|strong="H1004"\w* \w para|strong="H5414"\w* \w poner|strong="H5414"\w* \w allí|strong="H8033"\w* el arca del \w pacto|strong="H1285"\w* \w de|strong="H5414"\w* Yahvé.  
\v 20 Este santuario interior medía \w veinte|strong="H6242"\w* metros \w de|strong="H6440"\w* largo, \w veinte|strong="H6242"\w* \w de|strong="H6440"\w* ancho y \w veinte|strong="H6242"\w* \w de|strong="H6440"\w* alto. Lo recubrió \w de|strong="H6440"\w* \w oro|strong="H2091"\w* \w puro|strong="H5462"\w* y también \w cubrió|strong="H6823"\w* \w de|strong="H6440"\w* \w oro|strong="H2091"\w* el \w altar|strong="H4196"\w* \w de|strong="H6440"\w* cedro.  
\v 21 Después \w de|strong="H6440"\w* recubrir \w de|strong="H6440"\w* \w oro|strong="H2091"\w* \w puro|strong="H5462"\w* todo \w el|strong="H5674"\w* interior del \w templo|strong="H1004"\w*, \w Salomón|strong="H8010"\w* puso cadenas \w de|strong="H6440"\w* \w oro|strong="H2091"\w* frente al santuario interior, \w el|strong="H5674"\w* cual también \w estaba|strong="H1004"\w* recubierto \w de|strong="H6440"\w* \w oro|strong="H2091"\w*.  
\v 22 Así \w que|strong="H5704"\w* recubrió \w de|strong="H5704"\w* \w oro|strong="H2091"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* interior \w del|strong="H4196"\w* \w templo|strong="H1004"\w*, \w de|strong="H5704"\w* principio \w a|strong="H3068"\w* fin, \w lo|strong="H5704"\w* \w mismo|strong="H3605"\w* \w que|strong="H5704"\w* \w el|strong="H3605"\w* \w altar|strong="H4196"\w* \w que|strong="H5704"\w* \w estaba|strong="H1004"\w* \w en|strong="H5704"\w* \w el|strong="H3605"\w* santuario interior.   
\p
\v 23 Dentro del santuario interior \w hizo|strong="H6213"\w* \w dos|strong="H8147"\w* \w querubines|strong="H3742"\w* de \w madera|strong="H6086"\w* de olivo, \w cada|strong="H6235"\w* uno de cuatro metros y medio de alto.  
\v 24 \w Cada|strong="H6235"\w* una \w de|strong="H5704"\w* las \w alas|strong="H3671"\w* \w de|strong="H5704"\w* los \w querubines|strong="H3742"\w* medía dos metros \w con|strong="H5704"\w* veinte, \w de|strong="H5704"\w* modo \w que|strong="H5704"\w* había cuatro metros \w y|strong="H5704"\w* medio \w desde|strong="H5704"\w* la punta \w de|strong="H5704"\w* una \w de|strong="H5704"\w* las \w alas|strong="H3671"\w* \w hasta|strong="H5704"\w* la punta \w de|strong="H5704"\w* la \w otra|strong="H8145"\w*.  
\v 25 El \w segundo|strong="H8145"\w* \w querubín|strong="H3742"\w* medía lo mismo que el primero; los \w dos|strong="H8147"\w* tenían el mismo tamaño y la misma forma.  
\v 26 La \w altura|strong="H6967"\w* de ambos era de cuatro metros y medio.  
\v 27 Salomón \w puso|strong="H5414"\w* los \w querubines|strong="H3742"\w* \w en|strong="H8432"\w* el santuario \w interior|strong="H6442"\w* \w con|strong="H5060"\w* las \w alas|strong="H3671"\w* \w extendidas|strong="H6566"\w*. El \w ala|strong="H3671"\w* \w de|strong="H5414"\w* un \w querubín|strong="H3742"\w* \w tocaba|strong="H5060"\w* una \w pared|strong="H7023"\w* y el \w ala|strong="H3671"\w* del \w otro|strong="H8145"\w* \w tocaba|strong="H5060"\w* la \w pared|strong="H7023"\w* opuesta, mientras que las otras dos \w alas|strong="H3671"\w* se tocaban \w entre|strong="H8432"\w* sí \w en|strong="H8432"\w* el centro del santuario.  
\v 28 También estos \w querubines|strong="H3742"\w* fueron recubiertos de \w oro|strong="H2091"\w*.   
\p
\v 29 \w Todas|strong="H3605"\w* las paredes del \w templo|strong="H1004"\w*, tanto \w de|strong="H6440"\w* \w la|strong="H3605"\w* nave central como del santuario interior, fueron decoradas con \w figuras|strong="H4734"\w* \w de|strong="H6440"\w* \w querubines|strong="H3742"\w*, palmeras y flores.  
\v 30 Incluso el suelo del \w templo|strong="H1004"\w* se recubrió de \w oro|strong="H2091"\w* en ambas secciones.  
\v 31 Para la entrada del santuario interior se \w hicieron|strong="H6213"\w* \w puertas|strong="H1817"\w* de \w madera|strong="H6086"\w* de olivo; \w el|strong="H6213"\w* dintel y los \w postes|strong="H4201"\w* formaban un marco de cinco lados.  
\v 32 \w En|strong="H5921"\w* estas \w dos|strong="H8147"\w* \w puertas|strong="H1817"\w* \w de|strong="H5921"\w* \w madera|strong="H6086"\w* \w de|strong="H5921"\w* olivo \w se|strong="H5921"\w* tallaron \w querubines|strong="H3742"\w*, palmeras \w y|strong="H5921"\w* flores, \w y|strong="H5921"\w* todo \w se|strong="H5921"\w* recubrió \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.  
\v 33 Para la entrada de la nave central \w también|strong="H3651"\w* \w se|strong="H3651"\w* \w hicieron|strong="H6213"\w* \w postes|strong="H4201"\w* de \w madera|strong="H6086"\w* de olivo, pero con un marco de cuatro lados.  
\v 34 Las \w dos|strong="H8147"\w* \w puertas|strong="H1817"\w* eran de \w madera|strong="H6086"\w* de pino, y cada una tenía \w dos|strong="H8147"\w* hojas plegables.  
\v 35 \w En|strong="H5921"\w* \w ellas|strong="H5921"\w* \w se|strong="H5921"\w* tallaron \w querubines|strong="H3742"\w*, palmeras \w y|strong="H5921"\w* flores, \w y|strong="H5921"\w* \w se|strong="H5921"\w* recubrieron \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, siguiendo fielmente \w los|strong="H5921"\w* grabados \w de|strong="H5921"\w* \w la|strong="H5921"\w* madera.  
\v 36 El \w atrio|strong="H2691"\w* \w interior|strong="H6442"\w* se construyó con \w tres|strong="H7969"\w* hileras de piedra tallada y una hilera de vigas de cedro.   
\p
\v 37 Los \w cimientos|strong="H3245"\w* del \w templo|strong="H1004"\w* de Yahvé se echaron en el \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* del reinado de Salomón, en el \w mes|strong="H3391"\w* de ziv.  
\v 38 En \w el|strong="H1931"\w* \w año|strong="H8141"\w* undécimo, en \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H1697"\w* bul (\w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w octavo|strong="H8066"\w* \w mes|strong="H2320"\w* del \w año|strong="H8141"\w*), \w se|strong="H1931"\w* terminó \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w tal|strong="H1697"\w* \w como|strong="H1931"\w* \w se|strong="H1931"\w* había planeado en \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* detalles. Salomón tardó \w siete|strong="H7651"\w* \w años|strong="H8141"\w* en construirlo.   
\c 7  
\p
\v 1 \w Salomón|strong="H8010"\w* tardó \w trece|strong="H7969"\w* \w años|strong="H8141"\w* en construir su propio palacio y terminarlo por completo.  
\v 2 Construyó \w el|strong="H5921"\w* \w edificio|strong="H1004"\w* llamado “Palacio \w del|strong="H5921"\w* \w Bosque|strong="H3293"\w* \w del|strong="H5921"\w* \w Líbano|strong="H3844"\w*”, \w que|strong="H5921"\w* medía cuarenta \w y|strong="H5921"\w* cinco metros \w de|strong="H5921"\w* largo, veintidós \w de|strong="H5921"\w* ancho \w y|strong="H5921"\w* trece \w y|strong="H5921"\w* medio \w de|strong="H5921"\w* alto. Tenía cuatro hileras \w de|strong="H5921"\w* \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* cedro \w que|strong="H5921"\w* sostenían vigas \w del|strong="H5921"\w* mismo material.  
\v 3 \w El|strong="H5921"\w* techo era \w de|strong="H5921"\w* cedro \w y|strong="H5921"\w* descansaba \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* vigas; estas eran cuarenta \w y|strong="H5921"\w* \w cinco|strong="H2568"\w* \w en|strong="H5921"\w* total, \w quince|strong="H2568"\w* \w por|strong="H5921"\w* cada hilera.  
\v 4 Había ventanas dispuestas en \w tres|strong="H7969"\w* hileras, \w una|strong="H6471"\w* frente \w a|strong="H3068"\w* la otra.  
\v 5 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* marcos de las \w puertas|strong="H6607"\w* eran cuadrados, y las ventanas estaban colocadas en \w tres|strong="H7969"\w* hileras, \w una|strong="H6471"\w* frente \w a|strong="H3068"\w* \w la|strong="H3605"\w* otra.  
\v 6 También \w hizo|strong="H6213"\w* \w el|strong="H5921"\w* “Salón \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w Columnas|strong="H5982"\w*”, \w de|strong="H5921"\w* veintidós metros \w de|strong="H5921"\w* largo \w por|strong="H5921"\w* trece \w y|strong="H5921"\w* medio \w de|strong="H5921"\w* ancho. Frente \w a|strong="H3068"\w* este salón \w había|strong="H6213"\w* un vestíbulo \w con|strong="H5921"\w* \w más|strong="H5921"\w* \w columnas|strong="H5982"\w* \w y|strong="H5921"\w* una escalinata.  
\v 7 Construyó además \w el|strong="H6213"\w* “Salón del \w Trono|strong="H3678"\w*”, \w que|strong="H5704"\w* era \w el|strong="H6213"\w* salón del \w juicio|strong="H4941"\w* \w donde|strong="H8033"\w* \w él|strong="H6213"\w* impartía \w justicia|strong="H4941"\w*. Este salón estaba forrado \w de|strong="H5704"\w* cedro \w desde|strong="H5704"\w* \w el|strong="H6213"\w* suelo \w hasta|strong="H5704"\w* \w el|strong="H6213"\w* techo.  
\v 8 \w El|strong="H6213"\w* palacio \w donde|strong="H8033"\w* \w Salomón|strong="H8010"\w* \w vivía|strong="H3427"\w*, situado en \w otro|strong="H2088"\w* \w patio|strong="H2691"\w* detrás del salón del juicio, \w era|strong="H1961"\w* de un diseño similar. \w También|strong="H2088"\w* construyó un palacio igual \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w para|strong="H1961"\w* la \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w*, con \w quien|strong="H6213"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* casado.  
\v 9 \w Todas|strong="H3605"\w* estas construcciones se hicieron \w con|strong="H5704"\w* piedras \w de|strong="H5704"\w* \w la|strong="H3605"\w* \w mejor|strong="H2351"\w* calidad, \w cortadas|strong="H1496"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w medida|strong="H4060"\w* \w y|strong="H5704"\w* pulidas \w por|strong="H5704"\w* ambos lados, \w desde|strong="H5704"\w* \w los|strong="H3605"\w* cimientos \w hasta|strong="H5704"\w* \w la|strong="H3605"\w* cornisa, \w y|strong="H5704"\w* \w por|strong="H5704"\w* \w fuera|strong="H2351"\w* \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w gran|strong="H1419"\w* \w patio|strong="H2691"\w*.  
\v 10 Los \w cimientos|strong="H3245"\w* eran de enormes piedras de \w gran|strong="H1419"\w* valor, algunas de cuatro metros y medio y otras de tres metros y medio.  
\v 11 \w Sobre|strong="H4605"\w* ellas se colocaron piedras de excelente calidad, talladas \w a|strong="H3068"\w* la \w medida|strong="H4060"\w*, y vigas de cedro.  
\v 12 El \w gran|strong="H1419"\w* \w patio|strong="H2691"\w* exterior \w estaba|strong="H1004"\w* rodeado por un muro de \w tres|strong="H7969"\w* hileras de piedras talladas y una hilera de vigas de cedro, igual \w que|strong="H2691"\w* el \w patio|strong="H2691"\w* \w interior|strong="H6442"\w* del \w templo|strong="H1004"\w* de Yahvé y el vestíbulo del \w templo|strong="H1004"\w*.   
\p
\v 13 El \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w mandó|strong="H7971"\w* traer de \w Tiro|strong="H6865"\w* \w a|strong="H3068"\w* un hombre llamado \w Hiram|strong="H2438"\w*.  
\v 14 Hiram \w era|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* una viuda \w de|strong="H1121"\w* \w la|strong="H1931"\w* \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Neftalí y \w de|strong="H1121"\w* un \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Tiro \w que|strong="H1931"\w* \w era|strong="H1931"\w* experto en \w el|strong="H1931"\w* trabajo del bronce. Hiram poseía una gran \w sabiduría|strong="H2451"\w*, \w inteligencia|strong="H8394"\w* y habilidad para realizar \w cualquier|strong="H3605"\w* trabajo en bronce. \w Así|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* presentó ante \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* y llevó \w a|strong="H3068"\w* cabo \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w obra|strong="H4399"\w*.  
\v 15 Fundió las \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w* de bronce; cada una medía \w ocho|strong="H8083"\w* metros de alto y cinco metros y medio de circunferencia.  
\v 16 También \w hizo|strong="H6213"\w* \w dos|strong="H8147"\w* \w capiteles|strong="H3805"\w* \w de|strong="H5921"\w* bronce fundido \w para|strong="H5921"\w* ponerlos \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*. Cada \w capitel|strong="H3805"\w* medía \w dos|strong="H8147"\w* metros \w con|strong="H5921"\w* \w veinte|strong="H8147"\w* \w de|strong="H5921"\w* alto.  
\v 17 \w Para|strong="H5921"\w* decorar \w los|strong="H5921"\w* \w capiteles|strong="H3805"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*, hizo unas mallas \w de|strong="H5921"\w* red \w y|strong="H5921"\w* unos adornos \w en|strong="H5921"\w* forma \w de|strong="H5921"\w* cadenas: \w siete|strong="H7651"\w* \w para|strong="H5921"\w* cada \w capitel|strong="H3805"\w*.  
\v 18 Terminó \w las|strong="H5921"\w* \w columnas|strong="H5982"\w* poniendo \w dos|strong="H8147"\w* hileras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w* \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* malla \w de|strong="H5921"\w* cada \w capitel|strong="H3805"\w* \w para|strong="H5921"\w* cubrirlos. \w Hizo|strong="H6213"\w* \w lo|strong="H5921"\w* mismo \w con|strong="H5921"\w* \w ambos|strong="H8147"\w* \w capiteles|strong="H3805"\w*.  
\v 19 \w Los|strong="H5921"\w* \w capiteles|strong="H3805"\w* \w que|strong="H5921"\w* \w estaban|strong="H7218"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w* \w del|strong="H5921"\w* vestíbulo tenían forma \w de|strong="H5921"\w* \w lirios|strong="H7799"\w* \w y|strong="H5921"\w* medían un metro \w con|strong="H5921"\w* ochenta \w de|strong="H5921"\w* alto.  
\v 20 \w En|strong="H5921"\w* \w los|strong="H5921"\w* \w capiteles|strong="H3805"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w*, justo \w encima|strong="H4605"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* parte redondeada \w que|strong="H5921"\w* estaba \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* malla, \w había|strong="H3805"\w* \w doscientas|strong="H3967"\w* \w granadas|strong="H7416"\w* dispuestas \w en|strong="H5921"\w* hileras \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* cada \w capitel|strong="H3805"\w*.  
\v 21 Hiram colocó estas \w columnas|strong="H5982"\w* en el vestíbulo del \w templo|strong="H1964"\w*. \w A|strong="H3068"\w* la \w columna|strong="H5982"\w* de la \w derecha|strong="H3233"\w* la \w llamó|strong="H7121"\w* Jaquín, y \w a|strong="H3068"\w* la de la \w izquierda|strong="H8042"\w* la \w llamó|strong="H7121"\w* \w Boaz|strong="H1162"\w*.  
\v 22 \w Con|strong="H5921"\w* \w el|strong="H5921"\w* diseño \w de|strong="H5921"\w* \w lirios|strong="H7799"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior, quedó terminada \w la|strong="H5921"\w* \w obra|strong="H4639"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*.   
\p
\v 23 Hiram también \w hizo|strong="H6213"\w* un gran estanque \w de|strong="H5704"\w* metal fundido, conocido \w como|strong="H5704"\w* “\w el|strong="H6213"\w* \w Mar|strong="H3220"\w*”. Era circular, medía cuatro metros \w y|strong="H5704"\w* medio \w de|strong="H5704"\w* un borde \w al|strong="H5704"\w* \w otro|strong="H8145"\w*, dos metros \w con|strong="H5704"\w* veinte \w de|strong="H5704"\w* alto \w y|strong="H5704"\w* trece metros \w y|strong="H5704"\w* medio \w de|strong="H5704"\w* circunferencia.  
\v 24 \w Debajo|strong="H8478"\w* del borde, el estanque estaba rodeado \w por|strong="H8478"\w* \w dos|strong="H8147"\w* hileras \w de|strong="H8478"\w* adornos \w en|strong="H8478"\w* forma \w de|strong="H8478"\w* calabazas, \w diez|strong="H6235"\w* \w por|strong="H8478"\w* \w cada|strong="H6235"\w* medio metro, las cuales habían sido fundidas \w en|strong="H8478"\w* una sola pieza con el estanque.  
\v 25 \w El|strong="H5921"\w* estanque descansaba \w sobre|strong="H5921"\w* \w doce|strong="H8147"\w* \w bueyes|strong="H1241"\w*: \w tres|strong="H7969"\w* \w miraban|strong="H6437"\w* \w al|strong="H5921"\w* \w norte|strong="H6828"\w*, \w tres|strong="H7969"\w* \w al|strong="H5921"\w* oeste, \w tres|strong="H7969"\w* \w al|strong="H5921"\w* sur \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w al|strong="H5921"\w* \w este|strong="H4217"\w*. \w El|strong="H5921"\w* estanque \w estaba|strong="H5975"\w* apoyado \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* patas traseras \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w bueyes|strong="H1241"\w* quedaban \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* centro.  
\v 26 El grosor del estanque era de ocho centímetros; su borde se parecía al de una copa \w o|strong="H3068"\w* al de un lirio abierto, y tenía una capacidad de unos cuarenta y cuatro mil litros.   
\p
\v 27 También \w hizo|strong="H6213"\w* \w diez|strong="H6235"\w* bases móviles de bronce. \w Cada|strong="H6235"\w* una medía un metro con ochenta de largo, \w lo|strong="H6213"\w* mismo de ancho, y un metro con treinta de alto.  
\v 28 \w El|strong="H1992"\w* diseño de \w las|strong="H1992"\w* bases \w era|strong="H2088"\w* \w este|strong="H2088"\w*: tenían paneles laterales sujetos \w por|strong="H2088"\w* marcos.  
\v 29 \w En|strong="H5921"\w* esos paneles había figuras \w de|strong="H5921"\w* leones, \w bueyes|strong="H1241"\w* \w y|strong="H5921"\w* \w querubines|strong="H3742"\w*. \w En|strong="H5921"\w* \w los|strong="H5921"\w* marcos, \w tanto|strong="H5921"\w* \w arriba|strong="H4605"\w* \w como|strong="H5921"\w* \w abajo|strong="H8478"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* leones \w y|strong="H5921"\w* \w bueyes|strong="H1241"\w*, había guirnaldas repujadas.  
\v 30 Cada base tenía cuatro ruedas \w de|strong="H8478"\w* bronce con ejes también \w de|strong="H8478"\w* bronce. \w En|strong="H8478"\w* las cuatro \w esquinas|strong="H6471"\w*, la base tenía soportes fundidos para sostener la \w fuente|strong="H3595"\w*, y estos tenían guirnaldas decorativas.  
\v 31 \w La|strong="H5921"\w* abertura \w de|strong="H5921"\w* \w la|strong="H5921"\w* base era circular \w y|strong="H1571"\w* medía unos setenta centímetros \w de|strong="H5921"\w* profundidad; sobresalía unos cuarenta \w y|strong="H1571"\w* cinco centímetros \w por|strong="H5921"\w* \w encima|strong="H4605"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* base. \w Esta|strong="H5921"\w* abertura \w estaba|strong="H1004"\w* decorada \w con|strong="H5921"\w* grabados, pero \w los|strong="H5921"\w* paneles laterales \w de|strong="H5921"\w* \w las|strong="H5921"\w* bases \w eran|strong="H3808"\w* cuadrados \w y|strong="H1571"\w* \w no|strong="H3808"\w* redondos.  
\v 32 Las cuatro ruedas estaban \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* los paneles, y los ejes \w de|strong="H8478"\w* las ruedas estaban unidos \w a|strong="H3068"\w* la base. Cada rueda medía unos setenta centímetros \w de|strong="H8478"\w* alto.  
\v 33 Las ruedas eran como las de un \w carro|strong="H4818"\w* de guerra; sus ejes, llantas, radios y cubos eran \w todos|strong="H3605"\w* de metal fundido.  
\v 34 Cada una \w de|strong="H4480"\w* las diez bases tenía cuatro soportes, uno \w en|strong="H4480"\w* cada esquina, los cuales formaban una sola pieza \w con|strong="H4480"\w* la base.  
\v 35 \w En|strong="H5921"\w* \w la|strong="H5921"\w* \w parte|strong="H2677"\w* superior \w de|strong="H4480"\w* \w la|strong="H5921"\w* base había un borde circular \w de|strong="H4480"\w* unos veintidós centímetros \w de|strong="H4480"\w* alto. \w Los|strong="H5921"\w* soportes \w y|strong="H5921"\w* \w los|strong="H5921"\w* paneles formaban una sola pieza \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w parte|strong="H2677"\w* superior \w de|strong="H4480"\w* \w la|strong="H5921"\w* base.  
\v 36 Hiram grabó \w querubines|strong="H3742"\w*, leones \w y|strong="H5921"\w* palmeras \w en|strong="H5921"\w* \w las|strong="H5921"\w* superficies \w de|strong="H5921"\w* \w los|strong="H5921"\w* soportes \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* paneles, \w en|strong="H5921"\w* cada espacio disponible, \w y|strong="H5921"\w* \w los|strong="H5921"\w* rodeó \w con|strong="H5921"\w* guirnaldas.  
\v 37 \w Así|strong="H2063"\w* fue como \w hizo|strong="H6213"\w* las \w diez|strong="H6235"\w* bases: \w todas|strong="H3605"\w* con \w el|strong="H3605"\w* \w mismo|strong="H3605"\w* molde, \w la|strong="H2063"\w* misma \w medida|strong="H4060"\w* y \w el|strong="H3605"\w* \w mismo|strong="H3605"\w* diseño.  
\v 38 También \w hizo|strong="H6213"\w* \w diez|strong="H6235"\w* \w fuentes|strong="H3595"\w* \w de|strong="H5921"\w* bronce; \w en|strong="H5921"\w* \w cada|strong="H6235"\w* una cabían ochocientos ochenta litros \w y|strong="H5921"\w* \w cada|strong="H6235"\w* una medía un metro \w con|strong="H5921"\w* ochenta \w de|strong="H5921"\w* ancho. Colocó una \w fuente|strong="H3595"\w* \w sobre|strong="H5921"\w* \w cada|strong="H6235"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w diez|strong="H6235"\w* bases.  
\v 39 \w Puso|strong="H5414"\w* \w cinco|strong="H2568"\w* bases \w al|strong="H5921"\w* \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w y|strong="H5921"\w* \w cinco|strong="H2568"\w* \w al|strong="H5921"\w* \w lado|strong="H3802"\w* izquierdo. \w El|strong="H5921"\w* estanque \w lo|strong="H5921"\w* \w puso|strong="H5414"\w* \w al|strong="H5921"\w* \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w*, \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* sureste.   
\p
\v 40 \w Hiram|strong="H2438"\w* también \w hizo|strong="H6213"\w* las ollas, las palas y \w los|strong="H3605"\w* \w tazones|strong="H4219"\w* para recibir \w la|strong="H3605"\w* sangre. Así terminó \w Hiram|strong="H2438"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo \w que|strong="H3605"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* le encargó para \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé:  
\v 41 \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w*; \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w capiteles|strong="H3805"\w* redondos \w que|strong="H5921"\w* coronaban \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*; \w las|strong="H5921"\w* \w dos|strong="H8147"\w* mallas \w para|strong="H5921"\w* decorar \w los|strong="H5921"\w* \w capiteles|strong="H3805"\w*;  
\v 42 \w las|strong="H5921"\w* cuatrocientas \w granadas|strong="H7416"\w* \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* mallas (\w dos|strong="H8147"\w* hileras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w* \w para|strong="H5921"\w* cada malla);  
\v 43 \w las|strong="H5921"\w* \w diez|strong="H6235"\w* bases \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w diez|strong="H6235"\w* \w fuentes|strong="H3595"\w* \w que|strong="H5921"\w* iban \w sobre|strong="H5921"\w* \w ellas|strong="H5921"\w*;  
\v 44 el estanque \w y|strong="H1241"\w* los \w doce|strong="H8147"\w* \w bueyes|strong="H1241"\w* que lo sostenían;  
\v 45 y las ollas, las palas y \w los|strong="H3605"\w* \w tazones|strong="H4219"\w*. \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* utensilios \w que|strong="H3605"\w* \w Hiram|strong="H2438"\w* \w hizo|strong="H6213"\w* para \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* para \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé eran de bronce pulido.  
\v 46 El \w rey|strong="H4428"\w* mandó fundirlos en moldes de arcilla en la llanura del \w Jordán|strong="H3383"\w*, entre Sucot y Saretán.  
\v 47 \w Eran|strong="H3808"\w* tantos \w los|strong="H3605"\w* utensilios \w que|strong="H3808"\w* \w Salomón|strong="H8010"\w* \w ni|strong="H3808"\w* siquiera \w los|strong="H3605"\w* \w pesó|strong="H4948"\w*; \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* supo cuánto pesaba \w el|strong="H3605"\w* bronce.   
\p
\v 48 \w Salomón|strong="H8010"\w* \w también|strong="H7979"\w* mandó \w hacer|strong="H6213"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* otros utensilios \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé: \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*; \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w*;  
\v 49 los candelabros \w de|strong="H6440"\w* \w oro|strong="H2091"\w* \w puro|strong="H5462"\w* (\w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* y \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*, frente al Lugar Santísimo); las \w flores|strong="H6525"\w*, las \w lámparas|strong="H5216"\w* y las tenazas \w de|strong="H6440"\w* \w oro|strong="H2091"\w*;  
\v 50 las copas, las tijeras para las lámparas, los \w tazones|strong="H4219"\w*, las \w cucharas|strong="H3709"\w* y los \w incensarios|strong="H4289"\w* de \w oro|strong="H2091"\w* \w puro|strong="H5462"\w*; y las bisagras de \w oro|strong="H2091"\w* para las \w puertas|strong="H1817"\w* del Lugar \w Santísimo|strong="H6944"\w* y para las \w puertas|strong="H1817"\w* de la nave central del \w templo|strong="H1964"\w*.   
\p
\v 51 Cuando se terminó \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w obra|strong="H4399"\w* \w que|strong="H3605"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w había|strong="H6213"\w* mandado \w hacer|strong="H6213"\w* \w para|strong="H5414"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé, \w Salomón|strong="H8010"\w* trajo \w la|strong="H3605"\w* \w plata|strong="H3701"\w*, \w el|strong="H3605"\w* \w oro|strong="H2091"\w* y \w los|strong="H3605"\w* utensilios \w que|strong="H3605"\w* su padre \w David|strong="H1732"\w* \w había|strong="H6213"\w* \w dedicado|strong="H6944"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*, y \w los|strong="H3605"\w* guardó en \w los|strong="H3605"\w* tesoros del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé.   
\c 8  
\p
\v 1 Entonces \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* mandó llamar \w a|strong="H3068"\w* Jerusalén \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w tribus|strong="H4294"\w* y \w de|strong="H1121"\w* las familias \w de|strong="H1121"\w* \w los|strong="H1121"\w* israelitas. \w El|strong="H1931"\w* propósito \w era|strong="H1931"\w* trasladar \w el|strong="H1931"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H1121"\w* Yahvé desde \w Sión|strong="H6726"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*.  
\v 2 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres de \w Israel|strong="H3478"\w* \w se|strong="H1931"\w* reunieron con \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* para \w la|strong="H1931"\w* \w fiesta|strong="H2282"\w* del \w mes|strong="H2320"\w* de etanim, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w* del año.  
\v 3 Cuando llegaron \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* de \w Israel|strong="H3478"\w*, \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* levantaron \w el|strong="H3605"\w* arca.  
\v 4 Trasladaron \w el|strong="H3605"\w* arca de Yahvé, junto con \w la|strong="H3605"\w* Carpa del Encuentro y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios \w sagrados|strong="H6944"\w* \w que|strong="H3605"\w* había en \w ella|strong="H3605"\w*. \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* se encargaron de llevarlo \w todo|strong="H3605"\w*.  
\v 5 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* había reunido \w con|strong="H5921"\w* \w él|strong="H5921"\w*, \w se|strong="H5921"\w* pusieron \w ante|strong="H6440"\w* \w el|strong="H5921"\w* arca \w y|strong="H5921"\w* \w sacrificaron|strong="H2076"\w* tantas \w ovejas|strong="H6629"\w* \w y|strong="H5921"\w* \w bueyes|strong="H1241"\w* \w que|strong="H3808"\w* era imposible contarlos.  
\v 6 Luego los \w sacerdotes|strong="H3548"\w* llevaron el arca del \w pacto|strong="H1285"\w* \w de|strong="H8478"\w* Yahvé \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w* \w en|strong="H8478"\w* el \w santuario|strong="H6944"\w* interior del \w templo|strong="H1004"\w*, que es el \w Lugar|strong="H4725"\w* \w Santísimo|strong="H6944"\w*, y la pusieron \w bajo|strong="H8478"\w* las \w alas|strong="H3671"\w* \w de|strong="H8478"\w* los \w querubines|strong="H3742"\w*.  
\v 7 \w Los|strong="H5921"\w* \w querubines|strong="H3742"\w* tenían \w las|strong="H5921"\w* \w alas|strong="H3671"\w* \w extendidas|strong="H6566"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* quedó \w el|strong="H5921"\w* arca, \w cubriendo|strong="H5526"\w* \w tanto|strong="H5921"\w* \w el|strong="H5921"\w* arca \w como|strong="H3588"\w* sus varas.  
\v 8 \w Las|strong="H5921"\w* varas \w eran|strong="H1961"\w* tan largas \w que|strong="H4480"\w* sus extremos \w se|strong="H1961"\w* podían \w ver|strong="H7200"\w* \w desde|strong="H4480"\w* \w la|strong="H5921"\w* sala \w principal|strong="H7218"\w*, frente \w al|strong="H5921"\w* Lugar \w Santísimo|strong="H6944"\w*, \w aunque|strong="H5704"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w veían|strong="H7200"\w* \w desde|strong="H4480"\w* \w afuera|strong="H2351"\w*. \w Y|strong="H3068"\w* \w allí|strong="H8033"\w* siguen \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w hoy|strong="H3117"\w*.  
\v 9 \w En|strong="H5973"\w* \w el|strong="H5973"\w* arca no había nada \w más|strong="H7535"\w* \w que|strong="H1121"\w* las \w dos|strong="H8147"\w* \w tablas|strong="H3871"\w* \w de|strong="H5973"\w* piedra \w que|strong="H1121"\w* \w Moisés|strong="H4872"\w* había colocado \w en|strong="H5973"\w* \w ella|strong="H8033"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* monte \w Horeb|strong="H2722"\w*, \w donde|strong="H8033"\w* Yahvé \w hizo|strong="H3772"\w* un pacto \w con|strong="H5973"\w* \w los|strong="H1121"\w* israelitas cuando \w salieron|strong="H3318"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*.  
\v 10 \w Cuando|strong="H1961"\w* \w los|strong="H1961"\w* \w sacerdotes|strong="H3548"\w* \w salieron|strong="H3318"\w* \w del|strong="H4480"\w* Lugar \w Santo|strong="H6944"\w*, una \w nube|strong="H6051"\w* \w llenó|strong="H4390"\w* el \w templo|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé.  
\v 11 Debido \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w nube|strong="H6051"\w*, \w los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* continuar \w con|strong="H3588"\w* sus funciones, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* Yahvé \w había|strong="H5975"\w* llenado \w su|strong="H3588"\w* \w templo|strong="H1004"\w*.   
\p
\v 12 Entonces \w Salomón|strong="H8010"\w* exclamó: “Yahvé, tú has dicho que habitarías en la \w oscuridad|strong="H6205"\w* de una nube.  
\v 13 Yo te he construido un \w templo|strong="H1004"\w* majestuoso, un lugar donde habites para \w siempre|strong="H5769"\w*”.   
\p
\v 14 Después \w el|strong="H3605"\w* \w rey|strong="H4428"\w* se volvió \w hacia|strong="H6440"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w que|strong="H6951"\w* \w estaba|strong="H5975"\w* allí \w de|strong="H6440"\w* \w pie|strong="H5975"\w*, y les dio su \w bendición|strong="H1288"\w*.  
\v 15 \w Dijo|strong="H1696"\w*: “¡\w Bendito|strong="H1288"\w* sea Yahvé, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*! Él ha cumplido con su \w poder|strong="H3027"\w* lo \w que|strong="H6310"\w* le prometió \w a|strong="H3068"\w* mi padre \w David|strong="H1732"\w* cuando le \w dijo|strong="H1696"\w*:  
\v 16 “\w Desde|strong="H4480"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H4480"\w* \w saqué|strong="H3318"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w no|strong="H3808"\w* elegí \w ninguna|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w de|strong="H4480"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w tribus|strong="H7626"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* construir un \w templo|strong="H1004"\w* \w donde|strong="H8033"\w* residiera \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*; pero elegí \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w para|strong="H5921"\w* \w que|strong="H4480"\w* gobernara \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*””.   
\p
\v 17 Luego añadió: “\w Mi|strong="H1961"\w* padre \w David|strong="H1732"\w* \w tenía|strong="H1961"\w* \w el|strong="H5973"\w* gran deseo \w de|strong="H5973"\w* construir un \w templo|strong="H1004"\w* \w en|strong="H5973"\w* honor al \w nombre|strong="H8034"\w* \w de|strong="H5973"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Pero|strong="H3588"\w* Yahvé \w le|strong="H5973"\w* dijo: “Hiciste muy \w bien|strong="H2895"\w* \w en|strong="H5973"\w* querer construir un \w templo|strong="H1004"\w* \w en|strong="H5973"\w* \w mi|strong="H1961"\w* honor.  
\v 19 \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* serás tú \w quien|strong="H1931"\w* \w lo|strong="H1931"\w* construya, \w sino|strong="H3588"\w* tu propio \w hijo|strong="H1121"\w*; \w él|strong="H1931"\w* \w será|strong="H1931"\w* \w quien|strong="H1931"\w* construya \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w en|strong="H3588"\w* mi honor”.  
\v 20 \w Y|strong="H3068"\w* ahora Yahvé ha cumplido su promesa. Yo he sucedido \w a|strong="H3068"\w* \w mi|strong="H5921"\w* padre \w David|strong="H1732"\w* \w y|strong="H5921"\w* ocupo \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w tal|strong="H1697"\w* \w como|strong="H5921"\w* Yahvé \w lo|strong="H1697"\w* prometió, \w y|strong="H5921"\w* he construido \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w en|strong="H5921"\w* honor \w al|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 21 \w Allí|strong="H8033"\w* he reservado un \w lugar|strong="H4725"\w* \w para|strong="H5973"\w* \w el|strong="H5973"\w* arca, \w donde|strong="H8033"\w* se encuentra \w el|strong="H5973"\w* \w pacto|strong="H1285"\w* que Yahvé \w hizo|strong="H3772"\w* \w con|strong="H5973"\w* nuestros antepasados cuando \w los|strong="H5973"\w* \w sacó|strong="H3318"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*”.   
\p
\v 22 Entonces \w Salomón|strong="H8010"\w* se \w puso|strong="H5975"\w* \w ante|strong="H6440"\w* \w el|strong="H3605"\w* \w altar|strong="H4196"\w* \w de|strong="H6440"\w* Yahvé, \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w Extendió|strong="H6566"\w* sus \w manos|strong="H3709"\w* \w hacia|strong="H6440"\w* \w el|strong="H3605"\w* \w cielo|strong="H8064"\w*  
\v 23 \w y|strong="H5921"\w* oró: “Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w no|strong="H5921"\w* hay \w Dios|strong="H3068"\w* \w como|strong="H3644"\w* tú ni \w arriba|strong="H4605"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* ni \w abajo|strong="H8478"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra. Tú cumples tu \w pacto|strong="H1285"\w* \w y|strong="H5921"\w* muestras tu fiel amor \w a|strong="H3068"\w* tus servidores \w que|strong="H5921"\w* \w te|strong="H5921"\w* sirven \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*.  
\v 24 Has cumplido \w lo|strong="H2088"\w* \w que|strong="H3117"\w* le prometiste \w a|strong="H3068"\w* tu servidor \w David|strong="H1732"\w*, mi padre; con tus propias \w palabras|strong="H1696"\w* \w lo|strong="H2088"\w* prometiste y con tu gran \w poder|strong="H3027"\w* \w lo|strong="H2088"\w* has cumplido, como podemos verlo \w hoy|strong="H3117"\w*.  
\v 25 “\w Ahora|strong="H6258"\w*, Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w cumple|strong="H8104"\w* también \w la|strong="H5921"\w* otra promesa \w que|strong="H3808"\w* \w le|strong="H5921"\w* hiciste \w a|strong="H3068"\w* \w mi|strong="H5921"\w* padre \w David|strong="H1732"\w* \w cuando|strong="H5650"\w* \w le|strong="H5921"\w* \w dijiste|strong="H1696"\w*: “\w Nunca|strong="H3808"\w* \w faltará|strong="H3772"\w* un descendiente \w tuyo|strong="H6258"\w* \w que|strong="H3808"\w* ocupe \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w ante|strong="H6440"\w* \w mí|strong="H5921"\w*, \w siempre|strong="H1980"\w* \w y|strong="H5921"\w* \w cuando|strong="H5650"\w* tus \w hijos|strong="H1121"\w* cuiden su conducta \w y|strong="H5921"\w* \w me|strong="H5921"\w* sirvan fielmente \w como|strong="H5921"\w* \w lo|strong="H3808"\w* hiciste tú”.   
\p
\v 26 Dios \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*, ¡te \w ruego|strong="H4994"\w* \w que|strong="H6258"\w* se confirme la promesa \w que|strong="H6258"\w* le hiciste \w a|strong="H3068"\w* \w mi|strong="H4994"\w* padre \w David|strong="H1732"\w*!  
\v 27 “\w Pero|strong="H3588"\w*, ¿realmente puede Dios vivir \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra? \w Si|strong="H3588"\w* \w ni|strong="H3808"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w más|strong="H3588"\w* alto puede contenerte, ¡mucho \w menos|strong="H3588"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* he construido!  
\v 28 Aun así, Yahvé mi \w Dios|strong="H3068"\w*, atiende la \w oración|strong="H8605"\w* y la \w súplica|strong="H8467"\w* \w de|strong="H6440"\w* tu servidor. \w Escucha|strong="H8085"\w* el \w clamor|strong="H7440"\w* y la \w oración|strong="H8605"\w* \w que|strong="H3117"\w* \w hoy|strong="H3117"\w* elevo \w a|strong="H3068"\w* tu \w presencia|strong="H6440"\w*.  
\v 29 Cuida \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w día|strong="H3117"\w* y \w noche|strong="H3915"\w*, \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* del cual dijiste: “\w Ahí|strong="H8033"\w* residirá \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*”. \w Escucha|strong="H8085"\w* la \w oración|strong="H8605"\w* \w que|strong="H3117"\w* tu servidor dirija \w hacia|strong="H8033"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 30 \w Escucha|strong="H8085"\w* las súplicas \w de|strong="H5971"\w* tu servidor y \w de|strong="H5971"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w cuando|strong="H5650"\w* oren hacia \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*. Escúchanos en \w el|strong="H3427"\w* \w cielo|strong="H8064"\w*, \w donde|strong="H4725"\w* tú vives, y \w cuando|strong="H5650"\w* nos escuches, perdónanos.   
\p
\v 31 “Cuando alguien sea acusado \w de|strong="H6440"\w* \w pecar|strong="H2398"\w* \w contra|strong="H6440"\w* su \w prójimo|strong="H7453"\w* y se le obligue \w a|strong="H3068"\w* jurar \w ante|strong="H6440"\w* tu \w altar|strong="H4196"\w* en \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 32 \w escucha|strong="H8085"\w* \w tú|strong="H8199"\w* desde \w el|strong="H6213"\w* \w cielo|strong="H8064"\w* y actúa. \w Juzga|strong="H8199"\w* \w a|strong="H3068"\w* tus servidores: condena al culpable y \w haz|strong="H6213"\w* que reciba \w el|strong="H6213"\w* \w pago|strong="H5414"\w* \w por|strong="H1870"\w* su mala acción, y declara inocente al que \w no|strong="H6213"\w* tiene culpa, tratándolo según su \w justicia|strong="H6666"\w*.   
\p
\v 33 “Cuando tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* sea derrotado \w por|strong="H6440"\w* sus enemigos \w por|strong="H6440"\w* haber \w pecado|strong="H2398"\w* \w contra|strong="H6440"\w* ti, \w si|strong="H6440"\w* ellos \w se|strong="H5971"\w* \w vuelven|strong="H7725"\w* \w a|strong="H3068"\w* ti, reconocen tu \w nombre|strong="H8034"\w* y oran y te suplican en \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 34 escúchalos tú desde el \w cielo|strong="H8064"\w*. \w Perdona|strong="H5545"\w* el \w pecado|strong="H2403"\w* \w de|strong="H5971"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* y hazlos \w volver|strong="H7725"\w* \w a|strong="H3068"\w* la tierra \w que|strong="H5971"\w* les \w diste|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados.   
\p
\v 35 “\w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w* \w se|strong="H1961"\w* cierre \w y|strong="H3588"\w* \w no|strong="H3808"\w* llueva \w porque|strong="H3588"\w* \w el|strong="H3588"\w* pueblo \w pecó|strong="H2398"\w* \w contra|strong="H1961"\w* ti, \w si|strong="H3588"\w* ellos oran hacia \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, reconocen tu \w nombre|strong="H8034"\w* \w y|strong="H3588"\w* \w se|strong="H1961"\w* arrepienten \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w* al verte humillados,  
\v 36 escúchalos tú \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*. \w Perdona|strong="H5545"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w de|strong="H5921"\w* tus servidores \w y|strong="H3588"\w* \w de|strong="H5921"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. Enséñales \w el|strong="H5921"\w* \w buen|strong="H2896"\w* \w camino|strong="H1870"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H3588"\w* deben \w andar|strong="H3212"\w* \w y|strong="H3588"\w* envía \w la|strong="H5921"\w* \w lluvia|strong="H4306"\w* \w sobre|strong="H5921"\w* \w esta|strong="H5921"\w* tierra \w que|strong="H3588"\w* \w les|strong="H5921"\w* \w diste|strong="H5414"\w* \w como|strong="H3588"\w* \w herencia|strong="H5159"\w*.   
\p
\v 37 “\w Cuando|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* país \w haya|strong="H1961"\w* \w hambre|strong="H7458"\w*, peste, plagas, hongos \w en|strong="H3588"\w* \w los|strong="H3605"\w* cultivos, langostas \w o|strong="H3068"\w* saltamontes; \w o|strong="H3068"\w* \w cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w enemigo|strong="H6887"\w* rodee sus \w ciudades|strong="H8179"\w*; \w sea|strong="H1961"\w* \w cual|strong="H3588"\w* \w sea|strong="H1961"\w* \w la|strong="H3588"\w* \w plaga|strong="H5061"\w* \w o|strong="H3068"\w* \w enfermedad|strong="H4245"\w* \w que|strong="H3588"\w* \w los|strong="H3605"\w* azote,  
\v 38 \w escucha|strong="H8605"\w* \w toda|strong="H3605"\w* \w oración|strong="H8605"\w* \w o|strong="H3068"\w* \w súplica|strong="H8467"\w* \w que|strong="H5971"\w* te haga \w cualquier|strong="H3605"\w* persona \w o|strong="H3068"\w* \w todo|strong="H3605"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. \w Cuando|strong="H1961"\w* alguien sienta \w el|strong="H3605"\w* dolor en su propio \w corazón|strong="H3824"\w* y extienda sus \w manos|strong="H3709"\w* hacia \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 39 escúchalo \w tú|strong="H6213"\w* desde \w el|strong="H3588"\w* \w cielo|strong="H8064"\w*, donde vives. Perdónalo \w y|strong="H3588"\w* actúa; dale \w a|strong="H3068"\w* \w cada|strong="H3605"\w* uno \w lo|strong="H6213"\w* \w que|strong="H3588"\w* merecen sus acciones, \w pues|strong="H3588"\w* \w tú|strong="H6213"\w* \w conoces|strong="H3045"\w* \w su|strong="H3588"\w* \w corazón|strong="H3824"\w* (solo \w tú|strong="H6213"\w* \w conoces|strong="H3045"\w* \w el|strong="H3588"\w* \w corazón|strong="H3824"\w* \w de|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* seres humanos).  
\v 40 Hazlo \w así|strong="H1992"\w* \w para|strong="H4616"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* respeten \w mientras|strong="H3605"\w* vivan \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w les|strong="H1992"\w* \w diste|strong="H5414"\w* \w a|strong="H3068"\w* nuestros antepasados.   
\p
\v 41 “En cuanto al \w extranjero|strong="H5237"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* pertenece \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, pero \w que|strong="H1931"\w* viene \w de|strong="H5971"\w* tierras lejanas atraído \w por|strong="H4616"\w* tu \w fama|strong="H8034"\w*  
\v 42 (\w porque|strong="H3588"\w* todos \w oirán|strong="H8085"\w* hablar \w de|strong="H3588"\w* tu \w gran|strong="H1419"\w* \w nombre|strong="H8034"\w*, \w de|strong="H3588"\w* tu fuerza \w y|strong="H3588"\w* \w de|strong="H3588"\w* tu \w poder|strong="H3027"\w*), \w cuando|strong="H3588"\w* \w ese|strong="H2088"\w* extranjero venga \w y|strong="H3588"\w* \w ore|strong="H6419"\w* hacia \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 43 escúchalo \w tú|strong="H6213"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w donde|strong="H5921"\w* vives. Concédele \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* pida, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w te|strong="H5921"\w* \w conozcan|strong="H3045"\w* \w y|strong="H3588"\w* \w te|strong="H5921"\w* respeten, \w como|strong="H3588"\w* \w lo|strong="H2088"\w* \w hace|strong="H6213"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w sepan|strong="H3045"\w* \w que|strong="H3588"\w* \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w* reside \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* construí.   
\p
\v 44 “\w Cuando|strong="H3588"\w* tu \w pueblo|strong="H5971"\w* \w salga|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* sus enemigos, \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w que|strong="H3588"\w* tú \w les|strong="H5921"\w* mandes, \w si|strong="H3588"\w* \w ellos|strong="H5921"\w* oran \w a|strong="H3068"\w* Yahvé \w hacia|strong="H1870"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3588"\w* tú elegiste \w y|strong="H3588"\w* \w hacia|strong="H1870"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* construí \w en|strong="H5921"\w* tu honor,  
\v 45 \w escucha|strong="H8085"\w* \w tú|strong="H6213"\w* desde \w el|strong="H6213"\w* \w cielo|strong="H8064"\w* su \w oración|strong="H8605"\w* y su \w súplica|strong="H8467"\w*, y defiende su causa.  
\v 46 “\w Si|strong="H3588"\w* ellos pecan \w contra|strong="H6440"\w* ti (\w pues|strong="H3588"\w* \w no|strong="H3808"\w* hay \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w peque|strong="H2398"\w*), \w y|strong="H3588"\w* tú \w te|strong="H3588"\w* enojas \w con|strong="H3588"\w* ellos \w y|strong="H3588"\w* \w los|strong="H3588"\w* entregas al enemigo \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w los|strong="H3588"\w* lleven cautivos \w a|strong="H3068"\w* otro país, \w lejos|strong="H7350"\w* \w o|strong="H3068"\w* \w cerca|strong="H7138"\w*;  
\v 47 \w si|strong="H7617"\w* en el país \w a|strong="H3068"\w* \w donde|strong="H8033"\w* fueron llevados recapacitan, se arrepienten y te suplican diciendo: “Hemos \w pecado|strong="H2398"\w*, hemos actuado mal y con maldad”;  
\v 48 \w si|strong="H7617"\w* se \w vuelven|strong="H7725"\w* \w a|strong="H3068"\w* ti \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w* y con \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w* en \w la|strong="H3605"\w* tierra \w de|strong="H5414"\w* \w los|strong="H3605"\w* enemigos \w que|strong="H3605"\w* \w los|strong="H3605"\w* capturaron, y oran \w hacia|strong="H1870"\w* \w la|strong="H3605"\w* tierra \w que|strong="H3605"\w* les \w diste|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados, \w hacia|strong="H1870"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3605"\w* elegiste y \w hacia|strong="H1870"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w que|strong="H3605"\w* construí en tu honor,  
\v 49 \w escucha|strong="H8085"\w* \w tú|strong="H6213"\w* desde \w el|strong="H6213"\w* \w cielo|strong="H8064"\w*, donde vives, su \w oración|strong="H8605"\w* y su \w súplica|strong="H8467"\w*, y defiende su causa.  
\v 50 \w Perdona|strong="H5545"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w pecó|strong="H2398"\w* \w contra|strong="H6440"\w* ti; \w perdona|strong="H5545"\w* \w todas|strong="H3605"\w* sus \w rebeliones|strong="H6588"\w* y haz \w que|strong="H5971"\w* sus captores les tengan compasión y \w los|strong="H3605"\w* traten bien.  
\v 51 Al fin \w y|strong="H3588"\w* al cabo, \w ellos|strong="H1992"\w* \w son|strong="H3588"\w* tu \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* tu \w heredad|strong="H5159"\w*; tú \w los|strong="H1992"\w* \w sacaste|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H3588"\w* ese horno \w de|strong="H3588"\w* fundición.  
\v 52 “\w Que|strong="H5971"\w* tus \w ojos|strong="H5869"\w* \w estén|strong="H1961"\w* \w abiertos|strong="H6605"\w* \w a|strong="H3068"\w* las súplicas \w de|strong="H5971"\w* tu servidor y \w de|strong="H5971"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*; escúchalos \w siempre|strong="H3605"\w* \w que|strong="H5971"\w* \w te|strong="H5869"\w* \w invoquen|strong="H7121"\w*.  
\v 53 Tú \w los|strong="H3605"\w* elegiste \w entre|strong="H3588"\w* \w todas|strong="H3605"\w* las naciones del mundo \w para|strong="H3588"\w* \w que|strong="H3588"\w* fueran tu \w herencia|strong="H5159"\w*, tal \w como|strong="H3588"\w* \w lo|strong="H3605"\w* declaraste \w por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* tu servidor \w Moisés|strong="H4872"\w* \w cuando|strong="H3588"\w* \w sacaste|strong="H3318"\w* \w a|strong="H3068"\w* nuestros antepasados \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, oh Señor Yahvé”.   
\p
\v 54 \w Cuando|strong="H1961"\w* \w Salomón|strong="H8010"\w* terminó \w de|strong="H5921"\w* elevar \w a|strong="H3068"\w* Yahvé \w toda|strong="H3605"\w* \w esta|strong="H2063"\w* \w oración|strong="H8605"\w* \w y|strong="H5921"\w* \w súplica|strong="H8467"\w*, \w se|strong="H1961"\w* \w levantó|strong="H6965"\w* \w de|strong="H5921"\w* \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, \w donde|strong="H5921"\w* \w había|strong="H1961"\w* \w estado|strong="H1961"\w* arrodillado \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3709"\w* \w extendidas|strong="H6566"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*.  
\v 55 Se \w puso|strong="H5975"\w* de \w pie|strong="H5975"\w* y \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad de \w Israel|strong="H3478"\w*, diciendo \w en|strong="H5975"\w* \w voz|strong="H6963"\w* \w alta|strong="H1419"\w*:  
\v 56 “¡\w Bendito|strong="H1288"\w* sea Yahvé! \w Él|strong="H3605"\w* le \w ha|strong="H3808"\w* \w dado|strong="H5414"\w* \w descanso|strong="H4496"\w* \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w tal|strong="H1697"\w* como \w lo|strong="H1697"\w* prometió. \w Ni|strong="H3808"\w* una sola \w de|strong="H5971"\w* las promesas \w que|strong="H3808"\w* \w él|strong="H3605"\w* \w hizo|strong="H5414"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H5971"\w* su servidor \w Moisés|strong="H4872"\w* \w ha|strong="H3808"\w* dejado \w de|strong="H5971"\w* cumplirse.  
\v 57 \w Que|strong="H1961"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w esté|strong="H1961"\w* \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w* \w como|strong="H5973"\w* \w estuvo|strong="H1961"\w* \w con|strong="H5973"\w* nuestros antepasados; \w que|strong="H1961"\w* nunca nos \w deje|strong="H5800"\w* \w ni|strong="H5973"\w* nos abandone.  
\v 58 \w Que|strong="H3605"\w* \w incline|strong="H5186"\w* nuestro \w corazón|strong="H3824"\w* \w hacia|strong="H1870"\w* \w él|strong="H3605"\w* para \w que|strong="H3605"\w* sigamos \w todos|strong="H3605"\w* sus \w caminos|strong="H1870"\w* y cumplamos sus \w mandamientos|strong="H4687"\w*, leyes y decretos, \w los|strong="H3605"\w* cuales \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* nuestros antepasados.  
\v 59 \w Y|strong="H3068"\w* \w que|strong="H5971"\w* \w estas|strong="H6213"\w* \w palabras|strong="H1697"\w* con las \w que|strong="H5971"\w* he suplicado \w ante|strong="H6440"\w* Yahvé permanezcan presentes \w ante|strong="H6440"\w* \w él|strong="H6213"\w* \w día|strong="H3117"\w* y \w noche|strong="H3915"\w*. \w Que|strong="H5971"\w* \w él|strong="H6213"\w* defienda la \w causa|strong="H1697"\w* \w de|strong="H6440"\w* su servidor y \w de|strong="H6440"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* según la necesidad \w de|strong="H6440"\w* \w cada|strong="H3117"\w* \w día|strong="H3117"\w*.  
\v 60 \w Así|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* tierra \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* Yahvé \w es|strong="H1931"\w* \w el|strong="H1931"\w* único \w Dios|strong="H3068"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w hay|strong="H5750"\w* \w otro|strong="H4616"\w*.   
\p
\v 61 \w Que|strong="H3117"\w* \w el|strong="H5973"\w* \w corazón|strong="H3824"\w* \w de|strong="H5973"\w* ustedes \w sea|strong="H1961"\w* totalmente fiel \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, \w para|strong="H1961"\w* \w que|strong="H3117"\w* vivan según sus leyes y cumplan sus \w mandamientos|strong="H4687"\w*, \w como|strong="H5973"\w* \w lo|strong="H2088"\w* hacen \w hoy|strong="H3117"\w*”.   
\p
\v 62 Entonces \w el|strong="H5973"\w* \w rey|strong="H4428"\w* y \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* ofrecieron \w sacrificios|strong="H2077"\w* \w ante|strong="H6440"\w* Yahvé.  
\v 63 Para \w el|strong="H3605"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H1121"\w* las ofrendas \w de|strong="H1121"\w* paz, \w Salomón|strong="H8010"\w* \w ofreció|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé \w veintidós|strong="H6242"\w* \w mil|strong="H3967"\w* \w bueyes|strong="H1241"\w* \w y|strong="H1241"\w* \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*. Así fue como \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w y|strong="H1241"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas dedicaron \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé.  
\v 64 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* consagró \w la|strong="H1931"\w* parte central \w del|strong="H4196"\w* \w patio|strong="H2691"\w* \w que|strong="H3588"\w* \w estaba|strong="H1004"\w* frente \w al|strong="H5930"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé. \w Allí|strong="H8033"\w* \w ofreció|strong="H6213"\w* \w los|strong="H1931"\w* \w holocaustos|strong="H5930"\w*, las ofrendas \w de|strong="H3588"\w* cereales \w y|strong="H3588"\w* \w la|strong="H1931"\w* grasa \w de|strong="H3588"\w* \w los|strong="H1931"\w* sacrificios \w de|strong="H3588"\w* paz, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w de|strong="H3588"\w* bronce \w que|strong="H3588"\w* \w estaba|strong="H1004"\w* \w ante|strong="H6440"\w* Yahvé \w era|strong="H1931"\w* muy \w pequeño|strong="H6996"\w* \w para|strong="H3588"\w* recibir todas esas ofrendas.   
\p
\v 65 \w En|strong="H5973"\w* \w esa|strong="H1931"\w* ocasión, \w Salomón|strong="H8010"\w* \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* celebraron \w la|strong="H1931"\w* \w fiesta|strong="H2282"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, \w y|strong="H5704"\w* \w luego|strong="H1931"\w* otros \w siete|strong="H7651"\w* \w días|strong="H3117"\w*; catorce \w días|strong="H3117"\w* \w en|strong="H5973"\w* total. \w Era|strong="H1931"\w* una \w gran|strong="H1419"\w* \w multitud|strong="H6951"\w* \w que|strong="H1931"\w* venía \w desde|strong="H5704"\w* \w el|strong="H1931"\w* paso \w de|strong="H6440"\w* Hamat \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w arroyo|strong="H5158"\w* \w de|strong="H6440"\w* \w Egipto|strong="H4714"\w*, \w todos|strong="H3605"\w* reunidos \w ante|strong="H6440"\w* Yahvé nuestro \w Dios|strong="H3068"\w*.  
\v 66 \w Al|strong="H5921"\w* \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* \w del|strong="H5921"\w* segundo periodo, \w Salomón|strong="H4428"\w* \w despidió|strong="H7971"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*. \w Ellos|strong="H5921"\w* \w bendijeron|strong="H1288"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* sus casas muy felices \w y|strong="H5921"\w* contentos \w por|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* bondad \w que|strong="H5921"\w* Yahvé \w había|strong="H6213"\w* mostrado \w a|strong="H3068"\w* su servidor \w David|strong="H1732"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.   
\c 9  
\p
\v 1 \w Cuando|strong="H1961"\w* \w Salomón|strong="H8010"\w* terminó de construir \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé, \w el|strong="H3605"\w* palacio \w real|strong="H4428"\w* y \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H1961"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* propuesto \w edificar|strong="H1129"\w*,  
\v 2 Yahvé se le \w apareció|strong="H7200"\w* por \w segunda|strong="H8145"\w* vez, tal como lo había hecho en \w Gabaón|strong="H1391"\w*.  
\v 3 Yahvé \w le|strong="H5869"\w* dijo: “He escuchado \w la|strong="H3605"\w* \w oración|strong="H8605"\w* \w y|strong="H5704"\w* \w la|strong="H3605"\w* \w súplica|strong="H8467"\w* \w que|strong="H5704"\w* has \w hecho|strong="H1961"\w* \w en|strong="H5704"\w* \w mi|strong="H1961"\w* \w presencia|strong="H6440"\w*. He santificado \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H5704"\w* has construido \w para|strong="H5704"\w* \w que|strong="H5704"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w* resida \w en|strong="H5704"\w* \w él|strong="H3605"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*; mis \w ojos|strong="H5869"\w* \w y|strong="H5704"\w* \w mi|strong="H1961"\w* \w corazón|strong="H3820"\w* \w estarán|strong="H1961"\w* \w allí|strong="H8033"\w* \w perpetuamente|strong="H5769"\w*.  
\v 4 \w En|strong="H3212"\w* cuanto \w a|strong="H3068"\w* ti, \w si|strong="H6440"\w* te conduces \w delante|strong="H6440"\w* \w de|strong="H6440"\w* mí con \w integridad|strong="H8537"\w* y rectitud, como \w lo|strong="H6213"\w* \w hizo|strong="H6213"\w* \w tu|strong="H6213"\w* padre \w David|strong="H1732"\w*, y \w si|strong="H6440"\w* \w haces|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* te he \w mandado|strong="H6680"\w* y cumples mis leyes y decretos,  
\v 5 yo afirmaré \w para|strong="H5921"\w* \w siempre|strong="H5769"\w* tu \w trono|strong="H3678"\w* \w en|strong="H5921"\w* \w Israel|strong="H3478"\w*, tal \w como|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H3808"\w* prometí \w a|strong="H3068"\w* tu padre \w David|strong="H1732"\w* cuando \w le|strong="H5921"\w* \w dije|strong="H1696"\w*: “\w Nunca|strong="H3808"\w* \w faltará|strong="H3772"\w* un descendiente tuyo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.  
\v 6 Pero \w si|strong="H3808"\w* ustedes \w o|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w se|strong="H3808"\w* \w apartan|strong="H7725"\w* \w de|strong="H6440"\w* mí y \w no|strong="H3808"\w* cumplen \w los|strong="H1121"\w* \w mandamientos|strong="H4687"\w* y leyes \w que|strong="H3808"\w* les he \w dado|strong="H5414"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w van|strong="H1980"\w* \w a|strong="H3068"\w* \w servir|strong="H5647"\w* y \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* otros dioses,  
\v 7 yo arrancaré \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w les|strong="H5921"\w* he \w entregado|strong="H5414"\w*. También rechazaré \w este|strong="H1961"\w* \w templo|strong="H1004"\w* \w que|strong="H5921"\w* he santificado \w en|strong="H5921"\w* honor \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* \w será|strong="H1961"\w* objeto \w de|strong="H5921"\w* burla \w y|strong="H5921"\w* \w de|strong="H5921"\w* mofa \w entre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* naciones.  
\v 8 \w Y|strong="H3068"\w* aunque \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w sea|strong="H1961"\w* ahora majestuoso, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H4100"\w* pasen \w por|strong="H5921"\w* \w aquí|strong="H2088"\w* \w se|strong="H1961"\w* quedarán asombrados \w y|strong="H5921"\w* \w se|strong="H1961"\w* burlarán diciendo: “¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* Yahvé ha tratado \w así|strong="H3602"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w*?”.  
\v 9 \w Y|strong="H3068"\w* \w les|strong="H5921"\w* responderán: “\w Porque|strong="H5921"\w* abandonaron \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*, \w que|strong="H5921"\w* \w sacó|strong="H3318"\w* \w a|strong="H3068"\w* sus antepasados \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* entregaron \w a|strong="H3068"\w* otros dioses \w para|strong="H5921"\w* adorarlos \w y|strong="H5921"\w* servirlos. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* Yahvé ha traído \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w todo|strong="H3605"\w* \w este|strong="H2063"\w* \w mal|strong="H7451"\w*””.   
\p
\v 10 \w Después|strong="H1961"\w* de \w veinte|strong="H6242"\w* \w años|strong="H8141"\w*, tiempo en el \w que|strong="H1961"\w* \w Salomón|strong="H8010"\w* construyó \w los|strong="H1961"\w* \w dos|strong="H8147"\w* edificios (el \w templo|strong="H1004"\w* de Yahvé y el palacio \w real|strong="H4428"\w*),  
\v 11 \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* le \w entregó|strong="H5414"\w* \w veinte|strong="H6242"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5414"\w* \w la|strong="H3605"\w* región \w de|strong="H5414"\w* Galilea \w a|strong="H3068"\w* \w Hiram|strong="H2438"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Tiro|strong="H6865"\w*, \w porque|strong="H4428"\w* \w Hiram|strong="H2438"\w* le había proporcionado \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w madera|strong="H6086"\w* \w de|strong="H5414"\w* cedro y \w de|strong="H5414"\w* pino, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w oro|strong="H2091"\w* \w que|strong="H3605"\w* \w Salomón|strong="H8010"\w* quiso.  
\v 12 Pero cuando \w Hiram|strong="H2438"\w* \w salió|strong="H3318"\w* \w de|strong="H5414"\w* \w Tiro|strong="H6865"\w* \w para|strong="H5414"\w* \w ver|strong="H7200"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H3808"\w* \w Salomón|strong="H8010"\w* \w le|strong="H5869"\w* había \w dado|strong="H5414"\w*, \w no|strong="H3808"\w* \w le|strong="H5869"\w* gustaron.  
\v 13 \w Entonces|strong="H3117"\w* dijo: “Hermano, ¿\w qué|strong="H4100"\w* clase \w de|strong="H5704"\w* \w ciudades|strong="H5892"\w* son \w estas|strong="H2088"\w* \w que|strong="H4100"\w* me \w has|strong="H5414"\w* \w dado|strong="H5414"\w*?”. \w Por|strong="H2088"\w* eso, \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w* esa región \w se|strong="H4100"\w* conoce \w como|strong="H4100"\w* la tierra \w de|strong="H5704"\w* Cabul.  
\v 14 \w Hiram|strong="H2438"\w* le había \w enviado|strong="H7971"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* casi cuatro toneladas de \w oro|strong="H2091"\w*.   
\p
\v 15 El \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* estableció un sistema \w de|strong="H1697"\w* trabajo obligatorio para construir el \w templo|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé, su propio palacio, el terraplén llamado Milo, la muralla \w de|strong="H1697"\w* Jerusalén, y las ciudades \w de|strong="H1697"\w* Jasor, Meguido y Guézer.  
\v 16 (\w El|strong="H3427"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Egipto|strong="H4714"\w*, había atacado y conquistado Guézer; la incendió, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* \w que|strong="H1323"\w* \w vivían|strong="H3427"\w* allí y se la \w dio|strong="H5414"\w* como regalo \w de|strong="H5414"\w* bodas \w a|strong="H3068"\w* su \w hija|strong="H1323"\w*, la esposa \w de|strong="H5414"\w* \w Salomón|strong="H8010"\w*).  
\v 17 Así que \w Salomón|strong="H8010"\w* reconstruyó Guézer, Bet Jorón de abajo,  
\v 18 Baalat y Tamar, en el \w desierto|strong="H4057"\w* de Judá,  
\v 19 junto con \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* donde almacenaba sus provisiones, las \w ciudades|strong="H5892"\w* \w para|strong="H1961"\w* sus \w carros|strong="H7393"\w* de guerra y \w para|strong="H1961"\w* su caballería. \w Salomón|strong="H8010"\w* construyó \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w quiso|strong="H2836"\w* en Jerusalén, en \w el|strong="H3605"\w* \w Líbano|strong="H3844"\w* y en \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio bajo su dominio.  
\v 20 Había \w gente|strong="H5971"\w* \w que|strong="H4480"\w* todavía \w quedaba|strong="H3498"\w* \w de|strong="H4480"\w* \w los|strong="H1992"\w* amorreos, hititas, ferezeos, \w heveos|strong="H2340"\w* y \w jebuseos|strong="H2983"\w*, \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w eran|strong="H3808"\w* israelitas.  
\v 21 \w A|strong="H3068"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5704"\w* \w estos|strong="H2088"\w* pueblos \w que|strong="H3808"\w* \w aún|strong="H5704"\w* quedaban \w en|strong="H5704"\w* la tierra \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w que|strong="H3808"\w* \w los|strong="H1121"\w* israelitas \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* \w destruir|strong="H2763"\w*, \w Salomón|strong="H8010"\w* \w los|strong="H1121"\w* reclutó \w como|strong="H5704"\w* trabajadores forzados, \w y|strong="H5704"\w* \w así|strong="H2088"\w* continúan \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 22 \w Sin|strong="H3808"\w* embargo, \w Salomón|strong="H8010"\w* \w no|strong="H3808"\w* obligó \w a|strong="H3068"\w* \w ningún|strong="H3808"\w* \w israelita|strong="H3478"\w* \w a|strong="H3068"\w* realizar esos trabajos, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w ellos|strong="H1992"\w* servían \w como|strong="H3588"\w* soldados, oficiales, \w jefes|strong="H8269"\w*, \w capitanes|strong="H8269"\w* \w y|strong="H3588"\w* comandantes \w de|strong="H3588"\w* \w sus|strong="H1992"\w* \w carros|strong="H7393"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w su|strong="H1992"\w* caballería.  
\v 23 Estos eran \w los|strong="H5921"\w* \w quinientos|strong="H2568"\w* \w cincuenta|strong="H2572"\w* \w oficiales|strong="H5324"\w* \w principales|strong="H8269"\w* \w que|strong="H5921"\w* supervisaban \w los|strong="H5921"\w* trabajos \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w* \w y|strong="H5921"\w* \w dirigían|strong="H7287"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H5921"\w* realizaba \w las|strong="H5921"\w* obras.   
\p
\v 24 En cuanto la \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w* se mudó de la \w Ciudad|strong="H5892"\w* de \w David|strong="H1732"\w* al palacio \w que|strong="H1323"\w* Salomón le había construido, él mandó construir el terraplén de Milo.   
\p
\v 25 \w Tres|strong="H7969"\w* \w veces|strong="H6471"\w* \w al|strong="H5921"\w* \w año|strong="H8141"\w* \w Salomón|strong="H8010"\w* ofrecía \w holocaustos|strong="H5930"\w* \w y|strong="H5921"\w* sacrificios \w de|strong="H5921"\w* \w paz|strong="H7999"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w que|strong="H5921"\w* había construido \w para|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* quemaba incienso \w ante|strong="H6440"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w*. Así completó \w la|strong="H5921"\w* obra \w del|strong="H5921"\w* \w templo|strong="H1004"\w*.   
\p
\v 26 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* también construyó una flota \w de|strong="H5921"\w* barcos \w en|strong="H5921"\w* Ezión Guéber, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* Elot, \w en|strong="H5921"\w* \w la|strong="H5921"\w* costa \w del|strong="H5921"\w* \w Mar|strong="H3220"\w* Rojo, \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Edom.  
\v 27 \w Hiram|strong="H2438"\w* \w envió|strong="H7971"\w* \w en|strong="H5973"\w* esos barcos \w a|strong="H3068"\w* sus propios oficiales, \w que|strong="H3045"\w* eran marinos expertos, \w para|strong="H5973"\w* \w que|strong="H3045"\w* trabajaran \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w los|strong="H5973"\w* servidores \w de|strong="H5973"\w* \w Salomón|strong="H8010"\w*.  
\v 28 Ellos fueron \w a|strong="H3068"\w* Ofir y trajeron de \w allí|strong="H8033"\w* catorce toneladas de \w oro|strong="H2091"\w*, las cuales entregaron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*.   
\c 10  
\p
\v 1 Cuando la \w reina|strong="H4436"\w* de Sabá se enteró de la \w fama|strong="H8034"\w* que \w Salomón|strong="H8010"\w* tenía gracias al \w nombre|strong="H8034"\w* de Yahvé, fue \w a|strong="H3068"\w* visitarlo para ponerlo \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* con preguntas difíciles.  
\v 2 Llegó \w a|strong="H3068"\w* Jerusalén \w con|strong="H5973"\w* una caravana \w muy|strong="H3966"\w* \w grande|strong="H7227"\w*; sus \w camellos|strong="H1581"\w* \w estaban|strong="H1961"\w* \w cargados|strong="H5375"\w* \w de|strong="H5973"\w* \w especias|strong="H1314"\w*, muchísimo \w oro|strong="H2091"\w* y piedras \w preciosas|strong="H3368"\w*. Al presentarse ante \w Salomón|strong="H8010"\w*, platicó \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w de|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w tenía|strong="H1961"\w* \w en|strong="H5973"\w* mente.  
