\v 41 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w*, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w sabiduría|strong="H2451"\w* \w que|strong="H3808"\w* \w tuvo|strong="H6213"\w*, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w*.  
\v 42 \w Salomón|strong="H8010"\w* \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* Jerusalén \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* durante cuarenta \w años|strong="H8141"\w*.  
\v 43 Murió y fue \w sepultado|strong="H6912"\w* \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*, su padre. Su \w hijo|strong="H1121"\w* \w Roboam|strong="H7346"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 12  
\p
\v 1 \w Roboam|strong="H7346"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* Siquem, \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas se habían reunido allí \w para|strong="H3588"\w* proclamarlo \w rey|strong="H4427"\w*.  
\v 2 \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Nabat|strong="H5028"\w* \w se|strong="H1961"\w* enteró \w de|strong="H6440"\w* \w esto|strong="H1931"\w* \w en|strong="H5750"\w* \w Egipto|strong="H4714"\w*, \w donde|strong="H1931"\w* \w vivía|strong="H3427"\w* \w desde|strong="H6440"\w* \w que|strong="H1931"\w* \w huyó|strong="H1272"\w* del \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*.  
\v 3 Entonces mandaron \w a|strong="H3068"\w* llamarlo, y \w Jeroboam|strong="H3379"\w* fue con \w toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea de \w Israel|strong="H3478"\w* \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* con \w Roboam|strong="H7346"\w*. Le \w dijeron|strong="H1696"\w*:  
\v 4 “Su padre \w nos|strong="H5921"\w* \w impuso|strong="H5414"\w* un \w yugo|strong="H5923"\w* muy \w pesado|strong="H3515"\w*. \w Si|strong="H5921"\w* usted \w ahora|strong="H6258"\w* aligera \w el|strong="H5921"\w* \w duro|strong="H7186"\w* trabajo \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w yugo|strong="H5923"\w* \w pesado|strong="H3515"\w* \w que|strong="H6258"\w* \w él|strong="H5921"\w* \w nos|strong="H5921"\w* \w impuso|strong="H5414"\w*, \w nosotros|strong="H5921"\w* \w le|strong="H5921"\w* \w serviremos|strong="H5647"\w*”.   
\p
\v 5 Roboam \w respondió|strong="H7725"\w*: “Váyanse y \w vuelvan|strong="H7725"\w* \w a|strong="H3068"\w* verme \w dentro|strong="H5750"\w* \w de|strong="H5750"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*”.  
\p Así \w que|strong="H5971"\w* el \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* retiró.   
\p
\v 6 El \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* consultó con \w los|strong="H1961"\w* \w ancianos|strong="H2205"\w* \w que|strong="H5971"\w* \w habían|strong="H1961"\w* servido \w a|strong="H3068"\w* su padre \w Salomón|strong="H8010"\w* \w en|strong="H5975"\w* \w vida|strong="H2416"\w*, y les preguntó: “¿\w Qué|strong="H5971"\w* me aconsejan ustedes \w que|strong="H5971"\w* le \w responda|strong="H7725"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*?”.   
\p
\v 7 \w Ellos|strong="H3605"\w* le contestaron: “\w Si|strong="H1961"\w* \w hoy|strong="H3117"\w* \w se|strong="H1961"\w* pone usted al \w servicio|strong="H5650"\w* \w de|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* y les \w responde|strong="H6030"\w* con amabilidad, \w ellos|strong="H3605"\w* le \w servirán|strong="H5647"\w* \w para|strong="H1961"\w* \w siempre|strong="H3605"\w*”.   
\p
\v 8 Pero Roboam rechazó el \w consejo|strong="H6098"\w* \w de|strong="H6440"\w* los \w ancianos|strong="H2205"\w* y consultó con los jóvenes que se habían criado con él y que \w estaban|strong="H5975"\w* \w a|strong="H3068"\w* su servicio.  
\v 9 \w Les|strong="H5921"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w consejo|strong="H3289"\w* \w me|strong="H4480"\w* \w dan|strong="H5414"\w* ustedes? ¿\w Qué|strong="H4100"\w* debemos responderle \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w que|strong="H4100"\w* \w me|strong="H4480"\w* pide \w que|strong="H4100"\w* aligere \w el|strong="H5921"\w* \w yugo|strong="H5923"\w* \w que|strong="H4100"\w* \w mi|strong="H5921"\w* padre \w les|strong="H5921"\w* \w impuso|strong="H5414"\w*?”.   
\p
\v 10 \w Los|strong="H5921"\w* jóvenes \w que|strong="H5921"\w* \w se|strong="H5921"\w* habían criado \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w le|strong="H5921"\w* \w dijeron|strong="H1696"\w*: “\w A|strong="H3068"\w* \w ese|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* pidió \w que|strong="H5921"\w* \w les|strong="H5921"\w* quitaras peso \w de|strong="H5921"\w* \w encima|strong="H5921"\w*, respóndeles \w así|strong="H3541"\w*: “\w Mi|strong="H5921"\w* dedo meñique \w es|strong="H2088"\w* \w más|strong="H5921"\w* grueso \w que|strong="H5921"\w* \w la|strong="H5921"\w* cintura \w de|strong="H5921"\w* \w mi|strong="H5921"\w* padre.  
\v 11 \w Si|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w les|strong="H5921"\w* impuso un \w yugo|strong="H5923"\w* \w pesado|strong="H3515"\w*, ¡yo \w lo|strong="H5921"\w* haré \w más|strong="H3254"\w* \w pesado|strong="H3515"\w* todavía! \w Si|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w los|strong="H5921"\w* castigó \w con|strong="H5921"\w* látigos, ¡yo \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w con|strong="H5921"\w* escorpiones!””.   
\p
\v 12 \w Al|strong="H4428"\w* tercer \w día|strong="H3117"\w*, \w Jeroboam|strong="H3379"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* fueron \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w*, tal como \w el|strong="H3605"\w* \w rey|strong="H4428"\w* les había ordenado.  
\v 13 Pero el \w rey|strong="H4428"\w* les \w respondió|strong="H6030"\w* con aspereza, ignorando el \w consejo|strong="H6098"\w* \w que|strong="H5971"\w* le habían dado los \w ancianos|strong="H2205"\w*.  
\v 14 Siguiendo \w el|strong="H5921"\w* \w consejo|strong="H6098"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* jóvenes, \w les|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w Mi|strong="H5921"\w* padre \w les|strong="H5921"\w* hizo pesado \w el|strong="H5921"\w* \w yugo|strong="H5923"\w*, pero yo \w se|strong="H5921"\w* \w lo|strong="H5921"\w* haré \w más|strong="H3254"\w* pesado todavía; \w mi|strong="H5921"\w* padre \w los|strong="H5921"\w* castigó \w con|strong="H5921"\w* látigos, pero yo \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w con|strong="H5921"\w* escorpiones”.   
\p
\v 15 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* \w escuchó|strong="H8085"\w* \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* Yahvé mismo \w había|strong="H1961"\w* dispuesto las \w cosas|strong="H1697"\w* \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* cumpliera \w la|strong="H3588"\w* promesa \w que|strong="H3588"\w* \w le|strong="H5973"\w* \w había|strong="H1961"\w* \w hecho|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Nabat|strong="H5028"\w* \w por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* \w Ahías|strong="H3379"\w* \w de|strong="H3588"\w* Siló.  
\v 16 \w Cuando|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* les hacía caso, le \w respondieron|strong="H7725"\w*: “¿\w Qué|strong="H3588"\w* tenemos \w nosotros|strong="H3605"\w* \w que|strong="H3588"\w* \w ver|strong="H7200"\w* \w con|strong="H3588"\w* \w David|strong="H1732"\w*? ¡\w No|strong="H3808"\w* tenemos \w nada|strong="H3808"\w* \w que|strong="H3588"\w* \w ver|strong="H7200"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Isaí|strong="H3448"\w*! ¡\w Israel|strong="H3478"\w*, \w cada|strong="H3605"\w* uno \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*! ¡\w David|strong="H1732"\w*, ocúpate \w de|strong="H3588"\w* tu propia \w familia|strong="H1004"\w*!”. \w Y|strong="H3068"\w* \w así|strong="H3588"\w*, \w los|strong="H1121"\w* israelitas \w se|strong="H3808"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* sus \w casas|strong="H1004"\w*.   
\p
\v 17 \w Roboam|strong="H7346"\w* solo \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w los|strong="H3427"\w* israelitas \w que|strong="H5921"\w* \w vivían|strong="H3427"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 18 Tiempo \w después|strong="H5921"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Adoram, \w que|strong="H5921"\w* estaba \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* trabajo obligatorio, pero \w todos|strong="H3605"\w* \w los|strong="H5921"\w* israelitas \w lo|strong="H5921"\w* \w mataron|strong="H4191"\w* \w a|strong="H3068"\w* pedradas. Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* prisa \w a|strong="H3068"\w* su \w carro|strong="H4818"\w* \w y|strong="H5921"\w* \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* Jerusalén.  
\v 19 \w Así|strong="H2088"\w* fue \w como|strong="H5704"\w* \w Israel|strong="H3478"\w* se rebeló \w contra|strong="H3478"\w* la \w familia|strong="H1004"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w* \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*.   
\p
\v 20 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* israelitas supieron \w que|strong="H3588"\w* \w Jeroboam|strong="H3379"\w* \w había|strong="H1961"\w* regresado, \w lo|strong="H3808"\w* invitaron \w a|strong="H3068"\w* una asamblea \w y|strong="H3588"\w* \w lo|strong="H3808"\w* proclamaron \w rey|strong="H4427"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*. \w La|strong="H5921"\w* única \w que|strong="H3588"\w* \w se|strong="H1961"\w* mantuvo fiel \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w fue|strong="H1961"\w* \w la|strong="H5921"\w* \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\p
\v 21 Cuando \w Roboam|strong="H7346"\w* llegó \w a|strong="H3068"\w* Jerusalén, reunió \w a|strong="H3068"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w mil|strong="H3967"\w* \w de|strong="H5973"\w* \w los|strong="H1121"\w* mejores \w guerreros|strong="H6213"\w* \w de|strong="H5973"\w* las \w tribus|strong="H7626"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* y \w de|strong="H5973"\w* \w Benjamín|strong="H1144"\w* \w para|strong="H5973"\w* pelear \w contra|strong="H5973"\w* \w Israel|strong="H3478"\w* y recuperar \w el|strong="H5973"\w* \w reino|strong="H4410"\w* \w para|strong="H5973"\w* \w Roboam|strong="H7346"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Salomón|strong="H8010"\w*.  
\v 22 Pero Dios le \w habló|strong="H1697"\w* \w a|strong="H3068"\w* \w Semaías|strong="H8098"\w*, hombre \w de|strong="H1697"\w* Dios, y le dijo:  
\v 23 “Diles \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* las tribus \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*, y \w al|strong="H4428"\w* \w resto|strong="H3499"\w* del \w pueblo|strong="H5971"\w*,  
\v 24 \w que|strong="H3588"\w* \w así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: “\w No|strong="H3808"\w* \w vayan|strong="H3212"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5973"\w* sus hermanos israelitas. Regrese \w cada|strong="H1697"\w* uno \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* he dispuesto \w que|strong="H3588"\w* \w esto|strong="H2088"\w* suceda””. Ellos \w obedecieron|strong="H8085"\w* \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* regresaron \w a|strong="H3068"\w* sus \w casas|strong="H1004"\w*, \w tal|strong="H2088"\w* \w como|strong="H3588"\w* \w él|strong="H5973"\w* \w se|strong="H1961"\w* \w lo|strong="H1697"\w* ordenó.   
\p
\v 25 \w Jeroboam|strong="H3379"\w* fortificó la ciudad de Siquem, \w en|strong="H3318"\w* la región montañosa de Efraín, y se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w allí|strong="H8033"\w*. \w Después|strong="H3427"\w* \w salió|strong="H3318"\w* y fortificó \w a|strong="H3068"\w* Penuel.  
\v 26 \w Jeroboam|strong="H3379"\w* pensó: “Es muy probable \w que|strong="H6258"\w* el \w reino|strong="H4467"\w* \w vuelva|strong="H7725"\w* \w a|strong="H3068"\w* manos de la \w familia|strong="H1004"\w* de \w David|strong="H1732"\w*.  
\v 27 Si \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* sigue yendo \w a|strong="H3068"\w* Jerusalén \w para|strong="H5971"\w* ofrecer \w sacrificios|strong="H2077"\w* en \w el|strong="H6213"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, terminarán poniéndose \w de|strong="H5971"\w* parte \w de|strong="H5971"\w* su \w señor|strong="H3068"\w* \w Roboam|strong="H7346"\w*, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w*. \w Entonces|strong="H7725"\w* me \w matarán|strong="H2026"\w* y \w se|strong="H5971"\w* irán con \w él|strong="H6213"\w*”.  
\v 28 Así que, después de buscar \w consejo|strong="H3289"\w*, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* \w dos|strong="H8147"\w* \w becerros|strong="H5695"\w* de \w oro|strong="H2091"\w* y le dijo \w al|strong="H4428"\w* \w pueblo|strong="H7227"\w*: “\w Ya|strong="H3068"\w* \w no|strong="H6213"\w* \w hace|strong="H6213"\w* falta que suban \w a|strong="H3068"\w* Jerusalén. ¡\w Aquí|strong="H2009"\w* \w están|strong="H2009"\w*, \w Israel|strong="H3478"\w*, tus dioses que te sacaron de \w Egipto|strong="H4714"\w*!”.  
\v 29 \w Puso|strong="H7760"\w* uno en Betel y \w el|strong="H1008"\w* otro en \w Dan|strong="H1835"\w*.  
\v 30 \w Esto|strong="H2088"\w* \w se|strong="H1961"\w* convirtió \w en|strong="H5704"\w* un gran \w pecado|strong="H2403"\w*, \w pues|strong="H2088"\w* el \w pueblo|strong="H5971"\w* \w iba|strong="H3212"\w* \w hasta|strong="H5704"\w* \w Dan|strong="H1835"\w* \w para|strong="H5704"\w* adorar \w al|strong="H5704"\w* becerro.  
\v 31 Jeroboam también construyó santuarios en las colinas y nombró \w sacerdotes|strong="H3548"\w* \w a|strong="H3068"\w* \w gente|strong="H5971"\w* común \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w era|strong="H1961"\w* \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*.  
\v 32 \w Además|strong="H5921"\w*, instituyó una \w fiesta|strong="H2282"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w quince|strong="H2568"\w* \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w octavo|strong="H8066"\w*, parecida \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w fiesta|strong="H2282"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* celebraba \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w En|strong="H5921"\w* Betel \w ofreció|strong="H2076"\w* \w sacrificios|strong="H2076"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w que|strong="H5921"\w* \w había|strong="H5975"\w* construido \w para|strong="H5921"\w* \w los|strong="H5921"\w* \w becerros|strong="H5695"\w*, \w y|strong="H5921"\w* allí mismo instaló \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* santuarios \w de|strong="H5921"\w* \w las|strong="H5921"\w* colinas.  
\v 33 \w El|strong="H5921"\w* \w día|strong="H3117"\w* \w quince|strong="H2568"\w* \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w octavo|strong="H8066"\w*, \w mes|strong="H2320"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* mismo \w había|strong="H6213"\w* elegido \w a|strong="H3068"\w* su antojo, Jeroboam \w ofreció|strong="H6213"\w* sacrificios \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Betel \w e|strong="H3068"\w* instituyó una \w fiesta|strong="H2282"\w* \w para|strong="H5921"\w* \w los|strong="H1121"\w* israelitas, \w y|strong="H5921"\w* \w subió|strong="H5927"\w* \w al|strong="H5921"\w* \w altar|strong="H4196"\w* \w a|strong="H3068"\w* quemar incienso.   
\c 13  
\p
\v 1 \w Por|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé, un hombre \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* salió \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* llegó \w a|strong="H3068"\w* Betel justo cuando \w Jeroboam|strong="H3379"\w* \w estaba|strong="H5975"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w altar|strong="H4196"\w* \w para|strong="H5921"\w* quemar incienso.  
\v 2 \w Por|strong="H5921"\w* mandato \w de|strong="H5921"\w* Yahvé, \w el|strong="H5921"\w* \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w gritó|strong="H7121"\w* \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*: “¡\w Altar|strong="H4196"\w*, \w altar|strong="H4196"\w*! \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: “\w En|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w nacerá|strong="H3205"\w* un \w hijo|strong="H1121"\w* \w llamado|strong="H8034"\w* \w Josías|strong="H2977"\w*. \w Él|strong="H5921"\w* sacrificará \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* santuarios \w de|strong="H5921"\w* \w las|strong="H5921"\w* colinas \w que|strong="H5921"\w* \w aquí|strong="H2009"\w* queman incienso, \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w se|strong="H5921"\w* \w quemarán|strong="H8313"\w* \w huesos|strong="H6106"\w* humanos””.  
\v 3 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* \w el|strong="H1931"\w* hombre \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w dio|strong="H5414"\w* una señal: “\w Esta|strong="H2088"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* señal \w de|strong="H5921"\w* \w que|strong="H1931"\w* Yahvé ha \w hablado|strong="H1696"\w*: \w El|strong="H1931"\w* \w altar|strong="H4196"\w* \w se|strong="H1931"\w* partirá, \w y|strong="H5921"\w* \w las|strong="H5921"\w* cenizas \w que|strong="H1931"\w* hay \w sobre|strong="H5921"\w* \w él|strong="H1931"\w* \w se|strong="H1931"\w* desparramarán”.   
\p
\v 4 \w Cuando|strong="H1961"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Jeroboam|strong="H3379"\w* \w oyó|strong="H8085"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* hombre \w de|strong="H5921"\w* Dios gritaba \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Betel, \w extendió|strong="H7971"\w* su \w mano|strong="H3027"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* ordenó: “¡Atrápenlo!”. Pero \w en|strong="H5921"\w* ese mismo instante \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w se|strong="H1961"\w* \w le|strong="H5921"\w* \w quedó|strong="H1961"\w* tiesa, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w pudo|strong="H3201"\w* \w volverla|strong="H7725"\w* \w a|strong="H3068"\w* su sitio.  
\v 5 El \w altar|strong="H4196"\w* \w se|strong="H4480"\w* partió y las cenizas \w se|strong="H4480"\w* desparramaron, \w tal|strong="H1697"\w* como el hombre \w de|strong="H4480"\w* \w Dios|strong="H3068"\w* \w lo|strong="H1697"\w* había anunciado \w por|strong="H4480"\w* orden \w de|strong="H4480"\w* Yahvé.  
\v 6 \w Entonces|strong="H7725"\w* el \w rey|strong="H4428"\w* \w le|strong="H1157"\w* suplicó \w al|strong="H4428"\w* hombre \w de|strong="H6440"\w* \w Dios|strong="H3068"\w*: “\w Por|strong="H1157"\w* favor, busca el favor \w de|strong="H6440"\w* Yahvé tu \w Dios|strong="H3068"\w* y \w ruega|strong="H6419"\w* \w por|strong="H1157"\w* \w mí|strong="H1961"\w* \w para|strong="H1961"\w* \w que|strong="H4994"\w* \w se|strong="H1961"\w* me cure la \w mano|strong="H3027"\w*”.  
\p El hombre \w de|strong="H6440"\w* \w Dios|strong="H3068"\w* rogó \w a|strong="H3068"\w* Yahvé, y la \w mano|strong="H3027"\w* del \w rey|strong="H4428"\w* sanó y \w quedó|strong="H1961"\w* \w como|strong="H1961"\w* \w estaba|strong="H1961"\w* \w antes|strong="H6440"\w*.   
\p
\v 7 El \w rey|strong="H4428"\w* le \w dijo|strong="H1696"\w* \w al|strong="H4428"\w* hombre \w de|strong="H5414"\w* Dios: “Ven conmigo \w a|strong="H3068"\w* mi \w casa|strong="H1004"\w* \w para|strong="H5414"\w* que comas algo y \w descanses|strong="H5414"\w*, y te \w daré|strong="H5414"\w* un regalo”.   
\p
\v 8 Pero \w el|strong="H5973"\w* hombre \w de|strong="H5973"\w* Dios \w le|strong="H5973"\w* respondió: “\w Aunque|strong="H3808"\w* usted \w me|strong="H5973"\w* \w diera|strong="H5414"\w* la mitad \w de|strong="H5973"\w* su palacio, \w no|strong="H3808"\w* iría \w con|strong="H5973"\w* usted, \w ni|strong="H3808"\w* comería \w pan|strong="H3899"\w* \w ni|strong="H3808"\w* \w bebería|strong="H8354"\w* \w agua|strong="H4325"\w* \w en|strong="H5973"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 9 \w Porque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* \w dio|strong="H7725"\w* \w esta|strong="H3651"\w* \w orden|strong="H6680"\w*: “\w No|strong="H3808"\w* \w comas|strong="H3899"\w* \w pan|strong="H3899"\w* \w ni|strong="H3808"\w* \w bebas|strong="H8354"\w* \w agua|strong="H4325"\w* allí, \w ni|strong="H3808"\w* regreses \w por|strong="H3588"\w* \w el|strong="H3588"\w* mismo \w camino|strong="H1870"\w* \w por|strong="H3588"\w* donde \w fuiste|strong="H1980"\w*””.  
\v 10 Así \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w fue|strong="H3212"\w* \w por|strong="H1870"\w* otro \w camino|strong="H1870"\w* y \w no|strong="H3808"\w* regresó \w por|strong="H1870"\w* donde había venido \w a|strong="H3068"\w* Betel.   
\p
\v 11 En Betel \w vivía|strong="H3427"\w* un \w viejo|strong="H2205"\w* \w profeta|strong="H5030"\w*. Sus \w hijos|strong="H1121"\w* fueron \w a|strong="H3068"\w* contarle \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w el|strong="H1008"\w* \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Dios \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* ese \w día|strong="H3117"\w* en Betel y \w lo|strong="H1697"\w* \w que|strong="H1697"\w* le \w había|strong="H6213"\w* \w dicho|strong="H1697"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.   
\p
\v 12 \w El|strong="H1121"\w* padre les preguntó: “¿\w Por|strong="H1870"\w* \w qué|strong="H1121"\w* \w camino|strong="H1870"\w* se \w fue|strong="H1980"\w*?”. Sus \w hijos|strong="H1121"\w* le mostraron \w el|strong="H1121"\w* \w camino|strong="H1870"\w* \w que|strong="H1121"\w* había tomado \w el|strong="H1121"\w* \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Dios \w que|strong="H1121"\w* venía \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 13 Entonces \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*: “Ensíllenme \w el|strong="H5921"\w* burro”. \w Ellos|strong="H5921"\w* \w lo|strong="H5921"\w* ensillaron, \w y|strong="H5921"\w* \w él|strong="H5921"\w* montó \w en|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 14 \w Fue|strong="H3212"\w* tras \w el|strong="H3427"\w* hombre \w de|strong="H8478"\w* Dios y lo encontró \w sentado|strong="H3427"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w una|strong="H4672"\w* encina. Le preguntó: “¿Eres tú \w el|strong="H3427"\w* hombre \w de|strong="H8478"\w* Dios que \w vino|strong="H3212"\w* \w de|strong="H8478"\w* \w Judá|strong="H3063"\w*?”.  
\p \w Él|strong="H3427"\w* respondió: “Sí, yo soy”.   
\p
\v 15 El viejo profeta le dijo: “\w Ven|strong="H3212"\w* conmigo \w a|strong="H3068"\w* mi \w casa|strong="H1004"\w* \w a|strong="H3068"\w* comer”.   
\p
\v 16 Pero el hombre \w de|strong="H4325"\w* Dios le contestó: “\w No|strong="H3808"\w* \w puedo|strong="H3201"\w* regresar con usted \w ni|strong="H3808"\w* entrar en su casa; \w tampoco|strong="H3808"\w* \w puedo|strong="H3201"\w* comer \w pan|strong="H3899"\w* \w ni|strong="H3808"\w* \w beber|strong="H8354"\w* \w agua|strong="H4325"\w* con usted en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 17 \w Porque|strong="H3588"\w* \w por|strong="H3588"\w* orden \w de|strong="H3588"\w* Yahvé \w se|strong="H3808"\w* \w me|strong="H3588"\w* dijo: “\w No|strong="H3808"\w* \w comas|strong="H3899"\w* \w pan|strong="H3899"\w* \w ni|strong="H3808"\w* \w bebas|strong="H8354"\w* \w agua|strong="H4325"\w* \w allí|strong="H8033"\w*, \w ni|strong="H3808"\w* regreses \w por|strong="H3588"\w* \w el|strong="H3588"\w* mismo \w camino|strong="H1870"\w* \w por|strong="H3588"\w* \w donde|strong="H8033"\w* \w fuiste|strong="H1980"\w*””.   
\p
\v 18 \w Entonces|strong="H7725"\w* \w el|strong="H5030"\w* \w viejo|strong="H5030"\w* \w profeta|strong="H5030"\w* le mintió: “Yo \w también|strong="H1571"\w* soy \w profeta|strong="H5030"\w* \w como|strong="H1571"\w* tú, \w y|strong="H1571"\w* un \w ángel|strong="H4397"\w* me \w dijo|strong="H1696"\w* \w por|strong="H1697"\w* orden \w de|strong="H1697"\w* Yahvé: “Haz \w que|strong="H1571"\w* regrese contigo \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w* para \w que|strong="H1571"\w* coma \w y|strong="H1571"\w* beba \w algo|strong="H1697"\w*””.   
\p
\v 19 Así \w que|strong="H4325"\w* el hombre \w de|strong="H4325"\w* Dios regresó con él, y comió y \w bebió|strong="H8354"\w* en su \w casa|strong="H1004"\w*.  
\v 20 Mientras \w estaban|strong="H1961"\w* \w sentados|strong="H3427"\w* \w a|strong="H3068"\w* la \w mesa|strong="H7979"\w*, Yahvé le \w habló|strong="H1697"\w* al \w profeta|strong="H5030"\w* \w que|strong="H1697"\w* \w lo|strong="H1697"\w* \w había|strong="H1961"\w* \w hecho|strong="H1961"\w* regresar.  
\v 21 Este le \w gritó|strong="H7121"\w* al hombre \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* venía \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*: “\w Así|strong="H3541"\w* dice Yahvé: “\w Por|strong="H3588"\w* \w haber|strong="H3808"\w* desobedecido mi \w palabra|strong="H6310"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w haber|strong="H3808"\w* cumplido \w el|strong="H3588"\w* \w mandato|strong="H6310"\w* \w que|strong="H3588"\w* Yahvé tu \w Dios|strong="H3068"\w* \w te|strong="H3588"\w* dio,  
\v 22 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* regresaste \w a|strong="H3068"\w* comer y \w beber|strong="H8354"\w* en el \w lugar|strong="H4725"\w* \w donde|strong="H4725"\w* te \w dije|strong="H1696"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* hicieras, tu \w cuerpo|strong="H5038"\w* \w no|strong="H3808"\w* \w será|strong="H3808"\w* enterrado en la tumba \w de|strong="H4325"\w* tus antepasados””.   
\p
\v 23 \w Después|strong="H1961"\w* de \w que|strong="H1961"\w* \w el|strong="H5030"\w* hombre de Dios terminó de comer y \w beber|strong="H8354"\w*, \w el|strong="H5030"\w* \w viejo|strong="H5030"\w* \w profeta|strong="H5030"\w* le ensilló \w el|strong="H5030"\w* burro.  
\v 24 Mientras el hombre de Dios \w iba|strong="H3212"\w* \w por|strong="H1870"\w* el \w camino|strong="H1870"\w*, un león le \w salió|strong="H3212"\w* al encuentro y lo \w mató|strong="H4191"\w*. Su \w cuerpo|strong="H5038"\w* \w quedó|strong="H1961"\w* tirado \w en|strong="H5975"\w* el \w camino|strong="H1870"\w*, con el burro y el león parados junto \w a|strong="H3068"\w* él.  
\v 25 Unas personas que \w pasaban|strong="H5674"\w* \w por|strong="H1870"\w* allí \w vieron|strong="H7200"\w* \w el|strong="H5674"\w* \w cuerpo|strong="H5038"\w* tirado \w en|strong="H5975"\w* \w el|strong="H5674"\w* \w camino|strong="H1870"\w* y al león parado \w a|strong="H3068"\w* su lado, y fueron \w a|strong="H3068"\w* contarlo \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* donde \w vivía|strong="H3427"\w* \w el|strong="H5674"\w* \w viejo|strong="H2205"\w* \w profeta|strong="H5030"\w*.  
\v 26 Cuando \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w que|strong="H4480"\w* \w lo|strong="H1931"\w* había hecho regresar \w lo|strong="H1931"\w* \w supo|strong="H8085"\w*, \w dijo|strong="H1696"\w*: “\w Es|strong="H1931"\w* \w el|strong="H1931"\w* hombre \w de|strong="H4480"\w* \w Dios|strong="H3068"\w* \w que|strong="H4480"\w* desobedeció \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* Yahvé. \w Por|strong="H4480"\w* \w eso|strong="H1931"\w* Yahvé \w lo|strong="H1931"\w* \w entregó|strong="H5414"\w* \w al|strong="H4480"\w* león, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w lo|strong="H1931"\w* destrozara y \w lo|strong="H1931"\w* \w matara|strong="H4191"\w*, \w tal|strong="H1697"\w* \w como|strong="H1931"\w* Yahvé \w se|strong="H1931"\w* \w lo|strong="H1931"\w* había advertido”.  
\v 27 Luego les \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*: “Ensíllenme \w el|strong="H1121"\w* burro”. \w Y|strong="H3068"\w* ellos lo ensillaron.  
\v 28 El profeta \w fue|strong="H3212"\w* y encontró el \w cuerpo|strong="H5038"\w* tirado \w en|strong="H5975"\w* el \w camino|strong="H1870"\w*, con el burro y el león todavía allí. El león \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w había|strong="H5975"\w* comido el \w cuerpo|strong="H5038"\w* \w ni|strong="H3808"\w* \w había|strong="H5975"\w* atacado al burro.  
\v 29 \w Entonces|strong="H7725"\w* \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w levantó|strong="H5375"\w* \w el|strong="H5030"\w* \w cuerpo|strong="H5038"\w* del hombre de Dios, lo \w puso|strong="H5375"\w* sobre \w el|strong="H5030"\w* burro y se lo \w llevó|strong="H5375"\w* \w a|strong="H3068"\w* su \w ciudad|strong="H5892"\w* para hacerle duelo y enterrarlo.  
\v 30 \w Puso|strong="H3240"\w* \w el|strong="H5921"\w* \w cuerpo|strong="H5038"\w* \w en|strong="H5921"\w* su propia tumba, \w y|strong="H5921"\w* lloraron \w por|strong="H5921"\w* \w él|strong="H5921"\w* diciendo: “¡\w Ay|strong="H1945"\w*, hermano \w mío|strong="H5921"\w*!”.   
\p
\v 31 \w Después|strong="H1961"\w* \w de|strong="H1121"\w* enterrarlo, les dijo \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*: “\w Cuando|strong="H1961"\w* yo \w muera|strong="H4191"\w*, entiérrenme \w en|strong="H6912"\w* la misma tumba donde \w está|strong="H1961"\w* \w el|strong="H1121"\w* \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Dios; pongan mis \w huesos|strong="H6106"\w* junto \w a|strong="H3068"\w* \w los|strong="H1121"\w* suyos.  
\v 32 \w Porque|strong="H3588"\w* sin duda \w se|strong="H1961"\w* cumplirá \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w él|strong="H5921"\w* anunció \w por|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Betel \w y|strong="H3588"\w* \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* santuarios \w de|strong="H5921"\w* \w las|strong="H5921"\w* colinas \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Samaria|strong="H8111"\w*”.   
\p
\v 33 \w A|strong="H3068"\w* pesar \w de|strong="H5971"\w* \w esto|strong="H2088"\w*, \w Jeroboam|strong="H3379"\w* \w no|strong="H3808"\w* cambió su \w mala|strong="H7451"\w* conducta, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* siguió nombrando \w sacerdotes|strong="H3548"\w* \w para|strong="H1961"\w* \w los|strong="H1961"\w* santuarios \w de|strong="H5971"\w* las colinas \w de|strong="H5971"\w* \w entre|strong="H3808"\w* la \w gente|strong="H5971"\w* común. \w A|strong="H3068"\w* cualquiera \w que|strong="H3808"\w* quería ser \w sacerdote|strong="H3548"\w*, \w él|strong="H6213"\w* \w lo|strong="H1697"\w* consagraba.  
\v 34 \w Este|strong="H2088"\w* \w pecado|strong="H2403"\w* causó \w la|strong="H5921"\w* ruina \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w* \w y|strong="H5921"\w* su desaparición total \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.   
\c 14  
\p
\v 1 Por \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, Abías, \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeroboam|strong="H3379"\w*, \w se|strong="H1931"\w* \w enfermó|strong="H2470"\w*.  
\v 2 \w Jeroboam|strong="H3379"\w* \w le|strong="H1931"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* esposa: “\w Mira|strong="H2009"\w*, \w levántate|strong="H6965"\w* \w y|strong="H3588"\w* \w disfrázate|strong="H8138"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w nadie|strong="H3808"\w* \w sepa|strong="H3045"\w* \w que|strong="H3588"\w* \w eres|strong="H1931"\w* \w mi|strong="H5921"\w* esposa, \w y|strong="H3588"\w* \w ve|strong="H1980"\w* \w a|strong="H3068"\w* \w Siló|strong="H7887"\w*. \w Allá|strong="H8033"\w* vive \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w Ahías|strong="H3379"\w*, \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* anunció \w que|strong="H3588"\w* \w yo|strong="H3588"\w* sería \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*.  
