\id 1KI  
\h 1 REYES 
\toc3 1 Reyes 
\toc1 PRIMER LIBRO DE LOS REYES 
\toc2 1 REYES 
\mt2 Primer libro de los  
\mt1 Reyes  
\c 1  
\p
\v 1 El \w rey|strong="H4428"\w* \w David|strong="H1732"\w* ya era muy anciano y entrado en \w años|strong="H3117"\w*; y \w aunque|strong="H3808"\w* \w lo|strong="H3808"\w* \w cubrían|strong="H3680"\w* con mantas, \w no|strong="H3808"\w* lograba entrar en calor.  
\v 2 \w Por|strong="H6440"\w* eso, sus servidores le dijeron: “\w Busquen|strong="H1245"\w* \w a|strong="H3068"\w* una joven \w virgen|strong="H1330"\w* \w para|strong="H1961"\w* \w mi|strong="H1961"\w* señor el \w rey|strong="H4428"\w*, \w para|strong="H1961"\w* \w que|strong="H1961"\w* lo atienda y lo cuide, y \w se|strong="H1961"\w* acueste \w a|strong="H3068"\w* su lado \w para|strong="H1961"\w* darle calor”.  
\v 3 Así \w que|strong="H3605"\w* \w buscaron|strong="H1245"\w* \w a|strong="H3068"\w* \w una|strong="H4672"\w* joven \w hermosa|strong="H3303"\w* \w por|strong="H4428"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de \w Israel|strong="H3478"\w*; encontraron \w a|strong="H3068"\w* Abisag, \w la|strong="H3605"\w* \w sunamita|strong="H7767"\w*, y \w la|strong="H3605"\w* llevaron ante \w el|strong="H3605"\w* \w rey|strong="H4428"\w*.  
\v 4 La joven \w era|strong="H1961"\w* bellísima \w y|strong="H5704"\w* \w se|strong="H3045"\w* dedicó \w a|strong="H3068"\w* servir \w al|strong="H5704"\w* \w rey|strong="H4428"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* cuidarlo, pero el \w rey|strong="H4428"\w* \w nunca|strong="H3808"\w* \w tuvo|strong="H1961"\w* relaciones sexuales \w con|strong="H5704"\w* ella.   
\p
\v 5 Mientras tanto, Adonías \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Haguit se llenó \w de|strong="H6440"\w* orgullo y decía: “\w Yo|strong="H6213"\w* voy \w a|strong="H3068"\w* ser \w el|strong="H1121"\w* \w rey|strong="H4427"\w*”. Así \w que|strong="H1121"\w* se consiguió \w carros|strong="H7393"\w*, caballos y \w cincuenta|strong="H2572"\w* \w hombres|strong="H1121"\w* \w que|strong="H1121"\w* corrieran \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H1121"\w*.  
\v 6 \w Su|strong="H1931"\w* padre \w nunca|strong="H3808"\w* \w lo|strong="H1931"\w* \w había|strong="H6213"\w* corregido \w ni|strong="H3808"\w* \w le|strong="H1931"\w* \w había|strong="H6213"\w* preguntado: “¿\w Por|strong="H4069"\w* \w qué|strong="H1931"\w* \w haces|strong="H6213"\w* \w esto|strong="H1931"\w*?”. Adonías \w era|strong="H1931"\w* \w muy|strong="H3966"\w* apuesto \w y|strong="H1571"\w* \w había|strong="H6213"\w* \w nacido|strong="H3205"\w* después de Absalón.  
\v 7 \w Se|strong="H1961"\w* puso \w de|strong="H5973"\w* acuerdo \w con|strong="H5973"\w* \w Joab|strong="H3097"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Sarvia y \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* Abiatar, y ellos \w lo|strong="H1697"\w* apoyaron \w en|strong="H5973"\w* sus planes.  
\v 8 Pero \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Joyadá, \w el|strong="H5973"\w* \w profeta|strong="H5030"\w* Natán, Simer, Reí y la guardia especial \w de|strong="H5973"\w* \w David|strong="H1732"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* unieron \w a|strong="H3068"\w* Adonías.   
\p
\v 9 Adonías \w sacrificó|strong="H2076"\w* \w ovejas|strong="H6629"\w*, \w bueyes|strong="H1241"\w* \w y|strong="H1241"\w* \w animales|strong="H1121"\w* engordados \w junto|strong="H5973"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* piedra \w de|strong="H5973"\w* Zojelet, \w que|strong="H1121"\w* está \w cerca|strong="H5973"\w* \w de|strong="H5973"\w* \w En|strong="H5973"\w* Roguel. Invitó \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus hermanos, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w del|strong="H5973"\w* \w rey|strong="H4428"\w*, \w y|strong="H1241"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* \w que|strong="H1121"\w* estaban \w al|strong="H4428"\w* \w servicio|strong="H5650"\w* \w del|strong="H5973"\w* \w rey|strong="H4428"\w*;  
\v 10 pero \w no|strong="H3808"\w* invitó al \w profeta|strong="H5030"\w* Natán, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* la guardia especial, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* su hermano \w Salomón|strong="H8010"\w*.   
\p
\v 11 \w Entonces|strong="H3588"\w* Natán le dijo \w a|strong="H3068"\w* Betsabé, \w la|strong="H3588"\w* madre \w de|strong="H3588"\w* \w Salomón|strong="H8010"\w*: “¿\w No|strong="H3808"\w* \w te|strong="H3588"\w* \w has|strong="H4427"\w* enterado \w de|strong="H3588"\w* \w que|strong="H3588"\w* Adonías \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Haguit \w se|strong="H3045"\w* \w ha|strong="H3808"\w* proclamado \w rey|strong="H4427"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* nuestro señor \w David|strong="H1732"\w* \w ni|strong="H3808"\w* siquiera \w lo|strong="H3808"\w* \w sabe|strong="H3045"\w*?  
\v 12 \w Ven|strong="H3212"\w* \w ahora|strong="H6258"\w*, déjame darte un \w consejo|strong="H6098"\w* \w para|strong="H6258"\w* \w que|strong="H6258"\w* salves tu \w vida|strong="H5315"\w* y la \w de|strong="H1121"\w* tu \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*.  
\v 13 \w Ve|strong="H3212"\w* \w de|strong="H5921"\w* inmediato \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* dile: ‘¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* \w juró|strong="H7650"\w* usted, \w mi|strong="H5921"\w* señor \w el|strong="H1931"\w* \w rey|strong="H4428"\w*, \w que|strong="H3588"\w* \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* reinaría \w después|strong="H5921"\w* \w de|strong="H5921"\w* usted \w y|strong="H3588"\w* \w se|strong="H1931"\w* sentaría \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w trono|strong="H3678"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w*, \w entonces|strong="H3588"\w*, Adonías \w se|strong="H1931"\w* \w ha|strong="H3808"\w* hecho \w rey|strong="H4428"\w*?’.  
\v 14 \w Mira|strong="H2009"\w*,\f + \fr 1:14 \ft “He aquí”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* \w mientras|strong="H5750"\w* tú estés \w hablando|strong="H1696"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w*, \w yo|strong="H2009"\w* entraré después \w de|strong="H5973"\w* \w ti|strong="H5973"\w* \w para|strong="H5973"\w* confirmar \w lo|strong="H1697"\w* \w que|strong="H1697"\w* hayas \w dicho|strong="H1696"\w*”.   
\p
\v 15 Betsabé fue \w a|strong="H3068"\w* la habitación del \w rey|strong="H4428"\w*. Él estaba \w muy|strong="H3966"\w* anciano, y Abisag la \w sunamita|strong="H7767"\w* lo atendía.  
\v 16 Betsabé \w se|strong="H4100"\w* \w inclinó|strong="H6915"\w* ante el \w rey|strong="H4428"\w* en señal de respeto. El \w rey|strong="H4428"\w* le preguntó: “¿\w Qué|strong="H4100"\w* \w se|strong="H4100"\w* te ofrece?”.   
\p
\v 17 \w Ella|strong="H1931"\w* \w le|strong="H1931"\w* respondió: “\w Señor|strong="H3068"\w* \w mío|strong="H5921"\w*, usted \w le|strong="H1931"\w* \w juró|strong="H7650"\w* \w a|strong="H3068"\w* \w esta|strong="H1931"\w* servidora \w suya|strong="H1931"\w* \w por|strong="H5921"\w* Yahvé\f + \fr 1:17 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones. \f* \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*\f + \fr 1:17 \ft Un talento equivale a unos 30 kilogramos o 66 libras o 965 onzas troy, por lo que 666 talentos son unas 20 toneladas métricas\f*: ‘Tu \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w me|strong="H5921"\w* sucederá \w como|strong="H3588"\w* \w rey|strong="H4427"\w* \w y|strong="H3588"\w* \w se|strong="H1931"\w* sentará \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w trono|strong="H3678"\w*’.  
\v 18 Pero resulta \w que|strong="H3808"\w* Adonías \w ya|strong="H6258"\w* \w se|strong="H3045"\w* \w ha|strong="H3808"\w* hecho \w rey|strong="H4428"\w*, y usted, \w mi|strong="H2009"\w* señor el \w rey|strong="H4428"\w*, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sabe|strong="H3045"\w*.  
\v 19 \w Él|strong="H3605"\w* \w ha|strong="H3808"\w* sacrificado muchísimos \w bueyes|strong="H7794"\w*, \w animales|strong="H1121"\w* engordados \w y|strong="H7794"\w* \w ovejas|strong="H6629"\w*, \w y|strong="H7794"\w* \w ha|strong="H3808"\w* invitado \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* del \w rey|strong="H4428"\w*, \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* Abiatar \w y|strong="H7794"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*, \w el|strong="H3605"\w* \w general|strong="H8269"\w* del \w ejército|strong="H6635"\w*; pero \w no|strong="H3808"\w* invitó \w a|strong="H3068"\w* su servidor \w Salomón|strong="H8010"\w*.  
\v 20 Ahora, \w mi|strong="H5921"\w* señor \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w está|strong="H3427"\w* pendiente \w de|strong="H5921"\w* usted, esperando \w que|strong="H4310"\w* \w les|strong="H5921"\w* diga \w quién|strong="H4310"\w* \w se|strong="H5921"\w* sentará \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* usted.  
\v 21 \w De|strong="H5973"\w* lo contrario, \w en|strong="H5973"\w* cuanto usted descanse \w con|strong="H5973"\w* sus antepasados, \w mi|strong="H1961"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* y yo \w seremos|strong="H1961"\w* tratados \w como|strong="H5973"\w* criminales”.   
\p
\v 22 \w Mientras|strong="H5750"\w* ella \w hablaba|strong="H1696"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w*, llegó \w el|strong="H5973"\w* \w profeta|strong="H5030"\w* Natán.  
\v 23 \w Le|strong="H5921"\w* informaron \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “\w Aquí|strong="H2009"\w* \w está|strong="H5921"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* Natán”.  
\p Cuando entró \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w se|strong="H5921"\w* inclinó \w hasta|strong="H5921"\w* tocar \w el|strong="H5921"\w* suelo \w con|strong="H5921"\w* \w la|strong="H5921"\w* frente.  
\v 24 Entonces Natán dijo: “\w Mi|strong="H5921"\w* señor \w el|strong="H1931"\w* \w rey|strong="H4428"\w*, ¿acaso usted ha declarado \w que|strong="H1931"\w* Adonías \w reinará|strong="H4427"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* usted \w y|strong="H5921"\w* \w se|strong="H1931"\w* sentará \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w trono|strong="H3678"\w*?  
\v 25 \w Porque|strong="H3588"\w* \w hoy|strong="H3117"\w* \w mismo|strong="H3605"\w* \w fue|strong="H6635"\w* \w y|strong="H3588"\w* \w sacrificó|strong="H2076"\w* muchísimos \w bueyes|strong="H7794"\w*, \w animales|strong="H1121"\w* engordados \w y|strong="H3588"\w* \w ovejas|strong="H6629"\w*; invitó \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w del|strong="H8354"\w* \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w del|strong="H8354"\w* \w ejército|strong="H6635"\w* \w y|strong="H3588"\w* \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* Abiatar. \w Ahora|strong="H3117"\w* \w mismo|strong="H3605"\w* \w están|strong="H2009"\w* comiendo \w y|strong="H3588"\w* \w bebiendo|strong="H8354"\w* \w con|strong="H3588"\w* \w él|strong="H3588"\w*, \w y|strong="H3588"\w* gritando: ‘¡\w Viva|strong="H2421"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* Adonías!’.  
\v 26 Pero \w a|strong="H3068"\w* mí, \w que|strong="H3808"\w* soy su servidor, \w no|strong="H3808"\w* me invitó, como \w tampoco|strong="H3808"\w* al \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joyadá, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* su servidor \w Salomón|strong="H8010"\w*.  
\v 27 ¿\w Ha|strong="H3808"\w* autorizado \w mi|strong="H5921"\w* señor \w el|strong="H5921"\w* \w rey|strong="H4428"\w* todo \w esto|strong="H2088"\w* \w sin|strong="H3808"\w* avisarles \w a|strong="H3068"\w* sus servidores \w quién|strong="H4310"\w* ocupará su \w trono|strong="H3678"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* usted?”.   
\p
\v 28 El \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w ordenó|strong="H5975"\w*: “Llamen \w a|strong="H3068"\w* Betsabé”. Ella entró y se presentó \w ante|strong="H6440"\w* el \w rey|strong="H4428"\w*.  
\v 29 Entonces \w el|strong="H3605"\w* \w rey|strong="H4428"\w* hizo este juramento: “Tan cierto como \w que|strong="H3605"\w* \w vive|strong="H2416"\w* Yahvé, \w quien|strong="H3605"\w* me ha librado de \w todas|strong="H3605"\w* mis \w angustias|strong="H6869"\w*,  
\v 30 \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* \w mismo|strong="H1931"\w* cumpliré \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* \w juré|strong="H7650"\w* \w por|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w cuando|strong="H3588"\w* dije: ‘\w Tu|strong="H6213"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w me|strong="H5921"\w* sucederá \w como|strong="H3588"\w* \w rey|strong="H4427"\w* \w y|strong="H3588"\w* \w se|strong="H1931"\w* sentará \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w trono|strong="H3678"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w lugar|strong="H8478"\w*’”.   
\p
\v 31 Betsabé se \w inclinó|strong="H6915"\w* hasta tocar el suelo con la frente y, en señal de respeto, exclamó: “¡Que \w viva|strong="H2421"\w* para \w siempre|strong="H5769"\w* mi señor el \w rey|strong="H4428"\w* \w David|strong="H1732"\w*!”.   
\p
\v 32 Luego \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* dijo: “Llamen \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w al|strong="H4428"\w* \w profeta|strong="H5030"\w* Natán y \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Joyadá”. Cuando ellos se presentaron \w ante|strong="H6440"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w*,  
\v 33 este \w les|strong="H5973"\w* dio \w las|strong="H5921"\w* siguientes instrucciones: “Lleven \w con|strong="H5973"\w* ustedes \w a|strong="H3068"\w* \w los|strong="H1121"\w* servidores \w de|strong="H5921"\w* su señor, monten \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* propia mula \w y|strong="H5921"\w* llévenlo \w a|strong="H3068"\w* Guijón.  
\v 34 Una vez \w allí|strong="H8033"\w*, \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* Natán \w lo|strong="H5921"\w* unjan \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. Toquen \w la|strong="H5921"\w* \w trompeta|strong="H7782"\w* \w y|strong="H5921"\w* griten: ‘¡\w Viva|strong="H2421"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*!’.  
\v 35 \w Después|strong="H5921"\w* suban \w con|strong="H5921"\w* \w él|strong="H1931"\w*; \w él|strong="H1931"\w* \w vendrá|strong="H1961"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* sentará \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w trono|strong="H3678"\w*, \w y|strong="H5921"\w* \w reinará|strong="H4427"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w lugar|strong="H8478"\w*. \w Yo|strong="H6680"\w* \w lo|strong="H1931"\w* he nombrado gobernante \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*”.   
\p
\v 36 \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joyadá le \w respondió|strong="H6030"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “¡Amén! \w Que|strong="H1121"\w* \w así|strong="H3651"\w* lo confirme Yahvé, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w mi|strong="H6030"\w* \w señor|strong="H3068"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w*.  
\v 37 \w Y|strong="H3068"\w* \w que|strong="H1961"\w* \w así|strong="H3651"\w* \w como|strong="H5973"\w* Yahvé ha \w estado|strong="H1961"\w* \w con|strong="H5973"\w* usted, \w mi|strong="H1431"\w* \w señor|strong="H3068"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w*, \w también|strong="H3651"\w* \w esté|strong="H1961"\w* \w con|strong="H5973"\w* \w Salomón|strong="H8010"\w* y haga \w que|strong="H1961"\w* su \w reinado|strong="H4428"\w* \w sea|strong="H1961"\w* aún más grandioso \w que|strong="H1961"\w* \w el|strong="H5973"\w* \w de|strong="H5973"\w* usted”.   
\p
\v 38 Entonces \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* Natán \w y|strong="H5921"\w* \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Joyadá, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* guardia especial, \w bajaron|strong="H3381"\w* \w y|strong="H5921"\w* montaron \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* mula \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* llevaron \w a|strong="H3068"\w* Guijón.  
\v 39 \w El|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w* \w tomó|strong="H3947"\w* \w el|strong="H3605"\w* \w cuerno|strong="H7161"\w* \w de|strong="H4480"\w* \w aceite|strong="H8081"\w* \w que|strong="H4480"\w* estaba \w en|strong="H4480"\w* \w el|strong="H3605"\w* santuario y \w ungió|strong="H4886"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*. Entonces \w tocaron|strong="H8628"\w* \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* gritó: “¡\w Viva|strong="H2421"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*!”.   
\p
\v 40 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w lo|strong="H3605"\w* siguió, tocando \w flautas|strong="H2485"\w* y saltando \w de|strong="H5971"\w* \w alegría|strong="H8057"\w*; hacían tanto \w ruido|strong="H6963"\w* \w que|strong="H5971"\w* \w la|strong="H3605"\w* tierra temblaba.  
\v 41 Adonías y \w todos|strong="H3605"\w* \w sus|strong="H1992"\w* invitados \w lo|strong="H1992"\w* \w oyeron|strong="H8085"\w* justo cuando terminaban de comer. Al \w oír|strong="H8085"\w* \w el|strong="H3605"\w* toque de \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*, \w Joab|strong="H3097"\w* preguntó: “¿\w A|strong="H3068"\w* \w qué|strong="H1992"\w* \w se|strong="H1992"\w* debe ese alboroto en \w la|strong="H3605"\w* \w ciudad|strong="H7151"\w*?”.   
\p
\v 42 \w Todavía|strong="H5750"\w* \w estaba|strong="H2009"\w* \w hablando|strong="H1696"\w* \w cuando|strong="H3588"\w* llegó Jonatán \w hijo|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Abiatar. Adonías le \w dijo|strong="H1696"\w*: “Pasa, \w que|strong="H3588"\w* tú eres un \w hombre|strong="H1121"\w* \w valiente|strong="H2428"\w* \w y|strong="H3588"\w* seguro traes \w buenas|strong="H2896"\w* noticias”.   
\p
\v 43 Pero Jonatán le \w respondió|strong="H6030"\w*: “¡\w Al|strong="H4428"\w* contrario! Nuestro señor el \w rey|strong="H4428"\w* \w David|strong="H1732"\w* ha nombrado \w rey|strong="H4428"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*.  
\v 44 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w envió|strong="H7971"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* Natán \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Joyadá, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* guardia especial, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* montaron \w en|strong="H5921"\w* \w la|strong="H5921"\w* mula \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 45 \w Luego|strong="H1931"\w* \w Sadoc|strong="H6659"\w* y Natán \w lo|strong="H1931"\w* \w ungieron|strong="H4886"\w* \w como|strong="H1931"\w* \w rey|strong="H4428"\w* en Guijón. De \w allí|strong="H8033"\w* \w subieron|strong="H5927"\w* todos muy \w alegres|strong="H8056"\w*, y \w la|strong="H1931"\w* \w ciudad|strong="H7151"\w* \w está|strong="H1931"\w* de fiesta. \w Ese|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w ruido|strong="H6963"\w* \w que|strong="H1931"\w* acaban de \w oír|strong="H8085"\w*.  
\v 46 \w Salomón|strong="H8010"\w* \w ya|strong="H1571"\w* \w se|strong="H5921"\w* ha \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w real|strong="H4410"\w*.  
\v 47 Incluso \w los|strong="H5921"\w* servidores \w del|strong="H5921"\w* \w rey|strong="H4428"\w* han ido \w a|strong="H3068"\w* felicitar \w a|strong="H3068"\w* nuestro señor \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w*, diciéndole: ‘¡\w Que|strong="H5921"\w* su Dios haga \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w* \w más|strong="H1571"\w* famoso \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* usted, \w y|strong="H1571"\w* su \w reinado|strong="H4428"\w* \w más|strong="H1571"\w* \w grande|strong="H1431"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* suyo!’. \w Y|strong="H3068"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* inclinó \w sobre|strong="H5921"\w* su \w cama|strong="H4904"\w* \w para|strong="H5921"\w* adorar \w a|strong="H3068"\w* Dios,  
\v 48 \w y|strong="H1571"\w* dijo: ‘\w Bendito|strong="H1288"\w* sea Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w que|strong="H5921"\w* \w hoy|strong="H3117"\w* ha permitido \w que|strong="H5921"\w* uno \w de|strong="H5921"\w* \w mis|strong="H5414"\w* hijos \w se|strong="H5921"\w* siente \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w trono|strong="H3678"\w*, \w y|strong="H1571"\w* \w que|strong="H5921"\w* yo pueda verlo \w con|strong="H5921"\w* \w mis|strong="H5414"\w* propios \w ojos|strong="H5869"\w*’”.   
\p
\v 49 Al oír esto, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* invitados de Adonías se aterraron; se \w levantaron|strong="H6965"\w* y \w cada|strong="H3605"\w* uno se \w fue|strong="H3212"\w* \w por|strong="H1870"\w* su lado.  
\v 50 Adonías, \w por|strong="H6440"\w* \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*, corrió al santuario y se agarró \w de|strong="H6440"\w* los \w cuernos|strong="H7161"\w* \w del|strong="H4196"\w* \w altar|strong="H4196"\w*.  
\v 51 Alguien le \w avisó|strong="H5046"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*: “Adonías tiene \w miedo|strong="H3372"\w* \w de|strong="H3372"\w* usted y está agarrado \w de|strong="H3372"\w* los \w cuernos|strong="H7161"\w* \w del|strong="H4196"\w* \w altar|strong="H4196"\w*. Dice: ‘\w Que|strong="H3117"\w* el \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* me \w jure|strong="H7650"\w* \w hoy|strong="H3117"\w* mismo \w que|strong="H3117"\w* no me \w matará|strong="H4191"\w*’”.   
\p
\v 52 \w Salomón|strong="H8010"\w* respondió: “\w Si|strong="H3808"\w* \w se|strong="H1961"\w* porta \w como|strong="H1961"\w* un \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* bien, \w no|strong="H3808"\w* \w se|strong="H1961"\w* le tocará \w ni|strong="H3808"\w* un solo cabello; pero \w si|strong="H3808"\w* \w se|strong="H1961"\w* descubre \w que|strong="H3808"\w* \w tiene|strong="H1961"\w* \w malas|strong="H7451"\w* intenciones, \w morirá|strong="H4191"\w*”.   
\p
\v 53 Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w mandó|strong="H7971"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* bajaran \w del|strong="H5921"\w* \w altar|strong="H4196"\w*. Adonías \w vino|strong="H3212"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinó ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*, \w y|strong="H5921"\w* este \w le|strong="H5921"\w* dijo: “\w Vete|strong="H3212"\w* \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w*”.   
\c 2  
\p
\v 1 \w Cuando|strong="H3117"\w* se acercaba \w el|strong="H1121"\w* \w día|strong="H3117"\w* \w de|strong="H1121"\w* su \w muerte|strong="H4191"\w*, \w David|strong="H1732"\w* le dio estas instrucciones \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*:  
\v 2 “Hijo mío, \w voy|strong="H1980"\w* \w por|strong="H1870"\w* \w el|strong="H3605"\w* \w camino|strong="H1870"\w* \w que|strong="H1961"\w* \w todos|strong="H3605"\w* en \w este|strong="H1961"\w* mundo deben seguir. Ten valor y pórtate \w como|strong="H1961"\w* un hombre.  
\v 3 \w Cumple|strong="H8104"\w* \w los|strong="H3605"\w* \w mandamientos|strong="H4687"\w* de Yahvé \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w*; sigue sus \w caminos|strong="H1870"\w* y obedece sus \w leyes|strong="H8451"\w*, sus mandatos, sus decretos y sus enseñanzas, tal como están \w escritos|strong="H3789"\w* \w en|strong="H3212"\w* \w la|strong="H8104"\w* \w ley|strong="H8451"\w* de \w Moisés|strong="H4872"\w*. Así te \w irá|strong="H3212"\w* bien \w en|strong="H3212"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H4616"\w* \w hagas|strong="H6213"\w* y dondequiera \w que|strong="H4616"\w* \w vayas|strong="H3212"\w*.  
\v 4 \w Si|strong="H3808"\w* \w lo|strong="H1697"\w* haces, Yahvé cumplirá \w la|strong="H5921"\w* promesa \w que|strong="H3808"\w* \w me|strong="H5921"\w* \w hizo|strong="H3772"\w* cuando \w dijo|strong="H1696"\w*: “\w Si|strong="H3808"\w* tus \w hijos|strong="H1121"\w* cuidan su conducta \w y|strong="H5921"\w* \w me|strong="H5921"\w* sirven fielmente \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su \w corazón|strong="H3824"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w*, \w nunca|strong="H3808"\w* \w faltará|strong="H3772"\w* un descendiente tuyo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 5 “\w Por|strong="H5414"\w* \w otra|strong="H6213"\w* parte, \w tú|strong="H6213"\w* \w sabes|strong="H3045"\w* muy \w bien|strong="H7965"\w* \w lo|strong="H6213"\w* \w que|strong="H1571"\w* me \w hizo|strong="H6213"\w* \w Joab|strong="H3097"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sarvia, \w y|strong="H1571"\w* \w lo|strong="H6213"\w* \w que|strong="H1571"\w* les \w hizo|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w generales|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w Amasa|strong="H6021"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeter|strong="H3500"\w*. \w Él|strong="H1121"\w* \w los|strong="H1121"\w* asesinó en tiempo \w de|strong="H1121"\w* \w paz|strong="H7965"\w* \w como|strong="H1571"\w* \w si|strong="H1571"\w* estuviera en \w guerra|strong="H4421"\w*, manchando \w con|strong="H1571"\w* esa \w sangre|strong="H1818"\w* \w el|strong="H1121"\w* cinturón \w de|strong="H1121"\w* su cintura \w y|strong="H1571"\w* \w el|strong="H1121"\w* calzado \w de|strong="H1121"\w* sus \w pies|strong="H7272"\w*.  
\v 6 Actúa, \w pues|strong="H3381"\w*, con \w sabiduría|strong="H2451"\w*, y \w no|strong="H3808"\w* dejes \w que|strong="H3808"\w* sus canas bajen al \w sepulcro|strong="H7585"\w* en \w paz|strong="H7965"\w*.  
\v 7 \w Pero|strong="H3588"\w* trata \w con|strong="H3588"\w* bondad \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* Barzilay \w el|strong="H3588"\w* \w galaadita|strong="H1569"\w*; deja \w que|strong="H3588"\w* coman siempre \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w mesa|strong="H7979"\w*, \w porque|strong="H3588"\w* ellos \w me|strong="H3588"\w* ayudaron \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* \w huía|strong="H1272"\w* \w de|strong="H3588"\w* \w tu|strong="H6213"\w* hermano Absalón.   
\p
\v 8 “También tienes \w cerca|strong="H5973"\w* \w a|strong="H3068"\w* Simei \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Guera, \w el|strong="H1931"\w* \w benjamita|strong="H1121"\w* \w de|strong="H5973"\w* Bajurim. \w Él|strong="H1931"\w* lanzó \w contra|strong="H5973"\w* \w mí|strong="H2009"\w* una \w maldición|strong="H7045"\w* terrible \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w que|strong="H1931"\w* \w yo|strong="H2009"\w* \w iba|strong="H3212"\w* \w a|strong="H3068"\w* Majanaim; pero \w cuando|strong="H3117"\w* bajó \w a|strong="H3068"\w* recibirme al \w Jordán|strong="H3383"\w*, \w le|strong="H1931"\w* \w juré|strong="H7650"\w* por Yahvé \w que|strong="H1931"\w* no \w lo|strong="H1931"\w* mataría.  
\v 9 \w Pero|strong="H3588"\w* \w tú|strong="H6213"\w* \w no|strong="H6213"\w* \w lo|strong="H6213"\w* dejes sin \w castigo|strong="H5352"\w*. Eres un hombre \w sabio|strong="H2450"\w* \w y|strong="H3588"\w* \w sabrás|strong="H3045"\w* \w qué|strong="H3588"\w* \w hacer|strong="H6213"\w* \w con|strong="H3588"\w* \w él|strong="H3588"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* sus canas bajen \w al|strong="H5352"\w* \w sepulcro|strong="H7585"\w* manchadas \w de|strong="H3588"\w* \w sangre|strong="H1818"\w*”.   
\p
\v 10 \w David|strong="H1732"\w* murió y fue \w sepultado|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H5973"\w* \w David|strong="H1732"\w*.  
\v 11 \w Reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* durante cuarenta \w años|strong="H8141"\w*: \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w* \w y|strong="H5921"\w* \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w en|strong="H5921"\w* Jerusalén.  
\v 12 \w Salomón|strong="H8010"\w* ocupó \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* su padre \w David|strong="H1732"\w*, \w y|strong="H5921"\w* su \w reino|strong="H4428"\w* \w se|strong="H5921"\w* consolidó totalmente.   
\p
\v 13 Un \w día|strong="H1121"\w*, Adonías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Haguit fue \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Betsabé, la madre \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*. Ella le preguntó: “¿Vienes en son \w de|strong="H1121"\w* \w paz|strong="H7965"\w*?”.  
\p \w Él|strong="H1121"\w* respondió: “Sí, en son \w de|strong="H1121"\w* \w paz|strong="H7965"\w*”.  
\v 14 \w Y|strong="H3068"\w* añadió: “\w Tengo|strong="H1696"\w* \w algo|strong="H1697"\w* \w que|strong="H1697"\w* decirte”.  
\p Ella le contestó: “Dime”.   
\p
\v 15 \w Él|strong="H5921"\w* \w le|strong="H5921"\w* dijo: “Usted \w sabe|strong="H3045"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w reino|strong="H4427"\w* \w me|strong="H5921"\w* pertenecía \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* esperaba \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w fuera|strong="H1961"\w* \w el|strong="H5921"\w* \w rey|strong="H4427"\w*. \w Pero|strong="H3588"\w* \w las|strong="H5921"\w* \w cosas|strong="H3045"\w* cambiaron \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w reino|strong="H4427"\w* pasó \w a|strong="H3068"\w* manos \w de|strong="H5921"\w* \w mi|strong="H5921"\w* hermano, \w porque|strong="H3588"\w* Yahvé \w así|strong="H3588"\w* \w lo|strong="H5921"\w* quiso.  
\v 16 \w Ahora|strong="H6258"\w* quiero pedirle un favor; \w por|strong="H6440"\w* favor, \w no|strong="H6440"\w* me \w diga|strong="H1696"\w* \w que|strong="H6258"\w* \w no|strong="H6440"\w*”.  
\p Ella le \w dijo|strong="H1696"\w*: “Dime \w qué|strong="H6258"\w* es”.   
\p
\v 17 \w Él|strong="H3588"\w* le pidió: “\w Por|strong="H3588"\w* favor, hable \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* (\w pues|strong="H3588"\w* \w a|strong="H3068"\w* usted \w no|strong="H3808"\w* le dirá \w que|strong="H3588"\w* \w no|strong="H3808"\w*) \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* \w dé|strong="H3588"\w* \w por|strong="H3588"\w* esposa \w a|strong="H3068"\w* Abisag, \w la|strong="H3588"\w* \w sunamita|strong="H7767"\w*”.   
\p
\v 18 Betsabé respondió: “\w Está|strong="H5921"\w* \w bien|strong="H2896"\w*, \w hablaré|strong="H1696"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w por|strong="H5921"\w* \w ti|strong="H5921"\w*”.   
\p
\v 19 \w Así|strong="H1696"\w* \w que|strong="H5921"\w* Betsabé fue \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w para|strong="H5921"\w* interceder \w por|strong="H5921"\w* Adonías. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w levantó|strong="H6965"\w* \w a|strong="H3068"\w* recibirla, \w se|strong="H5921"\w* inclinó ante \w ella|strong="H5921"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* sentó \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*. Luego \w mandó|strong="H1696"\w* traer otro \w trono|strong="H3678"\w* \w para|strong="H5921"\w* su madre, \w y|strong="H5921"\w* \w ella|strong="H5921"\w* \w se|strong="H5921"\w* sentó \w a|strong="H3068"\w* su \w derecha|strong="H3225"\w*.  
\v 20 Ella le dijo: “Quiero pedirte un \w pequeño|strong="H6996"\w* favor; \w no|strong="H3808"\w* \w me|strong="H3588"\w* \w lo|strong="H3808"\w* niegues”.  
\p \w El|strong="H3588"\w* \w rey|strong="H4428"\w* le \w respondió|strong="H7725"\w*: “\w Pídeme|strong="H7592"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* quieras, madre mía, \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w lo|strong="H3808"\w* voy \w a|strong="H3068"\w* negar”.   
\p
