\v 23 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Asa, \w sus|strong="H1992"\w* hazañas, \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* \w y|strong="H5921"\w* \w las|strong="H1992"\w* \w ciudades|strong="H5892"\w* \w que|strong="H3808"\w* fortificó están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w En|strong="H5921"\w* \w su|strong="H1992"\w* vejez, Asa sufrió \w de|strong="H5921"\w* una enfermedad \w en|strong="H5921"\w* \w los|strong="H1992"\w* \w pies|strong="H7272"\w*.  
\v 24 Cuando Asa murió, lo \w sepultaron|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*. Su \w hijo|strong="H1121"\w* Josafat \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 25 \w Nadab|strong="H5070"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w* comenzó \w a|strong="H3068"\w* reinar \w en|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* Asa, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* gobernó \w dos|strong="H8147"\w* \w años|strong="H8141"\w*.  
\v 26 Pero \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que \w a|strong="H3068"\w* Yahvé \w no|strong="H6213"\w* \w le|strong="H5869"\w* agrada, pues \w siguió|strong="H3212"\w* \w el|strong="H6213"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* su padre y persistió \w en|strong="H3212"\w* los mismos \w pecados|strong="H2403"\w* con que Jeroboam \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 27 Entonces \w Baasa|strong="H1201"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahías, \w de|strong="H5921"\w* \w la|strong="H5921"\w* tribu \w de|strong="H5921"\w* Isacar, \w conspiró|strong="H7194"\w* \w contra|strong="H5921"\w* \w Nadab|strong="H5070"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w mató|strong="H5221"\w* \w en|strong="H5921"\w* Guibetón, una ciudad \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*, \w mientras|strong="H3605"\w* \w Nadab|strong="H5070"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w la|strong="H5921"\w* tenían sitiada.  
\v 28 \w Baasa|strong="H1201"\w* \w mató|strong="H4191"\w* \w a|strong="H3068"\w* Nadab \w en|strong="H8478"\w* el tercer \w año|strong="H8141"\w* del \w reinado|strong="H4427"\w* \w de|strong="H8478"\w* Asa \w en|strong="H8478"\w* \w Judá|strong="H3063"\w*, y se convirtió \w en|strong="H8478"\w* el nuevo \w rey|strong="H4428"\w* \w de|strong="H8478"\w* Israel.  
\v 29 \w En|strong="H5704"\w* cuanto comenzó \w a|strong="H3068"\w* reinar, Baasa \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* descendientes \w de|strong="H5704"\w* \w Jeroboam|strong="H3379"\w*. \w No|strong="H3808"\w* \w dejó|strong="H7604"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w con|strong="H5704"\w* vida, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w los|strong="H3605"\w* exterminó \w a|strong="H3068"\w* \w todos|strong="H3605"\w*, \w tal|strong="H1697"\w* \w como|strong="H1961"\w* Yahvé \w lo|strong="H1697"\w* \w había|strong="H1961"\w* anunciado \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H5704"\w* su servidor \w Ahías|strong="H3379"\w* \w de|strong="H5704"\w* Siló.  
\v 30 Esto sucedió \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w que|strong="H5921"\w* \w Jeroboam|strong="H3379"\w* \w cometió|strong="H2398"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* hizo \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, provocando así \w la|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 31 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Nadab|strong="H5070"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 32 \w Hubo|strong="H1961"\w* \w guerra|strong="H4421"\w* continua entre Asa y \w Baasa|strong="H1201"\w*, \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*.   
\p
\v 33 \w Baasa|strong="H1201"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahías comenzó \w a|strong="H3068"\w* reinar \w en|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* tercer \w año|strong="H8141"\w* \w de|strong="H5921"\w* Asa, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. Gobernó \w en|strong="H5921"\w* Tirsa durante \w veinticuatro|strong="H6242"\w* \w años|strong="H8141"\w*.  
\v 34 Pero \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que \w a|strong="H3068"\w* Yahvé \w no|strong="H6213"\w* \w le|strong="H5869"\w* agrada, pues \w siguió|strong="H3212"\w* \w el|strong="H6213"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* \w Jeroboam|strong="H3379"\w* y persistió \w en|strong="H3212"\w* los mismos \w pecados|strong="H2403"\w* con que este \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.   
\c 16  
\p
\v 1 Entonces Yahvé \w le|strong="H5921"\w* envió \w este|strong="H1961"\w* mensaje \w al|strong="H5921"\w* profeta \w Jehú|strong="H3058"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hananí|strong="H2607"\w* \w contra|strong="H5921"\w* \w Baasa|strong="H1201"\w*:  
\v 2 “\w Yo|strong="H4480"\w* \w te|strong="H5921"\w* saqué \w del|strong="H4480"\w* \w polvo|strong="H6083"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w puse|strong="H5414"\w* \w como|strong="H5921"\w* gobernante \w de|strong="H4480"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, pero tú \w has|strong="H5414"\w* seguido \w el|strong="H5921"\w* mal ejemplo \w de|strong="H4480"\w* \w Jeroboam|strong="H3379"\w* \w y|strong="H5921"\w* \w has|strong="H5414"\w* hecho \w que|strong="H4480"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w peque|strong="H2398"\w*, provocando \w mi|strong="H5921"\w* enojo \w con|strong="H5921"\w* sus \w pecados|strong="H2403"\w*.  
\v 3 \w Por|strong="H5414"\w* eso, voy \w a|strong="H3068"\w* barrer \w por|strong="H5414"\w* completo con \w Baasa|strong="H1201"\w* \w y|strong="H1197"\w* con su \w familia|strong="H1004"\w*; voy \w a|strong="H3068"\w* hacer con tu \w casa|strong="H1004"\w* lo mismo \w que|strong="H1121"\w* hice con \w la|strong="H1197"\w* \w de|strong="H1121"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w*.  
\v 4 \w A|strong="H3068"\w* los de la familia de \w Baasa|strong="H1201"\w* que \w mueran|strong="H4191"\w* en la \w ciudad|strong="H5892"\w*, se los comerán los \w perros|strong="H3611"\w*, y \w a|strong="H3068"\w* los que \w mueran|strong="H4191"\w* en el \w campo|strong="H7704"\w*, se los comerán las \w aves|strong="H5775"\w* de rapiña”.   
\p
\v 5 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Baasa|strong="H1201"\w*, \w sus|strong="H1992"\w* hazañas \w y|strong="H5921"\w* \w su|strong="H1992"\w* poder, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 6 Cuando \w Baasa|strong="H1201"\w* murió, lo \w sepultaron|strong="H6912"\w* \w en|strong="H5973"\w* Tirsa, y su \w hijo|strong="H1121"\w* Elá \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
