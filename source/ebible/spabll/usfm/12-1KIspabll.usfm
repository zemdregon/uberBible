\v 30 \w Benaía|strong="H1141"\w* \w fue|strong="H3808"\w* \w al|strong="H4428"\w* santuario \w y|strong="H3588"\w* le \w dijo|strong="H1696"\w*: “\w El|strong="H3588"\w* \w rey|strong="H4428"\w* ordena \w que|strong="H3588"\w* \w salgas|strong="H3318"\w* \w de|strong="H3588"\w* ahí”.  
\p \w Pero|strong="H3588"\w* \w Joab|strong="H3097"\w* \w respondió|strong="H6030"\w*: “\w No|strong="H3808"\w*, \w aquí|strong="H6311"\w* mismo voy \w a|strong="H3068"\w* \w morir|strong="H4191"\w*”.  
\p \w Benaía|strong="H1141"\w* \w fue|strong="H3808"\w* \w y|strong="H3588"\w* le informó \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w Joab|strong="H3097"\w* \w había|strong="H3588"\w* \w dicho|strong="H1697"\w*.   
