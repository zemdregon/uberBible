\v 14 \w Entonces|strong="G5119"\w* \w uno|strong="G1520"\w* \w de|strong="G4314"\w* \w los|strong="G3588"\w* \w doce|strong="G1427"\w*, \w llamado|strong="G3004"\w* \w Judas|strong="G2455"\w* \w Iscariote|strong="G2469"\w*, \w fue|strong="G4198"\w* \w a|strong="G4314"\w* ver \w a|strong="G4314"\w* \w los|strong="G3588"\w* jefes \w de|strong="G4314"\w* \w los|strong="G3588"\w* sacerdotes  
