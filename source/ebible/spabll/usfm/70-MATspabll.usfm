\v 39 \wj \+w Y|strong="G1063"\+w* les advierto \+w que|strong="G3588"\+w* ya \+w no|strong="G3756"\+w* volverán \+w a|strong="G1722"\+w* verme, \+w hasta|strong="G2193"\+w* \+w que|strong="G3588"\+w* digan: “¡\+w Bendito|strong="G2127"\+w* \+w el|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w viene|strong="G2064"\+w* \+w en|strong="G1722"\+w* \+w el|strong="G3588"\+w* \+w nombre|strong="G3686"\+w* \+w del|strong="G3588"\+w* \+w Señor|strong="G2962"\+w*!”.\wj*\f + \fr 23:39 \ft Salmo 118:26 \f*   
\c 24  
\p
\v 1 \w Jesús|strong="G2424"\w* \w salió|strong="G1831"\w* \w del|strong="G3588"\w* \w templo|strong="G2411"\w* \w y|strong="G2532"\w* \w ya|strong="G2532"\w* \w se|strong="G2532"\w* \w iba|strong="G4198"\w*, cuando \w sus|strong="G3588"\w* \w discípulos|strong="G3101"\w* \w se|strong="G2532"\w* acercaron para mostrarle \w lo|strong="G3588"\w* hermosos \w que|strong="G3588"\w* eran \w los|strong="G3588"\w* \w edificios|strong="G3619"\w* \w del|strong="G3588"\w* \w templo|strong="G2411"\w*.  
\v 2 \w Pero|strong="G1161"\w* \w él|strong="G3588"\w* \w les|strong="G1909"\w* \w dijo|strong="G3004"\w*: \wj “¿Ven \+w todo|strong="G3956"\+w* \+w esto|strong="G3778"\+w*? \+w Les|strong="G1909"\+w* aseguro \+w que|strong="G3588"\+w* \+w aquí|strong="G5602"\+w* \+w no|strong="G3756"\+w* quedará \+w ni|strong="G3756"\+w* \+w una|strong="G3588"\+w* \+w piedra|strong="G3037"\+w* \+w sobre|strong="G1909"\+w* otra; \+w todo|strong="G3956"\+w* será destruido”.\wj*   
\p
\v 3 \w Más|strong="G1161"\w* tarde, \w mientras|strong="G1909"\w* Jesús estaba \w sentado|strong="G2521"\w* \w en|strong="G1909"\w* \w el|strong="G3588"\w* \w Monte|strong="G3735"\w* \w de|strong="G1909"\w* \w los|strong="G3588"\w* Olivos, \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* \w se|strong="G2532"\w* \w le|strong="G2596"\w* acercaron \w en|strong="G1909"\w* privado \w y|strong="G2532"\w* \w le|strong="G2596"\w* preguntaron: “Dinos, ¿\w cuándo|strong="G4219"\w* van \w a|strong="G1909"\w* pasar \w estas|strong="G3778"\w* cosas? ¿\w Cuál|strong="G5101"\w* será \w la|strong="G3588"\w* \w señal|strong="G4592"\w* \w de|strong="G1909"\w* \w tu|strong="G3588"\w* regreso \w y|strong="G2532"\w* \w del|strong="G3588"\w* \w fin|strong="G4930"\w* \w del|strong="G3588"\w* mundo?”.   
\p
