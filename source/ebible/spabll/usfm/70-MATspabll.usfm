\v 5 \wj \+w Todo|strong="G3956"\+w* \+w lo|strong="G3588"\+w* \+w hacen|strong="G4160"\+w* \+w para|strong="G4314"\+w* \+w que|strong="G3588"\+w* \+w la|strong="G3588"\+w* gente \+w los|strong="G3588"\+w* vea. Usan unas cajitas \+w de|strong="G4314"\+w* cuero \+w con|strong="G4314"\+w* porciones \+w de|strong="G4314"\+w* \+w las|strong="G3588"\+w* Escrituras\wj*\f + \fr 23:5 \ft NU omite el segundo “Rabí”. \f* \wj \+w bien|strong="G1161"\+w* anchas \+w en|strong="G4314"\+w* \+w la|strong="G3588"\+w* frente \+w y|strong="G2532"\+w* \+w en|strong="G4314"\+w* \+w los|strong="G3588"\+w* brazos, \+w y|strong="G2532"\+w* \+w le|strong="G4314"\+w* ponen \+w flecos|strong="G2899"\+w* muy largos \+w a|strong="G4314"\+w* \+w sus|strong="G3588"\+w* mantos.\wj*  
\v 6 \wj Les encanta ocupar \+w los|strong="G3588"\+w* lugares \+w de|strong="G1722"\+w* honor \+w en|strong="G1722"\+w* \+w los|strong="G3588"\+w* banquetes \+w y|strong="G2532"\+w* \+w los|strong="G3588"\+w* primeros asientos \+w en|strong="G1722"\+w* \+w las|strong="G3588"\+w* \+w sinagogas|strong="G4864"\+w*;\wj*  
