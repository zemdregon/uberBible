\v 10 \wj \+w Los|strong="G3588"\+w* sirvientes \+w salieron|strong="G1831"\+w* \+w a|strong="G1519"\+w* \+w las|strong="G3588"\+w* calles \+w y|strong="G2532"\+w* reunieron \+w a|strong="G1519"\+w* \+w todos|strong="G3956"\+w* \+w los|strong="G3588"\+w* \+w que|strong="G3588"\+w* encontraron, \+w tanto|strong="G3745"\+w* buenos \+w como|strong="G2532"\+w* \+w malos|strong="G4190"\+w*. \+w Y|strong="G2532"\+w* \+w el|strong="G3588"\+w* salón \+w de|strong="G1519"\+w* \+w bodas|strong="G1062"\+w* \+w se|strong="G2532"\+w* \+w llenó|strong="G4130"\+w* \+w de|strong="G1519"\+w* invitados.\wj*   
\p
\v 11 \wj “Cuando \+w el|strong="G3588"\+w* rey \+w entró|strong="G1525"\+w* \+w a|strong="G1161"\+w* ver \+w a|strong="G1161"\+w* \+w los|strong="G3588"\+w* invitados, notó \+w que|strong="G3588"\+w* había \+w allí|strong="G1563"\+w* \+w un|strong="G3588"\+w* hombre \+w que|strong="G3588"\+w* \+w no|strong="G3756"\+w* estaba \+w vestido|strong="G1742"\+w* \+w con|strong="G1161"\+w* ropa \+w de|strong="G3588"\+w* boda.\wj*  
\v 12 \wj Le preguntó: ‘\+w Amigo|strong="G2083"\+w*, ¿\+w cómo|strong="G4459"\+w* \+w entraste|strong="G1525"\+w* \+w aquí|strong="G5602"\+w* \+w sin|strong="G3361"\+w* ropa \+w de|strong="G3588"\+w* boda?’. \+w Y|strong="G2532"\+w* \+w el|strong="G3588"\+w* hombre \+w se|strong="G2532"\+w* quedó callado.\wj*  
\v 13 \wj \+w Entonces|strong="G5119"\+w* \+w el|strong="G3588"\+w* rey \+w les|strong="G1519"\+w* ordenó \+w a|strong="G1519"\+w* \+w sus|strong="G3588"\+w* \+w sirvientes|strong="G1249"\+w*: ‘Átenlo \+w de|strong="G1519"\+w* \+w pies|strong="G4228"\+w* \+w y|strong="G2532"\+w* \+w manos|strong="G5495"\+w*, \+w y|strong="G2532"\+w* échenlo \+w a|strong="G1519"\+w* \+w la|strong="G3588"\+w* oscuridad \+w de|strong="G1519"\+w* afuera. \+w Allí|strong="G1563"\+w* habrá \+w llanto|strong="G2805"\+w* \+w y|strong="G2532"\+w* rechinar \+w de|strong="G1519"\+w* \+w dientes|strong="G3599"\+w*’.\wj*  
\v 14 \wj \+w Porque|strong="G1063"\+w* \+w muchos|strong="G4183"\+w* \+w son|strong="G1510"\+w* los invitados, \+w pero|strong="G1161"\+w* \+w pocos|strong="G3641"\+w* los \+w escogidos|strong="G1588"\+w*”.\wj*   
\p
\v 15 \w Entonces|strong="G5119"\w* \w los|strong="G3588"\w* \w fariseos|strong="G5330"\w* se \w fueron|strong="G4198"\w* \w y|strong="G5119"\w* se pusieron \w de|strong="G1722"\w* acuerdo \w para|strong="G3704"\w* hacerle \w a|strong="G1722"\w* Jesús \w una|strong="G3588"\w* pregunta tramposa.  
\v 16 \w Le|strong="G1722"\w* mandaron \w a|strong="G1519"\w* \w algunos|strong="G3588"\w* \w de|strong="G4012"\w* \w sus|strong="G3588"\w* seguidores junto \w con|strong="G3326"\w* \w algunos|strong="G3588"\w* \w del|strong="G3588"\w* partido \w de|strong="G4012"\w* Herodes, \w a|strong="G1519"\w* \w decirle|strong="G3004"\w*: “\w Maestro|strong="G1320"\w*, \w sabemos|strong="G1492"\w* \w que|strong="G3754"\w* \w eres|strong="G1510"\w* \w un|strong="G3588"\w* hombre sincero, \w y|strong="G2532"\w* \w que|strong="G3754"\w* \w enseñas|strong="G1321"\w* \w el|strong="G3588"\w* \w camino|strong="G3598"\w* \w de|strong="G4012"\w* \w Dios|strong="G2316"\w* \w con|strong="G3326"\w* \w la|strong="G3588"\w* verdad. \w Sabemos|strong="G1492"\w* \w que|strong="G3754"\w* \w no|strong="G3756"\w* \w te|strong="G4771"\w* dejas llevar \w por|strong="G1722"\w* \w lo|strong="G3588"\w* \w que|strong="G3754"\w* diga \w la|strong="G3588"\w* gente, \w porque|strong="G1063"\w* \w no|strong="G3756"\w* \w te|strong="G4771"\w* fijas \w en|strong="G1722"\w* \w las|strong="G3588"\w* apariencias.  
\v 17 Dinos, \w pues|strong="G3767"\w*, \w qué|strong="G5101"\w* opinas: ¿Está permitido pagarle impuestos al \w César|strong="G2541"\w* \w o|strong="G2228"\w* \w no|strong="G3756"\w*?”.   
\p
\v 18 \w Pero|strong="G1161"\w* \w Jesús|strong="G2424"\w*, \w que|strong="G3588"\w* \w conocía|strong="G1097"\w* \w la|strong="G3588"\w* mala intención \w que|strong="G3588"\w* traían, les contestó: \wj “¡\+w Hipócritas|strong="G5273"\+w*! ¿\+w Por|strong="G3588"\+w* \+w qué|strong="G3588"\+w* \+w me|strong="G1473"\+w* ponen trampas?\wj*  
