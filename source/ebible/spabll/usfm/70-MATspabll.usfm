\v 14 \wj Déjenlos; \+w son|strong="G1510"\+w* \+w ciegos|strong="G5185"\+w* \+w que|strong="G1437"\+w* guían \+w a|strong="G1519"\+w* otros \+w ciegos|strong="G5185"\+w*. \+w Y|strong="G1161"\+w* \+w si|strong="G1437"\+w* un \+w ciego|strong="G5185"\+w* \+w guía|strong="G3595"\+w* \+w a|strong="G1519"\+w* otro, los dos \+w caerán|strong="G4098"\+w* \+w en|strong="G1519"\+w* un pozo”.\wj*   
