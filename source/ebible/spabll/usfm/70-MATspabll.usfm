\v 8 \wj ‘\+w Este|strong="G3778"\+w* \+w pueblo|strong="G2992"\+w* \+w me|strong="G1473"\+w* \+w honra|strong="G5091"\+w* \+w con|strong="G1161"\+w* \+w los|strong="G3588"\+w* \+w labios|strong="G5491"\+w*,\wj*  
\q2 \wj \+w pero|strong="G1161"\+w* \+w su|strong="G3588"\+w* \+w corazón|strong="G2588"\+w* \+w está|strong="G3778"\+w* \+w lejos|strong="G4206"\+w* \+w de|strong="G3588"\+w* \+w mí|strong="G3588"\+w*.\wj*   
\q1
\v 9 \wj \+w De|strong="G1161"\+w* nada sirve \+w que|strong="G1161"\+w* \+w me|strong="G1473"\+w* adoren,\wj*  
\q2 \wj \+w porque|strong="G1161"\+w* \+w enseñan|strong="G1321"\+w* \+w doctrinas|strong="G1319"\+w* \+w que|strong="G1161"\+w* son mandatos \+w de|strong="G1161"\+w* hombres’”.\wj*   
