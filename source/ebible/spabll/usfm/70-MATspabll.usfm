\v 26 \w Jesús|strong="G2424"\w* \w los|strong="G3588"\w* \w miró|strong="G1689"\w* \w y|strong="G1161"\w* \w les|strong="G3844"\w* \w dijo|strong="G3004"\w*: \wj “\+w Para|strong="G3844"\+w* \+w los|strong="G3588"\+w* hombres \+w esto|strong="G3778"\+w* \+w es|strong="G3778"\+w* imposible, \+w pero|strong="G1161"\+w* \+w para|strong="G3844"\+w* \+w Dios|strong="G2316"\+w* \+w todo|strong="G3956"\+w* \+w es|strong="G3778"\+w* \+w posible|strong="G1415"\+w*”.\wj*   
