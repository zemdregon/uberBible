\v 22 Cuando \w el|strong="G3588"\w* joven oyó \w esto|strong="G3588"\w*, se fue \w muy|strong="G4183"\w* \w triste|strong="G3076"\w*, \w porque|strong="G1063"\w* \w era|strong="G2192"\w* \w muy|strong="G4183"\w* rico.   
\p
\v 23 \w Jesús|strong="G2424"\w* \w les|strong="G1519"\w* \w dijo|strong="G3004"\w* \w a|strong="G1519"\w* \w sus|strong="G3588"\w* \w discípulos|strong="G3101"\w*: \wj “\+w Les|strong="G1519"\+w* aseguro \+w que|strong="G3754"\+w* es muy difícil \+w que|strong="G3754"\+w* \+w un|strong="G3588"\+w* \+w rico|strong="G4145"\+w* \+w entre|strong="G1519"\+w* \+w en|strong="G1519"\+w* \+w el|strong="G3588"\+w* Reino \+w de|strong="G1519"\+w* \+w los|strong="G3588"\+w* \+w Cielos|strong="G3772"\+w*.\wj*  
