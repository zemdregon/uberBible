\q1
\v 10 \w y|strong="G2532"\w* \w las|strong="G3588"\w* usaron \w para|strong="G1519"\w* comprar \w el|strong="G3588"\w* campo \w del|strong="G3588"\w* \w alfarero|strong="G2763"\w*,  
\q2 tal \w como|strong="G2532"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w me|strong="G1473"\w* \w lo|strong="G3588"\w* había ordenado”.\f + \fr 27:10 \ft Zacarías 11:12-13; Jeremías 19:1-13; 32:6-9\f*   
\p
\v 11 \w Jesús|strong="G2424"\w* fue llevado \w ante|strong="G1715"\w* \w el|strong="G3588"\w* \w gobernador|strong="G2232"\w*, \w y|strong="G2532"\w* \w este|strong="G3588"\w* le \w preguntó|strong="G1905"\w*: “¿\w Eres|strong="G1510"\w* \w tú|strong="G4771"\w* \w el|strong="G3588"\w* Rey \w de|strong="G3588"\w* \w los|strong="G3588"\w* \w judíos|strong="G2453"\w*?”.  
\p \w Jesús|strong="G2424"\w* le respondió: \wj “\+w Tú|strong="G4771"\+w* mismo \+w lo|strong="G3588"\+w* \+w dices|strong="G3004"\+w*”.\wj*   
\p
\v 12 \w Pero|strong="G2532"\w* \w cuando|strong="G1722"\w* \w los|strong="G3588"\w* jefes \w de|strong="G1722"\w* \w los|strong="G3588"\w* sacerdotes \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w ancianos|strong="G4245"\w* comenzaron \w a|strong="G1722"\w* acusarlo, Jesús \w no|strong="G3762"\w* respondió \w nada|strong="G3762"\w*.  
\v 13 \w Entonces|strong="G5119"\w* \w Pilato|strong="G4091"\w* le preguntó: “¿\w No|strong="G3756"\w* oyes \w de|strong="G3588"\w* \w cuántas|strong="G4214"\w* cosas \w te|strong="G4771"\w* están acusando?”.   
