\v 11 \wj \+w Lo|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w contamina|strong="G2840"\+w* \+w a|strong="G1519"\+w* \+w una|strong="G3588"\+w* persona \+w no|strong="G3756"\+w* \+w es|strong="G3756"\+w* \+w lo|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w entra|strong="G1525"\+w* \+w por|strong="G1537"\+w* \+w la|strong="G3588"\+w* \+w boca|strong="G4750"\+w*, sino \+w lo|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w sale|strong="G1607"\+w* \+w de|strong="G1537"\+w* \+w ella|strong="G3588"\+w*”.\wj*   
