\p
\v 37 \wj “¡Jerusalén, Jerusalén, \+w que|strong="G3588"\+w* matas \+w a|strong="G4314"\+w* \+w los|strong="G3588"\+w* \+w profetas|strong="G4396"\+w* \+w y|strong="G2532"\+w* \+w apedreas|strong="G3036"\+w* \+w a|strong="G4314"\+w* \+w los|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w Dios|strong="G5259"\+w* \+w te|strong="G4771"\+w* envía! ¡\+w Cuántas|strong="G4212"\+w* veces \+w quise|strong="G2309"\+w* \+w juntar|strong="G1996"\+w* \+w a|strong="G4314"\+w* \+w tus|strong="G3588"\+w* \+w hijos|strong="G5043"\+w*, \+w como|strong="G2532"\+w* \+w la|strong="G3588"\+w* gallina \+w junta|strong="G1996"\+w* \+w a|strong="G4314"\+w* \+w sus|strong="G3588"\+w* pollitos \+w debajo|strong="G5259"\+w* \+w de|strong="G5259"\+w* \+w sus|strong="G3588"\+w* \+w alas|strong="G4420"\+w*, \+w pero|strong="G2532"\+w* ustedes \+w no|strong="G3756"\+w* \+w quisieron|strong="G2309"\+w*!\wj*  
