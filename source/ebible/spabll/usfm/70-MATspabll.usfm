\v 28 \wj Les aseguro \+w que|strong="G3754"\+w* \+w algunos|strong="G5100"\+w* \+w de|strong="G1722"\+w* \+w los|strong="G3588"\+w* \+w que|strong="G3754"\+w* \+w están|strong="G2476"\+w* \+w aquí|strong="G5602"\+w* presentes \+w no|strong="G3756"\+w* morirán antes \+w de|strong="G1722"\+w* ver \+w al|strong="G3588"\+w* \+w Hijo|strong="G5207"\+w* \+w del|strong="G3588"\+w* Hombre \+w venir|strong="G2064"\+w* \+w en|strong="G1722"\+w* \+w su|strong="G3588"\+w* Reino”.\wj*   
\c 17  
\p
\v 1 \w Al|strong="G3588"\w* cabo \w de|strong="G1519"\w* \w seis|strong="G1803"\w* \w días|strong="G2250"\w*, \w Jesús|strong="G2424"\w* \w tomó|strong="G3880"\w* \w consigo|strong="G3326"\w* \w a|strong="G1519"\w* \w Pedro|strong="G4074"\w*, \w a|strong="G1519"\w* Santiago \w y|strong="G2532"\w* \w a|strong="G1519"\w* \w Juan|strong="G2491"\w*, \w su|strong="G3588"\w* hermano, \w y|strong="G2532"\w* \w los|strong="G3588"\w* llevó solos \w a|strong="G1519"\w* \w un|strong="G3588"\w* \w monte|strong="G3735"\w* \w alto|strong="G5308"\w*.  
\v 2 \w Se|strong="G1096"\w* transformó \f + \fr 17:2 \ft NU omite el versículo 21.\f*\w ante|strong="G1715"\w* \w ellos|strong="G3588"\w*. \w Su|strong="G3588"\w* \w rostro|strong="G4383"\w* brillaba \w como|strong="G5613"\w* \w el|strong="G3588"\w* \w sol|strong="G2246"\w*, \w y|strong="G2532"\w* \w sus|strong="G3588"\w* \w ropas|strong="G2440"\w* \w se|strong="G1096"\w* volvieron \w blancas|strong="G3022"\w* \w como|strong="G5613"\w* \w la|strong="G3588"\w* \w luz|strong="G5457"\w*.  
\v 3 \w Y|strong="G2532"\w* \w se|strong="G2532"\w* les aparecieron \w Moisés|strong="G3475"\w* \w y|strong="G2532"\w* \w Elías|strong="G2243"\w* \w hablando|strong="G4814"\w* \w con|strong="G3326"\w* él.   
\p
\v 4 \w Pedro|strong="G4074"\w* tomó \w la|strong="G3588"\w* palabra \w y|strong="G2532"\w* le \w dijo|strong="G3004"\w* \w a|strong="G1161"\w* \w Jesús|strong="G2424"\w*: “\w Señor|strong="G2962"\w*, ¡\w qué|strong="G3588"\w* \w bueno|strong="G2570"\w* \w que|strong="G3588"\w* estemos \w aquí|strong="G5602"\w*! \w Si|strong="G1487"\w* \w quieres|strong="G2309"\w*, \w hagamos|strong="G4160"\w* \w aquí|strong="G5602"\w* \w tres|strong="G5140"\w* enramadas: \w una|strong="G1520"\w* para ti, otra para \w Moisés|strong="G3475"\w* \w y|strong="G2532"\w* otra para \w Elías|strong="G2243"\w*”.   
\p
\v 5 Mientras \w aún|strong="G2532"\w* \w hablaba|strong="G2980"\w*, \w de|strong="G1537"\w* pronto \w una|strong="G3588"\w* \w nube|strong="G3507"\w* brillante \w los|strong="G3588"\w* \w cubrió|strong="G1982"\w* \w con|strong="G1722"\w* \w su|strong="G3588"\w* sombra. \w Y|strong="G2532"\w* \w de|strong="G1537"\w* \w la|strong="G3588"\w* \w nube|strong="G3507"\w* salió \w una|strong="G3588"\w* \w voz|strong="G5456"\w* \w que|strong="G3588"\w* \w decía|strong="G3004"\w*: “\w Este|strong="G3778"\w* \w es|strong="G3739"\w* \w mi|strong="G3588"\w* \w Hijo|strong="G5207"\w* amado, \w en|strong="G1722"\w* \w quien|strong="G3739"\w* \w me|strong="G1473"\w* complazco. Escúchenlo”.   
\p
\v 6 \w Cuando|strong="G1909"\w* \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* oyeron \w esto|strong="G3588"\w*, \w cayeron|strong="G4098"\w* \w rostro|strong="G4383"\w* \w en|strong="G1909"\w* tierra \w y|strong="G2532"\w* \w tuvieron|strong="G5399"\w* \w mucho|strong="G1909"\w* \w miedo|strong="G5399"\w*.  
\v 7 \w Pero|strong="G2532"\w* \w Jesús|strong="G2424"\w* \w se|strong="G2532"\w* acercó, \w los|strong="G3588"\w* tocó \w y|strong="G2532"\w* les \w dijo|strong="G3004"\w*: \wj “Levántense \+w y|strong="G2532"\+w* \+w no|strong="G3361"\+w* tengan \+w miedo|strong="G5399"\+w*”.\wj*  
\v 8 \w Y|strong="G1161"\w* \w al|strong="G3588"\w* levantar \w la|strong="G3588"\w* vista, \w no|strong="G3361"\w* vieron \w a|strong="G1161"\w* \w nadie|strong="G3762"\w* \w más|strong="G1161"\w* \w que|strong="G3588"\w* \w a|strong="G1161"\w* \w Jesús|strong="G2424"\w*.   
