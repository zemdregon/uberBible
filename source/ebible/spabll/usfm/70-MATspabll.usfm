\v 20 \wj \+w Por|strong="G1722"\+w* \+w lo|strong="G3588"\+w* tanto, \+w el|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w jura|strong="G3660"\+w* \+w por|strong="G1722"\+w* \+w el|strong="G3588"\+w* \+w altar|strong="G2379"\+w*, \+w jura|strong="G3660"\+w* \+w por|strong="G1722"\+w* \+w el|strong="G3588"\+w* \+w altar|strong="G2379"\+w* \+w y|strong="G2532"\+w* \+w por|strong="G1722"\+w* \+w todo|strong="G3956"\+w* \+w lo|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w hay|strong="G3588"\+w* \+w encima|strong="G1883"\+w* \+w de|strong="G1722"\+w* \+w él|strong="G3588"\+w*.\wj*  
