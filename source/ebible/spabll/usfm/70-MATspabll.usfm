\p
\v 55 \w En|strong="G1722"\w* ese momento, \w Jesús|strong="G2424"\w* \w le|strong="G1722"\w* \w dijo|strong="G3004"\w* \w a|strong="G1909"\w* \w la|strong="G3588"\w* \w multitud|strong="G3793"\w*: \wj “¿Acaso soy \+w un|strong="G3588"\+w* bandido peligroso, \+w que|strong="G3588"\+w* han venido \+w a|strong="G1909"\+w* arrestarme \+w con|strong="G3326"\+w* \+w espadas|strong="G3162"\+w* \+w y|strong="G2532"\+w* \+w palos|strong="G3586"\+w*? \+w Todos|strong="G2596"\+w* \+w los|strong="G3588"\+w* \+w días|strong="G2250"\+w* \+w me|strong="G1473"\+w* sentaba \+w a|strong="G1909"\+w* \+w enseñar|strong="G1321"\+w* \+w en|strong="G1722"\+w* \+w el|strong="G3588"\+w* \+w templo|strong="G2411"\+w*, \+w y|strong="G2532"\+w* \+w no|strong="G3756"\+w* \+w me|strong="G1473"\+w* arrestaron.\wj*  
\v 56 \wj \+w Pero|strong="G1161"\+w* \+w todo|strong="G3956"\+w* \+w esto|strong="G3778"\+w* ha sucedido \+w para|strong="G2443"\+w* \+w que|strong="G3588"\+w* \+w se|strong="G1096"\+w* cumpla \+w lo|strong="G3588"\+w* \+w que|strong="G3588"\+w* escribieron \+w los|strong="G3588"\+w* \+w profetas|strong="G4396"\+w*”.\wj*  
\p \w Entonces|strong="G1161"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* \w lo|strong="G3588"\w* abandonaron \w y|strong="G1161"\w* \w huyeron|strong="G5343"\w*.   
\p
