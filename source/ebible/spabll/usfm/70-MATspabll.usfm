\p \w Y|strong="G2532"\w* \w en|strong="G3588"\w* ese mismo instante \w cantó|strong="G5455"\w* \w un|strong="G3588"\w* gallo.  
\v 75 \w Entonces|strong="G2532"\w* \w Pedro|strong="G4074"\w* \w se|strong="G2532"\w* acordó \w de|strong="G3588"\w* \w lo|strong="G3588"\w* \w que|strong="G3754"\w* \w Jesús|strong="G2424"\w* le había \w dicho|strong="G2046"\w*: \wj “\+w Antes|strong="G4250"\+w* \+w de|strong="G3588"\+w* \+w que|strong="G3754"\+w* \+w cante|strong="G5455"\+w* \+w el|strong="G3588"\+w* gallo, \+w me|strong="G1473"\+w* negarás \+w tres|strong="G5151"\+w* veces”.\wj* \w Y|strong="G2532"\w* \w salió|strong="G1831"\w* \w de|strong="G3588"\w* allí \w y|strong="G2532"\w* \w lloró|strong="G2799"\w* \w amargamente|strong="G4090"\w*.   
\c 27  
\p
\v 1 \w Al|strong="G3588"\w* amanecer, \w todos|strong="G3956"\w* \w los|strong="G3588"\w* jefes \w de|strong="G2596"\w* \w los|strong="G3588"\w* sacerdotes \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w ancianos|strong="G4245"\w* \w del|strong="G3588"\w* \w pueblo|strong="G2992"\w* \w se|strong="G1096"\w* reunieron \w para|strong="G5620"\w* \w hacer|strong="G1096"\w* \w un|strong="G3588"\w* plan \w y|strong="G2532"\w* condenar \w a|strong="G2596"\w* muerte \w a|strong="G2596"\w* \w Jesús|strong="G2424"\w*.  
\v 2 \w Lo|strong="G3588"\w* \w ataron|strong="G1210"\w*, \w se|strong="G2532"\w* \w lo|strong="G3588"\w* llevaron \w y|strong="G2532"\w* \w se|strong="G2532"\w* \w lo|strong="G3588"\w* \w entregaron|strong="G3860"\w* \w al|strong="G3588"\w* \w gobernador|strong="G2232"\w* Poncio \w Pilato|strong="G4091"\w*.   
\p
