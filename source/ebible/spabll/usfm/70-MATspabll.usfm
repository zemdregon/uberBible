\v 10 \wj \+w Porque|strong="G1510"\+w* \+w este|strong="G3778"\+w* \+w es|strong="G3739"\+w* \+w aquel|strong="G3588"\+w* \+w de|strong="G4012"\+w* \+w quien|strong="G3739"\+w* \+w está|strong="G3778"\+w* \+w escrito|strong="G1125"\+w*: ‘\+w Mira|strong="G3708"\+w*, \+w yo|strong="G1473"\+w* envío \+w mi|strong="G3588"\+w* mensajero \+w delante|strong="G1715"\+w* \+w de|strong="G4012"\+w* \+w ti|strong="G3739"\+w*, \+w el|strong="G3588"\+w* \+w cual|strong="G3739"\+w* preparará \+w tu|strong="G4771"\+w* \+w camino|strong="G3598"\+w*’.\wj*\f + \fr 11:10 \ft Malaquías 3:1 \f*  
