\v 17 Jesús \w le|strong="G1519"\w* contestó: \wj “¿\+w Por|strong="G1519"\+w* \+w qué|strong="G3588"\+w* \+w me|strong="G1473"\+w* \+w llamas|strong="G3004"\+w* bueno?\wj*\f + \fr 19:17 \ft Así que MT y TR. NU dice “¿Por qué me preguntas sobre lo que es bueno?”\f* \wj \+w Solo|strong="G1520"\+w* Dios \+w es|strong="G1487"\+w* bueno. \+w Pero|strong="G1161"\+w* \+w si|strong="G1487"\+w* \+w quieres|strong="G2309"\+w* \+w entrar|strong="G1525"\+w* \+w en|strong="G1519"\+w* \+w la|strong="G3588"\+w* \+w vida|strong="G2222"\+w*, obedece \+w los|strong="G3588"\+w* \+w mandamientos|strong="G1785"\+w*”.\wj*   
\p
\v 18 “¿\w Cuáles|strong="G4169"\w*?”, preguntó \w el|strong="G3588"\w* joven.  
\p \w Jesús|strong="G2424"\w* le \w dijo|strong="G3004"\w*: \wj “‘\+w No|strong="G3756"\+w* \+w mates|strong="G5407"\+w*, \+w no|strong="G3756"\+w* cometas adulterio, \+w no|strong="G3756"\+w* robes, \+w no|strong="G3756"\+w* des falso testimonio,\wj*  
\v 19 \wj \+w honra|strong="G5091"\+w* \+w a|strong="G5613"\+w* \+w tu|strong="G4771"\+w* \+w padre|strong="G3962"\+w* \+w y|strong="G2532"\+w* \+w a|strong="G5613"\+w* \+w tu|strong="G4771"\+w* \+w madre|strong="G3384"\+w*’\wj*\f + \fr 19:19 \ft Éxodo 20:12-16; Deuteronomio 5:16-20\f* \wj \+w y|strong="G2532"\+w* ‘ama \+w a|strong="G5613"\+w* \+w tu|strong="G4771"\+w* \+w prójimo|strong="G4139"\+w* \+w como|strong="G5613"\+w* \+w a|strong="G5613"\+w* \+w ti|strong="G4572"\+w* mismo’”.\wj*\f + \fr 19:19 \ft Levítico 19:18\f*   
\p
\v 20 \w El|strong="G3588"\w* joven le \w dijo|strong="G3004"\w*: “\w Todo|strong="G3956"\w* eso \w lo|strong="G3588"\w* he cumplido desde \w mi|strong="G3588"\w* juventud. ¿\w Qué|strong="G3588"\w* \w más|strong="G2089"\w* me \w falta|strong="G5302"\w*?”   
