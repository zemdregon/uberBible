\p \w Pero|strong="G1161"\w* \w ellos|strong="G3588"\w* \w le|strong="G4314"\w* contestaron: “¿\w Y|strong="G1161"\w* eso \w a|strong="G4314"\w* \w nosotros|strong="G2249"\w* \w qué|strong="G3588"\w* nos importa? Ese es \w tu|strong="G4771"\w* problema”.   
\p
\v 5 \w Entonces|strong="G2532"\w* Judas tiró \w las|strong="G3588"\w* monedas \w en|strong="G1519"\w* \w el|strong="G3588"\w* \w templo|strong="G3485"\w*, salió \w de|strong="G1519"\w* allí, \w y|strong="G2532"\w* fue \w y|strong="G2532"\w* \w se|strong="G2532"\w* ahorcó.   
\p
\v 6 \w Los|strong="G3588"\w* jefes \w de|strong="G1519"\w* \w los|strong="G3588"\w* sacerdotes recogieron \w las|strong="G3588"\w* monedas, \w y|strong="G1161"\w* \w dijeron|strong="G3004"\w*: “\w Nuestra|strong="G3588"\w* ley \w no|strong="G3756"\w* nos permite echar \w este|strong="G3588"\w* dinero \w en|strong="G1519"\w* \w la|strong="G3588"\w* caja \w de|strong="G1519"\w* \w las|strong="G3588"\w* ofrendas, \w porque|strong="G1161"\w* \w está|strong="G3588"\w* manchado \w de|strong="G1519"\w* sangre”.  
\v 7 \w Entonces|strong="G1161"\w* se pusieron \w de|strong="G1537"\w* acuerdo \w y|strong="G1161"\w* usaron \w el|strong="G3588"\w* dinero \w para|strong="G1519"\w* comprar \w un|strong="G3588"\w* terreno \w que|strong="G3588"\w* \w le|strong="G1519"\w* llamaban “\w El|strong="G3588"\w* campo \w del|strong="G3588"\w* \w alfarero|strong="G2763"\w*”, \w para|strong="G1519"\w* usarlo \w como|strong="G1519"\w* cementerio \w para|strong="G1519"\w* \w los|strong="G3588"\w* \w extranjeros|strong="G3581"\w*.  
\v 8 \w Por|strong="G1352"\w* eso, \w hasta|strong="G2193"\w* \w el|strong="G3588"\w* día \w de|strong="G3588"\w* \w hoy|strong="G4594"\w*, \w a|strong="G2193"\w* ese terreno se le \w llama|strong="G2564"\w* “Campo \w de|strong="G3588"\w* Sangre”.  
\v 9 \w Así|strong="G2532"\w* \w se|strong="G2532"\w* \w cumplió|strong="G4137"\w* \w lo|strong="G3588"\w* \w que|strong="G3588"\w* \w dijo|strong="G3004"\w* \w el|strong="G3588"\w* \w profeta|strong="G4396"\w* \w Jeremías|strong="G2408"\w*\f + \fr 27:9 \ft algunos manuscritos omiten “Jeremías”\f*:  
\q1 “\w Tomaron|strong="G2983"\w* \w las|strong="G3588"\w* \w treinta|strong="G5144"\w* monedas \w de|strong="G1223"\w* plata,  
