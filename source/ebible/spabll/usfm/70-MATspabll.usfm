\v 10 \w Sus|strong="G3588"\w* \w discípulos|strong="G3101"\w* \w le|strong="G3326"\w* \w dijeron|strong="G3004"\w*: “\w Si|strong="G1487"\w* \w así|strong="G3779"\w* \w es|strong="G1487"\w* \w la|strong="G3588"\w* situación \w entre|strong="G3326"\w* \w el|strong="G3588"\w* esposo \w y|strong="G1510"\w* \w la|strong="G3588"\w* \w esposa|strong="G1135"\w*, \w es|strong="G1487"\w* \w mejor|strong="G4851"\w* \w no|strong="G3756"\w* \w casarse|strong="G1060"\w*”.   
