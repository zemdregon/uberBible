\p
\v 26 \w Él|strong="G3588"\w* le \w dijo|strong="G3004"\w*: \wj “\+w No|strong="G3756"\+w* \+w está|strong="G3588"\+w* \+w bien|strong="G2570"\+w* quitarles \+w el|strong="G3588"\+w* pan \+w a|strong="G1161"\+w* \+w los|strong="G3588"\+w* \+w hijos|strong="G5043"\+w* para echárselo \+w a|strong="G1161"\+w* \+w los|strong="G3588"\+w* perritos”.\wj*   
