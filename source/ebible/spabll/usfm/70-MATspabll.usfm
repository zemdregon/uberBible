\v 38 \wj \+w Pero|strong="G1161"\+w* \+w cuando|strong="G1722"\+w* \+w los|strong="G3588"\+w* campesinos vieron \+w al|strong="G3588"\+w* \+w hijo|strong="G5207"\+w*, \+w dijeron|strong="G3004"\+w* \+w entre|strong="G1722"\+w* \+w ellos|strong="G3588"\+w*: “\+w Este|strong="G3778"\+w* \+w es|strong="G3778"\+w* \+w el|strong="G3588"\+w* \+w heredero|strong="G2818"\+w*. ¡Vamos, vamos \+w a|strong="G1722"\+w* matarlo \+w y|strong="G2532"\+w* \+w así|strong="G2532"\+w* \+w nos|strong="G1438"\+w* quedamos \+w con|strong="G1722"\+w* \+w su|strong="G3588"\+w* \+w herencia|strong="G2817"\+w*!”.\wj*  
\v 39 \wj \+w Lo|strong="G3588"\+w* agarraron, \+w lo|strong="G3588"\+w* sacaron \+w del|strong="G3588"\+w* viñedo \+w y|strong="G2532"\+w* \+w lo|strong="G3588"\+w* mataron.\wj*  
