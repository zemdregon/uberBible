\p
\v 42 \w Jesús|strong="G2424"\w* \w les|strong="G3844"\w* \w dijo|strong="G3004"\w*: \wj “¿Acaso \+w nunca|strong="G3763"\+w* han leído \+w en|strong="G1722"\+w* \+w las|strong="G3588"\+w* \+w Escrituras|strong="G1124"\+w*:\wj*  
\q1 \wj ‘\+w La|strong="G3588"\+w* \+w piedra|strong="G3037"\+w* \+w que|strong="G3588"\+w* rechazaron \+w los|strong="G3588"\+w* constructores\wj*  
