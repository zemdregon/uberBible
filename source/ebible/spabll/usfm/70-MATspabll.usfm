\v 21 \wj Pero esta clase de demonios no sale sino con oración y ayuno”.\wj*   
\p
\v 22 Mientras andaban \w por|strong="G1722"\w* \w Galilea|strong="G1056"\w*, \w Jesús|strong="G2424"\w* \w les|strong="G1519"\w* \w dijo|strong="G3004"\w*: \wj “\+w El|strong="G3588"\+w* \+w Hijo|strong="G5207"\+w* \+w del|strong="G3588"\+w* Hombre va \+w a|strong="G1519"\+w* ser \+w entregado|strong="G3860"\+w* \+w en|strong="G1722"\+w* \+w manos|strong="G5495"\+w* \+w de|strong="G1722"\+w* \+w los|strong="G3588"\+w* hombres,\wj*  
\v 23 \wj \+w lo|strong="G3588"\+w* matarán, \+w pero|strong="G2532"\+w* \+w al|strong="G3588"\+w* \+w tercer|strong="G5154"\+w* \+w día|strong="G2250"\+w* \+w resucitará|strong="G1453"\+w*”.\wj*  
\p \w Y|strong="G2532"\w* \w los|strong="G3588"\w* discípulos \w se|strong="G2532"\w* entristecieron \w mucho|strong="G4970"\w*.   
\p
\v 24 Cuando \w llegaron|strong="G4334"\w* \w a|strong="G1519"\w* \w Capernaúm|strong="G2584"\w*, \w los|strong="G3588"\w* \w que|strong="G3588"\w* cobraban \w el|strong="G3588"\w* impuesto\f + \fr 17:24 \ft Una didracma es una moneda de plata griega que vale 2 dracmas, más o menos lo mismo que 2 denarios romanos, o sea, el salario de 2 días. Se utilizaba comúnmente para pagar el impuesto del templo de medio shekel, porque 2 dracmas valían un medio shekel de plata. Un siclo equivale a unos 10 gramos o a unas 0,35 onzas.\f* \w del|strong="G3588"\w* templo \w se|strong="G2532"\w* acercaron \w a|strong="G1519"\w* \w Pedro|strong="G4074"\w* \w y|strong="G2532"\w* \w le|strong="G1519"\w* preguntaron: “¿\w Tu|strong="G4771"\w* \w maestro|strong="G1320"\w* \w no|strong="G3756"\w* \w paga|strong="G5055"\w* \w el|strong="G3588"\w* impuesto \w del|strong="G3588"\w* templo?”  
\v 25 \w Él|strong="G3588"\w* respondió: “\w Sí|strong="G3483"\w*”.  
\p \w Al|strong="G3588"\w* \w entrar|strong="G1525"\w* Pedro \w en|strong="G1519"\w* \w la|strong="G3588"\w* \w casa|strong="G3614"\w*, \w Jesús|strong="G2424"\w* \w se|strong="G2532"\w* \w le|strong="G1519"\w* adelantó \w y|strong="G2532"\w* \w le|strong="G1519"\w* preguntó: \wj “¿\+w Qué|strong="G3588"\+w* \+w te|strong="G4771"\+w* \+w parece|strong="G1380"\+w*, \+w Simón|strong="G4613"\+w*? ¿\+w A|strong="G1519"\+w* \+w quiénes|strong="G5101"\+w* \+w les|strong="G1519"\+w* \+w cobran|strong="G2983"\+w* impuestos \+w o|strong="G2228"\+w* tributos \+w los|strong="G3588"\+w* reyes \+w de|strong="G1519"\+w* \+w la|strong="G3588"\+w* \+w tierra|strong="G1093"\+w*? ¿\+w A|strong="G1519"\+w* \+w sus|strong="G3588"\+w* propios \+w hijos|strong="G5207"\+w* \+w o|strong="G2228"\+w* \+w a|strong="G1519"\+w* \+w los|strong="G3588"\+w* \+w demás|strong="G2532"\+w*?”\wj*   
\p
\v 26 Pedro le contestó: “\w A|strong="G1161"\w* \w los|strong="G3588"\w* demás”.  
\p \w Jesús|strong="G2424"\w* le \w dijo|strong="G3004"\w*: \wj “\+w Entonces|strong="G1161"\+w* \+w los|strong="G3588"\+w* \+w hijos|strong="G5207"\+w* están \+w libres|strong="G1658"\+w* \+w del|strong="G3588"\+w* pago.\wj*  
\v 27 \wj \+w Sin|strong="G3361"\+w* embargo, \+w para|strong="G1519"\+w* \+w no|strong="G3361"\+w* ofenderlos, \+w ve|strong="G4198"\+w* \+w al|strong="G3588"\+w* lago, echa \+w el|strong="G3588"\+w* anzuelo \+w y|strong="G2532"\+w* saca \+w el|strong="G3588"\+w* \+w primer|strong="G4413"\+w* \+w pescado|strong="G2486"\+w* \+w que|strong="G3588"\+w* pique. Ábrele \+w la|strong="G3588"\+w* \+w boca|strong="G4750"\+w* \+w y|strong="G2532"\+w* encontrarás \+w una|strong="G3588"\+w* moneda \+w de|strong="G1519"\+w* plata.\wj*\f + \fr 17:27 \ft Un stater es una moneda de plata equivalente a cuatro dracmas áticas o dos alejandrinas, o a un siclo judío: lo suficiente para cubrir el impuesto de medio siclo del templo para dos personas. Un siclo equivale a unos 10 gramos o unas 0,35 onzas, generalmente en forma de moneda de plata.\f* \wj Tómala \+w y|strong="G2532"\+w* págales \+w el|strong="G3588"\+w* impuesto \+w por|strong="G1519"\+w* \+w mí|strong="G3588"\+w* \+w y|strong="G2532"\+w* \+w por|strong="G1519"\+w* \+w ti|strong="G1438"\+w*”.\wj*   
\c 18  
\p
\v 1 \w En|strong="G1722"\w* ese momento, \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* se acercaron \w a|strong="G1722"\w* \w Jesús|strong="G2424"\w* \w y|strong="G1510"\w* \w le|strong="G1722"\w* preguntaron: “¿\w Quién|strong="G5101"\w* es \w el|strong="G3588"\w* más importante \w en|strong="G1722"\w* \w el|strong="G3588"\w* Reino \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w Cielos|strong="G3772"\w*?”   
\p
