\v 12 \wj \+w Porque|strong="G1063"\+w* \+w hay|strong="G3588"\+w* hombres \+w que|strong="G3588"\+w* nacen incapacitados \+w para|strong="G1223"\+w* \+w el|strong="G3588"\+w* matrimonio; \+w otros|strong="G3588"\+w* \+w son|strong="G1510"\+w* incapacitados \+w por|strong="G1223"\+w* \+w los|strong="G3588"\+w* hombres, \+w y|strong="G2532"\+w* \+w otros|strong="G3588"\+w* renuncian \+w a|strong="G1537"\+w* casarse \+w por|strong="G1223"\+w* \+w causa|strong="G1223"\+w* \+w del|strong="G3588"\+w* Reino \+w de|strong="G1537"\+w* \+w los|strong="G3588"\+w* \+w Cielos|strong="G3772"\+w*. \+w El|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w pueda|strong="G1410"\+w* aceptar \+w esto|strong="G3588"\+w*, \+w que|strong="G3588"\+w* \+w lo|strong="G3588"\+w* acepte”.\wj*   
\p
\v 13 \w Entonces|strong="G1161"\w* le llevaron \w unos|strong="G3588"\w* \w niños|strong="G3813"\w* \w a|strong="G2443"\w* Jesús \w para|strong="G2443"\w* \w que|strong="G3588"\w* pusiera \w las|strong="G3588"\w* \w manos|strong="G5495"\w* sobre \w ellos|strong="G3588"\w* \w y|strong="G2532"\w* orara, \w pero|strong="G1161"\w* \w los|strong="G3588"\w* \w discípulos|strong="G3101"\w* regañaban \w a|strong="G2443"\w* quienes \w los|strong="G3588"\w* llevaban.  
\v 14 \w Jesús|strong="G2424"\w* \w les|strong="G4314"\w* \w dijo|strong="G3004"\w*: \wj “Dejen \+w a|strong="G4314"\+w* \+w los|strong="G3588"\+w* \+w niños|strong="G3813"\+w* \+w y|strong="G2532"\+w* \+w no|strong="G3361"\+w* \+w les|strong="G4314"\+w* impidan \+w que|strong="G3588"\+w* \+w se|strong="G4314"\+w* acerquen \+w a|strong="G4314"\+w* \+w mí|strong="G3588"\+w*, \+w porque|strong="G1063"\+w* \+w el|strong="G3588"\+w* Reino \+w de|strong="G4314"\+w* \+w los|strong="G3588"\+w* \+w Cielos|strong="G3772"\+w* es \+w de|strong="G4314"\+w* \+w los|strong="G3588"\+w* \+w que|strong="G3588"\+w* \+w son|strong="G1510"\+w* \+w como|strong="G2532"\+w* \+w ellos|strong="G3588"\+w*”.\wj*  
\v 15 \w Después|strong="G2532"\w* \w de|strong="G3588"\w* poner \w las|strong="G3588"\w* \w manos|strong="G5495"\w* sobre \w ellos|strong="G3588"\w*, \w se|strong="G2532"\w* \w fue|strong="G4198"\w* \w de|strong="G3588"\w* allí.   
\p
\v 16 Resulta \w que|strong="G5101"\w* \w un|strong="G1520"\w* joven \w se|strong="G2532"\w* le acercó \w y|strong="G2532"\w* le preguntó: “\w Maestro|strong="G1320"\w* bueno, ¿\w qué|strong="G5101"\w* \w cosa|strong="G1520"\w* buena debo \w hacer|strong="G4160"\w* \w para|strong="G2443"\w* \w tener|strong="G2192"\w* la \w vida|strong="G2222"\w* eterna?”   
