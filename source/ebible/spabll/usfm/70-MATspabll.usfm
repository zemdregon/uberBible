\p
\v 16 \wj “¿\+w Pero|strong="G1161"\+w* \+w con|strong="G1722"\+w* \+w qué|strong="G3588"\+w* \+w compararé|strong="G3666"\+w* \+w a|strong="G1722"\+w* \+w esta|strong="G3778"\+w* \+w generación|strong="G1074"\+w*? \+w Es|strong="G3739"\+w* \+w como|strong="G1722"\+w* \+w los|strong="G3588"\+w* \+w niños|strong="G3813"\+w* \+w que|strong="G3588"\+w* se sientan \+w en|strong="G1722"\+w* \+w las|strong="G3588"\+w* plazas \+w y|strong="G1161"\+w* les gritan \+w a|strong="G1722"\+w* \+w sus|strong="G3588"\+w* compañeros:\wj*  
\v 17 \wj ‘Les tocamos la flauta, \+w y|strong="G2532"\+w* \+w no|strong="G3756"\+w* bailaron; les cantamos canciones tristes, \+w y|strong="G2532"\+w* \+w no|strong="G3756"\+w* lloraron’.\wj*  
