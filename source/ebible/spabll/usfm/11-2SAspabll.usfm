\toc1 SEGUNDO LIBRO DE SAMUEL 
\toc2 2 SAMUEL 
\mt2 Segundo libro de  
\mt1 Samuel  
\c 1  
\p
\v 1 \w Después|strong="H3427"\w* de la \w muerte|strong="H4191"\w* de \w Saúl|strong="H7586"\w*, \w cuando|strong="H3117"\w* \w David|strong="H1732"\w* regresó de derrotar \w a|strong="H3068"\w* \w los|strong="H3427"\w* amalecitas, \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w dos|strong="H8147"\w* \w días|strong="H3117"\w* \w en|strong="H5221"\w* \w Siclag|strong="H6860"\w*.  
\v 2 \w Al|strong="H5921"\w* tercer \w día|strong="H3117"\w*, un hombre llegó \w del|strong="H4480"\w* \w campamento|strong="H4264"\w* \w de|strong="H4480"\w* \w Saúl|strong="H7586"\w* \w con|strong="H5973"\w* \w la|strong="H5921"\w* ropa rota \w y|strong="H5921"\w* tierra \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*. \w Al|strong="H5921"\w* llegar ante \w David|strong="H1732"\w*, \w se|strong="H1961"\w* inclinó \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* suelo \w en|strong="H5921"\w* señal \w de|strong="H4480"\w* respeto.   
\p
\v 3 \w David|strong="H1732"\w* le preguntó: ¿De dónde vienes? \w Él|strong="H4264"\w* respondió: He escapado del \w campamento|strong="H4264"\w* de \w Israel|strong="H3478"\w*.   
\p
\v 4 ¿\w Qué|strong="H4100"\w* \w fue|strong="H1961"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* pasó? le pidió \w David|strong="H1732"\w*. Cuéntamelo todo, \w por|strong="H4480"\w* favor. \w El|strong="H5307"\w* \w hombre|strong="H1121"\w* respondió: \w El|strong="H5307"\w* ejército \w huyó|strong="H5127"\w* \w de|strong="H4480"\w* \w la|strong="H1571"\w* \w batalla|strong="H4421"\w*, \w y|strong="H1571"\w* muchísimos \w de|strong="H4480"\w* \w ellos|strong="H1571"\w* \w cayeron|strong="H5307"\w* \w muertos|strong="H4191"\w*. Incluso \w Saúl|strong="H7586"\w* \w y|strong="H1571"\w* su \w hijo|strong="H1121"\w* Jonatán \w han|strong="H4191"\w* \w muerto|strong="H4191"\w*.   
\p
\v 5 \w David|strong="H1732"\w* le preguntó al joven \w que|strong="H3588"\w* le traía \w la|strong="H3588"\w* noticia: ¿\w Cómo|strong="H3588"\w* \w sabes|strong="H3045"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* Jonatán \w han|strong="H4191"\w* \w muerto|strong="H4191"\w*?   
\p
\v 6 \w El|strong="H5921"\w* joven respondió: \w Por|strong="H5921"\w* casualidad \w me|strong="H5921"\w* encontraba \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* Gilboa \w y|strong="H5921"\w* vi \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* apoyado \w en|strong="H5921"\w* su \w lanza|strong="H2595"\w*, mientras \w los|strong="H5921"\w* \w carros|strong="H7393"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* caballería \w lo|strong="H5921"\w* rodeaban \w de|strong="H5921"\w* \w cerca|strong="H5921"\w*.  
\v 7 Cuando él \w miró|strong="H7200"\w* hacia atrás y me \w vio|strong="H7200"\w*, me \w llamó|strong="H7121"\w*. Yo le respondí: “\w Aquí|strong="H2005"\w* estoy”.  
\v 8 \w Él|strong="H4310"\w* \w me|strong="H4310"\w* preguntó: “¿\w Quién|strong="H4310"\w* eres?”. \w Y|strong="H3068"\w* yo \w le|strong="H4310"\w* dije: “Soy un amalecita”.  
\v 9 \w Entonces|strong="H3588"\w* \w me|strong="H5921"\w* pidió: “\w Por|strong="H5921"\w* favor, ven acá \w y|strong="H3588"\w* mátame, \w porque|strong="H3588"\w* \w estoy|strong="H5975"\w* agonizando \w y|strong="H3588"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w* \w no|strong="H3588"\w* termina \w de|strong="H5921"\w* irse”.  
\v 10 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* acerqué \w y|strong="H3588"\w* \w lo|strong="H3808"\w* \w maté|strong="H4191"\w*, \w pues|strong="H3588"\w* \w me|strong="H5921"\w* di cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* iba \w a|strong="H3068"\w* sobrevivir \w a|strong="H3068"\w* sus heridas. Luego \w tomé|strong="H3947"\w* \w la|strong="H5921"\w* corona \w que|strong="H3588"\w* tenía \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w y|strong="H3588"\w* \w el|strong="H5921"\w* brazalete \w que|strong="H3588"\w* llevaba \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w brazo|strong="H2220"\w*, \w y|strong="H3588"\w* \w se|strong="H3045"\w* \w los|strong="H5921"\w* he traído \w aquí|strong="H2008"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* señor.   
\p
\v 11 \w Entonces|strong="H1571"\w* \w David|strong="H1732"\w* \w y|strong="H1571"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres \w que|strong="H1571"\w* estaban \w con|strong="H1571"\w* \w él|strong="H3605"\w* agarraron su ropa \w y|strong="H1571"\w* \w la|strong="H1571"\w* \w rasgaron|strong="H7167"\w* en señal de duelo.  
\v 12 \w Lloraron|strong="H1058"\w*, \w se|strong="H5921"\w* \w lamentaron|strong="H1058"\w* \w y|strong="H3588"\w* ayunaron \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* anochecer \w por|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* Jonatán, \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* nación \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* muchos habían muerto \w a|strong="H3068"\w* \w espada|strong="H2719"\w*.   
\p
\v 13 Después \w David|strong="H1732"\w* le preguntó al joven \w que|strong="H1616"\w* le dio \w el|strong="H1121"\w* informe: ¿\w De|strong="H1121"\w* dónde eres tú? \w Y|strong="H3068"\w* \w él|strong="H1121"\w* respondió: Soy \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* un \w extranjero|strong="H1616"\w*, un amalecita.  
\v 14 \w David|strong="H1732"\w* le dijo: ¿Cómo te atreviste \w a|strong="H3068"\w* levantar la \w mano|strong="H3027"\w* para \w destruir|strong="H7843"\w* al \w ungido|strong="H4899"\w* del \w Señor|strong="H3068"\w*?  
\v 15 \w En|strong="H5221"\w* ese momento \w David|strong="H1732"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* uno de sus hombres y le ordenó: ¡Ven y mátalo! \w El|strong="H5066"\w* hombre lo golpeó y \w el|strong="H5066"\w* joven \w murió|strong="H4191"\w*.  
\v 16 \w Porque|strong="H3588"\w* \w David|strong="H1732"\w* \w le|strong="H5921"\w* \w había|strong="H3588"\w* \w dicho|strong="H6310"\w*: Tú eres \w el|strong="H5921"\w* único responsable \w de|strong="H5921"\w* tu propia \w muerte|strong="H4191"\w*, \w pues|strong="H3588"\w* tu misma \w boca|strong="H6310"\w* \w te|strong="H5921"\w* condenó \w al|strong="H5921"\w* decir: “\w Yo|strong="H3588"\w* \w maté|strong="H4191"\w* \w al|strong="H5921"\w* \w ungido|strong="H4899"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w*”.   
\p
\v 17 \w David|strong="H1732"\w* compuso \w este|strong="H2063"\w* lamento fúnebre \w por|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* su \w hijo|strong="H1121"\w* Jonatán,  
\v 18 \w y|strong="H5921"\w* ordenó \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w enseñara|strong="H3925"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* este “Canto \w del|strong="H5921"\w* \w Arco|strong="H7198"\w*”, \w el|strong="H5921"\w* cual \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* Jaser:   
\q1
\v 19 “¡Tu \w gloria|strong="H6643"\w*, oh \w Israel|strong="H3478"\w*, yace muerta \w en|strong="H5921"\w* tus colinas!  
\q2 ¡\w Cómo|strong="H5921"\w* han \w caído|strong="H5307"\w* \w los|strong="H5921"\w* \w valientes|strong="H1368"\w*!   
\q1
\v 20 \w No|strong="H6435"\w* den la noticia en Gat,  
\q2 \w ni|strong="H6435"\w* lo anuncien en las \w calles|strong="H2351"\w* de Ascalón,  
\q1 para \w que|strong="H6435"\w* \w no|strong="H6435"\w* \w se|strong="H6435"\w* alegren las \w hijas|strong="H1323"\w* de los \w filisteos|strong="H6430"\w*,  
\q2 \w ni|strong="H6435"\w* celebren las \w hijas|strong="H1323"\w* de los paganos.   
\q1
\v 21 ¡\w Montes|strong="H2022"\w* \w de|strong="H5921"\w* Gilboa,  
\q2 \w que|strong="H3588"\w* \w no|strong="H1097"\w* caiga \w sobre|strong="H5921"\w* ustedes \w rocío|strong="H2919"\w* \w ni|strong="H1097"\w* \w lluvia|strong="H4306"\w*, \w ni|strong="H1097"\w* den frutos \w para|strong="H5921"\w* \w ofrendas|strong="H8641"\w*!  
\q2 \w Porque|strong="H3588"\w* \w allí|strong="H8033"\w* fue pisoteado \w el|strong="H5921"\w* \w escudo|strong="H4043"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w valientes|strong="H1368"\w*,  
\q2 \w el|strong="H5921"\w* \w escudo|strong="H4043"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*, \w que|strong="H3588"\w* ya \w no|strong="H1097"\w* será \w ungido|strong="H4899"\w* \w con|strong="H5921"\w* \w aceite|strong="H8081"\w*.   
\q1
\v 22 \w Sin|strong="H3808"\w* beber \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* \w muertos|strong="H2491"\w* \w ni|strong="H3808"\w* grasa \w de|strong="H1818"\w* guerreros,  
\q2 el \w arco|strong="H7198"\w* \w de|strong="H1818"\w* Jonatán \w nunca|strong="H3808"\w* retrocedió,  
\q2 \w ni|strong="H3808"\w* la \w espada|strong="H2719"\w* \w de|strong="H1818"\w* \w Saúl|strong="H7586"\w* regresó \w vacía|strong="H7387"\w*.   
\q1
\v 23 ¡\w Saúl|strong="H7586"\w* y Jonatán, \w qué|strong="H3808"\w* amados y queridos fueron en \w vida|strong="H2416"\w*!  
\q2 \w Ni|strong="H3808"\w* en la \w muerte|strong="H4194"\w* fueron separados.  
\q1 \w Eran|strong="H3808"\w* \w más|strong="H3808"\w* veloces \w que|strong="H3808"\w* las águilas,  
\q2 \w eran|strong="H3808"\w* \w más|strong="H3808"\w* fuertes \w que|strong="H3808"\w* los leones.   
\q1
\v 24 \w Mujeres|strong="H1323"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w lloren|strong="H1058"\w* \w por|strong="H5921"\w* \w Saúl|strong="H7586"\w*,  
\q2 \w que|strong="H5921"\w* \w las|strong="H5921"\w* vestía \w de|strong="H5921"\w* fina escarlata  
\q2 \w y|strong="H5921"\w* \w las|strong="H5921"\w* adornaba \w con|strong="H5973"\w* joyas \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.   
\q1
\v 25 ¡\w Cómo|strong="H5921"\w* han \w caído|strong="H5307"\w* \w los|strong="H5921"\w* \w valientes|strong="H1368"\w* \w en|strong="H5921"\w* plena \w batalla|strong="H4421"\w*!  
\q2 ¡Jonatán, \w muerto|strong="H2491"\w* \w en|strong="H5921"\w* tus colinas!   
\q1
\v 26 ¡\w Qué|strong="H5921"\w* dolor siento \w por|strong="H5921"\w* \w ti|strong="H5921"\w*, Jonatán, hermano \w mío|strong="H5921"\w*!  
\q2 Fuiste \w para|strong="H5921"\w* \w mí|strong="H5921"\w* un amigo \w muy|strong="H3966"\w* querido.  
\q2 Tu amor \w por|strong="H5921"\w* \w mí|strong="H5921"\w* fue maravilloso,  
\q2 \w más|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* amor \w de|strong="H5921"\w* \w las|strong="H5921"\w* mujeres.   
\q1
\v 27 ¡Cómo han \w caído|strong="H5307"\w* los \w valientes|strong="H1368"\w*!  
\q2 ¡Las \w armas|strong="H3627"\w* de \w guerra|strong="H4421"\w* han perecido!”.   
\c 2  
\p
\v 1 Tiempo \w después|strong="H1961"\w*, \w David|strong="H1732"\w* \w consultó|strong="H7592"\w* al \w Señor|strong="H3068"\w*: ¿Debo ir \w a|strong="H3068"\w* alguna de las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w*?  
\p El \w Señor|strong="H3068"\w* le respondió: \w Sí|strong="H1961"\w*, \w ve|strong="H5927"\w*.  
\p \w David|strong="H1732"\w* \w preguntó|strong="H7592"\w*: ¿\w A|strong="H3068"\w* dónde debo ir?  
\p \w A|strong="H3068"\w* \w Hebrón|strong="H2275"\w* le respondió el \w Señor|strong="H3068"\w*.   
\p
\v 2 \w Así|strong="H1571"\w* \w que|strong="H1571"\w* \w David|strong="H1732"\w* \w fue|strong="H1571"\w* \w allá|strong="H8033"\w* \w con|strong="H1571"\w* sus \w dos|strong="H8147"\w* esposas: Ahinoam \w la|strong="H1571"\w* \w jezreelita|strong="H3159"\w* \w y|strong="H1571"\w* Abigail, \w la|strong="H1571"\w* viuda de \w Nabal|strong="H5037"\w* \w el|strong="H1571"\w* de Carmelo.  
\v 3 \w David|strong="H1732"\w* también se llevó \w a|strong="H3068"\w* \w los|strong="H3427"\w* hombres que \w estaban|strong="H3427"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*, cada uno \w con|strong="H5973"\w* su \w familia|strong="H1004"\w*, y se instalaron \w en|strong="H5973"\w* \w los|strong="H3427"\w* pueblos cercanos \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w*.  
\v 4 Entonces \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w fueron|strong="H1732"\w* \w a|strong="H3068"\w* Hebrón \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w ungieron|strong="H4886"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. También \w le|strong="H5921"\w* informaron \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Fueron|strong="H1732"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w Jabes|strong="H3003"\w* \w de|strong="H5921"\w* \w Galaad|strong="H1568"\w* quienes enterraron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*”.  
\v 5 \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w de|strong="H5973"\w* \w Jabes|strong="H3003"\w* \w de|strong="H5973"\w* \w Galaad|strong="H1568"\w* \w para|strong="H5973"\w* decirles: “\w Que|strong="H2088"\w* \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w los|strong="H5973"\w* \w bendiga|strong="H1288"\w* \w por|strong="H2088"\w* haber sido tan leales \w con|strong="H5973"\w* su \w señor|strong="H3068"\w* \w Saúl|strong="H7586"\w* al darle sepultura.  
\v 6 \w Que|strong="H6258"\w* \w ahora|strong="H6258"\w* \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w los|strong="H5973"\w* trate \w con|strong="H5973"\w* amor \w y|strong="H1571"\w* fidelidad; \w yo|strong="H6213"\w* \w también|strong="H1571"\w* \w los|strong="H5973"\w* recompensaré \w por|strong="H1697"\w* \w esto|strong="H2063"\w* \w que|strong="H6258"\w* han \w hecho|strong="H6213"\w*.  
\v 7 Cobren \w ánimo|strong="H2388"\w* \w y|strong="H1571"\w* \w sean|strong="H1961"\w* \w valientes|strong="H2428"\w*; \w pues|strong="H3588"\w* \w aunque|strong="H3588"\w* \w su|strong="H3588"\w* señor \w Saúl|strong="H7586"\w* ha \w muerto|strong="H4191"\w*, \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w ya|strong="H6258"\w* \w me|strong="H5921"\w* ha \w ungido|strong="H4886"\w* \w como|strong="H3588"\w* \w su|strong="H3588"\w* \w rey|strong="H4428"\w*”.   
\p
\v 8 Mientras tanto Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w*, \w general|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* Isboset \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* y lo \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Mahanaim|strong="H4266"\w*.  
\v 9 Allí \w lo|strong="H5921"\w* proclamó \w rey|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Galaad|strong="H1568"\w*, \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* asuritas, \w sobre|strong="H5921"\w* \w Jezreel|strong="H3157"\w*, \w sobre|strong="H5921"\w* Efraín \w y|strong="H5921"\w* \w Benjamín|strong="H1144"\w*; es decir, \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 10 Isboset \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w tenía|strong="H1961"\w* cuarenta \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w reinó|strong="H4427"\w* \w dos|strong="H8147"\w* \w años|strong="H8141"\w*. Pero \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w se|strong="H1961"\w* mantuvo fiel \w a|strong="H3068"\w* \w David|strong="H1732"\w*.  
\v 11 \w David|strong="H1732"\w* \w reinó|strong="H1961"\w* \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* durante \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w y|strong="H5921"\w* \w seis|strong="H8337"\w* \w meses|strong="H2320"\w*.   
\p
\v 12 Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w* y las tropas \w de|strong="H1121"\w* Isboset \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* \w salieron|strong="H3318"\w* \w de|strong="H1121"\w* \w Mahanaim|strong="H4266"\w* hacia \w Gabaón|strong="H1391"\w*.  
\v 13 \w Por|strong="H5921"\w* su parte, \w Joab|strong="H3097"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Sarvia \w y|strong="H5921"\w* \w los|strong="H3427"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* enfrentarlos. \w Se|strong="H5921"\w* encontraron \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w estanque|strong="H1295"\w* \w de|strong="H5921"\w* \w Gabaón|strong="H1391"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w sentaron|strong="H3427"\w* \w a|strong="H3068"\w* ambos \w lados|strong="H5650"\w* \w del|strong="H5921"\w* \w estanque|strong="H1295"\w*, \w un|strong="H3162"\w* grupo frente \w al|strong="H5921"\w* \w otro|strong="H2088"\w*.  
\v 14 Entonces Abner le dijo \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*: \w Que|strong="H4994"\w* se levanten algunos jóvenes y luchen frente \w a|strong="H3068"\w* nosotros.  
\p \w Está|strong="H6965"\w* bien, \w que|strong="H4994"\w* se levanten respondió \w Joab|strong="H3097"\w*.  
\v 15 Se \w levantaron|strong="H6965"\w* \w doce|strong="H8147"\w* jóvenes por \w el|strong="H1121"\w* bando \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* y \w de|strong="H1121"\w* Isboset \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*, y \w doce|strong="H8147"\w* por \w el|strong="H1121"\w* bando \w de|strong="H1121"\w* \w David|strong="H1732"\w*.  
\v 16 Cada uno agarró \w a|strong="H3068"\w* \w su|strong="H1931"\w* rival por \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* y \w le|strong="H1931"\w* hundió \w la|strong="H1931"\w* \w espada|strong="H2719"\w* en \w el|strong="H1931"\w* costado, de modo \w que|strong="H1931"\w* \w todos|strong="H3162"\w* \w cayeron|strong="H5307"\w* muertos al \w mismo|strong="H1931"\w* tiempo. Por \w eso|strong="H1931"\w* \w a|strong="H3068"\w* \w aquel|strong="H1931"\w* \w lugar|strong="H4725"\w*, \w que|strong="H1931"\w* \w está|strong="H1931"\w* en \w Gabaón|strong="H1391"\w*, \w lo|strong="H1931"\w* \w llamaron|strong="H7121"\w* Helcat-hazurim.  
\v 17 \w La|strong="H1931"\w* \w batalla|strong="H4421"\w* \w que|strong="H1931"\w* siguió \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w fue|strong="H1961"\w* \w muy|strong="H3966"\w* violenta, \w y|strong="H5704"\w* \w los|strong="H1931"\w* hombres \w de|strong="H6440"\w* \w David|strong="H1732"\w* derrotaron \w a|strong="H3068"\w* Abner \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Allí|strong="H8033"\w* \w estaban|strong="H1961"\w* \w los|strong="H1121"\w* \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Sarvia: \w Joab|strong="H3097"\w*, \w Abisai|strong="H7969"\w* y \w Asael|strong="H6214"\w*. \w Este|strong="H1961"\w* último corría tan rápido \w como|strong="H1961"\w* una gacela en \w el|strong="H1121"\w* \w campo|strong="H7704"\w*.  
\v 19 \w Asael|strong="H6214"\w* \w se|strong="H5921"\w* lanzó tras Abner \w y|strong="H5921"\w* \w lo|strong="H3808"\w* \w persiguió|strong="H7291"\w* \w sin|strong="H3808"\w* desviarse \w para|strong="H5921"\w* \w nada|strong="H3808"\w*.   
\p
\v 20 Abner \w miró|strong="H6437"\w* hacia atrás y preguntó: ¿Eres tú, \w Asael|strong="H6214"\w*?  
\p Sí, yo soy respondió él.   
\p
\v 21 Abner \w le|strong="H5921"\w* dijo: Déjame \w en|strong="H5921"\w* paz, persigue \w a|strong="H3068"\w* algún otro joven \w y|strong="H5921"\w* quédate \w con|strong="H5921"\w* su equipo \w de|strong="H5921"\w* guerra. Pero \w Asael|strong="H6214"\w* \w no|strong="H3808"\w* quiso dejar \w de|strong="H5921"\w* seguirlo.  
\v 22 Una vez \w más|strong="H5750"\w* Abner \w le|strong="H3254"\w* advirtió: ¡Deja \w de|strong="H6440"\w* perseguirme! \w No|strong="H6440"\w* me obligues \w a|strong="H3068"\w* matarte. ¿\w Cómo|strong="H4100"\w* podría después mirar \w a|strong="H3068"\w* la \w cara|strong="H6440"\w* \w a|strong="H3068"\w* tu hermano \w Joab|strong="H3097"\w*?  
\v 23 \w Como|strong="H1961"\w* \w Asael|strong="H6214"\w* \w se|strong="H1961"\w* negó \w a|strong="H3068"\w* dejarlo, Abner le dio un golpe \w hacia|strong="H8033"\w* atrás con \w el|strong="H3605"\w* extremo \w de|strong="H8478"\w* su \w lanza|strong="H2595"\w* y \w se|strong="H1961"\w* \w la|strong="H3605"\w* hundió \w en|strong="H3318"\w* \w el|strong="H3605"\w* vientre. \w La|strong="H3605"\w* \w lanza|strong="H2595"\w* le \w salió|strong="H3318"\w* \w por|strong="H8478"\w* \w la|strong="H3605"\w* espalda, y \w Asael|strong="H6214"\w* \w cayó|strong="H5307"\w* \w muerto|strong="H4191"\w* \w en|strong="H3318"\w* ese \w mismo|strong="H3605"\w* \w lugar|strong="H4725"\w*. \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* pasaban \w por|strong="H8478"\w* \w donde|strong="H8033"\w* \w cayó|strong="H5307"\w* \w Asael|strong="H6214"\w* \w se|strong="H1961"\w* detenían \w a|strong="H3068"\w* ver \w el|strong="H3605"\w* cuerpo.   
\p
\v 24 Pero \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* Abisai \w siguieron|strong="H7291"\w* persiguiendo \w a|strong="H3068"\w* Abner. \w El|strong="H5921"\w* \w sol|strong="H8121"\w* ya \w se|strong="H5921"\w* estaba poniendo \w cuando|strong="H5704"\w* llegaron \w a|strong="H3068"\w* \w la|strong="H5921"\w* colina \w de|strong="H5921"\w* Amma, frente \w a|strong="H3068"\w* Gía, \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w que|strong="H5921"\w* \w va|strong="H3068"\w* \w al|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* \w Gabaón|strong="H1391"\w*.  
\v 25 \w Los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w* \w se|strong="H1961"\w* reunieron detrás \w de|strong="H5921"\w* Abner \w y|strong="H5921"\w*, formando un solo grupo, \w se|strong="H1961"\w* detuvieron \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte \w más|strong="H5921"\w* alta \w de|strong="H5921"\w* \w la|strong="H5921"\w* colina.  
\v 26 \w Desde|strong="H5704"\w* allí Abner le \w gritó|strong="H7121"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*: ¿Seguirá \w la|strong="H3588"\w* \w espada|strong="H2719"\w* matando \w para|strong="H5704"\w* siempre? ¿\w No|strong="H3808"\w* \w te|strong="H3588"\w* das cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w al|strong="H5704"\w* final todo \w será|strong="H1961"\w* \w amargura|strong="H4751"\w*? ¿\w Cuánto|strong="H3588"\w* tiempo vas \w a|strong="H3068"\w* esperar \w para|strong="H5704"\w* ordenarle \w a|strong="H3068"\w* tu \w gente|strong="H5971"\w* \w que|strong="H3588"\w* deje \w de|strong="H3588"\w* perseguir \w a|strong="H3068"\w* sus hermanos?   
\p
\v 27 \w Joab|strong="H3097"\w* respondió: Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Dios \w vive|strong="H2416"\w*, \w que|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3884"\w* hubieras \w hablado|strong="H1696"\w*, mi \w gente|strong="H5971"\w* habría perseguido \w a|strong="H3068"\w* sus hermanos hasta \w el|strong="H3588"\w* amanecer.  
\v 28 Entonces \w Joab|strong="H3097"\w* \w tocó|strong="H8628"\w* \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*, y \w todas|strong="H3605"\w* sus tropas \w se|strong="H3808"\w* detuvieron; dejaron \w de|strong="H5750"\w* perseguir \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* y \w ya|strong="H3254"\w* \w no|strong="H3808"\w* lucharon \w más|strong="H5750"\w*.  
\v 29 Durante \w toda|strong="H3605"\w* \w esa|strong="H1931"\w* \w noche|strong="H3915"\w*, Abner y \w sus|strong="H1931"\w* hombres marcharon por \w el|strong="H1931"\w* valle del Arabá, \w cruzaron|strong="H3212"\w* \w el|strong="H1931"\w* \w Jordán|strong="H3383"\w* y, después de caminar \w toda|strong="H3605"\w* \w la|strong="H1931"\w* mañana por \w Bitrón|strong="H1338"\w*, llegaron \w a|strong="H3068"\w* \w Mahanaim|strong="H4266"\w*.   
\p
\v 30 \w Cuando|strong="H5650"\w* \w Joab|strong="H3097"\w* regresó \w de|strong="H5971"\w* perseguir \w a|strong="H3068"\w* Abner y reunió \w a|strong="H3068"\w* \w toda|strong="H3605"\w* su \w gente|strong="H5971"\w*, resultó \w que|strong="H5971"\w* faltaban \w diecinueve|strong="H8672"\w* \w de|strong="H5971"\w* \w los|strong="H3605"\w* soldados \w de|strong="H5971"\w* \w David|strong="H1732"\w*, además \w de|strong="H5971"\w* \w Asael|strong="H6214"\w*.  
\v 31 Sin embargo, los hombres de \w David|strong="H1732"\w* habían matado \w a|strong="H3068"\w* \w trescientos|strong="H7969"\w* \w sesenta|strong="H8346"\w* soldados del bando de Abner y de \w Benjamín|strong="H1144"\w*.  
\v 32 \w Tomaron|strong="H5375"\w* \w el|strong="H3605"\w* cuerpo de \w Asael|strong="H6214"\w* y \w lo|strong="H3605"\w* enterraron \w en|strong="H6912"\w* \w el|strong="H3605"\w* \w sepulcro|strong="H6913"\w* de su padre \w en|strong="H6912"\w* Belén. Después \w Joab|strong="H3097"\w* y sus hombres \w caminaron|strong="H3212"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w noche|strong="H3915"\w*, y llegaron \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w* al amanecer.   
\c 3  
\p
\v 1 La \w guerra|strong="H4421"\w* entre \w los|strong="H1961"\w* partidarios de \w Saúl|strong="H7586"\w* y \w los|strong="H1961"\w* de \w David|strong="H1732"\w* \w se|strong="H1961"\w* prolongó por mucho tiempo. \w David|strong="H1732"\w* \w se|strong="H1961"\w* hacía cada vez más fuerte, mientras \w que|strong="H1961"\w* la \w casa|strong="H1004"\w* de \w Saúl|strong="H7586"\w* \w se|strong="H1961"\w* \w iba|strong="H1980"\w* debilitando.  
\v 2 Estos \w son|strong="H1961"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w que|strong="H1121"\w* le \w nacieron|strong="H3205"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* en \w Hebrón|strong="H2275"\w*: su \w hijo|strong="H1121"\w* mayor \w fue|strong="H1961"\w* Amnón, cuya madre \w era|strong="H1961"\w* Ahinoam la \w jezreelita|strong="H3159"\w*;  
\v 3 \w el|strong="H1121"\w* \w segundo|strong="H4932"\w* fue Quileab, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abigail, la viuda \w de|strong="H1121"\w* \w Nabal|strong="H5037"\w* \w el|strong="H1121"\w* \w de|strong="H1121"\w* Carmelo; \w el|strong="H1121"\w* \w tercero|strong="H7992"\w* fue Absalón, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maaca, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Talmai, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Gesur;  
\v 4 \w el|strong="H1121"\w* \w cuarto|strong="H7243"\w* fue Adonías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Haguit; \w el|strong="H1121"\w* \w quinto|strong="H2549"\w* fue Sefatías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abital;  
\v 5 y el \w sexto|strong="H8345"\w* fue \w Itream|strong="H3507"\w*, \w hijo|strong="H3205"\w* de Egla, también esposa de \w David|strong="H1732"\w*. Todos ellos \w nacieron|strong="H3205"\w* en \w Hebrón|strong="H2275"\w*.   
\p
\v 6 Mientras duraba la \w guerra|strong="H4421"\w* entre \w los|strong="H1961"\w* bandos de \w Saúl|strong="H7586"\w* y de \w David|strong="H1732"\w*, Abner acumulaba más poder entre \w los|strong="H1961"\w* seguidores de \w Saúl|strong="H7586"\w*.  
\v 7 \w Saúl|strong="H7586"\w* había tenido una \w concubina|strong="H6370"\w* \w llamada|strong="H8034"\w* Rizpa, \w hija|strong="H1323"\w* de Aja. Un día, Isboset le reclamó \w a|strong="H3068"\w* Abner: ¿\w Por|strong="H4069"\w* \w qué|strong="H1323"\w* te acostaste con la \w concubina|strong="H6370"\w* de mi padre?   
\p
\v 8 Abner \w se|strong="H5921"\w* \w puso|strong="H6485"\w* furioso \w por|strong="H5921"\w* \w el|strong="H5921"\w* reclamo \w de|strong="H5921"\w* Isboset \w y|strong="H5921"\w* \w le|strong="H5921"\w* respondió: ¿Acaso soy \w yo|strong="H6213"\w* un traidor \w al|strong="H5921"\w* servicio \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*? \w Hasta|strong="H5921"\w* \w hoy|strong="H3117"\w* he sido fiel \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w tu|strong="H6213"\w* padre \w Saúl|strong="H7586"\w*, \w a|strong="H3068"\w* sus hermanos \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus amigos, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* he entregado \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*. ¡\w Y|strong="H3068"\w* \w ahora|strong="H3117"\w* \w me|strong="H5921"\w* vienes \w con|strong="H5973"\w* reclamos \w por|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* pasó \w con|strong="H5973"\w* esa mujer!  
\v 9 ¡\w Que|strong="H3588"\w* \w Dios|strong="H3068"\w* \w me|strong="H3588"\w* castigue duramente \w si|strong="H3588"\w* \w no|strong="H6213"\w* ayudo \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* conseguir \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w le|strong="H3254"\w* prometió bajo juramento!  
\v 10 Voy \w a|strong="H3068"\w* quitarle \w el|strong="H5921"\w* \w reino|strong="H4467"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* establecer \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w sobre|strong="H5921"\w* todo \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w desde|strong="H5704"\w* \w Dan|strong="H1835"\w* \w hasta|strong="H5704"\w* Berseba.   
\p
\v 11 Isboset \w no|strong="H3808"\w* \w se|strong="H3808"\w* atrevió \w a|strong="H3068"\w* decirle \w ni|strong="H3808"\w* una sola \w palabra|strong="H1697"\w* \w más|strong="H5750"\w*, \w porque|strong="H3808"\w* le tenía mucho \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* Abner.   
\p
\v 12 Entonces Abner \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w para|strong="H5973"\w* decirle \w de|strong="H8478"\w* su parte: “¿\w De|strong="H8478"\w* \w quién|strong="H4310"\w* \w es|strong="H3027"\w* esta tierra? \w Haz|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w conmigo|strong="H5973"\w*, y \w yo|strong="H2009"\w* \w te|strong="H5973"\w* ayudaré \w para|strong="H5973"\w* \w que|strong="H4310"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* se ponga \w de|strong="H8478"\w* tu parte”.   
\p
\v 13 Está \w bien|strong="H2896"\w* respondió David. \w Haré|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w contigo|strong="H6440"\w*, \w pero|strong="H3588"\w* \w con|strong="H3588"\w* una condición: \w no|strong="H3808"\w* \w te|strong="H3588"\w* presentarás \w ante|strong="H6440"\w* mí \w si|strong="H3588"\w* \w no|strong="H3808"\w* traes \w contigo|strong="H6440"\w* \w a|strong="H3068"\w* Mical, \w la|strong="H3588"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* \w Saúl|strong="H7586"\w*.  
\v 14 Al mismo tiempo, \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* Isboset \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*, con esta exigencia: “Entrégame \w a|strong="H3068"\w* mi esposa Mical, \w por|strong="H5414"\w* \w la|strong="H4324"\w* \w que|strong="H1121"\w* pagué \w cien|strong="H3967"\w* \w prepucios|strong="H6190"\w* \w de|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w para|strong="H5414"\w* casarme con ella”.   
\p
\v 15 Isboset \w mandó|strong="H7971"\w* \w que|strong="H1121"\w* se la quitaran \w a|strong="H3068"\w* su esposo \w Paltiel|strong="H6409"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Lais.  
\v 16 Paltiel se \w fue|strong="H3212"\w* tras ella \w llorando|strong="H1058"\w* \w por|strong="H5704"\w* todo el \w camino|strong="H1980"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* llegaron \w a|strong="H3068"\w* Bahurim. Allí Abner le ordenó: ¡\w Vete|strong="H3212"\w* ya, regresa \w a|strong="H3068"\w* tu casa! \w Y|strong="H3068"\w* él se \w volvió|strong="H7725"\w*.   
\p
\v 17 Luego Abner \w habló|strong="H1697"\w* \w con|strong="H5973"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* \w les|strong="H5973"\w* dijo: “\w Ya|strong="H3068"\w* \w desde|strong="H5921"\w* hace tiempo ustedes querían \w que|strong="H5921"\w* \w David|strong="H1732"\w* \w fuera|strong="H1961"\w* su \w rey|strong="H4428"\w*.  
\v 18 ¡\w Pues|strong="H3588"\w* este \w es|strong="H3027"\w* \w el|strong="H3588"\w* momento \w de|strong="H3588"\w* hacerlo! \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* ha dicho \w de|strong="H3588"\w* \w David|strong="H1732"\w*: “\w Por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* mi \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* \w salvaré|strong="H3467"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* del \w poder|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w todos|strong="H3605"\w* sus enemigos””.   
\p
\v 19 Abner \w habló|strong="H1696"\w* \w también|strong="H1571"\w* \w con|strong="H1571"\w* \w los|strong="H3605"\w* \w de|strong="H5869"\w* \w la|strong="H1571"\w* tribu \w de|strong="H5869"\w* \w Benjamín|strong="H1144"\w*. Después \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w* para informarle \w a|strong="H3068"\w* \w David|strong="H1732"\w* personalmente \w que|strong="H1571"\w* \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* \w los|strong="H3605"\w* \w de|strong="H5869"\w* \w Benjamín|strong="H1144"\w* estaban \w de|strong="H5869"\w* acuerdo \w con|strong="H1571"\w* \w él|strong="H3605"\w*.  
\v 20 Abner llegó \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w* acompañado de \w veinte|strong="H6242"\w* hombres, y \w David|strong="H1732"\w* les \w ofreció|strong="H6213"\w* un gran \w banquete|strong="H4960"\w*.  
\v 21 Abner le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: Permítame su Majestad \w ir|strong="H3212"\w* ahora \w mismo|strong="H3605"\w* \w a|strong="H3068"\w* reunir \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* para \w que|strong="H3605"\w* hagan un \w pacto|strong="H1285"\w* con usted, y así usted \w reine|strong="H4427"\w* sobre \w todo|strong="H3605"\w* \w lo|strong="H6908"\w* \w que|strong="H3605"\w* su \w corazón|strong="H5315"\w* desee. \w David|strong="H1732"\w* \w despidió|strong="H7971"\w* \w a|strong="H3068"\w* Abner, y \w él|strong="H3605"\w* se \w fue|strong="H3212"\w* tranquilo.   
\p
\v 22 Poco después, \w Joab|strong="H3097"\w* \w y|strong="H3588"\w* \w los|strong="H5973"\w* soldados \w de|strong="H3588"\w* \w David|strong="H1732"\w* regresaron \w de|strong="H3588"\w* una incursión trayendo un \w gran|strong="H7227"\w* botín. Abner ya \w no|strong="H3588"\w* \w estaba|strong="H2009"\w* \w con|strong="H5973"\w* \w David|strong="H1732"\w* \w en|strong="H5973"\w* \w Hebrón|strong="H2275"\w*, \w porque|strong="H3588"\w* \w David|strong="H1732"\w* lo \w había|strong="H3588"\w* despedido \w y|strong="H3588"\w* \w él|strong="H5973"\w* se \w había|strong="H3588"\w* \w ido|strong="H3212"\w* \w en|strong="H5973"\w* \w paz|strong="H7965"\w*.  
\v 23 Cuando \w llegó|strong="H3212"\w* \w Joab|strong="H3097"\w* con \w todo|strong="H3605"\w* su \w ejército|strong="H6635"\w*, le informaron: “Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w* \w vino|strong="H3212"\w* \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w*, y \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w lo|strong="H3605"\w* \w dejó|strong="H7971"\w* irse \w en|strong="H3212"\w* \w paz|strong="H7965"\w*”.   
\p
\v 24 Entonces \w Joab|strong="H3097"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* hablar con \w el|strong="H6213"\w* \w rey|strong="H4428"\w* y le dijo: ¿Pero \w qué|strong="H4100"\w* ha \w hecho|strong="H6213"\w* usted? ¡Abner \w vino|strong="H3212"\w* \w a|strong="H3068"\w* verlo! ¿\w Cómo|strong="H4100"\w* \w es|strong="H2088"\w* posible \w que|strong="H4100"\w* \w lo|strong="H4100"\w* haya dejado irse \w así|strong="H2088"\w* de fácil?  
\v 25 Usted \w conoce|strong="H3045"\w* \w bien|strong="H3588"\w* \w a|strong="H3068"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Ner|strong="H5369"\w*. ¡Vino \w a|strong="H3068"\w* engañarlo, \w a|strong="H3068"\w* espiar \w todos|strong="H3605"\w* sus movimientos \w y|strong="H3588"\w* \w a|strong="H3068"\w* enterarse \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* usted \w hace|strong="H6213"\w*!   
\p
\v 26 \w En|strong="H5973"\w* cuanto \w Joab|strong="H3097"\w* \w salió|strong="H3318"\w* \w de|strong="H5973"\w* hablar \w con|strong="H5973"\w* \w David|strong="H1732"\w*, \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w tras|strong="H5973"\w* Abner \w sin|strong="H3808"\w* \w que|strong="H3808"\w* \w David|strong="H1732"\w* \w lo|strong="H3808"\w* supiera, y \w lo|strong="H3808"\w* hicieron \w volver|strong="H7725"\w* desde \w el|strong="H5973"\w* pozo \w de|strong="H5973"\w* Sira.  
\v 27 Cuando Abner regresó \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w*, \w Joab|strong="H3097"\w* lo llevó aparte, \w hacia|strong="H8033"\w* un lado \w de|strong="H1818"\w* la \w puerta|strong="H8179"\w* \w de|strong="H1818"\w* la ciudad, como para \w hablar|strong="H1696"\w* con él \w en|strong="H8432"\w* privado. \w Allí|strong="H8033"\w* lo apuñaló \w en|strong="H8432"\w* el vientre y lo \w mató|strong="H5221"\w*, para vengar la \w muerte|strong="H4191"\w* \w de|strong="H1818"\w* su hermano \w Asael|strong="H6214"\w*.  
\v 28 Cuando \w David|strong="H1732"\w* \w se|strong="H3651"\w* enteró, declaró: “Ante \w el|strong="H5973"\w* \w Señor|strong="H3068"\w*, mi \w reino|strong="H4467"\w* \w y|strong="H5355"\w* yo somos inocentes \w por|strong="H5703"\w* \w siempre|strong="H5769"\w* \w de|strong="H5973"\w* la muerte \w de|strong="H5973"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Ner|strong="H5369"\w*.  
\v 29 ¡\w Que|strong="H5921"\w* \w la|strong="H5921"\w* culpa recaiga \w sobre|strong="H5921"\w* \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* su \w familia|strong="H1004"\w*! ¡\w Que|strong="H5921"\w* nunca \w falte|strong="H3772"\w* \w en|strong="H5921"\w* su descendencia \w quien|strong="H3605"\w* sufra \w de|strong="H5921"\w* flujos, \w o|strong="H3068"\w* \w de|strong="H5921"\w* lepra, \w o|strong="H3068"\w* \w que|strong="H5921"\w* sea un inválido, \w o|strong="H3068"\w* \w que|strong="H5921"\w* muera \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, \w o|strong="H3068"\w* \w que|strong="H5921"\w* pase hambre!”.  
\v 30 \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* su hermano Abisai \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* Abner \w porque|strong="H5921"\w* \w él|strong="H5921"\w* había matado \w a|strong="H3068"\w* su hermano \w Asael|strong="H6214"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w* \w de|strong="H5921"\w* \w Gabaón|strong="H1391"\w*.   
\p
\v 31 Entonces \w David|strong="H1732"\w* les ordenó \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H5971"\w* \w estaban|strong="H5971"\w* con \w él|strong="H3605"\w*: “Rasguen su ropa, vístanse \w de|strong="H6440"\w* luto y lloren \w por|strong="H6440"\w* Abner”. \w El|strong="H3605"\w* propio \w rey|strong="H4428"\w* \w David|strong="H1732"\w* marchó detrás \w de|strong="H6440"\w* \w la|strong="H3605"\w* camilla fúnebre.  
\v 32 Enterraron \w a|strong="H3068"\w* Abner \w en|strong="H6912"\w* \w Hebrón|strong="H2275"\w*. \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w lloró|strong="H1058"\w* \w a|strong="H3068"\w* gritos ante \w la|strong="H3605"\w* tumba \w de|strong="H5971"\w* Abner, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w lloró|strong="H1058"\w* con \w él|strong="H3605"\w*.  
\v 33 El \w rey|strong="H4428"\w* compuso este lamento \w por|strong="H4428"\w* Abner: “¿Tenía que \w morir|strong="H4191"\w* Abner como muere un \w insensato|strong="H5036"\w*?  
\v 34 \w No|strong="H3808"\w* tenías \w las|strong="H5921"\w* \w manos|strong="H3027"\w* atadas \w ni|strong="H3808"\w* \w los|strong="H1121"\w* \w pies|strong="H7272"\w* encadenados. \w Caíste|strong="H5307"\w* \w como|strong="H5921"\w* \w quien|strong="H3605"\w* \w cae|strong="H5307"\w* \w a|strong="H3068"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* criminales”. \w Y|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* llorar \w por|strong="H5921"\w* \w él|strong="H5921"\w*.   
\p
\v 35 Luego \w todos|strong="H3605"\w* \w trataron|strong="H6213"\w* \w de|strong="H3588"\w* convencer \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* comiera \w algo|strong="H3972"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* terminara \w el|strong="H3588"\w* \w día|strong="H3117"\w*, \w pero|strong="H3588"\w* \w David|strong="H1732"\w* \w juró|strong="H7650"\w*: “¡\w Que|strong="H3588"\w* Dios \w me|strong="H3588"\w* castigue duramente \w si|strong="H3588"\w* pruebo bocado \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H5971"\w* ponga \w el|strong="H3588"\w* \w sol|strong="H8121"\w*!”.   
\p
\v 36 \w Al|strong="H4428"\w* ver \w esto|strong="H6213"\w*, \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* quedó satisfecho, pues \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w hacía|strong="H6213"\w* les \w parecía|strong="H5869"\w* \w bien|strong="H2896"\w*.  
\v 37 \w Así|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* comprendieron \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* tenido \w nada|strong="H3808"\w* \w que|strong="H3588"\w* ver \w con|strong="H3588"\w* \w la|strong="H1931"\w* \w muerte|strong="H4191"\w* \w de|strong="H3588"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Ner|strong="H5369"\w*.  
\v 38 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* les dijo \w a|strong="H3068"\w* sus oficiales: ¿\w No|strong="H3808"\w* \w se|strong="H3045"\w* dan cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* \w ha|strong="H3808"\w* \w caído|strong="H5307"\w* \w en|strong="H3588"\w* \w Israel|strong="H3478"\w* un \w gran|strong="H1419"\w* \w príncipe|strong="H8269"\w*?  
\v 39 Aunque soy \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w ungido|strong="H4886"\w*, \w hoy|strong="H3117"\w* \w me|strong="H4480"\w* siento débil ante estos \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* Sarvia, \w que|strong="H4480"\w* son tan violentos. ¡\w Que|strong="H4480"\w* \w el|strong="H1121"\w* \w Señor|strong="H3068"\w* le \w dé|strong="H4480"\w* su merecido \w al|strong="H4480"\w* \w que|strong="H4480"\w* \w hace|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w*!”.   
\c 4  
\p
\v 1 \w Cuando|strong="H3588"\w* Isboset, \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Saúl|strong="H7586"\w*, \w supo|strong="H8085"\w* \w que|strong="H3588"\w* Abner \w había|strong="H3588"\w* \w muerto|strong="H4191"\w* \w en|strong="H3588"\w* \w Hebrón|strong="H2275"\w*, perdió completamente \w el|strong="H3588"\w* ánimo, \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* pueblo \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* se llenó \w de|strong="H3588"\w* miedo.  
\v 2 \w El|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w tenía|strong="H1961"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* servicio \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w hombres|strong="H1121"\w* \w que|strong="H3588"\w* \w eran|strong="H1961"\w* \w jefes|strong="H8269"\w* \w de|strong="H5921"\w* bandas \w de|strong="H5921"\w* asalto; uno \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* \w Baana|strong="H1196"\w* \w y|strong="H1571"\w* \w el|strong="H5921"\w* \w otro|strong="H8145"\w* Recab. \w Ambos|strong="H8147"\w* \w eran|strong="H1961"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Rimón \w el|strong="H5921"\w* beerotita, \w de|strong="H5921"\w* \w la|strong="H5921"\w* tribu \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w* (\w pues|strong="H3588"\w* \w a|strong="H3068"\w* Beerot \w se|strong="H1961"\w* \w le|strong="H5921"\w* considera parte \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*,  
\v 3 \w aunque|strong="H5704"\w* \w los|strong="H1961"\w* habitantes \w de|strong="H5704"\w* Beerot \w huyeron|strong="H1272"\w* \w a|strong="H3068"\w* Gitaim \w y|strong="H5704"\w* han vivido \w allí|strong="H8033"\w* \w como|strong="H1961"\w* extranjeros \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*).   
\p
\v 4 (\w Por|strong="H5127"\w* cierto, Jonatán \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Saúl|strong="H7586"\w* \w tenía|strong="H1961"\w* un \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* \w era|strong="H1961"\w* inválido \w de|strong="H2568"\w* ambos \w pies|strong="H7272"\w*. \w Tenía|strong="H1961"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* llegó \w de|strong="H2568"\w* \w Jezreel|strong="H3157"\w* la noticia \w de|strong="H2568"\w* la muerte \w de|strong="H2568"\w* \w Saúl|strong="H7586"\w* y \w de|strong="H2568"\w* Jonatán. Su nodriza lo \w tomó|strong="H5375"\w* \w para|strong="H1961"\w* huir, pero con la prisa \w se|strong="H1961"\w* le \w cayó|strong="H5307"\w* y \w el|strong="H5307"\w* niño \w quedó|strong="H1961"\w* cojo. Su \w nombre|strong="H8034"\w* \w era|strong="H1961"\w* Mefiboset).   
\p
\v 5 Recab y \w Baana|strong="H1196"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Rimón \w el|strong="H1931"\w* beerotita, \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Isboset y llegaron al mediodía, \w cuando|strong="H3117"\w* \w él|strong="H1931"\w* \w estaba|strong="H7901"\w* \w durmiendo|strong="H7901"\w* \w la|strong="H1931"\w* siesta.  
\v 6 Entraron \w hasta|strong="H5704"\w* el centro \w de|strong="H5704"\w* la \w casa|strong="H1004"\w* \w con|strong="H5704"\w* el pretexto \w de|strong="H5704"\w* buscar \w trigo|strong="H2406"\w*, \w y|strong="H5704"\w* allí \w lo|strong="H2007"\w* apuñalaron \w en|strong="H5704"\w* el vientre. \w Después|strong="H5704"\w* \w de|strong="H5704"\w* esto, Recab \w y|strong="H5704"\w* su hermano \w Baana|strong="H1196"\w* \w escaparon|strong="H4422"\w*.  
\v 7 Cuando \w entraron|strong="H3212"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w*, Isboset \w estaba|strong="H7901"\w* \w acostado|strong="H7901"\w* \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w cama|strong="H4904"\w*, \w dentro|strong="H5921"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* dormitorio; allí \w lo|strong="H1931"\w* atacaron \w y|strong="H5921"\w* \w lo|strong="H1931"\w* \w mataron|strong="H5221"\w*. \w Luego|strong="H1931"\w* \w le|strong="H1931"\w* cortaron \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w*, llevándosela \w con|strong="H5921"\w* \w ellos|strong="H1931"\w*, \w caminaron|strong="H3212"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w noche|strong="H3915"\w* \w por|strong="H5921"\w* \w la|strong="H1931"\w* ruta \w del|strong="H5921"\w* valle \w del|strong="H5921"\w* Jordán.  
\v 8 \w Al|strong="H4428"\w* llegar \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w*, le entregaron la \w cabeza|strong="H7218"\w* \w de|strong="H1121"\w* Isboset \w a|strong="H3068"\w* \w David|strong="H1732"\w* y le dijeron \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: ¡\w Aquí|strong="H2009"\w* tiene la \w cabeza|strong="H7218"\w* \w de|strong="H1121"\w* Isboset, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*, \w ese|strong="H2088"\w* enemigo \w que|strong="H3117"\w* quería matarlo! \w Hoy|strong="H3117"\w* \w el|strong="H1121"\w* \w Señor|strong="H3068"\w* ha vengado \w a|strong="H3068"\w* su Majestad frente \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y su \w descendencia|strong="H2233"\w*.   
\p
\v 9 Pero \w David|strong="H1732"\w* les \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* Recab y \w a|strong="H3068"\w* su hermano \w Baana|strong="H1196"\w*: Tan cierto como \w que|strong="H1121"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* \w vive|strong="H2416"\w*, \w quien|strong="H3605"\w* me ha librado \w de|strong="H1121"\w* \w todos|strong="H3605"\w* mis problemas,  
\v 10 \w que|strong="H3588"\w* \w si|strong="H3588"\w* al hombre \w que|strong="H3588"\w* \w me|strong="H3588"\w* trajo \w la|strong="H1931"\w* noticia \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w había|strong="H1961"\w* \w muerto|strong="H4191"\w* \w lo|strong="H1931"\w* agarré \w y|strong="H3588"\w* \w lo|strong="H1931"\w* \w maté|strong="H2026"\w* \w en|strong="H3588"\w* \w Siclag|strong="H6860"\w* \w aunque|strong="H3588"\w* \w él|strong="H1931"\w* creía \w que|strong="H3588"\w* \w me|strong="H3588"\w* \w traía|strong="H5869"\w* buenas noticias \w y|strong="H3588"\w* esperaba una recompensa,  
\v 11 ¡\w con|strong="H5921"\w* mucha \w más|strong="H3588"\w* razón \w lo|strong="H3808"\w* haré \w ahora|strong="H6258"\w* \w con|strong="H5921"\w* unos malvados \w que|strong="H3588"\w* \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* un hombre \w inocente|strong="H1818"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia \w casa|strong="H1004"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia \w cama|strong="H4904"\w*! ¿Acaso \w no|strong="H3808"\w* debo pedirles cuentas \w por|strong="H5921"\w* \w su|strong="H3588"\w* \w sangre|strong="H1818"\w* \w y|strong="H3588"\w* eliminarlos \w de|strong="H4480"\w* este mundo?  
\v 12 Entonces \w David|strong="H1732"\w* dio órdenes \w a|strong="H3068"\w* sus soldados, \w y|strong="H5921"\w* \w ellos|strong="H3027"\w* \w los|strong="H5921"\w* \w mataron|strong="H2026"\w*. \w Les|strong="H5921"\w* cortaron \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w pies|strong="H7272"\w*, \w y|strong="H5921"\w* \w colgaron|strong="H8518"\w* sus cuerpos \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w estanque|strong="H1295"\w* \w de|strong="H5921"\w* \w Hebrón|strong="H2275"\w*. Luego \w tomaron|strong="H3947"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* Isboset \w y|strong="H5921"\w* \w la|strong="H5921"\w* enterraron \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w sepulcro|strong="H6913"\w* \w de|strong="H5921"\w* Abner, allí mismo \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w*.   
\c 5  
\p
\v 1 \w Todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w* \w fueron|strong="H1732"\w* \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w* para hablar con \w David|strong="H1732"\w* y le dijeron: “\w Nosotros|strong="H3605"\w* somos de tu misma \w carne|strong="H1320"\w* y \w hueso|strong="H6106"\w*.  
\v 2 \w Ya|strong="H3068"\w* \w desde|strong="H5921"\w* antes, \w cuando|strong="H1571"\w* \w Saúl|strong="H7586"\w* todavía \w era|strong="H1961"\w* nuestro \w rey|strong="H4428"\w*, \w eras|strong="H1961"\w* tú quien dirigía \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* sus batallas. \w Además|strong="H5921"\w*, \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w te|strong="H5921"\w* prometió: “Tú \w serás|strong="H1961"\w* \w el|strong="H5921"\w* \w pastor|strong="H7462"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*; tú \w serás|strong="H1961"\w* su nuevo guía””.  
\v 3 Así \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w se|strong="H5921"\w* reunieron \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w*. Allí \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w* \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w ungieron|strong="H4886"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 4 \w David|strong="H1732"\w* tenía \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y su \w reinado|strong="H4427"\w* duró cuarenta \w años|strong="H8141"\w*.  
\v 5 \w En|strong="H5921"\w* \w Hebrón|strong="H2275"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w y|strong="H5921"\w* \w seis|strong="H8337"\w* \w meses|strong="H2320"\w*, \w y|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w Judá|strong="H3063"\w* durante \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w años|strong="H8141"\w*.   
\p
\v 6 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* sus soldados marcharon \w hacia|strong="H2008"\w* Jerusalén \w para|strong="H3588"\w* atacar \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w jebuseos|strong="H2983"\w* \w que|strong="H3588"\w* \w vivían|strong="H3427"\w* allí. \w Los|strong="H3427"\w* \w jebuseos|strong="H2983"\w*, pensando \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w no|strong="H3808"\w* podría entrar, le mandaron \w a|strong="H3068"\w* decir: “\w Ni|strong="H3808"\w* siquiera lograrás entrar \w aquí|strong="H2008"\w*; \w para|strong="H3588"\w* detenerte nos bastan \w los|strong="H3427"\w* \w ciegos|strong="H5787"\w* \w y|strong="H3588"\w* \w los|strong="H3427"\w* cojos”.  
\v 7 Pero \w David|strong="H1732"\w* logró capturar \w la|strong="H1931"\w* fortaleza de \w Sión|strong="H6726"\w*, \w que|strong="H1931"\w* ahora \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w Ciudad|strong="H5892"\w* de \w David|strong="H1732"\w*.  
\v 8 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w David|strong="H1732"\w* dijo: “\w Todo|strong="H3605"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* quiera derrotar \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w jebuseos|strong="H2983"\w*, \w que|strong="H1931"\w* suba \w por|strong="H5921"\w* \w el|strong="H1931"\w* canal \w de|strong="H5921"\w* agua \w y|strong="H5921"\w* ataque \w a|strong="H3068"\w* esos “cojos \w y|strong="H5921"\w* \w ciegos|strong="H5787"\w*” \w que|strong="H1931"\w* \w tanto|strong="H3651"\w* \w aborrezco|strong="H8130"\w*”. \w De|strong="H5921"\w* ahí viene \w el|strong="H1931"\w* dicho: “\w Ni|strong="H3808"\w* \w los|strong="H5921"\w* \w ciegos|strong="H5787"\w* \w ni|strong="H3808"\w* \w los|strong="H5921"\w* cojos entrarán \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w*”.   
\p
\v 9 \w David|strong="H1732"\w* \w se|strong="H4480"\w* instaló \w en|strong="H4480"\w* la fortaleza y la \w llamó|strong="H7121"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H4480"\w* \w David|strong="H1732"\w*. Luego construyó defensas \w alrededor|strong="H5439"\w*, \w desde|strong="H4480"\w* \w el|strong="H3427"\w* terraplén \w de|strong="H4480"\w* \w Millo|strong="H4407"\w* \w hacia|strong="H4480"\w* \w adentro|strong="H1004"\w*.  
\v 10 \w David|strong="H1732"\w* se hacía cada vez más poderoso, \w porque|strong="H1732"\w* \w el|strong="H5973"\w* \w Señor|strong="H3068"\w*, \w el|strong="H5973"\w* \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w Ejércitos|strong="H6635"\w*, estaba \w con|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 11 El \w rey|strong="H4428"\w* \w Hiram|strong="H2438"\w* de \w Tiro|strong="H6865"\w* \w envió|strong="H7971"\w* una embajada \w a|strong="H3068"\w* \w David|strong="H1732"\w*, junto con \w madera|strong="H6086"\w* de cedro, \w carpinteros|strong="H2796"\w* y \w albañiles|strong="H2796"\w*, para construirle un palacio.  
\v 12 \w David|strong="H1732"\w* \w se|strong="H3045"\w* dio cuenta \w entonces|strong="H3588"\w* \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w lo|strong="H5921"\w* \w había|strong="H3588"\w* \w confirmado|strong="H3559"\w* \w como|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* bendecido \w su|strong="H3588"\w* \w reino|strong="H4467"\w* \w por|strong="H5921"\w* amor \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.   
\p
\v 13 Después \w de|strong="H5750"\w* mudarse \w de|strong="H5750"\w* \w Hebrón|strong="H2275"\w* \w a|strong="H3068"\w* Jerusalén, \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* \w más|strong="H5750"\w* \w concubinas|strong="H6370"\w* y esposas, y tuvo \w más|strong="H5750"\w* \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 14 Estos son los \w nombres|strong="H8034"\w* de los hijos que le nacieron en Jerusalén: \w Samúa|strong="H8051"\w*, \w Sobab|strong="H7727"\w*, Natán, \w Salomón|strong="H8010"\w*,  
\v 15 \w Ibhar|strong="H2984"\w*, Elisúa, Nefeg, Jafía,  
\v 16 Elisama, Eliada y Elifelet.   
\p
\v 17 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* supieron \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* sido \w ungido|strong="H4886"\w* \w como|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, movilizaron \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w su|strong="H3588"\w* ejército \w para|strong="H5921"\w* capturarlo. \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* enteró \w y|strong="H3588"\w* \w se|strong="H5921"\w* refugió \w en|strong="H5921"\w* \w la|strong="H5921"\w* fortaleza.  
\v 18 Los \w filisteos|strong="H6430"\w* llegaron y se desplegaron por el \w valle|strong="H6010"\w* de Refaim.  
\v 19 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* \w consultó|strong="H7592"\w* al \w Señor|strong="H3068"\w*: “¿Debo atacar \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w*? ¿\w Me|strong="H3588"\w* \w darás|strong="H5414"\w* \w la|strong="H3588"\w* victoria sobre \w ellos|strong="H3027"\w*?”. \w El|strong="H3588"\w* \w Señor|strong="H3068"\w* le respondió: “Atácalos, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w daré|strong="H5414"\w* \w la|strong="H3588"\w* victoria sobre \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w*”.   
\p
\v 20 \w David|strong="H1732"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* Baal-perazim \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w los|strong="H5921"\w* derrotó. \w Entonces|strong="H3651"\w* exclamó: “\w El|strong="H1931"\w* \w Señor|strong="H3068"\w* ha abierto una brecha \w entre|strong="H5921"\w* mis enemigos, \w como|strong="H5921"\w* cuando \w se|strong="H1931"\w* rompe una represa”. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* Baal-perazim.  
\v 21 Los filisteos abandonaron \w allí|strong="H8033"\w* sus \w ídolos|strong="H6091"\w*, y \w David|strong="H1732"\w* y sus hombres se los \w llevaron|strong="H5375"\w*.   
\p
\v 22 Pero los \w filisteos|strong="H6430"\w* volvieron al ataque y se desplegaron \w de|strong="H5750"\w* nuevo \w en|strong="H5750"\w* el \w valle|strong="H6010"\w* \w de|strong="H5750"\w* Refaim.  
\v 23 \w David|strong="H1732"\w* volvió \w a|strong="H3068"\w* consultar al \w Señor|strong="H3068"\w*, y esta vez \w Dios|strong="H3068"\w* le dijo: “\w No|strong="H3808"\w* los ataques de frente. Rodéalos y dales alcance frente \w a|strong="H3068"\w* los árboles de bálsamo.  
\v 24 \w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w oigas|strong="H8085"\w* un \w ruido|strong="H6963"\w* \w como|strong="H3588"\w* \w de|strong="H3588"\w* pasos \w en|strong="H3588"\w* las copas \w de|strong="H3588"\w* \w los|strong="H1961"\w* árboles, lánzate al ataque, \w porque|strong="H3588"\w* eso significa \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w va|strong="H3068"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ti \w para|strong="H3588"\w* derrotar al \w ejército|strong="H4264"\w* \w filisteo|strong="H6430"\w*”.   
\p
\v 25 \w David|strong="H1732"\w* \w hizo|strong="H6213"\w* exactamente \w lo|strong="H6213"\w* \w que|strong="H5704"\w* \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* le \w ordenó|strong="H6680"\w*, \w y|strong="H5704"\w* derrotó \w a|strong="H3068"\w* los \w filisteos|strong="H6430"\w* \w desde|strong="H5704"\w* Geba \w hasta|strong="H5704"\w* \w Gezer|strong="H1507"\w*.   
\c 6  
\p
\v 1 \w David|strong="H1732"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* reunir \w a|strong="H3068"\w* \w los|strong="H3605"\w* mejores soldados \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*, \w treinta|strong="H7970"\w* mil \w en|strong="H5750"\w* total.  
\v 2 \w Luego|strong="H5927"\w* \w partió|strong="H3212"\w* \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su acompañamiento \w desde|strong="H5921"\w* Baala \w de|strong="H5921"\w* Judá \w para|strong="H5921"\w* traer \w de|strong="H5921"\w* \w allá|strong="H8033"\w* \w el|strong="H5921"\w* arca \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*, \w la|strong="H5921"\w* cual es \w llamada|strong="H8034"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w Nombre|strong="H8034"\w*, \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w que|strong="H5921"\w* tiene su trono \w sobre|strong="H5921"\w* \w los|strong="H3427"\w* \w querubines|strong="H3742"\w*.  
\v 3 Pusieron \w el|strong="H1121"\w* arca \w de|strong="H1121"\w* Dios en una carreta \w nueva|strong="H2319"\w* y la sacaron \w de|strong="H1121"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Abinadab, \w que|strong="H1121"\w* \w estaba|strong="H1004"\w* en la colina. Uza y Ahío, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Abinadab, iban guiando la carreta.  
\v 4 \w Así|strong="H5973"\w* sacaron \w el|strong="H5973"\w* arca \w de|strong="H6440"\w* Dios \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* Abinadab \w en|strong="H5973"\w* la colina; Ahío caminaba \w delante|strong="H6440"\w* \w del|strong="H5973"\w* arca.  
\v 5 \w Mientras|strong="H3605"\w* tanto, \w David|strong="H1732"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas hacían fiesta \w ante|strong="H6440"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w*, tocando \w toda|strong="H3605"\w* clase \w de|strong="H6440"\w* instrumentos \w de|strong="H6440"\w* \w madera|strong="H6086"\w* \w de|strong="H6440"\w* ciprés: \w arpas|strong="H3658"\w*, liras, panderos, castañuelas y platillos.   
\p
\v 6 \w Cuando|strong="H3588"\w* llegaron \w al|strong="H5704"\w* lugar donde se trilla \w el|strong="H3588"\w* trigo \w de|strong="H3588"\w* Nacón, \w los|strong="H3588"\w* \w bueyes|strong="H1241"\w* tropezaron; \w entonces|strong="H3588"\w* Uza \w extendió|strong="H7971"\w* \w su|strong="H3588"\w* mano \w y|strong="H3588"\w* sostuvo \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* Dios.  
\v 7 Pero \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w se|strong="H5921"\w* enfureció \w contra|strong="H5921"\w* Uza \w por|strong="H5921"\w* ese atrevimiento \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w hirió|strong="H5221"\w* \w de|strong="H5921"\w* \w muerte|strong="H4191"\w* \w allí|strong="H8033"\w* mismo. \w Así|strong="H5973"\w* \w que|strong="H5921"\w* Uza \w murió|strong="H4191"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* arca \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*.  
\v 8 \w David|strong="H1732"\w* \w se|strong="H1931"\w* disgustó mucho \w porque|strong="H5921"\w* \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* había castigado \w a|strong="H3068"\w* Uza \w con|strong="H5921"\w* tanta dureza, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w eso|strong="H1931"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* Fares-uza, \w nombre|strong="H7121"\w* \w que|strong="H1931"\w* conserva \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 9 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w David|strong="H1732"\w* \w tuvo|strong="H3372"\w* mucho \w miedo|strong="H3372"\w* del \w Señor|strong="H3068"\w* y \w se|strong="H1931"\w* preguntó: “¿\w Cómo|strong="H1931"\w* voy \w a|strong="H3068"\w* llevar \w el|strong="H1931"\w* arca del \w Señor|strong="H3068"\w* \w a|strong="H3068"\w* mi casa?”.  
