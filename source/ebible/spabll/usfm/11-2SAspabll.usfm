\v 39 \w Con|strong="H5921"\w* \w el|strong="H5921"\w* tiempo, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* dejó \w de|strong="H5921"\w* estar \w de|strong="H5921"\w* luto \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w muerte|strong="H4191"\w* \w de|strong="H5921"\w* Amnón \w y|strong="H3588"\w* empezó \w a|strong="H3068"\w* sentir grandes deseos \w de|strong="H5921"\w* volver \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Absalón.   
\c 14  
\p
\v 1 \w Joab|strong="H3097"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Sarvia \w se|strong="H3045"\w* dio cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* extrañaba mucho \w a|strong="H3068"\w* Absalón.  
\v 2 \w Así|strong="H2088"\w* \w que|strong="H4994"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* traer \w de|strong="H5921"\w* Tecoa \w a|strong="H3068"\w* una mujer muy \w astuta|strong="H2450"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo: “\w Por|strong="H5921"\w* favor, fíngete \w que|strong="H4994"\w* \w estás|strong="H2088"\w* \w de|strong="H5921"\w* luto. Ponte ropa \w de|strong="H5921"\w* duelo, \w no|strong="H1961"\w* \w te|strong="H5921"\w* perfumes \w con|strong="H5921"\w* aceites \w y|strong="H5921"\w* actúa \w como|strong="H1961"\w* una mujer \w que|strong="H4994"\w* ha llorado \w por|strong="H5921"\w* un \w muerto|strong="H4191"\w* durante \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w*.  
\v 3 Preséntate ante el \w rey|strong="H4428"\w* y háblale \w de|strong="H1697"\w* \w esta|strong="H2088"\w* \w manera|strong="H1697"\w*”. Entonces \w Joab|strong="H3097"\w* le indicó \w lo|strong="H1697"\w* \w que|strong="H1697"\w* debía decir.   
\p
\v 4 Cuando \w la|strong="H5921"\w* mujer \w de|strong="H5921"\w* \w Tecoa|strong="H8621"\w* habló \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w se|strong="H5921"\w* inclinó rostro \w en|strong="H5921"\w* tierra \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* respeto \w y|strong="H5921"\w* exclamó: ¡Ayúdeme, su Majestad!   
\p
\v 5 ¿\w Qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* te pasa? le preguntó el \w rey|strong="H4428"\w*. Ella respondió: ¡Ay de mí! Soy viuda; mi esposo \w murió|strong="H4191"\w*.  
\v 6 Esta servidora suya tenía \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w que|strong="H1121"\w* se pelearon \w en|strong="H5221"\w* \w el|strong="H1121"\w* \w campo|strong="H7704"\w*. Como no había nadie \w que|strong="H1121"\w* \w los|strong="H1121"\w* separara, uno \w hirió|strong="H5221"\w* al otro y lo \w mató|strong="H5221"\w*.  
\v 7 \w Y|strong="H3068"\w* \w ahora|strong="H2009"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w familia|strong="H4940"\w* \w se|strong="H5921"\w* \w ha|strong="H3423"\w* echado \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w esta|strong="H6965"\w* servidora suya. Dicen: “\w Entrega|strong="H5414"\w* \w al|strong="H5921"\w* \w que|strong="H5921"\w* \w mató|strong="H2026"\w* \w a|strong="H3068"\w* su hermano \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* \w matemos|strong="H2026"\w*. Debe pagar \w con|strong="H5921"\w* su \w vida|strong="H5315"\w* \w la|strong="H5921"\w* \w vida|strong="H5315"\w* \w de|strong="H5921"\w* su hermano, \w aunque|strong="H1571"\w* \w así|strong="H1571"\w* eliminemos \w al|strong="H5921"\w* \w heredero|strong="H3423"\w*”. ¡Quieren apagar \w la|strong="H5921"\w* última brasa \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w queda|strong="H7604"\w*! ¡Quieren \w dejar|strong="H5414"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* esposo sin \w nombre|strong="H8034"\w* \w ni|strong="H1571"\w* descendencia \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra!   
\p
\v 8 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w la|strong="H5921"\w* mujer: Regresa \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w*; \w yo|strong="H6680"\w* \w me|strong="H5921"\w* encargaré \w de|strong="H5921"\w* dar \w las|strong="H5921"\w* órdenes necesarias \w en|strong="H5921"\w* tu favor.   
\p
\v 9 Pero \w la|strong="H5921"\w* mujer \w de|strong="H5921"\w* \w Tecoa|strong="H8621"\w* añadió: Su Majestad, \w mi|strong="H5921"\w* señor \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w que|strong="H5921"\w* \w la|strong="H5921"\w* culpa recaiga \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w familia|strong="H1004"\w*; \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* su \w trono|strong="H3678"\w* queden \w libres|strong="H5355"\w* \w de|strong="H5921"\w* \w toda|strong="H5921"\w* responsabilidad.   
\p
\v 10 El \w rey|strong="H4428"\w* respondió: \w Si|strong="H3808"\w* alguien te amenaza, tráelo ante mí y \w no|strong="H3808"\w* \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* molestarte.   
\p
\v 11 Ella insistió: Le \w ruego|strong="H4994"\w* \w a|strong="H3068"\w* su Majestad \w que|strong="H3808"\w* invoque \w al|strong="H4428"\w* \w Señor|strong="H3068"\w* su \w Dios|strong="H3068"\w*, para \w que|strong="H3808"\w* \w el|strong="H5307"\w* \w pariente|strong="H1350"\w* encargado \w de|strong="H1121"\w* vengar la \w sangre|strong="H1818"\w* \w no|strong="H3808"\w* aumente la desgracia destruyendo \w a|strong="H3068"\w* \w mi|strong="H4994"\w* \w hijo|strong="H1121"\w*. \w David|strong="H4428"\w* respondió: Tan \w cierto|strong="H3808"\w* como \w que|strong="H3808"\w* \w el|strong="H5307"\w* \w Señor|strong="H3068"\w* \w vive|strong="H2416"\w*, \w que|strong="H3808"\w* \w ni|strong="H3808"\w* un solo pelo \w de|strong="H1121"\w* tu \w hijo|strong="H1121"\w* \w caerá|strong="H5307"\w* \w al|strong="H4428"\w* suelo.   
\p
\v 12 Entonces la mujer pidió: Permita usted \w que|strong="H4994"\w* esta servidora suya le \w diga|strong="H1696"\w* \w algo|strong="H1697"\w* más \w a|strong="H3068"\w* \w mi|strong="H4994"\w* señor el \w rey|strong="H4428"\w*. \w Habla|strong="H1696"\w* \w dijo|strong="H1696"\w* él.   
\p
\v 13 \w La|strong="H5921"\w* mujer \w dijo|strong="H1696"\w*: ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* ha tramado usted \w algo|strong="H1697"\w* semejante \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* Dios? \w Al|strong="H5921"\w* dar usted \w este|strong="H2088"\w* veredicto, \w se|strong="H5921"\w* condena \w a|strong="H3068"\w* \w sí|strong="H5921"\w* mismo, \w pues|strong="H2088"\w* \w no|strong="H5921"\w* deja \w que|strong="H4100"\w* su propio hijo exiliado regrese \w a|strong="H3068"\w* casa.  
\v 14 \w Lo|strong="H3808"\w* \w cierto|strong="H3588"\w* \w es|strong="H3588"\w* \w que|strong="H3588"\w* todos tenemos \w que|strong="H3588"\w* \w morir|strong="H4191"\w*; somos \w como|strong="H3588"\w* \w agua|strong="H4325"\w* derramada \w en|strong="H4480"\w* \w el|strong="H3588"\w* suelo, \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H4480"\w* puede recoger. \w Pero|strong="H3588"\w* Dios \w no|strong="H3808"\w* \w quita|strong="H5375"\w* \w la|strong="H3588"\w* \w vida|strong="H5315"\w* \w así|strong="H3588"\w* \w nada|strong="H3808"\w* \w más|strong="H3588"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* busca \w la|strong="H3588"\w* manera \w de|strong="H4480"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* desterrado \w no|strong="H3808"\w* siga alejado \w de|strong="H4480"\w* \w él|strong="H3588"\w*.  
\v 15 \w Yo|strong="H3588"\w* he venido \w a|strong="H3068"\w* decirle \w esto|strong="H2088"\w* \w a|strong="H3068"\w* \w mi|strong="H4994"\w* señor \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w me|strong="H3588"\w* ha llenado \w de|strong="H3588"\w* \w miedo|strong="H3372"\w*. Pensé: “\w Hablaré|strong="H1696"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w*; \w tal|strong="H2088"\w* vez \w él|strong="H3588"\w* \w haga|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* le pida.  
\v 16 Seguramente \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w me|strong="H3588"\w* \w escuchará|strong="H8085"\w* \w y|strong="H3588"\w* \w me|strong="H3588"\w* \w librará|strong="H5337"\w* \w de|strong="H3588"\w* quien pretende eliminarnos \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* mí \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w herencia|strong="H5159"\w* \w que|strong="H3588"\w* Dios nos dio”.  
\v 17 \w También|strong="H3651"\w* pensé: “Las \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* \w mi|strong="H1961"\w* \w señor|strong="H3068"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w me|strong="H3588"\w* darán tranquilidad, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* Majestad \w es|strong="H1961"\w* \w como|strong="H3588"\w* un \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* sabe distinguir \w entre|strong="H5973"\w* \w el|strong="H5973"\w* \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w el|strong="H5973"\w* \w mal|strong="H7451"\w*”. ¡\w Que|strong="H3588"\w* \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w esté|strong="H1961"\w* \w con|strong="H5973"\w* usted!”.   
\p
\v 18 El \w rey|strong="H4428"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* la mujer: \w Por|strong="H4480"\w* favor, no \w me|strong="H4480"\w* ocultes \w nada|strong="H1697"\w* \w de|strong="H4480"\w* \w lo|strong="H1697"\w* \w que|strong="H4480"\w* \w te|strong="H4480"\w* voy \w a|strong="H3068"\w* preguntar. \w Diga|strong="H1696"\w* usted, \w mi|strong="H6030"\w* señor el \w rey|strong="H4428"\w* \w respondió|strong="H6030"\w* \w ella|strong="H4480"\w*.   
\p
\v 19 \w El|strong="H1931"\w* \w rey|strong="H4428"\w* \w le|strong="H1931"\w* preguntó: ¿\w No|strong="H3588"\w* \w tiene|strong="H1931"\w* \w Joab|strong="H3097"\w* \w algo|strong="H1697"\w* \w que|strong="H3588"\w* ver \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*? \w La|strong="H1931"\w* mujer \w respondió|strong="H6030"\w*: ¡\w Tan|strong="H1931"\w* \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H1931"\w* Majestad \w vive|strong="H2416"\w*, \w que|strong="H3588"\w* \w no|strong="H3588"\w* hay forma \w de|strong="H3588"\w* escapar \w de|strong="H3588"\w* \w la|strong="H1931"\w* verdad \w de|strong="H3588"\w* \w sus|strong="H1931"\w* \w palabras|strong="H1697"\w*! \w Fue|strong="H1931"\w* \w su|strong="H1931"\w* servidor \w Joab|strong="H3097"\w* \w quien|strong="H3605"\w* \w me|strong="H3588"\w* \w ordenó|strong="H6680"\w* venir \w y|strong="H3588"\w* \w me|strong="H3588"\w* \w dijo|strong="H1696"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w tenía|strong="H1931"\w* \w que|strong="H3588"\w* decir.  
\v 20 Su servidor \w Joab|strong="H3097"\w* \w hizo|strong="H6213"\w* \w esto|strong="H2088"\w* para plantear \w el|strong="H3605"\w* \w asunto|strong="H1697"\w* \w de|strong="H6440"\w* \w otra|strong="H6213"\w* \w manera|strong="H1697"\w*. Pero su Majestad \w es|strong="H2088"\w* tan \w sabio|strong="H2450"\w* como un \w ángel|strong="H4397"\w* \w de|strong="H6440"\w* Dios y \w sabe|strong="H3045"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3045"\w* \w pasa|strong="H5437"\w* en \w el|strong="H3605"\w* país.   
\p
\v 21 \w Entonces|strong="H7725"\w* \w el|strong="H6213"\w* \w rey|strong="H4428"\w* le dijo \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*: \w Está|strong="H2088"\w* bien, concedo \w lo|strong="H1697"\w* \w que|strong="H4994"\w* pides. \w Ve|strong="H3212"\w* y \w haz|strong="H6213"\w* \w que|strong="H4994"\w* regrese \w el|strong="H6213"\w* joven Absalón.   
\p
\v 22 \w Joab|strong="H3097"\w* \w se|strong="H3045"\w* inclinó \w rostro|strong="H6440"\w* \w en|strong="H3588"\w* tierra, \w bendijo|strong="H1288"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* dijo: \w Hoy|strong="H3117"\w* \w me|strong="H3588"\w* doy \w cuenta|strong="H1697"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* cuento \w con|strong="H3588"\w* \w el|strong="H3588"\w* favor \w de|strong="H3588"\w* \w su|strong="H3588"\w* Majestad, \w pues|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* ha \w cumplido|strong="H6213"\w* mi petición.   
\p
\v 23 \w Joab|strong="H3097"\w* se \w levantó|strong="H6965"\w*, \w fue|strong="H3212"\w* \w a|strong="H3068"\w* Gesur y trajo \w a|strong="H3068"\w* Absalón \w a|strong="H3068"\w* Jerusalén.  
\v 24 Pero el \w rey|strong="H4428"\w* ordenó: “\w Que|strong="H3808"\w* \w se|strong="H3808"\w* vaya \w a|strong="H3068"\w* su propia \w casa|strong="H1004"\w*; \w no|strong="H3808"\w* quiero verlo”. Así \w que|strong="H3808"\w* Absalón \w se|strong="H3808"\w* retiró \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* y \w no|strong="H3808"\w* \w vio|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 25 \w En|strong="H5704"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* hombre \w más|strong="H5704"\w* admirado \w que|strong="H3808"\w* Absalón \w por|strong="H5704"\w* su belleza; \w desde|strong="H5704"\w* \w la|strong="H3605"\w* planta del \w pie|strong="H7272"\w* \w hasta|strong="H5704"\w* \w la|strong="H3605"\w* cabeza, \w no|strong="H3808"\w* \w tenía|strong="H1961"\w* \w ningún|strong="H3605"\w* defecto.  
\v 26 \w Al|strong="H5921"\w* final \w de|strong="H5921"\w* \w cada|strong="H3117"\w* año \w se|strong="H1961"\w* cortaba \w el|strong="H5921"\w* cabello, \w porque|strong="H3588"\w* \w le|strong="H5921"\w* \w pesaba|strong="H3513"\w* demasiado. \w Según|strong="H5921"\w* \w la|strong="H5921"\w* pesa \w real|strong="H4428"\w*, \w el|strong="H5921"\w* cabello cortado \w pesaba|strong="H3513"\w* unos \w dos|strong="H3117"\w* kilos.\f + \fr 14:26 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 200 siclos equivalen a unos 2 kilogramos o a unas 4,4 libras.\f*  
\v 27 Absalón \w tuvo|strong="H1961"\w* \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* y una \w hija|strong="H1323"\w* \w llamada|strong="H8034"\w* Tamar, \w que|strong="H1931"\w* \w era|strong="H1961"\w* una mujer muy \w hermosa|strong="H3303"\w*.  
\v 28 Absalón \w vivió|strong="H3117"\w* en Jerusalén \w dos|strong="H8141"\w* \w años|strong="H8141"\w* enteros \w sin|strong="H3808"\w* \w ver|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 29 Entonces \w mandó|strong="H7971"\w* llamar \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* para \w que|strong="H3808"\w* intercediera ante el \w rey|strong="H4428"\w*, pero \w Joab|strong="H3097"\w* \w no|strong="H3808"\w* quiso \w ir|strong="H7971"\w*. \w Lo|strong="H3808"\w* llamó \w por|strong="H5750"\w* \w segunda|strong="H8145"\w* vez, y \w Joab|strong="H3097"\w* \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* negarse.  
\v 30 Entonces Absalón les dijo \w a|strong="H3068"\w* sus \w criados|strong="H5650"\w*: “Miren, el campo de \w Joab|strong="H3097"\w* \w está|strong="H8033"\w* \w junto|strong="H3027"\w* al mío y tiene \w cebada|strong="H8184"\w*. ¡\w Vayan|strong="H3212"\w* y préndanle fuego!”. \w Y|strong="H3068"\w* los \w criados|strong="H5650"\w* de Absalón incendiaron el campo.   
\p
\v 31 \w Joab|strong="H3097"\w* fue entonces \w a|strong="H3068"\w* \w casa|strong="H1004"\w* de Absalón y le reclamó: ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* tus \w criados|strong="H5650"\w* le prendieron fuego \w a|strong="H3068"\w* mi campo?   
\p
\v 32 Absalón le respondió: \w Porque|strong="H4100"\w* te mandé llamar y \w no|strong="H6440"\w* viniste. Quería \w que|strong="H4100"\w* fueras \w a|strong="H3068"\w* decirle \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w mi|strong="H2009"\w* parte: “¿\w Para|strong="H6258"\w* \w qué|strong="H4100"\w* regresé \w de|strong="H6440"\w* Gesur? ¡\w Más|strong="H5750"\w* me valía haberme quedado \w allá|strong="H8033"\w*!”. Quiero \w ver|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*, y \w si|strong="H6440"\w* soy culpable \w de|strong="H6440"\w* algo, ¡\w que|strong="H4100"\w* me \w mate|strong="H4191"\w*!   
\p
\v 33 \w Joab|strong="H3097"\w* fue \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* informó. Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Absalón. Este \w se|strong="H5921"\w* presentó \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinó \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra. \w El|strong="H5921"\w* \w rey|strong="H4428"\w*, \w por|strong="H5921"\w* su parte, recibió \w a|strong="H3068"\w* Absalón \w con|strong="H5921"\w* un \w beso|strong="H5401"\w*.   
\c 15  
\p
\v 1 Algún tiempo \w después|strong="H1961"\w*, Absalón \w se|strong="H1961"\w* consiguió un \w carro|strong="H4818"\w* \w de|strong="H6440"\w* guerra con sus \w caballos|strong="H5483"\w*, y \w cincuenta|strong="H2572"\w* hombres \w que|strong="H1961"\w* \w corrían|strong="H7323"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H6213"\w*.  
\v 2 Absalón \w se|strong="H1961"\w* levantaba muy temprano \w y|strong="H5921"\w* \w se|strong="H1961"\w* ponía \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*. \w Cuando|strong="H1961"\w* alguien venía \w con|strong="H5921"\w* algún \w pleito|strong="H7379"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H2088"\w* \w juzgara|strong="H7379"\w*, Absalón \w lo|strong="H2088"\w* \w llamaba|strong="H7121"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* preguntaba: “¿\w De|strong="H5921"\w* \w qué|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w eres|strong="H1961"\w*?”. \w El|strong="H5921"\w* hombre respondía: “Su servidor \w es|strong="H1961"\w* \w de|strong="H5921"\w* \w tal|strong="H2088"\w* \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 3 Entonces Absalón le decía: “\w Mira|strong="H7200"\w*, tus argumentos son \w buenos|strong="H2896"\w* y justos, pero no hay nadie \w de|strong="H1697"\w* parte del \w rey|strong="H4428"\w* \w que|strong="H1697"\w* te \w escuche|strong="H8085"\w*”.  
\v 4 \w Y|strong="H3068"\w* añadía: “¡\w Ojalá|strong="H4310"\w* \w me|strong="H5921"\w* nombraran \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w juez|strong="H8199"\w* \w del|strong="H5921"\w* país! Así, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H4310"\w* tuviera un \w pleito|strong="H7379"\w* \w o|strong="H3068"\w* una \w causa|strong="H7379"\w* vendría \w a|strong="H3068"\w* \w mí|strong="H5921"\w*, \w y|strong="H5921"\w* yo \w le|strong="H5921"\w* haría \w justicia|strong="H4941"\w*”.  
\v 5 Además, \w cuando|strong="H1961"\w* alguien \w se|strong="H1961"\w* acercaba \w para|strong="H1961"\w* inclinarse ante él, Absalón extendía la \w mano|strong="H3027"\w*, lo abrazaba y lo besaba.  
\v 6 \w Esto|strong="H2088"\w* \w lo|strong="H1697"\w* \w hacía|strong="H6213"\w* Absalón con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas \w que|strong="H1697"\w* iban ante \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* pedir \w justicia|strong="H4941"\w*. Fue \w así|strong="H2088"\w* como Absalón se ganó \w el|strong="H3605"\w* \w corazón|strong="H3820"\w* \w de|strong="H1697"\w* \w los|strong="H3605"\w* hombres \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*.   
\p
\v 7 \w Al|strong="H4428"\w* cabo de cuatro \w años|strong="H8141"\w*, Absalón le dijo \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: \w Por|strong="H4428"\w* favor, permítame su Majestad \w ir|strong="H3212"\w* \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w* \w para|strong="H1961"\w* cumplir una \w promesa|strong="H5087"\w* \w que|strong="H4994"\w* le hice \w al|strong="H4428"\w* \w Señor|strong="H3068"\w*.  
\v 8 \w Pues|strong="H3588"\w* \w cuando|strong="H3588"\w* este servidor suyo \w vivía|strong="H3427"\w* \w en|strong="H3588"\w* Gesur, \w en|strong="H3588"\w* Siria, \w hizo|strong="H5088"\w* \w esta|strong="H3427"\w* \w promesa|strong="H5087"\w*: “\w Si|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w me|strong="H3588"\w* permite \w volver|strong="H7725"\w* \w a|strong="H3068"\w* Jerusalén, \w yo|strong="H3588"\w* le ofreceré culto”.   
\p
\v 9 \w Ve|strong="H3212"\w* \w en|strong="H3212"\w* \w paz|strong="H7965"\w* le respondió el \w rey|strong="H4428"\w*.  
\p Entonces Absalón se puso \w en|strong="H3212"\w* camino hacia \w Hebrón|strong="H2275"\w*.  
\v 10 Pero Absalón \w envió|strong="H7971"\w* emisarios por \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w* con este mensaje: “En cuanto \w oigan|strong="H8085"\w* \w el|strong="H3605"\w* toque de \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*, digan: “¡Absalón ya es \w rey|strong="H4427"\w* en \w Hebrón|strong="H2275"\w*!””.   
\p
\v 11 Con Absalón salieron \w de|strong="H1697"\w* Jerusalén \w doscientos|strong="H3967"\w* hombres invitados \w por|strong="H1697"\w* \w él|strong="H3605"\w*. \w Ellos|strong="H3605"\w* \w iban|strong="H1980"\w* con \w toda|strong="H3605"\w* buena fe, \w sin|strong="H3808"\w* sospechar \w nada|strong="H3808"\w* \w de|strong="H1697"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* pasaba.  
\v 12 Mientras \w ofrecía|strong="H2076"\w* \w los|strong="H1961"\w* \w sacrificios|strong="H2077"\w*, Absalón \w mandó|strong="H7971"\w* traer desde Gilo \w a|strong="H3068"\w* Ajitófel, el \w consejero|strong="H3289"\w* \w de|strong="H5971"\w* \w David|strong="H1732"\w*. La conspiración cobró \w mucha|strong="H7227"\w* fuerza, y la \w gente|strong="H5971"\w* \w que|strong="H5971"\w* \w seguía|strong="H1961"\w* \w a|strong="H3068"\w* Absalón aumentaba cada vez \w más|strong="H7227"\w*.  
\v 13 Un \w mensajero|strong="H5046"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* decirle \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “¡\w Los|strong="H1961"\w* israelitas \w se|strong="H1961"\w* han puesto de parte de Absalón!”.   
\p
\v 14 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus oficiales \w que|strong="H3588"\w* \w estaban|strong="H1961"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén: ¡\w Levántense|strong="H6965"\w*! ¡Tenemos \w que|strong="H3588"\w* huir! \w De|strong="H5921"\w* \w lo|strong="H3808"\w* contrario, \w ninguno|strong="H3808"\w* \w de|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w escapará|strong="H6413"\w* \w de|strong="H5921"\w* manos \w de|strong="H5921"\w* Absalón. \w Salgan|strong="H6965"\w* \w de|strong="H5921"\w* prisa, \w no|strong="H3808"\w* \w sea|strong="H1961"\w* \w que|strong="H3588"\w* \w él|strong="H5921"\w* \w nos|strong="H5921"\w* \w alcance|strong="H5381"\w* \w pronto|strong="H4116"\w*, \w nos|strong="H5921"\w* traiga \w la|strong="H5921"\w* desgracia \w y|strong="H3588"\w* pase \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w a|strong="H3068"\w* filo \w de|strong="H5921"\w* \w espada|strong="H2719"\w*.   
\p
\v 15 \w Los|strong="H3605"\w* oficiales del \w rey|strong="H4428"\w* respondieron: \w Nosotros|strong="H3605"\w*, sus servidores, estamos listos para hacer \w lo|strong="H3605"\w* \w que|strong="H3605"\w* su Majestad decida.   
\p
\v 16 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* \w pie|strong="H7272"\w* con \w toda|strong="H3605"\w* su \w familia|strong="H1004"\w*, pero \w dejó|strong="H5800"\w* \w a|strong="H3068"\w* \w diez|strong="H6235"\w* de sus \w concubinas|strong="H6370"\w* para \w que|strong="H3605"\w* cuidaran \w el|strong="H3605"\w* palacio.  
\v 17 Así \w salió|strong="H3318"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* con \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w que|strong="H5971"\w* \w lo|strong="H3605"\w* seguía, y \w se|strong="H5971"\w* detuvieron \w en|strong="H3318"\w* \w la|strong="H3605"\w* última casa.  
\v 18 \w Todos|strong="H3605"\w* sus soldados \w pasaron|strong="H5674"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*; también \w los|strong="H5921"\w* cereteos \w y|strong="H5921"\w* peleteos, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w seiscientos|strong="H8337"\w* geteos \w que|strong="H5921"\w* \w lo|strong="H5921"\w* habían seguido \w desde|strong="H5921"\w* Gat.   
