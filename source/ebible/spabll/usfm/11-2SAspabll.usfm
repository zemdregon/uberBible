\v 38 \w Ira|strong="H5896"\w* el itrita; \w Gareb|strong="H1619"\w* el itrita,  
\v 39 y Urías \w el|strong="H3605"\w* hitita. En total eran \w treinta|strong="H7970"\w* y \w siete|strong="H7651"\w*.   
\c 24  
\p
\v 1 Una vez \w más|strong="H3254"\w* el \w Señor|strong="H3068"\w* se enojó \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*, \w e|strong="H3068"\w* incitó \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w contra|strong="H3478"\w* ellos al decirle: “\w Ve|strong="H3212"\w* y haz un censo de \w Israel|strong="H3478"\w* y de \w Judá|strong="H3063"\w*”.  
\v 2 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* le ordenó \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*, \w el|strong="H3605"\w* \w general|strong="H8269"\w* del \w ejército|strong="H2428"\w*: Vayan \w por|strong="H5704"\w* \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w desde|strong="H5704"\w* \w Dan|strong="H1835"\w* \w hasta|strong="H5704"\w* Berseba, \w y|strong="H5704"\w* realicen un censo \w de|strong="H5704"\w* \w la|strong="H3605"\w* población. Quiero \w saber|strong="H3045"\w* cuánta \w gente|strong="H5971"\w* hay.   
\p
\v 3 Pero \w Joab|strong="H3097"\w* \w le|strong="H3254"\w* respondió \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: ¡\w Que|strong="H4100"\w* \w el|strong="H1992"\w* \w Señor|strong="H3068"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w* multiplique \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w* \w cien|strong="H3967"\w* \w veces|strong="H6471"\w* \w más|strong="H3254"\w* \w de|strong="H5971"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w es|strong="H2088"\w* \w ahora|strong="H6471"\w*, y \w que|strong="H4100"\w* \w su|strong="H1992"\w* Majestad alcance \w a|strong="H3068"\w* verlo! Pero, ¿\w por|strong="H1697"\w* \w qué|strong="H4100"\w* \w quiere|strong="H2654"\w* \w su|strong="H1992"\w* Majestad hacer \w esto|strong="H2088"\w*?   
\p
\v 4 Sin embargo, \w la|strong="H5921"\w* orden \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* impuso \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* comandantes \w del|strong="H5921"\w* \w ejército|strong="H2428"\w*. \w Así|strong="H2388"\w* \w que|strong="H5921"\w* \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* comandantes \w salieron|strong="H3318"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w para|strong="H5921"\w* contar \w a|strong="H3068"\w* \w los|strong="H5921"\w* israelitas.  
\v 5 Cruzaron \w el|strong="H5674"\w* \w Jordán|strong="H3383"\w* y acamparon cerca de \w Aroer|strong="H6177"\w*, al sur de la \w ciudad|strong="H5892"\w* que está \w en|strong="H8432"\w* \w el|strong="H5674"\w* valle de \w Gad|strong="H1410"\w*, y siguieron hacia \w Jazer|strong="H3270"\w*.  
\v 6 Luego pasaron por \w Galaad|strong="H1568"\w* y la región de Tajtim-hodsi, llegaron \w a|strong="H3068"\w* Dan-jaán y rodearon hasta \w Sidón|strong="H6721"\w*.  
\v 7 Siguieron \w hacia|strong="H5045"\w* \w la|strong="H3605"\w* \w fortaleza|strong="H4013"\w* de \w Tiro|strong="H6865"\w* y por \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* de \w los|strong="H3605"\w* \w heveos|strong="H2340"\w* y de \w los|strong="H3605"\w* \w cananeos|strong="H3669"\w*, hasta llegar al sur de \w Judá|strong="H3063"\w*, \w en|strong="H3318"\w* Berseba.  
\v 8 Después de recorrer \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país durante \w nueve|strong="H8672"\w* \w meses|strong="H2320"\w* y \w veinte|strong="H6242"\w* \w días|strong="H3117"\w*, regresaron \w a|strong="H3068"\w* Jerusalén.  
\v 9 \w Joab|strong="H3097"\w* le \w entregó|strong="H5414"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* las cifras del censo: en \w Israel|strong="H3478"\w* \w había|strong="H1961"\w* \w ochocientos|strong="H8083"\w* \w mil|strong="H3967"\w* hombres aptos \w para|strong="H5414"\w* el servicio militar, y en \w Judá|strong="H3063"\w* \w había|strong="H1961"\w* \w quinientos|strong="H2568"\w* \w mil|strong="H3967"\w*.   
\p
\v 10 Después \w de|strong="H3588"\w* haber \w contado|strong="H5608"\w* al \w pueblo|strong="H5971"\w*, \w David|strong="H1732"\w* \w se|strong="H3651"\w* sintió \w muy|strong="H3966"\w* arrepentido \w y|strong="H3588"\w* le dijo al \w Señor|strong="H3068"\w*: “He cometido un \w pecado|strong="H5771"\w* \w muy|strong="H3966"\w* \w grande|strong="H3966"\w*. \w Señor|strong="H3068"\w*, \w te|strong="H3588"\w* \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* perdones \w la|strong="H3588"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* \w tu|strong="H6213"\w* \w siervo|strong="H5650"\w*, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* he portado \w como|strong="H3588"\w* un necio”.   
\p
\v 11 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w cuando|strong="H1961"\w* \w David|strong="H1732"\w* \w se|strong="H1961"\w* \w levantó|strong="H6965"\w*, \w el|strong="H5030"\w* \w Señor|strong="H3068"\w* \w le|strong="H1242"\w* \w habló|strong="H1697"\w* al \w profeta|strong="H5030"\w* \w Gad|strong="H1410"\w*, \w que|strong="H1697"\w* \w era|strong="H1961"\w* \w el|strong="H5030"\w* \w vidente|strong="H2374"\w* \w de|strong="H1697"\w* \w David|strong="H1732"\w*:  
\v 12 “\w Ve|strong="H1980"\w* \w y|strong="H5921"\w* dile \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H5921"\w* \w así|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*: “\w Te|strong="H5921"\w* \w ofrezco|strong="H5190"\w* \w tres|strong="H7969"\w* opciones. Elige una \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w yo|strong="H6213"\w* \w la|strong="H5921"\w* ejecute \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*””.   
\p
\v 13 \w Gad|strong="H1410"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w le|strong="H1931"\w* preguntó: “¿\w Qué|strong="H4100"\w* prefieres: \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w de|strong="H6440"\w* \w hambre|strong="H7458"\w* en tu país, \w o|strong="H3068"\w* huir durante \w tres|strong="H7969"\w* \w meses|strong="H2320"\w* perseguido \w por|strong="H1697"\w* tus \w enemigos|strong="H6862"\w*, \w o|strong="H3068"\w* \w que|strong="H4100"\w* \w haya|strong="H1961"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w de|strong="H6440"\w* peste en tu tierra? Piénselo \w bien|strong="H7200"\w* y dígame \w qué|strong="H4100"\w* \w respuesta|strong="H1697"\w* debo darle al \w que|strong="H4100"\w* me \w envió|strong="H7971"\w*”.   
\p
\v 14 ¡\w Estoy|strong="H6862"\w* \w en|strong="H3588"\w* un grave aprieto! respondió \w David|strong="H1732"\w*. \w Pero|strong="H3588"\w* prefiero \w caer|strong="H5307"\w* \w en|strong="H3588"\w* \w manos|strong="H3027"\w* del \w Señor|strong="H3068"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* misericordia \w es|strong="H3027"\w* \w muy|strong="H3966"\w* \w grande|strong="H7227"\w*, \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* hombres.   
\p
\v 15 \w Entonces|strong="H6256"\w* el \w Señor|strong="H3068"\w* envió una peste \w sobre|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w desde|strong="H4480"\w* esa \w mañana|strong="H1242"\w* \w hasta|strong="H5704"\w* el \w tiempo|strong="H6256"\w* \w señalado|strong="H4150"\w*. \w Desde|strong="H4480"\w* \w Dan|strong="H1835"\w* \w hasta|strong="H5704"\w* Berseba \w murieron|strong="H4191"\w* \w setenta|strong="H7657"\w* mil personas.  
\v 16 \w Cuando|strong="H1961"\w* \w el|strong="H5973"\w* \w ángel|strong="H4397"\w* \w extendió|strong="H7971"\w* su \w mano|strong="H3027"\w* hacia Jerusalén \w para|strong="H1961"\w* destruirla, \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w se|strong="H1961"\w* dolió \w por|strong="H3027"\w* aquel \w castigo|strong="H7451"\w* y \w le|strong="H5973"\w* dijo al \w ángel|strong="H4397"\w* \w que|strong="H6258"\w* \w estaba|strong="H1961"\w* matando \w a|strong="H3068"\w* la \w gente|strong="H5971"\w*: “¡\w Basta|strong="H7227"\w*! ¡\w Detén|strong="H7503"\w* tu \w mano|strong="H3027"\w*!”. \w En|strong="H5973"\w* ese momento \w el|strong="H5973"\w* \w ángel|strong="H4397"\w* \w del|strong="H5973"\w* \w Señor|strong="H3068"\w* \w estaba|strong="H1961"\w* \w junto|strong="H5973"\w* \w a|strong="H3068"\w* la parcela \w de|strong="H5973"\w* Arauná \w el|strong="H5973"\w* \w jebuseo|strong="H2983"\w*.   
\p
\v 17 Al \w ver|strong="H7200"\w* al \w ángel|strong="H4397"\w* \w que|strong="H4100"\w* \w estaba|strong="H1961"\w* matando al \w pueblo|strong="H5971"\w*, \w David|strong="H1732"\w* le dijo al \w Señor|strong="H3068"\w*: “¡\w Soy|strong="H1961"\w* \w yo|strong="H2009"\w* \w quien|strong="H4100"\w* ha \w pecado|strong="H2398"\w*! ¡\w Soy|strong="H1961"\w* \w yo|strong="H2009"\w* \w quien|strong="H4100"\w* ha \w hecho|strong="H6213"\w* \w lo|strong="H4100"\w* malo! Pero \w este|strong="H1961"\w* \w pueblo|strong="H5971"\w*, \w que|strong="H4100"\w* \w son|strong="H1961"\w* \w como|strong="H4100"\w* \w ovejas|strong="H6629"\w*, ¿\w qué|strong="H4100"\w* culpa \w tienen|strong="H1961"\w*? Te \w ruego|strong="H4994"\w* \w que|strong="H4100"\w* descargues \w tu|strong="H6213"\w* \w mano|strong="H3027"\w* \w contra|strong="H1961"\w* \w mí|strong="H2009"\w* y \w contra|strong="H1961"\w* \w mi|strong="H2009"\w* \w familia|strong="H1004"\w*”.   
\p
\v 18 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, \w Gad|strong="H1410"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w le|strong="H1931"\w* dijo: “\w Sube|strong="H5927"\w* y construye un \w altar|strong="H4196"\w* al \w Señor|strong="H3068"\w* en \w la|strong="H1931"\w* parcela de Arauná \w el|strong="H1931"\w* \w jebuseo|strong="H2983"\w*”.   
\p
\v 19 \w David|strong="H1732"\w* \w subió|strong="H5927"\w* para cumplir la \w orden|strong="H6680"\w* \w que|strong="H1697"\w* el \w Señor|strong="H3068"\w* le dio \w por|strong="H1697"\w* medio \w de|strong="H1697"\w* \w Gad|strong="H1410"\w*.  
\v 20 \w Cuando|strong="H5650"\w* Arauná \w vio|strong="H7200"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* sus oficiales \w se|strong="H5921"\w* acercaban, \w salió|strong="H3318"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinó rostro \w en|strong="H5921"\w* tierra ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 21 —¿\w A|strong="H3068"\w* \w qué|strong="H5921"\w* \w se|strong="H5921"\w* debe \w que|strong="H5921"\w* su Majestad venga \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* este \w siervo|strong="H5650"\w* \w suyo|strong="H5971"\w*? —preguntó Arauná. \w David|strong="H1732"\w* respondió: Vengo \w a|strong="H3068"\w* comprarte tu parcela \w para|strong="H5921"\w* construir un \w altar|strong="H4196"\w* \w al|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w así|strong="H5973"\w* \w se|strong="H5921"\w* detenga \w la|strong="H5921"\w* \w plaga|strong="H4046"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* matando \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 22 Arauná \w le|strong="H5869"\w* dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: —Que su Majestad \w tome|strong="H3947"\w* lo que guste \w y|strong="H1241"\w* lo ofrezca. Aquí tiene \w bueyes|strong="H1241"\w* para la ofrenda, \w y|strong="H1241"\w* las herramientas \w de|strong="H5869"\w* trillar \w y|strong="H1241"\w* los yugos para la \w leña|strong="H6086"\w*.  
\v 23 \w Todo|strong="H3605"\w* esto, Majestad, se \w lo|strong="H3605"\w* \w entrego|strong="H5414"\w*. ¡\w Que|strong="H3605"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* su \w Dios|strong="H3068"\w* acepte su ofrenda!   
\p
\v 24 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* le respondió \w a|strong="H3068"\w* Arauná: \w No|strong="H3808"\w*, \w no|strong="H3808"\w* puedo aceptarlo. \w Te|strong="H3588"\w* \w lo|strong="H3808"\w* \w compraré|strong="H7069"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w precio|strong="H3701"\w* justo, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* ofrecer \w al|strong="H5930"\w* \w Señor|strong="H3068"\w* mi \w Dios|strong="H3068"\w* ofrendas quemadas \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* cuesten \w nada|strong="H3808"\w*. \w Fue|strong="H3808"\w* \w así|strong="H3588"\w* \w como|strong="H3588"\w* \w David|strong="H1732"\w* \w compró|strong="H7069"\w* \w la|strong="H3588"\w* parcela \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w bueyes|strong="H1241"\w* \w por|strong="H3588"\w* \w cincuenta|strong="H2572"\w* \w monedas|strong="H3701"\w* \w de|strong="H3588"\w* \w plata|strong="H3701"\w*.\f + \fr 24:24 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 50 siclos equivalen a unos 0,5 kilogramos o 1,1 libras.\f*  
\v 25 \w David|strong="H1732"\w* construyó \w allí|strong="H8033"\w* un \w altar|strong="H4196"\w* \w al|strong="H5921"\w* \w Señor|strong="H3068"\w* \w y|strong="H5921"\w* \w ofreció|strong="H5927"\w* sacrificios \w y|strong="H5921"\w* ofrendas \w de|strong="H5921"\w* paz. Entonces \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* escuchó \w las|strong="H5921"\w* súplicas \w por|strong="H5921"\w* \w el|strong="H5921"\w* país, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w plaga|strong="H4046"\w* \w se|strong="H5921"\w* detuvo \w en|strong="H5921"\w* \w Israel|strong="H3478"\w*.   