\v 21 Has \w hecho|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H2063"\w* \w maravillas|strong="H6213"\w* para \w que|strong="H3045"\w* \w yo|strong="H6213"\w* las conozca, conforme \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w palabra|strong="H1697"\w* y \w a|strong="H3068"\w* \w tu|strong="H6213"\w* voluntad.  
\v 22 “¡\w Por|strong="H5921"\w* \w eso|strong="H3651"\w* eres tan \w grande|strong="H1431"\w*, Señor \w y|strong="H3588"\w* \w Dios|strong="H3069"\w*! \w No|strong="H3588"\w* hay \w nadie|strong="H3605"\w* \w como|strong="H3588"\w* tú, ni hay \w más|strong="H3588"\w* \w Dios|strong="H3069"\w* \w que|strong="H3588"\w* tú, \w según|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* hemos \w oído|strong="H8085"\w* \w con|strong="H5921"\w* nuestros propios \w oídos|strong="H8085"\w*.  
\v 23 ¿\w Y|strong="H3068"\w* \w qué|strong="H4310"\w* \w nación|strong="H1471"\w* \w se|strong="H5971"\w* compara con \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*? Es la única \w nación|strong="H1471"\w* en la tierra \w que|strong="H4310"\w* \w tú|strong="H6213"\w*, Dios, viniste \w a|strong="H3068"\w* rescatar \w para|strong="H5971"\w* \w que|strong="H4310"\w* fuera \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w*. Te \w hiciste|strong="H6213"\w* famoso al \w hacer|strong="H6213"\w* cosas \w grandes|strong="H1420"\w* y asombrosas en favor \w de|strong="H6440"\w* \w tu|strong="H6213"\w* tierra y \w ante|strong="H6440"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w*, al \w cual|strong="H4310"\w* rescataste \w de|strong="H6440"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H6440"\w* las \w naciones|strong="H1471"\w* y \w de|strong="H6440"\w* sus dioses.  
\v 24 Tú confirmaste \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w como|strong="H1961"\w* tu propio \w pueblo|strong="H5971"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, \w y|strong="H5704"\w* tú, \w Señor|strong="H3068"\w*, te has convertido \w en|strong="H5704"\w* su \w Dios|strong="H3068"\w*.   
\p
\v 25 “\w Y|strong="H3068"\w* \w ahora|strong="H6258"\w*, \w Señor|strong="H3068"\w* \w y|strong="H5921"\w* \w Dios|strong="H3068"\w*, \w confirma|strong="H6965"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w la|strong="H5921"\w* promesa \w que|strong="H6258"\w* has \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* este \w siervo|strong="H5650"\w* \w tuyo|strong="H6258"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su \w familia|strong="H1004"\w*. Cumple \w lo|strong="H1697"\w* \w que|strong="H6258"\w* has \w dicho|strong="H1697"\w*.  
\v 26 Así tu \w nombre|strong="H8034"\w* \w será|strong="H1961"\w* exaltado \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* dirá: “\w El|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* \w es|strong="H1961"\w* \w Dios|strong="H3068"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*”. Entonces \w la|strong="H5921"\w* dinastía \w de|strong="H5921"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* \w quedará|strong="H1961"\w* \w firme|strong="H3559"\w* \w ante|strong="H6440"\w* \w ti|strong="H5921"\w*.  
\v 27 “Tú mismo, \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* \w y|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w me|strong="H5921"\w* \w lo|strong="H5921"\w* has revelado \w al|strong="H5921"\w* decirme: “\w Yo|strong="H3588"\w* \w te|strong="H5921"\w* daré \w una|strong="H4672"\w* dinastía”. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w yo|strong="H3588"\w*, tu \w siervo|strong="H5650"\w*, \w me|strong="H5921"\w* he atrevido \w a|strong="H3068"\w* dirigirte \w esta|strong="H2063"\w* \w oración|strong="H8605"\w*.   
\p
\v 28 “Señor y \w Dios|strong="H3069"\w*, tú \w eres|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3069"\w* verdadero; tus \w palabras|strong="H1697"\w* \w son|strong="H1961"\w* \w la|strong="H1931"\w* verdad y has prometido \w este|strong="H1931"\w* \w bien|strong="H2896"\w* \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w*.  
\v 29 Dígnate \w ahora|strong="H6258"\w* bendecir \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w familia|strong="H1004"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* permanezca \w siempre|strong="H5769"\w* \w ante|strong="H6440"\w* ti. Tú, Señor \w y|strong="H3588"\w* \w Dios|strong="H3069"\w*, lo has prometido, \w y|strong="H3588"\w* \w con|strong="H3588"\w* tu \w bendición|strong="H1293"\w* \w mi|strong="H1961"\w* \w familia|strong="H1004"\w* \w será|strong="H1961"\w* \w bendita|strong="H1288"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*”.   
\c 8  
\p
\v 1 Tiempo \w después|strong="H1961"\w*, \w David|strong="H1732"\w* derrotó \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* y \w los|strong="H1961"\w* sometió, quitándoles el control de su metrópoli.  
\v 2 También derrotó \w a|strong="H3068"\w* \w los|strong="H1961"\w* moabitas. \w Los|strong="H1961"\w* obligó \w a|strong="H3068"\w* acostarse \w en|strong="H5221"\w* el suelo y \w los|strong="H1961"\w* \w midió|strong="H4058"\w* con una cuerda: por cada \w dos|strong="H8147"\w* medidas de cuerda les daba \w muerte|strong="H4191"\w*, y por cada medida completa les perdonaba la \w vida|strong="H2421"\w*. Así \w los|strong="H1961"\w* moabitas pasaron \w a|strong="H3068"\w* ser súbditos de \w David|strong="H1732"\w* y le pagaron impuestos.   
\p
\v 3 \w David|strong="H1732"\w* también derrotó \w a|strong="H3068"\w* Hadadézer \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Rehob|strong="H7340"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Soba, cuando este \w iba|strong="H3212"\w* camino \w al|strong="H4428"\w* \w río|strong="H5104"\w* Éufrates para recuperar su dominio.  
\v 4 \w David|strong="H1732"\w* le capturó \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* \w jinetes|strong="H6571"\w* y \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* soldados \w de|strong="H4480"\w* infantería. También les cortó \w los|strong="H3605"\w* tendones \w a|strong="H3068"\w* \w los|strong="H3605"\w* caballos \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w carros|strong="H7393"\w*, \w dejando|strong="H3498"\w* sanos solamente \w a|strong="H3068"\w* \w los|strong="H3605"\w* caballos suficientes \w para|strong="H4480"\w* \w cien|strong="H3967"\w* \w carros|strong="H7393"\w*.  
\v 5 Cuando los sirios de \w Damasco|strong="H1834"\w* llegaron para ayudar \w a|strong="H3068"\w* Hadadézer, \w rey|strong="H4428"\w* de Soba, \w David|strong="H1732"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w veintidós|strong="H6242"\w* mil de ellos.  
\v 6 Luego \w David|strong="H1732"\w* \w puso|strong="H7760"\w* destacamentos militares en \w Damasco|strong="H1834"\w*, y \w los|strong="H3605"\w* sirios \w se|strong="H1961"\w* convirtieron en sus súbditos y le pagaron impuestos. \w El|strong="H3605"\w* \w Señor|strong="H3068"\w* le daba \w la|strong="H3605"\w* victoria \w a|strong="H3068"\w* \w David|strong="H1732"\w* por dondequiera \w que|strong="H1961"\w* \w iba|strong="H1980"\w*.  
\v 7 \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* \w los|strong="H1961"\w* \w escudos|strong="H7982"\w* de \w oro|strong="H2091"\w* \w que|strong="H1961"\w* \w llevaban|strong="H1961"\w* \w los|strong="H1961"\w* oficiales de Hadadézer y \w los|strong="H1961"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* Jerusalén.  
\v 8 Además, el \w rey|strong="H4428"\w* \w David|strong="H1732"\w* se \w llevó|strong="H3947"\w* una \w gran|strong="H3966"\w* cantidad de bronce de las \w ciudades|strong="H5892"\w* de Beta y Berotai, que pertenecían \w a|strong="H3068"\w* Hadadézer.   
\p
\v 9 \w Cuando|strong="H3588"\w* \w Toi|strong="H8583"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Hamat, \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* derrotado \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w ejército|strong="H2426"\w* \w de|strong="H3588"\w* Hadadézer,  
\v 10 \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* \w Joram|strong="H3141"\w* \w para|strong="H5921"\w* saludar \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* felicitarlo \w por|strong="H5921"\w* \w su|strong="H3588"\w* victoria, \w pues|strong="H3588"\w* Hadadézer \w había|strong="H1961"\w* \w estado|strong="H1961"\w* \w en|strong="H5921"\w* \w guerra|strong="H4421"\w* \w con|strong="H5921"\w* \w Toi|strong="H8583"\w*. \w Joram|strong="H3141"\w* \w le|strong="H5921"\w* llevó regalos \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w plata|strong="H3701"\w* \w y|strong="H3588"\w* bronce.  
\v 11 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* consagró \w estos|strong="H3605"\w* objetos \w al|strong="H4428"\w* \w Señor|strong="H3068"\w*, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w la|strong="H1571"\w* \w plata|strong="H3701"\w* \w y|strong="H1571"\w* \w el|strong="H5973"\w* \w oro|strong="H2091"\w* \w que|strong="H1571"\w* \w había|strong="H6942"\w* tomado \w de|strong="H5973"\w* las otras \w naciones|strong="H1471"\w* \w que|strong="H1571"\w* sometió:  
\v 12 \w de|strong="H1121"\w* Siria, \w de|strong="H1121"\w* \w Moab|strong="H4124"\w*, \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas, \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* y \w de|strong="H1121"\w* \w Amalec|strong="H6002"\w*, además \w de|strong="H1121"\w* lo \w que|strong="H1121"\w* tomó \w de|strong="H1121"\w* Hadadézer \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Rehob|strong="H7340"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Soba.   
\p
\v 13 \w David|strong="H1732"\w* se \w hizo|strong="H6213"\w* muy famoso cuando regresó después de haber matado \w a|strong="H3068"\w* \w dieciocho|strong="H8083"\w* mil sirios \w en|strong="H5221"\w* \w el|strong="H6213"\w* \w Valle|strong="H1516"\w* de la \w Sal|strong="H4417"\w*.  
\v 14 \w Puso|strong="H7760"\w* destacamentos militares por \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de Edom, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* edomitas \w se|strong="H1961"\w* convirtieron en sus súbditos. \w El|strong="H3605"\w* \w Señor|strong="H3068"\w* le daba \w la|strong="H3605"\w* victoria \w a|strong="H3068"\w* \w David|strong="H1732"\w* por dondequiera \w que|strong="H1961"\w* \w iba|strong="H1980"\w*.   
\p
\v 15 \w David|strong="H1732"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, gobernando \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w con|strong="H5921"\w* \w justicia|strong="H6666"\w* \w y|strong="H5921"\w* rectitud.  
\v 16 \w Joab|strong="H3097"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Sarvia \w era|strong="H1121"\w* \w el|strong="H5921"\w* comandante \w del|strong="H5921"\w* \w ejército|strong="H6635"\w*; Josafat \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahilud \w era|strong="H1121"\w* \w el|strong="H5921"\w* secretario \w de|strong="H5921"\w* estado;  
\v 17 \w Sadoc|strong="H6659"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahitob y Ahimelec \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abiatar eran \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*; \w Seraías|strong="H8304"\w* \w era|strong="H1121"\w* \w el|strong="H1121"\w* cronista;  
\v 18 \w Benaía|strong="H1141"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joiada|strong="H3077"\w* \w estaba|strong="H1961"\w* al mando \w de|strong="H1121"\w* la guardia real (\w los|strong="H1121"\w* cereteos y peleteos), y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w* \w eran|strong="H1961"\w* sus ministros principales.   
\c 9  
\p
\v 1 Un día \w David|strong="H1732"\w* preguntó: “¿\w Queda|strong="H3498"\w* \w todavía|strong="H5750"\w* alguien \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w yo|strong="H3588"\w* pueda favorecer \w en|strong="H5973"\w* memoria \w de|strong="H3588"\w* Jonatán?”.  
\v 2 Como había un servidor de la \w familia|strong="H1004"\w* de \w Saúl|strong="H7586"\w* \w llamado|strong="H8034"\w* \w Siba|strong="H6717"\w*, lo \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* presentarse ante \w David|strong="H1732"\w*. El \w rey|strong="H4428"\w* le preguntó: ¿Tú eres \w Siba|strong="H6717"\w*? \w A|strong="H3068"\w* sus órdenes respondió él.   
\p
\v 3 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* \w le|strong="H5973"\w* \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* preguntar: ¿\w No|strong="H6213"\w* queda nadie \w de|strong="H5973"\w* la \w familia|strong="H1004"\w* \w de|strong="H5973"\w* \w Saúl|strong="H7586"\w* \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w yo|strong="H6213"\w* pueda mostrarle la bondad \w de|strong="H5973"\w* Dios? \w Siba|strong="H6717"\w* \w le|strong="H5973"\w* contestó: \w Todavía|strong="H5750"\w* queda un \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Jonatán, \w que|strong="H1121"\w* está \w lisiado|strong="H5223"\w* \w de|strong="H5973"\w* ambos \w pies|strong="H7272"\w*.   
\p
\v 4 ¿\w Y|strong="H3068"\w* \w dónde|strong="H1931"\w* \w está|strong="H1931"\w*? preguntó \w el|strong="H1931"\w* \w rey|strong="H4428"\w*. \w Siba|strong="H6717"\w* \w le|strong="H1931"\w* respondió: \w Está|strong="H1931"\w* en \w Lo|strong="H1931"\w* Debar, en \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Maquir, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amiel.   
\p
\v 5 Entonces \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w mandó|strong="H7971"\w* traerlo \w de|strong="H1121"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Maquir, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amiel, en Lo Debar.  
\v 6 \w Cuando|strong="H5650"\w* Mefiboset, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jonatán \w y|strong="H5921"\w* \w nieto|strong="H1121"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*, llegó \w ante|strong="H6440"\w* \w David|strong="H1732"\w*, \w se|strong="H5921"\w* inclinó \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra \w con|strong="H5921"\w* gran respeto. \w David|strong="H1732"\w* \w le|strong="H5921"\w* dijo: ¡Mefiboset! \w A|strong="H3068"\w* sus órdenes, su Majestad respondió \w él|strong="H5921"\w*.   
\p
\v 7 \w No|strong="H6213"\w* tengas \w miedo|strong="H3372"\w* \w le|strong="H5921"\w* dijo \w David|strong="H1732"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H5921"\w* voy \w a|strong="H3068"\w* tratar \w con|strong="H5973"\w* bondad \w por|strong="H5921"\w* amor \w a|strong="H3068"\w* \w tu|strong="H6213"\w* padre Jonatán. \w Te|strong="H5921"\w* voy \w a|strong="H3068"\w* devolver \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w tierras|strong="H7704"\w* \w que|strong="H3588"\w* pertenecieron \w a|strong="H3068"\w* \w tu|strong="H6213"\w* abuelo \w Saúl|strong="H7586"\w*, \w y|strong="H3588"\w* \w tú|strong="H6213"\w* comerás \w siempre|strong="H8548"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w mesa|strong="H7979"\w*.   
\p
\v 8 Mefiboset \w se|strong="H4100"\w* \w volvió|strong="H6437"\w* \w a|strong="H3068"\w* inclinar \w y|strong="H3588"\w* dijo: ¿\w Quién|strong="H4100"\w* \w es|strong="H3588"\w* este \w siervo|strong="H5650"\w* suyo \w para|strong="H3588"\w* \w que|strong="H3588"\w* usted \w se|strong="H4100"\w* fije \w en|strong="H3588"\w* alguien \w como|strong="H4100"\w* \w yo|strong="H3588"\w*, \w que|strong="H3588"\w* \w no|strong="H3588"\w* vale \w más|strong="H3588"\w* \w que|strong="H3588"\w* un \w perro|strong="H3611"\w* \w muerto|strong="H4191"\w*?   
\p
\v 9 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w llamó|strong="H7121"\w* entonces \w a|strong="H3068"\w* \w Siba|strong="H6717"\w*, \w el|strong="H3605"\w* empleado \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*, y le ordenó: “\w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1121"\w* le pertenecía \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* su \w familia|strong="H1004"\w*, \w se|strong="H1961"\w* \w lo|strong="H3605"\w* he \w entregado|strong="H5414"\w* \w al|strong="H4428"\w* \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* tu amo.  
\v 10 Ustedes tú, tus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* tus \w siervos|strong="H5650"\w* cultivarán \w la|strong="H5921"\w* tierra \w para|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* entregarán \w las|strong="H5921"\w* cosechas \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* familia \w de|strong="H5921"\w* tu amo \w tenga|strong="H1961"\w* sustento. Sin embargo, Mefiboset, \w el|strong="H5921"\w* \w nieto|strong="H1121"\w* \w de|strong="H5921"\w* tu amo, comerá \w siempre|strong="H8548"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w mesa|strong="H7979"\w*”. (\w Siba|strong="H6717"\w* \w tenía|strong="H1961"\w* \w quince|strong="H2568"\w* \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* \w veinte|strong="H6242"\w* \w criados|strong="H5650"\w*).   
\p
\v 11 \w Siba|strong="H6717"\w* \w le|strong="H5921"\w* respondió \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “Este servidor suyo \w hará|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* su Majestad \w mi|strong="H5921"\w* señor \w le|strong="H5921"\w* \w ordene|strong="H6680"\w*”. \w Desde|strong="H5921"\w* ese \w día|strong="H1121"\w*, Mefiboset comió \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w de|strong="H5921"\w* \w David|strong="H4428"\w* \w como|strong="H5921"\w* \w si|strong="H5921"\w* fuera uno \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 12 Mefiboset tenía un \w hijo|strong="H1121"\w* \w pequeño|strong="H6996"\w* \w llamado|strong="H8034"\w* Micaía. \w Todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* vivían en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Siba|strong="H6717"\w* estaban al \w servicio|strong="H5650"\w* \w de|strong="H1121"\w* Mefiboset.  
\v 13 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* Mefiboset, \w que|strong="H3588"\w* \w estaba|strong="H3427"\w* lisiado \w de|strong="H5921"\w* \w ambos|strong="H8147"\w* \w pies|strong="H7272"\w*, \w se|strong="H1931"\w* \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w en|strong="H5921"\w* Jerusalén, \w porque|strong="H3588"\w* \w siempre|strong="H8548"\w* comía \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w mesa|strong="H7979"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\c 10  
\p
\v 1 Algún tiempo \w después|strong="H1961"\w* \w murió|strong="H4191"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w de|strong="H8478"\w* \w los|strong="H1121"\w* amonitas, y su \w hijo|strong="H1121"\w* \w Hanún|strong="H2586"\w* lo \w sucedió|strong="H1961"\w* \w en|strong="H8478"\w* \w el|strong="H1121"\w* trono.  
\v 2 \w David|strong="H1732"\w* pensó: “Debo tratar \w a|strong="H3068"\w* \w Hanún|strong="H2586"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Nahas \w con|strong="H5973"\w* la misma lealtad \w con|strong="H5973"\w* \w que|strong="H1121"\w* su padre \w me|strong="H5973"\w* trató \w a|strong="H3068"\w* mí”. \w Así|strong="H5973"\w* \w que|strong="H1121"\w* \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* algunos \w de|strong="H5973"\w* sus oficiales \w para|strong="H5973"\w* darle \w el|strong="H5973"\w* pésame \w por|strong="H3027"\w* la muerte \w de|strong="H5973"\w* su padre. Pero \w cuando|strong="H5650"\w* \w los|strong="H1121"\w* oficiales \w de|strong="H5973"\w* \w David|strong="H1732"\w* llegaron al territorio amonita,   
\p
\v 3 \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* amonitas \w le|strong="H5869"\w* dijeron \w a|strong="H3068"\w* \w Hanún|strong="H2586"\w*, \w su|strong="H3588"\w* señor: “¿Usted cree \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* estos \w hombres|strong="H1121"\w* solo \w para|strong="H3588"\w* consolarlo \w y|strong="H3588"\w* honrar \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre? ¡Claro \w que|strong="H3588"\w* \w no|strong="H3808"\w*! Seguramente \w David|strong="H1732"\w* \w los|strong="H1121"\w* \w envió|strong="H7971"\w* \w para|strong="H3588"\w* espiar \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*, conocer nuestras defensas \w y|strong="H3588"\w* luego destruirnos”.   
\p
\v 4 Entonces \w Hanún|strong="H2586"\w* agarró \w a|strong="H3068"\w* los oficiales \w de|strong="H5704"\w* \w David|strong="H1732"\w*, les afeitó media \w barba|strong="H2206"\w*, les \w cortó|strong="H3772"\w* la ropa \w por|strong="H5704"\w* la mitad \w hasta|strong="H5704"\w* las nalgas \w y|strong="H5704"\w* los \w despidió|strong="H7971"\w*.  
\v 5 \w Cuando|strong="H3588"\w* \w David|strong="H1732"\w* \w se|strong="H1961"\w* enteró, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* alguien \w a|strong="H3068"\w* recibirlos, \w pues|strong="H3588"\w* \w los|strong="H3427"\w* hombres \w estaban|strong="H1961"\w* terriblemente humillados. \w El|strong="H3588"\w* \w rey|strong="H4428"\w* les \w mandó|strong="H7971"\w* decir: “Quédense \w en|strong="H5704"\w* \w Jericó|strong="H3405"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* les crezca \w la|strong="H3588"\w* \w barba|strong="H2206"\w*, \w y|strong="H3588"\w* \w entonces|strong="H3588"\w* regresen”.   
\p
\v 6 \w Al|strong="H4428"\w* darse cuenta \w los|strong="H1121"\w* amonitas \w de|strong="H3588"\w* \w que|strong="H3588"\w* se habían \w ganado|strong="H1121"\w* \w el|strong="H3588"\w* odio \w de|strong="H3588"\w* \w David|strong="H1732"\w*, contrataron mercenarios sirios \w de|strong="H3588"\w* Bet-rehob \w y|strong="H3588"\w* \w de|strong="H3588"\w* Soba (\w veinte|strong="H6242"\w* mil soldados \w de|strong="H3588"\w* infantería), \w además|strong="H3588"\w* del \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Maaca \w con|strong="H3588"\w* mil \w hombres|strong="H1121"\w* \w y|strong="H3588"\w* \w doce|strong="H8147"\w* mil soldados \w de|strong="H3588"\w* Tob.  
\v 7 En cuanto \w David|strong="H1732"\w* \w lo|strong="H3605"\w* \w supo|strong="H8085"\w*, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* con \w todo|strong="H3605"\w* su \w ejército|strong="H6635"\w* de soldados de élite.  
\v 8 \w Los|strong="H1121"\w* amonitas \w salieron|strong="H3318"\w* y se prepararon para la \w batalla|strong="H4421"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* su ciudad, mientras \w que|strong="H1121"\w* \w los|strong="H1121"\w* sirios \w de|strong="H1121"\w* Soba, \w de|strong="H1121"\w* \w Rehob|strong="H7340"\w*, y \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* Tob y \w de|strong="H1121"\w* Maaca estaban posicionados aparte, \w en|strong="H3318"\w* \w el|strong="H1121"\w* \w campo|strong="H7704"\w*.  
\v 9 \w Cuando|strong="H3588"\w* \w Joab|strong="H3097"\w* \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w tenía|strong="H1961"\w* \w que|strong="H3588"\w* pelear \w en|strong="H3588"\w* \w dos|strong="H6440"\w* frentes, \w por|strong="H3588"\w* \w delante|strong="H6440"\w* \w y|strong="H3588"\w* \w por|strong="H3588"\w* detrás, eligió \w a|strong="H3068"\w* \w los|strong="H3605"\w* mejores soldados \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w los|strong="H3605"\w* desplegó \w contra|strong="H7125"\w* \w los|strong="H3605"\w* sirios.  
\v 10 Al \w resto|strong="H3499"\w* \w de|strong="H1121"\w* la tropa la \w puso|strong="H5414"\w* bajo \w el|strong="H1121"\w* mando \w de|strong="H1121"\w* su hermano Abisai, y \w los|strong="H1121"\w* desplegó \w contra|strong="H7125"\w* \w los|strong="H1121"\w* amonitas.  
\v 11 Joab le dijo \w a|strong="H3068"\w* su hermano: “\w Si|strong="H1961"\w* \w los|strong="H1121"\w* sirios \w son|strong="H1961"\w* \w más|strong="H4480"\w* \w fuertes|strong="H1121"\w* \w que|strong="H4480"\w* \w yo|strong="H4480"\w*, ustedes vendrán \w a|strong="H3068"\w* ayudarme; pero \w si|strong="H1961"\w* \w los|strong="H1121"\w* amonitas \w son|strong="H1961"\w* \w más|strong="H4480"\w* \w fuertes|strong="H1121"\w* \w que|strong="H4480"\w* ustedes, \w yo|strong="H4480"\w* \w iré|strong="H1980"\w* \w a|strong="H3068"\w* ayudarlos.  
\v 12 ¡\w Ánimo|strong="H2388"\w*! Sean valientes y luchemos con valor \w por|strong="H1157"\w* nuestro \w pueblo|strong="H5971"\w* y \w por|strong="H1157"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5971"\w* nuestro \w Dios|strong="H3068"\w*. \w Que|strong="H5971"\w* \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* \w haga|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w mejor|strong="H2896"\w* \w le|strong="H1157"\w* parezca”.  
\v 13 Entonces \w Joab|strong="H3097"\w* y sus tropas avanzaron \w para|strong="H5973"\w* atacar \w a|strong="H3068"\w* \w los|strong="H5973"\w* sirios, y estos \w huyeron|strong="H5127"\w* \w ante|strong="H6440"\w* \w él|strong="H5973"\w*.  
\v 14 \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* \w los|strong="H1121"\w* amonitas \w que|strong="H3588"\w* \w los|strong="H1121"\w* sirios huían, también \w ellos|strong="H5921"\w* \w huyeron|strong="H5127"\w* \w de|strong="H5921"\w* Abisai \w y|strong="H3588"\w* \w se|strong="H5921"\w* refugiaron \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* esto, \w Joab|strong="H3097"\w* dejó \w de|strong="H5921"\w* perseguir \w a|strong="H3068"\w* \w los|strong="H1121"\w* amonitas \w y|strong="H3588"\w* regresó \w a|strong="H3068"\w* Jerusalén.   
\p
\v 15 \w Cuando|strong="H3588"\w* \w los|strong="H3588"\w* sirios se \w vieron|strong="H7200"\w* derrotados \w por|strong="H3588"\w* \w Israel|strong="H3478"\w*, volvieron \w a|strong="H3068"\w* concentrar sus fuerzas.  
\v 16 Hadadézer \w mandó|strong="H7971"\w* traer \w a|strong="H3068"\w* los sirios que estaban al otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w* Éufrates, y estos llegaron \w a|strong="H3068"\w* Helam bajo el \w mando|strong="H7971"\w* \w de|strong="H6440"\w* Sobac, el \w general|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H6440"\w* Hadadézer.  
\v 17 \w En|strong="H5973"\w* cuanto \w le|strong="H5973"\w* informaron \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w él|strong="H5973"\w* reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, cruzó \w el|strong="H5973"\w* \w Jordán|strong="H3383"\w* y llegó \w a|strong="H3068"\w* Helam. \w Los|strong="H3605"\w* sirios se desplegaron \w contra|strong="H5973"\w* \w David|strong="H1732"\w* y \w lo|strong="H3605"\w* atacaron,  
\v 18 pero volvieron \w a|strong="H3068"\w* huir \w ante|strong="H6440"\w* los israelitas. \w David|strong="H1732"\w* \w destruyó|strong="H2026"\w* \w setecientos|strong="H7651"\w* \w carros|strong="H7393"\w* \w de|strong="H6440"\w* \w guerra|strong="H6635"\w*, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* cuarenta \w mil|strong="H3967"\w* \w jinetes|strong="H6571"\w* y también \w hirió|strong="H5221"\w* \w de|strong="H6440"\w* \w muerte|strong="H4191"\w* \w a|strong="H3068"\w* Sobac, el \w general|strong="H8269"\w* del \w ejército|strong="H6635"\w* sirio.  
\v 19 \w Cuando|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w que|strong="H3588"\w* eran súbditos \w de|strong="H3588"\w* Hadadézer \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w Israel|strong="H3478"\w* \w los|strong="H1121"\w* \w había|strong="H3588"\w* derrotado, hicieron \w la|strong="H3588"\w* \w paz|strong="H7999"\w* \w con|strong="H3588"\w* \w los|strong="H1121"\w* israelitas \w y|strong="H3588"\w* se sometieron \w a|strong="H3068"\w* \w ellos|strong="H3605"\w*. \w Desde|strong="H6440"\w* \w entonces|strong="H3588"\w*, \w los|strong="H1121"\w* sirios tuvieron \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* volver \w a|strong="H3068"\w* ayudar \w a|strong="H3068"\w* \w los|strong="H1121"\w* amonitas.   
\c 11  
\p
\v 1 \w A|strong="H3068"\w* \w la|strong="H5921"\w* primavera siguiente, \w en|strong="H5921"\w* \w la|strong="H5921"\w* época \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* suelen \w salir|strong="H3318"\w* \w a|strong="H3068"\w* campaña, \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* \w con|strong="H5973"\w* sus oficiales \w y|strong="H5921"\w* \w con|strong="H5973"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* ejército \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Ellos|strong="H5921"\w* derrotaron \w a|strong="H3068"\w* \w los|strong="H3427"\w* amonitas \w y|strong="H5921"\w* sitiaron \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* Rabá; pero \w David|strong="H1732"\w* \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w en|strong="H5921"\w* Jerusalén.  
\v 2 Una \w tarde|strong="H6153"\w*, \w David|strong="H1732"\w* \w se|strong="H1961"\w* \w levantó|strong="H6965"\w* \w de|strong="H5921"\w* su \w cama|strong="H4904"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* puso \w a|strong="H3068"\w* caminar \w por|strong="H5921"\w* \w la|strong="H5921"\w* azotea \w del|strong="H5921"\w* palacio. \w Desde|strong="H5921"\w* allí \w vio|strong="H7200"\w* \w a|strong="H3068"\w* una mujer \w que|strong="H5921"\w* \w se|strong="H1961"\w* \w estaba|strong="H1961"\w* bañando; \w la|strong="H5921"\w* mujer \w era|strong="H1961"\w* \w muy|strong="H3966"\w* \w hermosa|strong="H2896"\w*.  
\v 3 \w David|strong="H1732"\w* \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* alguien para \w que|strong="H3808"\w* investigara quién era ella, y le informaron: “\w Es|strong="H2063"\w* Betsabé, \w hija|strong="H1323"\w* de Eliam y esposa de Urías el hitita”.   
\p
\v 4 \w Entonces|strong="H7725"\w* \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w para|strong="H5973"\w* traerla. Cuando \w ella|strong="H1931"\w* llegó, \w David|strong="H1732"\w* \w se|strong="H1931"\w* acostó \w con|strong="H5973"\w* \w ella|strong="H1931"\w* (\w ella|strong="H1931"\w* acababa \w de|strong="H5973"\w* purificarse \w de|strong="H5973"\w* \w su|strong="H1931"\w* regla). Después Betsabé regresó \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w*.  
\v 5 Más tarde, la mujer se dio \w cuenta|strong="H5046"\w* de que estaba \w embarazada|strong="H2029"\w* y le \w mandó|strong="H7971"\w* \w aviso|strong="H5046"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “Estoy esperando un hijo”.   
\p
\v 6 Ante esto, \w David|strong="H1732"\w* le \w envió|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* \w Joab|strong="H3097"\w*: “Mándame \w a|strong="H3068"\w* Urías el hitita”. \w Y|strong="H3068"\w* \w Joab|strong="H3097"\w* se lo \w envió|strong="H7971"\w*.  
\v 7 Cuando Urías llegó, \w David|strong="H1732"\w* le \w preguntó|strong="H7592"\w* cómo \w estaban|strong="H5971"\w* \w Joab|strong="H3097"\w* y el ejército, y cómo iba la \w guerra|strong="H4421"\w*.  
\v 8 \w Luego|strong="H3318"\w* \w David|strong="H1732"\w* le dijo \w a|strong="H3068"\w* Urías: Vete \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w* y descansa. \w En|strong="H3318"\w* cuanto Urías \w salió|strong="H3318"\w* del palacio, el \w rey|strong="H4428"\w* le envió un regalo \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*.  
\v 9 Pero Urías \w no|strong="H3808"\w* \w fue|strong="H3808"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* quedó \w a|strong="H3068"\w* dormir \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada del palacio con \w los|strong="H3605"\w* guardias de su señor.  
\v 10 Cuando le avisaron \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H3808"\w* Urías \w no|strong="H3808"\w* había ido \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*, \w David|strong="H1732"\w* le preguntó: ¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* fuiste \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w*? ¡Acabas de llegar de un \w viaje|strong="H1870"\w* largo!   
\p
\v 11 Urías \w le|strong="H5921"\w* respondió: \w Tanto|strong="H5921"\w* \w el|strong="H5921"\w* arca \w como|strong="H5973"\w* \w los|strong="H3427"\w* ejércitos \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w viven|strong="H2416"\w* \w en|strong="H5921"\w* campamentos; \w mi|strong="H5921"\w* señor \w Joab|strong="H3097"\w* \w y|strong="H5921"\w* sus oficiales \w están|strong="H3427"\w* acampando \w al|strong="H5921"\w* aire libre. ¿\w Cómo|strong="H5973"\w* podría \w yo|strong="H5315"\w* ir \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w casa|strong="H1004"\w* \w a|strong="H3068"\w* \w comer|strong="H5315"\w* \w y|strong="H5921"\w* \w beber|strong="H8354"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* acostarme \w con|strong="H5973"\w* \w mi|strong="H5921"\w* esposa? ¡Tan cierto \w como|strong="H5973"\w* \w que|strong="H5921"\w* usted \w vive|strong="H2416"\w*, \w que|strong="H5921"\w* \w yo|strong="H5315"\w* \w no|strong="H6213"\w* puedo \w hacer|strong="H6213"\w* \w tal|strong="H2088"\w* \w cosa|strong="H1697"\w*!   
\p
\v 12 \w Está|strong="H2088"\w* bien dijo \w David|strong="H1732"\w*, \w quédate|strong="H3427"\w* \w hoy|strong="H3117"\w* \w aquí|strong="H2088"\w* \w y|strong="H1571"\w* \w mañana|strong="H4279"\w* te \w dejaré|strong="H7971"\w* regresar. \w Así|strong="H1571"\w* \w que|strong="H1931"\w* Urías \w se|strong="H1931"\w* \w quedó|strong="H3427"\w* en Jerusalén \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w y|strong="H1571"\w* \w el|strong="H1931"\w* \w siguiente|strong="H4283"\w*.  
\v 13 \w David|strong="H1732"\w* \w lo|strong="H3808"\w* invitó \w a|strong="H3068"\w* comer y \w a|strong="H3068"\w* \w beber|strong="H8354"\w*, y \w lo|strong="H3808"\w* emborrachó. Pero esa noche Urías volvió \w a|strong="H3068"\w* dormir \w en|strong="H5973"\w* su colchoneta \w con|strong="H5973"\w* \w los|strong="H5973"\w* guardias \w de|strong="H6440"\w* su señor, y \w no|strong="H3808"\w* \w fue|strong="H3808"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*.  
\v 14 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w David|strong="H1732"\w* \w escribió|strong="H3789"\w* una \w carta|strong="H5612"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* y \w se|strong="H1961"\w* la \w envió|strong="H7971"\w* \w por|strong="H3027"\w* \w medio|strong="H3027"\w* de Urías.  
\v 15 \w En|strong="H5221"\w* la \w carta|strong="H5612"\w* le ordenaba: “Pongan \w a|strong="H3068"\w* Urías \w en|strong="H5221"\w* la primera línea \w de|strong="H6440"\w* fuego, donde la \w batalla|strong="H4421"\w* sea \w más|strong="H4191"\w* dura, y \w luego|strong="H7725"\w* déjenlo solo para que \w lo|strong="H5612"\w* maten”.   
\p
\v 16 \w Así|strong="H3588"\w* \w que|strong="H3588"\w*, \w mientras|strong="H3588"\w* \w Joab|strong="H3097"\w* sitiaba \w la|strong="H8104"\w* \w ciudad|strong="H5892"\w*, mandó \w a|strong="H3068"\w* Urías al \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w sabía|strong="H3045"\w* \w que|strong="H3588"\w* \w estaban|strong="H1961"\w* \w los|strong="H1961"\w* defensores \w más|strong="H3588"\w* \w valientes|strong="H2428"\w*.  
\v 17 \w Cuando|strong="H1571"\w* los hombres \w de|strong="H4480"\w* \w la|strong="H1571"\w* \w ciudad|strong="H5892"\w* \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H4480"\w* \w Joab|strong="H3097"\w*, \w murieron|strong="H4191"\w* \w algunos|strong="H5307"\w* \w de|strong="H4480"\w* los soldados \w de|strong="H4480"\w* \w David|strong="H1732"\w*, \w y|strong="H1571"\w* \w entre|strong="H4480"\w* \w ellos|strong="H1571"\w* \w murió|strong="H4191"\w* Urías \w el|strong="H5307"\w* hitita.  
\v 18 \w Joab|strong="H3097"\w* \w envió|strong="H7971"\w* entonces \w a|strong="H3068"\w* \w David|strong="H1732"\w* un informe detallado \w de|strong="H1697"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*,  
\v 19 y le dio estas instrucciones \w al|strong="H4428"\w* \w mensajero|strong="H4397"\w*: “Cuando termines \w de|strong="H1697"\w* contarle \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* pasó en \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*,  
\v 20 \w es|strong="H1961"\w* posible \w que|strong="H3808"\w* \w él|strong="H5921"\w* \w se|strong="H3045"\w* enoje \w y|strong="H5921"\w* \w te|strong="H5921"\w* pregunte: “¿\w Por|strong="H5921"\w* \w qué|strong="H3808"\w* \w se|strong="H3045"\w* acercaron \w tanto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w para|strong="H5921"\w* pelear? ¿Acaso \w no|strong="H3808"\w* \w sabían|strong="H3045"\w* \w que|strong="H3808"\w* \w les|strong="H5921"\w* dispararían \w desde|strong="H5921"\w* \w la|strong="H5921"\w* muralla?  
\v 21 ¿\w No|strong="H3808"\w* recuerdan \w quién|strong="H4310"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* Abimelec \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jerobeset? ¿\w No|strong="H3808"\w* \w fue|strong="H3808"\w* una mujer \w la|strong="H5921"\w* \w que|strong="H4100"\w* \w le|strong="H5921"\w* lanzó una piedra \w de|strong="H5921"\w* molino \w desde|strong="H5921"\w* \w la|strong="H5921"\w* muralla \w de|strong="H5921"\w* Tebas \w y|strong="H1571"\w* \w lo|strong="H4100"\w* \w mató|strong="H5221"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w se|strong="H5921"\w* acercaron \w tanto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* muralla?”. \w Si|strong="H1571"\w* \w él|strong="H5921"\w* \w te|strong="H5921"\w* pregunta eso, tú dile: “\w También|strong="H1571"\w* \w ha|strong="H3808"\w* \w muerto|strong="H4191"\w* su servidor Urías \w el|strong="H5921"\w* hitita””.   
\p
\v 22 \w El|strong="H3605"\w* \w mensajero|strong="H4397"\w* \w partió|strong="H3212"\w* y, al llegar ante \w David|strong="H1732"\w*, le dio \w el|strong="H3605"\w* informe \w que|strong="H3605"\w* \w Joab|strong="H3097"\w* le había encargado.  
\v 23 \w Le|strong="H5921"\w* dijo: \w Los|strong="H5921"\w* enemigos \w nos|strong="H5921"\w* aventajaban \w y|strong="H3588"\w* \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w al|strong="H5921"\w* \w campo|strong="H7704"\w* abierto. \w Nosotros|strong="H5921"\w* \w los|strong="H5921"\w* rechazamos \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudad,  
\v 24 pero \w desde|strong="H5921"\w* \w la|strong="H5921"\w* muralla \w los|strong="H5921"\w* arqueros dispararon \w contra|strong="H5921"\w* sus soldados, \w y|strong="H1571"\w* \w murieron|strong="H4191"\w* algunos \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w de|strong="H5921"\w* su Majestad. \w También|strong="H1571"\w* \w murió|strong="H4191"\w* su servidor Urías \w el|strong="H5921"\w* hitita.   
\p
\v 25 \w David|strong="H1732"\w* \w le|strong="H5869"\w* dijo al \w mensajero|strong="H4397"\w*: Dile \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* \w de|strong="H3588"\w* mi parte: “\w No|strong="H3588"\w* \w te|strong="H5869"\w* desanimes \w por|strong="H3588"\w* \w esto|strong="H2088"\w*, \w que|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w guerra|strong="H4421"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w* mata \w a|strong="H3068"\w* unos \w y|strong="H3588"\w* \w a|strong="H3068"\w* otros. Intensifica \w el|strong="H3588"\w* ataque contra \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w hasta|strong="H2088"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* destruyas”. ¡Dale ánimos!   
\p
\v 26 \w Cuando|strong="H3588"\w* \w la|strong="H5921"\w* esposa \w de|strong="H5921"\w* Urías \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w marido|strong="H1167"\w* \w había|strong="H3588"\w* \w muerto|strong="H4191"\w*, hizo luto \w por|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 27 \w Pasado|strong="H5674"\w* \w el|strong="H1121"\w* tiempo \w de|strong="H1121"\w* luto, \w David|strong="H1732"\w* \w mandó|strong="H7971"\w* \w que|strong="H1697"\w* la trajeran al palacio. Ella \w se|strong="H1961"\w* convirtió en su esposa y \w le|strong="H5869"\w* dio un \w hijo|strong="H1121"\w*. Pero \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w David|strong="H1732"\w* \w había|strong="H1961"\w* \w hecho|strong="H6213"\w* \w fue|strong="H1961"\w* muy malo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* del \w Señor|strong="H3068"\w*.   
\c 12  
\p
\v 1 El \w Señor|strong="H3068"\w* \w envió|strong="H7971"\w* al profeta Natán \w para|strong="H1961"\w* \w que|strong="H1961"\w* hablara con \w David|strong="H1732"\w*. \w Cuando|strong="H1961"\w* Natán llegó, le contó \w esta|strong="H1961"\w* historia: “En cierta \w ciudad|strong="H5892"\w* vivían \w dos|strong="H8147"\w* \w hombres|strong="H8147"\w*; uno \w era|strong="H1961"\w* muy \w rico|strong="H6223"\w* y el otro \w era|strong="H1961"\w* muy \w pobre|strong="H7326"\w*.  
\v 2 El \w rico|strong="H6223"\w* \w tenía|strong="H1961"\w* muchísimas \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w*.  
\v 3 \w En|strong="H5973"\w* cambio, \w el|strong="H5973"\w* \w pobre|strong="H7326"\w* \w no|strong="H3588"\w* \w tenía|strong="H1961"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* una sola ovejita \w que|strong="H3588"\w* \w él|strong="H5973"\w* \w mismo|strong="H3605"\w* \w había|strong="H1961"\w* \w comprado|strong="H7069"\w* \w y|strong="H3588"\w* criado. \w La|strong="H3588"\w* ovejita \w creció|strong="H1431"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w y|strong="H3588"\w* \w con|strong="H5973"\w* sus \w hijos|strong="H1121"\w*; comía \w de|strong="H3588"\w* \w su|strong="H3588"\w* propio plato, bebía \w de|strong="H3588"\w* \w su|strong="H3588"\w* misma copa \w y|strong="H3588"\w* dormía \w en|strong="H5973"\w* \w su|strong="H3588"\w* pecho. \w Era|strong="H1961"\w* \w para|strong="H3588"\w* \w él|strong="H5973"\w* \w como|strong="H3588"\w* una \w hija|strong="H1323"\w*.  
\v 4 Cierto día, un viajero llegó \w a|strong="H3068"\w* visitar al hombre \w rico|strong="H6223"\w*. Este, por \w no|strong="H6213"\w* matar \w a|strong="H3068"\w* una de sus propias \w ovejas|strong="H6629"\w* \w o|strong="H3068"\w* \w vacas|strong="H1241"\w* para alimentar al visitante, le \w quitó|strong="H3947"\w* al hombre \w pobre|strong="H7326"\w* su única ovejita \w y|strong="H1241"\w* la preparó para su invitado”.   
\p
\v 5 \w David|strong="H1732"\w* se puso furioso contra \w aquel|strong="H6213"\w* \w hombre|strong="H1121"\w* \w y|strong="H3588"\w* le dijo \w a|strong="H3068"\w* Natán: ¡\w Tan|strong="H3966"\w* \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w vive|strong="H2416"\w*, \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w hombre|strong="H1121"\w* \w que|strong="H3588"\w* \w hizo|strong="H6213"\w* \w esto|strong="H2063"\w* merece \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*!  
\v 6 ¡\w Y|strong="H3068"\w* tendrá \w que|strong="H3808"\w* \w pagar|strong="H7999"\w* cuatro veces \w el|strong="H5921"\w* valor \w de|strong="H5921"\w* \w la|strong="H5921"\w* ovejita \w por|strong="H5921"\w* \w haber|strong="H3808"\w* \w hecho|strong="H6213"\w* \w algo|strong="H1697"\w* tan cruel \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w haber|strong="H3808"\w* tenido compasión!   
\p
\v 7 Entonces Natán \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: ¡Tú eres ese hombre! \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: “Yo \w te|strong="H5921"\w* \w ungí|strong="H4886"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w libré|strong="H5337"\w* \w del|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*.  
\v 8 Te \w entregué|strong="H5414"\w* el palacio \w de|strong="H5414"\w* tu señor y \w puse|strong="H5414"\w* \w a|strong="H3068"\w* sus mujeres en tus brazos. Te \w di|strong="H5414"\w* el reino \w de|strong="H5414"\w* \w Israel|strong="H3478"\w* y \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*; y \w por|strong="H2007"\w* si fuera \w poco|strong="H4592"\w*, te habría \w dado|strong="H5414"\w* \w mucho|strong="H4592"\w* \w más|strong="H3254"\w*.  
\v 9 ¿\w Por|strong="H4069"\w* \w qué|strong="H1697"\w* despreciaste la \w palabra|strong="H1697"\w* del \w Señor|strong="H3068"\w* \w haciendo|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w a|strong="H3068"\w* \w él|strong="H1121"\w* \w le|strong="H5869"\w* desagrada? \w Mataste|strong="H2026"\w* \w a|strong="H3068"\w* Urías \w el|strong="H1121"\w* hitita valiéndote \w de|strong="H1121"\w* la \w espada|strong="H2719"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas, y \w te|strong="H5869"\w* quedaste con su esposa.  
\v 10 \w Por|strong="H3588"\w* eso, \w la|strong="H3588"\w* violencia \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w* \w nunca|strong="H3808"\w* \w se|strong="H1961"\w* apartarán \w de|strong="H3588"\w* tu \w familia|strong="H1004"\w*, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* despreciaste \w al|strong="H5704"\w* \w tomar|strong="H3947"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* mujer \w de|strong="H3588"\w* Urías \w el|strong="H3588"\w* hitita \w para|strong="H5704"\w* \w que|strong="H3588"\w* \w fuera|strong="H1961"\w* tu esposa”.   
\p
\v 11 “\w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*: “Yo \w haré|strong="H5414"\w* \w que|strong="H5921"\w* \w de|strong="H5921"\w* tu propia \w familia|strong="H1004"\w* surja tu desgracia. Ante tus mismos \w ojos|strong="H5869"\w* \w te|strong="H5869"\w* \w quitaré|strong="H3947"\w* \w a|strong="H3068"\w* tus mujeres \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w las|strong="H5921"\w* \w daré|strong="H5414"\w* \w a|strong="H3068"\w* alguien cercano \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, quien \w se|strong="H5921"\w* acostará \w con|strong="H5973"\w* \w ellas|strong="H5921"\w* \w a|strong="H3068"\w* plena luz \w del|strong="H5921"\w* día.  
\v 12 \w Tú|strong="H6213"\w* \w lo|strong="H1697"\w* \w hiciste|strong="H6213"\w* \w a|strong="H3068"\w* escondidas, \w pero|strong="H3588"\w* \w yo|strong="H3588"\w* \w lo|strong="H1697"\w* \w haré|strong="H6213"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* vista \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* pleno día””.   
\p
\v 13 He \w pecado|strong="H2403"\w* contra \w el|strong="H5674"\w* \w Señor|strong="H3068"\w* confesó \w David|strong="H1732"\w* ante Natán.  
\p Natán le respondió: \w El|strong="H5674"\w* \w Señor|strong="H3068"\w* \w ha|strong="H3808"\w* perdonado tu \w pecado|strong="H2403"\w*; \w no|strong="H3808"\w* vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*.  
\v 14 \w Pero|strong="H3588"\w* \w como|strong="H3588"\w* \w con|strong="H3588"\w* \w este|strong="H2088"\w* acto \w has|strong="H4191"\w* ofendido gravemente al \w Señor|strong="H3068"\w*, \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* ha nacido \w morirá|strong="H4191"\w* sin remedio.  
\v 15 Después de esto, Natán regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*.  
\p El \w Señor|strong="H3068"\w* hizo que el \w hijo|strong="H3205"\w* que la esposa de Urías le había dado \w a|strong="H3068"\w* \w David|strong="H1732"\w* se enfermara de gravedad.  
\v 16 \w David|strong="H1732"\w* \w le|strong="H1157"\w* rogó \w a|strong="H3068"\w* Dios \w por|strong="H1157"\w* la salud del \w niño|strong="H5288"\w*; se puso \w a|strong="H3068"\w* ayunar y pasaba las noches \w acostado|strong="H7901"\w* en \w el|strong="H3885"\w* suelo.  
\v 17 \w Los|strong="H5921"\w* consejeros \w de|strong="H4480"\w* su palacio trataban \w de|strong="H4480"\w* levantarlo, pero \w él|strong="H5921"\w* \w no|strong="H3808"\w* quería, \w ni|strong="H3808"\w* \w tampoco|strong="H3808"\w* aceptaba comer \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 18 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, \w el|strong="H3588"\w* niño \w murió|strong="H4191"\w*. \w Los|strong="H1961"\w* oficiales \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w tenían|strong="H1961"\w* \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* darle \w la|strong="H3588"\w* noticia, \w pues|strong="H3588"\w* decían: “\w Si|strong="H3588"\w* \w cuando|strong="H3588"\w* \w el|strong="H3588"\w* niño \w aún|strong="H3808"\w* vivía le \w hablábamos|strong="H1696"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* nos \w hacía|strong="H6213"\w* caso, ¿\w qué|strong="H3588"\w* locura \w no|strong="H3808"\w* \w hará|strong="H6213"\w* \w ahora|strong="H3117"\w* \w si|strong="H3588"\w* le decimos \w que|strong="H3588"\w* \w el|strong="H3588"\w* niño \w ha|strong="H3808"\w* \w muerto|strong="H4191"\w*?”.   
\p
\v 19 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w David|strong="H1732"\w* \w vio|strong="H7200"\w* \w que|strong="H3588"\w* sus oficiales estaban cuchicheando, comprendió lo \w que|strong="H3588"\w* \w había|strong="H3588"\w* pasado \w y|strong="H3588"\w* les preguntó: ¿\w Ya|strong="H3068"\w* \w murió|strong="H4191"\w* \w el|strong="H3588"\w* niño?  
\p \w Sí|strong="H3588"\w*, ya \w murió|strong="H4191"\w* respondieron ellos.   
\p
\v 20 Entonces \w David|strong="H1732"\w* se \w levantó|strong="H6965"\w* del suelo, se bañó, se perfumó y se cambió de \w ropa|strong="H8071"\w*. Entró en la \w casa|strong="H1004"\w* del \w Señor|strong="H3068"\w* y lo \w adoró|strong="H7812"\w*. Al regresar \w a|strong="H3068"\w* su palacio, \w pidió|strong="H7592"\w* \w comida|strong="H3899"\w*, se la sirvieron y comió.  
\v 21 Sus oficiales le preguntaron: ¿\w Por|strong="H1697"\w* \w qué|strong="H4100"\w* \w se|strong="H4100"\w* comporta usted \w así|strong="H2088"\w*? Mientras \w el|strong="H6213"\w* niño vivía, usted ayunaba y \w lloraba|strong="H1058"\w*; pero ahora \w que|strong="H4100"\w* \w el|strong="H6213"\w* niño ha \w muerto|strong="H4191"\w*, ¡\w se|strong="H4100"\w* levanta y \w se|strong="H4100"\w* pone \w a|strong="H3068"\w* comer!   
\p
\v 22 David respondió: \w Mientras|strong="H5750"\w* \w el|strong="H3588"\w* niño vivía, \w yo|strong="H3588"\w* ayunaba \w y|strong="H3588"\w* \w lloraba|strong="H1058"\w* \w porque|strong="H3588"\w* pensaba: “¿\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w*? Tal vez \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* tenga \w compasión|strong="H2603"\w* \w de|strong="H3588"\w* mí \w y|strong="H3588"\w* deje vivir al niño”.  
\v 23 Pero \w ahora|strong="H6258"\w* \w que|strong="H4100"\w* \w ha|strong="H3808"\w* \w muerto|strong="H4191"\w*, ¿\w para|strong="H6258"\w* \w qué|strong="H4100"\w* \w voy|strong="H1980"\w* \w a|strong="H3068"\w* ayunar? ¿Acaso \w puedo|strong="H3201"\w* hacer \w que|strong="H4100"\w* \w vuelva|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* vida? Un día yo \w iré|strong="H1980"\w* \w a|strong="H3068"\w* \w donde|strong="H1931"\w* \w él|strong="H1931"\w* \w está|strong="H2088"\w*, pero \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* mí.   
\p
\v 24 Luego \w David|strong="H1732"\w* consoló \w a|strong="H3068"\w* su esposa Betsabé, y se acostó \w con|strong="H5973"\w* ella. Ella tuvo un \w hijo|strong="H1121"\w* y lo \w llamó|strong="H7121"\w* \w Salomón|strong="H8010"\w*. \w El|strong="H5973"\w* \w Señor|strong="H3068"\w* amó al niño,  
\v 25 y \w por|strong="H3027"\w* \w medio|strong="H3027"\w* del \w profeta|strong="H5030"\w* Natán \w mandó|strong="H7971"\w* decirle \w que|strong="H3027"\w* lo \w llamara|strong="H7121"\w* Jedidías, \w por|strong="H3027"\w* amor al \w Señor|strong="H3068"\w*.   
\p
\v 26 Mientras tanto, \w Joab|strong="H3097"\w* atacó \w a|strong="H3068"\w* Rabá, la capital \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas, y capturó la zona \w real|strong="H4410"\w* \w de|strong="H1121"\w* la \w ciudad|strong="H5892"\w*.  
\v 27 Luego \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* decirle \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “He atacado \w a|strong="H3068"\w* Rabá \w y|strong="H1571"\w* \w ya|strong="H1571"\w* capturé \w el|strong="H1571"\w* suministro \w de|strong="H4325"\w* \w agua|strong="H4325"\w*.  
\v 28 Reúna \w ahora|strong="H6258"\w* \w al|strong="H5921"\w* \w resto|strong="H3499"\w* \w del|strong="H5921"\w* ejército, sitie \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* tómela usted mismo. \w Si|strong="H6435"\w* \w lo|strong="H5921"\w* hago yo, \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* llevará \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*”.   
\p
\v 29 \w David|strong="H1732"\w* reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* ejército, marchó hacia Rabá, \w la|strong="H3605"\w* atacó y \w la|strong="H3605"\w* capturó.  
\v 30 \w David|strong="H1732"\w* \w le|strong="H5921"\w* \w quitó|strong="H3947"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* amonitas \w la|strong="H5921"\w* \w corona|strong="H5850"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* \w tenía|strong="H1961"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w la|strong="H5921"\w* cual pesaba unos treinta kilos\f + \fr 12:30 \ft Un talento equivale a unos 30 kilogramos o 66 libras o 965 onzas troy.\f* \w y|strong="H5921"\w* \w estaba|strong="H1961"\w* adornada \w con|strong="H5921"\w* piedras \w preciosas|strong="H3368"\w*. Esa \w corona|strong="H5850"\w* \w fue|strong="H1961"\w* puesta \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, quien \w además|strong="H5921"\w* \w se|strong="H1961"\w* \w llevó|strong="H3947"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* un \w gran|strong="H3966"\w* botín.  
\v 31 \w David|strong="H1732"\w* \w sacó|strong="H3318"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* y \w la|strong="H3605"\w* \w puso|strong="H7760"\w* \w a|strong="H3068"\w* \w trabajar|strong="H6213"\w* con sierras, rastrillos y hachas \w de|strong="H1121"\w* \w hierro|strong="H1270"\w*, y \w los|strong="H1121"\w* obligó \w a|strong="H3068"\w* fabricar ladrillos. \w Lo|strong="H6213"\w* \w mismo|strong="H3605"\w* \w hizo|strong="H6213"\w* con \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas. Después \w de|strong="H1121"\w* \w eso|strong="H3651"\w*, \w David|strong="H1732"\w* y \w todo|strong="H3605"\w* su ejército regresaron \w a|strong="H3068"\w* Jerusalén.   
\c 13  
\p
\v 1 Tiempo \w después|strong="H1961"\w* \w de|strong="H1121"\w* estos sucesos, ocurrió lo siguiente: Absalón, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w tenía|strong="H1961"\w* una hermana muy \w hermosa|strong="H3303"\w* \w llamada|strong="H8034"\w* Tamar, y Amnón, otro \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w se|strong="H1961"\w* enamoró \w de|strong="H1121"\w* ella.  
\v 2 Amnón estaba \w tan|strong="H1931"\w* obsesionado \w con|strong="H3588"\w* \w su|strong="H1931"\w* hermana Tamar \w que|strong="H3588"\w* \w se|strong="H1931"\w* \w enfermó|strong="H2470"\w* \w de|strong="H3588"\w* angustia. \w Como|strong="H3588"\w* \w ella|strong="H1931"\w* \w era|strong="H1931"\w* \w virgen|strong="H1330"\w*, \w a|strong="H3068"\w* \w él|strong="H1931"\w* \w le|strong="H1931"\w* \w parecía|strong="H5869"\w* imposible estar \w a|strong="H3068"\w* solas \w con|strong="H3588"\w* \w ella|strong="H1931"\w*.  
\v 3 Pero Amnón tenía un \w amigo|strong="H7453"\w* \w llamado|strong="H8034"\w* \w Jonadab|strong="H3122"\w*, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Simea y sobrino \w de|strong="H1121"\w* \w David|strong="H1732"\w*. \w Jonadab|strong="H3122"\w* \w era|strong="H1121"\w* un \w hombre|strong="H1121"\w* \w muy|strong="H3966"\w* \w astuto|strong="H2450"\w*,  
\v 4 y \w le|strong="H1242"\w* preguntó: Oye, tú eres \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* del \w rey|strong="H4428"\w*, ¿\w por|strong="H4069"\w* \w qué|strong="H3808"\w* te ves tan decaído \w día|strong="H1121"\w* tras \w día|strong="H1121"\w*? ¿\w No|strong="H3808"\w* quieres contarme \w qué|strong="H3808"\w* te pasa? Amnón \w le|strong="H1242"\w* respondió: Es \w que|strong="H3808"\w* estoy enamorado \w de|strong="H1121"\w* Tamar, la hermana \w de|strong="H1121"\w* mi hermano Absalón.   
\p
\v 5 Jonadab \w le|strong="H5921"\w* dijo: \w Acuéstate|strong="H7901"\w* \w en|strong="H5921"\w* \w tu|strong="H6213"\w* \w cama|strong="H4904"\w* \w y|strong="H5921"\w* finge \w que|strong="H4994"\w* \w estás|strong="H6213"\w* \w enfermo|strong="H2470"\w*. Cuando \w tu|strong="H6213"\w* padre venga \w a|strong="H3068"\w* verte, dile: “\w Por|strong="H5921"\w* favor, deja \w que|strong="H4994"\w* \w mi|strong="H5921"\w* hermana Tamar venga \w a|strong="H3068"\w* darme \w de|strong="H5921"\w* comer. \w Me|strong="H5921"\w* gustaría \w que|strong="H4994"\w* preparara algo aquí mismo, \w para|strong="H4616"\w* \w que|strong="H4994"\w* \w yo|strong="H4994"\w* \w vea|strong="H7200"\w* \w cómo|strong="H5921"\w* \w lo|strong="H5921"\w* \w hace|strong="H6213"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w lo|strong="H5921"\w* \w dé|strong="H5921"\w* \w de|strong="H5921"\w* su propia \w mano|strong="H3027"\w*”.   
\p
\v 6 Amnón se acostó y fingió estar \w enfermo|strong="H2470"\w*. Cuando el \w rey|strong="H4428"\w* fue \w a|strong="H3068"\w* verlo, Amnón \w le|strong="H5869"\w* pidió: \w Por|strong="H3027"\w* favor, deja \w que|strong="H4994"\w* \w mi|strong="H4994"\w* hermana Tamar venga y prepare un par \w de|strong="H5869"\w* panecillos aquí conmigo, para \w que|strong="H4994"\w* \w yo|strong="H4994"\w* coma \w de|strong="H5869"\w* su propia \w mano|strong="H3027"\w*.   
\p
\v 7 \w David|strong="H1732"\w* \w envió|strong="H7971"\w* un mensaje al palacio de Tamar: “\w Ve|strong="H3212"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de \w tu|strong="H6213"\w* hermano Amnón y prepárale algo de comer”.  
\v 8 Tamar \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H5869"\w* \w su|strong="H1931"\w* hermano Amnón, \w quien|strong="H1931"\w* \w estaba|strong="H7901"\w* \w acostado|strong="H7901"\w*. \w Ella|strong="H1931"\w* \w tomó|strong="H3947"\w* masa, \w la|strong="H1931"\w* amasó y preparó \w los|strong="H1931"\w* panecillos ante \w sus|strong="H1931"\w* \w ojos|strong="H5869"\w*; \w luego|strong="H1931"\w* \w los|strong="H1931"\w* horneó.  
\v 9 \w Tomó|strong="H3947"\w* \w la|strong="H5921"\w* charola \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* sirvió, pero \w él|strong="H5921"\w* \w no|strong="H3985"\w* quiso comer. Amnón ordenó: ¡\w Que|strong="H5921"\w* \w salgan|strong="H3318"\w* \w todos|strong="H3605"\w* \w de|strong="H5921"\w* aquí! \w Y|strong="H3068"\w* \w todos|strong="H3605"\w* \w se|strong="H5921"\w* retiraron.  
\v 10 Entonces Amnón le dijo \w a|strong="H3068"\w* Tamar: Trae la \w comida|strong="H1262"\w* \w a|strong="H3068"\w* mi recámara y dámela \w tú|strong="H6213"\w* misma. Tamar \w tomó|strong="H3947"\w* los panecillos \w que|strong="H3027"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* y se los \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* su hermano Amnón \w a|strong="H3068"\w* su cuarto.  
\v 11 Pero cuando ella se \w acercó|strong="H5066"\w* \w para|strong="H5973"\w* darle \w de|strong="H5973"\w* comer, \w él|strong="H5973"\w* la agarró y \w le|strong="H5973"\w* dijo: Ven, hermana mía, \w acuéstate|strong="H7901"\w* \w conmigo|strong="H5973"\w*.   
\p
\v 12 ¡\w No|strong="H3808"\w*, hermano mío! respondió ella. ¡\w No|strong="H3808"\w* \w me|strong="H3588"\w* obligues! \w Eso|strong="H3651"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* debe \w hacer|strong="H6213"\w* \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*. ¡\w No|strong="H3808"\w* cometas \w semejante|strong="H3651"\w* locura!  
\v 13 ¿\w A|strong="H3068"\w* dónde iría \w yo|strong="H4480"\w* \w con|strong="H4480"\w* \w mi|strong="H1961"\w* vergüenza? \w Y|strong="H3068"\w* tú quedarías \w como|strong="H3588"\w* un infame ante todo \w Israel|strong="H3478"\w*. \w Por|strong="H3588"\w* favor, \w habla|strong="H1696"\w* \w con|strong="H4480"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w*; \w él|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* opondrá \w a|strong="H3068"\w* \w que|strong="H3588"\w* \w nos|strong="H4480"\w* casemos.   
\p
\v 14 Pero él \w no|strong="H3808"\w* quiso escucharla. Como era \w más|strong="H4480"\w* fuerte \w que|strong="H4480"\w* \w ella|strong="H4480"\w*, la violó y \w se|strong="H3808"\w* acostó \w con|strong="H4480"\w* \w ella|strong="H4480"\w*.  
\v 15 Inmediatamente después, Amnón sintió \w por|strong="H3588"\w* ella un \w odio|strong="H8135"\w* terrible. \w El|strong="H3588"\w* \w odio|strong="H8135"\w* \w que|strong="H3588"\w* ahora sentía era \w mucho|strong="H3966"\w* \w mayor|strong="H1419"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* amor \w que|strong="H3588"\w* le \w había|strong="H3588"\w* tenido. ¡\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* lárgate! le gritó Amnón.   
\p
\v 16 ¡\w No|strong="H3808"\w*! respondió ella. ¡Echarme ahora sería un \w mal|strong="H7451"\w* peor \w que|strong="H3808"\w* \w el|strong="H5973"\w* \w que|strong="H3808"\w* ya \w me|strong="H5973"\w* has \w hecho|strong="H6213"\w*! Pero \w él|strong="H5973"\w* \w no|strong="H3808"\w* quiso escucharla.   
\p
\v 17 \w Al|strong="H5921"\w* contrario, \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* su sirviente personal \w y|strong="H5921"\w* \w le|strong="H5921"\w* ordenó: ¡Saca \w de|strong="H5921"\w* aquí \w a|strong="H3068"\w* \w esta|strong="H2063"\w* mujer \w y|strong="H5921"\w* cierra \w la|strong="H5921"\w* \w puerta|strong="H1817"\w* \w con|strong="H5921"\w* seguro!   
\p
\v 18 \w Ella|strong="H5921"\w* llevaba \w puesto|strong="H3588"\w* un \w vestido|strong="H3847"\w* \w de|strong="H5921"\w* muchos colores, \w que|strong="H3588"\w* era \w la|strong="H5921"\w* ropa \w que|strong="H3588"\w* usaban \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* solteras \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. \w El|strong="H5921"\w* sirviente \w la|strong="H5921"\w* \w sacó|strong="H3318"\w* \w y|strong="H3588"\w* cerró \w la|strong="H5921"\w* \w puerta|strong="H1817"\w* tras \w ella|strong="H5921"\w*.  
\v 19 Entonces Tamar \w se|strong="H5921"\w* echó ceniza \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w rasgó|strong="H7167"\w* su vestido \w de|strong="H5921"\w* colores \w y|strong="H5921"\w*, \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w se|strong="H5921"\w* \w fue|strong="H3212"\w* llorando \w a|strong="H3068"\w* gritos.  
\v 20 \w Su|strong="H1931"\w* hermano Absalón \w le|strong="H1931"\w* preguntó: ¿Acaso tu hermano Amnón ha \w estado|strong="H1961"\w* \w contigo|strong="H5973"\w*? Mira, hermana mía, \w por|strong="H1697"\w* \w ahora|strong="H6258"\w* cállate; al fin y al \w que|strong="H1931"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* tu hermano. \w No|strong="H1961"\w* \w te|strong="H5973"\w* tomes \w esto|strong="H2088"\w* \w tan|strong="H1931"\w* \w a|strong="H3068"\w* pecho. \w Y|strong="H3068"\w* Tamar \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* viviendo \w en|strong="H5973"\w* \w casa|strong="H1004"\w* \w de|strong="H5973"\w* \w su|strong="H1931"\w* hermano Absalón, triste y desolada.   
\p
\v 21 Cuando \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* se enteró \w de|strong="H1697"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* había pasado, se puso furioso.  
\v 22 Absalón, \w por|strong="H5921"\w* \w su|strong="H3588"\w* parte, \w no|strong="H3808"\w* \w le|strong="H5921"\w* dirigió \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w a|strong="H3068"\w* Amnón \w para|strong="H5704"\w* \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* \w para|strong="H5704"\w* \w bien|strong="H2896"\w* \w ni|strong="H3808"\w* \w para|strong="H5704"\w* \w mal|strong="H7451"\w*, \w porque|strong="H3588"\w* \w lo|strong="H1697"\w* odiaba \w por|strong="H5921"\w* \w haber|strong="H3808"\w* violado \w a|strong="H3068"\w* \w su|strong="H3588"\w* hermana Tamar.   
