\v 11 \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H3588"\w* nombré \w jueces|strong="H8199"\w* \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. \w Yo|strong="H4480"\w* \w te|strong="H5921"\w* daré descanso \w de|strong="H4480"\w* \w todos|strong="H3605"\w* tus enemigos, \w y|strong="H3588"\w* \w te|strong="H5921"\w* \w anuncio|strong="H5046"\w* \w que|strong="H3588"\w* \w yo|strong="H4480"\w*, \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w te|strong="H5921"\w* daré una dinastía.  
\v 12 \w Cuando|strong="H3588"\w* se acaben tus \w días|strong="H3117"\w* \w y|strong="H3588"\w* descanses \w con|strong="H3588"\w* tus antepasados, elegiré \w a|strong="H3068"\w* uno \w de|strong="H3588"\w* tus propios \w hijos|strong="H2233"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* sea tu sucesor, \w y|strong="H3588"\w* afirmaré \w su|strong="H3588"\w* \w reino|strong="H4467"\w*.  
\v 13 \w Él|strong="H1931"\w* \w será|strong="H1931"\w* \w quien|strong="H1931"\w* construya una \w casa|strong="H1004"\w* \w en|strong="H5704"\w* mi honor, \w y|strong="H5704"\w* yo afirmaré \w su|strong="H1931"\w* \w trono|strong="H3678"\w* \w real|strong="H4467"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 14 Yo \w seré|strong="H1961"\w* \w para|strong="H1961"\w* \w él|strong="H1931"\w* un padre, y \w él|strong="H1931"\w* \w será|strong="H1961"\w* \w para|strong="H1961"\w* \w mí|strong="H1961"\w* un \w hijo|strong="H1121"\w*. \w Si|strong="H1931"\w* hace algo malo, \w lo|strong="H1931"\w* corregiré con \w vara|strong="H7626"\w* y con azotes, \w como|strong="H1961"\w* \w lo|strong="H1931"\w* hace cualquier padre;  
\v 15 pero \w nunca|strong="H3808"\w* \w le|strong="H5973"\w* retiraré mi amor, \w como|strong="H5973"\w* \w se|strong="H3808"\w* \w lo|strong="H3808"\w* retiré \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, \w a|strong="H3068"\w* quien \w quité|strong="H5493"\w* \w de|strong="H4480"\w* tu camino.  
