\h GÉNESIS 
\toc3 Génesis 
\toc1 LIBRO PRIMERO DE MOISÉS, COMÚNMENTE LLAMADO GÉNESIS 
\toc2 GÉNESIS 
\mt2 Libro primero de Moisés,  
\mt3 comúnmente llamado  
\mt1 Génesis  
\c 1  
\p
\v 1 En el \w principio|strong="H7225"\w*, Dios\f + \fr 1:1 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* creó los \w cielos|strong="H8064"\w* y la tierra.  
\v 2 \w La|strong="H5921"\w* tierra \w no|strong="H1961"\w* \w tenía|strong="H1961"\w* forma \w y|strong="H5921"\w* \w estaba|strong="H1961"\w* vacía. \w Las|strong="H5921"\w* \w tinieblas|strong="H2822"\w* cubrían \w el|strong="H5921"\w* \w abismo|strong="H8415"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios \w se|strong="H1961"\w* movía \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*.   
\p
\v 3 Dios dijo: “\w Que|strong="H1961"\w* \w se|strong="H1961"\w* haga la luz”, y \w se|strong="H1961"\w* hizo la luz.  
\v 4 Dios \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* luz era \w buena|strong="H2896"\w* \w y|strong="H3588"\w* separó \w la|strong="H3588"\w* luz \w de|strong="H3588"\w* las \w tinieblas|strong="H2822"\w*.  
\v 5 Dios \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* la luz “\w día|strong="H3117"\w*”, y \w a|strong="H3068"\w* las \w tinieblas|strong="H2822"\w* las \w llamó|strong="H7121"\w* “\w noche|strong="H3915"\w*”. \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: el primer \w día|strong="H3117"\w*.   
\p
\v 6 Dios dijo: “\w Que|strong="H4325"\w* \w haya|strong="H1961"\w* una bóveda \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H4325"\w* las \w aguas|strong="H4325"\w*, \w para|strong="H1961"\w* \w que|strong="H4325"\w* separe unas \w aguas|strong="H4325"\w* \w de|strong="H4325"\w* otras”.  
\v 7 Dios \w hizo|strong="H6213"\w* \w la|strong="H5921"\w* bóveda \w y|strong="H5921"\w* separó \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* \w debajo|strong="H8478"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* bóveda \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* arriba \w de|strong="H5921"\w* \w ella|strong="H5921"\w*; \w y|strong="H5921"\w* \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.  
\v 8 Dios \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* la bóveda “\w cielo|strong="H8064"\w*”. \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: el \w segundo|strong="H8145"\w* \w día|strong="H3117"\w*.   
\p
\v 9 Dios dijo: “\w Que|strong="H4325"\w* las \w aguas|strong="H4325"\w* \w que|strong="H4325"\w* \w están|strong="H1961"\w* \w debajo|strong="H8478"\w* del \w cielo|strong="H8064"\w* \w se|strong="H1961"\w* junten \w en|strong="H8478"\w* un solo \w lugar|strong="H4725"\w*, y \w que|strong="H4325"\w* \w aparezca|strong="H7200"\w* lo seco”; y \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.  
\v 10 Dios \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* lo seco “\w tierra|strong="H3004"\w*”, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* reunión \w de|strong="H3588"\w* las \w aguas|strong="H4325"\w* \w la|strong="H3588"\w* \w llamó|strong="H7121"\w* “\w mares|strong="H3220"\w*”. \w Y|strong="H3068"\w* \w vio|strong="H7200"\w* Dios \w que|strong="H3588"\w* era \w bueno|strong="H2896"\w*.  
\v 11 \w Luego|strong="H3651"\w* Dios dijo: “\w Que|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w produzca|strong="H1877"\w* vegetación: plantas \w que|strong="H5921"\w* den semilla \w y|strong="H5921"\w* \w árboles|strong="H6086"\w* frutales \w que|strong="H5921"\w* den \w fruto|strong="H6529"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w según|strong="H5921"\w* su \w especie|strong="H4327"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* su semilla \w en|strong="H5921"\w* \w él|strong="H5921"\w*”; \w y|strong="H5921"\w* \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.  
\v 12 \w La|strong="H3588"\w* tierra produjo vegetación: plantas \w que|strong="H3588"\w* dan semilla según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*, \w y|strong="H3588"\w* \w árboles|strong="H6086"\w* \w que|strong="H3588"\w* dan \w fruto|strong="H6529"\w* \w con|strong="H3588"\w* \w su|strong="H3588"\w* semilla \w en|strong="H3588"\w* \w él|strong="H3588"\w*, según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*. \w Y|strong="H3068"\w* \w vio|strong="H7200"\w* Dios \w que|strong="H3588"\w* era \w bueno|strong="H2896"\w*.  
\v 13 \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: el tercer \w día|strong="H3117"\w*.   
\p
\v 14 Dios dijo: “\w Que|strong="H3117"\w* \w haya|strong="H1961"\w* luces en la bóveda del \w cielo|strong="H8064"\w* \w para|strong="H1961"\w* separar el \w día|strong="H3117"\w* de la \w noche|strong="H3915"\w*; \w que|strong="H3117"\w* sirvan \w como|strong="H1961"\w* señales \w para|strong="H1961"\w* las estaciones, \w los|strong="H1961"\w* \w días|strong="H3117"\w* y \w los|strong="H1961"\w* \w años|strong="H8141"\w*,  
\v 15 \w y|strong="H5921"\w* \w que|strong="H5921"\w* brillen \w en|strong="H5921"\w* \w la|strong="H5921"\w* bóveda \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w para|strong="H5921"\w* iluminar \w la|strong="H5921"\w* tierra”; \w y|strong="H5921"\w* \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.  
\v 16 Dios \w hizo|strong="H6213"\w* las \w dos|strong="H8147"\w* \w grandes|strong="H1419"\w* luces: la luz \w mayor|strong="H1419"\w* para dominar \w el|strong="H6213"\w* \w día|strong="H3117"\w* y la luz \w menor|strong="H6996"\w* para dominar la \w noche|strong="H3915"\w*. También \w hizo|strong="H6213"\w* las \w estrellas|strong="H3556"\w*.  
\v 17 Dios \w las|strong="H5921"\w* \w puso|strong="H5414"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* bóveda \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w para|strong="H5921"\w* iluminar \w la|strong="H5921"\w* tierra,  
\v 18 \w para|strong="H3588"\w* dominar \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w noche|strong="H3915"\w*, \w y|strong="H3588"\w* \w para|strong="H3588"\w* separar \w la|strong="H3588"\w* luz \w de|strong="H3588"\w* las \w tinieblas|strong="H2822"\w*. \w Y|strong="H3068"\w* \w vio|strong="H7200"\w* Dios \w que|strong="H3588"\w* era \w bueno|strong="H2896"\w*.  
\v 19 \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: el \w cuarto|strong="H7243"\w* \w día|strong="H3117"\w*.   
\p
\v 20 Dios dijo: “\w Que|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H5921"\w* llenen \w de|strong="H5921"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w*, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* vuelen \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w en|strong="H5921"\w* \w la|strong="H5921"\w* abierta \w expansión|strong="H7549"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*”.  
\v 21 Dios creó las \w grandes|strong="H1419"\w* criaturas marinas \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w* \w que|strong="H3588"\w* se mueven \w y|strong="H3588"\w* pululan \w en|strong="H3588"\w* las \w aguas|strong="H4325"\w*, según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*, \w y|strong="H3588"\w* \w toda|strong="H3605"\w* \w ave|strong="H5775"\w* \w alada|strong="H3671"\w* según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*. \w Y|strong="H3068"\w* \w vio|strong="H7200"\w* Dios \w que|strong="H3588"\w* era \w bueno|strong="H2896"\w*.  
\v 22 Dios los \w bendijo|strong="H1288"\w* diciendo: “Sean fecundos y multiplíquense; llenen las \w aguas|strong="H4325"\w* \w de|strong="H4325"\w* los \w mares|strong="H3220"\w* y \w que|strong="H4325"\w* las \w aves|strong="H5775"\w* se multipliquen en la tierra”.  
\v 23 \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: el \w quinto|strong="H2549"\w* \w día|strong="H3117"\w*.   
\p
\v 24 Dios dijo: “\w Que|strong="H1961"\w* la tierra \w produzca|strong="H3318"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w* según su \w especie|strong="H4327"\w*: ganado, \w reptiles|strong="H7431"\w* y \w animales|strong="H2416"\w* salvajes según su \w especie|strong="H4327"\w*”; y \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.  
\v 25 Dios \w hizo|strong="H6213"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*, \w el|strong="H3588"\w* ganado según \w su|strong="H3588"\w* \w especie|strong="H4327"\w* \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* se arrastra \w por|strong="H3588"\w* \w el|strong="H3588"\w* suelo según \w su|strong="H3588"\w* \w especie|strong="H4327"\w*. \w Y|strong="H3068"\w* \w vio|strong="H7200"\w* Dios \w que|strong="H3588"\w* era \w bueno|strong="H2896"\w*.   
\p
\v 26 Entonces Dios dijo: “\w Hagamos|strong="H6213"\w* \w al|strong="H5921"\w* hombre \w a|strong="H3068"\w* nuestra \w imagen|strong="H6754"\w*, \w conforme|strong="H5921"\w* \w a|strong="H3068"\w* nuestra \w semejanza|strong="H1823"\w*. \w Que|strong="H5921"\w* tenga dominio \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w peces|strong="H1710"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*, \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w el|strong="H5921"\w* ganado, \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w animal|strong="H7431"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* arrastra \w por|strong="H5921"\w* \w ella|strong="H5921"\w*”.  
\v 27 \w Y|strong="H3068"\w* Dios creó al hombre \w a|strong="H3068"\w* su \w imagen|strong="H6754"\w*, \w a|strong="H3068"\w* \w imagen|strong="H6754"\w* de Dios lo creó; hombre y mujer los creó.  
\v 28 Dios \w los|strong="H5921"\w* \w bendijo|strong="H1288"\w* \w y|strong="H5921"\w* \w les|strong="H5921"\w* dijo: “Sean fecundos \w y|strong="H5921"\w* multiplíquense; llenen \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* sométanla. Dominen \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w peces|strong="H1710"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*, \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres \w vivos|strong="H2416"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* mueven \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra”.  
\v 29 También dijo Dios: “Miren,\f + \fr 1:29 \ft “He aquí”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* \w les|strong="H5921"\w* he \w dado|strong="H5414"\w* \w toda|strong="H3605"\w* planta \w que|strong="H5921"\w* \w da|strong="H5414"\w* semilla, \w que|strong="H5921"\w* \w está|strong="H1961"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w árbol|strong="H6086"\w* \w que|strong="H5921"\w* \w da|strong="H5414"\w* \w fruto|strong="H6529"\w* \w con|strong="H5921"\w* semilla. Esto \w les|strong="H5921"\w* \w servirá|strong="H1961"\w* \w de|strong="H5921"\w* alimento.  
\v 30 \w A|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* arrastra \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w tiene|strong="H1961"\w* \w vida|strong="H5315"\w*, \w les|strong="H5921"\w* doy \w toda|strong="H3605"\w* planta \w verde|strong="H3418"\w* \w como|strong="H1961"\w* alimento”; \w y|strong="H5921"\w* \w así|strong="H3651"\w* \w fue|strong="H1961"\w*.   
\p
\v 31 Dios \w vio|strong="H7200"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3117"\w* \w había|strong="H1961"\w* \w hecho|strong="H6213"\w*, y \w todo|strong="H3605"\w* \w era|strong="H1961"\w* \w muy|strong="H3966"\w* \w bueno|strong="H2896"\w*. \w Hubo|strong="H1961"\w* \w tarde|strong="H6153"\w* y \w hubo|strong="H1961"\w* \w mañana|strong="H1242"\w*: \w el|strong="H3605"\w* \w sexto|strong="H8345"\w* \w día|strong="H3117"\w*.   
\c 2  
\p
\v 1 Así quedaron terminados \w los|strong="H3605"\w* \w cielos|strong="H8064"\w* y \w la|strong="H3605"\w* tierra, y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* hay en \w ellos|strong="H3605"\w*.  
\v 2 Al llegar \w el|strong="H3605"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, Dios terminó \w la|strong="H3605"\w* \w obra|strong="H4399"\w* \w que|strong="H3117"\w* \w había|strong="H6213"\w* estado \w haciendo|strong="H6213"\w*, y descansó de \w toda|strong="H3605"\w* su \w labor|strong="H4399"\w*.  
\v 3 Dios \w bendijo|strong="H1288"\w* \w el|strong="H3588"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w y|strong="H3588"\w* \w lo|strong="H6213"\w* declaró \w santo|strong="H6942"\w*, \w porque|strong="H3588"\w* \w en|strong="H3588"\w* ese \w día|strong="H3117"\w* descansó \w de|strong="H3588"\w* \w toda|strong="H3605"\w* \w su|strong="H3588"\w* \w obra|strong="H4399"\w* \w de|strong="H3588"\w* creación.   
\p
\v 4 Ésta es la historia de la creación de los \w cielos|strong="H8064"\w* y de la tierra. \w Cuando|strong="H3117"\w* Yahvé \w Dios|strong="H3068"\w* \w hizo|strong="H6213"\w* la tierra y los \w cielos|strong="H8064"\w*,  
\v 5 \w aún|strong="H2962"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w ningún|strong="H3605"\w* arbusto \w del|strong="H5921"\w* \w campo|strong="H7704"\w*, \w ni|strong="H3808"\w* \w había|strong="H1961"\w* brotado \w ninguna|strong="H3605"\w* \w hierba|strong="H6212"\w*, \w porque|strong="H3588"\w* Yahvé \w Dios|strong="H3068"\w* \w todavía|strong="H2962"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* \w hecho|strong="H1961"\w* llover \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w ni|strong="H3808"\w* \w había|strong="H1961"\w* \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* \w la|strong="H5921"\w* cultivara.  
\v 6 \w En|strong="H4480"\w* lugar \w de|strong="H4480"\w* eso, \w subía|strong="H5927"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* tierra un vapor \w que|strong="H4480"\w* regaba \w toda|strong="H3605"\w* \w la|strong="H3605"\w* superficie \w del|strong="H4480"\w* suelo.  
\v 7 Entonces Yahvé \w Dios|strong="H3068"\w* \w formó|strong="H3335"\w* \w al|strong="H4480"\w* hombre \w del|strong="H4480"\w* \w polvo|strong="H6083"\w* \w de|strong="H4480"\w* la \w tierra|strong="H6083"\w*, \w sopló|strong="H5397"\w* \w en|strong="H4480"\w* su nariz aliento \w de|strong="H4480"\w* \w vida|strong="H5315"\w*, y el hombre \w se|strong="H1961"\w* convirtió \w en|strong="H4480"\w* un \w ser|strong="H5315"\w* \w viviente|strong="H2416"\w*.  
\v 8 Yahvé \w Dios|strong="H3068"\w* \w plantó|strong="H5193"\w* un jardín en una región llamada Edén, en el \w oriente|strong="H6924"\w*, y \w allí|strong="H8033"\w* \w puso|strong="H7760"\w* al hombre que había formado.  
\v 9 Yahvé \w Dios|strong="H3068"\w* hizo \w que|strong="H4480"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* tierra creciera \w toda|strong="H3605"\w* clase \w de|strong="H4480"\w* \w árboles|strong="H6086"\w* \w hermosos|strong="H2896"\w* y \w buenos|strong="H2896"\w* \w para|strong="H4480"\w* comer. \w En|strong="H4480"\w* \w medio|strong="H8432"\w* \w del|strong="H4480"\w* jardín estaban también \w el|strong="H3605"\w* \w árbol|strong="H6086"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w vida|strong="H2416"\w* y \w el|strong="H3605"\w* \w árbol|strong="H6086"\w* \w del|strong="H4480"\w* \w conocimiento|strong="H1847"\w* \w del|strong="H4480"\w* \w bien|strong="H2896"\w* y \w del|strong="H4480"\w* \w mal|strong="H7451"\w*.  
\v 10 Del Edén \w salía|strong="H3318"\w* un \w río|strong="H5104"\w* \w que|strong="H1961"\w* regaba el jardín, y de \w allí|strong="H8033"\w* \w se|strong="H1961"\w* dividía \w en|strong="H3318"\w* cuatro brazos.  
\v 11 \w El|strong="H1931"\w* primero \w se|strong="H1931"\w* \w llama|strong="H8034"\w* Pisón, y \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* rodea \w toda|strong="H3605"\w* \w la|strong="H1931"\w* tierra de Javilá, \w donde|strong="H8033"\w* hay \w oro|strong="H2091"\w*.  
\v 12 \w El|strong="H1931"\w* \w oro|strong="H2091"\w* de \w esa|strong="H1931"\w* tierra \w es|strong="H1931"\w* de muy \w buena|strong="H2896"\w* calidad; también hay \w allí|strong="H8033"\w* resina aromática y piedras de ónice.  
\v 13 \w El|strong="H1931"\w* \w segundo|strong="H8145"\w* \w río|strong="H5104"\w* \w se|strong="H1931"\w* \w llama|strong="H8034"\w* Guijón, y \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* rodea \w toda|strong="H3605"\w* \w la|strong="H1931"\w* tierra de Cus.  
\v 14 \w El|strong="H1931"\w* tercer \w río|strong="H5104"\w* \w se|strong="H1931"\w* \w llama|strong="H8034"\w* Tigris, y \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* corre al oriente de Asiria. \w El|strong="H1931"\w* \w cuarto|strong="H7243"\w* \w río|strong="H5104"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w Éufrates|strong="H6578"\w*.  
\v 15 Yahvé \w Dios|strong="H3068"\w* \w tomó|strong="H3947"\w* al hombre y lo \w puso|strong="H3240"\w* en el jardín del Edén para que lo cultivara y lo cuidara.  
\v 16 \w Y|strong="H3068"\w* Yahvé \w Dios|strong="H3068"\w* \w le|strong="H5921"\w* dio \w al|strong="H5921"\w* hombre \w esta|strong="H5921"\w* \w orden|strong="H6680"\w*: “Puedes comer \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w árboles|strong="H6086"\w* \w del|strong="H5921"\w* jardín,  
\v 17 \w pero|strong="H3588"\w* \w no|strong="H3808"\w* comas \w del|strong="H4480"\w* \w árbol|strong="H6086"\w* \w del|strong="H4480"\w* \w conocimiento|strong="H1847"\w* \w del|strong="H4480"\w* \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w del|strong="H4480"\w* \w mal|strong="H7451"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* comas \w de|strong="H4480"\w* \w él|strong="H3588"\w*, \w de|strong="H4480"\w* \w cierto|strong="H3588"\w* \w morirás|strong="H4191"\w*”.   
\p
\v 18 Luego Yahvé \w Dios|strong="H3068"\w* dijo: “\w No|strong="H3808"\w* \w es|strong="H1961"\w* \w bueno|strong="H2896"\w* \w que|strong="H3808"\w* \w el|strong="H6213"\w* hombre \w esté|strong="H1961"\w* solo. Voy \w a|strong="H3068"\w* \w hacerle|strong="H6213"\w* una \w ayuda|strong="H5828"\w* adecuada”.  
\v 19 Yahvé \w Dios|strong="H3068"\w* \w formó|strong="H3335"\w* \w de|strong="H4480"\w* \w la|strong="H1931"\w* tierra \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* \w del|strong="H4480"\w* \w campo|strong="H7704"\w* y \w todas|strong="H3605"\w* las \w aves|strong="H5775"\w* \w del|strong="H4480"\w* \w cielo|strong="H8064"\w*, y \w se|strong="H1931"\w* \w los|strong="H3605"\w* llevó \w al|strong="H4480"\w* hombre \w para|strong="H4480"\w* \w ver|strong="H7200"\w* \w qué|strong="H4100"\w* \w nombre|strong="H8034"\w* les ponía. \w El|strong="H1931"\w* \w nombre|strong="H8034"\w* \w que|strong="H4100"\w* \w el|strong="H1931"\w* hombre \w le|strong="H1931"\w* dio \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w ser|strong="H5315"\w* \w viviente|strong="H2416"\w*, \w ése|strong="H1931"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* quedó.  
\v 20 Así \w el|strong="H3605"\w* hombre les puso \w nombre|strong="H8034"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* domésticos, \w a|strong="H3068"\w* las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* salvajes. \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w se|strong="H3808"\w* encontró \w entre|strong="H3808"\w* \w ellos|strong="H3605"\w* \w una|strong="H4672"\w* \w ayuda|strong="H5828"\w* adecuada para \w el|strong="H3605"\w* hombre.  
\v 21 Entonces Yahvé \w Dios|strong="H3068"\w* \w hizo|strong="H5307"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* hombre cayera \w en|strong="H5921"\w* un sueño profundo \w y|strong="H5921"\w*, mientras \w dormía|strong="H3462"\w*, \w le|strong="H5921"\w* sacó una \w de|strong="H5921"\w* sus costillas \w y|strong="H5921"\w* \w cerró|strong="H5462"\w* \w la|strong="H5921"\w* \w carne|strong="H1320"\w* \w en|strong="H5921"\w* ese \w lugar|strong="H8478"\w*.  
\v 22 \w De|strong="H4480"\w* esa costilla Yahvé \w Dios|strong="H3068"\w* \w hizo|strong="H1129"\w* una mujer, y \w se|strong="H4480"\w* la presentó \w al|strong="H4480"\w* hombre.  
\v 23 Al verla, \w el|strong="H3588"\w* hombre exclamó: “¡\w Ésta|strong="H2063"\w* \w sí|strong="H3588"\w* \w es|strong="H3588"\w* \w hueso|strong="H6106"\w* \w de|strong="H3588"\w* mis \w huesos|strong="H6106"\w* \w y|strong="H3588"\w* \w carne|strong="H1320"\w* \w de|strong="H3588"\w* mi \w carne|strong="H1320"\w*! Se \w llamará|strong="H7121"\w* ‘mujer’, \w porque|strong="H3588"\w* del hombre fue sacada”.  
\v 24 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w el|strong="H5921"\w* hombre \w deja|strong="H5800"\w* \w a|strong="H3068"\w* su padre \w y|strong="H5921"\w* \w a|strong="H3068"\w* su madre, \w y|strong="H5921"\w* \w se|strong="H1961"\w* une \w a|strong="H3068"\w* su mujer, \w y|strong="H5921"\w* \w los|strong="H5921"\w* dos \w se|strong="H1961"\w* funden \w en|strong="H5921"\w* un solo ser.  
\v 25 Tanto el hombre \w como|strong="H1961"\w* su mujer \w estaban|strong="H1961"\w* \w desnudos|strong="H6174"\w*, pero \w ninguno|strong="H3808"\w* de \w los|strong="H1961"\w* \w dos|strong="H8147"\w* sentía vergüenza.   
\c 3  
\p
\v 1 \w La|strong="H3588"\w* \w serpiente|strong="H5175"\w* \w era|strong="H1961"\w* \w más|strong="H3588"\w* \w astuta|strong="H6175"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* salvajes \w que|strong="H3588"\w* Yahvé \w Dios|strong="H3068"\w* \w había|strong="H1961"\w* creado. \w Ella|strong="H3605"\w* le preguntó \w a|strong="H3068"\w* \w la|strong="H3588"\w* mujer: “¿\w De|strong="H3588"\w* veras \w Dios|strong="H3068"\w* les dijo \w que|strong="H3588"\w* \w no|strong="H3808"\w* comieran \w de|strong="H3588"\w* \w ningún|strong="H3605"\w* \w árbol|strong="H6086"\w* del jardín?”   
\p
\v 2 La mujer le respondió: “Podemos comer del \w fruto|strong="H6529"\w* de los \w árboles|strong="H6086"\w* del jardín.  
\v 3 Pero \w en|strong="H4480"\w* cuanto \w al|strong="H4480"\w* \w fruto|strong="H6529"\w* \w del|strong="H4480"\w* \w árbol|strong="H6086"\w* \w que|strong="H4480"\w* está \w en|strong="H4480"\w* \w medio|strong="H8432"\w* \w del|strong="H4480"\w* jardín, Dios \w nos|strong="H4480"\w* dijo: ‘\w No|strong="H3808"\w* coman \w de|strong="H4480"\w* él, \w ni|strong="H3808"\w* \w lo|strong="H3808"\w* \w toquen|strong="H5060"\w*, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w*’”.   
\p
\v 4 Pero la \w serpiente|strong="H5175"\w* le dijo \w a|strong="H3068"\w* la mujer: “¡\w No|strong="H3808"\w* es \w cierto|strong="H3808"\w*, \w no|strong="H3808"\w* \w morirán|strong="H4191"\w*!  
\v 5 Dios \w sabe|strong="H3045"\w* muy \w bien|strong="H2896"\w* \w que|strong="H3588"\w*, \w cuando|strong="H3588"\w* ustedes coman \w de|strong="H4480"\w* ese árbol, \w se|strong="H3045"\w* les abrirán \w los|strong="H1961"\w* \w ojos|strong="H5869"\w* \w y|strong="H3588"\w* \w serán|strong="H1961"\w* \w como|strong="H3588"\w* Dios, conocedores \w del|strong="H4480"\w* \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w del|strong="H4480"\w* \w mal|strong="H7451"\w*”.   
\p
\v 6 \w La|strong="H1931"\w* mujer \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w fruto|strong="H6529"\w* \w del|strong="H5973"\w* \w árbol|strong="H6086"\w* \w era|strong="H1931"\w* \w bueno|strong="H2896"\w* \w para|strong="H3588"\w* comer, \w y|strong="H1571"\w* \w que|strong="H3588"\w* \w tenía|strong="H1931"\w* un aspecto encantador \w y|strong="H1571"\w* \w era|strong="H1931"\w* deseable \w para|strong="H3588"\w* alcanzar sabiduría. \w Así|strong="H1571"\w* \w que|strong="H3588"\w* \w tomó|strong="H3947"\w* un \w fruto|strong="H6529"\w* \w y|strong="H1571"\w* \w se|strong="H1931"\w* \w lo|strong="H1931"\w* comió. \w Luego|strong="H1931"\w* \w le|strong="H1931"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* esposo, \w que|strong="H3588"\w* estaba \w con|strong="H5973"\w* \w ella|strong="H1931"\w*, \w y|strong="H1571"\w* \w él|strong="H1931"\w* \w también|strong="H1571"\w* comió.  
\v 7 \w En|strong="H3588"\w* ese momento \w se|strong="H3045"\w* \w les|strong="H1992"\w* abrirán \w los|strong="H1992"\w* \w ojos|strong="H5869"\w* \w y|strong="H3588"\w* \w se|strong="H3045"\w* dieron cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* estaban desnudos. \w Entonces|strong="H3588"\w* cosieron \w hojas|strong="H5929"\w* \w de|strong="H3588"\w* higuera \w para|strong="H3588"\w* cubrirse.  
\v 8 \w Cuando|strong="H3117"\w* \w oyeron|strong="H8085"\w* \w que|strong="H3117"\w* Yahvé \w Dios|strong="H3068"\w* se paseaba \w por|strong="H6440"\w* el jardín \w a|strong="H3068"\w* la hora \w en|strong="H8432"\w* \w que|strong="H3117"\w* sopla el \w viento|strong="H7307"\w* \w de|strong="H6440"\w* la tarde, el hombre y su mujer se escondieron \w de|strong="H6440"\w* su \w presencia|strong="H6440"\w* \w entre|strong="H8432"\w* los \w árboles|strong="H6086"\w* del jardín.   
\p
\v 9 Pero Yahvé \w Dios|strong="H3068"\w* \w llamó|strong="H7121"\w* al hombre y le preguntó: “¿Dónde estás?”   
\p
\v 10 \w El|strong="H3588"\w* hombre respondió: “\w Oí|strong="H8085"\w* tus pasos \w por|strong="H3588"\w* \w el|strong="H3588"\w* jardín \w y|strong="H3588"\w* tuve \w miedo|strong="H3372"\w* \w porque|strong="H3588"\w* estoy desnudo; \w por|strong="H3588"\w* eso \w me|strong="H3588"\w* \w escondí|strong="H2244"\w*”.   
\p
\v 11 “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* \w te|strong="H4480"\w* \w dijo|strong="H5046"\w* \w que|strong="H3588"\w* estás desnudo? \w le|strong="H4310"\w* preguntó Dios. ¿Acaso has comido \w del|strong="H4480"\w* \w árbol|strong="H6086"\w* \w que|strong="H3588"\w* \w te|strong="H4480"\w* prohibí comer?”   
\p
\v 12 \w El|strong="H1931"\w* hombre contestó: “\w La|strong="H1931"\w* mujer \w que|strong="H4480"\w* \w me|strong="H4480"\w* \w diste|strong="H5414"\w* \w por|strong="H4480"\w* compañera \w me|strong="H4480"\w* \w dio|strong="H5414"\w* \w del|strong="H4480"\w* fruto \w de|strong="H4480"\w* \w ese|strong="H1931"\w* \w árbol|strong="H6086"\w*, y \w yo|strong="H4480"\w* comí”.   
\p
\v 13 Entonces Yahvé \w Dios|strong="H3068"\w* le preguntó \w a|strong="H3068"\w* \w la|strong="H2063"\w* mujer: “¿\w Qué|strong="H4100"\w* \w es|strong="H2063"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* has \w hecho|strong="H6213"\w*?”  
\p “\w La|strong="H2063"\w* \w serpiente|strong="H5175"\w* me engañó, y \w yo|strong="H6213"\w* comí” respondió ella.   
\p
\v 14 \w Entonces|strong="H3117"\w* Yahvé \w Dios|strong="H3068"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w serpiente|strong="H5175"\w*:  
\q1 “\w Por|strong="H5921"\w* haber \w hecho|strong="H6213"\w* \w esto|strong="H2063"\w*, maldita serás  
\q2 \w entre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* domésticos  
\q2 \w y|strong="H3588"\w* \w entre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* salvajes.  
\q1 \w Te|strong="H5921"\w* arrastrarás \w sobre|strong="H5921"\w* \w tu|strong="H6213"\w* vientre,  
\q2 \w y|strong="H3588"\w* comerás \w polvo|strong="H6083"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w tu|strong="H6213"\w* \w vida|strong="H2416"\w*.   
\q1
\v 15 \w Pondré|strong="H7896"\w* enemistad entre ti y \w la|strong="H1931"\w* mujer,  
\q2 y entre tu \w descendencia|strong="H2233"\w* y \w la|strong="H1931"\w* \w suya|strong="H1931"\w*.  
\q1 \w Él|strong="H1931"\w* te aplastará \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w*,  
\q2 y tú \w le|strong="H1931"\w* \w herirás|strong="H7779"\w* \w el|strong="H1931"\w* talón”.   
\p
\v 16 \w A|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w le|strong="H1931"\w* dijo:  
\q1 “Aumentaré \w mucho|strong="H7235"\w* tus dolores \w de|strong="H1121"\w* parto;  
\q2 con dolor darás \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w*.  
\q1 Tu deseo te llevará \w a|strong="H3068"\w* tu esposo,  
\q2 y \w él|strong="H1931"\w* te dominará”.   
\p
\v 17 \w Al|strong="H4480"\w* hombre le dijo:  
\q1 “\w Como|strong="H3588"\w* le hiciste caso \w a|strong="H3068"\w* tu mujer  
\q2 \w y|strong="H3588"\w* comiste \w del|strong="H4480"\w* \w árbol|strong="H6086"\w* \w que|strong="H3588"\w* \w te|strong="H4480"\w* prohibí,  
\q2 \w la|strong="H3588"\w* tierra \w estará|strong="H3605"\w* maldita \w por|strong="H3588"\w* tu culpa.  
\q1 \w Con|strong="H4480"\w* mucho esfuerzo comerás \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H4480"\w* tu \w vida|strong="H2416"\w*.   
\q2
\v 18 La tierra te \w producirá|strong="H6779"\w* \w espinos|strong="H6975"\w* y cardos,  
\q2 y comerás hierbas del \w campo|strong="H7704"\w*.   
\q1
\v 19 \w Te|strong="H4480"\w* ganarás \w el|strong="H3588"\w* \w pan|strong="H3899"\w* \w con|strong="H4480"\w* \w el|strong="H3588"\w* sudor \w de|strong="H4480"\w* tu frente,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w vuelvas|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w tierra|strong="H6083"\w* \w de|strong="H4480"\w* donde fuiste sacado.  
\q1 \w Porque|strong="H3588"\w* eres \w polvo|strong="H6083"\w*,  
\q2 \w y|strong="H3588"\w* \w al|strong="H4480"\w* \w polvo|strong="H6083"\w* \w volverás|strong="H7725"\w*”.   
\p
\v 20 \w El|strong="H1931"\w* hombre \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* mujer \w Eva|strong="H2332"\w*, \w porque|strong="H3588"\w* \w ella|strong="H1931"\w* \w sería|strong="H1961"\w* \w la|strong="H1931"\w* madre \w de|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w vivientes|strong="H2416"\w*.  
\v 21 Yahvé \w Dios|strong="H3068"\w* les \w hizo|strong="H6213"\w* ropa \w de|strong="H3847"\w* \w piel|strong="H5785"\w* al hombre y \w a|strong="H3068"\w* su mujer, y los \w vistió|strong="H3847"\w*.   
\p
\v 22 \w Luego|strong="H6258"\w* Yahvé \w Dios|strong="H3068"\w* dijo: “\w Ahora|strong="H6258"\w* \w el|strong="H1571"\w* hombre \w se|strong="H3045"\w* ha vuelto \w como|strong="H1571"\w* uno \w de|strong="H4480"\w* nosotros, \w pues|strong="H6258"\w* \w conoce|strong="H3045"\w* \w el|strong="H1571"\w* \w bien|strong="H2896"\w* \w y|strong="H1571"\w* \w el|strong="H1571"\w* \w mal|strong="H7451"\w*. \w No|strong="H6435"\w* vaya \w a|strong="H3068"\w* ser \w que|strong="H4480"\w* extienda su \w mano|strong="H3027"\w* \w y|strong="H1571"\w* \w tome|strong="H3947"\w* \w también|strong="H1571"\w* \w del|strong="H4480"\w* \w árbol|strong="H6086"\w* \w de|strong="H4480"\w* \w la|strong="H1571"\w* \w vida|strong="H2416"\w*, \w y|strong="H1571"\w* coma \w de|strong="H4480"\w* \w él|strong="H1571"\w* \w y|strong="H1571"\w* \w viva|strong="H2416"\w* \w para|strong="H4480"\w* \w siempre|strong="H5769"\w*”.  
\v 23 Así que Yahvé \w Dios|strong="H3068"\w* expulsó al hombre del jardín del Edén, para que cultivara la tierra de la cual había sido formado.  
\v 24 Después de expulsar al hombre, puso al \w oriente|strong="H6924"\w* del jardín del Edén \w querubines|strong="H3742"\w*\f + \fr 3:24 \ft Los querubines son poderosas criaturas angélicas, mensajeros de Dios con alas. Véase Ezequiel 10.\f* y una \w espada|strong="H2719"\w* llameante que giraba en todas direcciones para vigilar el \w camino|strong="H1870"\w* que conducía al \w árbol|strong="H6086"\w* de \w la|strong="H8104"\w* \w vida|strong="H2416"\w*.   
\c 4  
\p
\v 1 El hombre tuvo relaciones\f + \fr 4:1 \ft o, yacer con\f* con su mujer \w Eva|strong="H2332"\w*. Ella quedó \w embarazada|strong="H2029"\w*\f + \fr 4:1 \ft o, concibió\f* y dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w Caín|strong="H7014"\w*, y dijo: “Con la ayuda de Yahvé, he tenido un \w hijo|strong="H3205"\w* varón”.  
\v 2 \w Después|strong="H1961"\w* dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w Abel|strong="H1893"\w*, el hermano de \w Caín|strong="H7014"\w*. \w Abel|strong="H1893"\w* \w se|strong="H1961"\w* dedicó \w a|strong="H3068"\w* pastorear \w ovejas|strong="H6629"\w*, mientras \w que|strong="H1961"\w* \w Caín|strong="H7014"\w* \w se|strong="H1961"\w* dedicó \w a|strong="H3068"\w* cultivar la tierra.  
\v 3 \w Tiempo|strong="H3117"\w* \w después|strong="H1961"\w*, \w Caín|strong="H7014"\w* le presentó \w a|strong="H3068"\w* Yahvé una \w ofrenda|strong="H4503"\w* del \w fruto|strong="H6529"\w* de la tierra.  
\v 4 Por \w su|strong="H1931"\w* parte, \w Abel|strong="H1893"\w* \w le|strong="H1931"\w* presentó \w lo|strong="H1931"\w* mejor de las primeras crías de \w su|strong="H1931"\w* \w rebaño|strong="H6629"\w*. Yahvé \w miró|strong="H8159"\w* \w con|strong="H1571"\w* agrado \w a|strong="H3068"\w* \w Abel|strong="H1893"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w ofrenda|strong="H4503"\w*,  
\v 5 pero \w no|strong="H3808"\w* \w miró|strong="H8159"\w* así \w a|strong="H3068"\w* \w Caín|strong="H7014"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* su \w ofrenda|strong="H4503"\w*. \w Por|strong="H6440"\w* eso \w Caín|strong="H7014"\w* \w se|strong="H3808"\w* enfureció y andaba \w muy|strong="H3966"\w* cabizbajo.  
\v 6 Yahvé le preguntó \w a|strong="H3068"\w* \w Caín|strong="H7014"\w*: “¿\w Por|strong="H6440"\w* \w qué|strong="H4100"\w* estás tan \w enojado|strong="H2734"\w*? ¿\w Por|strong="H6440"\w* \w qué|strong="H4100"\w* andas cabizbajo?  
\v 7 \w Si|strong="H3808"\w* hicieras \w lo|strong="H3808"\w* bueno, podrías andar con la frente en alto. Pero, \w si|strong="H3808"\w* haces \w lo|strong="H3808"\w* malo, el \w pecado|strong="H2403"\w* te acecha como una fiera lista para atraparte. \w No|strong="H3808"\w* obstante, tú puedes dominarlo”.  
\v 8 \w Caín|strong="H7014"\w* le dijo \w a|strong="H3068"\w* su hermano \w Abel|strong="H1893"\w*: “Vamos al \w campo|strong="H7704"\w*”. \w Y|strong="H3068"\w* \w sucedió|strong="H1961"\w* \w que|strong="H1961"\w*, mientras \w estaban|strong="H1961"\w* en el \w campo|strong="H7704"\w*, \w Caín|strong="H7014"\w* atacó \w a|strong="H3068"\w* su hermano \w Abel|strong="H1893"\w* y lo \w mató|strong="H2026"\w*.   
\p
\v 9 Entonces Yahvé le preguntó \w a|strong="H3068"\w* \w Caín|strong="H7014"\w*: “¿Dónde está tu hermano \w Abel|strong="H1893"\w*?”  
\p “\w No|strong="H3808"\w* \w lo|strong="H3808"\w* \w sé|strong="H3045"\w* respondió él. ¿Acaso soy yo el guardián de mi hermano?”   
\p
\v 10 “¿\w Qué|strong="H4100"\w* has \w hecho|strong="H6213"\w*? le dijo Yahvé. La \w sangre|strong="H1818"\w* \w de|strong="H4480"\w* \w tu|strong="H6213"\w* hermano \w clama|strong="H6817"\w* \w a|strong="H3068"\w* mí \w desde|strong="H4480"\w* la tierra.  
\v 11 \w Por|strong="H4480"\w* eso, \w ahora|strong="H6258"\w* quedas bajo la maldición \w de|strong="H4480"\w* la tierra, \w que|strong="H4480"\w* \w abrió|strong="H6475"\w* su \w boca|strong="H6310"\w* \w para|strong="H4480"\w* \w recibir|strong="H3947"\w* \w de|strong="H4480"\w* tus \w manos|strong="H3027"\w* la \w sangre|strong="H1818"\w* \w de|strong="H4480"\w* tu hermano.  
\v 12 \w Cuando|strong="H3588"\w* cultives \w la|strong="H3588"\w* tierra, ella \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w dará|strong="H5414"\w* sus frutos. \w Andarás|strong="H5110"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w como|strong="H3588"\w* un fugitivo \w y|strong="H3588"\w* un vagabundo”.   
\p
\v 13 \w Caín|strong="H7014"\w* le dijo \w a|strong="H3068"\w* Yahvé: “\w Mi|strong="H5375"\w* castigo es más de lo que puedo soportar.  
\v 14 \w Hoy|strong="H3117"\w* \w me|strong="H5921"\w* estás expulsando \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w tendré|strong="H1961"\w* \w que|strong="H5921"\w* esconderme \w de|strong="H5921"\w* tu \w presencia|strong="H6440"\w*. Andaré \w por|strong="H5921"\w* \w el|strong="H5921"\w* mundo \w como|strong="H1961"\w* un fugitivo \w y|strong="H5921"\w* un vagabundo, \w y|strong="H5921"\w* \w cualquiera|strong="H3605"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* encuentre \w me|strong="H5921"\w* \w matará|strong="H2026"\w*”.   
\p
\v 15 Pero Yahvé le respondió: “\w No|strong="H1115"\w* será \w así|strong="H3651"\w*. \w El|strong="H3605"\w* \w que|strong="H1115"\w* \w mate|strong="H2026"\w* \w a|strong="H3068"\w* \w Caín|strong="H7014"\w* será castigado \w siete|strong="H7659"\w* veces”. \w Entonces|strong="H3651"\w* Yahvé le \w puso|strong="H7760"\w* \w una|strong="H4672"\w* señal \w a|strong="H3068"\w* \w Caín|strong="H7014"\w* para \w que|strong="H1115"\w* \w el|strong="H3605"\w* \w que|strong="H1115"\w* \w lo|strong="H3605"\w* encontrara \w no|strong="H1115"\w* \w lo|strong="H3605"\w* \w matara|strong="H2026"\w*.   
\p
\v 16 Así \w Caín|strong="H7014"\w* se alejó \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé y se fue \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* la región \w de|strong="H6440"\w* Nod, al oriente del Edén.  
\v 17 \w Caín|strong="H7014"\w* \w tuvo|strong="H1961"\w* relaciones con su mujer, y ella \w quedó|strong="H1961"\w* \w embarazada|strong="H2029"\w* y dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Enoc. \w Caín|strong="H7014"\w* \w estaba|strong="H1961"\w* construyendo una \w ciudad|strong="H5892"\w*, \w a|strong="H3068"\w* la \w que|strong="H3045"\w* le \w puso|strong="H3205"\w* \w el|strong="H1121"\w* \w nombre|strong="H8034"\w* \w de|strong="H1121"\w* su \w hijo|strong="H1121"\w*, Enoc.  
\v 18 Enoc fue el padre de \w Irad|strong="H5897"\w*, \w Irad|strong="H5897"\w* fue el padre de Mejuyael, Mejuyael fue el padre de Metusael, y Metusael fue el padre de Lamec.  
\v 19 Lamec tuvo \w dos|strong="H8147"\w* mujeres. Una se \w llamaba|strong="H8034"\w* \w Adá|strong="H5711"\w* y la \w otra|strong="H8145"\w* Zilá.  
\v 20 \w Adá|strong="H5711"\w* dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Jabal, \w que|strong="H1931"\w* \w fue|strong="H1961"\w* \w el|strong="H1931"\w* antepasado de \w los|strong="H3427"\w* \w que|strong="H1931"\w* viven en tiendas y crían \w ganado|strong="H4735"\w*.  
\v 21 Jabal \w tuvo|strong="H1961"\w* un hermano \w llamado|strong="H8034"\w* \w Jubal|strong="H3106"\w*, \w que|strong="H1931"\w* \w fue|strong="H1961"\w* \w el|strong="H1931"\w* antepasado de \w los|strong="H3605"\w* \w que|strong="H1931"\w* tocan \w el|strong="H1931"\w* \w arpa|strong="H3658"\w* y \w la|strong="H1931"\w* flauta.  
\v 22 Por \w su|strong="H1931"\w* parte, Zilá dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Tubal Caín, \w que|strong="H1931"\w* \w fue|strong="H1931"\w* herrero \w y|strong="H1571"\w* forjador de \w toda|strong="H3605"\w* clase de herramientas de bronce \w y|strong="H1571"\w* de \w hierro|strong="H1270"\w*. Tubal Caín tuvo una hermana \w que|strong="H1931"\w* \w se|strong="H1931"\w* llamaba Noamá.  
\v 23 Lamec les dijo \w a|strong="H3068"\w* sus mujeres:  
\q1 “\w Adá|strong="H5711"\w* \w y|strong="H3588"\w* Zilá, \w escuchen|strong="H8085"\w* \w bien|strong="H3588"\w* mi \w voz|strong="H6963"\w*;  
\q2 mujeres \w de|strong="H3588"\w* Lamec, presten atención \w a|strong="H3068"\w* mis palabras:  
\q1 \w maté|strong="H2026"\w* \w a|strong="H3068"\w* un hombre \w por|strong="H3588"\w* haberme herido,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* un joven \w por|strong="H3588"\w* haberme golpeado.   
\q1
\v 24 \w Si|strong="H3588"\w* \w a|strong="H3068"\w* \w Caín|strong="H7014"\w* lo vengarán \w siete|strong="H7651"\w* \w veces|strong="H7651"\w*,  
\q2 \w a|strong="H3068"\w* Lamec lo vengarán \w setenta|strong="H7657"\w* \w y|strong="H3588"\w* \w siete|strong="H7651"\w* \w veces|strong="H7651"\w*”.   
\p
\v 25 Adán \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* tener relaciones \w con|strong="H3588"\w* \w su|strong="H3588"\w* mujer, \w y|strong="H3588"\w* ella dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w* \w al|strong="H8478"\w* \w que|strong="H3588"\w* \w llamó|strong="H7121"\w* Set, \w pues|strong="H3588"\w* dijo: “Dios \w me|strong="H3588"\w* ha concedido \w otro|strong="H5750"\w* \w hijo|strong="H1121"\w* \w en|strong="H3588"\w* \w lugar|strong="H8478"\w* \w de|strong="H3588"\w* \w Abel|strong="H1893"\w*, \w a|strong="H3068"\w* quien \w Caín|strong="H7014"\w* \w mató|strong="H2026"\w*”.  
\v 26 \w También|strong="H1571"\w* Set tuvo un \w hijo|strong="H1121"\w*, al \w que|strong="H1931"\w* \w llamó|strong="H7121"\w* Enós. \w Fue|strong="H1931"\w* \w entonces|strong="H1571"\w* \w cuando|strong="H1571"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w comenzaron|strong="H2490"\w* \w a|strong="H3068"\w* invocar \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* \w de|strong="H1121"\w* Yahvé.   
\c 5  
\p
\v 1 \w Ésta|strong="H2088"\w* \w es|strong="H2088"\w* la lista de los descendientes de Adán. \w Cuando|strong="H3117"\w* Dios creó al hombre, \w lo|strong="H2088"\w* \w hizo|strong="H6213"\w* \w a|strong="H3068"\w* su \w semejanza|strong="H1823"\w*.  
\v 2 Hombre y mujer los creó, y los \w bendijo|strong="H1288"\w*. El \w día|strong="H3117"\w* \w que|strong="H3117"\w* fueron creados, los \w llamó|strong="H7121"\w* “Humanidad”. \f + \fr 5:2 \ft “Adán” y “Humanidad” se escriben igual en hebreo.\f*  
\v 3 Adán tenía \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* cuando tuvo un \w hijo|strong="H3205"\w* \w a|strong="H3068"\w* su \w imagen|strong="H1823"\w* y \w semejanza|strong="H1823"\w*, al que \w llamó|strong="H7121"\w* Set.  
\v 4 \w Después|strong="H1961"\w* del nacimiento \w de|strong="H1121"\w* Set, Adán \w vivió|strong="H3117"\w* \w ochocientos|strong="H8083"\w* \w años|strong="H8141"\w* más, y \w tuvo|strong="H1961"\w* otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 5 Adán \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 6 Set tenía \w ciento|strong="H3967"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando fue padre \w de|strong="H2568"\w* Enós.  
\v 7 Después del nacimiento \w de|strong="H1121"\w* Enós, Set \w vivió|strong="H2421"\w* \w ochocientos|strong="H8083"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 8 Set \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w doce|strong="H8147"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 9 Enós tenía \w noventa|strong="H8673"\w* \w años|strong="H8141"\w* cuando fue padre de \w Cainán|strong="H7018"\w*.  
\v 10 Después del nacimiento \w de|strong="H2568"\w* \w Cainán|strong="H7018"\w*, Enós \w vivió|strong="H2421"\w* \w ochocientos|strong="H8083"\w* \w quince|strong="H2568"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 11 Enós \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* \w de|strong="H2568"\w* \w edad|strong="H3117"\w*.   
\p
\v 12 \w Cainán|strong="H7018"\w* tenía \w setenta|strong="H7657"\w* \w años|strong="H8141"\w* cuando fue padre de Mejalalel.  
\v 13 Después del nacimiento \w de|strong="H1121"\w* Mejalalel, \w Cainán|strong="H7018"\w* \w vivió|strong="H2421"\w* \w ochocientos|strong="H8083"\w* cuarenta \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 14 \w Cainán|strong="H7018"\w* \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w diez|strong="H6235"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 15 Mejalalel tenía \w sesenta|strong="H8346"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando fue padre \w de|strong="H2568"\w* \w Jared|strong="H3382"\w*.  
\v 16 Después del nacimiento \w de|strong="H1121"\w* \w Jared|strong="H3382"\w*, Mejalalel \w vivió|strong="H2421"\w* \w ochocientos|strong="H8083"\w* \w treinta|strong="H7970"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 17 Mejalalel \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ochocientos|strong="H8083"\w* \w noventa|strong="H8673"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* \w de|strong="H2568"\w* \w edad|strong="H3117"\w*.   
\p
\v 18 \w Jared|strong="H3382"\w* tenía \w ciento|strong="H3967"\w* \w sesenta|strong="H8346"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* cuando fue padre de Enoc.  
\v 19 Después del nacimiento \w de|strong="H1121"\w* Enoc, \w Jared|strong="H3382"\w* \w vivió|strong="H2421"\w* \w ochocientos|strong="H8083"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 20 \w Jared|strong="H3382"\w* \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w sesenta|strong="H8346"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 21 Enoc tenía \w sesenta|strong="H8346"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando fue padre \w de|strong="H2568"\w* Matusalén.  
\v 22 Después del nacimiento \w de|strong="H1121"\w* Matusalén, Enoc vivió en íntima comunión con Dios \w trescientos|strong="H7969"\w* \w años|strong="H8141"\w* más, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 23 En total, Enoc \w vivió|strong="H3117"\w* \w trescientos|strong="H7969"\w* \w sesenta|strong="H8346"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w*.  
\v 24 Enoc vivió \w en|strong="H3588"\w* íntima comunión \w con|strong="H3588"\w* Dios, \w y|strong="H3588"\w* un día \w desapareció|strong="H1980"\w* \w porque|strong="H3588"\w* Dios se lo \w llevó|strong="H3947"\w*.   
\p
\v 25 Matusalén tenía \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* y \w siete|strong="H7651"\w* \w años|strong="H8141"\w* cuando fue padre de Lamec.  
\v 26 Después del nacimiento \w de|strong="H1121"\w* Lamec, Matusalén \w vivió|strong="H2421"\w* \w setecientos|strong="H7651"\w* \w ochenta|strong="H8084"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 27 Matusalén \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w sesenta|strong="H8346"\w* y \w nueve|strong="H8672"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 28 Lamec tenía \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* cuando tuvo un \w hijo|strong="H1121"\w*.  
\v 29 \w Lo|strong="H2088"\w* \w llamó|strong="H7121"\w* \w Noé|strong="H5146"\w*, \w pues|strong="H2088"\w* dijo: “\w Éste|strong="H2088"\w* \w nos|strong="H4480"\w* \w aliviará|strong="H5162"\w* \w de|strong="H4480"\w* nuestro \w trabajo|strong="H6093"\w* y \w de|strong="H4480"\w* la fatiga \w de|strong="H4480"\w* nuestras \w manos|strong="H3027"\w*, causados \w por|strong="H4480"\w* la tierra \w que|strong="H4480"\w* Yahvé maldijo”.  
\v 30 Después del nacimiento \w de|strong="H2568"\w* \w Noé|strong="H5146"\w*, Lamec \w vivió|strong="H2421"\w* \w quinientos|strong="H2568"\w* \w noventa|strong="H8673"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 31 Lamec \w murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w setecientos|strong="H7651"\w* \w setenta|strong="H7657"\w* y \w siete|strong="H7651"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\p
\v 32 \w Noé|strong="H5146"\w* \w tenía|strong="H1961"\w* \w quinientos|strong="H2568"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* \w fue|strong="H1961"\w* padre \w de|strong="H2568"\w* \w Sem|strong="H8035"\w*, Cam y Jafet.   
\c 6  
\p
\v 1 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* seres humanos \w comenzaron|strong="H2490"\w* \w a|strong="H3068"\w* multiplicarse \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H3588"\w* \w tuvieron|strong="H1961"\w* \w hijas|strong="H1323"\w*,  
\v 2 \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* Dios \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* las \w hijas|strong="H1323"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* eran \w hermosas|strong="H2896"\w*, \w y|strong="H3588"\w* \w tomaron|strong="H3947"\w* \w por|strong="H3588"\w* esposas \w a|strong="H3068"\w* las \w que|strong="H3588"\w* \w más|strong="H3588"\w* les gustaron.  
\v 3 \w Entonces|strong="H3117"\w* Yahvé dijo: “\w Mi|strong="H1961"\w* \w Espíritu|strong="H7307"\w* \w no|strong="H3808"\w* \w permanecerá|strong="H1961"\w* en \w el|strong="H1931"\w* hombre \w para|strong="H1961"\w* \w siempre|strong="H5769"\w*, \w porque|strong="H3808"\w* \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w más|strong="H1571"\w* \w que|strong="H1931"\w* \w carne|strong="H1320"\w* mortal. \w Por|strong="H5769"\w* \w eso|strong="H1931"\w*, \w el|strong="H1931"\w* hombre \w no|strong="H3808"\w* vivirá \w más|strong="H1571"\w* de \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w*”.  
\v 4 En \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w y|strong="H1571"\w* \w aun|strong="H1571"\w* \w después|strong="H1961"\w*, \w había|strong="H1961"\w* \w gigantes|strong="H5303"\w*\f + \fr 6:4 \ft o, Nefilim\f* en \w la|strong="H1571"\w* tierra. \w Éstos|strong="H1992"\w* \w eran|strong="H1961"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w que|strong="H1571"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Dios \w tuvieron|strong="H1961"\w* \w con|strong="H1571"\w* \w las|strong="H1992"\w* \w hijas|strong="H1323"\w* \w de|strong="H1121"\w* \w los|strong="H1992"\w* \w hombres|strong="H1368"\w*. \w Fueron|strong="H1961"\w* \w los|strong="H1992"\w* héroes famosos \w de|strong="H1121"\w* \w la|strong="H1571"\w* antigüedad.   
\p
\v 5 Al \w ver|strong="H7200"\w* Yahvé \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H7451"\w* del ser humano \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra era muy \w grande|strong="H7227"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* sus \w pensamientos|strong="H4284"\w* tendían \w siempre|strong="H3605"\w* hacia \w el|strong="H3588"\w* \w mal|strong="H7451"\w*,  
\v 6 se arrepintió \w de|strong="H3588"\w* haber \w hecho|strong="H6213"\w* al hombre \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra, \w y|strong="H3588"\w* le dolió \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w corazón|strong="H3820"\w*.  
\v 7 \w Por|strong="H5921"\w* eso dijo Yahvé: “Voy \w a|strong="H3068"\w* borrar \w de|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w a|strong="H3068"\w* estos hombres \w que|strong="H3588"\w* he creado, \w y|strong="H3588"\w* también \w a|strong="H3068"\w* \w los|strong="H5921"\w* animales, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reptiles|strong="H7431"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*. ¡\w Me|strong="H5921"\w* pesa haberlos \w hecho|strong="H6213"\w*!”  
\v 8 Pero \w Noé|strong="H5146"\w* contaba con el favor \w de|strong="H5869"\w* Yahvé.   
\p
\v 9 \w Ésta|strong="H1961"\w* \w es|strong="H1961"\w* la historia \w de|strong="H6662"\w* \w Noé|strong="H5146"\w*. \w Noé|strong="H5146"\w* \w era|strong="H1961"\w* un hombre \w justo|strong="H6662"\w* y honrado entre sus contemporáneos. \w Siempre|strong="H1980"\w* vivió \w en|strong="H8549"\w* íntima comunión con Dios.  
\v 10 \w Noé|strong="H5146"\w* tuvo \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w*: \w Sem|strong="H8035"\w*, Cam y Jafet.  
\v 11 Para ese entonces, la tierra estaba corrompida \w a|strong="H3068"\w* los ojos \w de|strong="H6440"\w* Dios y \w llena|strong="H4390"\w* \w de|strong="H6440"\w* \w violencia|strong="H2555"\w*.  
\v 12 \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* Dios tanta corrupción \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w pues|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres humanos \w se|strong="H5921"\w* habían \w corrompido|strong="H7843"\w*,   
\p
\v 13 le dijo \w a|strong="H3068"\w* \w Noé|strong="H5146"\w*: “He decidido poner \w fin|strong="H7093"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* humanidad, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* tierra está \w llena|strong="H4390"\w* \w de|strong="H3588"\w* \w violencia|strong="H2555"\w* \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w ellos|strong="H3605"\w*. ¡Voy \w a|strong="H3068"\w* \w destruirlos|strong="H7843"\w* junto \w con|strong="H3588"\w* \w la|strong="H3588"\w* tierra!  
\v 14 Así que \w hazte|strong="H6213"\w* un \w arca|strong="H8392"\w* de \w madera|strong="H6086"\w* de ciprés, con compartimentos, y recúbrela con brea por dentro y por \w fuera|strong="H2351"\w*.  
\v 15 Hazla de \w estas|strong="H2088"\w* medidas: \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* y ocho metros\f + \fr 6:15 \ft o, trescientos codos\f* de largo, veintitrés metros de ancho y catorce metros de alto.  
\v 16 Hazle un techo, dejando una abertura de medio metro entre \w el|strong="H6213"\w* techo y los \w costados|strong="H6654"\w*. \w Pon|strong="H7760"\w* la \w puerta|strong="H6607"\w* en uno de sus \w lados|strong="H6654"\w*, y construye tres pisos en \w el|strong="H6213"\w* \w arca|strong="H8392"\w*.  
\v 17 \w Yo|strong="H2009"\w* voy \w a|strong="H3068"\w* enviar un \w diluvio|strong="H3999"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w para|strong="H5921"\w* \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres \w que|strong="H5921"\w* tienen aliento \w de|strong="H5921"\w* \w vida|strong="H2416"\w* \w bajo|strong="H8478"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*. ¡\w Todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* hay \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w morirá|strong="H1478"\w*!  
\v 18 Pero contigo \w estableceré|strong="H6965"\w* mi \w pacto|strong="H1285"\w*. Tú entrarás en \w el|strong="H1121"\w* \w arca|strong="H8392"\w*, y contigo tus \w hijos|strong="H1121"\w*, tu mujer y tus nueras.  
\v 19 También meterás en \w el|strong="H3605"\w* \w arca|strong="H8392"\w* una pareja de \w cada|strong="H3605"\w* especie de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* seres \w vivos|strong="H2416"\w*, \w para|strong="H1961"\w* \w que|strong="H1961"\w* sobrevivan contigo; \w tienen|strong="H1961"\w* \w que|strong="H1961"\w* ser \w macho|strong="H2145"\w* y \w hembra|strong="H5347"\w*.  
\v 20 \w De|strong="H4480"\w* \w cada|strong="H3605"\w* \w especie|strong="H4327"\w* \w de|strong="H4480"\w* \w aves|strong="H5775"\w*, \w de|strong="H4480"\w* animales y \w de|strong="H4480"\w* \w reptiles|strong="H7431"\w*, entrará contigo una pareja \w para|strong="H4480"\w* \w que|strong="H4480"\w* sobrevivan.  
\v 21 Asegúrate de llevar \w toda|strong="H3605"\w* clase de alimentos y de almacenarlos, \w para|strong="H1961"\w* \w que|strong="H1961"\w* tú y \w ellos|strong="H3605"\w* tengan \w qué|strong="H1961"\w* comer”.  
\v 22 \w Noé|strong="H5146"\w* \w lo|strong="H6213"\w* \w hizo|strong="H6213"\w* \w así|strong="H3651"\w*; cumplió al pie de \w la|strong="H3605"\w* letra con \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* Dios le \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w*.   
\c 7  
\p
\v 1 Después Yahvé le dijo \w a|strong="H3068"\w* \w Noé|strong="H5146"\w*: “Entra \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w arca|strong="H8392"\w* \w con|strong="H3588"\w* \w toda|strong="H3605"\w* tu \w familia|strong="H1004"\w*, \w porque|strong="H3588"\w* he \w visto|strong="H7200"\w* \w que|strong="H3588"\w* tú eres \w el|strong="H3588"\w* único hombre \w justo|strong="H6662"\w* \w de|strong="H3588"\w* \w este|strong="H2088"\w* tiempo.  
\v 2 \w De|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* animales puros, \w toma|strong="H3947"\w* \w siete|strong="H7651"\w* parejas, macho y hembra; pero \w de|strong="H4480"\w* \w los|strong="H3605"\w* animales impuros, \w toma|strong="H3947"\w* \w sólo|strong="H1931"\w* una pareja, macho y hembra.  
\v 3 \w También|strong="H1571"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, toma \w siete|strong="H7651"\w* parejas, \w macho|strong="H2145"\w* \w y|strong="H1571"\w* \w hembra|strong="H5347"\w*, \w para|strong="H5921"\w* conservar su especie \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\v 4 \w Porque|strong="H3588"\w* \w dentro|strong="H5750"\w* \w de|strong="H5921"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* enviaré una \w lluvia|strong="H4305"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H3588"\w* durará cuarenta \w días|strong="H3117"\w* \w y|strong="H3588"\w* cuarenta \w noches|strong="H3915"\w*, \w y|strong="H3588"\w* borraré \w de|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres vivos \w que|strong="H3588"\w* he creado”.   
\p
\v 5 \w Noé|strong="H5146"\w* \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* tal como Yahvé se \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w*.   
\p
\v 6 \w Noé|strong="H5146"\w* \w tenía|strong="H1961"\w* \w seiscientos|strong="H8337"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* \w el|strong="H5921"\w* \w diluvio|strong="H3999"\w* inundó \w la|strong="H5921"\w* tierra.  
\v 7 \w Él|strong="H1121"\w* entró en \w el|strong="H1121"\w* \w arca|strong="H8392"\w*, junto con sus \w hijos|strong="H1121"\w*, su mujer y sus nueras, para salvarse del \w diluvio|strong="H3999"\w*.  
\v 8 \w De|strong="H4480"\w* \w los|strong="H5921"\w* animales puros \w e|strong="H3068"\w* impuros, \w de|strong="H4480"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres \w que|strong="H4480"\w* \w se|strong="H5921"\w* arrastran \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo,  
\v 9 entraron con \w Noé|strong="H5146"\w* en el \w arca|strong="H8392"\w* parejas de \w macho|strong="H2145"\w* y \w hembra|strong="H5347"\w*, tal como Dios se lo había \w ordenado|strong="H6680"\w*.  
\v 10 \w Siete|strong="H7651"\w* \w días|strong="H3117"\w* \w después|strong="H1961"\w*, \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* \w diluvio|strong="H3999"\w* comenzaron \w a|strong="H3068"\w* caer \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\v 11 \w Cuando|strong="H3117"\w* \w Noé|strong="H5146"\w* tenía \w seiscientos|strong="H8337"\w* \w años|strong="H8141"\w*, \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w diecisiete|strong="H7651"\w* del \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, se reventaron \w todas|strong="H3605"\w* las fuentes del \w gran|strong="H7227"\w* \w abismo|strong="H8415"\w* y se \w abrieron|strong="H1234"\w* las compuertas del \w cielo|strong="H8064"\w*.  
\v 12 \w Estuvo|strong="H1961"\w* lloviendo \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra cuarenta \w días|strong="H3117"\w* \w y|strong="H5921"\w* cuarenta \w noches|strong="H3915"\w*.   
\p
\v 13 \w Ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w*, \w Noé|strong="H5146"\w* y sus \w hijos|strong="H1121"\w* \w Sem|strong="H8035"\w*, Cam y Jafet, junto con su mujer y sus \w tres|strong="H7969"\w* nueras, entraron en \w el|strong="H1121"\w* \w arca|strong="H8392"\w*.  
\v 14 \w Con|strong="H5921"\w* \w ellos|strong="H1992"\w* entraron \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w animales|strong="H2416"\w* salvajes \w y|strong="H5921"\w* domésticos \w según|strong="H5921"\w* \w su|strong="H1992"\w* \w especie|strong="H4327"\w*, \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w reptiles|strong="H7431"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* arrastran \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo \w según|strong="H5921"\w* \w su|strong="H1992"\w* \w especie|strong="H4327"\w*, \w y|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H1992"\w* \w aves|strong="H5775"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* seres alados \w según|strong="H5921"\w* \w su|strong="H1992"\w* \w especie|strong="H4327"\w*.  
\v 15 De \w todos|strong="H3605"\w* \w los|strong="H3605"\w* seres \w que|strong="H3605"\w* tienen aliento de \w vida|strong="H2416"\w*, entraron con \w Noé|strong="H5146"\w* en \w el|strong="H3605"\w* \w arca|strong="H8392"\w* de \w dos|strong="H8147"\w* en \w dos|strong="H8147"\w*.  
\v 16 \w Los|strong="H3605"\w* animales \w que|strong="H1157"\w* entraron eran \w macho|strong="H2145"\w* y \w hembra|strong="H5347"\w* de \w cada|strong="H3605"\w* especie, tal como \w Dios|strong="H3068"\w* se \w lo|strong="H3605"\w* había \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* Noé. Luego Yahvé \w cerró|strong="H5462"\w* \w la|strong="H3605"\w* puerta.  
\v 17 \w El|strong="H5921"\w* \w diluvio|strong="H3999"\w* duró cuarenta \w días|strong="H3117"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra. \w Al|strong="H5921"\w* crecer \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*, \w el|strong="H5921"\w* \w arca|strong="H8392"\w* \w se|strong="H1961"\w* \w levantó|strong="H5375"\w* \w y|strong="H5921"\w* comenzó \w a|strong="H3068"\w* flotar.  
\v 18 \w Las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w crecieron|strong="H7235"\w* \w y|strong="H5921"\w* aumentaron muchísimo, pero \w el|strong="H5921"\w* \w arca|strong="H8392"\w* \w se|strong="H5921"\w* mantenía \w a|strong="H3068"\w* flote \w sobre|strong="H5921"\w* \w ellas|strong="H5921"\w*.  
\v 19 \w Tanto|strong="H3966"\w* subieron \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w que|strong="H5921"\w* \w cubrieron|strong="H3680"\w* \w las|strong="H5921"\w* montañas \w más|strong="H5921"\w* altas \w que|strong="H5921"\w* hay \w bajo|strong="H8478"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*.  
\v 20 El nivel del \w agua|strong="H4325"\w* subió casi siete metros\f + \fr 7:20 \ft o, quince codos\f* por \w encima|strong="H4605"\w* \w de|strong="H2568"\w* las montañas.  
\v 21 \w Y|strong="H3068"\w* murieron \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres \w que|strong="H5921"\w* \w se|strong="H5921"\w* movían \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra: \w las|strong="H5921"\w* \w aves|strong="H5775"\w*, \w los|strong="H5921"\w* \w animales|strong="H2416"\w* domésticos \w y|strong="H5921"\w* salvajes, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* reptiles \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* humanidad.  
\v 22 \w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* tenía aliento \w de|strong="H5397"\w* \w vida|strong="H2416"\w* y vivía en \w la|strong="H3605"\w* tierra firme, \w murió|strong="H4191"\w*.  
\v 23 Así Dios borró \w de|strong="H4480"\w* \w la|strong="H5921"\w* superficie \w de|strong="H4480"\w* \w la|strong="H5921"\w* tierra \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres vivos, \w desde|strong="H4480"\w* \w el|strong="H5921"\w* hombre \w hasta|strong="H5704"\w* \w los|strong="H5921"\w* animales, \w los|strong="H5921"\w* \w reptiles|strong="H7431"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H4480"\w* \w cielo|strong="H8064"\w*. ¡\w Todos|strong="H3605"\w* fueron borrados \w de|strong="H4480"\w* \w la|strong="H5921"\w* tierra! Sólo sobrevivieron \w Noé|strong="H5146"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H4480"\w* estaban \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w arca|strong="H8392"\w*.  
\v 24 \w Y|strong="H3068"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* cubrieron \w la|strong="H5921"\w* tierra durante \w ciento|strong="H3967"\w* \w cincuenta|strong="H2572"\w* \w días|strong="H3117"\w*.   
\c 8  
\p
\v 1 Pero Dios \w se|strong="H5921"\w* acordó \w de|strong="H5921"\w* \w Noé|strong="H5146"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* salvajes \w y|strong="H5921"\w* domésticos \w que|strong="H5921"\w* \w estaban|strong="H4325"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w arca|strong="H8392"\w*. Entonces hizo \w que|strong="H5921"\w* soplara un \w viento|strong="H7307"\w* fuerte \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* comenzaron \w a|strong="H3068"\w* bajar.  
\v 2 \w Se|strong="H4480"\w* cerraron las fuentes \w del|strong="H4480"\w* \w abismo|strong="H8415"\w* y las compuertas \w del|strong="H4480"\w* \w cielo|strong="H8064"\w*, y dejó \w de|strong="H4480"\w* llover.  
\v 3 Poco \w a|strong="H3068"\w* poco \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H5921"\w* \w fueron|strong="H1980"\w* retirando \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra. \w Al|strong="H5921"\w* \w cabo|strong="H7097"\w* \w de|strong="H5921"\w* \w ciento|strong="H3967"\w* \w cincuenta|strong="H2572"\w* \w días|strong="H3117"\w*, \w el|strong="H5921"\w* nivel \w del|strong="H5921"\w* \w agua|strong="H4325"\w* había bajado.  
\v 4 \w El|strong="H5921"\w* \w día|strong="H3117"\w* \w diecisiete|strong="H7651"\w* \w del|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*, \w el|strong="H5921"\w* \w arca|strong="H8392"\w* quedó encallada \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w de|strong="H5921"\w* Ararat.  
\v 5 Las \w aguas|strong="H4325"\w* \w siguieron|strong="H1980"\w* bajando \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* el \w primer|strong="H7218"\w* día del \w décimo|strong="H6224"\w* \w mes|strong="H2320"\w* pudieron \w verse|strong="H7200"\w* las cimas \w de|strong="H5704"\w* las montañas.   
\p
\v 6 \w Pasados|strong="H1961"\w* otros cuarenta \w días|strong="H3117"\w*, \w Noé|strong="H5146"\w* \w abrió|strong="H6605"\w* la ventana \w que|strong="H3117"\w* le \w había|strong="H1961"\w* \w hecho|strong="H6213"\w* al \w arca|strong="H8392"\w*  
\v 7 \w y|strong="H5921"\w* soltó un \w cuervo|strong="H6158"\w*, \w el|strong="H5921"\w* cual estuvo volando \w de|strong="H5921"\w* un lado \w a|strong="H3068"\w* otro \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w secó|strong="H3001"\w* \w la|strong="H5921"\w* tierra.  
\v 8 Luego soltó una \w paloma|strong="H3123"\w* \w para|strong="H5921"\w* \w ver|strong="H7200"\w* \w si|strong="H6440"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* ya \w se|strong="H5921"\w* habían retirado \w de|strong="H5921"\w* \w la|strong="H5921"\w* superficie.  
\v 9 \w Pero|strong="H3588"\w* \w la|strong="H5921"\w* \w paloma|strong="H3123"\w* \w no|strong="H3808"\w* encontró \w dónde|strong="H5921"\w* posarse, \w así|strong="H3588"\w* \w que|strong="H3588"\w* \w volvió|strong="H7725"\w* \w al|strong="H5921"\w* \w arca|strong="H8392"\w* \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* todavía cubría \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra. Noé \w extendió|strong="H7971"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w la|strong="H5921"\w* \w tomó|strong="H3947"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* \w metió|strong="H7971"\w* \w de|strong="H5921"\w* nuevo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w arca|strong="H8392"\w*.  
\v 10 Esperó \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w más|strong="H5750"\w* y \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w soltar|strong="H7971"\w* la \w paloma|strong="H3123"\w*.  
\v 11 \w Al|strong="H5921"\w* anochecer, \w la|strong="H5921"\w* \w paloma|strong="H3123"\w* regresó \w con|strong="H5921"\w* una hoja \w de|strong="H5921"\w* olivo recién arrancada \w en|strong="H5921"\w* \w el|strong="H5921"\w* pico. \w Así|strong="H3588"\w* \w Noé|strong="H5146"\w* \w se|strong="H3045"\w* dio cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* ya habían bajado.  
\v 12 \w Esperó|strong="H3176"\w* \w otros|strong="H5750"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* y \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* \w soltar|strong="H7971"\w* la \w paloma|strong="H3123"\w*, pero ésta \w ya|strong="H3254"\w* \w no|strong="H3808"\w* regresó.   
\p
\v 13 \w Cuando|strong="H1961"\w* \w Noé|strong="H5146"\w* \w tenía|strong="H1961"\w* \w seiscientos|strong="H8337"\w* un \w años|strong="H8141"\w*, \w el|strong="H5921"\w* \w primer|strong="H7223"\w* día \w del|strong="H5921"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H1961"\w* \w habían|strong="H1961"\w* secado. \w Noé|strong="H5146"\w* \w quitó|strong="H5493"\w* \w el|strong="H5921"\w* techo \w del|strong="H5921"\w* \w arca|strong="H8392"\w* \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w del|strong="H5921"\w* suelo ya \w estaba|strong="H1961"\w* seca.  
\v 14 El \w día|strong="H3117"\w* \w veintisiete|strong="H6242"\w* del \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, la tierra ya estaba completamente \w seca|strong="H3001"\w*.   
\p
\v 15 Entonces Dios le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Noé|strong="H5146"\w*:  
\v 16 “\w Sal|strong="H3318"\w* \w del|strong="H4480"\w* \w arca|strong="H8392"\w* junto \w con|strong="H4480"\w* tu mujer, tus \w hijos|strong="H1121"\w* y tus nueras.  
\v 17 \w Saca|strong="H3318"\w* \w también|strong="H3318"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* \w que|strong="H5921"\w* están \w contigo|strong="H5921"\w*, \w tanto|strong="H5921"\w* \w aves|strong="H5775"\w* \w como|strong="H5921"\w* fieras \w y|strong="H5921"\w* \w reptiles|strong="H7431"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* multipliquen \w y|strong="H5921"\w* sean fecundos \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra”.   
\p
\v 18 \w Noé|strong="H5146"\w* \w salió|strong="H3318"\w* del arca con sus \w hijos|strong="H1121"\w*, su mujer y sus nueras.  
\v 19 \w También|strong="H3318"\w* \w salieron|strong="H3318"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w*, \w reptiles|strong="H7431"\w* \w y|strong="H5921"\w* \w aves|strong="H5775"\w*, \w según|strong="H5921"\w* su especie.   
\p
\v 20 \w Luego|strong="H5927"\w* \w Noé|strong="H5146"\w* construyó un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé y, \w tomando|strong="H3947"\w* de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* animales y \w aves|strong="H5775"\w* puros, \w ofreció|strong="H5927"\w* un sacrificio en \w el|strong="H3605"\w* \w altar|strong="H4196"\w*.  
\v 21 \w El|strong="H3588"\w* aroma del sacrificio \w le|strong="H3254"\w* agradó \w a|strong="H3068"\w* Yahvé, \w quien|strong="H3605"\w* pensó: “\w Nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* maldecir \w la|strong="H3588"\w* tierra \w por|strong="H3588"\w* culpa del hombre, \w aunque|strong="H3588"\w* desde \w su|strong="H3588"\w* \w juventud|strong="H5271"\w* sus intenciones sean \w malas|strong="H7451"\w*. \w Tampoco|strong="H3808"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* destruir \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* seres \w vivos|strong="H2416"\w*, \w como|strong="H3588"\w* acabo \w de|strong="H3588"\w* hacerlo.  
\v 22 \w Mientras|strong="H5750"\w* \w la|strong="H3605"\w* tierra exista, \w no|strong="H3808"\w* faltarán \w la|strong="H3605"\w* \w siembra|strong="H2233"\w* \w ni|strong="H3808"\w* \w la|strong="H3605"\w* cosecha, \w ni|strong="H3808"\w* \w el|strong="H3605"\w* frío \w ni|strong="H3808"\w* \w el|strong="H3605"\w* calor, \w ni|strong="H3808"\w* \w el|strong="H3605"\w* \w verano|strong="H7019"\w* \w ni|strong="H3808"\w* \w el|strong="H3605"\w* invierno, \w ni|strong="H3808"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w ni|strong="H3808"\w* \w la|strong="H3605"\w* \w noche|strong="H3915"\w*”.   
\c 9  
\p
\v 1 Dios \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* \w Noé|strong="H5146"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, y les dijo: “Sean fecundos, multiplíquense y llenen la tierra.  
\v 2 \w Todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* reptiles \w que|strong="H5921"\w* \w se|strong="H1961"\w* arrastran \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* peces \w del|strong="H5921"\w* \w mar|strong="H3220"\w* \w tendrán|strong="H1961"\w* miedo \w de|strong="H5921"\w* ustedes. \w Todos|strong="H3605"\w* \w ellos|strong="H3027"\w* quedan bajo su dominio.  
\v 3 \w Todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* mueve y \w tiene|strong="H1931"\w* \w vida|strong="H2416"\w* les \w servirá|strong="H1961"\w* \w de|strong="H5414"\w* alimento. Yo les \w doy|strong="H5414"\w* \w todo|strong="H3605"\w* \w esto|strong="H1931"\w*, tal \w como|strong="H1961"\w* antes les \w di|strong="H5414"\w* las plantas verdes.  
\v 4 Pero \w no|strong="H3808"\w* deben \w comer|strong="H5315"\w* \w carne|strong="H1320"\w* con \w sangre|strong="H1818"\w*, \w porque|strong="H3808"\w* la \w sangre|strong="H1818"\w* es la \w vida|strong="H5315"\w*.  
\v 5 \w Yo|strong="H5315"\w* pediré cuentas \w de|strong="H1818"\w* \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* \w cada|strong="H3605"\w* uno \w de|strong="H1818"\w* ustedes. Se las pediré \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w animal|strong="H2416"\w*, y también \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* hombre \w por|strong="H3027"\w* \w la|strong="H3605"\w* \w vida|strong="H5315"\w* \w de|strong="H1818"\w* su semejante.  
\v 6 \w El|strong="H3588"\w* \w que|strong="H3588"\w* derrame \w sangre|strong="H1818"\w* humana, \w por|strong="H3588"\w* otro hombre \w su|strong="H3588"\w* \w sangre|strong="H1818"\w* \w será|strong="H6213"\w* derramada; \w porque|strong="H3588"\w* Dios creó al hombre \w a|strong="H3068"\w* \w su|strong="H3588"\w* propia \w imagen|strong="H6754"\w*.  
\v 7 Pero ustedes, sean fecundos y multiplíquense; pueblen la tierra en \w abundancia|strong="H7235"\w* y multiplíquense en ella”.   
\p
\v 8 Dios también les dijo \w a|strong="H3068"\w* \w Noé|strong="H5146"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*:  
\v 9 “Miren, yo establezco mi \w pacto|strong="H1285"\w* con ustedes, con sus descendientes  
\v 10 y con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w* \w que|strong="H3605"\w* están con ustedes: \w aves|strong="H5775"\w*, \w animales|strong="H2416"\w* domésticos y salvajes, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w salieron|strong="H3318"\w* del \w arca|strong="H8392"\w*.  
\v 11 \w Éste|strong="H1961"\w* \w es|strong="H1961"\w* \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w*: \w Nunca|strong="H3808"\w* \w más|strong="H5750"\w* volverán \w a|strong="H3068"\w* ser exterminados \w los|strong="H3605"\w* seres vivos \w por|strong="H5750"\w* un \w diluvio|strong="H3999"\w*, \w ni|strong="H3808"\w* \w habrá|strong="H1961"\w* \w otro|strong="H5750"\w* \w diluvio|strong="H3999"\w* \w que|strong="H3808"\w* \w destruya|strong="H7843"\w* \w la|strong="H3605"\w* tierra”.  
\v 12 \w Y|strong="H3068"\w* añadió Dios: “\w Ésta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* señal del \w pacto|strong="H1285"\w* \w que|strong="H3605"\w* \w establezco|strong="H5414"\w* \w para|strong="H5414"\w* \w siempre|strong="H5769"\w* con ustedes y con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w*:  
\v 13 He \w puesto|strong="H5414"\w* \w mi|strong="H1961"\w* \w arco|strong="H7198"\w* iris en las \w nubes|strong="H6051"\w*. Ésa \w será|strong="H1961"\w* la señal \w de|strong="H5414"\w* \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* con la tierra.  
\v 14 \w Cuando|strong="H1961"\w* yo cubra \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w nubes|strong="H6051"\w* \w y|strong="H5921"\w* \w aparezca|strong="H7200"\w* \w el|strong="H5921"\w* \w arco|strong="H7198"\w* iris,  
\v 15 me acordaré del \w pacto|strong="H1285"\w* \w que|strong="H3808"\w* hice con ustedes y con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w*, y \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* las \w aguas|strong="H4325"\w* del \w diluvio|strong="H3999"\w* volverán \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w*.  
\v 16 \w Cuando|strong="H1961"\w* \w el|strong="H5921"\w* \w arco|strong="H7198"\w* iris \w esté|strong="H1961"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w nubes|strong="H6051"\w*, \w yo|strong="H5315"\w* \w lo|strong="H5921"\w* \w veré|strong="H7200"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* acordaré \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w* \w que|strong="H5921"\w* \w hay|strong="H1961"\w* \w entre|strong="H5921"\w* Dios \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w seres|strong="H5315"\w* \w vivos|strong="H2416"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra”.  
\v 17 \w Así|strong="H2063"\w* \w le|strong="H5921"\w* dijo Dios \w a|strong="H3068"\w* \w Noé|strong="H5146"\w*: “\w Ésta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H5921"\w* señal \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w que|strong="H5921"\w* he establecido \w con|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* seres vivos \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra”.   
\p
\v 18 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Noé|strong="H5146"\w* \w que|strong="H4480"\w* \w salieron|strong="H3318"\w* \w del|strong="H4480"\w* \w arca|strong="H8392"\w* \w fueron|strong="H1961"\w* \w Sem|strong="H8035"\w*, Cam y Jafet. Cam \w fue|strong="H1961"\w* \w el|strong="H1931"\w* padre \w de|strong="H4480"\w* \w Canaán|strong="H3667"\w*.  
\v 19 \w A|strong="H3068"\w* partir \w de|strong="H1121"\w* \w estos|strong="H3605"\w* \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Noé|strong="H5146"\w* se pobló \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra.   
\p
\v 20 \w Noé|strong="H5146"\w* se dedicó \w a|strong="H3068"\w* la agricultura y \w plantó|strong="H5193"\w* una \w viña|strong="H3754"\w*.  
\v 21 Un día \w bebió|strong="H8354"\w* \w vino|strong="H3196"\w*, \w se|strong="H4480"\w* emborrachó y \w se|strong="H4480"\w* quedó desnudo \w dentro|strong="H8432"\w* \w de|strong="H4480"\w* su tienda.  
\v 22 Cam, el padre de \w Canaán|strong="H3667"\w*, \w vio|strong="H7200"\w* la \w desnudez|strong="H6172"\w* de su padre y salió \w a|strong="H3068"\w* contárselo \w a|strong="H3068"\w* sus \w dos|strong="H8147"\w* hermanos.  
\v 23 Entonces \w Sem|strong="H8035"\w* \w y|strong="H5921"\w* Jafet \w tomaron|strong="H3947"\w* un manto \w y|strong="H5921"\w*, poniéndoselo \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w hombros|strong="H7926"\w*, \w entraron|strong="H3212"\w* \w caminando|strong="H3212"\w* \w de|strong="H5921"\w* espaldas \w para|strong="H5921"\w* \w no|strong="H3808"\w* \w ver|strong="H7200"\w* \w la|strong="H5921"\w* \w desnudez|strong="H6172"\w* \w de|strong="H5921"\w* su padre, \w y|strong="H5921"\w* \w lo|strong="H3808"\w* \w cubrieron|strong="H3680"\w*. \w Como|strong="H5921"\w* caminaban \w de|strong="H5921"\w* espaldas, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w vieron|strong="H7200"\w* desnudo.  
\v 24 Cuando \w a|strong="H3068"\w* \w Noé|strong="H5146"\w* \w se|strong="H3045"\w* le pasó la borrachera y \w se|strong="H3045"\w* enteró \w de|strong="H1121"\w* \w lo|strong="H6213"\w* \w que|strong="H3045"\w* su \w hijo|strong="H1121"\w* \w menor|strong="H6996"\w* le \w había|strong="H6213"\w* \w hecho|strong="H6213"\w*,  
\v 25 exclamó:  
\q1 “¡Maldito \w sea|strong="H1961"\w* \w Canaán|strong="H3667"\w*!  
\q2 \w Será|strong="H1961"\w* el último de \w los|strong="H1961"\w* esclavos de sus hermanos”.   
\p
\v 26 \w Y|strong="H3068"\w* añadió:  
\q1 “¡\w Bendito|strong="H1288"\w* \w sea|strong="H1961"\w* Yahvé, \w Dios|strong="H3068"\w* de \w Sem|strong="H8035"\w*!  
\q2 ¡\w Que|strong="H1961"\w* \w Canaán|strong="H3667"\w* \w sea|strong="H1961"\w* esclavo de \w Sem|strong="H8035"\w*!   
\q1
\v 27 ¡\w Que|strong="H1961"\w* Dios extienda el territorio de Jafet!  
\q2 ¡\w Que|strong="H1961"\w* Jafet viva en las tiendas de \w Sem|strong="H8035"\w*,  
\q2 y \w que|strong="H1961"\w* \w Canaán|strong="H3667"\w* \w sea|strong="H1961"\w* su esclavo!”   
\p
\v 28 Después del \w diluvio|strong="H3999"\w*, \w Noé|strong="H5146"\w* \w vivió|strong="H2421"\w* \w trescientos|strong="H7969"\w* \w cincuenta|strong="H2572"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*.  
\v 29 \w Murió|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w novecientos|strong="H8672"\w* \w cincuenta|strong="H2572"\w* \w años|strong="H8141"\w* de \w edad|strong="H3117"\w*.   
\c 10  
\p
\v 1 Éstos son \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Sem|strong="H8035"\w*, Cam y Jafet, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Noé|strong="H5146"\w*, \w que|strong="H1121"\w* tuvieron \w hijos|strong="H1121"\w* después del \w diluvio|strong="H3999"\w*.   
\p
\v 2 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Jafet fueron: \w Gómer|strong="H1586"\w*, \w Magog|strong="H4031"\w*, Maday, \w Javán|strong="H3120"\w*, \w Tubal|strong="H8422"\w*, \w Mésec|strong="H4902"\w* y Tirás.  
\v 3 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gómer|strong="H1586"\w* fueron: Asquenaz, Rifat y Togarma.  
\v 4 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Javán|strong="H3120"\w* fueron: Elisá, \w Tarsis|strong="H8659"\w*, Quitín y Dodanín.  
\v 5 De ellos descendieron los que poblaron las costas y las islas, cada uno según su \w lengua|strong="H3956"\w*, sus \w familias|strong="H4940"\w* y sus \w naciones|strong="H1471"\w*.   
\p
\v 6 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Cam fueron: Cus, Mizrayín, Fut y \w Canaán|strong="H3667"\w*.  
\v 7 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Cus fueron: \w Seba|strong="H7614"\w*, Javilá, Sabtá, Raamá y Sabteca. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Raamá fueron: Sabá y \w Dedán|strong="H1719"\w*.  
\v 8 Cus \w fue|strong="H1961"\w* \w el|strong="H1931"\w* padre de Nimrod, \w el|strong="H1931"\w* primer \w hombre|strong="H1368"\w* \w poderoso|strong="H1368"\w* \w que|strong="H1931"\w* \w hubo|strong="H1961"\w* en \w la|strong="H1931"\w* tierra.  
\v 9 Nimrod \w fue|strong="H1961"\w* un gran \w cazador|strong="H6718"\w* \w ante|strong="H6440"\w* Yahvé; \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w se|strong="H1961"\w* dice: “\w Como|strong="H1961"\w* Nimrod, gran \w cazador|strong="H6718"\w* \w ante|strong="H6440"\w* Yahvé”.  
\v 10 Las ciudades \w principales|strong="H7225"\w* de su \w reino|strong="H4467"\w* \w fueron|strong="H1961"\w* Babel, Érec, Acad y Calné, en la tierra de Sinar.  
\v 11 \w De|strong="H4480"\w* \w esa|strong="H1931"\w* tierra pasó \w a|strong="H3068"\w* Asiria, \w donde|strong="H1931"\w* construyó \w Nínive|strong="H5210"\w*, Rehobot Ir, Cálaj  
\v 12 y Resén, \w la|strong="H1931"\w* \w gran|strong="H1419"\w* \w ciudad|strong="H5892"\w* \w que|strong="H1931"\w* \w está|strong="H1931"\w* entre \w Nínive|strong="H5210"\w* y Cálaj.  
\v 13 Mizrayín fue el antepasado de los ludeos, los anameos, los lejabeos, los naftujeos,  
\v 14 los patrusim, los caslujeos (de \w donde|strong="H8033"\w* descendieron los \w filisteos|strong="H6430"\w*) y los caftoreos.   
\p
\v 15 \w Canaán|strong="H3667"\w* fue el padre de \w Sidón|strong="H6721"\w*, su \w primogénito|strong="H1060"\w*, y de Het.  
\v 16 También fue el antepasado de los \w jebuseos|strong="H2983"\w*, los amorreos, los \w gergeseos|strong="H1622"\w*,  
\v 17 los \w heveos|strong="H2340"\w*, los araceos, los sineos,  
\v 18 los arvadeos, los zemareos y los jamateos. Después las \w familias|strong="H4940"\w* cananeas se dispersaron.  
\v 19 El territorio \w de|strong="H5704"\w* \w los|strong="H1961"\w* \w cananeos|strong="H3669"\w* \w se|strong="H1961"\w* extendía \w desde|strong="H5704"\w* \w Sidón|strong="H6721"\w*, \w en|strong="H5704"\w* dirección \w a|strong="H3068"\w* \w Gerar|strong="H1642"\w*, \w hasta|strong="H5704"\w* \w Gaza|strong="H5804"\w*, \w y|strong="H5704"\w* \w en|strong="H5704"\w* dirección \w a|strong="H3068"\w* \w Sodoma|strong="H5467"\w*, \w Gomorra|strong="H6017"\w*, Admá \w y|strong="H5704"\w* Zeboín, \w hasta|strong="H5704"\w* \w Lasa|strong="H3962"\w*.  
\v 20 Éstos fueron \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Cam, según sus \w familias|strong="H4940"\w* y sus lenguas, en sus tierras y sus \w naciones|strong="H1471"\w*.   
\p
\v 21 \w También|strong="H1571"\w* \w Sem|strong="H8035"\w*, \w el|strong="H1931"\w* hermano \w mayor|strong="H1419"\w* \w de|strong="H1121"\w* Jafet, tuvo \w hijos|strong="H1121"\w*. \w Sem|strong="H8035"\w* \w fue|strong="H1931"\w* \w el|strong="H1931"\w* antepasado \w de|strong="H1121"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Héber|strong="H5677"\w*.  
\v 22 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Sem|strong="H8035"\w* fueron: \w Elam|strong="H5867"\w*, Asur, Arfaxad, \w Lud|strong="H3865"\w* y Aram.  
\v 23 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aram fueron: \w Uz|strong="H5780"\w*, \w Hul|strong="H2343"\w*, Guéter y Mas.  
\v 24 Arfaxad fue el padre de \w Selá|strong="H7974"\w*, y \w Selá|strong="H7974"\w* fue el padre de \w Héber|strong="H5677"\w*.  
\v 25 \w Héber|strong="H5677"\w* tuvo \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w*. Uno se \w llamaba|strong="H8034"\w* \w Péleg|strong="H6389"\w*, \w porque|strong="H3588"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w tiempo|strong="H3117"\w* se dividió \w la|strong="H3588"\w* tierra; \w su|strong="H3588"\w* hermano se \w llamaba|strong="H8034"\w* \w Joctán|strong="H3355"\w*.  
\v 26 \w Joctán|strong="H3355"\w* fue el padre de Almodad, Sélef, Jazarmávet, Jera,  
\v 27 Adorán, Uzal, \w Diclá|strong="H1853"\w*,  
\v 28 Obal, Abimael, Sabá,  
\v 29 Ofir, Javilá y \w Jobab|strong="H3103"\w*. \w Todos|strong="H3605"\w* \w éstos|strong="H3605"\w* fueron \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Joctán|strong="H3355"\w*.  
\v 30 Su territorio \w se|strong="H1961"\w* extendía desde Mesá, en dirección \w a|strong="H3068"\w* Sefar, en la región montañosa del \w oriente|strong="H6924"\w*.  
\v 31 Éstos fueron \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Sem|strong="H8035"\w*, según sus \w familias|strong="H4940"\w* y sus lenguas, en sus tierras y sus \w naciones|strong="H1471"\w*.   
\p
\v 32 Éstas son las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Noé|strong="H5146"\w*, según sus descendientes y sus \w naciones|strong="H1471"\w*. \w A|strong="H3068"\w* partir \w de|strong="H1121"\w* ellas se dispersaron las \w naciones|strong="H1471"\w* por toda la tierra después del \w diluvio|strong="H3999"\w*.   
\c 11  
\p
\v 1 En ese tiempo, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* mundo \w hablaba|strong="H1697"\w* un \w mismo|strong="H3605"\w* idioma y usaba las mismas \w palabras|strong="H1697"\w*.  
\v 2 Al emigrar desde \w el|strong="H3427"\w* \w oriente|strong="H6924"\w*, la gente encontró \w una|strong="H4672"\w* llanura en la tierra de Sinar y \w se|strong="H1961"\w* estableció \w allí|strong="H8033"\w*.  
\v 3 Un día \w se|strong="H1961"\w* dijeron unos \w a|strong="H3068"\w* otros: “Vengan, vamos \w a|strong="H3068"\w* fabricar \w ladrillos|strong="H3843"\w* y \w a|strong="H3068"\w* cocerlos al fuego”. Así, usaron \w ladrillos|strong="H3843"\w* en vez de piedras, y asfalto en vez de mezcla.  
\v 4 Luego dijeron: “Vengan, vamos \w a|strong="H3068"\w* construir una \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* una \w torre|strong="H4026"\w* \w que|strong="H5921"\w* llegue \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*. Así \w nos|strong="H5921"\w* \w haremos|strong="H6213"\w* famosos \w y|strong="H5921"\w* \w no|strong="H6435"\w* andaremos dispersos \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* mundo”.   
\p
\v 5 Pero Yahvé bajó para \w ver|strong="H7200"\w* la \w ciudad|strong="H5892"\w* y la \w torre|strong="H4026"\w* \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* estaban construyendo.  
\v 6 \w Y|strong="H3068"\w* dijo Yahvé: “Miren, \w todos|strong="H3605"\w* \w ellos|strong="H1992"\w* forman un solo \w pueblo|strong="H5971"\w* y hablan un solo idioma; ¡y \w esto|strong="H2088"\w* \w es|strong="H2088"\w* sólo \w el|strong="H3605"\w* \w comienzo|strong="H2490"\w* \w de|strong="H5971"\w* \w sus|strong="H1992"\w* obras! \w Ahora|strong="H6258"\w* \w nada|strong="H3808"\w* \w de|strong="H5971"\w* \w lo|strong="H2088"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* propongan \w les|strong="H1992"\w* \w será|strong="H3808"\w* imposible.  
\v 7 \w Será|strong="H3808"\w* mejor \w que|strong="H3808"\w* bajemos y confundamos su idioma, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* entiendan \w entre|strong="H3808"\w* ellos”.  
\v 8 Así Yahvé \w los|strong="H5921"\w* dispersó \w por|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w ellos|strong="H5921"\w* \w dejaron|strong="H2308"\w* \w de|strong="H5921"\w* construir \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.  
\v 9 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w la|strong="H5921"\w* ciudad \w se|strong="H5921"\w* \w llamó|strong="H7121"\w* Babel, \w porque|strong="H3588"\w* \w allí|strong="H8033"\w* \w confundió|strong="H1101"\w* Yahvé \w el|strong="H5921"\w* idioma \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* mundo, \w y|strong="H3588"\w* \w desde|strong="H5921"\w* \w allí|strong="H8033"\w* \w los|strong="H5921"\w* dispersó \w por|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra.   
\p
\v 10 Ésta es la historia \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Sem|strong="H8035"\w*. \w Dos|strong="H8141"\w* \w años|strong="H8141"\w* después del \w diluvio|strong="H3999"\w*, cuando \w Sem|strong="H8035"\w* tenía \w cien|strong="H3967"\w* \w años|strong="H8141"\w*, fue padre \w de|strong="H1121"\w* Arfaxad.  
\v 11 Después del nacimiento \w de|strong="H2568"\w* Arfaxad, \w Sem|strong="H8035"\w* \w vivió|strong="H2421"\w* \w quinientos|strong="H2568"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 12 Arfaxad tenía \w treinta|strong="H7970"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando fue padre \w de|strong="H2568"\w* \w Selá|strong="H7974"\w*.  
\v 13 Después del nacimiento \w de|strong="H1121"\w* \w Selá|strong="H7974"\w*, Arfaxad \w vivió|strong="H2421"\w* cuatrocientos \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 14 \w Selá|strong="H7974"\w* tenía \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* cuando fue padre de \w Héber|strong="H5677"\w*.  
\v 15 Después del nacimiento \w de|strong="H1121"\w* \w Héber|strong="H5677"\w*, \w Selá|strong="H7974"\w* \w vivió|strong="H2421"\w* cuatrocientos \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 16 \w Héber|strong="H5677"\w* tenía \w treinta|strong="H7970"\w* y cuatro \w años|strong="H8141"\w* cuando fue padre de \w Péleg|strong="H6389"\w*.  
\v 17 Después del nacimiento \w de|strong="H1121"\w* \w Péleg|strong="H6389"\w*, \w Héber|strong="H5677"\w* \w vivió|strong="H2421"\w* cuatrocientos \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 18 \w Péleg|strong="H6389"\w* tenía \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* cuando fue padre de \w Reu|strong="H7466"\w*.  
\v 19 Después del nacimiento \w de|strong="H1121"\w* \w Reu|strong="H7466"\w*, \w Péleg|strong="H6389"\w* \w vivió|strong="H2421"\w* \w doscientos|strong="H3967"\w* \w nueve|strong="H8672"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 20 \w Reu|strong="H7466"\w* tenía \w treinta|strong="H7970"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* cuando fue padre de \w Serug|strong="H8286"\w*.  
\v 21 Después del nacimiento \w de|strong="H1121"\w* \w Serug|strong="H8286"\w*, \w Reu|strong="H7466"\w* \w vivió|strong="H2421"\w* \w doscientos|strong="H3967"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 22 \w Serug|strong="H8286"\w* tenía \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* cuando fue padre de Nacor.  
\v 23 Después del nacimiento \w de|strong="H1121"\w* Nacor, \w Serug|strong="H8286"\w* \w vivió|strong="H2421"\w* \w doscientos|strong="H3967"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 24 Nacor tenía \w veintinueve|strong="H6242"\w* \w años|strong="H8141"\w* cuando fue padre de Taré.  
\v 25 Después del nacimiento \w de|strong="H1121"\w* Taré, Nacor \w vivió|strong="H2421"\w* \w ciento|strong="H3967"\w* \w diecinueve|strong="H8672"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w*, y tuvo otros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 26 Taré tenía \w setenta|strong="H7657"\w* \w años|strong="H8141"\w* cuando fue padre de Abram, Nacor y \w Harán|strong="H2039"\w*.   
\p
\v 27 Éstos son los descendientes de Taré. Taré fue el padre de Abram, Nacor y \w Harán|strong="H2039"\w*. \w Harán|strong="H2039"\w* fue el padre de \w Lot|strong="H3876"\w*.  
\v 28 \w Harán|strong="H2039"\w* \w murió|strong="H4191"\w* \w en|strong="H5921"\w* Ur \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w*, su tierra natal, mientras su padre Taré aún vivía.  
\v 29 Abram y Nacor se casaron. La esposa de Abram se \w llamaba|strong="H8034"\w* Saray. La esposa de Nacor se \w llamaba|strong="H8034"\w* \w Milca|strong="H4435"\w*, y era \w hija|strong="H1323"\w* de \w Harán|strong="H2039"\w*, el padre de \w Milca|strong="H4435"\w* \w e|strong="H3068"\w* Iscá.  
\v 30 Pero Saray \w era|strong="H1961"\w* estéril y \w no|strong="H1961"\w* podía \w tener|strong="H1961"\w* hijos.  
\v 31 Taré \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Abram, \w a|strong="H3068"\w* su \w nieto|strong="H1121"\w* \w Lot|strong="H3876"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Harán|strong="H2771"\w*, \w y|strong="H5704"\w* \w a|strong="H3068"\w* su \w nuera|strong="H3618"\w* Saray, la \w esposa|strong="H3618"\w* \w de|strong="H5704"\w* Abram, \w y|strong="H5704"\w* \w salieron|strong="H3318"\w* \w de|strong="H5704"\w* Ur \w de|strong="H5704"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w* \w para|strong="H5704"\w* \w ir|strong="H3212"\w* \w a|strong="H3068"\w* la tierra \w de|strong="H5704"\w* \w Canaán|strong="H3667"\w*. \w Al|strong="H5704"\w* llegar \w a|strong="H3068"\w* la ciudad \w de|strong="H5704"\w* Jarán, se quedaron \w a|strong="H3068"\w* vivir \w allí|strong="H8033"\w*.  
\v 32 Taré \w vivió|strong="H3117"\w* \w doscientos|strong="H3967"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w*, y \w murió|strong="H4191"\w* en Jarán.   
\c 12  
\p
\v 1 Yahvé le dijo \w a|strong="H3068"\w* Abram: “\w Vete|strong="H3212"\w* de tu tierra, de tu \w parentela|strong="H4138"\w* y de la \w casa|strong="H1004"\w* de tu padre \w a|strong="H3068"\w* la tierra que yo te \w mostraré|strong="H7200"\w*.  
\v 2 \w Haré|strong="H6213"\w* de ti una \w nación|strong="H1471"\w* \w grande|strong="H1419"\w*, y te \w bendeciré|strong="H1288"\w*; \w haré|strong="H6213"\w* famoso \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w*, y \w serás|strong="H1961"\w* una \w bendición|strong="H1293"\w*.  
\v 3 \w Bendeciré|strong="H1288"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* te bendigan y maldeciré \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* te \w maldigan|strong="H7043"\w*; ¡por medio de ti serán benditas \w todas|strong="H3605"\w* las \w familias|strong="H4940"\w* de \w la|strong="H3605"\w* tierra!”   
\p
\v 4 Abram \w partió|strong="H3212"\w*, tal como Yahvé se lo había ordenado, y \w Lot|strong="H3876"\w* se \w fue|strong="H3212"\w* con \w él|strong="H1121"\w*. Abram tenía \w setenta|strong="H7657"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando \w salió|strong="H3318"\w* \w de|strong="H2568"\w* Jarán.  
\v 5 \w Tomó|strong="H3947"\w* \w a|strong="H3068"\w* su esposa Saray, \w a|strong="H3068"\w* su \w nieto|strong="H1121"\w* \w Lot|strong="H3876"\w*, y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* bienes y las \w personas|strong="H5315"\w* \w que|strong="H1121"\w* habían adquirido \w en|strong="H3318"\w* Jarán, y se \w pusieron|strong="H6213"\w* \w en|strong="H3318"\w* camino \w hacia|strong="H6213"\w* \w la|strong="H3605"\w* tierra \w de|strong="H1121"\w* \w Canaán|strong="H3667"\w*. Cuando llegaron \w a|strong="H3068"\w* \w Canaán|strong="H3667"\w*,  
\v 6 Abram atravesó la tierra \w hasta|strong="H5704"\w* llegar \w al|strong="H5704"\w* \w lugar|strong="H4725"\w* \w de|strong="H5704"\w* Siquén, \w donde|strong="H4725"\w* está la encina \w de|strong="H5704"\w* Moré. \w En|strong="H5704"\w* aquel tiempo, los \w cananeos|strong="H3669"\w* vivían \w en|strong="H5704"\w* esa región.   
\p
\v 7 \w Allí|strong="H8033"\w* Yahvé se le \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* Abram y le dijo: “Yo le \w daré|strong="H5414"\w* \w esta|strong="H2063"\w* tierra \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w*”. Entonces Abram construyó \w allí|strong="H8033"\w* un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé, quien se le había aparecido.  
\v 8 De \w allí|strong="H8033"\w* pasó \w a|strong="H3068"\w* la región montañosa que \w está|strong="H8033"\w* al \w oriente|strong="H6924"\w* de Betel, \w donde|strong="H8033"\w* plantó su tienda, \w entre|strong="H8033"\w* Betel al occidente y Ay al \w oriente|strong="H6924"\w*. También \w allí|strong="H8033"\w* construyó un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé \w e|strong="H3068"\w* invocó su \w nombre|strong="H8034"\w*.  
\v 9 Después Abram siguió su \w camino|strong="H1980"\w* por etapas \w hacia|strong="H5045"\w* el Néguev.   
\p
\v 10 \w Hubo|strong="H1961"\w* \w entonces|strong="H3588"\w* una gran escasez \w de|strong="H3588"\w* comida \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra, \w por|strong="H3588"\w* lo \w que|strong="H3588"\w* Abram bajó \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w para|strong="H3588"\w* vivir \w allí|strong="H8033"\w* \w por|strong="H3588"\w* un tiempo, \w pues|strong="H3588"\w* \w el|strong="H3588"\w* \w hambre|strong="H7458"\w* \w era|strong="H1961"\w* terrible.  
\v 11 \w Cuando|strong="H3588"\w* \w estaba|strong="H1961"\w* \w por|strong="H3588"\w* entrar \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*, le dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposa Saray: “Escúchame; \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w eres|strong="H1961"\w* una mujer \w hermosa|strong="H3303"\w*.  
\v 12 \w Cuando|strong="H3588"\w* \w los|strong="H1961"\w* \w egipcios|strong="H4713"\w* \w te|strong="H3588"\w* \w vean|strong="H7200"\w*, dirán: ‘\w Ésta|strong="H2063"\w* \w es|strong="H1961"\w* \w su|strong="H3588"\w* esposa’, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w me|strong="H3588"\w* \w matarán|strong="H2026"\w*, \w pero|strong="H3588"\w* \w a|strong="H3068"\w* ti \w te|strong="H3588"\w* dejarán \w con|strong="H3588"\w* \w vida|strong="H2421"\w*.  
\v 13 \w Por|strong="H4616"\w* favor, di \w que|strong="H4994"\w* eres \w mi|strong="H4994"\w* hermana, \w para|strong="H4616"\w* \w que|strong="H4994"\w* me traten \w bien|strong="H3190"\w* \w por|strong="H4616"\w* tu culpa y me dejen \w vivir|strong="H2421"\w* gracias \w a|strong="H3068"\w* ti”.   
\p
\v 14 \w En|strong="H3588"\w* efecto, \w cuando|strong="H3588"\w* Abram entró \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w los|strong="H1931"\w* \w egipcios|strong="H4713"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* Saray \w era|strong="H1961"\w* \w muy|strong="H3966"\w* \w hermosa|strong="H3303"\w*.  
\v 15 También la \w vieron|strong="H7200"\w* los funcionarios del \w faraón|strong="H6547"\w* y le hablaron \w de|strong="H8269"\w* ella \w a|strong="H3068"\w* su soberano, por lo que Saray fue \w llevada|strong="H3947"\w* al palacio.  
\v 16 Gracias \w a|strong="H3068"\w* ella, el faraón trató \w muy|strong="H3190"\w* \w bien|strong="H3190"\w* \w a|strong="H3068"\w* Abram, quien llegó \w a|strong="H3068"\w* \w tener|strong="H1961"\w* \w ovejas|strong="H6629"\w*, \w vacas|strong="H1241"\w*, burros \w y|strong="H1241"\w* burras, \w siervos|strong="H5650"\w* \w y|strong="H1241"\w* \w siervas|strong="H8198"\w*, \w y|strong="H1241"\w* \w camellos|strong="H1581"\w*.  
\v 17 Pero \w por|strong="H5921"\w* \w causa|strong="H1697"\w* \w de|strong="H5921"\w* Saray, \w la|strong="H5921"\w* esposa \w de|strong="H5921"\w* Abram, Yahvé envió terribles \w plagas|strong="H1419"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w y|strong="H5921"\w* su \w familia|strong="H1004"\w*.  
\v 18 \w Entonces|strong="H3588"\w* \w el|strong="H1931"\w* \w faraón|strong="H6547"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Abram \w y|strong="H3588"\w* \w le|strong="H1931"\w* reclamó: “¿\w Qué|strong="H3588"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* has \w hecho|strong="H6213"\w*? ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* dijiste \w que|strong="H3588"\w* \w era|strong="H1931"\w* \w tu|strong="H6213"\w* esposa?  
\v 19 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* dijiste: ‘\w Es|strong="H1931"\w* \w mi|strong="H2009"\w* hermana’? ¡\w Yo|strong="H2009"\w* pude haberla \w tomado|strong="H3947"\w* \w por|strong="H4100"\w* esposa! ¡\w Aquí|strong="H2009"\w* tienes \w a|strong="H3068"\w* tu mujer; \w tómala|strong="H3947"\w* y \w vete|strong="H3212"\w*!”   
\p
\v 20 Entonces \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w les|strong="H5921"\w* dio órdenes \w a|strong="H3068"\w* sus hombres \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* Abram, \w y|strong="H5921"\w* \w ellos|strong="H5921"\w* \w lo|strong="H5921"\w* despidieron \w junto|strong="H5921"\w* \w con|strong="H5921"\w* su mujer \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* tenía.   
\c 13  
\p
\v 1 Abram \w salió|strong="H5927"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w* y \w se|strong="H1931"\w* \w fue|strong="H1931"\w* al Néguev, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w su|strong="H1931"\w* mujer y \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w tenía|strong="H1931"\w*. \w Lot|strong="H3876"\w* también iba \w con|strong="H5973"\w* \w él|strong="H1931"\w*.  
\v 2 Abram ya era \w muy|strong="H3966"\w* rico en \w ganado|strong="H4735"\w*, \w plata|strong="H3701"\w* y \w oro|strong="H2091"\w*.  
\v 3 Del Néguev, Abram volvió \w por|strong="H5704"\w* etapas \w hasta|strong="H5704"\w* llegar \w a|strong="H3068"\w* Betel, \w al|strong="H5704"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w antes|strong="H5704"\w* \w había|strong="H1961"\w* plantado su tienda, \w entre|strong="H8033"\w* Betel \w y|strong="H5704"\w* Ay.  
\v 4 \w Allí|strong="H8033"\w* estaba \w el|strong="H6213"\w* \w altar|strong="H4196"\w* que \w antes|strong="H7223"\w* \w había|strong="H6213"\w* construido, y \w allí|strong="H8033"\w* Abram invocó \w el|strong="H6213"\w* \w nombre|strong="H8034"\w* de Yahvé.  
\v 5 \w También|strong="H1571"\w* \w Lot|strong="H3876"\w*, \w que|strong="H1571"\w* acompañaba \w a|strong="H3068"\w* Abram, \w tenía|strong="H1961"\w* sus propias \w ovejas|strong="H6629"\w*, \w vacas|strong="H1241"\w* \w y|strong="H1571"\w* tiendas.  
\v 6 \w Pero|strong="H3588"\w* \w la|strong="H3588"\w* región \w no|strong="H3808"\w* bastaba \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H3427"\w* dos vivieran \w juntos|strong="H3162"\w*, \w porque|strong="H3588"\w* \w tenían|strong="H1961"\w* demasiadas posesiones.  
\v 7 Por eso \w hubo|strong="H1961"\w* pleitos entre \w los|strong="H3427"\w* pastores de Abram y \w los|strong="H3427"\w* de \w Lot|strong="H3876"\w*. En aquel tiempo, \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* y \w los|strong="H3427"\w* ferezeos también \w vivían|strong="H3427"\w* en esa región.  
\v 8 \w Entonces|strong="H3588"\w* Abram le dijo \w a|strong="H3068"\w* \w Lot|strong="H3876"\w*: “\w No|strong="H3588"\w* debe \w haber|strong="H1961"\w* pleitos \w entre|strong="H3588"\w* nosotros, ni \w entre|strong="H3588"\w* tus pastores \w y|strong="H3588"\w* \w los|strong="H1961"\w* míos, \w porque|strong="H3588"\w* \w somos|strong="H1961"\w* parientes.  
\v 9 ¿Acaso \w no|strong="H3808"\w* tienes \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w ante|strong="H6440"\w* tus ojos? \w Por|strong="H5921"\w* favor, sepárate \w de|strong="H5921"\w* \w mí|strong="H5921"\w*. \w Si|strong="H3808"\w* \w te|strong="H5921"\w* vas \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w*, \w yo|strong="H4994"\w* \w me|strong="H5921"\w* iré \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w*; \w y|strong="H5921"\w* \w si|strong="H3808"\w* \w te|strong="H5921"\w* vas \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w*, \w yo|strong="H4994"\w* \w me|strong="H5921"\w* iré \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w*”.   
\p
\v 10 \w Lot|strong="H3876"\w* \w miró|strong="H7200"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* alrededor \w y|strong="H3588"\w* \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* valle del \w Jordán|strong="H3383"\w*, hasta llegar \w a|strong="H3068"\w* \w Zoar|strong="H6820"\w*, era tierra \w de|strong="H3588"\w* regadío, \w como|strong="H3588"\w* \w el|strong="H3588"\w* jardín \w de|strong="H3588"\w* Yahvé \w o|strong="H3068"\w* \w como|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. Esto fue \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé destruyera \w a|strong="H3068"\w* \w Sodoma|strong="H5467"\w* \w y|strong="H3588"\w* \w Gomorra|strong="H6017"\w*.  
\v 11 Entonces \w Lot|strong="H3876"\w* escogió \w para|strong="H5921"\w* \w sí|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* valle \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w* \w y|strong="H5921"\w* \w partió|strong="H5265"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w oriente|strong="H6924"\w*. Así \w fue|strong="H5265"\w* \w como|strong="H5921"\w* \w se|strong="H5921"\w* separaron \w el|strong="H5921"\w* uno \w del|strong="H5921"\w* otro.  
\v 12 Abram se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w en|strong="H5704"\w* la tierra \w de|strong="H5704"\w* \w Canaán|strong="H3667"\w*, \w mientras|strong="H5704"\w* \w que|strong="H5704"\w* \w Lot|strong="H3876"\w* se estableció entre las \w ciudades|strong="H5892"\w* del valle \w y|strong="H5704"\w* fue plantando sus tiendas cerca \w de|strong="H5704"\w* \w Sodoma|strong="H5467"\w*.  
\v 13 Pero los habitantes \w de|strong="H7451"\w* \w Sodoma|strong="H5467"\w* eran \w muy|strong="H3966"\w* \w malos|strong="H7451"\w* y cometían grandes pecados contra Yahvé.   
\p
\v 14 Después \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w Lot|strong="H3876"\w* \w se|strong="H4480"\w* separó \w de|strong="H4480"\w* \w él|strong="H5973"\w*, Yahvé \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* Abram: “\w Levanta|strong="H5375"\w* \w los|strong="H5973"\w* \w ojos|strong="H5869"\w* y, \w desde|strong="H4480"\w* \w donde|strong="H8033"\w* estás, \w mira|strong="H7200"\w* \w hacia|strong="H4480"\w* \w el|strong="H5973"\w* \w norte|strong="H6828"\w* y \w el|strong="H5973"\w* sur, \w hacia|strong="H4480"\w* \w el|strong="H5973"\w* \w oriente|strong="H6924"\w* y \w el|strong="H5973"\w* occidente.  
\v 15 \w Yo|strong="H3588"\w* \w te|strong="H3588"\w* \w daré|strong="H5414"\w* \w a|strong="H3068"\w* ti \w y|strong="H3588"\w* \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w*, \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* alcanzas \w a|strong="H3068"\w* \w ver|strong="H7200"\w*.  
\v 16 \w Haré|strong="H7760"\w* \w que|strong="H1571"\w* tu \w descendencia|strong="H2233"\w* sea \w como|strong="H1571"\w* \w el|strong="H1571"\w* \w polvo|strong="H6083"\w* de \w la|strong="H1571"\w* \w tierra|strong="H6083"\w*; ¡\w si|strong="H1571"\w* alguien \w puede|strong="H3201"\w* contar \w el|strong="H1571"\w* \w polvo|strong="H6083"\w* de \w la|strong="H1571"\w* \w tierra|strong="H6083"\w*, \w también|strong="H1571"\w* \w podrá|strong="H3201"\w* contar \w a|strong="H3068"\w* tus descendientes!  
\v 17 ¡\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* recorre \w la|strong="H3588"\w* tierra \w a|strong="H3068"\w* lo largo \w y|strong="H3588"\w* \w a|strong="H3068"\w* lo ancho, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w la|strong="H3588"\w* \w doy|strong="H5414"\w* \w a|strong="H3068"\w* ti!”   
\p
\v 18 Entonces Abram levantó su campamento y se fue \w a|strong="H3068"\w* vivir cerca \w del|strong="H4196"\w* encinar de \w Mamre|strong="H4471"\w*, en \w Hebrón|strong="H2275"\w*, \w donde|strong="H8033"\w* construyó un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé.   
\c 14  
\p
\v 1 En aquel \w tiempo|strong="H3117"\w*, Amrafel \w era|strong="H1961"\w* \w rey|strong="H4428"\w* de Sinar; Arioc, \w rey|strong="H4428"\w* de Elasar; Quedorlaomer, \w rey|strong="H4428"\w* de \w Elam|strong="H5867"\w*; y Tidal, \w rey|strong="H4428"\w* de Goyín.  
\v 2 \w Estos|strong="H1931"\w* \w reyes|strong="H4428"\w* \w le|strong="H1931"\w* declararon \w la|strong="H1931"\w* \w guerra|strong="H4421"\w* \w a|strong="H3068"\w* \w Bera|strong="H1298"\w*, \w rey|strong="H4428"\w* de \w Sodoma|strong="H5467"\w*; \w a|strong="H3068"\w* Birsá, \w rey|strong="H4428"\w* de \w Gomorra|strong="H6017"\w*; \w a|strong="H3068"\w* Sinab, \w rey|strong="H4428"\w* de Admá; \w a|strong="H3068"\w* Semeber, \w rey|strong="H4428"\w* de Zeboín; y \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de \w Bela|strong="H1106"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w Zoar|strong="H6820"\w*.  
\v 3 \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* últimos \w se|strong="H1931"\w* aliaron en \w el|strong="H1931"\w* \w valle|strong="H6010"\w* de Sidín, \w donde|strong="H1931"\w* ahora \w está|strong="H1931"\w* \w el|strong="H1931"\w* \w Mar|strong="H3220"\w* Muerto.  
\v 4 Durante \w doce|strong="H8147"\w* \w años|strong="H8141"\w* habían estado bajo el dominio de Quedorlaomer, pero en el \w año|strong="H8141"\w* \w trece|strong="H7969"\w* se rebelaron.  
\v 5 \w Al|strong="H4428"\w* \w año|strong="H8141"\w* siguiente, Quedorlaomer y los \w reyes|strong="H4428"\w* que estaban con él marcharon y derrotaron \w a|strong="H3068"\w* los refaítas \w en|strong="H5221"\w* Asterot Carnayín, \w a|strong="H3068"\w* los zuzitas \w en|strong="H5221"\w* Jan, \w a|strong="H3068"\w* los emitas \w en|strong="H5221"\w* Savé Quiriataín  
\v 6 \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* horeos \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w de|strong="H5921"\w* \w Seir|strong="H8165"\w*, \w hasta|strong="H5704"\w* \w El|strong="H5921"\w* Parán, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w cerca|strong="H5921"\w* \w del|strong="H5921"\w* \w desierto|strong="H4057"\w*.  
\v 7 De regreso, \w pasaron|strong="H3427"\w* por \w En|strong="H5221"\w* Mispat, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w Cades|strong="H6946"\w*, \w y|strong="H1571"\w* conquistaron \w todo|strong="H3605"\w* \w el|strong="H1931"\w* territorio de \w los|strong="H3427"\w* amalecitas, \w y|strong="H1571"\w* \w también|strong="H1571"\w* derrotaron \w a|strong="H3068"\w* \w los|strong="H3427"\w* amorreos \w que|strong="H1931"\w* \w vivían|strong="H3427"\w* \w en|strong="H5221"\w* Jazezón Tamar.  
\v 8 Entonces \w salieron|strong="H3318"\w* \w los|strong="H1931"\w* \w reyes|strong="H4428"\w* de \w Sodoma|strong="H5467"\w*, de \w Gomorra|strong="H6017"\w*, de Admá, de Zeboín y de \w Bela|strong="H1106"\w* (\w que|strong="H1931"\w* \w es|strong="H1931"\w* \w Zoar|strong="H6820"\w*), y \w en|strong="H3318"\w* \w el|strong="H1931"\w* \w valle|strong="H6010"\w* de Sidín \w presentaron|strong="H6186"\w* \w batalla|strong="H4421"\w*  
\v 9 contra Quedorlaomer, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Elam|strong="H5867"\w*; Tidal, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* Goyín; Amrafel, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* Sinar; y Arioc, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* Elasar. Eran cuatro \w reyes|strong="H4428"\w* contra \w cinco|strong="H2568"\w*.  
\v 10 Como \w el|strong="H5307"\w* \w valle|strong="H6010"\w* de Sidín estaba lleno de pozos de asfalto, cuando los \w reyes|strong="H4428"\w* de \w Sodoma|strong="H5467"\w* y de \w Gomorra|strong="H6017"\w* \w huyeron|strong="H5127"\w*, \w cayeron|strong="H5307"\w* en ellos, y los demás escaparon \w hacia|strong="H8033"\w* los \w montes|strong="H2022"\w*.  
\v 11 \w Los|strong="H3605"\w* vencedores se \w llevaron|strong="H3947"\w* \w todas|strong="H3605"\w* las \w riquezas|strong="H7399"\w* de \w Sodoma|strong="H5467"\w* y de \w Gomorra|strong="H6017"\w*, y \w todas|strong="H3605"\w* sus provisiones.  
\v 12 También \w se|strong="H1931"\w* \w llevaron|strong="H3947"\w* \w a|strong="H3068"\w* \w Lot|strong="H3876"\w*, \w el|strong="H1931"\w* sobrino \w de|strong="H1121"\w* Abram, junto con todas \w sus|strong="H1931"\w* posesiones, ya \w que|strong="H1931"\w* \w él|strong="H1931"\w* \w vivía|strong="H3427"\w* \w en|strong="H3212"\w* \w Sodoma|strong="H5467"\w*.   
\p
\v 13 Uno de \w los|strong="H1992"\w* \w que|strong="H1931"\w* escaparon \w fue|strong="H1931"\w* \w a|strong="H3068"\w* contarle todo \w esto|strong="H1931"\w* \w a|strong="H3068"\w* Abram \w el|strong="H1931"\w* \w hebreo|strong="H5680"\w*, \w que|strong="H1931"\w* vivía cerca del encinar de \w Mamre|strong="H4471"\w* \w el|strong="H1931"\w* amorreo. \w Mamre|strong="H4471"\w* \w era|strong="H1931"\w* hermano de Escol y de \w Aner|strong="H6063"\w*, \w los|strong="H1992"\w* cuales eran aliados de Abram.  
\v 14 \w Cuando|strong="H3588"\w* Abram se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* sobrino \w estaba|strong="H1004"\w* \w cautivo|strong="H7617"\w*, organizó \w a|strong="H3068"\w* \w trescientos|strong="H7969"\w* \w dieciocho|strong="H8083"\w* hombres \w de|strong="H3588"\w* confianza, \w nacidos|strong="H3211"\w* \w en|strong="H5704"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*, \w y|strong="H3588"\w* \w persiguió|strong="H7291"\w* \w a|strong="H3068"\w* \w los|strong="H7291"\w* reyes \w hasta|strong="H5704"\w* \w Dan|strong="H1835"\w*.  
\v 15 Durante \w la|strong="H1931"\w* \w noche|strong="H3915"\w*, Abram \w y|strong="H5921"\w* \w sus|strong="H1931"\w* hombres \w se|strong="H1931"\w* dividieron \w para|strong="H5704"\w* atacarlos, \w y|strong="H5921"\w* \w los|strong="H5921"\w* derrotaron \w y|strong="H5921"\w* \w persiguieron|strong="H7291"\w* \w hasta|strong="H5704"\w* Hobá, \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w al|strong="H5921"\w* norte \w de|strong="H5921"\w* \w Damasco|strong="H1834"\w*.  
\v 16 \w Así|strong="H1571"\w* \w recuperó|strong="H7725"\w* \w todas|strong="H3605"\w* las \w riquezas|strong="H7399"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* su sobrino \w Lot|strong="H3876"\w* \w con|strong="H1571"\w* sus posesiones, \w y|strong="H1571"\w* \w a|strong="H3068"\w* las mujeres \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w la|strong="H1571"\w* \w demás|strong="H1571"\w* \w gente|strong="H5971"\w*.   
\p
\v 17 Cuando Abram \w volvía|strong="H7725"\w* de derrotar \w a|strong="H3068"\w* Quedorlaomer y \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w reyes|strong="H4428"\w* \w que|strong="H1931"\w* \w lo|strong="H1931"\w* acompañaban, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* de \w Sodoma|strong="H5467"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibirlo \w al|strong="H4428"\w* \w valle|strong="H6010"\w* de Savé, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w Valle|strong="H6010"\w* del \w Rey|strong="H4428"\w*.  
\v 18 Entonces Melquisedec, \w rey|strong="H4428"\w* de \w Salén|strong="H3318"\w* y \w sacerdote|strong="H3548"\w* del Dios \w Altísimo|strong="H5945"\w*, \w sacó|strong="H3318"\w* \w pan|strong="H3899"\w* y \w vino|strong="H3196"\w*;  
\v 19 \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* Abram con estas palabras: “¡Que te \w bendiga|strong="H1288"\w* el Dios \w Altísimo|strong="H5945"\w*, creador del \w cielo|strong="H8064"\w* y de la tierra!  
\v 20 ¡\w Y|strong="H3068"\w* \w bendito|strong="H1288"\w* sea \w el|strong="H3605"\w* Dios \w Altísimo|strong="H5945"\w*, \w que|strong="H3605"\w* \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* tus \w enemigos|strong="H6862"\w* en tus \w manos|strong="H3027"\w*!” Entonces Abram le \w dio|strong="H5414"\w* \w a|strong="H3068"\w* Melquisedec \w la|strong="H3605"\w* \w décima|strong="H4643"\w* parte \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* había recuperado.   
\p
\v 21 El \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Sodoma|strong="H5467"\w* le dijo \w a|strong="H3068"\w* Abram: “\w Dame|strong="H5414"\w* \w a|strong="H3068"\w* las \w personas|strong="H5315"\w* y quédate con las \w riquezas|strong="H7399"\w*”.  
\v 22 Pero Abram le respondió \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de \w Sodoma|strong="H5467"\w*: “He jurado \w por|strong="H3027"\w* Yahvé, el \w Dios|strong="H3068"\w* \w Altísimo|strong="H5945"\w*, creador del \w cielo|strong="H8064"\w* y de la tierra,  
\v 23 \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w tomaré|strong="H3947"\w* \w nada|strong="H3808"\w* \w de|strong="H5704"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* es tuyo, \w ni|strong="H3808"\w* siquiera un hilo \w o|strong="H3068"\w* \w la|strong="H3605"\w* correa \w de|strong="H5704"\w* una sandalia, \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* digas: ‘Yo \w enriquecí|strong="H6238"\w* \w a|strong="H3068"\w* Abram’.  
\v 24 No quiero nada \w para|strong="H7535"\w* mí, \w fuera|strong="H1107"\w* de \w lo|strong="H1992"\w* \w que|strong="H1992"\w* mis hombres ya han comido. En cuanto \w a|strong="H3068"\w* la \w parte|strong="H2506"\w* \w que|strong="H1992"\w* \w les|strong="H1992"\w* corresponde \w a|strong="H3068"\w* \w los|strong="H1992"\w* hombres \w que|strong="H1992"\w* me acompañaron, es decir, \w Aner|strong="H6063"\w*, Escol y \w Mamre|strong="H4471"\w*, \w que|strong="H1992"\w* \w se|strong="H1992"\w* queden \w ellos|strong="H1992"\w* con \w su|strong="H1992"\w* \w parte|strong="H2506"\w*”.   
\c 15  
\p
\v 1 \w Después|strong="H1961"\w* \w de|strong="H1697"\w* \w esto|strong="H1697"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* Abram en una \w visión|strong="H4236"\w*: “\w No|strong="H1961"\w* tengas \w miedo|strong="H3372"\w*, Abram. Yo \w soy|strong="H1961"\w* tu \w escudo|strong="H4043"\w*; tu recompensa \w será|strong="H1961"\w* \w muy|strong="H3966"\w* \w grande|strong="H7235"\w*”.   
\p
\v 2 Pero Abram \w le|strong="H1931"\w* respondió: “Señor\f + \fr 15:2 \ft La palabra traducida “Señor” es “Adonai”.\f* Yahvé, ¿\w qué|strong="H4100"\w* me puedes \w dar|strong="H5414"\w*, \w si|strong="H1931"\w* \w no|strong="H4100"\w* tengo \w hijos|strong="H1121"\w*, y \w el|strong="H1931"\w* heredero \w de|strong="H1121"\w* \w mis|strong="H5414"\w* bienes \w será|strong="H1931"\w* Eliezer \w de|strong="H1121"\w* \w Damasco|strong="H1834"\w*?”  
\v 3 \w Y|strong="H3068"\w* Abram añadió: “Como \w no|strong="H3808"\w* me \w has|strong="H5414"\w* \w dado|strong="H5414"\w* \w ningún|strong="H3808"\w* \w hijo|strong="H1121"\w*, \w el|strong="H1121"\w* \w heredero|strong="H3423"\w* \w de|strong="H1121"\w* todo \w será|strong="H3808"\w* un siervo nacido en \w mi|strong="H2009"\w* \w casa|strong="H1004"\w*”.   
\p
\v 4 \w Entonces|strong="H3588"\w* \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé vino \w a|strong="H3068"\w* \w él|strong="H1931"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijo: “\w Ese|strong="H1931"\w* hombre \w no|strong="H3808"\w* \w será|strong="H1931"\w* tu \w heredero|strong="H3423"\w*; tu \w heredero|strong="H3423"\w* \w será|strong="H1931"\w* tu propio hijo”.  
\v 5 \w Luego|strong="H4994"\w* Yahvé lo llevó \w afuera|strong="H2351"\w* \w y|strong="H3541"\w* le dijo: “\w Mira|strong="H5027"\w* al \w cielo|strong="H8064"\w* \w y|strong="H3541"\w* \w cuenta|strong="H5608"\w* las \w estrellas|strong="H3556"\w*, \w a|strong="H3068"\w* \w ver|strong="H5027"\w* \w si|strong="H4994"\w* \w puedes|strong="H3201"\w* contarlas”. \w Y|strong="H3068"\w* añadió: “\w Así|strong="H3541"\w* de numerosa \w será|strong="H1961"\w* tu \w descendencia|strong="H2233"\w*”.  
\v 6 Abram le creyó \w a|strong="H3068"\w* Yahvé, y el \w Señor|strong="H3068"\w* se lo reconoció como \w justicia|strong="H6666"\w*.  
\v 7 Además, le dijo: “Yo soy Yahvé, que te \w saqué|strong="H3318"\w* \w de|strong="H5414"\w* Ur \w de|strong="H5414"\w* los \w caldeos|strong="H3778"\w* \w para|strong="H5414"\w* darte \w esta|strong="H2063"\w* tierra como herencia”.   
\p
\v 8 \w Pero|strong="H3588"\w* Abram le preguntó: “Señor Yahvé, ¿\w cómo|strong="H4100"\w* sabré \w que|strong="H3588"\w* esta tierra \w va|strong="H3068"\w* \w a|strong="H3068"\w* ser mía?”   
\p
\v 9 Yahvé le respondió: “Tráeme una ternera, una \w cabra|strong="H5795"\w* y un carnero, todos de tres años, y también una tórtola y un pichón de paloma”.  
\v 10 Abram le trajo \w todos|strong="H3605"\w* \w estos|strong="H3605"\w* animales, \w los|strong="H3605"\w* \w partió|strong="H1335"\w* \w por|strong="H5414"\w* \w la|strong="H3605"\w* \w mitad|strong="H8432"\w* y \w puso|strong="H5414"\w* \w cada|strong="H3605"\w* \w mitad|strong="H8432"\w* \w frente|strong="H7125"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* otra, pero \w no|strong="H3808"\w* \w partió|strong="H1335"\w* las aves.  
\v 11 Cuando \w las|strong="H5921"\w* \w aves|strong="H5861"\w* \w de|strong="H5921"\w* rapiña \w bajaron|strong="H3381"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* animales \w muertos|strong="H6297"\w*, Abram \w las|strong="H5921"\w* espantó.   
\p
\v 12 \w Al|strong="H5921"\w* atardecer, Abram \w cayó|strong="H5307"\w* \w en|strong="H5921"\w* un sueño profundo, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* invadió un temor \w y|strong="H5921"\w* una \w gran|strong="H1419"\w* oscuridad.  
\v 13 \w Entonces|strong="H3588"\w* Yahvé le dijo: “\w Ten|strong="H3045"\w* \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* tus descendientes vivirán \w como|strong="H3588"\w* \w extranjeros|strong="H1616"\w* \w en|strong="H3588"\w* un país \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w será|strong="H1961"\w* \w el|strong="H3588"\w* suyo. Allí \w serán|strong="H1961"\w* esclavos, \w y|strong="H3588"\w* \w los|strong="H1961"\w* maltratarán durante cuatrocientos \w años|strong="H8141"\w*.  
\v 14 Pero yo \w también|strong="H1571"\w* castigaré \w a|strong="H3068"\w* \w la|strong="H1571"\w* \w nación|strong="H1471"\w* de \w la|strong="H1571"\w* \w que|strong="H1571"\w* serán esclavos, \w y|strong="H1571"\w* después \w saldrán|strong="H3318"\w* de allí \w con|strong="H1571"\w* \w grandes|strong="H1419"\w* \w riquezas|strong="H7399"\w*.  
\v 15 Tú, por tu parte, morirás \w en|strong="H6912"\w* \w paz|strong="H7965"\w* y serás \w enterrado|strong="H6912"\w* \w a|strong="H3068"\w* una edad muy avanzada.  
\v 16 \w En|strong="H5704"\w* \w la|strong="H3588"\w* cuarta \w generación|strong="H1755"\w* tus descendientes \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* este lugar, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* amorreos \w aún|strong="H5704"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* llegado \w a|strong="H3068"\w* \w su|strong="H3588"\w* límite”.  
\v 17 \w Cuando|strong="H1961"\w* \w el|strong="H5674"\w* \w sol|strong="H8121"\w* \w se|strong="H1961"\w* puso y todo \w quedó|strong="H1961"\w* \w a|strong="H3068"\w* oscuras, aparecieron un \w horno|strong="H8574"\w* humeante y una antorcha encendida, \w los|strong="H1961"\w* cuales \w pasaron|strong="H5674"\w* por en medio de \w los|strong="H1961"\w* animales descuartizados.  
\v 18 \w Aquel|strong="H1931"\w* \w día|strong="H3117"\w* Yahvé \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5704"\w* Abram, diciendo: “\w A|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w le|strong="H1931"\w* he \w dado|strong="H5414"\w* \w esta|strong="H2063"\w* tierra, \w desde|strong="H5704"\w* \w el|strong="H1931"\w* \w río|strong="H5104"\w* \w de|strong="H5704"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w gran|strong="H1419"\w* \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w*:  
\v 19 la tierra de los quenitas, de los quenizitas, de los cadmonitas,  
\v 20 de los hititas, de los ferezeos, de los refaítas,  
\v 21 de los amorreos, de los \w cananeos|strong="H3669"\w*, de los \w gergeseos|strong="H1622"\w* y de los \w jebuseos|strong="H2983"\w*”.   
\c 16  
\p
\v 1 \w Sarai|strong="H8297"\w*, la esposa de Abram, \w no|strong="H3808"\w* le había dado hijos. Pero tenía una esclava \w egipcia|strong="H4713"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w llamaba|strong="H8034"\w* \w Agar|strong="H1904"\w*.  
\v 2 Entonces \w Sarai|strong="H8297"\w* le dijo \w a|strong="H3068"\w* Abram: “\w Mira|strong="H2009"\w*, Yahvé no \w me|strong="H4480"\w* ha permitido tener hijos. \w Por|strong="H4480"\w* favor, ten relaciones \w con|strong="H4480"\w* \w mi|strong="H2009"\w* esclava; tal vez pueda formar una familia \w por|strong="H4480"\w* medio \w de|strong="H4480"\w* \w ella|strong="H4480"\w*”. \w Y|strong="H3068"\w* Abram aceptó la propuesta \w de|strong="H4480"\w* \w Sarai|strong="H8297"\w*.  
\v 3 Así que \w Sarai|strong="H8297"\w*, la esposa \w de|strong="H5414"\w* Abram, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su esclava \w Agar|strong="H1904"\w* la \w egipcia|strong="H4713"\w* y se la \w dio|strong="H5414"\w* \w a|strong="H3068"\w* su esposo \w por|strong="H5414"\w* mujer. Esto ocurrió cuando Abram ya llevaba \w diez|strong="H6235"\w* \w años|strong="H8141"\w* viviendo en la tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w*.  
\v 4 Abram tuvo relaciones \w con|strong="H3588"\w* \w Agar|strong="H1904"\w*, \w y|strong="H3588"\w* ella quedó \w embarazada|strong="H2029"\w*. Al darse cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* estaba \w embarazada|strong="H2029"\w*, \w Agar|strong="H1904"\w* comenzó \w a|strong="H3068"\w* \w mirar|strong="H7200"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w señora|strong="H1404"\w* \w con|strong="H3588"\w* desprecio.  
\v 5 \w Entonces|strong="H3588"\w* \w Sarai|strong="H8297"\w* \w le|strong="H5921"\w* reclamó \w a|strong="H3068"\w* Abram: “¡\w Tú|strong="H8199"\w* tienes \w la|strong="H5921"\w* culpa \w de|strong="H5921"\w* este problema! \w Yo|strong="H3588"\w* misma \w te|strong="H5869"\w* \w entregué|strong="H5414"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* esclava, \w pero|strong="H3588"\w* \w desde|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* \w dio|strong="H5414"\w* cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w embarazada|strong="H2029"\w*, \w me|strong="H5921"\w* \w mira|strong="H7200"\w* \w con|strong="H5921"\w* desprecio. ¡\w Que|strong="H3588"\w* Yahvé \w juzgue|strong="H8199"\w* \w entre|strong="H5921"\w* \w tú|strong="H8199"\w* \w y|strong="H3588"\w* \w yo|strong="H3588"\w*!”   
\p
\v 6 Abram \w le|strong="H5869"\w* respondió \w a|strong="H3068"\w* \w Sarai|strong="H8297"\w*: “\w Tu|strong="H6213"\w* esclava está en tus \w manos|strong="H3027"\w*; \w haz|strong="H6213"\w* con ella \w lo|strong="H6213"\w* \w que|strong="H3027"\w* \w mejor|strong="H2896"\w* \w te|strong="H5869"\w* parezca”. Entonces \w Sarai|strong="H8297"\w* la trató tan mal \w que|strong="H3027"\w* Agar \w huyó|strong="H1272"\w* \w de|strong="H6440"\w* ella.   
\p
\v 7 \w El|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé \w la|strong="H5921"\w* encontró \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* un manantial \w de|strong="H5921"\w* \w agua|strong="H4325"\w*; es \w el|strong="H5921"\w* manantial \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w a|strong="H3068"\w* \w Shur|strong="H7793"\w*.  
\v 8 \w Y|strong="H3068"\w* le preguntó: “\w Agar|strong="H1904"\w*, esclava \w de|strong="H6440"\w* \w Sarai|strong="H8297"\w*, ¿\w de|strong="H6440"\w* dónde \w vienes|strong="H3212"\w* y \w a|strong="H3068"\w* dónde \w vas|strong="H3212"\w*?”  
\p Ella le respondió: “Estoy \w huyendo|strong="H1272"\w* \w de|strong="H6440"\w* mi \w señora|strong="H1404"\w* \w Sarai|strong="H8297"\w*”.   
\p
\v 9 El \w ángel|strong="H4397"\w* \w de|strong="H8478"\w* Yahvé le ordenó: “Regresa con tu \w señora|strong="H1404"\w* y sométete \w a|strong="H3068"\w* su autoridad”.  
\v 10 El \w ángel|strong="H4397"\w* de Yahvé también le dijo: “\w Multiplicaré|strong="H7235"\w* \w tanto|strong="H7235"\w* tu \w descendencia|strong="H2233"\w* \w que|strong="H3808"\w* \w será|strong="H3808"\w* imposible contarla”.  
\v 11 \w Además|strong="H3588"\w*, \w el|strong="H3588"\w* \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* Yahvé le dijo: “Estás embarazada \w y|strong="H3588"\w* darás \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, \w y|strong="H3588"\w* le pondrás \w por|strong="H3588"\w* \w nombre|strong="H8034"\w* \w Ismael|strong="H3458"\w*, \w porque|strong="H3588"\w* Yahvé ha escuchado tu \w aflicción|strong="H6040"\w*.  
\v 12 \w Será|strong="H1961"\w* un hombre indomable \w como|strong="H1961"\w* un burro salvaje. Luchará \w contra|strong="H5921"\w* \w todos|strong="H3605"\w*, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* lucharán \w contra|strong="H5921"\w* \w él|strong="H1931"\w*; \w y|strong="H5921"\w* vivirá \w en|strong="H5921"\w* conflicto \w con|strong="H5921"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* hermanos”.   
\p
\v 13 \w Como|strong="H3588"\w* Yahvé le \w había|strong="H3588"\w* \w hablado|strong="H1696"\w*, ella lo \w llamó|strong="H7121"\w*: “Tú eres \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* \w ve|strong="H7200"\w*”, \w pues|strong="H3588"\w* se \w dijo|strong="H1696"\w*: “¿Acaso he \w visto|strong="H7200"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w* \w y|strong="H1571"\w* sigo \w con|strong="H3588"\w* vida?”  
\v 14 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w el|strong="H5921"\w* pozo fue \w llamado|strong="H7121"\w* Beer Lahai Roi.\f + \fr 16:14 \ft Beer Lahai Roi significa “pozo del que vive y me ve”.\f* Este pozo \w se|strong="H5921"\w* encuentra \w entre|strong="H5921"\w* \w Cades|strong="H6946"\w* \w y|strong="H5921"\w* \w Bered|strong="H1260"\w*.   
\p
\v 15 \w Agar|strong="H1904"\w* le dio un \w hijo|strong="H1121"\w* \w a|strong="H3068"\w* Abram, y Abram le \w puso|strong="H3205"\w* por \w nombre|strong="H8034"\w* \w Ismael|strong="H3458"\w* al \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* ella le dio.  
\v 16 Abram tenía \w ochenta|strong="H8084"\w* y \w seis|strong="H8337"\w* \w años|strong="H8141"\w* cuando \w Agar|strong="H1904"\w* dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w*.   
\c 17  
\p
\v 1 \w Cuando|strong="H1961"\w* Abram \w tenía|strong="H1961"\w* \w noventa|strong="H8673"\w* y \w nueve|strong="H8672"\w* \w años|strong="H8141"\w*, Yahvé \w se|strong="H1961"\w* le \w apareció|strong="H7200"\w* y le dijo: “Yo \w soy|strong="H1961"\w* \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w Todopoderoso|strong="H7706"\w*. Vive \w en|strong="H8549"\w* \w mi|strong="H1961"\w* \w presencia|strong="H6440"\w* y \w sé|strong="H1961"\w* intachable.  
\v 2 Estableceré mi \w pacto|strong="H1285"\w* contigo, y \w multiplicaré|strong="H7235"\w* tu descendencia en \w gran|strong="H3966"\w* \w manera|strong="H7235"\w*”.   
\p
\v 3 Abram \w se|strong="H5921"\w* inclinó \w hasta|strong="H5921"\w* tocar \w el|strong="H5921"\w* suelo \w con|strong="H5921"\w* \w la|strong="H5921"\w* frente, \w y|strong="H5921"\w* Dios \w le|strong="H5921"\w* \w dijo|strong="H1696"\w*:  
\v 4 “\w Éste|strong="H1961"\w* \w es|strong="H1961"\w* \w mi|strong="H2009"\w* \w pacto|strong="H1285"\w* contigo: \w Serás|strong="H1961"\w* el padre de \w muchas|strong="H1995"\w* \w naciones|strong="H1471"\w*.  
\v 5 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w llamarás|strong="H7121"\w* Abram, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* tu \w nombre|strong="H8034"\w* \w será|strong="H1961"\w* Abraham, \w porque|strong="H3588"\w* \w te|strong="H3588"\w* he constituido \w en|strong="H3588"\w* padre \w de|strong="H3588"\w* \w muchas|strong="H1995"\w* \w naciones|strong="H1471"\w*.  
\v 6 \w Te|strong="H4480"\w* \w haré|strong="H5414"\w* \w muy|strong="H3966"\w* fecundo; \w de|strong="H4480"\w* \w ti|strong="H4480"\w* formaré \w naciones|strong="H1471"\w*, y \w de|strong="H4480"\w* \w ti|strong="H4480"\w* \w saldrán|strong="H3318"\w* \w reyes|strong="H4428"\w*.  
\v 7 \w Estableceré|strong="H6965"\w* \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* contigo y con tu \w descendencia|strong="H2233"\w* \w por|strong="H5769"\w* \w todas|strong="H1755"\w* las \w generaciones|strong="H1755"\w* venideras. \w Será|strong="H1961"\w* un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*; yo \w seré|strong="H1961"\w* tu Dios y el Dios de tus descendientes.  
\v 8 \w A|strong="H3068"\w* ti y \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* les \w daré|strong="H5414"\w* en posesión \w eterna|strong="H5769"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w*, donde ahora viven \w como|strong="H1961"\w* extranjeros. \w Y|strong="H3068"\w* yo \w seré|strong="H1961"\w* su Dios”.   
\p
\v 9 Dios también le dijo \w a|strong="H3068"\w* Abraham: “Tú, por tu parte, cumplirás mi \w pacto|strong="H1285"\w*, tú y tus descendientes por \w todas|strong="H1755"\w* las \w generaciones|strong="H1755"\w*.  
\v 10 \w Éste|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* \w que|strong="H3605"\w* ustedes deberán cumplir, \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* entre mí y ustedes y sus descendientes: \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w varones|strong="H2145"\w* entre ustedes deberán ser circuncidados.  
\v 11 \w Se|strong="H1961"\w* circuncidarán la \w carne|strong="H1320"\w* del \w prepucio|strong="H6190"\w*, y esto \w servirá|strong="H1961"\w* \w como|strong="H1961"\w* señal del \w pacto|strong="H1285"\w* entre nosotros.  
\v 12 \w Todo|strong="H3605"\w* \w varón|strong="H2145"\w* \w entre|strong="H3808"\w* ustedes \w que|strong="H1931"\w* tenga \w ocho|strong="H8083"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* \w nacido|strong="H3211"\w* deberá ser \w circuncidado|strong="H4135"\w* \w a|strong="H3068"\w* \w lo|strong="H1931"\w* largo \w de|strong="H1121"\w* \w sus|strong="H1931"\w* \w generaciones|strong="H1755"\w*, ya sea \w que|strong="H1931"\w* haya \w nacido|strong="H3211"\w* en \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w o|strong="H3068"\w* \w que|strong="H1931"\w* haya sido \w comprado|strong="H4736"\w* con \w dinero|strong="H3701"\w* \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w extranjero|strong="H5236"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* sea \w de|strong="H1121"\w* \w su|strong="H1931"\w* sangre.  
\v 13 Tanto el \w nacido|strong="H3211"\w* en tu \w casa|strong="H1004"\w* \w como|strong="H1961"\w* el \w comprado|strong="H4736"\w* con tu \w dinero|strong="H3701"\w* \w debe|strong="H4135"\w* ser \w circuncidado|strong="H4135"\w*. Así \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* \w quedará|strong="H1961"\w* marcado en su \w carne|strong="H1320"\w* \w como|strong="H1961"\w* un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*.  
\v 14 \w El|strong="H1931"\w* \w varón|strong="H2145"\w* \w incircunciso|strong="H6189"\w*, \w el|strong="H1931"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* haya sido \w circuncidado|strong="H4135"\w* en \w la|strong="H1931"\w* \w carne|strong="H1320"\w* \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w prepucio|strong="H6190"\w*, \w será|strong="H1931"\w* eliminado \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w* por \w haber|strong="H3808"\w* roto \w mi|strong="H5315"\w* \w pacto|strong="H1285"\w*”.   
\p
\v 15 Dios también le dijo \w a|strong="H3068"\w* Abraham: “\w A|strong="H3068"\w* tu esposa \w Sarai|strong="H8297"\w* ya \w no|strong="H3808"\w* \w la|strong="H3588"\w* \w llamarás|strong="H7121"\w* \w Sarai|strong="H8297"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w nombre|strong="H8034"\w* \w será|strong="H3808"\w* \w Sara|strong="H8283"\w*.  
\v 16 \w Yo|strong="H4480"\w* \w la|strong="H1571"\w* \w bendeciré|strong="H1288"\w* \w y|strong="H1571"\w*, \w por|strong="H4480"\w* medio \w de|strong="H4480"\w* \w ella|strong="H4480"\w*, \w te|strong="H4480"\w* \w daré|strong="H5414"\w* un \w hijo|strong="H1121"\w*. \w Sí|strong="H1571"\w*, \w la|strong="H1571"\w* \w bendeciré|strong="H1288"\w* \w y|strong="H1571"\w* \w será|strong="H1961"\w* madre \w de|strong="H4480"\w* \w naciones|strong="H1471"\w*; \w de|strong="H4480"\w* \w ella|strong="H4480"\w* saldrán \w reyes|strong="H4428"\w* \w de|strong="H4480"\w* \w pueblos|strong="H5971"\w*”.   
\p
\v 17 Entonces Abraham \w se|strong="H5921"\w* inclinó \w hasta|strong="H5921"\w* tocar \w el|strong="H5921"\w* suelo \w con|strong="H5921"\w* \w la|strong="H5921"\w* frente, \w se|strong="H5921"\w* rió \w y|strong="H5921"\w* pensó: “¿Acaso puede un \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* \w cien|strong="H3967"\w* \w años|strong="H8141"\w* tener un \w hijo|strong="H1121"\w*? ¿\w Y|strong="H3068"\w* podrá \w Sara|strong="H8283"\w* dar \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w noventa|strong="H8673"\w* \w años|strong="H8141"\w*?”  
\v 18 \w Y|strong="H3068"\w* le dijo \w a|strong="H3068"\w* Dios: “¡\w Ojalá|strong="H3863"\w* \w que|strong="H3863"\w* \w Ismael|strong="H3458"\w* pueda \w vivir|strong="H2421"\w* bajo tu bendición!”   
\p
\v 19 Pero Dios le respondió: “No, tu esposa \w Sara|strong="H8283"\w* te \w dará|strong="H3205"\w* un \w hijo|strong="H1121"\w*, y lo \w llamarás|strong="H7121"\w* \w Isaac|strong="H3327"\w*.\f + \fr 17:19 \ft Isaac significa “se ríe”.\f* Yo \w estableceré|strong="H6965"\w* mi \w pacto|strong="H1285"\w* con \w él|strong="H1121"\w* y con su \w descendencia|strong="H2233"\w*, como un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*.  
\v 20 En cuanto \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w*, también te he escuchado. \w Yo|strong="H2009"\w* lo \w bendeciré|strong="H1288"\w*, lo \w haré|strong="H5414"\w* \w muy|strong="H3966"\w* fecundo y \w multiplicaré|strong="H7235"\w* en \w gran|strong="H1419"\w* \w manera|strong="H7235"\w* su descendencia. \w Será|strong="H5414"\w* el padre \w de|strong="H5414"\w* \w doce|strong="H8147"\w* \w príncipes|strong="H5387"\w*, y \w haré|strong="H5414"\w* \w de|strong="H5414"\w* él una \w gran|strong="H1419"\w* \w nación|strong="H1471"\w*.  
\v 21 Pero mi \w pacto|strong="H1285"\w* \w lo|strong="H2088"\w* \w estableceré|strong="H6965"\w* con \w Isaac|strong="H3327"\w*, el \w hijo|strong="H3205"\w* \w que|strong="H2088"\w* \w Sara|strong="H8283"\w* te \w dará|strong="H3205"\w* \w a|strong="H3068"\w* luz \w por|strong="H2088"\w* \w esta|strong="H2088"\w* misma época el \w año|strong="H8141"\w* \w que|strong="H2088"\w* viene”.   
\p
\v 22 Cuando terminó \w de|strong="H5921"\w* \w hablar|strong="H1696"\w* \w con|strong="H5921"\w* Abraham, Dios \w se|strong="H5921"\w* retiró \w de|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 23 \w Ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w*, Abraham \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Ismael|strong="H3458"\w*, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w nacidos|strong="H3211"\w* en su \w casa|strong="H1004"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* comprados con su \w dinero|strong="H3701"\w*; \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w varones|strong="H2145"\w* \w de|strong="H1121"\w* su \w casa|strong="H1004"\w*, y les circuncidó \w la|strong="H3605"\w* \w carne|strong="H1320"\w* del \w prepucio|strong="H6190"\w*, \w tal|strong="H2088"\w* como Dios se \w lo|strong="H2088"\w* había ordenado.  
\v 24 Abraham tenía \w noventa|strong="H8673"\w* y \w nueve|strong="H8672"\w* \w años|strong="H8141"\w* cuando fue \w circuncidado|strong="H4135"\w*.  
\v 25 Su \w hijo|strong="H1121"\w* \w Ismael|strong="H3458"\w* tenía \w trece|strong="H7969"\w* \w años|strong="H8141"\w* cuando fue \w circuncidado|strong="H4135"\w*.  
\v 26 \w Ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w* fueron circuncidados Abraham y su \w hijo|strong="H1121"\w* \w Ismael|strong="H3458"\w*.  
\v 27 \w Y|strong="H3068"\w* con \w él|strong="H3605"\w* fueron circuncidados \w todos|strong="H3605"\w* \w los|strong="H1121"\w* varones \w de|strong="H1121"\w* su \w casa|strong="H1004"\w*, tanto \w los|strong="H1121"\w* \w nacidos|strong="H3211"\w* en \w ella|strong="H3605"\w* como \w los|strong="H1121"\w* \w que|strong="H1121"\w* habían sido comprados \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w extranjeros|strong="H1121"\w*.   
\c 18  
\p
\v 1 Yahvé \w se|strong="H1931"\w* \w le|strong="H1931"\w* \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* Abraham junto \w a|strong="H3068"\w* \w los|strong="H3427"\w* robles de \w Mamre|strong="H4471"\w*, mientras \w él|strong="H1931"\w* \w estaba|strong="H3427"\w* \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* entrada de \w su|strong="H1931"\w* tienda en \w la|strong="H1931"\w* hora de más calor.  
\v 2 Abraham \w levantó|strong="H5375"\w* \w la|strong="H5921"\w* vista \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w tres|strong="H7969"\w* hombres \w de|strong="H5921"\w* pie \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*. \w Al|strong="H5921"\w* verlos, \w corrió|strong="H7323"\w* \w desde|strong="H5921"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* tienda \w a|strong="H3068"\w* recibirlos, \w se|strong="H5921"\w* inclinó \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* suelo  
\v 3 \w y|strong="H5921"\w* dijo: “Señor \w mío|strong="H5921"\w*, \w si|strong="H4994"\w* he \w hallado|strong="H4672"\w* \w gracia|strong="H2580"\w* \w a|strong="H3068"\w* tus \w ojos|strong="H5869"\w*, \w te|strong="H5869"\w* \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* \w no|strong="H5921"\w* \w pases|strong="H5674"\w* \w de|strong="H5921"\w* largo \w y|strong="H5921"\w* \w te|strong="H5869"\w* quedes \w con|strong="H5921"\w* tu \w siervo|strong="H5650"\w*.  
\v 4 Haré \w que|strong="H4994"\w* \w traigan|strong="H3947"\w* un \w poco|strong="H4592"\w* \w de|strong="H8478"\w* \w agua|strong="H4325"\w* para \w que|strong="H4994"\w* se laven los \w pies|strong="H7272"\w* y descansen \w bajo|strong="H8478"\w* el \w árbol|strong="H6086"\w*.  
\v 5 \w Ya|strong="H3068"\w* \w que|strong="H3588"\w* han \w pasado|strong="H5674"\w* \w por|strong="H5921"\w* \w donde|strong="H5921"\w* \w está|strong="H3651"\w* \w su|strong="H3588"\w* \w siervo|strong="H5650"\w*, iré \w a|strong="H3068"\w* buscar un pedazo \w de|strong="H5921"\w* \w pan|strong="H3899"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* repongan sus fuerzas \w antes|strong="H3588"\w* \w de|strong="H5921"\w* seguir \w su|strong="H3588"\w* camino”.  
\p \w Ellos|strong="H5921"\w* \w respondieron|strong="H1696"\w*: “\w Está|strong="H3651"\w* \w bien|strong="H3588"\w*, \w haz|strong="H6213"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* has \w dicho|strong="H1696"\w*”.   
\p
\v 6 Abraham entró corriendo \w a|strong="H3068"\w* la tienda donde estaba \w Sara|strong="H8283"\w* y le dijo: “¡Rápido! Toma \w tres|strong="H7969"\w* \w medidas|strong="H5429"\w*\f + \fr 18:6 \ft La medida hebrea original es el seah, equivalente a unos 7 litros.\f* de la mejor \w harina|strong="H7058"\w*, amásala y prepara unos \w panes|strong="H5692"\w*”.  
\v 7 \w Luego|strong="H7323"\w* Abraham \w corrió|strong="H7323"\w* \w hacia|strong="H6213"\w* donde estaba \w el|strong="H1121"\w* \w ganado|strong="H1121"\w*, escogió un ternero \w tierno|strong="H7390"\w* \w y|strong="H1241"\w* gordo, \w y|strong="H1241"\w* se \w lo|strong="H6213"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* un sirviente, \w quien|strong="H6213"\w* se apresuró \w a|strong="H3068"\w* prepararlo.  
\v 8 También \w tomó|strong="H3947"\w* cuajada, \w leche|strong="H2461"\w* \w y|strong="H5921"\w* \w el|strong="H1931"\w* ternero recién preparado, \w y|strong="H5921"\w* \w se|strong="H1931"\w* \w lo|strong="H1931"\w* sirvió. Mientras \w ellos|strong="H1931"\w* comían, \w él|strong="H1931"\w* \w se|strong="H1931"\w* \w quedó|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H1931"\w* \w debajo|strong="H8478"\w* \w del|strong="H5921"\w* \w árbol|strong="H6086"\w*.   
\p
\v 9 Entonces le preguntaron: “¿Dónde está tu esposa \w Sara|strong="H8283"\w*?”  
\p “Allí en la tienda”, respondió él.   
\p
\v 10 \w Y|strong="H3068"\w* uno \w de|strong="H1121"\w* \w ellos|strong="H1931"\w* \w le|strong="H1931"\w* dijo: “Te aseguro \w que|strong="H1931"\w* para \w esta|strong="H1931"\w* \w misma|strong="H1931"\w* época, \w el|strong="H1931"\w* año \w que|strong="H1931"\w* viene, \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* verte, y tu esposa \w Sara|strong="H8283"\w* tendrá un \w hijo|strong="H1121"\w*”.  
\p \w Sara|strong="H8283"\w* \w estaba|strong="H2009"\w* \w escuchando|strong="H8085"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* entrada \w de|strong="H1121"\w* \w la|strong="H1931"\w* tienda, \w a|strong="H3068"\w* espaldas \w de|strong="H1121"\w* \w él|strong="H1931"\w*.  
\v 11 Abraham y \w Sara|strong="H8283"\w* ya \w eran|strong="H1961"\w* muy \w ancianos|strong="H2205"\w*, y \w Sara|strong="H8283"\w* \w había|strong="H1961"\w* pasado la \w edad|strong="H3117"\w* de \w tener|strong="H1961"\w* hijos.  
\v 12 Por eso \w Sara|strong="H8283"\w* \w se|strong="H1961"\w* rió por \w dentro|strong="H7130"\w*, pensando: “¿Acaso voy \w a|strong="H3068"\w* \w tener|strong="H1961"\w* \w este|strong="H1961"\w* placer, ahora \w que|strong="H1961"\w* ya \w estoy|strong="H1961"\w* vieja y \w mi|strong="H1961"\w* esposo también \w es|strong="H1961"\w* un anciano?”   
\p
\v 13 Pero Yahvé le dijo \w a|strong="H3068"\w* Abraham: “¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* \w se|strong="H4100"\w* ríe \w Sara|strong="H8283"\w*? ¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* dice: ‘¿De verdad voy \w a|strong="H3068"\w* dar \w a|strong="H3068"\w* luz ahora \w que|strong="H4100"\w* soy vieja?’  
\v 14 ¿Acaso hay \w algo|strong="H1697"\w* imposible para Yahvé? \w El|strong="H1121"\w* año \w que|strong="H1697"\w* viene, \w por|strong="H1697"\w* esta misma época, \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* visitarte, y \w Sara|strong="H8283"\w* tendrá un \w hijo|strong="H1121"\w*”.   
\p
\v 15 Llena \w de|strong="H3588"\w* \w miedo|strong="H3372"\w*, \w Sara|strong="H8283"\w* mintió \w y|strong="H3588"\w* dijo: “\w No|strong="H3808"\w* \w me|strong="H3588"\w* estaba riendo”.  
\p \w Pero|strong="H3588"\w* \w él|strong="H3588"\w* le replicó: “\w No|strong="H3808"\w* \w es|strong="H3588"\w* \w cierto|strong="H3588"\w*, \w sí|strong="H3588"\w* \w te|strong="H3588"\w* reíste”.   
\p
\v 16 Luego \w los|strong="H5921"\w* hombres \w se|strong="H5921"\w* \w levantaron|strong="H6965"\w* \w de|strong="H5921"\w* \w allí|strong="H8033"\w* \w y|strong="H5921"\w* miraron \w hacia|strong="H5921"\w* \w Sodoma|strong="H5467"\w*, \w y|strong="H5921"\w* Abraham \w los|strong="H5921"\w* acompañó \w para|strong="H5921"\w* despedirlos.  
\v 17 Yahvé pensó: “¿Debería ocultarle \w a|strong="H3068"\w* Abraham \w lo|strong="H6213"\w* que voy \w a|strong="H3068"\w* \w hacer|strong="H6213"\w*?  
\v 18 \w Después|strong="H1961"\w* de \w todo|strong="H3605"\w*, de Abraham saldrá una \w nación|strong="H1471"\w* \w grande|strong="H1419"\w* y poderosa, y por medio de \w él|strong="H3605"\w* \w serán|strong="H1961"\w* bendecidas \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* de \w la|strong="H3605"\w* tierra.  
\v 19 \w Yo|strong="H3588"\w* \w lo|strong="H5921"\w* he elegido \w para|strong="H4616"\w* \w que|strong="H3588"\w* instruya \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w familia|strong="H1004"\w*, \w a|strong="H3068"\w* fin \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* mantengan \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H3588"\w* practiquen \w la|strong="H5921"\w* \w justicia|strong="H6666"\w* \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w derecho|strong="H4941"\w*. \w Así|strong="H3588"\w* Yahvé \w cumplirá|strong="H6213"\w* todo \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w le|strong="H5921"\w* ha prometido \w a|strong="H3068"\w* Abraham”.  
\v 20 \w Entonces|strong="H3588"\w* Yahvé le dijo: “Las quejas contra \w Sodoma|strong="H5467"\w* \w y|strong="H3588"\w* \w Gomorra|strong="H6017"\w* \w son|strong="H3588"\w* ya \w muchas|strong="H7227"\w*, \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w* \w es|strong="H3588"\w* gravísimo.  
\v 21 Voy \w a|strong="H3068"\w* bajar \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w si|strong="H3808"\w* realmente sus acciones \w son|strong="H3808"\w* tan malas como los informes \w que|strong="H3808"\w* me han llegado. \w Y|strong="H3068"\w* \w si|strong="H3808"\w* \w no|strong="H3808"\w* es así, \w lo|strong="H3808"\w* sabré”.   
\p
\v 22 Los hombres se alejaron \w de|strong="H6440"\w* \w allí|strong="H8033"\w* y se dirigieron \w a|strong="H3068"\w* \w Sodoma|strong="H5467"\w*, pero Abraham se \w quedó|strong="H5975"\w* \w de|strong="H6440"\w* \w pie|strong="H5975"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 23 Abraham se \w acercó|strong="H5066"\w* y \w le|strong="H5973"\w* dijo: “¿\w De|strong="H5973"\w* veras vas \w a|strong="H3068"\w* destruir al \w justo|strong="H6662"\w* \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* malvado?  
\v 24 ¿\w Qué|strong="H3808"\w* tal \w si|strong="H3808"\w* \w hay|strong="H3426"\w* \w cincuenta|strong="H2572"\w* \w justos|strong="H6662"\w* \w en|strong="H8432"\w* la \w ciudad|strong="H5892"\w*? ¿Acaso \w no|strong="H3808"\w* \w perdonarás|strong="H5375"\w* el \w lugar|strong="H4725"\w* \w por|strong="H4616"\w* amor \w a|strong="H3068"\w* esos \w cincuenta|strong="H2572"\w* \w justos|strong="H6662"\w*?  
\v 25 ¡\w Lejos|strong="H2486"\w* \w de|strong="H5973"\w* \w ti|strong="H5973"\w* actuar \w de|strong="H5973"\w* esa \w manera|strong="H1697"\w*! ¡\w Tú|strong="H8199"\w* \w no|strong="H3808"\w* puedes matar al \w justo|strong="H6662"\w* \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* malvado, \w ni|strong="H3808"\w* tratar al \w justo|strong="H6662"\w* \w como|strong="H5973"\w* al malvado! ¡\w Lejos|strong="H2486"\w* \w de|strong="H5973"\w* \w ti|strong="H5973"\w* \w hacer|strong="H6213"\w* \w tal|strong="H2088"\w* \w cosa|strong="H1697"\w*! \w El|strong="H5973"\w* \w Juez|strong="H8199"\w* \w de|strong="H5973"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra, ¿acaso \w no|strong="H3808"\w* actuará \w con|strong="H5973"\w* \w justicia|strong="H4941"\w*?”   
\p
\v 26 Yahvé le respondió: “Si encuentro \w cincuenta|strong="H2572"\w* \w justos|strong="H6662"\w* \w en|strong="H8432"\w* \w Sodoma|strong="H5467"\w*, \w por|strong="H5668"\w* amor \w a|strong="H3068"\w* \w ellos|strong="H3605"\w* \w perdonaré|strong="H5375"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*”.  
\v 27 Pero Abraham volvió \w a|strong="H3068"\w* \w hablar|strong="H1696"\w*: “\w Ya|strong="H3068"\w* \w que|strong="H4994"\w* he tenido el atrevimiento de \w hablarle|strong="H1696"\w* \w a|strong="H3068"\w* \w mi|strong="H2009"\w* Señor, \w yo|strong="H2009"\w* \w que|strong="H4994"\w* no soy \w más|strong="H6030"\w* \w que|strong="H4994"\w* \w polvo|strong="H6083"\w* y ceniza,  
\v 28 ¿\w qué|strong="H3808"\w* pasará \w si|strong="H3808"\w* \w de|strong="H2568"\w* esos \w cincuenta|strong="H2572"\w* \w justos|strong="H6662"\w* faltan \w cinco|strong="H2568"\w*? ¿\w Destruirás|strong="H7843"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* por esos \w cinco|strong="H2568"\w*?”  
\p “\w Si|strong="H3808"\w* encuentro \w allí|strong="H8033"\w* cuarenta y \w cinco|strong="H2568"\w*, \w no|strong="H3808"\w* \w la|strong="H3605"\w* \w destruiré|strong="H7843"\w*”, respondió \w él|strong="H3605"\w*.   
\p
\v 29 Abraham insistió: “¿\w Y|strong="H3068"\w* \w si|strong="H3808"\w* sólo \w se|strong="H3808"\w* encuentran cuarenta?”  
\p “\w Por|strong="H5750"\w* amor \w a|strong="H3068"\w* esos cuarenta, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w haré|strong="H6213"\w*”, respondió \w él|strong="H6213"\w*.   
\p
\v 30 Abraham volvió \w a|strong="H3068"\w* decirle: “Por favor, \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* enoje \w mi|strong="H4994"\w* Señor \w si|strong="H3808"\w* sigo \w hablando|strong="H1696"\w*. ¿\w Qué|strong="H3808"\w* pasará \w si|strong="H3808"\w* sólo \w se|strong="H3808"\w* encuentran \w treinta|strong="H7970"\w*?”  
\p “\w Si|strong="H3808"\w* encuentro \w treinta|strong="H7970"\w*, \w tampoco|strong="H3808"\w* \w lo|strong="H3808"\w* \w haré|strong="H6213"\w*”, contestó.   
\p
\v 31 Abraham \w dijo|strong="H1696"\w*: “Me he atrevido \w a|strong="H3068"\w* \w hablarle|strong="H1696"\w* \w a|strong="H3068"\w* \w mi|strong="H2009"\w* Señor. ¿\w Y|strong="H3068"\w* \w si|strong="H3808"\w* \w se|strong="H3808"\w* encuentran \w veinte|strong="H6242"\w*?”  
\p “\w Por|strong="H5668"\w* amor \w a|strong="H3068"\w* esos \w veinte|strong="H6242"\w*, \w no|strong="H3808"\w* la \w destruiré|strong="H7843"\w*”, le respondió.   
\p
\v 32 Finalmente Abraham \w dijo|strong="H1696"\w*: “Le \w ruego|strong="H4994"\w* \w a|strong="H3068"\w* \w mi|strong="H4994"\w* Señor \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* enoje, y \w hablaré|strong="H1696"\w* sólo \w una|strong="H6471"\w* \w vez|strong="H6471"\w* \w más|strong="H3808"\w*. ¿\w Y|strong="H3068"\w* \w si|strong="H3808"\w* sólo \w se|strong="H3808"\w* encuentran \w diez|strong="H6235"\w*?”  
\p “\w Por|strong="H5668"\w* amor \w a|strong="H3068"\w* esos \w diez|strong="H6235"\w*, \w no|strong="H3808"\w* la \w destruiré|strong="H7843"\w*”, contestó él.   
\p
\v 33 El \w Señor|strong="H3068"\w* se \w fue|strong="H3212"\w* \w en|strong="H3212"\w* cuanto terminó de \w hablar|strong="H1696"\w* con Abraham, y éste \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w*.   
\c 19  
\p
\v 1 \w Los|strong="H3427"\w* \w dos|strong="H8147"\w* \w ángeles|strong="H4397"\w* llegaron \w a|strong="H3068"\w* \w Sodoma|strong="H5467"\w* al anochecer. \w Lot|strong="H3876"\w* \w estaba|strong="H3427"\w* \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* de la ciudad. Al verlos, \w Lot|strong="H3876"\w* se \w levantó|strong="H6965"\w* \w a|strong="H3068"\w* recibirlos, se inclinó hasta tocar \w el|strong="H3427"\w* suelo con la \w frente|strong="H7125"\w*,  
\v 2 \w y|strong="H3588"\w* les dijo: “\w Por|strong="H3588"\w* favor, señores míos, vengan \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* este servidor suyo \w para|strong="H3588"\w* pasar \w la|strong="H3588"\w* noche \w y|strong="H3588"\w* lavarse \w los|strong="H3588"\w* \w pies|strong="H7272"\w*; mañana podrán levantarse temprano \w y|strong="H3588"\w* seguir \w su|strong="H3588"\w* \w camino|strong="H1870"\w*”. “\w No|strong="H3808"\w* respondieron ellos, pasaremos \w la|strong="H3588"\w* noche \w en|strong="H3588"\w* \w la|strong="H3588"\w* plaza”.   
\p
\v 3 Pero Lot les insistió \w tanto|strong="H3966"\w* que fueron con \w él|strong="H6213"\w* y entraron \w en|strong="H5493"\w* su \w casa|strong="H1004"\w*. Allí les preparó una \w gran|strong="H3966"\w* cena, horneó pan sin levadura, y ellos comieron.  
\v 4 \w Aún|strong="H5704"\w* \w no|strong="H5921"\w* \w se|strong="H5921"\w* habían \w acostado|strong="H7901"\w* \w cuando|strong="H5704"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w Sodoma|strong="H5467"\w*, rodearon \w la|strong="H5921"\w* \w casa|strong="H1004"\w*. \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w los|strong="H5921"\w* \w más|strong="H5921"\w* jóvenes \w hasta|strong="H5704"\w* \w los|strong="H5921"\w* \w más|strong="H5921"\w* \w viejos|strong="H2205"\w*, \w estaba|strong="H7901"\w* allí.  
\v 5 \w Llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w Lot|strong="H3876"\w* y le dijeron: “¿Dónde están los hombres \w que|strong="H3045"\w* entraron \w en|strong="H3318"\w* tu casa esta \w noche|strong="H3915"\w*? ¡Sácalos, para \w que|strong="H3045"\w* tengamos relaciones con ellos!”   
\p
\v 6 \w Lot|strong="H3876"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* la \w puerta|strong="H6607"\w* y, cerrándola detrás de sí,  
\v 7 les dijo: “Por favor, hermanos míos, no cometan semejante maldad.  
\v 8 Miren, \w tengo|strong="H5921"\w* \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w* \w que|strong="H3588"\w* todavía \w son|strong="H3588"\w* vírgenes. Voy \w a|strong="H3068"\w* sacarlas \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w hagan|strong="H6213"\w* \w con|strong="H5921"\w* \w ellas|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* quieran. \w Pero|strong="H3588"\w* \w a|strong="H3068"\w* estos \w hombres|strong="H8147"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w hagan|strong="H6213"\w* \w nada|strong="H3808"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* mis invitados \w y|strong="H3588"\w* \w están|strong="H2009"\w* bajo \w mi|strong="H5921"\w* protección”.   
\p
\v 9 “¡Hazte \w a|strong="H3068"\w* un lado!” le gritaron. \w Y|strong="H3068"\w* añadieron: “Éste no es \w más|strong="H6258"\w* \w que|strong="H6258"\w* un extranjero entre nosotros, ¡y \w ahora|strong="H6258"\w* resulta \w que|strong="H6258"\w* quiere ser nuestro \w juez|strong="H8199"\w*! \w Pues|strong="H6258"\w* \w ahora|strong="H6258"\w* \w te|strong="H7489"\w* trataremos \w a|strong="H3068"\w* ti \w peor|strong="H7489"\w* \w que|strong="H6258"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w*”. Entonces \w se|strong="H1992"\w* abalanzaron sobre \w Lot|strong="H3876"\w* y \w se|strong="H1992"\w* acercaron \w para|strong="H6258"\w* derribar la \w puerta|strong="H1817"\w*.  
\v 10 Pero los hombres \w que|strong="H3027"\w* estaban \w adentro|strong="H1004"\w* extendieron los brazos, \w metieron|strong="H7971"\w* \w a|strong="H3068"\w* \w Lot|strong="H3876"\w* en la \w casa|strong="H1004"\w* y \w cerraron|strong="H5462"\w* la \w puerta|strong="H1817"\w*.  
\v 11 \w Luego|strong="H5704"\w*, \w a|strong="H3068"\w* los hombres \w que|strong="H5704"\w* estaban \w a|strong="H3068"\w* la \w puerta|strong="H6607"\w* \w de|strong="H5704"\w* la \w casa|strong="H1004"\w*, \w desde|strong="H5704"\w* el \w más|strong="H5704"\w* joven \w hasta|strong="H5704"\w* el \w más|strong="H5704"\w* viejo, los \w hirieron|strong="H5221"\w* \w con|strong="H5704"\w* ceguera, \w de|strong="H5704"\w* modo \w que|strong="H5704"\w* se cansaron \w de|strong="H5704"\w* buscar la \w puerta|strong="H6607"\w*.   
\p
\v 12 Entonces \w los|strong="H1121"\w* dos visitantes \w le|strong="H4310"\w* dijeron \w a|strong="H3068"\w* \w Lot|strong="H3876"\w*: “¿\w Tienes|strong="H5750"\w* \w a|strong="H3068"\w* alguien \w más|strong="H5750"\w* \w aquí|strong="H6311"\w*? \w Saca|strong="H3318"\w* \w de|strong="H4480"\w* este \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* tus \w yernos|strong="H2860"\w*, \w hijos|strong="H1121"\w*, \w hijas|strong="H1323"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H4480"\w* tengas \w en|strong="H4480"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*,  
\v 13 \w porque|strong="H3588"\w* \w vamos|strong="H7843"\w* \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*. \w El|strong="H3588"\w* \w clamor|strong="H6818"\w* \w contra|strong="H6440"\w* \w esta|strong="H2088"\w* gente ha llegado \w hasta|strong="H2088"\w* Yahvé, \w y|strong="H3588"\w* \w él|strong="H3588"\w* nos ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w destruirlos|strong="H7843"\w*”.   
\p
\v 14 \w Lot|strong="H3876"\w* \w salió|strong="H3318"\w* \w y|strong="H3588"\w* \w habló|strong="H1696"\w* \w con|strong="H4480"\w* sus futuros \w yernos|strong="H2860"\w*, \w los|strong="H1961"\w* \w que|strong="H3588"\w* iban \w a|strong="H3068"\w* casarse \w con|strong="H4480"\w* sus \w hijas|strong="H1323"\w*, \w y|strong="H3588"\w* les \w dijo|strong="H1696"\w*: “¡\w Levántense|strong="H6965"\w* \w y|strong="H3588"\w* \w salgan|strong="H3318"\w* \w de|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, \w porque|strong="H3588"\w* Yahvé \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*!” \w Pero|strong="H3588"\w* sus \w yernos|strong="H2860"\w* pensaron \w que|strong="H3588"\w* \w estaba|strong="H1961"\w* bromeando.  
\v 15 Al amanecer, los \w ángeles|strong="H4397"\w* apresuraron \w a|strong="H3068"\w* \w Lot|strong="H3876"\w*, diciéndole: “¡\w Levántate|strong="H6965"\w*! Llévate \w a|strong="H3068"\w* tu esposa y \w a|strong="H3068"\w* tus \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w* \w que|strong="H6435"\w* están aquí, para \w que|strong="H6435"\w* \w no|strong="H6435"\w* mueran cuando la \w ciudad|strong="H5892"\w* \w sea|strong="H6435"\w* castigada”.  
\v 16 \w Como|strong="H5921"\w* Lot \w se|strong="H5921"\w* demoraba, \w los|strong="H5921"\w* \w hombres|strong="H8147"\w* \w lo|strong="H5921"\w* \w tomaron|strong="H2388"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w lo|strong="H5921"\w* mismo \w que|strong="H5921"\w* \w a|strong="H3068"\w* su esposa \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w sacaron|strong="H3318"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w porque|strong="H5921"\w* Yahvé tuvo compasión \w de|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 17 Una vez \w fuera|strong="H2351"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudad, uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* ángeles \w le|strong="H5921"\w* dijo: “¡Huye \w para|strong="H5921"\w* salvar tu \w vida|strong="H5315"\w*! \w No|strong="H6435"\w* \w mires|strong="H5027"\w* \w hacia|strong="H5921"\w* atrás, \w ni|strong="H6435"\w* \w te|strong="H5921"\w* detengas \w en|strong="H5921"\w* \w ninguna|strong="H3605"\w* parte \w del|strong="H5921"\w* valle. ¡Huye \w a|strong="H3068"\w* \w las|strong="H5921"\w* montañas, \w no|strong="H6435"\w* \w sea|strong="H1961"\w* \w que|strong="H5921"\w* mueras!”   
\p
\v 18 Pero \w Lot|strong="H3876"\w* les respondió: “¡No, por favor, señor mío!  
\v 19 \w Tu|strong="H6213"\w* servidor \w ha|strong="H3808"\w* \w hallado|strong="H4672"\w* \w gracia|strong="H2580"\w* \w a|strong="H3068"\w* tus \w ojos|strong="H5869"\w*, y me \w has|strong="H4191"\w* mostrado \w una|strong="H4672"\w* gran bondad al salvarme la \w vida|strong="H5315"\w*. Pero \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* huir \w a|strong="H3068"\w* las montañas; la desgracia me alcanzaría y moriría.  
\v 20 \w Mira|strong="H2009"\w*, \w aquí|strong="H2009"\w* \w cerca|strong="H7138"\w* hay una \w ciudad|strong="H5892"\w* \w pequeña|strong="H4705"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w que|strong="H1931"\w* puedo huir. ¡Déjame \w escapar|strong="H4422"\w* \w allá|strong="H8033"\w* y salvaré \w mi|strong="H2009"\w* \w vida|strong="H5315"\w*! ¡Al fin y al cabo \w es|strong="H1931"\w* una \w ciudad|strong="H5892"\w* muy \w pequeña|strong="H4705"\w*!”   
\p
\v 21 \w El|strong="H1571"\w* ángel le contestó: “\w Está|strong="H2088"\w* bien, te concedo \w también|strong="H1571"\w* \w esta|strong="H2088"\w* petición: \w no|strong="H1115"\w* \w destruiré|strong="H2015"\w* \w la|strong="H1571"\w* \w ciudad|strong="H5892"\w* \w de|strong="H6440"\w* \w la|strong="H1571"\w* \w que|strong="H1571"\w* hablas.  
\v 22 ¡\w Pero|strong="H3588"\w* date prisa, huye \w allá|strong="H8033"\w*! \w No|strong="H3808"\w* \w puedo|strong="H3201"\w* \w hacer|strong="H6213"\w* \w nada|strong="H3808"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* llegues”. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* recibió \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* \w Zoar|strong="H6820"\w*.   
\p
\v 23 \w El|strong="H5921"\w* \w sol|strong="H8121"\w* ya había \w salido|strong="H3318"\w* cuando \w Lot|strong="H3876"\w* llegó \w a|strong="H3068"\w* \w Zoar|strong="H6820"\w*.  
\v 24 Entonces Yahvé hizo llover \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* fuego \w y|strong="H5921"\w* \w azufre|strong="H1614"\w* \w sobre|strong="H5921"\w* \w Sodoma|strong="H5467"\w* \w y|strong="H5921"\w* \w Gomorra|strong="H6017"\w*.  
\v 25 Destruyó esas \w ciudades|strong="H5892"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* valle, junto con \w todos|strong="H3605"\w* sus \w habitantes|strong="H3427"\w* y \w la|strong="H3605"\w* vegetación de \w la|strong="H3605"\w* tierra.  
\v 26 Pero la esposa de Lot \w miró|strong="H5027"\w* hacia atrás, \w a|strong="H3068"\w* espaldas de él, y \w se|strong="H1961"\w* convirtió en una \w estatua|strong="H5333"\w* de \w sal|strong="H4417"\w*.   
\p
\v 27 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, Abraham se levantó muy temprano y fue al \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w había|strong="H5975"\w* \w estado|strong="H5975"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 28 \w Miró|strong="H7200"\w* \w hacia|strong="H5921"\w* \w Sodoma|strong="H5467"\w* \w y|strong="H5921"\w* \w Gomorra|strong="H6017"\w*, \w y|strong="H5921"\w* \w hacia|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* valle, \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w que|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w subía|strong="H5927"\w* un humo muy denso, \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* un horno.   
\p
\v 29 Así \w que|strong="H1961"\w*, \w cuando|strong="H1961"\w* Dios \w destruyó|strong="H7843"\w* las \w ciudades|strong="H5892"\w* del valle donde \w vivía|strong="H3427"\w* \w Lot|strong="H3876"\w*, \w se|strong="H1961"\w* acordó de Abraham y sacó \w a|strong="H3068"\w* \w Lot|strong="H3876"\w* de la destrucción.   
\p
\v 30 \w Lot|strong="H3876"\w* \w tenía|strong="H1931"\w* \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* quedarse \w a|strong="H3068"\w* vivir \w en|strong="H5973"\w* \w Zoar|strong="H6820"\w*; \w por|strong="H3588"\w* \w eso|strong="H1931"\w* \w se|strong="H1931"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* montaña \w y|strong="H3588"\w* \w se|strong="H1931"\w* instaló \w en|strong="H5973"\w* una \w cueva|strong="H4631"\w* \w con|strong="H5973"\w* \w sus|strong="H1931"\w* \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w*.  
\v 31 Un día, \w la|strong="H5921"\w* hija mayor \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w menor|strong="H6810"\w*: “Nuestro padre ya \w está|strong="H5921"\w* \w viejo|strong="H2204"\w*, \w y|strong="H5921"\w* \w no|strong="H5921"\w* queda \w ningún|strong="H3605"\w* hombre \w en|strong="H5921"\w* \w esta|strong="H5921"\w* región \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* case \w con|strong="H5921"\w* nosotras, \w como|strong="H5921"\w* es \w la|strong="H5921"\w* costumbre \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* mundo.  
\v 32 \w Ven|strong="H3212"\w*, emborrachémoslo \w con|strong="H5973"\w* \w vino|strong="H3196"\w* y acostémonos \w con|strong="H5973"\w* \w él|strong="H5973"\w*, \w para|strong="H5973"\w* que podamos conservar la \w descendencia|strong="H2233"\w* \w de|strong="H5973"\w* nuestro padre”.  
\v 33 \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* \w le|strong="H1931"\w* dieron \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w vino|strong="H3196"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre, y \w la|strong="H1931"\w* hija mayor entró y \w se|strong="H3045"\w* acostó con \w él|strong="H1931"\w*. Pero \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* dio cuenta \w ni|strong="H3808"\w* cuando \w ella|strong="H1931"\w* \w se|strong="H3045"\w* acostó \w ni|strong="H3808"\w* cuando \w se|strong="H3045"\w* \w levantó|strong="H6965"\w*.  
\v 34 Al día \w siguiente|strong="H4283"\w*, \w la|strong="H1571"\w* mayor \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* \w la|strong="H1571"\w* \w menor|strong="H6810"\w*: “Ayer por \w la|strong="H1571"\w* \w noche|strong="H3915"\w* yo \w me|strong="H5973"\w* acosté \w con|strong="H5973"\w* \w mi|strong="H1961"\w* padre. Vamos \w a|strong="H3068"\w* darle \w vino|strong="H3196"\w* \w también|strong="H1571"\w* \w esta|strong="H1961"\w* \w noche|strong="H3915"\w*; luego entras tú \w y|strong="H1571"\w* \w te|strong="H5973"\w* acuestas \w con|strong="H5973"\w* \w él|strong="H5973"\w*. \w Así|strong="H1571"\w* conservaremos \w la|strong="H1571"\w* \w descendencia|strong="H2233"\w* \w de|strong="H5973"\w* nuestro padre”.  
\v 35 \w Esa|strong="H1931"\w* \w noche|strong="H3915"\w* \w también|strong="H1571"\w* \w le|strong="H1931"\w* dieron \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w vino|strong="H3196"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre, \w y|strong="H1571"\w* \w la|strong="H1931"\w* \w menor|strong="H6810"\w* entró \w y|strong="H1571"\w* \w se|strong="H3045"\w* acostó \w con|strong="H5973"\w* \w él|strong="H1931"\w*. Igual \w que|strong="H1931"\w* \w la|strong="H1931"\w* vez anterior, \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* dio cuenta \w ni|strong="H3808"\w* \w cuando|strong="H1571"\w* \w ella|strong="H1931"\w* \w se|strong="H3045"\w* acostó \w ni|strong="H3808"\w* \w cuando|strong="H1571"\w* \w se|strong="H3045"\w* \w levantó|strong="H6965"\w*.  
\v 36 De este modo, las \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w* de \w Lot|strong="H3876"\w* quedaron embarazadas de su propio padre.  
\v 37 \w La|strong="H1931"\w* mayor tuvo un \w hijo|strong="H1121"\w*, \w y|strong="H5704"\w* \w lo|strong="H1931"\w* \w llamó|strong="H7121"\w* \w Moab|strong="H4124"\w*. \w Éste|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* antepasado \w de|strong="H5704"\w* \w los|strong="H1121"\w* actuales moabitas.  
\v 38 \w La|strong="H1931"\w* \w menor|strong="H6810"\w* \w también|strong="H1571"\w* tuvo un \w hijo|strong="H1121"\w*, \w y|strong="H1571"\w* \w lo|strong="H1931"\w* \w llamó|strong="H7121"\w* Ben Amí. \w Éste|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* antepasado \w de|strong="H5704"\w* \w los|strong="H1121"\w* actuales amonitas.   
\c 20  
\p
\v 1 Abraham viajó desde \w allí|strong="H8033"\w* \w hacia|strong="H8033"\w* la región del Néguev, y se estableció \w entre|strong="H8033"\w* \w Cades|strong="H6946"\w* y \w Shur|strong="H7793"\w*. Mientras \w vivía|strong="H3427"\w* como extranjero en \w Gerar|strong="H1642"\w*,  
\v 2 Abraham decía \w que|strong="H1931"\w* \w su|strong="H1931"\w* esposa \w Sara|strong="H8283"\w* \w era|strong="H1931"\w* \w su|strong="H1931"\w* hermana. Entonces Abimelec, \w rey|strong="H4428"\w* de \w Gerar|strong="H1642"\w*, \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w Sara|strong="H8283"\w* y \w se|strong="H1931"\w* \w la|strong="H1931"\w* \w llevó|strong="H3947"\w*.  
\v 3 Pero Dios \w se|strong="H1931"\w* \w le|strong="H1931"\w* apareció \w a|strong="H3068"\w* Abimelec \w en|strong="H5921"\w* un \w sueño|strong="H2472"\w* nocturno \w y|strong="H5921"\w* \w le|strong="H1931"\w* dijo: “Date \w por|strong="H5921"\w* \w muerto|strong="H4191"\w* \w a|strong="H3068"\w* causa \w de|strong="H5921"\w* \w la|strong="H1931"\w* mujer \w que|strong="H1931"\w* \w has|strong="H4191"\w* \w tomado|strong="H3947"\w*, \w porque|strong="H5921"\w* \w es|strong="H1931"\w* una mujer \w casada|strong="H1167"\w*”.   
\p
\v 4 \w Como|strong="H1571"\w* Abimelec todavía \w no|strong="H3808"\w* \w la|strong="H1571"\w* había tocado, le respondió: “Señor, ¿acaso destruirías \w a|strong="H3068"\w* una \w nación|strong="H1471"\w* inocente?  
\v 5 ¿\w No|strong="H3808"\w* me dijo \w él|strong="H1931"\w* \w mismo|strong="H1931"\w*: ‘\w Es|strong="H1931"\w* mi hermana’? \w Y|strong="H3068"\w* \w ella|strong="H1931"\w* \w también|strong="H1571"\w* afirmó: ‘\w Es|strong="H1931"\w* mi hermano’. \w Yo|strong="H6213"\w* he \w hecho|strong="H6213"\w* \w esto|strong="H2063"\w* \w con|strong="H1571"\w* buenas intenciones \w y|strong="H1571"\w* \w con|strong="H1571"\w* las \w manos|strong="H3709"\w* limpias”.   
\p
\v 6 Dios \w le|strong="H5921"\w* respondió \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w sueño|strong="H2472"\w*: “\w Sí|strong="H3588"\w*, \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w has|strong="H5414"\w* actuado \w con|strong="H5921"\w* buenas intenciones. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w yo|strong="H3588"\w* \w mismo|strong="H1571"\w* \w te|strong="H5921"\w* impedí \w pecar|strong="H2398"\w* \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* permití \w que|strong="H3588"\w* \w la|strong="H5921"\w* tocaras.  
\v 7 \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, devuélvele \w su|strong="H1931"\w* esposa \w a|strong="H3068"\w* \w ese|strong="H1931"\w* hombre. \w Él|strong="H1931"\w* \w es|strong="H1931"\w* \w profeta|strong="H5030"\w* \w y|strong="H3588"\w* \w orará|strong="H6419"\w* \w por|strong="H3588"\w* ti \w para|strong="H3588"\w* \w que|strong="H3588"\w* vivas. \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3588"\w* \w se|strong="H3045"\w* \w la|strong="H1931"\w* devuelves, \w ten|strong="H3045"\w* \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* \w morirás|strong="H4191"\w*, tú \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* tuyos”.   
\p
\v 8 Al día siguiente, Abimelec se levantó \w muy|strong="H3966"\w* temprano, \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus servidores y les contó \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* había pasado. Al oírlo, \w los|strong="H3605"\w* hombres se llenaron \w de|strong="H1697"\w* \w miedo|strong="H3372"\w*.  
\v 9 Luego Abimelec mandó \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* Abraham \w y|strong="H3588"\w* \w le|strong="H5921"\w* reclamó: “¿\w Qué|strong="H3588"\w* \w nos|strong="H5921"\w* has \w hecho|strong="H6213"\w*? ¿\w En|strong="H5921"\w* \w qué|strong="H3588"\w* \w te|strong="H5921"\w* he ofendido, \w para|strong="H5921"\w* \w que|strong="H3588"\w* hayas traído un \w pecado|strong="H2401"\w* tan \w grande|strong="H1419"\w* \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w reino|strong="H4467"\w*? ¡\w Me|strong="H5921"\w* has \w hecho|strong="H6213"\w* cosas \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w hacen|strong="H6213"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*!”  
\v 10 \w Y|strong="H3068"\w* añadió Abimelec: “¿\w Qué|strong="H3588"\w* pretendías al \w hacer|strong="H6213"\w* \w esto|strong="H2088"\w*?”   
\p
\v 11 Abraham \w le|strong="H5921"\w* respondió: “\w Es|strong="H2088"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* pensé: ‘Seguramente \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w no|strong="H3588"\w* hay \w temor|strong="H3374"\w* \w de|strong="H5921"\w* Dios, \w y|strong="H3588"\w* \w me|strong="H5921"\w* \w matarán|strong="H2026"\w* \w por|strong="H5921"\w* \w causa|strong="H1697"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* esposa’.  
\v 12 \w Además|strong="H1571"\w*, \w ella|strong="H1931"\w* \w es|strong="H1931"\w* en verdad \w mi|strong="H1961"\w* hermana, \w pues|strong="H1931"\w* \w es|strong="H1931"\w* \w hija|strong="H1323"\w* de \w mi|strong="H1961"\w* padre, \w aunque|strong="H1571"\w* \w no|strong="H3808"\w* de \w mi|strong="H1961"\w* madre; \w y|strong="H1571"\w* llegó \w a|strong="H3068"\w* ser \w mi|strong="H1961"\w* esposa.  
\v 13 \w Cuando|strong="H1961"\w* Dios me \w hizo|strong="H6213"\w* salir de \w la|strong="H1931"\w* \w casa|strong="H1004"\w* de \w mi|strong="H1961"\w* padre \w para|strong="H1961"\w* andar errante, \w yo|strong="H6213"\w* \w le|strong="H1931"\w* dije \w a|strong="H3068"\w* \w ella|strong="H1931"\w*: ‘\w Hazme|strong="H6213"\w* \w este|strong="H2088"\w* favor: en \w cualquier|strong="H3605"\w* \w lugar|strong="H4725"\w* adonde vayamos, di \w siempre|strong="H3605"\w* \w que|strong="H1931"\w* \w soy|strong="H1961"\w* \w tu|strong="H6213"\w* hermano’”.   
\p
\v 14 \w Entonces|strong="H7725"\w* Abimelec \w tomó|strong="H3947"\w* \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w*, esclavos \w y|strong="H1241"\w* esclavas, \w y|strong="H1241"\w* se los regaló \w a|strong="H3068"\w* Abraham; además, le devolvió \w a|strong="H3068"\w* su esposa \w Sara|strong="H8283"\w*.  
\v 15 \w Y|strong="H3068"\w* \w le|strong="H5869"\w* dijo Abimelec: “\w Mi|strong="H2009"\w* tierra \w está|strong="H3427"\w* \w a|strong="H3068"\w* tu disposición; \w quédate|strong="H3427"\w* \w a|strong="H3068"\w* vivir donde más \w te|strong="H5869"\w* guste”.  
\v 16 \w A|strong="H3068"\w* \w Sara|strong="H8283"\w* \w le|strong="H1931"\w* dijo: “\w Mira|strong="H2009"\w*, \w le|strong="H1931"\w* he \w entregado|strong="H5414"\w* \w a|strong="H3068"\w* tu hermano mil \w monedas|strong="H3701"\w* \w de|strong="H5414"\w* \w plata|strong="H3701"\w*. \w Esto|strong="H1931"\w* servirá \w como|strong="H1931"\w* compensación \w para|strong="H5414"\w* ti ante \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1931"\w* \w están|strong="H2009"\w* contigo; \w así|strong="H1931"\w* quedarás libre \w de|strong="H5414"\w* \w toda|strong="H3605"\w* culpa”.   
\p
\v 17 Entonces Abraham \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Dios, y Dios \w sanó|strong="H7495"\w* \w a|strong="H3068"\w* Abimelec, \w a|strong="H3068"\w* su esposa y \w a|strong="H3068"\w* sus esclavas, para que pudieran tener hijos,  
\v 18 \w porque|strong="H3588"\w* \w a|strong="H3068"\w* \w causa|strong="H1697"\w* \w de|strong="H5921"\w* \w Sara|strong="H8283"\w*, \w la|strong="H5921"\w* esposa \w de|strong="H5921"\w* Abraham, Yahvé \w había|strong="H3588"\w* dejado estériles \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* mujeres \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Abimelec.   
\c 21  
\p
\v 1 Yahvé \w visitó|strong="H6485"\w* \w a|strong="H3068"\w* \w Sara|strong="H8283"\w* tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w dicho|strong="H1696"\w*, y cumplió Yahvé su promesa con ella.  
\v 2 \w Sara|strong="H8283"\w* quedó \w embarazada|strong="H2029"\w* y le dio un \w hijo|strong="H1121"\w* \w a|strong="H3068"\w* Abraham en su vejez, en \w el|strong="H1121"\w* \w tiempo|strong="H4150"\w* exacto \w que|strong="H1121"\w* Dios le había indicado.  
\v 3 Al \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* \w Sara|strong="H8283"\w* le dio, Abraham le \w puso|strong="H3205"\w* por \w nombre|strong="H8034"\w* \w Isaac|strong="H3327"\w*. \f + \fr 21:3 \ft Isaac significa “Él se ríe”.\f*  
\v 4 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ocho|strong="H8083"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* nacido, Abraham circuncidó \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*, tal como Dios se lo había \w ordenado|strong="H6680"\w*.  
\v 5 Abraham tenía ya \w cien|strong="H3967"\w* \w años|strong="H8141"\w* cuando \w nació|strong="H3205"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*.  
\v 6 \w Sara|strong="H8283"\w* exclamó: “Dios me ha \w hecho|strong="H6213"\w* reír, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* se enteren se reirán \w conmigo|strong="H6213"\w*”.  
\v 7 \w Y|strong="H3068"\w* añadió: “¿\w Quién|strong="H4310"\w* \w le|strong="H4310"\w* hubiera dicho \w a|strong="H3068"\w* Abraham \w que|strong="H3588"\w* \w Sara|strong="H8283"\w* amamantaría \w hijos|strong="H1121"\w*? Sin embargo, \w le|strong="H4310"\w* he dado un \w hijo|strong="H1121"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* vejez”.   
\p
\v 8 \w El|strong="H6213"\w* niño \w creció|strong="H1431"\w* y fue destetado. Ese mismo \w día|strong="H3117"\w*, Abraham \w hizo|strong="H6213"\w* una \w gran|strong="H1419"\w* fiesta.  
\v 9 Pero \w Sara|strong="H8283"\w* \w vio|strong="H7200"\w* \w que|strong="H1121"\w* \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* \w Agar|strong="H1904"\w* la \w egipcia|strong="H4713"\w* le había dado \w a|strong="H3068"\w* Abraham se burlaba \w de|strong="H1121"\w* Isaac.  
\v 10 \w Entonces|strong="H3588"\w* \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* Abraham: “¡\w Echa|strong="H1644"\w* \w de|strong="H3588"\w* aquí \w a|strong="H3068"\w* esa esclava \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*! \w El|strong="H5973"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* esa esclava \w jamás|strong="H3808"\w* compartirá \w la|strong="H3588"\w* herencia \w con|strong="H5973"\w* mi \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*”.   
\p
\v 11 \w Esto|strong="H1697"\w* \w le|strong="H5921"\w* dolió muchísimo \w a|strong="H3068"\w* Abraham, \w porque|strong="H5921"\w* \w se|strong="H5921"\w* trataba \w de|strong="H5921"\w* su propio \w hijo|strong="H1121"\w*.  
\v 12 \w Pero|strong="H3588"\w* Dios \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Abraham: “\w No|strong="H3588"\w* \w te|strong="H5869"\w* angusties \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w muchacho|strong="H5288"\w* ni \w por|strong="H5921"\w* tu esclava. Hazle caso \w a|strong="H3068"\w* \w Sara|strong="H8283"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w te|strong="H5869"\w* pida, \w porque|strong="H3588"\w* tu \w descendencia|strong="H2233"\w* \w se|strong="H5921"\w* establecerá \w por|strong="H5921"\w* medio \w de|strong="H5921"\w* \w Isaac|strong="H3327"\w*.  
\v 13 \w Pero|strong="H3588"\w* \w también|strong="H1571"\w* del \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* esclava \w haré|strong="H7760"\w* una gran \w nación|strong="H1471"\w*, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w también|strong="H1571"\w* \w es|strong="H1931"\w* descendiente tuyo”.  
\v 14 \w A|strong="H3068"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* siguiente, Abraham \w se|strong="H5921"\w* levantó muy temprano, \w tomó|strong="H3947"\w* \w pan|strong="H3899"\w* \w y|strong="H5921"\w* un \w odre|strong="H2573"\w* \w de|strong="H5921"\w* \w agua|strong="H4325"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w Agar|strong="H1904"\w*, poniéndoselos \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w hombro|strong="H7926"\w*. Luego \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* \w al|strong="H5921"\w* muchacho \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w despidió|strong="H7971"\w*. \w Agar|strong="H1904"\w* \w se|strong="H5921"\w* \w fue|strong="H3212"\w* \w y|strong="H5921"\w* \w anduvo|strong="H3212"\w* vagando \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* Beerseba.  
\v 15 Cuando \w se|strong="H4480"\w* le \w acabó|strong="H3615"\w* el \w agua|strong="H4325"\w* \w del|strong="H4480"\w* \w odre|strong="H2573"\w*, dejó \w al|strong="H4480"\w* muchacho \w debajo|strong="H8478"\w* \w de|strong="H4480"\w* un matorral  
\v 16 \w y|strong="H3588"\w* se \w fue|strong="H3212"\w* \w a|strong="H3068"\w* sentar \w a|strong="H3068"\w* cierta distancia, \w a|strong="H3068"\w* \w la|strong="H3588"\w* distancia \w de|strong="H3588"\w* un tiro \w de|strong="H3588"\w* \w arco|strong="H7198"\w*, \w pues|strong="H3588"\w* se decía: “\w No|strong="H3588"\w* quiero \w ver|strong="H7200"\w* morir al muchacho”. \w Y|strong="H3068"\w* \w mientras|strong="H3588"\w* \w estaba|strong="H3427"\w* allí sentada, comenzó \w a|strong="H3068"\w* llorar \w a|strong="H3068"\w* gritos.  
\v 17 \w Pero|strong="H3588"\w* Dios \w escuchó|strong="H8085"\w* \w los|strong="H1931"\w* sollozos \w del|strong="H4480"\w* \w muchacho|strong="H5288"\w*,  
\p \w y|strong="H3588"\w* \w el|strong="H1931"\w* \w ángel|strong="H4397"\w* \w de|strong="H4480"\w* Dios \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Agar|strong="H1904"\w* \w desde|strong="H4480"\w* \w el|strong="H1931"\w* \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijo: “¿\w Qué|strong="H3588"\w* \w te|strong="H4480"\w* pasa, \w Agar|strong="H1904"\w*? \w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* Dios ha escuchado \w los|strong="H1931"\w* sollozos \w del|strong="H4480"\w* \w muchacho|strong="H5288"\w* \w allí|strong="H8033"\w* \w donde|strong="H8033"\w* \w está|strong="H1931"\w*.  
\v 18 ¡\w Levántate|strong="H6965"\w*! \w Toma|strong="H5375"\w* al \w muchacho|strong="H5288"\w* \w y|strong="H3588"\w* \w tómalo|strong="H5375"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w mano|strong="H3027"\w*, \w porque|strong="H3588"\w* \w haré|strong="H7760"\w* \w de|strong="H3588"\w* \w él|strong="H3588"\w* una \w gran|strong="H1419"\w* \w nación|strong="H1471"\w*”.   
\p
\v 19 Entonces Dios \w le|strong="H5869"\w* \w abrió|strong="H6491"\w* los \w ojos|strong="H5869"\w*, y ella \w vio|strong="H7200"\w* un pozo \w de|strong="H4325"\w* \w agua|strong="H4325"\w*. \w Fue|strong="H3212"\w* y \w llenó|strong="H4390"\w* el \w odre|strong="H2573"\w* \w de|strong="H4325"\w* \w agua|strong="H4325"\w* y \w le|strong="H5869"\w* dio \w de|strong="H4325"\w* \w beber|strong="H8248"\w* al \w muchacho|strong="H5288"\w*.   
\p
\v 20 Dios acompañó al \w muchacho|strong="H5288"\w*, \w el|strong="H3427"\w* cual \w creció|strong="H1431"\w*, vivió en \w el|strong="H3427"\w* \w desierto|strong="H4057"\w* y \w se|strong="H1961"\w* convirtió en un \w gran|strong="H7235"\w* arquero.  
\v 21 Vivió en \w el|strong="H3427"\w* \w desierto|strong="H4057"\w* de \w Parán|strong="H6290"\w*, y su madre le consiguió una esposa de la tierra de \w Egipto|strong="H4714"\w*.   
\p
\v 22 \w En|strong="H5973"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, Abimelec y Ficol, \w jefe|strong="H8269"\w* \w de|strong="H5973"\w* \w su|strong="H1931"\w* \w ejército|strong="H6635"\w*, \w le|strong="H1931"\w* dijeron \w a|strong="H3068"\w* Abraham: “Dios \w está|strong="H1931"\w* \w contigo|strong="H5973"\w* \w en|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w haces|strong="H6213"\w*.  
\v 23 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w júrame|strong="H7650"\w* \w ahora|strong="H6258"\w* mismo, por Dios, \w que|strong="H6258"\w* \w no|strong="H6213"\w* \w me|strong="H5973"\w* engañarás \w a|strong="H3068"\w* mí, \w ni|strong="H5973"\w* \w a|strong="H3068"\w* mis hijos, \w ni|strong="H5973"\w* \w a|strong="H3068"\w* mis nietos. \w Júrame|strong="H7650"\w* \w que|strong="H6258"\w* \w así|strong="H6258"\w* \w como|strong="H5973"\w* \w yo|strong="H6213"\w* \w te|strong="H5973"\w* he tratado \w con|strong="H5973"\w* bondad, \w tú|strong="H6213"\w* también nos tratarás \w a|strong="H3068"\w* mí y \w a|strong="H3068"\w* este país \w donde|strong="H2008"\w* has vivido \w como|strong="H5973"\w* extranjero”.   
\p
\v 24 Abraham le respondió: “Te lo \w juro|strong="H7650"\w*”.  
\v 25 Pero Abraham \w le|strong="H5921"\w* reclamó \w a|strong="H3068"\w* Abimelec \w por|strong="H5921"\w* un pozo \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w siervos|strong="H5650"\w* \w de|strong="H5921"\w* Abimelec \w le|strong="H5921"\w* habían quitado \w por|strong="H5921"\w* \w la|strong="H5921"\w* fuerza.  
\v 26 Abimelec contestó: “\w No|strong="H3808"\w* \w sé|strong="H3045"\w* \w quién|strong="H4310"\w* pudo \w haber|strong="H3808"\w* \w hecho|strong="H6213"\w* \w esto|strong="H2088"\w*. \w Tú|strong="H6213"\w* \w no|strong="H3808"\w* \w me|strong="H4310"\w* \w lo|strong="H1697"\w* habías informado, \w y|strong="H1571"\w* \w yo|strong="H6213"\w* \w me|strong="H4310"\w* vengo \w a|strong="H3068"\w* enterar apenas \w hoy|strong="H3117"\w*”.   
\p
\v 27 Entonces Abraham \w tomó|strong="H3947"\w* \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w*, \w y|strong="H1241"\w* se las \w dio|strong="H5414"\w* \w a|strong="H3068"\w* Abimelec, \w y|strong="H1241"\w* los \w dos|strong="H8147"\w* \w hicieron|strong="H3772"\w* un \w pacto|strong="H1285"\w*.  
\v 28 Luego Abraham apartó \w siete|strong="H7651"\w* \w corderas|strong="H3535"\w* de su \w rebaño|strong="H6629"\w*,  
\v 29 y Abimelec le preguntó: “¿\w Qué|strong="H4100"\w* significan \w estas|strong="H2007"\w* \w siete|strong="H7651"\w* \w corderas|strong="H3535"\w* \w que|strong="H4100"\w* has puesto aparte?”   
\p
\v 30 Abraham respondió: “Aceptarás \w estas|strong="H2063"\w* \w siete|strong="H7651"\w* \w corderas|strong="H3535"\w* \w de|strong="H3588"\w* mis \w manos|strong="H3027"\w* \w como|strong="H3588"\w* prueba \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* mismo cavé \w este|strong="H2063"\w* pozo”.  
\v 31 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* \w llamó|strong="H7121"\w* Beerseba,\f + \fr 21:31 \ft Beerseba puede significar “pozo del juramento” o “pozo de las siete”.\f* \w porque|strong="H3588"\w* \w allí|strong="H8033"\w* \w ambos|strong="H8147"\w* hicieron un juramento.  
\v 32 Después \w de|strong="H8269"\w* \w hacer|strong="H3772"\w* este \w pacto|strong="H1285"\w* en Beerseba, Abimelec y Ficol, \w jefe|strong="H8269"\w* \w de|strong="H8269"\w* su \w ejército|strong="H6635"\w*, regresaron \w a|strong="H3068"\w* la tierra \w de|strong="H8269"\w* los \w filisteos|strong="H6430"\w*.  
\v 33 Abraham \w plantó|strong="H5193"\w* un árbol de tamarisco en Beerseba, y \w allí|strong="H8033"\w* invocó el \w nombre|strong="H8034"\w* de Yahvé, el \w Dios|strong="H3068"\w* \w eterno|strong="H5769"\w*.  
\v 34 \w Y|strong="H3068"\w* Abraham \w vivió|strong="H3117"\w* \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w* como extranjero en la tierra de los \w filisteos|strong="H6430"\w*.   
\c 22  
\p
\v 1 Pasado algún tiempo, Dios puso \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w a|strong="H3068"\w* Abraham y le dijo: “¡Abraham!”  
\p “\w Aquí|strong="H2009"\w* \w estoy|strong="H1961"\w*”, respondió él.   
\p
\v 2 \w Y|strong="H3068"\w* Dios \w le|strong="H5921"\w* dijo: “\w Toma|strong="H3947"\w* \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w*, \w a|strong="H3068"\w* tu \w único|strong="H3173"\w* \w hijo|strong="H1121"\w*, \w Isaac|strong="H3327"\w*, \w a|strong="H3068"\w* quien \w tanto|strong="H5921"\w* amas, \w y|strong="H5921"\w* \w vete|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* Moriah. \w Allí|strong="H8033"\w* \w me|strong="H5921"\w* \w lo|strong="H5921"\w* \w ofrecerás|strong="H5927"\w* \w en|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* montaña \w que|strong="H4994"\w* \w yo|strong="H4994"\w* \w te|strong="H5921"\w* indicaré”.   
\p
\v 3 Abraham se \w levantó|strong="H6965"\w* \w de|strong="H1121"\w* madrugada, ensilló su burro y se \w llevó|strong="H3947"\w* consigo \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w de|strong="H1121"\w* sus \w muchachos|strong="H1121"\w* y \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*. \w Cortó|strong="H1234"\w* \w leña|strong="H6086"\w* para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w* y emprendió \w el|strong="H1121"\w* viaje hacia \w el|strong="H1121"\w* \w lugar|strong="H4725"\w* \w que|strong="H1121"\w* Dios \w le|strong="H1242"\w* había indicado.  
\v 4 Al tercer \w día|strong="H3117"\w*, Abraham \w levantó|strong="H5375"\w* la vista y \w vio|strong="H7200"\w* el \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* \w lo|strong="H7350"\w* \w lejos|strong="H7350"\w*.  
\v 5 \w Entonces|strong="H7725"\w* \w les|strong="H5973"\w* dijo \w a|strong="H3068"\w* sus muchachos: “Quédense \w aquí|strong="H6311"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* burro. \w El|strong="H5973"\w* \w muchacho|strong="H5288"\w* \w y|strong="H5704"\w* yo seguiremos \w hasta|strong="H5704"\w* allá. Adoraremos \w a|strong="H3068"\w* Dios \w y|strong="H5704"\w* \w luego|strong="H7725"\w* regresaremos \w con|strong="H5973"\w* ustedes”.  
\v 6 Abraham \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* \w leña|strong="H6086"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w puso|strong="H7760"\w* \w sobre|strong="H5921"\w* \w los|strong="H1121"\w* hombros \w de|strong="H5921"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*; \w él|strong="H5921"\w*, \w por|strong="H5921"\w* su parte, \w llevó|strong="H3947"\w* \w el|strong="H5921"\w* fuego \w y|strong="H5921"\w* \w el|strong="H5921"\w* cuchillo. \w Y|strong="H3068"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* siguieron \w caminando|strong="H3212"\w* \w juntos|strong="H3162"\w*.  
\v 7 \w De|strong="H1121"\w* pronto, \w Isaac|strong="H3327"\w* le dijo \w a|strong="H3068"\w* su padre Abraham: “¿Padre mío?”  
\p “\w Aquí|strong="H2009"\w* estoy, \w hijo|strong="H1121"\w* mío”, le respondió.  
\p “\w Aquí|strong="H2009"\w* tenemos \w el|strong="H1121"\w* fuego y la \w leña|strong="H6086"\w* dijo \w Isaac|strong="H3327"\w*, pero ¿dónde está \w el|strong="H1121"\w* \w cordero|strong="H7716"\w* para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*?”   
\p
\v 8 Abraham le respondió: “Dios mismo \w proveerá|strong="H7200"\w* \w el|strong="H1121"\w* \w cordero|strong="H7716"\w* para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*, \w hijo|strong="H1121"\w* mío”. \w Y|strong="H3068"\w* continuaron \w caminando|strong="H3212"\w* \w juntos|strong="H3162"\w*.  
\v 9 Cuando llegaron \w al|strong="H5921"\w* \w lugar|strong="H4725"\w* \w que|strong="H5921"\w* Dios \w le|strong="H5921"\w* había indicado, Abraham construyó un \w altar|strong="H4196"\w* \w y|strong="H5921"\w* acomodó \w la|strong="H5921"\w* \w leña|strong="H6086"\w*. Luego ató \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w puso|strong="H7760"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, \w encima|strong="H4605"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w leña|strong="H6086"\w*.  
\v 10 Entonces \w extendió|strong="H7971"\w* la \w mano|strong="H3027"\w* y \w tomó|strong="H3947"\w* \w el|strong="H1121"\w* cuchillo para sacrificar \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w*.   
\p
\v 11 Pero el \w ángel|strong="H4397"\w* \w de|strong="H4480"\w* Yahvé lo \w llamó|strong="H7121"\w* \w desde|strong="H4480"\w* el \w cielo|strong="H8064"\w*: “¡Abraham, Abraham!”  
\p “\w Aquí|strong="H2009"\w* estoy”, respondió él.   
\p
\v 12 “\w No|strong="H3808"\w* \w pongas|strong="H7971"\w* \w tu|strong="H6213"\w* \w mano|strong="H3027"\w* \w sobre|strong="H4480"\w* \w el|strong="H3588"\w* \w muchacho|strong="H5288"\w* \w ni|strong="H3808"\w* le \w hagas|strong="H6213"\w* \w ningún|strong="H3808"\w* daño”, le dijo \w el|strong="H3588"\w* ángel. “\w Ahora|strong="H6258"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w temes|strong="H3373"\w* \w a|strong="H3068"\w* Dios, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H4480"\w* has negado \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w hijo|strong="H1121"\w*, \w tu|strong="H6213"\w* \w único|strong="H3173"\w* \w hijo|strong="H1121"\w*”.   
\p
\v 13 Abraham \w levantó|strong="H5375"\w* la vista y \w vio|strong="H7200"\w* \w a|strong="H3068"\w* sus espaldas un carnero enredado \w por|strong="H8478"\w* \w los|strong="H1121"\w* \w cuernos|strong="H7161"\w* \w en|strong="H8478"\w* un matorral. Entonces \w fue|strong="H3212"\w*, \w tomó|strong="H3947"\w* \w el|strong="H1121"\w* carnero y lo \w ofreció|strong="H5927"\w* \w en|strong="H8478"\w* \w holocausto|strong="H5930"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su \w hijo|strong="H1121"\w*.  
\v 14 Por \w eso|strong="H1931"\w* Abraham \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w aquel|strong="H1931"\w* \w lugar|strong="H4725"\w* “Yahvé \w proveerá|strong="H7200"\w*”.\f + \fr 22:14 \ft o, Yahvé-Jireh, que significa “Yahvé provee”.\f* De allí viene \w el|strong="H1931"\w* dicho de \w hoy|strong="H3117"\w*: “En \w la|strong="H1931"\w* montaña de Yahvé \w se|strong="H1931"\w* \w proveerá|strong="H7200"\w*”.   
\p
\v 15 El \w ángel|strong="H4397"\w* \w de|strong="H4480"\w* Yahvé \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Abraham \w por|strong="H4480"\w* \w segunda|strong="H8145"\w* vez \w desde|strong="H4480"\w* el \w cielo|strong="H8064"\w*  
\v 16 \w y|strong="H3588"\w* le \w dijo|strong="H5002"\w*: “He \w jurado|strong="H7650"\w* \w por|strong="H3588"\w* mí mismo, afirma Yahvé, \w que|strong="H3588"\w* \w por|strong="H3588"\w* \w haber|strong="H3808"\w* \w hecho|strong="H6213"\w* \w esto|strong="H2088"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* haberme negado \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w hijo|strong="H1121"\w*, \w tu|strong="H6213"\w* \w único|strong="H3173"\w* \w hijo|strong="H1121"\w*,  
\v 17 \w te|strong="H5921"\w* \w bendeciré|strong="H1288"\w* \w en|strong="H5921"\w* \w gran|strong="H7235"\w* \w manera|strong="H7235"\w*. \w Multiplicaré|strong="H7235"\w* tu \w descendencia|strong="H2233"\w* \w como|strong="H3588"\w* \w las|strong="H5921"\w* \w estrellas|strong="H3556"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* \w como|strong="H3588"\w* \w la|strong="H5921"\w* arena \w de|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w mar|strong="H3220"\w*. Tu \w descendencia|strong="H2233"\w* conquistará \w las|strong="H5921"\w* \w ciudades|strong="H8179"\w* \w de|strong="H5921"\w* sus enemigos,  
\v 18 y \w por|strong="H6118"\w* medio de tu \w descendencia|strong="H2233"\w* serán bendecidas \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* de \w la|strong="H3605"\w* tierra, \w porque|strong="H6118"\w* has obedecido mi \w voz|strong="H6963"\w*”.   
\p
\v 19 \w Después|strong="H3427"\w* de esto, Abraham regresó \w a|strong="H3068"\w* donde \w estaban|strong="H3427"\w* sus muchachos, y \w juntos|strong="H3162"\w* \w partieron|strong="H3212"\w* hacia Beerseba. \w Y|strong="H3068"\w* Abraham se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w en|strong="H3212"\w* Beerseba.   
\p
\v 20 Pasado algún tiempo, \w le|strong="H1931"\w* informaron \w a|strong="H3068"\w* Abraham: “Tu cuñada \w Milca|strong="H4435"\w* \w también|strong="H1571"\w* \w le|strong="H1931"\w* ha dado \w hijos|strong="H1121"\w* \w a|strong="H3068"\w* tu hermano Nacor:  
\v 21 \w Uz|strong="H5780"\w* el \w primogénito|strong="H1060"\w*, Buz su hermano, Kemuel el padre de Aram,  
\v 22 Quésed, Jazó, Pildás, Jidlaf y Betuel”.  
\v 23 \w Y|strong="H3068"\w* Betuel fue el padre de \w Rebeca|strong="H7259"\w*. Estos \w ocho|strong="H8083"\w* hijos le dio \w Milca|strong="H4435"\w* \w a|strong="H3068"\w* Nacor, el hermano de Abraham.  
\v 24 \w Además|strong="H1571"\w*, \w la|strong="H1931"\w* \w concubina|strong="H6370"\w* de Nacor, \w que|strong="H1931"\w* \w se|strong="H1931"\w* \w llamaba|strong="H8034"\w* \w Reúma|strong="H7208"\w*, \w le|strong="H1931"\w* dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Tébah, Gaham, Tahas \w y|strong="H1571"\w* Maaca.   
\c 23  
\p
\v 1 \w Sara|strong="H8283"\w* vivió \w ciento|strong="H3967"\w* \w veintisiete|strong="H6242"\w* \w años|strong="H8141"\w*; esa \w fue|strong="H1961"\w* la duración de su \w vida|strong="H2416"\w*.  
\v 2 \w Murió|strong="H4191"\w* en Quiriat Arba (\w es|strong="H1931"\w* decir, en \w Hebrón|strong="H2275"\w*), en \w la|strong="H1931"\w* tierra de \w Canaán|strong="H3667"\w*. \w Y|strong="H3068"\w* Abraham hizo duelo por \w Sara|strong="H8283"\w* y \w la|strong="H1931"\w* \w lloró|strong="H1058"\w*.  
\v 3 Luego Abraham \w se|strong="H5921"\w* \w levantó|strong="H6965"\w* \w de|strong="H5921"\w* \w donde|strong="H5921"\w* estaba \w el|strong="H5921"\w* cuerpo \w de|strong="H5921"\w* su esposa, \w y|strong="H5921"\w* fue \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H5921"\w* \w los|strong="H1121"\w* hititas, diciéndoles:  
\v 4 “Yo \w no|strong="H6440"\w* soy \w más|strong="H4191"\w* \w que|strong="H1616"\w* un \w extranjero|strong="H1616"\w* \w de|strong="H6440"\w* paso \w entre|strong="H5973"\w* ustedes. Véndanme una propiedad \w para|strong="H5414"\w* tener un lugar propio donde sepultar \w a|strong="H3068"\w* mi esposa”.   
\p
\v 5 \w Los|strong="H1121"\w* hititas le \w respondieron|strong="H6030"\w* \w a|strong="H3068"\w* Abraham:  
\v 6 “Escúchenos, señor nuestro. Usted es un \w príncipe|strong="H5387"\w* \w de|strong="H4480"\w* Dios \w entre|strong="H8432"\w* nosotros. Sepulte \w a|strong="H3068"\w* su esposa \w en|strong="H4480"\w* la mejor \w de|strong="H4480"\w* nuestras tumbas. \w Ninguno|strong="H3808"\w* \w de|strong="H4480"\w* nosotros le negará su tumba \w para|strong="H4480"\w* \w que|strong="H4480"\w* sepulte \w a|strong="H3068"\w* su esposa”.   
\p
\v 7 Abraham \w se|strong="H5971"\w* \w levantó|strong="H6965"\w*, \w se|strong="H5971"\w* inclinó ante \w los|strong="H1121"\w* hititas, \w que|strong="H5971"\w* eran \w los|strong="H1121"\w* habitantes del lugar,  
\v 8 y les \w dijo|strong="H1696"\w*: “\w Si|strong="H6440"\w* \w de|strong="H6440"\w* veras \w están|strong="H3426"\w* \w de|strong="H6440"\w* acuerdo \w en|strong="H6912"\w* \w que|strong="H1121"\w* \w yo|strong="H5315"\w* sepulte aquí \w a|strong="H3068"\w* \w mi|strong="H5315"\w* esposa, escúchenme y pídanle \w de|strong="H6440"\w* \w mi|strong="H5315"\w* parte \w a|strong="H3068"\w* Efrón, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Zojar,  
\v 9 que me venda la \w cueva|strong="H4631"\w* \w de|strong="H5414"\w* Macpela que le pertenece, la cual está \w en|strong="H8432"\w* el \w extremo|strong="H7097"\w* \w de|strong="H5414"\w* su \w campo|strong="H7704"\w*. Que me la venda \w por|strong="H5414"\w* su \w precio|strong="H3701"\w* exacto, \w para|strong="H5414"\w* tener \w entre|strong="H8432"\w* ustedes un lugar propio \w para|strong="H5414"\w* sepulturas”.   
\p
\v 10 Efrón \w el|strong="H3605"\w* hitita \w estaba|strong="H3427"\w* \w sentado|strong="H3427"\w* \w entre|strong="H8432"\w* su gente, y le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* Abraham para \w que|strong="H1121"\w* \w lo|strong="H3605"\w* escucharan \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H1121"\w* entraban por \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*:  
\v 11 “\w No|strong="H3808"\w*, señor \w mío|strong="H5971"\w*, escúcheme \w bien|strong="H5869"\w*. Yo \w le|strong="H5869"\w* regalo \w el|strong="H1121"\w* \w campo|strong="H7704"\w*, y también \w le|strong="H5869"\w* regalo la \w cueva|strong="H4631"\w* \w que|strong="H3808"\w* está \w en|strong="H6912"\w* \w él|strong="H1121"\w*. \w Se|strong="H3808"\w* \w lo|strong="H3808"\w* \w doy|strong="H5414"\w* \w en|strong="H6912"\w* presencia \w de|strong="H1121"\w* mi \w pueblo|strong="H5971"\w*. Sepulte \w a|strong="H3068"\w* su esposa”.   
\p
\v 12 Abraham volvió \w a|strong="H3068"\w* inclinarse \w ante|strong="H6440"\w* la \w gente|strong="H5971"\w* del lugar,  
\v 13 y \w a|strong="H3068"\w* la vista \w de|strong="H4480"\w* todos \w ellos|strong="H4480"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Efrón: “\w Por|strong="H4480"\w* favor, escúcheme usted \w a|strong="H3068"\w* mí. Le \w pagaré|strong="H5414"\w* el \w precio|strong="H3701"\w* \w del|strong="H4480"\w* \w campo|strong="H7704"\w*. Acéptelo, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w yo|strong="H4480"\w* pueda sepultar \w allí|strong="H8033"\w* \w a|strong="H3068"\w* mi esposa”.   
\p
\v 14 Efrón le contestó \w a|strong="H3068"\w* Abraham:  
\v 15 “Señor mío, escúcheme: un terreno \w que|strong="H4100"\w* vale cuatrocientas \w monedas|strong="H3701"\w* de \w plata|strong="H3701"\w*\f + \fr 23:15 \ft Un siclo equivale a unos 10 gramos, por lo que 400 siclos serían unos 4 kg u 8,8 libras.\f*, ¿\w qué|strong="H4100"\w* significa entre usted y yo? Sepulte \w a|strong="H3068"\w* \w su|strong="H1931"\w* esposa”.   
\p
\v 16 Abraham aceptó la propuesta \w de|strong="H1121"\w* Efrón, y \w a|strong="H3068"\w* la vista \w de|strong="H1121"\w* \w los|strong="H1121"\w* hititas le pesó la cantidad \w de|strong="H1121"\w* \w plata|strong="H3701"\w* \w que|strong="H1121"\w* Efrón había mencionado: cuatrocientas \w monedas|strong="H3701"\w* \w de|strong="H1121"\w* \w plata|strong="H3701"\w*, \w de|strong="H1121"\w* acuerdo con \w el|strong="H1121"\w* peso \w de|strong="H1121"\w* \w los|strong="H1121"\w* comerciantes \w de|strong="H1121"\w* la época.   
\p
\v 17 Fue así como \w el|strong="H3605"\w* \w campo|strong="H7704"\w* \w de|strong="H6440"\w* Efrón en Macpela, frente \w a|strong="H3068"\w* \w Mamre|strong="H4471"\w*, es decir, \w el|strong="H3605"\w* \w campo|strong="H7704"\w* con \w la|strong="H3605"\w* \w cueva|strong="H4631"\w* y con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* \w que|strong="H3605"\w* había \w dentro|strong="H6440"\w* \w de|strong="H6440"\w* sus límites,  
\v 18 pasó \w a|strong="H3068"\w* ser propiedad \w de|strong="H1121"\w* Abraham, \w a|strong="H3068"\w* \w la|strong="H3605"\w* vista \w de|strong="H1121"\w* \w los|strong="H1121"\w* hititas y \w de|strong="H1121"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* entraban por \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*.  
\v 19 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w esto|strong="H3651"\w*, Abraham \w sepultó|strong="H6912"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* esposa \w Sara|strong="H8283"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w cueva|strong="H4631"\w* \w del|strong="H5921"\w* \w campo|strong="H7704"\w* \w de|strong="H5921"\w* Macpela, frente \w a|strong="H3068"\w* \w Mamre|strong="H4471"\w* (\w es|strong="H1931"\w* decir, \w Hebrón|strong="H2275"\w*), \w en|strong="H5921"\w* \w la|strong="H1931"\w* tierra \w de|strong="H5921"\w* \w Canaán|strong="H3667"\w*.  
\v 20 Así fue como \w los|strong="H1121"\w* hititas le cedieron \w a|strong="H3068"\w* Abraham \w el|strong="H1121"\w* \w campo|strong="H7704"\w* y la \w cueva|strong="H4631"\w*, como propiedad para \w sepultura|strong="H6913"\w*.   
\c 24  
\p
\v 1 Abraham ya era \w viejo|strong="H2204"\w*, de \w edad|strong="H3117"\w* muy avanzada, y Yahvé \w lo|strong="H3605"\w* había bendecido en \w todo|strong="H3605"\w*.  
\v 2 Un día, Abraham le dijo \w al|strong="H8478"\w* sirviente más \w viejo|strong="H2205"\w* \w de|strong="H8478"\w* su \w casa|strong="H1004"\w*, \w el|strong="H3605"\w* \w que|strong="H4994"\w* administraba \w todos|strong="H3605"\w* sus bienes: “\w Por|strong="H8478"\w* favor, \w pon|strong="H7760"\w* tu \w mano|strong="H3027"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w mi|strong="H4994"\w* \w muslo|strong="H3409"\w*  
\v 3 y \w júrame|strong="H7650"\w* por Yahvé, \w Dios|strong="H3068"\w* del \w cielo|strong="H8064"\w* y \w de|strong="H1121"\w* la tierra, \w que|strong="H3808"\w* \w no|strong="H3808"\w* buscarás una esposa para mi \w hijo|strong="H1121"\w* \w entre|strong="H7130"\w* las \w hijas|strong="H1323"\w* \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w*, con \w los|strong="H3427"\w* cuales vivo.  
\v 4 Júrame \w que|strong="H3588"\w* \w irás|strong="H3212"\w* \w a|strong="H3068"\w* mi tierra, \w a|strong="H3068"\w* mi propia familia, \w y|strong="H3588"\w* \w de|strong="H3588"\w* allí buscarás una esposa \w para|strong="H3588"\w* mi \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*”.   
\p
\v 5 \w El|strong="H1121"\w* sirviente le preguntó: “¿\w Y|strong="H3068"\w* \w qué|strong="H3808"\w* pasa \w si|strong="H3808"\w* \w la|strong="H2063"\w* mujer \w no|strong="H3808"\w* quiere \w venir|strong="H3212"\w* conmigo \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra? ¿Debo llevar \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w* \w a|strong="H3068"\w* \w la|strong="H2063"\w* tierra \w de|strong="H1121"\w* \w donde|strong="H8033"\w* \w saliste|strong="H3318"\w*?”   
\p
\v 6 Abraham le advirtió: “¡Cuidado con llevar \w allá|strong="H8033"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w*!  
\v 7 Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* del \w cielo|strong="H8064"\w*, \w que|strong="H1931"\w* me sacó \w de|strong="H6440"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H6440"\w* mi padre y \w de|strong="H6440"\w* \w la|strong="H1931"\w* tierra \w de|strong="H6440"\w* \w mis|strong="H5414"\w* familiares, me prometió y me \w juró|strong="H7650"\w*: ‘\w A|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w le|strong="H1931"\w* \w daré|strong="H5414"\w* \w esta|strong="H2063"\w* tierra’. \w Él|strong="H1931"\w* \w enviará|strong="H7971"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w ángel|strong="H4397"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti \w para|strong="H5414"\w* \w que|strong="H1931"\w* puedas traer \w de|strong="H6440"\w* \w allá|strong="H8033"\w* una esposa \w para|strong="H5414"\w* mi \w hijo|strong="H1121"\w*.  
\v 8 \w Si|strong="H3808"\w* \w la|strong="H2063"\w* mujer \w no|strong="H3808"\w* quiere seguirte, quedarás \w libre|strong="H5352"\w* \w de|strong="H1121"\w* \w este|strong="H2063"\w* \w juramento|strong="H7621"\w*. Pero por \w ningún|strong="H3808"\w* motivo lleves \w allá|strong="H8033"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w*”.   
\p
\v 9 Entonces \w el|strong="H5921"\w* sirviente \w puso|strong="H7760"\w* su \w mano|strong="H3027"\w* \w debajo|strong="H8478"\w* \w del|strong="H5921"\w* \w muslo|strong="H3409"\w* \w de|strong="H5921"\w* su amo Abraham, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w juró|strong="H7650"\w* cumplir \w con|strong="H5921"\w* \w este|strong="H2088"\w* encargo.  
\v 10 Luego \w tomó|strong="H3947"\w* \w diez|strong="H6235"\w* de \w los|strong="H3605"\w* \w camellos|strong="H1581"\w* de su amo, \w cargó|strong="H3027"\w* \w toda|strong="H3605"\w* clase de regalos valiosos de su amo, y se puso \w en|strong="H3212"\w* camino hacia Aram Naharaim, \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* de Nacor.  
\v 11 Hacia el atardecer, \w a|strong="H3068"\w* la \w hora|strong="H6256"\w* \w en|strong="H3318"\w* \w que|strong="H4325"\w* las mujeres \w salen|strong="H3318"\w* \w a|strong="H3068"\w* sacar \w agua|strong="H4325"\w*, el sirviente hizo arrodillar \w a|strong="H3068"\w* los \w camellos|strong="H1581"\w* \w fuera|strong="H2351"\w* \w de|strong="H4325"\w* la \w ciudad|strong="H5892"\w*, junto \w al|strong="H6256"\w* pozo \w de|strong="H4325"\w* \w agua|strong="H4325"\w*.  
\v 12 \w Y|strong="H3068"\w* oró: “Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w mi|strong="H4994"\w* amo Abraham, \w te|strong="H5973"\w* \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* \w me|strong="H5973"\w* concedas \w el|strong="H5973"\w* éxito \w hoy|strong="H3117"\w* y \w que|strong="H4994"\w* \w le|strong="H5973"\w* muestres bondad \w a|strong="H3068"\w* \w mi|strong="H4994"\w* amo Abraham.  
\v 13 \w Aquí|strong="H2009"\w* \w estoy|strong="H5324"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* este manantial, mientras \w las|strong="H5921"\w* muchachas \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w salen|strong="H3318"\w* \w a|strong="H3068"\w* sacar \w agua|strong="H4325"\w*.  
\v 14 \w Yo|strong="H3588"\w* \w le|strong="H5973"\w* diré \w a|strong="H3068"\w* una \w de|strong="H3588"\w* las muchachas: ‘\w Por|strong="H3588"\w* favor, \w baja|strong="H5186"\w* \w tu|strong="H6213"\w* \w cántaro|strong="H3537"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* beba’. \w Si|strong="H3588"\w* ella \w me|strong="H3588"\w* responde: ‘\w Bebe|strong="H8354"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w les|strong="H5973"\w* daré \w de|strong="H3588"\w* \w beber|strong="H8354"\w* \w a|strong="H3068"\w* tus \w camellos|strong="H1581"\w*’, \w que|strong="H3588"\w* \w sea|strong="H1961"\w* ella \w la|strong="H1571"\w* \w que|strong="H3588"\w* \w tú|strong="H6213"\w* has elegido \w para|strong="H3588"\w* \w tu|strong="H6213"\w* \w siervo|strong="H5650"\w* \w Isaac|strong="H3327"\w*. \w Así|strong="H1571"\w* sabré \w que|strong="H3588"\w* has \w sido|strong="H1961"\w* bondadoso \w con|strong="H5973"\w* \w mi|strong="H1961"\w* amo”.   
\p
\v 15 \w Aún|strong="H2962"\w* \w no|strong="H1961"\w* \w había|strong="H1961"\w* terminado \w de|strong="H5921"\w* orar, \w cuando|strong="H1961"\w* \w vio|strong="H2009"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* acercaba \w Rebeca|strong="H7259"\w* \w con|strong="H5921"\w* \w su|strong="H1931"\w* \w cántaro|strong="H3537"\w* \w al|strong="H5921"\w* \w hombro|strong="H7926"\w*. \w Ella|strong="H1931"\w* \w era|strong="H1961"\w* hija \w de|strong="H5921"\w* Betuel, \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Milca|strong="H4435"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Nacor, \w el|strong="H1931"\w* hermano \w de|strong="H5921"\w* Abraham.  
\v 16 La joven era \w muy|strong="H3966"\w* \w hermosa|strong="H2896"\w*; era \w virgen|strong="H1330"\w*, \w ningún|strong="H3808"\w* hombre la había tocado. Bajó hasta el manantial, \w llenó|strong="H4390"\w* su \w cántaro|strong="H3537"\w* y volvió \w a|strong="H3068"\w* \w subir|strong="H5927"\w*.  
\v 17 El sirviente \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* su encuentro y le dijo: “Por favor, dame \w a|strong="H3068"\w* beber un \w poco|strong="H4592"\w* \w de|strong="H4325"\w* \w agua|strong="H4325"\w* \w de|strong="H4325"\w* tu \w cántaro|strong="H3537"\w*”.   
\p
\v 18 “Beba usted, señor \w mío|strong="H5921"\w*” respondió \w ella|strong="H5921"\w*. Enseguida bajó su \w cántaro|strong="H3537"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* dio \w a|strong="H3068"\w* \w beber|strong="H8354"\w*.  
\v 19 \w Cuando|strong="H5704"\w* \w él|strong="H1571"\w* terminó \w de|strong="H5704"\w* \w beber|strong="H8354"\w*, ella le dijo: “Ahora voy \w a|strong="H3068"\w* sacar agua \w para|strong="H5704"\w* sus \w camellos|strong="H1581"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* terminen \w de|strong="H5704"\w* \w beber|strong="H8354"\w*”.  
\v 20 Rápidamente vació su \w cántaro|strong="H3537"\w* \w en|strong="H5750"\w* \w el|strong="H3605"\w* bebedero y \w corrió|strong="H7323"\w* \w de|strong="H5750"\w* nuevo al pozo para sacar \w más|strong="H5750"\w* agua, y les dio \w de|strong="H5750"\w* beber \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w camellos|strong="H1581"\w*.   
\p
\v 21 El hombre la observaba en silencio, maravillado, tratando de \w saber|strong="H3045"\w* \w si|strong="H3808"\w* Yahvé había coronado con el éxito su \w viaje|strong="H1870"\w* \w o|strong="H3068"\w* \w no|strong="H3808"\w*.  
\v 22 \w Cuando|strong="H1961"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w* terminaron \w de|strong="H5921"\w* \w beber|strong="H8354"\w*, \w el|strong="H5921"\w* hombre \w tomó|strong="H3947"\w* un anillo \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* pesaba \w como|strong="H1961"\w* seis gramos,\f + \fr 24:22 \ft Un siclo equivale a unos 10 gramos; medio siclo son 5 gramos o unas 0,17 onzas.\f* \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w lo|strong="H5921"\w* puso \w a|strong="H3068"\w* \w ella|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* nariz. También \w le|strong="H5921"\w* puso \w en|strong="H5921"\w* \w los|strong="H5921"\w* brazos \w dos|strong="H8147"\w* pulseras \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* pesaban \w más|strong="H5921"\w* \w de|strong="H5921"\w* cien gramos,  
\v 23 y \w le|strong="H4310"\w* preguntó: “Por favor, dime: ¿de \w quién|strong="H4310"\w* eres \w hija|strong="H1323"\w*? ¿\w Habrá|strong="H3426"\w* \w lugar|strong="H4725"\w* en la \w casa|strong="H1004"\w* de \w tu|strong="H3426"\w* padre para \w que|strong="H4310"\w* mis hombres y \w yo|strong="H4994"\w* pasemos la noche?”   
\p
\v 24 Ella le respondió: “Soy \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Betuel, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* \w Milca|strong="H4435"\w* le dio \w a|strong="H3068"\w* Nacor”.  
\v 25 \w Y|strong="H3068"\w* añadió: “Tenemos \w mucha|strong="H7227"\w* \w paja|strong="H8401"\w* \w y|strong="H1571"\w* \w forraje|strong="H4554"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* hay \w lugar|strong="H4725"\w* \w para|strong="H5973"\w* \w que|strong="H1571"\w* pasen \w la|strong="H1571"\w* noche”.   
\p
\v 26 Entonces el hombre se \w inclinó|strong="H6915"\w* y \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* Yahvé,  
\v 27 diciendo: “¡\w Bendito|strong="H1288"\w* sea Yahvé, \w el|strong="H5973"\w* \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* mi amo Abraham, \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w le|strong="H5973"\w* \w ha|strong="H3808"\w* negado su bondad y su verdad \w a|strong="H3068"\w* mi amo! Yahvé \w me|strong="H5973"\w* \w ha|strong="H3808"\w* guiado \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w camino|strong="H1870"\w* hasta la \w casa|strong="H1004"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* familiares \w de|strong="H5973"\w* mi amo”.   
\p
\v 28 La joven \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H1697"\w* su madre para contar todo \w esto|strong="H1697"\w*.  
\v 29 \w Rebeca|strong="H7259"\w* tenía un hermano \w llamado|strong="H8034"\w* \w Labán|strong="H3837"\w*, el cual salió \w corriendo|strong="H7323"\w* hacia el manantial para encontrarse con el hombre.  
\v 30 \w Cuando|strong="H1961"\w* Labán \w vio|strong="H7200"\w* \w el|strong="H5921"\w* anillo \w en|strong="H5921"\w* \w la|strong="H5921"\w* nariz \w de|strong="H5921"\w* su hermana \w y|strong="H5921"\w* \w las|strong="H5921"\w* pulseras \w en|strong="H5921"\w* sus brazos, \w y|strong="H5921"\w* \w escuchó|strong="H8085"\w* \w que|strong="H5921"\w* \w Rebeca|strong="H7259"\w* decía: “\w Así|strong="H3541"\w* \w me|strong="H5921"\w* \w habló|strong="H1696"\w* aquel hombre”, \w fue|strong="H1961"\w* \w a|strong="H3068"\w* buscarlo. \w Lo|strong="H1697"\w* encontró todavía \w de|strong="H5921"\w* \w pie|strong="H5975"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w*, \w cerca|strong="H5921"\w* \w del|strong="H5921"\w* manantial.  
\v 31 \w Y|strong="H3068"\w* le dijo: “¡Pase usted, \w bendito|strong="H1288"\w* de Yahvé! ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w se|strong="H4100"\w* queda ahí \w afuera|strong="H2351"\w*? \w Ya|strong="H3068"\w* he preparado la \w casa|strong="H1004"\w* y un \w lugar|strong="H4725"\w* para los \w camellos|strong="H1581"\w*”.   
\p
\v 32 Entonces el hombre entró en la \w casa|strong="H1004"\w*. Labán descargó los \w camellos|strong="H1581"\w* y les \w dio|strong="H5414"\w* \w paja|strong="H8401"\w* y \w forraje|strong="H4554"\w*, y luego trajo \w agua|strong="H4325"\w* \w para|strong="H5414"\w* \w que|strong="H4325"\w* el hombre y sus acompañantes se \w lavaran|strong="H7364"\w* los \w pies|strong="H7272"\w*.  
\v 33 Le sirvieron comida, pero él \w dijo|strong="H1696"\w*: “\w No|strong="H3808"\w* comeré \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* haya \w dicho|strong="H1696"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w tengo|strong="H1696"\w* \w que|strong="H3808"\w* decir”.  
\p “\w Hable|strong="H1696"\w* usted” le contestó Labán.   
\p
\v 34 Entonces el hombre dijo: “Soy sirviente de Abraham.  
\v 35 Yahvé ha bendecido \w mucho|strong="H3966"\w* \w a|strong="H3068"\w* \w mi|strong="H1431"\w* amo \w y|strong="H1241"\w* lo ha hecho \w muy|strong="H3966"\w* rico. Le ha \w dado|strong="H5414"\w* \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w*, \w plata|strong="H3701"\w* \w y|strong="H1241"\w* \w oro|strong="H2091"\w*, esclavos \w y|strong="H1241"\w* esclavas, \w camellos|strong="H1581"\w* \w y|strong="H1241"\w* burros.  
\v 36 \w Sara|strong="H8283"\w*, \w la|strong="H3605"\w* esposa \w de|strong="H1121"\w* mi amo, le \w dio|strong="H5414"\w* un \w hijo|strong="H1121"\w* en su vejez, y mi amo le ha dejado \w a|strong="H3068"\w* ese \w hijo|strong="H1121"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1121"\w* tiene.  
\v 37 Además, mi amo me hizo jurar, diciendo: ‘\w No|strong="H3808"\w* buscarás una esposa para mi \w hijo|strong="H1121"\w* \w entre|strong="H3808"\w* las \w hijas|strong="H1323"\w* \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w*, en cuya tierra vivo.  
\v 38 Tienes \w que|strong="H3808"\w* \w ir|strong="H3212"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* mi padre y \w a|strong="H3068"\w* mi propia \w familia|strong="H1004"\w*, y \w de|strong="H1121"\w* allí buscarás una esposa para mi \w hijo|strong="H1121"\w*’.  
\v 39 Yo le pregunté \w a|strong="H3068"\w* mi amo: ‘¿\w Y|strong="H3068"\w* \w si|strong="H3808"\w* la mujer \w no|strong="H3808"\w* quiere \w venir|strong="H3212"\w* conmigo?’  
\v 40 Pero \w él|strong="H1121"\w* me respondió: ‘Yahvé, en cuya \w presencia|strong="H6440"\w* he vivido, \w enviará|strong="H7971"\w* su \w ángel|strong="H4397"\w* \w contigo|strong="H6440"\w* y hará \w que|strong="H1121"\w* tu \w viaje|strong="H1870"\w* sea un éxito. Así podrás traerle \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* una esposa \w de|strong="H6440"\w* mi propia \w familia|strong="H1004"\w*, \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* mi padre.  
\v 41 Sólo quedarás \w libre|strong="H5355"\w* del juramento \w que|strong="H3588"\w* \w me|strong="H3588"\w* \w has|strong="H5414"\w* \w hecho|strong="H1961"\w* \w si|strong="H3588"\w* llegas \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w familia|strong="H4940"\w* \w y|strong="H3588"\w* ellos \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w la|strong="H3588"\w* quieren \w dar|strong="H5414"\w*. \w En|strong="H3588"\w* ese caso, quedarás \w libre|strong="H5355"\w* \w de|strong="H3588"\w* \w mi|strong="H1961"\w* juramento’.  
\v 42 \w Hoy|strong="H3117"\w*, \w cuando|strong="H3117"\w* llegué \w al|strong="H5921"\w* manantial, oré así: ‘Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* amo Abraham, \w te|strong="H5869"\w* \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* corones \w con|strong="H5921"\w* \w el|strong="H5921"\w* éxito \w el|strong="H5921"\w* \w viaje|strong="H1870"\w* \w que|strong="H4994"\w* he emprendido.  
\v 43 \w Aquí|strong="H2009"\w* \w estoy|strong="H1961"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w este|strong="H1961"\w* manantial. \w Si|strong="H2009"\w* una muchacha viene \w a|strong="H3068"\w* sacar \w agua|strong="H4325"\w*, \w yo|strong="H2009"\w* \w le|strong="H5921"\w* diré: “\w Por|strong="H5921"\w* favor, dame \w a|strong="H3068"\w* \w beber|strong="H8248"\w* un \w poco|strong="H4592"\w* \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* tu \w cántaro|strong="H3537"\w*”.  
\v 44 \w Si|strong="H1571"\w* \w ella|strong="H1931"\w* me responde: “Beba usted, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w sacaré|strong="H7579"\w* agua para \w sus|strong="H1931"\w* \w camellos|strong="H1581"\w*”, \w que|strong="H1931"\w* sea \w ella|strong="H1931"\w* \w la|strong="H1931"\w* mujer \w que|strong="H1931"\w* Yahvé ha elegido para \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* mi amo’.  
\v 45 \w Todavía|strong="H2962"\w* \w no|strong="H5921"\w* terminaba \w yo|strong="H2009"\w* \w de|strong="H5921"\w* orar \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w corazón|strong="H3820"\w*, cuando vi \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* \w que|strong="H4994"\w* venía \w con|strong="H5921"\w* su \w cántaro|strong="H3537"\w* \w al|strong="H5921"\w* \w hombro|strong="H7926"\w*. Bajó \w al|strong="H5921"\w* manantial \w y|strong="H5921"\w* \w sacó|strong="H3318"\w* agua. Entonces \w le|strong="H5921"\w* pedí: ‘\w Por|strong="H5921"\w* favor, dame \w de|strong="H5921"\w* \w beber|strong="H8248"\w*’.  
\v 46 \w Ella|strong="H5921"\w* enseguida bajó su \w cántaro|strong="H3537"\w* \w del|strong="H5921"\w* hombro \w y|strong="H1571"\w* \w me|strong="H5921"\w* dijo: ‘Beba usted, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w les|strong="H5921"\w* daré \w de|strong="H5921"\w* \w beber|strong="H8354"\w* \w a|strong="H3068"\w* sus \w camellos|strong="H1581"\w*’. \w Así|strong="H1571"\w* \w que|strong="H5921"\w* yo \w bebí|strong="H8354"\w*, \w y|strong="H1571"\w* \w ella|strong="H5921"\w* \w también|strong="H1571"\w* \w les|strong="H5921"\w* dio agua \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w*.  
\v 47 Luego \w le|strong="H5921"\w* \w pregunté|strong="H7592"\w*: ‘¿\w De|strong="H5921"\w* \w quién|strong="H4310"\w* eres \w hija|strong="H1323"\w*?’ \w Ella|strong="H5921"\w* \w me|strong="H5921"\w* respondió: ‘Soy \w hija|strong="H1323"\w* \w de|strong="H5921"\w* Betuel, \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w que|strong="H4310"\w* \w Milca|strong="H4435"\w* \w le|strong="H5921"\w* \w dio|strong="H7760"\w* \w a|strong="H3068"\w* Nacor’. Entonces \w le|strong="H5921"\w* \w puse|strong="H7760"\w* \w el|strong="H5921"\w* anillo \w en|strong="H5921"\w* \w la|strong="H5921"\w* nariz \w y|strong="H5921"\w* \w las|strong="H5921"\w* pulseras \w en|strong="H5921"\w* \w los|strong="H1121"\w* brazos.  
\v 48 \w Y|strong="H3068"\w* me incliné y adoré \w a|strong="H3068"\w* Yahvé, y \w bendije|strong="H1288"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* mi amo Abraham, \w que|strong="H1121"\w* me había guiado \w por|strong="H1870"\w* \w el|strong="H1121"\w* \w camino|strong="H1870"\w* correcto para llevarle al \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* mi amo la \w hija|strong="H1323"\w* \w de|strong="H1121"\w* su hermano.  
\v 49 \w Ahora|strong="H6258"\w* bien, \w si|strong="H3808"\w* ustedes \w están|strong="H3426"\w* dispuestos \w a|strong="H3068"\w* tratar \w a|strong="H3068"\w* \w mi|strong="H5921"\w* amo \w con|strong="H5921"\w* bondad \w y|strong="H5921"\w* lealtad, díganmelo; \w y|strong="H5921"\w* \w si|strong="H3808"\w* \w no|strong="H3808"\w*, díganmelo también, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w yo|strong="H6213"\w* sepa \w qué|strong="H3808"\w* camino tomar”.   
\p
\v 50 \w Labán|strong="H3837"\w* y Betuel \w respondieron|strong="H6030"\w*: “\w Esto|strong="H1697"\w* viene \w de|strong="H1697"\w* Yahvé; \w no|strong="H3808"\w* \w podemos|strong="H3201"\w* decirle \w a|strong="H3068"\w* usted \w que|strong="H3808"\w* \w sí|strong="H3808"\w* \w ni|strong="H3808"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w*.  
\v 51 \w Aquí|strong="H2009"\w* \w tiene|strong="H1961"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w*; llévesela, y \w que|strong="H1121"\w* \w sea|strong="H1961"\w* la esposa del \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* su amo, tal \w como|strong="H1961"\w* Yahvé lo ha dispuesto”.   
\p
\v 52 Al \w oír|strong="H8085"\w* \w esto|strong="H1697"\w*, el sirviente \w de|strong="H1697"\w* Abraham \w se|strong="H1961"\w* inclinó hasta el suelo \w para|strong="H1961"\w* adorar \w a|strong="H3068"\w* Yahvé.  
\v 53 \w Luego|strong="H3318"\w* \w sacó|strong="H3318"\w* joyas \w de|strong="H5414"\w* \w oro|strong="H2091"\w* y \w de|strong="H5414"\w* \w plata|strong="H3701"\w*, y vestidos, y se los regaló \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w*. \w También|strong="H3318"\w* les \w dio|strong="H5414"\w* valiosos regalos \w a|strong="H3068"\w* su hermano y \w a|strong="H3068"\w* su madre.  
\v 54 Después comieron y \w bebieron|strong="H8354"\w*, \w él|strong="H1931"\w* y \w los|strong="H5973"\w* hombres \w que|strong="H1931"\w* \w lo|strong="H1931"\w* acompañaban, y pasaron \w la|strong="H1931"\w* noche allí. Al \w levantarse|strong="H6965"\w* por \w la|strong="H1931"\w* \w mañana|strong="H1242"\w*, \w el|strong="H1931"\w* sirviente \w les|strong="H5973"\w* dijo: “Déjenme regresar \w a|strong="H3068"\w* \w la|strong="H1931"\w* casa \w de|strong="H5973"\w* mi amo”.   
\p
\v 55 Pero \w el|strong="H3427"\w* hermano y la madre de la muchacha respondieron: “\w Que|strong="H3117"\w* la joven se \w quede|strong="H3427"\w* con nosotros unos diez \w días|strong="H3117"\w* más, y \w después|strong="H3427"\w* se podrá \w ir|strong="H3212"\w*”.   
\p
\v 56 “\w No|strong="H1870"\w* me detengan es contestó él, ya que Yahvé ha coronado con el éxito mi \w viaje|strong="H1870"\w*. Déjenme \w ir|strong="H3212"\w* para que vuelva \w a|strong="H3068"\w* la casa de mi amo”.   
\p
\v 57 “Llamaremos \w a|strong="H3068"\w* la muchacha para ver \w qué|strong="H6310"\w* opina ella” le dijeron.  
\v 58 \w Así|strong="H2088"\w* \w que|strong="H2088"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* y \w le|strong="H5973"\w* preguntaron: “¿Quieres irte \w con|strong="H5973"\w* \w este|strong="H2088"\w* hombre?”  
\p “Sí, \w me|strong="H5973"\w* \w iré|strong="H3212"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*”, respondió ella.   
\p
\v 59 Entonces dejaron \w ir|strong="H7971"\w* \w a|strong="H3068"\w* su hermana \w Rebeca|strong="H7259"\w*, junto con su nodriza, y al sirviente de Abraham y \w a|strong="H3068"\w* sus hombres.  
\v 60 \w Y|strong="H3068"\w* \w bendijeron|strong="H1288"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* con estas palabras: “Hermana nuestra, ¡\w que|strong="H1961"\w* \w seas|strong="H1961"\w* madre de millones! ¡\w Que|strong="H1961"\w* tus descendientes conquisten las \w ciudades|strong="H8179"\w* de sus \w enemigos|strong="H8130"\w*!”   
\p
\v 61 \w Rebeca|strong="H7259"\w* \w y|strong="H5921"\w* sus sirvientas \w se|strong="H5921"\w* prepararon, montaron \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w* \w y|strong="H5921"\w* siguieron \w al|strong="H5921"\w* hombre. Así \w fue|strong="H3212"\w* \w como|strong="H5921"\w* \w el|strong="H5921"\w* sirviente \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* \w y|strong="H5921"\w* emprendió \w el|strong="H5921"\w* camino \w de|strong="H5921"\w* regreso.  
\v 62 Mientras tanto, \w Isaac|strong="H3327"\w* había regresado del pozo del Viviente-que-me-ve, \w pues|strong="H1931"\w* \w vivía|strong="H3427"\w* en \w la|strong="H1931"\w* región del Néguev.  
\v 63 Al atardecer, \w Isaac|strong="H3327"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* meditar al \w campo|strong="H7704"\w*. \w Levantó|strong="H5375"\w* la vista y \w vio|strong="H7200"\w* que se acercaban unos \w camellos|strong="H1581"\w*.  
\v 64 También \w Rebeca|strong="H7259"\w* \w levantó|strong="H5375"\w* \w la|strong="H5921"\w* vista, \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* \w se|strong="H5921"\w* bajó \w del|strong="H5921"\w* \w camello|strong="H1581"\w*  
\v 65 y \w le|strong="H1931"\w* preguntó al sirviente: “¿\w Quién|strong="H4310"\w* \w es|strong="H1931"\w* \w ese|strong="H1931"\w* hombre \w que|strong="H4310"\w* \w viene|strong="H1980"\w* por \w el|strong="H1931"\w* \w campo|strong="H7704"\w* \w a|strong="H3068"\w* nuestro encuentro?”  
\p “\w Es|strong="H1931"\w* mi amo” contestó \w el|strong="H1931"\w* sirviente. Entonces \w ella|strong="H1931"\w* \w tomó|strong="H3947"\w* \w su|strong="H1931"\w* velo y \w se|strong="H1931"\w* \w cubrió|strong="H3680"\w* \w el|strong="H1931"\w* rostro.  
\v 66 \w El|strong="H3605"\w* sirviente le \w contó|strong="H5608"\w* \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w*.  
\v 67 Luego \w Isaac|strong="H3327"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* \w a|strong="H3068"\w* la tienda de su madre \w Sara|strong="H8283"\w*, y la \w tomó|strong="H3947"\w* por esposa. \w Isaac|strong="H3327"\w* la amó mucho, y así \w se|strong="H1961"\w* consoló tras la muerte de su madre.   
\c 25  
\p
\v 1 Abraham \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* casarse. Su nueva esposa se \w llamaba|strong="H8034"\w* Cetura,  
\v 2 la cual le dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Zimrán, \w Jocsán|strong="H3370"\w*, \w Medán|strong="H4091"\w*, \w Madián|strong="H4080"\w*, \w Isbac|strong="H3435"\w* y Súa.  
\v 3 \w Jocsán|strong="H3370"\w* \w fue|strong="H1961"\w* \w el|strong="H1121"\w* padre \w de|strong="H1121"\w* \w Seba|strong="H7614"\w* y \w de|strong="H1121"\w* \w Dedán|strong="H1719"\w*. \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Dedán|strong="H1719"\w* \w fueron|strong="H1961"\w* \w los|strong="H1121"\w* asureos, \w los|strong="H1121"\w* letuseos y \w los|strong="H1121"\w* leumeos.  
\v 4 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Madián|strong="H4080"\w* fueron Efá, Efer, Hanoc, Abida y Eldá. \w Todos|strong="H3605"\w* \w ellos|strong="H3605"\w* fueron descendientes \w de|strong="H1121"\w* Cetura.  
\v 5 Abraham le \w dejó|strong="H5414"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* tenía \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w*,  
\v 6 pero \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w que|strong="H5921"\w* tuvo \w con|strong="H5921"\w* sus \w concubinas|strong="H6370"\w* \w les|strong="H5921"\w* \w dio|strong="H5414"\w* regalos \w mientras|strong="H5750"\w* \w él|strong="H5921"\w* \w aún|strong="H5750"\w* vivía, \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w envió|strong="H7971"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w oriente|strong="H6924"\w*, lejos \w de|strong="H5921"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*.  
\v 7 Abraham \w vivió|strong="H3117"\w* en total \w ciento|strong="H3967"\w* \w setenta|strong="H7657"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w*.  
\v 8 \w Murió|strong="H4191"\w* \w a|strong="H3068"\w* una edad muy avanzada, \w anciano|strong="H2205"\w* y satisfecho \w de|strong="H5971"\w* la vida, y fue \w a|strong="H3068"\w* reunirse con sus antepasados.  
\v 9 Sus \w hijos|strong="H1121"\w* \w Isaac|strong="H3327"\w* \w e|strong="H3068"\w* \w Ismael|strong="H3458"\w* \w lo|strong="H5921"\w* \w sepultaron|strong="H6912"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cueva|strong="H4631"\w* \w de|strong="H5921"\w* Macpela, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* \w de|strong="H5921"\w* Efrón, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Zojar \w el|strong="H5921"\w* hitita, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w al|strong="H5921"\w* oriente \w de|strong="H5921"\w* \w Mamre|strong="H4471"\w*.  
\v 10 Éste \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w campo|strong="H7704"\w* \w que|strong="H1121"\w* Abraham les había \w comprado|strong="H7069"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* hititas. \w Allí|strong="H8033"\w* fue \w sepultado|strong="H6912"\w* Abraham, junto \w a|strong="H3068"\w* su esposa \w Sara|strong="H8283"\w*.  
\v 11 \w Después|strong="H3427"\w* \w de|strong="H5973"\w* la \w muerte|strong="H4194"\w* \w de|strong="H5973"\w* Abraham, Dios \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Isaac|strong="H3327"\w*, quien \w se|strong="H1961"\w* estableció \w cerca|strong="H5973"\w* \w de|strong="H5973"\w* Beer Lahai Roi.   
\p
\v 12 Ésta es la historia \w de|strong="H1121"\w* \w Ismael|strong="H3458"\w*, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w que|strong="H1121"\w* Abraham tuvo con \w Agar|strong="H1904"\w* la \w egipcia|strong="H4713"\w*, la esclava \w de|strong="H1121"\w* \w Sara|strong="H8283"\w*.  
\v 13 Éstos son \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Ismael|strong="H3458"\w*, en orden \w de|strong="H1121"\w* nacimiento: \w el|strong="H1121"\w* \w primogénito|strong="H1060"\w* fue Nebaiot; luego nacieron \w Cedar|strong="H6938"\w*, Adbeel, \w Mibsam|strong="H4017"\w*,  
\v 14 \w Mismá|strong="H4927"\w*, \w Dumá|strong="H1746"\w*, Masá,  
\v 15 \w Hadad|strong="H2301"\w*, Temá, \w Jetur|strong="H3195"\w*, Nafis y Cedema.  
\v 16 \w Éstos|strong="H1992"\w* fueron \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Ismael|strong="H3458"\w*, y \w éstos|strong="H1992"\w* son \w los|strong="H1992"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w sus|strong="H1992"\w* poblados y \w campamentos|strong="H2918"\w*. Fueron \w los|strong="H1992"\w* \w doce|strong="H8147"\w* jefes \w de|strong="H1121"\w* \w sus|strong="H1992"\w* respectivas tribus.  
\v 17 \w Ismael|strong="H3458"\w* vivió \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* y \w siete|strong="H7651"\w* \w años|strong="H8141"\w*. Luego exhaló el último suspiro, \w murió|strong="H4191"\w* y fue \w a|strong="H3068"\w* reunirse con sus antepasados.  
\v 18 Sus descendientes habitaron \w en|strong="H5921"\w* \w la|strong="H5921"\w* región \w que|strong="H5921"\w* \w va|strong="H3068"\w* \w desde|strong="H5704"\w* Javilá \w hasta|strong="H5704"\w* \w Shur|strong="H7793"\w*, \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w en|strong="H5921"\w* dirección \w a|strong="H3068"\w* Asiria. Ismael vivió \w en|strong="H5921"\w* conflicto \w con|strong="H5921"\w* \w todos|strong="H3605"\w* sus parientes.   
\p
\v 19 Ésta es la historia \w de|strong="H1121"\w* \w Isaac|strong="H3327"\w*, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abraham.  
\v 20 \w Isaac|strong="H3327"\w* \w tenía|strong="H1961"\w* cuarenta \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* \w se|strong="H1961"\w* \w casó|strong="H3947"\w* con \w Rebeca|strong="H7259"\w*, \w que|strong="H1121"\w* \w era|strong="H1961"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Betuel y hermana \w de|strong="H1121"\w* \w Labán|strong="H3837"\w*, \w los|strong="H1121"\w* arameos \w de|strong="H1121"\w* Padán Aram.  
\v 21 \w Isaac|strong="H3327"\w* oró \w a|strong="H3068"\w* Yahvé \w en|strong="H3588"\w* favor \w de|strong="H3588"\w* \w su|strong="H1931"\w* esposa, \w porque|strong="H3588"\w* \w ella|strong="H1931"\w* \w no|strong="H3588"\w* podía tener hijos. Yahvé escuchó \w su|strong="H1931"\w* oración, \w y|strong="H3588"\w* \w Rebeca|strong="H7259"\w* quedó \w embarazada|strong="H2029"\w*.  
\v 22 Pero \w como|strong="H4100"\w* \w los|strong="H1121"\w* niños luchaban \w dentro|strong="H7130"\w* \w de|strong="H1121"\w* su vientre, ella exclamó: “Si \w esto|strong="H2088"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* ser \w así|strong="H3651"\w*, ¿para \w qué|strong="H4100"\w* sigo viva?” \w Entonces|strong="H3651"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé,  
\v 23 y Yahvé le contestó:  
\q1 “En tu vientre hay \w dos|strong="H8147"\w* \w naciones|strong="H1471"\w*,  
\q2 de tus \w entrañas|strong="H4578"\w* saldrán \w dos|strong="H8147"\w* \w pueblos|strong="H3816"\w* divididos.  
\q1 Uno de los \w pueblos|strong="H3816"\w* será \w más|strong="H7227"\w* fuerte que el otro,  
\q2 y el \w mayor|strong="H7227"\w* \w servirá|strong="H5647"\w* al \w menor|strong="H6810"\w*”.   
\p
\v 24 \w Cuando|strong="H3117"\w* llegó el momento de dar \w a|strong="H3068"\w* luz, resultó \w que|strong="H3117"\w* llevaba gemelos en el vientre.  
\v 25 \w El|strong="H3605"\w* \w primero|strong="H7223"\w* \w en|strong="H3318"\w* nacer era pelirrojo, y tenía \w el|strong="H3605"\w* cuerpo tan cubierto de vello \w que|strong="H3605"\w* parecía un abrigo de pieles; por eso le pusieron por \w nombre|strong="H8034"\w* \w Esaú|strong="H6215"\w*.  
\v 26 \w Luego|strong="H3318"\w* \w nació|strong="H3205"\w* su hermano, agarrado del talón \w de|strong="H1121"\w* \w Esaú|strong="H6215"\w* con una \w mano|strong="H3027"\w*; \w por|strong="H3027"\w* \w eso|strong="H3651"\w* le pusieron \w por|strong="H3027"\w* \w nombre|strong="H8034"\w* \w Jacob|strong="H3290"\w*. \w Isaac|strong="H3327"\w* tenía \w sesenta|strong="H8346"\w* \w años|strong="H8141"\w* cuando \w nacieron|strong="H3205"\w*.   
\p
\v 27 \w Los|strong="H3427"\w* \w niños|strong="H5288"\w* crecieron. \w Esaú|strong="H6215"\w* \w se|strong="H3045"\w* convirtió en un hábil \w cazador|strong="H6718"\w*, un hombre de \w campo|strong="H7704"\w*, mientras \w que|strong="H3045"\w* \w Jacob|strong="H3290"\w* \w era|strong="H1961"\w* un hombre tranquilo \w que|strong="H3045"\w* prefería quedarse en las tiendas.  
\v 28 \w Isaac|strong="H3327"\w* prefería \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w* \w porque|strong="H3588"\w* le gustaba comer \w de|strong="H3588"\w* lo \w que|strong="H3588"\w* \w él|strong="H3588"\w* cazaba, \w pero|strong="H3588"\w* \w Rebeca|strong="H7259"\w* prefería \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*.  
\v 29 Un día, \w Jacob|strong="H3290"\w* estaba preparando un guiso. \w En|strong="H4480"\w* \w eso|strong="H1931"\w* llegó \w Esaú|strong="H6215"\w* \w del|strong="H4480"\w* \w campo|strong="H7704"\w*, agotado \w por|strong="H4480"\w* \w el|strong="H1931"\w* hambre,  
\v 30 \w y|strong="H3588"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*: “\w Por|strong="H5921"\w* favor, dame un poco \w de|strong="H4480"\w* \w ese|strong="H2088"\w* guiso rojo, \w porque|strong="H3588"\w* \w me|strong="H4480"\w* muero \w de|strong="H4480"\w* hambre”. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w* \w también|strong="H3651"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* conoció \w como|strong="H3588"\w* Edom.\f + \fr 25:30 \ft “Edom” significa “rojo”.\f*   
\p
\v 31 \w Jacob|strong="H3290"\w* le respondió: “Primero \w véndeme|strong="H4376"\w* tus derechos de primogenitura”.   
\p
\v 32 \w Esaú|strong="H6215"\w* dijo: “Me estoy \w muriendo|strong="H4191"\w* de hambre, ¿de \w qué|strong="H4100"\w* me sirven \w a|strong="H3068"\w* \w mí|strong="H2009"\w* los derechos de primogenitura?”   
\p
\v 33 \w Jacob|strong="H3290"\w* insistió: “\w Júramelo|strong="H7650"\w* \w ahora|strong="H3117"\w* mismo”. Esaú se lo \w juró|strong="H7650"\w*, y de esa manera le \w vendió|strong="H4376"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* sus derechos de primogenitura.  
\v 34 Luego \w Jacob|strong="H3290"\w* le \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w* \w pan|strong="H3899"\w* y guiso \w de|strong="H5414"\w* \w lentejas|strong="H5742"\w*. \w Esaú|strong="H6215"\w* comió y \w bebió|strong="H8354"\w*, luego se \w levantó|strong="H6965"\w* y se \w fue|strong="H3212"\w*. Así \w de|strong="H5414"\w* poco le importaron \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w* sus derechos \w de|strong="H5414"\w* hijo mayor.   
\c 26  
\p
\v 1 \w Hubo|strong="H1961"\w* otra época de \w hambre|strong="H7458"\w* \w en|strong="H3212"\w* la región, además de la \w primera|strong="H7223"\w* \w que|strong="H3117"\w* \w hubo|strong="H1961"\w* \w en|strong="H3212"\w* \w tiempos|strong="H3117"\w* de Abraham. \w Por|strong="H4428"\w* eso, \w Isaac|strong="H3327"\w* \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* \w Gerar|strong="H1642"\w*, donde \w estaba|strong="H1961"\w* Abimelec, \w rey|strong="H4428"\w* de \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w*.  
\v 2 Allí Yahvé se le \w apareció|strong="H7200"\w* y le dijo: “No bajes \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*. Quédate \w a|strong="H3068"\w* vivir en la tierra que yo te indicaré.  
\v 3 Quédate \w a|strong="H3068"\w* vivir \w en|strong="H5973"\w* \w esta|strong="H2063"\w* tierra, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* estaré \w contigo|strong="H5973"\w* \w y|strong="H3588"\w* \w te|strong="H3588"\w* \w bendeciré|strong="H1288"\w*. \w A|strong="H3068"\w* \w ti|strong="H5973"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w les|strong="H5973"\w* \w daré|strong="H5414"\w* \w todas|strong="H3605"\w* \w estas|strong="H2063"\w* tierras, \w y|strong="H3588"\w* \w así|strong="H2063"\w* cumpliré \w el|strong="H5973"\w* \w juramento|strong="H7621"\w* \w que|strong="H3588"\w* \w le|strong="H5973"\w* \w hice|strong="H7650"\w* \w a|strong="H3068"\w* tu padre Abraham.  
\v 4 \w Multiplicaré|strong="H7235"\w* tu \w descendencia|strong="H2233"\w* como las \w estrellas|strong="H3556"\w* del \w cielo|strong="H8064"\w*, y le \w daré|strong="H5414"\w* \w todas|strong="H3605"\w* estas tierras. \w Por|strong="H5414"\w* medio \w de|strong="H5414"\w* tu \w descendencia|strong="H2233"\w* serán bendecidas \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w de|strong="H5414"\w* \w la|strong="H3605"\w* tierra,  
\v 5 \w porque|strong="H6118"\w* Abraham me \w obedeció|strong="H8085"\w* y cumplió mis preceptos, mis \w mandamientos|strong="H4687"\w*, mis normas y mis \w leyes|strong="H8451"\w*”.   
\p
\v 6 Así que \w Isaac|strong="H3327"\w* se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir en \w Gerar|strong="H1642"\w*.  
\v 7 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* hombres \w del|strong="H5921"\w* \w lugar|strong="H4725"\w* \w le|strong="H1931"\w* \w preguntaban|strong="H7592"\w* \w por|strong="H5921"\w* \w su|strong="H1931"\w* esposa, \w él|strong="H1931"\w* respondía: “\w Es|strong="H1931"\w* \w mi|strong="H5921"\w* hermana”. \w Tenía|strong="H1931"\w* \w miedo|strong="H3372"\w* \w de|strong="H5921"\w* decir \w que|strong="H3588"\w* \w era|strong="H1931"\w* \w su|strong="H1931"\w* esposa, \w pues|strong="H3588"\w* pensaba: “\w Los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w este|strong="H1931"\w* \w lugar|strong="H4725"\w* \w me|strong="H5921"\w* \w matarán|strong="H2026"\w* \w por|strong="H5921"\w* causa \w de|strong="H5921"\w* \w Rebeca|strong="H7259"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* muy \w hermosa|strong="H2896"\w*”.  
\v 8 \w Isaac|strong="H3327"\w* ya \w llevaba|strong="H1961"\w* mucho \w tiempo|strong="H3117"\w* \w allí|strong="H8033"\w* \w cuando|strong="H3588"\w* Abimelec, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w*, \w se|strong="H1961"\w* asomó \w a|strong="H3068"\w* una ventana \w y|strong="H3588"\w* lo \w vio|strong="H7200"\w* acariciando \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposa \w Rebeca|strong="H7259"\w*.  
\v 9 Abimelec mandó \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijo: “¡\w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* tu esposa! ¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* dijiste \w que|strong="H3588"\w* \w era|strong="H1931"\w* tu hermana?” \w Isaac|strong="H3327"\w* \w le|strong="H1931"\w* respondió: “\w Porque|strong="H3588"\w* pensé \w que|strong="H3588"\w* \w me|strong="H5921"\w* matarían \w por|strong="H5921"\w* \w su|strong="H1931"\w* culpa”.   
\p
\v 10 Abimelec \w le|strong="H5921"\w* reclamó: “¿\w Qué|strong="H4100"\w* \w es|strong="H2063"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w nos|strong="H5921"\w* has \w hecho|strong="H6213"\w*? Cualquiera \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w* podría haberse \w acostado|strong="H7901"\w* \w con|strong="H5921"\w* \w tu|strong="H6213"\w* esposa, ¡\w y|strong="H5921"\w* \w tú|strong="H6213"\w* \w nos|strong="H5921"\w* habrías \w hecho|strong="H6213"\w* culpables \w de|strong="H5921"\w* un gran pecado!”   
\p
\v 11 Entonces Abimelec le dio \w esta|strong="H2088"\w* \w orden|strong="H6680"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*: “\w Cualquiera|strong="H3605"\w* \w que|strong="H5971"\w* toque \w a|strong="H3068"\w* \w este|strong="H2088"\w* hombre \w o|strong="H3068"\w* \w a|strong="H3068"\w* su esposa, será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*”.   
\p
\v 12 \w Isaac|strong="H3327"\w* sembró en \w aquella|strong="H1931"\w* región, y \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w año|strong="H8141"\w* cosechó \w cien|strong="H3967"\w* veces \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w había|strong="H4672"\w* \w sembrado|strong="H2232"\w*, porque Yahvé \w lo|strong="H1931"\w* \w bendijo|strong="H1288"\w*.  
\v 13 \w Su|strong="H3588"\w* riqueza \w fue|strong="H3212"\w* aumentando, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* ser un hombre \w muy|strong="H3966"\w* rico \w y|strong="H3588"\w* \w poderoso|strong="H1431"\w*.  
\v 14 Llegó \w a|strong="H3068"\w* \w tener|strong="H1961"\w* tantas \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w*, \w y|strong="H1241"\w* tantos sirvientes, \w que|strong="H1961"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* le \w tuvieron|strong="H1961"\w* \w envidia|strong="H7065"\w*.  
\v 15 Por eso, taparon con \w tierra|strong="H6083"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* pozos \w que|strong="H3117"\w* \w los|strong="H3605"\w* sirvientes de su padre habían cavado en \w tiempos|strong="H3117"\w* de Abraham.  
\v 16 Incluso Abimelec \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w*: “\w Vete|strong="H3212"\w* \w de|strong="H4480"\w* aquí, \w porque|strong="H3588"\w* \w te|strong="H4480"\w* has vuelto \w mucho|strong="H3966"\w* \w más|strong="H3588"\w* poderoso \w que|strong="H3588"\w* \w nosotros|strong="H5973"\w*”.   
\p
\v 17 Así que \w Isaac|strong="H3327"\w* se \w fue|strong="H3212"\w* de \w allí|strong="H8033"\w*, acampó \w en|strong="H3212"\w* \w el|strong="H3427"\w* valle de \w Gerar|strong="H1642"\w* y se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w en|strong="H3212"\w* ese lugar.   
\p
\v 18 \w Isaac|strong="H3327"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* abrir los pozos \w de|strong="H4325"\w* \w agua|strong="H4325"\w* \w que|strong="H3117"\w* habían sido cavados en \w tiempos|strong="H3117"\w* \w de|strong="H4325"\w* su padre Abraham, y \w que|strong="H3117"\w* los \w filisteos|strong="H6430"\w* habían tapado después \w de|strong="H4325"\w* su \w muerte|strong="H4194"\w*. \w A|strong="H3068"\w* estos pozos les puso los mismos \w nombres|strong="H8034"\w* \w que|strong="H3117"\w* su padre les había dado.  
\v 19 Un día, los sirvientes \w de|strong="H4325"\w* \w Isaac|strong="H3327"\w* \w estaban|strong="H4325"\w* cavando en el valle y encontraron un pozo \w de|strong="H4325"\w* \w agua|strong="H4325"\w* fresca.\f + \fr 26:19 \ft O, agua viva.\f*  
\v 20 \w Pero|strong="H3588"\w* \w los|strong="H5973"\w* pastores \w de|strong="H3588"\w* \w Gerar|strong="H1642"\w* se pelearon \w con|strong="H5973"\w* \w los|strong="H5973"\w* pastores \w de|strong="H3588"\w* \w Isaac|strong="H3327"\w*, reclamando: “¡Esta \w agua|strong="H4325"\w* \w es|strong="H3588"\w* nuestra!” \w Por|strong="H3588"\w* eso \w Isaac|strong="H3327"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* ese pozo \w Esek|strong="H6230"\w*,\f + \fr 26:20 \ft “Esek” significa “contención” o “disputa”.\f* \w porque|strong="H3588"\w* se habían peleado \w con|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 21 Luego \w cavaron|strong="H2658"\w* otro pozo, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w se|strong="H5921"\w* pelearon \w por|strong="H5921"\w* \w él|strong="H5921"\w*; \w así|strong="H1571"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* \w llamó|strong="H7121"\w* Sitná.\f + \fr 26:21 \ft “Sitná” significa “hostilidad”.\f*  
\v 22 \w Se|strong="H5921"\w* alejó \w de|strong="H5921"\w* \w allí|strong="H8033"\w* \w y|strong="H3588"\w* cavó otro pozo, \w y|strong="H3588"\w* \w por|strong="H5921"\w* ese \w no|strong="H3808"\w* \w se|strong="H5921"\w* pelearon. \w A|strong="H3068"\w* ese \w lo|strong="H3808"\w* \w llamó|strong="H7121"\w* Rejobot,\f + \fr 26:22 \ft “Rejobot” significa “lugares amplios”.\f* \w pues|strong="H3588"\w* dijo: “\w Ahora|strong="H6258"\w* Yahvé \w nos|strong="H5921"\w* \w ha|strong="H3808"\w* dado espacio, \w y|strong="H3588"\w* prosperaremos \w en|strong="H5921"\w* \w esta|strong="H5921"\w* tierra”.   
\p
\v 23 De \w allí|strong="H8033"\w*, Isaac \w subió|strong="H5927"\w* \w a|strong="H3068"\w* Beerseba.  
\v 24 \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* Yahvé \w se|strong="H1931"\w* \w le|strong="H1931"\w* \w apareció|strong="H7200"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijo: “\w Yo|strong="H3588"\w* \w soy|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* tu padre Abraham. \w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy contigo. \w Por|strong="H3588"\w* amor \w a|strong="H3068"\w* mi \w siervo|strong="H5650"\w* Abraham, \w te|strong="H3588"\w* \w bendeciré|strong="H1288"\w* \w y|strong="H3588"\w* \w multiplicaré|strong="H7235"\w* tu \w descendencia|strong="H2233"\w*”.   
\p
\v 25 \w Isaac|strong="H3327"\w* construyó \w allí|strong="H8033"\w* un \w altar|strong="H4196"\w* \w e|strong="H3068"\w* invocó el \w nombre|strong="H8034"\w* de Yahvé. \w Allí|strong="H8033"\w* armó su campamento, y sus sirvientes \w cavaron|strong="H3738"\w* un pozo.   
\p
\v 26 Abimelec \w fue|strong="H1980"\w* \w a|strong="H3068"\w* visitarlo desde \w Gerar|strong="H1642"\w*, acompañado por su \w amigo|strong="H4828"\w* Ajuzat y por Ficol, el \w jefe|strong="H8269"\w* \w de|strong="H8269"\w* su \w ejército|strong="H6635"\w*.  
\v 27 \w Isaac|strong="H3327"\w* les preguntó: “¿\w A|strong="H3068"\w* qué vienen, si ustedes me odian y me echaron de su tierra?”   
\p
\v 28 Ellos \w le|strong="H5973"\w* respondieron: “Hemos \w visto|strong="H7200"\w* claramente \w que|strong="H3588"\w* Yahvé \w está|strong="H1961"\w* \w contigo|strong="H5973"\w*. \w Por|strong="H3588"\w* eso pensamos \w que|strong="H3588"\w* debería \w haber|strong="H1961"\w* un acuerdo bajo juramento \w entre|strong="H5973"\w* \w nosotros|strong="H5973"\w* \w y|strong="H3588"\w* tú. Queremos \w hacer|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w contigo|strong="H5973"\w*:  
\v 29 júranos \w que|strong="H3808"\w* \w no|strong="H3808"\w* nos \w harás|strong="H6213"\w* \w ningún|strong="H3808"\w* daño, \w así|strong="H6258"\w* \w como|strong="H5973"\w* \w nosotros|strong="H5973"\w* \w no|strong="H3808"\w* \w te|strong="H5973"\w* hemos tocado, \w sino|strong="H7535"\w* \w que|strong="H3808"\w* \w te|strong="H5973"\w* hemos tratado \w bien|strong="H2896"\w* y \w te|strong="H5973"\w* dejamos \w ir|strong="H7971"\w* \w en|strong="H5973"\w* \w paz|strong="H7965"\w*. ¡\w Tú|strong="H6213"\w* eres \w el|strong="H5973"\w* \w bendito|strong="H1288"\w* \w de|strong="H5973"\w* Yahvé!”   
\p
\v 30 Isaac les preparó un \w banquete|strong="H4960"\w*, y comieron y \w bebieron|strong="H8354"\w*.  
\v 31 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente se levantaron temprano y se hicieron un juramento mutuo. Luego \w Isaac|strong="H3327"\w* los \w despidió|strong="H7971"\w*, y ellos se \w fueron|strong="H3212"\w* \w en|strong="H3212"\w* \w paz|strong="H7965"\w*.  
\v 32 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* llegaron \w los|strong="H5921"\w* sirvientes \w de|strong="H5921"\w* \w Isaac|strong="H3327"\w* \w y|strong="H5921"\w* \w le|strong="H1931"\w* informaron \w acerca|strong="H5921"\w* \w del|strong="H5921"\w* pozo \w que|strong="H1931"\w* \w habían|strong="H1961"\w* \w estado|strong="H1961"\w* cavando. “¡Encontramos \w agua|strong="H4325"\w*!”, \w le|strong="H1931"\w* dijeron.  
\v 33 Isaac \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H2088"\w* pozo Sibá.\f + \fr 26:33 \ft Sibá significa “juramento” o “siete”.\f* \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*, \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w se|strong="H5921"\w* \w llama|strong="H7121"\w* Beerseba.\f + \fr 26:33 \ft Beerseba significa “pozo del juramento” o “pozo de los siete”.\f*   
\p
\v 34 \w Cuando|strong="H1961"\w* \w Esaú|strong="H6215"\w* \w tenía|strong="H1961"\w* cuarenta \w años|strong="H8141"\w*, \w se|strong="H1961"\w* \w casó|strong="H3947"\w* con Judit, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Beerí \w el|strong="H1121"\w* hitita, y con Basemat, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Elón \w el|strong="H1121"\w* hitita.  
\v 35 Estas dos mujeres les causaron mucha amargura \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* y \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w*.   
\c 27  
\p
\v 1 \w Cuando|strong="H3588"\w* \w Isaac|strong="H3327"\w* \w envejeció|strong="H2204"\w* \w y|strong="H3588"\w* perdió \w la|strong="H3588"\w* vista, \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w*, \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* \w mayor|strong="H1419"\w*, \w y|strong="H3588"\w* \w le|strong="H5869"\w* dijo: “¡\w Hijo|strong="H1121"\w* mío!”  
\p —“\w Aquí|strong="H2009"\w* \w estoy|strong="H1961"\w*” —respondió \w él|strong="H3588"\w*.   
\p
\v 2 \w Entonces|strong="H3117"\w* Isaac le dijo: “\w Mira|strong="H2009"\w*, \w ya|strong="H4994"\w* soy \w viejo|strong="H2204"\w* y \w no|strong="H3808"\w* \w sé|strong="H3045"\w* \w qué|strong="H3808"\w* \w día|strong="H3117"\w* voy \w a|strong="H3068"\w* morir.  
\v 3 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w toma|strong="H5375"\w* tus \w armas|strong="H3627"\w*, tu \w arco|strong="H7198"\w* y tus flechas, \w sal|strong="H3318"\w* al \w campo|strong="H7704"\w* y cázame algún animal.  
\v 4 Prepárame un guiso sabroso, como \w a|strong="H3068"\w* \w mí|strong="H5315"\w* me gusta, y tráemelo para que coma. Así \w te|strong="H5315"\w* \w daré|strong="H1288"\w* \w mi|strong="H5315"\w* \w bendición|strong="H1288"\w* \w antes|strong="H2962"\w* de \w morir|strong="H4191"\w*”.   
\p
\v 5 \w Rebeca|strong="H7259"\w* estaba \w escuchando|strong="H8085"\w* mientras \w Isaac|strong="H3327"\w* \w hablaba|strong="H1696"\w* con su \w hijo|strong="H1121"\w* \w Esaú|strong="H6215"\w*. \w Así|strong="H1696"\w* \w que|strong="H1121"\w*, cuando \w Esaú|strong="H6215"\w* se \w fue|strong="H3212"\w* al \w campo|strong="H7704"\w* \w a|strong="H3068"\w* cazar \w el|strong="H1121"\w* animal para su padre,  
\v 6 \w Rebeca|strong="H7259"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Jacob|strong="H3290"\w*: “Acabo \w de|strong="H1121"\w* \w escuchar|strong="H8085"\w* \w a|strong="H3068"\w* tu padre \w hablar|strong="H1696"\w* con tu hermano \w Esaú|strong="H6215"\w*. Le \w estaba|strong="H2009"\w* \w diciendo|strong="H1696"\w*:  
\v 7 ‘Cázame un animal y prepárame un guiso sabroso, para que \w yo|strong="H6213"\w* coma y te \w bendiga|strong="H1288"\w* en \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w antes|strong="H6440"\w* \w de|strong="H6440"\w* morir’.  
\v 8 \w Ahora|strong="H6258"\w* bien, \w hijo|strong="H1121"\w* mío, \w escúchame|strong="H8085"\w* y haz exactamente lo \w que|strong="H6258"\w* te \w ordeno|strong="H6680"\w*:  
\v 9 \w ve|strong="H3212"\w* al \w rebaño|strong="H6629"\w* y tráeme \w dos|strong="H8147"\w* de los \w mejores|strong="H2896"\w* \w cabritos|strong="H1423"\w*. \w Yo|strong="H4994"\w* prepararé con ellos un guiso sabroso para \w tu|strong="H6213"\w* padre, tal como \w a|strong="H3068"\w* \w él|strong="H6213"\w* le gusta.  
\v 10 Luego se lo llevarás \w a|strong="H3068"\w* tu padre para que coma, y así él te dará su \w bendición|strong="H1288"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* morir”.   
\p
\v 11 Pero \w Jacob|strong="H3290"\w* le dijo \w a|strong="H3068"\w* su madre \w Rebeca|strong="H7259"\w*: “\w Mira|strong="H2005"\w* que mi hermano \w Esaú|strong="H6215"\w* es un hombre muy velludo, y yo no.  
\v 12 ¿\w Qué|strong="H3808"\w* pasa \w si|strong="H3808"\w* \w mi|strong="H5921"\w* padre \w me|strong="H5921"\w* toca? \w Se|strong="H1961"\w* dará cuenta \w de|strong="H5921"\w* \w que|strong="H3808"\w* \w lo|strong="H5921"\w* \w estoy|strong="H1961"\w* engañando, \w y|strong="H5921"\w* \w en|strong="H5921"\w* lugar \w de|strong="H5921"\w* \w bendición|strong="H1293"\w*, atraeré \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* una \w maldición|strong="H7045"\w*”.   
\p
\v 13 Su madre \w le|strong="H5921"\w* respondió: “¡\w Que|strong="H5921"\w* esa \w maldición|strong="H7045"\w* caiga \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*, \w hijo|strong="H1121"\w* \w mío|strong="H5921"\w*! Tú sólo hazme \w caso|strong="H3947"\w*, \w y|strong="H5921"\w* \w ve|strong="H3212"\w* \w a|strong="H3068"\w* traerme \w los|strong="H1121"\w* cabritos”.   
\p
\v 14 Entonces Jacob \w fue|strong="H3212"\w* \w a|strong="H3068"\w* buscarlos y se los \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* su madre, y ella preparó un guiso sabroso, tal como le gustaba \w a|strong="H3068"\w* su padre.  
\v 15 Luego \w Rebeca|strong="H7259"\w* sacó la mejor ropa \w de|strong="H1121"\w* su \w hijo|strong="H1121"\w* \w mayor|strong="H1419"\w* \w Esaú|strong="H6215"\w*, la cual tenía guardada en \w casa|strong="H1004"\w*, y con ella \w vistió|strong="H3847"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w menor|strong="H6996"\w* \w Jacob|strong="H3290"\w*.  
\v 16 \w Con|strong="H5921"\w* \w las|strong="H5921"\w* pieles \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w cabritos|strong="H1423"\w* \w le|strong="H5921"\w* cubrió \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w parte|strong="H2513"\w* sin vello \w del|strong="H5921"\w* \w cuello|strong="H6677"\w*.  
\v 17 Finalmente, le \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* \w el|strong="H1121"\w* guiso sabroso y \w el|strong="H1121"\w* \w pan|strong="H3899"\w* \w que|strong="H1121"\w* \w había|strong="H6213"\w* preparado.   
\p
\v 18 Jacob se acercó \w a|strong="H3068"\w* su padre y \w le|strong="H4310"\w* dijo: “¡Padre mío!”  
\p “\w Aquí|strong="H2009"\w* estoy respondió Isaac. ¿\w Quién|strong="H4310"\w* eres, \w hijo|strong="H1121"\w* mío?”   
\p
\v 19 \w Jacob|strong="H3290"\w* le contestó: “Soy \w Esaú|strong="H6215"\w*, \w tu|strong="H6213"\w* hijo mayor. \w Ya|strong="H3068"\w* \w hice|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H4994"\w* me pediste. \w Por|strong="H5668"\w* favor, \w siéntate|strong="H3427"\w* y come de \w lo|strong="H6213"\w* \w que|strong="H4994"\w* he cazado, para \w que|strong="H4994"\w* puedas darme \w tu|strong="H6213"\w* \w bendición|strong="H1288"\w*”.   
\p
\v 20 \w Isaac|strong="H3327"\w* le preguntó \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*: “¿\w Cómo|strong="H4100"\w* \w es|strong="H2088"\w* \w que|strong="H3588"\w* \w lo|strong="H4100"\w* encontraste tan rápido, \w hijo|strong="H1121"\w* mío?” “\w Porque|strong="H3588"\w* Yahvé tu \w Dios|strong="H3068"\w* \w me|strong="H3588"\w* ayudó \w a|strong="H3068"\w* encontrarlo”, respondió \w él|strong="H3588"\w*.   
\p
\v 21 Entonces \w Isaac|strong="H3327"\w* le dijo \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*: “\w Acércate|strong="H5066"\w*, \w hijo|strong="H1121"\w* mío, para \w que|strong="H3808"\w* pueda tocarte y saber \w si|strong="H3808"\w* realmente eres \w mi|strong="H4994"\w* \w hijo|strong="H1121"\w* \w Esaú|strong="H6215"\w* \w o|strong="H3068"\w* \w no|strong="H3808"\w*”.   
\p
\v 22 \w Jacob|strong="H3290"\w* se \w acercó|strong="H5066"\w* \w a|strong="H3068"\w* su padre \w Isaac|strong="H3327"\w*. Al tocarlo, \w Isaac|strong="H3327"\w* dijo: “La \w voz|strong="H6963"\w* \w es|strong="H3027"\w* la de \w Jacob|strong="H3290"\w*, pero las \w manos|strong="H3027"\w* son las de \w Esaú|strong="H6215"\w*”.  
\v 23 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* reconoció, \w porque|strong="H3588"\w* sus \w manos|strong="H3027"\w* \w estaban|strong="H1961"\w* velludas \w como|strong="H3588"\w* las \w de|strong="H3588"\w* \w su|strong="H3588"\w* hermano \w Esaú|strong="H6215"\w*, \w y|strong="H3588"\w* \w lo|strong="H3808"\w* \w bendijo|strong="H1288"\w*.  
\v 24 Sin embargo, volvió \w a|strong="H3068"\w* preguntarle: “¿\w De|strong="H1121"\w* verdad eres mi \w hijo|strong="H1121"\w* \w Esaú|strong="H6215"\w*?”  
\p “Sí, \w lo|strong="H2088"\w* soy” respondió Jacob.   
\p
\v 25 Entonces Isaac le dijo: “Sírveme, \w para|strong="H4616"\w* \w que|strong="H1121"\w* coma \w de|strong="H1121"\w* la \w caza|strong="H6718"\w* \w de|strong="H1121"\w* \w mi|strong="H5315"\w* \w hijo|strong="H1121"\w* y \w te|strong="H5315"\w* \w dé|strong="H1121"\w* \w mi|strong="H5315"\w* \w bendición|strong="H1288"\w*”. Jacob le sirvió, \w e|strong="H3068"\w* Isaac comió; también le trajo \w vino|strong="H3196"\w*, y \w él|strong="H1121"\w* \w bebió|strong="H8354"\w*.  
\v 26 \w Luego|strong="H4994"\w* su padre \w Isaac|strong="H3327"\w* le dijo: “\w Acércate|strong="H5066"\w* y bésame, \w hijo|strong="H1121"\w* mío”.  
\v 27 Jacob se \w acercó|strong="H5066"\w* y lo \w besó|strong="H5401"\w*. Cuando Isaac sintió \w el|strong="H1121"\w* \w olor|strong="H7381"\w* \w de|strong="H1121"\w* su ropa, lo \w bendijo|strong="H1288"\w* con estas palabras:  
\q1 “Miren, \w el|strong="H1121"\w* \w olor|strong="H7381"\w* \w de|strong="H1121"\w* mi \w hijo|strong="H1121"\w*  
\q2 es como \w el|strong="H1121"\w* \w olor|strong="H7381"\w* \w de|strong="H1121"\w* un \w campo|strong="H7704"\w* bendecido por Yahvé.   
\q1
\v 28 ¡Que Dios te conceda el \w rocío|strong="H2919"\w* del \w cielo|strong="H8064"\w*,  
\q2 la riqueza \w de|strong="H5414"\w* la tierra,  
\q2 y \w abundancia|strong="H7230"\w* \w de|strong="H5414"\w* \w trigo|strong="H1715"\w* y \w de|strong="H5414"\w* \w vino|strong="H8492"\w* nuevo!   
\q1
\v 29 \w Que|strong="H5971"\w* \w los|strong="H1121"\w* \w pueblos|strong="H5971"\w* te sirvan,  
\q2 y \w que|strong="H5971"\w* las naciones \w se|strong="H5971"\w* inclinen ante ti.  
\q1 \w Sé|strong="H5971"\w* \w el|strong="H1121"\w* señor \w de|strong="H1121"\w* tus hermanos,  
\q2 y \w que|strong="H5971"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* tu madre \w se|strong="H5971"\w* inclinen ante ti.  
\q1 ¡Maldito sea \w el|strong="H1121"\w* \w que|strong="H5971"\w* te maldiga,  
\q2 y \w bendito|strong="H1288"\w* sea \w el|strong="H1121"\w* \w que|strong="H5971"\w* te \w bendiga|strong="H1288"\w*!”   
\p
\v 30 \w Isaac|strong="H3327"\w* acababa \w de|strong="H6440"\w* bendecir \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*, y apenas \w había|strong="H1961"\w* \w salido|strong="H3318"\w* \w Jacob|strong="H3290"\w* \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* su padre, \w cuando|strong="H1961"\w* su hermano \w Esaú|strong="H6215"\w* llegó \w de|strong="H6440"\w* cazar.  
\v 31 \w También|strong="H1571"\w* \w él|strong="H1931"\w* preparó un guiso sabroso, \w se|strong="H1931"\w* \w lo|strong="H1931"\w* llevó \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre \w y|strong="H1571"\w* \w le|strong="H1931"\w* dijo: “\w Levántate|strong="H6965"\w*, padre mío, \w y|strong="H1571"\w* come \w de|strong="H1121"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w tu|strong="H6213"\w* \w hijo|strong="H1121"\w* ha cazado, para \w que|strong="H1931"\w* me des \w tu|strong="H6213"\w* \w bendición|strong="H1288"\w*”.   
\p
\v 32 Su padre \w Isaac|strong="H3327"\w* \w le|strong="H4310"\w* preguntó: “¿\w Y|strong="H3068"\w* tú \w quién|strong="H4310"\w* eres?”  
\p “Soy tu \w hijo|strong="H1121"\w* mayor, \w Esaú|strong="H6215"\w*” respondió \w él|strong="H4310"\w*.   
\p
\v 33 \w Isaac|strong="H3327"\w* \w se|strong="H1961"\w* asustó muchísimo \w y|strong="H1571"\w*, temblando, \w le|strong="H1931"\w* dijo: “\w Entonces|strong="H1571"\w*, ¿\w quién|strong="H4310"\w* \w fue|strong="H1961"\w* \w el|strong="H1931"\w* \w que|strong="H4310"\w* cazó un animal \w y|strong="H1571"\w* \w me|strong="H4310"\w* \w lo|strong="H1931"\w* trajo? Yo comí \w de|strong="H5704"\w* \w todo|strong="H3605"\w* \w antes|strong="H2962"\w* \w de|strong="H5704"\w* \w que|strong="H4310"\w* tú llegaras. \w Ya|strong="H3068"\w* \w le|strong="H1931"\w* he dado \w mi|strong="H1961"\w* \w bendición|strong="H1288"\w*, \w y|strong="H1571"\w* \w bendito|strong="H1288"\w* \w quedará|strong="H1961"\w*”.   
\p
\v 34 \w Al|strong="H5704"\w* \w escuchar|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w de|strong="H5704"\w* su padre, \w Esaú|strong="H6215"\w* dio un grito lleno \w de|strong="H5704"\w* \w amargura|strong="H4751"\w* \w y|strong="H1571"\w* le suplicó: “¡\w Bendíceme|strong="H1288"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* mí, padre mío!”   
\p
\v 35 Pero Isaac le respondió: “Tu hermano vino y me \w engañó|strong="H4820"\w*, y se \w llevó|strong="H3947"\w* tu \w bendición|strong="H1293"\w*”.   
\p
\v 36 Esaú exclamó: “¡\w Con|strong="H3588"\w* razón le pusieron \w por|strong="H3588"\w* \w nombre|strong="H8034"\w* \w Jacob|strong="H3290"\w*! \w Ya|strong="H3068"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* engañado \w dos|strong="H6471"\w* \w veces|strong="H6471"\w*: primero \w me|strong="H3588"\w* \w quitó|strong="H3947"\w* mis derechos \w de|strong="H3588"\w* hijo \w mayor|strong="H3588"\w*, \w y|strong="H3588"\w* \w ahora|strong="H6258"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* quitado \w mi|strong="H2009"\w* \w bendición|strong="H1293"\w*”. \w Y|strong="H3068"\w* le preguntó \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre: “¿\w No|strong="H3808"\w* has guardado \w ninguna|strong="H3808"\w* \w bendición|strong="H1293"\w* \w para|strong="H3588"\w* \w mí|strong="H2009"\w*?”   
\p
\v 37 \w Isaac|strong="H3327"\w* le contestó \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w*: “\w Ya|strong="H3068"\w* \w lo|strong="H4100"\w* he \w puesto|strong="H5414"\w* \w como|strong="H4100"\w* señor tuyo, y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus parientes \w los|strong="H1121"\w* he \w puesto|strong="H5414"\w* \w como|strong="H4100"\w* sus servidores; \w lo|strong="H4100"\w* he provisto \w de|strong="H1121"\w* \w trigo|strong="H1715"\w* y \w de|strong="H1121"\w* \w vino|strong="H8492"\w*. ¿\w Qué|strong="H4100"\w* puedo \w hacer|strong="H6213"\w* ahora \w por|strong="H4100"\w* ti, \w hijo|strong="H1121"\w* mío?”   
\p
\v 38 \w Esaú|strong="H6215"\w* \w le|strong="H1931"\w* rogó \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre: “¿Acaso tienes una sola \w bendición|strong="H1293"\w*, padre mío? ¡\w Bendíceme|strong="H1288"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* \w mí|strong="H5375"\w*!” \w Y|strong="H3068"\w* \w Esaú|strong="H6215"\w* \w se|strong="H1931"\w* \w puso|strong="H5375"\w* \w a|strong="H3068"\w* llorar \w a|strong="H3068"\w* gritos.   
\p
\v 39 Entonces su padre \w Isaac|strong="H3327"\w* \w le|strong="H5921"\w* dijo:  
\q1 “Vivirás lejos \w de|strong="H5921"\w* \w las|strong="H5921"\w* riquezas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra  
\q1 \w y|strong="H5921"\w* lejos \w del|strong="H5921"\w* \w rocío|strong="H2919"\w* \w que|strong="H5921"\w* cae \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*.   
\q1
\v 40 \w Vivirás|strong="H2421"\w* \w de|strong="H5921"\w* tu \w espada|strong="H2719"\w* \w y|strong="H5921"\w* \w servirás|strong="H5647"\w* \w a|strong="H3068"\w* tu hermano.  
\q1 Pero \w cuando|strong="H1961"\w* \w no|strong="H1961"\w* \w lo|strong="H5921"\w* soportes \w más|strong="H5921"\w*,  
\q1 \w te|strong="H5921"\w* arrancarás su \w yugo|strong="H5923"\w* \w del|strong="H5921"\w* \w cuello|strong="H6677"\w*”.   
\p
\v 41 \w A|strong="H3068"\w* partir \w de|strong="H5921"\w* ese momento, \w Esaú|strong="H6215"\w* guardó un profundo rencor \w contra|strong="H5921"\w* \w Jacob|strong="H3290"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w bendición|strong="H1293"\w* \w que|strong="H5921"\w* su padre \w le|strong="H5921"\w* había dado, \w y|strong="H5921"\w* pensó: “\w Ya|strong="H3068"\w* \w se|strong="H5921"\w* acercan \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* guardar luto \w por|strong="H5921"\w* \w mi|strong="H5921"\w* padre. \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* muera, \w mataré|strong="H2026"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* hermano \w Jacob|strong="H3290"\w*”.   
\p
\v 42 Pero alguien le \w contó|strong="H5046"\w* \w a|strong="H3068"\w* \w Rebeca|strong="H7259"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w estaba|strong="H2009"\w* planeando su \w hijo|strong="H1121"\w* \w mayor|strong="H1419"\w*. Entonces \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w menor|strong="H6996"\w* \w Jacob|strong="H3290"\w* y le \w dijo|strong="H5046"\w*: “\w Mira|strong="H2009"\w*, tu hermano \w Esaú|strong="H6215"\w* se está consolando con la idea \w de|strong="H1121"\w* matarte.  
\v 43 \w Así|strong="H6258"\w* \w que|strong="H6258"\w*, \w hijo|strong="H1121"\w* mío, \w escúchame|strong="H8085"\w* bien: prepárate y huye \w de|strong="H1121"\w* inmediato \w a|strong="H3068"\w* Jarán, \w a|strong="H3068"\w* la casa \w de|strong="H1121"\w* mi hermano \w Labán|strong="H3837"\w*.  
\v 44 \w Quédate|strong="H3427"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* un \w tiempo|strong="H3117"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* se \w le|strong="H5973"\w* pase \w el|strong="H5973"\w* \w enojo|strong="H2534"\w* \w a|strong="H3068"\w* tu hermano.  
\v 45 \w Cuando|strong="H3117"\w* \w se|strong="H4480"\w* calme su ira \w y|strong="H1571"\w* olvide \w lo|strong="H4100"\w* \w que|strong="H4100"\w* le has \w hecho|strong="H6213"\w*, \w yo|strong="H4480"\w* mandaré \w a|strong="H3068"\w* buscarte. ¿\w Por|strong="H4480"\w* \w qué|strong="H4100"\w* habría \w de|strong="H4480"\w* perderlos \w a|strong="H3068"\w* los \w dos|strong="H8147"\w* \w en|strong="H4480"\w* un solo \w día|strong="H3117"\w*?”   
\p
\v 46 Luego \w Rebeca|strong="H7259"\w* le dijo \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w*: “\w Ya|strong="H3068"\w* \w no|strong="H6440"\w* aguanto la \w vida|strong="H2416"\w* \w por|strong="H6440"\w* culpa \w de|strong="H6440"\w* estas \w mujeres|strong="H1323"\w* hititas. \w Si|strong="H6440"\w* \w Jacob|strong="H3290"\w* llega \w a|strong="H3068"\w* casarse con una hitita, con una \w de|strong="H6440"\w* las \w mujeres|strong="H1323"\w* \w de|strong="H6440"\w* esta tierra, ¡más me valdría morir!”   
\c 28  
\p
\v 1 Entonces \w Isaac|strong="H3327"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*, \w lo|strong="H3808"\w* \w bendijo|strong="H1288"\w* y le dio esta \w orden|strong="H6680"\w*: “\w No|strong="H3808"\w* te cases con \w ninguna|strong="H3808"\w* de las \w mujeres|strong="H1323"\w* de \w Canaán|strong="H3667"\w*.  
\v 2 Prepárate y \w ve|strong="H3212"\w* \w a|strong="H3068"\w* Padán Aram, \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de tu abuelo Betuel. Cásate \w allá|strong="H8033"\w* con una de las \w hijas|strong="H1323"\w* de \w Labán|strong="H3837"\w*, el hermano de tu madre.  
\v 3 \w Que|strong="H5971"\w* el Dios \w Todopoderoso|strong="H7706"\w* te \w bendiga|strong="H1288"\w*, te haga muy fecundo y multiplique tu descendencia, hasta \w que|strong="H5971"\w* llegues \w a|strong="H3068"\w* formar una \w multitud|strong="H6951"\w* \w de|strong="H5971"\w* naciones.  
\v 4 Que también te \w dé|strong="H5414"\w* la \w bendición|strong="H1293"\w* \w de|strong="H5414"\w* Abraham, \w a|strong="H3068"\w* ti y \w a|strong="H3068"\w* tus descendientes, \w para|strong="H5414"\w* que tomes posesión \w de|strong="H5414"\w* esta tierra donde ahora vives como extranjero, la cual Dios le \w dio|strong="H5414"\w* \w a|strong="H3068"\w* Abraham”.   
\p
\v 5 Así \w fue|strong="H3212"\w* como \w Isaac|strong="H3327"\w* \w despidió|strong="H7971"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*, quien se dirigió \w a|strong="H3068"\w* Padán Aram, \w a|strong="H3068"\w* la casa \w de|strong="H1121"\w* \w Labán|strong="H3837"\w*, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Betuel \w el|strong="H1121"\w* arameo y hermano \w de|strong="H1121"\w* \w Rebeca|strong="H7259"\w*, la madre \w de|strong="H1121"\w* \w Jacob|strong="H3290"\w* y \w Esaú|strong="H6215"\w*.   
\p
\v 6 \w Esaú|strong="H6215"\w* \w se|strong="H5921"\w* dio cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w Isaac|strong="H3327"\w* \w había|strong="H3588"\w* bendecido \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* \w y|strong="H3588"\w* \w lo|strong="H3808"\w* \w había|strong="H3588"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* Padán Aram \w para|strong="H5921"\w* buscar esposa \w allí|strong="H8033"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w al|strong="H5921"\w* bendecirlo \w le|strong="H5921"\w* \w había|strong="H3588"\w* \w ordenado|strong="H6680"\w*: “\w No|strong="H3808"\w* \w te|strong="H5921"\w* cases \w con|strong="H5921"\w* \w ninguna|strong="H3808"\w* mujer \w de|strong="H5921"\w* \w Canaán|strong="H3667"\w*”.  
\v 7 También \w supo|strong="H8085"\w* que \w Jacob|strong="H3290"\w* había obedecido \w a|strong="H3068"\w* su padre y \w a|strong="H3068"\w* su madre, y que se había \w ido|strong="H3212"\w* \w a|strong="H3068"\w* Padán Aram.  
\v 8 Al \w ver|strong="H7200"\w* \w Esaú|strong="H6215"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre \w Isaac|strong="H3327"\w* \w no|strong="H3588"\w* \w le|strong="H5869"\w* agradaban las \w mujeres|strong="H1323"\w* cananeas,  
\v 9 \w fue|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w*, \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Abraham, \w y|strong="H5921"\w* \w además|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* esposas \w que|strong="H5921"\w* ya tenía, \w se|strong="H5921"\w* \w casó|strong="H3947"\w* \w con|strong="H5921"\w* Majalat, \w que|strong="H5921"\w* \w era|strong="H1121"\w* \w hija|strong="H1323"\w* \w de|strong="H5921"\w* \w Ismael|strong="H3458"\w* \w y|strong="H5921"\w* hermana \w de|strong="H5921"\w* Nebaiot.   
\p
\v 10 \w Jacob|strong="H3290"\w* \w salió|strong="H3318"\w* de Beerseba y emprendió el viaje hacia Jarán.  
\v 11 Al llegar \w a|strong="H3068"\w* \w cierto|strong="H3588"\w* \w lugar|strong="H4725"\w*, \w se|strong="H1931"\w* detuvo \w para|strong="H3588"\w* pasar \w la|strong="H1931"\w* noche, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w* ya \w se|strong="H1931"\w* \w había|strong="H3588"\w* \w puesto|strong="H3588"\w*. \w Tomó|strong="H3947"\w* una \w de|strong="H3588"\w* las piedras del \w lugar|strong="H4725"\w*, \w la|strong="H1931"\w* usó \w como|strong="H3588"\w* almohada \w y|strong="H3588"\w* \w se|strong="H1931"\w* acostó \w a|strong="H3068"\w* dormir \w allí|strong="H8033"\w*.  
\v 12 Entonces \w tuvo|strong="H2492"\w* un sueño: \w vio|strong="H2009"\w* una escalinata que \w estaba|strong="H5324"\w* apoyada en la tierra y cuya parte superior \w llegaba|strong="H5060"\w* hasta el \w cielo|strong="H8064"\w*; y \w vio|strong="H2009"\w* que los \w ángeles|strong="H4397"\w* de Dios \w subían|strong="H5927"\w* y bajaban por ella.  
\v 13 Arriba \w de|strong="H5921"\w* \w ella|strong="H5921"\w* \w estaba|strong="H5324"\w* Yahvé, quien \w le|strong="H5921"\w* dijo: “\w Yo|strong="H2009"\w* soy Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* tu abuelo Abraham \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Isaac|strong="H3327"\w*. \w A|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w les|strong="H5921"\w* \w daré|strong="H5414"\w* \w la|strong="H5921"\w* tierra \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* estás \w acostado|strong="H7901"\w*.  
\v 14 Tus descendientes \w serán|strong="H1961"\w* tan numerosos \w como|strong="H1961"\w* \w el|strong="H3605"\w* \w polvo|strong="H6083"\w* de \w la|strong="H3605"\w* \w tierra|strong="H6083"\w*, y \w te|strong="H3220"\w* extenderás \w hacia|strong="H5045"\w* \w el|strong="H3605"\w* occidente y \w el|strong="H3605"\w* \w oriente|strong="H6924"\w*, \w hacia|strong="H5045"\w* \w el|strong="H3605"\w* \w norte|strong="H6828"\w* y \w el|strong="H3605"\w* sur. Por medio de ti y de tu \w descendencia|strong="H2233"\w* \w serán|strong="H1961"\w* bendecidas \w todas|strong="H3605"\w* las \w familias|strong="H4940"\w* de \w la|strong="H3605"\w* \w tierra|strong="H6083"\w*.  
\v 15 \w Yo|strong="H3588"\w* estoy \w contigo|strong="H5973"\w*; \w te|strong="H3588"\w* protegeré \w por|strong="H3588"\w* dondequiera \w que|strong="H3588"\w* \w vayas|strong="H3212"\w* \w y|strong="H3588"\w* \w te|strong="H3588"\w* traeré \w de|strong="H3588"\w* vuelta \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra. \w No|strong="H3808"\w* \w te|strong="H3588"\w* \w abandonaré|strong="H5800"\w* \w hasta|strong="H5704"\w* cumplir \w con|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* he prometido”.   
\p
\v 16 Al despertar de su \w sueño|strong="H8142"\w*, \w Jacob|strong="H3290"\w* pensó: “¡En verdad Yahvé \w está|strong="H2088"\w* en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, y yo \w no|strong="H3808"\w* \w lo|strong="H2088"\w* \w sabía|strong="H3045"\w*!”  
\v 17 Lleno \w de|strong="H3588"\w* \w temor|strong="H3372"\w*, exclamó: “¡\w Qué|strong="H3588"\w* impresionante \w es|strong="H2088"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*! \w No|strong="H3588"\w* \w es|strong="H2088"\w* otra \w cosa|strong="H2088"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Dios \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* del \w cielo|strong="H8064"\w*”.   
\p
\v 18 \w A|strong="H3068"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* siguiente, \w Jacob|strong="H3290"\w* \w se|strong="H5921"\w* levantó temprano, \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* piedra \w que|strong="H5921"\w* \w le|strong="H5921"\w* había servido \w de|strong="H5921"\w* almohada, \w la|strong="H5921"\w* erigió \w como|strong="H5921"\w* un pilar \w y|strong="H5921"\w* \w derramó|strong="H3332"\w* \w aceite|strong="H8081"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 19 \w A|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* \w le|strong="H1931"\w* puso por \w nombre|strong="H8034"\w* Betel, aunque al principio \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w se|strong="H1931"\w* \w llamaba|strong="H7121"\w* \w Luz|strong="H3870"\w*.  
\v 20 \w Luego|strong="H2088"\w* \w Jacob|strong="H3290"\w* \w hizo|strong="H5088"\w* \w esta|strong="H2088"\w* \w promesa|strong="H5087"\w*: “\w Si|strong="H1961"\w* Dios me acompaña y me protege en \w este|strong="H2088"\w* \w viaje|strong="H1870"\w* \w que|strong="H1961"\w* \w estoy|strong="H1961"\w* haciendo, y \w si|strong="H1961"\w* me \w da|strong="H5414"\w* alimento \w para|strong="H5414"\w* comer y ropa \w para|strong="H5414"\w* vestirme,  
\v 21 y \w si|strong="H1961"\w* regreso sano y salvo \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de \w mi|strong="H1961"\w* padre, \w entonces|strong="H7725"\w* Yahvé \w será|strong="H1961"\w* \w mi|strong="H1961"\w* \w Dios|strong="H3068"\w*.  
\v 22 \w Esta|strong="H2063"\w* piedra \w que|strong="H1961"\w* he erigido \w como|strong="H1961"\w* pilar \w será|strong="H1961"\w* \w casa|strong="H1004"\w* \w de|strong="H5414"\w* Dios; y \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* Dios me \w dé|strong="H5414"\w*, le \w entregaré|strong="H5414"\w* \w la|strong="H2063"\w* décima parte”.   
\c 29  
\p
\v 1 \w Jacob|strong="H3290"\w* continuó su viaje y \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* la tierra \w de|strong="H1121"\w* \w los|strong="H1121"\w* pueblos del \w oriente|strong="H6924"\w*.  
\v 2 \w Al|strong="H5921"\w* \w mirar|strong="H7200"\w*, \w vio|strong="H7200"\w* un pozo \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w campo|strong="H7704"\w* \w y|strong="H3588"\w* \w tres|strong="H7969"\w* \w rebaños|strong="H5739"\w* \w de|strong="H4480"\w* \w ovejas|strong="H6629"\w* descansando \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H1931"\w*, \w porque|strong="H3588"\w* \w de|strong="H4480"\w* \w ese|strong="H1931"\w* pozo \w abrevaban|strong="H8248"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w rebaños|strong="H5739"\w*. \w La|strong="H1931"\w* piedra \w que|strong="H3588"\w* cubría \w la|strong="H1931"\w* \w boca|strong="H6310"\w* \w del|strong="H4480"\w* pozo \w era|strong="H1931"\w* muy \w grande|strong="H1419"\w*.  
\v 3 Cuando \w se|strong="H5921"\w* juntaban \w allí|strong="H8033"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w rebaños|strong="H5739"\w*, \w los|strong="H5921"\w* pastores quitaban \w la|strong="H5921"\w* piedra \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w del|strong="H5921"\w* pozo \w para|strong="H5921"\w* dar \w de|strong="H5921"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*, \w y|strong="H5921"\w* \w luego|strong="H7725"\w* \w volvían|strong="H7725"\w* \w a|strong="H3068"\w* poner \w la|strong="H5921"\w* piedra \w en|strong="H5921"\w* su \w lugar|strong="H4725"\w*.  
\v 4 \w Jacob|strong="H3290"\w* les preguntó \w a|strong="H3068"\w* los pastores: “Hermanos míos, ¿de dónde son ustedes?”  
\p Ellos respondieron: “Somos de Jarán”.   
\p
\v 5 \w Él|strong="H1121"\w* les dijo: “¿\w Conocen|strong="H3045"\w* \w a|strong="H3068"\w* \w Labán|strong="H3837"\w*, \w el|strong="H1121"\w* \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Nacor?”  
\p \w Y|strong="H3068"\w* ellos dijeron: “Sí, lo conocemos”.   
\p
\v 6 Jacob \w les|strong="H5973"\w* preguntó: “¿\w Cómo|strong="H5973"\w* está \w él|strong="H5973"\w*?”  
\p Ellos contestaron: “Está \w bien|strong="H7965"\w*. Miren, allí viene su \w hija|strong="H1323"\w* Raquel \w con|strong="H5973"\w* las \w ovejas|strong="H6629"\w*”.   
\p
\v 7 Jacob les dijo: “\w Todavía|strong="H5750"\w* \w es|strong="H4735"\w* pleno \w día|strong="H3117"\w*, y \w aún|strong="H5750"\w* \w no|strong="H3808"\w* \w es|strong="H4735"\w* \w hora|strong="H6256"\w* \w de|strong="H5750"\w* encerrar el \w ganado|strong="H4735"\w*. Denles \w de|strong="H5750"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* las \w ovejas|strong="H6629"\w* y llévenlas \w a|strong="H3068"\w* pastar”.   
\p
\v 8 Pero \w ellos|strong="H5921"\w* dijeron: “\w No|strong="H3808"\w* \w podemos|strong="H3201"\w* \w hacerlo|strong="H3201"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* junten \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w rebaños|strong="H5739"\w* \w y|strong="H5921"\w* quiten \w la|strong="H5921"\w* piedra \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w del|strong="H5921"\w* pozo. Sólo entonces \w podremos|strong="H3201"\w* darles \w de|strong="H5921"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*”.   
\p
\v 9 \w Todavía|strong="H5750"\w* estaba \w hablando|strong="H1696"\w* \w con|strong="H5973"\w* \w ellos|strong="H1931"\w* \w cuando|strong="H3588"\w* llegó Raquel \w con|strong="H5973"\w* \w el|strong="H1931"\w* \w rebaño|strong="H6629"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* padre, \w pues|strong="H3588"\w* \w ella|strong="H1931"\w* \w era|strong="H1931"\w* \w la|strong="H1931"\w* pastora.  
\v 10 \w Cuando|strong="H1961"\w* \w Jacob|strong="H3290"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* Raquel, \w hija|strong="H1323"\w* \w de|strong="H5921"\w* \w Labán|strong="H3837"\w*, \w el|strong="H5921"\w* hermano \w de|strong="H5921"\w* su madre, \w y|strong="H5921"\w* \w vio|strong="H7200"\w* también \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w de|strong="H5921"\w* su tío \w Labán|strong="H3837"\w*, \w se|strong="H1961"\w* \w acercó|strong="H5066"\w*, quitó \w la|strong="H5921"\w* piedra \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w del|strong="H5921"\w* pozo \w y|strong="H5921"\w* \w les|strong="H5921"\w* dio \w de|strong="H5921"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*.  
\v 11 Luego \w Jacob|strong="H3290"\w* \w besó|strong="H5401"\w* \w a|strong="H3068"\w* Raquel y se echó \w a|strong="H3068"\w* llorar de alegría.  
\v 12 \w Jacob|strong="H3290"\w* \w le|strong="H1931"\w* \w contó|strong="H5046"\w* \w a|strong="H3068"\w* Raquel \w que|strong="H3588"\w* \w él|strong="H1931"\w* \w era|strong="H1931"\w* pariente \w de|strong="H3588"\w* \w su|strong="H1931"\w* padre \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w era|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Rebeca|strong="H7259"\w*. \w Entonces|strong="H3588"\w* \w ella|strong="H1931"\w* \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* contárselo \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre.   
\p
\v 13 Tan pronto \w como|strong="H1961"\w* \w Labán|strong="H3837"\w* \w oyó|strong="H8085"\w* las noticias \w acerca|strong="H1697"\w* \w de|strong="H1121"\w* \w Jacob|strong="H3290"\w*, \w el|strong="H3605"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* su hermana, \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* recibirlo, \w lo|strong="H1697"\w* abrazó, \w lo|strong="H1697"\w* \w besó|strong="H5401"\w* y \w lo|strong="H1697"\w* llevó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*. Allí \w Jacob|strong="H3290"\w* le \w contó|strong="H5608"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w había|strong="H1961"\w* pasado.  
\v 14 \w Labán|strong="H3837"\w* \w le|strong="H5973"\w* dijo: “¡Realmente eres \w de|strong="H5973"\w* mi propia sangre!” \w Y|strong="H3068"\w* Jacob se \w quedó|strong="H3427"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* todo un \w mes|strong="H2320"\w*.  
\v 15 \w Entonces|strong="H3588"\w* \w Labán|strong="H3837"\w* le \w dijo|strong="H5046"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*: “\w No|strong="H3588"\w* vas \w a|strong="H3068"\w* trabajar \w para|strong="H3588"\w* mí \w de|strong="H3588"\w* balde sólo \w porque|strong="H3588"\w* eres mi pariente. Dime, ¿\w cuánto|strong="H3588"\w* quieres ganar?”   
\p
\v 16 \w Labán|strong="H3837"\w* tenía \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w*: la \w mayor|strong="H1419"\w* se \w llamaba|strong="H8034"\w* \w Lea|strong="H3812"\w*, y la \w menor|strong="H6996"\w* se \w llamaba|strong="H8034"\w* Raquel.  
\v 17 \w Lea|strong="H3812"\w* \w tenía|strong="H1961"\w* \w los|strong="H1961"\w* \w ojos|strong="H5869"\w* apagados, pero Raquel \w era|strong="H1961"\w* \w de|strong="H5869"\w* \w hermosa|strong="H3303"\w* figura y muy atractiva.  
\v 18 Como \w Jacob|strong="H3290"\w* se había enamorado de Raquel, le dijo \w a|strong="H3068"\w* Labán: “Trabajaré para ti \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w a|strong="H3068"\w* cambio de Raquel, tu \w hija|strong="H1323"\w* \w menor|strong="H6996"\w*”.   
\p
\v 19 \w Labán|strong="H3837"\w* respondió: “Es \w mejor|strong="H2896"\w* que te la \w dé|strong="H5414"\w* \w a|strong="H3068"\w* ti y no \w a|strong="H3068"\w* un extraño. \w Quédate|strong="H3427"\w* \w conmigo|strong="H5978"\w*”.   
\p
\v 20 Así \w que|strong="H3117"\w* \w Jacob|strong="H3290"\w* trabajó \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w para|strong="H1961"\w* casarse con Raquel, pero \w le|strong="H5869"\w* parecieron unos pocos \w días|strong="H3117"\w* por el gran amor \w que|strong="H3117"\w* \w le|strong="H5869"\w* \w tenía|strong="H1961"\w*.   
