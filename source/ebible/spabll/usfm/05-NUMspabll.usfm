\v 20 y \w cómo|strong="H4100"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* tierra, \w si|strong="H1931"\w* \w es|strong="H1931"\w* fértil \w o|strong="H3068"\w* pobre, \w si|strong="H1931"\w* \w hay|strong="H3426"\w* \w madera|strong="H6086"\w* en \w ella|strong="H1931"\w* \w o|strong="H3068"\w* \w no|strong="H4100"\w*. Sean \w valientes|strong="H8082"\w* y \w traigan|strong="H3947"\w* algo del \w fruto|strong="H6529"\w* de \w la|strong="H1931"\w* tierra”. \w Era|strong="H1931"\w* \w el|strong="H1931"\w* \w tiempo|strong="H3117"\w* de las primeras \w uvas|strong="H6025"\w* maduras.   
\p
\v 21 \w Subieron|strong="H5927"\w*, pues, \w y|strong="H5704"\w* reconocieron la tierra \w desde|strong="H5704"\w* el \w desierto|strong="H4057"\w* \w de|strong="H5704"\w* Zin \w hasta|strong="H5704"\w* \w Rehob|strong="H7340"\w*, \w hasta|strong="H5704"\w* la entrada \w de|strong="H5704"\w* Hamat.  
\v 22 \w Subieron|strong="H5927"\w* \w por|strong="H6440"\w* el sur \w y|strong="H5704"\w* llegaron \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w*, \w donde|strong="H8033"\w* estaban Ahimán, Sesai \w y|strong="H5704"\w* Talmai, \w hijos|strong="H3211"\w* \w de|strong="H6440"\w* Anac. (Ahora bien, \w Hebrón|strong="H2275"\w* fue construida \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w antes|strong="H6440"\w* \w que|strong="H5704"\w* Zoán \w en|strong="H5704"\w* \w Egipto|strong="H4714"\w*).  
\v 23 Llegaron \w al|strong="H4480"\w* valle \w de|strong="H4480"\w* Escol, \w y|strong="H5704"\w* \w cortaron|strong="H3772"\w* \w de|strong="H4480"\w* \w allí|strong="H8033"\w* una rama \w con|strong="H4480"\w* un racimo \w de|strong="H4480"\w* \w uvas|strong="H6025"\w*, \w y|strong="H5704"\w* la \w llevaron|strong="H5375"\w* \w en|strong="H4480"\w* un bastón \w entre|strong="H8033"\w* \w dos|strong="H8147"\w*. También \w llevaron|strong="H5375"\w* algunas \w granadas|strong="H7416"\w* \w e|strong="H3068"\w* \w higos|strong="H8384"\w*.  
\v 24 \w Aquel|strong="H1931"\w* \w lugar|strong="H4725"\w* \w fue|strong="H1931"\w* \w llamado|strong="H7121"\w* valle \w de|strong="H5921"\w* Escol, \w por|strong="H5921"\w* \w el|strong="H1931"\w* racimo \w que|strong="H1931"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w cortaron|strong="H3772"\w* \w de|strong="H5921"\w* \w allí|strong="H8033"\w*.  
\v 25 \w Volvieron|strong="H7725"\w* de espiar la tierra al cabo de cuarenta \w días|strong="H3117"\w*.  
\v 26 \w Fueron|strong="H3212"\w* y vinieron \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, al \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* \w Parán|strong="H6290"\w*, \w a|strong="H3068"\w* \w Cades|strong="H6946"\w*, y les trajeron \w la|strong="H3605"\w* noticia \w a|strong="H3068"\w* \w ellos|strong="H3605"\w* y \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación. Les mostraron \w el|strong="H3605"\w* \w fruto|strong="H6529"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* tierra.  
\v 27 \w Ellos|strong="H1931"\w* \w se|strong="H1931"\w* \w lo|strong="H1931"\w* \w contaron|strong="H5608"\w* \w y|strong="H1571"\w* dijeron: “Hemos llegado \w a|strong="H3068"\w* \w la|strong="H1931"\w* tierra \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w que|strong="H1931"\w* nos \w enviaste|strong="H7971"\w*. \w Ciertamente|strong="H1571"\w* \w fluye|strong="H2100"\w* \w leche|strong="H2461"\w* \w y|strong="H1571"\w* \w miel|strong="H1706"\w*, \w y|strong="H1571"\w* \w este|strong="H2088"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* \w fruto|strong="H6529"\w*.  
\v 28 Sin embargo, \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w habita|strong="H3427"\w* \w la|strong="H1571"\w* tierra \w es|strong="H3588"\w* \w fuerte|strong="H5794"\w*, \w y|strong="H1571"\w* las \w ciudades|strong="H5892"\w* \w están|strong="H3427"\w* \w fortificadas|strong="H1219"\w* \w y|strong="H1571"\w* \w son|strong="H3588"\w* \w muy|strong="H3966"\w* \w grandes|strong="H1419"\w*. \w Además|strong="H3588"\w*, \w vimos|strong="H7200"\w* \w allí|strong="H8033"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w hijos|strong="H3211"\w* \w de|strong="H3588"\w* Anac.  
\v 29 \w Amalec|strong="H6002"\w* \w habita|strong="H3427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w del|strong="H5921"\w* Sur. \w El|strong="H5921"\w* hitita, \w el|strong="H5921"\w* \w jebuseo|strong="H2983"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* amorreo \w habitan|strong="H3427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* región montañosa. \w El|strong="H5921"\w* \w cananeo|strong="H3669"\w* \w habita|strong="H3427"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w mar|strong="H3220"\w* \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w lado|strong="H3027"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*”.   
\p
\v 30 \w Caleb|strong="H3612"\w* calmó al \w pueblo|strong="H5971"\w* ante \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* dijo: “¡\w Subamos|strong="H5927"\w* \w de|strong="H3588"\w* inmediato \w y|strong="H3588"\w* tomemos posesión \w de|strong="H3588"\w* ella, \w pues|strong="H3588"\w* somos capaces \w de|strong="H3588"\w* vencerla!”   
\p
\v 31 \w Pero|strong="H3588"\w* \w los|strong="H5973"\w* hombres \w que|strong="H3588"\w* \w subieron|strong="H5927"\w* \w con|strong="H5973"\w* \w él|strong="H1931"\w* dijeron: “\w No|strong="H3808"\w* somos capaces \w de|strong="H4480"\w* \w subir|strong="H5927"\w* \w contra|strong="H5973"\w* \w ese|strong="H1931"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w más|strong="H3588"\w* \w fuerte|strong="H2389"\w* \w que|strong="H3588"\w* \w nosotros|strong="H5973"\w*”.  
\v 32 Presentaron \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* un mal informe \w de|strong="H1121"\w* \w la|strong="H1931"\w* tierra \w que|strong="H1931"\w* habían espiado, diciendo: “\w La|strong="H1931"\w* tierra por \w la|strong="H1931"\w* \w que|strong="H1931"\w* hemos \w pasado|strong="H5674"\w* \w para|strong="H5971"\w* espiarla \w es|strong="H1931"\w* una tierra \w que|strong="H1931"\w* devora \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w habitantes|strong="H3427"\w*, y \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w* \w que|strong="H1931"\w* \w vimos|strong="H7200"\w* \w en|strong="H8432"\w* \w ella|strong="H1931"\w* son \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* gran estatura.  
\v 33 \w Allí|strong="H8033"\w* \w vimos|strong="H7200"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* Nefilim,\f + \fr 13:33 \ft o, gigantes\f* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* Anac, \w que|strong="H4480"\w* provienen \w de|strong="H4480"\w* \w los|strong="H1121"\w* Nefilim.\f + \fr 13:33 \ft o, gigantes\f* Éramos \w a|strong="H3068"\w* nuestra vista \w como|strong="H1961"\w* saltamontes, y \w así|strong="H3651"\w* éramos \w a|strong="H3068"\w* su vista”.   
\c 14  
\p
\v 1 \w Toda|strong="H3605"\w* \w la|strong="H1931"\w* congregación \w alzó|strong="H5375"\w* \w la|strong="H1931"\w* \w voz|strong="H6963"\w* y gritó, y \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w lloró|strong="H1058"\w* \w aquella|strong="H1931"\w* \w noche|strong="H3915"\w*.  
\v 2 \w Todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* murmuraron \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w contra|strong="H5921"\w* Aarón. \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* congregación \w les|strong="H5921"\w* dijo: “¡\w Ojalá|strong="H3863"\w* hubiéramos \w muerto|strong="H4191"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w o|strong="H3068"\w* hubiéramos \w muerto|strong="H4191"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w desierto|strong="H4057"\w*!  
\v 3 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* trae Yahvé \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra \w para|strong="H1961"\w* \w que|strong="H4100"\w* caigamos \w a|strong="H3068"\w* \w espada|strong="H2719"\w*? ¡Nuestras esposas y nuestros pequeños \w serán|strong="H1961"\w* capturados \w o|strong="H3068"\w* asesinados! ¿\w No|strong="H3808"\w* \w sería|strong="H1961"\w* \w mejor|strong="H2896"\w* \w que|strong="H4100"\w* volviéramos \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*?”  
\v 4 Se dijeron unos \w a|strong="H3068"\w* otros: “Elijamos un líder y \w volvamos|strong="H7725"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*”.   
\p
\v 5 Entonces \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* Aarón \w se|strong="H5921"\w* postraron \w ante|strong="H6440"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w congregación|strong="H6951"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 6 \w Josué|strong="H3091"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Nun|strong="H5126"\w*, y \w Caleb|strong="H3612"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Jefone, \w que|strong="H4480"\w* eran \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w que|strong="H4480"\w* espiaron la tierra, \w se|strong="H4480"\w* \w rasgaron|strong="H7167"\w* la ropa.  
\v 7 Hablaron \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, diciendo: “\w La|strong="H3605"\w* tierra \w que|strong="H1121"\w* atravesamos para espiarla es una tierra \w sumamente|strong="H3966"\w* \w buena|strong="H2896"\w*.  
\v 8 \w Si|strong="H1931"\w* Yahvé \w se|strong="H1931"\w* complace en \w nosotros|strong="H1931"\w*, nos introducirá en \w esta|strong="H2063"\w* tierra y nos \w la|strong="H1931"\w* \w dará|strong="H5414"\w*: una tierra \w que|strong="H1931"\w* mana \w leche|strong="H2461"\w* y \w miel|strong="H1706"\w*.  
\v 9 Solo \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w se|strong="H5921"\w* rebelen \w contra|strong="H5921"\w* Yahvé, ni \w le|strong="H5921"\w* \w teman|strong="H3372"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w son|strong="H3588"\w* \w pan|strong="H3899"\w* comido \w para|strong="H5921"\w* \w nosotros|strong="H5921"\w*. \w Su|strong="H1992"\w* defensa \w les|strong="H1992"\w* ha sido quitada, \w y|strong="H3588"\w* Yahvé \w está|strong="H1992"\w* \w con|strong="H5921"\w* \w nosotros|strong="H5921"\w*. \w No|strong="H3588"\w* \w les|strong="H1992"\w* tengan \w miedo|strong="H3372"\w*”.   
\p
\v 10 Pero \w toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación amenazó con apedrearlos.  
\p \w La|strong="H3605"\w* \w gloria|strong="H3519"\w* \w de|strong="H1121"\w* Yahvé se presentó en \w la|strong="H3605"\w* Tienda del Encuentro \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 11 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* me despreciará \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*? ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* \w no|strong="H3808"\w* creerán \w en|strong="H5704"\w* mí, \w a|strong="H3068"\w* pesar \w de|strong="H5704"\w* \w todas|strong="H3605"\w* las señales \w que|strong="H3808"\w* he realizado \w entre|strong="H7130"\w* \w ellos|strong="H3605"\w*?  
\v 12 Los \w heriré|strong="H5221"\w* \w con|strong="H4480"\w* una plaga y los desheredaré, y \w haré|strong="H6213"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w* una \w nación|strong="H1471"\w* \w más|strong="H4480"\w* \w grande|strong="H1419"\w* y poderosa \w que|strong="H4480"\w* \w ellos|strong="H4480"\w*”.   
\p
\v 13 \w Moisés|strong="H4872"\w* le respondió \w a|strong="H3068"\w* Yahvé: “\w Entonces|strong="H3588"\w* \w los|strong="H3588"\w* \w egipcios|strong="H4713"\w* \w lo|strong="H2088"\w* \w oirán|strong="H8085"\w*, \w porque|strong="H3588"\w* tú \w con|strong="H3588"\w* tu \w poder|strong="H3581"\w* \w sacaste|strong="H5927"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ellos.  
\v 14 \w Se|strong="H5921"\w* \w lo|strong="H2088"\w* contarán \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* tierra. Han \w oído|strong="H8085"\w* \w que|strong="H3588"\w* tú, Yahvé, \w estás|strong="H5975"\w* \w en|strong="H5921"\w* \w medio|strong="H7130"\w* \w de|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*; \w porque|strong="H3588"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, Yahvé, \w te|strong="H5869"\w* \w ven|strong="H7200"\w* \w cara|strong="H6440"\w* \w a|strong="H3068"\w* \w cara|strong="H6440"\w*, \w y|strong="H3588"\w* tu \w nube|strong="H6051"\w* \w está|strong="H2063"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H3588"\w* tú \w vas|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w en|strong="H5921"\w* una \w columna|strong="H5982"\w* \w de|strong="H5921"\w* \w nube|strong="H6051"\w* \w de|strong="H5921"\w* \w día|strong="H3119"\w*, \w y|strong="H3588"\w* \w en|strong="H5921"\w* una \w columna|strong="H5982"\w* \w de|strong="H5921"\w* fuego \w de|strong="H5921"\w* \w noche|strong="H3915"\w*.  
\v 15 Ahora bien, si matas \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* como \w a|strong="H3068"\w* un solo hombre, las \w naciones|strong="H1471"\w* \w que|strong="H5971"\w* \w han|strong="H4191"\w* \w oído|strong="H8085"\w* \w de|strong="H5971"\w* tu fama hablarán diciendo:  
\v 16 ‘Como Yahvé \w no|strong="H1115"\w* \w pudo|strong="H3201"\w* llevar \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w a|strong="H3068"\w* la tierra \w que|strong="H5971"\w* les había \w jurado|strong="H7650"\w*, los mató en el \w desierto|strong="H4057"\w*’.  
\v 17 \w Ahora|strong="H6258"\w*, \w por|strong="H3581"\w* favor, demuestra la grandeza del \w poder|strong="H3581"\w* de Yahvé,\f + \fr 14:17 \ft La palabra traducida “Señor” es “Adonai”.\f* tal como lo has declarado al decir:  
\v 18 ‘Yahvé es lento \w para|strong="H5921"\w* enojarse, \w y|strong="H5921"\w* abundante \w en|strong="H5921"\w* \w misericordia|strong="H2617"\w*, \w que|strong="H3808"\w* \w perdona|strong="H5375"\w* \w la|strong="H5921"\w* \w maldad|strong="H5771"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* rebeldía; pero \w de|strong="H5921"\w* \w ninguna|strong="H3808"\w* manera dejará \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w* \w al|strong="H5921"\w* culpable, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* castigará \w la|strong="H5921"\w* \w maldad|strong="H5771"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* padres \w en|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w*, \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* tercera \w y|strong="H5921"\w* cuarta generación’.  
\v 19 \w Por|strong="H2088"\w* favor, \w perdona|strong="H5545"\w* el \w pecado|strong="H5771"\w* \w de|strong="H5704"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* según la \w grandeza|strong="H1433"\w* \w de|strong="H5704"\w* tu fiel amor, \w tal|strong="H2088"\w* \w como|strong="H5704"\w* has perdonado \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w desde|strong="H5704"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w ahora|strong="H4994"\w*”.   
\p
\v 20 Yahvé dijo: “Los he perdonado según \w lo|strong="H1697"\w* has pedido;  
\v 21 pero en realidad, tan cierto como \w que|strong="H3605"\w* yo \w vivo|strong="H2416"\w* \w y|strong="H3519"\w* \w que|strong="H3605"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra se \w llenará|strong="H4390"\w* de \w la|strong="H3605"\w* \w gloria|strong="H3519"\w* de Yahvé,  
\v 22 \w ninguno|strong="H3808"\w* \w de|strong="H3588"\w* esos hombres \w que|strong="H3588"\w* han \w visto|strong="H7200"\w* mi \w gloria|strong="H3519"\w* \w y|strong="H3588"\w* las señales \w que|strong="H3588"\w* \w hice|strong="H6213"\w* \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* han \w puesto|strong="H3588"\w* \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w estas|strong="H2088"\w* \w diez|strong="H6235"\w* \w veces|strong="H6471"\w* \w sin|strong="H3808"\w* \w escuchar|strong="H8085"\w* mi \w voz|strong="H6963"\w*,  
\v 23 ciertamente \w no|strong="H3808"\w* \w verán|strong="H7200"\w* \w la|strong="H3605"\w* tierra \w que|strong="H3808"\w* les \w juré|strong="H7650"\w* \w a|strong="H3068"\w* sus padres, \w ni|strong="H3808"\w* \w la|strong="H3605"\w* \w verá|strong="H7200"\w* \w ninguno|strong="H3808"\w* de \w los|strong="H3605"\w* \w que|strong="H3808"\w* me despreciaron.  
\v 24 Pero \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w siervo|strong="H5650"\w* \w Caleb|strong="H3612"\w*, \w por|strong="H6118"\w* \w haber|strong="H1961"\w* tenido una actitud diferente y haberme seguido \w de|strong="H5973"\w* todo corazón, lo introduciré \w en|strong="H5973"\w* la tierra \w a|strong="H3068"\w* la \w que|strong="H1961"\w* entró. Sus descendientes tomarán posesión \w de|strong="H5973"\w* \w ella|strong="H8033"\w*.  
\v 25 \w Ya|strong="H3068"\w* que \w los|strong="H3427"\w* amalecitas y \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* viven en \w el|strong="H3427"\w* \w valle|strong="H6010"\w*, \w mañana|strong="H4279"\w* den la vuelta y regresen al \w desierto|strong="H4057"\w* \w por|strong="H1870"\w* \w el|strong="H3427"\w* \w camino|strong="H1870"\w* del \w Mar|strong="H3220"\w* Rojo”.  
\v 26 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, \w diciendo|strong="H1696"\w*:  
\v 27 “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* tendré \w que|strong="H5921"\w* soportar \w a|strong="H3068"\w* \w esta|strong="H2063"\w* comunidad malvada \w que|strong="H5921"\w* \w se|strong="H5921"\w* queja \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*? He \w oído|strong="H8085"\w* \w las|strong="H1992"\w* quejas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w que|strong="H5921"\w* \w no|strong="H5921"\w* dejan \w de|strong="H5921"\w* murmurar \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 28 \w Diles|strong="H1696"\w*: ‘Tan \w cierto|strong="H3808"\w* \w como|strong="H3651"\w* \w que|strong="H3808"\w* \w yo|strong="H6213"\w* \w vivo|strong="H2416"\w*, \w dice|strong="H5002"\w* Yahvé, \w que|strong="H3808"\w* \w haré|strong="H6213"\w* con ustedes exactamente \w lo|strong="H3808"\w* \w que|strong="H3808"\w* les he escuchado decir.  
\v 29 Sus cadáveres \w caerán|strong="H5307"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w desierto|strong="H4057"\w*; \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* fueron \w contados|strong="H4557"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* censo, \w de|strong="H5921"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* \w para|strong="H5921"\w* \w arriba|strong="H4605"\w*, \w que|strong="H5921"\w* \w se|strong="H5921"\w* han quejado \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*,  
\v 30 \w ciertamente|strong="H3588"\w* \w no|strong="H3588"\w* entrarán \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra donde juré \w que|strong="H3588"\w* \w los|strong="H1121"\w* establecería, \w a|strong="H3068"\w* excepción \w de|strong="H3588"\w* \w Caleb|strong="H3612"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Jefone, \w y|strong="H3588"\w* \w Josué|strong="H3091"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Nun|strong="H5126"\w*.  
\v 31 Pero \w a|strong="H3068"\w* sus hijos pequeños, \w que|strong="H3045"\w* ustedes dijeron \w que|strong="H3045"\w* serían botín de guerra, \w a|strong="H3068"\w* ellos \w los|strong="H1961"\w* introduciré y \w conocerán|strong="H3045"\w* la tierra \w que|strong="H3045"\w* ustedes han rechazado.  
\v 32 Pero en cuanto \w a|strong="H3068"\w* ustedes, sus cadáveres \w caerán|strong="H5307"\w* en \w este|strong="H2088"\w* \w desierto|strong="H4057"\w*.  
\v 33 Sus \w hijos|strong="H1121"\w* \w serán|strong="H1961"\w* \w pastores|strong="H7462"\w* nómadas \w en|strong="H5704"\w* \w el|strong="H1121"\w* \w desierto|strong="H4057"\w* durante cuarenta \w años|strong="H8141"\w*, \w y|strong="H5704"\w* sufrirán \w por|strong="H5704"\w* la infidelidad \w de|strong="H5704"\w* ustedes, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w el|strong="H1121"\w* último \w de|strong="H5704"\w* sus cadáveres \w quede|strong="H1961"\w* \w en|strong="H5704"\w* \w el|strong="H1121"\w* \w desierto|strong="H4057"\w*.  
\v 34 De acuerdo al \w número|strong="H4557"\w* de \w días|strong="H3117"\w* \w que|strong="H3045"\w* exploraron la tierra, \w que|strong="H3045"\w* fueron cuarenta \w días|strong="H3117"\w*, por \w cada|strong="H3117"\w* \w día|strong="H3117"\w* sufrirán un \w año|strong="H8141"\w* de castigo por sus \w pecados|strong="H5771"\w*; es decir, cuarenta \w años|strong="H8141"\w*, y así \w sabrán|strong="H3045"\w* lo \w que|strong="H3045"\w* significa tenerme en contra’.  
\v 35 \w Yo|strong="H6213"\w*, Yahvé, he \w hablado|strong="H1696"\w*. \w Ciertamente|strong="H4191"\w* \w le|strong="H5921"\w* \w haré|strong="H6213"\w* \w esto|strong="H2063"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w esta|strong="H2063"\w* comunidad malvada \w que|strong="H3808"\w* \w se|strong="H5921"\w* \w ha|strong="H3808"\w* unido \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*. \w En|strong="H5921"\w* \w este|strong="H2088"\w* \w desierto|strong="H4057"\w* encontrarán su fin, \w y|strong="H5921"\w* \w aquí|strong="H2088"\w* \w morirán|strong="H4191"\w*”.   
\p
\v 36 \w Los|strong="H5921"\w* hombres \w que|strong="H5921"\w* \w Moisés|strong="H4872"\w* había \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* explorar \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w al|strong="H5921"\w* regresar hicieron \w que|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad murmurara \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w al|strong="H5921"\w* dar un mal reporte \w del|strong="H5921"\w* país,  
\v 37 esos mismos hombres que dieron el \w mal|strong="H7451"\w* reporte \w de|strong="H6440"\w* la tierra \w murieron|strong="H4191"\w* \w por|strong="H6440"\w* una \w plaga|strong="H4046"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 38 Solo \w Josué|strong="H3091"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Nun|strong="H5126"\w*, y \w Caleb|strong="H3612"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Jefone, sobrevivieron \w de|strong="H4480"\w* \w entre|strong="H4480"\w* \w los|strong="H1992"\w* \w hombres|strong="H1121"\w* \w que|strong="H4480"\w* \w fueron|strong="H1980"\w* \w a|strong="H3068"\w* explorar la tierra.   
\p
\v 39 Cuando \w Moisés|strong="H4872"\w* les comunicó estas \w palabras|strong="H1697"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* entristeció muchísimo.  
\v 40 Se levantaron muy temprano \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w mañana|strong="H1242"\w* \w y|strong="H3588"\w* \w subieron|strong="H5927"\w* hacia lo alto \w de|strong="H3588"\w* \w la|strong="H3588"\w* zona montañosa, diciendo: “\w Aquí|strong="H2005"\w* estamos; \w subiremos|strong="H5927"\w* al \w lugar|strong="H4725"\w* \w que|strong="H3588"\w* Yahvé ha prometido, \w porque|strong="H3588"\w* reconocemos \w que|strong="H3588"\w* hemos \w pecado|strong="H2398"\w*”.   
\p
\v 41 Pero \w Moisés|strong="H4872"\w* les dijo: “¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* \w están|strong="H2088"\w* desobedeciendo ahora \w la|strong="H1931"\w* orden de Yahvé? \w Eso|strong="H1931"\w* \w no|strong="H3808"\w* les saldrá bien.  
\v 42 \w No|strong="H3808"\w* suban, \w porque|strong="H3588"\w* Yahvé \w no|strong="H3808"\w* está \w entre|strong="H7130"\w* ustedes, \w y|strong="H3588"\w* serán derrotados \w por|strong="H3588"\w* sus enemigos.  
\v 43 \w Porque|strong="H3588"\w* \w allí|strong="H8033"\w* \w se|strong="H1961"\w* enfrentarán \w a|strong="H3068"\w* \w los|strong="H5921"\w* amalecitas \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w cananeos|strong="H3669"\w*, \w y|strong="H3588"\w* \w caerán|strong="H5307"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*. \w Como|strong="H3588"\w* \w se|strong="H1961"\w* han apartado \w de|strong="H5921"\w* Yahvé, Yahvé \w no|strong="H3808"\w* \w estará|strong="H1961"\w* \w con|strong="H5973"\w* ustedes”.   
\p
\v 44 \w A|strong="H3068"\w* pesar de esto, \w se|strong="H3808"\w* atrevieron \w a|strong="H3068"\w* \w subir|strong="H5927"\w* \w a|strong="H3068"\w* la zona montañosa, \w aunque|strong="H3808"\w* \w ni|strong="H3808"\w* \w el|strong="H4264"\w* arca del \w pacto|strong="H1285"\w* de Yahvé \w ni|strong="H3808"\w* \w Moisés|strong="H4872"\w* \w se|strong="H3808"\w* movieron del \w campamento|strong="H4264"\w*.  
\v 45 Entonces \w los|strong="H3427"\w* amalecitas \w y|strong="H5704"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* \w que|strong="H1931"\w* \w vivían|strong="H3427"\w* \w en|strong="H5704"\w* aquellas montañas \w descendieron|strong="H3381"\w*, \w los|strong="H3427"\w* atacaron \w y|strong="H5704"\w* \w los|strong="H3427"\w* persiguieron \w hasta|strong="H5704"\w* \w Horma|strong="H2767"\w*.   
\c 15  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* hayan entrado \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra donde van \w a|strong="H3068"\w* vivir, \w la|strong="H3588"\w* \w cual|strong="H3588"\w* \w yo|strong="H3588"\w* les \w doy|strong="H5414"\w*,  
\v 3 \w y|strong="H1241"\w* \w hagan|strong="H6213"\w* una ofrenda \w por|strong="H4480"\w* fuego \w a|strong="H3068"\w* Yahvé, ya sea un \w holocausto|strong="H5930"\w*, un \w sacrificio|strong="H2077"\w* \w para|strong="H4480"\w* cumplir un \w voto|strong="H5088"\w* especial, una ofrenda \w voluntaria|strong="H5071"\w*, \w o|strong="H3068"\w* durante sus fiestas establecidas, \w para|strong="H4480"\w* presentar un aroma agradable \w a|strong="H3068"\w* Yahvé, ya sea \w de|strong="H4480"\w* \w vacas|strong="H1241"\w* \w o|strong="H3068"\w* \w de|strong="H4480"\w* \w ovejas|strong="H6629"\w*,  
\v 4 entonces la persona que \w presente|strong="H4503"\w* su \w ofrenda|strong="H4503"\w* deberá ofrecer \w a|strong="H3068"\w* Yahvé una \w ofrenda|strong="H4503"\w* de grano de la \w décima|strong="H6241"\w* \w parte|strong="H6241"\w* de un efa\f + \fr 15:4 \ft 1 efa equivale a unos 22 litros.\f* de harina fina mezclada con la cuarta \w parte|strong="H6241"\w* de un \w hin|strong="H1969"\w*\f + \fr 15:4 \ft Un hin equivale a unos 6.5 litros.\f* de \w aceite|strong="H8081"\w*.  
\v 5 \w Y|strong="H3068"\w* prepararán \w vino|strong="H3196"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda líquida, \w la|strong="H5921"\w* cuarta parte \w de|strong="H5921"\w* un \w hin|strong="H1969"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w o|strong="H3068"\w* \w el|strong="H5921"\w* \w sacrificio|strong="H2077"\w*, \w por|strong="H5921"\w* cada \w cordero|strong="H3532"\w*.   
\p
\v 6 “‘Si es un carnero, prepararán como \w ofrenda|strong="H4503"\w* de grano \w dos|strong="H8147"\w* \w décimas|strong="H6241"\w* de efa\f + \fr 15:6 \ft 1 efa equivale a unos 22 litros.\f* de harina fina mezclada con la \w tercera|strong="H7992"\w* \w parte|strong="H6241"\w* de un \w hin|strong="H1969"\w* de \w aceite|strong="H8081"\w*;  
\v 7 y como ofrenda líquida \w ofrecerán|strong="H7126"\w* la \w tercera|strong="H7992"\w* parte de un \w hin|strong="H1969"\w* de \w vino|strong="H3196"\w*, como un aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 8 \w Cuando|strong="H3588"\w* preparen un becerro \w para|strong="H3588"\w* un \w holocausto|strong="H5930"\w* \w o|strong="H3068"\w* un \w sacrificio|strong="H2077"\w*, ya sea \w para|strong="H3588"\w* cumplir un \w voto|strong="H5088"\w* \w o|strong="H3068"\w* \w como|strong="H3588"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H3588"\w* comunión \w a|strong="H3068"\w* Yahvé,  
\v 9 entonces \w ofrecerán|strong="H7126"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* becerro una \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* grano \w de|strong="H5921"\w* \w tres|strong="H7969"\w* \w décimas|strong="H6241"\w* \w de|strong="H5921"\w* efa\f + \fr 15:9 \ft 1 efa equivale a unos 22 litros.\f* \w de|strong="H5921"\w* harina fina mezclada \w con|strong="H5921"\w* \w medio|strong="H2677"\w* \w hin|strong="H1969"\w* \w de|strong="H5921"\w* \w aceite|strong="H8081"\w*;  
\v 10 y presentarán como ofrenda líquida \w medio|strong="H2677"\w* \w hin|strong="H1969"\w* de \w vino|strong="H3196"\w*, como una ofrenda por fuego, de aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 11 \w Así|strong="H3602"\w* se \w hará|strong="H6213"\w* con cada toro, con cada \w carnero|strong="H7716"\w* \w y|strong="H7794"\w* con cada \w cordero|strong="H3532"\w* \w o|strong="H3068"\w* cabrito.  
\v 12 Según \w el|strong="H6213"\w* \w número|strong="H4557"\w* de animales que preparen, \w así|strong="H3602"\w* \w harán|strong="H6213"\w* con cada uno según la cantidad.   
\p
\v 13 “‘\w Todos|strong="H3605"\w* \w los|strong="H3605"\w* nacidos en \w el|strong="H3605"\w* país \w harán|strong="H6213"\w* \w estas|strong="H6213"\w* cosas de esta manera cuando presenten una ofrenda por fuego, de aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 14 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* un \w extranjero|strong="H1616"\w* \w que|strong="H3588"\w* reside \w con|strong="H3588"\w* ustedes, \w o|strong="H3068"\w* cualquiera \w que|strong="H3588"\w* viva \w entre|strong="H8432"\w* ustedes \w en|strong="H8432"\w* \w el|strong="H3588"\w* futuro, presenta una ofrenda \w por|strong="H3588"\w* fuego \w de|strong="H3588"\w* aroma agradable \w a|strong="H3068"\w* Yahvé, deberá hacerlo \w de|strong="H3588"\w* \w la|strong="H3588"\w* misma manera \w que|strong="H3588"\w* ustedes.  
\v 15 \w Habrá|strong="H1961"\w* un solo \w estatuto|strong="H2708"\w* \w para|strong="H1961"\w* ustedes y \w para|strong="H1961"\w* el \w extranjero|strong="H1616"\w* \w que|strong="H1616"\w* resida allí; \w será|strong="H1961"\w* un \w estatuto|strong="H2708"\w* \w perpetuo|strong="H5769"\w* \w por|strong="H6440"\w* \w todas|strong="H1755"\w* sus \w generaciones|strong="H1755"\w*. \w Ante|strong="H6440"\w* Yahvé, el \w extranjero|strong="H1616"\w* \w será|strong="H1961"\w* igual \w que|strong="H1616"\w* ustedes.  
\v 16 La misma \w ley|strong="H8451"\w* y el mismo reglamento \w se|strong="H1961"\w* aplicarán tanto \w a|strong="H3068"\w* ustedes \w como|strong="H1961"\w* al \w extranjero|strong="H1616"\w* \w que|strong="H1616"\w* resida entre ustedes’”.   
\p
\v 17 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 18 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w diles|strong="H1696"\w*: ‘Cuando lleguen \w a|strong="H3068"\w* la tierra \w a|strong="H3068"\w* la \w que|strong="H1121"\w* \w los|strong="H1121"\w* llevo,  
\v 19 al comer del \w pan|strong="H3899"\w* de la tierra, deberán presentar una \w ofrenda|strong="H8641"\w* especial \w a|strong="H3068"\w* Yahvé.  
\v 20 De la primera masa que preparen, \w ofrecerán|strong="H7311"\w* una \w torta|strong="H2471"\w* \w como|strong="H3651"\w* \w ofrenda|strong="H8641"\w* especial. La presentarán de la misma manera que la \w ofrenda|strong="H8641"\w* especial del grano de la era.  
\v 21 \w De|strong="H5414"\w* las \w primicias|strong="H7225"\w* \w de|strong="H5414"\w* su masa, le \w darán|strong="H5414"\w* \w a|strong="H3068"\w* Yahvé una \w ofrenda|strong="H8641"\w* especial \w por|strong="H5414"\w* \w todas|strong="H1755"\w* sus \w generaciones|strong="H1755"\w*.   
\p
\v 22 “‘\w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w se|strong="H3808"\w* equivocan \w y|strong="H3588"\w* \w no|strong="H3808"\w* cumplen \w todos|strong="H3605"\w* \w estos|strong="H3605"\w* \w mandamientos|strong="H4687"\w* \w que|strong="H3588"\w* Yahvé le \w ha|strong="H3808"\w* dado \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*,  
\v 23 \w es|strong="H3027"\w* decir, \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H4480"\w* Yahvé \w les|strong="H6680"\w* ha \w ordenado|strong="H6680"\w* \w por|strong="H4480"\w* \w medio|strong="H3027"\w* \w de|strong="H4480"\w* \w Moisés|strong="H4872"\w* \w desde|strong="H4480"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* dio \w la|strong="H3605"\w* \w orden|strong="H6680"\w* y \w en|strong="H4480"\w* adelante \w por|strong="H4480"\w* \w todas|strong="H3605"\w* sus \w generaciones|strong="H1755"\w*,  
\v 24 \w si|strong="H1961"\w* \w el|strong="H3605"\w* error \w se|strong="H1961"\w* \w cometió|strong="H6213"\w* sin querer \w y|strong="H1241"\w* sin \w que|strong="H1121"\w* \w la|strong="H3605"\w* comunidad \w se|strong="H1961"\w* diera cuenta, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad deberá ofrecer un \w becerro|strong="H6499"\w* \w como|strong="H1961"\w* \w holocausto|strong="H5930"\w* \w de|strong="H1121"\w* aroma agradable \w a|strong="H3068"\w* Yahvé, junto con su respectiva \w ofrenda|strong="H4503"\w* \w de|strong="H1121"\w* grano \w y|strong="H1241"\w* \w ofrenda|strong="H4503"\w* líquida, según \w el|strong="H3605"\w* reglamento, \w y|strong="H1241"\w* un \w macho|strong="H8163"\w* \w cabrío|strong="H5795"\w* \w como|strong="H1961"\w* \w ofrenda|strong="H4503"\w* por \w el|strong="H3605"\w* \w pecado|strong="H2403"\w*.  
\v 25 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* comunidad \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w serán|strong="H1931"\w* perdonados; \w porque|strong="H3588"\w* \w fue|strong="H1931"\w* un error, \w y|strong="H3588"\w* han traído \w su|strong="H1931"\w* \w ofrenda|strong="H7133"\w* \w por|strong="H5921"\w* fuego \w a|strong="H3068"\w* Yahvé, \w y|strong="H3588"\w* \w su|strong="H1931"\w* \w ofrenda|strong="H7133"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, \w para|strong="H5921"\w* reparar \w su|strong="H1931"\w* falta.  
\v 26 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* será perdonada, incluyendo al \w extranjero|strong="H1616"\w* \w que|strong="H3588"\w* resida \w entre|strong="H8432"\w* \w ellos|strong="H3605"\w*, ya \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* estuvo involucrado \w en|strong="H8432"\w* \w el|strong="H3588"\w* error involuntario.   
\p
\v 27 “‘\w Si|strong="H5315"\w* es una sola \w persona|strong="H5315"\w* la \w que|strong="H1323"\w* \w peca|strong="H2398"\w* sin darse cuenta, deberá ofrecer una \w cabra|strong="H5795"\w* de un \w año|strong="H8141"\w* como ofrenda por el \w pecado|strong="H2403"\w*.  
\v 28 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w persona|strong="H5315"\w* \w que|strong="H5921"\w* \w pecó|strong="H2398"\w* \w por|strong="H5921"\w* ignorancia. \w Al|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* esa \w persona|strong="H5315"\w*, será perdonada.  
\v 29 \w Tendrán|strong="H1961"\w* una misma \w ley|strong="H8451"\w* \w para|strong="H1961"\w* \w el|strong="H1121"\w* \w que|strong="H1616"\w* \w haga|strong="H6213"\w* algo sin querer, tanto \w para|strong="H1961"\w* \w el|strong="H1121"\w* nacido \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w como|strong="H1961"\w* \w para|strong="H1961"\w* \w el|strong="H1121"\w* \w extranjero|strong="H1616"\w* \w que|strong="H1616"\w* resida \w entre|strong="H8432"\w* ellos.   
\p
\v 30 “‘Pero \w la|strong="H1931"\w* \w persona|strong="H5315"\w* \w que|strong="H4480"\w* peque intencionalmente y \w con|strong="H4480"\w* soberbia, sea nativo \w o|strong="H3068"\w* \w extranjero|strong="H1616"\w*, \w está|strong="H1931"\w* insultando \w a|strong="H3068"\w* Yahvé. \w Esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1931"\w* eliminada \w de|strong="H4480"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 31 \w Por|strong="H3588"\w* haber despreciado \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* haber roto \w su|strong="H1931"\w* \w mandamiento|strong="H4687"\w*, \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1931"\w* cortada \w por|strong="H3588"\w* completo \w y|strong="H3588"\w* cargará \w con|strong="H3588"\w* \w su|strong="H1931"\w* propia culpa’”.   
\p
\v 32 Mientras \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w estaban|strong="H1961"\w* en \w el|strong="H1121"\w* \w desierto|strong="H4057"\w*, encontraron \w a|strong="H3068"\w* un \w hombre|strong="H1121"\w* \w recogiendo|strong="H7197"\w* \w leña|strong="H6086"\w* en \w el|strong="H1121"\w* \w día|strong="H3117"\w* \w de|strong="H1121"\w* descanso.  
\v 33 \w Los|strong="H3605"\w* \w que|strong="H5712"\w* \w lo|strong="H3605"\w* encontraron juntando \w la|strong="H3605"\w* \w leña|strong="H6086"\w* \w lo|strong="H3605"\w* llevaron ante \w Moisés|strong="H4872"\w*, Aarón y \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad.  
\v 34 \w Lo|strong="H4100"\w* \w pusieron|strong="H3240"\w* bajo vigilancia, \w porque|strong="H3588"\w* \w aún|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w había|strong="H3588"\w* determinado \w qué|strong="H3588"\w* \w se|strong="H3808"\w* debía \w hacer|strong="H6213"\w* \w con|strong="H3588"\w* \w él|strong="H3588"\w*.   
\p
\v 35 Entonces Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Ese hombre debe \w morir|strong="H4191"\w*. \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w lo|strong="H3605"\w* apedreará \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*”.  
\v 36 Así \w que|strong="H5712"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w lo|strong="H3605"\w* \w sacó|strong="H3318"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w* y \w lo|strong="H3605"\w* apedrearon hasta \w matarlo|strong="H4191"\w*, tal como Yahvé se \w lo|strong="H3605"\w* había \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.   
\p
\v 37 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*:  
\v 38 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w diles|strong="H1696"\w* \w que|strong="H5921"\w*, \w a|strong="H3068"\w* \w lo|strong="H5921"\w* largo \w de|strong="H5921"\w* sus \w generaciones|strong="H1755"\w*, \w se|strong="H5921"\w* \w hagan|strong="H6213"\w* borlas\f + \fr 15:38 \ft o, flecos (hebreo צִיצִ֛ת)\f* \w en|strong="H5921"\w* \w los|strong="H1121"\w* bordes \w de|strong="H5921"\w* su ropa, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* pongan un cordón azul \w a|strong="H3068"\w* \w la|strong="H5921"\w* borla\f + \fr 15:38 \ft o, fleco\f* \w de|strong="H5921"\w* cada borde.  
\v 39 \w Estas|strong="H6213"\w* borlas\f + \fr 15:39 \ft o, flecos\f* les \w servirán|strong="H1961"\w* \w para|strong="H1961"\w* \w que|strong="H3808"\w*, al verlas, \w se|strong="H1961"\w* acuerden \w de|strong="H5869"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w mandamientos|strong="H4687"\w* \w de|strong="H5869"\w* Yahvé y \w los|strong="H3605"\w* obedezcan, y \w no|strong="H3808"\w* \w se|strong="H1961"\w* dejen llevar por \w los|strong="H3605"\w* deseos \w de|strong="H5869"\w* su propio \w corazón|strong="H3824"\w* y \w de|strong="H5869"\w* sus \w ojos|strong="H5869"\w*, \w que|strong="H3808"\w* \w los|strong="H3605"\w* llevan \w a|strong="H3068"\w* ser infieles;  
\v 40 \w así|strong="H6918"\w* \w se|strong="H1961"\w* acordarán de cumplir \w todos|strong="H3605"\w* mis \w mandamientos|strong="H4687"\w* y \w serán|strong="H1961"\w* consagrados \w a|strong="H3068"\w* su Dios.  
\v 41 Yo \w soy|strong="H1961"\w* Yahvé, su \w Dios|strong="H3068"\w*, \w que|strong="H1961"\w* \w los|strong="H1961"\w* \w saqué|strong="H3318"\w* de la tierra de \w Egipto|strong="H4714"\w* \w para|strong="H1961"\w* ser su \w Dios|strong="H3068"\w*. Yo \w soy|strong="H1961"\w* Yahvé su \w Dios|strong="H3068"\w*”.   
\c 16  
\p
\v 1 \w Coré|strong="H7141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Izhar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Coat, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*, se unió \w a|strong="H3068"\w* Datán y Abiram, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Eliab, y \w a|strong="H3068"\w* On, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Pelet, todos ellos \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*.  
\v 2 \w Y|strong="H3068"\w* se rebelaron \w contra|strong="H6440"\w* \w Moisés|strong="H4872"\w*. Con ellos había \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w* \w hombres|strong="H1121"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, líderes \w de|strong="H6440"\w* la comunidad, miembros del consejo y \w hombres|strong="H1121"\w* \w de|strong="H6440"\w* buena reputación.  
\v 3 \w Se|strong="H5921"\w* agruparon \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* Aarón, \w y|strong="H3588"\w* \w les|strong="H5921"\w* dijeron: “¡\w Se|strong="H5921"\w* están tomando demasiadas atribuciones! \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w es|strong="H3588"\w* \w santa|strong="H6918"\w*, \w todos|strong="H3605"\w* \w y|strong="H3588"\w* \w cada|strong="H3605"\w* uno \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H3588"\w* Yahvé \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w nosotros|strong="H3605"\w*. ¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* \w se|strong="H5921"\w* creen ustedes superiores \w a|strong="H3068"\w* \w la|strong="H5921"\w* asamblea \w de|strong="H5921"\w* Yahvé?”.   
\p
\v 4 Cuando \w Moisés|strong="H4872"\w* \w escuchó|strong="H8085"\w* esto, \w se|strong="H5921"\w* postró \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra.  
\v 5 Luego les \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Coré|strong="H7141"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus seguidores: “\w Mañana|strong="H1242"\w* por \w la|strong="H3605"\w* \w mañana|strong="H1242"\w*, Yahvé demostrará quiénes son suyos y quiénes son \w santos|strong="H6918"\w*, y \w a|strong="H3068"\w* esos \w los|strong="H3605"\w* dejará acercarse \w a|strong="H3068"\w* \w él|strong="H3605"\w*. Al \w que|strong="H3045"\w* \w él|strong="H3605"\w* elija, \w le|strong="H1242"\w* permitirá acercarse.  
\v 6 \w Hagan|strong="H6213"\w* \w lo|strong="H6213"\w* siguiente: \w tomen|strong="H3947"\w* \w incensarios|strong="H4289"\w*, \w Coré|strong="H7141"\w* y \w todo|strong="H3605"\w* su grupo,  
\v 7 pónganles brasas \w y|strong="H5921"\w* échenles incienso \w mañana|strong="H4279"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé. \w El|strong="H1931"\w* \w hombre|strong="H1121"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* Yahvé elija, \w ese|strong="H1931"\w* \w será|strong="H1961"\w* \w el|strong="H1931"\w* consagrado. ¡\w Son|strong="H1961"\w* ustedes, \w los|strong="H1121"\w* levitas, \w los|strong="H1121"\w* \w que|strong="H1931"\w* han llegado demasiado lejos!”.   
\p
\v 8 \w Moisés|strong="H4872"\w* también le dijo \w a|strong="H3068"\w* \w Coré|strong="H7141"\w*: “¡Escúchenme bien, levitas!  
\v 9 ¿Les parece \w poca|strong="H4592"\w* cosa \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w los|strong="H3588"\w* haya separado \w del|strong="H4480"\w* resto \w de|strong="H4480"\w* \w la|strong="H3588"\w* comunidad \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w para|strong="H3588"\w* acercarlos \w a|strong="H3068"\w* \w él|strong="H3588"\w*, encargándoles \w el|strong="H3588"\w* servicio \w del|strong="H4480"\w* \w tabernáculo|strong="H4908"\w* \w de|strong="H4480"\w* Yahvé \w y|strong="H3588"\w* poniéndolos \w delante|strong="H6440"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* comunidad \w para|strong="H3588"\w* servirles?  
\v 10 \w Los|strong="H1121"\w* ha acercado \w a|strong="H3068"\w* ustedes, \w y|strong="H1571"\w* \w con|strong="H1571"\w* ustedes \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus hermanos levitas. ¿\w Y|strong="H3068"\w* ahora \w también|strong="H1571"\w* \w buscan|strong="H1245"\w* quedarse \w con|strong="H1571"\w* \w el|strong="H3605"\w* \w sacerdocio|strong="H3550"\w*?  
\v 11 ¡\w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w es|strong="H1931"\w* \w que|strong="H3588"\w* tú \w y|strong="H3588"\w* tus seguidores \w se|strong="H1931"\w* han rebelado \w contra|strong="H5921"\w* Yahvé! \w Pues|strong="H3588"\w*, ¿\w quién|strong="H4100"\w* \w es|strong="H1931"\w* Aarón \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H1931"\w* quejen \w de|strong="H5921"\w* \w él|strong="H1931"\w*?”.   
\p
\v 12 Después, \w Moisés|strong="H4872"\w* \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* Datán y \w a|strong="H3068"\w* Abiram, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Eliab, pero ellos respondieron: “¡\w No|strong="H3808"\w* \w iremos|strong="H5927"\w*!  
\v 13 ¿\w Te|strong="H5921"\w* parece \w poco|strong="H4592"\w* habernos sacado \w de|strong="H5921"\w* una tierra \w que|strong="H3588"\w* mana \w leche|strong="H2461"\w* \w y|strong="H1571"\w* \w miel|strong="H1706"\w* \w para|strong="H5921"\w* hacernos \w morir|strong="H4191"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w y|strong="H1571"\w* \w que|strong="H3588"\w* ahora \w encima|strong="H5921"\w* quieras portarte \w como|strong="H3588"\w* un dictador \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w*?  
\v 14 \w Y|strong="H3068"\w* \w lo|strong="H3808"\w* peor es \w que|strong="H3808"\w* \w ni|strong="H3808"\w* siquiera nos \w has|strong="H5414"\w* llevado \w a|strong="H3068"\w* una tierra \w que|strong="H3808"\w* fluya \w leche|strong="H2461"\w* y \w miel|strong="H1706"\w*, \w ni|strong="H3808"\w* nos \w has|strong="H5414"\w* \w dado|strong="H5414"\w* \w campos|strong="H7704"\w* \w ni|strong="H3808"\w* viñedos como \w herencia|strong="H5159"\w*. ¿Crees \w que|strong="H3808"\w* puedes engañar \w a|strong="H3068"\w* \w estos|strong="H1992"\w* hombres? ¡Definitivamente \w no|strong="H3808"\w* \w iremos|strong="H5927"\w*!”.   
\p
\v 15 \w Moisés|strong="H4872"\w* \w se|strong="H3808"\w* molestó muchísimo y le dijo \w a|strong="H3068"\w* Yahvé: “\w No|strong="H3808"\w* aceptes \w sus|strong="H1992"\w* ofrendas. Yo \w no|strong="H3808"\w* \w les|strong="H1992"\w* he quitado \w ni|strong="H3808"\w* un solo burro, \w ni|strong="H3808"\w* le he hecho daño \w a|strong="H3068"\w* \w ninguno|strong="H3808"\w* de \w ellos|strong="H1992"\w*”.   
\p
\v 16 Luego, \w Moisés|strong="H4872"\w* le dijo \w a|strong="H3068"\w* \w Coré|strong="H7141"\w*: “Tú y \w todos|strong="H3605"\w* tus seguidores preséntense \w mañana|strong="H4279"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé; vayan tú y \w ellos|strong="H1992"\w*, junto con Aarón.  
\v 17 \w Que|strong="H5921"\w* cada uno \w tome|strong="H3947"\w* su incensario \w y|strong="H5921"\w* \w le|strong="H5921"\w* ponga incienso; \w y|strong="H5921"\w* cada uno \w de|strong="H5921"\w* ustedes, \w los|strong="H5921"\w* \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w*, lleve su incensario \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé. Tú \w y|strong="H5921"\w* Aarón también llevarán \w el|strong="H5921"\w* suyo”.   
\p
\v 18 Así \w que|strong="H5921"\w* cada uno \w tomó|strong="H3947"\w* su incensario, \w le|strong="H5921"\w* \w puso|strong="H7760"\w* brasas \w e|strong="H3068"\w* incienso, \w y|strong="H5921"\w* \w se|strong="H5921"\w* pararon \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* Aarón.  
\v 19 Cuando \w Coré|strong="H7141"\w* ya había reunido \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w en|strong="H5921"\w* \w contra|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea.   
\p
\v 20 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, \w diciendo|strong="H1696"\w*:  
\v 21 “¡Apártense de \w esta|strong="H2063"\w* comunidad, porque voy \w a|strong="H3068"\w* \w destruirlos|strong="H3615"\w* \w en|strong="H8432"\w* un instante!”.   
\p
\v 22 Pero \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* postraron \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra \w y|strong="H5921"\w* clamaron: “Oh Dios, Dios \w que|strong="H5921"\w* da aliento \w de|strong="H5921"\w* vida \w a|strong="H3068"\w* \w todos|strong="H3605"\w*, ¿\w te|strong="H5921"\w* vas \w a|strong="H3068"\w* enojar \w con|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea solo \w porque|strong="H5921"\w* un hombre \w pecó|strong="H2398"\w*?”.   
\p
\v 23 Entonces Yahvé le respondió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*:  
\v 24 “Dile \w a|strong="H3068"\w* la comunidad: ‘¡Aléjense de los \w alrededores|strong="H5439"\w* de las \w tiendas|strong="H4908"\w* de \w Coré|strong="H7141"\w*, Datán y Abiram!’”.   
\p
\v 25 \w Moisés|strong="H4872"\w* se \w levantó|strong="H6965"\w* y \w fue|strong="H3212"\w* \w a|strong="H3068"\w* donde estaban Datán y Abiram, y los \w ancianos|strong="H2205"\w* de \w Israel|strong="H3478"\w* lo siguieron.  
\v 26 \w Y|strong="H3068"\w* \w le|strong="H5921"\w* advirtió \w a|strong="H3068"\w* \w la|strong="H5921"\w* comunidad: “¡Apártense, \w por|strong="H5921"\w* favor, \w de|strong="H5921"\w* \w las|strong="H5921"\w* tiendas \w de|strong="H5921"\w* \w estos|strong="H3605"\w* hombres perversos! \w No|strong="H6435"\w* \w toquen|strong="H5060"\w* \w nada|strong="H3605"\w* \w que|strong="H4994"\w* \w les|strong="H5921"\w* pertenezca, \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H4994"\w* ustedes también sean destruidos \w por|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*”.   
\p
\v 27 Entonces \w la|strong="H5921"\w* gente \w se|strong="H5921"\w* alejó \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w alrededores|strong="H5439"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w tiendas|strong="H4908"\w* \w de|strong="H5921"\w* \w Coré|strong="H7141"\w*, Datán \w y|strong="H5921"\w* Abiram. \w Por|strong="H5921"\w* su parte, Datán \w y|strong="H5921"\w* Abiram \w salieron|strong="H3318"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* quedaron \w de|strong="H5921"\w* pie \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* sus \w tiendas|strong="H4908"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus esposas, sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* sus pequeños.   
\p
\v 28 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* dijo: “\w Con|strong="H3588"\w* \w esto|strong="H2063"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H2063"\w* \w cosas|strong="H3045"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* las \w hago|strong="H6213"\w* \w por|strong="H3588"\w* mi propia cuenta.  
\v 29 \w Si|strong="H3808"\w* \w estos|strong="H3605"\w* hombres \w mueren|strong="H4191"\w* \w de|strong="H5921"\w* forma natural \w como|strong="H5921"\w* \w cualquier|strong="H3605"\w* otra persona, \w o|strong="H3068"\w* \w si|strong="H3808"\w* sufren \w el|strong="H5921"\w* destino normal \w de|strong="H5921"\w* \w todos|strong="H3605"\w*, entonces Yahvé \w no|strong="H3808"\w* \w me|strong="H5921"\w* \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w*.  
\v 30 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* Yahvé hace \w que|strong="H3588"\w* ocurra algo totalmente nuevo, \w y|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w se|strong="H3045"\w* \w abre|strong="H6475"\w* \w y|strong="H3588"\w* \w se|strong="H3045"\w* \w los|strong="H3605"\w* traga junto \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3588"\w* tienen, \w y|strong="H3588"\w* bajan \w vivos|strong="H2416"\w* al Seol,\f + \fr 16:30 \ft El Seol es el lugar de los muertos.\f* \w entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w estos|strong="H3605"\w* hombres han despreciado \w a|strong="H3068"\w* Yahvé”.   
\p
\v 31 Apenas terminó \w de|strong="H8478"\w* decir estas \w palabras|strong="H1697"\w*, \w el|strong="H3605"\w* suelo \w se|strong="H1961"\w* abrió \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w ellos|strong="H3605"\w*.  
\v 32 \w La|strong="H3605"\w* tierra \w abrió|strong="H6605"\w* su \w boca|strong="H6310"\w* y se \w los|strong="H3605"\w* tragó junto con sus \w familias|strong="H1004"\w*, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* seguidores de \w Coré|strong="H7141"\w* y \w todas|strong="H3605"\w* sus posesiones.  
\v 33 \w Bajaron|strong="H3381"\w* \w vivos|strong="H2416"\w* \w al|strong="H5921"\w* Seol\f + \fr 16:33 \ft El Seol es el lugar de los muertos.\f* \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w les|strong="H1992"\w* pertenecía. \w La|strong="H5921"\w* tierra \w se|strong="H1992"\w* cerró \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w* \w y|strong="H5921"\w* desaparecieron \w de|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* asamblea.  
\v 34 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas \w que|strong="H3588"\w* estaban \w alrededor|strong="H5439"\w* \w huyeron|strong="H5127"\w* al escuchar sus gritos, \w pues|strong="H3588"\w* decían: “¡Corran, \w no|strong="H6435"\w* vaya \w a|strong="H3068"\w* ser \w que|strong="H3588"\w* \w la|strong="H3605"\w* tierra nos \w trague|strong="H1104"\w* \w a|strong="H3068"\w* \w nosotros|strong="H3605"\w* también!”.  
\v 35 \w Y|strong="H3068"\w* de parte de Yahvé \w salió|strong="H3318"\w* un fuego que consumió \w a|strong="H3068"\w* los \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w* hombres que estaban ofreciendo el incienso.   
\p
\v 36 Yahvé le habló \w a|strong="H3068"\w* Moisés, diciendo:  
\v 37 “Dile \w a|strong="H3068"\w* Eleazar, hijo del sacerdote Aarón, que saque los incensarios de entre los restos del fuego y esparza las brasas lejos de allí, porque los incensarios son sagrados.  
\v 38 Tomen los incensarios de estos hombres que pecaron y les costó la vida, y aplástenlos para hacer láminas con las que se recubrirá el altar. Como los presentaron delante de Yahvé, son sagrados. Servirán como una señal de advertencia para los hijos de Israel”.   
\p
\v 39 El sacerdote Eleazar recogió los incensarios de bronce que habían traído los hombres que murieron quemados, y mandó que los martillaran para recubrir el altar.  
\v 40 Esto se hizo para recordar \w a|strong="H3068"\w* los hijos de Israel que ninguna persona ajena \w a|strong="H3068"\w* la familia de Aarón debe acercarse \w a|strong="H3068"\w* quemar incienso delante de Yahvé, para evitar sufrir el mismo castigo de Coré y sus seguidores, tal como Yahvé se lo había advertido por medio de Moisés.   
\p
\v 41 Al día siguiente, toda la comunidad de los israelitas comenzó \w a|strong="H3068"\w* murmurar contra Moisés y Aarón, diciendo: “¡Ustedes han matado al pueblo de Yahvé!”.   
\p
\v 42 Pero mientras la comunidad se amotinaba contra Moisés y Aarón, se voltearon hacia la Tienda del Encuentro y vieron que la nube la cubría y la gloria de Yahvé se había manifestado.  
\v 43 Moisés y Aarón fueron al frente de la Tienda del Encuentro,  
\v 44 y Yahvé le habló \w a|strong="H3068"\w* Moisés, diciendo:  
\v 45 “¡Aléjense de esta comunidad, porque voy \w a|strong="H3068"\w* destruirlos en un instante!”. Entonces ellos cayeron rostro en tierra.   
\p
\v 46 \w Y|strong="H3068"\w* Moisés le dijo \w a|strong="H3068"\w* Aarón: “¡Toma tu incensario, ponle brasas del altar y échale incienso! Ve rápido \w a|strong="H3068"\w* donde está la comunidad y haz expiación por ellos, porque el enojo de Yahvé se ha desatado. ¡La mortandad ya ha comenzado!”.   
\p
\v 47 Aarón hizo lo que Moisés le ordenó y corrió hacia el medio de la asamblea. La mortandad ya había empezado entre la gente. Echó el incienso en el fuego \w e|strong="H3068"\w* hizo expiación por el pueblo.  
\v 48 Se paró entre los muertos y los vivos, y la plaga se detuvo.  
\v 49 Fueron catorce mil setecientas las personas que murieron por esa plaga, sin contar \w a|strong="H3068"\w* los que murieron por culpa de Coré.  
\v 50 Luego Aarón regresó \w a|strong="H3068"\w* donde estaba Moisés, \w a|strong="H3068"\w* la entrada de la Tienda del Encuentro, pues la plaga se había detenido.   
\c 17  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “Habla \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* Israel \w y|strong="H3588"\w* pídeles doce varas, una \w por|strong="H3588"\w* cada jefe \w de|strong="H3588"\w* sus familias patriarcales. Escribe \w el|strong="H3588"\w* nombre \w de|strong="H3588"\w* cada uno \w en|strong="H3588"\w* \w su|strong="H3588"\w* respectiva vara.  
\v 3 \w Y|strong="H3068"\w* escribirás \w el|strong="H3588"\w* nombre \w de|strong="H3588"\w* Aarón \w en|strong="H3588"\w* \w la|strong="H3588"\w* vara \w de|strong="H3588"\w* \w la|strong="H3588"\w* tribu \w de|strong="H3588"\w* Leví. \w Habrá|strong="H1961"\w* una vara \w por|strong="H3588"\w* cada jefe \w de|strong="H3588"\w* familia.  
\v 4 Luego las pondrás en la Tienda \w del|strong="H4196"\w* Encuentro, frente al arca \w del|strong="H4196"\w* Testimonio, donde me reúno con ustedes.  
\v 5 \w Y|strong="H3068"\w* \w sucederá|strong="H1961"\w* \w que|strong="H1931"\w* \w la|strong="H1931"\w* vara del \w hombre|strong="H1121"\w* \w que|strong="H1931"\w* yo elija retoñará. \w De|strong="H6440"\w* \w esta|strong="H1931"\w* manera haré \w que|strong="H1931"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* dejen \w de|strong="H6440"\w* quejarse y murmurar \w contra|strong="H6440"\w* ustedes \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H1961"\w*”.   
\p
\v 6 \w Moisés|strong="H4872"\w* habló \w con|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus líderes \w le|strong="H5921"\w* entregaron varas, una \w por|strong="H5921"\w* \w cada|strong="H3605"\w* jefe \w de|strong="H5921"\w* familia, siendo doce varas \w en|strong="H5921"\w* total. \w La|strong="H5921"\w* vara \w de|strong="H5921"\w* Aarón estaba \w entre|strong="H5921"\w* \w ellas|strong="H5921"\w*.  
\v 7 \w Moisés|strong="H4872"\w* depositó \w las|strong="H5921"\w* varas \w delante|strong="H5921"\w* \w de|strong="H5921"\w* Yahvé \w en|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Testimonio.   
\p
\v 8 Al día siguiente, cuando \w Moisés|strong="H4872"\w* entró en la Tienda del Testimonio, vio que la vara \w de|strong="H6440"\w* Aarón, que representaba \w a|strong="H3068"\w* la casa \w de|strong="H6440"\w* Leví, había retoñado; tenía brotes, había florecido y producido almendras maduras.  
\v 9 Entonces \w Moisés|strong="H4872"\w* sacó todas las varas de la presencia de Yahvé y se las mostró \w a|strong="H3068"\w* todos los hijos de Israel. Ellos las vieron, y cada hombre tomó su propia vara.   
\p
\v 10 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Moisés: “Vuelve \w a|strong="H3068"\w* poner \w la|strong="H5921"\w* vara \w de|strong="H5921"\w* Aarón frente \w al|strong="H5921"\w* Testimonio, \w para|strong="H5921"\w* guardarla \w como|strong="H5921"\w* advertencia \w para|strong="H5921"\w* \w los|strong="H5921"\w* rebeldes; \w así|strong="H2063"\w* pondrás fin \w a|strong="H3068"\w* sus quejas \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*, \w y|strong="H5921"\w* \w no|strong="H5921"\w* morirán”.  
\v 11 \w Moisés|strong="H4872"\w* \w hizo|strong="H5414"\w* exactamente \w lo|strong="H5921"\w* \w que|strong="H3588"\w* Yahvé \w le|strong="H5921"\w* \w había|strong="H3588"\w* ordenado.   
\p
\v 12 Pero \w los|strong="H5921"\w* hijos \w de|strong="H5921"\w* Israel \w le|strong="H5921"\w* \w dijeron|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¡\w Nos|strong="H5921"\w* vamos \w a|strong="H3068"\w* morir! ¡Estamos perdidos! ¡Todos estamos arruinados!  
\v 13 ¡Cualquiera que se acerque al tabernáculo de Yahvé muere! ¿Acaso vamos \w a|strong="H3068"\w* perecer todos?”   
\c 18  
\p
\v 1 Yahvé le dijo \w a|strong="H3068"\w* Aarón: “Tú, tus \w hijos|strong="H1121"\w* y tu \w familia|strong="H1004"\w* cargarán con la responsabilidad \w de|strong="H1121"\w* las ofensas contra \w el|strong="H1121"\w* \w santuario|strong="H4720"\w*; y tú y tus \w hijos|strong="H1121"\w* cargarán con la responsabilidad \w de|strong="H1121"\w* las ofensas cometidas en \w el|strong="H1121"\w* ejercicio \w de|strong="H1121"\w* su \w sacerdocio|strong="H3550"\w*.  
\v 2 Trae \w también|strong="H1571"\w* \w contigo|strong="H5921"\w* \w a|strong="H3068"\w* tus hermanos \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* \w Leví|strong="H3878"\w*, \w la|strong="H5921"\w* \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* tu padre, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* unan \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H1571"\w* \w te|strong="H5921"\w* ayuden; pero solo tú \w y|strong="H1571"\w* tus \w hijos|strong="H1121"\w* estarán frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* \w Testimonio|strong="H5715"\w*.  
\v 3 \w Ellos|strong="H1992"\w* \w se|strong="H3808"\w* encargarán de ayudarte \w y|strong="H1571"\w* de cuidar \w toda|strong="H3605"\w* \w la|strong="H1571"\w* Tienda; pero \w no|strong="H3808"\w* deberán acercarse \w a|strong="H3068"\w* \w los|strong="H1992"\w* objetos \w sagrados|strong="H6944"\w* \w ni|strong="H3808"\w* al \w altar|strong="H4196"\w*, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w* \w ni|strong="H3808"\w* \w ellos|strong="H1992"\w* \w ni|strong="H3808"\w* ustedes.  
\v 4 \w Se|strong="H5921"\w* unirán \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* encargarán \w del|strong="H5921"\w* cuidado \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* su servicio. \w Ninguna|strong="H3605"\w* persona extraña \w podrá|strong="H3808"\w* acercarse \w a|strong="H3068"\w* ustedes.   
\p
\v 5 “Ustedes \w se|strong="H1961"\w* encargarán \w del|strong="H5921"\w* cuidado \w del|strong="H5921"\w* \w santuario|strong="H6944"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w mi|strong="H5921"\w* \w enojo|strong="H7110"\w* \w no|strong="H3808"\w* vuelva \w a|strong="H3068"\w* caer \w sobre|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 6 \w Yo|strong="H2009"\w* mismo he escogido \w a|strong="H3068"\w* sus hermanos \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w de|strong="H1121"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. Ellos son un regalo \w para|strong="H5414"\w* ustedes, dedicados \w a|strong="H3068"\w* Yahvé, \w para|strong="H5414"\w* realizar \w el|strong="H1121"\w* servicio \w de|strong="H1121"\w* la Tienda del Encuentro.  
\v 7 Pero tú y tus \w hijos|strong="H1121"\w* serán \w los|strong="H1121"\w* únicos \w que|strong="H1697"\w* ejercerán \w el|strong="H3605"\w* \w sacerdocio|strong="H3550"\w* en \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* respecta al \w altar|strong="H4196"\w* y \w a|strong="H3068"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* está detrás \w del|strong="H4196"\w* velo. Ustedes \w servirán|strong="H5647"\w* allí. Les he \w dado|strong="H5414"\w* \w el|strong="H3605"\w* servicio \w del|strong="H4196"\w* \w sacerdocio|strong="H3550"\w* como un regalo. \w Cualquier|strong="H3605"\w* \w extraño|strong="H1121"\w* \w que|strong="H1697"\w* se acerque \w será|strong="H5414"\w* condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*”.   
\p
\v 8 Yahvé también le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Aarón: “\w Yo|strong="H2009"\w* \w mismo|strong="H3605"\w* te he \w puesto|strong="H5414"\w* \w a|strong="H3068"\w* cargo \w de|strong="H1121"\w* las \w ofrendas|strong="H8641"\w* \w que|strong="H1121"\w* me presentan, es decir, \w de|strong="H1121"\w* \w todas|strong="H3605"\w* las cosas sagradas \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. Te las he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* ti y \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* como una porción permanente, debido \w a|strong="H3068"\w* tu consagración.  
\v 9 \w De|strong="H4480"\w* las \w ofrendas|strong="H7133"\w* santísimas \w que|strong="H4480"\w* \w no|strong="H1961"\w* \w se|strong="H1961"\w* queman \w en|strong="H4480"\w* \w el|strong="H1931"\w* fuego, \w lo|strong="H1931"\w* siguiente \w será|strong="H1961"\w* \w para|strong="H4480"\w* \w ti|strong="H4480"\w*: \w toda|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H4480"\w* grano, \w toda|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w por|strong="H4480"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* y \w toda|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w por|strong="H4480"\w* \w la|strong="H1931"\w* culpa \w que|strong="H4480"\w* \w me|strong="H4480"\w* presenten. \w Todo|strong="H3605"\w* \w esto|strong="H2088"\w* \w será|strong="H1961"\w* \w santísimo|strong="H6944"\w* \w para|strong="H4480"\w* \w ti|strong="H4480"\w* y \w para|strong="H4480"\w* tus \w hijos|strong="H1121"\w*.  
\v 10 \w Lo|strong="H3605"\w* comerán \w como|strong="H1961"\w* algo \w santísimo|strong="H6944"\w*. Solo \w los|strong="H3605"\w* \w varones|strong="H2145"\w* podrán comerlo. \w Será|strong="H1961"\w* \w sagrado|strong="H6944"\w* \w para|strong="H1961"\w* ti.   
\p
\v 11 “\w También|strong="H2088"\w* \w será|strong="H5414"\w* tuyo \w lo|strong="H2088"\w* siguiente: las \w ofrendas|strong="H8641"\w* especiales \w que|strong="H1121"\w* \w los|strong="H1121"\w* israelitas \w presenten|strong="H5414"\w* como un don. Te las he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* ti, \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* tus \w hijas|strong="H1323"\w*, como una \w ley|strong="H2706"\w* permanente. \w Cualquier|strong="H3605"\w* persona \w de|strong="H1121"\w* tu \w familia|strong="H1004"\w* \w que|strong="H1121"\w* \w esté|strong="H2088"\w* ritualmente \w pura|strong="H2889"\w* podrá comer \w de|strong="H1121"\w* ellas.   
\p
\v 12 “Te \w doy|strong="H5414"\w* \w lo|strong="H3605"\w* mejor del \w aceite|strong="H3323"\w* puro, \w lo|strong="H3605"\w* mejor del \w vino|strong="H8492"\w* nuevo y del \w grano|strong="H1715"\w*; es decir, las \w primicias|strong="H7225"\w* \w que|strong="H3605"\w* \w ellos|strong="H3605"\w* le presentan \w a|strong="H3068"\w* Yahvé.  
\v 13 \w Los|strong="H3605"\w* primeros frutos de \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w la|strong="H3605"\w* tierra produzca y \w que|strong="H1961"\w* traigan \w a|strong="H3068"\w* Yahvé, \w serán|strong="H1961"\w* \w tuyos|strong="H1004"\w*. \w Cualquier|strong="H3605"\w* persona de tu \w familia|strong="H1004"\w* \w que|strong="H1961"\w* \w esté|strong="H1961"\w* \w pura|strong="H2889"\w* podrá comerlos.   
\p
\v 14 “\w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w sea|strong="H1961"\w* consagrado por completo en \w Israel|strong="H3478"\w* \w será|strong="H1961"\w* tuyo.  
\v 15 \w El|strong="H3605"\w* primer nacido de \w toda|strong="H3605"\w* criatura, \w sea|strong="H1961"\w* hombre \w o|strong="H3068"\w* animal, \w que|strong="H1961"\w* ofrezcan \w a|strong="H3068"\w* Yahvé, \w será|strong="H1961"\w* tuyo. Sin embargo, deberás cobrar \w el|strong="H3605"\w* rescate por \w el|strong="H3605"\w* \w primogénito|strong="H1060"\w* del hombre y por \w el|strong="H3605"\w* \w primogénito|strong="H1060"\w* de \w los|strong="H3605"\w* animales impuros.  
\v 16 \w El|strong="H1931"\w* \w precio|strong="H3701"\w* del rescate por \w los|strong="H1121"\w* niños \w de|strong="H2568"\w* un \w mes|strong="H2320"\w* \w de|strong="H2568"\w* nacidos \w será|strong="H1931"\w* \w de|strong="H2568"\w* \w cinco|strong="H2568"\w* \w siclos|strong="H8255"\w* \w de|strong="H2568"\w* \w plata|strong="H3701"\w*, según \w el|strong="H1931"\w* peso oficial del \w santuario|strong="H6944"\w*, \w que|strong="H1931"\w* equivale \w a|strong="H3068"\w* \w veinte|strong="H6242"\w* \w geras|strong="H1626"\w*.\f + \fr 18:16 \ft Un gera equivale a unos 0,5 gramos.\f*   
\p
\v 17 “Pero \w no|strong="H3808"\w* cobrarás rescate \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w primogénito|strong="H1060"\w* \w de|strong="H5921"\w* una vaca, \w de|strong="H5921"\w* una oveja \w o|strong="H3068"\w* \w de|strong="H5921"\w* una \w cabra|strong="H5795"\w*, ya \w que|strong="H3808"\w* \w son|strong="H3808"\w* \w sagrados|strong="H6944"\w*. \w Rociarás|strong="H2236"\w* \w su|strong="H1992"\w* \w sangre|strong="H1818"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* quemarás \w su|strong="H1992"\w* grasa \w como|strong="H5921"\w* una ofrenda \w por|strong="H5921"\w* fuego, \w de|strong="H5921"\w* aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 18 La \w carne|strong="H1320"\w* de esos animales \w será|strong="H1961"\w* tuya; al igual \w que|strong="H1961"\w* el pecho de la \w ofrenda|strong="H8573"\w* especial y la \w pierna|strong="H7785"\w* \w derecha|strong="H3225"\w*, te pertenecerán.  
\v 19 \w Todas|strong="H3605"\w* las \w ofrendas|strong="H8641"\w* \w sagradas|strong="H6944"\w* \w que|strong="H1931"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w le|strong="H1931"\w* \w presenten|strong="H5414"\w* \w a|strong="H3068"\w* Yahvé, te las \w doy|strong="H5414"\w* \w a|strong="H3068"\w* ti, \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* tus \w hijas|strong="H1323"\w* \w como|strong="H1931"\w* una porción \w para|strong="H5414"\w* \w siempre|strong="H5769"\w*. \w Es|strong="H1931"\w* un \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* \w sal|strong="H4417"\w* permanente \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w para|strong="H5414"\w* ti y \w para|strong="H5414"\w* tus descendientes”.   
\p
\v 20 Yahvé le dijo \w a|strong="H3068"\w* Aarón: “\w No|strong="H3808"\w* \w tendrás|strong="H1961"\w* \w herencia|strong="H5159"\w* \w en|strong="H8432"\w* la tierra \w de|strong="H1121"\w* ellos, \w ni|strong="H3808"\w* \w se|strong="H1961"\w* te dará \w ninguna|strong="H3808"\w* porción \w entre|strong="H8432"\w* ellos. Yo \w soy|strong="H1961"\w* tu porción y tu \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.   
\p
\v 21 “\w A|strong="H3068"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3878"\w* \w les|strong="H1992"\w* he \w dado|strong="H5414"\w* como \w herencia|strong="H5159"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* diezmos \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* cambio del trabajo \w que|strong="H1121"\w* realizan al \w servir|strong="H5647"\w* en \w la|strong="H3605"\w* Tienda del Encuentro.  
\v 22 \w A|strong="H3068"\w* partir \w de|strong="H5750"\w* ahora, \w los|strong="H1121"\w* demás \w hijos|strong="H1121"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* deberán acercarse \w a|strong="H3068"\w* la Tienda del Encuentro, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* carguen con \w culpa|strong="H2399"\w* y \w mueran|strong="H4191"\w*.  
\v 23 \w Solo|strong="H1931"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* realizarán \w el|strong="H1931"\w* servicio \w de|strong="H1121"\w* \w la|strong="H1931"\w* Tienda del Encuentro y cargarán con \w la|strong="H1931"\w* responsabilidad \w de|strong="H1121"\w* \w sus|strong="H1931"\w* errores. \w Esta|strong="H1931"\w* \w será|strong="H1931"\w* una ley permanente \w por|strong="H5769"\w* \w todas|strong="H1755"\w* \w sus|strong="H1931"\w* \w generaciones|strong="H1755"\w*. \w No|strong="H3808"\w* recibirán tierras \w como|strong="H1931"\w* \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 24 \w Porque|strong="H3588"\w* \w los|strong="H1992"\w* diezmos \w que|strong="H3588"\w* \w los|strong="H1992"\w* israelitas presentan \w como|strong="H3588"\w* \w ofrenda|strong="H8641"\w* \w a|strong="H3068"\w* Yahvé, \w se|strong="H5921"\w* \w los|strong="H1992"\w* he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* \w como|strong="H3588"\w* \w su|strong="H1992"\w* \w herencia|strong="H5159"\w*. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w les|strong="H1992"\w* he dicho \w que|strong="H3588"\w* \w no|strong="H3808"\w* tendrán \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 25 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 26 “\w Habla|strong="H1696"\w* \w con|strong="H4480"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* reciban \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w los|strong="H1121"\w* diezmos \w que|strong="H3588"\w* les he \w dado|strong="H5414"\w* \w como|strong="H3588"\w* \w herencia|strong="H5159"\w*, ustedes deberán presentarle \w a|strong="H3068"\w* Yahvé una \w ofrenda|strong="H8641"\w* \w de|strong="H4480"\w* esos diezmos, \w es|strong="H3588"\w* decir, \w la|strong="H3588"\w* \w décima|strong="H4643"\w* parte \w del|strong="H4480"\w* diezmo.  
\v 27 Esta \w ofrenda|strong="H8641"\w* \w se|strong="H4480"\w* les contará \w a|strong="H3068"\w* ustedes como si \w fuera|strong="H4480"\w* el \w grano|strong="H1715"\w* \w de|strong="H4480"\w* la era y el vino \w del|strong="H4480"\w* \w lagar|strong="H3342"\w*.  
\v 28 \w Así|strong="H3651"\w* \w también|strong="H1571"\w* ustedes \w presentarán|strong="H5414"\w* una \w ofrenda|strong="H8641"\w* \w a|strong="H3068"\w* Yahvé \w de|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* diezmos \w que|strong="H4480"\w* reciban \w de|strong="H4480"\w* \w los|strong="H1121"\w* israelitas; \w y|strong="H1571"\w* \w de|strong="H4480"\w* allí le \w darán|strong="H5414"\w* \w la|strong="H1571"\w* \w ofrenda|strong="H8641"\w* \w de|strong="H4480"\w* Yahvé \w al|strong="H4480"\w* \w sacerdote|strong="H3548"\w* Aarón.  
\v 29 \w De|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w dones|strong="H4979"\w* \w que|strong="H4480"\w* reciban, deberán presentar \w la|strong="H3605"\w* \w ofrenda|strong="H8641"\w* \w que|strong="H4480"\w* le corresponde \w a|strong="H3068"\w* Yahvé; tomarán \w la|strong="H3605"\w* mejor parte y \w la|strong="H3605"\w* consagrarán’.   
\p
\v 30 “\w Por|strong="H4480"\w* lo tanto, diles: ‘Cuando ustedes ofrezcan la mejor parte, el resto \w se|strong="H4480"\w* les contará \w a|strong="H3068"\w* los \w levitas|strong="H3881"\w* como si \w fuera|strong="H4480"\w* la cosecha \w de|strong="H4480"\w* la era y \w del|strong="H4480"\w* \w lagar|strong="H3342"\w*.  
\v 31 Podrán comerlo \w en|strong="H3588"\w* \w cualquier|strong="H3605"\w* \w lugar|strong="H4725"\w*, ustedes \w y|strong="H3588"\w* \w sus|strong="H1931"\w* \w familias|strong="H1004"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* pago \w por|strong="H3588"\w* \w el|strong="H1931"\w* servicio \w que|strong="H3588"\w* prestan \w en|strong="H3588"\w* \w la|strong="H1931"\w* Tienda del Encuentro.  
\v 32 \w Al|strong="H5921"\w* apartar \w la|strong="H5921"\w* mejor parte, \w no|strong="H3808"\w* cometerán \w ningún|strong="H3808"\w* \w pecado|strong="H2399"\w*. \w Tampoco|strong="H3808"\w* \w profanarán|strong="H2490"\w* \w las|strong="H5921"\w* ofrendas sagradas \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w así|strong="H6918"\w* \w no|strong="H3808"\w* \w morirán|strong="H4191"\w*’”.   
\c 19  
\p
\v 1 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* una exigencia \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w que|strong="H3808"\w* Yahvé \w ha|strong="H3808"\w* \w ordenado|strong="H6680"\w*. \w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H3808"\w* \w te|strong="H5921"\w* \w traigan|strong="H3947"\w* una vaca roja \w y|strong="H5921"\w* \w sin|strong="H3808"\w* defectos, \w que|strong="H3808"\w* \w no|strong="H3808"\w* tenga manchas \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w haya|strong="H3971"\w* \w puesto|strong="H5927"\w* un \w yugo|strong="H5923"\w*.  
\v 3 Se la entregarán al \w sacerdote|strong="H3548"\w* Eleazar, y \w él|strong="H4264"\w* la \w sacará|strong="H3318"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w* y ordenará que la maten \w en|strong="H3318"\w* su \w presencia|strong="H6440"\w*.  
\v 4 Luego, el \w sacerdote|strong="H3548"\w* Eleazar \w tomará|strong="H3947"\w* con el dedo un poco \w de|strong="H6440"\w* la \w sangre|strong="H1818"\w* y la \w rociará|strong="H5137"\w* \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w hacia|strong="H6440"\w* la parte delantera \w de|strong="H6440"\w* la Tienda del Encuentro.  
\v 5 \w Después|strong="H5921"\w* mandará quemar \w la|strong="H5921"\w* vaca \w a|strong="H3068"\w* \w la|strong="H5921"\w* vista \w de|strong="H5921"\w* todos; \w se|strong="H5921"\w* \w quemará|strong="H8313"\w* su \w piel|strong="H5785"\w*, su \w carne|strong="H1320"\w*, su \w sangre|strong="H1818"\w* \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* su \w estiércol|strong="H6569"\w*.  
\v 6 El \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* un pedazo de \w madera|strong="H6086"\w* de cedro, una rama de hisopo y un hilo rojo, y los \w arrojará|strong="H7993"\w* al fuego donde se quema la vaca.  
\v 7 \w Luego|strong="H5704"\w* \w el|strong="H4264"\w* \w sacerdote|strong="H3548"\w* \w lavará|strong="H3526"\w* su ropa \w y|strong="H5704"\w* se bañará \w con|strong="H5704"\w* \w agua|strong="H4325"\w*, \w y|strong="H5704"\w* \w después|strong="H5704"\w* podrá entrar \w al|strong="H5704"\w* \w campamento|strong="H4264"\w*, \w aunque|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H4264"\w* anochecer.  
\v 8 El hombre \w que|strong="H5704"\w* \w quemó|strong="H8313"\w* la vaca también \w lavará|strong="H3526"\w* su ropa \w y|strong="H5704"\w* se bañará \w con|strong="H5704"\w* \w agua|strong="H4325"\w*, \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* el anochecer.   
\p
\v 9 “Un \w hombre|strong="H1121"\w* \w que|strong="H1931"\w* \w esté|strong="H1931"\w* \w puro|strong="H2889"\w* recogerá las cenizas \w de|strong="H1121"\w* \w la|strong="H1931"\w* vaca y las pondrá en un \w lugar|strong="H4725"\w* \w limpio|strong="H2889"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*. Allí \w se|strong="H1961"\w* guardarán \w para|strong="H1961"\w* \w que|strong="H1931"\w* \w la|strong="H1931"\w* comunidad \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* las use en \w el|strong="H1931"\w* \w agua|strong="H4325"\w* \w de|strong="H1121"\w* purificación. \w Esta|strong="H1931"\w* \w es|strong="H1931"\w* una ofrenda por \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*.  
\v 10 \w El|strong="H1121"\w* \w hombre|strong="H1121"\w* \w que|strong="H5704"\w* recoja las cenizas \w lavará|strong="H3526"\w* su ropa \w y|strong="H5704"\w* \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* anochecer. \w Esta|strong="H1961"\w* \w será|strong="H1961"\w* una regla permanente \w para|strong="H5704"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w y|strong="H5704"\w* \w para|strong="H5704"\w* \w los|strong="H1121"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H5704"\w* vivan \w entre|strong="H8432"\w* \w ellos|strong="H2708"\w*.   
\p
\v 11 “\w Cualquiera|strong="H3605"\w* \w que|strong="H3117"\w* toque \w el|strong="H3605"\w* cadáver de una \w persona|strong="H5315"\w* quedará impuro durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 12 Deberá purificarse con \w esa|strong="H1931"\w* agua \w el|strong="H1931"\w* tercer y \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, y \w entonces|strong="H3117"\w* quedará \w limpio|strong="H2891"\w*. Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* purifica \w el|strong="H1931"\w* tercer \w día|strong="H3117"\w*, \w tampoco|strong="H3808"\w* quedará \w limpio|strong="H2891"\w* \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*.  
\v 13 \w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* toque \w a|strong="H3068"\w* un \w muerto|strong="H4191"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* purifique, contamina \w el|strong="H1931"\w* \w tabernáculo|strong="H4908"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H3588"\w* \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1961"\w* eliminada \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Como|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w le|strong="H1931"\w* roció \w el|strong="H1931"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* purificación, sigue \w estando|strong="H1961"\w* impuro. \w Su|strong="H1931"\w* impureza permanece \w en|strong="H5921"\w* \w él|strong="H1931"\w*.   
\p
\v 14 “\w Esta|strong="H2063"\w* \w es|strong="H3588"\w* \w la|strong="H2063"\w* regla \w para|strong="H3588"\w* \w cuando|strong="H3588"\w* alguien \w muera|strong="H4191"\w* dentro \w de|strong="H3588"\w* una tienda: \w cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* \w entre|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H2063"\w* tienda \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* ya \w esté|strong="H2063"\w* adentro quedará impuro durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 15 \w Y|strong="H3068"\w* \w toda|strong="H3605"\w* \w vasija|strong="H3627"\w* \w que|strong="H1931"\w* \w esté|strong="H1931"\w* destapada, sin una tapa bien ajustada, quedará impura.   
\p
\v 16 “\w Si|strong="H6440"\w* alguien \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* \w toca|strong="H5060"\w* \w el|strong="H5921"\w* cuerpo \w de|strong="H5921"\w* un hombre \w muerto|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, \w o|strong="H3068"\w* un cadáver, \w o|strong="H3068"\w* un \w hueso|strong="H6106"\w* humano, \w o|strong="H3068"\w* una tumba, quedará impuro \w por|strong="H5921"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.   
\p
\v 17 “\w Para|strong="H5921"\w* purificar \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona impura, \w pondrán|strong="H5414"\w* \w en|strong="H5921"\w* una \w vasija|strong="H3627"\w* un poco \w de|strong="H5921"\w* \w la|strong="H5921"\w* ceniza \w de|strong="H5921"\w* \w la|strong="H5921"\w* vaca quemada \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* echarán \w agua|strong="H4325"\w* fresca \w de|strong="H5921"\w* manantial.  
\v 18 Luego, una \w persona|strong="H5315"\w* \w pura|strong="H2889"\w* \w tomará|strong="H3947"\w* una rama \w de|strong="H5921"\w* hisopo, \w la|strong="H5921"\w* mojará \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* \w rociará|strong="H5137"\w* \w la|strong="H5921"\w* tienda, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* utensilios \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w personas|strong="H5315"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* \w allí|strong="H8033"\w*. También \w rociará|strong="H5137"\w* \w al|strong="H5921"\w* \w que|strong="H5921"\w* \w haya|strong="H1961"\w* tocado \w el|strong="H5921"\w* \w hueso|strong="H6106"\w* humano, \w al|strong="H5921"\w* asesinado, \w al|strong="H5921"\w* \w muerto|strong="H4191"\w* \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* tumba.  
\v 19 \w La|strong="H5921"\w* persona \w pura|strong="H2889"\w* \w rociará|strong="H5137"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* impura \w el|strong="H5921"\w* tercer \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*. \w El|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* terminará \w de|strong="H5921"\w* purificarla; \w entonces|strong="H3117"\w* \w la|strong="H5921"\w* persona impura \w lavará|strong="H3526"\w* su ropa, \w se|strong="H5921"\w* bañará \w con|strong="H5921"\w* \w agua|strong="H4325"\w*, \w y|strong="H5921"\w* quedará \w limpia|strong="H2889"\w* \w al|strong="H5921"\w* anochecer.  
\v 20 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* una \w persona|strong="H5315"\w* impura \w no|strong="H3808"\w* \w se|strong="H1931"\w* purifica, \w será|strong="H1931"\w* expulsada \w de|strong="H5921"\w* \w la|strong="H1931"\w* asamblea, \w porque|strong="H3588"\w* \w ha|strong="H3808"\w* profanado \w el|strong="H1931"\w* \w santuario|strong="H4720"\w* \w de|strong="H5921"\w* Yahvé. \w Como|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* roció \w el|strong="H1931"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* purificación, sigue estando impura.  
\v 21 \w Esta|strong="H1961"\w* \w será|strong="H1961"\w* una regla permanente \w para|strong="H5704"\w* todos. El \w que|strong="H5704"\w* rocíe el \w agua|strong="H4325"\w* \w de|strong="H5704"\w* purificación también deberá lavar su ropa, \w y|strong="H5704"\w* cualquiera \w que|strong="H5704"\w* toque el \w agua|strong="H4325"\w* \w de|strong="H5704"\w* purificación \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* el anochecer.   
\p
\v 22 “\w Cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* \w que|strong="H5704"\w* toque \w la|strong="H3605"\w* \w persona|strong="H5315"\w* impura quedará impura, \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w que|strong="H5704"\w* toque esa \w cosa|strong="H3605"\w* también quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* anochecer”.   
\c 20  
\p
\v 1 \w En|strong="H6912"\w* \w el|strong="H3605"\w* \w mes|strong="H2320"\w* \w primero|strong="H7223"\w*, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* llegó al \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* Zin, y \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* estableció \w en|strong="H6912"\w* \w Cades|strong="H6946"\w*. \w Allí|strong="H8033"\w* \w murió|strong="H4191"\w* Miriam y \w allí|strong="H8033"\w* \w mismo|strong="H3605"\w* fue enterrada.  
\v 2 \w Como|strong="H1961"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* \w agua|strong="H4325"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* comunidad, \w el|strong="H5921"\w* pueblo \w se|strong="H1961"\w* amotinó \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* Aarón.  
\v 3 \w Se|strong="H5971"\w* pusieron \w a|strong="H3068"\w* pelear \w con|strong="H5973"\w* \w Moisés|strong="H4872"\w*, diciéndole: “¡\w Ojalá|strong="H3863"\w* hubiéramos muerto cuando nuestros hermanos cayeron muertos \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé!  
\v 4 ¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* \w han|strong="H4191"\w* traído \w a|strong="H3068"\w* la asamblea de Yahvé \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w desierto|strong="H4057"\w*? ¿Para \w que|strong="H4100"\w* \w muramos|strong="H4191"\w* \w aquí|strong="H2088"\w* junto con nuestro ganado?  
\v 5 ¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* sacaron \w de|strong="H4325"\w* \w Egipto|strong="H4714"\w* para traernos \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* tan horrible? \w Aquí|strong="H2088"\w* \w no|strong="H3808"\w* hay \w dónde|strong="H4725"\w* sembrar, \w no|strong="H3808"\w* hay \w higueras|strong="H8384"\w*, \w ni|strong="H3808"\w* viñedos, \w ni|strong="H3808"\w* granados; ¡y \w ni|strong="H3808"\w* siquiera hay \w agua|strong="H4325"\w* para \w beber|strong="H8354"\w*!”.   
\p
\v 6 \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* Aarón \w se|strong="H5921"\w* alejaron \w de|strong="H5921"\w* \w la|strong="H5921"\w* asamblea, fueron \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro \w y|strong="H5921"\w* \w se|strong="H5921"\w* postraron \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra. Entonces \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* \w les|strong="H5921"\w* \w apareció|strong="H7200"\w*.  
\v 7 \w Y|strong="H3068"\w* Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*:  
\v 8 “\w Toma|strong="H3947"\w* la \w vara|strong="H4294"\w* y, \w junto|strong="H6950"\w* \w con|strong="H4480"\w* tu hermano Aarón, reúnan \w a|strong="H3068"\w* la comunidad. Háblenle \w a|strong="H3068"\w* la \w roca|strong="H5553"\w* \w a|strong="H3068"\w* la vista \w de|strong="H4480"\w* todos, y \w ella|strong="H4480"\w* \w dará|strong="H5414"\w* su \w agua|strong="H4325"\w*. \w Así|strong="H1696"\w* \w sacarán|strong="H3318"\w* \w agua|strong="H4325"\w* \w de|strong="H4480"\w* la \w roca|strong="H5553"\w* \w para|strong="H4480"\w* \w darle|strong="H5414"\w* \w de|strong="H4480"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* la comunidad y \w a|strong="H3068"\w* su ganado”.   
\p
\v 9 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* la \w vara|strong="H4294"\w* que estaba \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, tal como él se lo había \w ordenado|strong="H6680"\w*.  
\v 10 \w Luego|strong="H4994"\w* \w Moisés|strong="H4872"\w* y Aarón reunieron \w a|strong="H3068"\w* la asamblea frente \w a|strong="H3068"\w* la \w roca|strong="H5553"\w*, y \w Moisés|strong="H4872"\w* les dijo: “¡\w Escuchen|strong="H8085"\w*, \w rebeldes|strong="H4784"\w*! ¿Acaso tendremos \w que|strong="H4480"\w* sacarles \w agua|strong="H4325"\w* \w de|strong="H4480"\w* \w esta|strong="H2088"\w* \w roca|strong="H5553"\w*?”.  
\v 11 Enseguida \w Moisés|strong="H4872"\w* levantó la \w mano|strong="H3027"\w*, golpeó la \w roca|strong="H5553"\w* \w dos|strong="H6471"\w* \w veces|strong="H6471"\w* con su \w vara|strong="H4294"\w*, y brotó \w agua|strong="H4325"\w* \w en|strong="H3318"\w* abundancia. Así pudieron \w beber|strong="H8354"\w* la comunidad y su ganado.   
\p
\v 12 Pero Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón: “\w Por|strong="H3282"\w* \w cuanto|strong="H3282"\w* \w no|strong="H3808"\w* confiaron en mí \w para|strong="H5414"\w* honrar mi santidad ante \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w no|strong="H3808"\w* serán ustedes \w los|strong="H1121"\w* \w que|strong="H3808"\w* lleven \w a|strong="H3068"\w* \w esta|strong="H2088"\w* asamblea \w a|strong="H3068"\w* la tierra \w que|strong="H3808"\w* les he \w dado|strong="H5414"\w*”.   
\p
\v 13 \w Estas|strong="H1992"\w* son \w las|strong="H1992"\w* \w aguas|strong="H4325"\w* \w de|strong="H1121"\w* Meribá,\f + \fr 20:13 \ft “Meribá” significa “pelea” o “disputa”.\f* donde \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w se|strong="H1992"\w* rebelaron \w contra|strong="H3478"\w* Yahvé, y donde \w él|strong="H1121"\w* demostró \w su|strong="H1992"\w* santidad.   
\p
\v 14 Desde \w Cades|strong="H6946"\w*, \w Moisés|strong="H4872"\w* le \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Edom con \w el|strong="H3605"\w* siguiente mensaje:  
\p “\w Así|strong="H3541"\w* dice tu hermano \w Israel|strong="H3478"\w*: Tú \w sabes|strong="H3045"\w* muy bien \w todas|strong="H3605"\w* las dificultades \w por|strong="H4428"\w* las \w que|strong="H3045"\w* hemos pasado;  
\v 15 cómo nuestros antepasados se fueron \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, y cómo vivimos allí durante \w muchos|strong="H7227"\w* \w años|strong="H3117"\w*. \w Los|strong="H3427"\w* \w egipcios|strong="H4714"\w* nos maltrataron tanto \w a|strong="H3068"\w* nosotros como \w a|strong="H3068"\w* nuestros antepasados.  
\v 16 Pero clamamos \w a|strong="H3068"\w* Yahvé, y él \w escuchó|strong="H8085"\w* nuestra \w voz|strong="H6963"\w*, \w envió|strong="H7971"\w* un \w ángel|strong="H4397"\w* y nos \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w*. \w Ahora|strong="H2009"\w* estamos \w en|strong="H3318"\w* \w Cades|strong="H6946"\w*, una \w ciudad|strong="H5892"\w* que está \w en|strong="H3318"\w* \w la|strong="H1366"\w* frontera de tu territorio.   
\p
\v 17 “Te pedimos \w que|strong="H3808"\w* nos dejes \w pasar|strong="H5674"\w* \w por|strong="H1870"\w* tu país. Prometemos \w no|strong="H3808"\w* \w pasar|strong="H5674"\w* \w por|strong="H1870"\w* los \w campos|strong="H7704"\w* sembrados \w ni|strong="H3808"\w* \w por|strong="H1870"\w* los viñedos, \w y|strong="H5704"\w* \w tampoco|strong="H3808"\w* \w beberemos|strong="H8354"\w* \w agua|strong="H4325"\w* \w de|strong="H5704"\w* tus pozos. \w Iremos|strong="H3212"\w* \w por|strong="H1870"\w* \w el|strong="H5674"\w* \w Camino|strong="H1870"\w* \w del|strong="H8354"\w* \w Rey|strong="H4428"\w*, \w sin|strong="H3808"\w* desviarnos \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w derecha|strong="H3225"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w izquierda|strong="H8040"\w*, \w hasta|strong="H5704"\w* salir \w de|strong="H5704"\w* tu territorio”.   
\p
\v 18 Pero \w el|strong="H5674"\w* rey de Edom le respondió: “\w No|strong="H3808"\w* \w pasarán|strong="H5674"\w* por mi territorio. \w Si|strong="H3808"\w* \w lo|strong="H3808"\w* intentan, \w saldré|strong="H3318"\w* \w a|strong="H3068"\w* atacarlos con la \w espada|strong="H2719"\w*”.   
\p
\v 19 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* le insistieron: “\w Iremos|strong="H5927"\w* \w por|strong="H1697"\w* \w el|strong="H1121"\w* \w camino|strong="H4546"\w* principal, y si nosotros \w o|strong="H3068"\w* nuestro \w ganado|strong="H4735"\w* llegamos \w a|strong="H3068"\w* \w beber|strong="H8354"\w* \w de|strong="H1121"\w* tu \w agua|strong="H4325"\w*, te la pagaremos. \w Solo|strong="H7535"\w* queremos \w pasar|strong="H5674"\w* \w a|strong="H3068"\w* \w pie|strong="H7272"\w*, \w nada|strong="H1697"\w* \w más|strong="H7535"\w*”.   
\p
\v 20 Pero \w el|strong="H5674"\w* rey volvió \w a|strong="H3068"\w* decir: “¡\w No|strong="H3808"\w* \w pasarán|strong="H5674"\w*!”. \w Y|strong="H3068"\w* \w salió|strong="H3318"\w* \w el|strong="H5674"\w* rey \w de|strong="H5971"\w* Edom \w a|strong="H3068"\w* enfrentarlos con un ejército \w grande|strong="H3515"\w* y fuertemente armado.  
\v 21 \w Como|strong="H5921"\w* Edom \w se|strong="H5921"\w* negó \w a|strong="H3068"\w* dejarlos \w pasar|strong="H5674"\w* \w por|strong="H5921"\w* su territorio, \w los|strong="H5921"\w* israelitas tuvieron \w que|strong="H5921"\w* desviarse \w del|strong="H5921"\w* camino.   
\p
\v 22 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w partió|strong="H5265"\w* \w de|strong="H1121"\w* \w Cades|strong="H6946"\w* y llegó al \w monte|strong="H2022"\w* Hor.  
\v 23 Allí, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* Hor, \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w de|strong="H5921"\w* Edom, Yahvé \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* Aarón:  
\v 24 “\w Ha|strong="H3808"\w* llegado \w la|strong="H5921"\w* hora \w de|strong="H5921"\w* \w que|strong="H3588"\w* Aarón \w se|strong="H5921"\w* reúna \w con|strong="H5921"\w* sus antepasados. \w Él|strong="H5921"\w* \w no|strong="H3808"\w* entrará \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H3588"\w* \w les|strong="H5921"\w* he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* ustedes desobedecieron \w mis|strong="H5414"\w* órdenes \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w de|strong="H5921"\w* Meribá.  
\v 25 \w Toma|strong="H3947"\w* \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Eleazar, y llévalos \w a|strong="H3068"\w* la cumbre del \w monte|strong="H2022"\w* Hor.  
\v 26 Quítale \w a|strong="H3068"\w* Aarón su ropa sacerdotal y pónsela \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Eleazar. Aarón \w morirá|strong="H4191"\w* \w allí|strong="H8033"\w* y se reunirá con sus antepasados”.   
\p
\v 27 \w Moisés|strong="H4872"\w* \w hizo|strong="H6213"\w* tal como Yahvé \w le|strong="H5869"\w* \w ordenó|strong="H6680"\w*. \w Subieron|strong="H5927"\w* al \w monte|strong="H2022"\w* Hor \w a|strong="H3068"\w* \w la|strong="H3605"\w* vista \w de|strong="H5869"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad.  
\v 28 \w Moisés|strong="H4872"\w* le \w quitó|strong="H4191"\w* \w a|strong="H3068"\w* Aarón su ropa sacerdotal y \w se|strong="H4480"\w* la puso \w a|strong="H3068"\w* Eleazar. \w Allí|strong="H8033"\w* mismo, \w en|strong="H4480"\w* la \w cumbre|strong="H7218"\w* \w de|strong="H4480"\w* la montaña, \w murió|strong="H4191"\w* Aarón. Después, \w Moisés|strong="H4872"\w* y Eleazar \w bajaron|strong="H3381"\w* \w del|strong="H4480"\w* \w monte|strong="H2022"\w*.  
\v 29 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* Aarón \w había|strong="H3588"\w* muerto, \w todo|strong="H3605"\w* \w el|strong="H3588"\w* pueblo \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* hizo duelo \w por|strong="H3588"\w* \w él|strong="H3588"\w* durante \w treinta|strong="H7970"\w* \w días|strong="H3117"\w*.   
\c 21  
\p
\v 1 \w El|strong="H3588"\w* \w cananeo|strong="H3669"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Arad|strong="H6166"\w*, \w que|strong="H3588"\w* \w vivía|strong="H3427"\w* \w en|strong="H4480"\w* \w la|strong="H3588"\w* zona \w del|strong="H4480"\w* Néguev, \w se|strong="H4480"\w* enteró \w de|strong="H4480"\w* \w que|strong="H3588"\w* \w Israel|strong="H3478"\w* venía \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w de|strong="H4480"\w* Atarim. Atacó \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* tomó \w a|strong="H3068"\w* algunos \w de|strong="H4480"\w* \w ellos|strong="H4480"\w* \w como|strong="H3588"\w* prisioneros.  
\v 2 Entonces \w Israel|strong="H3478"\w* le \w hizo|strong="H5088"\w* una \w promesa|strong="H5087"\w* \w a|strong="H3068"\w* Yahvé, diciendo: “Si \w de|strong="H5971"\w* verdad entregas \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* en nuestras \w manos|strong="H3027"\w*, destruiremos sus \w ciudades|strong="H5892"\w* \w por|strong="H2088"\w* completo”.  
\v 3 Yahvé \w escuchó|strong="H8085"\w* la petición \w de|strong="H5414"\w* \w Israel|strong="H3478"\w* y les \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* los \w cananeos|strong="H3669"\w*; y los israelitas los \w destruyeron|strong="H2763"\w* \w por|strong="H5414"\w* completo \w a|strong="H3068"\w* ellos y \w a|strong="H3068"\w* sus \w ciudades|strong="H5892"\w*. \w Por|strong="H5414"\w* eso, ese \w lugar|strong="H4725"\w* fue \w llamado|strong="H8034"\w* \w Horma|strong="H2767"\w*. \f + \fr 21:3 \ft “Horma” significa “destrucción”.\f*   
\p
\v 4 \w Partieron|strong="H5265"\w* del \w monte|strong="H2022"\w* Hor \w por|strong="H1870"\w* el \w camino|strong="H1870"\w* del \w Mar|strong="H3220"\w* Rojo, \w para|strong="H5971"\w* rodear el territorio \w de|strong="H5971"\w* Edom. Pero la \w gente|strong="H5971"\w* \w se|strong="H5971"\w* impacientó mucho \w por|strong="H1870"\w* el cansancio del \w viaje|strong="H1870"\w*,  
\v 5 \w y|strong="H3588"\w* comenzaron \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* contra Dios \w y|strong="H3588"\w* contra \w Moisés|strong="H4872"\w*: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w nos|strong="H4100"\w* sacaron \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w para|strong="H3588"\w* hacernos \w morir|strong="H4191"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*? ¡\w No|strong="H3588"\w* hay \w pan|strong="H3899"\w* ni \w agua|strong="H4325"\w*, \w y|strong="H3588"\w* ya estamos hartos \w de|strong="H3588"\w* esta \w comida|strong="H3899"\w* miserable!”.   
\p
\v 6 Entonces Yahvé \w envió|strong="H7971"\w* \w serpientes|strong="H5175"\w* venenosas entre el \w pueblo|strong="H5971"\w*; estas mordieron \w a|strong="H3068"\w* la \w gente|strong="H5971"\w*, y \w muchos|strong="H7227"\w* israelitas \w murieron|strong="H4191"\w*.  
\v 7 \w El|strong="H5921"\w* \w pueblo|strong="H5971"\w* acudió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* \w le|strong="H5921"\w* \w dijo|strong="H1696"\w*: “Hemos \w pecado|strong="H2398"\w* \w al|strong="H5921"\w* \w hablar|strong="H1696"\w* \w contra|strong="H5921"\w* Yahvé \w y|strong="H3588"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*. Ruégale \w a|strong="H3068"\w* Yahvé \w que|strong="H3588"\w* aleje \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w serpientes|strong="H5175"\w* \w de|strong="H5921"\w* \w nosotros|strong="H5921"\w*”. \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w oró|strong="H6419"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 8 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Haz|strong="H6213"\w* \w la|strong="H5921"\w* figura \w de|strong="H5921"\w* una serpiente venenosa \w y|strong="H5921"\w* ponla \w sobre|strong="H5921"\w* un poste. \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w sea|strong="H1961"\w* mordido \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w mire|strong="H7200"\w*, \w vivirá|strong="H2425"\w*”.  
\v 9 \w Moisés|strong="H4872"\w* \w hizo|strong="H6213"\w* una \w serpiente|strong="H5175"\w* \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w puso|strong="H7760"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* poste. \w Y|strong="H3068"\w* \w sucedía|strong="H1961"\w* \w que|strong="H5921"\w*, \w si|strong="H1961"\w* una \w serpiente|strong="H5175"\w* \w mordía|strong="H5391"\w* \w a|strong="H3068"\w* alguien, esa persona \w miraba|strong="H5027"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w serpiente|strong="H5175"\w* \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* \w se|strong="H1961"\w* salvaba.   
\p
\v 10 Luego \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w partieron|strong="H5265"\w* y acamparon en Obot.  
\v 11 \w Salieron|strong="H5265"\w* \w de|strong="H5921"\w* Obot \w y|strong="H5921"\w* acamparon \w en|strong="H5921"\w* Ije-abarim, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* frente \w a|strong="H3068"\w* \w Moab|strong="H4124"\w*, \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w este|strong="H4217"\w*.  
\v 12 De \w allí|strong="H8033"\w* avanzaron y acamparon en el valle de Zered.  
\v 13 \w Salieron|strong="H3318"\w* \w de|strong="H3588"\w* \w allí|strong="H8033"\w* \w y|strong="H3588"\w* acamparon al otro \w lado|strong="H5676"\w* del río Arnón, \w que|strong="H3588"\w* \w está|strong="H8033"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w* \w y|strong="H3588"\w* se extiende desde \w la|strong="H1366"\w* frontera \w de|strong="H3588"\w* \w los|strong="H3588"\w* amorreos. \w El|strong="H3588"\w* Arnón \w es|strong="H3588"\w* \w la|strong="H1366"\w* frontera \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*, \w y|strong="H3588"\w* separa \w a|strong="H3068"\w* \w los|strong="H3588"\w* moabitas \w de|strong="H3588"\w* \w los|strong="H3588"\w* amorreos.  
\v 14 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w se|strong="H5921"\w* dice \w en|strong="H5921"\w* \bk \+w el|strong="H5921"\+w* \+w Libro|strong="H5612"\+w* \+w de|strong="H5921"\+w* \+w las|strong="H5921"\+w* \+w Guerras|strong="H4421"\+w* \+w de|strong="H5921"\+w* Yahvé: \bk*“Vaheb \w en|strong="H5921"\w* Sufa, \w los|strong="H5921"\w* \w arroyos|strong="H5158"\w* \w del|strong="H5921"\w* Arnón,  
\v 15 y \w la|strong="H1366"\w* ladera de \w los|strong="H3427"\w* \w arroyos|strong="H5158"\w* que llega hasta \w la|strong="H1366"\w* ciudad de \w Ar|strong="H6144"\w* y descansa en \w la|strong="H1366"\w* frontera de \w Moab|strong="H4124"\w*”.   
\p
\v 16 \w De|strong="H5971"\w* \w allí|strong="H8033"\w* continuaron \w hasta|strong="H1931"\w* Beer, \w el|strong="H1931"\w* pozo \w donde|strong="H8033"\w* Yahvé \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Reúne al \w pueblo|strong="H5971"\w* y yo les \w daré|strong="H5414"\w* \w agua|strong="H4325"\w*”.   
\p
\v 17 Entonces \w Israel|strong="H3478"\w* \w cantó|strong="H7891"\w* \w esta|strong="H2063"\w* \w canción|strong="H7892"\w*:  
\q1 “¡Brota, pozo! ¡Cántenle!   
\q2
\v 18 El pozo \w que|strong="H5971"\w* \w cavaron|strong="H2658"\w* los líderes,  
\q2 \w que|strong="H5971"\w* los nobles del \w pueblo|strong="H5971"\w* abrieron,  
\q2 con sus cetros y con sus bastones”.  
\p Del \w desierto|strong="H4057"\w* viajaron \w a|strong="H3068"\w* Mataná;  
\v 19 de Mataná \w a|strong="H3068"\w* Nahaliel; de Nahaliel \w a|strong="H3068"\w* Bamot;  
\v 20 \w y|strong="H5921"\w* \w de|strong="H5921"\w* Bamot \w al|strong="H5921"\w* \w valle|strong="H1516"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* territorio \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cumbre|strong="H7218"\w* \w del|strong="H5921"\w* monte Pisga, \w con|strong="H5921"\w* vista \w al|strong="H5921"\w* desierto.  
\v 21 \w Israel|strong="H3478"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w Sehón|strong="H5511"\w*, \w rey|strong="H4428"\w* de los amorreos, para decirle:  
\v 22 “Déjanos \w pasar|strong="H5674"\w* \w por|strong="H1870"\w* tu país. Prometemos \w no|strong="H3808"\w* desviarnos \w por|strong="H1870"\w* los \w campos|strong="H7704"\w* \w ni|strong="H3808"\w* \w por|strong="H1870"\w* los viñedos, \w ni|strong="H3808"\w* \w beberemos|strong="H8354"\w* \w agua|strong="H4325"\w* \w de|strong="H5704"\w* tus pozos. \w Iremos|strong="H3212"\w* \w por|strong="H1870"\w* \w el|strong="H5674"\w* \w Camino|strong="H1870"\w* \w del|strong="H8354"\w* \w Rey|strong="H4428"\w*, \w hasta|strong="H5704"\w* salir \w de|strong="H5704"\w* tu territorio”.   
\p
\v 23 Pero \w Sehón|strong="H5511"\w* \w no|strong="H3808"\w* le \w permitió|strong="H5414"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* cruzar \w por|strong="H5414"\w* su territorio. Al contrario, reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su ejército y \w salió|strong="H3318"\w* al \w desierto|strong="H4057"\w* \w para|strong="H5414"\w* atacar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*; al llegar \w a|strong="H3068"\w* Jahaz, \w se|strong="H3808"\w* enfrentó \w a|strong="H3068"\w* \w ellos|strong="H3605"\w*.  
\v 24 \w Israel|strong="H3478"\w* \w lo|strong="H5704"\w* derrotó \w a|strong="H3068"\w* filo \w de|strong="H3588"\w* \w espada|strong="H2719"\w* \w y|strong="H3588"\w* se adueñó \w de|strong="H3588"\w* \w su|strong="H3588"\w* territorio \w desde|strong="H5704"\w* \w el|strong="H3588"\w* río Arnón \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* río \w Jaboc|strong="H2999"\w*, llegando \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* frontera \w de|strong="H3588"\w* \w los|strong="H1121"\w* amonitas, \w pues|strong="H3588"\w* \w la|strong="H3588"\w* frontera \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* Amón estaba \w bien|strong="H3588"\w* fortificada.  
\v 25 \w Israel|strong="H3478"\w* \w tomó|strong="H3947"\w* \w todas|strong="H3605"\w* esas \w ciudades|strong="H5892"\w* y se estableció en ellas, incluyendo \w Hesbón|strong="H2809"\w* y \w todos|strong="H3605"\w* sus poblados.  
\v 26 \w Hesbón|strong="H2809"\w* \w era|strong="H1931"\w* \w la|strong="H1931"\w* capital \w de|strong="H3588"\w* \w Sehón|strong="H5511"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* amorreo, \w quien|strong="H3605"\w* \w había|strong="H3588"\w* peleado contra \w el|strong="H1931"\w* anterior \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Moab|strong="H4124"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* \w había|strong="H3588"\w* quitado \w todo|strong="H3605"\w* \w su|strong="H1931"\w* territorio \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* río Arnón.  
\v 27 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* dicen \w los|strong="H5921"\w* poetas:  
\q1 “¡Vengan \w a|strong="H3068"\w* \w Hesbón|strong="H2809"\w*!  
\q2 ¡\w Que|strong="H5921"\w* sea reconstruida \w y|strong="H5921"\w* afirmada \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w Sehón|strong="H5511"\w*!   
\q1
\v 28 \w Porque|strong="H3588"\w* \w de|strong="H3588"\w* \w Hesbón|strong="H2809"\w* \w salió|strong="H3318"\w* un fuego,  
\q2 una \w llama|strong="H3852"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H7151"\w* \w de|strong="H3588"\w* \w Sehón|strong="H5511"\w*,  
\q1 \w que|strong="H3588"\w* devoró \w a|strong="H3068"\w* \w Ar|strong="H6144"\w* \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1167"\w* \w señores|strong="H1167"\w* \w de|strong="H3588"\w* las colinas del Arnón.   
\q1
\v 29 ¡Pobre \w de|strong="H1121"\w* ti, \w Moab|strong="H4124"\w*!  
\q2 ¡Estás arruinado, \w pueblo|strong="H5971"\w* \w de|strong="H1121"\w* Quemos!  
\q1 Ha dejado \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* como fugitivos,  
\q2 y \w a|strong="H3068"\w* sus \w hijas|strong="H1323"\w* como prisioneras,  
\q2 \w de|strong="H1121"\w* \w Sehón|strong="H5511"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amorreos.   
\q1
\v 30 Pero nosotros los destruimos \w a|strong="H3068"\w* flechazos.  
\q2 \w Hesbón|strong="H2809"\w* está \w en|strong="H5704"\w* ruinas \w hasta|strong="H5704"\w* \w Dibón|strong="H1769"\w*.  
\q1 Los hemos destruido \w hasta|strong="H5704"\w* Nofa,  
\q2 \w que|strong="H5704"\w* se extiende \w hasta|strong="H5704"\w* \w Medeba|strong="H4311"\w*”.   
\p
\v 31 Así se estableció \w Israel|strong="H3478"\w* en la tierra de \w los|strong="H3427"\w* amorreos.  
\v 32 Luego \w Moisés|strong="H4872"\w* \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* unos hombres \w a|strong="H3068"\w* explorar \w Jazer|strong="H3270"\w*. Capturaron sus poblados y expulsaron \w a|strong="H3068"\w* los amorreos \w que|strong="H1323"\w* vivían \w allí|strong="H8033"\w*.  
\v 33 Después dieron \w la|strong="H1931"\w* vuelta y \w subieron|strong="H5927"\w* \w por|strong="H1870"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w* \w de|strong="H5971"\w* \w Basán|strong="H1316"\w*. Pero \w Og|strong="H5747"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Basán|strong="H1316"\w*, \w salió|strong="H3318"\w* con \w todo|strong="H3605"\w* \w su|strong="H1931"\w* ejército \w para|strong="H5971"\w* atacarlos \w en|strong="H3318"\w* Edrei.   
\p
\v 34 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w No|strong="H6213"\w* le \w tengas|strong="H5414"\w* \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* \w lo|strong="H6213"\w* he \w entregado|strong="H5414"\w* \w en|strong="H3588"\w* tus \w manos|strong="H3027"\w* \w junto|strong="H3027"\w* \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w su|strong="H3588"\w* ejército \w y|strong="H3588"\w* \w su|strong="H3588"\w* tierra. \w Harás|strong="H6213"\w* \w con|strong="H3588"\w* \w él|strong="H3588"\w* \w lo|strong="H6213"\w* \w mismo|strong="H3605"\w* \w que|strong="H3588"\w* \w hiciste|strong="H6213"\w* \w con|strong="H3588"\w* \w Sehón|strong="H5511"\w*, \w el|strong="H3588"\w* \w rey|strong="H4428"\w* amorreo \w que|strong="H3588"\w* \w vivía|strong="H3427"\w* \w en|strong="H3588"\w* \w Hesbón|strong="H2809"\w*”.   
\p
\v 35 Así \w que|strong="H5704"\w* \w los|strong="H1121"\w* israelitas \w lo|strong="H5704"\w* \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w él|strong="H3605"\w*, \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su ejército, sin \w dejar|strong="H7604"\w* \w a|strong="H3068"\w* \w nadie|strong="H3605"\w* \w con|strong="H5704"\w* vida; \w y|strong="H5704"\w* \w se|strong="H5971"\w* adueñaron \w de|strong="H5704"\w* su tierra.   
\c 22  
\p
\v 1 Luego \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* avanzaron y acamparon en las llanuras \w de|strong="H1121"\w* \w Moab|strong="H4124"\w*, al otro \w lado|strong="H5676"\w* del río \w Jordán|strong="H3383"\w*, frente \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*.  
\v 2 Cuando \w Balac|strong="H1111"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zipor, se enteró \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H1121"\w* \w Israel|strong="H3478"\w* les \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* amorreos,  
\v 3 \w los|strong="H1121"\w* \w de|strong="H3588"\w* \w Moab|strong="H4124"\w* \w se|strong="H1931"\w* llenaron \w de|strong="H3588"\w* miedo, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w era|strong="H1931"\w* \w muy|strong="H3966"\w* \w grande|strong="H7227"\w*. \w Estaban|strong="H5971"\w* aterrorizados \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w los|strong="H1121"\w* israelitas.  
\v 4 \w Entonces|strong="H6256"\w* \w Moab|strong="H4124"\w* les dijo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H1121"\w* \w Madián|strong="H4080"\w*: “\w Esa|strong="H1931"\w* \w multitud|strong="H6951"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* arrasar con \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* tenemos \w alrededor|strong="H5439"\w*, \w como|strong="H1931"\w* un toro \w se|strong="H1931"\w* come \w el|strong="H1931"\w* pasto del \w campo|strong="H7704"\w*”.  
\p \w Balac|strong="H1111"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zipor, \w era|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Moab|strong="H4124"\w* en \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w*.  
\v 5 \w Mandó|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Beor, \w que|strong="H1931"\w* \w vivía|strong="H3427"\w* \w en|strong="H5921"\w* Petor, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Éufrates, \w en|strong="H5921"\w* \w su|strong="H1931"\w* tierra natal. \w El|strong="H1931"\w* mensaje decía: “Presta atención: un \w pueblo|strong="H5971"\w* entero ha \w salido|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*. Son tantos \w que|strong="H1931"\w* \w cubren|strong="H3680"\w* \w toda|strong="H5921"\w* \w la|strong="H1931"\w* tierra \w y|strong="H5921"\w* han acampado justo \w enfrente|strong="H4136"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 6 \w Por|strong="H3588"\w* favor, \w ven|strong="H3212"\w* \w y|strong="H3588"\w* maldice \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w por|strong="H3588"\w* \w mí|strong="H4994"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* \w fuertes|strong="H6099"\w* \w que|strong="H3588"\w* \w nosotros|strong="H1931"\w*. \w Tal|strong="H2088"\w* vez \w así|strong="H2088"\w* \w pueda|strong="H3201"\w* derrotarlos \w y|strong="H3588"\w* echarlos \w del|strong="H4480"\w* país. \w Yo|strong="H4480"\w* \w sé|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* tú \w bendices|strong="H1288"\w* \w le|strong="H1931"\w* \w va|strong="H3068"\w* \w bien|strong="H3588"\w*, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* tú maldices \w le|strong="H1931"\w* \w va|strong="H3068"\w* mal”.   
\p
\v 7 Los \w ancianos|strong="H2205"\w* \w de|strong="H1697"\w* \w Moab|strong="H4124"\w* y \w de|strong="H1697"\w* \w Madián|strong="H4080"\w* se \w fueron|strong="H3212"\w* llevando dinero para pagarle \w por|strong="H1697"\w* la \w adivinación|strong="H7081"\w*. Cuando llegaron \w a|strong="H3068"\w* donde estaba \w Balaam|strong="H1109"\w*, le dieron el mensaje \w de|strong="H1697"\w* \w Balac|strong="H1111"\w*.   
\p
\v 8 \w Balaam|strong="H1109"\w* \w les|strong="H5973"\w* \w respondió|strong="H7725"\w*: “Quédense \w aquí|strong="H6311"\w* \w esta|strong="H3427"\w* \w noche|strong="H3915"\w*, y \w les|strong="H5973"\w* daré una \w respuesta|strong="H1697"\w* mañana, según \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé \w me|strong="H5973"\w* \w diga|strong="H1696"\w*”. \w Y|strong="H3068"\w* \w los|strong="H3427"\w* líderes \w de|strong="H5973"\w* \w Moab|strong="H4124"\w* se quedaron \w con|strong="H5973"\w* \w Balaam|strong="H1109"\w*.   
\p
\v 9 Dios se \w le|strong="H5973"\w* apareció \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* y \w le|strong="H5973"\w* preguntó: “¿\w Quiénes|strong="H4310"\w* son estos hombres \w que|strong="H4310"\w* están \w contigo|strong="H5973"\w*?”.   
\p
\v 10 \w Balaam|strong="H1109"\w* le contestó \w a|strong="H3068"\w* Dios: “\w Balac|strong="H1111"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zipor, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Moab|strong="H4124"\w*, me \w mandó|strong="H7971"\w* este mensaje:  
\v 11 ‘Un \w pueblo|strong="H5971"\w* \w que|strong="H6258"\w* \w salió|strong="H3318"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w* ha cubierto toda la tierra. \w Ven|strong="H3212"\w* y maldícelos por \w mí|strong="H2009"\w*; \w a|strong="H3068"\w* lo mejor \w así|strong="H6258"\w* logro \w pelear|strong="H3201"\w* contra ellos y expulsarlos’”.   
\p
\v 12 \w Pero|strong="H3588"\w* Dios \w le|strong="H1931"\w* \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “\w No|strong="H3808"\w* \w vayas|strong="H3212"\w* \w con|strong="H5973"\w* \w ellos|strong="H1931"\w*. \w Tampoco|strong="H3808"\w* maldigas \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* un \w pueblo|strong="H5971"\w* \w bendito|strong="H1288"\w*”.   
\p
\v 13 \w A|strong="H3068"\w* \w la|strong="H3588"\w* \w mañana|strong="H1242"\w* siguiente, \w Balaam|strong="H1109"\w* se \w levantó|strong="H6965"\w* \w y|strong="H3588"\w* \w les|strong="H5973"\w* \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* líderes enviados \w por|strong="H3588"\w* \w Balac|strong="H1111"\w*: “Regresen \w a|strong="H3068"\w* \w su|strong="H3588"\w* país, \w porque|strong="H3588"\w* Yahvé \w no|strong="H3985"\w* \w me|strong="H3588"\w* \w da|strong="H5414"\w* permiso \w para|strong="H3588"\w* \w ir|strong="H3212"\w* \w con|strong="H5973"\w* ustedes”.   
\p
\v 14 \w Los|strong="H5973"\w* líderes moabitas regresaron \w a|strong="H3068"\w* \w Balac|strong="H1111"\w* y \w le|strong="H5973"\w* informaron: “\w Balaam|strong="H1109"\w* \w no|strong="H3985"\w* quiso \w venir|strong="H1980"\w* \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*”.   
\p
\v 15 \w Balac|strong="H1111"\w* insistió y \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w otro|strong="H5750"\w* grupo \w de|strong="H5750"\w* líderes, un grupo \w más|strong="H5750"\w* \w numeroso|strong="H7227"\w* y \w más|strong="H5750"\w* importante que el primero.  
\v 16 Cuando llegaron, le dijeron \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* lo \w que|strong="H4994"\w* dice \w Balac|strong="H1111"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zipor: ‘Por favor, no \w dejes|strong="H4513"\w* \w que|strong="H4994"\w* nada te impida \w venir|strong="H1980"\w* \w a|strong="H3068"\w* ayudarme.  
\v 17 \w Te|strong="H3588"\w* pagaré \w muy|strong="H3966"\w* \w bien|strong="H3588"\w* \w y|strong="H3588"\w* \w haré|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* pidas. ¡\w Por|strong="H3588"\w* favor, \w ven|strong="H3212"\w* \w y|strong="H3588"\w* maldice \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w por|strong="H3588"\w* \w mí|strong="H4994"\w*!’”.   
\p
\v 18 Pero \w Balaam|strong="H1109"\w* les \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* los sirvientes \w de|strong="H5414"\w* \w Balac|strong="H1111"\w*: “\w Aunque|strong="H3808"\w* \w Balac|strong="H1111"\w* me regalara su palacio \w lleno|strong="H4393"\w* \w de|strong="H5414"\w* \w plata|strong="H3701"\w* y \w de|strong="H5414"\w* \w oro|strong="H2091"\w*, \w yo|strong="H6213"\w* \w no|strong="H3808"\w* podría desobedecer \w a|strong="H3068"\w* Yahvé \w mi|strong="H6030"\w* \w Dios|strong="H3068"\w* en \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* en \w lo|strong="H3808"\w* \w más|strong="H6030"\w* mínimo.  
\v 19 \w De|strong="H5973"\w* todos modos, quédense \w aquí|strong="H2088"\w* \w esta|strong="H2088"\w* \w noche|strong="H3915"\w*, \w para|strong="H5973"\w* ver \w qué|strong="H4100"\w* otra \w cosa|strong="H1696"\w* \w me|strong="H5973"\w* \w dice|strong="H1696"\w* Yahvé”.   
\p
\v 20 Esa \w noche|strong="H3915"\w*, Dios se le apareció \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* y le \w dijo|strong="H1696"\w*: “\w Ya|strong="H3068"\w* \w que|strong="H1697"\w* estos hombres han venido \w a|strong="H3068"\w* buscarte, \w levántate|strong="H6965"\w* y \w ve|strong="H3212"\w* con ellos; pero solo \w harás|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w yo|strong="H6213"\w* te indique”.   
\p
\v 21 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w Balaam|strong="H1109"\w* se \w levantó|strong="H6965"\w*, \w le|strong="H5973"\w* puso la silla \w a|strong="H3068"\w* su burra y se \w fue|strong="H3212"\w* \w con|strong="H5973"\w* \w los|strong="H5973"\w* líderes \w de|strong="H5973"\w* \w Moab|strong="H4124"\w*.  
\v 22 \w Pero|strong="H3588"\w* \w Dios|strong="H3068"\w* \w se|strong="H1931"\w* enojó mucho \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w iba|strong="H1980"\w* \w con|strong="H5973"\w* \w ellos|strong="H1931"\w*. \w Mientras|strong="H3588"\w* Balaam \w iba|strong="H1980"\w* \w montado|strong="H7392"\w* \w en|strong="H5921"\w* \w su|strong="H1931"\w* burra, acompañado \w por|strong="H5921"\w* \w dos|strong="H8147"\w* \w de|strong="H5921"\w* \w sus|strong="H1931"\w* sirvientes, \w el|strong="H1931"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H1931"\w* paró \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w* \w para|strong="H5921"\w* cerrarle \w el|strong="H1931"\w* paso.  
\v 23 Cuando la burra \w vio|strong="H7200"\w* \w al|strong="H4480"\w* \w ángel|strong="H4397"\w* \w de|strong="H4480"\w* Yahvé parado \w en|strong="H4480"\w* el \w camino|strong="H1870"\w* \w con|strong="H4480"\w* la \w espada|strong="H2719"\w* desenvainada, \w se|strong="H4480"\w* \w salió|strong="H3212"\w* \w del|strong="H4480"\w* \w camino|strong="H1870"\w* y \w se|strong="H4480"\w* metió \w al|strong="H4480"\w* \w campo|strong="H7704"\w*. \w Balaam|strong="H1109"\w* agarró \w a|strong="H3068"\w* golpes \w a|strong="H3068"\w* la burra \w para|strong="H4480"\w* \w que|strong="H4480"\w* volviera \w al|strong="H4480"\w* \w camino|strong="H1870"\w*.  
\v 24 Más adelante, el \w ángel|strong="H4397"\w* de Yahvé se paró \w en|strong="H5975"\w* un callejón estrecho entre dos viñedos, \w que|strong="H2088"\w* tenía muros de piedra \w a|strong="H3068"\w* ambos lados.  
\v 25 Al \w ver|strong="H7200"\w* la burra al \w ángel|strong="H4397"\w* de Yahvé, se pegó contra la \w pared|strong="H7023"\w*, aplastándole el \w pie|strong="H7272"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*; así que él la \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* golpear.   
\p
\v 26 \w El|strong="H5674"\w* \w ángel|strong="H4397"\w* de Yahvé se adelantó otra vez y se paró \w en|strong="H5975"\w* un \w paso|strong="H5674"\w* tan estrecho que \w no|strong="H1870"\w* \w había|strong="H5975"\w* forma de hacerse ni \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* ni \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*.  
\v 27 Cuando la burra volvió \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w al|strong="H8478"\w* \w ángel|strong="H4397"\w* \w de|strong="H8478"\w* Yahvé, se echó \w al|strong="H8478"\w* suelo \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w Balaam|strong="H1109"\w*. \w Balaam|strong="H1109"\w* se enfureció y agarró \w a|strong="H3068"\w* la burra \w a|strong="H3068"\w* bastonazos.   
\p
\v 28 \w Entonces|strong="H3588"\w* Yahvé \w hizo|strong="H6213"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* burra hablara, \w y|strong="H3588"\w* ella le \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “¿\w Qué|strong="H3588"\w* \w te|strong="H3588"\w* he \w hecho|strong="H6213"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* golpees \w por|strong="H3588"\w* tercera vez?”.   
\p
\v 29 \w Balaam|strong="H1109"\w* le contestó \w a|strong="H3068"\w* \w la|strong="H3588"\w* burra: “¡\w Te|strong="H3588"\w* estás burlando \w de|strong="H3588"\w* mí! ¡\w Si|strong="H3588"\w* \w tuviera|strong="H3426"\w* una \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w mano|strong="H3027"\w*, \w te|strong="H3588"\w* mataría \w ahora|strong="H6258"\w* mismo!”.   
\p
\v 30 \w La|strong="H5921"\w* burra \w le|strong="H5921"\w* \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “¿Acaso \w no|strong="H3808"\w* soy \w tu|strong="H6213"\w* burra? ¡\w Toda|strong="H5921"\w* \w tu|strong="H6213"\w* \w vida|strong="H3117"\w* \w me|strong="H5921"\w* has \w montado|strong="H7392"\w*! ¿Alguna vez \w te|strong="H5921"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* algo \w así|strong="H3541"\w*?”.  
\p “\w No|strong="H3808"\w*, \w nunca|strong="H3808"\w*”, \w respondió|strong="H1109"\w* \w él|strong="H5921"\w*.   
\p
\v 31 En ese momento, Yahvé \w le|strong="H5869"\w* \w abrió|strong="H1540"\w* los \w ojos|strong="H5869"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* y pudo \w ver|strong="H7200"\w* al \w ángel|strong="H4397"\w* \w de|strong="H5869"\w* Yahvé parado en el \w camino|strong="H1870"\w*, con la \w espada|strong="H2719"\w* desenvainada. \w Balaam|strong="H1109"\w* bajó la cabeza y se postró rostro en tierra.  
\v 32 \w El|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* preguntó: “¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* golpeaste \w a|strong="H3068"\w* tu burra \w estas|strong="H2088"\w* \w tres|strong="H7969"\w* \w veces|strong="H7272"\w*? \w Yo|strong="H3588"\w* soy \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* \w está|strong="H2088"\w* cerrando \w el|strong="H5921"\w* paso, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w que|strong="H3588"\w* llevas \w me|strong="H5921"\w* desagrada.  
\v 33 \w La|strong="H1571"\w* burra \w me|strong="H3588"\w* \w vio|strong="H7200"\w* \w y|strong="H1571"\w* se apartó \w de|strong="H3588"\w* mí \w estas|strong="H2088"\w* \w tres|strong="H7969"\w* \w veces|strong="H7272"\w*. \w Si|strong="H3588"\w* \w no|strong="H3588"\w* se hubiera apartado, \w a|strong="H3068"\w* ti \w ya|strong="H2088"\w* \w te|strong="H3588"\w* habría matado, \w y|strong="H1571"\w* \w a|strong="H3068"\w* ella \w la|strong="H1571"\w* habría dejado \w viva|strong="H2421"\w*”.   
\p
\v 34 \w Balaam|strong="H1109"\w* \w le|strong="H5869"\w* \w dijo|strong="H1109"\w* al \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* Yahvé: “He \w pecado|strong="H2398"\w*, \w no|strong="H3808"\w* \w sabía|strong="H3045"\w* \w que|strong="H3588"\w* estabas bloqueando \w el|strong="H3588"\w* \w camino|strong="H1870"\w*. \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w te|strong="H5869"\w* parece \w mal|strong="H7489"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* vaya, \w me|strong="H3588"\w* regresaré \w ahora|strong="H6258"\w* mismo”.   
\p
\v 35 \w El|strong="H5973"\w* \w ángel|strong="H4397"\w* \w de|strong="H5973"\w* Yahvé \w le|strong="H5973"\w* \w dijo|strong="H1696"\w*: “Puedes \w ir|strong="H3212"\w* \w con|strong="H5973"\w* ellos, pero tendrás \w que|strong="H1697"\w* decir únicamente las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* yo \w te|strong="H5973"\w* \w diga|strong="H1696"\w*”.  
\p \w Y|strong="H3068"\w* \w Balaam|strong="H1109"\w* continuó su viaje \w con|strong="H5973"\w* \w los|strong="H5973"\w* líderes enviados \w por|strong="H1697"\w* \w Balac|strong="H1111"\w*.  
\v 36 \w Cuando|strong="H3588"\w* \w Balac|strong="H1111"\w* \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w Balaam|strong="H1109"\w* estaba \w por|strong="H5921"\w* llegar, \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibirlo \w a|strong="H3068"\w* una \w ciudad|strong="H5892"\w* moabita \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w del|strong="H5921"\w* río Arnón, justo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w límite|strong="H7097"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* territorio.  
\v 37 \w Balac|strong="H1111"\w* le \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* veniste \w cuando|strong="H4100"\w* te mandé \w llamar|strong="H7121"\w*? ¿Acaso crees \w que|strong="H4100"\w* \w no|strong="H3808"\w* tengo poder para pagarte bien y darte honores?”.   
\p
\v 38 \w Balaam|strong="H1109"\w* le contestó: “\w Pues|strong="H6258"\w* \w aquí|strong="H2009"\w* me tienes, \w ya|strong="H6258"\w* llegué. Pero no te hagas ilusiones, \w porque|strong="H2009"\w* \w yo|strong="H2009"\w* no \w puedo|strong="H3201"\w* decir \w lo|strong="H1697"\w* \w que|strong="H6258"\w* se me antoje. Solo \w podré|strong="H3201"\w* decir las \w palabras|strong="H1697"\w* \w que|strong="H6258"\w* Dios \w ponga|strong="H7760"\w* en \w mi|strong="H2009"\w* \w boca|strong="H6310"\w*”.   
\p
\v 39 \w Balaam|strong="H1109"\w* se \w fue|strong="H3212"\w* \w con|strong="H5973"\w* \w Balac|strong="H1111"\w* y llegaron \w a|strong="H3068"\w* Quiriat-huzot.  
\v 40 Allí \w Balac|strong="H1111"\w* \w sacrificó|strong="H2076"\w* \w vacas|strong="H1241"\w* \w y|strong="H1241"\w* \w ovejas|strong="H6629"\w*, \w y|strong="H1241"\w* les \w mandó|strong="H7971"\w* porciones \w de|strong="H8269"\w* carne \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* \w y|strong="H1241"\w* \w a|strong="H3068"\w* los líderes que lo acompañaban.  
\v 41 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w Balac|strong="H1111"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* cerros consagrados \w a|strong="H3068"\w* Baal, desde \w donde|strong="H8033"\w* pudo \w ver|strong="H7200"\w* \w a|strong="H3068"\w* una parte del \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Israel.   
\c 23  
\p
\v 1 \w Balaam|strong="H1109"\w* le \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balac|strong="H1111"\w*: “Constrúyeme \w aquí|strong="H2088"\w* \w siete|strong="H7651"\w* \w altares|strong="H4196"\w*, y prepárame \w siete|strong="H7651"\w* \w toros|strong="H6499"\w* y \w siete|strong="H7651"\w* carneros”.   
\p
\v 2 \w Balac|strong="H1111"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que \w Balaam|strong="H1109"\w* le pidió, y juntos ofrecieron un \w toro|strong="H6499"\w* y un carnero en cada uno de los \w altares|strong="H4196"\w*.  
\v 3 Entonces \w Balaam|strong="H1109"\w* \w le|strong="H5921"\w* \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balac|strong="H1111"\w*: “Quédate aquí \w junto|strong="H5921"\w* \w a|strong="H3068"\w* tu ofrenda mientras yo \w me|strong="H5921"\w* alejo un poco. \w A|strong="H3068"\w* \w lo|strong="H1697"\w* mejor Yahvé viene \w a|strong="H3068"\w* encontrarse conmigo, \w y|strong="H5921"\w* yo \w te|strong="H5921"\w* informaré todo \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w él|strong="H5921"\w* \w me|strong="H5921"\w* muestre”.  
\p \w Balaam|strong="H1109"\w* \w se|strong="H5921"\w* \w fue|strong="H3212"\w* \w solo|strong="H8205"\w* \w a|strong="H3068"\w* un cerro desierto.  
\v 4 \w Y|strong="H3068"\w* Dios se le apareció \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*. \w Balaam|strong="H1109"\w* le \w dijo|strong="H1109"\w*: “He preparado \w siete|strong="H7651"\w* \w altares|strong="H4196"\w*, y en cada uno he ofrecido un \w toro|strong="H6499"\w* y un carnero”.   
\p
\v 5 Yahvé le \w dio|strong="H7725"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* el mensaje \w que|strong="H1697"\w* debía entregar, diciéndole: “Regresa \w a|strong="H3068"\w* donde está \w Balac|strong="H1111"\w* \w y|strong="H3541"\w* dile \w esto|strong="H1697"\w*”.   
\p
\v 6 Balaam regresó \w y|strong="H5921"\w* encontró \w a|strong="H3068"\w* Balac todavía \w de|strong="H5921"\w* pie \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* ofrenda, acompañado \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*.  
\v 7 Entonces Balaam \w pronunció|strong="H5375"\w* esta profecía:  
\q1 “\w Desde|strong="H4480"\w* Aram \w me|strong="H4480"\w* hizo \w venir|strong="H3212"\w* \w Balac|strong="H1111"\w*;  
\q2 el \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Moab|strong="H4124"\w* \w me|strong="H4480"\w* \w trajo|strong="H5375"\w* \w desde|strong="H4480"\w* los montes \w del|strong="H4480"\w* este.  
\q1 \w Me|strong="H4480"\w* dijo: ‘\w Ven|strong="H3212"\w*, maldice \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* \w por|strong="H4480"\w* \w mí|strong="H5375"\w*;  
\q2 \w ven|strong="H3212"\w*, condena \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*’.   
\q1
\v 8 Pero, ¿\w cómo|strong="H4100"\w* puedo maldecir \w a|strong="H3068"\w* \w quien|strong="H4100"\w* \w Dios|strong="H3068"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* maldecido?  
\q2 ¿\w Cómo|strong="H4100"\w* puedo condenar \w a|strong="H3068"\w* \w quien|strong="H4100"\w* Yahvé \w no|strong="H3808"\w* \w ha|strong="H3808"\w* condenado?   
\q1
\v 9 Desde \w lo|strong="H3808"\w* alto \w de|strong="H3588"\w* las rocas \w los|strong="H3588"\w* \w veo|strong="H7200"\w*,  
\q2 desde las colinas \w los|strong="H3588"\w* observo.  
\q1 \w Son|strong="H3588"\w* un \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* vive apartado,  
\q2 \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* considera \w como|strong="H3588"\w* las demás \w naciones|strong="H1471"\w*.   
\q1
\v 10 ¿\w Quién|strong="H4310"\w* puede contar \w el|strong="H4310"\w* \w polvo|strong="H6083"\w* \w que|strong="H4310"\w* \w es|strong="H1961"\w* \w Jacob|strong="H3290"\w*,  
\q2 \w o|strong="H3068"\w* calcular siquiera \w a|strong="H3068"\w* una cuarta parte de \w Israel|strong="H3478"\w*?  
\q1 ¡\w Ojalá|strong="H4310"\w* \w yo|strong="H5315"\w* \w muera|strong="H4191"\w* \w como|strong="H3644"\w* \w mueren|strong="H4191"\w* \w los|strong="H1961"\w* hombres justos!  
\q2 ¡\w Ojalá|strong="H4310"\w* \w mi|strong="H1961"\w* fin \w sea|strong="H1961"\w* \w como|strong="H3644"\w* \w el|strong="H4310"\w* de ellos!”.   
\p
\v 11 \w Balac|strong="H1111"\w* le reclamó \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “¿\w Qué|strong="H4100"\w* me has \w hecho|strong="H6213"\w*? Te traje para \w que|strong="H4100"\w* maldijeras \w a|strong="H3068"\w* mis enemigos, ¡y resulta \w que|strong="H4100"\w* los has llenado de \w bendiciones|strong="H1288"\w*!”.   
\p
\v 12 Pero Balaam le \w respondió|strong="H6030"\w*: “\w Tengo|strong="H1696"\w* \w que|strong="H3808"\w* tener mucho cuidado de decir exactamente \w lo|strong="H3808"\w* \w que|strong="H3808"\w* Yahvé \w ponga|strong="H7760"\w* en \w mi|strong="H6030"\w* \w boca|strong="H6310"\w*”.   
\p
\v 13 \w Balac|strong="H1111"\w* le dijo: “Por favor, \w ven|strong="H3212"\w* conmigo \w a|strong="H3068"\w* \w otro|strong="H7097"\w* \w lugar|strong="H4725"\w* desde \w donde|strong="H8033"\w* puedas verlos. Solo \w podrás|strong="H3808"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* una \w parte|strong="H4725"\w* del pueblo, \w no|strong="H3808"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w*. Maldícelos desde \w allí|strong="H8033"\w* por mí”.   
\p
\v 14 Así \w que|strong="H6449"\w* lo \w llevó|strong="H3947"\w* al \w campo|strong="H7704"\w* de Zofim, \w a|strong="H3068"\w* la \w cumbre|strong="H7218"\w* \w del|strong="H4196"\w* monte Pisga. Allí volvió \w a|strong="H3068"\w* construir \w siete|strong="H7651"\w* \w altares|strong="H4196"\w* y \w ofreció|strong="H5927"\w* un \w toro|strong="H6499"\w* y un carnero en cada \w altar|strong="H4196"\w*.  
\v 15 Balaam \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Balac|strong="H1111"\w*: “Quédate \w aquí|strong="H3541"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* tu ofrenda mientras yo voy \w a|strong="H3068"\w* encontrarme \w con|strong="H5921"\w* Dios allá”.   
\p
\v 16 Yahvé se encontró con \w Balaam|strong="H1109"\w*, le \w dio|strong="H7725"\w* un mensaje \w y|strong="H3541"\w* le \w ordenó|strong="H7760"\w*: “Regresa \w a|strong="H3068"\w* donde está \w Balac|strong="H1111"\w* \w y|strong="H3541"\w* dile \w esto|strong="H1697"\w*”.   
\p
\v 17 Balaam regresó \w y|strong="H5921"\w* encontró \w a|strong="H3068"\w* \w Balac|strong="H1111"\w* \w de|strong="H5921"\w* pie \w junto|strong="H5921"\w* \w a|strong="H3068"\w* su ofrenda, rodeado \w de|strong="H5921"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*. \w Balac|strong="H1111"\w* \w le|strong="H5921"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w dijo|strong="H1696"\w* Yahvé?”.   
\p
\v 18 Entonces Balaam \w pronunció|strong="H5375"\w* su profecía:  
\q1 “¡Pon atención, \w Balac|strong="H1111"\w*, \w y|strong="H5704"\w* \w escucha|strong="H8085"\w*!  
\q2 ¡\w Escúchame|strong="H8085"\w* bien, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Zipor!   
\q1
\v 19 Dios \w no|strong="H3808"\w* \w es|strong="H1931"\w* un simple humano para andar \w mintiendo|strong="H3576"\w*,  
\q2 \w ni|strong="H3808"\w* cambia \w de|strong="H1121"\w* opinión \w como|strong="H1931"\w* \w los|strong="H1121"\w* mortales.  
\q1 ¿Acaso \w él|strong="H1931"\w* promete algo y \w no|strong="H3808"\w* \w lo|strong="H1931"\w* cumple?  
\q2 ¿Acaso \w habla|strong="H1696"\w* y \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w hace|strong="H6213"\w* realidad?   
\q1
\v 20 Escucha: he recibido la orden de bendecir;  
\q2 él los \w ha|strong="H3808"\w* bendecido, y \w yo|strong="H2009"\w* \w no|strong="H3808"\w* puedo cambiar eso.   
\q1
\v 21 \w Dios|strong="H3068"\w* \w no|strong="H3808"\w* \w le|strong="H5973"\w* \w ha|strong="H3808"\w* encontrado faltas \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*,  
\q2 \w ni|strong="H3808"\w* \w ha|strong="H3808"\w* \w visto|strong="H7200"\w* maldad \w en|strong="H5973"\w* \w Israel|strong="H3478"\w*.  
\q1 Yahvé su \w Dios|strong="H3068"\w* está \w con|strong="H5973"\w* ellos,  
\q2 y \w lo|strong="H3808"\w* aclaman \w como|strong="H5973"\w* \w a|strong="H3068"\w* su \w Rey|strong="H4428"\w*.   
\q1
\v 22 Dios los \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w*;  
\q2 son tan fuertes como un toro salvaje.   
\q1
\v 23 \w No|strong="H3808"\w* hay brujería \w que|strong="H3588"\w* valga \w contra|strong="H3478"\w* \w Jacob|strong="H3290"\w*,  
\q2 \w ni|strong="H3808"\w* \w adivinación|strong="H7081"\w* \w que|strong="H3588"\w* funcione \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*.  
\q1 \w De|strong="H3588"\w* \w Jacob|strong="H3290"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* ahora \w se|strong="H3808"\w* dirá:  
\q2 ‘¡Miren las maravillas \w que|strong="H3588"\w* \w ha|strong="H3808"\w* hecho Dios!’.   
\q1
\v 24 Es un \w pueblo|strong="H5971"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w levanta|strong="H5375"\w* \w como|strong="H5704"\w* leona;  
\q2 \w que|strong="H3808"\w* \w se|strong="H3808"\w* yergue \w como|strong="H5704"\w* un león.  
\q1 \w No|strong="H3808"\w* \w descansa|strong="H7901"\w* \w hasta|strong="H5704"\w* tragarse \w a|strong="H3068"\w* su presa,  
\q2 \w hasta|strong="H5704"\w* \w beber|strong="H8354"\w* la \w sangre|strong="H1818"\w* \w de|strong="H5704"\w* sus víctimas”.   
\p
\v 25 \w Entonces|strong="H1571"\w* \w Balac|strong="H1111"\w* le \w dijo|strong="H1109"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*: “¡\w Si|strong="H1571"\w* \w no|strong="H3808"\w* los vas \w a|strong="H3068"\w* maldecir, por \w lo|strong="H3808"\w* menos \w no|strong="H3808"\w* los bendigas!”.   
\p
\v 26 \w Y|strong="H3068"\w* \w Balaam|strong="H1109"\w* le \w respondió|strong="H6030"\w*: “¿\w No|strong="H3808"\w* te advertí ya \w que|strong="H3808"\w* \w tengo|strong="H1696"\w* \w que|strong="H3808"\w* \w hacer|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* Yahvé me ordene?”.   
\p
\v 27 \w Balac|strong="H1111"\w* insistió: “\w Ven|strong="H3212"\w*, \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* intentar \w en|strong="H3212"\w* otro \w lugar|strong="H4725"\w*. \w A|strong="H3068"\w* lo \w mejor|strong="H3474"\w* \w a|strong="H3068"\w* Dios \w le|strong="H5869"\w* parece \w bien|strong="H5869"\w* \w que|strong="H4994"\w* los maldigas desde \w allí|strong="H8033"\w*”.   
\p
\v 28 \w Balac|strong="H1111"\w* \w se|strong="H5921"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w cumbre|strong="H7218"\w* \w del|strong="H5921"\w* monte Peor, \w que|strong="H5921"\w* tiene vista \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* desierto.  
\v 29 \w Y|strong="H3068"\w* \w Balaam|strong="H1109"\w* volvió \w a|strong="H3068"\w* pedirle: “Constrúyeme \w aquí|strong="H2088"\w* \w siete|strong="H7651"\w* \w altares|strong="H4196"\w*, y prepárame \w siete|strong="H7651"\w* \w toros|strong="H6499"\w* y \w siete|strong="H7651"\w* carneros”.   
\p
\v 30 \w Balac|strong="H1111"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que \w Balaam|strong="H1109"\w* le pidió, y \w ofreció|strong="H6213"\w* un \w toro|strong="H6499"\w* y un carnero en cada \w altar|strong="H4196"\w*.   
\c 24  
\p
\v 1 Al \w ver|strong="H7200"\w* \w Balaam|strong="H1109"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* Yahvé \w le|strong="H5869"\w* agradaba bendecir \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, ya \w no|strong="H3808"\w* \w fue|strong="H1980"\w* \w a|strong="H3068"\w* buscar presagios mágicos \w como|strong="H3588"\w* las otras \w veces|strong="H6471"\w*. \w En|strong="H3588"\w* lugar \w de|strong="H3588"\w* eso, dirigió \w su|strong="H3588"\w* mirada \w hacia|strong="H6440"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*.  
\v 2 \w Al|strong="H5921"\w* alzar \w la|strong="H5921"\w* vista \w y|strong="H5921"\w* \w ver|strong="H7200"\w* \w al|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* acampado, \w ordenado|strong="H1961"\w* \w por|strong="H5921"\w* \w tribus|strong="H7626"\w*, \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*,  
\v 3 y \w pronunció|strong="H5375"\w* esta profecía:  
\q1 “Mensaje \w de|strong="H1121"\w* \w Balaam|strong="H1109"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Beor;  
\q2 mensaje del \w hombre|strong="H1397"\w* \w que|strong="H1121"\w* ve con claridad.   
\q1
\v 4 Mensaje del que \w escucha|strong="H8085"\w* las palabras \w de|strong="H5869"\w* Dios,  
\q2 del que tiene visiones del \w Todopoderoso|strong="H7706"\w*,  
\q2 del que \w cae|strong="H5307"\w* al suelo pero tiene los \w ojos|strong="H5869"\w* \w bien|strong="H5869"\w* abiertos:   
\q1
\v 5 ¡\w Qué|strong="H4100"\w* hermosas son tus \w tiendas|strong="H4908"\w*, \w Jacob|strong="H3290"\w*!  
\q2 ¡\w Qué|strong="H4100"\w* bellos son tus campamentos, \w Israel|strong="H3478"\w*!   
\q1
\v 6 \w Se|strong="H5921"\w* extienden \w como|strong="H5921"\w* valles,  
\q2 \w como|strong="H5921"\w* jardines \w junto|strong="H5921"\w* \w a|strong="H3068"\w* un \w río|strong="H5104"\w*;  
\q2 son \w como|strong="H5921"\w* áloes \w plantados|strong="H5193"\w* \w por|strong="H5921"\w* Yahvé,  
\q2 \w como|strong="H5921"\w* cedros \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w agua|strong="H4325"\w*.   
\q1
\v 7 \w De|strong="H4325"\w* sus cántaros el \w agua|strong="H4325"\w* se desborda;  
\q2 su semilla tendrá \w agua|strong="H4325"\w* en abundancia.  
\q1 Su \w rey|strong="H4428"\w* será \w más|strong="H7227"\w* poderoso \w que|strong="H4325"\w* Agag,  
\q2 y su \w reino|strong="H4438"\w* será muy respetado.   
\q1
\v 8 Dios los \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w*;  
\q2 son tan fuertes como un toro salvaje.  
\q1 Israel devorará \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* enemigas;  
\q2 les romperá los \w huesos|strong="H6106"\w*  
\q2 y los atravesará con sus flechas.   
\q1
\v 9 Se acuesta \w a|strong="H3068"\w* descansar como un león;  
\q2 como una leona, ¿\w quién|strong="H4310"\w* se atreve \w a|strong="H3068"\w* despertarlo?  
\q1 ¡\w Benditos|strong="H1288"\w* sean los \w que|strong="H4310"\w* te bendigan,  
\q2 y malditos los \w que|strong="H4310"\w* te maldigan!”.   
\p
\v 10 \w Balac|strong="H1111"\w* se enfureció tanto con \w Balaam|strong="H1109"\w* \w que|strong="H2088"\w* golpeó las \w manos|strong="H3709"\w* de rabia y le \w dijo|strong="H1109"\w*: “Te mandé \w llamar|strong="H7121"\w* para \w que|strong="H2088"\w* maldijeras \w a|strong="H3068"\w* mis enemigos, ¡y resulta \w que|strong="H2088"\w* \w ya|strong="H2088"\w* los has bendecido \w tres|strong="H7969"\w* \w veces|strong="H6471"\w*!  
\v 11 ¡Lárgate \w ya|strong="H6258"\w* \w a|strong="H3068"\w* tu casa! Pensaba darte grandes honores, pero \w ya|strong="H6258"\w* ves \w que|strong="H6258"\w* Yahvé te ha dejado sin nada”.   
\p
\v 12 \w Balaam|strong="H1109"\w* le contestó \w a|strong="H3068"\w* \w Balac|strong="H1111"\w*: “Yo \w se|strong="H3808"\w* \w lo|strong="H3808"\w* advertí muy bien \w a|strong="H3068"\w* los \w mensajeros|strong="H4397"\w* \w que|strong="H3808"\w* me \w enviaste|strong="H7971"\w*. Les \w dije|strong="H1696"\w*:  
\v 13 ‘\w Aunque|strong="H3808"\w* \w Balac|strong="H1111"\w* me regalara su palacio \w lleno|strong="H4393"\w* \w de|strong="H5414"\w* \w plata|strong="H3701"\w* y \w oro|strong="H2091"\w*, \w yo|strong="H6213"\w* \w no|strong="H3808"\w* podría desobedecer la orden \w de|strong="H5414"\w* Yahvé \w haciendo|strong="H6213"\w* algo \w bueno|strong="H2896"\w* \w o|strong="H3068"\w* \w malo|strong="H7451"\w* \w por|strong="H5414"\w* mi propia cuenta. Solo \w puedo|strong="H3201"\w* decir \w lo|strong="H3808"\w* \w que|strong="H3808"\w* Yahvé me ordene decir’.  
\v 14 \w Así|strong="H2088"\w* \w que|strong="H6258"\w* \w ahora|strong="H6258"\w* me regreso \w a|strong="H3068"\w* mi tierra. Pero \w antes|strong="H2088"\w* \w de|strong="H5971"\w* \w irme|strong="H3212"\w*, te \w voy|strong="H1980"\w* \w a|strong="H3068"\w* anunciar \w lo|strong="H2088"\w* \w que|strong="H6258"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* le \w hará|strong="H6213"\w* al \w tuyo|strong="H6258"\w* \w en|strong="H3212"\w* \w el|strong="H6213"\w* futuro”.   
\p
\v 15 \w Y|strong="H3068"\w* \w pronunció|strong="H5375"\w* esta profecía:  
\q1 “Mensaje \w de|strong="H1121"\w* \w Balaam|strong="H1109"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Beor;  
\q2 mensaje del \w hombre|strong="H1397"\w* \w que|strong="H1121"\w* ve con claridad.   
\q2
\v 16 Mensaje del \w que|strong="H3045"\w* \w escucha|strong="H8085"\w* las palabras \w de|strong="H5869"\w* Dios,  
\q2 del \w que|strong="H3045"\w* \w conoce|strong="H3045"\w* la \w sabiduría|strong="H1847"\w* del \w Altísimo|strong="H5945"\w*,  
\q2 del \w que|strong="H3045"\w* tiene visiones del \w Todopoderoso|strong="H7706"\w*,  
\q2 del \w que|strong="H3045"\w* \w cae|strong="H5307"\w* al suelo pero tiene los \w ojos|strong="H5869"\w* \w bien|strong="H5869"\w* abiertos:   
\q1
\v 17 \w Lo|strong="H3808"\w* \w veo|strong="H7200"\w*, pero \w no|strong="H3808"\w* \w ahora|strong="H6258"\w*;  
\q2 \w lo|strong="H3808"\w* contemplo, pero \w no|strong="H3808"\w* \w está|strong="H6965"\w* \w cerca|strong="H7138"\w*.  
\q1 Una \w estrella|strong="H3556"\w* surgirá \w de|strong="H1121"\w* \w Jacob|strong="H3290"\w*;  
\q2 un rey \w se|strong="H3808"\w* \w levantará|strong="H6965"\w* en \w Israel|strong="H3478"\w*.  
\q1 Le aplastará \w la|strong="H3605"\w* cabeza \w a|strong="H3068"\w* \w Moab|strong="H4124"\w*,  
\q2 y acabará con \w todos|strong="H3605"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Set.   
\q1
\v 18 Conquistará \w a|strong="H3068"\w* Edom;  
\q2 \w se|strong="H1961"\w* adueñará de \w Seir|strong="H8165"\w*, su enemigo,  
\q2 mientras \w que|strong="H1961"\w* \w Israel|strong="H3478"\w* \w se|strong="H1961"\w* fortalecerá.   
\q1
\v 19 De \w Jacob|strong="H3290"\w* saldrá un líder  
\q2 que destruirá \w a|strong="H3068"\w* los que queden en la \w ciudad|strong="H5892"\w*”.   
\p
\v 20 Luego Balaam \w vio|strong="H7200"\w* \w a|strong="H3068"\w* los amalecitas y \w pronunció|strong="H5375"\w* esta profecía:  
\q1 “\w Amalec|strong="H6002"\w* fue la primera entre las \w naciones|strong="H1471"\w*,  
\q2 pero al final será destruida \w por|strong="H5703"\w* completo”.   
\p
\v 21 Después \w vio|strong="H7200"\w* \w a|strong="H3068"\w* los quenitas y \w pronunció|strong="H5375"\w* esta profecía:  
\q1 “Tu casa es muy segura;  
\q2 has puesto tu \w nido|strong="H7064"\w* en las rocas.   
\q1
\v 22 \w Pero|strong="H3588"\w* \w los|strong="H3588"\w* quenitas \w serán|strong="H1961"\w* destruidos,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* Asiria \w se|strong="H1961"\w* \w los|strong="H3588"\w* lleve prisioneros”.   
\p
\v 23 Finalmente, \w pronunció|strong="H5375"\w* esta otra profecía:  
\q1 “¡Ay! ¿\w Quién|strong="H4310"\w* podrá sobrevivir cuando Dios haga esto?   
\q2
\v 24 Llegarán barcos desde las costas de Quitim;  
\q1 oprimirán \w a|strong="H3068"\w* Asiria \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w Heber|strong="H5677"\w*,  
\q2 pero al final, \w ellos|strong="H3027"\w* \w también|strong="H1571"\w* \w serán|strong="H1931"\w* destruidos”.   
\p
\v 25 Después de esto, \w Balaam|strong="H1109"\w* se \w levantó|strong="H6965"\w* \w y|strong="H1571"\w* se regresó \w a|strong="H3068"\w* su tierra; \w y|strong="H1571"\w* \w Balac|strong="H1111"\w* \w también|strong="H1571"\w* se \w fue|strong="H3212"\w* \w por|strong="H1870"\w* su lado.   
\c 25  
\p
\v 1 Mientras \w Israel|strong="H3478"\w* \w estaba|strong="H3427"\w* acampado en Sitim, \w el|strong="H3427"\w* \w pueblo|strong="H5971"\w* \w comenzó|strong="H2490"\w* \w a|strong="H3068"\w* prostituirse con las \w mujeres|strong="H1323"\w* \w de|strong="H5971"\w* \w Moab|strong="H4124"\w*;  
\v 2 pues ellas invitaban \w a|strong="H3068"\w* los hombres \w a|strong="H3068"\w* los \w sacrificios|strong="H2077"\w* \w de|strong="H5971"\w* sus dioses. El \w pueblo|strong="H5971"\w* comió \w de|strong="H5971"\w* los \w sacrificios|strong="H2077"\w* y \w se|strong="H5971"\w* inclinó ante esos dioses.  
\v 3 De esta manera, \w Israel|strong="H3478"\w* se unió \w a|strong="H3068"\w* la adoración de Baal de Peor, y el enojo de Yahvé se encendió \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*.  
\v 4 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Reúne \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes del \w pueblo|strong="H5971"\w* y ahórquenlos \w delante|strong="H5048"\w* \w de|strong="H5048"\w* Yahvé \w a|strong="H3068"\w* plena luz del día, \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* ardiente enojo \w de|strong="H5048"\w* Yahvé \w se|strong="H5971"\w* aparte \w de|strong="H5048"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 5 Entonces \w Moisés|strong="H4872"\w* les dijo \w a|strong="H3068"\w* los \w jueces|strong="H8199"\w* de \w Israel|strong="H3478"\w*: “Cada uno de ustedes debe matar \w a|strong="H3068"\w* aquellos de sus hombres que se hayan unido \w a|strong="H3068"\w* Baal de Peor”.   
\p
\v 6 En ese momento, un \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* llegó al campamento trayendo \w a|strong="H3068"\w* una mujer \w madianita|strong="H4084"\w* para presentarla \w a|strong="H3068"\w* \w sus|strong="H1992"\w* familiares. \w Lo|strong="H1992"\w* hizo \w a|strong="H3068"\w* \w la|strong="H3605"\w* vista \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w* y \w de|strong="H1121"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w israelita|strong="H3478"\w*, \w mientras|strong="H3605"\w* \w ellos|strong="H1992"\w* \w lloraban|strong="H1058"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada \w de|strong="H1121"\w* \w la|strong="H3605"\w* Tienda del Encuentro.  
\v 7 Cuando Finees, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Eleazar y \w nieto|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Aarón, \w vio|strong="H7200"\w* esto, se \w levantó|strong="H6965"\w* \w de|strong="H1121"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* la asamblea, \w tomó|strong="H3947"\w* una \w lanza|strong="H7420"\w* \w en|strong="H8432"\w* su \w mano|strong="H3027"\w*,  
\v 8 \w y|strong="H5921"\w* siguió \w al|strong="H5921"\w* \w israelita|strong="H3478"\w* \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* interior \w de|strong="H5921"\w* \w la|strong="H5921"\w* tienda. Allí \w los|strong="H1121"\w* atravesó \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* vientre, \w tanto|strong="H5921"\w* \w al|strong="H5921"\w* \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* mujer. \w Con|strong="H5921"\w* esto \w se|strong="H5921"\w* detuvo \w la|strong="H5921"\w* \w plaga|strong="H4046"\w* \w que|strong="H5921"\w* estaba matando \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas.  
\v 9 Sin embargo, \w veinticuatro|strong="H6242"\w* mil personas \w murieron|strong="H4191"\w* \w a|strong="H3068"\w* causa de esa \w plaga|strong="H4046"\w*.   
\p
\v 10 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 11 “Finees, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Eleazar \w y|strong="H5921"\w* \w nieto|strong="H1121"\w* \w del|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Aarón, \w ha|strong="H3808"\w* apartado \w mi|strong="H5921"\w* \w enojo|strong="H2534"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Él|strong="H5921"\w* demostró \w el|strong="H5921"\w* mismo \w celo|strong="H7068"\w* \w que|strong="H3808"\w* yo siento \w por|strong="H5921"\w* ustedes, \w y|strong="H5921"\w* \w por|strong="H5921"\w* eso \w no|strong="H3808"\w* destruí \w por|strong="H5921"\w* completo \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w celo|strong="H7068"\w*.  
\v 12 \w Por|strong="H3651"\w* lo \w tanto|strong="H3651"\w*, dile que le concedo mi \w pacto|strong="H1285"\w* \w de|strong="H5414"\w* \w paz|strong="H7965"\w*.  
\v 13 \w Este|strong="H1961"\w* \w será|strong="H1961"\w* un \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* \w sacerdocio|strong="H3550"\w* \w perpetuo|strong="H5769"\w* \w para|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* sus descendientes, \w porque|strong="H5921"\w* \w tuvo|strong="H1961"\w* \w celo|strong="H7065"\w* \w por|strong="H5921"\w* su Dios \w e|strong="H3068"\w* hizo \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 14 \w El|strong="H1121"\w* \w israelita|strong="H3478"\w* \w que|strong="H1121"\w* fue asesinado junto \w a|strong="H3068"\w* la mujer \w madianita|strong="H4084"\w* se \w llamaba|strong="H8034"\w* \w Zimri|strong="H2174"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Salu|strong="H5543"\w*, líder \w de|strong="H1121"\w* una \w familia|strong="H1004"\w* \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* \w Simeón|strong="H8099"\w*.  
\v 15 \w Y|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w madianita|strong="H4084"\w* asesinada \w se|strong="H1931"\w* \w llamaba|strong="H8034"\w* Cozbi, \w hija|strong="H1323"\w* de Zur. \w Su|strong="H1931"\w* padre \w era|strong="H1931"\w* \w jefe|strong="H7218"\w* de una de las \w familias|strong="H1004"\w* patriarcales de \w Madián|strong="H4080"\w*.   
\p
\v 16 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 17 “Ataquen \w a|strong="H3068"\w* los madianitas y destrúyanlos,  
\v 18 \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w los|strong="H1992"\w* atacaron \w a|strong="H3068"\w* ustedes \w con|strong="H5921"\w* \w sus|strong="H1992"\w* engaños. \w Los|strong="H1992"\w* engañaron \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w asunto|strong="H1697"\w* \w de|strong="H5921"\w* Peor \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* caso \w de|strong="H5921"\w* Cozbi, \w la|strong="H5921"\w* \w hija|strong="H1323"\w* \w del|strong="H5921"\w* líder madianita, \w que|strong="H3588"\w* fue asesinada \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w plaga|strong="H4046"\w* causada \w por|strong="H5921"\w* \w lo|strong="H1697"\w* \w de|strong="H5921"\w* Peor”.   
\c 26  
\p
\v 1 Después \w de|strong="H1121"\w* la plaga, Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y al \w sacerdote|strong="H3548"\w* Eleazar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Aarón:  
\v 2 “Hagan un censo \w de|strong="H1121"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, anotando \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* para \w arriba|strong="H4605"\w*, según sus \w familias|strong="H1004"\w* patriarcales. Cuenten \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* sean aptos para ir \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w guerra|strong="H6635"\w* por \w Israel|strong="H3478"\w*”.  
\v 3 \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Eleazar \w hablaron|strong="H1696"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* pueblo \w en|strong="H5921"\w* \w las|strong="H5921"\w* llanuras \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* río \w Jordán|strong="H3383"\w*, frente \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*, \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w dijeron|strong="H1696"\w*:  
\v 4 “Hagan un censo \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* para \w arriba|strong="H4605"\w*, tal como Yahvé se lo \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas al \w salir|strong="H3318"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*”.   
\p
\v 5 \w Rubén|strong="H7205"\w* fue \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* mayor \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w* fueron: \w de|strong="H1121"\w* Hanoc, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* hanoquitas; \w de|strong="H1121"\w* Falú, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* faluitas;  
\v 6 de Esrom, el clan de los esromitas; de \w Carmi|strong="H3756"\w*, el clan de los carmitas.  
\v 7 Estos \w fueron|strong="H1961"\w* \w los|strong="H1961"\w* clanes de Rubén, y \w los|strong="H1961"\w* anotados en el censo \w fueron|strong="H1961"\w* cuarenta y \w tres|strong="H7969"\w* \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* \w treinta|strong="H7970"\w*.  
\v 8 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Falú fue Eliab.  
\v 9 \w Y|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Eliab fueron \w Nemuel|strong="H5241"\w*, Datán \w y|strong="H5921"\w* Abiram. \w Estos|strong="H1931"\w* son \w los|strong="H1121"\w* mismos Datán \w y|strong="H5921"\w* Abiram, líderes \w de|strong="H5921"\w* \w la|strong="H1931"\w* comunidad, \w que|strong="H1931"\w* \w se|strong="H1931"\w* rebelaron \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* Aarón \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H1121"\w* seguidores \w de|strong="H5921"\w* \w Coré|strong="H7141"\w*, cuando \w se|strong="H1931"\w* rebelaron \w contra|strong="H5921"\w* Yahvé.  
\v 10 En esa ocasión, la tierra \w se|strong="H1961"\w* \w abrió|strong="H6605"\w* y \w se|strong="H1961"\w* \w los|strong="H1961"\w* tragó junto con \w Coré|strong="H7141"\w*. Así murieron sus seguidores, y el fuego consumió \w a|strong="H3068"\w* \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w* hombres, sirviendo esto de escarmiento.  
\v 11 \w Sin|strong="H3808"\w* embargo, \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Coré|strong="H7141"\w* \w no|strong="H3808"\w* \w murieron|strong="H4191"\w*.  
\v 12 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Simeón|strong="H8095"\w*, por clanes, fueron: \w de|strong="H1121"\w* \w Nemuel|strong="H5241"\w*, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* nemuelitas; \w de|strong="H1121"\w* \w Jamín|strong="H3226"\w*, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* jaminitas; \w de|strong="H1121"\w* Jaquín, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* jaquinitas;  
\v 13 de \w Zera|strong="H2226"\w*, el clan de los zeraítas; de \w Saúl|strong="H7586"\w*, el clan de los saulitas.  
\v 14 Estos fueron los clanes de \w Simeón|strong="H8099"\w*: \w veintidós|strong="H6242"\w* \w mil|strong="H3967"\w* \w doscientos|strong="H3967"\w* \w hombres|strong="H8147"\w*.  
\v 15 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Gad|strong="H1410"\w*, por clanes, fueron: \w de|strong="H1121"\w* Zefón, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* zefonitas; \w de|strong="H1121"\w* Hagi, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* haguitas; \w de|strong="H1121"\w* Suni, \w el|strong="H1121"\w* clan \w de|strong="H1121"\w* \w los|strong="H1121"\w* sunitas;  
\v 16 de Ozni, el clan de los oznitas; de Eri, el clan de los eritas;  
\v 17 de Arod, el clan de los aroditas; de Areli, el clan de los arelitas.  
\v 18 Estos fueron \w los|strong="H1121"\w* clanes \w de|strong="H2568"\w* \w Gad|strong="H1410"\w*; y \w los|strong="H1121"\w* anotados en su censo fueron cuarenta \w mil|strong="H3967"\w* \w quinientos|strong="H2568"\w*.  
