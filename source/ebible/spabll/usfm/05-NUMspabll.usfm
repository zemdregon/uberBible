\v 22 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w eso|strong="H3651"\w*, \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* entraron \w a|strong="H3068"\w* realizar su servicio \w en|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, bajo \w la|strong="H5921"\w* supervisión \w de|strong="H5921"\w* Aarón \w y|strong="H5921"\w* \w de|strong="H5921"\w* sus \w hijos|strong="H1121"\w*; \w tal|strong="H3651"\w* \w como|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*, \w así|strong="H3651"\w* \w hicieron|strong="H6213"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*.   
\p
\v 23 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 24 “\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* regla para \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*: \w a|strong="H3068"\w* partir \w de|strong="H2568"\w* \w los|strong="H1121"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w de|strong="H2568"\w* \w edad|strong="H8141"\w* entrarán \w a|strong="H3068"\w* servir en \w el|strong="H1121"\w* trabajo \w de|strong="H2568"\w* \w la|strong="H2063"\w* Tienda del Encuentro;  
\v 25 pero \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w cincuenta|strong="H2572"\w* \w años|strong="H8141"\w* \w se|strong="H3808"\w* retirarán del servicio activo, y \w no|strong="H3808"\w* trabajarán \w más|strong="H5750"\w*.  
\v 26 Solo ayudarán \w a|strong="H3068"\w* sus hermanos en \w la|strong="H8104"\w* Tienda del Encuentro \w a|strong="H3068"\w* cumplir con sus deberes de guardia, pero \w no|strong="H3808"\w* realizarán \w ningún|strong="H3808"\w* trabajo pesado. \w Así|strong="H3602"\w* organizarás \w a|strong="H3068"\w* los \w levitas|strong="H3881"\w* en cuanto \w a|strong="H3068"\w* sus obligaciones”.   
\c 9  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w en|strong="H3318"\w* el \w desierto|strong="H4057"\w* del \w Sinaí|strong="H5514"\w*, \w en|strong="H3318"\w* el \w primer|strong="H7223"\w* \w mes|strong="H2320"\w* del \w segundo|strong="H8145"\w* \w año|strong="H8141"\w* \w después|strong="H8145"\w* de que \w salieron|strong="H3318"\w* de la tierra de \w Egipto|strong="H4714"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Que|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* celebren la \w Pascua|strong="H6453"\w* en \w el|strong="H1121"\w* \w tiempo|strong="H4150"\w* \w señalado|strong="H4150"\w*.  
\v 3 \w El|strong="H3605"\w* \w día|strong="H3117"\w* catorce de \w este|strong="H2088"\w* \w mes|strong="H2320"\w*, al atardecer, \w la|strong="H3605"\w* celebrarán \w a|strong="H3068"\w* su \w tiempo|strong="H3117"\w*. \w La|strong="H3605"\w* celebrarán según \w todos|strong="H3605"\w* sus \w estatutos|strong="H2708"\w* y según \w todas|strong="H3605"\w* sus \w ordenanzas|strong="H4941"\w*”.   
\p
\v 4 \w Moisés|strong="H4872"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1121"\w* debían \w celebrar|strong="H6213"\w* la \w Pascua|strong="H6453"\w*.  
\v 5 Celebraron \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w* en \w el|strong="H3605"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, \w el|strong="H3605"\w* \w día|strong="H3117"\w* catorce del \w mes|strong="H2320"\w* \w por|strong="H3651"\w* \w la|strong="H3605"\w* \w tarde|strong="H6153"\w*, en \w el|strong="H3605"\w* \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* \w Sinaí|strong="H5514"\w*. Conforme \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3117"\w* Yahvé le \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w así|strong="H3651"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 6 \w Hubo|strong="H1961"\w* algunos hombres \w que|strong="H1931"\w* \w estaban|strong="H1961"\w* impuros \w por|strong="H6440"\w* \w haber|strong="H1961"\w* tocado \w el|strong="H1931"\w* cadáver \w de|strong="H6440"\w* una \w persona|strong="H5315"\w*, \w por|strong="H6440"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* \w celebrar|strong="H6213"\w* \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, y \w se|strong="H1961"\w* presentaron \w ante|strong="H6440"\w* \w Moisés|strong="H4872"\w* y Aarón \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*.  
\v 7 \w Aquellos|strong="H1992"\w* \w hombres|strong="H1121"\w* le dijeron: “Estamos impuros \w por|strong="H4100"\w* causa \w de|strong="H1121"\w* un cadáver. ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w se|strong="H1992"\w* \w nos|strong="H4100"\w* impide presentar la \w ofrenda|strong="H7133"\w* \w de|strong="H1121"\w* Yahvé \w en|strong="H8432"\w* \w el|strong="H1121"\w* \w tiempo|strong="H4150"\w* \w señalado|strong="H4150"\w* \w entre|strong="H8432"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*?”.   
\p
\v 8 \w Moisés|strong="H4872"\w* \w les|strong="H6680"\w* respondió: “Esperen aquí, para \w que|strong="H4100"\w* \w yo|strong="H6680"\w* \w escuche|strong="H8085"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* Yahvé \w ordene|strong="H6680"\w* respecto \w a|strong="H3068"\w* ustedes”.   
\p
\v 9 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 10 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: ‘\w Si|strong="H3588"\w* \w alguno|strong="H5315"\w* \w de|strong="H3588"\w* ustedes \w o|strong="H3068"\w* \w de|strong="H3588"\w* sus descendientes \w está|strong="H1961"\w* impuro \w por|strong="H3588"\w* causa \w de|strong="H3588"\w* un cadáver, \w o|strong="H3068"\w* \w se|strong="H1961"\w* encuentra \w de|strong="H3588"\w* \w viaje|strong="H1870"\w* \w lejos|strong="H7350"\w*, \w aun|strong="H3588"\w* \w así|strong="H3588"\w* deberá \w celebrar|strong="H6213"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w a|strong="H3068"\w* Yahvé.  
\v 11 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, \w el|strong="H5921"\w* \w día|strong="H3117"\w* catorce \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w*, \w la|strong="H5921"\w* celebrarán; \w la|strong="H5921"\w* comerán \w con|strong="H5921"\w* panes sin levadura \w y|strong="H5921"\w* hierbas amargas.  
\v 12 \w No|strong="H3808"\w* \w dejarán|strong="H7604"\w* \w nada|strong="H3808"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* cena \w para|strong="H5704"\w* \w la|strong="H3605"\w* \w mañana|strong="H1242"\w* siguiente, \w ni|strong="H3808"\w* \w le|strong="H1242"\w* \w quebrarán|strong="H7665"\w* \w ningún|strong="H3605"\w* \w hueso|strong="H6106"\w*. \w Conforme|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w estatuto|strong="H2708"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w* \w la|strong="H3605"\w* celebrarán.  
\v 13 \w Pero|strong="H3588"\w* \w el|strong="H1931"\w* hombre \w que|strong="H3588"\w* \w esté|strong="H1931"\w* \w limpio|strong="H2889"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* encuentre \w de|strong="H3588"\w* \w viaje|strong="H1870"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* celebre \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w*, \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1961"\w* eliminada \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*. \w Por|strong="H3588"\w* \w no|strong="H3808"\w* \w haber|strong="H1961"\w* presentado \w la|strong="H1931"\w* \w ofrenda|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé \w en|strong="H3588"\w* \w su|strong="H1931"\w* \w tiempo|strong="H4150"\w* \w señalado|strong="H4150"\w*, \w ese|strong="H1931"\w* hombre \w cargará|strong="H1961"\w* \w con|strong="H3588"\w* \w su|strong="H1931"\w* \w pecado|strong="H2399"\w*.   
\p
\v 14 “‘\w Si|strong="H3588"\w* un \w extranjero|strong="H1616"\w* vive \w entre|strong="H3588"\w* ustedes \w y|strong="H3588"\w* desea \w celebrar|strong="H6213"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w a|strong="H3068"\w* Yahvé, \w lo|strong="H6213"\w* \w hará|strong="H6213"\w* según \w el|strong="H3588"\w* \w estatuto|strong="H2708"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w y|strong="H3588"\w* según \w su|strong="H3588"\w* \w ordenanza|strong="H4941"\w*. \w Tendrán|strong="H1961"\w* un solo \w estatuto|strong="H2708"\w*, \w tanto|strong="H3651"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* \w extranjero|strong="H1616"\w* \w como|strong="H3588"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* nacido \w en|strong="H3588"\w* \w el|strong="H3588"\w* país’”.   
\p
\v 15 \w El|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* \w levantó|strong="H6965"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*, \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w cubrió|strong="H3680"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*, \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* \w Testimonio|strong="H5715"\w*. \w Al|strong="H5921"\w* atardecer, \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w* \w tenía|strong="H1961"\w* una \w apariencia|strong="H4758"\w* \w de|strong="H5921"\w* fuego \w que|strong="H5921"\w* duraba \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w*.  
\v 16 \w Así|strong="H3651"\w* ocurría \w continuamente|strong="H8548"\w*. La \w nube|strong="H6051"\w* lo cubría de día, y de \w noche|strong="H3915"\w* \w tenía|strong="H1961"\w* \w apariencia|strong="H4758"\w* de fuego.  
\v 17 \w Cada|strong="H8033"\w* vez \w que|strong="H5921"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w se|strong="H5921"\w* levantaba \w de|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* Tienda, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w se|strong="H5921"\w* ponían \w en|strong="H5921"\w* marcha; \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w se|strong="H5921"\w* detenía, \w allí|strong="H8033"\w* acampaban \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Por|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* avanzaban, \w y|strong="H5921"\w* \w por|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé acampaban. \w Mientras|strong="H3605"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* permanecía \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*, \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* quedaban acampados.  
\v 19 \w Cuando|strong="H3117"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w se|strong="H5921"\w* quedaba \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w* \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* obedecían \w la|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w no|strong="H3808"\w* avanzaban.  
\v 20 \w A|strong="H3068"\w* veces \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w estaba|strong="H1961"\w* solo unos \w pocos|strong="H4557"\w* \w días|strong="H3117"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*; \w entonces|strong="H3117"\w*, \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé, permanecían acampados, \w y|strong="H5921"\w* \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé, \w se|strong="H1961"\w* ponían \w en|strong="H5921"\w* marcha.  
\v 21 \w A|strong="H3068"\w* veces la \w nube|strong="H6051"\w* \w se|strong="H1961"\w* quedaba \w desde|strong="H5704"\w* la \w tarde|strong="H6153"\w* \w hasta|strong="H5704"\w* la \w mañana|strong="H1242"\w*, \w y|strong="H5704"\w* \w cuando|strong="H5704"\w* \w se|strong="H1961"\w* levantaba \w por|strong="H5704"\w* la \w mañana|strong="H1242"\w*, ellos avanzaban; ya \w fuera|strong="H1961"\w* \w de|strong="H5704"\w* \w día|strong="H3119"\w* \w o|strong="H3068"\w* \w de|strong="H5704"\w* \w noche|strong="H3915"\w*, \w cuando|strong="H5704"\w* la \w nube|strong="H6051"\w* \w se|strong="H1961"\w* levantaba, ellos \w se|strong="H1961"\w* ponían \w en|strong="H5704"\w* marcha.  
\v 22 \w Ya|strong="H3068"\w* fuera \w que|strong="H3808"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* permaneciera \w dos|strong="H3117"\w* \w días|strong="H3117"\w*, un \w mes|strong="H2320"\w* \w o|strong="H3068"\w* un año \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w se|strong="H5921"\w* quedaban acampados \w y|strong="H5921"\w* \w no|strong="H3808"\w* viajaban; pero \w cuando|strong="H3117"\w* \w se|strong="H5921"\w* levantaba, \w se|strong="H5921"\w* ponían \w en|strong="H5921"\w* marcha.  
\v 23 \w Al|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé acampaban, \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé viajaban. Cumplieron \w con|strong="H5921"\w* \w las|strong="H5921"\w* instrucciones \w de|strong="H5921"\w* Yahvé, \w según|strong="H5921"\w* \w la|strong="H5921"\w* orden \w que|strong="H5921"\w* Yahvé dio \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*.   
\c 10  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Hazte|strong="H6213"\w* \w dos|strong="H8147"\w* \w trompetas|strong="H2689"\w* de \w plata|strong="H3701"\w*. Las \w harás|strong="H6213"\w* de \w plata|strong="H3701"\w* martillada. Las usarás \w para|strong="H1961"\w* convocar \w a|strong="H3068"\w* la congregación y \w para|strong="H1961"\w* dar la orden de marcha \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w campamentos|strong="H4264"\w*.  
\v 3 Cuando toquen ambas trompetas, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación se reunirá contigo \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada de \w la|strong="H3605"\w* Tienda del Encuentro.  
\v 4 Si tocan una sola, los líderes, los \w jefes|strong="H7218"\w* de los millares de \w Israel|strong="H3478"\w*, se reunirán contigo.  
\v 5 Cuando toquen un toque de \w alarma|strong="H8643"\w*, los \w campamentos|strong="H4264"\w* que están en \w el|strong="H4264"\w* lado este se \w pondrán|strong="H8628"\w* en marcha.  
\v 6 Cuando toquen la \w alarma|strong="H8643"\w* por \w segunda|strong="H8145"\w* vez, los \w campamentos|strong="H4264"\w* que están en \w el|strong="H4264"\w* \w lado|strong="H8145"\w* sur avanzarán. \w Tocarán|strong="H8628"\w* la \w alarma|strong="H8643"\w* para indicar que deben moverse.  
\v 7 Pero cuando \w se|strong="H3808"\w* deba reunir la asamblea, \w tocarán|strong="H8628"\w* las trompetas, pero \w no|strong="H3808"\w* darán el toque de alarma.   
\p
\v 8 “\w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w tocarán|strong="H8628"\w* las \w trompetas|strong="H2689"\w*. Esto les \w servirá|strong="H1961"\w* \w como|strong="H1961"\w* un \w estatuto|strong="H2708"\w* \w perpetuo|strong="H5769"\w* \w por|strong="H5769"\w* \w todas|strong="H1755"\w* sus \w generaciones|strong="H1755"\w*.  
\v 9 \w Cuando|strong="H3588"\w* vayan \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia tierra \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w enemigo|strong="H6887"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* oprime, tocarán \w la|strong="H5921"\w* alarma \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w*. \w Entonces|strong="H3588"\w* serán recordados \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w y|strong="H3588"\w* serán salvados \w de|strong="H5921"\w* sus \w enemigos|strong="H6862"\w*.   
\p
\v 10 “También \w en|strong="H5921"\w* sus \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w alegría|strong="H8057"\w*, \w en|strong="H5921"\w* sus fiestas señaladas \w y|strong="H5921"\w* \w al|strong="H5921"\w* principio \w de|strong="H5921"\w* \w cada|strong="H3117"\w* \w mes|strong="H2320"\w*, \w tocarán|strong="H8628"\w* \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w* \w al|strong="H5921"\w* ofrecer sus \w holocaustos|strong="H5930"\w* \w y|strong="H5921"\w* sus \w sacrificios|strong="H2077"\w* \w de|strong="H5921"\w* comunión; esto \w les|strong="H5921"\w* \w servirá|strong="H1961"\w* \w de|strong="H5921"\w* recordatorio \w delante|strong="H6440"\w* \w de|strong="H5921"\w* su \w Dios|strong="H3068"\w*. Yo \w soy|strong="H1961"\w* Yahvé, su \w Dios|strong="H3068"\w*”.   
\p
\v 11 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w segundo|strong="H8145"\w* \w año|strong="H8141"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w veinte|strong="H6242"\w* días \w del|strong="H5921"\w* \w mes|strong="H2320"\w*, \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w se|strong="H1961"\w* levantó \w de|strong="H5921"\w* \w encima|strong="H5921"\w* \w del|strong="H5921"\w* \w tabernáculo|strong="H4908"\w* \w del|strong="H5921"\w* \w Testimonio|strong="H5715"\w*.  
\v 12 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w partieron|strong="H5265"\w* del \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* \w Sinaí|strong="H5514"\w*, y la \w nube|strong="H6051"\w* se detuvo en \w el|strong="H1121"\w* \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* \w Parán|strong="H6290"\w*.  
\v 13 \w Esta|strong="H5921"\w* \w fue|strong="H5265"\w* \w la|strong="H5921"\w* \w primera|strong="H7223"\w* vez \w que|strong="H5921"\w* avanzaron \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w mandato|strong="H6310"\w* \w que|strong="H5921"\w* Yahvé dio \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*.   
\p
\v 14 \w En|strong="H5921"\w* \w primer|strong="H7223"\w* lugar, avanzó \w la|strong="H5921"\w* bandera \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w según|strong="H5921"\w* sus divisiones. \w Naasón|strong="H5177"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Aminadab|strong="H5992"\w*, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* su división.  
\v 15 Netanel, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Zuar, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Isacar.  
\v 16 Eliab, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Helón, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Zabulón|strong="H2074"\w*.  
\v 17 Luego desarmaron \w el|strong="H1121"\w* \w tabernáculo|strong="H4908"\w*, y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1648"\w* y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w*, \w que|strong="H1121"\w* lo transportaban, se pusieron en marcha.  
\v 18 \w La|strong="H5921"\w* bandera \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w de|strong="H5921"\w* \w Rubén|strong="H7205"\w* avanzó \w según|strong="H5921"\w* sus divisiones. Elizur, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Sedeur, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* su división.  
\v 19 \w Selumiel|strong="H8017"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Zurisadai, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Simeón|strong="H8095"\w*.  
\v 20 Eliasaf, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Deuel, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Gad|strong="H1410"\w*.   
\p
\v 21 \w Después|strong="H5704"\w* avanzaron los coatitas \w llevando|strong="H5375"\w* las cosas sagradas. El \w tabernáculo|strong="H4908"\w* debía estar armado \w antes|strong="H5704"\w* \w de|strong="H5704"\w* \w que|strong="H5704"\w* ellos llegaran.   
\p
\v 22 \w La|strong="H5921"\w* bandera \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Efraín avanzó \w según|strong="H5921"\w* sus divisiones. Elisama, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amiud, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* su división.  
\v 23 \w Gamaliel|strong="H1583"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Pedasur, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Manasés|strong="H4519"\w*.  
\v 24 Abidán, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Gideoni, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*.   
\p
\v 25 \w La|strong="H5921"\w* bandera \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Dan|strong="H1835"\w*, \w que|strong="H5921"\w* servía \w de|strong="H5921"\w* retaguardia \w para|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w campamentos|strong="H4264"\w*, avanzó \w según|strong="H5921"\w* sus divisiones. Ahiezer, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amisadai, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* su división.  
\v 26 \w Pagiel|strong="H6295"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ocrán, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Aser.  
\v 27 \w Ahira|strong="H5321"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Enán, estaba \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w la|strong="H5921"\w* división \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H4294"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Neftalí.  
\v 28 Así \w era|strong="H1121"\w* \w el|strong="H1121"\w* orden \w de|strong="H1121"\w* marcha \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* según sus divisiones cuando avanzaban.   
\p
\v 29 \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Hobab, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Reuel|strong="H7467"\w* \w el|strong="H5921"\w* \w madianita|strong="H4084"\w*, \w suegro|strong="H2859"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*: “\w Nos|strong="H5921"\w* dirigimos \w al|strong="H5921"\w* \w lugar|strong="H4725"\w* \w del|strong="H5921"\w* \w que|strong="H3588"\w* Yahvé \w dijo|strong="H1696"\w*: ‘\w Se|strong="H5921"\w* \w lo|strong="H5921"\w* \w daré|strong="H5414"\w* \w a|strong="H3068"\w* ustedes’. \w Ven|strong="H3212"\w* \w con|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w y|strong="H3588"\w* \w te|strong="H5921"\w* trataremos \w bien|strong="H2896"\w*, \w porque|strong="H3588"\w* Yahvé ha prometido cosas \w buenas|strong="H2896"\w* \w para|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 30 \w Él|strong="H3588"\w* le respondió: “\w No|strong="H3808"\w* \w iré|strong="H3212"\w*, prefiero regresar \w a|strong="H3068"\w* mi tierra \w y|strong="H3588"\w* \w con|strong="H3588"\w* mi familia”.   
\p
\v 31 Moisés insistió: “\w No|strong="H3588"\w* \w nos|strong="H5921"\w* \w dejes|strong="H5800"\w*, \w por|strong="H5921"\w* favor; \w porque|strong="H3588"\w* tú \w conoces|strong="H3045"\w* \w los|strong="H5921"\w* lugares \w donde|strong="H5921"\w* debemos acampar \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w y|strong="H3588"\w* puedes ser nuestro guía.  
\v 32 \w Sucederá|strong="H1961"\w* \w que|strong="H3588"\w*, \w si|strong="H3588"\w* \w vienes|strong="H3212"\w* \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*, ten \w por|strong="H3588"\w* seguro, \w que|strong="H3588"\w* todo \w lo|strong="H1931"\w* \w bueno|strong="H2896"\w* \w que|strong="H3588"\w* Yahvé haga \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*, \w nosotros|strong="H5973"\w* \w lo|strong="H1931"\w* compartiremos \w contigo|strong="H5973"\w*”.   
\p
\v 33 \w Partieron|strong="H5265"\w* del \w monte|strong="H2022"\w* \w de|strong="H6440"\w* Yahvé \w e|strong="H3068"\w* hicieron un \w viaje|strong="H1870"\w* \w de|strong="H6440"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*. El arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Yahvé iba \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos durante los \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w de|strong="H6440"\w* \w viaje|strong="H1870"\w*, para buscarles un lugar donde descansar.  
\v 34 \w La|strong="H5921"\w* \w nube|strong="H6051"\w* \w de|strong="H4480"\w* Yahvé estaba \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* durante \w el|strong="H5921"\w* \w día|strong="H3119"\w*, cuando levantaban \w el|strong="H5921"\w* \w campamento|strong="H4264"\w*.  
\v 35 \w Cuando|strong="H1961"\w* el arca \w se|strong="H1961"\w* ponía en movimiento, \w Moisés|strong="H4872"\w* decía: “¡\w Levántate|strong="H6965"\w*, Yahvé, y \w que|strong="H1961"\w* \w se|strong="H1961"\w* dispersen tus \w enemigos|strong="H8130"\w*! \w Que|strong="H1961"\w* huyan \w de|strong="H6440"\w* tu \w presencia|strong="H6440"\w* \w los|strong="H1961"\w* \w que|strong="H1961"\w* te odian”.  
\v 36 \w Y|strong="H3068"\w* cuando el arca se detenía, decía: “Regresa, Yahvé, \w a|strong="H3068"\w* las incontables multitudes de \w Israel|strong="H3478"\w*”.   
\c 11  
\p
\v 1 \w El|strong="H4264"\w* \w pueblo|strong="H5971"\w* comenzó \w a|strong="H3068"\w* quejarse amargamente \w a|strong="H3068"\w* \w oídos|strong="H8085"\w* \w de|strong="H5971"\w* Yahvé. \w Cuando|strong="H1961"\w* Yahvé lo \w escuchó|strong="H8085"\w*, \w se|strong="H1961"\w* encendió su enojo; \w y|strong="H1197"\w* \w el|strong="H4264"\w* fuego \w de|strong="H5971"\w* Yahvé ardió entre ellos, \w y|strong="H1197"\w* consumió una parte \w de|strong="H5971"\w* las afueras del \w campamento|strong="H4264"\w*.  
\v 2 El \w pueblo|strong="H5971"\w* le suplicó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*; \w Moisés|strong="H4872"\w* \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé, y el fuego \w se|strong="H5971"\w* apagó.  
\v 3 \w A|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* \w llamó|strong="H7121"\w* Taberá, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* fuego \w de|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* ardido \w entre|strong="H3588"\w* \w ellos|strong="H1931"\w*.   
\p
\v 4 \w La|strong="H1571"\w* multitud \w de|strong="H1121"\w* \w extranjeros|strong="H1121"\w* \w que|strong="H4310"\w* iba \w con|strong="H1571"\w* \w ellos|strong="H1571"\w* sintió un antojo insaciable; \w y|strong="H1571"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w también|strong="H1571"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* llorar \w y|strong="H1571"\w* dijeron: “¡\w Quién|strong="H4310"\w* nos diera \w carne|strong="H1320"\w* para comer!  
\v 5 Recordamos el pescado que comíamos gratis en \w Egipto|strong="H4714"\w*; los pepinos, los melones, los puerros, las cebollas y los ajos;  
\v 6 pero \w ahora|strong="H6258"\w* \w ya|strong="H6258"\w* \w no|strong="H1115"\w* tenemos apetito. \w No|strong="H1115"\w* vemos \w nada|strong="H3605"\w* \w más|strong="H6258"\w* \w que|strong="H6258"\w* este \w maná|strong="H4478"\w*”.  
\v 7 \w El|strong="H1931"\w* \w maná|strong="H4478"\w* \w era|strong="H1931"\w* parecido \w a|strong="H3068"\w* \w la|strong="H1931"\w* semilla \w de|strong="H5869"\w* cilantro, y \w su|strong="H1931"\w* \w color|strong="H5869"\w* \w era|strong="H1931"\w* \w como|strong="H1931"\w* \w el|strong="H1931"\w* del bedelio. \f + \fr 11:7 \ft El bedelio es una resina que se extrae de ciertos árboles africanos.\f*  
\v 8 La \w gente|strong="H5971"\w* salía \w a|strong="H3068"\w* recogerlo, \w lo|strong="H6213"\w* molía en molinos \w de|strong="H5971"\w* mano \w o|strong="H3068"\w* \w lo|strong="H6213"\w* trituraba en morteros, \w lo|strong="H6213"\w* cocinaba en ollas y \w hacía|strong="H6213"\w* \w tortas|strong="H5692"\w* con \w él|strong="H6213"\w*. Sabía \w a|strong="H3068"\w* \w pan|strong="H5692"\w* amasado con \w aceite|strong="H8081"\w* fresco.  
\v 9 Cuando \w el|strong="H5921"\w* \w rocío|strong="H2919"\w* caía \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w campamento|strong="H4264"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w*, también caía \w el|strong="H5921"\w* \w maná|strong="H4478"\w*.   
\p
\v 10 \w Moisés|strong="H4872"\w* \w escuchó|strong="H8085"\w* al \w pueblo|strong="H5971"\w* \w llorando|strong="H1058"\w*, cada \w familia|strong="H4940"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H5971"\w* su tienda; y el enojo \w de|strong="H5971"\w* Yahvé \w se|strong="H5971"\w* encendió muchísimo, lo cual \w le|strong="H5869"\w* \w pareció|strong="H5869"\w* \w muy|strong="H3966"\w* \w mal|strong="H7489"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.  
\v 11 \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Yahvé: “¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* tratas tan \w mal|strong="H7489"\w* \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* he \w hallado|strong="H4672"\w* favor ante tus \w ojos|strong="H5869"\w*, \w para|strong="H5921"\w* \w que|strong="H4100"\w* hayas puesto \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* \w la|strong="H5921"\w* \w carga|strong="H4853"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*?  
\v 12 ¿Acaso \w yo|strong="H3588"\w* \w concebí|strong="H2029"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*? ¿Acaso \w yo|strong="H3588"\w* \w los|strong="H5921"\w* di \w a|strong="H3068"\w* luz, \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* pidas: ‘Llévalos \w en|strong="H5921"\w* tus brazos, \w como|strong="H3588"\w* una niñera \w lleva|strong="H5375"\w* \w a|strong="H3068"\w* un bebé, \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H3588"\w* prometiste \w a|strong="H3068"\w* sus antepasados’?  
\v 13 ¿\w De|strong="H5921"\w* \w dónde|strong="H5921"\w* voy \w a|strong="H3068"\w* sacar \w carne|strong="H1320"\w* \w para|strong="H5921"\w* \w darle|strong="H5414"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*? \w Porque|strong="H3588"\w* vienen \w a|strong="H3068"\w* llorarme, diciendo: ‘\w Danos|strong="H5414"\w* \w carne|strong="H1320"\w* \w para|strong="H5921"\w* comer’.  
\v 14 \w Yo|strong="H4480"\w* solo \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* soportar \w el|strong="H3588"\w* peso \w de|strong="H4480"\w* \w todo|strong="H3605"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*; \w es|strong="H2088"\w* una carga demasiado \w pesada|strong="H3515"\w* \w para|strong="H3588"\w* \w mí|strong="H5375"\w*.  
\v 15 \w Si|strong="H4994"\w* me vas \w a|strong="H3068"\w* tratar \w así|strong="H3602"\w*, \w te|strong="H5869"\w* \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* me mates \w ahora|strong="H4994"\w* mismo, \w si|strong="H4994"\w* he \w hallado|strong="H4672"\w* favor ante tus \w ojos|strong="H5869"\w*; y \w no|strong="H6213"\w* me dejes \w ver|strong="H7200"\w* \w mi|strong="H4994"\w* propia desgracia”.   
\p
\v 16 Yahvé \w le|strong="H5973"\w* respondió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Reúne \w a|strong="H3068"\w* \w setenta|strong="H7657"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w ancianos|strong="H2205"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, hombres \w que|strong="H3588"\w* \w sepas|strong="H3045"\w* \w que|strong="H3588"\w* \w son|strong="H3588"\w* líderes \w y|strong="H3588"\w* \w oficiales|strong="H7860"\w* \w del|strong="H5973"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H3588"\w* llévalos \w a|strong="H3068"\w* \w la|strong="H3588"\w* Tienda \w del|strong="H5973"\w* Encuentro \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* queden \w allí|strong="H8033"\w* \w contigo|strong="H5973"\w*.  
\v 17 \w Yo|strong="H4480"\w* bajaré \w y|strong="H5921"\w* \w hablaré|strong="H1696"\w* \w allí|strong="H8033"\w* \w contigo|strong="H5973"\w*. \w Tomaré|strong="H5375"\w* una parte \w del|strong="H4480"\w* \w Espíritu|strong="H7307"\w* \w que|strong="H4480"\w* \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ti|strong="H5973"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w pondré|strong="H7760"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*; \w así|strong="H1696"\w* compartirán \w contigo|strong="H5973"\w* \w la|strong="H5921"\w* \w carga|strong="H4853"\w* \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H5921"\w* \w no|strong="H3808"\w* tendrás \w que|strong="H4480"\w* llevarla tú solo.   
\p
\v 18 “\w Y|strong="H3068"\w* dile al \w pueblo|strong="H5971"\w*: ‘Santifíquense \w para|strong="H3588"\w* \w mañana|strong="H4279"\w*, \w y|strong="H3588"\w* comerán \w carne|strong="H1320"\w*; \w porque|strong="H3588"\w* han estado \w llorando|strong="H1058"\w* \w a|strong="H3068"\w* oídos \w de|strong="H3588"\w* Yahvé, diciendo: “¡\w Quién|strong="H4310"\w* nos \w diera|strong="H5414"\w* \w carne|strong="H1320"\w* \w para|strong="H3588"\w* comer! ¡Estábamos \w mucho|strong="H1058"\w* \w mejor|strong="H2895"\w* \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*!”. \w Por|strong="H3588"\w* lo tanto, Yahvé les \w dará|strong="H5414"\w* \w carne|strong="H1320"\w*, \w y|strong="H3588"\w* comerán.  
\v 19 \w No|strong="H3808"\w* la comerán solo un \w día|strong="H3117"\w*, \w ni|strong="H3808"\w* \w dos|strong="H3117"\w*, \w ni|strong="H3808"\w* \w cinco|strong="H2568"\w*, \w ni|strong="H3808"\w* \w diez|strong="H6235"\w*, \w ni|strong="H3808"\w* \w veinte|strong="H6242"\w* \w días|strong="H3117"\w*,  
\v 20 \w sino|strong="H3588"\w* un \w mes|strong="H2320"\w* entero, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* les \w salga|strong="H3318"\w* \w por|strong="H3588"\w* las narices \w y|strong="H3588"\w* les \w dé|strong="H3588"\w* asco; \w porque|strong="H3588"\w* han rechazado \w a|strong="H3068"\w* Yahvé, \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w en|strong="H5704"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ustedes, \w y|strong="H3588"\w* han llorado \w delante|strong="H6440"\w* \w de|strong="H3588"\w* \w él|strong="H3588"\w*, diciendo: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* tuvimos \w que|strong="H3588"\w* \w salir|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*?”’”.   
\p
\v 21 \w Moisés|strong="H4872"\w* respondió: “El \w pueblo|strong="H5971"\w* en el \w que|strong="H5971"\w* me encuentro tiene \w seiscientos|strong="H8337"\w* \w mil|strong="H3967"\w* hombres \w de|strong="H5971"\w* \w a|strong="H3068"\w* pie, ¡y tú dices: ‘Les \w daré|strong="H5414"\w* \w carne|strong="H1320"\w* \w para|strong="H5414"\w* \w que|strong="H5971"\w* coman durante un \w mes|strong="H2320"\w* entero’!  
\v 22 ¿Acaso se \w matarán|strong="H7819"\w* suficientes \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w* para alimentarlos \w a|strong="H3068"\w* \w todos|strong="H3605"\w*? ¿\w O|strong="H3068"\w* se pescarán \w todos|strong="H3605"\w* \w los|strong="H3605"\w* peces del \w mar|strong="H3220"\w* para \w que|strong="H3605"\w* les alcance?”.   
\p
\v 23 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¿Acaso el \w poder|strong="H3027"\w* \w de|strong="H1697"\w* Yahvé tiene límites? \w Ahora|strong="H6258"\w* \w verás|strong="H7200"\w* \w si|strong="H3808"\w* mi \w palabra|strong="H1697"\w* \w se|strong="H3808"\w* cumple \w o|strong="H3068"\w* \w no|strong="H3808"\w*”.   
\p
\v 24 \w Moisés|strong="H4872"\w* \w salió|strong="H3318"\w* y le comunicó al \w pueblo|strong="H5971"\w* las \w palabras|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé. \w Luego|strong="H3318"\w* reunió \w a|strong="H3068"\w* \w setenta|strong="H7657"\w* hombres \w de|strong="H5971"\w* los \w ancianos|strong="H2205"\w* del \w pueblo|strong="H5971"\w* y los colocó \w alrededor|strong="H5439"\w* \w de|strong="H5971"\w* la Tienda.  
\v 25 Yahvé bajó \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w y|strong="H5921"\w* \w habló|strong="H1696"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w*; tomó una parte \w del|strong="H4480"\w* \w Espíritu|strong="H7307"\w* \w que|strong="H4480"\w* \w estaba|strong="H1961"\w* \w sobre|strong="H5921"\w* Moisés \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w puso|strong="H5414"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w setenta|strong="H7657"\w* \w ancianos|strong="H2205"\w*. \w Cuando|strong="H1961"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w reposó|strong="H5117"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*, comenzaron \w a|strong="H3068"\w* profetizar, pero esto \w no|strong="H3808"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* suceder.  
\v 26 \w Sin|strong="H3808"\w* embargo, \w dos|strong="H8147"\w* \w hombres|strong="H8147"\w* \w se|strong="H5921"\w* habían quedado \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campamento|strong="H4264"\w*. Uno \w se|strong="H5921"\w* \w llamaba|strong="H8034"\w* Eldad \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w otro|strong="H8145"\w* \w Medad|strong="H4312"\w*. \w El|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w también|strong="H3318"\w* \w reposó|strong="H5117"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w*, pues estaban \w en|strong="H5921"\w* \w la|strong="H5921"\w* lista \w de|strong="H5921"\w* \w los|strong="H1992"\w* elegidos, \w aunque|strong="H3808"\w* \w no|strong="H3808"\w* habían ido \w a|strong="H3068"\w* \w la|strong="H5921"\w* Tienda; \w y|strong="H5921"\w* comenzaron \w a|strong="H3068"\w* profetizar \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campamento|strong="H4264"\w*.  
\v 27 Un joven \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* avisarle \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¡Eldad y \w Medad|strong="H4312"\w* están \w profetizando|strong="H5012"\w* en \w el|strong="H4264"\w* \w campamento|strong="H4264"\w*!”.   
\p
\v 28 \w Josué|strong="H3091"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w*, \w que|strong="H1121"\w* \w era|strong="H1121"\w* ayudante \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w* desde su juventud, intervino diciendo: “¡\w Moisés|strong="H4872"\w*, \w mi|strong="H6030"\w* señor, detenlos!”.   
\p
\v 29 \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* respondió: “¿Estás celoso \w por|strong="H5921"\w* \w mí|strong="H5921"\w*? ¡\w Ojalá|strong="H4310"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* Yahvé fuera \w profeta|strong="H5030"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w pusiera|strong="H5414"\w* \w su|strong="H3588"\w* \w Espíritu|strong="H7307"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w ellos|strong="H5921"\w*!”.   
\p
\v 30 Después, \w Moisés|strong="H4872"\w* y \w los|strong="H1931"\w* \w ancianos|strong="H2205"\w* de \w Israel|strong="H3478"\w* regresaron al \w campamento|strong="H4264"\w*.  
\v 31 \w Entonces|strong="H3117"\w* \w se|strong="H5921"\w* levantó un \w viento|strong="H7307"\w* enviado \w por|strong="H5921"\w* Yahvé \w que|strong="H4480"\w* trajo \w codornices|strong="H7958"\w* \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w dejó|strong="H5203"\w* caer \w alrededor|strong="H5439"\w* \w del|strong="H4480"\w* \w campamento|strong="H4264"\w*. Había \w codornices|strong="H7958"\w* esparcidas \w a|strong="H3068"\w* un \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w camino|strong="H1870"\w* \w en|strong="H5921"\w* \w todas|strong="H5439"\w* direcciones, amontonadas \w a|strong="H3068"\w* casi \w dos|strong="H3117"\w* codos\f + \fr 11:31 \ft Un codo es la longitud desde la punta del dedo medio hasta el codo del brazo de un hombre, es decir, unos 46 centímetros.\f* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 32 \w El|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1931"\w* pasó \w todo|strong="H3605"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w noche|strong="H3915"\w* y \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w* recogiendo \w codornices|strong="H7958"\w*. \w Nadie|strong="H3605"\w* recogió menos \w de|strong="H5971"\w* \w diez|strong="H6235"\w* ómeres;\f + \fr 11:32 \ft 1 ómer equivale a unos 220 litros o 6 bushels.\f* y las pusieron \w a|strong="H3068"\w* secar al sol \w alrededor|strong="H5439"\w* del \w campamento|strong="H4264"\w*.  
\v 33 Pero \w mientras|strong="H5750"\w* la \w carne|strong="H1320"\w* \w todavía|strong="H5750"\w* estaba entre sus \w dientes|strong="H8127"\w*, \w antes|strong="H2962"\w* \w de|strong="H5750"\w* \w que|strong="H5971"\w* pudieran tragarla, el enojo \w de|strong="H5750"\w* Yahvé \w se|strong="H5971"\w* encendió contra el \w pueblo|strong="H5971"\w*, y los \w hirió|strong="H5221"\w* con una \w plaga|strong="H4347"\w* terrible.  
\v 34 \w Por|strong="H3588"\w* \w eso|strong="H1931"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* Kibrot-hataava,\f + \fr 11:34 \ft Kibrot-hataava significa “tumbas de los antojos”.\f* \w porque|strong="H3588"\w* \w allí|strong="H8033"\w* enterraron \w a|strong="H3068"\w* las personas \w que|strong="H3588"\w* \w se|strong="H1931"\w* dejaron llevar \w por|strong="H3588"\w* \w la|strong="H1931"\w* gula.   
\p
\v 35 Desde Kibrot-hataava el \w pueblo|strong="H5971"\w* avanzó hacia Jaserot; y allí \w se|strong="H1961"\w* \w quedaron|strong="H1961"\w*.   
\c 12  
\p
\v 1 Miriam \w y|strong="H3588"\w* Aarón comenzaron \w a|strong="H3068"\w* murmurar \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w por|strong="H5921"\w* causa \w de|strong="H5921"\w* \w su|strong="H3588"\w* esposa cusita, ya \w que|strong="H3588"\w* \w él|strong="H5921"\w* \w se|strong="H5921"\w* \w había|strong="H3588"\w* casado \w con|strong="H5921"\w* una mujer \w de|strong="H5921"\w* Cus.  
\v 2 Decían: “¿Acaso Yahvé \w ha|strong="H3808"\w* \w hablado|strong="H1696"\w* únicamente por medio de \w Moisés|strong="H4872"\w*? ¿\w No|strong="H3808"\w* \w ha|strong="H3808"\w* \w hablado|strong="H1696"\w* \w también|strong="H1571"\w* por medio de nosotros?”. \w Y|strong="H3068"\w* Yahvé \w lo|strong="H3808"\w* \w escuchó|strong="H8085"\w*.   
\p
\v 3 (\w A|strong="H3068"\w* decir verdad, \w Moisés|strong="H4872"\w* era un hombre \w muy|strong="H3966"\w* humilde, \w más|strong="H5921"\w* \w que|strong="H5921"\w* \w cualquier|strong="H3605"\w* otra \w persona|strong="H6440"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra).  
\v 4 De repente, Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* Miriam: “¡Vengan ustedes \w tres|strong="H7969"\w* \w a|strong="H3068"\w* la Tienda del Encuentro!”.  
\p \w Y|strong="H3068"\w* los \w tres|strong="H7969"\w* fueron.  
\v 5 Yahvé bajó \w en|strong="H3318"\w* una \w columna|strong="H5982"\w* de \w nube|strong="H6051"\w*, se paró \w a|strong="H3068"\w* la entrada de la Tienda y \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* Miriam. Cuando \w ambos|strong="H8147"\w* se acercaron,  
\v 6 \w él|strong="H5030"\w* les \w dijo|strong="H1696"\w*: “\w Escuchen|strong="H8085"\w* bien mis \w palabras|strong="H1697"\w*. \w Si|strong="H4994"\w* \w hay|strong="H1961"\w* un \w profeta|strong="H5030"\w* entre ustedes, \w yo|strong="H4994"\w*, Yahvé, me revelaré \w a|strong="H3068"\w* \w él|strong="H5030"\w* en \w visiones|strong="H4759"\w* y le \w hablaré|strong="H1696"\w* en \w sueños|strong="H2472"\w*.  
\v 7 Pero \w no|strong="H3808"\w* hago \w lo|strong="H1931"\w* \w mismo|strong="H1931"\w* con mi \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* he confiado \w toda|strong="H3605"\w* mi \w casa|strong="H1004"\w*.  
\v 8 Con él \w hablo|strong="H1696"\w* cara \w a|strong="H3068"\w* cara, claramente y \w no|strong="H3808"\w* con acertijos, y él puede contemplar la forma \w de|strong="H3372"\w* Yahvé. ¿\w Cómo|strong="H4069"\w* es \w que|strong="H3808"\w* \w no|strong="H3808"\w* tuvieron \w miedo|strong="H3372"\w* \w de|strong="H3372"\w* \w hablar|strong="H1696"\w* en contra \w de|strong="H3372"\w* mi \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*?”.  
\v 9 El enojo de Yahvé se encendió contra ellos, y él se marchó.   
\p
\v 10 Cuando \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w se|strong="H5921"\w* alejó \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda, resultó \w que|strong="H5921"\w* Miriam tenía lepra, \w y|strong="H5921"\w* su piel \w estaba|strong="H2009"\w* blanca \w como|strong="H5921"\w* \w la|strong="H5921"\w* nieve. \w Al|strong="H5921"\w* volverse Aarón \w hacia|strong="H5921"\w* Miriam, \w vio|strong="H2009"\w* \w que|strong="H5921"\w* \w estaba|strong="H2009"\w* leprosa.   
\p
\v 11 Entonces Aarón \w le|strong="H5921"\w* suplicó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¡Ay, señor \w mío|strong="H5921"\w*! \w Por|strong="H5921"\w* favor, \w no|strong="H5921"\w* \w nos|strong="H5921"\w* hagas pagar \w por|strong="H5921"\w* este \w pecado|strong="H2403"\w* \w que|strong="H4994"\w* hemos cometido tan tontamente.  
\v 12 Te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* ella \w no|strong="H1961"\w* \w quede|strong="H1961"\w* \w como|strong="H1961"\w* un bebé \w que|strong="H4994"\w* \w nace|strong="H3318"\w* \w muerto|strong="H4191"\w*, \w que|strong="H4994"\w* \w sale|strong="H3318"\w* \w del|strong="H2677"\w* vientre de su madre con la \w carne|strong="H1320"\w* \w medio|strong="H2677"\w* consumida”.   
\p
\v 13 \w Moisés|strong="H4872"\w* \w clamó|strong="H6817"\w* \w a|strong="H3068"\w* Yahvé, diciendo: “¡Oh \w Dios|strong="H3068"\w*, te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* la sanes!”.   
\p
\v 14 Yahvé le respondió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Si|strong="H3808"\w* su padre le hubiera escupido en la \w cara|strong="H6440"\w*, ¿\w no|strong="H3808"\w* estaría avergonzada durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*? \w Que|strong="H3808"\w* sea expulsada del \w campamento|strong="H4264"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, y después \w de|strong="H6440"\w* eso \w podrá|strong="H3808"\w* regresar”.   
\p
\v 15 Así \w que|strong="H3808"\w* Miriam \w fue|strong="H3808"\w* apartada del \w campamento|strong="H4264"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, \w y|strong="H5704"\w* \w el|strong="H4264"\w* \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* levantó \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* ella regresó.  
\v 16 Después \w de|strong="H5971"\w* esto, el \w pueblo|strong="H5971"\w* \w partió|strong="H5265"\w* \w de|strong="H5971"\w* Jaserot y acampó en el \w desierto|strong="H4057"\w* \w de|strong="H5971"\w* \w Parán|strong="H6290"\w*.   
\c 13  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Envía|strong="H7971"\w* \w hombres|strong="H1121"\w* \w para|strong="H5414"\w* \w que|strong="H1121"\w* espíen \w la|strong="H3605"\w* tierra \w de|strong="H1121"\w* \w Canaán|strong="H3667"\w*, \w que|strong="H1121"\w* yo les \w doy|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. \w De|strong="H1121"\w* \w cada|strong="H3605"\w* \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* sus padres, \w enviarán|strong="H7971"\w* un \w hombre|strong="H1121"\w*, \w cada|strong="H3605"\w* uno \w de|strong="H1121"\w* \w ellos|strong="H3605"\w* un líder entre \w ellos|strong="H3605"\w*”.   
\p
\v 3 \w Moisés|strong="H4872"\w* \w los|strong="H1992"\w* \w envió|strong="H7971"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* \w Parán|strong="H6290"\w*, \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé. \w Todos|strong="H3605"\w* \w ellos|strong="H1992"\w* eran \w hombres|strong="H1121"\w* \w que|strong="H5921"\w* eran \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 4 Estos eran sus \w nombres|strong="H8034"\w*:  
\m \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*, \w Samua|strong="H8051"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zacur.   
\m
\v 5 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Simeón|strong="H8095"\w*, Safat \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hori|strong="H2753"\w*.   
\m
\v 6 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w Caleb|strong="H3612"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jefone.   
\m
\v 7 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Isacar, \w Igal|strong="H3008"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*.   
\m
\v 8 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Efraín, \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w*.   
\m
\v 9 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w*, \w Palti|strong="H6406"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Rafu.   
\m
\v 10 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Zabulón|strong="H2074"\w*, Gadiel \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sodi.   
\m
\v 11 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*, Gadi \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Susi.   
\m
\v 12 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Dan|strong="H1835"\w*, \w Ammiel|strong="H5988"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Gemali.   
\m
\v 13 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Aser, Setur, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Micael.   
\m
\v 14 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Neftalí, Nahbi \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Vapsi.   
\m
\v 15 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Gad|strong="H1410"\w*, \w Geuel|strong="H1345"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maqui.   
\m
\v 16 Estos son \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w que|strong="H1121"\w* \w Moisés|strong="H4872"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* espiar la tierra. \w Moisés|strong="H4872"\w* \w llamó|strong="H7121"\w* \w Josué|strong="H3091"\w* \w a|strong="H3068"\w* \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w*.  
\v 17 \w Moisés|strong="H4872"\w* los \w envió|strong="H7971"\w* \w a|strong="H3068"\w* espiar la tierra de \w Canaán|strong="H3667"\w*, y les dijo: “Suban \w por|strong="H2088"\w* \w este|strong="H2088"\w* camino del sur y suban \w a|strong="H3068"\w* la región montañosa.  
\v 18 \w Vean|strong="H7200"\w* \w la|strong="H1931"\w* tierra, \w cómo|strong="H4100"\w* \w es|strong="H1931"\w*; \w y|strong="H5921"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w que|strong="H4100"\w* \w la|strong="H1931"\w* \w habita|strong="H3427"\w*, \w si|strong="H1931"\w* \w es|strong="H1931"\w* \w fuerte|strong="H2389"\w* \w o|strong="H3068"\w* débil, \w si|strong="H1931"\w* \w es|strong="H1931"\w* \w poco|strong="H4592"\w* \w o|strong="H3068"\w* \w mucho|strong="H7227"\w*;  
