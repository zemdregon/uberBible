\p
\v 44 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w diciendo|strong="H1696"\w*:  
\v 45 “\w Toma|strong="H3947"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w primogénitos|strong="H1060"\w* \w de|strong="H8478"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*, y \w el|strong="H3605"\w* \w ganado|strong="H1121"\w* \w de|strong="H8478"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su \w ganado|strong="H1121"\w*; y \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w serán|strong="H1961"\w* míos. Yo \w soy|strong="H1961"\w* Yahvé.  
\v 46 \w Y|strong="H3068"\w* \w para|strong="H5921"\w* rescatar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w doscientos|strong="H3967"\w* \w setenta|strong="H7657"\w* \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w primogénitos|strong="H1060"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H5921"\w* sobrepasan \w el|strong="H5921"\w* número \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*,  
\v 47 cobrarás \w cinco|strong="H2568"\w* \w siclos|strong="H8255"\w* por cada uno; los cobrarás según el peso oficial del \w santuario|strong="H6944"\w* (un \w siclo|strong="H8255"\w* equivale \w a|strong="H3068"\w* \w veinte|strong="H6242"\w* \w geras|strong="H1626"\w*);  
\v 48 y le \w darás|strong="H5414"\w* \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w el|strong="H1121"\w* \w dinero|strong="H3701"\w* con \w el|strong="H1121"\w* \w que|strong="H1121"\w* se rescata \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* sobran”.   
\p
\v 49 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w el|strong="H5921"\w* \w dinero|strong="H3701"\w* \w del|strong="H5921"\w* rescate \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* excedían \w el|strong="H5921"\w* número \w de|strong="H5921"\w* \w los|strong="H5921"\w* rescatados \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*;  
\v 50 cobró \w el|strong="H1121"\w* \w dinero|strong="H3701"\w* \w de|strong="H2568"\w* \w los|strong="H1121"\w* \w primogénitos|strong="H1060"\w* \w de|strong="H2568"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*: \w mil|strong="H3967"\w* \w trescientos|strong="H7969"\w* \w sesenta|strong="H8346"\w* y \w cinco|strong="H2568"\w* \w siclos|strong="H8255"\w*, según \w el|strong="H1121"\w* peso del \w santuario|strong="H6944"\w*;  
\v 51 \w y|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* \w el|strong="H5921"\w* \w dinero|strong="H3701"\w* \w del|strong="H5921"\w* rescate \w a|strong="H3068"\w* Aarón \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, \w según|strong="H5921"\w* \w la|strong="H5921"\w* \w palabra|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé, tal \w como|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.   
\c 4  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, \w diciendo|strong="H1696"\w*:  
\v 2 “Hagan un censo \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat \w de|strong="H1121"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3881"\w*, \w por|strong="H3881"\w* sus \w familias|strong="H4940"\w* y \w por|strong="H3881"\w* las \w casas|strong="H1004"\w* \w de|strong="H1121"\w* sus padres,  
\v 3 \w desde|strong="H5704"\w* \w los|strong="H1121"\w* \w treinta|strong="H7970"\w* \w hasta|strong="H5704"\w* \w los|strong="H1121"\w* \w cincuenta|strong="H2572"\w* \w años|strong="H8141"\w*, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5704"\w* puedan entrar \w al|strong="H5704"\w* servicio \w para|strong="H5704"\w* \w trabajar|strong="H6213"\w* \w en|strong="H5704"\w* \w la|strong="H3605"\w* Tienda del Encuentro.   
\p
\v 4 “\w Este|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H1121"\w* servicio \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat en \w la|strong="H2063"\w* Tienda del Encuentro, en cuanto \w a|strong="H3068"\w* las cosas santísimas.  
\v 5 Cuando \w el|strong="H1121"\w* \w campamento|strong="H4264"\w* deba avanzar, Aarón entrará con sus \w hijos|strong="H1121"\w*; bajarán \w el|strong="H1121"\w* velo \w de|strong="H1121"\w* la cortina, \w cubrirán|strong="H3680"\w* con \w él|strong="H1121"\w* \w el|strong="H1121"\w* Arca del \w Testimonio|strong="H5715"\w*,  
\v 6 \w le|strong="H5921"\w* \w pondrán|strong="H7760"\w* una cubierta \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón, \w extenderán|strong="H6566"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w* una tela \w totalmente|strong="H3632"\w* azul \w y|strong="H5921"\w* colocarán sus varas.   
\p
\v 7 “\w Sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w del|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w Presencia|strong="H6440"\w* \w extenderán|strong="H6566"\w* una tela azul, \w y|strong="H5921"\w* \w pondrán|strong="H5414"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w* \w los|strong="H5921"\w* \w platos|strong="H7086"\w*, \w las|strong="H5921"\w* \w cucharas|strong="H3709"\w*, \w los|strong="H5921"\w* tazones \w y|strong="H5921"\w* \w las|strong="H5921"\w* jarras \w para|strong="H5921"\w* \w las|strong="H5921"\w* ofrendas líquidas; \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w continuo|strong="H8548"\w* \w estará|strong="H1961"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 8 \w Extenderán|strong="H6566"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* una tela carmesí, \w la|strong="H5921"\w* \w cubrirán|strong="H3680"\w* \w con|strong="H5921"\w* una cubierta \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón, \w y|strong="H5921"\w* colocarán sus varas.   
\p
\v 9 “\w Tomarán|strong="H3947"\w* una tela azul y \w cubrirán|strong="H3680"\w* \w el|strong="H3605"\w* candelabro de \w la|strong="H3605"\w* iluminación, sus \w lámparas|strong="H5216"\w*, sus tenazas, sus platillos y \w todos|strong="H3605"\w* sus recipientes de \w aceite|strong="H8081"\w*, con \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w lo|strong="H3605"\w* atienden.  
\v 10 \w Lo|strong="H5921"\w* \w pondrán|strong="H5414"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w todos|strong="H3605"\w* sus utensilios, \w dentro|strong="H5921"\w* \w de|strong="H5921"\w* una cubierta \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* colocarán \w sobre|strong="H5921"\w* unas parihuelas.   
\p
\v 11 “\w Sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w extenderán|strong="H6566"\w* una tela azul, \w lo|strong="H5921"\w* \w cubrirán|strong="H3680"\w* \w con|strong="H5921"\w* una cubierta \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón, \w y|strong="H5921"\w* \w le|strong="H5921"\w* colocarán sus varas.   
\p
\v 12 “\w Tomarán|strong="H3947"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* utensilios \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* sirven \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w santuario|strong="H6944"\w*, \w los|strong="H5921"\w* \w pondrán|strong="H5414"\w* \w en|strong="H5921"\w* una tela azul, \w los|strong="H5921"\w* \w cubrirán|strong="H3680"\w* \w con|strong="H5921"\w* una funda \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón \w y|strong="H5921"\w* \w los|strong="H5921"\w* colocarán \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* parihuelas.   
\p
\v 13 “Limpiarán \w la|strong="H5921"\w* ceniza \w del|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* \w extenderán|strong="H6566"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* una tela púrpura.  
\v 14 \w Pondrán|strong="H7760"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* utensilios \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* sirven \w en|strong="H5921"\w* \w él|strong="H5921"\w*: \w los|strong="H5921"\w* braseros, \w los|strong="H5921"\w* tenedores, \w las|strong="H5921"\w* palas \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w tazones|strong="H4219"\w*, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* utensilios \w del|strong="H5921"\w* \w altar|strong="H4196"\w*; \w extenderán|strong="H6566"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* una cubierta \w de|strong="H5921"\w* \w piel|strong="H5785"\w* \w de|strong="H5921"\w* tejón, \w y|strong="H5921"\w* \w le|strong="H5921"\w* colocarán sus varas.   
\p
\v 15 “Cuando Aarón y sus \w hijos|strong="H1121"\w* hayan terminado \w de|strong="H1121"\w* \w cubrir|strong="H3680"\w* \w el|strong="H3605"\w* \w santuario|strong="H6944"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* muebles del \w santuario|strong="H6944"\w*, cuando \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* esté \w por|strong="H3651"\w* avanzar, \w entonces|strong="H3651"\w* vendrán \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat para cargarlos; pero \w no|strong="H3808"\w* \w tocarán|strong="H5060"\w* las cosas \w santas|strong="H6944"\w*, para \w no|strong="H3808"\w* \w morir|strong="H4191"\w*. Estas \w son|strong="H3808"\w* las cargas \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat en \w la|strong="H3605"\w* Tienda del Encuentro.   
\p
\v 16 “Eleazar, \w hijo|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Aarón, \w estará|strong="H3605"\w* \w a|strong="H3068"\w* cargo del \w aceite|strong="H8081"\w* para \w la|strong="H3605"\w* lámpara, del incienso \w aromático|strong="H5561"\w*, \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w continua|strong="H8548"\w* y del \w aceite|strong="H8081"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w unción|strong="H4888"\w*, teniendo \w la|strong="H3605"\w* responsabilidad \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w tabernáculo|strong="H4908"\w* y \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1121"\w* hay en \w él|strong="H3605"\w*, del \w santuario|strong="H6944"\w* y \w de|strong="H1121"\w* sus utensilios”.   
\p
\v 17 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, \w diciendo|strong="H1696"\w*:  
\v 18 “No permitan que la \w tribu|strong="H7626"\w* de las \w familias|strong="H4940"\w* de los coatitas desaparezca de \w entre|strong="H8432"\w* los \w levitas|strong="H3881"\w*;  
\v 19 \w más|strong="H5921"\w* bien, \w hagan|strong="H6213"\w* \w esto|strong="H2063"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w para|strong="H5921"\w* \w que|strong="H3808"\w* vivan \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w* cuando \w se|strong="H5921"\w* acerquen \w a|strong="H3068"\w* \w las|strong="H5921"\w* cosas santísimas: Aarón \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* entrarán \w y|strong="H5921"\w* \w le|strong="H5921"\w* asignarán \w a|strong="H3068"\w* cada uno su \w tarea|strong="H5656"\w* \w y|strong="H5921"\w* su \w carga|strong="H4853"\w*;  
\v 20 pero ellos \w no|strong="H3808"\w* entrarán \w a|strong="H3068"\w* \w ver|strong="H7200"\w* las cosas \w santas|strong="H6944"\w* \w ni|strong="H3808"\w* por un instante, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w*”.   
\p
\v 21 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 22 “Haz un censo \w también|strong="H1571"\w* \w de|strong="H1121"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1648"\w*, por \w las|strong="H1992"\w* \w casas|strong="H1004"\w* \w de|strong="H1121"\w* \w sus|strong="H1992"\w* padres \w y|strong="H1571"\w* por \w sus|strong="H1992"\w* \w familias|strong="H4940"\w*;  
\v 23 \w los|strong="H1121"\w* \w contarás|strong="H6485"\w* \w desde|strong="H5704"\w* \w los|strong="H1121"\w* \w treinta|strong="H7970"\w* \w hasta|strong="H5704"\w* \w los|strong="H1121"\w* \w cincuenta|strong="H2572"\w* \w años|strong="H8141"\w*, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5704"\w* entran \w a|strong="H3068"\w* \w servir|strong="H5647"\w*, \w para|strong="H5704"\w* hacer \w el|strong="H3605"\w* trabajo \w en|strong="H5704"\w* \w la|strong="H3605"\w* Tienda del Encuentro.   
\p
\v 24 “\w Este|strong="H2063"\w* \w es|strong="H2063"\w* el servicio de las \w familias|strong="H4940"\w* de los gersonitas, para \w servir|strong="H5647"\w* y para cargar:  
\v 25 \w llevarán|strong="H5375"\w* \w las|strong="H5921"\w* \w cortinas|strong="H3407"\w* \w del|strong="H5921"\w* \w tabernáculo|strong="H4908"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, su cubierta, \w la|strong="H5921"\w* cubierta \w de|strong="H5921"\w* piel \w de|strong="H5921"\w* tejón \w que|strong="H5921"\w* \w va|strong="H3068"\w* \w por|strong="H5921"\w* \w encima|strong="H4605"\w*, \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro,  
\v 26 \w las|strong="H5921"\w* \w cortinas|strong="H7050"\w* \w del|strong="H5921"\w* \w atrio|strong="H2691"\w*, \w la|strong="H5921"\w* cortina \w de|strong="H5921"\w* \w la|strong="H5921"\w* entrada \w del|strong="H5921"\w* \w atrio|strong="H2691"\w* \w que|strong="H5921"\w* rodea \w el|strong="H5921"\w* \w tabernáculo|strong="H4908"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, sus cuerdas \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* accesorios \w de|strong="H5921"\w* su servicio, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w haga|strong="H6213"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*. Así \w servirán|strong="H5647"\w*.  
\v 27 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* servicio \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* gersonitas, \w tanto|strong="H5921"\w* \w en|strong="H5921"\w* sus cargas \w como|strong="H1961"\w* \w en|strong="H5921"\w* sus tareas, \w estará|strong="H1961"\w* bajo \w las|strong="H5921"\w* órdenes \w de|strong="H5921"\w* Aarón \w y|strong="H5921"\w* \w de|strong="H5921"\w* sus \w hijos|strong="H1121"\w*; \w y|strong="H5921"\w* ustedes \w les|strong="H5921"\w* asignarán \w la|strong="H5921"\w* responsabilidad \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* deben cargar.  
\v 28 \w Este|strong="H2063"\w* \w es|strong="H3027"\w* \w el|strong="H1121"\w* servicio \w de|strong="H1121"\w* las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1649"\w* en \w la|strong="H2063"\w* Tienda del Encuentro. Su trabajo estará bajo \w la|strong="H2063"\w* dirección \w de|strong="H1121"\w* Itamar, \w hijo|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Aarón.   
\p
