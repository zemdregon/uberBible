\c 5  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Manda|strong="H6680"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w que|strong="H4480"\w* saquen \w del|strong="H4480"\w* \w campamento|strong="H4264"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w leproso|strong="H6879"\w*, \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w que|strong="H4480"\w* tenga un flujo y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w que|strong="H4480"\w* esté impuro \w por|strong="H4480"\w* tocar un cadáver.  
\v 3 Sacarán del \w campamento|strong="H4264"\w* tanto \w a|strong="H3068"\w* los hombres \w como|strong="H5704"\w* \w a|strong="H3068"\w* las \w mujeres|strong="H5704"\w*, \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* contaminen su \w campamento|strong="H4264"\w*, \w en|strong="H5704"\w* \w medio|strong="H8432"\w* del cual yo \w habito|strong="H7931"\w*”.   
\p
\v 4 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w así|strong="H3651"\w*, y \w los|strong="H1121"\w* sacaron del \w campamento|strong="H4264"\w*; \w tal|strong="H3651"\w* \w como|strong="H3651"\w* Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w así|strong="H3651"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.   
\p
\v 5 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 6 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: ‘\w Cuando|strong="H3588"\w* un \w hombre|strong="H1121"\w* \w o|strong="H3068"\w* una mujer cometa \w cualquier|strong="H3605"\w* \w pecado|strong="H2403"\w* \w que|strong="H3588"\w* cometen \w los|strong="H1121"\w* \w hombres|strong="H1121"\w*, ofendiendo \w así|strong="H3588"\w* \w a|strong="H3068"\w* Yahvé, \w y|strong="H3588"\w* \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* resulte culpable,  
\v 7 \w entonces|strong="H7725"\w* \w confesará|strong="H3034"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w que|strong="H5921"\w* ha cometido; \w y|strong="H5921"\w* \w pagará|strong="H5414"\w* \w la|strong="H5921"\w* restitución \w por|strong="H5921"\w* su culpa \w en|strong="H5921"\w* su totalidad, \w añadiendo|strong="H3254"\w* \w además|strong="H5921"\w* \w la|strong="H5921"\w* quinta parte, \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* \w dará|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona \w contra|strong="H5921"\w* \w la|strong="H5921"\w* cual pecó.  
\v 8 Pero \w si|strong="H5921"\w* \w la|strong="H5921"\w* persona \w no|strong="H5921"\w* tiene un \w pariente|strong="H1350"\w* cercano \w a|strong="H3068"\w* quien hacerle \w la|strong="H5921"\w* restitución, \w la|strong="H5921"\w* restitución \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* haga \w a|strong="H3068"\w* Yahvé será \w del|strong="H5921"\w* \w sacerdote|strong="H3548"\w*, \w además|strong="H5921"\w* \w del|strong="H5921"\w* carnero \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w expiación|strong="H3722"\w*, \w con|strong="H5921"\w* \w el|strong="H5921"\w* cual \w se|strong="H5921"\w* hará \w la|strong="H5921"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* culpable.  
\v 9 \w Toda|strong="H3605"\w* \w ofrenda|strong="H8641"\w* \w de|strong="H1121"\w* las cosas \w sagradas|strong="H6944"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1121"\w* le presenten al \w sacerdote|strong="H3548"\w*, \w será|strong="H1961"\w* suya.  
\v 10 Las cosas \w sagradas|strong="H6944"\w* \w de|strong="H5414"\w* cada persona \w serán|strong="H1961"\w* del \w sacerdote|strong="H3548"\w*; todo lo \w que|strong="H1961"\w* alguien le \w entregue|strong="H5414"\w* al \w sacerdote|strong="H3548"\w* \w será|strong="H1961"\w* suyo’”.   
\p
\v 11 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 12 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Si|strong="H3588"\w* \w la|strong="H3588"\w* mujer \w de|strong="H3588"\w* un \w hombre|strong="H1121"\w* se desvía \w y|strong="H3588"\w* le \w es|strong="H3588"\w* infiel,  
\v 13 y un hombre \w tiene|strong="H1931"\w* relaciones sexuales con \w ella|strong="H1931"\w*, y \w esto|strong="H1931"\w* \w se|strong="H1931"\w* oculta \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* \w su|strong="H1931"\w* esposo y \w se|strong="H1931"\w* mantiene en secreto, y \w ella|strong="H1931"\w* \w se|strong="H1931"\w* contamina, \w sin|strong="H3808"\w* \w que|strong="H1931"\w* haya \w testigos|strong="H5707"\w* contra \w ella|strong="H1931"\w* \w ni|strong="H3808"\w* sea sorprendida en \w el|strong="H1931"\w* acto;  
\v 14 \w y|strong="H5921"\w* \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w celos|strong="H7065"\w* \w se|strong="H1931"\w* apodera \w del|strong="H5921"\w* esposo, \w y|strong="H5921"\w* siente \w celos|strong="H7065"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* mujer, estando \w ella|strong="H1931"\w* \w contaminada|strong="H2930"\w*; \w o|strong="H3068"\w* \w si|strong="H3808"\w* \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w celos|strong="H7065"\w* \w se|strong="H1931"\w* apodera \w de|strong="H5921"\w* \w él|strong="H1931"\w*, \w y|strong="H5921"\w* siente \w celos|strong="H7065"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* mujer, \w aunque|strong="H3808"\w* \w ella|strong="H1931"\w* \w no|strong="H3808"\w* \w esté|strong="H1931"\w* \w contaminada|strong="H2930"\w*;  
\v 15 \w entonces|strong="H3588"\w* \w el|strong="H1931"\w* hombre llevará \w a|strong="H3068"\w* \w su|strong="H1931"\w* mujer ante \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w*, \w y|strong="H3588"\w* presentará \w su|strong="H1931"\w* \w ofrenda|strong="H4503"\w* \w por|strong="H5921"\w* \w ella|strong="H1931"\w*: \w la|strong="H1931"\w* décima parte \w de|strong="H5921"\w* un efa \w de|strong="H5921"\w* \w harina|strong="H7058"\w* \w de|strong="H5921"\w* \w cebada|strong="H8184"\w*. \w No|strong="H3808"\w* derramará \w aceite|strong="H8081"\w* \w ni|strong="H3808"\w* \w le|strong="H1931"\w* \w pondrá|strong="H5414"\w* \w incienso|strong="H3828"\w* \w encima|strong="H5921"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* una \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* celos, una \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* recordatorio, \w que|strong="H3588"\w* \w trae|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w memoria|strong="H2142"\w* \w el|strong="H1931"\w* \w pecado|strong="H5771"\w*.  
\v 16 El \w sacerdote|strong="H3548"\w* la acercará y la pondrá \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 17 El \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* \w agua|strong="H4325"\w* \w santa|strong="H6918"\w* \w en|strong="H4480"\w* una \w vasija|strong="H3627"\w* \w de|strong="H4480"\w* \w barro|strong="H6083"\w*; y \w tomará|strong="H3947"\w* un poco \w del|strong="H4480"\w* \w polvo|strong="H6083"\w* \w que|strong="H4480"\w* \w está|strong="H1961"\w* \w en|strong="H4480"\w* el piso \w del|strong="H4480"\w* \w tabernáculo|strong="H4908"\w* y lo echará \w en|strong="H4480"\w* el \w agua|strong="H4325"\w*.  
\v 18 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w pondrá|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, soltará \w el|strong="H1931"\w* cabello \w de|strong="H5921"\w* \w la|strong="H1931"\w* mujer, \w y|strong="H5921"\w* \w pondrá|strong="H5414"\w* \w en|strong="H5921"\w* \w sus|strong="H1931"\w* \w manos|strong="H3027"\w* \w la|strong="H1931"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* recordatorio, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* celos. \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w tendrá|strong="H1961"\w* \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w mano|strong="H3027"\w* \w el|strong="H1931"\w* \w agua|strong="H4325"\w* \w amarga|strong="H4751"\w* \w que|strong="H1931"\w* \w trae|strong="H5414"\w* maldición.  
\v 19 El \w sacerdote|strong="H3548"\w* le hará un juramento y le dirá \w a|strong="H3068"\w* la mujer: “\w Si|strong="H3808"\w* \w ningún|strong="H3808"\w* hombre \w se|strong="H3808"\w* \w ha|strong="H3808"\w* \w acostado|strong="H7901"\w* contigo y \w si|strong="H3808"\w* \w no|strong="H3808"\w* te has desviado \w a|strong="H3068"\w* la impureza, estando \w bajo|strong="H8478"\w* la autoridad \w de|strong="H8478"\w* tu esposo, queda \w libre|strong="H5352"\w* \w de|strong="H8478"\w* esta \w agua|strong="H4325"\w* \w amarga|strong="H4751"\w* \w que|strong="H3808"\w* trae maldición.  
\v 20 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w te|strong="H3588"\w* \w has|strong="H5414"\w* desviado, estando \w bajo|strong="H8478"\w* \w la|strong="H3588"\w* autoridad \w de|strong="H3588"\w* tu esposo, \w y|strong="H3588"\w* \w si|strong="H3588"\w* \w te|strong="H3588"\w* \w has|strong="H5414"\w* \w contaminado|strong="H2930"\w*, \w y|strong="H3588"\w* algún hombre se ha acostado contigo \w además|strong="H3588"\w* \w de|strong="H3588"\w* tu esposo,”  
\v 21 entonces \w el|strong="H5307"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H5414"\w* \w que|strong="H5971"\w* la mujer \w haga|strong="H5414"\w* un \w juramento|strong="H7621"\w* \w de|strong="H5971"\w* maldición, y le dirá: “\w Que|strong="H5971"\w* Yahvé te ponga como ejemplo \w de|strong="H5971"\w* maldición y \w juramento|strong="H7621"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5971"\w* tu \w pueblo|strong="H5971"\w*, cuando Yahvé \w haga|strong="H5414"\w* \w que|strong="H5971"\w* tu \w muslo|strong="H3409"\w* decaiga y tu vientre \w se|strong="H5971"\w* hinche;  
\v 22 y \w que|strong="H4325"\w* esta \w agua|strong="H4325"\w* \w que|strong="H4325"\w* trae maldición entre en tus \w entrañas|strong="H4578"\w* para hacer \w que|strong="H4325"\w* tu vientre se hinche y tu \w muslo|strong="H3409"\w* decaiga”. \w Y|strong="H3068"\w* la mujer dirá: “Amén, amén”.   
\p
\v 23 “‘El \w sacerdote|strong="H3548"\w* \w escribirá|strong="H3789"\w* estas maldiciones en un documento, y las lavará en el \w agua|strong="H4325"\w* \w amarga|strong="H4751"\w*.  
\v 24 Hará \w que|strong="H4325"\w* la mujer beba el \w agua|strong="H4325"\w* \w amarga|strong="H4751"\w* \w que|strong="H4325"\w* trae maldición; y el \w agua|strong="H4325"\w* \w que|strong="H4325"\w* trae la maldición entrará en ella y se volverá \w amarga|strong="H4751"\w*.  
\v 25 El \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* \w de|strong="H6440"\w* las \w manos|strong="H3027"\w* \w de|strong="H6440"\w* la mujer la \w ofrenda|strong="H4503"\w* \w de|strong="H6440"\w* celos, \w mecerá|strong="H5130"\w* la \w ofrenda|strong="H4503"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé y la \w llevará|strong="H3947"\w* al \w altar|strong="H4196"\w*.  
\v 26 El \w sacerdote|strong="H3548"\w* tomará un puñado \w de|strong="H4480"\w* la \w ofrenda|strong="H4503"\w* como porción \w de|strong="H4480"\w* recordatorio, la \w quemará|strong="H6999"\w* \w sobre|strong="H4480"\w* el \w altar|strong="H4196"\w*, y después hará \w que|strong="H4480"\w* la mujer beba el \w agua|strong="H4325"\w*.  
\v 27 \w Cuando|strong="H1961"\w* le \w haya|strong="H1961"\w* dado \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w el|strong="H5307"\w* \w agua|strong="H4325"\w*, \w sucederá|strong="H1961"\w* \w que|strong="H5971"\w* \w si|strong="H1961"\w* ella \w se|strong="H1961"\w* ha \w contaminado|strong="H2930"\w* y ha \w sido|strong="H1961"\w* infiel \w a|strong="H3068"\w* su esposo, \w el|strong="H5307"\w* \w agua|strong="H4325"\w* \w que|strong="H5971"\w* trae la maldición entrará en ella causando \w amargura|strong="H4751"\w*, su vientre \w se|strong="H1961"\w* hinchará y su \w muslo|strong="H3409"\w* decaerá; y la mujer \w se|strong="H1961"\w* convertirá en una maldición en \w medio|strong="H7130"\w* \w de|strong="H5971"\w* su \w pueblo|strong="H5971"\w*.  
\v 28 Pero \w si|strong="H3808"\w* \w la|strong="H1931"\w* mujer \w no|strong="H3808"\w* \w se|strong="H1931"\w* \w ha|strong="H3808"\w* \w contaminado|strong="H2930"\w* y \w está|strong="H1931"\w* \w limpia|strong="H2889"\w*, entonces quedará \w libre|strong="H5352"\w* y \w podrá|strong="H3808"\w* tener \w hijos|strong="H2233"\w*.   
\p
\v 29 “‘\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w ley|strong="H8451"\w* sobre los celos, cuando una mujer que \w está|strong="H2063"\w* \w bajo|strong="H8478"\w* \w la|strong="H2063"\w* autoridad \w de|strong="H8478"\w* su esposo se desvía y se contamina,  
\v 30 \w o|strong="H3068"\w* cuando un \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w celos|strong="H7065"\w* \w se|strong="H5921"\w* apodera \w de|strong="H5921"\w* un hombre \w y|strong="H5921"\w* \w este|strong="H2063"\w* siente \w celos|strong="H7065"\w* \w de|strong="H5921"\w* su mujer; entonces pondrá \w a|strong="H3068"\w* \w la|strong="H5921"\w* mujer \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* aplicará \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w toda|strong="H3605"\w* \w esta|strong="H2063"\w* \w ley|strong="H8451"\w*.  
\v 31 \w El|strong="H1931"\w* hombre quedará \w libre|strong="H5352"\w* de \w culpa|strong="H5352"\w*, y \w la|strong="H1931"\w* mujer cargará con \w su|strong="H1931"\w* propio \w pecado|strong="H5771"\w*’”.   
\c 6  
\p
\v 1 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* un \w hombre|strong="H1121"\w* \w o|strong="H3068"\w* una mujer haga un \w voto|strong="H5087"\w* especial, \w el|strong="H3588"\w* \w voto|strong="H5087"\w* \w de|strong="H3588"\w* \w nazareo|strong="H5139"\w*, \w para|strong="H3588"\w* consagrarse \w a|strong="H3068"\w* Yahvé,  
\v 3 \w se|strong="H3808"\w* apartará \w del|strong="H8354"\w* \w vino|strong="H3196"\w* y de las bebidas fermentadas. \w No|strong="H3808"\w* \w beberá|strong="H8354"\w* \w vinagre|strong="H2558"\w* de \w vino|strong="H3196"\w*, \w ni|strong="H3808"\w* \w vinagre|strong="H2558"\w* de \w bebida|strong="H7941"\w* fermentada, \w ni|strong="H3808"\w* \w beberá|strong="H8354"\w* jugo de uva, \w ni|strong="H3808"\w* comerá \w uvas|strong="H6025"\w* \w frescas|strong="H3892"\w* \w o|strong="H3068"\w* \w secas|strong="H3002"\w*.  
\v 4 Durante \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H5704"\w* su \w nazareato|strong="H5145"\w*, \w no|strong="H3808"\w* comerá \w nada|strong="H3808"\w* \w que|strong="H3808"\w* provenga \w de|strong="H5704"\w* \w la|strong="H3605"\w* \w vid|strong="H1612"\w*, \w desde|strong="H5704"\w* las semillas \w hasta|strong="H5704"\w* \w la|strong="H3605"\w* cáscara.   
\p
\v 5 “‘Durante \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* su \w voto|strong="H5088"\w* \w de|strong="H5921"\w* \w consagración|strong="H5145"\w*, \w ninguna|strong="H3605"\w* \w navaja|strong="H8593"\w* \w pasará|strong="H5674"\w* \w por|strong="H5921"\w* su \w cabeza|strong="H7218"\w*, \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* \w cumpla|strong="H4390"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w de|strong="H5921"\w* su \w consagración|strong="H5145"\w* \w a|strong="H3068"\w* Yahvé. \w Será|strong="H1961"\w* \w santo|strong="H6918"\w*. Dejará crecer \w los|strong="H5921"\w* mechones \w de|strong="H5921"\w* su \w cabello|strong="H5145"\w*.   
\p
\v 6 “‘\w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w que|strong="H3808"\w* esté consagrado \w a|strong="H3068"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H5921"\w* acercará \w a|strong="H3068"\w* un cadáver.  
\v 7 \w No|strong="H3808"\w* \w se|strong="H5921"\w* \w contaminará|strong="H2930"\w* \w ni|strong="H3808"\w* siquiera \w por|strong="H5921"\w* \w su|strong="H3588"\w* padre, \w su|strong="H3588"\w* madre, \w su|strong="H3588"\w* hermano \w o|strong="H3068"\w* \w su|strong="H3588"\w* hermana \w cuando|strong="H3588"\w* \w ellos|strong="H5921"\w* mueran, \w porque|strong="H3588"\w* lleva \w sobre|strong="H5921"\w* \w su|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w la|strong="H5921"\w* \w consagración|strong="H5145"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* Dios.  
\v 8 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* de \w su|strong="H1931"\w* \w nazareato|strong="H5145"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w santo|strong="H6918"\w* para Yahvé.   
\p
\v 9 “‘\w Si|strong="H3588"\w* alguien muere \w de|strong="H5921"\w* repente \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w y|strong="H3588"\w* \w se|strong="H5921"\w* contamina \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w consagración|strong="H5145"\w*, \w entonces|strong="H3117"\w* \w se|strong="H5921"\w* rapará \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* purificación. \w Al|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* rapará.  
\v 10 Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* llevará \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones al \w sacerdote|strong="H3548"\w*, \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la Tienda del Encuentro.  
\v 11 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w ofrecerá|strong="H6213"\w* uno \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* \w y|strong="H5921"\w* \w el|strong="H1931"\w* otro \w como|strong="H5921"\w* \w holocausto|strong="H5930"\w*, \w y|strong="H5921"\w* \w hará|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H1931"\w*, \w porque|strong="H5921"\w* \w pecó|strong="H2398"\w* \w a|strong="H3068"\w* causa \w del|strong="H5921"\w* muerto, \w y|strong="H5921"\w* consagrará \w su|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*.  
\v 12 Dedicará nuevamente \w a|strong="H3068"\w* Yahvé \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w nazareato|strong="H5145"\w*, \w y|strong="H3588"\w* traerá un \w cordero|strong="H3532"\w* \w de|strong="H3588"\w* un \w año|strong="H8141"\w* \w como|strong="H3588"\w* ofrenda \w por|strong="H3588"\w* \w la|strong="H3588"\w* culpa; \w los|strong="H1121"\w* \w días|strong="H3117"\w* anteriores quedarán anulados, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w consagración|strong="H5145"\w* fue profanada.   
\p
\v 13 “‘\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w ley|strong="H8451"\w* del \w nazareo|strong="H5139"\w*: \w cuando|strong="H3117"\w* se \w cumpla|strong="H4390"\w* el \w tiempo|strong="H3117"\w* de su \w consagración|strong="H5145"\w*, será llevado \w a|strong="H3068"\w* \w la|strong="H2063"\w* entrada de \w la|strong="H2063"\w* Tienda del Encuentro,  
\v 14 y \w presentará|strong="H7126"\w* su \w ofrenda|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé: un \w cordero|strong="H3532"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w* sin defecto para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*, una \w cordera|strong="H3535"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w* sin defecto para la \w ofrenda|strong="H7133"\w* por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w*, un carnero sin defecto para \w el|strong="H1121"\w* sacrificio \w de|strong="H1121"\w* comunión,  
\v 15 una canasta de panes sin levadura, \w tortas|strong="H2471"\w* de harina fina \w amasadas|strong="H1101"\w* con \w aceite|strong="H8081"\w*, y obleas sin levadura \w untadas|strong="H4886"\w* con \w aceite|strong="H8081"\w*, junto con su \w ofrenda|strong="H4503"\w* de grano y sus \w libaciones|strong="H5262"\w*.  
\v 16 \w El|strong="H6213"\w* \w sacerdote|strong="H3548"\w* los \w presentará|strong="H7126"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, y \w ofrecerá|strong="H7126"\w* su ofrenda \w por|strong="H6440"\w* \w el|strong="H6213"\w* \w pecado|strong="H2403"\w* y su \w holocausto|strong="H5930"\w*.  
\v 17 \w Ofrecerá|strong="H6213"\w* \w el|strong="H5921"\w* carnero \w como|strong="H5921"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* comunión \w a|strong="H3068"\w* Yahvé, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* canasta \w de|strong="H5921"\w* \w los|strong="H5921"\w* panes sin levadura. \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w ofrecerá|strong="H6213"\w* también su \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* grano \w y|strong="H5921"\w* su \w libación|strong="H5262"\w*.  
\v 18 \w El|strong="H5921"\w* \w nazareo|strong="H5139"\w* \w se|strong="H5921"\w* rapará \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* su \w consagración|strong="H5145"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, \w tomará|strong="H3947"\w* \w el|strong="H5921"\w* \w cabello|strong="H5145"\w* \w de|strong="H5921"\w* su \w consagración|strong="H5145"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* echará \w al|strong="H5921"\w* fuego \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w debajo|strong="H8478"\w* \w del|strong="H5921"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* comunión.  
\v 19 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* \w la|strong="H5921"\w* pierna \w cocida|strong="H1311"\w* \w del|strong="H4480"\w* carnero, una \w torta|strong="H2471"\w* sin levadura \w de|strong="H4480"\w* \w la|strong="H5921"\w* canasta \w y|strong="H5921"\w* una oblea sin levadura, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrá|strong="H5414"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3709"\w* \w del|strong="H4480"\w* \w nazareo|strong="H5139"\w* \w después|strong="H5921"\w* \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w se|strong="H5921"\w* haya rapado \w la|strong="H5921"\w* cabeza \w de|strong="H4480"\w* su \w consagración|strong="H5145"\w*;  
\v 20 \w y|strong="H5921"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w las|strong="H5921"\w* \w mecerá|strong="H5130"\w* \w como|strong="H5921"\w* \w ofrenda|strong="H8641"\w* especial \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé. Son porción sagrada \w para|strong="H5921"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w*, \w además|strong="H5921"\w* \w del|strong="H5921"\w* pecho \w mecido|strong="H8573"\w* \w y|strong="H5921"\w* \w la|strong="H1931"\w* \w pierna|strong="H7785"\w* ofrecida. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w eso|strong="H1931"\w*, \w el|strong="H1931"\w* \w nazareo|strong="H5139"\w* podrá \w beber|strong="H8354"\w* \w vino|strong="H3196"\w*.   
\p
\v 21 “‘\w Esta|strong="H2063"\w* \w es|strong="H3027"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w del|strong="H5921"\w* \w nazareo|strong="H5139"\w* \w que|strong="H5921"\w* \w hace|strong="H6213"\w* un \w voto|strong="H5087"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* su \w ofrenda|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* su \w consagración|strong="H5145"\w*, sin contar \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* voluntariamente pueda dar. \w Según|strong="H5921"\w* \w el|strong="H5921"\w* \w voto|strong="H5087"\w* \w que|strong="H5921"\w* haya \w hecho|strong="H6213"\w*, \w así|strong="H3651"\w* \w lo|strong="H5921"\w* \w cumplirá|strong="H6213"\w* \w conforme|strong="H6310"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* su \w consagración|strong="H5145"\w*’”.   
\p
\v 22 Yahvé \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w diciendo|strong="H1696"\w*:  
\v 23 “\w Habla|strong="H1696"\w* \w a|strong="H3068"\w* Aarón \w y|strong="H3541"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, \w y|strong="H3541"\w* \w diles|strong="H1696"\w*: ‘\w Así|strong="H3541"\w* bendecirán \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. Les dirán:   
\q1
\v 24 Que Yahvé te \w bendiga|strong="H1288"\w* y te proteja;   
\q2
\v 25 Que Yahvé haga brillar su \w rostro|strong="H6440"\w* sobre ti,  
\q2 y te muestre su favor;   
\q1
\v 26 Que Yahvé levante su \w rostro|strong="H6440"\w* \w hacia|strong="H6440"\w* ti,  
\q2 y te conceda la \w paz|strong="H7965"\w*’.   
\p
\v 27 “Así \w pondrán|strong="H7760"\w* \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w* \w sobre|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* yo \w los|strong="H1121"\w* \w bendeciré|strong="H1288"\w*”.   
\c 7  
\p
\v 1 \w El|strong="H3605"\w* \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w Moisés|strong="H4872"\w* terminó de \w levantar|strong="H6965"\w* \w el|strong="H3605"\w* \w tabernáculo|strong="H4908"\w*, \w lo|strong="H3605"\w* \w ungió|strong="H4886"\w* y \w lo|strong="H3605"\w* consagró con \w todo|strong="H3605"\w* su mobiliario; \w ungió|strong="H4886"\w* y consagró también \w el|strong="H3605"\w* \w altar|strong="H4196"\w* con \w todos|strong="H3605"\w* sus utensilios;  
\v 2 \w los|strong="H1992"\w* líderes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w los|strong="H1992"\w* \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* \w sus|strong="H1992"\w* padres, presentaron ofrendas. \w Estos|strong="H1992"\w* eran \w los|strong="H1992"\w* líderes \w de|strong="H5921"\w* \w las|strong="H1992"\w* \w tribus|strong="H4294"\w*, \w los|strong="H1992"\w* \w que|strong="H5921"\w* \w estaban|strong="H5975"\w* \w a|strong="H3068"\w* \w cargo|strong="H6485"\w* \w del|strong="H5921"\w* censo;  
\v 3 \w y|strong="H5921"\w* \w trajeron|strong="H7126"\w* su \w ofrenda|strong="H7133"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé: \w seis|strong="H8337"\w* carretas cubiertas \w y|strong="H5921"\w* \w doce|strong="H8147"\w* \w bueyes|strong="H1241"\w*; una carreta \w por|strong="H5921"\w* cada \w dos|strong="H8147"\w* líderes, \w y|strong="H5921"\w* un \w buey|strong="H7794"\w* \w por|strong="H5921"\w* cada uno. \w Los|strong="H5921"\w* presentaron \w delante|strong="H6440"\w* \w del|strong="H5921"\w* \w tabernáculo|strong="H4908"\w*.  
\v 4 Yahvé habló \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, diciendo:  
\v 5 “Recíbelos \w de|strong="H5414"\w* ellos, \w para|strong="H5414"\w* \w que|strong="H1961"\w* \w se|strong="H1961"\w* utilicen en el servicio \w de|strong="H5414"\w* la Tienda del Encuentro; y entrégaselos \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w levitas|strong="H3881"\w*, \w a|strong="H3068"\w* cada uno \w según|strong="H6310"\w* sus responsabilidades”.   
\p
\v 6 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* las carretas \w y|strong="H1241"\w* los \w bueyes|strong="H1241"\w* \w y|strong="H1241"\w* se los \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* los \w levitas|strong="H3881"\w*.  
\v 7 Les \w dio|strong="H5414"\w* \w dos|strong="H8147"\w* carretas \w y|strong="H1241"\w* cuatro \w bueyes|strong="H1241"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1648"\w*, \w según|strong="H6310"\w* sus responsabilidades.  
\v 8 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w* les \w dio|strong="H5414"\w* cuatro carretas \w y|strong="H1241"\w* \w ocho|strong="H8083"\w* \w bueyes|strong="H1241"\w*, \w según|strong="H6310"\w* sus responsabilidades, bajo la dirección \w de|strong="H1121"\w* Itamar, \w hijo|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Aarón.  
\v 9 \w Pero|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Coat \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w dio|strong="H5414"\w* \w nada|strong="H3808"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* servicio \w del|strong="H5921"\w* \w santuario|strong="H6944"\w* estaba \w a|strong="H3068"\w* \w su|strong="H3588"\w* cargo \w y|strong="H3588"\w* debían llevar \w las|strong="H5921"\w* cosas \w santas|strong="H6944"\w* \w sobre|strong="H5921"\w* sus \w hombros|strong="H3802"\w*.   
\p
\v 10 Los líderes presentaron \w ofrendas|strong="H7133"\w* para la dedicación \w del|strong="H4196"\w* \w altar|strong="H4196"\w* el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* fue \w ungido|strong="H4886"\w*. Los líderes presentaron sus \w ofrendas|strong="H7133"\w* \w delante|strong="H6440"\w* \w del|strong="H4196"\w* \w altar|strong="H4196"\w*.   
\p
\v 11 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Presentarán su \w ofrenda|strong="H7133"\w*, un líder \w cada|strong="H3117"\w* \w día|strong="H3117"\w*, para la dedicación \w del|strong="H4196"\w* \w altar|strong="H4196"\w*”.   
\p
