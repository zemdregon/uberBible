\id HAG  
\h HAGEO 
\toc3 Hageo 
\toc1 HAGEO 
\toc2 HAGEO 
\mt1 Hageo  
\c 1  
\p
\v 1 En \w el|strong="H1121"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* del \w rey|strong="H4428"\w* \w Darío|strong="H1867"\w*, \w el|strong="H1121"\w* primer \w día|strong="H3117"\w* del \w sexto|strong="H8345"\w* \w mes|strong="H2320"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w vino|strong="H1961"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* del \w profeta|strong="H5030"\w* Ageo \w a|strong="H3068"\w* \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Salatiel, \w gobernador|strong="H6346"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, y \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac, \w el|strong="H1121"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w*:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w*: \w Este|strong="H2088"\w* \w pueblo|strong="H5971"\w* anda diciendo: ‘Todavía \w no|strong="H3808"\w* \w es|strong="H2088"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5971"\w* reconstruir el \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé’”.   
\p
\v 3 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* del \w profeta|strong="H5030"\w* Ageo:  
\v 4 “¿Acaso \w es|strong="H2088"\w* \w tiempo|strong="H6256"\w* \w de|strong="H6256"\w* \w que|strong="H2088"\w* ustedes vivan en \w casas|strong="H1004"\w* con techos lujosos, mientras \w que|strong="H2088"\w* mi \w templo|strong="H1004"\w* sigue en ruinas?  
\v 5 \w Por|strong="H5921"\w* eso, \w así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: ‘Piensen bien \w en|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H6258"\w* \w están|strong="H3824"\w* haciendo.  
\v 6 Ustedes siembran \w mucho|strong="H7235"\w*, pero cosechan \w poco|strong="H4592"\w*. Comen, pero no quedan satisfechos. \w Beben|strong="H8354"\w*, pero siguen con sed. Se visten, pero no se quitan el frío. \w Y|strong="H3068"\w* el que gana un sueldo, lo pone en un saco roto’”.   
\p
\v 7 “\w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: ‘Reflexionen \w sobre|strong="H5921"\w* su conducta.  
\v 8 Vayan \w a|strong="H3068"\w* los \w montes|strong="H2022"\w*, traigan \w madera|strong="H6086"\w* y reconstruyan mi \w templo|strong="H1004"\w*. Yo estaré contento con él y mostraré mi gloria’, dice el \w Señor|strong="H3068"\w*.  
\v 9 “Ustedes esperaban \w mucho|strong="H7235"\w*, pero les llegó \w poco|strong="H4592"\w*; y \w lo|strong="H1931"\w* \w que|strong="H4100"\w* trajeron \w a|strong="H3068"\w* \w casa|strong="H1004"\w*, \w yo|strong="H2009"\w* \w lo|strong="H1931"\w* desaparecí de un soplido. ¿\w Por|strong="H3282"\w* \w qué|strong="H4100"\w*?”, \w dice|strong="H5002"\w* Yahvé de \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*. “¡\w Porque|strong="H3282"\w* \w mi|strong="H2009"\w* \w templo|strong="H1004"\w* \w está|strong="H1931"\w* en ruinas, mientras \w que|strong="H4100"\w* cada uno de ustedes \w solo|strong="H1931"\w* \w se|strong="H1931"\w* preocupa \w por|strong="H3282"\w* \w su|strong="H1931"\w* propia \w casa|strong="H1004"\w*!  
\v 10 \w Por|strong="H5921"\w* culpa \w de|strong="H5921"\w* ustedes, \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* ha retenido \w el|strong="H5921"\w* \w rocío|strong="H2919"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w no|strong="H5921"\w* ha dado sus cosechas.  
\v 11 Yo envié una sequía \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* campos \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w*, \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w trigo|strong="H1715"\w*, \w el|strong="H5921"\w* \w vino|strong="H8492"\w* nuevo, \w el|strong="H5921"\w* \w aceite|strong="H3323"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w produce|strong="H3318"\w*; \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* gente, \w el|strong="H5921"\w* ganado \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* esfuerzo \w de|strong="H5921"\w* sus \w manos|strong="H3709"\w*”.   
\p
\v 12 Entonces \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Salatiel, \w el|strong="H5921"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Josadac, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w resto|strong="H7611"\w* \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w obedecieron|strong="H8085"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*. Hicieron caso \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w del|strong="H5921"\w* \w profeta|strong="H5030"\w* Ageo, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* Yahvé su \w Dios|strong="H3068"\w* había \w enviado|strong="H7971"\w*; \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* sintió reverencia \w ante|strong="H6440"\w* Yahvé.   
\p
\v 13 Entonces Ageo, el \w mensajero|strong="H4397"\w* \w de|strong="H5971"\w* Yahvé, dio al \w pueblo|strong="H5971"\w* este mensaje \w de|strong="H5971"\w* parte del \w Señor|strong="H3068"\w*: “Yo estoy con ustedes. Es la palabra \w de|strong="H5971"\w* Yahvé”.   
\p
\v 14 Yahvé \w despertó|strong="H5782"\w* \w el|strong="H3605"\w* entusiasmo \w de|strong="H1121"\w* \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Salatiel, \w gobernador|strong="H6346"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, y \w el|strong="H3605"\w* entusiasmo del \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac, y \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w resto|strong="H7611"\w* del \w pueblo|strong="H5971"\w*. \w Ellos|strong="H3605"\w* fueron y comenzaron \w a|strong="H3068"\w* \w trabajar|strong="H6213"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* su \w Dios|strong="H3068"\w*, Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*,  
\v 15 el \w día|strong="H3117"\w* \w veinticuatro|strong="H6242"\w* del \w sexto|strong="H8345"\w* \w mes|strong="H2320"\w*, en el \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* del \w rey|strong="H4428"\w* \w Darío|strong="H1867"\w*.   
\c 2  
\p
\v 1 \w El|strong="H5030"\w* día \w veintiuno|strong="H6242"\w* del \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* del \w profeta|strong="H5030"\w* Ageo:  
\v 2 “Habla \w ahora|strong="H4994"\w* con \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Salatiel, \w gobernador|strong="H6346"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, con \w el|strong="H1121"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac, y con \w el|strong="H1121"\w* \w resto|strong="H7611"\w* del \w pueblo|strong="H5971"\w*. Diles:  
\v 3 ‘¿\w Queda|strong="H7604"\w* alguien \w entre|strong="H3808"\w* ustedes \w que|strong="H4100"\w* haya \w visto|strong="H7200"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* en su \w antigua|strong="H7223"\w* \w gloria|strong="H3519"\w*? ¿\w Cómo|strong="H4100"\w* \w lo|strong="H4100"\w* \w ven|strong="H7200"\w* \w ahora|strong="H6258"\w*? ¿\w No|strong="H3808"\w* les parece \w que|strong="H4100"\w* \w no|strong="H3808"\w* \w es|strong="H2088"\w* \w nada|strong="H3808"\w* en comparación?  
\v 4 \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, ¡ten \w ánimo|strong="H2388"\w*, \w Zorobabel|strong="H2216"\w*!’, \w dice|strong="H5002"\w* Yahvé. ‘¡Ten \w ánimo|strong="H2388"\w*, \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Josadac! ¡Tengan \w ánimo|strong="H2388"\w*, \w todos|strong="H3605"\w* ustedes, habitantes del país!’, \w dice|strong="H5002"\w* Yahvé. ‘¡\w Y|strong="H3068"\w* trabajen, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w con|strong="H3588"\w* ustedes!’, \w dice|strong="H5002"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*.  
\v 5 ‘\w Esta|strong="H5975"\w* \w es|strong="H1697"\w* la promesa \w que|strong="H1697"\w* les \w hice|strong="H3772"\w* cuando \w salieron|strong="H3318"\w* \w de|strong="H1697"\w* \w Egipto|strong="H4714"\w*: Mi \w Espíritu|strong="H7307"\w* \w está|strong="H5975"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1697"\w* ustedes. No tengan \w miedo|strong="H3372"\w*’.  
\v 6 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*: ‘\w Dentro|strong="H5750"\w* \w de|strong="H3588"\w* \w poco|strong="H4592"\w* tiempo, \w yo|strong="H3588"\w* haré \w temblar|strong="H7493"\w* \w los|strong="H1931"\w* \w cielos|strong="H8064"\w* \w y|strong="H3588"\w* \w la|strong="H1931"\w* tierra, \w el|strong="H1931"\w* \w mar|strong="H3220"\w* \w y|strong="H3588"\w* \w la|strong="H1931"\w* tierra firme.  
\v 7 Haré \w temblar|strong="H7493"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w*; vendrán las riquezas de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H1471"\w*, \w y|strong="H3519"\w* llenaré \w este|strong="H2088"\w* \w templo|strong="H1004"\w* de \w gloria|strong="H3519"\w*’, dice Yahvé de \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*.  
\v 8 ‘Mía es la \w plata|strong="H3701"\w* y mío es el \w oro|strong="H2091"\w*’, \w dice|strong="H5002"\w* Yahvé de los \w Ejércitos|strong="H6635"\w*.  
\v 9 ‘La \w gloria|strong="H3519"\w* \w de|strong="H4480"\w* \w este|strong="H2088"\w* segundo \w templo|strong="H1004"\w* \w será|strong="H1961"\w* \w mayor|strong="H1419"\w* \w que|strong="H4480"\w* la \w del|strong="H4480"\w* \w primero|strong="H7223"\w*’, \w dice|strong="H5002"\w* Yahvé \w de|strong="H4480"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*; ‘\w y|strong="H3519"\w* \w en|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w daré|strong="H5414"\w* \w paz|strong="H7965"\w*’, \w dice|strong="H5002"\w* Yahvé \w de|strong="H4480"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*”.   
\p
\v 10 \w El|strong="H5030"\w* día \w veinticuatro|strong="H6242"\w* del mes \w noveno|strong="H8671"\w*, en \w el|strong="H5030"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* \w de|strong="H1697"\w* \w Darío|strong="H1867"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* al \w profeta|strong="H5030"\w* Ageo:  
\v 11 “\w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*: ‘Pregúntales \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* \w qué|strong="H4994"\w* dice la \w ley|strong="H8451"\w* sobre lo siguiente:  
\v 12 \w Si|strong="H2005"\w* alguien \w lleva|strong="H5375"\w* \w carne|strong="H1320"\w* sagrada en \w el|strong="H3605"\w* borde de su ropa, y ese borde \w toca|strong="H5060"\w* \w pan|strong="H3899"\w*, \w o|strong="H3068"\w* guiso, \w o|strong="H3068"\w* \w vino|strong="H3196"\w*, \w o|strong="H3068"\w* \w aceite|strong="H8081"\w*, \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* otra \w comida|strong="H3978"\w*, ¿quedará esa \w comida|strong="H3978"\w* \w consagrada|strong="H6944"\w*?’”.  
\p \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w respondieron|strong="H6030"\w*: “\w No|strong="H3808"\w*”.   
\p
\v 13 Entonces Ageo preguntó: “\w Si|strong="H5315"\w* alguien \w que|strong="H3605"\w* está impuro por haber tocado un cadáver \w toca|strong="H5060"\w* \w alguna|strong="H3605"\w* de estas cosas, ¿quedará \w ella|strong="H3605"\w* impura?”.  
\p \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w respondieron|strong="H6030"\w*: “\w Sí|strong="H5315"\w*, quedará impura”.   
\p
\v 14 \w Entonces|strong="H3651"\w* Ageo \w dijo|strong="H5002"\w*: “‘\w Lo|strong="H1931"\w* \w mismo|strong="H1931"\w* pasa con \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* y con \w esta|strong="H2088"\w* \w nación|strong="H1471"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H6030"\w*’, \w dice|strong="H5002"\w* Yahvé. ‘\w Lo|strong="H1931"\w* \w mismo|strong="H1931"\w* pasa con \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* hacen y con las ofrendas \w que|strong="H1931"\w* traen: \w todo|strong="H3605"\w* \w es|strong="H1931"\w* impuro.  
\v 15 \w Ahora|strong="H6258"\w*, \w por|strong="H4480"\w* favor, piensen bien \w en|strong="H4480"\w* \w lo|strong="H2088"\w* \w que|strong="H4480"\w* ha pasado \w desde|strong="H4480"\w* \w hoy|strong="H3117"\w* \w hacia|strong="H4480"\w* atrás, \w antes|strong="H2962"\w* \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w se|strong="H4480"\w* pusiera piedra \w sobre|strong="H4605"\w* piedra \w en|strong="H4480"\w* el \w templo|strong="H1964"\w* \w de|strong="H4480"\w* Yahvé.  
\v 16 En aquel tiempo, \w cuando|strong="H1961"\w* alguien iba \w a|strong="H3068"\w* un \w montón|strong="H6194"\w* esperando encontrar \w veinte|strong="H6242"\w* medidas de grano, solo encontraba \w diez|strong="H6235"\w*. \w Cuando|strong="H1961"\w* iba al \w lagar|strong="H3342"\w* \w para|strong="H1961"\w* sacar \w cincuenta|strong="H2572"\w* cántaros de \w vino|strong="H1961"\w*, solo encontraba \w veinte|strong="H6242"\w*.  
\v 17 Yo \w los|strong="H3605"\w* castigué con plagas, moho y \w granizo|strong="H1259"\w* \w en|strong="H5221"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo de sus \w manos|strong="H3027"\w*; pero aun así no se volvieron \w a|strong="H3068"\w* mí’, \w dice|strong="H5002"\w* Yahvé.  
\v 18 ‘Reflexionen, \w por|strong="H4480"\w* favor, \w desde|strong="H4480"\w* \w este|strong="H2088"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* adelante; \w desde|strong="H4480"\w* \w hoy|strong="H3117"\w*, \w veinticuatro|strong="H6242"\w* \w del|strong="H4480"\w* mes \w noveno|strong="H8671"\w*, \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* \w se|strong="H4480"\w* terminaron \w de|strong="H4480"\w* echar los \w cimientos|strong="H3245"\w* \w del|strong="H4480"\w* \w templo|strong="H1964"\w* \w de|strong="H4480"\w* Yahvé. Piénsenlo bien:  
\v 19 ¿Acaso queda \w todavía|strong="H5750"\w* semilla \w en|strong="H4480"\w* el granero? \w Hasta|strong="H5704"\w* \w ahora|strong="H3117"\w*, la \w vid|strong="H1612"\w*, la higuera, el granado \w y|strong="H5704"\w* el olivo \w no|strong="H3808"\w* han dado fruto. Pero \w a|strong="H3068"\w* partir \w de|strong="H4480"\w* \w hoy|strong="H3117"\w*, \w yo|strong="H4480"\w* los \w bendeciré|strong="H1288"\w*’”.   
\p
\v 20 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w por|strong="H1697"\w* \w segunda|strong="H8145"\w* vez \w a|strong="H3068"\w* Ageo el día \w veinticuatro|strong="H6242"\w* del \w mes|strong="H2320"\w*:  
\v 21 “Dile \w a|strong="H3068"\w* \w Zorobabel|strong="H2216"\w*, \w gobernador|strong="H6346"\w* de \w Judá|strong="H3063"\w*: ‘Yo voy \w a|strong="H3068"\w* hacer \w temblar|strong="H7493"\w* los \w cielos|strong="H8064"\w* y la tierra.  
\v 22 Derribaré los tronos \w reales|strong="H4467"\w* y \w destruiré|strong="H8045"\w* el poder de los \w reinos|strong="H4467"\w* de las \w naciones|strong="H1471"\w*. Volcaré los \w carros|strong="H4818"\w* de guerra y \w a|strong="H3068"\w* los que los tripulan; los \w caballos|strong="H5483"\w* y sus jinetes \w caerán|strong="H3381"\w*, cada uno por la \w espada|strong="H2719"\w* de su propio hermano.  
\v 23 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*’, \w dice|strong="H5002"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*, ‘\w te|strong="H3588"\w* \w tomaré|strong="H3947"\w* \w a|strong="H3068"\w* ti, \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Salatiel, \w siervo|strong="H5650"\w* mío’, \w dice|strong="H5002"\w* Yahvé, ‘\w y|strong="H3588"\w* \w te|strong="H3588"\w* \w haré|strong="H7760"\w* \w como|strong="H3588"\w* mi anillo \w de|strong="H3588"\w* sellar, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* he elegido’, \w dice|strong="H5002"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*”.   