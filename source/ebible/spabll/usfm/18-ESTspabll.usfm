\v 31 \w En|strong="H5921"\w* \w ellas|strong="H5921"\w* confirmaba \w las|strong="H5921"\w* fechas \w para|strong="H5921"\w* \w la|strong="H5921"\w* celebración \w de|strong="H5921"\w* \w Purim|strong="H6332"\w*, \w tal|strong="H1697"\w* \w como|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Ester \w lo|strong="H1697"\w* habían ordenado, \w y|strong="H5921"\w* \w como|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w lo|strong="H1697"\w* habían establecido \w para|strong="H5921"\w* \w sí|strong="H5921"\w* mismos \w y|strong="H5921"\w* \w para|strong="H5921"\w* sus descendientes, incluyendo \w las|strong="H5921"\w* instrucciones \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w ayuno|strong="H6685"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* lamentos.  
\v 32 El decreto \w de|strong="H1697"\w* Ester \w confirmó|strong="H6965"\w* estas reglas sobre el \w Purim|strong="H6332"\w*, y todo quedó registrado en un \w libro|strong="H5612"\w*.   
\c 10  
\p
\v 1 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero fijó impuestos \w en|strong="H5921"\w* todo \w el|strong="H5921"\w* territorio \w del|strong="H5921"\w* \w reino|strong="H4428"\w*, incluso \w en|strong="H5921"\w* \w las|strong="H5921"\w* islas \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 2 \w Todas|strong="H3605"\w* \w sus|strong="H1992"\w* \w grandes|strong="H1431"\w* hazañas \w y|strong="H5921"\w* \w su|strong="H1992"\w* poder, \w así|strong="H1992"\w* \w como|strong="H5921"\w* \w el|strong="H5921"\w* relato detallado \w del|strong="H5921"\w* prestigio \w de|strong="H5921"\w* Mardoqueo \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w cómo|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H1697"\w* ascendió, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* anales \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Media|strong="H4074"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w*.  
\v 3 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* \w judío|strong="H3064"\w* Mardoqueo llegó \w a|strong="H3068"\w* ser \w el|strong="H3588"\w* \w segundo|strong="H4932"\w* después del \w rey|strong="H4428"\w* Asuero. Fue un hombre muy importante \w entre|strong="H3588"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w y|strong="H3588"\w* muy querido \w por|strong="H3588"\w* \w todos|strong="H3605"\w* sus compatriotas, \w porque|strong="H3588"\w* \w siempre|strong="H3605"\w* \w buscó|strong="H1875"\w* \w el|strong="H3588"\w* bienestar \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* trabajó \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w paz|strong="H7965"\w* \w de|strong="H3588"\w* \w todos|strong="H3605"\w* sus descendientes.   