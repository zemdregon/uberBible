\v 11 \w Y|strong="H3068"\w* \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w le|strong="H5869"\w* dijo \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*: “Quédate con \w el|strong="H6213"\w* \w dinero|strong="H3701"\w*, y \w haz|strong="H6213"\w* con ese \w pueblo|strong="H5971"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w mejor|strong="H2896"\w* \w te|strong="H5869"\w* parezca.”   
\p
\v 12 \w El|strong="H5921"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* \w del|strong="H5921"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, \w se|strong="H5921"\w* \w convocó|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* secretarios \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. Tal \w como|strong="H5921"\w* \w Amán|strong="H2001"\w* \w lo|strong="H5921"\w* \w ordenó|strong="H6680"\w*, \w se|strong="H5921"\w* \w escribió|strong="H3789"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w gobernadores|strong="H6346"\w* regionales, \w a|strong="H3068"\w* \w los|strong="H5921"\w* administradores \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w jefes|strong="H8269"\w* \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w*. \w Las|strong="H5921"\w* cartas \w se|strong="H5921"\w* \w escribieron|strong="H3789"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w escritura|strong="H3789"\w* \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* idioma \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w y|strong="H5921"\w* selladas \w con|strong="H5921"\w* su anillo.  
\v 13 Las \w cartas|strong="H5612"\w* fueron enviadas \w por|strong="H5704"\w* \w medio|strong="H3027"\w* \w de|strong="H5704"\w* mensajeros \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w*. \w La|strong="H1931"\w* orden \w era|strong="H1931"\w* \w destruir|strong="H8045"\w*, matar \w y|strong="H5704"\w* exterminar \w por|strong="H5704"\w* completo \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* —jóvenes \w y|strong="H5704"\w* \w ancianos|strong="H2205"\w*, \w mujeres|strong="H5704"\w* \w y|strong="H5704"\w* \w niños|strong="H2945"\w*— \w en|strong="H5704"\w* un \w solo|strong="H1931"\w* \w día|strong="H3117"\w*: \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* del \w mes|strong="H2320"\w* \w doce|strong="H8147"\w* (\w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H5704"\w* Adar), \w y|strong="H5704"\w* confiscar \w todas|strong="H3605"\w* \w sus|strong="H1931"\w* pertenencias.  
\v 14 Una copia del decreto debía publicarse \w como|strong="H1961"\w* ley en \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w*, \w para|strong="H5414"\w* \w que|strong="H5971"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w de|strong="H5971"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* estuviera preparada \w para|strong="H5414"\w* \w ese|strong="H2088"\w* \w día|strong="H3117"\w*.  
\v 15 \w Por|strong="H1697"\w* orden \w del|strong="H8354"\w* \w rey|strong="H4428"\w*, \w los|strong="H3427"\w* mensajeros \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* toda prisa. \w El|strong="H3427"\w* decreto \w también|strong="H3318"\w* se publicó \w en|strong="H3318"\w* la ciudadela \w de|strong="H1697"\w* Susa. Mientras \w el|strong="H3427"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* se sentaban \w a|strong="H3068"\w* \w beber|strong="H8354"\w*, \w en|strong="H3318"\w* la \w ciudad|strong="H5892"\w* \w de|strong="H1697"\w* Susa \w reinaba|strong="H4428"\w* la confusión.   
\c 4  
\p
\v 1 Cuando Mardoqueo \w se|strong="H3045"\w* enteró \w de|strong="H3847"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3045"\w* \w había|strong="H6213"\w* pasado, \w se|strong="H3045"\w* \w rasgó|strong="H7167"\w* \w la|strong="H3605"\w* ropa, \w se|strong="H3045"\w* \w vistió|strong="H3847"\w* \w de|strong="H3847"\w* luto, \w se|strong="H3045"\w* cubrió \w de|strong="H3847"\w* ceniza y \w salió|strong="H3318"\w* por \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w gritando|strong="H2199"\w* con mucha \w amargura|strong="H4751"\w*.  
\v 2 \w Pero|strong="H3588"\w* solo pudo llegar \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* del palacio, \w porque|strong="H3588"\w* \w a|strong="H3068"\w* nadie se le permitía entrar \w en|strong="H5704"\w* ella \w vestido|strong="H3830"\w* \w con|strong="H3588"\w* ropa \w de|strong="H3588"\w* luto.  
\v 3 En \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* \w a|strong="H3068"\w* \w donde|strong="H4725"\w* \w llegaba|strong="H5060"\w* \w el|strong="H3605"\w* decreto y \w la|strong="H3605"\w* orden del \w rey|strong="H4428"\w*, hubo \w gran|strong="H1419"\w* aflicción entre \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*. Ayunaban, lloraban y hacían \w lamentos|strong="H1065"\w*; y \w muchos|strong="H7227"\w* \w de|strong="H1697"\w* \w ellos|strong="H3605"\w* terminaron acostados en ceniza y vestidos \w de|strong="H1697"\w* luto.   
\p
\v 4 Cuando \w las|strong="H5921"\w* muchachas \w al|strong="H5921"\w* servicio \w de|strong="H5921"\w* Ester \w y|strong="H5921"\w* sus oficiales \w le|strong="H5921"\w* \w contaron|strong="H5046"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* pasaba, \w la|strong="H5921"\w* \w reina|strong="H4436"\w* \w se|strong="H5921"\w* angustió \w mucho|strong="H3966"\w*. \w Le|strong="H5921"\w* \w envió|strong="H7971"\w* ropa \w a|strong="H3068"\w* Mardoqueo \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* cambiara \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w quitara|strong="H5493"\w* \w la|strong="H5921"\w* ropa \w de|strong="H5921"\w* luto, pero \w él|strong="H5921"\w* \w no|strong="H3808"\w* quiso aceptarla.  
\v 5 Entonces Ester \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Hatac, uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w del|strong="H5921"\w* \w rey|strong="H4428"\w* asignado \w para|strong="H5921"\w* atenderla, \w y|strong="H5921"\w* \w lo|strong="H4100"\w* \w mandó|strong="H6680"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Mardoqueo \w para|strong="H5921"\w* averiguar \w qué|strong="H4100"\w* \w estaba|strong="H5975"\w* pasando \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w qué|strong="H4100"\w* \w estaba|strong="H5975"\w* \w así|strong="H2088"\w*.  
\v 6 Hatac \w salió|strong="H3318"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Mardoqueo \w a|strong="H3068"\w* la plaza \w de|strong="H6440"\w* la \w ciudad|strong="H5892"\w*, frente \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* del palacio.  
\v 7 Mardoqueo \w le|strong="H5921"\w* \w contó|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* había sucedido \w y|strong="H5921"\w* \w le|strong="H5921"\w* dio \w el|strong="H5921"\w* detalle exacto \w de|strong="H5921"\w* \w la|strong="H5921"\w* cantidad \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w que|strong="H5921"\w* \w Amán|strong="H2001"\w* había prometido entregar \w a|strong="H3068"\w* \w las|strong="H5921"\w* arcas \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* cambio \w del|strong="H5921"\w* exterminio \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w*.  
\v 8 También \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* una copia \w del|strong="H5921"\w* decreto publicado \w en|strong="H5921"\w* Susa \w que|strong="H5921"\w* ordenaba su destrucción, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* \w mostrara|strong="H7200"\w* \w a|strong="H3068"\w* Ester, \w se|strong="H5921"\w* \w la|strong="H5921"\w* explicara \w y|strong="H5921"\w* \w la|strong="H5921"\w* convenciera \w de|strong="H5921"\w* presentarse \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w para|strong="H5921"\w* suplicarle \w y|strong="H5921"\w* pedirle clemencia \w por|strong="H5921"\w* su \w pueblo|strong="H5971"\w*.   
\p
\v 9 Hatac regresó y le dio \w a|strong="H3068"\w* Ester el mensaje \w de|strong="H1697"\w* Mardoqueo.  
\v 10 Entonces Ester habló de nuevo con Hatac y le dio esta respuesta para Mardoqueo:  
\v 11 “\w Todos|strong="H3605"\w* \w los|strong="H3605"\w* servidores del \w rey|strong="H4428"\w* y \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w de|strong="H5971"\w* las \w provincias|strong="H4082"\w* \w saben|strong="H3045"\w* \w que|strong="H3808"\w* hay una sola ley \w para|strong="H5971"\w* \w cualquier|strong="H3605"\w* hombre \w o|strong="H3068"\w* mujer \w que|strong="H3808"\w* \w se|strong="H3045"\w* presente ante \w el|strong="H3605"\w* \w rey|strong="H4428"\w* en \w el|strong="H3605"\w* \w patio|strong="H2691"\w* \w interior|strong="H6442"\w* \w sin|strong="H3808"\w* ser \w llamado|strong="H7121"\w*: \w la|strong="H3605"\w* \w muerte|strong="H4191"\w*. \w La|strong="H3605"\w* única excepción \w es|strong="H2088"\w* \w que|strong="H3808"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* le extienda su cetro \w de|strong="H5971"\w* \w oro|strong="H2091"\w* \w para|strong="H5971"\w* salvarle \w la|strong="H3605"\w* \w vida|strong="H3117"\w*. ¡\w Y|strong="H3068"\w* \w a|strong="H3068"\w* mí \w no|strong="H3808"\w* me \w han|strong="H4191"\w* \w llamado|strong="H7121"\w* \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* en \w estos|strong="H2088"\w* últimos \w treinta|strong="H7970"\w* \w días|strong="H3117"\w*!”.   
\p
\v 12 Cuando le dieron \w a|strong="H3068"\w* Mardoqueo el mensaje \w de|strong="H1697"\w* Ester,  
\v 13 \w él|strong="H3605"\w* mandó decirle: “No creas \w que|strong="H3605"\w* \w por|strong="H4428"\w* estar en \w el|strong="H3605"\w* palacio \w real|strong="H4428"\w* vas \w a|strong="H3068"\w* \w ser|strong="H5315"\w* \w la|strong="H3605"\w* única judía \w que|strong="H3605"\w* se salve.  
\v 14 \w Si|strong="H3588"\w* \w te|strong="H3588"\w* quedas callada \w en|strong="H3588"\w* un momento \w como|strong="H3588"\w* \w este|strong="H2063"\w*, \w el|strong="H3588"\w* auxilio \w y|strong="H3588"\w* \w la|strong="H3588"\w* libertad \w para|strong="H3588"\w* \w los|strong="H3588"\w* \w judíos|strong="H3064"\w* vendrán \w de|strong="H3588"\w* otra \w parte|strong="H4725"\w*, \w pero|strong="H3588"\w* tú \w y|strong="H3588"\w* tu \w familia|strong="H1004"\w* morirán. ¡\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w si|strong="H3588"\w* \w no|strong="H3588"\w* llegaste \w al|strong="H6256"\w* trono precisamente \w para|strong="H3588"\w* un momento \w como|strong="H3588"\w* \w este|strong="H2063"\w*!”.   
\p
\v 15 \w Entonces|strong="H7725"\w* Ester le envió esta respuesta \w a|strong="H3068"\w* Mardoqueo:  
\v 16 “\w Ve|strong="H3212"\w* \w y|strong="H1571"\w* reúne \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w que|strong="H3808"\w* estén \w en|strong="H5921"\w* Susa. Ayunen \w por|strong="H5921"\w* \w mí|strong="H5921"\w*; \w no|strong="H3808"\w* coman \w ni|strong="H3808"\w* \w beban|strong="H8354"\w* \w nada|strong="H3808"\w* durante \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w y|strong="H1571"\w* \w tres|strong="H7969"\w* \w noches|strong="H3915"\w*. Mis muchachas \w y|strong="H1571"\w* yo ayunaremos \w también|strong="H1571"\w*. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w eso|strong="H3651"\w*, \w me|strong="H5921"\w* presentaré ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w aunque|strong="H1571"\w* sea \w contra|strong="H5921"\w* \w la|strong="H5921"\w* ley. \w Y|strong="H3068"\w* \w si|strong="H1571"\w* \w tengo|strong="H5921"\w* \w que|strong="H3808"\w* morir, moriré”.  
\v 17 Mardoqueo \w se|strong="H5921"\w* retiró \w de|strong="H5921"\w* allí \w y|strong="H5921"\w* cumplió \w con|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* instrucciones \w que|strong="H5921"\w* Ester \w le|strong="H5921"\w* \w había|strong="H6213"\w* dado.   
\c 5  
\p
\v 1 \w Al|strong="H5921"\w* tercer \w día|strong="H3117"\w*, Ester \w se|strong="H1961"\w* \w puso|strong="H5975"\w* su \w vestido|strong="H3847"\w* \w de|strong="H5921"\w* \w reina|strong="H4428"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* presentó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w* \w interior|strong="H6442"\w* \w del|strong="H5921"\w* palacio, frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* sala \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w estaba|strong="H1961"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*, orientado \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* entrada.  
\v 2 \w Cuando|strong="H1961"\w* el \w rey|strong="H4428"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* la \w reina|strong="H4436"\w* Ester allí \w de|strong="H5869"\w* \w pie|strong="H5975"\w* \w en|strong="H5975"\w* el \w patio|strong="H2691"\w*, ella \w se|strong="H1961"\w* ganó su favor; entonces el \w rey|strong="H4428"\w* \w le|strong="H5869"\w* \w extendió|strong="H3447"\w* el cetro \w de|strong="H5869"\w* \w oro|strong="H2091"\w* \w que|strong="H1961"\w* \w tenía|strong="H1961"\w* \w en|strong="H5975"\w* la \w mano|strong="H3027"\w*. Ester \w se|strong="H1961"\w* acercó y \w tocó|strong="H5060"\w* la punta del cetro.   
\p
\v 3 El \w rey|strong="H4428"\w* le preguntó: “¿\w Qué|strong="H4100"\w* te pasa, \w reina|strong="H4436"\w* Ester? ¿\w Qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* quieres? ¡\w Hasta|strong="H5704"\w* la mitad \w de|strong="H5704"\w* mi \w reino|strong="H4438"\w* te \w daría|strong="H5414"\w*!”.   
\p
\v 4 Ester respondió: “\w Si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, \w le|strong="H5921"\w* invito \w a|strong="H3068"\w* \w que|strong="H5921"\w* venga \w hoy|strong="H3117"\w* \w con|strong="H5921"\w* \w Amán|strong="H2001"\w* \w al|strong="H5921"\w* \w banquete|strong="H4960"\w* \w que|strong="H5921"\w* he preparado \w en|strong="H5921"\w* su honor”.   
\p
\v 5 \w De|strong="H1697"\w* inmediato \w el|strong="H6213"\w* \w rey|strong="H4428"\w* ordenó: “Busquen rápido \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* para \w que|strong="H1697"\w* podamos cumplir \w el|strong="H6213"\w* deseo \w de|strong="H1697"\w* Ester”. Así, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* fueron \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* \w que|strong="H1697"\w* Ester \w había|strong="H6213"\w* preparado.   
\p
\v 6 \w Mientras|strong="H5704"\w* bebían \w vino|strong="H3196"\w*, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* le \w volvió|strong="H5414"\w* \w a|strong="H3068"\w* preguntar \w a|strong="H3068"\w* Ester: “Dime \w qué|strong="H4100"\w* deseas \w y|strong="H5704"\w* \w se|strong="H4100"\w* te concederá. ¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*? ¡Incluso si fuera la mitad \w del|strong="H2677"\w* \w reino|strong="H4438"\w*, \w se|strong="H4100"\w* te \w daría|strong="H5414"\w*!”.   
\p
\v 7 Ester \w respondió|strong="H6030"\w*: “Esto es lo que deseo y pido:  
\v 8 \w Si|strong="H5921"\w* cuento \w con|strong="H5921"\w* \w el|strong="H5921"\w* favor \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w y|strong="H5921"\w* \w si|strong="H5921"\w* su majestad tiene \w a|strong="H3068"\w* \w bien|strong="H2895"\w* concederme \w lo|strong="H1697"\w* \w que|strong="H5921"\w* pido \w y|strong="H5921"\w* cumplir \w mi|strong="H5921"\w* deseo, \w le|strong="H5921"\w* ruego \w que|strong="H5921"\w* venga \w mañana|strong="H4279"\w* \w con|strong="H5921"\w* \w Amán|strong="H2001"\w* \w al|strong="H5921"\w* \w banquete|strong="H4960"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* voy \w a|strong="H3068"\w* preparar. Entonces \w le|strong="H5921"\w* \w daré|strong="H5414"\w* \w una|strong="H4672"\w* \w respuesta|strong="H1697"\w* definitiva”.   
\p
\v 9 \w Amán|strong="H2001"\w* \w salió|strong="H3318"\w* \w del|strong="H4480"\w* palacio muy \w alegre|strong="H8056"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w buen|strong="H2896"\w* humor. Pero \w cuando|strong="H3117"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* Mardoqueo \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w puerta|strong="H8179"\w* \w del|strong="H4480"\w* palacio, \w y|strong="H5921"\w* notó \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* levantaba \w ni|strong="H3808"\w* mostraba \w ningún|strong="H3808"\w* respeto ante \w él|strong="H1931"\w*, \w se|strong="H1931"\w* puso furioso.  
\v 10 Sin embargo, se aguantó y se fue \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*. Allí reunió \w a|strong="H3068"\w* sus amigos y \w a|strong="H3068"\w* su esposa \w Zeres|strong="H2238"\w*,  
\v 11 \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w puso|strong="H5375"\w* \w a|strong="H3068"\w* presumirles \w de|strong="H5921"\w* \w su|strong="H1992"\w* gran riqueza, \w de|strong="H5921"\w* \w sus|strong="H1992"\w* \w muchos|strong="H7230"\w* \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H1992"\w* veces \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H5921"\w* había ascendido, dándole \w más|strong="H5921"\w* importancia \w que|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* demás funcionarios \w y|strong="H5921"\w* servidores.   
\p
\v 12 \w Y|strong="H3068"\w* agregó \w Amán|strong="H2001"\w*: “\w Es|strong="H3588"\w* \w más|strong="H3588"\w*, \w la|strong="H1571"\w* \w reina|strong="H4436"\w* Ester \w no|strong="H3808"\w* invitó \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* mí \w para|strong="H3588"\w* acompañar \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* \w que|strong="H3588"\w* ella preparó. \w Y|strong="H3068"\w* \w también|strong="H1571"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* invitado \w para|strong="H3588"\w* acompañar \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w mañana|strong="H4279"\w*.  
\v 13 Pero \w nada|strong="H3605"\w* \w de|strong="H6256"\w* \w esto|strong="H2088"\w* me satisface \w mientras|strong="H3605"\w* \w vea|strong="H7200"\w* \w a|strong="H3068"\w* \w ese|strong="H2088"\w* \w judío|strong="H3064"\w* Mardoqueo \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del palacio”.   
\p
\v 14 Entonces su esposa \w Zeres|strong="H2238"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus amigos \w le|strong="H5921"\w* sugirieron: “Manda construir una horca \w de|strong="H5921"\w* veinticinco metros \w de|strong="H5921"\w* altura, \w y|strong="H5921"\w* \w mañana|strong="H1242"\w* temprano pídele \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H5921"\w* cuelguen allí \w a|strong="H3068"\w* Mardoqueo. \w Así|strong="H5973"\w* podrás ir \w al|strong="H5921"\w* \w banquete|strong="H4960"\w* \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* disfrutarlo”. \w A|strong="H3068"\w* \w Amán|strong="H2001"\w* \w le|strong="H5921"\w* encantó \w la|strong="H5921"\w* idea \w y|strong="H5921"\w* mandó construir \w la|strong="H5921"\w* horca.   
\c 6  
\p
\v 1 \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w no|strong="H1961"\w* podía dormir, \w así|strong="H1931"\w* \w que|strong="H1931"\w* mandó traer \w el|strong="H1931"\w* \w libro|strong="H5612"\w* \w de|strong="H6440"\w* \w la|strong="H1931"\w* historia \w de|strong="H6440"\w* \w su|strong="H1931"\w* \w reino|strong="H4428"\w* \w para|strong="H1961"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* \w lo|strong="H1931"\w* leyeran.  
\v 2 Allí encontraron \w el|strong="H5921"\w* relato \w de|strong="H5921"\w* \w cómo|strong="H5921"\w* Mardoqueo \w había|strong="H4672"\w* denunciado \w a|strong="H3068"\w* Bigtán \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w Teres|strong="H8657"\w*, \w dos|strong="H8147"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H5921"\w* vigilaban \w la|strong="H5921"\w* entrada \w y|strong="H5921"\w* \w que|strong="H5921"\w* habían tramado un plan \w para|strong="H5921"\w* asesinar \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero.  
\v 3 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* preguntó: “¿\w Qué|strong="H4100"\w* honor \w o|strong="H3068"\w* reconocimiento recibió Mardoqueo \w por|strong="H5921"\w* \w haber|strong="H3808"\w* \w hecho|strong="H6213"\w* \w esto|strong="H2088"\w*?”.  
\p Sus asistentes \w le|strong="H5921"\w* respondieron: “\w No|strong="H3808"\w* \w se|strong="H5921"\w* \w ha|strong="H3808"\w* \w hecho|strong="H6213"\w* \w nada|strong="H3808"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w*”.   
\p
\v 4 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* preguntó: “¿\w Quién|strong="H4310"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w*?”. \w En|strong="H5921"\w* ese momento \w Amán|strong="H2001"\w* acababa \w de|strong="H5921"\w* entrar \w al|strong="H5921"\w* \w patio|strong="H2691"\w* \w exterior|strong="H2435"\w* \w del|strong="H5921"\w* palacio \w para|strong="H5921"\w* pedirle \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H4310"\w* colgaran \w a|strong="H3068"\w* Mardoqueo \w en|strong="H5921"\w* \w la|strong="H5921"\w* horca \w que|strong="H4310"\w* \w él|strong="H5921"\w* mismo \w le|strong="H5921"\w* había preparado.   
\p
\v 5 Sus servidores le contestaron: “\w Es|strong="H5975"\w* \w Amán|strong="H2001"\w* quien \w está|strong="H5975"\w* \w en|strong="H5975"\w* el \w patio|strong="H2691"\w*”.  
\p El \w rey|strong="H4428"\w* \w ordenó|strong="H5975"\w*: “Díganle \w que|strong="H2691"\w* pase”.  
\v 6 \w Cuando|strong="H4100"\w* \w Amán|strong="H2001"\w* entró, \w el|strong="H4310"\w* \w rey|strong="H4428"\w* \w le|strong="H4310"\w* preguntó: “¿\w Cómo|strong="H4100"\w* \w se|strong="H4480"\w* debe tratar \w al|strong="H4480"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H4310"\w* \w el|strong="H4310"\w* \w rey|strong="H4428"\w* \w desea|strong="H2654"\w* honrar?”.  
\p \w Amán|strong="H2001"\w* pensó \w para|strong="H4480"\w* sus adentros: “¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w más|strong="H4480"\w* querría honrar \w el|strong="H4310"\w* \w rey|strong="H4428"\w* sino \w a|strong="H3068"\w* mí?”.  
\v 7 Así que le respondió \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “Para el hombre \w a|strong="H3068"\w* quien el \w rey|strong="H4428"\w* \w desea|strong="H2654"\w* honrar,  
\v 8 traigan una \w de|strong="H5921"\w* \w las|strong="H5921"\w* túnicas \w reales|strong="H4428"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* mismo usa \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w caballo|strong="H5483"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w monta|strong="H7392"\w*, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* pongan \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w la|strong="H5921"\w* corona \w real|strong="H4428"\w*.  
\v 9 Entreguen luego \w la|strong="H5921"\w* ropa \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w caballo|strong="H5483"\w* \w a|strong="H3068"\w* uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w más|strong="H5921"\w* nobles \w del|strong="H5921"\w* \w reino|strong="H4428"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* vistan \w al|strong="H5921"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w desea|strong="H2654"\w* honrar. Llévenlo \w a|strong="H3068"\w* \w caballo|strong="H5483"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* plaza \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w proclamando|strong="H7121"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*: ‘¡\w Así|strong="H3602"\w* \w es|strong="H3027"\w* \w como|strong="H5921"\w* \w se|strong="H5921"\w* trata \w al|strong="H5921"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w desea|strong="H2654"\w* honrar!’”.   
\p
\v 10 \w Entonces|strong="H3651"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* le ordenó \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*: “¡Date prisa! \w Toma|strong="H3947"\w* \w la|strong="H3605"\w* túnica y \w el|strong="H3605"\w* \w caballo|strong="H5483"\w*, \w tal|strong="H3651"\w* \w como|strong="H3651"\w* \w lo|strong="H1697"\w* \w dijiste|strong="H1696"\w*, y \w haz|strong="H6213"\w* exactamente \w eso|strong="H3651"\w* con \w el|strong="H3605"\w* \w judío|strong="H3064"\w* Mardoqueo, \w que|strong="H1697"\w* \w está|strong="H3651"\w* \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del palacio. \w No|strong="H6213"\w* pases \w por|strong="H1697"\w* alto \w ninguno|strong="H3605"\w* \w de|strong="H1697"\w* \w los|strong="H3427"\w* detalles \w que|strong="H1697"\w* sugeriste”.   
\p
\v 11 \w Amán|strong="H2001"\w* \w tomó|strong="H3947"\w* la túnica y \w el|strong="H6213"\w* \w caballo|strong="H5483"\w*, \w vistió|strong="H3847"\w* \w a|strong="H3068"\w* Mardoqueo y \w lo|strong="H6213"\w* \w llevó|strong="H3947"\w* \w por|strong="H6440"\w* la plaza \w de|strong="H6440"\w* la \w ciudad|strong="H5892"\w* \w proclamando|strong="H7121"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H6213"\w*: “¡\w Así|strong="H3602"\w* es como se trata \w al|strong="H4428"\w* hombre \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w desea|strong="H2654"\w* honrar!”.   
\p
\v 12 Después de esto, Mardoqueo regresó \w a|strong="H3068"\w* su puesto en la \w puerta|strong="H8179"\w* del palacio, pero \w Amán|strong="H2001"\w* corrió \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*, muy avergonzado y cubriéndose la cara en señal de luto.  
\v 13 \w Amán|strong="H2001"\w* les \w contó|strong="H5608"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposa \w Zeres|strong="H2238"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus amigos \w lo|strong="H3808"\w* \w que|strong="H3588"\w* le \w había|strong="H3588"\w* pasado. \w Entonces|strong="H3588"\w* sus consejeros \w y|strong="H3588"\w* \w su|strong="H3588"\w* esposa le advirtieron: “\w Si|strong="H3588"\w* ese Mardoqueo, \w ante|strong="H6440"\w* \w quien|strong="H3605"\w* ya empezaste \w a|strong="H3068"\w* perder terreno, \w es|strong="H3588"\w* \w de|strong="H3588"\w* origen \w judío|strong="H3064"\w*, \w no|strong="H3808"\w* vas \w a|strong="H3068"\w* poder vencerlo. Ten \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* serás derrotado \w por|strong="H3588"\w* \w él|strong="H3588"\w*”.  
\v 14 \w Todavía|strong="H5750"\w* estaban \w hablando|strong="H1696"\w* cuando \w llegaron|strong="H5060"\w* \w los|strong="H5973"\w* oficiales \w del|strong="H5973"\w* \w rey|strong="H4428"\w* y se llevaron \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* \w a|strong="H3068"\w* toda prisa \w al|strong="H4428"\w* \w banquete|strong="H4960"\w* que Ester \w había|strong="H6213"\w* preparado.   
\c 7  
\p
\v 1 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* y \w Amán|strong="H2001"\w* fueron \w al|strong="H4428"\w* banquete \w con|strong="H5973"\w* la \w reina|strong="H4436"\w* Ester.  
\v 2 \w También|strong="H1571"\w* \w en|strong="H5704"\w* este \w segundo|strong="H8145"\w* \w día|strong="H3117"\w*, \w mientras|strong="H5704"\w* bebían \w vino|strong="H3196"\w*, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* le preguntó: “¿\w Qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* quieres, \w reina|strong="H4436"\w* Ester? \w Lo|strong="H4100"\w* \w que|strong="H4100"\w* me pidas \w se|strong="H4100"\w* te concederá. ¿\w Cuál|strong="H4100"\w* es \w tu|strong="H6213"\w* \w petición|strong="H7596"\w*? ¡Incluso \w si|strong="H1571"\w* fuera \w la|strong="H1571"\w* mitad \w del|strong="H2677"\w* \w reino|strong="H4438"\w*, te \w la|strong="H1571"\w* \w daría|strong="H5414"\w*!”.   
\p
\v 3 \w La|strong="H5921"\w* \w reina|strong="H4436"\w* Ester \w respondió|strong="H6030"\w*: “\w Si|strong="H5921"\w* cuento \w con|strong="H5921"\w* \w el|strong="H5921"\w* favor \w de|strong="H5921"\w* su majestad, \w y|strong="H5921"\w* \w si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, \w mi|strong="H5921"\w* única \w petición|strong="H7596"\w* es \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* perdone \w la|strong="H5921"\w* \w vida|strong="H5315"\w* \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* salve \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*.  
\v 4 \w Porque|strong="H3588"\w* mi \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w yo|strong="H3588"\w* hemos sido \w vendidos|strong="H4376"\w* \w para|strong="H3588"\w* ser exterminados, \w para|strong="H3588"\w* ser asesinados \w y|strong="H3588"\w* \w para|strong="H3588"\w* morir. \w Si|strong="H3588"\w* solo nos hubieran vendido \w como|strong="H3588"\w* esclavos \w y|strong="H3588"\w* esclavas, \w me|strong="H3588"\w* habría quedado callada, \w pues|strong="H3588"\w* ese problema \w no|strong="H3588"\w* afectaría tanto \w los|strong="H3588"\w* intereses del \w rey|strong="H4428"\w*”.   
\p
\v 5 \w Entonces|strong="H3651"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Asuero \w le|strong="H1931"\w* preguntó \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* Ester: “¿\w Quién|strong="H4310"\w* \w es|strong="H1931"\w* \w ese|strong="H1931"\w* hombre? ¿\w Dónde|strong="H1931"\w* \w está|strong="H2088"\w* \w el|strong="H1931"\w* \w que|strong="H4310"\w* \w se|strong="H1931"\w* atrevió \w a|strong="H3068"\w* pensar en \w hacer|strong="H6213"\w* algo \w así|strong="H3651"\w*?”.   
\p
\v 6 Ester contestó: “¡Nuestro \w enemigo|strong="H6862"\w* y adversario \w es|strong="H2088"\w* \w este|strong="H2088"\w* \w malvado|strong="H7451"\w* \w Amán|strong="H2001"\w*!”. \w Ante|strong="H6440"\w* el \w rey|strong="H4428"\w* y la \w reina|strong="H4436"\w*, \w Amán|strong="H2001"\w* se quedó aterrorizado.  
\v 7 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w levantó|strong="H6965"\w* furioso, dejó \w el|strong="H5921"\w* \w vino|strong="H3196"\w* \w y|strong="H3588"\w* salió \w al|strong="H5921"\w* jardín \w del|strong="H5921"\w* palacio. \w Pero|strong="H3588"\w* \w Amán|strong="H2001"\w*, dándose cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* ya \w había|strong="H5975"\w* decidido \w su|strong="H3588"\w* \w castigo|strong="H7451"\w*, \w se|strong="H5921"\w* \w quedó|strong="H5975"\w* \w para|strong="H5921"\w* suplicarle \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Ester \w que|strong="H3588"\w* \w le|strong="H5921"\w* perdonara \w la|strong="H5921"\w* \w vida|strong="H5315"\w*.  
\v 8 \w Cuando|strong="H1571"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* regresó \w del|strong="H5921"\w* jardín \w al|strong="H5921"\w* lugar \w del|strong="H5921"\w* \w banquete|strong="H4960"\w*, vio \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* \w de|strong="H5921"\w* rodillas \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* diván \w donde|strong="H5921"\w* \w estaba|strong="H1004"\w* Ester. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* exclamó: “¿Todavía \w se|strong="H5921"\w* atreve \w a|strong="H3068"\w* agredir \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* propia \w casa|strong="H1004"\w* \w y|strong="H1571"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*?”. \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* terminó \w de|strong="H5921"\w* \w hablar|strong="H1697"\w*, \w los|strong="H5921"\w* guardias \w le|strong="H5921"\w* \w cubrieron|strong="H2645"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w* \w a|strong="H3068"\w* \w Amán|strong="H2001"\w*.   
\p
\v 9 \w Entonces|strong="H1571"\w* \w Harboná|strong="H2726"\w*, uno \w de|strong="H4480"\w* \w los|strong="H5921"\w* oficiales \w al|strong="H5921"\w* servicio \w del|strong="H4480"\w* \w rey|strong="H4428"\w*, \w dijo|strong="H1696"\w*: “\w En|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w Amán|strong="H2001"\w* hay una horca \w de|strong="H4480"\w* veinticinco metros \w de|strong="H4480"\w* altura. \w Él|strong="H5921"\w* \w mismo|strong="H1571"\w* \w la|strong="H5921"\w* \w mandó|strong="H1696"\w* construir \w para|strong="H5921"\w* colgar \w a|strong="H3068"\w* Mardoqueo, \w el|strong="H5921"\w* hombre \w que|strong="H4480"\w* salvó \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w con|strong="H5921"\w* su informe”.  
\p \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w ordenó|strong="H5975"\w*: “¡Cuélguenlo \w en|strong="H5921"\w* \w ella|strong="H4480"\w*!”.   
\p
\v 10 Así \w que|strong="H5921"\w* \w colgaron|strong="H8518"\w* \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* misma horca \w que|strong="H5921"\w* \w él|strong="H5921"\w* había preparado \w para|strong="H5921"\w* Mardoqueo. \w Con|strong="H5921"\w* esto, \w se|strong="H5921"\w* calmó \w la|strong="H5921"\w* furia \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\c 8  
\p
\v 1 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Asuero \w le|strong="H1931"\w* regaló \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* Ester todas las propiedades \w de|strong="H3588"\w* \w Amán|strong="H2001"\w*, \w el|strong="H1931"\w* \w enemigo|strong="H6887"\w* \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w judíos|strong="H3064"\w*. \w Además|strong="H3588"\w*, Mardoqueo \w fue|strong="H1931"\w* admitido \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w presencia|strong="H6440"\w* del \w rey|strong="H4428"\w*, \w porque|strong="H3588"\w* Ester \w le|strong="H1931"\w* explicó \w que|strong="H3588"\w* \w él|strong="H1931"\w* \w era|strong="H1931"\w* \w su|strong="H1931"\w* pariente.  
\v 2 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w quitó|strong="H5493"\w* \w el|strong="H5921"\w* anillo oficial \w que|strong="H5921"\w* \w le|strong="H5921"\w* había quitado \w a|strong="H3068"\w* \w Amán|strong="H2001"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* Mardoqueo. \w Por|strong="H5921"\w* su parte, Ester \w lo|strong="H5921"\w* nombró administrador \w de|strong="H5921"\w* \w los|strong="H5921"\w* bienes \w que|strong="H5921"\w* habían sido \w de|strong="H5921"\w* \w Amán|strong="H2001"\w*.   
\p
\v 3 Ester \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w se|strong="H5921"\w* arrodilló \w ante|strong="H6440"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w*, \w con|strong="H5921"\w* lágrimas \w en|strong="H5921"\w* \w los|strong="H5921"\w* ojos, \w le|strong="H5921"\w* suplicó \w que|strong="H5921"\w* detuviera \w el|strong="H5921"\w* plan \w malvado|strong="H7451"\w* \w de|strong="H5921"\w* \w Amán|strong="H2001"\w*, \w el|strong="H5921"\w* agagueo, \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w*.  
\v 4 El \w rey|strong="H4428"\w* le \w extendió|strong="H3447"\w* \w a|strong="H3068"\w* Ester el cetro \w de|strong="H6440"\w* \w oro|strong="H2091"\w*, y ella se \w levantó|strong="H6965"\w* y \w permaneció|strong="H5975"\w* \w de|strong="H6440"\w* \w pie|strong="H5975"\w* \w ante|strong="H6440"\w* él.  
\v 5 \w Ella|strong="H5921"\w* dijo: “\w Si|strong="H6440"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2896"\w*, \w si|strong="H6440"\w* he \w ganado|strong="H1121"\w* su favor \w y|strong="H5921"\w* \w si|strong="H6440"\w* su majestad cree \w que|strong="H5921"\w* \w mi|strong="H5921"\w* petición \w es|strong="H1697"\w* justa \w y|strong="H5921"\w* \w me|strong="H5921"\w* tiene aprecio, \w le|strong="H5921"\w* ruego \w que|strong="H5921"\w* emita un decreto \w para|strong="H5921"\w* anular \w las|strong="H5921"\w* \w cartas|strong="H5612"\w* \w de|strong="H5921"\w* \w Amán|strong="H2001"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hamedata, \w el|strong="H5921"\w* agagueo. \w Él|strong="H5921"\w* \w las|strong="H5921"\w* \w escribió|strong="H3789"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* fin \w de|strong="H5921"\w* exterminar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* \w en|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w del|strong="H5921"\w* \w reino|strong="H4428"\w*.  
\v 6 \w Porque|strong="H3588"\w*, ¿\w cómo|strong="H3588"\w* \w podré|strong="H3201"\w* soportar \w ver|strong="H7200"\w* \w la|strong="H3588"\w* desgracia \w que|strong="H3588"\w* caerá sobre mi \w pueblo|strong="H5971"\w*? ¿\w Cómo|strong="H3588"\w* \w podré|strong="H3201"\w* \w ver|strong="H7200"\w* \w la|strong="H3588"\w* destrucción \w de|strong="H3588"\w* mi propia familia?”.   
\p
\v 7 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero \w les|strong="H5921"\w* respondió \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Ester \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w judío|strong="H3064"\w* Mardoqueo: “Miren, ya \w le|strong="H5921"\w* he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* Ester \w las|strong="H5921"\w* propiedades \w de|strong="H5921"\w* \w Amán|strong="H2001"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w lo|strong="H5921"\w* \w colgaron|strong="H8518"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* horca \w por|strong="H5921"\w* haber intentado atacar \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w*.  
\v 8 Ahora, escriban ustedes \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w mejor|strong="H2896"\w* \w les|strong="H5921"\w* parezca \w en|strong="H5921"\w* favor \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w*, \w y|strong="H3588"\w* séllenlo \w con|strong="H5921"\w* \w mi|strong="H5921"\w* anillo oficial. \w Pues|strong="H3588"\w* un decreto \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w sellado|strong="H2856"\w* \w con|strong="H5921"\w* \w su|strong="H3588"\w* anillo \w no|strong="H3588"\w* puede ser anulado”.   
\p
\v 9 \w De|strong="H5704"\w* inmediato, \w el|strong="H1931"\w* \w día|strong="H6256"\w* \w veintitrés|strong="H6242"\w* del tercer \w mes|strong="H2320"\w* (\w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H5704"\w* Siván), \w se|strong="H1931"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* secretarios del \w rey|strong="H4428"\w*. Siguiendo las instrucciones \w de|strong="H5704"\w* Mardoqueo, \w se|strong="H1931"\w* \w escribió|strong="H3789"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w gobernadores|strong="H6346"\w*, administradores \w y|strong="H5704"\w* \w jefes|strong="H8269"\w* \w de|strong="H5704"\w* las \w ciento|strong="H3967"\w* \w veintisiete|strong="H6242"\w* \w provincias|strong="H4082"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* extendían \w desde|strong="H5704"\w* \w la|strong="H1931"\w* India \w hasta|strong="H5704"\w* \w Etiopía|strong="H3568"\w*. \w Se|strong="H1931"\w* \w escribió|strong="H3789"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* \w en|strong="H5704"\w* \w su|strong="H1931"\w* propia \w escritura|strong="H3789"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w en|strong="H5704"\w* \w su|strong="H1931"\w* propio idioma, incluyendo \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w en|strong="H5704"\w* \w su|strong="H1931"\w* \w lengua|strong="H3956"\w* \w y|strong="H5704"\w* \w escritura|strong="H3789"\w*.  
\v 10 Mardoqueo \w escribió|strong="H3789"\w* en \w nombre|strong="H8034"\w* del \w rey|strong="H4428"\w* Asuero, selló las \w cartas|strong="H5612"\w* con \w el|strong="H1121"\w* anillo del \w rey|strong="H4428"\w* y las \w envió|strong="H7971"\w* con mensajeros \w que|strong="H1121"\w* montaban veloces \w caballos|strong="H5483"\w* \w de|strong="H1121"\w* las caballerizas \w reales|strong="H4428"\w*.  
\v 11 \w En|strong="H5921"\w* \w el|strong="H5921"\w* decreto, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* autorizaba \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w de|strong="H5921"\w* \w cada|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w a|strong="H3068"\w* reunirse \w para|strong="H5921"\w* defender su \w vida|strong="H5315"\w*. Tenían permiso \w para|strong="H5921"\w* \w destruir|strong="H8045"\w*, matar \w y|strong="H5921"\w* exterminar \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* fuerza armada, \w de|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w o|strong="H3068"\w* \w provincia|strong="H4082"\w*, \w que|strong="H5921"\w* \w los|strong="H5921"\w* atacara \w a|strong="H3068"\w* \w ellos|strong="H5921"\w*, \w a|strong="H3068"\w* sus mujeres \w o|strong="H3068"\w* \w a|strong="H3068"\w* sus hijos, \w y|strong="H5921"\w* podían confiscar sus bienes.  
\v 12 \w El|strong="H1931"\w* \w día|strong="H3117"\w* fijado para \w esto|strong="H1931"\w* en \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w* Asuero \w fue|strong="H1931"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* del \w mes|strong="H2320"\w* \w doce|strong="H8147"\w* (\w el|strong="H1931"\w* \w mes|strong="H2320"\w* de Adar).  
\v 13 Una copia del decreto debía publicarse \w como|strong="H1961"\w* ley en \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* y darse \w a|strong="H3068"\w* conocer \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w*, \w para|strong="H5414"\w* \w que|strong="H5971"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* estuvieran preparados \w ese|strong="H2088"\w* \w día|strong="H3117"\w* \w para|strong="H5414"\w* defenderse \w de|strong="H5971"\w* sus enemigos.  
\v 14 \w Por|strong="H1697"\w* orden del \w rey|strong="H4428"\w*, los mensajeros \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* toda prisa montando los caballos \w reales|strong="H4428"\w*. El decreto \w también|strong="H3318"\w* se publicó \w en|strong="H3318"\w* la ciudadela \w de|strong="H1697"\w* Susa.   
\p
\v 15 Mardoqueo \w salió|strong="H3318"\w* \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* del \w rey|strong="H4428"\w* \w vestido|strong="H3830"\w* con ropa \w real|strong="H4428"\w* \w de|strong="H6440"\w* color azul y \w blanco|strong="H2353"\w*, una \w gran|strong="H1419"\w* \w corona|strong="H5850"\w* \w de|strong="H6440"\w* \w oro|strong="H2091"\w* y una capa \w de|strong="H6440"\w* lino fino color púrpura. \w Al|strong="H4428"\w* verlo, la \w ciudad|strong="H5892"\w* \w de|strong="H6440"\w* Susa estalló \w en|strong="H3318"\w* gritos \w de|strong="H6440"\w* alegría.  
\v 16 \w Para|strong="H1961"\w* \w los|strong="H1961"\w* \w judíos|strong="H3064"\w* \w fue|strong="H1961"\w* un tiempo de luz, \w alegría|strong="H8057"\w*, felicidad y \w honra|strong="H3366"\w*.  
\v 17 \w En|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w y|strong="H3588"\w* \w ciudades|strong="H5892"\w* \w a|strong="H3068"\w* \w donde|strong="H5921"\w* \w llegaba|strong="H5060"\w* \w el|strong="H5921"\w* decreto \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* celebraban \w con|strong="H5921"\w* \w gozo|strong="H8057"\w* \w y|strong="H3588"\w* \w banquetes|strong="H4960"\w*. Era \w para|strong="H5921"\w* \w ellos|strong="H5921"\w* un \w día|strong="H3117"\w* \w de|strong="H5921"\w* fiesta. \w Además|strong="H5921"\w*, \w muchas|strong="H7227"\w* personas \w de|strong="H5921"\w* otros \w pueblos|strong="H5971"\w* \w se|strong="H5921"\w* hicieron \w judíos|strong="H3064"\w*, \w porque|strong="H3588"\w* tenían \w mucho|strong="H7227"\w* \w miedo|strong="H6343"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.   
\c 9  
\p
\v 1 \w El|strong="H1931"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* del \w mes|strong="H2320"\w* \w doce|strong="H8147"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H1697"\w* Adar, \w llegó|strong="H5060"\w* \w el|strong="H1931"\w* momento en \w que|strong="H1931"\w* debía ejecutarse \w el|strong="H1931"\w* decreto y \w la|strong="H1931"\w* orden del \w rey|strong="H4428"\w*. \w Ese|strong="H1931"\w* \w era|strong="H1931"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* en \w que|strong="H1931"\w* \w los|strong="H1992"\w* \w enemigos|strong="H8130"\w* \w de|strong="H1697"\w* \w los|strong="H1992"\w* \w judíos|strong="H3064"\w* \w esperaban|strong="H7663"\w* derrotarlos, pero resultó todo \w lo|strong="H1931"\w* contrario: fueron \w los|strong="H1992"\w* \w judíos|strong="H3064"\w* quienes vencieron \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w que|strong="H1931"\w* \w los|strong="H1992"\w* odiaban.  
\v 2 \w Los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w se|strong="H5921"\w* reunieron \w en|strong="H5921"\w* sus \w ciudades|strong="H5892"\w*, \w en|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero, \w para|strong="H5921"\w* atacar \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* querían hacerles daño. \w Nadie|strong="H3808"\w* pudo hacerles frente, \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w pueblos|strong="H5971"\w* tenían mucho \w miedo|strong="H6343"\w* \w de|strong="H5921"\w* \w ellos|strong="H3027"\w*.  
\v 3 \w Además|strong="H5921"\w*, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w jefes|strong="H8269"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w*, \w los|strong="H5921"\w* \w gobernadores|strong="H6346"\w*, \w los|strong="H5921"\w* administradores \w y|strong="H3588"\w* \w los|strong="H5921"\w* funcionarios \w del|strong="H5921"\w* \w rey|strong="H4428"\w* ayudaban \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* gran respeto \w que|strong="H3588"\w* \w le|strong="H5921"\w* tenían \w a|strong="H3068"\w* Mardoqueo.  
\v 4 Mardoqueo se \w había|strong="H3588"\w* vuelto un hombre muy poderoso \w en|strong="H3588"\w* \w el|strong="H3588"\w* palacio; \w su|strong="H3588"\w* fama se extendía \w por|strong="H3588"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* \w y|strong="H3588"\w* \w cada|strong="H3605"\w* vez tenía \w más|strong="H3588"\w* influencia.  
\v 5 Así \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* derrotaron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w enemigos|strong="H8130"\w* \w a|strong="H3068"\w* filo de \w espada|strong="H2719"\w*, matándolos y destruyéndolos; \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* quisieron con \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* odiaban.  
\v 6 Tan solo en la ciudadela \w de|strong="H2568"\w* Susa, los \w judíos|strong="H3064"\w* \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* \w quinientos|strong="H2568"\w* hombres.  
\v 7 También mataron \w a|strong="H3068"\w* Parsandata, dalfón, Aspata,  
\v 8 Porata, Adalía, Aridat,  
\v 9 Parmasta, Arisai, Aridai y Vaizata,  
\v 10 \w que|strong="H3808"\w* \w eran|strong="H3808"\w* \w los|strong="H1121"\w* \w diez|strong="H6235"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Amán|strong="H2001"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Hamedata, \w el|strong="H1121"\w* \w enemigo|strong="H6887"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w*. \w Sin|strong="H3808"\w* embargo, \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* \w no|strong="H3808"\w* tocaron \w ninguna|strong="H3808"\w* \w de|strong="H1121"\w* sus pertenencias.   
\p
\v 11 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* \w le|strong="H1931"\w* informaron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* cuántas personas habían muerto en \w la|strong="H1931"\w* ciudadela \w de|strong="H6440"\w* Susa.  
\v 12 Entonces \w el|strong="H1121"\w* \w rey|strong="H4428"\w* le dijo \w a|strong="H3068"\w* la \w reina|strong="H4436"\w* Ester: “Si tan solo \w en|strong="H5750"\w* la ciudadela \w de|strong="H5750"\w* Susa \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* han matado \w a|strong="H3068"\w* \w quinientos|strong="H2568"\w* \w hombres|strong="H1121"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w diez|strong="H6235"\w* \w hijos|strong="H1121"\w* \w de|strong="H5750"\w* \w Amán|strong="H2001"\w*, ¡\w qué|strong="H4100"\w* \w no|strong="H6213"\w* habrán \w hecho|strong="H6213"\w* \w en|strong="H5750"\w* \w el|strong="H1121"\w* resto \w de|strong="H5750"\w* las \w provincias|strong="H4082"\w*! Dime ahora, ¿\w qué|strong="H4100"\w* \w más|strong="H5750"\w* quieres? \w Se|strong="H4100"\w* te concederá. ¿\w Tienes|strong="H5750"\w* alguna \w otra|strong="H5750"\w* \w petición|strong="H7596"\w*? \w Se|strong="H4100"\w* \w hará|strong="H6213"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* pidas”.   
\p
\v 13 Ester respondió: “\w Si|strong="H1571"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2896"\w*, permita \w que|strong="H5921"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* \w que|strong="H5921"\w* están \w en|strong="H5921"\w* Susa \w hagan|strong="H6213"\w* \w también|strong="H1571"\w* \w mañana|strong="H4279"\w* \w lo|strong="H5921"\w* \w mismo|strong="H1571"\w* \w que|strong="H5921"\w* \w hoy|strong="H3117"\w*, \w y|strong="H1571"\w* \w que|strong="H5921"\w* cuelguen \w en|strong="H5921"\w* \w la|strong="H5921"\w* horca \w los|strong="H1121"\w* cuerpos \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w diez|strong="H6235"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Amán|strong="H2001"\w*”.   
\p
\v 14 \w El|strong="H1121"\w* \w rey|strong="H4428"\w* ordenó \w que|strong="H1121"\w* \w así|strong="H3651"\w* \w se|strong="H3651"\w* hiciera. \w El|strong="H1121"\w* decreto \w se|strong="H3651"\w* publicó en Susa y \w colgaron|strong="H8518"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w diez|strong="H6235"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Amán|strong="H2001"\w*.  
\v 15 Los \w judíos|strong="H3064"\w* de Susa \w se|strong="H3808"\w* reunieron \w también|strong="H1571"\w* \w el|strong="H1571"\w* \w día|strong="H3117"\w* catorce del \w mes|strong="H2320"\w* de Adar \w y|strong="H1571"\w* \w mataron|strong="H2026"\w* en \w la|strong="H1571"\w* ciudad \w a|strong="H3068"\w* otros \w trescientos|strong="H7969"\w* hombres, pero \w tampoco|strong="H1571"\w* tocaron sus pertenencias.   
\p
\v 16 Mientras \w tanto|strong="H5921"\w*, \w los|strong="H5921"\w* demás \w judíos|strong="H3064"\w* \w que|strong="H3808"\w* vivían \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* organizaron \w para|strong="H5921"\w* defender su \w vida|strong="H5315"\w*. \w Se|strong="H5921"\w* deshicieron \w de|strong="H5921"\w* sus \w enemigos|strong="H8130"\w* \w matando|strong="H2026"\w* \w a|strong="H3068"\w* \w setenta|strong="H7657"\w* \w y|strong="H5921"\w* \w cinco|strong="H2568"\w* mil \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w los|strong="H5921"\w* odiaban, pero \w no|strong="H3808"\w* \w se|strong="H5921"\w* quedaron \w con|strong="H5921"\w* \w nada|strong="H3808"\w* \w de|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w ellos|strong="H3027"\w* tenían.  
\v 17 \w Esto|strong="H6213"\w* sucedió \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w trece|strong="H7969"\w* del \w mes|strong="H2320"\w* de Adar. \w El|strong="H6213"\w* \w día|strong="H3117"\w* catorce descansaron y \w lo|strong="H6213"\w* convirtieron en un \w día|strong="H3117"\w* de fiesta y \w alegría|strong="H8057"\w*.   
\p
\v 18 Pero los \w judíos|strong="H3064"\w* \w de|strong="H2568"\w* Susa se habían reunido los \w días|strong="H3117"\w* \w trece|strong="H7969"\w* y catorce, así \w que|strong="H3117"\w* descansaron \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w quince|strong="H2568"\w*, y fue ese \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w que|strong="H3117"\w* celebraron con \w banquetes|strong="H4960"\w* y \w alegría|strong="H8057"\w*.  
\v 19 \w Por|strong="H5921"\w* \w esta|strong="H3651"\w* razón, \w los|strong="H3427"\w* \w judíos|strong="H3064"\w* \w que|strong="H5921"\w* viven \w en|strong="H5921"\w* \w los|strong="H3427"\w* pueblos \w y|strong="H5921"\w* aldeas celebran \w el|strong="H5921"\w* \w día|strong="H3117"\w* catorce \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w de|strong="H5921"\w* Adar \w como|strong="H5921"\w* un \w día|strong="H3117"\w* \w de|strong="H5921"\w* fiesta \w y|strong="H5921"\w* \w alegría|strong="H8057"\w*, un \w día|strong="H3117"\w* feriado \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* envían regalos \w de|strong="H5921"\w* comida unos \w a|strong="H3068"\w* otros.   
\p
\v 20 Mardoqueo registró \w estos|strong="H3605"\w* acontecimientos y \w envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w de|strong="H1697"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w rey|strong="H4428"\w* Asuero, tanto \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H1697"\w* vivían \w cerca|strong="H7138"\w* como \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H1697"\w* vivían \w lejos|strong="H7350"\w*.  
\v 21 \w Les|strong="H5921"\w* ordenó \w que|strong="H5921"\w* celebraran \w cada|strong="H3605"\w* \w año|strong="H8141"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* catorce \w y|strong="H5921"\w* \w quince|strong="H2568"\w* \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w de|strong="H5921"\w* Adar,  
\v 22 como \w los|strong="H1992"\w* \w días|strong="H3117"\w* en \w que|strong="H3117"\w* \w los|strong="H1992"\w* \w judíos|strong="H3064"\w* \w se|strong="H1992"\w* libraron de \w sus|strong="H1992"\w* enemigos, y como \w el|strong="H6213"\w* \w mes|strong="H2320"\w* en \w que|strong="H3117"\w* \w su|strong="H1992"\w* \w tristeza|strong="H3015"\w* \w se|strong="H1992"\w* convirtió en \w alegría|strong="H8057"\w* y \w su|strong="H1992"\w* llanto en fiesta. \w Les|strong="H1992"\w* pidió \w que|strong="H3117"\w* celebraran esos \w días|strong="H3117"\w* con \w banquetes|strong="H4960"\w* y \w alegría|strong="H8057"\w*, compartiendo comida \w unos|strong="H1992"\w* con otros y dando regalos \w a|strong="H3068"\w* \w los|strong="H1992"\w* pobres.  
\v 23 Los \w judíos|strong="H3064"\w* \w aceptaron|strong="H6901"\w* seguir celebrando \w esta|strong="H3789"\w* fiesta, tal como \w lo|strong="H6213"\w* habían \w hecho|strong="H6213"\w* esa primera vez y de acuerdo con \w lo|strong="H6213"\w* que Mardoqueo les \w había|strong="H6213"\w* \w escrito|strong="H3789"\w*.  
\v 24 \w Porque|strong="H3588"\w* \w Amán|strong="H2001"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hamedata, \w el|strong="H1931"\w* agagueo \w y|strong="H3588"\w* \w enemigo|strong="H6887"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w*, \w había|strong="H3588"\w* tramado un plan \w para|strong="H5921"\w* destruirlos \w y|strong="H3588"\w* \w había|strong="H3588"\w* \w echado|strong="H5307"\w* \w el|strong="H1931"\w* “\w Pur|strong="H6332"\w*” (\w es|strong="H1931"\w* decir, \w la|strong="H1931"\w* \w suerte|strong="H1486"\w*) \w para|strong="H5921"\w* decidir \w el|strong="H1931"\w* \w día|strong="H1121"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* exterminio.  
\v 25 Pero cuando Ester \w se|strong="H5921"\w* presentó \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, este emitió órdenes escritas \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* plan \w malvado|strong="H7451"\w* \w de|strong="H5921"\w* Amán \w contra|strong="H5921"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* \w se|strong="H5921"\w* volviera \w contra|strong="H5921"\w* \w él|strong="H5921"\w* mismo, \w y|strong="H5921"\w* mandó \w que|strong="H5921"\w* \w lo|strong="H5921"\w* colgaran \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* horca.   
\p
\v 26 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w estos|strong="H2063"\w* \w días|strong="H3117"\w* \w se|strong="H5921"\w* \w llaman|strong="H7121"\w* \w Purim|strong="H6332"\w*, \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w Pur|strong="H6332"\w*. Debido \w a|strong="H3068"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* decía \w esta|strong="H2063"\w* carta, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w ellos|strong="H5921"\w* mismos habían \w visto|strong="H7200"\w* \w y|strong="H5921"\w* vivido,  
\v 27 \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w establecieron|strong="H6965"\w* \w la|strong="H5921"\w* costumbre \w de|strong="H5921"\w* \w celebrar|strong="H6213"\w* \w sin|strong="H3808"\w* falta \w estos|strong="H3605"\w* \w dos|strong="H8147"\w* \w días|strong="H3117"\w* \w cada|strong="H3605"\w* \w año|strong="H8141"\w*, \w según|strong="H5921"\w* \w las|strong="H5921"\w* instrucciones \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* fecha fijada. \w Esta|strong="H1961"\w* norma \w es|strong="H1961"\w* obligatoria \w para|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w para|strong="H5921"\w* sus descendientes \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* unan \w a|strong="H3068"\w* \w ellos|strong="H5921"\w*.  
\v 28 \w Estos|strong="H3605"\w* \w días|strong="H3117"\w* deben ser recordados y celebrados por \w todas|strong="H3605"\w* las \w generaciones|strong="H1755"\w*, \w en|strong="H8432"\w* \w cada|strong="H3605"\w* \w familia|strong="H4940"\w*, \w provincia|strong="H4082"\w* y \w ciudad|strong="H5892"\w*. \w La|strong="H3605"\w* fiesta de \w Purim|strong="H6332"\w* \w nunca|strong="H3808"\w* debe dejar de celebrarse \w entre|strong="H8432"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w*, \w ni|strong="H3808"\w* su recuerdo debe borrarse de sus descendientes.   
\p
\v 29 \w La|strong="H3605"\w* \w reina|strong="H4436"\w* Ester, \w hija|strong="H1323"\w* de Abihail, y Mardoqueo \w el|strong="H3605"\w* \w judío|strong="H3064"\w*, \w escribieron|strong="H3789"\w* con \w toda|strong="H3605"\w* autoridad una \w segunda|strong="H8145"\w* carta para confirmar \w lo|strong="H3605"\w* \w que|strong="H1323"\w* se había dicho sobre \w el|strong="H3605"\w* \w Purim|strong="H6332"\w*.  
