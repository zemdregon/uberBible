\mt1 Ester  
\c 1  
\p
\v 1 \w Esto|strong="H1931"\w* \w sucedió|strong="H1961"\w* \w en|strong="H5704"\w* \w el|strong="H1931"\w* \w tiempo|strong="H3117"\w* \w de|strong="H5704"\w* Asuero, \w el|strong="H1931"\w* \w que|strong="H1931"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H1961"\w* \w ciento|strong="H3967"\w* \w veintisiete|strong="H6242"\w* \w provincias|strong="H4082"\w*, \w desde|strong="H5704"\w* \w la|strong="H1931"\w* India \w hasta|strong="H5704"\w* \w Etiopía|strong="H3568"\w*.  
\v 2 \w En|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero gobernaba \w desde|strong="H5921"\w* \w su|strong="H1992"\w* \w trono|strong="H3678"\w* \w real|strong="H4428"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* ciudadela \w de|strong="H5921"\w* Susa.  
\v 3 En \w el|strong="H3605"\w* tercer \w año|strong="H8141"\w* \w de|strong="H6440"\w* su gobierno, \w ofreció|strong="H6213"\w* una gran fiesta para \w todos|strong="H3605"\w* sus funcionarios y servidores. Estaban presentes \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* del \w ejército|strong="H2426"\w* \w de|strong="H6440"\w* \w Persia|strong="H6539"\w* y \w de|strong="H6440"\w* \w Media|strong="H4074"\w*, junto con \w los|strong="H3605"\w* nobles y \w los|strong="H3605"\w* \w gobernadores|strong="H6579"\w* \w de|strong="H6440"\w* las \w provincias|strong="H4082"\w*.  
\v 4 Durante \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w*, unos \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w días|strong="H3117"\w*, el rey hizo ostentación de la enorme riqueza de su \w reino|strong="H4438"\w* \w y|strong="H3519"\w* del \w glorioso|strong="H3519"\w* esplendor de su poder.   
\p
\v 5 \w Cuando|strong="H3117"\w* terminó ese \w tiempo|strong="H3117"\w*, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w ofreció|strong="H6213"\w* \w otra|strong="H6213"\w* fiesta \w de|strong="H5704"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w patio|strong="H2691"\w* del jardín del palacio \w real|strong="H4428"\w*, \w para|strong="H5704"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w que|strong="H5704"\w* \w se|strong="H5971"\w* encontraba \w en|strong="H5704"\w* \w la|strong="H3605"\w* ciudadela \w de|strong="H5704"\w* Susa, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* importante \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* humilde.  
\v 6 \w El|strong="H5921"\w* lugar estaba adornado \w con|strong="H5921"\w* cortinas \w de|strong="H5921"\w* lino \w blanco|strong="H2353"\w* \w y|strong="H5921"\w* azul, colgadas \w con|strong="H5921"\w* cordones \w de|strong="H5921"\w* lino fino \w y|strong="H5921"\w* púrpura \w de|strong="H5921"\w* \w anillos|strong="H1550"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* mármol. Había divanes \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w plata|strong="H3701"\w* \w sobre|strong="H5921"\w* un piso \w de|strong="H5921"\w* mosaicos \w de|strong="H5921"\w* mármol, \w de|strong="H5921"\w* nácar \w y|strong="H5921"\w* \w de|strong="H5921"\w* piedras preciosas.  
\v 7 Se servía la \w bebida|strong="H8248"\w* en \w vasos|strong="H3627"\w* \w de|strong="H8138"\w* \w oro|strong="H2091"\w*, todos \w diferentes|strong="H8138"\w* entre sí, y el \w vino|strong="H3196"\w* \w real|strong="H4428"\w* corría en abundancia, como correspondía \w a|strong="H3068"\w* la generosidad del \w rey|strong="H4428"\w*.  
\v 8 \w Por|strong="H5921"\w* orden \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w nadie|strong="H3605"\w* \w estaba|strong="H1004"\w* \w obligado|strong="H5921"\w* \w a|strong="H3068"\w* beber \w más|strong="H3588"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* cuenta, \w pues|strong="H3588"\w* \w él|strong="H5921"\w* \w había|strong="H3588"\w* instruido \w a|strong="H3068"\w* \w los|strong="H5921"\w* empleados \w de|strong="H5921"\w* \w su|strong="H3588"\w* palacio \w que|strong="H3588"\w* respetaran \w el|strong="H5921"\w* deseo \w de|strong="H5921"\w* \w cada|strong="H3605"\w* invitado.   
\p
\v 9 \w También|strong="H1571"\w* \w la|strong="H1571"\w* \w reina|strong="H4436"\w* Vasti \w ofreció|strong="H6213"\w* un \w banquete|strong="H4960"\w* para las mujeres en \w el|strong="H6213"\w* palacio \w real|strong="H4428"\w* del \w rey|strong="H4428"\w* Asuero.   
\p
\v 10 El \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, \w cuando|strong="H3117"\w* el \w rey|strong="H4428"\w* ya estaba muy \w alegre|strong="H2896"\w* \w por|strong="H6440"\w* el \w vino|strong="H3196"\w*, les ordenó \w a|strong="H3068"\w* Mehumán, Bizta, \w Harbona|strong="H2726"\w*, Bigta, Abagta, Zetar y Carcas, los \w siete|strong="H7651"\w* \w eunucos|strong="H5631"\w* \w que|strong="H3117"\w* estaban \w a|strong="H3068"\w* su servicio,  
\v 11 \w que|strong="H3588"\w* trajeran \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w presencia|strong="H6440"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* Vasti \w con|strong="H3588"\w* \w su|strong="H1931"\w* corona \w real|strong="H4428"\w*. Quería mostrarle \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* funcionarios \w la|strong="H1931"\w* belleza \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w*, \w pues|strong="H3588"\w* \w era|strong="H1931"\w* realmente \w hermosa|strong="H2896"\w*.  
\v 12 Pero cuando los \w eunucos|strong="H5631"\w* le entregaron \w la|strong="H1197"\w* orden del \w rey|strong="H4428"\w*, \w la|strong="H1197"\w* \w reina|strong="H4436"\w* Vasti se negó \w a|strong="H3068"\w* ir. \w Esto|strong="H1697"\w* hizo \w que|strong="H1697"\w* el \w rey|strong="H4428"\w* se pusiera furioso \w y|strong="H1197"\w* estallara en \w ira|strong="H2534"\w*.   
\p
\v 13 \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* consultó \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sabios|strong="H2450"\w* \w que|strong="H3588"\w* \w conocían|strong="H3045"\w* \w de|strong="H3588"\w* leyes \w y|strong="H3588"\w* costumbres (\w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* acostumbraba consultar \w a|strong="H3068"\w* \w los|strong="H3605"\w* expertos \w en|strong="H3588"\w* leyes \w y|strong="H3588"\w* justicia).  
\v 14 Sus consejeros más \w cercanos|strong="H7138"\w* eran \w Carsena|strong="H3771"\w*, Setar, Admata, \w Tarsis|strong="H8659"\w*, Meres, Marsena y \w Memucán|strong="H4462"\w*, \w los|strong="H3427"\w* \w siete|strong="H7651"\w* funcionarios \w de|strong="H6440"\w* \w Persia|strong="H6539"\w* y \w de|strong="H6440"\w* \w Media|strong="H4074"\w* \w que|strong="H7651"\w* tenían acceso directo \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y ocupaban \w los|strong="H3427"\w* cargos más altos del \w reino|strong="H4438"\w*.  
\v 15 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w les|strong="H5921"\w* preguntó: “\w De|strong="H5921"\w* acuerdo \w con|strong="H5921"\w* \w la|strong="H5921"\w* ley, ¿\w qué|strong="H4100"\w* \w se|strong="H5921"\w* debe \w hacer|strong="H6213"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti \w por|strong="H5921"\w* \w no|strong="H3808"\w* \w haber|strong="H3808"\w* \w cumplido|strong="H6213"\w* \w la|strong="H5921"\w* orden \w que|strong="H4100"\w* \w le|strong="H5921"\w* envié \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w eunucos|strong="H5631"\w*?”.   
\p
\v 16 \w Entonces|strong="H3588"\w* \w Memucán|strong="H4462"\w* respondió \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w los|strong="H5921"\w* funcionarios: “\w La|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti \w no|strong="H3808"\w* solo \w ha|strong="H3808"\w* ofendido \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, \w sino|strong="H3588"\w* también \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* funcionarios \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w pueblos|strong="H5971"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero.  
\v 17 \w Porque|strong="H3588"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* mujeres \w se|strong="H5921"\w* enterarán \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* hizo \w la|strong="H5921"\w* \w reina|strong="H4436"\w*, \w y|strong="H3588"\w* \w esto|strong="H1697"\w* hará \w que|strong="H3588"\w* desprecien \w a|strong="H3068"\w* sus esposos. Dirán: “\w El|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero mandó llamar \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w reina|strong="H4436"\w* Vasti, \w y|strong="H3588"\w* \w ella|strong="H5921"\w* \w no|strong="H3808"\w* \w fue|strong="H3808"\w*”.  
\v 18 \w Ese|strong="H2088"\w* \w mismo|strong="H3605"\w* \w día|strong="H3117"\w*, las señoras \w de|strong="H1697"\w* \w la|strong="H3605"\w* nobleza \w de|strong="H1697"\w* \w Persia|strong="H6539"\w* y \w de|strong="H1697"\w* \w Media|strong="H4074"\w* \w que|strong="H1697"\w* sepan \w lo|strong="H1697"\w* \w que|strong="H1697"\w* hizo \w la|strong="H3605"\w* \w reina|strong="H4436"\w* se \w lo|strong="H1697"\w* contarán \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* funcionarios del \w rey|strong="H4428"\w*, y no \w habrá|strong="H3117"\w* fin \w al|strong="H4428"\w* desprecio y \w a|strong="H3068"\w* \w la|strong="H3605"\w* discordia.   
\p
\v 19 “\w Si|strong="H3808"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2896"\w*, emita un decreto \w real|strong="H4428"\w* \w y|strong="H5921"\w* \w que|strong="H4480"\w* \w se|strong="H5921"\w* escriba \w en|strong="H5921"\w* \w las|strong="H5921"\w* leyes \w de|strong="H4480"\w* \w Persia|strong="H6539"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w Media|strong="H4074"\w* \w para|strong="H5921"\w* \w que|strong="H4480"\w* \w no|strong="H3808"\w* pueda ser anulado: \w que|strong="H4480"\w* Vasti \w no|strong="H3808"\w* vuelva \w a|strong="H3068"\w* presentarse \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero. \w También|strong="H3318"\w* \w que|strong="H4480"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* \w entregue|strong="H5414"\w* \w el|strong="H5921"\w* título \w de|strong="H4480"\w* \w reina|strong="H4428"\w* \w a|strong="H3068"\w* otra mujer \w que|strong="H4480"\w* sea \w mejor|strong="H2896"\w* \w que|strong="H4480"\w* \w ella|strong="H4480"\w*.  
\v 20 \w Cuando|strong="H3588"\w* \w el|strong="H1931"\w* decreto \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* promulgue \w se|strong="H1931"\w* \w dé|strong="H3588"\w* \w a|strong="H3068"\w* conocer \w por|strong="H3588"\w* \w todo|strong="H3605"\w* \w su|strong="H1931"\w* \w gran|strong="H1419"\w* \w reino|strong="H4438"\w*, \w todas|strong="H3605"\w* las \w mujeres|strong="H5704"\w* respetarán \w a|strong="H3068"\w* \w sus|strong="H1931"\w* esposos, \w desde|strong="H5704"\w* \w el|strong="H1931"\w* \w más|strong="H3588"\w* importante \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w más|strong="H3588"\w* humilde”.   
\p
\v 21 \w El|strong="H6213"\w* \w consejo|strong="H1697"\w* \w le|strong="H5869"\w* gustó \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* los funcionarios, y \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w Memucán|strong="H4462"\w* propuso.  
\v 22 \w Envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* del \w reino|strong="H4428"\w*, \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w provincia|strong="H4082"\w* en su propia escritura y \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w pueblo|strong="H5971"\w* en su propio idioma, declarando \w que|strong="H5971"\w* \w cada|strong="H3605"\w* hombre \w fuera|strong="H1961"\w* \w la|strong="H3605"\w* autoridad en su propia \w casa|strong="H1004"\w* y \w que|strong="H5971"\w* \w se|strong="H1961"\w* \w hablara|strong="H1696"\w* \w el|strong="H3605"\w* idioma \w de|strong="H5971"\w* su propio \w pueblo|strong="H5971"\w*.   
\c 2  
\p
\v 1 Tiempo \w después|strong="H5921"\w*, cuando \w se|strong="H5921"\w* \w le|strong="H5921"\w* pasó \w el|strong="H5921"\w* \w enojo|strong="H2534"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Asuero, \w se|strong="H5921"\w* acordó \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* Vasti \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w había|strong="H6213"\w* decidido \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 2 Entonces los asistentes personales del \w rey|strong="H4428"\w* le propusieron: “Que se \w busquen|strong="H1245"\w* para el \w rey|strong="H4428"\w* muchachas jóvenes y \w hermosas|strong="H2896"\w*.  
\v 3 Nombre \w el|strong="H3605"\w* \w rey|strong="H4428"\w* delegados en \w todas|strong="H3605"\w* las \w provincias|strong="H4082"\w* \w de|strong="H5414"\w* su \w reino|strong="H4438"\w* \w para|strong="H5414"\w* \w que|strong="H4082"\w* reúnan \w a|strong="H3068"\w* \w todas|strong="H3605"\w* estas jóvenes \w hermosas|strong="H2896"\w* en \w la|strong="H8104"\w* ciudadela \w de|strong="H5414"\w* Susa. \w Que|strong="H4082"\w* las lleven \w al|strong="H4428"\w* pabellón \w de|strong="H5414"\w* las mujeres bajo \w el|strong="H3605"\w* \w cuidado|strong="H3027"\w* \w de|strong="H5414"\w* \w Hegai|strong="H1896"\w*, \w el|strong="H3605"\w* oficial del \w rey|strong="H4428"\w* \w encargado|strong="H6485"\w* \w de|strong="H5414"\w* ellas, y \w que|strong="H4082"\w* se les den sus tratamientos \w de|strong="H5414"\w* belleza.  
\v 4 \w Entonces|strong="H3651"\w*, la joven \w que|strong="H1697"\w* más \w le|strong="H5869"\w* guste \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w será|strong="H6213"\w* la \w reina|strong="H4427"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* Vasti”. \w Al|strong="H4428"\w* \w rey|strong="H4428"\w* \w le|strong="H5869"\w* \w pareció|strong="H5869"\w* una excelente idea, y \w así|strong="H3651"\w* \w lo|strong="H1697"\w* \w hizo|strong="H6213"\w*.   
\p
\v 5 En la ciudadela \w de|strong="H1121"\w* Susa vivía un \w judío|strong="H3064"\w* \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* Benjamín \w que|strong="H1121"\w* \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Mardoqueo. \w Era|strong="H1961"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jair|strong="H2971"\w*, \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Simei y bisnieto \w de|strong="H1121"\w* Quis.  
\v 6 \w Él|strong="H5973"\w* había sido uno \w de|strong="H5973"\w* \w los|strong="H5973"\w* deportados \w de|strong="H5973"\w* Jerusalén que \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w Nabucodonosor|strong="H5019"\w* \w de|strong="H5973"\w* Babilonia se llevó \w junto|strong="H5973"\w* \w con|strong="H5973"\w* Jeconías, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*.  
\v 7 Mardoqueo \w había|strong="H1961"\w* criado \w a|strong="H3068"\w* \w su|strong="H1931"\w* prima Hadasa, \w es|strong="H1931"\w* decir Ester, \w porque|strong="H3588"\w* \w ella|strong="H1931"\w* \w era|strong="H1961"\w* huérfana \w de|strong="H3588"\w* padre \w y|strong="H3588"\w* madre. \w La|strong="H1931"\w* muchacha \w era|strong="H1961"\w* muy atractiva \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w hermosa|strong="H3303"\w* figura. \w Cuando|strong="H3588"\w* \w sus|strong="H1931"\w* padres murieron, Mardoqueo \w la|strong="H1931"\w* adoptó \w como|strong="H3588"\w* \w su|strong="H1931"\w* propia \w hija|strong="H1323"\w*.   
\p
\v 8 \w Cuando|strong="H1961"\w* \w se|strong="H1961"\w* publicó el decreto del \w rey|strong="H4428"\w* y \w muchas|strong="H7227"\w* jóvenes \w fueron|strong="H1961"\w* reunidas en \w la|strong="H8104"\w* ciudadela \w de|strong="H1697"\w* Susa bajo el \w cuidado|strong="H3027"\w* \w de|strong="H1697"\w* \w Hegai|strong="H1896"\w*, también \w llevaron|strong="H3947"\w* \w a|strong="H3068"\w* Ester \w al|strong="H4428"\w* palacio \w real|strong="H4428"\w*, quedando bajo \w la|strong="H8104"\w* custodia \w de|strong="H1697"\w* \w Hegai|strong="H1896"\w*, el encargado \w de|strong="H1697"\w* las mujeres.  
\v 9 Ester \w le|strong="H5869"\w* cayó \w muy|strong="H3190"\w* \w bien|strong="H2896"\w* \w a|strong="H3068"\w* Hegai y se ganó su favor. Él se apresuró \w a|strong="H3068"\w* \w darle|strong="H5414"\w* sus tratamientos \w de|strong="H6440"\w* belleza y su dieta especial; además, \w le|strong="H5869"\w* asignó \w a|strong="H3068"\w* las \w siete|strong="H7651"\w* \w mejores|strong="H2896"\w* muchachas del palacio \w para|strong="H5414"\w* atenderla y la instaló con ellas en el \w mejor|strong="H2896"\w* lugar del pabellón \w de|strong="H6440"\w* las mujeres.  
