\id JON  
\h JONÁS 
\toc3 Jonás 
\toc1 JONÁS 
\toc2 JONÁS 
\mt1 Jonás  
\c 1  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé llegó \w a|strong="H3068"\w* \w Jonás|strong="H3124"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amitai, y le dijo:  
\v 2 “\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* \w ve|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gran|strong="H1419"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w Nínive|strong="H5210"\w*. Predica \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w maldad|strong="H7451"\w* ha llegado \w hasta|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*”.   
\p
\v 3 Pero \w Jonás|strong="H3124"\w* se \w levantó|strong="H6965"\w* \w para|strong="H5414"\w* huir \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé rumbo \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w*. Bajó \w a|strong="H3068"\w* Jope y encontró un barco que salía \w para|strong="H5414"\w* \w allá|strong="H6440"\w*; \w pagó|strong="H5414"\w* su pasaje y subió \w a|strong="H3068"\w* bordo \w para|strong="H5414"\w* irse \w con|strong="H5973"\w* ellos \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w*, \w lejos|strong="H1272"\w* \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.   
\p
\v 4 Pero Yahvé envió un fuerte \w viento|strong="H7307"\w* \w sobre|strong="H1961"\w* el \w mar|strong="H3220"\w*, y \w se|strong="H1961"\w* desató una tormenta tan violenta \w que|strong="H1961"\w* el barco \w estaba|strong="H1961"\w* \w a|strong="H3068"\w* punto de romperse.  
\v 5 \w Los|strong="H5921"\w* marineros tuvieron mucho \w miedo|strong="H3372"\w* \w y|strong="H5921"\w* cada uno empezó \w a|strong="H3068"\w* \w clamar|strong="H2199"\w* \w a|strong="H3068"\w* su dios. \w Para|strong="H5921"\w* aligerar \w el|strong="H5921"\w* barco, arrojaron \w al|strong="H5921"\w* \w mar|strong="H3220"\w* \w la|strong="H5921"\w* carga \w que|strong="H5921"\w* llevaban. Mientras \w tanto|strong="H5921"\w*, \w Jonás|strong="H3124"\w* había bajado \w al|strong="H5921"\w* fondo \w del|strong="H5921"\w* barco, \w se|strong="H5921"\w* había \w acostado|strong="H7901"\w* \w y|strong="H5921"\w* \w estaba|strong="H7901"\w* profundamente dormido.  
\v 6 El \w capitán|strong="H7227"\w* del barco \w se|strong="H3808"\w* le acercó y le dijo: “¡¿\w Qué|strong="H4100"\w* te pasa, \w que|strong="H4100"\w* estás tan dormido?! ¡\w Levántate|strong="H6965"\w* y \w clama|strong="H7121"\w* \w a|strong="H3068"\w* tu Dios! Tal vez \w se|strong="H3808"\w* compadezca de nosotros y \w no|strong="H3808"\w* moriremos”.   
\p
\v 7 Luego \w se|strong="H3045"\w* dijeron unos \w a|strong="H3068"\w* otros: “¡Vengan! \w Vamos|strong="H3212"\w* \w a|strong="H3068"\w* \w echar|strong="H5307"\w* \w suertes|strong="H1486"\w* \w para|strong="H5921"\w* \w saber|strong="H3045"\w* \w quién|strong="H4310"\w* tiene \w la|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w esta|strong="H2063"\w* desgracia \w que|strong="H4310"\w* \w nos|strong="H5921"\w* ha \w caído|strong="H5307"\w*”. \w Echaron|strong="H5307"\w* \w suertes|strong="H1486"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w suerte|strong="H1486"\w* \w cayó|strong="H5307"\w* \w sobre|strong="H5921"\w* \w Jonás|strong="H3124"\w*.  
\v 8 Entonces \w le|strong="H4310"\w* preguntaron: “Dinos \w ahora|strong="H4994"\w*, ¿\w por|strong="H2088"\w* \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* ha venido \w este|strong="H2088"\w* \w mal|strong="H7451"\w*? ¿En \w qué|strong="H4100"\w* trabajas? ¿\w De|strong="H5971"\w* dónde vienes? ¿\w Cuál|strong="H4100"\w* \w es|strong="H2088"\w* tu país y \w de|strong="H5971"\w* \w qué|strong="H4100"\w* \w pueblo|strong="H5971"\w* eres?”.   
\p
\v 9 \w Él|strong="H6213"\w* les contestó: “Soy \w hebreo|strong="H5680"\w* y temo \w a|strong="H3068"\w* Yahvé, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* del \w cielo|strong="H8064"\w*, que \w hizo|strong="H6213"\w* \w el|strong="H6213"\w* \w mar|strong="H3220"\w* y la \w tierra|strong="H3004"\w*”.   
\p
\v 10 Al oír \w esto|strong="H2063"\w*, \w los|strong="H1992"\w* hombres \w se|strong="H3045"\w* aterrorizaron \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijeron: “¡¿\w Pero|strong="H3588"\w* \w qué|strong="H3588"\w* has \w hecho|strong="H6213"\w*?!”. \w Pues|strong="H3588"\w* \w ellos|strong="H1992"\w* ya \w sabían|strong="H3045"\w* \w que|strong="H3588"\w* Jonás \w huía|strong="H1272"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w presencia|strong="H6440"\w* \w de|strong="H3588"\w* Yahvé, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w mismo|strong="H1931"\w* \w se|strong="H3045"\w* \w lo|strong="H1931"\w* \w había|strong="H3588"\w* contado.  
\v 11 \w Como|strong="H4100"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w se|strong="H5921"\w* ponía cada vez \w más|strong="H3588"\w* agitado, \w le|strong="H5921"\w* preguntaron: “¿\w Qué|strong="H3588"\w* debemos \w hacer|strong="H6213"\w* \w contigo|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w se|strong="H5921"\w* \w nos|strong="H5921"\w* calme?”.   
\p
\v 12 \w Él|strong="H5921"\w* \w les|strong="H5921"\w* respondió: “Levántenme \w y|strong="H3588"\w* arrójenme \w al|strong="H5921"\w* \w mar|strong="H3220"\w*. \w Así|strong="H2088"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w se|strong="H3045"\w* calmará, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w por|strong="H5921"\w* \w mi|strong="H5921"\w* culpa \w les|strong="H5921"\w* ha venido \w esta|strong="H2088"\w* \w gran|strong="H1419"\w* tormenta”.   
\p
\v 13 \w A|strong="H3068"\w* pesar \w de|strong="H5921"\w* esto, \w los|strong="H5921"\w* hombres remaron \w con|strong="H5921"\w* todas sus fuerzas \w para|strong="H5921"\w* tratar \w de|strong="H5921"\w* regresar \w a|strong="H3068"\w* \w tierra|strong="H3004"\w*, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w se|strong="H3808"\w* embravecía cada vez \w más|strong="H3588"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 14 \w Entonces|strong="H3588"\w* clamaron \w a|strong="H3068"\w* Yahvé: “¡\w Te|strong="H5921"\w* rogamos, Yahvé, \w que|strong="H3588"\w* \w no|strong="H6213"\w* \w nos|strong="H5921"\w* dejes morir \w por|strong="H5921"\w* quitarle \w la|strong="H5921"\w* \w vida|strong="H5315"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* hombre! \w No|strong="H6213"\w* \w nos|strong="H5921"\w* culpes \w de|strong="H5921"\w* matar \w a|strong="H3068"\w* un \w inocente|strong="H5355"\w*, \w porque|strong="H3588"\w* \w tú|strong="H6213"\w*, Yahvé, \w has|strong="H5414"\w* \w hecho|strong="H6213"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* \w has|strong="H5414"\w* querido”.  
\v 15 Entonces agarraron \w a|strong="H3068"\w* \w Jonás|strong="H3124"\w* y lo lanzaron al \w mar|strong="H3220"\w*, y el \w mar|strong="H3220"\w* calmó su furia.  
\v 16 Al ver esto, los hombres tuvieron un \w gran|strong="H1419"\w* \w temor|strong="H3372"\w* \w de|strong="H3372"\w* Yahvé, le ofrecieron un \w sacrificio|strong="H2077"\w* y le hicieron promesas.   
\p
\v 17 Yahvé dispuso un gran pez para que se tragara \w a|strong="H3068"\w* Jonás, y Jonás estuvo en el vientre del pez tres días y tres noches.   
\c 2  
\p
\v 1 \w Entonces|strong="H3117"\w* \w Jonás|strong="H3124"\w* oró \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w* desde el vientre del \w pez|strong="H1709"\w*,  
\v 2 diciendo:  
\q1 “En mi angustia invoqué \w a|strong="H3068"\w* Yahvé,  
\q2 y él me respondió.  
\q1 Desde lo profundo del sepulcro grité,  
\q2 y tú escuchaste mi voz.   
\q1
\v 3 Me arrojaste \w a|strong="H3068"\w* lo profundo,  
\q2 al corazón de los mares;  
\q1 la corriente me rodeaba.  
\q2 Todas tus ondas y tus olas pasaron sobre \w mí|strong="H6030"\w*.   
\q1
\v 4 Yo dije: ‘He sido arrojado \w de|strong="H5921"\w* tu presencia;  
\q2 pero volveré \w a|strong="H3068"\w* ver tu santo templo’.   
\q1
\v 5 Las aguas me llegaron hasta el cuello,  
\q2 el abismo me rodeó;  
\q1 las algas se enredaron en mi cabeza.   
\q1
\v 6 Bajé \w hasta|strong="H5704"\w* la base \w de|strong="H5704"\w* las montañas;  
\q2 la tierra echó sus cerrojos sobre \w mí|strong="H5315"\w* \w para|strong="H5704"\w* siempre.  
\q2 Pero tú, Yahvé \w mi|strong="H5315"\w* Dios, rescataste \w mi|strong="H5315"\w* \w vida|strong="H5315"\w* del hoyo.   
\b  
\q1
\v 7 “Cuando me quedaba sin fuerzas, me acordé de Yahvé;  
\q2 mi oración \w llegó|strong="H5927"\w* \w a|strong="H3068"\w* ti, \w a|strong="H3068"\w* tu santo templo.   
\q1
\v 8 \w Los|strong="H5921"\w* \w que|strong="H5921"\w* adoran ídolos inútiles  
\q2 abandonan \w el|strong="H5921"\w* amor fiel \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*.   
\q1
\v 9 Pero yo, con cantos de gratitud, te ofreceré sacrificios.  
\q2 Cumpliré lo que te prometí.  
\q1 ¡\w La|strong="H8104"\w* salvación viene de Yahvé!”.   
\p
\v 10 Entonces Yahvé le dio una orden al pez, y el pez vomitó \w a|strong="H3068"\w* Jonás en tierra firme.   
\c 3  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jonás|strong="H3124"\w* \w por|strong="H1697"\w* \w segunda|strong="H8145"\w* vez, y le dijo:  
\v 2 “\w Levántate|strong="H6965"\w*, \w ve|strong="H3212"\w* \w a|strong="H3068"\w* la \w gran|strong="H1419"\w* \w ciudad|strong="H5892"\w* de \w Nínive|strong="H5210"\w* y anúnciale el mensaje que yo te daré”.   
\p
\v 3 \w Jonás|strong="H3124"\w* \w se|strong="H1961"\w* \w levantó|strong="H6965"\w* y \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* \w Nínive|strong="H5210"\w*, \w tal|strong="H1697"\w* \w como|strong="H1961"\w* Yahvé \w se|strong="H1961"\w* \w lo|strong="H1697"\w* \w había|strong="H1961"\w* \w ordenado|strong="H1961"\w*. \w Nínive|strong="H5210"\w* \w era|strong="H1961"\w* una \w ciudad|strong="H5892"\w* enorme; \w se|strong="H1961"\w* necesitaban \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w para|strong="H1961"\w* recorrerla toda.  
\v 4 \w Jonás|strong="H3124"\w* \w comenzó|strong="H2490"\w* \w a|strong="H3068"\w* entrar \w en|strong="H5750"\w* la \w ciudad|strong="H5892"\w* y, después \w de|strong="H5750"\w* caminar todo un \w día|strong="H3117"\w*, gritaba: “¡\w Dentro|strong="H5750"\w* \w de|strong="H5750"\w* cuarenta \w días|strong="H3117"\w* \w Nínive|strong="H5210"\w* será destruida!”.   
\p
\v 5 La gente \w de|strong="H5704"\w* \w Nínive|strong="H5210"\w* le creyó \w a|strong="H3068"\w* Dios, \w por|strong="H5704"\w* \w lo|strong="H5704"\w* \w que|strong="H5704"\w* anunciaron un \w ayuno|strong="H6685"\w* \w y|strong="H5704"\w*, \w desde|strong="H5704"\w* el \w más|strong="H5704"\w* importante \w hasta|strong="H5704"\w* el \w más|strong="H5704"\w* humilde, se vistieron \w de|strong="H5704"\w* cilicio \w en|strong="H5704"\w* señal \w de|strong="H5704"\w* arrepentimiento.  
\v 6 Cuando \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Nínive|strong="H5210"\w* \w se|strong="H5921"\w* enteró \w de|strong="H5921"\w* \w la|strong="H5921"\w* noticia, \w se|strong="H5921"\w* \w levantó|strong="H6965"\w* \w de|strong="H5921"\w* su \w trono|strong="H3678"\w*, \w se|strong="H5921"\w* quitó su manto \w real|strong="H4428"\w*, \w se|strong="H5921"\w* puso ropa \w de|strong="H5921"\w* luto \w y|strong="H5921"\w* \w se|strong="H5921"\w* sentó \w en|strong="H5921"\w* \w la|strong="H5921"\w* ceniza.  
\v 7 Luego mandó proclamar en \w Nínive|strong="H5210"\w* este decreto \w del|strong="H8354"\w* \w rey|strong="H4428"\w* \w y|strong="H1241"\w* \w de|strong="H4325"\w* sus consejeros: “Ninguna persona ni animal, ni el \w ganado|strong="H6629"\w* \w mayor|strong="H1419"\w* ni el menor, debe probar bocado. No se \w les|strong="H3972"\w* debe dar \w de|strong="H4325"\w* comer ni \w de|strong="H4325"\w* \w beber|strong="H8354"\w*.  
\v 8 \w Al|strong="H4480"\w* contrario, \w que|strong="H4480"\w* todos, hombres y animales, \w se|strong="H4480"\w* cubran \w de|strong="H4480"\w* cilicio y clamen \w a|strong="H3068"\w* Dios \w con|strong="H4480"\w* todas sus fuerzas. \w Que|strong="H4480"\w* cada uno \w se|strong="H4480"\w* arrepienta \w de|strong="H4480"\w* su \w mala|strong="H7451"\w* conducta y deje \w de|strong="H4480"\w* cometer actos violentos.  
\v 9 ¡\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w*! Tal vez Dios cambie de parecer, \w se|strong="H3045"\w* arrepienta y calme su terrible enojo, para \w que|strong="H4310"\w* \w no|strong="H3808"\w* muramos”.   
\p
\v 10 \w Cuando|strong="H3588"\w* Dios \w vio|strong="H7200"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w hicieron|strong="H6213"\w* \w y|strong="H3588"\w* \w cómo|strong="H3588"\w* \w se|strong="H5921"\w* apartaron \w de|strong="H5921"\w* \w su|strong="H1992"\w* \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*, cambió \w de|strong="H5921"\w* parecer respecto \w al|strong="H5921"\w* \w castigo|strong="H7451"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* amenazado \w con|strong="H5921"\w* enviarles, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* destruyó.   
\c 4  
\p
\v 1 Pero \w Jonás|strong="H3124"\w* se disgustó \w mucho|strong="H1419"\w* por esto y se puso muy furioso.  
\v 2 \w Así|strong="H3651"\w* \w que|strong="H3588"\w* \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé \w y|strong="H3588"\w* \w le|strong="H5921"\w* dijo: “¡Ay, Yahvé! ¿\w No|strong="H3808"\w* \w fue|strong="H1961"\w* \w esto|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* dije \w cuando|strong="H3588"\w* todavía \w estaba|strong="H1961"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* país? \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w me|strong="H5921"\w* apresuré \w a|strong="H3068"\w* huir \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w sabía|strong="H3045"\w* \w que|strong="H3588"\w* \w eres|strong="H1961"\w* un \w Dios|strong="H3068"\w* tierno \w y|strong="H3588"\w* compasivo, \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* enoja fácilmente, \w que|strong="H3588"\w* \w es|strong="H1961"\w* todo amor \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w siempre|strong="H5921"\w* \w está|strong="H2088"\w* dispuesto \w a|strong="H3068"\w* \w no|strong="H3808"\w* enviar \w el|strong="H5921"\w* \w castigo|strong="H7451"\w* anunciado.  
\v 3 \w Por|strong="H3588"\w* eso \w ahora|strong="H6258"\w*, Yahvé, \w te|strong="H4480"\w* \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* \w me|strong="H4480"\w* \w quites|strong="H3947"\w* \w la|strong="H3588"\w* \w vida|strong="H5315"\w*. ¡\w Es|strong="H3588"\w* \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w mí|strong="H4994"\w* morir \w que|strong="H3588"\w* seguir \w viviendo|strong="H2416"\w*!”.   
\p
\v 4 Yahvé le respondió: “¿Te parece \w bien|strong="H3190"\w* enojarte así?”.   
\p
\v 5 \w Jonás|strong="H3124"\w* \w salió|strong="H3318"\w* \w de|strong="H4480"\w* la \w ciudad|strong="H5892"\w* \w y|strong="H5704"\w* \w se|strong="H1961"\w* sentó \w al|strong="H4480"\w* \w oriente|strong="H6924"\w* \w de|strong="H4480"\w* \w ella|strong="H8033"\w*. \w Allí|strong="H8033"\w* \w se|strong="H1961"\w* \w hizo|strong="H6213"\w* una enramada \w y|strong="H5704"\w* \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w sentado|strong="H3427"\w* \w a|strong="H3068"\w* su \w sombra|strong="H6738"\w*, esperando \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w qué|strong="H4100"\w* le pasaba \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w*.  
\v 6 \w Dios|strong="H3068"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* dispuso \w que|strong="H5921"\w* una planta creciera \w sobre|strong="H5921"\w* \w Jonás|strong="H3124"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* diera \w sombra|strong="H6738"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* hiciera sentir mejor. \w Jonás|strong="H3124"\w* \w estaba|strong="H1961"\w* muy contento \w con|strong="H5921"\w* \w la|strong="H5921"\w* planta.  
\v 7 Pero al amanecer del día \w siguiente|strong="H4283"\w*, Dios mandó un \w gusano|strong="H8438"\w*, el cual atacó la planta y esta se \w secó|strong="H3001"\w*.  
\v 8 \w Cuando|strong="H1961"\w* \w salió|strong="H2224"\w* \w el|strong="H5921"\w* \w sol|strong="H8121"\w*, Dios envió un \w viento|strong="H7307"\w* abrasador \w del|strong="H5921"\w* \w este|strong="H1961"\w*; \w el|strong="H5921"\w* \w sol|strong="H8121"\w* golpeó \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w Jonás|strong="H3124"\w* \w con|strong="H5921"\w* tanta fuerza \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w se|strong="H1961"\w* sintió desfallecer \w y|strong="H5921"\w* quiso morirse. Dijo: “¡\w Es|strong="H1961"\w* \w mejor|strong="H2896"\w* \w para|strong="H5921"\w* \w mí|strong="H5921"\w* \w morir|strong="H4191"\w* \w que|strong="H5921"\w* vivir!”.   
\p
\v 9 Pero Dios \w le|strong="H5921"\w* preguntó \w a|strong="H3068"\w* \w Jonás|strong="H3124"\w*: “¿\w Te|strong="H5921"\w* parece \w bien|strong="H3190"\w* enojarte \w por|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* pasó \w a|strong="H3068"\w* \w la|strong="H5921"\w* planta?”. \w Y|strong="H3068"\w* \w Jonás|strong="H3124"\w* respondió: “¡Claro \w que|strong="H5921"\w* \w sí|strong="H5921"\w*! ¡Estoy tan \w enojado|strong="H2734"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* quiero morir!”.   
\p
\v 10 Entonces Yahvé \w le|strong="H5921"\w* dijo: “Tú \w te|strong="H5921"\w* preocupaste \w por|strong="H5921"\w* una planta \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* hiciste \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* \w la|strong="H5921"\w* hiciste crecer; \w nació|strong="H1961"\w* \w en|strong="H5921"\w* una \w noche|strong="H3915"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* otra \w noche|strong="H3915"\w* murió.  
\v 11 ¿\w Y|strong="H3068"\w* \w no|strong="H3808"\w* debería yo preocuparme \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w gran|strong="H1419"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w Nínive|strong="H5210"\w*, \w donde|strong="H5921"\w* \w hay|strong="H3426"\w* \w más|strong="H5921"\w* \w de|strong="H5921"\w* ciento \w veinte|strong="H8147"\w* mil personas \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w saben|strong="H3045"\w* distinguir \w el|strong="H5921"\w* bien \w del|strong="H5921"\w* mal, \w y|strong="H5921"\w* \w donde|strong="H5921"\w* también \w hay|strong="H3426"\w* \w muchos|strong="H7227"\w* animales?”.   