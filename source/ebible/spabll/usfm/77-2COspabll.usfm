\c 12  
\p
\v 1 \w Es|strong="G3756"\w* \w verdad|strong="G3303"\w* \w que|strong="G1519"\w* jactarse \w no|strong="G3756"\w* sirve \w de|strong="G1519"\w* \w nada|strong="G3756"\w*; \w pero|strong="G1161"\w* hablaré \w de|strong="G1519"\w* las visiones \w y|strong="G2532"\w* revelaciones \w del|strong="G1519"\w* \w Señor|strong="G2962"\w*.  
\v 2 \w Conozco|strong="G1492"\w* \w a|strong="G1722"\w* \w un|strong="G3588"\w* hombre \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w que|strong="G3588"\w* hace \w catorce|strong="G1180"\w* \w años|strong="G2094"\w* fue arrebatado \w hasta|strong="G2193"\w* \w el|strong="G3588"\w* \w tercer|strong="G5154"\w* \w cielo|strong="G3772"\w*. \w Si|strong="G1535"\w* fue \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w cuerpo|strong="G4983"\w* \w o|strong="G1535"\w* \w fuera|strong="G1622"\w* \w del|strong="G3588"\w* \w cuerpo|strong="G4983"\w*, \w no|strong="G3756"\w* \w lo|strong="G3588"\w* \w sé|strong="G1492"\w*; solo \w Dios|strong="G2316"\w* \w lo|strong="G3588"\w* \w sabe|strong="G1492"\w*.  
\v 3 \w Y|strong="G2532"\w* \w sé|strong="G1492"\w* \w que|strong="G3588"\w* \w este|strong="G3588"\w* hombre (\w si|strong="G1535"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w cuerpo|strong="G4983"\w* \w o|strong="G1535"\w* \w aparte|strong="G5565"\w* \w del|strong="G3588"\w* \w cuerpo|strong="G4983"\w*, \w no|strong="G3756"\w* \w lo|strong="G3588"\w* \w sé|strong="G1492"\w*, \w Dios|strong="G2316"\w* \w lo|strong="G3588"\w* \w sabe|strong="G1492"\w*)  
\v 4 fue arrebatado \w al|strong="G3588"\w* \w paraíso|strong="G3857"\w* \w y|strong="G2532"\w* escuchó \w cosas|strong="G4487"\w* indecibles \w que|strong="G3754"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* humanos \w no|strong="G3756"\w* \w se|strong="G2532"\w* \w les|strong="G1519"\w* permite expresar.  
\v 5 \w De|strong="G1722"\w* alguien \w así|strong="G1161"\w* podría jactarme, \w pero|strong="G1161"\w* \w de|strong="G1722"\w* \w mí|strong="G1683"\w* \w mismo|strong="G1683"\w* \w no|strong="G3756"\w* \w me|strong="G1683"\w* jactaré \w sino|strong="G1487"\w* \w de|strong="G1722"\w* mis debilidades.  
