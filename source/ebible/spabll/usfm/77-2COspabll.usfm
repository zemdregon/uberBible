\v 15 \w Por|strong="G2596"\w* \w lo|strong="G3588"\w* \w tanto|strong="G3739"\w*, \w no|strong="G3756"\w* \w es|strong="G1487"\w* sorprendente \w que|strong="G3588"\w* \w sus|strong="G3588"\w* servidores \w también|strong="G2532"\w* \w se|strong="G2532"\w* disfracen \w de|strong="G2596"\w* servidores \w de|strong="G2596"\w* \w la|strong="G3588"\w* \w justicia|strong="G1343"\w*. \w Su|strong="G3588"\w* \w fin|strong="G5056"\w* será \w el|strong="G3588"\w* \w que|strong="G3588"\w* merecen \w sus|strong="G3588"\w* acciones.   
\p
\v 16 \w Lo|strong="G5101"\w* repito: \w que|strong="G5101"\w* \w nadie|strong="G3361"\w* piense \w que|strong="G5101"\w* \w estoy|strong="G1510"\w* loco. \w Pero|strong="G1161"\w* \w si|strong="G1487"\w* \w lo|strong="G5101"\w* \w piensan|strong="G1380"\w*, acéptenme \w como|strong="G5613"\w* \w a|strong="G2443"\w* \w un|strong="G5100"\w* loco, \w para|strong="G2443"\w* \w que|strong="G5101"\w* \w yo|strong="G1473"\w* \w también|strong="G1161"\w* pueda jactarme \w un|strong="G5100"\w* poco.  
\v 17 \w Al|strong="G3588"\w* \w decir|strong="G2980"\w* \w esto|strong="G3778"\w*, \w no|strong="G3756"\w* \w hablo|strong="G2980"\w* \w como|strong="G5613"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* mandaría, sino \w como|strong="G5613"\w* \w un|strong="G3588"\w* loco, \w con|strong="G1722"\w* \w la|strong="G3588"\w* \w confianza|strong="G5287"\w* \w de|strong="G1722"\w* tener \w de|strong="G1722"\w* \w qué|strong="G3588"\w* enorgullecerme.  
\v 18 Ya \w que|strong="G2596"\w* \w muchos|strong="G4183"\w* se jactan \w de|strong="G2596"\w* sus logros humanos, \w yo|strong="G2504"\w* \w también|strong="G2504"\w* lo haré.  
\v 19 Ustedes, \w que|strong="G3588"\w* \w son|strong="G1510"\w* tan \w sabios|strong="G5429"\w*, ¡toleran \w con|strong="G1063"\w* gusto a \w los|strong="G3588"\w* locos!  
