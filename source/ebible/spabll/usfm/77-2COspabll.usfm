\v 3 \w Pero|strong="G1161"\w* \w si|strong="G1487"\w* \w nuestro|strong="G2249"\w* \w evangelio|strong="G2098"\w* \w está|strong="G3588"\w* \w encubierto|strong="G2572"\w*, \w lo|strong="G3588"\w* \w está|strong="G3588"\w* \w para|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* pierden.  
\v 4 \w El|strong="G3588"\w* \w dios|strong="G2316"\w* \w de|strong="G1722"\w* \w este|strong="G3778"\w* mundo ha cegado \w la|strong="G3588"\w* mente \w de|strong="G1722"\w* \w estos|strong="G3778"\w* incrédulos, \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w no|strong="G3361"\w* vean \w la|strong="G3588"\w* luz \w del|strong="G3588"\w* \w glorioso|strong="G1391"\w* \w evangelio|strong="G2098"\w* \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*, \w el|strong="G3588"\w* \w cual|strong="G3739"\w* \w es|strong="G3739"\w* \w la|strong="G3588"\w* \w imagen|strong="G1504"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*.  
