\v 10 \w Siempre|strong="G3842"\w* llevamos \w en|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w cuerpo|strong="G4983"\w* \w la|strong="G3588"\w* \w muerte|strong="G3500"\w* \w de|strong="G1722"\w* \w Jesús|strong="G2424"\w*, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w también|strong="G2532"\w* \w su|strong="G3588"\w* \w vida|strong="G2222"\w* \w se|strong="G2532"\w* \w manifieste|strong="G5319"\w* \w en|strong="G1722"\w* \w nosotros|strong="G2249"\w*.  
\v 11 \w Pues|strong="G1063"\w* \w a|strong="G1519"\w* \w nosotros|strong="G2249"\w*, \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w vivimos|strong="G2198"\w*, \w siempre|strong="G3588"\w* \w se|strong="G2532"\w* nos \w entrega|strong="G3860"\w* \w a|strong="G1519"\w* \w la|strong="G3588"\w* \w muerte|strong="G2288"\w* \w por|strong="G1223"\w* \w causa|strong="G1223"\w* \w de|strong="G1722"\w* \w Jesús|strong="G2424"\w*, \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w también|strong="G2532"\w* \w su|strong="G3588"\w* \w vida|strong="G2222"\w* \w se|strong="G2532"\w* \w manifieste|strong="G5319"\w* \w en|strong="G1722"\w* \w nuestro|strong="G2249"\w* cuerpo \w mortal|strong="G2349"\w*.  
