\v 25 \w Tres|strong="G5151"\w* veces \w me|strong="G1722"\w* golpearon \w con|strong="G1722"\w* varas, \w una|strong="G3588"\w* vez \w me|strong="G1722"\w* apedrearon, \w tres|strong="G5151"\w* veces naufragué, y pasé \w un|strong="G3588"\w* \w día|strong="G1722"\w* y \w una|strong="G3588"\w* \w noche|strong="G1722"\w* \w a|strong="G1722"\w* \w la|strong="G3588"\w* deriva \w en|strong="G1722"\w* alta mar.  
\v 26 He estado \w en|strong="G1722"\w* continuos viajes; enfrentando \w peligros|strong="G2794"\w* \w en|strong="G1722"\w* \w ríos|strong="G4215"\w*, \w peligros|strong="G2794"\w* \w de|strong="G1537"\w* asaltantes, \w peligros|strong="G2794"\w* \w de|strong="G1537"\w* parte \w de|strong="G1537"\w* mis compatriotas, \w peligros|strong="G2794"\w* \w de|strong="G1537"\w* los gentiles, \w peligros|strong="G2794"\w* \w en|strong="G1722"\w* \w la|strong="G1537"\w* \w ciudad|strong="G4172"\w*, \w peligros|strong="G2794"\w* \w en|strong="G1722"\w* \w el|strong="G1537"\w* campo, \w peligros|strong="G2794"\w* \w en|strong="G1722"\w* \w el|strong="G1537"\w* \w mar|strong="G2281"\w* y \w peligros|strong="G2794"\w* \w de|strong="G1537"\w* falsos hermanos.  
\v 27 He pasado \w trabajos|strong="G2873"\w* \w y|strong="G2532"\w* fatigas, \w muchas|strong="G4178"\w* noches \w sin|strong="G2532"\w* dormir, \w hambre|strong="G3042"\w* \w y|strong="G2532"\w* \w sed|strong="G1373"\w*, \w muchos|strong="G4178"\w* días \w sin|strong="G2532"\w* comer, \w frío|strong="G5592"\w* \w y|strong="G2532"\w* \w desnudez|strong="G1132"\w*.   
\p
