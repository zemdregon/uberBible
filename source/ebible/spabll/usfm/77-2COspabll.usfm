\v 5 \w Pues|strong="G2532"\w* \w así|strong="G3779"\w* \w como|strong="G2531"\w* participamos abundantemente \w en|strong="G1519"\w* \w los|strong="G3588"\w* sufrimientos \w de|strong="G1519"\w* \w Cristo|strong="G5547"\w*, \w así|strong="G3779"\w* \w también|strong="G2532"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1519"\w* \w él|strong="G3588"\w* tenemos abundante \w consuelo|strong="G3874"\w*.  
\v 6 \w Si|strong="G1535"\w* somos afligidos, \w es|strong="G3739"\w* \w para|strong="G1722"\w* \w el|strong="G3588"\w* \w consuelo|strong="G3874"\w* \w y|strong="G2532"\w* \w la|strong="G3588"\w* \w salvación|strong="G4991"\w* \w de|strong="G1722"\w* ustedes. \w Y|strong="G2532"\w* \w si|strong="G1535"\w* somos consolados, \w es|strong="G3739"\w* \w para|strong="G1722"\w* \w el|strong="G3588"\w* \w consuelo|strong="G3874"\w* \w de|strong="G1722"\w* ustedes, \w el|strong="G3588"\w* \w cual|strong="G3739"\w* les ayuda \w a|strong="G1722"\w* soportar \w con|strong="G1722"\w* \w paciencia|strong="G5281"\w* \w los|strong="G3588"\w* mismos sufrimientos \w que|strong="G3588"\w* \w nosotros|strong="G2249"\w* \w padecemos|strong="G3958"\w*.  
\v 7 \w Nuestra|strong="G3588"\w* \w esperanza|strong="G1680"\w* respecto \w a|strong="G5613"\w* ustedes es firme, \w porque|strong="G3754"\w* \w sabemos|strong="G1492"\w* \w que|strong="G3754"\w* \w así|strong="G3779"\w* \w como|strong="G5613"\w* participan \w de|strong="G5228"\w* nuestros sufrimientos, \w también|strong="G2532"\w* participan \w de|strong="G5228"\w* \w nuestro|strong="G3588"\w* \w consuelo|strong="G3874"\w*.   
\p
\v 8 Hermanos, \w no|strong="G3756"\w* \w queremos|strong="G2309"\w* \w que|strong="G3754"\w* ignoren \w las|strong="G3588"\w* \w aflicciones|strong="G2347"\w* \w que|strong="G3754"\w* sufrimos \w en|strong="G1722"\w* \w la|strong="G3588"\w* provincia \w de|strong="G1722"\w* Asia. Estábamos tan agobiados bajo tanta presión, \w mucho|strong="G3756"\w* \w más|strong="G2532"\w* allá \w de|strong="G1722"\w* nuestras fuerzas, \w que|strong="G3754"\w* hasta perdimos \w la|strong="G3588"\w* esperanza \w de|strong="G1722"\w* salir \w con|strong="G1722"\w* \w vida|strong="G2198"\w*.  
\v 9 \w De|strong="G1722"\w* hecho, sentíamos \w que|strong="G3588"\w* teníamos \w la|strong="G3588"\w* sentencia \w de|strong="G1722"\w* \w muerte|strong="G2288"\w* \w encima|strong="G1909"\w*, \w para|strong="G2443"\w* \w que|strong="G3588"\w* aprendiéramos \w a|strong="G1909"\w* \w no|strong="G3361"\w* confiar \w en|strong="G1722"\w* \w nosotros|strong="G1438"\w* mismos, \w sino|strong="G3361"\w* \w en|strong="G1722"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* resucita \w a|strong="G1909"\w* \w los|strong="G3588"\w* \w muertos|strong="G3498"\w*.  
\v 10 \w Él|strong="G3739"\w* nos \w libró|strong="G4506"\w* \w y|strong="G2532"\w* nos \w librará|strong="G4506"\w* \w de|strong="G1537"\w* un peligro \w de|strong="G1537"\w* \w muerte|strong="G2288"\w* tan terrible, \w y|strong="G2532"\w* \w en|strong="G1519"\w* \w él|strong="G3739"\w* hemos puesto nuestra \w esperanza|strong="G1679"\w* \w de|strong="G1537"\w* \w que|strong="G3754"\w* seguirá librándonos,  
