\v 6 \w Porque|strong="G3754"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3754"\w* ordenó \w que|strong="G3754"\w* \w la|strong="G3588"\w* \w luz|strong="G5457"\w* brillara \w en|strong="G1722"\w* \w las|strong="G3588"\w* \w tinieblas|strong="G4655"\w*, hizo brillar \w su|strong="G3588"\w* \w luz|strong="G5457"\w* \w en|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w corazón|strong="G2588"\w* \w para|strong="G4314"\w* \w que|strong="G3754"\w* conociéramos \w la|strong="G3588"\w* \w gloria|strong="G1391"\w* \w de|strong="G1537"\w* \w Dios|strong="G2316"\w* \w que|strong="G3754"\w* \w resplandece|strong="G2989"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w rostro|strong="G4383"\w* \w de|strong="G1537"\w* \w Cristo|strong="G5547"\w*.   
\p
\v 7 \w Pero|strong="G1161"\w* \w tenemos|strong="G2192"\w* \w este|strong="G3778"\w* \w tesoro|strong="G2344"\w* \w en|strong="G1722"\w* vasijas \w de|strong="G1537"\w* barro \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* vea \w que|strong="G3588"\w* \w este|strong="G3778"\w* \w poder|strong="G1411"\w* incomparable proviene \w de|strong="G1537"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w no|strong="G3361"\w* \w de|strong="G1537"\w* \w nosotros|strong="G2249"\w*.  
\v 8 Nos vemos oprimidos \w por|strong="G1722"\w* \w todos|strong="G3956"\w* lados, pero \w no|strong="G3756"\w* aplastados; perplejos, pero \w no|strong="G3756"\w* desesperados;  
