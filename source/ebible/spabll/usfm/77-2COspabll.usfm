\v 3 \w Pero|strong="G1161"\w* \w me|strong="G1519"\w* \w temo|strong="G5399"\w* \w que|strong="G3588"\w*, \w así|strong="G2532"\w* \w como|strong="G5613"\w* \w la|strong="G3588"\w* \w serpiente|strong="G3789"\w* \w engañó|strong="G1818"\w* \w a|strong="G1519"\w* \w Eva|strong="G2096"\w* \w con|strong="G1722"\w* \w su|strong="G3588"\w* \w astucia|strong="G3834"\w*, \w la|strong="G3588"\w* mente \w de|strong="G1722"\w* ustedes \w se|strong="G2532"\w* corrompa \w y|strong="G2532"\w* \w se|strong="G2532"\w* desvíe \w de|strong="G1722"\w* \w la|strong="G3588"\w* sincera \w y|strong="G2532"\w* pura devoción \w a|strong="G1519"\w* \w Cristo|strong="G5547"\w*.  
\v 4 \w Porque|strong="G1063"\w* \w si|strong="G1487"\w* alguien llega \w predicando|strong="G2784"\w* a \w un|strong="G3588"\w* \w Jesús|strong="G2424"\w* diferente \w del|strong="G3588"\w* \w que|strong="G3588"\w* nosotros \w predicamos|strong="G2784"\w*, \w o|strong="G2228"\w* \w si|strong="G1487"\w* \w reciben|strong="G1209"\w* \w un|strong="G3588"\w* \w espíritu|strong="G4151"\w* distinto \w del|strong="G3588"\w* \w que|strong="G3588"\w* ya \w recibieron|strong="G2983"\w*, \w o|strong="G2228"\w* \w un|strong="G3588"\w* \w evangelio|strong="G2098"\w* diferente \w del|strong="G3588"\w* \w que|strong="G3588"\w* aceptaron, ustedes \w lo|strong="G3588"\w* toleran \w con|strong="G3739"\w* mucha facilidad.  
\v 5 \w Pero|strong="G1063"\w* considero \w que|strong="G3588"\w* \w en|strong="G3588"\w* \w nada|strong="G3367"\w* soy inferior a esos superapóstoles.  
