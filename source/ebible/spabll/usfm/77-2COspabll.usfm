\v 15 ¡\w Gracias|strong="G5485"\w* \w a|strong="G1909"\w* \w Dios|strong="G2316"\w* \w por|strong="G1909"\w* \w su|strong="G3588"\w* \w don|strong="G1431"\w* tan maravilloso \w que|strong="G3588"\w* no se puede expresar \w con|strong="G1909"\w* palabras!   
\c 10  
\p
\v 1 \w Ahora|strong="G1161"\w* \w bien|strong="G1161"\w*, \w yo|strong="G1473"\w* mismo, \w Pablo|strong="G3972"\w*, \w les|strong="G1519"\w* \w ruego|strong="G3870"\w* \w por|strong="G1223"\w* \w la|strong="G3588"\w* humildad \w y|strong="G2532"\w* ternura \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*, \w yo|strong="G1473"\w* \w que|strong="G3588"\w* \w en|strong="G1722"\w* \w persona|strong="G4383"\w* parezco \w humilde|strong="G5011"\w* \w entre|strong="G1722"\w* ustedes, \w pero|strong="G1161"\w* \w que|strong="G3588"\w* \w a|strong="G1519"\w* \w la|strong="G3588"\w* distancia soy atrevido.  
