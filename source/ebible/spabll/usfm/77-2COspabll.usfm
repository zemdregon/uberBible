\p
\v 12 \w Nuestro|strong="G2249"\w* motivo \w de|strong="G1722"\w* orgullo \w es|strong="G3756"\w* \w este|strong="G3778"\w*: \w el|strong="G3588"\w* \w testimonio|strong="G3142"\w* \w de|strong="G1722"\w* \w nuestra|strong="G3588"\w* \w conciencia|strong="G4893"\w* \w de|strong="G1722"\w* \w que|strong="G3754"\w* \w nos|strong="G2316"\w* hemos comportado \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w mundo|strong="G2889"\w*, \w y|strong="G2532"\w* especialmente \w con|strong="G1722"\w* ustedes, \w con|strong="G1722"\w* \w la|strong="G3588"\w* santidad \w y|strong="G2532"\w* \w sinceridad|strong="G1505"\w* \w que|strong="G3754"\w* vienen \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*. \w Nuestra|strong="G3588"\w* conducta \w no|strong="G3756"\w* \w se|strong="G4314"\w* ha basado \w en|strong="G1722"\w* \w la|strong="G3588"\w* \w sabiduría|strong="G4678"\w* humana, \w sino|strong="G1161"\w* \w en|strong="G1722"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*.  
\v 13 \w Porque|strong="G1063"\w* \w no|strong="G3756"\w* les \w escribimos|strong="G1125"\w* \w nada|strong="G3756"\w* \w que|strong="G3754"\w* \w no|strong="G3756"\w* puedan leer \w y|strong="G2532"\w* \w entender|strong="G1921"\w*. \w Y|strong="G2532"\w* \w espero|strong="G1679"\w* \w que|strong="G3754"\w* lleguen \w a|strong="G2193"\w* comprender plenamente,  
\v 14 \w así|strong="G2532"\w* \w como|strong="G2531"\w* \w ya|strong="G2532"\w* nos han \w entendido|strong="G1921"\w* \w en|strong="G1722"\w* \w parte|strong="G3313"\w*, \w que|strong="G3754"\w* \w nosotros|strong="G2249"\w* somos \w el|strong="G3588"\w* orgullo \w de|strong="G1722"\w* ustedes, \w de|strong="G1722"\w* \w la|strong="G3588"\w* misma manera \w que|strong="G3754"\w* ustedes \w son|strong="G1510"\w* \w el|strong="G3588"\w* \w nuestro|strong="G2249"\w* \w para|strong="G1722"\w* \w el|strong="G3588"\w* \w día|strong="G2250"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w*.   
\p
\v 15 \w Con|strong="G4314"\w* \w esta|strong="G3778"\w* \w confianza|strong="G4006"\w*, había planeado visitarlos \w primero|strong="G4386"\w* \w a|strong="G4314"\w* ustedes \w para|strong="G2443"\w* \w que|strong="G3588"\w* recibieran \w una|strong="G3588"\w* doble bendición,  
\v 16 \w y|strong="G2532"\w* desde allí \w pasar|strong="G1330"\w* \w a|strong="G1519"\w* \w Macedonia|strong="G3109"\w*. Luego, desde \w Macedonia|strong="G3109"\w*, pensaba \w volver|strong="G3825"\w* \w a|strong="G1519"\w* ustedes \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w me|strong="G4314"\w* ayudaran \w a|strong="G1519"\w* seguir \w mi|strong="G3588"\w* viaje \w hacia|strong="G4314"\w* \w Judea|strong="G2449"\w*.  
\v 17 \w Al|strong="G3588"\w* planear \w esto|strong="G3778"\w*, ¿\w acaso|strong="G2228"\w* \w lo|strong="G3588"\w* hice \w a|strong="G3844"\w* \w la|strong="G3588"\w* ligera? \w O|strong="G2228"\w*, \w cuando|strong="G2443"\w* \w hago|strong="G1473"\w* planes, ¿\w los|strong="G3588"\w* \w hago|strong="G1473"\w* \w por|strong="G2596"\w* motivos egoístas, diciendo “\w Sí|strong="G3483"\w*, \w sí|strong="G3483"\w*” \w y|strong="G2532"\w* “\w No|strong="G3756"\w*, \w no|strong="G3756"\w*” \w al|strong="G3588"\w* mismo tiempo?  
\v 18 \w Pero|strong="G1161"\w* tan cierto \w como|strong="G2532"\w* \w que|strong="G3754"\w* \w Dios|strong="G2316"\w* \w es|strong="G3756"\w* \w fiel|strong="G4103"\w*, \w el|strong="G3588"\w* mensaje \w que|strong="G3754"\w* \w les|strong="G4314"\w* hemos anunciado \w no|strong="G3756"\w* \w es|strong="G3756"\w* “\w Sí|strong="G3483"\w* \w y|strong="G2532"\w* \w no|strong="G3756"\w*”.  
\v 19 \w Porque|strong="G1063"\w* \w el|strong="G3588"\w* \w Hijo|strong="G5207"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*, \w Jesucristo|strong="G2424"\w*, \w a|strong="G1722"\w* \w quien|strong="G3588"\w* \w Silvano|strong="G4610"\w*, \w Timoteo|strong="G5095"\w* \w y|strong="G2532"\w* \w yo|strong="G1473"\w* \w predicamos|strong="G2784"\w* \w entre|strong="G1722"\w* ustedes, \w no|strong="G3756"\w* \w fue|strong="G1096"\w* “\w Sí|strong="G3483"\w* \w y|strong="G2532"\w* \w no|strong="G3756"\w*”, sino \w que|strong="G3588"\w* \w en|strong="G1722"\w* \w él|strong="G3588"\w* \w siempre|strong="G3588"\w* ha \w sido|strong="G1096"\w* “\w Sí|strong="G3483"\w*”.  
\v 20 \w Porque|strong="G1063"\w* \w todas|strong="G3745"\w* \w las|strong="G3588"\w* \w promesas|strong="G1860"\w* \w que|strong="G3588"\w* ha hecho \w Dios|strong="G2316"\w* son “\w Sí|strong="G3483"\w*” \w en|strong="G1722"\w* Cristo. \w Así|strong="G2532"\w* \w que|strong="G3588"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1722"\w* Cristo respondemos “Amén” \w para|strong="G4314"\w* \w la|strong="G3588"\w* \w gloria|strong="G1391"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*.   
\p
\v 21 \w Y|strong="G2532"\w* es \w Dios|strong="G2316"\w* \w el|strong="G3588"\w* \w que|strong="G3588"\w* \w nos|strong="G2316"\w* mantiene firmes \w en|strong="G1519"\w* \w Cristo|strong="G5547"\w*, tanto \w a|strong="G1519"\w* \w nosotros|strong="G2249"\w* \w como|strong="G2532"\w* \w a|strong="G1519"\w* ustedes. \w Él|strong="G3588"\w* \w nos|strong="G2316"\w* \w ungió|strong="G5548"\w*,  
\v 22 nos \w selló|strong="G4972"\w* \w como|strong="G2532"\w* propiedad suya \w y|strong="G2532"\w* puso \w su|strong="G3588"\w* \w Espíritu|strong="G4151"\w* \w en|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w corazón|strong="G2588"\w* \w como|strong="G2532"\w* garantía \w de|strong="G1722"\w* \w sus|strong="G3588"\w* promesas.   
\p
\v 23 Pongo \w a|strong="G1519"\w* \w Dios|strong="G2316"\w* \w por|strong="G1519"\w* \w testigo|strong="G3144"\w* \w sobre|strong="G1909"\w* \w mi|strong="G1699"\w* \w vida|strong="G5590"\w*, \w que|strong="G3754"\w* \w si|strong="G1161"\w* \w no|strong="G3765"\w* he vuelto \w a|strong="G1519"\w* \w Corinto|strong="G2882"\w*, ha sido \w para|strong="G1519"\w* \w no|strong="G3765"\w* ser duro \w con|strong="G1909"\w* ustedes.  
\v 24 \w No|strong="G3756"\w* \w es|strong="G3756"\w* \w que|strong="G3754"\w* queramos imponerles \w lo|strong="G3588"\w* \w que|strong="G3754"\w* deben creer, sino \w que|strong="G3754"\w* somos colaboradores suyos para \w que|strong="G3754"\w* ustedes tengan \w alegría|strong="G5479"\w*, \w porque|strong="G1063"\w* \w en|strong="G3588"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w* ustedes se mantienen \w firmes|strong="G2476"\w*.   
\c 2  
\p
\v 1 \w Por|strong="G1722"\w* eso decidí \w no|strong="G3361"\w* hacerles \w otra|strong="G3825"\w* visita \w que|strong="G3588"\w* \w les|strong="G4314"\w* causara \w tristeza|strong="G3077"\w*.  
\v 2 \w Porque|strong="G1063"\w* \w si|strong="G1487"\w* \w yo|strong="G1473"\w* \w los|strong="G3588"\w* entristezco, ¿\w quién|strong="G5101"\w* \w me|strong="G1473"\w* \w alegrará|strong="G2165"\w* \w a|strong="G1537"\w* \w mí|strong="G3588"\w*, \w sino|strong="G1487"\w* \w aquel|strong="G3588"\w* \w a|strong="G1537"\w* \w quien|strong="G5101"\w* \w yo|strong="G1473"\w* mismo he entristecido?  
\v 3 \w Por|strong="G1909"\w* eso \w les|strong="G1909"\w* \w escribí|strong="G1125"\w* \w como|strong="G2532"\w* \w lo|strong="G3588"\w* hice, \w para|strong="G2443"\w* \w que|strong="G3754"\w* \w al|strong="G3588"\w* llegar \w no|strong="G3361"\w* \w me|strong="G1473"\w* entristecieran \w los|strong="G3588"\w* mismos \w que|strong="G3754"\w* debían alegrarme. \w Estaba|strong="G2192"\w* seguro \w de|strong="G1909"\w* \w que|strong="G3754"\w* \w mi|strong="G1699"\w* \w alegría|strong="G5479"\w* sería compartida \w por|strong="G1909"\w* \w todos|strong="G3956"\w* ustedes.  
\v 4 \w Porque|strong="G1063"\w* \w les|strong="G1519"\w* \w escribí|strong="G1125"\w* \w con|strong="G1223"\w* \w gran|strong="G4183"\w* \w aflicción|strong="G2347"\w* \w y|strong="G2532"\w* \w angustia|strong="G4928"\w* \w de|strong="G1537"\w* \w corazón|strong="G2588"\w*, \w y|strong="G2532"\w* \w con|strong="G1223"\w* \w muchas|strong="G4183"\w* \w lágrimas|strong="G1144"\w*, \w no|strong="G3756"\w* \w para|strong="G1519"\w* entristecerlos, sino \w para|strong="G1519"\w* \w que|strong="G3588"\w* supieran \w cuánto|strong="G3739"\w* \w los|strong="G3588"\w* amo.   
\p
\v 5 \w Si|strong="G1487"\w* \w alguno|strong="G5100"\w* ha causado tristeza, \w no|strong="G3756"\w* \w me|strong="G1473"\w* la ha causado solo \w a|strong="G2443"\w* mí; hasta \w cierto|strong="G5100"\w* punto, \w y|strong="G1161"\w* \w para|strong="G2443"\w* \w no|strong="G3756"\w* exagerar, se la ha causado \w a|strong="G2443"\w* \w todos|strong="G3956"\w* ustedes.  
\v 6 \w El|strong="G3588"\w* castigo \w que|strong="G3588"\w* le impuso \w la|strong="G3588"\w* mayoría \w es|strong="G3778"\w* suficiente para esa persona.  
\v 7 Ahora, \w por|strong="G3588"\w* \w el|strong="G3588"\w* contrario, deben perdonarlo \w y|strong="G2532"\w* consolarlo, \w para|strong="G5620"\w* \w que|strong="G3588"\w* \w no|strong="G3361"\w* \w sea|strong="G3588"\w* consumido \w por|strong="G3588"\w* demasiada \w tristeza|strong="G3077"\w*.  
\v 8 \w Por|strong="G1519"\w* eso \w les|strong="G1519"\w* \w ruego|strong="G3870"\w* \w que|strong="G1519"\w* \w le|strong="G1519"\w* demuestren nuevamente su amor.  
\v 9 \w El|strong="G3588"\w* propósito \w de|strong="G1519"\w* \w mi|strong="G3588"\w* carta \w era|strong="G1519"\w* \w también|strong="G2532"\w* comprobar \w si|strong="G1487"\w* ustedes eran \w obedientes|strong="G5255"\w* \w en|strong="G1519"\w* \w todo|strong="G3956"\w*.  
\v 10 \w A|strong="G1722"\w* \w quien|strong="G3739"\w* ustedes perdonen, \w yo|strong="G1473"\w* \w también|strong="G2532"\w* \w lo|strong="G3739"\w* \w perdono|strong="G5483"\w*. \w Y|strong="G2532"\w* \w lo|strong="G3739"\w* \w que|strong="G3739"\w* he perdonado, \w si|strong="G1487"\w* \w algo|strong="G5100"\w* había \w que|strong="G3739"\w* perdonar, \w lo|strong="G3739"\w* he hecho \w por|strong="G1223"\w* \w el|strong="G3739"\w* \w bien|strong="G1161"\w* \w de|strong="G1722"\w* ustedes \w en|strong="G1722"\w* la \w presencia|strong="G4383"\w* \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*,  
\v 11 \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w Satanás|strong="G4567"\w* \w no|strong="G3756"\w* se aproveche \w de|strong="G5259"\w* nosotros, \w pues|strong="G1063"\w* conocemos muy bien \w sus|strong="G3588"\w* malas intenciones.   
\p
\v 12 \w Cuando|strong="G1722"\w* \w llegué|strong="G2064"\w* \w a|strong="G1519"\w* \w Troas|strong="G5174"\w* \w para|strong="G1519"\w* predicar \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*, descubrí \w que|strong="G3588"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w me|strong="G1473"\w* había abierto \w una|strong="G3588"\w* \w puerta|strong="G2374"\w*.  
\v 13 \w Sin|strong="G3361"\w* embargo, \w no|strong="G3756"\w* \w tuve|strong="G2192"\w* tranquilidad porque \w no|strong="G3756"\w* encontré \w a|strong="G1519"\w* \w mi|strong="G3588"\w* hermano \w Tito|strong="G5103"\w*. Así \w que|strong="G3588"\w* \w me|strong="G1473"\w* despedí \w de|strong="G1519"\w* \w ellos|strong="G3588"\w* \w y|strong="G1473"\w* \w me|strong="G1473"\w* fui \w a|strong="G1519"\w* \w Macedonia|strong="G3109"\w*.   
