\v 9 \w Sin|strong="H3808"\w* embargo, \w Salomón|strong="H8010"\w* \w no|strong="H3808"\w* obligó \w a|strong="H3068"\w* \w ningún|strong="H3808"\w* \w israelita|strong="H3478"\w* \w a|strong="H3068"\w* trabajar \w como|strong="H3588"\w* esclavo \w en|strong="H4480"\w* \w sus|strong="H1992"\w* construcciones, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* sirvieron \w como|strong="H3588"\w* soldados, \w como|strong="H3588"\w* oficiales \w de|strong="H4480"\w* \w sus|strong="H1992"\w* \w capitanes|strong="H8269"\w* \w y|strong="H3588"\w* \w como|strong="H3588"\w* comandantes \w de|strong="H4480"\w* \w sus|strong="H1992"\w* \w carros|strong="H7393"\w* \w y|strong="H3588"\w* \w de|strong="H4480"\w* \w su|strong="H1992"\w* caballería.  
\v 10 El \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* tenía \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w* oficiales \w principales|strong="H8269"\w*, \w que|strong="H5971"\w* eran los encargados \w de|strong="H5971"\w* supervisar \w a|strong="H3068"\w* la \w gente|strong="H5971"\w*.   
\p
\v 11 \w Salomón|strong="H8010"\w* trasladó \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w al|strong="H4428"\w* palacio \w que|strong="H3588"\w* \w había|strong="H3588"\w* construido \w para|strong="H3588"\w* ella, \w pues|strong="H3588"\w* dijo: “Mi esposa \w no|strong="H3808"\w* debe vivir \w en|strong="H3588"\w* \w el|strong="H3588"\w* palacio \w de|strong="H3588"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* cualquier lugar donde haya estado \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* \w sagrado|strong="H6944"\w*”.   
\p
\v 12 \w Luego|strong="H5927"\w* \w Salomón|strong="H8010"\w* \w ofreció|strong="H5927"\w* \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* había construido frente \w al|strong="H5921"\w* pórtico \w del|strong="H5921"\w* templo.  
\v 13 \w Lo|strong="H1697"\w* \w hizo|strong="H5927"\w* siguiendo el deber \w de|strong="H1697"\w* \w cada|strong="H1697"\w* \w día|strong="H3117"\w*, ofreciendo sacrificios según \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w Moisés|strong="H4872"\w* había ordenado para los \w sábados|strong="H7676"\w*, las fiestas \w de|strong="H1697"\w* luna nueva y las \w tres|strong="H7969"\w* fiestas anuales: la \w fiesta|strong="H2282"\w* \w de|strong="H1697"\w* los Panes sin Levadura, la \w fiesta|strong="H2282"\w* \w de|strong="H1697"\w* las \w Semanas|strong="H7620"\w* y la \w fiesta|strong="H2282"\w* \w de|strong="H1697"\w* las Enramadas.   
\p
\v 14 Siguiendo \w las|strong="H5921"\w* instrucciones \w de|strong="H5921"\w* \w su|strong="H3588"\w* padre \w David|strong="H1732"\w*, Salomón organizó \w los|strong="H5921"\w* \w turnos|strong="H4931"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w para|strong="H5921"\w* \w su|strong="H3588"\w* servicio, \w y|strong="H3588"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* dirigieran \w la|strong="H5921"\w* \w alabanza|strong="H1984"\w* \w y|strong="H3588"\w* ayudaran \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* tareas \w de|strong="H5921"\w* \w cada|strong="H3117"\w* \w día|strong="H3117"\w*. \w También|strong="H3651"\w* asignó \w los|strong="H5921"\w* \w turnos|strong="H4931"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w porteros|strong="H7778"\w* \w en|strong="H5921"\w* \w cada|strong="H3117"\w* \w puerta|strong="H8179"\w*, \w pues|strong="H3588"\w* \w así|strong="H3651"\w* \w lo|strong="H1697"\w* \w había|strong="H5975"\w* ordenado \w David|strong="H1732"\w*, hombre \w de|strong="H5921"\w* Dios.  
\v 15 \w Nadie|strong="H3808"\w* \w se|strong="H3808"\w* desvió \w de|strong="H5921"\w* \w las|strong="H5921"\w* órdenes \w que|strong="H3808"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* dio \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w levitas|strong="H3881"\w* \w sobre|strong="H5921"\w* \w ningún|strong="H3605"\w* \w asunto|strong="H1697"\w*, \w ni|strong="H3808"\w* siquiera \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* cuidado \w de|strong="H5921"\w* \w los|strong="H5921"\w* tesoros.   
\p
\v 16 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo \w de|strong="H5704"\w* \w Salomón|strong="H8010"\w* se llevó \w a|strong="H3068"\w* cabo \w con|strong="H5704"\w* éxito \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H5704"\w* se pusieron \w los|strong="H3605"\w* cimientos del \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* se terminó. Así, \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé quedó completamente listo.   
\p
\v 17 \w Después|strong="H5921"\w* \w Salomón|strong="H8010"\w* \w fue|strong="H1980"\w* \w a|strong="H3068"\w* Ezión Geber \w y|strong="H5921"\w* \w a|strong="H3068"\w* Elat, ciudades costeras \w en|strong="H5921"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* Edom.  
\v 18 Huram \w le|strong="H5973"\w* \w envió|strong="H7971"\w* barcos y marineros expertos, bajo \w el|strong="H5973"\w* \w mando|strong="H7971"\w* \w de|strong="H5973"\w* sus propios oficiales. Estos hombres fueron \w a|strong="H3068"\w* Ofir \w con|strong="H5973"\w* \w los|strong="H5973"\w* \w siervos|strong="H5650"\w* \w de|strong="H5973"\w* \w Salomón|strong="H8010"\w*, y \w de|strong="H5973"\w* \w allí|strong="H8033"\w* \w le|strong="H5973"\w* trajeron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* quince toneladas \w de|strong="H5973"\w* \w oro|strong="H2091"\w*.   
\c 9  
\p
\v 1 \w Cuando|strong="H1961"\w* \w la|strong="H3605"\w* \w reina|strong="H4436"\w* \w de|strong="H5973"\w* Sabá \w se|strong="H1961"\w* enteró \w de|strong="H5973"\w* \w la|strong="H3605"\w* fama \w de|strong="H5973"\w* \w Salomón|strong="H8010"\w*, viajó \w a|strong="H3068"\w* Jerusalén \w para|strong="H1961"\w* ponerlo \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w con|strong="H5973"\w* preguntas difíciles. Llegó \w con|strong="H5973"\w* una caravana impresionante, \w con|strong="H5973"\w* \w camellos|strong="H1581"\w* \w cargados|strong="H5375"\w* \w de|strong="H5973"\w* \w especias|strong="H1314"\w*, \w oro|strong="H2091"\w* \w en|strong="H5973"\w* \w abundancia|strong="H7230"\w* y piedras \w preciosas|strong="H3368"\w*. Al presentarse ante \w Salomón|strong="H8010"\w*, \w le|strong="H5973"\w* \w habló|strong="H1696"\w* \w de|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w tenía|strong="H1961"\w* \w en|strong="H5973"\w* mente.  
\v 2 \w Salomón|strong="H8010"\w* le respondió \w todas|strong="H3605"\w* sus preguntas. \w No|strong="H3808"\w* hubo \w ningún|strong="H3605"\w* misterio \w que|strong="H3808"\w* \w Salomón|strong="H8010"\w* \w no|strong="H3808"\w* pudiera resolver \w ni|strong="H3808"\w* explicarle.  
\v 3 Cuando \w la|strong="H2451"\w* \w reina|strong="H4436"\w* de Sabá comprobó \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* de \w Salomón|strong="H8010"\w*, y \w vio|strong="H7200"\w* el palacio que había construido,  
\v 4 la \w comida|strong="H3978"\w* \w de|strong="H5750"\w* su \w mesa|strong="H7979"\w*, \w cómo|strong="H1961"\w* \w estaban|strong="H1961"\w* sentados sus funcionarios, la organización \w de|strong="H5750"\w* sus servidores y sus uniformes, sus coperos y sus uniformes, y las escaleras \w por|strong="H5750"\w* las \w que|strong="H3808"\w* \w subía|strong="H5927"\w* \w al|strong="H5930"\w* \w templo|strong="H1004"\w* \w de|strong="H5750"\w* Yahvé, \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* asombrada.   
\p
\v 5 \w Ella|strong="H5921"\w* \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “¡\w Es|strong="H1697"\w* verdad todo \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w escuché|strong="H8085"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* país \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* tus logros \w y|strong="H5921"\w* \w de|strong="H5921"\w* tu \w sabiduría|strong="H2451"\w*!  
\v 6 \w Yo|strong="H2009"\w* \w no|strong="H3808"\w* \w podía|strong="H3808"\w* creer \w lo|strong="H1697"\w* \w que|strong="H3808"\w* decían, \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* vine \w y|strong="H5921"\w* \w lo|strong="H1697"\w* \w vi|strong="H7200"\w* \w con|strong="H5921"\w* mis propios \w ojos|strong="H5869"\w*. ¡\w Y|strong="H3068"\w* \w la|strong="H5921"\w* verdad \w es|strong="H1697"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w me|strong="H5921"\w* habían contado \w ni|strong="H3808"\w* \w la|strong="H5921"\w* mitad \w de|strong="H5921"\w* \w lo|strong="H1697"\w* grande \w que|strong="H3808"\w* \w es|strong="H1697"\w* tu \w sabiduría|strong="H2451"\w*! Superas \w por|strong="H5921"\w* mucho \w la|strong="H5921"\w* \w fama|strong="H8052"\w* \w que|strong="H3808"\w* había escuchado.  
\v 7 ¡Qué afortunada \w es|strong="H5975"\w* tu gente! ¡Qué dichosos son estos servidores tuyos, que \w siempre|strong="H8548"\w* están \w contigo|strong="H6440"\w* y pueden \w escuchar|strong="H8085"\w* tu \w sabiduría|strong="H2451"\w*!  
\v 8 ¡\w Bendito|strong="H1288"\w* \w sea|strong="H1961"\w* Yahvé, \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w*, \w que|strong="H5921"\w* \w se|strong="H1961"\w* agradó \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w puso|strong="H5414"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* reines \w en|strong="H5921"\w* \w el|strong="H5921"\w* nombre \w de|strong="H5921"\w* Yahvé, \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w*! \w Como|strong="H1961"\w* \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w* ama \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w quiere|strong="H2654"\w* establecerlo \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*, \w te|strong="H5921"\w* ha \w puesto|strong="H5414"\w* \w como|strong="H1961"\w* \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* gobiernes \w con|strong="H5921"\w* \w justicia|strong="H6666"\w* \w y|strong="H5921"\w* rectitud”.   
\p
\v 9 \w Luego|strong="H1931"\w*, \w ella|strong="H1931"\w* \w le|strong="H1931"\w* regaló \w al|strong="H4428"\w* \w rey|strong="H4428"\w* unas cuatro toneladas \w de|strong="H5414"\w* \w oro|strong="H2091"\w*, una enorme cantidad \w de|strong="H5414"\w* \w especias|strong="H1314"\w* y piedras \w preciosas|strong="H3368"\w*. \w Nunca|strong="H3808"\w* \w hubo|strong="H1961"\w* tantas \w especias|strong="H1314"\w* \w como|strong="H1961"\w* las \w que|strong="H1931"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* \w de|strong="H5414"\w* Sabá \w le|strong="H1931"\w* \w dio|strong="H5414"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*.   
\p
\v 10 (Los \w siervos|strong="H5650"\w* de \w Hiram|strong="H2438"\w* \w y|strong="H1571"\w* los \w siervos|strong="H5650"\w* de \w Salomón|strong="H8010"\w*, \w que|strong="H1571"\w* traían \w oro|strong="H2091"\w* de Ofir, \w también|strong="H1571"\w* trajeron \w madera|strong="H6086"\w* de sándalo \w y|strong="H1571"\w* piedras \w preciosas|strong="H3368"\w*.  
\v 11 Con esa \w madera|strong="H6086"\w* \w de|strong="H6440"\w* sándalo, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* escaleras para \w el|strong="H6213"\w* \w templo|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé y para \w el|strong="H6213"\w* palacio \w real|strong="H4428"\w*, además \w de|strong="H6440"\w* liras y \w arpas|strong="H3658"\w* para \w los|strong="H1992"\w* músicos. \w Nunca|strong="H3808"\w* \w se|strong="H3808"\w* \w había|strong="H6213"\w* \w visto|strong="H7200"\w* algo \w así|strong="H1992"\w* en \w el|strong="H6213"\w* territorio \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*).  
\v 12 \w Por|strong="H5414"\w* \w su|strong="H1931"\w* parte, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w le|strong="H1931"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w reina|strong="H4436"\w* \w de|strong="H5414"\w* Sabá \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w ella|strong="H1931"\w* quiso pedirle, \w que|strong="H1931"\w* \w fue|strong="H3212"\w* \w mucho|strong="H7592"\w* más \w de|strong="H5414"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w ella|strong="H1931"\w* \w le|strong="H1931"\w* había traído \w a|strong="H3068"\w* \w él|strong="H1931"\w*. Después, \w ella|strong="H1931"\w* y \w sus|strong="H1931"\w* sirvientes regresaron \w a|strong="H3068"\w* \w su|strong="H1931"\w* propio país.   
\p
\v 13 El \w peso|strong="H4948"\w* del \w oro|strong="H2091"\w* \w que|strong="H1961"\w* \w Salomón|strong="H8010"\w* recibía \w cada|strong="H8141"\w* \w año|strong="H8141"\w* \w era|strong="H1961"\w* de más de veintidós toneladas,  
\v 14 sin contar \w lo|strong="H3605"\w* \w que|strong="H3605"\w* traían \w los|strong="H3605"\w* comerciantes y \w mercaderes|strong="H5503"\w*. También \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w Arabia|strong="H6152"\w* y \w los|strong="H3605"\w* \w gobernadores|strong="H6346"\w* del país le traían \w oro|strong="H2091"\w* y \w plata|strong="H3701"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*.  
