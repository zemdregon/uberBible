\p
\v 24 “\w Si|strong="H3588"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w es|strong="H2088"\w* derrotado \w por|strong="H3588"\w* sus enemigos \w por|strong="H3588"\w* haber \w pecado|strong="H2398"\w* \w contra|strong="H6440"\w* ti, \w pero|strong="H3588"\w* \w luego|strong="H2088"\w* \w se|strong="H5971"\w* \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* ti, confiesa tu \w nombre|strong="H8034"\w*, \w y|strong="H3588"\w* \w ora|strong="H6419"\w* \w y|strong="H3588"\w* \w te|strong="H3588"\w* suplica \w en|strong="H3588"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
