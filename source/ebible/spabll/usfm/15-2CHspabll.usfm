\v 13 “\w Si|strong="H2005"\w* \w yo|strong="H6680"\w* cierro \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* llueva, \w o|strong="H3068"\w* \w si|strong="H2005"\w* \w le|strong="H5921"\w* \w ordeno|strong="H6680"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* langosta \w que|strong="H3808"\w* devore \w la|strong="H5921"\w* tierra, \w o|strong="H3068"\w* \w si|strong="H2005"\w* \w envío|strong="H7971"\w* una plaga \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*,  
\v 14 \w y|strong="H5921"\w* \w si|strong="H6440"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w que|strong="H4480"\w* lleva \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w se|strong="H5921"\w* humilla, \w ora|strong="H6419"\w*, \w me|strong="H4480"\w* \w busca|strong="H1245"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* aparta \w de|strong="H4480"\w* su \w mala|strong="H7451"\w* conducta, \w entonces|strong="H7725"\w* \w yo|strong="H4480"\w* \w los|strong="H5921"\w* \w escucharé|strong="H8085"\w* \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w perdonaré|strong="H5545"\w* sus \w pecados|strong="H2403"\w* \w y|strong="H5921"\w* \w sanaré|strong="H7495"\w* su tierra.  
\v 15 \w A|strong="H3068"\w* partir \w de|strong="H5869"\w* \w ahora|strong="H6258"\w*, mis \w ojos|strong="H5869"\w* \w estarán|strong="H1961"\w* \w abiertos|strong="H6605"\w* y mis oídos \w atentos|strong="H7183"\w* \w a|strong="H3068"\w* las oraciones \w que|strong="H6258"\w* \w se|strong="H1961"\w* hagan en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 16 He elegido \w y|strong="H5704"\w* consagrado \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w para|strong="H5704"\w* \w que|strong="H6258"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w* permanezca \w allí|strong="H8033"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*; mis \w ojos|strong="H5869"\w* \w y|strong="H5704"\w* \w mi|strong="H1961"\w* \w corazón|strong="H3820"\w* \w siempre|strong="H5769"\w* \w estarán|strong="H1961"\w* \w allí|strong="H8033"\w*.   
