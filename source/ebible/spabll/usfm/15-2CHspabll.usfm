\ide UTF-8
\h 2 CRÓNICAS 
\toc3 2 Crónicas 
\toc1 SEGUNDO LIBRO DE LAS CRÓNICAS 
\toc2 2 CRÓNICAS 
\mt2 Segundo libro de las  
\mt1 Crónicas  
\c 1  
\p
\v 1 \w Salomón|strong="H8010"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* afirmó \w en|strong="H5921"\w* su \w reino|strong="H4438"\w*, \w porque|strong="H5921"\w* Yahvé\f + \fr 1:1 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* su \w Dios|strong="H3068"\w*\f + \fr 1:1 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* estaba \w con|strong="H5973"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* hizo \w muy|strong="H4605"\w* \w poderoso|strong="H2388"\w*.   
\p
\v 2 \w Salomón|strong="H8010"\w* habló con \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*: con \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* \w mil|strong="H3967"\w* y \w de|strong="H8269"\w* \w cien|strong="H3967"\w* hombres, con \w los|strong="H3605"\w* \w jueces|strong="H8199"\w*, con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* y \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* familia \w de|strong="H8269"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 3 \w Después|strong="H1961"\w* \w Salomón|strong="H8010"\w*, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* comunidad, \w fue|strong="H1961"\w* al lugar \w de|strong="H3588"\w* culto \w que|strong="H3588"\w* \w estaba|strong="H1961"\w* \w en|strong="H5973"\w* \w Gabaón|strong="H1391"\w*, \w porque|strong="H3588"\w* \w allí|strong="H8033"\w* \w se|strong="H1961"\w* encontraba \w la|strong="H3588"\w* Tienda \w de|strong="H3588"\w* \w Reunión|strong="H6951"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* \w Moisés|strong="H4872"\w*, \w siervo|strong="H5650"\w* \w de|strong="H3588"\w* Yahvé, \w había|strong="H1961"\w* \w hecho|strong="H6213"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w desierto|strong="H4057"\w*.  
\v 4 \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* ya \w había|strong="H3588"\w* trasladado \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* Dios desde Quiriat Jearim al lugar \w que|strong="H3588"\w* le \w había|strong="H3588"\w* preparado, \w pues|strong="H3588"\w* le \w había|strong="H3588"\w* levantado una tienda \w en|strong="H3588"\w* Jerusalén.  
\v 5 Sin embargo, \w el|strong="H1121"\w* \w altar|strong="H4196"\w* \w de|strong="H6440"\w* bronce \w que|strong="H1121"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* Bezalel \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Uri, \w nieto|strong="H1121"\w* \w de|strong="H6440"\w* \w Hur|strong="H2354"\w*, \w estaba|strong="H7760"\w* allí en Gabaón frente al santuario \w de|strong="H6440"\w* Yahvé; \w por|strong="H6440"\w* eso \w Salomón|strong="H8010"\w* y la comunidad fueron \w a|strong="H3068"\w* consultarlo allí.  
\v 6 \w Salomón|strong="H8010"\w* \w subió|strong="H5927"\w* \w al|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* bronce \w que|strong="H5921"\w* estaba \w ante|strong="H6440"\w* Yahvé, \w en|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w de|strong="H5921"\w* Reunión, \w y|strong="H5921"\w* \w ofreció|strong="H5927"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* mil \w holocaustos|strong="H5930"\w*.   
\p
\v 7 \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* Dios \w se|strong="H1931"\w* \w le|strong="H1931"\w* \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w* y \w le|strong="H1931"\w* dijo: “\w Pídeme|strong="H7592"\w* \w lo|strong="H1931"\w* \w que|strong="H4100"\w* quieras \w que|strong="H4100"\w* te \w dé|strong="H5414"\w*”.   
\p
\v 8 \w Salomón|strong="H8010"\w* \w le|strong="H5973"\w* respondió \w a|strong="H3068"\w* Dios: “\w Tú|strong="H6213"\w* trataste \w con|strong="H5973"\w* \w gran|strong="H1419"\w* bondad \w a|strong="H3068"\w* mi padre \w David|strong="H1732"\w*, y \w a|strong="H3068"\w* mí \w me|strong="H5973"\w* \w has|strong="H4427"\w* puesto \w como|strong="H5973"\w* \w rey|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.  
\v 9 \w Ahora|strong="H6258"\w*, Yahvé \w Dios|strong="H3068"\w*, cumple \w la|strong="H5921"\w* promesa \w que|strong="H3588"\w* \w le|strong="H5921"\w* hiciste \w a|strong="H3068"\w* \w mi|strong="H5921"\w* padre \w David|strong="H1732"\w*, \w ya|strong="H6258"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* \w has|strong="H4427"\w* hecho \w rey|strong="H4427"\w* \w de|strong="H5921"\w* un \w pueblo|strong="H5971"\w* tan \w numeroso|strong="H7227"\w* \w como|strong="H3588"\w* \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tierra|strong="H6083"\w*.  
\v 10 \w Dame|strong="H5414"\w* \w ahora|strong="H6258"\w* \w sabiduría|strong="H2451"\w* \w y|strong="H3588"\w* \w conocimiento|strong="H4093"\w* \w para|strong="H3588"\w* dirigir \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* podrá \w gobernar|strong="H8199"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w tuyo|strong="H6258"\w* tan \w grande|strong="H1419"\w*?”   
\p
\v 11 \w Entonces|strong="H3117"\w* Dios \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*: “\w Ya|strong="H3068"\w* \w que|strong="H3808"\w* \w esto|strong="H2063"\w* \w es|strong="H1961"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w hay|strong="H1961"\w* \w en|strong="H5921"\w* \w tu|strong="H8199"\w* \w corazón|strong="H3824"\w*, \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w pediste|strong="H7592"\w* \w riquezas|strong="H6239"\w*, bienes \w ni|strong="H3808"\w* honores, \w ni|strong="H3808"\w* \w la|strong="H5921"\w* muerte \w de|strong="H5921"\w* tus \w enemigos|strong="H8130"\w*, \w ni|strong="H3808"\w* \w tampoco|strong="H1571"\w* \w pediste|strong="H7592"\w* una larga \w vida|strong="H5315"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w pediste|strong="H7592"\w* \w sabiduría|strong="H2451"\w* \w y|strong="H1571"\w* \w conocimiento|strong="H4093"\w* \w para|strong="H5921"\w* \w gobernar|strong="H8199"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w cual|strong="H5315"\w* \w te|strong="H5921"\w* he puesto \w como|strong="H1571"\w* \w rey|strong="H4427"\w*,  
\v 12 te concedo \w sabiduría|strong="H2451"\w* \w y|strong="H3519"\w* \w conocimiento|strong="H4093"\w*. Pero además te \w daré|strong="H5414"\w* \w riquezas|strong="H6239"\w*, bienes \w y|strong="H3519"\w* honores, \w como|strong="H1961"\w* \w no|strong="H3808"\w* \w los|strong="H1961"\w* \w tuvo|strong="H1961"\w* \w ninguno|strong="H3808"\w* \w de|strong="H6440"\w* \w los|strong="H1961"\w* \w reyes|strong="H4428"\w* \w que|strong="H3808"\w* \w hubo|strong="H1961"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* ti, \w ni|strong="H3808"\w* \w los|strong="H1961"\w* \w tendrá|strong="H1961"\w* \w ninguno|strong="H3808"\w* \w después|strong="H1961"\w* \w de|strong="H6440"\w* ti”.   
\p
\v 13 \w Salomón|strong="H8010"\w* regresó \w a|strong="H3068"\w* Jerusalén \w desde|strong="H6440"\w* \w el|strong="H5921"\w* lugar \w de|strong="H5921"\w* culto \w que|strong="H5921"\w* estaba \w en|strong="H5921"\w* \w Gabaón|strong="H1391"\w*, \w después|strong="H5921"\w* \w de|strong="H5921"\w* presentarse \w ante|strong="H6440"\w* \w la|strong="H5921"\w* Tienda \w de|strong="H5921"\w* Reunión, \w y|strong="H5921"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 14 \w Salomón|strong="H8010"\w* reunió \w carros|strong="H7393"\w* \w de|strong="H5973"\w* combate y caballería. Llegó \w a|strong="H3068"\w* \w tener|strong="H1961"\w* \w mil|strong="H3967"\w* cuatrocientos \w carros|strong="H7393"\w* y \w doce|strong="H8147"\w* \w mil|strong="H3967"\w* \w jinetes|strong="H6571"\w*, \w los|strong="H5973"\w* cuales instaló \w en|strong="H5973"\w* las \w ciudades|strong="H5892"\w* destinadas \w para|strong="H1961"\w* \w los|strong="H5973"\w* \w carros|strong="H7393"\w* y \w en|strong="H5973"\w* Jerusalén, \w cerca|strong="H5973"\w* \w de|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 15 El \w rey|strong="H4428"\w* \w hizo|strong="H5414"\w* que en Jerusalén la \w plata|strong="H3701"\w* y el \w oro|strong="H2091"\w* fueran tan comunes como las piedras, y que los cedros abundaran tanto como los árboles \w de|strong="H5414"\w* sicómoro en la llanura.  
\v 16 Los \w caballos|strong="H5483"\w* de \w Salomón|strong="H8010"\w* eran importados de \w Egipto|strong="H4714"\w* y de Cilicia; los comerciantes del \w rey|strong="H4428"\w* los compraban en Cilicia \w a|strong="H3068"\w* \w precio|strong="H4242"\w* de mercado.  
\v 17 Un \w carro|strong="H4818"\w* importado de \w Egipto|strong="H4714"\w* costaba \w seiscientas|strong="H8337"\w* \w monedas|strong="H3701"\w* de \w plata|strong="H3701"\w*, y un \w caballo|strong="H5483"\w*, \w ciento|strong="H3967"\w* \w cincuenta|strong="H2572"\w*.\f + \fr 1:17 \ft Las piezas de plata eran probablemente siclos, por lo que 600 piezas serían unas 13,2 libras o 6 kilogramos de plata, y 150 serían unas 3,3 libras o 1,5 kilogramos de plata.\f* \w Estos|strong="H3605"\w* mismos comerciantes les vendían \w caballos|strong="H5483"\w* y \w carros|strong="H4818"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* hititas y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* sirios. \f + \fr 1:17 \ft “Beracah” significa “bendición”.\f*   
\c 2  
\p
\v 1 \w Salomón|strong="H8010"\w* decidió construir un templo \w en|strong="H5921"\w* honor \w al|strong="H5921"\w* nombre \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* un palacio real \w para|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 2 \w Para|strong="H5973"\w* ello, reclutó \w a|strong="H3068"\w* setenta mil cargadores, ochenta mil canteros \w para|strong="H5973"\w* \w trabajar|strong="H6213"\w* \w en|strong="H5973"\w* las montañas y tres mil seiscientos capataces \w para|strong="H5973"\w* dirigirlos.   
\p
\v 3 También envió \w este|strong="H2063"\w* mensaje \w a|strong="H3068"\w* Hiram, rey \w de|strong="H5921"\w* Tiro: “Trátame \w de|strong="H5921"\w* \w la|strong="H5921"\w* misma manera \w que|strong="H5921"\w* trataste \w a|strong="H3068"\w* \w mi|strong="H5921"\w* padre David, \w a|strong="H3068"\w* quien \w le|strong="H5921"\w* enviaste cedros \w para|strong="H5921"\w* construir su residencia.  
\v 4 Estoy \w por|strong="H3588"\w* construir un \w templo|strong="H1004"\w* \w en|strong="H3588"\w* honor al nombre \w de|strong="H3588"\w* Yahvé mi Dios, \w para|strong="H3588"\w* consagrárselo \w y|strong="H3588"\w* quemar ante \w él|strong="H3588"\w* incienso aromático, \w para|strong="H3588"\w* presentar \w siempre|strong="H3605"\w* \w el|strong="H3588"\w* pan \w de|strong="H3588"\w* \w la|strong="H3588"\w* presencia \w y|strong="H3588"\w* ofrecer \w los|strong="H3605"\w* holocaustos \w de|strong="H3588"\w* \w la|strong="H3588"\w* mañana \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tarde, \w de|strong="H3588"\w* \w los|strong="H3605"\w* sábados, \w de|strong="H3588"\w* las lunas nuevas \w y|strong="H3588"\w* \w de|strong="H3588"\w* las fiestas establecidas \w por|strong="H3588"\w* Yahvé nuestro Dios. Esto \w es|strong="H3588"\w* una ley \w para|strong="H3588"\w* \w siempre|strong="H3605"\w* \w en|strong="H3588"\w* Israel.   
\p
\v 5 “\w El|strong="H3588"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* voy \w a|strong="H3068"\w* construir \w será|strong="H3808"\w* grande, \w porque|strong="H3588"\w* nuestro Dios \w es|strong="H3588"\w* \w más|strong="H3588"\w* grande \w que|strong="H3588"\w* todos \w los|strong="H3588"\w* dioses.  
\v 6 Pero, \w en|strong="H5973"\w* realidad, ¿\w quién|strong="H6213"\w* es capaz \w de|strong="H5973"\w* construirle un templo, si \w ni|strong="H5973"\w* siquiera \w los|strong="H5973"\w* cielos \w más|strong="H6258"\w* altos pueden contenerlo? ¿\w Y|strong="H3068"\w* \w quién|strong="H6213"\w* soy \w yo|strong="H6213"\w* \w para|strong="H5973"\w* construirle un templo, si \w no|strong="H6213"\w* es solo \w para|strong="H5973"\w* quemar incienso ante \w él|strong="H5973"\w*?   
\p
\v 7 “\w Por|strong="H3588"\w* lo tanto, \w envíame|strong="H7971"\w* \w a|strong="H3068"\w* un hombre experto \w en|strong="H5973"\w* trabajar \w el|strong="H5973"\w* oro, \w la|strong="H3588"\w* plata, \w el|strong="H5973"\w* bronce, \w el|strong="H5973"\w* hierro, \w y|strong="H3588"\w* las telas \w de|strong="H3588"\w* púrpura, carmesí \w y|strong="H3588"\w* azul, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w además|strong="H3588"\w* \w sepa|strong="H3045"\w* \w hacer|strong="H3772"\w* grabados. \w Él|strong="H5973"\w* trabajará \w junto|strong="H5973"\w* \w con|strong="H5973"\w* mis artesanos \w en|strong="H5973"\w* Judá \w y|strong="H3588"\w* Jerusalén, \w a|strong="H3068"\w* quienes \w mi|strong="H2009"\w* padre ya \w había|strong="H3588"\w* preparado.   
\p
\v 8 “Envíame también \w madera|strong="H6086"\w* \w de|strong="H3588"\w* cedro, pino \w y|strong="H3588"\w* sándalo del Líbano, \w pues|strong="H3588"\w* sé muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* tus siervos \w son|strong="H3588"\w* expertos \w en|strong="H3588"\w* cortar \w los|strong="H3588"\w* \w árboles|strong="H6086"\w* del Líbano. Mis siervos trabajarán \w con|strong="H3588"\w* \w los|strong="H3588"\w* \w tuyos|strong="H1004"\w*  
\v 9 \w para|strong="H5414"\w* prepararme \w madera|strong="H6086"\w* en abundancia, \w porque|strong="H2009"\w* el templo que voy \w a|strong="H3068"\w* construir \w será|strong="H5414"\w* grande y maravilloso.  
\v 10 \w A|strong="H3068"\w* tus siervos, \w los|strong="H5921"\w* leñadores, \w les|strong="H5921"\w* \w daré|strong="H5414"\w* veinte mil coros \w de|strong="H5921"\w* trigo desgranado, veinte mil coros \w de|strong="H5921"\w* cebada, veinte mil batos \w de|strong="H5921"\w* vino \w y|strong="H5921"\w* veinte mil batos \w de|strong="H5921"\w* aceite”.   
\p
\v 11 Entonces Huram, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Tiro, le respondió \w a|strong="H3068"\w* \w Salomón|strong="H4428"\w* \w por|strong="H5414"\w* escrito: “\w Porque|strong="H1732"\w* Yahvé ama \w a|strong="H3068"\w* su pueblo, te ha \w puesto|strong="H5414"\w* como \w rey|strong="H4428"\w* sobre ellos”.  
\v 12 \w Y|strong="H3068"\w* añadió Huram: “¡Bendito sea Yahvé, el Dios de Israel, \w que|strong="H6258"\w* hizo el cielo y la tierra, porque le ha dado al rey David un hijo \w sabio|strong="H2450"\w*, lleno de prudencia y entendimiento, \w para|strong="H6258"\w* construir un templo \w a|strong="H3068"\w* Yahvé y un palacio real!   
\p
\v 13 “\w Te|strong="H4480"\w* envío ahora \w a|strong="H3068"\w* Huram-abí, un \w hombre|strong="H1121"\w* muy \w hábil|strong="H2450"\w* y \w con|strong="H5973"\w* mucho entendimiento.  
\v 14 Él es hijo de una mujer de la tribu de Dan y de un padre de Tiro. Es experto en trabajar el oro, la plata, el bronce, el hierro, la piedra, la madera, y las telas de púrpura, azul, lino fino y carmesí. También sabe hacer toda clase de grabados y diseñar cualquier obra \w que|strong="H6258"\w* se le encargue. Él trabajará junto con tus expertos y con los de mi señor David, tu padre.   
\p
\v 15 “\w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H5921"\w*, envíe ahora \w mi|strong="H5921"\w* señor \w a|strong="H3068"\w* sus siervos \w el|strong="H5921"\w* trigo, \w la|strong="H5921"\w* cebada, \w el|strong="H5921"\w* aceite \w y|strong="H5921"\w* \w el|strong="H5921"\w* vino \w que|strong="H4480"\w* prometió;  
\v 16 y \w nosotros|strong="H3605"\w* cortaremos en \w el|strong="H3605"\w* Líbano \w toda|strong="H3605"\w* \w la|strong="H3605"\w* madera \w que|strong="H1616"\w* necesites. Te \w la|strong="H3605"\w* enviaremos en balsas por \w el|strong="H3605"\w* mar hasta Jope, y desde allí tú \w la|strong="H3605"\w* llevarás \w a|strong="H3068"\w* Jerusalén”.   
\p
\v 17 Salomón \w hizo|strong="H6213"\w* un censo \w de|strong="H5971"\w* todos \w los|strong="H1992"\w* extranjeros \w que|strong="H5971"\w* vivían en Israel, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w su|strong="H1992"\w* padre David, y resultaron ser \w ciento|strong="H3967"\w* cincuenta y \w tres|strong="H7969"\w* \w mil|strong="H3967"\w* \w seiscientos|strong="H8337"\w*.  
\v 18 De ellos, designó \w a|strong="H3068"\w* setenta mil como cargadores, \w a|strong="H3068"\w* ochenta mil como canteros en las montañas, y \w a|strong="H3068"\w* tres mil seiscientos como capataces para asignar el trabajo al pueblo.   
\c 3  
\p
\v 1 \w Salomón|strong="H8010"\w* \w comenzó|strong="H2490"\w* \w a|strong="H3068"\w* construir el \w Templo|strong="H1004"\w* de Yahvé en Jerusalén, en el \w monte|strong="H2022"\w* Moriah, \w donde|strong="H4725"\w* Yahvé se le había aparecido \w a|strong="H3068"\w* su padre \w David|strong="H1732"\w*. Lo construyó en el \w lugar|strong="H4725"\w* que \w David|strong="H1732"\w* había preparado en el terreno de Ornán el \w jebuseo|strong="H2983"\w*.  
\v 2 \w Comenzó|strong="H2490"\w* la construcción el \w segundo|strong="H8145"\w* día del \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, en el cuarto \w año|strong="H8141"\w* de su \w reinado|strong="H4438"\w*.  
\v 3 Estas son las medidas que \w Salomón|strong="H8010"\w* fijó para los \w cimientos|strong="H3245"\w* del \w templo|strong="H1004"\w* de Dios: \w sesenta|strong="H8346"\w* codos de largo por \w veinte|strong="H6242"\w* de ancho, usando la \w medida|strong="H4060"\w* \w antigua|strong="H7223"\w*.  
\v 4 \w El|strong="H5921"\w* vestíbulo \w que|strong="H5921"\w* \w estaba|strong="H1004"\w* \w al|strong="H5921"\w* frente \w del|strong="H5921"\w* \w templo|strong="H1004"\w* medía \w veinte|strong="H6242"\w* codos \w de|strong="H5921"\w* largo, igual \w al|strong="H5921"\w* ancho \w del|strong="H5921"\w* \w templo|strong="H1004"\w*, \w y|strong="H5921"\w* tenía \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* codos \w de|strong="H5921"\w* alto. \w Por|strong="H5921"\w* \w dentro|strong="H6440"\w*, \w lo|strong="H5921"\w* recubrió \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*.  
\v 5 Revistió \w la|strong="H5921"\w* sala \w principal|strong="H1419"\w* \w con|strong="H5921"\w* \w madera|strong="H6086"\w* \w de|strong="H5921"\w* pino \w y|strong="H5921"\w* \w la|strong="H5921"\w* recubrió \w de|strong="H5921"\w* \w oro|strong="H2091"\w* fino, decorándola \w con|strong="H5921"\w* figuras \w de|strong="H5921"\w* palmeras \w y|strong="H5921"\w* cadenas.  
\v 6 Para embellecer el \w templo|strong="H1004"\w*, lo adornó con piedras \w preciosas|strong="H3368"\w*. El \w oro|strong="H2091"\w* utilizado era de Parvaim.  
\v 7 Recubrió \w de|strong="H5921"\w* \w oro|strong="H2091"\w* todo \w el|strong="H5921"\w* \w templo|strong="H1004"\w*: \w las|strong="H5921"\w* vigas, \w los|strong="H5921"\w* umbrales, \w las|strong="H5921"\w* paredes \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H1817"\w*, \w y|strong="H5921"\w* mandó grabar \w querubines|strong="H3742"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* paredes.   
\p
\v 8 También construyó \w el|strong="H5921"\w* lugar \w santísimo|strong="H6944"\w*. Medía \w veinte|strong="H6242"\w* codos \w de|strong="H5921"\w* largo, \w que|strong="H5921"\w* era \w el|strong="H5921"\w* ancho \w del|strong="H5921"\w* \w templo|strong="H1004"\w*, \w y|strong="H5921"\w* \w veinte|strong="H6242"\w* codos \w de|strong="H5921"\w* ancho. \w Lo|strong="H5921"\w* recubrió \w con|strong="H5921"\w* \w seiscientos|strong="H8337"\w* \w talentos|strong="H3603"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* fino.  
\v 9 El \w peso|strong="H4948"\w* de los clavos de \w oro|strong="H2091"\w* era de \w cincuenta|strong="H2572"\w* \w siclos|strong="H8255"\w*. También recubrió de \w oro|strong="H2091"\w* las \w salas|strong="H5944"\w* de la planta alta.   
\p
\v 10 En \w el|strong="H6213"\w* lugar \w santísimo|strong="H6944"\w* mandó \w hacer|strong="H6213"\w* \w dos|strong="H8147"\w* \w querubines|strong="H3742"\w* de madera tallada, y los recubrió de \w oro|strong="H2091"\w*.  
\v 11 Las \w alas|strong="H3671"\w* \w de|strong="H2568"\w* los \w querubines|strong="H3742"\w* medían en total \w veinte|strong="H6242"\w* codos \w de|strong="H2568"\w* largo. Un \w ala|strong="H3671"\w* del primer \w querubín|strong="H3742"\w* medía \w cinco|strong="H2568"\w* codos y \w tocaba|strong="H5060"\w* la \w pared|strong="H7023"\w* del \w templo|strong="H1004"\w*, y su otra \w ala|strong="H3671"\w*, también \w de|strong="H2568"\w* \w cinco|strong="H2568"\w* codos, \w tocaba|strong="H5060"\w* el \w ala|strong="H3671"\w* del segundo \w querubín|strong="H3742"\w*.  
\v 12 \w De|strong="H2568"\w* la misma forma, un \w ala|strong="H3671"\w* del segundo \w querubín|strong="H3742"\w* medía \w cinco|strong="H2568"\w* codos y \w tocaba|strong="H5060"\w* la \w pared|strong="H7023"\w* del \w templo|strong="H1004"\w*, y su otra \w ala|strong="H3671"\w*, \w de|strong="H2568"\w* \w cinco|strong="H2568"\w* codos, \w tocaba|strong="H5060"\w* el \w ala|strong="H3671"\w* del primer \w querubín|strong="H3742"\w*.  
\v 13 \w Así|strong="H1992"\w* \w que|strong="H5921"\w* \w las|strong="H1992"\w* \w alas|strong="H3671"\w* \w de|strong="H5921"\w* \w estos|strong="H1992"\w* \w querubines|strong="H3742"\w* \w estaban|strong="H5975"\w* \w extendidas|strong="H6566"\w* \w a|strong="H3068"\w* \w lo|strong="H5921"\w* largo \w de|strong="H5921"\w* \w veinte|strong="H6242"\w* codos. \w Estaban|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H7272"\w*, mirando \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* sala principal.  
\v 14 \w Hizo|strong="H6213"\w* \w la|strong="H5921"\w* cortina \w de|strong="H5921"\w* tela azul, púrpura, \w carmesí|strong="H3758"\w* \w y|strong="H5921"\w* lino fino, \w y|strong="H5921"\w* mandó bordar \w querubines|strong="H3742"\w* \w en|strong="H5921"\w* \w ella|strong="H5921"\w*.   
\p
\v 15 Frente \w al|strong="H5921"\w* \w templo|strong="H1004"\w* levantó \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w cinco|strong="H2568"\w* codos \w de|strong="H5921"\w* alto, \w y|strong="H5921"\w* \w el|strong="H5921"\w* capitel \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w de|strong="H5921"\w* cada una medía \w cinco|strong="H2568"\w* codos.  
\v 16 \w Hizo|strong="H6213"\w* cadenas, \w como|strong="H5921"\w* \w las|strong="H5921"\w* \w del|strong="H5921"\w* santuario interior, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w puso|strong="H5414"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*; también \w hizo|strong="H6213"\w* \w cien|strong="H3967"\w* figuras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* colocó \w en|strong="H5921"\w* \w las|strong="H5921"\w* cadenas.  
\v 17 \w Levantó|strong="H6965"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w* frente \w al|strong="H5921"\w* \w templo|strong="H1964"\w*, una \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w y|strong="H5921"\w* otra \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w*. \w A|strong="H3068"\w* \w la|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w la|strong="H5921"\w* \w llamó|strong="H7121"\w* Jaquín, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w*, \w Boaz|strong="H1162"\w*.   
\c 4  
\p
\v 1 Luego mandó \w hacer|strong="H6213"\w* un \w altar|strong="H4196"\w* de bronce de \w veinte|strong="H6242"\w* codos de largo, \w veinte|strong="H6242"\w* codos de ancho y \w diez|strong="H6235"\w* codos de alto.  
\v 2 También \w hizo|strong="H6213"\w* una enorme pila circular \w de|strong="H2568"\w* bronce fundido, llamada \w el|strong="H6213"\w* \w Mar|strong="H3220"\w*, que medía \w diez|strong="H6235"\w* codos \w de|strong="H2568"\w* un borde al \w otro|strong="H8193"\w*, \w cinco|strong="H2568"\w* codos \w de|strong="H2568"\w* alto y \w treinta|strong="H7970"\w* codos \w de|strong="H2568"\w* circunferencia.  
\v 3 \w Debajo|strong="H8478"\w* del borde había figuras \w de|strong="H8478"\w* toros que rodeaban toda la pila, \w diez|strong="H6235"\w* \w por|strong="H8478"\w* \w cada|strong="H6235"\w* codo. Los toros estaban fundidos \w en|strong="H8478"\w* \w dos|strong="H8147"\w* hileras \w en|strong="H8478"\w* una sola pieza con la pila.  
\v 4 \w La|strong="H5921"\w* pila descansaba \w sobre|strong="H5921"\w* \w doce|strong="H8147"\w* toros: \w tres|strong="H7969"\w* \w miraban|strong="H6437"\w* \w al|strong="H5921"\w* \w norte|strong="H6828"\w*, \w tres|strong="H7969"\w* \w al|strong="H5921"\w* oeste, \w tres|strong="H7969"\w* \w al|strong="H5921"\w* sur \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w al|strong="H5921"\w* \w este|strong="H4217"\w*. \w La|strong="H5921"\w* pila \w estaba|strong="H5975"\w* asentada \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* partes traseras \w de|strong="H5921"\w* \w los|strong="H5921"\w* toros daban \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* centro.  
\v 5 El grosor de la pila era de un palmo, y su borde tenía forma de copa, como la \w flor|strong="H6525"\w* de un lirio abierto. Tenía capacidad para \w tres|strong="H7969"\w* mil \w batos|strong="H1324"\w* de agua.  
\v 6 Además, \w hizo|strong="H6213"\w* \w diez|strong="H6235"\w* palanganas y \w puso|strong="H5414"\w* \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* y \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w* \w para|strong="H5414"\w* lavar en ellas. En \w estas|strong="H6213"\w* palanganas se \w lavaban|strong="H7364"\w* las cosas destinadas \w a|strong="H3068"\w* los \w holocaustos|strong="H5930"\w*, pero \w el|strong="H6213"\w* \w Mar|strong="H3220"\w* era \w para|strong="H5414"\w* que los \w sacerdotes|strong="H3548"\w* se \w lavaran|strong="H7364"\w*.   
\p
\v 7 \w Hizo|strong="H6213"\w* \w diez|strong="H6235"\w* candelabros \w de|strong="H2568"\w* \w oro|strong="H2091"\w*, según \w el|strong="H6213"\w* diseño ordenado \w para|strong="H5414"\w* ellos, y los \w puso|strong="H5414"\w* en \w el|strong="H6213"\w* \w templo|strong="H1964"\w*, \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* y \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*.  
\v 8 \w También|strong="H7979"\w* \w hizo|strong="H6213"\w* \w diez|strong="H6235"\w* \w mesas|strong="H7979"\w* y las colocó en \w el|strong="H6213"\w* \w templo|strong="H1964"\w*, \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* y \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*; \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* \w cien|strong="H3967"\w* \w tazones|strong="H4219"\w* \w de|strong="H2568"\w* \w oro|strong="H2091"\w*.  
\v 9 Construyó \w el|strong="H6213"\w* \w patio|strong="H2691"\w* de los \w sacerdotes|strong="H3548"\w* y \w el|strong="H6213"\w* \w gran|strong="H1419"\w* \w patio|strong="H2691"\w*, y las \w puertas|strong="H1817"\w* para \w el|strong="H6213"\w* \w patio|strong="H2691"\w*, las cuales recubrió de bronce.  
\v 10 Colocó la pila del \w Mar|strong="H3220"\w* al \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w* del templo, \w hacia|strong="H4136"\w* la esquina sureste.   
\p
\v 11 Huram también \w hizo|strong="H6213"\w* las ollas, las palas y los \w tazones|strong="H4219"\w*.  
\p Así terminó Huram \w el|strong="H6213"\w* trabajo que \w hizo|strong="H6213"\w* para \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* en \w el|strong="H6213"\w* \w templo|strong="H1004"\w* de Dios:  
\v 12 \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w*, \w los|strong="H5921"\w* tazones, \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w capiteles|strong="H3805"\w* \w que|strong="H5921"\w* \w estaban|strong="H7218"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*, \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w redes|strong="H3805"\w* \w para|strong="H5921"\w* \w cubrir|strong="H3680"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* tazones \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w capiteles|strong="H3805"\w* \w que|strong="H5921"\w* \w estaban|strong="H7218"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*,  
\v 13 \w y|strong="H5921"\w* \w las|strong="H5921"\w* cuatrocientas figuras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w* \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w redes|strong="H3805"\w*, dispuestas \w en|strong="H5921"\w* \w dos|strong="H8147"\w* hileras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w* \w por|strong="H5921"\w* cada red, \w para|strong="H5921"\w* \w cubrir|strong="H3680"\w* \w los|strong="H5921"\w* tazones \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w capiteles|strong="H3805"\w* \w que|strong="H5921"\w* estaban \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*.  
\v 14 También \w hizo|strong="H6213"\w* \w las|strong="H5921"\w* bases, \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ellas|strong="H5921"\w* colocó \w las|strong="H5921"\w* palanganas,  
\v 15 la única pila del \w Mar|strong="H3220"\w*, \w y|strong="H1241"\w* los \w doce|strong="H8147"\w* toros \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* ella.  
\v 16 Las ollas, las palas, \w los|strong="H3605"\w* tenedores y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* demás utensilios, \w los|strong="H3605"\w* \w hizo|strong="H6213"\w* Huram-abí de bronce pulido para \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*, para \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé.  
\v 17 El \w rey|strong="H4428"\w* mandó fundirlos en moldes de arcilla en la llanura del \w Jordán|strong="H3383"\w*, entre Sucot y Zereda.  
\v 18 \w Salomón|strong="H8010"\w* \w hizo|strong="H6213"\w* tantos utensilios \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w fue|strong="H3808"\w* posible determinar \w el|strong="H3588"\w* \w peso|strong="H4948"\w* del bronce.   
\p
\v 19 \w Salomón|strong="H8010"\w* \w hizo|strong="H6213"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* utensilios \w que|strong="H5921"\w* \w había|strong="H6213"\w* \w dentro|strong="H6440"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios: \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w las|strong="H5921"\w* \w mesas|strong="H7979"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w*,  
\v 20 los candelabros \w de|strong="H6440"\w* \w oro|strong="H2091"\w* \w puro|strong="H5462"\w* con sus \w lámparas|strong="H5216"\w*, para que ardieran \w ante|strong="H6440"\w* el santuario interior como estaba ordenado;  
\v 21 las \w flores|strong="H6525"\w*, las \w lámparas|strong="H5216"\w* y las tenazas de \w oro|strong="H2091"\w* del más puro;  
\v 22 los cortapabilos, los \w tazones|strong="H4219"\w*, las \w cucharas|strong="H3709"\w* y los \w incensarios|strong="H4289"\w*, todos de \w oro|strong="H2091"\w* \w puro|strong="H5462"\w*. En cuanto \w a|strong="H3068"\w* la entrada del \w edificio|strong="H1004"\w*, tanto las \w puertas|strong="H1817"\w* \w interiores|strong="H6442"\w* hacia el lugar \w santísimo|strong="H6944"\w* como las de la sala principal del \w templo|strong="H1964"\w*, eran de \w oro|strong="H2091"\w*.   
\c 5  
\p
\v 1 Así quedó terminado \w todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo \w que|strong="H3605"\w* \w Salomón|strong="H8010"\w* \w hizo|strong="H6213"\w* \w para|strong="H5414"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé. Luego, \w Salomón|strong="H8010"\w* trajo las cosas \w que|strong="H3605"\w* su padre \w David|strong="H1732"\w* \w había|strong="H6213"\w* \w consagrado|strong="H6944"\w*, es decir, \w la|strong="H3605"\w* \w plata|strong="H3701"\w*, \w el|strong="H3605"\w* \w oro|strong="H2091"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios, y \w los|strong="H3605"\w* guardó en \w los|strong="H3605"\w* tesoros del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* \w Dios|strong="H3068"\w*.   
\p
\v 2 Entonces \w Salomón|strong="H8010"\w* reunió en Jerusalén \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w tribus|strong="H4294"\w*, \w que|strong="H1931"\w* eran \w los|strong="H1121"\w* líderes \w de|strong="H1121"\w* las familias \w de|strong="H1121"\w* \w los|strong="H1121"\w* israelitas, para trasladar \w el|strong="H1931"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H1121"\w* Yahvé desde \w la|strong="H1931"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w Sión|strong="H6726"\w*.  
\v 3 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres de \w Israel|strong="H3478"\w* \w se|strong="H1931"\w* reunieron con \w el|strong="H1931"\w* \w rey|strong="H4428"\w* durante \w la|strong="H1931"\w* \w fiesta|strong="H2282"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* celebraba en \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*.  
\v 4 Cuando llegaron \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* de \w Israel|strong="H3478"\w*, \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* levantaron \w el|strong="H3605"\w* arca.  
\v 5 Trasladaron \w el|strong="H3605"\w* arca, \w la|strong="H3605"\w* Tienda de Reunión y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios \w sagrados|strong="H6944"\w* \w que|strong="H3605"\w* estaban en \w la|strong="H3605"\w* Tienda; \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w fueron|strong="H5927"\w* quienes \w los|strong="H3605"\w* llevaron.  
\v 6 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* había reunido \w con|strong="H5921"\w* \w él|strong="H5921"\w* estaban frente \w al|strong="H5921"\w* arca, \w sacrificando|strong="H2076"\w* \w ovejas|strong="H6629"\w* \w y|strong="H5921"\w* toros \w en|strong="H5921"\w* tal cantidad \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* podían \w contar|strong="H5608"\w*.  
\v 7 Luego, los \w sacerdotes|strong="H3548"\w* llevaron el arca del \w pacto|strong="H1285"\w* \w de|strong="H8478"\w* Yahvé \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w*, \w al|strong="H8478"\w* \w santuario|strong="H6944"\w* interior del \w templo|strong="H1004"\w*, es decir, \w al|strong="H8478"\w* \w lugar|strong="H4725"\w* \w santísimo|strong="H6944"\w*, y la pusieron \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* las \w alas|strong="H3671"\w* \w de|strong="H8478"\w* los \w querubines|strong="H3742"\w*.  
\v 8 \w Los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w tenían|strong="H1961"\w* sus \w alas|strong="H3671"\w* \w extendidas|strong="H6566"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w lugar|strong="H4725"\w* \w del|strong="H5921"\w* arca, \w de|strong="H5921"\w* manera \w que|strong="H5921"\w* \w cubrían|strong="H3680"\w* \w por|strong="H5921"\w* \w encima|strong="H4605"\w* \w el|strong="H5921"\w* arca \w y|strong="H5921"\w* sus varas \w para|strong="H5921"\w* transportarla.  
\v 9 \w Las|strong="H5921"\w* varas \w eran|strong="H1961"\w* tan largas \w que|strong="H4480"\w* sus extremos \w se|strong="H1961"\w* podían \w ver|strong="H7200"\w* \w desde|strong="H4480"\w* \w el|strong="H5921"\w* arca \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte delantera \w del|strong="H4480"\w* santuario interior, pero \w no|strong="H3808"\w* \w desde|strong="H4480"\w* \w afuera|strong="H2351"\w*; \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w están|strong="H1961"\w* \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w hoy|strong="H3117"\w*.  
\v 10 Dentro \w del|strong="H5973"\w* arca \w solo|strong="H7535"\w* estaban las \w dos|strong="H8147"\w* \w tablas|strong="H3871"\w* \w de|strong="H5973"\w* piedra \w que|strong="H1121"\w* \w Moisés|strong="H4872"\w* había \w puesto|strong="H5414"\w* allí \w en|strong="H5973"\w* \w Horeb|strong="H2722"\w*, cuando Yahvé \w hizo|strong="H3772"\w* un pacto \w con|strong="H5973"\w* \w los|strong="H1121"\w* israelitas después \w de|strong="H5973"\w* \w que|strong="H1121"\w* \w salieron|strong="H3318"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*.   
\p
\v 11 \w Cuando|strong="H3588"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w salieron|strong="H3318"\w* \w del|strong="H4480"\w* lugar \w santo|strong="H6944"\w* (\w pues|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H3588"\w* \w estaban|strong="H1961"\w* allí \w se|strong="H1961"\w* \w habían|strong="H1961"\w* \w santificado|strong="H6944"\w* sin importar \w su|strong="H3588"\w* turno \w de|strong="H4480"\w* servicio;  
\v 12 y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w cantores|strong="H7891"\w*, Asaf, \w Hemán|strong="H1968"\w*, Jedutún, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* sus \w hijos|strong="H1121"\w* y sus hermanos, \w estaban|strong="H5975"\w* \w vestidos|strong="H3847"\w* \w de|strong="H5973"\w* lino fino y \w tocaban|strong="H2690"\w* platillos, \w arpas|strong="H3658"\w* y liras, \w de|strong="H5973"\w* \w pie|strong="H5975"\w* al lado \w este|strong="H4217"\w* \w del|strong="H4196"\w* \w altar|strong="H4196"\w*, acompañados \w por|strong="H3881"\w* \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H1121"\w* \w tocaban|strong="H2690"\w* \w trompetas|strong="H2689"\w*);  
\v 13 \w cuando|strong="H3588"\w* \w los|strong="H1961"\w* trompetistas \w y|strong="H3588"\w* \w los|strong="H1961"\w* \w cantores|strong="H7891"\w* \w se|strong="H1961"\w* unieron \w a|strong="H3068"\w* una sola \w voz|strong="H6963"\w* \w para|strong="H3588"\w* \w alabar|strong="H1984"\w* \w y|strong="H3588"\w* dar gracias \w a|strong="H3068"\w* Yahvé, \w y|strong="H3588"\w* \w cuando|strong="H3588"\w* levantaron \w la|strong="H3588"\w* \w voz|strong="H6963"\w* al \w sonido|strong="H6963"\w* \w de|strong="H3588"\w* las \w trompetas|strong="H2689"\w*, \w los|strong="H1961"\w* platillos \w y|strong="H3588"\w* \w los|strong="H1961"\w* \w instrumentos|strong="H3627"\w* musicales, alabaron \w a|strong="H3068"\w* Yahvé \w cantando|strong="H7891"\w*:  
\q1 “\w Porque|strong="H3588"\w* \w él|strong="H3588"\w* \w es|strong="H1961"\w* \w bueno|strong="H2896"\w*,  
\q2 \w porque|strong="H3588"\w* \w su|strong="H3588"\w* fiel amor \w es|strong="H1961"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*”,  
\m \w en|strong="H3588"\w* ese momento una \w nube|strong="H6051"\w* \w llenó|strong="H4390"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé,  
\v 14 \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w causa|strong="H6440"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w nube|strong="H6051"\w*, \w los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* quedarse \w para|strong="H3588"\w* hacer \w su|strong="H3588"\w* servicio, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* Yahvé \w llenó|strong="H4390"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w*.   
\c 6  
\p
\v 1 Entonces \w Salomón|strong="H8010"\w* dijo: “Yahvé ha dicho que él habitaría en una nube oscura.  
\v 2 ¡Pero yo te he construido un \w templo|strong="H1004"\w* majestuoso, un lugar para que habites para \w siempre|strong="H5769"\w*!”   
\p
\v 3 Luego, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* se dio \w la|strong="H3605"\w* \w vuelta|strong="H5437"\w* y \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w mientras|strong="H3605"\w* \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* permanecían \w de|strong="H6440"\w* \w pie|strong="H5975"\w*.   
\p
\v 4 \w Y|strong="H3068"\w* \w dijo|strong="H1696"\w*: “\w Bendito|strong="H1288"\w* sea Yahvé, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, \w que|strong="H6310"\w* con sus propias \w manos|strong="H3027"\w* ha cumplido lo \w que|strong="H6310"\w* con su \w boca|strong="H6310"\w* le prometió \w a|strong="H3068"\w* mi padre \w David|strong="H1732"\w*, cuando le \w dijo|strong="H1696"\w*:  
\v 5 ‘\w Desde|strong="H4480"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H4480"\w* \w saqué|strong="H3318"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w*, \w no|strong="H3808"\w* elegí \w ninguna|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w de|strong="H4480"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w tribus|strong="H7626"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* construir un \w templo|strong="H1004"\w* \w donde|strong="H8033"\w* residiera \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w ni|strong="H3808"\w* elegí \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w para|strong="H5921"\w* \w que|strong="H4480"\w* \w fuera|strong="H1961"\w* \w el|strong="H5921"\w* líder \w de|strong="H4480"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*;  
\v 6 pero ahora he elegido \w a|strong="H3068"\w* Jerusalén \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w* \w esté|strong="H1961"\w* \w allí|strong="H8033"\w*, \w y|strong="H5921"\w* he elegido \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* gobierne \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*’.  
\v 7 \w Mi|strong="H1961"\w* padre \w David|strong="H1732"\w* \w tenía|strong="H1961"\w* \w el|strong="H5973"\w* profundo deseo \w de|strong="H5973"\w* construir un \w templo|strong="H1004"\w* \w en|strong="H5973"\w* honor al \w nombre|strong="H8034"\w* \w de|strong="H5973"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*.  
\v 8 \w Pero|strong="H3588"\w* Yahvé \w le|strong="H5973"\w* dijo: ‘Hiciste \w bien|strong="H2895"\w* \w en|strong="H5973"\w* \w tener|strong="H1961"\w* \w el|strong="H5973"\w* deseo \w de|strong="H3588"\w* construir un \w templo|strong="H1004"\w* \w en|strong="H5973"\w* honor \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*;  
\v 9 \w sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* serás tú \w quien|strong="H1931"\w* \w lo|strong="H1931"\w* construya, \w sino|strong="H3588"\w* tu propio \w hijo|strong="H1121"\w*; \w él|strong="H1931"\w* construirá \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w para|strong="H3588"\w* mi \w nombre|strong="H8034"\w*’.   
\p
\v 10 “Ahora Yahvé ha cumplido \w la|strong="H5921"\w* promesa \w que|strong="H5921"\w* \w hizo|strong="H1129"\w*, pues yo he tomado \w el|strong="H5921"\w* \w lugar|strong="H8478"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w David|strong="H1732"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* he \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w tal|strong="H1697"\w* \w como|strong="H5921"\w* Yahvé \w lo|strong="H1697"\w* prometió. \w Además|strong="H5921"\w*, he construido \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w en|strong="H5921"\w* honor \w al|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*,  
\v 11 y \w allí|strong="H8033"\w* he puesto \w el|strong="H5973"\w* arca \w que|strong="H1121"\w* contiene \w el|strong="H5973"\w* \w pacto|strong="H1285"\w* \w que|strong="H1121"\w* Yahvé \w hizo|strong="H3772"\w* \w con|strong="H5973"\w* \w los|strong="H1121"\w* israelitas”.   
\p
\v 12 Luego, Salomón se paró \w frente|strong="H5048"\w* al \w altar|strong="H4196"\w* \w de|strong="H6440"\w* Yahvé, \w a|strong="H3068"\w* \w la|strong="H3605"\w* vista \w de|strong="H6440"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, y levantó las \w manos|strong="H3709"\w*.  
\v 13 (\w Salomón|strong="H8010"\w* \w había|strong="H5975"\w* mandado \w hacer|strong="H6213"\w* una plataforma \w de|strong="H5921"\w* bronce \w que|strong="H3588"\w* medía dos metros \w y|strong="H3588"\w* cuarto \w de|strong="H5921"\w* largo, dos metros \w y|strong="H3588"\w* cuarto \w de|strong="H5921"\w* ancho, \w y|strong="H3588"\w* un metro \w y|strong="H3588"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* alto, \w y|strong="H3588"\w* \w la|strong="H5921"\w* \w había|strong="H5975"\w* colocado \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w del|strong="H5921"\w* patio. \w Se|strong="H5921"\w* paró \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*, \w se|strong="H5921"\w* arrodilló \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, levantó \w las|strong="H5921"\w* \w manos|strong="H3709"\w* \w hacia|strong="H6213"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*)  
\v 14 y dijo: “Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w no|strong="H6440"\w* hay \w Dios|strong="H3068"\w* \w como|strong="H3644"\w* tú en \w el|strong="H3605"\w* \w cielo|strong="H8064"\w* ni en \w la|strong="H8104"\w* tierra, \w que|strong="H3605"\w* cumpla su \w pacto|strong="H1285"\w* y muestre su fiel amor \w a|strong="H3068"\w* sus \w siervos|strong="H5650"\w* \w que|strong="H3605"\w* te \w siguen|strong="H1980"\w* \w de|strong="H6440"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*.  
\v 15 Tú le has cumplido \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*, mi padre, \w lo|strong="H2088"\w* \w que|strong="H3117"\w* le prometiste. \w Lo|strong="H2088"\w* \w que|strong="H3117"\w* \w dijiste|strong="H1696"\w* con tu \w boca|strong="H6310"\w*, \w hoy|strong="H3117"\w* \w lo|strong="H2088"\w* has hecho realidad con tu \w mano|strong="H3027"\w*.   
\p
\v 16 “\w Ahora|strong="H6258"\w*, Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, cumplele también \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* \w la|strong="H5921"\w* promesa \w que|strong="H3808"\w* \w le|strong="H5921"\w* hiciste \w cuando|strong="H5650"\w* \w dijiste|strong="H1696"\w*: ‘\w Nunca|strong="H3808"\w* \w te|strong="H5921"\w* \w faltará|strong="H3772"\w* un descendiente \w que|strong="H3808"\w* \w se|strong="H5921"\w* siente \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*, \w siempre|strong="H1980"\w* \w y|strong="H5921"\w* \w cuando|strong="H5650"\w* tus \w hijos|strong="H1121"\w* cuiden su conducta \w y|strong="H5921"\w* obedezcan \w mi|strong="H5921"\w* \w ley|strong="H8451"\w*, tal \w como|strong="H5921"\w* tú \w lo|strong="H3808"\w* has \w hecho|strong="H3772"\w*’.  
\v 17 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w ahora|strong="H6258"\w*, Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*, te ruego \w que|strong="H6258"\w* confirmes la promesa \w que|strong="H6258"\w* le hiciste \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*.   
\p
\v 18 “\w Pero|strong="H3588"\w*, ¿\w será|strong="H3808"\w* posible \w que|strong="H3588"\w* Dios habite \w con|strong="H5921"\w* \w los|strong="H3427"\w* seres humanos \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra? \w Si|strong="H3588"\w* \w ni|strong="H3808"\w* siquiera \w los|strong="H3427"\w* \w cielos|strong="H8064"\w* \w más|strong="H3588"\w* altos pueden contenerte, ¡mucho \w menos|strong="H3588"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* he construido!  
\v 19 Sin embargo, Yahvé, \w Dios|strong="H3068"\w* mío, atiende la \w oración|strong="H8605"\w* y la \w súplica|strong="H8467"\w* \w de|strong="H6440"\w* tu \w siervo|strong="H5650"\w*. \w Escucha|strong="H8085"\w* el \w clamor|strong="H7440"\w* y la \w oración|strong="H8605"\w* que te dirijo.  
\v 20 \w Que|strong="H1961"\w* tus \w ojos|strong="H5869"\w* \w estén|strong="H1961"\w* \w abiertos|strong="H6605"\w* \w de|strong="H5869"\w* \w día|strong="H3119"\w* y \w de|strong="H5869"\w* \w noche|strong="H3915"\w* \w sobre|strong="H1961"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w*, el \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* dijiste \w que|strong="H1961"\w* pondrías tu \w nombre|strong="H8034"\w*, \w para|strong="H1961"\w* \w que|strong="H1961"\w* escuches la \w oración|strong="H8605"\w* \w que|strong="H1961"\w* tu \w siervo|strong="H5650"\w* haga mirando \w hacia|strong="H8033"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 21 \w Escucha|strong="H8085"\w* las peticiones \w de|strong="H4480"\w* tu \w siervo|strong="H5650"\w* y \w de|strong="H4480"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w cuando|strong="H5650"\w* oren mirando \w hacia|strong="H4480"\w* \w acá|strong="H2088"\w*. \w Escucha|strong="H8085"\w* \w desde|strong="H4480"\w* \w el|strong="H3427"\w* \w cielo|strong="H8064"\w*, \w el|strong="H3427"\w* \w lugar|strong="H4725"\w* \w donde|strong="H4725"\w* \w habitas|strong="H3427"\w*, y \w cuando|strong="H5650"\w* escuches, perdónanos.   
\p
\v 22 “\w Si|strong="H6440"\w* alguien \w peca|strong="H2398"\w* \w contra|strong="H6440"\w* su \w prójimo|strong="H7453"\w* y se le exige \w que|strong="H2088"\w* haga un juramento, y viene \w a|strong="H3068"\w* jurar frente \w a|strong="H3068"\w* tu \w altar|strong="H4196"\w* en \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
