\p
\v 29 \w El|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w*, \w de|strong="H5921"\w* principio \w a|strong="H3068"\w* fin, \w está|strong="H1992"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w los|strong="H1992"\w* registros \w del|strong="H5921"\w* \w profeta|strong="H5030"\w* Natán, \w en|strong="H5921"\w* \w la|strong="H5921"\w* profecía \w de|strong="H5921"\w* \w Ahías|strong="H3379"\w* \w de|strong="H5921"\w* Siló, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H1992"\w* visiones \w del|strong="H5921"\w* \w vidente|strong="H2374"\w* Iddo \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Nabat|strong="H5028"\w*.  
\v 30 \w Salomón|strong="H8010"\w* \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* Jerusalén \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* durante cuarenta \w años|strong="H8141"\w*.  
\v 31 Cuando \w Salomón|strong="H8010"\w* murió, fue \w enterrado|strong="H6912"\w* \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*, su padre. \w Y|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Roboam|strong="H7346"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 10  
\p
\v 1 \w Roboam|strong="H7346"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* Siquem, \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas se habían reunido allí \w para|strong="H3588"\w* hacerlo \w rey|strong="H4427"\w*.  
\v 2 \w Cuando|strong="H1961"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Nabat|strong="H5028"\w*, \w que|strong="H1931"\w* \w estaba|strong="H1961"\w* en \w Egipto|strong="H4714"\w* adonde \w había|strong="H1961"\w* huido del \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*, \w se|strong="H1961"\w* enteró \w de|strong="H6440"\w* \w esto|strong="H1931"\w*, regresó \w de|strong="H6440"\w* \w Egipto|strong="H4714"\w*.  
\v 3 Entonces mandaron \w a|strong="H3068"\w* llamarlo, y \w Jeroboam|strong="H3379"\w* fue con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* con \w Roboam|strong="H7346"\w*. Le \w dijeron|strong="H1696"\w*:  
\v 4 “Tu padre \w nos|strong="H5921"\w* \w impuso|strong="H5414"\w* un trabajo muy \w pesado|strong="H3515"\w*. \w Si|strong="H5921"\w* \w ahora|strong="H6258"\w* tú \w nos|strong="H5921"\w* alivias \w del|strong="H5921"\w* trabajo \w duro|strong="H7186"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* \w pesado|strong="H3515"\w* \w yugo|strong="H5923"\w* \w que|strong="H6258"\w* \w él|strong="H5921"\w* \w nos|strong="H5921"\w* \w puso|strong="H5414"\w*, \w nosotros|strong="H5921"\w* \w te|strong="H5921"\w* \w serviremos|strong="H5647"\w*”.   
\p
\v 5 Él les \w respondió|strong="H7725"\w*: “Denme \w tres|strong="H7969"\w* \w días|strong="H3117"\w* y \w vuelvan|strong="H7725"\w* \w por|strong="H5750"\w* mi respuesta”.  
\p Así \w que|strong="H5971"\w* el \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* \w fue|strong="H3212"\w*.   
\p
\v 6 El \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* consultó \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w ancianos|strong="H2205"\w* \w que|strong="H5971"\w* \w habían|strong="H1961"\w* aconsejado \w a|strong="H3068"\w* su padre \w Salomón|strong="H8010"\w* mientras vivía, y les preguntó: “¿\w Qué|strong="H5971"\w* me aconsejan ustedes \w que|strong="H5971"\w* le \w responda|strong="H7725"\w* \w a|strong="H3068"\w* \w esta|strong="H2088"\w* \w gente|strong="H5971"\w*?”   
\p
\v 7 \w Ellos|strong="H3605"\w* le contestaron: “\w Si|strong="H1961"\w* \w eres|strong="H1961"\w* amable con \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, \w los|strong="H3605"\w* tratas \w bien|strong="H2896"\w* y les respondes con \w buenas|strong="H2896"\w* \w palabras|strong="H1697"\w*, \w ellos|strong="H3605"\w* \w serán|strong="H1961"\w* tus \w siervos|strong="H5650"\w* \w para|strong="H1961"\w* \w siempre|strong="H3605"\w*”.   
\p
\v 8 Pero Roboam rechazó el \w consejo|strong="H6098"\w* \w de|strong="H6440"\w* los \w ancianos|strong="H2205"\w*, y se fue \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* los jóvenes que habían \w crecido|strong="H1431"\w* con él y que ahora \w estaban|strong="H5975"\w* \w a|strong="H3068"\w* su servicio.  
\v 9 \w Les|strong="H5921"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w me|strong="H4480"\w* aconsejan ustedes \w que|strong="H4100"\w* \w le|strong="H5921"\w* \w responda|strong="H7725"\w* \w a|strong="H3068"\w* \w esta|strong="H2088"\w* \w gente|strong="H5971"\w* \w que|strong="H4100"\w* \w me|strong="H4480"\w* \w dijo|strong="H1696"\w*: ‘Alívianos \w del|strong="H4480"\w* \w yugo|strong="H5923"\w* \w que|strong="H4100"\w* tu padre \w nos|strong="H5921"\w* \w impuso|strong="H5414"\w*’?”   
\p
\v 10 \w Los|strong="H5921"\w* jóvenes \w que|strong="H5921"\w* habían \w crecido|strong="H1431"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w le|strong="H5921"\w* \w respondieron|strong="H1696"\w*: “\w A|strong="H3068"\w* esa \w gente|strong="H5971"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* \w dijo|strong="H1696"\w*: ‘Tu padre \w nos|strong="H5921"\w* impuso un trabajo pesado, alívianos \w de|strong="H5921"\w* esa carga’, tienes \w que|strong="H5921"\w* decirles \w esto|strong="H3541"\w*: ‘¡\w Mi|strong="H5921"\w* dedo meñique \w es|strong="H3541"\w* \w más|strong="H5921"\w* grueso \w que|strong="H5921"\w* \w la|strong="H5921"\w* cintura \w de|strong="H5921"\w* \w mi|strong="H5921"\w* padre!  
\v 11 \w Si|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w los|strong="H5921"\w* cargó \w con|strong="H5921"\w* un \w yugo|strong="H5923"\w* \w pesado|strong="H3515"\w*, ¡yo \w los|strong="H5921"\w* cargaré \w aún|strong="H3254"\w* \w más|strong="H3254"\w*! \w Si|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w los|strong="H5921"\w* castigó \w con|strong="H5921"\w* látigos, ¡yo \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w con|strong="H5921"\w* látigos \w que|strong="H6258"\w* tienen puntas \w de|strong="H5921"\w* metal!’”   
\p
\v 12 \w Al|strong="H4428"\w* tercer \w día|strong="H3117"\w*, \w Jeroboam|strong="H3379"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* regresaron \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w*, tal como \w el|strong="H3605"\w* \w rey|strong="H4428"\w* les había \w dicho|strong="H1696"\w*: “\w Vuelvan|strong="H7725"\w* \w por|strong="H4428"\w* mi respuesta en tres \w días|strong="H3117"\w*”.  
\v 13 Pero el \w rey|strong="H4428"\w* les \w respondió|strong="H6030"\w* con dureza. El \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* rechazó el \w consejo|strong="H6098"\w* de los \w ancianos|strong="H2205"\w*  
\v 14 \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w habló|strong="H1696"\w* \w como|strong="H5921"\w* \w le|strong="H5921"\w* aconsejaron \w los|strong="H5921"\w* jóvenes. \w Les|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w Mi|strong="H5921"\w* padre \w les|strong="H5921"\w* impuso un \w yugo|strong="H5923"\w* pesado, ¡pero yo \w se|strong="H5921"\w* \w lo|strong="H5921"\w* haré \w aún|strong="H3254"\w* \w más|strong="H3254"\w* pesado! \w Mi|strong="H5921"\w* padre \w los|strong="H5921"\w* castigó \w con|strong="H5921"\w* látigos, ¡pero yo \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w con|strong="H5921"\w* látigos \w que|strong="H5921"\w* tienen puntas \w de|strong="H5921"\w* metal!”   
\p
\v 15 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* quiso \w escuchar|strong="H8085"\w* \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w*, \w pues|strong="H3588"\w* \w esto|strong="H1697"\w* \w era|strong="H1961"\w* plan \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w para|strong="H4616"\w* \w que|strong="H3588"\w* Yahvé cumpliera \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w que|strong="H3588"\w* \w le|strong="H5973"\w* \w había|strong="H1961"\w* dado \w a|strong="H3068"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Nabat|strong="H5028"\w*, \w por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* \w Ahías|strong="H3379"\w* \w de|strong="H3588"\w* Siló.   
\p
\v 16 \w Cuando|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* israelitas \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* \w les|strong="H1992"\w* hacía caso, le \w respondieron|strong="H7725"\w*: “¿\w Qué|strong="H3588"\w* tenemos \w que|strong="H3588"\w* \w ver|strong="H7200"\w* \w nosotros|strong="H3605"\w* \w con|strong="H3588"\w* \w David|strong="H1732"\w*? ¡\w No|strong="H3808"\w* tenemos \w herencia|strong="H5159"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Isaí|strong="H3448"\w*! ¡Israelitas, regrese \w cada|strong="H3605"\w* uno \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w casa|strong="H1004"\w*! \w Y|strong="H3068"\w* tú, \w David|strong="H1732"\w*, ¡cuida \w de|strong="H3588"\w* tu propia \w familia|strong="H1004"\w*!” \w Y|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* israelitas regresaron \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w casas|strong="H1004"\w*.   
\p
\v 17 Así \w que|strong="H5921"\w* \w Roboam|strong="H7346"\w* solo \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w los|strong="H3427"\w* israelitas \w que|strong="H5921"\w* \w vivían|strong="H3427"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 18 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Adoniram, \w que|strong="H5921"\w* \w era|strong="H1121"\w* \w el|strong="H5921"\w* encargado \w de|strong="H5921"\w* \w los|strong="H1121"\w* trabajos forzados, pero \w los|strong="H1121"\w* israelitas \w lo|strong="H5921"\w* \w mataron|strong="H4191"\w* \w a|strong="H3068"\w* pedradas. Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* \w se|strong="H5921"\w* \w subió|strong="H5927"\w* rápidamente \w a|strong="H3068"\w* su \w carro|strong="H4818"\w* \w de|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* Jerusalén.  
\v 19 \w Así|strong="H2088"\w* fue \w como|strong="H5704"\w* \w Israel|strong="H3478"\w* se rebeló \w contra|strong="H3478"\w* la \w familia|strong="H1004"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w*, \w y|strong="H5704"\w* \w así|strong="H2088"\w* sigue \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*.   
\c 11  
\p
\v 1 Cuando \w Roboam|strong="H7346"\w* llegó \w a|strong="H3068"\w* Jerusalén, reunió \w a|strong="H3068"\w* las tribus \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* y \w de|strong="H5973"\w* \w Benjamín|strong="H1144"\w*, \w a|strong="H3068"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w mil|strong="H3967"\w* \w guerreros|strong="H6213"\w* escogidos, \w para|strong="H5973"\w* pelear \w contra|strong="H5973"\w* \w Israel|strong="H3478"\w* y recuperar su \w reino|strong="H4467"\w*.  
\v 2 Pero Yahvé le dio \w este|strong="H1961"\w* mensaje \w a|strong="H3068"\w* \w Semaías|strong="H8098"\w*, hombre \w de|strong="H1697"\w* \w Dios|strong="H3068"\w*:  
\v 3 “Dile \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas en \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*:  
\v 4 ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: \w No|strong="H3808"\w* salgan \w a|strong="H3068"\w* pelear \w contra|strong="H5973"\w* sus propios hermanos. Regrese \w cada|strong="H1697"\w* uno \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*, \w porque|strong="H3588"\w* \w esto|strong="H2088"\w* \w ha|strong="H3541"\w* \w sido|strong="H1961"\w* obra mía’”. Ellos \w obedecieron|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5973"\w* \w Jeroboam|strong="H3379"\w*.   
\p
\v 5 \w Roboam|strong="H7346"\w* se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir en Jerusalén y construyó \w ciudades|strong="H5892"\w* \w fortificadas|strong="H4692"\w* en \w Judá|strong="H3063"\w* para su defensa.  
\v 6 Fortificó \w a|strong="H3068"\w* Belén, Etam, Tecoa,  
\v 7 Bet Zur, Soco, Adulam,  
\v 8 Gat, \w Maresa|strong="H4762"\w*, Zif,  
\v 9 Adoraim, Laquis, \w Azeca|strong="H5825"\w*,  
\v 10 Zora, Ajalón y \w Hebrón|strong="H2275"\w*. Estas eran \w ciudades|strong="H5892"\w* fortificadas en \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*.  
\v 11 Reforzó las defensas, \w puso|strong="H5414"\w* comandantes en ellas y almacenó alimentos, \w aceite|strong="H8081"\w* y \w vino|strong="H3196"\w*.  
\v 12 Puso \w escudos|strong="H6793"\w* y \w lanzas|strong="H7420"\w* en \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* y las hizo \w muy|strong="H3966"\w* fuertes. \w Así|strong="H2388"\w* \w retuvo|strong="H2388"\w* \w el|strong="H3605"\w* control \w sobre|strong="H1961"\w* \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*.   
\p
\v 13 \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w que|strong="H5921"\w* vivían \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* dejaron sus territorios \w y|strong="H5921"\w* \w se|strong="H5921"\w* unieron \w a|strong="H3068"\w* \w él|strong="H5921"\w*.  
\v 14 \w Los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w dejaron|strong="H5800"\w* sus campos \w de|strong="H3588"\w* pastoreo \w y|strong="H3588"\w* sus propiedades, \w y|strong="H3588"\w* se mudaron \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* Jerusalén, \w porque|strong="H3588"\w* \w Jeroboam|strong="H3379"\w* \w y|strong="H3588"\w* sus \w hijos|strong="H1121"\w* les prohibieron servir \w como|strong="H3588"\w* sacerdotes \w de|strong="H3588"\w* Yahvé.  
\v 15 Jeroboam nombró \w a|strong="H3068"\w* sus propios \w sacerdotes|strong="H3548"\w* para los \w altares|strong="H1116"\w* paganos, y para que adoraran \w a|strong="H3068"\w* los ídolos con forma de chivos y de \w becerros|strong="H5695"\w* que \w él|strong="H6213"\w* \w había|strong="H5975"\w* mandado \w hacer|strong="H6213"\w*.  
\v 16 Detrás \w de|strong="H5414"\w* \w los|strong="H3605"\w* levitas, gente \w de|strong="H5414"\w* \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w* \w que|strong="H3605"\w* buscaban \w de|strong="H5414"\w* \w corazón|strong="H3824"\w* \w a|strong="H3068"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*, fue \w a|strong="H3068"\w* Jerusalén \w para|strong="H5414"\w* ofrecer \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* sus antepasados.  
\v 17 \w De|strong="H3588"\w* esta manera fortalecieron \w el|strong="H3588"\w* \w reino|strong="H4438"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* apoyaron \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Salomón|strong="H8010"\w* durante \w tres|strong="H7969"\w* \w años|strong="H8141"\w*, ya \w que|strong="H3588"\w* durante ese tiempo \w siguieron|strong="H1980"\w* \w el|strong="H3588"\w* buen ejemplo \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w Salomón|strong="H8010"\w*.   
\p
\v 18 \w Roboam|strong="H7346"\w* se \w casó|strong="H3947"\w* con Mahalat, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Jerimot (\w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*) y \w de|strong="H1121"\w* Abihail, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Eliab y nieta \w de|strong="H1121"\w* \w Isaí|strong="H3448"\w*.  
\v 19 Ella le dio tres \w hijos|strong="H1121"\w*: \w Jeús|strong="H3266"\w*, \w Semarías|strong="H8114"\w* y Zaham.  
\v 20 Después se \w casó|strong="H3947"\w* con Maaca, nieta de Absalón, y con ella tuvo \w a|strong="H3068"\w* Abías, Atai, \w Ziza|strong="H2124"\w* y Selomit.  
\v 21 \w Roboam|strong="H7346"\w* amó \w a|strong="H3068"\w* Maaca \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* sus otras esposas \w y|strong="H3588"\w* \w concubinas|strong="H6370"\w* (llegó \w a|strong="H3068"\w* tener \w dieciocho|strong="H8083"\w* esposas \w y|strong="H3588"\w* \w sesenta|strong="H8346"\w* \w concubinas|strong="H6370"\w*, \w con|strong="H3588"\w* las \w que|strong="H3588"\w* \w tuvo|strong="H5375"\w* \w veintiocho|strong="H6242"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w sesenta|strong="H8346"\w* \w hijas|strong="H1323"\w*).  
\v 22 \w Roboam|strong="H7346"\w* nombró \w a|strong="H3068"\w* Abías, \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Maaca, \w como|strong="H3588"\w* \w jefe|strong="H7218"\w* \w y|strong="H3588"\w* \w príncipe|strong="H5057"\w* sobre sus hermanos, \w pues|strong="H3588"\w* planeaba hacerlo \w rey|strong="H4427"\w*.  
\v 23 Actuó \w de|strong="H1121"\w* manera inteligente y distribuyó \w a|strong="H3068"\w* algunos \w de|strong="H1121"\w* sus \w hijos|strong="H1121"\w* \w por|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* territorios \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*, \w poniéndolos|strong="H5414"\w* \w a|strong="H3068"\w* cargo \w de|strong="H1121"\w* las \w ciudades|strong="H5892"\w* fortificadas. Les \w dio|strong="H5414"\w* \w muchas|strong="H7230"\w* provisiones y les consiguió \w muchas|strong="H7230"\w* esposas.   
\c 12  
\p
\v 1 \w Cuando|strong="H1961"\w* \w Roboam|strong="H7346"\w* consolidó su \w reino|strong="H4438"\w* y \w se|strong="H1961"\w* hizo fuerte, \w él|strong="H5973"\w* y \w todo|strong="H3605"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5973"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w* abandonaron \w la|strong="H3605"\w* \w ley|strong="H8451"\w* \w de|strong="H5973"\w* Yahvé.  
\v 2 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w quinto|strong="H2549"\w* \w año|strong="H8141"\w* \w del|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* \w Roboam|strong="H7346"\w*, \w Sisac|strong="H7895"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, atacó Jerusalén, \w porque|strong="H3588"\w* \w los|strong="H5921"\w* israelitas \w le|strong="H5921"\w* \w habían|strong="H1961"\w* \w sido|strong="H1961"\w* infieles \w a|strong="H3068"\w* Yahvé.  
\v 3 Sisac llegó \w con|strong="H5973"\w* \w mil|strong="H3967"\w* \w doscientos|strong="H3967"\w* \w carros|strong="H7393"\w* \w de|strong="H5973"\w* guerra, \w sesenta|strong="H8346"\w* \w mil|strong="H3967"\w* \w jinetes|strong="H6571"\w* y un ejército innumerable \w que|strong="H5971"\w* venía \w con|strong="H5973"\w* \w él|strong="H5973"\w* desde \w Egipto|strong="H4714"\w*: libios, suquienos y etíopes.  
\v 4 Capturó las \w ciudades|strong="H5892"\w* fortificadas \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* \w y|strong="H5704"\w* avanzó \w hasta|strong="H5704"\w* Jerusalén.  
\v 5 Entonces \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Semaías|strong="H8098"\w* \w fue|strong="H3063"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Roboam|strong="H7346"\w* \w y|strong="H3541"\w* \w a|strong="H3068"\w* los líderes \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w que|strong="H3541"\w* se habían reunido en Jerusalén \w por|strong="H6440"\w* miedo \w a|strong="H3068"\w* \w Sisac|strong="H7895"\w*, \w y|strong="H3541"\w* les dijo: “Yahvé dice: ‘Ustedes \w me|strong="H3541"\w* han abandonado, \w así|strong="H3541"\w* \w que|strong="H3541"\w* \w ahora|strong="H3541"\w* yo los abandono en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* \w Sisac|strong="H7895"\w*’”.   
\p
\v 6 Los líderes \w de|strong="H8269"\w* \w Israel|strong="H3478"\w* y el \w rey|strong="H4428"\w* se humillaron y dijeron: “Yahvé es \w justo|strong="H6662"\w*”.   
\p
\v 7 \w Cuando|strong="H3588"\w* Yahvé \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* \w habían|strong="H1961"\w* \w humillado|strong="H3665"\w*, le \w dio|strong="H5414"\w* \w este|strong="H1961"\w* mensaje \w a|strong="H3068"\w* \w Semaías|strong="H8098"\w*: “\w Como|strong="H3588"\w* \w se|strong="H1961"\w* han \w humillado|strong="H3665"\w*, \w no|strong="H3808"\w* \w los|strong="H1992"\w* voy \w a|strong="H3068"\w* \w destruir|strong="H7843"\w*. Pronto \w los|strong="H1992"\w* \w salvaré|strong="H5414"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* derramaré \w mi|strong="H3389"\w* \w enojo|strong="H2534"\w* \w sobre|strong="H1961"\w* Jerusalén \w por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* \w Sisac|strong="H7895"\w*.  
\v 8 Sin embargo, \w serán|strong="H1961"\w* dominados \w por|strong="H3588"\w* \w él|strong="H3588"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* aprendan \w la|strong="H3588"\w* diferencia \w entre|strong="H3588"\w* servirme \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w y|strong="H3588"\w* servir \w a|strong="H3068"\w* \w los|strong="H3588"\w* reyes \w de|strong="H3588"\w* otras naciones”.   
\p
\v 9 Así \w que|strong="H5921"\w* \w Sisac|strong="H7895"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, atacó Jerusalén \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w llevó|strong="H3947"\w* \w los|strong="H5921"\w* tesoros \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w del|strong="H5921"\w* palacio \w real|strong="H4428"\w*. ¡\w Se|strong="H5921"\w* \w lo|strong="H5921"\w* \w llevó|strong="H3947"\w* \w todo|strong="H3605"\w*! También \w se|strong="H5921"\w* \w llevó|strong="H3947"\w* \w los|strong="H5921"\w* \w escudos|strong="H4043"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w Salomón|strong="H8010"\w*.  
\v 10 \w Para|strong="H5921"\w* reemplazarlos, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* mandó \w hacer|strong="H6213"\w* \w escudos|strong="H4043"\w* \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* entregó \w a|strong="H3068"\w* \w los|strong="H5921"\w* oficiales \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia \w que|strong="H5921"\w* cuidaban \w la|strong="H5921"\w* entrada \w del|strong="H5921"\w* palacio \w real|strong="H4428"\w*.  
\v 11 Cada vez \w que|strong="H1961"\w* el \w rey|strong="H4428"\w* iba \w al|strong="H4428"\w* \w templo|strong="H1004"\w* de Yahvé, \w los|strong="H1961"\w* guardias sacaban \w los|strong="H1961"\w* escudos y \w después|strong="H1961"\w* \w los|strong="H1961"\w* regresaban \w al|strong="H4428"\w* cuarto de guardia.  
\v 12 \w Como|strong="H1571"\w* Roboam \w se|strong="H1961"\w* humilló, \w la|strong="H1571"\w* ira \w de|strong="H4480"\w* Yahvé \w se|strong="H1961"\w* apartó \w de|strong="H4480"\w* \w él|strong="H1571"\w* \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w lo|strong="H1697"\w* \w destruyó|strong="H7843"\w* \w por|strong="H4480"\w* completo. \w Además|strong="H4480"\w*, todavía \w había|strong="H1961"\w* \w cosas|strong="H1697"\w* \w buenas|strong="H2896"\w* \w en|strong="H4480"\w* \w Judá|strong="H3063"\w*.   
\p
\v 13 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w Roboam|strong="H7346"\w* se consolidó \w en|strong="H3588"\w* \w el|strong="H3588"\w* poder \w en|strong="H3588"\w* Jerusalén \w y|strong="H3588"\w* siguió reinando. \w Roboam|strong="H7346"\w* tenía cuarenta \w y|strong="H3588"\w* un \w años|strong="H8141"\w* \w cuando|strong="H3588"\w* comenzó \w a|strong="H3068"\w* reinar, \w y|strong="H3588"\w* \w reinó|strong="H4427"\w* \w diecisiete|strong="H7651"\w* \w años|strong="H8141"\w* \w en|strong="H3588"\w* Jerusalén, \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* elegido \w de|strong="H3588"\w* \w entre|strong="H3588"\w* \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w para|strong="H3588"\w* poner \w allí|strong="H8033"\w* \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*. \w Su|strong="H3588"\w* madre se \w llamaba|strong="H8034"\w* Naamá, \w y|strong="H3588"\w* \w era|strong="H8141"\w* amonita.  
\v 14 \w Pero|strong="H3588"\w* Roboam \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w malo|strong="H7451"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w buscó|strong="H1875"\w* \w a|strong="H3068"\w* Yahvé \w de|strong="H3588"\w* todo \w corazón|strong="H3820"\w*.   
\p
\v 15 \w La|strong="H3605"\w* historia \w de|strong="H1697"\w* \w Roboam|strong="H7346"\w*, \w de|strong="H1697"\w* principio \w a|strong="H3068"\w* fin, \w está|strong="H1992"\w* \w escrita|strong="H3789"\w* en \w los|strong="H1992"\w* registros del \w profeta|strong="H5030"\w* \w Semaías|strong="H8098"\w* y del \w vidente|strong="H2374"\w* \w Iddo|strong="H5714"\w*, en \w los|strong="H1992"\w* registros genealógicos. Durante \w todo|strong="H3605"\w* ese \w tiempo|strong="H3117"\w*, hubo \w guerra|strong="H4421"\w* \w entre|strong="H3808"\w* \w Roboam|strong="H7346"\w* y \w Jeroboam|strong="H3379"\w*.  
\v 16 Cuando \w Roboam|strong="H7346"\w* murió, fue \w enterrado|strong="H6912"\w* \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*, y su \w hijo|strong="H1121"\w* Abías \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 13  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w*, Abías comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 2 \w Reinó|strong="H4427"\w* \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w en|strong="H4480"\w* Jerusalén. Su madre \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Micaías, \w hija|strong="H1323"\w* \w de|strong="H4480"\w* Uriel \w de|strong="H4480"\w* Guibeá. \w Y|strong="H3068"\w* \w hubo|strong="H1961"\w* \w guerra|strong="H4421"\w* \w entre|strong="H4480"\w* Abías y \w Jeroboam|strong="H3379"\w*.  
\v 3 Abías se preparó \w para|strong="H5973"\w* la \w batalla|strong="H4421"\w* \w con|strong="H5973"\w* un \w ejército|strong="H2428"\w* \w de|strong="H5973"\w* guerreros \w valientes|strong="H1368"\w*, cuatrocientos \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* bien escogidos. Por su parte, \w Jeroboam|strong="H3379"\w* formó sus tropas \w contra|strong="H5973"\w* \w él|strong="H5973"\w* \w con|strong="H5973"\w* \w ochocientos|strong="H8083"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* escogidos, que también eran muy \w valientes|strong="H1368"\w*.  
\v 4 Abías \w se|strong="H5921"\w* paró \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* Zemaraim, \w que|strong="H5921"\w* \w está|strong="H6965"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* región montañosa \w de|strong="H5921"\w* Efraín, \w y|strong="H5921"\w* gritó: “¡Escúchenme, \w Jeroboam|strong="H3379"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*!  
\v 5 ¿\w No|strong="H3808"\w* \w saben|strong="H3045"\w* acaso \w que|strong="H3588"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* \w el|strong="H5921"\w* \w reino|strong="H4467"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*? \w Se|strong="H3045"\w* \w lo|strong="H3808"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus descendientes mediante un \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* \w sal|strong="H4417"\w* inquebrantable.  
\v 6 Pero \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Nabat|strong="H5028"\w*, \w siervo|strong="H5650"\w* \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w se|strong="H5921"\w* \w levantó|strong="H6965"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* rebeló \w contra|strong="H5921"\w* su señor.  
\v 7 \w Se|strong="H1961"\w* \w le|strong="H5921"\w* unieron \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* peor clase, rebeldes \w perversos|strong="H1121"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* hicieron \w fuertes|strong="H1121"\w* \w contra|strong="H5921"\w* \w Roboam|strong="H7346"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Salomón|strong="H8010"\w*, \w cuando|strong="H1961"\w* \w Roboam|strong="H7346"\w* \w aún|strong="H3808"\w* \w era|strong="H1961"\w* joven \w e|strong="H3068"\w* inexperto, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w tuvo|strong="H1961"\w* \w la|strong="H5921"\w* fuerza \w para|strong="H5921"\w* hacerles frente.   
\p
\v 8 “¡\w Y|strong="H3068"\w* \w ahora|strong="H6258"\w* ustedes pretenden enfrentarse al \w reino|strong="H4467"\w* \w de|strong="H6440"\w* Yahvé, \w que|strong="H6258"\w* está \w en|strong="H5973"\w* \w manos|strong="H3027"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H6440"\w* \w David|strong="H1732"\w*! Son una inmensa \w multitud|strong="H1995"\w*, y traen \w con|strong="H5973"\w* ustedes \w los|strong="H1121"\w* \w becerros|strong="H5695"\w* \w de|strong="H6440"\w* \w oro|strong="H2091"\w* \w que|strong="H6258"\w* \w Jeroboam|strong="H3379"\w* \w les|strong="H5973"\w* \w hizo|strong="H6213"\w* \w para|strong="H5973"\w* \w que|strong="H6258"\w* fueran sus dioses.  
\v 9 ¿Acaso \w no|strong="H3808"\w* expulsaron ustedes \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H1121"\w* Yahvé, \w a|strong="H3068"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Aarón \w y|strong="H1241"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*, \w para|strong="H1961"\w* nombrar \w a|strong="H3068"\w* sus propios \w sacerdotes|strong="H3548"\w* \w como|strong="H1961"\w* \w lo|strong="H3808"\w* \w hacen|strong="H6213"\w* \w los|strong="H1121"\w* \w pueblos|strong="H5971"\w* paganos? Ahora, \w cualquiera|strong="H3605"\w* \w que|strong="H3808"\w* viene \w a|strong="H3068"\w* consagrarse con un \w toro|strong="H6499"\w* joven \w y|strong="H1241"\w* \w siete|strong="H7651"\w* carneros, puede ser \w sacerdote|strong="H3548"\w* \w de|strong="H1121"\w* esos \w que|strong="H3808"\w* \w ni|strong="H3808"\w* siquiera \w son|strong="H1961"\w* dioses.   
\p
\v 10 “Pero en cuanto \w a|strong="H3068"\w* nosotros, Yahvé es nuestro \w Dios|strong="H3068"\w* y \w no|strong="H3808"\w* \w lo|strong="H3808"\w* hemos abandonado. Tenemos \w sacerdotes|strong="H3548"\w* \w que|strong="H3808"\w* sirven \w a|strong="H3068"\w* Yahvé, \w que|strong="H3808"\w* \w son|strong="H3808"\w* descendientes \w de|strong="H1121"\w* Aarón, y \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w los|strong="H1121"\w* ayudan en \w el|strong="H1121"\w* servicio.  
\v 11 Todas \w las|strong="H5921"\w* mañanas \w y|strong="H3588"\w* todas \w las|strong="H5921"\w* tardes \w le|strong="H5921"\w* ofrecen \w a|strong="H3068"\w* Yahvé \w holocaustos|strong="H5930"\w* \w e|strong="H3068"\w* incienso \w aromático|strong="H5561"\w*. \w También|strong="H7979"\w* acomodan \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* presencia \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*, \w y|strong="H3588"\w* \w encienden|strong="H1197"\w* \w el|strong="H5921"\w* candelabro \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w con|strong="H5921"\w* sus \w lámparas|strong="H5216"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* arda todas \w las|strong="H5921"\w* tardes. \w Nosotros|strong="H5921"\w* \w sí|strong="H3588"\w* obedecemos \w las|strong="H5921"\w* \w órdenes|strong="H4635"\w* \w de|strong="H5921"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, \w pero|strong="H3588"\w* ustedes \w lo|strong="H5921"\w* han abandonado.  
\v 12 ¡Miren! \w Dios|strong="H3068"\w* mismo \w está|strong="H5921"\w* \w al|strong="H5921"\w* frente \w de|strong="H5921"\w* \w nosotros|strong="H5973"\w*. \w Aquí|strong="H2009"\w* \w están|strong="H2009"\w* sus \w sacerdotes|strong="H3548"\w*, listos \w para|strong="H5921"\w* tocar \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w* \w y|strong="H3588"\w* dar \w la|strong="H5921"\w* señal \w de|strong="H5921"\w* ataque \w contra|strong="H5921"\w* ustedes. Israelitas, \w no|strong="H3808"\w* peleen \w contra|strong="H5921"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* sus antepasados, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* van \w a|strong="H3068"\w* ganar”.   
\p
\v 13 Sin embargo, \w Jeroboam|strong="H3379"\w* envió tropas \w a|strong="H3068"\w* escondidas \w para|strong="H1961"\w* atacarlos \w por|strong="H6440"\w* la espalda. \w De|strong="H6440"\w* \w esta|strong="H1961"\w* manera, el ejército principal \w estaba|strong="H1961"\w* frente \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, y la emboscada \w estaba|strong="H1961"\w* \w a|strong="H3068"\w* sus espaldas.  
\v 14 Cuando los \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* voltearon, se dieron cuenta \w de|strong="H6440"\w* que los atacaban \w por|strong="H6440"\w* el frente y \w por|strong="H6440"\w* la retaguardia. Entonces le gritaron \w a|strong="H3068"\w* Yahvé pidiendo ayuda, mientras los \w sacerdotes|strong="H3548"\w* \w tocaban|strong="H2690"\w* las \w trompetas|strong="H2689"\w*.  
\v 15 \w Los|strong="H3605"\w* hombres \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* lanzaron su grito \w de|strong="H6440"\w* batalla, y al escuchar ese grito, Dios derrotó \w a|strong="H3068"\w* \w Jeroboam|strong="H3379"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* frente \w a|strong="H3068"\w* Abías y las tropas \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*.  
\v 16 \w Los|strong="H1121"\w* israelitas \w huyeron|strong="H5127"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, y Dios \w los|strong="H1121"\w* \w entregó|strong="H5414"\w* en sus \w manos|strong="H3027"\w*.  
\v 17 Abías y su ejército causaron una enorme masacre entre ellos. Ese día \w cayeron|strong="H5307"\w* \w muertos|strong="H2491"\w* \w quinientos|strong="H2568"\w* \w mil|strong="H3967"\w* hombres escogidos \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Así|strong="H3588"\w* fueron humillados \w los|strong="H1121"\w* israelitas \w en|strong="H5921"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w y|strong="H3588"\w* \w los|strong="H1121"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* ganaron \w la|strong="H1931"\w* batalla \w porque|strong="H3588"\w* confiaron \w en|strong="H5921"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w sus|strong="H1931"\w* antepasados.  
\v 19 Abías \w persiguió|strong="H7291"\w* \w a|strong="H3068"\w* \w Jeroboam|strong="H3379"\w* y le quitó varias \w ciudades|strong="H5892"\w*, incluyendo Betel, Jesana y Efrón, junto \w con|strong="H4480"\w* sus respectivas \w aldeas|strong="H1323"\w*.   
\p
\v 20 \w Jeroboam|strong="H3379"\w* \w no|strong="H3808"\w* \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* recuperar su poderío \w mientras|strong="H5750"\w* Abías \w vivió|strong="H3117"\w*. Finalmente, el \w Señor|strong="H3068"\w* \w lo|strong="H3808"\w* \w hirió|strong="H5062"\w* y \w murió|strong="H4191"\w*.  
\v 21 Abías, en cambio, se hizo cada vez más \w poderoso|strong="H2388"\w*. \w Tuvo|strong="H5375"\w* catorce esposas, y fue padre \w de|strong="H1121"\w* \w veintidós|strong="H6242"\w* \w hijos|strong="H1121"\w* y \w dieciséis|strong="H8337"\w* \w hijas|strong="H1323"\w*.  
\v 22 \w El|strong="H5030"\w* \w resto|strong="H3499"\w* \w de|strong="H1697"\w* la historia \w de|strong="H1697"\w* Abías, todo \w lo|strong="H1697"\w* \w que|strong="H1697"\w* hizo y \w lo|strong="H1697"\w* \w que|strong="H1697"\w* dijo, \w está|strong="H3789"\w* \w escrito|strong="H3789"\w* en los comentarios del \w profeta|strong="H5030"\w* \w Iddo|strong="H5714"\w*.   
\c 14  
\p
\v 1 Abías murió y fue enterrado en la Ciudad \w de|strong="H5869"\w* David. Su hijo Asá reinó en su lugar, y durante su reinado, \w el|strong="H6213"\w* país \w tuvo|strong="H6213"\w* paz por diez años.  
\v 2 Asá hizo lo que era bueno y correcto \w a|strong="H3068"\w* los ojos de Yahvé su Dios.  
\v 3 Quitó los altares paganos y los santuarios en las colinas, \w hizo|strong="H6213"\w* pedazos las piedras sagradas y cortó los postes dedicados \w a|strong="H3068"\w* la diosa Asera.  
\v 4 Le ordenó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* \w que|strong="H3605"\w* buscara \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* Dios \w de|strong="H6440"\w* sus antepasados, y \w que|strong="H3605"\w* obedeciera sus leyes y mandamientos.  
\v 5 También quitó \w de|strong="H3588"\w* todas las \w ciudades|strong="H5892"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w los|strong="H5973"\w* santuarios \w en|strong="H5973"\w* las colinas \w y|strong="H3588"\w* \w los|strong="H5973"\w* altares \w para|strong="H3588"\w* quemar incienso, \w y|strong="H3588"\w* \w el|strong="H5973"\w* reino tuvo paz bajo \w su|strong="H3588"\w* gobierno.  
\v 6 \w Como|strong="H3588"\w* \w el|strong="H3588"\w* país estaba \w en|strong="H3588"\w* paz \w y|strong="H3588"\w* \w no|strong="H3588"\w* tuvo guerras \w en|strong="H3588"\w* esos años, Asá pudo construir \w ciudades|strong="H5892"\w* fortificadas \w en|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w pues|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* le \w había|strong="H3588"\w* dado tranquilidad.  
\v 7 Asá le dijo \w a|strong="H3068"\w* \w la|strong="H3605"\w* gente de \w Judá|strong="H3063"\w*: “Vamos \w a|strong="H3068"\w* construir estas ciudades y \w a|strong="H3068"\w* rodearlas de murallas, torres, \w puertas|strong="H7969"\w* y barras de hierro. \w La|strong="H3605"\w* tierra todavía \w es|strong="H1961"\w* nuestra, porque hemos buscado \w a|strong="H3068"\w* Yahvé nuestro Dios. \w Lo|strong="H3605"\w* hemos buscado, y \w él|strong="H3605"\w* nos ha dado paz en \w todas|strong="H3605"\w* nuestras fronteras”. Así \w que|strong="H1869"\w* construyeron y \w tuvieron|strong="H1961"\w* éxito.   
\p
\v 8 Asá tenía un \w ejército|strong="H2428"\w* \w de|strong="H5704"\w* \w trescientos|strong="H7969"\w* \w mil|strong="H3967"\w* hombres \w de|strong="H5704"\w* Judá, armados \w con|strong="H5704"\w* escudos grandes \w y|strong="H5704"\w* lanzas, \w y|strong="H5704"\w* \w doscientos|strong="H3967"\w* ochenta \w mil|strong="H3967"\w* hombres \w de|strong="H5704"\w* Benjamín, armados \w con|strong="H5704"\w* escudos pequeños \w y|strong="H5704"\w* arcos. Todos ellos eran soldados muy \w valientes|strong="H2428"\w*.   
\p
\v 9 Zéraj el etíope los atacó con un ejército \w de|strong="H6440"\w* un millón \w de|strong="H6440"\w* soldados y trescientos carros \w de|strong="H6440"\w* \w guerra|strong="H4421"\w*, y llegó hasta la ciudad \w de|strong="H6440"\w* \w Maresa|strong="H4762"\w*.  
\v 10 Asá salió \w a|strong="H3068"\w* enfrentarlo, \w y|strong="H3588"\w* \w los|strong="H5921"\w* dos ejércitos tomaron posiciones \w de|strong="H5921"\w* batalla \w en|strong="H5921"\w* \w el|strong="H5921"\w* valle \w de|strong="H5921"\w* Sefata, \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* Maresa.  
\v 11 Entonces Asá le rogó \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*, diciendo: “¡\w Señor|strong="H3068"\w*, \w no|strong="H6440"\w* hay nadie como tú para ayudar \w a|strong="H3068"\w* los débiles \w contra|strong="H6440"\w* los poderosos! Ayúdanos, Yahvé nuestro \w Dios|strong="H3068"\w*, \w porque|strong="H6440"\w* confiamos en ti, y en tu nombre venimos \w a|strong="H3068"\w* enfrentar \w a|strong="H3068"\w* esta inmensa multitud. Yahvé, tú eres nuestro \w Dios|strong="H3068"\w*. ¡\w No|strong="H6440"\w* dejes que simples hombres te derroten!”   
\p
\v 12 \w El|strong="H5973"\w* \w Señor|strong="H3068"\w* derrotó \w a|strong="H3068"\w* \w los|strong="H1992"\w* etíopes frente \w a|strong="H3068"\w* Asá \w y|strong="H3588"\w* \w al|strong="H5704"\w* \w ejército|strong="H4264"\w* \w de|strong="H3588"\w* Judá, \w y|strong="H3588"\w* \w los|strong="H1992"\w* etíopes huyeron.  
\v 13 Asá \w y|strong="H3588"\w* sus hombres \w los|strong="H5921"\w* persiguieron \w hasta|strong="H5921"\w* \w Gerar|strong="H1642"\w*. Murieron tantos etíopes \w que|strong="H3588"\w* \w su|strong="H3588"\w* ejército \w quedó|strong="H1961"\w* destruido \w por|strong="H5921"\w* completo ante \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w y|strong="H3588"\w* sus fuerzas. \w Los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Judá \w se|strong="H1961"\w* llevaron muchísimo botín.  
\v 14 Atacaron todas las ciudades alrededor de Gerar, porque \w el|strong="H1571"\w* terror de Yahvé había caído sobre ellas. Las saquearon todas, \w pues|strong="H1571"\w* había \w muchas|strong="H7230"\w* riquezas allí.  
\v 15 También atacaron los campamentos de los pastores y se llevaron muchísimas ovejas y camellos. Después regresaron \w a|strong="H3068"\w* Jerusalén.   
\c 15  
\p
\v 1 \w El|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Oded,  
\v 2 y \w él|strong="H5973"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibir \w a|strong="H3068"\w* Asá \w para|strong="H1961"\w* decirle: “¡Escúchenme, Asá, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* y \w Benjamín|strong="H1144"\w*! Yahvé \w estará|strong="H1961"\w* \w con|strong="H5973"\w* ustedes \w siempre|strong="H3605"\w* y \w cuando|strong="H1961"\w* ustedes \w estén|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*. \w Si|strong="H6440"\w* \w lo|strong="H3605"\w* \w buscan|strong="H1875"\w*, \w lo|strong="H3605"\w* encontrarán; pero \w si|strong="H6440"\w* \w lo|strong="H3605"\w* \w abandonan|strong="H5800"\w*, \w él|strong="H5973"\w* \w los|strong="H3605"\w* abandonará \w a|strong="H3068"\w* ustedes.  
\v 3 Durante \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w*, el \w pueblo|strong="H7227"\w* de \w Israel|strong="H3478"\w* \w vivió|strong="H3117"\w* \w sin|strong="H3808"\w* el Dios verdadero, \w sin|strong="H3808"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H3808"\w* les enseñaran, y \w sin|strong="H3808"\w* la \w ley|strong="H8451"\w*.  
\v 4 Pero cuando \w se|strong="H5921"\w* vieron \w en|strong="H5921"\w* problemas \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w buscaron|strong="H1245"\w*, \w él|strong="H5921"\w* dejó \w que|strong="H5921"\w* \w lo|strong="H5921"\w* encontraran.  
\v 5 \w En|strong="H5921"\w* esos tiempos, \w no|strong="H3588"\w* era seguro viajar, ni \w salir|strong="H3318"\w* ni entrar, \w porque|strong="H3588"\w* \w había|strong="H3588"\w* \w grandes|strong="H7227"\w* problemas \w para|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w del|strong="H5921"\w* país.  
\v 6 Las \w naciones|strong="H1471"\w* \w y|strong="H3588"\w* las \w ciudades|strong="H5892"\w* se destruían unas \w a|strong="H3068"\w* otras, \w porque|strong="H3588"\w* Dios las castigaba \w con|strong="H3588"\w* \w todo|strong="H3605"\w* tipo \w de|strong="H3588"\w* desgracias.  
\v 7 ¡\w Pero|strong="H3588"\w* ustedes sean fuertes! \w No|strong="H3588"\w* dejen \w que|strong="H3588"\w* sus \w manos|strong="H3027"\w* se debiliten, \w porque|strong="H3588"\w* todo \w su|strong="H3588"\w* trabajo tendrá \w su|strong="H3588"\w* \w recompensa|strong="H6468"\w*”.   
\p
\v 8 Cuando Asá \w escuchó|strong="H8085"\w* estas \w palabras|strong="H1697"\w* y \w la|strong="H3605"\w* profecía \w de|strong="H4480"\w* Oded, \w se|strong="H4480"\w* llenó \w de|strong="H4480"\w* valor y quitó \w los|strong="H3605"\w* ídolos repugnantes \w de|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* y \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*, y también \w de|strong="H4480"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H4480"\w* había conquistado \w en|strong="H4480"\w* \w la|strong="H3605"\w* región montañosa \w de|strong="H4480"\w* Efraín. \w Además|strong="H4480"\w*, reparó \w el|strong="H3605"\w* \w altar|strong="H4196"\w* \w de|strong="H4480"\w* Yahvé \w que|strong="H4480"\w* estaba frente \w al|strong="H4480"\w* pórtico \w del|strong="H4480"\w* templo \w de|strong="H4480"\w* Yahvé.  
\v 9 Luego reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w Benjamín|strong="H1144"\w*, \w junto|strong="H5921"\w* \w con|strong="H5973"\w* \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* Efraín, \w Manasés|strong="H4519"\w* \w y|strong="H3588"\w* \w Simeón|strong="H8095"\w* \w que|strong="H3588"\w* vivía \w entre|strong="H5921"\w* \w ellos|strong="H5921"\w*; \w pues|strong="H3588"\w* muchísimos israelitas \w se|strong="H5921"\w* habían unido \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w al|strong="H5921"\w* \w ver|strong="H7200"\w* \w que|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w lo|strong="H5921"\w* respaldaba.  
\v 10 Se reunieron en Jerusalén en el tercer \w mes|strong="H2320"\w*, durante el \w año|strong="H8141"\w* \w quince|strong="H2568"\w* del \w reinado|strong="H4438"\w* \w de|strong="H2568"\w* Asá.  
\v 11 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w le|strong="H1931"\w* ofrecieron \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé \w del|strong="H4480"\w* botín \w que|strong="H4480"\w* habían traído: \w setecientas|strong="H7651"\w* \w vacas|strong="H1241"\w* \w y|strong="H1241"\w* \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*.  
\v 12 Hicieron \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* de buscar \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de sus antepasados, con \w todo|strong="H3605"\w* su \w corazón|strong="H3824"\w* y con \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w*.  
\v 13 También acordaron \w que|strong="H4480"\w* \w cualquiera|strong="H3605"\w* \w que|strong="H4480"\w* \w se|strong="H4480"\w* negara \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, sería condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*, \w no|strong="H3808"\w* importando \w si|strong="H3808"\w* era importante \w o|strong="H3068"\w* humilde, hombre \w o|strong="H3068"\w* mujer.  
\v 14 Se lo \w juraron|strong="H7650"\w* \w a|strong="H3068"\w* Yahvé en \w voz|strong="H6963"\w* \w alta|strong="H1419"\w*, entre \w gritos|strong="H8643"\w* de alegría y sonidos de \w trompetas|strong="H2689"\w* y cuernos.  
\v 15 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w se|strong="H5921"\w* alegró \w por|strong="H5921"\w* este \w juramento|strong="H7621"\w*, \w porque|strong="H3588"\w* \w lo|strong="H5921"\w* habían hecho \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*. \w Buscaron|strong="H1245"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w* \w con|strong="H5921"\w* muchas ganas \w y|strong="H3588"\w* \w lo|strong="H5921"\w* encontraron, \w y|strong="H3588"\w* Yahvé \w les|strong="H5921"\w* dio paz \w en|strong="H5921"\w* \w todas|strong="H3605"\w* sus fronteras.   
\p
\v 16 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* Asá incluso le \w quitó|strong="H5493"\w* \w a|strong="H3068"\w* su abuela Maaca \w el|strong="H6213"\w* título de \w reina|strong="H4428"\w* madre, \w porque|strong="H4428"\w* ella \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* una figura repugnante \w para|strong="H5493"\w* adorar \w a|strong="H3068"\w* \w la|strong="H1571"\w* diosa Asera. Asá derribó \w la|strong="H1571"\w* figura, \w la|strong="H1571"\w* \w hizo|strong="H6213"\w* polvo \w y|strong="H1571"\w* \w la|strong="H1571"\w* \w quemó|strong="H8313"\w* \w en|strong="H5493"\w* \w el|strong="H6213"\w* \w arroyo|strong="H5158"\w* de Cedrón.  
\v 17 \w Aunque|strong="H7535"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w quitaron|strong="H5493"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w altares|strong="H1116"\w* paganos de \w Israel|strong="H3478"\w*, \w el|strong="H3605"\w* \w corazón|strong="H3824"\w* de Asá \w se|strong="H1961"\w* mantuvo fiel \w a|strong="H3068"\w* Dios \w toda|strong="H3605"\w* su \w vida|strong="H3117"\w*.  
\v 18 Asá llevó al \w templo|strong="H1004"\w* de Dios los artículos de \w plata|strong="H3701"\w* y \w oro|strong="H2091"\w*, y los utensilios que él y su padre habían \w consagrado|strong="H6944"\w*.  
\v 19 \w Y|strong="H3068"\w* \w no|strong="H3808"\w* \w hubo|strong="H1961"\w* \w más|strong="H5704"\w* \w guerras|strong="H4421"\w* \w hasta|strong="H5704"\w* el \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H5704"\w* \w cinco|strong="H2568"\w* del \w reinado|strong="H4438"\w* \w de|strong="H5704"\w* Asá.   
\c 16  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w seis|strong="H8337"\w* \w del|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* Asá, \w Baasa|strong="H1201"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, atacó \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* comenzó \w a|strong="H3068"\w* construir defensas \w en|strong="H5921"\w* \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* \w Ramá|strong="H7414"\w*, \w para|strong="H5921"\w* impedir \w que|strong="H5921"\w* nadie entrara \w o|strong="H3068"\w* \w saliera|strong="H3318"\w* \w del|strong="H5921"\w* territorio \w de|strong="H5921"\w* Asá, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 2 Entonces Asá \w sacó|strong="H3318"\w* la \w plata|strong="H3701"\w* y \w el|strong="H3427"\w* \w oro|strong="H2091"\w* de \w los|strong="H3427"\w* tesoros del \w templo|strong="H1004"\w* de Yahvé y del palacio \w real|strong="H4428"\w*, y se \w los|strong="H3427"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Ben Hadad, \w rey|strong="H4428"\w* de Siria, que \w vivía|strong="H3427"\w* \w en|strong="H3318"\w* \w Damasco|strong="H1834"\w*, con este mensaje:  
\v 3 “Hagamos un tratado tú \w y|strong="H5921"\w* \w yo|strong="H2009"\w*, \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* hicieron nuestros padres. \w Aquí|strong="H2009"\w* \w te|strong="H5921"\w* \w envío|strong="H7971"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w oro|strong="H2091"\w*. \w Ve|strong="H3212"\w* \w y|strong="H5921"\w* rompe \w el|strong="H5921"\w* tratado \w que|strong="H5921"\w* tienes \w con|strong="H5921"\w* \w Baasa|strong="H1201"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w deje|strong="H7971"\w* \w en|strong="H5921"\w* paz \w y|strong="H5921"\w* \w se|strong="H5921"\w* retire \w de|strong="H5921"\w* \w mi|strong="H5921"\w* territorio”.   
\p
\v 4 Ben Hadad aceptó \w la|strong="H3605"\w* oferta del \w rey|strong="H4428"\w* Asá y \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* comandantes \w de|strong="H8269"\w* sus \w ejércitos|strong="H2428"\w* \w a|strong="H3068"\w* atacar las \w ciudades|strong="H5892"\w* \w de|strong="H8269"\w* \w Israel|strong="H3478"\w*. Conquistaron Ijón, \w Dan|strong="H1835"\w*, Abel Maim y \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H8269"\w* almacenamiento \w de|strong="H8269"\w* Neftalí.  
\v 5 \w Cuando|strong="H1961"\w* \w Baasa|strong="H1201"\w* \w se|strong="H1961"\w* enteró de esto, \w dejó|strong="H2308"\w* de construir las defensas de \w Ramá|strong="H7414"\w* y abandonó el trabajo.  
\v 6 Entonces \w el|strong="H3605"\w* \w rey|strong="H4428"\w* Asá reunió \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* gente de \w Judá|strong="H3063"\w*, y se \w llevaron|strong="H5375"\w* las piedras y \w la|strong="H3605"\w* \w madera|strong="H6086"\w* \w que|strong="H3605"\w* \w Baasa|strong="H1201"\w* había estado usando en \w Ramá|strong="H7414"\w*. Con esos mismos materiales, Asá construyó defensas en Geba y en \w Mizpa|strong="H4709"\w*.   
\p
\v 7 \w Por|strong="H5921"\w* \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w el|strong="H1931"\w* \w vidente|strong="H7200"\w* \w Hananí|strong="H2607"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* Asá, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* \w le|strong="H1931"\w* dijo: “\w Por|strong="H5921"\w* \w haber|strong="H3808"\w* confiado \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria \w en|strong="H5921"\w* lugar \w de|strong="H5921"\w* confiar \w en|strong="H5921"\w* Yahvé tu \w Dios|strong="H3068"\w*, \w el|strong="H1931"\w* \w ejército|strong="H2426"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria \w se|strong="H1931"\w* \w te|strong="H5921"\w* \w ha|strong="H3808"\w* escapado \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w*.  
\v 8 ¿Acaso \w los|strong="H5921"\w* etíopes \w y|strong="H5921"\w* \w los|strong="H5921"\w* libios \w no|strong="H3808"\w* formaban un \w ejército|strong="H2428"\w* enorme, \w con|strong="H5921"\w* muchísimos \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w jinetes|strong="H6571"\w*? \w Sin|strong="H3808"\w* embargo, \w como|strong="H1961"\w* tú confiaste \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w él|strong="H5921"\w* \w los|strong="H5921"\w* \w entregó|strong="H5414"\w* \w en|strong="H5921"\w* tus \w manos|strong="H3027"\w*.  
\v 9 \w Porque|strong="H3588"\w* \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w de|strong="H5921"\w* Yahvé \w recorren|strong="H7751"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra, \w para|strong="H5921"\w* fortalecer \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w le|strong="H5921"\w* \w son|strong="H3588"\w* completamente fieles. \w Te|strong="H5869"\w* portaste \w como|strong="H3588"\w* un necio \w en|strong="H5921"\w* \w esto|strong="H2063"\w*; \w por|strong="H5921"\w* \w eso|strong="H2063"\w*, \w de|strong="H5921"\w* \w ahora|strong="H6258"\w* \w en|strong="H5921"\w* adelante tendrás \w guerras|strong="H4421"\w*”.   
\p
\v 10 Asá \w se|strong="H1931"\w* enojó muchísimo \w con|strong="H5973"\w* \w el|strong="H1931"\w* \w vidente|strong="H7200"\w* \w y|strong="H3588"\w* \w lo|strong="H1931"\w* mandó \w a|strong="H3068"\w* \w la|strong="H1931"\w* cárcel, \w porque|strong="H3588"\w* \w estaba|strong="H1004"\w* furioso \w por|strong="H5921"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w le|strong="H1931"\w* \w había|strong="H3588"\w* dicho. \w En|strong="H5921"\w* \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* época, Asá comenzó \w a|strong="H3068"\w* maltratar \w a|strong="H3068"\w* algunas personas \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 11 \w La|strong="H5921"\w* historia \w de|strong="H5921"\w* Asá, \w desde|strong="H5921"\w* \w el|strong="H5921"\w* principio \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* fin, \w está|strong="H5921"\w* \w escrita|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 12 \w En|strong="H5704"\w* \w el|strong="H3588"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H1571"\w* \w nueve|strong="H8672"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w reinado|strong="H4438"\w*, Asá \w se|strong="H3808"\w* \w enfermó|strong="H2456"\w* gravemente \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w pies|strong="H7272"\w*. \w Sin|strong="H3808"\w* embargo, \w a|strong="H3068"\w* pesar \w de|strong="H3588"\w* \w su|strong="H3588"\w* grave \w enfermedad|strong="H2483"\w*, \w no|strong="H3808"\w* \w buscó|strong="H1875"\w* \w la|strong="H1571"\w* ayuda \w de|strong="H3588"\w* Yahvé, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* confió solo \w en|strong="H5704"\w* \w los|strong="H3588"\w* \w médicos|strong="H7495"\w*.  
\v 13 Asá \w murió|strong="H4191"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w año|strong="H8141"\w* cuarenta y uno \w de|strong="H5973"\w* su \w reinado|strong="H4427"\w*.  
\v 14 \w Lo|strong="H5704"\w* enterraron \w en|strong="H5704"\w* la tumba \w que|strong="H5704"\w* él mismo había mandado cavar \w en|strong="H5704"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w*. \w Lo|strong="H5704"\w* acostaron \w en|strong="H5704"\w* una \w cama|strong="H4904"\w* \w llena|strong="H4390"\w* \w de|strong="H5704"\w* \w especias|strong="H1314"\w* aromáticas \w y|strong="H5704"\w* perfumes preparados \w por|strong="H5704"\w* expertos, \w y|strong="H5704"\w* encendieron un fuego \w muy|strong="H3966"\w* \w grande|strong="H1419"\w* \w en|strong="H5704"\w* su honor.   
\c 17  
\p
\v 1 Su \w hijo|strong="H1121"\w* Josafat \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* hizo fuerte \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 2 Colocó tropas en \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*, y \w puso|strong="H5414"\w* guarniciones en \w la|strong="H3605"\w* tierra \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* y en las \w ciudades|strong="H5892"\w* \w de|strong="H5414"\w* Efraín \w que|strong="H3605"\w* su padre Asá había conquistado.  
\v 3 Yahvé \w estuvo|strong="H1961"\w* \w con|strong="H5973"\w* Josafat, \w porque|strong="H3588"\w* \w anduvo|strong="H1980"\w* \w en|strong="H5973"\w* \w los|strong="H5973"\w* \w primeros|strong="H7223"\w* \w caminos|strong="H1870"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre \w David|strong="H1732"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w buscó|strong="H1875"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* baales,  
\v 4 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w buscó|strong="H1875"\w* al Dios \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre \w y|strong="H3588"\w* \w anduvo|strong="H1980"\w* \w en|strong="H3588"\w* sus \w mandamientos|strong="H4687"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* según las costumbres \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.  
\v 5 \w Por|strong="H3027"\w* eso \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* \w afirmó|strong="H3559"\w* \w el|strong="H3605"\w* \w reino|strong="H4467"\w* en sus \w manos|strong="H3027"\w*. \w Todo|strong="H3605"\w* \w Judá|strong="H3063"\w* llevó \w tributo|strong="H4503"\w* \w a|strong="H3068"\w* Josafat, \w y|strong="H3519"\w* \w él|strong="H3605"\w* \w tuvo|strong="H1961"\w* \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* \w gloria|strong="H3519"\w* en \w abundancia|strong="H7230"\w*.  
\v 6 Su \w corazón|strong="H3820"\w* se enalteció \w en|strong="H5493"\w* los \w caminos|strong="H1870"\w* \w de|strong="H5750"\w* Yahvé; y \w además|strong="H5750"\w*, \w quitó|strong="H5493"\w* \w de|strong="H5750"\w* \w Judá|strong="H3063"\w* los lugares \w altos|strong="H1116"\w* y las imágenes \w de|strong="H5750"\w* Asera.   
\p
\v 7 En el tercer \w año|strong="H8141"\w* \w de|strong="H8269"\w* su \w reinado|strong="H4427"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* sus \w príncipes|strong="H8269"\w* Ben Hail, \w Abdías|strong="H5662"\w*, \w Zacarías|strong="H2148"\w*, Natanael y Micaías, para que \w enseñaran|strong="H3925"\w* en las \w ciudades|strong="H5892"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*;  
\v 8 y \w con|strong="H5973"\w* ellos \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w levitas|strong="H3881"\w* \w Semaías|strong="H8098"\w*, Netanías, \w Zebadías|strong="H2069"\w*, \w Asael|strong="H6214"\w*, Semiramot, Jonatán, Adonías, \w Tobías|strong="H2900"\w* y Tobadonías; y \w con|strong="H5973"\w* ellos \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w sacerdotes|strong="H3548"\w* Elisama y \w Joram|strong="H3088"\w*.  
\v 9 \w Ellos|strong="H3605"\w* enseñaron \w en|strong="H5973"\w* \w Judá|strong="H3063"\w*, llevando \w consigo|strong="H5973"\w* \w el|strong="H5973"\w* \w libro|strong="H5612"\w* \w de|strong="H5973"\w* \w la|strong="H3605"\w* \w ley|strong="H8451"\w* \w de|strong="H5973"\w* Yahvé. Recorrieron \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* y enseñaron al \w pueblo|strong="H5971"\w*.   
\p
\v 10 \w El|strong="H5921"\w* \w temor|strong="H6343"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w* cayó \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tierras \w que|strong="H3808"\w* rodeaban \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, \w de|strong="H5921"\w* modo \w que|strong="H3808"\w* \w no|strong="H3808"\w* hicieron \w la|strong="H5921"\w* \w guerra|strong="H3898"\w* \w contra|strong="H5921"\w* Josafat.  
\v 11 Algunos \w de|strong="H4480"\w* los \w filisteos|strong="H6430"\w* le trajeron \w a|strong="H3068"\w* Josafat regalos \w y|strong="H1571"\w* \w plata|strong="H3701"\w* \w como|strong="H1571"\w* \w tributo|strong="H4503"\w*. Los árabes \w también|strong="H1571"\w* le trajeron rebaños: \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* carneros \w y|strong="H1571"\w* \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* machos cabríos.  
\v 12 Josafat \w se|strong="H1961"\w* engrandeció \w sobremanera|strong="H4605"\w*, \w y|strong="H5704"\w* \w edificó|strong="H1129"\w* \w fortalezas|strong="H1003"\w* \w y|strong="H5704"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5704"\w* abastecimiento \w en|strong="H5704"\w* \w Judá|strong="H3063"\w*.  
\v 13 Llevó \w a|strong="H3068"\w* cabo \w grandes|strong="H7227"\w* obras en las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w*, y \w tuvo|strong="H1961"\w* en Jerusalén guerreros y \w hombres|strong="H1368"\w* \w valientes|strong="H1368"\w*.  
\v 14 Este es \w el|strong="H5973"\w* censo \w de|strong="H5973"\w* ellos según sus \w casas|strong="H1004"\w* paternas: \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*, \w los|strong="H5973"\w* \w jefes|strong="H8269"\w* \w de|strong="H5973"\w* millares: \w el|strong="H5973"\w* \w jefe|strong="H8269"\w* \w Adná|strong="H5734"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w trescientos|strong="H7969"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* \w valientes|strong="H1368"\w*;  
\v 15 \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w el|strong="H5921"\w* \w jefe|strong="H8269"\w* \w Johanán|strong="H3076"\w*, \w y|strong="H5921"\w* \w con|strong="H5973"\w* \w él|strong="H5921"\w* \w doscientos|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w mil|strong="H3967"\w*;  
\v 16 \w y|strong="H5921"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w Amasías|strong="H6007"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Zicri, \w que|strong="H5921"\w* \w se|strong="H5921"\w* había ofrecido \w voluntariamente|strong="H5068"\w* \w a|strong="H3068"\w* Yahvé, \w y|strong="H5921"\w* \w con|strong="H5973"\w* \w él|strong="H5921"\w* \w doscientos|strong="H3967"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* \w valientes|strong="H1368"\w*.  
\v 17 \w De|strong="H4480"\w* \w Benjamín|strong="H1144"\w*: Eliada, \w hombre|strong="H1368"\w* \w valeroso|strong="H2428"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w doscientos|strong="H3967"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* \w armados|strong="H5401"\w* \w con|strong="H5973"\w* \w arco|strong="H7198"\w* y \w escudo|strong="H4043"\w*;  
\v 18 \w y|strong="H5921"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w Jozabad|strong="H3075"\w*, \w y|strong="H5921"\w* \w con|strong="H5973"\w* \w él|strong="H5921"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* \w mil|strong="H3967"\w* hombres pertrechados \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H6635"\w*.  
\v 19 \w Estos|strong="H3605"\w* eran \w los|strong="H3605"\w* \w que|strong="H3605"\w* estaban \w al|strong="H4428"\w* servicio del \w rey|strong="H4428"\w*, además \w de|strong="H5414"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* había \w puesto|strong="H5414"\w* en las \w ciudades|strong="H5892"\w* fortificadas \w por|strong="H5414"\w* \w toda|strong="H3605"\w* \w Judá|strong="H3063"\w*.   
\c 18  
\p
\v 1 Josafat \w tuvo|strong="H1961"\w* \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* \w gloria|strong="H3519"\w* en \w abundancia|strong="H7230"\w*, \w y|strong="H3519"\w* \w se|strong="H1961"\w* emparentó con Ajab.  
\v 2 Al cabo \w de|strong="H5973"\w* algunos \w años|strong="H8141"\w*, \w descendió|strong="H3381"\w* \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w* \w para|strong="H5973"\w* visitar \w a|strong="H3068"\w* Ajab. Ajab \w mató|strong="H2076"\w* \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w* \w en|strong="H5973"\w* \w abundancia|strong="H7230"\w* \w para|strong="H5973"\w* \w él|strong="H5973"\w* \w y|strong="H1241"\w* \w para|strong="H5973"\w* la \w gente|strong="H5971"\w* \w que|strong="H5971"\w* lo acompañaba, \w y|strong="H1241"\w* lo persuadió \w para|strong="H5973"\w* \w que|strong="H5971"\w* subiera \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w contra|strong="H5973"\w* Ramot \w de|strong="H5973"\w* \w Galaad|strong="H1568"\w*.  
\v 3 Ajab, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*, dijo \w a|strong="H3068"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*: “¿\w Irás|strong="H3212"\w* \w conmigo|strong="H5973"\w* \w a|strong="H3068"\w* Ramot \w de|strong="H5973"\w* \w Galaad|strong="H1568"\w*?”  
\p \w Él|strong="H5973"\w* \w le|strong="H5973"\w* respondió: “Yo soy \w como|strong="H3644"\w* tú, y mi \w pueblo|strong="H5971"\w* \w como|strong="H3644"\w* tu \w pueblo|strong="H5971"\w*; estaremos \w contigo|strong="H5973"\w* \w en|strong="H5973"\w* la \w guerra|strong="H4421"\w*”.  
\v 4 Pero Josafat dijo \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*: “\w Por|strong="H1697"\w* favor, consulta \w hoy|strong="H3117"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé”.   
\p
\v 5 Entonces \w el|strong="H5030"\w* \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w* reunió \w a|strong="H3068"\w* los \w profetas|strong="H5030"\w*, cuatrocientos hombres, y les preguntó: “¿\w Iremos|strong="H3212"\w* \w a|strong="H3068"\w* la \w guerra|strong="H4421"\w* \w contra|strong="H3478"\w* Ramot \w de|strong="H5414"\w* \w Galaad|strong="H1568"\w*, \w o|strong="H3068"\w* me abstendré?”  
\p \w Ellos|strong="H3027"\w* dijeron: “\w Sube|strong="H5927"\w*, \w porque|strong="H4428"\w* Dios la \w entregará|strong="H5414"\w* \w en|strong="H3212"\w* \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w*”.   
\p
\v 6 Pero Josafat preguntó: “¿No \w hay|strong="H5750"\w* \w aquí|strong="H6311"\w* \w algún|strong="H5750"\w* \w otro|strong="H5750"\w* \w profeta|strong="H5030"\w* \w de|strong="H5750"\w* Yahvé \w a|strong="H3068"\w* quien podamos consultar?”   
\p
\v 7 \w El|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* respondió \w a|strong="H3068"\w* Josafat: “\w Aún|strong="H5750"\w* \w hay|strong="H5750"\w* un \w hombre|strong="H1121"\w* \w por|strong="H5921"\w* medio \w del|strong="H5921"\w* \w cual|strong="H1931"\w* podemos consultar \w a|strong="H3068"\w* Yahvé, \w pero|strong="H3588"\w* \w yo|strong="H3588"\w* \w lo|strong="H1931"\w* \w aborrezco|strong="H8130"\w*, \w porque|strong="H3588"\w* \w nunca|strong="H3588"\w* \w me|strong="H5921"\w* \w profetiza|strong="H5012"\w* \w el|strong="H1931"\w* \w bien|strong="H2896"\w*, \w sino|strong="H3588"\w* \w siempre|strong="H3605"\w* \w el|strong="H1931"\w* \w mal|strong="H7451"\w*. \w Es|strong="H1931"\w* Micaías, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Imlá”.  
\p Josafat dijo: “\w No|strong="H3588"\w* hable \w así|strong="H3651"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w*”.   
\p
\v 8 Entonces \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* un oficial y le ordenó: “Trae \w de|strong="H1121"\w* prisa \w a|strong="H3068"\w* Micaías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Imlá”.   
\p
\v 9 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w estaban|strong="H3427"\w* \w sentados|strong="H3427"\w* \w cada|strong="H3605"\w* uno \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*, \w vestidos|strong="H3847"\w* \w con|strong="H5921"\w* sus ropas \w reales|strong="H4428"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* plaza \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w* \w de|strong="H5921"\w* \w Samaria|strong="H8111"\w*; \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* \w profetizaban|strong="H5012"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 10 Sedequías, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Quenaaná, se \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* unos \w cuernos|strong="H7161"\w* \w de|strong="H5704"\w* \w hierro|strong="H1270"\w* \w y|strong="H5704"\w* decía: “\w Así|strong="H3541"\w* dice Yahvé: ‘\w Con|strong="H5704"\w* estos \w acornearás|strong="H5055"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* sirios \w hasta|strong="H5704"\w* \w destruirlos|strong="H3615"\w* \w por|strong="H5704"\w* completo’”.   
\p
\v 11 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* \w profetizaban|strong="H5012"\w* \w lo|strong="H3605"\w* \w mismo|strong="H3605"\w*, diciendo: “\w Sube|strong="H5927"\w* \w a|strong="H3068"\w* Ramot \w de|strong="H5414"\w* \w Galaad|strong="H1568"\w* y serás \w prosperado|strong="H6743"\w*, \w porque|strong="H4428"\w* Yahvé \w la|strong="H3605"\w* \w entregará|strong="H5414"\w* en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w*”.   
\p
\v 12 \w El|strong="H5030"\w* \w mensajero|strong="H4397"\w* \w que|strong="H4994"\w* \w había|strong="H1961"\w* ido \w a|strong="H3068"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* Micaías le \w habló|strong="H1696"\w*, \w diciendo|strong="H1696"\w*: “He \w aquí|strong="H2009"\w* \w que|strong="H4994"\w* \w las|strong="H1992"\w* \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w los|strong="H1992"\w* \w profetas|strong="H5030"\w*, \w a|strong="H3068"\w* una sola voz, anuncian \w el|strong="H5030"\w* \w bien|strong="H2896"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*. Te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* tu \w palabra|strong="H1697"\w* \w sea|strong="H1961"\w* \w como|strong="H1961"\w* la \w de|strong="H1697"\w* uno \w de|strong="H1697"\w* \w ellos|strong="H1992"\w*, y \w que|strong="H4994"\w* anuncies \w el|strong="H5030"\w* \w bien|strong="H2896"\w*”.   
\p
\v 13 \w Pero|strong="H3588"\w* Micaías respondió: “\w Vive|strong="H2416"\w* Yahvé, \w que|strong="H3588"\w* lo \w que|strong="H3588"\w* mi \w Dios|strong="H3068"\w* \w me|strong="H3588"\w* \w diga|strong="H1696"\w*, eso \w hablaré|strong="H1696"\w*”.   
\p
\v 14 Cuando \w llegó|strong="H3212"\w* ante el \w rey|strong="H4428"\w*, el \w rey|strong="H4428"\w* le preguntó: “Micaías, ¿\w iremos|strong="H3212"\w* \w a|strong="H3068"\w* la \w guerra|strong="H4421"\w* contra Ramot \w de|strong="H5414"\w* \w Galaad|strong="H1568"\w*, \w o|strong="H3068"\w* me abstendré?”  
\p Él respondió: “\w Subid|strong="H5927"\w* y seréis prosperados; serán entregados \w en|strong="H3212"\w* vuestras \w manos|strong="H3027"\w*”.   
\p
\v 15 El \w rey|strong="H4428"\w* le \w dijo|strong="H1696"\w*: “¿\w Cuántas|strong="H4100"\w* \w veces|strong="H6471"\w* he \w de|strong="H5704"\w* conjurarte \w para|strong="H5704"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* me \w digas|strong="H1696"\w* \w sino|strong="H7535"\w* la verdad \w en|strong="H5704"\w* el \w nombre|strong="H8034"\w* \w de|strong="H5704"\w* Yahvé?”   
\p
\v 16 \w Entonces|strong="H7725"\w* Micaías dijo: “He \w visto|strong="H7200"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w esparcido|strong="H6327"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w*, \w como|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w sin|strong="H3808"\w* \w pastor|strong="H7462"\w*. \w Y|strong="H3068"\w* Yahvé dijo: ‘\w Estos|strong="H3605"\w* \w no|strong="H3808"\w* tienen \w señor|strong="H3068"\w*; \w vuelva|strong="H7725"\w* \w cada|strong="H3605"\w* uno \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* \w en|strong="H5921"\w* \w paz|strong="H7965"\w*’”.   
\p
\v 17 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* dijo \w a|strong="H3068"\w* Josafat: “¿\w No|strong="H3808"\w* \w te|strong="H5921"\w* dije \w que|strong="H3588"\w* este \w no|strong="H3808"\w* \w profetizaría|strong="H5012"\w* \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* \w nada|strong="H3808"\w* \w bueno|strong="H2896"\w*, \w sino|strong="H3588"\w* sólo \w el|strong="H5921"\w* \w mal|strong="H7451"\w*?”   
\p
\v 18 \w Y|strong="H3068"\w* Micaías añadió: “\w Escuchad|strong="H8085"\w*, \w pues|strong="H3651"\w*, \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé: \w Vi|strong="H7200"\w* \w a|strong="H3068"\w* Yahvé \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w ejército|strong="H6635"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w cielos|strong="H8064"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w a|strong="H3068"\w* su \w derecha|strong="H3225"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su \w izquierda|strong="H8040"\w*.  
\v 19 \w Y|strong="H3068"\w* Yahvé preguntó: ‘¿\w Quién|strong="H4310"\w* persuadirá \w a|strong="H3068"\w* Ajab, \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*, para \w que|strong="H4310"\w* \w suba|strong="H5927"\w* y \w caiga|strong="H5307"\w* en Ramot de \w Galaad|strong="H1568"\w*?’ \w Y|strong="H3068"\w* uno decía de una manera, y \w otro|strong="H2088"\w* decía de otra.  
\v 20 Entonces \w salió|strong="H3318"\w* un \w espíritu|strong="H7307"\w*, \w se|strong="H4100"\w* \w puso|strong="H5975"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé y dijo: ‘Yo \w lo|strong="H4100"\w* persuadiré’.  
\p “Yahvé le preguntó: ‘¿\w De|strong="H6440"\w* \w qué|strong="H4100"\w* manera?’   
\p
\v 21 “\w Él|strong="H3605"\w* respondió: ‘\w Saldré|strong="H3318"\w* \w y|strong="H1571"\w* \w seré|strong="H1961"\w* \w espíritu|strong="H7307"\w* de \w mentira|strong="H8267"\w* \w en|strong="H3318"\w* \w la|strong="H1571"\w* \w boca|strong="H6310"\w* de \w todos|strong="H3605"\w* sus \w profetas|strong="H5030"\w*’.  
\p “\w Y|strong="H3068"\w* Yahvé dijo: ‘\w Tú|strong="H6213"\w* \w lo|strong="H6213"\w* persuadirás, \w y|strong="H1571"\w* \w ciertamente|strong="H1571"\w* prevalecerás. Ve \w y|strong="H1571"\w* \w hazlo|strong="H6213"\w* \w así|strong="H3651"\w*’.   
\p
\v 22 “\w Ahora|strong="H6258"\w*, \w pues|strong="H6258"\w*, he \w aquí|strong="H2009"\w* \w que|strong="H6258"\w* Yahvé ha \w puesto|strong="H5414"\w* un \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w mentira|strong="H8267"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w de|strong="H5921"\w* estos tus \w profetas|strong="H5030"\w*, \w y|strong="H5921"\w* Yahvé ha decretado \w el|strong="H5921"\w* \w mal|strong="H7451"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*”.   
\p
\v 23 Entonces \w se|strong="H5921"\w* \w acercó|strong="H5066"\w* Sedequías, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Quenaaná, golpeó \w a|strong="H3068"\w* Micaías \w en|strong="H5921"\w* \w la|strong="H5921"\w* mejilla \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w dijo|strong="H1696"\w*: “¿\w Por|strong="H5921"\w* \w qué|strong="H5921"\w* \w camino|strong="H1870"\w* \w se|strong="H5921"\w* apartó \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Yahvé \w para|strong="H5921"\w* \w hablarte|strong="H1696"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w*?”   
\p
\v 24 Micaías respondió: “He \w aquí|strong="H2005"\w*, tú \w lo|strong="H1931"\w* \w verás|strong="H7200"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w cuando|strong="H3117"\w* vayas de aposento en aposento para esconderte”.   
\p
\v 25 \w El|strong="H1121"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* ordenó: “\w Tomad|strong="H3947"\w* \w a|strong="H3068"\w* Micaías y llevadlo \w a|strong="H3068"\w* Amón, \w gobernador|strong="H8269"\w* \w de|strong="H1121"\w* la \w ciudad|strong="H5892"\w*, y \w a|strong="H3068"\w* \w Joás|strong="H3101"\w*, \w hijo|strong="H1121"\w* del \w rey|strong="H4428"\w*;  
\v 26 \w y|strong="H5704"\w* decidles: ‘\w Así|strong="H3541"\w* dice el \w rey|strong="H4428"\w*: \w Poned|strong="H7760"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* hombre \w en|strong="H5704"\w* la cárcel, \w y|strong="H5704"\w* sustentadle \w con|strong="H5704"\w* \w pan|strong="H3899"\w* \w de|strong="H5704"\w* aflicción \w y|strong="H5704"\w* \w agua|strong="H4325"\w* \w de|strong="H5704"\w* aflicción, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* yo regrese \w en|strong="H5704"\w* \w paz|strong="H7965"\w*’”.   
\p
\v 27 Micaías \w dijo|strong="H1696"\w*: “\w Si|strong="H3808"\w* tú logras regresar en \w paz|strong="H7965"\w*, Yahvé \w no|strong="H3808"\w* \w ha|strong="H3808"\w* \w hablado|strong="H1696"\w* por medio \w de|strong="H5971"\w* mí”. \w Y|strong="H3068"\w* añadió: “¡\w Escuchad|strong="H8085"\w*, \w pueblos|strong="H5971"\w* \w todos|strong="H3605"\w*!”   
\p
\v 28 \w Subieron|strong="H5927"\w*, pues, el \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* y Josafat, \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* Ramot de \w Galaad|strong="H1568"\w*.  
\v 29 El \w rey|strong="H4428"\w* \w de|strong="H3847"\w* \w Israel|strong="H3478"\w* dijo \w a|strong="H3068"\w* Josafat: “Yo me disfrazaré para entrar en la \w batalla|strong="H4421"\w*, pero tú \w vístete|strong="H3847"\w* con tus ropas \w reales|strong="H4428"\w*”. Se disfrazó, pues, el \w rey|strong="H4428"\w* \w de|strong="H3847"\w* \w Israel|strong="H3478"\w*, y entraron en la \w batalla|strong="H4421"\w*.  
\v 30 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Siria \w había|strong="H3588"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w capitanes|strong="H8269"\w* \w de|strong="H3588"\w* sus \w carros|strong="H7393"\w*: “\w No|strong="H3808"\w* \w peleéis|strong="H3898"\w* \w ni|strong="H3808"\w* \w contra|strong="H3478"\w* \w el|strong="H3588"\w* \w pequeño|strong="H6996"\w* \w ni|strong="H3808"\w* \w contra|strong="H3478"\w* \w el|strong="H3588"\w* \w grande|strong="H1419"\w*, \w sino|strong="H3588"\w* únicamente \w contra|strong="H3478"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 31 \w Cuando|strong="H1961"\w* \w los|strong="H1992"\w* \w capitanes|strong="H8269"\w* \w de|strong="H4480"\w* \w los|strong="H1992"\w* \w carros|strong="H7393"\w* \w vieron|strong="H7200"\w* \w a|strong="H3068"\w* Josafat, dijeron: “¡\w Este|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*!” \w Y|strong="H3068"\w* \w lo|strong="H1931"\w* rodearon \w para|strong="H5921"\w* atacarlo; pero Josafat \w clamó|strong="H2199"\w*, \w y|strong="H5921"\w* Yahvé \w lo|strong="H1931"\w* \w ayudó|strong="H5826"\w*, \w y|strong="H5921"\w* \w Dios|strong="H3068"\w* \w los|strong="H1992"\w* \w apartó|strong="H5437"\w* \w de|strong="H4480"\w* \w él|strong="H1931"\w*.  
\v 32 \w Pues|strong="H3588"\w* \w cuando|strong="H3588"\w* \w los|strong="H1961"\w* \w capitanes|strong="H8269"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w carros|strong="H7393"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w era|strong="H1961"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, dejaron \w de|strong="H3588"\w* perseguirlo.  
\v 33 \w Pero|strong="H3588"\w* un hombre disparó \w su|strong="H3588"\w* \w arco|strong="H7198"\w* \w al|strong="H4480"\w* azar \w e|strong="H3068"\w* \w hirió|strong="H5221"\w* \w al|strong="H4480"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w por|strong="H3588"\w* \w entre|strong="H3588"\w* las junturas \w de|strong="H4480"\w* \w la|strong="H3588"\w* armadura. \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* dijo \w al|strong="H4480"\w* conductor \w de|strong="H4480"\w* \w su|strong="H3588"\w* carro: “Da \w la|strong="H3588"\w* \w vuelta|strong="H2015"\w* \w y|strong="H3588"\w* \w sácame|strong="H3318"\w* \w del|strong="H4480"\w* \w campo|strong="H4264"\w* \w de|strong="H4480"\w* batalla, \w porque|strong="H3588"\w* estoy gravemente herido”.  
\v 34 \w La|strong="H1931"\w* \w batalla|strong="H4421"\w* arreció \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*; \w y|strong="H5704"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w se|strong="H1961"\w* mantuvo \w en|strong="H5704"\w* \w pie|strong="H5975"\w* \w en|strong="H5704"\w* \w su|strong="H1931"\w* \w carro|strong="H4818"\w* frente \w a|strong="H3068"\w* \w los|strong="H1931"\w* sirios \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* \w tarde|strong="H6153"\w*, pero \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w hora|strong="H6256"\w* \w de|strong="H5704"\w* \w la|strong="H1931"\w* puesta del \w sol|strong="H8121"\w*, \w murió|strong="H4191"\w*.   
\c 19  
\p
\v 1 Josafat, \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w*, regresó en \w paz|strong="H7965"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* en Jerusalén.  
\v 2 \w Y|strong="H3068"\w* \w le|strong="H5921"\w* \w salió|strong="H3318"\w* \w al|strong="H5921"\w* encuentro \w el|strong="H5921"\w* \w vidente|strong="H2374"\w* \w Jehú|strong="H3058"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hananí|strong="H2607"\w*, \w y|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Josafat: “¿Acaso debías ayudar \w al|strong="H5921"\w* \w impío|strong="H7563"\w* \w y|strong="H5921"\w* amar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* \w aborrecen|strong="H8130"\w* \w a|strong="H3068"\w* Yahvé? \w Por|strong="H5921"\w* \w esto|strong="H2063"\w*, \w la|strong="H5921"\w* \w ira|strong="H7110"\w* \w de|strong="H5921"\w* Yahvé ha caído \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w*.  
\v 3 Sin embargo, \w se|strong="H4480"\w* han \w hallado|strong="H4672"\w* \w cosas|strong="H1697"\w* \w buenas|strong="H2896"\w* \w en|strong="H4480"\w* \w ti|strong="H5973"\w*, \w por|strong="H3588"\w* \w cuanto|strong="H3588"\w* has quitado \w de|strong="H4480"\w* \w la|strong="H3588"\w* tierra las imágenes \w de|strong="H4480"\w* Asera \w y|strong="H3588"\w* has \w dispuesto|strong="H3559"\w* tu \w corazón|strong="H3824"\w* \w para|strong="H3588"\w* buscar \w a|strong="H3068"\w* Dios”.   
\p
\v 4 Josafat \w habitó|strong="H3427"\w* \w en|strong="H5704"\w* Jerusalén; \w y|strong="H5704"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* \w salir|strong="H3318"\w* \w por|strong="H5704"\w* entre \w el|strong="H3427"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* Beerseba \w hasta|strong="H5704"\w* la región montañosa \w de|strong="H5704"\w* Efraín, \w y|strong="H5704"\w* \w los|strong="H3427"\w* hizo \w volver|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3427"\w* \w Dios|strong="H3068"\w* \w de|strong="H5704"\w* sus padres.  
\v 5 Estableció \w jueces|strong="H8199"\w* \w en|strong="H5975"\w* \w la|strong="H3605"\w* tierra, \w en|strong="H5975"\w* \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* de \w Judá|strong="H3063"\w*, \w ciudad|strong="H5892"\w* por \w ciudad|strong="H5892"\w*,  
\v 6 \w y|strong="H3588"\w* dijo \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w jueces|strong="H8199"\w*: “\w Considerad|strong="H7200"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w hacéis|strong="H6213"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w juzgáis|strong="H8199"\w* \w en|strong="H5973"\w* lugar \w del|strong="H5973"\w* hombre, \w sino|strong="H3588"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* \w él|strong="H5973"\w* estará \w con|strong="H5973"\w* \w vosotros|strong="H5973"\w* \w cuando|strong="H3588"\w* dictéis \w sentencia|strong="H4941"\w*.  
\v 7 \w Ahora|strong="H6258"\w*, \w pues|strong="H3588"\w*, \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w temor|strong="H6343"\w* \w de|strong="H5921"\w* Yahvé \w esté|strong="H1961"\w* \w sobre|strong="H5921"\w* \w vosotros|strong="H5973"\w*. Tened cuidado \w con|strong="H5973"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w hacéis|strong="H6213"\w*, \w porque|strong="H3588"\w* \w en|strong="H5921"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w no|strong="H6213"\w* \w hay|strong="H1961"\w* injusticia, \w ni|strong="H5973"\w* acepción \w de|strong="H5921"\w* personas, \w ni|strong="H5973"\w* admisión \w de|strong="H5921"\w* \w soborno|strong="H7810"\w*”.   
\p
\v 8 \w En|strong="H4480"\w* Jerusalén, Josafat \w también|strong="H1571"\w* estableció \w a|strong="H3068"\w* algunos \w de|strong="H4480"\w* los \w levitas|strong="H3881"\w*, \w sacerdotes|strong="H3548"\w* \w y|strong="H1571"\w* \w jefes|strong="H7218"\w* \w de|strong="H4480"\w* las familias \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w para|strong="H4480"\w* \w el|strong="H1571"\w* \w juicio|strong="H4941"\w* \w de|strong="H4480"\w* Yahvé \w y|strong="H1571"\w* \w para|strong="H4480"\w* resolver las controversias. \w Y|strong="H3068"\w* regresaron \w a|strong="H3068"\w* Jerusalén.  
\v 9 \w Les|strong="H5921"\w* dio \w estas|strong="H6213"\w* órdenes: “Actuaréis \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w temor|strong="H3374"\w* \w de|strong="H5921"\w* Yahvé, \w con|strong="H5921"\w* fidelidad \w y|strong="H5921"\w* \w con|strong="H5921"\w* un \w corazón|strong="H3824"\w* \w íntegro|strong="H8003"\w*.  
\v 10 \w En|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w pleito|strong="H7379"\w* \w que|strong="H3808"\w* llegue \w a|strong="H3068"\w* vosotros \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* vuestros hermanos \w que|strong="H3808"\w* \w habitan|strong="H3427"\w* \w en|strong="H5921"\w* sus \w ciudades|strong="H5892"\w*, ya \w sea|strong="H1961"\w* \w sobre|strong="H5921"\w* derramamiento \w de|strong="H5921"\w* \w sangre|strong="H1818"\w* \w o|strong="H3068"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w*, \w los|strong="H3427"\w* \w mandamientos|strong="H4687"\w*, \w los|strong="H3427"\w* \w estatutos|strong="H2706"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w ordenanzas|strong="H2706"\w*, deberéis advertirles \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* pequen \w contra|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w así|strong="H3541"\w* \w no|strong="H3808"\w* \w venga|strong="H1961"\w* \w la|strong="H5921"\w* \w ira|strong="H7110"\w* \w sobre|strong="H5921"\w* vosotros \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* vuestros hermanos. \w Haced|strong="H6213"\w* \w esto|strong="H3541"\w*, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w seréis|strong="H1961"\w* culpables.  
\v 11 He \w aquí|strong="H2009"\w*, \w el|strong="H5921"\w* \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w* Amarías \w estará|strong="H1961"\w* \w sobre|strong="H5921"\w* \w vosotros|strong="H5973"\w* \w en|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* asuntos \w de|strong="H5921"\w* Yahvé; \w y|strong="H5921"\w* \w Zebadías|strong="H2069"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Ismael|strong="H3458"\w*, \w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w en|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* asuntos \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. \w Los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w servirán|strong="H1961"\w* \w como|strong="H5973"\w* \w oficiales|strong="H7860"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w vosotros|strong="H5973"\w*. \w Esforzaos|strong="H2388"\w* \w y|strong="H5921"\w* obrad \w con|strong="H5973"\w* valentía, \w y|strong="H5921"\w* \w que|strong="H5921"\w* Yahvé \w esté|strong="H1961"\w* \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w hace|strong="H6213"\w* \w el|strong="H5921"\w* \w bien|strong="H2896"\w*”.   
\c 20  
\p
\v 1 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* estas cosas, \w aconteció|strong="H1961"\w* \w que|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Amón, \w y|strong="H5921"\w* \w con|strong="H5973"\w* \w ellos|strong="H5921"\w* algunos \w de|strong="H5921"\w* \w los|strong="H1121"\w* meunitas, vinieron \w contra|strong="H5921"\w* Josafat \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*.  
\v 2 Acudieron algunos \w y|strong="H5921"\w* dieron \w aviso|strong="H5046"\w* \w a|strong="H3068"\w* Josafat, diciendo: “Una \w gran|strong="H7227"\w* \w multitud|strong="H1995"\w* viene \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w desde|strong="H5921"\w* \w el|strong="H1931"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*, \w desde|strong="H5921"\w* Aram; \w y|strong="H5921"\w* he \w aquí|strong="H2009"\w*, \w están|strong="H2009"\w* \w en|strong="H5921"\w* Hazazón Tamar” (\w que|strong="H1931"\w* \w es|strong="H1931"\w* \w En|strong="H5921"\w* Gedi).  
\v 3 Josafat \w tuvo|strong="H3372"\w* \w miedo|strong="H3372"\w* \w y|strong="H5921"\w* dispuso su corazón \w para|strong="H5921"\w* buscar \w a|strong="H3068"\w* Yahvé, \w y|strong="H5921"\w* \w proclamó|strong="H7121"\w* un \w ayuno|strong="H6685"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w*.  
\v 4 Se reunieron \w los|strong="H3605"\w* de \w Judá|strong="H3063"\w* para pedir ayuda \w a|strong="H3068"\w* Yahvé; de \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w* acudieron para buscar \w a|strong="H3068"\w* Yahvé.   
\p
\v 5 Josafat se \w puso|strong="H5975"\w* \w en|strong="H5975"\w* \w pie|strong="H5975"\w* \w en|strong="H5975"\w* la asamblea \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* y \w de|strong="H6440"\w* Jerusalén, \w en|strong="H5975"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé, \w delante|strong="H6440"\w* del \w atrio|strong="H2691"\w* \w nuevo|strong="H2319"\w*,  
\v 6 y dijo: “Oh Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* nuestros padres, ¿\w no|strong="H3808"\w* \w eres|strong="H1931"\w* tú \w Dios|strong="H3068"\w* \w en|strong="H5973"\w* \w los|strong="H3605"\w* \w cielos|strong="H8064"\w*, y gobiernas sobre \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H5973"\w* las \w naciones|strong="H1471"\w*? \w En|strong="H5973"\w* tu \w mano|strong="H3027"\w* hay \w fuerza|strong="H3581"\w* y \w poder|strong="H3027"\w*, \w de|strong="H5973"\w* modo \w que|strong="H1931"\w* \w nadie|strong="H3808"\w* puede resistirte.  
\v 7 ¿\w No|strong="H3808"\w* expulsaste tú, Dios nuestro, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H6440"\w* \w esta|strong="H2063"\w* tierra \w delante|strong="H6440"\w* \w de|strong="H6440"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, y \w la|strong="H2063"\w* \w diste|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H2063"\w* \w descendencia|strong="H2233"\w* \w de|strong="H6440"\w* tu amigo Abraham \w para|strong="H5414"\w* \w siempre|strong="H5769"\w*?  
\v 8 Ellos han habitado en ella, y te han \w edificado|strong="H1129"\w* en ella un \w santuario|strong="H4720"\w* \w a|strong="H3068"\w* tu \w nombre|strong="H8034"\w*, diciendo:  
\v 9 ‘\w Si|strong="H3588"\w* \w nos|strong="H5921"\w* sobreviene \w el|strong="H5921"\w* \w mal|strong="H7451"\w*, \w ya|strong="H2088"\w* sea \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, \w el|strong="H5921"\w* juicio, \w la|strong="H5921"\w* peste \w o|strong="H3068"\w* \w el|strong="H5921"\w* \w hambre|strong="H7458"\w*, \w nos|strong="H5921"\w* presentaremos \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w esta|strong="H2088"\w* \w casa|strong="H1004"\w* \w y|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w* (\w porque|strong="H3588"\w* tu \w nombre|strong="H8034"\w* \w está|strong="H2088"\w* \w en|strong="H5921"\w* \w esta|strong="H2088"\w* \w casa|strong="H1004"\w*), \w y|strong="H3588"\w* \w clamaremos|strong="H2199"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w en|strong="H5921"\w* nuestra \w tribulación|strong="H6869"\w*, \w y|strong="H3588"\w* tú \w nos|strong="H5921"\w* escucharás \w y|strong="H3588"\w* \w nos|strong="H5921"\w* \w salvarás|strong="H3467"\w*’.  
\v 10 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w*, he \w aquí|strong="H2009"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Amón, \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w y|strong="H3588"\w* \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w Seír|strong="H8165"\w*, \w a|strong="H3068"\w* cuyas tierras \w no|strong="H3808"\w* permitiste \w que|strong="H3588"\w* \w Israel|strong="H3478"\w* entrara \w cuando|strong="H3588"\w* venían \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* apartaron \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H1121"\w* \w destruyeron|strong="H8045"\w*;  
\v 11 \w mira|strong="H2009"\w* \w cómo|strong="H5921"\w* \w nos|strong="H5921"\w* pagan, viniendo \w a|strong="H3068"\w* arrojarnos \w de|strong="H5921"\w* tu \w posesión|strong="H3425"\w* \w que|strong="H5921"\w* tú \w nos|strong="H5921"\w* diste \w en|strong="H5921"\w* herencia.  
\v 12 \w Oh|strong="H4100"\w* Dios nuestro, ¿\w no|strong="H3808"\w* \w los|strong="H5921"\w* \w juzgarás|strong="H8199"\w* \w tú|strong="H8199"\w*? \w Porque|strong="H3588"\w* \w nosotros|strong="H5921"\w* carecemos \w de|strong="H5921"\w* \w fuerza|strong="H3581"\w* \w ante|strong="H6440"\w* \w esta|strong="H2088"\w* \w gran|strong="H7227"\w* \w multitud|strong="H1995"\w* \w que|strong="H3588"\w* viene \w contra|strong="H5921"\w* \w nosotros|strong="H5921"\w*; \w no|strong="H3808"\w* \w sabemos|strong="H3045"\w* \w qué|strong="H3588"\w* \w hacer|strong="H6213"\w*, \w pero|strong="H3588"\w* nuestros \w ojos|strong="H5869"\w* \w están|strong="H2088"\w* puestos \w en|strong="H5921"\w* \w ti|strong="H5921"\w*”.   
\p
\v 13 \w Todo|strong="H3605"\w* \w Judá|strong="H3063"\w* \w estaba|strong="H5975"\w* \w de|strong="H6440"\w* \w pie|strong="H5975"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w con|strong="H1571"\w* sus \w niños|strong="H2945"\w*, sus mujeres \w y|strong="H1571"\w* sus \w hijos|strong="H1121"\w*.   
\p
\v 14 Entonces \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H4480"\w* Yahvé \w vino|strong="H1961"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* asamblea \w sobre|strong="H5921"\w* \w Jahaziel|strong="H3166"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Benaía|strong="H1141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Jeiel|strong="H3273"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Matanías, un \w levita|strong="H3881"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* Asaf;  
\v 15 \w y|strong="H3588"\w* dijo: “\w Escuchad|strong="H7181"\w*, \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3588"\w* vosotros \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* Jerusalén, \w y|strong="H3588"\w* tú, \w rey|strong="H4428"\w* Josafat. \w Así|strong="H3541"\w* os dice Yahvé: ‘\w No|strong="H3808"\w* \w temáis|strong="H3372"\w* \w ni|strong="H3808"\w* os acobardéis \w delante|strong="H6440"\w* \w de|strong="H3588"\w* \w esta|strong="H2088"\w* \w gran|strong="H7227"\w* \w multitud|strong="H1995"\w*, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w batalla|strong="H4421"\w* \w no|strong="H3808"\w* \w es|strong="H2088"\w* vuestra, \w sino|strong="H3588"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 16 \w Descended|strong="H3381"\w* \w mañana|strong="H4279"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*. He \w aquí|strong="H2005"\w* \w que|strong="H5921"\w* \w ellos|strong="H5921"\w* \w subirán|strong="H5927"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* cuesta \w de|strong="H5921"\w* Ziz, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w hallaréis|strong="H4672"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* extremo \w del|strong="H5921"\w* valle, frente \w al|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* Jeruel.  
\v 17 \w No|strong="H3808"\w* tendréis \w que|strong="H3808"\w* pelear \w en|strong="H5973"\w* \w esta|strong="H2063"\w* ocasión. Poneos firmes, quedaos quietos y \w ved|strong="H7200"\w* \w la|strong="H2063"\w* salvación \w que|strong="H3808"\w* Yahvé obrará \w a|strong="H3068"\w* vuestro favor, oh \w Judá|strong="H3063"\w* y Jerusalén. \w No|strong="H3808"\w* \w temáis|strong="H3372"\w* \w ni|strong="H3808"\w* \w os|strong="H5973"\w* acobardéis. \w Salid|strong="H3318"\w* \w mañana|strong="H4279"\w* \w a|strong="H3068"\w* su encuentro, \w porque|strong="H3808"\w* Yahvé \w estará|strong="H5975"\w* \w con|strong="H5973"\w* \w vosotros|strong="H5973"\w*’”.   
\p
\v 18 Entonces Josafat \w inclinó|strong="H6915"\w* su \w rostro|strong="H6440"\w* \w a|strong="H3068"\w* tierra, y \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* y \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H6440"\w* Jerusalén se postraron \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, para adorar \w a|strong="H3068"\w* Yahvé.  
\v 19 \w Y|strong="H3068"\w* \w se|strong="H4480"\w* \w levantaron|strong="H6965"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* Coat y \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Coré|strong="H7145"\w* \w para|strong="H4480"\w* \w alabar|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* \w gran|strong="H1419"\w* \w voz|strong="H6963"\w*.   
\p
\v 20 Se levantaron muy de \w mañana|strong="H1242"\w* y \w salieron|strong="H3318"\w* al \w desierto|strong="H4057"\w* de Tecoa. \w Y|strong="H3068"\w* mientras \w salían|strong="H3318"\w*, Josafat se \w puso|strong="H5975"\w* \w en|strong="H3318"\w* \w pie|strong="H5975"\w* y dijo: “¡\w Escuchadme|strong="H8085"\w*, \w Judá|strong="H3063"\w* y \w habitantes|strong="H3427"\w* de Jerusalén! Creed \w en|strong="H3318"\w* Yahvé vuestro \w Dios|strong="H3068"\w*, y \w estaréis|strong="H3427"\w* seguros; creed \w a|strong="H3068"\w* sus \w profetas|strong="H5030"\w*, y seréis prosperados”.   
\p
\v 21 Después \w de|strong="H3588"\w* consultar \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*, designó \w a|strong="H3068"\w* algunos \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w cantaran|strong="H7891"\w* \w a|strong="H3068"\w* Yahvé \w y|strong="H3588"\w* lo \w alabaran|strong="H1984"\w* vestidos \w con|strong="H3588"\w* ornamentos \w sagrados|strong="H6944"\w*, \w mientras|strong="H3588"\w* marchaban al frente del ejército, diciendo: “Dad gracias \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w misericordia|strong="H2617"\w* \w es|strong="H3588"\w* \w eterna|strong="H5769"\w*”.  
\v 22 \w Cuando|strong="H6256"\w* \w comenzaron|strong="H2490"\w* \w a|strong="H3068"\w* entonar cantos \w de|strong="H5921"\w* júbilo \w y|strong="H5921"\w* \w alabanza|strong="H8416"\w*, Yahvé \w puso|strong="H5414"\w* emboscadas \w contra|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Amón, \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w Seír|strong="H8165"\w* \w que|strong="H5921"\w* habían venido \w contra|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* fueron derrotados.  
\v 23 \w Porque|strong="H5921"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Amón \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w se|strong="H5921"\w* levantaron \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w Seír|strong="H8165"\w*, \w para|strong="H5921"\w* \w destruirlos|strong="H8045"\w* \w y|strong="H5921"\w* aniquilarlos \w por|strong="H5921"\w* completo; \w y|strong="H5921"\w* cuando \w acabaron|strong="H3615"\w* \w con|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w Seír|strong="H8165"\w*, \w se|strong="H5921"\w* \w ayudaron|strong="H5826"\w* unos \w a|strong="H3068"\w* otros \w a|strong="H3068"\w* destruirse mutuamente.   
\p
\v 24 Cuando \w Judá|strong="H3063"\w* llegó \w a|strong="H3068"\w* \w la|strong="H5921"\w* atalaya \w del|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w miraron|strong="H6437"\w* \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H1995"\w*, \w y|strong="H5921"\w* he \w aquí|strong="H2005"\w* \w que|strong="H5921"\w* solo había cadáveres \w tendidos|strong="H5307"\w* \w en|strong="H5921"\w* tierra; \w no|strong="H5921"\w* había escapado nadie.  
\v 25 Josafat \w y|strong="H3588"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* recoger \w el|strong="H1931"\w* botín, \w y|strong="H3588"\w* \w hallaron|strong="H4672"\w* \w entre|strong="H3588"\w* \w los|strong="H1931"\w* cadáveres \w gran|strong="H7227"\w* cantidad \w de|strong="H3588"\w* \w enseres|strong="H3627"\w* \w y|strong="H3588"\w* joyas preciosas, las cuales despojaron \w para|strong="H3588"\w* \w sí|strong="H3588"\w*, \w hasta|strong="H3117"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* pudieron llevar \w más|strong="H3588"\w*. Pasaron \w tres|strong="H7969"\w* \w días|strong="H3117"\w* recogiendo \w el|strong="H1931"\w* botín, \w porque|strong="H3588"\w* \w era|strong="H1961"\w* muchísimo.  
\v 26 \w Al|strong="H5921"\w* \w cuarto|strong="H7243"\w* \w día|strong="H3117"\w* \w se|strong="H1931"\w* congregaron \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w valle|strong="H6010"\w* \w de|strong="H5921"\w* Beracá, \w porque|strong="H3588"\w* \w allí|strong="H8033"\w* \w bendijeron|strong="H1288"\w* \w a|strong="H3068"\w* Yahvé. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w aquel|strong="H1931"\w* \w lugar|strong="H4725"\w* “\w Valle|strong="H6010"\w* \w de|strong="H5921"\w* Beracá”, \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*.  
\v 27 Después, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén, \w con|strong="H3588"\w* Josafat \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w cabeza|strong="H7218"\w*, emprendieron \w el|strong="H3588"\w* regreso \w a|strong="H3068"\w* Jerusalén \w con|strong="H3588"\w* \w gozo|strong="H8057"\w*, \w porque|strong="H3588"\w* Yahvé les \w había|strong="H3588"\w* dado \w alegría|strong="H8057"\w* sobre sus enemigos.  
\v 28 Entraron en Jerusalén al son \w de|strong="H5035"\w* \w arpas|strong="H3658"\w*, liras y \w trompetas|strong="H2689"\w*, y se dirigieron \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H5035"\w* Yahvé.  
\v 29 \w Y|strong="H3068"\w* \w el|strong="H5921"\w* \w temor|strong="H6343"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* cayó \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* aquellas tierras \w cuando|strong="H3588"\w* \w oyeron|strong="H8085"\w* \w que|strong="H3588"\w* Yahvé \w había|strong="H1961"\w* peleado \w contra|strong="H5921"\w* \w los|strong="H5921"\w* enemigos \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 30 Así \w el|strong="H8252"\w* \w reino|strong="H4438"\w* de Josafat tuvo paz, porque su Dios le dio descanso por \w todas|strong="H5439"\w* \w partes|strong="H5439"\w*.   
\p
\v 31 Así \w reinó|strong="H4427"\w* Josafat \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w*. Tenía \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, \w y|strong="H5921"\w* \w reinó|strong="H4427"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w en|strong="H5921"\w* Jerusalén. Su madre \w se|strong="H5921"\w* \w llamaba|strong="H8034"\w* \w Azubá|strong="H5806"\w*, \w hija|strong="H1323"\w* \w de|strong="H5921"\w* \w Silhí|strong="H7977"\w*.  
\v 32 \w Anduvo|strong="H3212"\w* \w en|strong="H4480"\w* \w el|strong="H6213"\w* \w camino|strong="H1870"\w* \w de|strong="H4480"\w* su padre Asá y \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartó \w de|strong="H4480"\w* \w él|strong="H6213"\w*, \w haciendo|strong="H6213"\w* \w lo|strong="H3808"\w* \w recto|strong="H3477"\w* ante los \w ojos|strong="H5869"\w* \w de|strong="H4480"\w* Yahvé.  
\v 33 \w Sin|strong="H3808"\w* embargo, los lugares \w altos|strong="H1116"\w* \w no|strong="H3808"\w* fueron quitados, \w pues|strong="H5750"\w* el \w pueblo|strong="H5971"\w* \w aún|strong="H5750"\w* \w no|strong="H3808"\w* había \w dispuesto|strong="H3559"\w* su \w corazón|strong="H3824"\w* \w para|strong="H5493"\w* buscar al Dios \w de|strong="H5750"\w* sus padres.   
\p
\v 34 \w Los|strong="H1121"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Josafat, \w los|strong="H1121"\w* \w primeros|strong="H7223"\w* \w y|strong="H5921"\w* \w los|strong="H1121"\w* últimos, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* crónicas \w de|strong="H5921"\w* \w Jehú|strong="H3058"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hananí|strong="H2607"\w*, \w las|strong="H5921"\w* cuales están incluidas \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 35 Después \w de|strong="H5973"\w* \w esto|strong="H1931"\w*, Josafat, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*, \w se|strong="H1931"\w* alió \w con|strong="H5973"\w* Ocozías, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*, \w el|strong="H1931"\w* \w cual|strong="H1931"\w* actuaba \w con|strong="H5973"\w* gran impiedad.  
\v 36 Se alió \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w para|strong="H5973"\w* construir barcos que fueran \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w*, y construyeron \w los|strong="H5973"\w* barcos \w en|strong="H5973"\w* Ezión Geber.  
\v 37 Pero Eliezer, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Dodavahu, \w de|strong="H5921"\w* \w Maresa|strong="H4762"\w*, \w profetizó|strong="H5012"\w* \w contra|strong="H5921"\w* Josafat, diciendo: “\w Por|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w te|strong="H5921"\w* has aliado \w con|strong="H5973"\w* Ocozías, Yahvé \w ha|strong="H3808"\w* destruido tus \w obras|strong="H4639"\w*”. \w Y|strong="H3068"\w* \w los|strong="H1121"\w* barcos naufragaron, \w de|strong="H5921"\w* modo \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w pudieron|strong="H6113"\w* \w ir|strong="H3212"\w* \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w*.   
\c 21  
\p
\v 1 Cuando Josafat murió, fue \w enterrado|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*, y su \w hijo|strong="H1121"\w* \w Joram|strong="H3088"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.  
\v 2 Joram tenía hermanos, \w que|strong="H1121"\w* también eran \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Josafat: \w Azarías|strong="H5838"\w*, \w Jehiel|strong="H3171"\w*, \w Zacarías|strong="H2148"\w*, \w Azarías|strong="H5838"\w*, \w Miguel|strong="H4317"\w* y Sefatías. \w Todos|strong="H3605"\w* \w ellos|strong="H3605"\w* eran \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 3 \w Su|strong="H1931"\w* padre \w les|strong="H1992"\w* \w había|strong="H3588"\w* regalado \w muchas|strong="H7227"\w* \w cosas|strong="H1992"\w* \w de|strong="H3588"\w* valor, \w plata|strong="H3701"\w* \w y|strong="H3588"\w* \w oro|strong="H2091"\w*, \w además|strong="H3588"\w* \w de|strong="H3588"\w* \w ciudades|strong="H5892"\w* fortificadas \w en|strong="H5973"\w* \w Judá|strong="H3063"\w*; \w pero|strong="H3588"\w* \w le|strong="H1931"\w* \w dejó|strong="H5414"\w* \w el|strong="H1931"\w* \w reino|strong="H4467"\w* \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* \w por|strong="H3588"\w* ser \w el|strong="H1931"\w* hijo \w mayor|strong="H7227"\w*.  
\v 4 \w Cuando|strong="H1571"\w* \w Joram|strong="H3088"\w* tomó \w el|strong="H5921"\w* control \w del|strong="H5921"\w* \w reino|strong="H4467"\w* \w de|strong="H5921"\w* su padre \w y|strong="H1571"\w* \w se|strong="H5921"\w* sintió seguro, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus hermanos \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* algunos \w de|strong="H5921"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 5 \w Joram|strong="H3088"\w* tenía \w treinta|strong="H7970"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén durante \w ocho|strong="H8083"\w* \w años|strong="H8141"\w*.  
\v 6 \w Siguió|strong="H3212"\w* \w el|strong="H3588"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w reyes|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w se|strong="H1961"\w* portó igual \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Acab, ya \w que|strong="H3588"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* casado \w con|strong="H3588"\w* una \w hija|strong="H1323"\w* \w de|strong="H3588"\w* Acab. Joram \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w ojos|strong="H5869"\w* \w de|strong="H3588"\w* Yahvé.  
\v 7 \w Sin|strong="H3808"\w* embargo, Yahvé \w no|strong="H3808"\w* quiso \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, debido al \w pacto|strong="H1285"\w* \w que|strong="H3808"\w* había \w hecho|strong="H3772"\w* con \w él|strong="H3605"\w*. Además, le había prometido \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H3808"\w* \w siempre|strong="H3605"\w* habría un descendiente suyo en \w el|strong="H3605"\w* trono.   
\p
\v 8 Durante \w el|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Joram, \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* Edom \w se|strong="H5921"\w* rebeló \w contra|strong="H5921"\w* \w el|strong="H5921"\w* dominio \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* nombraron \w a|strong="H3068"\w* su propio \w rey|strong="H4428"\w*.  
\v 9 Entonces \w Joram|strong="H3088"\w* \w fue|strong="H1961"\w* \w para|strong="H1961"\w* allá \w con|strong="H5973"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H5973"\w* su ejército y \w todos|strong="H3605"\w* sus \w carros|strong="H7393"\w* \w de|strong="H5973"\w* guerra. Atacó \w de|strong="H5973"\w* \w noche|strong="H3915"\w* y derrotó \w a|strong="H3068"\w* \w los|strong="H3605"\w* edomitas \w que|strong="H1961"\w* \w lo|strong="H3605"\w* \w tenían|strong="H1961"\w* rodeado \w a|strong="H3068"\w* \w él|strong="H5973"\w* y \w a|strong="H3068"\w* \w los|strong="H3605"\w* comandantes \w de|strong="H5973"\w* sus \w carros|strong="H7393"\w*.  
\v 10 \w Así|strong="H2088"\w* \w fue|strong="H1931"\w* \w como|strong="H3588"\w* Edom \w se|strong="H1931"\w* independizó del dominio \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3588"\w* \w así|strong="H2088"\w* sigue \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w*. \w En|strong="H5704"\w* \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* época, \w la|strong="H1931"\w* ciudad \w de|strong="H3588"\w* \w Libna|strong="H3841"\w* \w también|strong="H2088"\w* \w se|strong="H1931"\w* rebeló contra Joram, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w había|strong="H3588"\w* abandonado \w a|strong="H3068"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w sus|strong="H1931"\w* antepasados.   
\p
\v 11 Por \w si|strong="H1571"\w* fuera poco, Joram construyó \w altares|strong="H1116"\w* paganos en las colinas de \w Judá|strong="H3063"\w*, \w hizo|strong="H6213"\w* \w que|strong="H1931"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén \w se|strong="H1931"\w* prostituyeran adorando ídolos, \w y|strong="H1571"\w* llevó \w a|strong="H3068"\w* \w la|strong="H1931"\w* gente de \w Judá|strong="H3063"\w* por \w el|strong="H1931"\w* mal camino.  
\v 12 Entonces le llegó una carta del \w profeta|strong="H5030"\w* Elías \w que|strong="H3808"\w* decía: “\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* dice Yahvé, \w el|strong="H5030"\w* \w Dios|strong="H3068"\w* \w de|strong="H8478"\w* tu antepasado \w David|strong="H1732"\w*: ‘\w Como|strong="H8478"\w* \w no|strong="H3808"\w* has seguido \w el|strong="H5030"\w* buen ejemplo \w de|strong="H8478"\w* tu padre Josafat, \w ni|strong="H3808"\w* \w el|strong="H5030"\w* \w de|strong="H8478"\w* Asá, \w rey|strong="H4428"\w* \w de|strong="H8478"\w* \w Judá|strong="H3063"\w*,  
\v 13 \w sino|strong="H2896"\w* \w que|strong="H4480"\w* \w has|strong="H2026"\w* seguido \w el|strong="H3427"\w* mal ejemplo \w de|strong="H4480"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H1571"\w* \w has|strong="H2026"\w* hecho \w que|strong="H4480"\w* \w Judá|strong="H3063"\w* \w y|strong="H1571"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H4480"\w* Jerusalén \w se|strong="H4480"\w* prostituyan adorando ídolos \w como|strong="H1571"\w* lo hizo \w la|strong="H1571"\w* \w familia|strong="H1004"\w* \w de|strong="H4480"\w* Acab; \w y|strong="H1571"\w* \w como|strong="H1571"\w* \w además|strong="H1571"\w* \w mataste|strong="H2026"\w* \w a|strong="H3068"\w* tus propios hermanos, \w que|strong="H4480"\w* eran \w mejores|strong="H2896"\w* \w que|strong="H4480"\w* tú,  
\v 14 ¡escucha bien! Yahvé \w va|strong="H3068"\w* \w a|strong="H3068"\w* castigar \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* con una terrible \w plaga|strong="H4046"\w*, \w que|strong="H5971"\w* afectará \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w*, \w a|strong="H3068"\w* tus esposas y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H5971"\w* tienes.  
\v 15 \w Y|strong="H3068"\w* tú vas \w a|strong="H3068"\w* sufrir una terrible \w enfermedad|strong="H2483"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* intestinos, \w hasta|strong="H5704"\w* \w que|strong="H4480"\w* \w se|strong="H5921"\w* \w te|strong="H5921"\w* \w salgan|strong="H3318"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* fuerza \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w enfermedad|strong="H2483"\w*, \w día|strong="H3117"\w* tras \w día|strong="H3117"\w*’”.   
\p
\v 16 Yahvé hizo \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* árabes \w que|strong="H5921"\w* vivían \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* etíopes \w se|strong="H5921"\w* levantaran \w contra|strong="H5921"\w* \w Joram|strong="H3088"\w*.  
\v 17 Atacaron \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, invadieron \w el|strong="H3588"\w* país \w y|strong="H1571"\w* \w se|strong="H3808"\w* robaron \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w de|strong="H3588"\w* valor \w que|strong="H3588"\w* encontraron \w en|strong="H3588"\w* \w el|strong="H3588"\w* palacio \w real|strong="H4428"\w*, \w y|strong="H1571"\w* hasta \w se|strong="H3808"\w* llevaron \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* las esposas del \w rey|strong="H4428"\w*. \w No|strong="H3808"\w* le \w quedó|strong="H7604"\w* \w ni|strong="H3808"\w* un solo \w hijo|strong="H1121"\w*, excepto Joacaz, \w que|strong="H3588"\w* \w era|strong="H1121"\w* \w el|strong="H3588"\w* \w menor|strong="H6996"\w*.   
\p
\v 18 Después de \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, Yahvé castigó \w a|strong="H3068"\w* Joram con una \w enfermedad|strong="H2483"\w* intestinal \w que|strong="H3605"\w* no tenía cura.  
\v 19 \w Al|strong="H6256"\w* cabo \w de|strong="H5973"\w* \w dos|strong="H8147"\w* \w años|strong="H3117"\w*, la \w enfermedad|strong="H2483"\w* empeoró tanto \w que|strong="H3808"\w* \w los|strong="H5973"\w* intestinos \w se|strong="H1961"\w* \w le|strong="H5973"\w* \w salieron|strong="H3318"\w* y \w murió|strong="H4191"\w* sufriendo terribles dolores. Su \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* encendió \w ningún|strong="H3808"\w* fuego \w en|strong="H5973"\w* su honor, \w como|strong="H5973"\w* \w lo|strong="H3808"\w* \w habían|strong="H1961"\w* \w hecho|strong="H6213"\w* por sus antepasados.  
\v 20 Joram \w tenía|strong="H1961"\w* \w treinta|strong="H7970"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y gobernó \w en|strong="H6912"\w* Jerusalén durante \w ocho|strong="H8083"\w* \w años|strong="H8141"\w*. Murió \w sin|strong="H3808"\w* \w que|strong="H3808"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* le importara, y \w lo|strong="H3808"\w* enterraron \w en|strong="H6912"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, pero \w no|strong="H3808"\w* \w en|strong="H6912"\w* las tumbas \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w*.   
\c 22  
\p
\v 1 \w Como|strong="H3588"\w* \w los|strong="H3427"\w* invasores \w que|strong="H3588"\w* habían venido \w con|strong="H3588"\w* \w los|strong="H3427"\w* árabes \w al|strong="H4428"\w* \w campamento|strong="H4264"\w* habían matado \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* mayores del \w rey|strong="H4428"\w*, \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* Jerusalén hicieron \w rey|strong="H4428"\w* \w a|strong="H3068"\w* Ocozías, \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w menor|strong="H6996"\w* \w de|strong="H3588"\w* \w Joram|strong="H3088"\w*. \w Así|strong="H3588"\w* \w fue|strong="H3063"\w* \w como|strong="H3588"\w* Ocozías \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Joram|strong="H3088"\w* se convirtió \w en|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*.  
\v 2 Ocozías tenía cuarenta y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* solo un \w año|strong="H8141"\w* en Jerusalén. Su madre se \w llamaba|strong="H8034"\w* \w Atalía|strong="H6271"\w*, y \w era|strong="H8141"\w* nieta \w de|strong="H1121"\w* \w Omrí|strong="H6018"\w*.  
\v 3 \w Él|strong="H1931"\w* \w también|strong="H1571"\w* siguió \w el|strong="H1931"\w* mal ejemplo \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Acab, \w porque|strong="H3588"\w* \w su|strong="H1931"\w* madre \w le|strong="H1931"\w* \w daba|strong="H3289"\w* malos consejos \w para|strong="H3588"\w* \w que|strong="H3588"\w* actuara \w con|strong="H3588"\w* maldad.  
\v 4 \w Hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w ojos|strong="H5869"\w* \w de|strong="H3588"\w* Yahvé, igual \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Acab, \w porque|strong="H3588"\w* \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H1992"\w* padre murió, \w ellos|strong="H1992"\w* \w se|strong="H1961"\w* convirtieron \w en|strong="H3588"\w* \w sus|strong="H1992"\w* \w consejeros|strong="H3289"\w*, \w y|strong="H3588"\w* \w lo|strong="H6213"\w* llevaron \w a|strong="H3068"\w* \w la|strong="H3588"\w* ruina.  
\v 5 \w Siguiendo|strong="H3212"\w* \w el|strong="H5921"\w* \w consejo|strong="H6098"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, Ocozías \w se|strong="H5921"\w* unió \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Acab, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w para|strong="H5921"\w* pelear \w contra|strong="H5921"\w* \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria, \w en|strong="H5921"\w* Ramot \w de|strong="H5921"\w* \w Galaad|strong="H1568"\w*. Pero \w los|strong="H1121"\w* sirios \w hirieron|strong="H5221"\w* \w a|strong="H3068"\w* \w Joram|strong="H3088"\w*.  
\v 6 \w Joram|strong="H3088"\w* regresó \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w* \w para|strong="H3588"\w* recuperarse \w de|strong="H3588"\w* las \w heridas|strong="H4347"\w* \w que|strong="H3588"\w* \w los|strong="H1121"\w* sirios \w le|strong="H1931"\w* habían hecho \w en|strong="H3588"\w* \w Ramá|strong="H7414"\w* \w cuando|strong="H3588"\w* \w peleó|strong="H3898"\w* contra \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Hazael|strong="H2371"\w*. \w Y|strong="H3068"\w* Ocozías \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Joram|strong="H3088"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w fue|strong="H1931"\w* \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w* \w para|strong="H3588"\w* visitar \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Acab, \w porque|strong="H3588"\w* estaba herido.   
\p
\v 7 \w Dios|strong="H3068"\w* \w había|strong="H1961"\w* planeado \w que|strong="H1121"\w* la visita \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* \w fuera|strong="H1961"\w* la ruina \w de|strong="H5973"\w* Ocozías. \w Cuando|strong="H1961"\w* Ocozías llegó, \w salió|strong="H3318"\w* \w con|strong="H5973"\w* \w Joram|strong="H3088"\w* \w a|strong="H3068"\w* encontrarse \w con|strong="H5973"\w* \w Jehú|strong="H3058"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Nimsí, \w a|strong="H3068"\w* quien Yahvé \w había|strong="H1961"\w* elegido \w para|strong="H1961"\w* destruir \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H5973"\w* Acab.  
\v 8 Mientras \w Jehú|strong="H3058"\w* \w estaba|strong="H1961"\w* castigando \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H5973"\w* Acab, \w se|strong="H1961"\w* encontró \w con|strong="H5973"\w* \w los|strong="H1121"\w* líderes \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* y \w con|strong="H5973"\w* \w los|strong="H1121"\w* sobrinos \w de|strong="H5973"\w* Ocozías, \w que|strong="H1121"\w* \w estaban|strong="H1961"\w* al servicio \w del|strong="H5973"\w* rey, y \w los|strong="H1121"\w* \w mató|strong="H2026"\w*.  
\v 9 \w Luego|strong="H1931"\w* mandó buscar \w a|strong="H3068"\w* Ocozías, \w que|strong="H3588"\w* \w estaba|strong="H1004"\w* \w escondido|strong="H2244"\w* \w en|strong="H3588"\w* \w Samaria|strong="H8111"\w*. \w Lo|strong="H1931"\w* atraparon, \w lo|strong="H1931"\w* llevaron ante \w Jehú|strong="H3058"\w* \w y|strong="H3588"\w* \w lo|strong="H1931"\w* \w mataron|strong="H4191"\w*. \w Pero|strong="H3588"\w* \w le|strong="H1931"\w* dieron un entierro digno, \w pues|strong="H3588"\w* dijeron: “\w Es|strong="H1931"\w* \w nieto|strong="H1121"\w* \w de|strong="H3588"\w* Josafat, un \w hombre|strong="H1121"\w* \w que|strong="H3588"\w* \w buscó|strong="H1875"\w* \w a|strong="H3068"\w* Yahvé \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*”. Después \w de|strong="H3588"\w* \w esto|strong="H1931"\w*, \w no|strong="H3588"\w* quedó \w nadie|strong="H3605"\w* \w en|strong="H3588"\w* \w la|strong="H1931"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Ocozías \w con|strong="H3588"\w* \w el|strong="H1931"\w* \w poder|strong="H3581"\w* suficiente \w para|strong="H3588"\w* gobernar \w el|strong="H1931"\w* \w reino|strong="H4467"\w*.   
\p
\v 10 \w Cuando|strong="H3588"\w* \w Atalía|strong="H6271"\w*, \w la|strong="H3588"\w* madre \w de|strong="H3588"\w* Ocozías, se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* \w había|strong="H3588"\w* \w muerto|strong="H4191"\w*, tomó \w la|strong="H3588"\w* decisión \w de|strong="H3588"\w* asesinar \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* herederos al trono \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*.  
\v 11 \w Pero|strong="H3588"\w* \w la|strong="H1931"\w* princesa Josabet, hermana \w de|strong="H3588"\w* Ocozías, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w Joás|strong="H3101"\w*, \w que|strong="H3588"\w* \w era|strong="H1961"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ocozías, \w y|strong="H3588"\w* \w lo|strong="H1931"\w* rescató \w en|strong="H8432"\w* secreto \w de|strong="H3588"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* príncipes \w que|strong="H3588"\w* \w estaban|strong="H1961"\w* \w siendo|strong="H1931"\w* asesinados, escondiéndolo \w a|strong="H3068"\w* \w él|strong="H1931"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* niñera \w en|strong="H8432"\w* un dormitorio. \w Así|strong="H3588"\w* \w fue|strong="H1961"\w* \w como|strong="H3588"\w* Josabet, \w que|strong="H3588"\w* \w era|strong="H1961"\w* \w hija|strong="H1323"\w* del \w rey|strong="H4428"\w* \w Joram|strong="H3088"\w* \w y|strong="H3588"\w* esposa del \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*, \w escondió|strong="H5641"\w* \w al|strong="H4428"\w* niño \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w Atalía|strong="H6271"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w matara|strong="H4191"\w*.  
\v 12 Joás \w estuvo|strong="H1961"\w* \w escondido|strong="H2244"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios durante \w seis|strong="H8337"\w* \w años|strong="H8141"\w*, bajo \w el|strong="H5921"\w* cuidado \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, mientras \w Atalía|strong="H6271"\w* gobernaba \w el|strong="H5921"\w* país.   
\c 23  
\p
\v 1 \w En|strong="H5973"\w* \w el|strong="H5973"\w* \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w*, \w el|strong="H5973"\w* sacerdote \w Joiada|strong="H3077"\w* se armó \w de|strong="H5973"\w* valor \w e|strong="H3068"\w* hizo una \w alianza|strong="H1285"\w* \w con|strong="H5973"\w* \w los|strong="H1121"\w* comandantes \w del|strong="H5973"\w* ejército: \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Jeroham|strong="H3395"\w*, \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Johanán|strong="H3076"\w*, \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Obed|strong="H5744"\w*, \w Maasías|strong="H4641"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Adaías|strong="H5718"\w* y Elisafat \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Zicri.  
\v 2 \w Ellos|strong="H3605"\w* recorrieron \w Judá|strong="H3063"\w* reuniendo \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* de \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w jefes|strong="H7218"\w* de las familias de \w Israel|strong="H3478"\w*, y \w los|strong="H3605"\w* llevaron \w a|strong="H3068"\w* Jerusalén.  
\v 3 \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*. \w Y|strong="H3068"\w* Joiada \w les|strong="H1992"\w* \w dijo|strong="H1696"\w*: “¡\w Aquí|strong="H2009"\w* \w tienen|strong="H1992"\w* \w al|strong="H5921"\w* \w hijo|strong="H1121"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*! \w Él|strong="H5921"\w* es \w quien|strong="H3605"\w* debe gobernar, tal \w como|strong="H5973"\w* Yahvé \w lo|strong="H5921"\w* prometió \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* descendientes \w de|strong="H5921"\w* \w David|strong="H1732"\w*.  
\v 4 \w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H4480"\w* deben \w hacer|strong="H6213"\w*: Una \w tercera|strong="H7992"\w* parte \w de|strong="H4480"\w* ustedes, los \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w* \w que|strong="H4480"\w* entran \w de|strong="H4480"\w* turno \w el|strong="H6213"\w* \w sábado|strong="H7676"\w*, vigilarán las entradas \w del|strong="H4480"\w* templo.  
\v 5 Otra \w tercera|strong="H7992"\w* parte vigilará \w el|strong="H3605"\w* palacio del \w rey|strong="H4428"\w*, y \w la|strong="H3605"\w* otra \w tercera|strong="H7992"\w* parte vigilará \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* \w de|strong="H5971"\w* \w los|strong="H3605"\w* Cimientos. \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* quedará en \w los|strong="H3605"\w* \w patios|strong="H2691"\w* del \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé.  
\v 6 \w Nadie|strong="H3605"\w* \w más|strong="H3588"\w* podrá entrar al \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, excepto \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* \w que|strong="H3588"\w* estén \w de|strong="H3588"\w* servicio. \w Ellos|strong="H1992"\w* podrán entrar \w porque|strong="H3588"\w* están consagrados \w para|strong="H3588"\w* hacerlo, \w pero|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* deberá obedecer \w las|strong="H1992"\w* órdenes \w de|strong="H3588"\w* Yahvé.  
\v 7 \w Los|strong="H1961"\w* \w levitas|strong="H3881"\w* harán un círculo \w alrededor|strong="H5439"\w* del \w rey|strong="H4428"\w*, cada uno con sus \w armas|strong="H3627"\w* \w en|strong="H3318"\w* la \w mano|strong="H3027"\w*. \w Si|strong="H1961"\w* alguien intenta entrar \w al|strong="H4428"\w* \w templo|strong="H1004"\w*, lo \w matarán|strong="H4191"\w*. Ustedes protegerán \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H1961"\w* vaya”.   
\p
\v 8 \w Los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w hicieron|strong="H6213"\w* exactamente \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w* \w les|strong="H5973"\w* \w ordenó|strong="H6680"\w*. \w Cada|strong="H3605"\w* comandante reunió \w a|strong="H3068"\w* sus hombres, tanto \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* empezaban \w su|strong="H3588"\w* turno \w el|strong="H5973"\w* \w sábado|strong="H7676"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* \w lo|strong="H3808"\w* terminaban, \w pues|strong="H3588"\w* \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w* \w no|strong="H3808"\w* \w había|strong="H3588"\w* dejado \w que|strong="H3588"\w* \w nadie|strong="H3808"\w* \w se|strong="H3808"\w* \w fuera|strong="H3318"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* casa.  
\v 9 \w Joiada|strong="H3077"\w* les \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* los comandantes las lanzas, los \w escudos|strong="H4043"\w* grandes y los \w escudos|strong="H4043"\w* pequeños que habían sido del \w rey|strong="H4428"\w* \w David|strong="H1732"\w* y que estaban guardados en el \w templo|strong="H1004"\w* \w de|strong="H8269"\w* Dios.  
\v 10 \w Luego|strong="H5704"\w* acomodó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w cada|strong="H3605"\w* uno \w con|strong="H5921"\w* su arma \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w desde|strong="H5704"\w* \w el|strong="H5921"\w* \w lado|strong="H3802"\w* sur \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w lado|strong="H3802"\w* norte \w del|strong="H5921"\w* \w templo|strong="H1004"\w*, \w alrededor|strong="H5439"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*, \w para|strong="H5704"\w* proteger \w al|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 11 Entonces \w sacaron|strong="H3318"\w* \w al|strong="H5921"\w* \w hijo|strong="H1121"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w le|strong="H5921"\w* \w pusieron|strong="H5414"\w* \w la|strong="H5921"\w* corona, \w le|strong="H5921"\w* entregaron una copia \w del|strong="H5921"\w* pacto \w y|strong="H5921"\w* \w lo|strong="H5921"\w* proclamaron \w rey|strong="H4428"\w*. \w Joiada|strong="H3077"\w* \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w lo|strong="H5921"\w* \w ungieron|strong="H4886"\w* \w con|strong="H5921"\w* aceite \w y|strong="H5921"\w* gritaron: “¡\w Viva|strong="H2421"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*!”   
\p
\v 12 Cuando \w Atalía|strong="H6271"\w* \w escuchó|strong="H8085"\w* los gritos \w de|strong="H5971"\w* la guardia y \w de|strong="H5971"\w* la \w gente|strong="H5971"\w* \w que|strong="H5971"\w* aclamaba \w al|strong="H4428"\w* \w rey|strong="H4428"\w*, \w se|strong="H5971"\w* fue \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, \w a|strong="H3068"\w* donde \w estaba|strong="H1004"\w* el \w pueblo|strong="H5971"\w*.  
\v 13 \w Se|strong="H3045"\w* asomó, \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* su \w columna|strong="H5982"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w entrada|strong="H3996"\w* \w del|strong="H5921"\w* templo, rodeado \w de|strong="H5921"\w* \w los|strong="H5921"\w* comandantes \w y|strong="H5921"\w* \w los|strong="H5921"\w* trompetistas. \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w del|strong="H5921"\w* país celebraba tocando \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* músicos \w con|strong="H5921"\w* sus \w instrumentos|strong="H3627"\w* dirigían \w las|strong="H5921"\w* \w canciones|strong="H7892"\w* \w de|strong="H5921"\w* \w alabanza|strong="H1984"\w*. \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* esto, \w Atalía|strong="H6271"\w* \w se|strong="H3045"\w* \w rasgó|strong="H7167"\w* \w la|strong="H5921"\w* ropa \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* coraje \w y|strong="H5921"\w* gritó: “¡\w Traición|strong="H7195"\w*! ¡\w Traición|strong="H7195"\w*!”   
\p
\v 14 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w* hizo \w salir|strong="H3318"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* comandantes \w que|strong="H3588"\w* estaban \w a|strong="H3068"\w* \w cargo|strong="H6485"\w* \w de|strong="H3588"\w* las tropas \w y|strong="H3588"\w* les ordenó: “¡Sáquenla \w de|strong="H3588"\w* aquí \w por|strong="H3588"\w* \w entre|strong="H3808"\w* las filas! \w Y|strong="H3068"\w* \w si|strong="H3588"\w* alguien intenta seguirla, ¡mátenlo \w a|strong="H3068"\w* \w espada|strong="H2719"\w*!” \w El|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w había|strong="H3588"\w* dicho esto \w porque|strong="H3588"\w* \w no|strong="H3808"\w* quería \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w mataran|strong="H4191"\w* dentro del \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé.  
\v 15 Así \w que|strong="H3027"\w* los guardias la agarraron y la sacaron \w a|strong="H3068"\w* la fuerza. Cuando llegaron \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* de los \w Caballos|strong="H5483"\w*, \w que|strong="H3027"\w* \w da|strong="H7760"\w* \w al|strong="H4428"\w* palacio \w real|strong="H4428"\w*, \w allí|strong="H8033"\w* la \w mataron|strong="H4191"\w*.   
\p
\v 16 Luego, \w Joiada|strong="H3077"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* entre \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* y \w él|strong="H3605"\w* \w mismo|strong="H3605"\w*, prometiendo \w que|strong="H5971"\w* \w todos|strong="H3605"\w* serían \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Yahvé.  
\v 17 Después, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* multitud \w se|strong="H5971"\w* fue al \w templo|strong="H1004"\w* \w de|strong="H6440"\w* \w Baal|strong="H1168"\w* y \w lo|strong="H3605"\w* derrumbaron. Destrozaron \w los|strong="H3605"\w* \w altares|strong="H4196"\w* y las \w imágenes|strong="H6754"\w*, y allí \w mismo|strong="H3605"\w* \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* Matán, \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w de|strong="H6440"\w* \w Baal|strong="H1168"\w*.  
\v 18 \w Joiada|strong="H3077"\w* \w puso|strong="H7760"\w* \w la|strong="H5921"\w* administración \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w levitas|strong="H3881"\w*, tal \w como|strong="H5921"\w* \w David|strong="H1732"\w* \w lo|strong="H5921"\w* había organizado. \w Ellos|strong="H3027"\w* debían ofrecerle \w los|strong="H5921"\w* \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé \w según|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w con|strong="H5921"\w* cantos \w y|strong="H5921"\w* \w alegría|strong="H8057"\w*, siguiendo \w las|strong="H5921"\w* instrucciones \w de|strong="H5921"\w* \w David|strong="H1732"\w*.  
\v 19 También \w puso|strong="H5975"\w* \w porteros|strong="H7778"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* entradas \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w para|strong="H5921"\w* evitar \w que|strong="H3808"\w* entrara \w cualquier|strong="H3605"\w* persona \w que|strong="H3808"\w* estuviera impura \w por|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w motivo|strong="H1697"\w*.  
\v 20 Finalmente, Joiada \w se|strong="H5921"\w* reunió \w con|strong="H5921"\w* \w los|strong="H3427"\w* comandantes, \w los|strong="H3427"\w* líderes \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudad, \w los|strong="H3427"\w* gobernadores \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H5921"\w* juntos escoltaron \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé. Entraron \w al|strong="H5921"\w* palacio \w real|strong="H4428"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* Superior \w y|strong="H5921"\w* \w sentaron|strong="H3427"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w del|strong="H5921"\w* \w reino|strong="H4467"\w*.  
\v 21 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* del país hizo fiesta, y \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* por fin tuvo paz después \w de|strong="H5971"\w* \w que|strong="H5971"\w* \w mataron|strong="H4191"\w* \w a|strong="H3068"\w* \w Atalía|strong="H6271"\w*.   
\c 24  
\p
\v 1 \w Joás|strong="H3101"\w* tenía \w siete|strong="H7651"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* durante cuarenta \w años|strong="H8141"\w* en Jerusalén. Su madre se \w llamaba|strong="H8034"\w* Sibia, y \w era|strong="H8141"\w* \w de|strong="H1121"\w* Berseba.  
\v 2 \w Joás|strong="H3101"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3117"\w* \w le|strong="H5869"\w* agradaba \w a|strong="H3068"\w* Yahvé durante \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* \w que|strong="H3117"\w* \w vivió|strong="H3117"\w* \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*.  
\v 3 \w Joiada|strong="H3077"\w* le consiguió \w dos|strong="H8147"\w* esposas, y Joás \w tuvo|strong="H5375"\w* varios \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.   
\p
\v 4 Algún tiempo \w después|strong="H1961"\w*, \w Joás|strong="H3101"\w* decidió restaurar \w el|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Yahvé.  
\v 5 Reunió \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* y les dijo: “Vayan \w por|strong="H1697"\w* \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* y recojan \w dinero|strong="H3701"\w* \w de|strong="H1697"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas, \w cada|strong="H3605"\w* \w año|strong="H8141"\w*, para reparar \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H1697"\w* su Dios. ¡Procuren hacer \w esto|strong="H1697"\w* \w lo|strong="H1697"\w* \w más|strong="H3808"\w* rápido posible!” Pero \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* apuraron.  
\v 6 Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* mandó \w llamar|strong="H7121"\w* \w al|strong="H5921"\w* \w sumo|strong="H7218"\w* sacerdote \w Joiada|strong="H3077"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* reclamó: “¿\w Por|strong="H5921"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* has exigido \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H3808"\w* traigan \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Jerusalén \w el|strong="H5921"\w* tributo ordenado \w por|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w el|strong="H5921"\w* \w siervo|strong="H5650"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Pacto?”  
\v 7 \w Y|strong="H3068"\w* \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* esa mujer tan malvada, \w Atalía|strong="H6271"\w*, habían destrozado \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w y|strong="H1571"\w* hasta se habían llevado las cosas \w sagradas|strong="H6944"\w* del \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé \w para|strong="H3588"\w* usarlas \w en|strong="H3588"\w* \w la|strong="H1571"\w* adoración \w a|strong="H3068"\w* \w los|strong="H1121"\w* baales.   
\p
\v 8 Así que \w el|strong="H6213"\w* \w rey|strong="H4428"\w* ordenó que hicieran una caja y la pusieran \w afuera|strong="H2351"\w*, junto \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé.  
\v 9 Luego mandó \w a|strong="H3068"\w* avisar \w por|strong="H5921"\w* todo \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* Jerusalén \w que|strong="H5921"\w* debían traerle \w a|strong="H3068"\w* Yahvé \w el|strong="H5921"\w* tributo \w que|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w siervo|strong="H5650"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*, \w le|strong="H5921"\w* había impuesto \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*.  
\v 10 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes \w y|strong="H5704"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w lo|strong="H5704"\w* hicieron \w con|strong="H5704"\w* mucho gusto, trayendo \w el|strong="H3605"\w* dinero \w y|strong="H5704"\w* echándolo \w en|strong="H5704"\w* \w la|strong="H3605"\w* caja \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w se|strong="H5971"\w* llenó.  
\v 11 \w Cada|strong="H3117"\w* \w vez|strong="H6256"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w levitas|strong="H3881"\w* \w llevaban|strong="H5375"\w* \w la|strong="H3588"\w* caja \w a|strong="H3068"\w* \w los|strong="H1961"\w* funcionarios del \w rey|strong="H4428"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* revisaran, \w y|strong="H3588"\w* \w veían|strong="H7200"\w* \w que|strong="H3588"\w* \w había|strong="H1961"\w* \w mucho|strong="H7227"\w* \w dinero|strong="H3701"\w*, \w el|strong="H3588"\w* \w secretario|strong="H5608"\w* del \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* asistente del \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w* venían, vaciaban \w la|strong="H3588"\w* caja \w y|strong="H3588"\w* \w la|strong="H3588"\w* regresaban \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w lugar|strong="H4725"\w*. \w Hacían|strong="H6213"\w* \w esto|strong="H3541"\w* \w todos|strong="H7230"\w* \w los|strong="H1961"\w* \w días|strong="H3117"\w*, \w y|strong="H3588"\w* lograron juntar muchísimo \w dinero|strong="H3701"\w*.  
\v 12 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* \w y|strong="H1571"\w* \w Joiada|strong="H3077"\w* le entregaban ese dinero \w a|strong="H3068"\w* \w los|strong="H1961"\w* encargados \w de|strong="H5414"\w* \w la|strong="H1571"\w* restauración del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé. \w Ellos|strong="H1571"\w* contrataban \w a|strong="H3068"\w* \w canteros|strong="H2672"\w* \w y|strong="H1571"\w* \w carpinteros|strong="H2796"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* expertos en \w trabajar|strong="H6213"\w* \w el|strong="H6213"\w* \w hierro|strong="H1270"\w* \w y|strong="H1571"\w* \w el|strong="H6213"\w* bronce, \w para|strong="H5414"\w* reparar \w el|strong="H6213"\w* \w templo|strong="H1004"\w*.  
\v 13 \w Los|strong="H5921"\w* trabajadores \w le|strong="H5921"\w* \w echaron|strong="H5927"\w* muchas ganas, \w y|strong="H5921"\w* bajo su dirección \w la|strong="H5921"\w* restauración avanzó muy bien. Arreglaron \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios \w hasta|strong="H5921"\w* dejarlo \w como|strong="H5921"\w* \w estaba|strong="H5975"\w* antes, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* reforzaron.  
\v 14 \w Cuando|strong="H3117"\w* terminaron, le llevaron \w al|strong="H5930"\w* \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* \w Joiada|strong="H3077"\w* \w el|strong="H3605"\w* \w dinero|strong="H3701"\w* \w que|strong="H3117"\w* sobró. Con ese \w dinero|strong="H3701"\w* \w hicieron|strong="H6213"\w* utensilios \w para|strong="H1961"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé, \w para|strong="H1961"\w* usarlos en \w el|strong="H3605"\w* servicio y en \w los|strong="H3605"\w* sacrificios, incluyendo \w cucharas|strong="H3709"\w* y copas \w de|strong="H6440"\w* \w oro|strong="H2091"\w* y \w de|strong="H6440"\w* \w plata|strong="H3701"\w*. \w Mientras|strong="H3605"\w* \w Joiada|strong="H3077"\w* \w vivió|strong="H3117"\w*, \w se|strong="H1961"\w* ofrecieron \w holocaustos|strong="H5930"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé.   
\p
\v 15 \w Joiada|strong="H3077"\w* llegó \w a|strong="H3068"\w* una \w edad|strong="H3117"\w* muy avanzada y \w murió|strong="H4191"\w*. Tenía \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* \w cuando|strong="H3117"\w* falleció.  
\v 16 \w Lo|strong="H6213"\w* enterraron \w en|strong="H5973"\w* \w la|strong="H3588"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w*, \w junto|strong="H5973"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w reyes|strong="H4428"\w*, \w porque|strong="H3588"\w* \w había|strong="H3588"\w* \w hecho|strong="H6213"\w* cosas muy \w buenas|strong="H2896"\w* \w por|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w por|strong="H3588"\w* Dios \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w templo|strong="H1004"\w*.   
\p
\v 17 Después \w de|strong="H8269"\w* la \w muerte|strong="H4194"\w* \w de|strong="H8269"\w* \w Joiada|strong="H3077"\w*, los líderes \w de|strong="H8269"\w* \w Judá|strong="H3063"\w* fueron \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y se inclinaron ante él, y el \w rey|strong="H4428"\w* se dejó convencer \w por|strong="H4428"\w* ellos.  
\v 18 Abandonaron \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* sus antepasados, \w y|strong="H5921"\w* empezaron \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* \w las|strong="H5921"\w* imágenes \w de|strong="H5921"\w* Asera \w y|strong="H5921"\w* \w a|strong="H3068"\w* otros \w ídolos|strong="H6091"\w*. \w Por|strong="H5921"\w* \w esta|strong="H2063"\w* gran ofensa, \w el|strong="H5921"\w* \w enojo|strong="H7110"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* cayó \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* Jerusalén.  
\v 19 Yahvé les \w mandó|strong="H7971"\w* \w profetas|strong="H5030"\w* para convencerlos de \w que|strong="H3808"\w* regresaran \w a|strong="H3068"\w* \w él|strong="H5030"\w*. Los \w profetas|strong="H5030"\w* les advirtieron, pero ellos \w no|strong="H3808"\w* quisieron hacer caso.   
\p
\v 20 \w Entonces|strong="H3588"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w vino|strong="H4100"\w* \w sobre|strong="H5921"\w* \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* \w del|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*. \w Él|strong="H5921"\w* \w se|strong="H5921"\w* paró \w en|strong="H5921"\w* un lugar alto frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w y|strong="H3588"\w* \w les|strong="H5921"\w* dijo: “\w Esto|strong="H3541"\w* dice \w Dios|strong="H3068"\w*: ‘¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* desobedecen \w los|strong="H1121"\w* \w mandamientos|strong="H4687"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H3588"\w* buscan \w su|strong="H3588"\w* propia ruina? \w Por|strong="H5921"\w* \w haber|strong="H3808"\w* abandonado \w a|strong="H3068"\w* Yahvé, \w él|strong="H5921"\w* también \w los|strong="H1121"\w* abandonará \w a|strong="H3068"\w* ustedes’”.   
\p
\v 21 Pero \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* pusieron \w de|strong="H5921"\w* acuerdo \w para|strong="H5921"\w* matarlo, \w y|strong="H5921"\w* \w por|strong="H5921"\w* orden \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H5921"\w* apedrearon \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 22 \w Así|strong="H5973"\w* \w de|strong="H5973"\w* malagradecido \w fue|strong="H3808"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w Joás|strong="H3101"\w*. \w Se|strong="H3808"\w* olvidó \w de|strong="H5973"\w* \w lo|strong="H3808"\w* bueno \w que|strong="H3808"\w* \w Joiada|strong="H3077"\w* \w había|strong="H6213"\w* sido \w con|strong="H5973"\w* \w él|strong="H5973"\w*, y mandó asesinar \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Zacarías. \w Al|strong="H4428"\w* \w morir|strong="H4191"\w*, Zacarías alcanzó \w a|strong="H3068"\w* decir: “¡\w Que|strong="H3808"\w* Yahvé \w vea|strong="H7200"\w* \w esto|strong="H6213"\w* y \w te|strong="H5973"\w* \w lo|strong="H3808"\w* cobre!”   
\p
\v 23 \w A|strong="H3068"\w* \w la|strong="H5921"\w* vuelta \w del|strong="H5921"\w* \w año|strong="H8141"\w*, \w el|strong="H5921"\w* \w ejército|strong="H2426"\w* sirio atacó \w a|strong="H3068"\w* Joás. Llegaron \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* Jerusalén, \w y|strong="H5921"\w* mataron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* líderes \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*. \w Además|strong="H5921"\w*, \w le|strong="H5921"\w* \w enviaron|strong="H7971"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* botín \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Damasco|strong="H1834"\w*.  
\v 24 \w Aunque|strong="H3588"\w* \w el|strong="H3588"\w* \w ejército|strong="H2428"\w* sirio era \w muy|strong="H3966"\w* \w pequeño|strong="H4705"\w*, Yahvé \w dejó|strong="H5800"\w* \w que|strong="H3588"\w* derrotaran \w a|strong="H3068"\w* un \w ejército|strong="H2428"\w* inmenso, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* gente \w de|strong="H3588"\w* Judá \w había|strong="H3588"\w* abandonado \w a|strong="H3068"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* sus antepasados. \w Así|strong="H3588"\w* fue \w como|strong="H3588"\w* \w los|strong="H3588"\w* sirios ejecutaron \w el|strong="H3588"\w* castigo \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* sobre \w Joás|strong="H3101"\w*.   
\p
\v 25 \w Cuando|strong="H3588"\w* \w los|strong="H1121"\w* sirios \w se|strong="H5921"\w* \w fueron|strong="H3212"\w*, \w dejando|strong="H5800"\w* \w a|strong="H3068"\w* Joás gravemente herido, sus propios oficiales hicieron un plan \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w para|strong="H5921"\w* vengar \w el|strong="H5921"\w* asesinato \w del|strong="H4480"\w* \w hijo|strong="H1121"\w* \w del|strong="H4480"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*. \w Lo|strong="H3808"\w* \w mataron|strong="H2026"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia \w cama|strong="H4296"\w*. \w Murió|strong="H4191"\w* \w y|strong="H3588"\w* \w lo|strong="H3808"\w* enterraron \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H4480"\w* \w David|strong="H1732"\w*, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* tumbas \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w*.  
\v 26 \w Los|strong="H1121"\w* \w que|strong="H5921"\w* planearon su muerte fueron \w Zabad|strong="H2066"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* amonita Simeat, \w y|strong="H5921"\w* \w Jozabad|strong="H3075"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w moabita|strong="H4125"\w* Simrit.  
\v 27 \w La|strong="H5921"\w* historia \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Joás, \w de|strong="H5921"\w* todas \w las|strong="H5921"\w* profecías \w en|strong="H5921"\w* su \w contra|strong="H5921"\w*, \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w cómo|strong="H5921"\w* \w se|strong="H5921"\w* reparó \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios, \w está|strong="H5921"\w* \w escrita|strong="H3789"\w* \w en|strong="H5921"\w* \w los|strong="H1121"\w* comentarios \w del|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w*. \w Y|strong="H3068"\w* su \w hijo|strong="H1121"\w* Amasías \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w*.   
\c 25  
\p
\v 1 Amasías tenía \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w veintinueve|strong="H6242"\w* \w años|strong="H8141"\w* en Jerusalén. Su madre se \w llamaba|strong="H8034"\w* Joadán y \w era|strong="H8141"\w* \w de|strong="H2568"\w* Jerusalén.  
\v 2 \w Él|strong="H6213"\w* \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era agradable \w a|strong="H3068"\w* los \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w hizo|strong="H6213"\w* \w de|strong="H5869"\w* todo \w corazón|strong="H3824"\w*.  
\v 3 \w Cuando|strong="H1961"\w* \w se|strong="H1961"\w* sintió seguro \w en|strong="H5921"\w* \w el|strong="H5921"\w* trono, mandó matar \w a|strong="H3068"\w* \w los|strong="H5921"\w* oficiales \w que|strong="H5921"\w* \w habían|strong="H1961"\w* asesinado \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, su padre.  
\v 4 \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w mató|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* asesinos, obedeciendo \w lo|strong="H3808"\w* \w que|strong="H3588"\w* Yahvé \w ordenó|strong="H6680"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*: “\w Los|strong="H1121"\w* padres \w no|strong="H3808"\w* \w morirán|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w culpa|strong="H2399"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w*, \w ni|strong="H3808"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w morirán|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w culpa|strong="H2399"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* padres; cada uno \w morirá|strong="H4191"\w* \w por|strong="H5921"\w* \w su|strong="H3588"\w* propio \w pecado|strong="H2399"\w*”.   
\p
\v 5 Además, Amasías reunió \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w*, y \w los|strong="H1121"\w* organizó por \w familias|strong="H1004"\w* bajo \w el|strong="H3605"\w* mando \w de|strong="H1121"\w* comandantes \w de|strong="H1121"\w* \w mil|strong="H3967"\w* y \w de|strong="H1121"\w* \w cien|strong="H3967"\w* \w hombres|strong="H1121"\w*. Hizo un censo \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* para \w arriba|strong="H4605"\w*, y encontró \w que|strong="H1121"\w* tenía un \w ejército|strong="H6635"\w* \w de|strong="H1121"\w* \w trescientos|strong="H7969"\w* \w mil|strong="H3967"\w* soldados escogidos, listos para \w la|strong="H3605"\w* \w guerra|strong="H6635"\w* y expertos \w en|strong="H3318"\w* \w el|strong="H3605"\w* manejo \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w lanza|strong="H7420"\w* y \w el|strong="H3605"\w* \w escudo|strong="H6793"\w*.  
\v 6 También contrató \w a|strong="H3068"\w* \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* soldados \w valientes|strong="H1368"\w* de \w Israel|strong="H3478"\w* por unos tres \w mil|strong="H3967"\w* trescientos kilos de \w plata|strong="H3701"\w*.\f + \fr 25:6 \ft 1 cor equivale a un homer, unos 211 litros. 10.000 cors de trigo pesan alrededor de 1.640 toneladas métricas.\f*  
\v 7 \w Pero|strong="H3588"\w* un \w hombre|strong="H1121"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w fue|strong="H6635"\w* \w a|strong="H3068"\w* verlo \w y|strong="H3588"\w* \w le|strong="H5973"\w* dijo: “\w Rey|strong="H4428"\w*, \w no|strong="H3588"\w* deje \w que|strong="H3588"\w* \w el|strong="H5973"\w* \w ejército|strong="H6635"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* vaya \w con|strong="H5973"\w* usted \w a|strong="H3068"\w* \w la|strong="H3588"\w* batalla, \w porque|strong="H3588"\w* Yahvé \w no|strong="H3588"\w* está \w con|strong="H5973"\w* \w Israel|strong="H3478"\w* \w ni|strong="H5973"\w* \w con|strong="H5973"\w* \w la|strong="H3588"\w* gente \w de|strong="H3588"\w* Efraín.  
\v 8 \w Si|strong="H3588"\w* usted \w va|strong="H3068"\w* \w a|strong="H3068"\w* pelear apoyándose \w en|strong="H3588"\w* ellos, \w aunque|strong="H3588"\w* pelee \w con|strong="H3588"\w* mucho valor, Dios \w hará|strong="H6213"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* enemigo \w lo|strong="H6213"\w* derrote; \w porque|strong="H3588"\w* solo Dios \w tiene|strong="H3426"\w* \w el|strong="H3588"\w* \w poder|strong="H3581"\w* \w para|strong="H3588"\w* dar \w la|strong="H3588"\w* victoria \w o|strong="H3068"\w* \w la|strong="H3588"\w* derrota”.   
\p
\v 9 Amasías le preguntó al hombre \w de|strong="H5414"\w* \w Dios|strong="H3068"\w*: “¿\w Y|strong="H3068"\w* \w qué|strong="H4100"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar con la plata \w que|strong="H4100"\w* \w ya|strong="H2088"\w* le pagué al \w ejército|strong="H1416"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*?”  
\p \w El|strong="H6213"\w* hombre \w de|strong="H5414"\w* \w Dios|strong="H3068"\w* le contestó: “¡Yahvé puede \w darle|strong="H5414"\w* \w a|strong="H3068"\w* usted \w mucho|strong="H7235"\w* \w más|strong="H7235"\w* \w que|strong="H4100"\w* eso!”   
\p
\v 10 \w Entonces|strong="H7725"\w* Amasías despidió \w a|strong="H3068"\w* las tropas de Efraín y las mandó de regreso \w a|strong="H3068"\w* su casa. Ellos se enojaron muchísimo con \w Judá|strong="H3063"\w* y regresaron \w a|strong="H3068"\w* su tierra echando chispas.   
\p
\v 11 Amasías \w se|strong="H5971"\w* armó \w de|strong="H1121"\w* valor, marchó con su ejército hacia \w el|strong="H1121"\w* \w Valle|strong="H1516"\w* \w de|strong="H1121"\w* la \w Sal|strong="H4417"\w*, y \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w Seír|strong="H8165"\w*.  
\v 12 \w El|strong="H3605"\w* ejército \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* capturó \w vivos|strong="H2416"\w* \w a|strong="H3068"\w* otros \w diez|strong="H6235"\w* \w mil|strong="H6235"\w*, \w los|strong="H1121"\w* llevaron \w a|strong="H3068"\w* \w la|strong="H3605"\w* cima \w de|strong="H1121"\w* un precipicio y \w los|strong="H1121"\w* aventaron desde allí, \w de|strong="H1121"\w* manera \w que|strong="H1121"\w* \w todos|strong="H3605"\w* se hicieron pedazos al caer.  
\v 13 \w Mientras|strong="H5704"\w* tanto, \w las|strong="H1992"\w* tropas \w que|strong="H5704"\w* Amasías había despedido \w para|strong="H5704"\w* \w que|strong="H5704"\w* no fueran \w a|strong="H3068"\w* la \w guerra|strong="H4421"\w* atacaron \w las|strong="H1992"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*, \w desde|strong="H5704"\w* \w Samaria|strong="H8111"\w* \w hasta|strong="H5704"\w* Bet Horón. \w Mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w tres|strong="H7969"\w* mil personas \w y|strong="H5704"\w* \w se|strong="H1992"\w* llevaron muchísimo botín.   
\p
\v 14 \w Cuando|strong="H1961"\w* Amasías regresó victorioso \w de|strong="H6440"\w* su matanza \w contra|strong="H6440"\w* \w los|strong="H1121"\w* edomitas, \w se|strong="H1961"\w* trajo \w a|strong="H3068"\w* \w los|strong="H1121"\w* dioses \w de|strong="H6440"\w* la gente \w de|strong="H6440"\w* \w Seír|strong="H8165"\w* y \w los|strong="H1121"\w* \w puso|strong="H5975"\w* \w como|strong="H1961"\w* \w si|strong="H6440"\w* fueran sus propios dioses; \w se|strong="H1961"\w* arrodilló \w ante|strong="H6440"\w* ellos y les quemó incienso.  
\v 15 \w Por|strong="H4100"\w* eso, Yahvé \w se|strong="H3808"\w* enojó mucho con Amasías y le \w mandó|strong="H7971"\w* un \w profeta|strong="H5030"\w* \w para|strong="H5971"\w* reclamarle: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* andas \w buscando|strong="H1875"\w* la ayuda \w de|strong="H5971"\w* esos dioses, \w si|strong="H3808"\w* \w ni|strong="H3808"\w* siquiera pudieron salvar \w a|strong="H3068"\w* su propia \w gente|strong="H5971"\w* \w de|strong="H5971"\w* tus \w manos|strong="H3027"\w*?”   
\p
\v 16 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w lo|strong="H4100"\w* interrumpió \w y|strong="H3588"\w* le \w dijo|strong="H1696"\w*: “¿Acaso \w te|strong="H3588"\w* hemos nombrado \w consejero|strong="H3289"\w* del \w rey|strong="H4428"\w*? ¡Cállate! ¿\w O|strong="H3068"\w* quieres \w que|strong="H3588"\w* \w te|strong="H3588"\w* mande matar?”  
\p \w El|strong="H3588"\w* \w profeta|strong="H5030"\w* \w se|strong="H3045"\w* calló, \w pero|strong="H3588"\w* \w antes|strong="H3588"\w* le \w dijo|strong="H1696"\w*: “\w Ya|strong="H3068"\w* veo \w que|strong="H3588"\w* Dios \w ha|strong="H3808"\w* decidido \w destruirte|strong="H7843"\w*, \w porque|strong="H3588"\w* \w hiciste|strong="H6213"\w* \w esto|strong="H2063"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w quisiste|strong="H5414"\w* \w escuchar|strong="H8085"\w* \w mi|strong="H1961"\w* \w consejo|strong="H6098"\w*”.   
\p
\v 17 Después \w de|strong="H6440"\w* consultar \w a|strong="H3068"\w* sus \w consejeros|strong="H3289"\w*, Amasías, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, le \w envió|strong="H7971"\w* un desafío \w a|strong="H3068"\w* \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Joacaz y \w nieto|strong="H1121"\w* \w de|strong="H6440"\w* \w Jehú|strong="H3058"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w El|strong="H1121"\w* mensaje decía: “¡Sal \w a|strong="H3068"\w* pelear, vamos \w a|strong="H3068"\w* vernos las caras!”   
\p
\v 18 Pero \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, le respondió \w a|strong="H3068"\w* Amasías con esta historia: “Un simple cardo del \w Líbano|strong="H3844"\w* le \w mandó|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* un gran cedro del \w Líbano|strong="H3844"\w*: ‘Dale tu \w hija|strong="H1323"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* \w para|strong="H5414"\w* \w que|strong="H1121"\w* se case con ella’. Pero \w de|strong="H1121"\w* pronto \w pasó|strong="H5674"\w* \w por|strong="H5414"\w* allí un \w animal|strong="H2416"\w* salvaje y aplastó \w al|strong="H4428"\w* cardo.  
\v 19 Tú \w te|strong="H5973"\w* andas presumiendo \w porque|strong="H4100"\w* derrotaste \w a|strong="H3068"\w* Edom, y \w ya|strong="H6258"\w* \w te|strong="H5973"\w* crees mucho. Mejor \w quédate|strong="H3427"\w* \w en|strong="H5973"\w* tu \w casa|strong="H1004"\w*. ¿\w Qué|strong="H4100"\w* necesidad tienes \w de|strong="H5973"\w* buscarte problemas y provocar tu propia ruina y la \w de|strong="H5973"\w* \w Judá|strong="H3063"\w*?”   
\p
\v 20 \w Pero|strong="H3588"\w* Amasías \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w hizo|strong="H5414"\w* caso, \w porque|strong="H3588"\w* Dios ya \w había|strong="H3588"\w* decidido entregarlos \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w sus|strong="H1931"\w* enemigos, \w por|strong="H3588"\w* \w haber|strong="H3808"\w* adorado \w a|strong="H3068"\w* \w los|strong="H1931"\w* dioses \w de|strong="H3588"\w* Edom.  
\v 21 \w Así|strong="H1931"\w* \w que|strong="H1931"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, marchó \w a|strong="H3068"\w* \w la|strong="H1931"\w* batalla, y \w él|strong="H1931"\w* y Amasías, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w se|strong="H1931"\w* enfrentaron en Bet Semes, territorio \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*.  
\v 22 El ejército \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* derrotó al \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, y los soldados \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* \w huyeron|strong="H5127"\w* cada uno \w a|strong="H3068"\w* su casa.   
\p
\v 23 \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, capturó \w a|strong="H3068"\w* Amasías \w en|strong="H5704"\w* Bet Semes \w y|strong="H5704"\w* se \w lo|strong="H5704"\w* llevó prisionero \w a|strong="H3068"\w* Jerusalén. \w Luego|strong="H5704"\w* derribó casi \w doscientos|strong="H3967"\w* metros \w de|strong="H5704"\w* la muralla \w de|strong="H5704"\w* Jerusalén, \w desde|strong="H5704"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5704"\w* Efraín \w hasta|strong="H5704"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5704"\w* la Esquina.  
\v 24 Además, se llevó \w todo|strong="H3605"\w* \w el|strong="H5973"\w* \w oro|strong="H2091"\w*, \w la|strong="H3605"\w* \w plata|strong="H3701"\w* y \w los|strong="H1121"\w* utensilios \w del|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Dios \w que|strong="H1121"\w* cuidaba Obed Edom. También vació \w los|strong="H1121"\w* tesoros \w del|strong="H5973"\w* palacio \w real|strong="H4428"\w*, tomó rehenes, y regresó \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*.   
\p
\v 25 Amasías, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Judá|strong="H3063"\w*, \w vivió|strong="H2421"\w* \w quince|strong="H2568"\w* \w años|strong="H8141"\w* \w más|strong="H4191"\w* después \w de|strong="H2568"\w* la \w muerte|strong="H4191"\w* \w de|strong="H2568"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*.  
\v 26 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* Amasías, \w de|strong="H5921"\w* principio \w a|strong="H3068"\w* fin, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 27 \w A|strong="H3068"\w* partir \w del|strong="H5921"\w* momento \w en|strong="H5921"\w* \w que|strong="H5921"\w* Amasías \w dejó|strong="H7971"\w* \w de|strong="H5921"\w* obedecer \w a|strong="H3068"\w* Yahvé, \w se|strong="H5921"\w* formó una conspiración \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén. Amasías \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* Laquis, pero \w lo|strong="H5921"\w* persiguieron \w hasta|strong="H5921"\w* \w allá|strong="H8033"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* asesinaron.  
\v 28 Luego \w trajeron|strong="H5375"\w* su cuerpo \w a|strong="H3068"\w* \w caballo|strong="H5483"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* enterraron \w con|strong="H5973"\w* sus antepasados \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H5921"\w* David.   
\c 26  
\p
\v 1 Entonces \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w de|strong="H8478"\w* \w Judá|strong="H3063"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* Uzías, \w que|strong="H1931"\w* apenas \w tenía|strong="H1931"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w*, y \w lo|strong="H1931"\w* hicieron \w rey|strong="H4427"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w su|strong="H1931"\w* padre Amasías.  
\v 2 Después \w de|strong="H5973"\w* \w que|strong="H1931"\w* \w su|strong="H1931"\w* padre murió, Uzías reconstruyó \w la|strong="H1931"\w* ciudad \w de|strong="H5973"\w* Elot y \w la|strong="H1931"\w* \w recuperó|strong="H7725"\w* \w para|strong="H5973"\w* \w Judá|strong="H3063"\w*.  
\v 3 Uzías tenía \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w cincuenta|strong="H2572"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* \w en|strong="H4480"\w* Jerusalén. Su madre \w se|strong="H4480"\w* \w llamaba|strong="H8034"\w* Jecolía y \w era|strong="H8141"\w* \w de|strong="H4480"\w* Jerusalén.  
\v 4 Uzías \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* era agradable \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, igual \w que|strong="H3605"\w* su padre Amasías.  
\v 5 \w Se|strong="H1961"\w* dedicó \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w Dios|strong="H3068"\w* mientras \w vivió|strong="H3117"\w* el profeta \w Zacarías|strong="H2148"\w*, quien lo instruyó \w para|strong="H1961"\w* \w que|strong="H3117"\w* respetara \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*. \w Y|strong="H3068"\w* mientras Uzías \w buscó|strong="H1875"\w* \w a|strong="H3068"\w* Yahvé, \w Dios|strong="H3068"\w* le dio éxito.   
\p
\v 6 Uzías \w salió|strong="H3318"\w* \w a|strong="H3068"\w* pelear contra los \w filisteos|strong="H6430"\w*; derribó las murallas \w de|strong="H3898"\w* Gat, Jabnia y Asdod, y construyó \w ciudades|strong="H5892"\w* cerca \w de|strong="H3898"\w* Asdod y \w en|strong="H3318"\w* otras \w partes|strong="H6555"\w* del territorio \w filisteo|strong="H6430"\w*.  
\v 7 Dios \w lo|strong="H5921"\w* \w ayudó|strong="H5826"\w* \w en|strong="H5921"\w* sus guerras \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w*, \w contra|strong="H5921"\w* \w los|strong="H3427"\w* árabes \w que|strong="H5921"\w* \w vivían|strong="H3427"\w* \w en|strong="H5921"\w* Gur Baal, \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w los|strong="H3427"\w* meunitas.  
\v 8 \w Los|strong="H3588"\w* amonitas le pagaban \w tributo|strong="H4503"\w* \w a|strong="H3068"\w* Uzías, \w y|strong="H3588"\w* se \w hizo|strong="H5414"\w* tan \w poderoso|strong="H2388"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w fama|strong="H8034"\w* \w llegó|strong="H3212"\w* \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* frontera \w con|strong="H3588"\w* \w Egipto|strong="H4714"\w*.  
\v 9 Uzías también construyó \w torres|strong="H4026"\w* \w de|strong="H5921"\w* defensa \w en|strong="H5921"\w* Jerusalén, ubicándolas \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* Esquina, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w del|strong="H5921"\w* \w Valle|strong="H1516"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* esquina \w de|strong="H5921"\w* \w la|strong="H5921"\w* muralla, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w fortificó|strong="H2388"\w*.  
\v 10 Construyó \w torres|strong="H4026"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w* \w y|strong="H3588"\w* cavó \w muchos|strong="H7227"\w* pozos \w de|strong="H3588"\w* agua, \w porque|strong="H3588"\w* \w tenía|strong="H1961"\w* muchísimo \w ganado|strong="H4735"\w*, tanto \w en|strong="H3588"\w* las colinas \w de|strong="H3588"\w* \w la|strong="H3588"\w* Sefelá \w como|strong="H3588"\w* \w en|strong="H3588"\w* \w los|strong="H1961"\w* llanos. \w A|strong="H3068"\w* \w él|strong="H3588"\w* le gustaba \w mucho|strong="H7227"\w* \w la|strong="H3588"\w* agricultura, \w así|strong="H3588"\w* \w que|strong="H3588"\w* \w tenía|strong="H1961"\w* campesinos \w y|strong="H3588"\w* cuidadores \w de|strong="H3588"\w* viñedos trabajando \w en|strong="H3588"\w* las montañas \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w los|strong="H1961"\w* campos fértiles.  
\v 11 \w Además|strong="H5921"\w*, Uzías \w tenía|strong="H1961"\w* un \w ejército|strong="H2428"\w* muy bien entrenado \w y|strong="H5921"\w* organizado \w en|strong="H5921"\w* divisiones, listas \w para|strong="H5921"\w* \w salir|strong="H3318"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*. \w El|strong="H5921"\w* \w secretario|strong="H5608"\w* \w Jeiel|strong="H3273"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* oficial \w Maasías|strong="H4641"\w* \w llevaban|strong="H1961"\w* \w el|strong="H5921"\w* registro \w de|strong="H5921"\w* \w las|strong="H5921"\w* tropas, bajo \w el|strong="H5921"\w* mando \w de|strong="H5921"\w* \w Hananías|strong="H2608"\w*, uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w generales|strong="H8269"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 12 \w El|strong="H3605"\w* \w número|strong="H4557"\w* total de \w los|strong="H3605"\w* líderes de familia, \w que|strong="H3605"\w* eran soldados expertos, era de dos \w mil|strong="H3967"\w* \w seiscientos|strong="H8337"\w*.  
\v 13 Bajo \w el|strong="H5921"\w* mando \w de|strong="H5921"\w* \w ellos|strong="H3027"\w* \w había|strong="H6213"\w* un \w ejército|strong="H2428"\w* \w de|strong="H5921"\w* \w trescientos|strong="H7969"\w* \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w quinientos|strong="H2568"\w* hombres, todos muy bien entrenados \w y|strong="H5921"\w* \w con|strong="H5921"\w* un gran \w poder|strong="H3027"\w* militar \w para|strong="H5921"\w* proteger \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w contra|strong="H5921"\w* cualquier enemigo.  
\v 14 Uzías equipó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w su|strong="H1992"\w* \w ejército|strong="H6635"\w* con \w escudos|strong="H4043"\w*, \w lanzas|strong="H7420"\w*, cascos, armaduras, \w arcos|strong="H7198"\w* y hondas para lanzar piedras.  
\v 15 \w En|strong="H5921"\w* Jerusalén, mandó \w a|strong="H3068"\w* fabricar máquinas \w de|strong="H5921"\w* guerra inventadas \w por|strong="H5921"\w* expertos, \w y|strong="H3588"\w* \w las|strong="H5921"\w* colocó \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w torres|strong="H4026"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w esquinas|strong="H6438"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* murallas \w para|strong="H5704"\w* disparar flechas \w y|strong="H3588"\w* lanzar piedras muy pesadas. \w Su|strong="H3588"\w* \w fama|strong="H8034"\w* \w se|strong="H1961"\w* extendió \w por|strong="H5921"\w* todas partes, \w pues|strong="H3588"\w* recibió una \w ayuda|strong="H5826"\w* maravillosa \w hasta|strong="H5704"\w* hacerse sumamente \w poderoso|strong="H2388"\w*.   
\p
\v 16 Pero \w cuando|strong="H5704"\w* Uzías \w se|strong="H5921"\w* sintió tan poderoso, \w se|strong="H5921"\w* llenó \w de|strong="H5921"\w* orgullo \w y|strong="H5921"\w* esto causó su ruina. \w Le|strong="H5921"\w* fue infiel \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*, pues \w se|strong="H5921"\w* atrevió \w a|strong="H3068"\w* entrar \w al|strong="H5921"\w* \w templo|strong="H1964"\w* \w de|strong="H5921"\w* Yahvé \w para|strong="H5704"\w* quemar incienso \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w del|strong="H5921"\w* incienso.  
\v 17 Detrás \w de|strong="H5973"\w* \w él|strong="H5973"\w* entró \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Azarías|strong="H5838"\w*, acompañado por \w ochenta|strong="H8084"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5973"\w* Yahvé, \w hombres|strong="H1121"\w* muy \w valientes|strong="H2428"\w*,  
\v 18 \w y|strong="H3588"\w* \w se|strong="H5921"\w* enfrentaron \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Uzías. \w Le|strong="H5921"\w* dijeron: “¡Uzías, \w no|strong="H3808"\w* \w te|strong="H5921"\w* corresponde \w a|strong="H3068"\w* \w ti|strong="H5921"\w* quemarle incienso \w a|strong="H3068"\w* Yahvé! Ese \w es|strong="H3588"\w* un trabajo exclusivo \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Aarón, \w que|strong="H3588"\w* han sido consagrados \w para|strong="H5921"\w* hacerlo. ¡\w Sal|strong="H3318"\w* \w de|strong="H4480"\w* \w este|strong="H5975"\w* lugar \w santo|strong="H6942"\w*! \w Le|strong="H5921"\w* has sido infiel \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*, \w y|strong="H3588"\w* Yahvé \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* honrar \w por|strong="H5921"\w* esto”.   
\p
\v 19 Uzías, \w que|strong="H5921"\w* tenía un quemador \w de|strong="H5921"\w* incienso \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w se|strong="H5921"\w* enfureció. Pero mientras \w le|strong="H5921"\w* gritaba enojado \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* allí mismo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w altar|strong="H4196"\w* \w del|strong="H5921"\w* incienso, \w le|strong="H5921"\w* brotó \w lepra|strong="H6883"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w frente|strong="H4696"\w*.  
\v 20 \w Cuando|strong="H3588"\w* \w el|strong="H1931"\w* \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w* \w Azarías|strong="H5838"\w* \w y|strong="H1571"\w* \w los|strong="H3605"\w* \w demás|strong="H1571"\w* \w sacerdotes|strong="H3548"\w* \w lo|strong="H1931"\w* \w miraron|strong="H6437"\w* \w y|strong="H1571"\w* vieron \w la|strong="H1931"\w* lepra \w en|strong="H3588"\w* \w su|strong="H1931"\w* \w frente|strong="H4696"\w*, \w lo|strong="H1931"\w* \w sacaron|strong="H3318"\w* del templo \w a|strong="H3068"\w* empujones. \w Y|strong="H3068"\w* \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* Uzías \w se|strong="H1931"\w* apuró \w a|strong="H3068"\w* \w salir|strong="H3318"\w*, \w porque|strong="H3588"\w* \w se|strong="H1931"\w* dio cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w lo|strong="H1931"\w* \w había|strong="H3588"\w* castigado.  
\v 21 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* Uzías \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w leproso|strong="H6879"\w* \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w muerte|strong="H4194"\w*. \w Tuvo|strong="H1961"\w* \w que|strong="H3588"\w* vivir aislado \w en|strong="H5921"\w* una \w casa|strong="H1004"\w* \w separada|strong="H2669"\w*, \w y|strong="H3588"\w* \w le|strong="H5921"\w* prohibieron volver \w a|strong="H3068"\w* entrar \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé. \w Su|strong="H3588"\w* \w hijo|strong="H1121"\w* Jotam \w quedó|strong="H1961"\w* \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* palacio \w real|strong="H4428"\w* \w y|strong="H3588"\w* gobernaba \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 22 \w El|strong="H1121"\w* \w resto|strong="H3499"\w* \w de|strong="H1121"\w* la historia \w de|strong="H1121"\w* Uzías, \w de|strong="H1121"\w* principio \w a|strong="H3068"\w* fin, fue \w escrita|strong="H3789"\w* \w por|strong="H1697"\w* \w el|strong="H1121"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amoz.  
\v 23 \w Cuando|strong="H3588"\w* Uzías murió, \w lo|strong="H1931"\w* enterraron \w con|strong="H5973"\w* \w sus|strong="H1931"\w* antepasados \w en|strong="H5973"\w* un cementerio \w que|strong="H3588"\w* pertenecía \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w*, \w pero|strong="H3588"\w* apartado \w de|strong="H3588"\w* \w ellos|strong="H1931"\w*, \w pues|strong="H3588"\w* \w la|strong="H1931"\w* gente decía: “\w Es|strong="H1931"\w* un \w leproso|strong="H6879"\w*”. \w Y|strong="H3068"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w* Jotam \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* \w su|strong="H1931"\w* \w lugar|strong="H8478"\w*.   
\c 27  
\p
\v 1 Jotam tenía \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w* en Jerusalén. Su madre se \w llamaba|strong="H8034"\w* Jerusá y \w era|strong="H8141"\w* \w hija|strong="H1323"\w* \w de|strong="H2568"\w* \w Sadoc|strong="H6659"\w*.  
\v 2 \w Él|strong="H3605"\w* \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era agradable \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5750"\w* Yahvé, siguiendo \w el|strong="H3605"\w* buen ejemplo \w de|strong="H5750"\w* su padre Uzías, pero con \w la|strong="H3605"\w* diferencia \w de|strong="H5750"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* atrevió \w a|strong="H3068"\w* profanar \w el|strong="H3605"\w* \w templo|strong="H1964"\w* \w de|strong="H5750"\w* Yahvé. \w Sin|strong="H3808"\w* embargo, \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* seguía \w haciendo|strong="H6213"\w* cosas malas.  
\v 3 Jotam reconstruyó \w la|strong="H1931"\w* \w puerta|strong="H8179"\w* Superior del \w templo|strong="H1004"\w* de Yahvé, y construyó \w muchas|strong="H7230"\w* obras en \w la|strong="H1931"\w* muralla del monte Ofel.  
\v 4 Además, construyó \w ciudades|strong="H5892"\w* en la región montañosa de \w Judá|strong="H3063"\w*, y levantó \w fortalezas|strong="H1003"\w* y \w torres|strong="H4026"\w* de vigilancia en los bosques.  
\v 5 \w Fue|strong="H1931"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w guerra|strong="H3898"\w* \w contra|strong="H5921"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* amonitas \w y|strong="H5921"\w* \w lo|strong="H1931"\w* derrotó. \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w año|strong="H8141"\w*, \w los|strong="H1121"\w* amonitas tuvieron \w que|strong="H1931"\w* pagarle un tributo \w de|strong="H5921"\w* unos tres \w mil|strong="H6235"\w* trescientos kilos \w de|strong="H5921"\w* \w plata|strong="H3701"\w*, unos \w dos|strong="H8141"\w* millones \w de|strong="H5921"\w* litros \w de|strong="H5921"\w* \w trigo|strong="H2406"\w* \w y|strong="H5921"\w* otros \w dos|strong="H8141"\w* millones \w de|strong="H5921"\w* litros \w de|strong="H5921"\w* \w cebada|strong="H8184"\w*.\f + \fr 27:5 \ft 10.000 cors de cebada pesan alrededor de 1.310 toneladas métricas.\f* \w Y|strong="H3068"\w* \w le|strong="H1931"\w* \w pagaron|strong="H7725"\w* \w esta|strong="H2063"\w* \w misma|strong="H1931"\w* cantidad durante \w los|strong="H1121"\w* \w dos|strong="H8141"\w* \w años|strong="H8141"\w* siguientes.  
\v 6 Jotam se hizo cada vez \w más|strong="H3588"\w* \w poderoso|strong="H2388"\w*, \w porque|strong="H3588"\w* se propuso obedecer siempre \w a|strong="H3068"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 7 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* Jotam, \w todas|strong="H3605"\w* sus \w guerras|strong="H4421"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* hizo, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 8 \w Tenía|strong="H1961"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w* en Jerusalén.  
\v 9 Cuando Jotam murió, fue \w enterrado|strong="H6912"\w* \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*, y su \w hijo|strong="H1121"\w* Acaz \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 28  
\p
\v 1 Acaz tenía \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w* en Jerusalén. \w A|strong="H3068"\w* diferencia \w de|strong="H1121"\w* su antepasado \w David|strong="H1732"\w*, \w él|strong="H1121"\w* \w no|strong="H3808"\w* \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w era|strong="H8141"\w* agradable \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H1121"\w* Yahvé.  
\v 2 \w Al|strong="H4428"\w* contrario, \w siguió|strong="H3212"\w* \w el|strong="H6213"\w* mal ejemplo de los \w reyes|strong="H4428"\w* de \w Israel|strong="H3478"\w*, \w y|strong="H1571"\w* hasta mandó \w hacer|strong="H6213"\w* \w imágenes|strong="H4541"\w* de metal para adorar \w a|strong="H3068"\w* los baales.  
\v 3 Quemó incienso en \w el|strong="H1931"\w* \w valle|strong="H1516"\w* \w de|strong="H6440"\w* Ben Hinom, \w y|strong="H1197"\w* \w hasta|strong="H1931"\w* sacrificó \w a|strong="H3068"\w* \w sus|strong="H1931"\w* propios \w hijos|strong="H1121"\w* quemándolos en \w el|strong="H1931"\w* fuego, practicando las mismas horribles costumbres \w de|strong="H6440"\w* las \w naciones|strong="H1471"\w* paganas \w que|strong="H1931"\w* Yahvé había expulsado \w de|strong="H6440"\w* \w esa|strong="H1931"\w* tierra.  
\v 4 También \w ofrecía|strong="H2076"\w* \w sacrificios|strong="H2076"\w* \w y|strong="H5921"\w* quemaba incienso \w en|strong="H5921"\w* \w los|strong="H5921"\w* santuarios \w de|strong="H5921"\w* \w las|strong="H5921"\w* colinas \w y|strong="H5921"\w* \w debajo|strong="H8478"\w* \w de|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w árbol|strong="H6086"\w* \w frondoso|strong="H7488"\w*.   
\p
\v 5 \w Por|strong="H4480"\w* esta razón, Yahvé su \w Dios|strong="H3068"\w* \w permitió|strong="H5414"\w* \w que|strong="H4480"\w* \w el|strong="H1571"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Siria lo derrotara. Los sirios le causaron muchas bajas, tomaron muchísimos prisioneros \w y|strong="H1571"\w* \w se|strong="H4480"\w* los llevaron \w a|strong="H3068"\w* \w Damasco|strong="H1834"\w*. \w También|strong="H1571"\w* \w Dios|strong="H3068"\w* lo \w entregó|strong="H5414"\w* \w en|strong="H4480"\w* \w manos|strong="H3027"\w* \w del|strong="H4480"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, quien le causó una terrible derrota.  
\v 6 \w Peka|strong="H6492"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Remalías, rey \w de|strong="H1121"\w* Israel, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* soldados \w valientes|strong="H2428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* en un solo \w día|strong="H3117"\w*, porque \w el|strong="H3605"\w* pueblo había abandonado \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* sus antepasados.  
\v 7 Además, Zicri, un gran guerrero \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* Efraín, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w Maasías|strong="H4641"\w*, \w hijo|strong="H1121"\w* del \w rey|strong="H4428"\w*; \w a|strong="H3068"\w* \w Azricam|strong="H5840"\w*, \w el|strong="H1121"\w* administrador del palacio; y \w a|strong="H3068"\w* Elcaná, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w segundo|strong="H4932"\w* en autoridad después del \w rey|strong="H4428"\w*.  
\v 8 \w El|strong="H1121"\w* ejército \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* tomó \w a|strong="H3068"\w* \w doscientos|strong="H3967"\w* \w mil|strong="H3967"\w* prisioneros \w de|strong="H1121"\w* Judá, incluyendo \w mujeres|strong="H1323"\w*, niños \w y|strong="H1571"\w* niñas. \w También|strong="H1571"\w* \w les|strong="H1992"\w* robaron muchísimo botín \w y|strong="H1571"\w* \w se|strong="H1992"\w* \w lo|strong="H1992"\w* llevaron todo \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*.  
\v 9 Pero \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* vivía un \w profeta|strong="H5030"\w* \w de|strong="H5921"\w* Yahvé \w llamado|strong="H8034"\w* Oded. \w Él|strong="H5921"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibir \w al|strong="H5921"\w* \w ejército|strong="H6635"\w* \w de|strong="H5921"\w* Israel \w cuando|strong="H5704"\w* regresaba victorioso, \w y|strong="H5921"\w* \w les|strong="H5921"\w* dijo: “¡Miren! Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* sus antepasados, \w estaba|strong="H1961"\w* \w enojado|strong="H2534"\w* \w con|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* eso \w los|strong="H5921"\w* \w entregó|strong="H5414"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* ustedes; pero ustedes \w los|strong="H5921"\w* han masacrado \w con|strong="H5921"\w* una furia tan terrible \w que|strong="H5921"\w* ha \w llegado|strong="H5060"\w* \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*.  
\v 10 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w* resulta \w que|strong="H3808"\w* ustedes pretenden esclavizar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* y mujeres \w de|strong="H5973"\w* \w Judá|strong="H3063"\w* y \w de|strong="H5973"\w* Jerusalén. ¿Acaso \w no|strong="H3808"\w* \w se|strong="H3808"\w* dan cuenta \w de|strong="H5973"\w* \w que|strong="H3808"\w* ustedes mismos \w son|strong="H3808"\w* culpables \w de|strong="H5973"\w* pecar \w contra|strong="H5973"\w* Yahvé su \w Dios|strong="H3068"\w*?  
\v 11 Escúchenme \w bien|strong="H3588"\w*: ¡devuelvan \w ahora|strong="H6258"\w* mismo \w a|strong="H3068"\w* \w los|strong="H5921"\w* prisioneros \w que|strong="H3588"\w* tomaron \w de|strong="H5921"\w* sus propios hermanos! \w Si|strong="H3588"\w* \w no|strong="H3588"\w* \w lo|strong="H5921"\w* hacen, \w el|strong="H5921"\w* terrible enojo \w de|strong="H5921"\w* Yahvé caerá \w sobre|strong="H5921"\w* ustedes”.  
\v 12 Entonces algunos líderes \w de|strong="H4480"\w* \w la|strong="H5921"\w* tribu \w de|strong="H4480"\w* Efraín, \w que|strong="H4480"\w* eran \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Johanán|strong="H3076"\w*, Berequías \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Mesilemot, Ezequías \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Salum, \w y|strong="H5921"\w* \w Amasa|strong="H6021"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Hadlai|strong="H2311"\w*, \w se|strong="H5921"\w* enfrentaron \w a|strong="H3068"\w* \w los|strong="H1121"\w* soldados \w que|strong="H4480"\w* regresaban \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w guerra|strong="H6635"\w*.  
\v 13 \w Les|strong="H5921"\w* dijeron: “¡\w No|strong="H3808"\w* traigan \w a|strong="H3068"\w* esos prisioneros \w aquí|strong="H2008"\w*! \w Lo|strong="H3808"\w* \w que|strong="H3588"\w* ustedes quieren hacer solo \w nos|strong="H5921"\w* hará pecar \w más|strong="H3588"\w* \w contra|strong="H5921"\w* Yahvé. \w Ya|strong="H3068"\w* \w de|strong="H5921"\w* \w por|strong="H5921"\w* \w sí|strong="H3588"\w* nuestra culpa \w es|strong="H3588"\w* muy \w grande|strong="H7227"\w*, \w y|strong="H3588"\w* \w el|strong="H5921"\w* enojo \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w* \w es|strong="H3588"\w* terrible; \w si|strong="H3588"\w* hacen esto, solo aumentarán nuestros \w pecados|strong="H2403"\w* \w y|strong="H3588"\w* nuestra culpa”.   
\p
\v 14 Entonces \w los|strong="H3605"\w* soldados \w dejaron|strong="H5800"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* prisioneros y \w el|strong="H3605"\w* botín allí \w mismo|strong="H3605"\w*, frente \w a|strong="H3068"\w* \w los|strong="H3605"\w* líderes y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* pueblo reunido.  
\v 15 \w Luego|strong="H7725"\w*, \w los|strong="H3605"\w* líderes \w que|strong="H4480"\w* fueron mencionados \w por|strong="H4480"\w* \w nombre|strong="H8034"\w* \w se|strong="H4480"\w* hicieron cargo \w de|strong="H4480"\w* \w los|strong="H3605"\w* prisioneros. \w Tomaron|strong="H2388"\w* ropa \w del|strong="H4480"\w* botín y vistieron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H4480"\w* estaban desnudos; les dieron ropa, sandalias, comida y \w bebida|strong="H8248"\w*, y les curaron las heridas \w con|strong="H4480"\w* aceite. \w A|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H4480"\w* estaban \w más|strong="H4480"\w* débiles \w los|strong="H3605"\w* subieron \w en|strong="H4480"\w* burros, y llevaron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*, \w la|strong="H3605"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H4480"\w* las \w Palmeras|strong="H8558"\w*, \w para|strong="H4480"\w* entregarlos \w a|strong="H3068"\w* sus familiares. Después, \w los|strong="H3605"\w* líderes regresaron \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*.   
\p
\v 16 \w En|strong="H5921"\w* \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Acaz \w les|strong="H5921"\w* \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* pedir \w ayuda|strong="H5826"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* Asiria.  
\v 17 \w Y|strong="H3068"\w* es que los edomitas habían vuelto \w a|strong="H3068"\w* invadir y atacar \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, y se habían llevado prisioneros.  
\v 18 \w Los|strong="H3427"\w* \w filisteos|strong="H6430"\w* también habían atacado las \w ciudades|strong="H5892"\w* de la Sefelá y la zona sur de \w Judá|strong="H3063"\w*. Habían capturado Bet Semes, Ajalón, Gederot, Soco, \w Timná|strong="H8553"\w* y Gimzo, junto con las \w aldeas|strong="H1323"\w* de alrededor, y se quedaron \w a|strong="H3068"\w* vivir \w allí|strong="H8033"\w*.  
\v 19 Yahvé humilló \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w de|strong="H3588"\w* esta manera \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* Acaz, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w porque|strong="H3588"\w* \w él|strong="H3588"\w* \w había|strong="H3588"\w* llevado \w al|strong="H4428"\w* pueblo \w al|strong="H4428"\w* desastre \w y|strong="H3588"\w* le \w había|strong="H3588"\w* sido muy infiel \w a|strong="H3068"\w* Yahvé.  
\v 20 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* Tiglat Pileser \w de|strong="H5921"\w* Asiria \w sí|strong="H3808"\w* \w fue|strong="H3808"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Acaz, pero \w en|strong="H5921"\w* lugar \w de|strong="H5921"\w* ayudarlo, \w le|strong="H5921"\w* causó \w más|strong="H5921"\w* problemas.  
\v 21 \w Aunque|strong="H3588"\w* Acaz vació \w los|strong="H3588"\w* tesoros del \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, del palacio \w real|strong="H4428"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* las \w casas|strong="H1004"\w* \w de|strong="H3588"\w* sus \w príncipes|strong="H8269"\w* \w para|strong="H3588"\w* pagarle tributo \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria, \w no|strong="H3808"\w* le sirvió \w de|strong="H3588"\w* \w nada|strong="H3808"\w*.   
\p
\v 22 \w Y|strong="H3068"\w* para colmo, en \w el|strong="H1931"\w* momento \w de|strong="H6256"\w* mayor \w angustia|strong="H6887"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Acaz \w le|strong="H1931"\w* \w fue|strong="H1931"\w* \w aún|strong="H3254"\w* \w más|strong="H3254"\w* infiel \w a|strong="H3068"\w* Yahvé.  
\v 23 Empezó \w a|strong="H3068"\w* ofrecerles \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* dioses \w de|strong="H3588"\w* \w Damasco|strong="H1834"\w*, \w los|strong="H1992"\w* \w mismos|strong="H1992"\w* \w que|strong="H3588"\w* \w lo|strong="H1992"\w* \w habían|strong="H1961"\w* derrotado, \w porque|strong="H3588"\w* pensaba: “\w Como|strong="H3588"\w* \w los|strong="H1992"\w* dioses \w de|strong="H3588"\w* Siria \w ayudaron|strong="H5826"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w reyes|strong="H4428"\w*, voy \w a|strong="H3068"\w* ofrecerles \w sacrificios|strong="H2076"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* ayuden \w a|strong="H3068"\w* \w mí|strong="H1961"\w* también”. ¡\w Pero|strong="H3588"\w* esos dioses \w fueron|strong="H1961"\w* \w su|strong="H1992"\w* perdición \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*!  
\v 24 Acaz juntó \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de \w Dios|strong="H3068"\w* y \w los|strong="H3605"\w* \w hizo|strong="H6213"\w* pedazos. Luego \w cerró|strong="H5462"\w* las \w puertas|strong="H1817"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de Yahvé, y mandó construir \w altares|strong="H4196"\w* paganos en \w cada|strong="H3605"\w* esquina de Jerusalén.  
\v 25 En \w todas|strong="H3605"\w* y \w cada|strong="H3605"\w* una de las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w*, mandó construir santuarios en las colinas para quemarles incienso \w a|strong="H3068"\w* otros dioses, provocando así \w la|strong="H3605"\w* ira de Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de sus antepasados.   
\p
\v 26 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* Acaz, \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* hizo \w de|strong="H5921"\w* principio \w a|strong="H3068"\w* fin, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 27 \w Cuando|strong="H3588"\w* Acaz murió, \w fue|strong="H3808"\w* \w enterrado|strong="H6912"\w* \w en|strong="H5973"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w de|strong="H3588"\w* Jerusalén, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* pusieron \w en|strong="H5973"\w* las tumbas \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*. \w Y|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* Ezequías \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* \w su|strong="H3588"\w* \w lugar|strong="H8478"\w*.   
\c 29  
\p
\v 1 Ezequías tenía \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén durante \w veintinueve|strong="H6242"\w* \w años|strong="H8141"\w*. Su madre se \w llamaba|strong="H8034"\w* Abías, y \w era|strong="H8141"\w* \w hija|strong="H1323"\w* \w de|strong="H2568"\w* \w Zacarías|strong="H2148"\w*.  
\v 2 \w Él|strong="H3605"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* era agradable \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, siguiendo \w el|strong="H3605"\w* buen ejemplo \w de|strong="H5869"\w* su antepasado \w David|strong="H1732"\w*.  
\v 3 En \w el|strong="H1931"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w* de \w su|strong="H1931"\w* \w primer|strong="H7223"\w* \w año|strong="H8141"\w* \w como|strong="H1931"\w* \w rey|strong="H4427"\w*, Ezequías \w abrió|strong="H6605"\w* las \w puertas|strong="H1817"\w* del \w templo|strong="H1004"\w* de Yahvé y las mandó reparar.  
\v 4 Mandó llamar \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* y \w a|strong="H3068"\w* los \w levitas|strong="H3881"\w*, los reunió en la plaza que da al \w este|strong="H4217"\w*,  
\v 5 y les dijo: “¡Escúchenme bien, \w levitas|strong="H3881"\w*! Santifíquense \w ahora|strong="H6258"\w* mismo, y purifiquen el \w templo|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* sus antepasados. ¡Saquen \w de|strong="H4480"\w* este lugar \w santo|strong="H6944"\w* todas las impurezas!  
\v 6 \w Porque|strong="H3588"\w* nuestros padres \w fueron|strong="H5869"\w* infieles \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w ojos|strong="H5869"\w* \w de|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*. \w Lo|strong="H6213"\w* abandonaron, \w le|strong="H5869"\w* \w dieron|strong="H5414"\w* \w la|strong="H3588"\w* espalda \w y|strong="H3588"\w* se alejaron del lugar donde habita Yahvé.  
\v 7 Incluso \w cerraron|strong="H5462"\w* las \w puertas|strong="H1817"\w* del pórtico, apagaron las \w lámparas|strong="H5216"\w*, \w y|strong="H1571"\w* dejaron de quemar incienso \w y|strong="H1571"\w* de ofrecer \w holocaustos|strong="H5930"\w* en \w el|strong="H1571"\w* \w santuario|strong="H6944"\w* para \w el|strong="H1571"\w* Dios de \w Israel|strong="H3478"\w*.  
\v 8 \w Por|strong="H5921"\w* eso, \w el|strong="H5921"\w* terrible \w enojo|strong="H7110"\w* \w de|strong="H5921"\w* Yahvé cayó \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* Jerusalén. \w Él|strong="H5921"\w* \w los|strong="H5921"\w* convirtió \w en|strong="H5921"\w* objeto \w de|strong="H5921"\w* terror \w y|strong="H5921"\w* \w de|strong="H5921"\w* burla, \w como|strong="H1961"\w* ustedes mismos \w lo|strong="H5921"\w* pueden \w ver|strong="H7200"\w*.  
\v 9 ¡Miren \w cómo|strong="H5921"\w* nuestros padres \w murieron|strong="H5307"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*! \w Y|strong="H3068"\w* \w por|strong="H5921"\w* \w esta|strong="H2063"\w* misma razón, nuestros \w hijos|strong="H1121"\w*, nuestras \w hijas|strong="H1323"\w* \w y|strong="H5921"\w* nuestras esposas fueron llevados prisioneros.  
\v 10 \w Por|strong="H4480"\w* eso, he decidido \w en|strong="H4480"\w* mi \w corazón|strong="H3824"\w* \w hacer|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5973"\w* Yahvé, \w el|strong="H5973"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w para|strong="H4480"\w* \w que|strong="H4480"\w* su ardiente enojo \w se|strong="H4480"\w* \w aparte|strong="H5973"\w* \w de|strong="H4480"\w* \w nosotros|strong="H5973"\w*.  
\v 11 \w Hijos|strong="H1121"\w* míos, \w no|strong="H3588"\w* \w sean|strong="H1961"\w* negligentes \w ahora|strong="H6258"\w*, \w porque|strong="H3588"\w* Yahvé \w los|strong="H1121"\w* ha elegido \w a|strong="H3068"\w* ustedes \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w estén|strong="H1961"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w presencia|strong="H6440"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* le sirvan, \w y|strong="H3588"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w sean|strong="H1961"\w* sus \w ministros|strong="H8334"\w* \w y|strong="H3588"\w* le \w quemen|strong="H6999"\w* incienso”.   
\p
\v 12 Entonces \w se|strong="H4480"\w* presentaron \w los|strong="H1121"\w* siguientes \w levitas|strong="H3881"\w*: \w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Coat, Mahat \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Amasai|strong="H6022"\w* y \w Joel|strong="H3100"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Azarías|strong="H5838"\w*; \w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* \w Merari|strong="H4847"\w*, \w Cis|strong="H7027"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Abdi y \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Jehalelel; \w de|strong="H4480"\w* la familia \w de|strong="H4480"\w* \w Gersón|strong="H1649"\w*, Joa \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Zima y Edén \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Joa;  
\v 13 \w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Elizafán, \w Simri|strong="H8113"\w* y \w Jeiel|strong="H3273"\w*; \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Asaf, \w Zacarías|strong="H2148"\w* y Matanías;  
\v 14 \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* \w Hemán|strong="H1968"\w*, \w Jehiel|strong="H3171"\w* y Simei; y \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Jedutún, \w Semaías|strong="H8098"\w* y Uziel.  
\v 15 Ellos reunieron \w a|strong="H3068"\w* sus hermanos, se purificaron y entraron \w a|strong="H3068"\w* limpiar el \w templo|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé, obedeciendo la orden del \w rey|strong="H4428"\w* y \w de|strong="H1697"\w* acuerdo con las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé.  
\v 16 \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* entraron al interior del \w templo|strong="H1964"\w* de Yahvé para limpiarlo, y \w sacaron|strong="H3318"\w* al \w patio|strong="H2691"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* basura y las impurezas \w que|strong="H2691"\w* encontraron \w adentro|strong="H1004"\w*. \w Luego|strong="H3318"\w*, \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w tomaron|strong="H6901"\w* \w todo|strong="H3605"\w* eso y \w lo|strong="H3605"\w* \w sacaron|strong="H3318"\w* de \w la|strong="H3605"\w* ciudad, hasta \w el|strong="H3605"\w* \w arroyo|strong="H5158"\w* de Cedrón.  
\v 17 Empezaron el trabajo de purificación el \w primer|strong="H7223"\w* \w día|strong="H3117"\w* del \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, y para el octavo \w día|strong="H3117"\w* ya habían llegado al pórtico de Yahvé. En \w ocho|strong="H8083"\w* \w días|strong="H3117"\w* purificaron todo el \w templo|strong="H1004"\w* de Yahvé, terminando su labor el \w día|strong="H3117"\w* \w dieciséis|strong="H8337"\w* del \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*.  
\v 18 Después fueron \w al|strong="H5930"\w* palacio, se presentaron ante \w el|strong="H3605"\w* \w rey|strong="H4428"\w* Ezequías y le informaron: “\w Ya|strong="H3068"\w* terminamos de limpiar \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé, incluyendo \w el|strong="H3605"\w* \w altar|strong="H4196"\w* de \w los|strong="H3605"\w* \w holocaustos|strong="H5930"\w* y sus utensilios, y \w la|strong="H3605"\w* \w mesa|strong="H7979"\w* \w del|strong="H4196"\w* pan de \w la|strong="H3605"\w* presencia con \w todos|strong="H3605"\w* sus utensilios.  
\v 19 También recuperamos y purificamos \w todos|strong="H3605"\w* \w los|strong="H3605"\w* artículos \w que|strong="H3605"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* Acaz profanó y tiró \w a|strong="H3068"\w* \w la|strong="H3605"\w* basura cuando le fue infiel \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*. Ahora ya están \w todos|strong="H3605"\w* listos frente \w al|strong="H4428"\w* \w altar|strong="H4196"\w* \w de|strong="H6440"\w* Yahvé”.   
\p
\v 20 \w A|strong="H3068"\w* la mañana siguiente, el \w rey|strong="H4428"\w* Ezequías se levantó temprano, reunió \w a|strong="H3068"\w* los líderes \w de|strong="H8269"\w* la \w ciudad|strong="H5892"\w* y \w subió|strong="H5927"\w* \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H8269"\w* Yahvé.  
\v 21 Llevaron \w siete|strong="H7651"\w* \w toros|strong="H6499"\w*, \w siete|strong="H7651"\w* carneros, \w siete|strong="H7651"\w* \w corderos|strong="H3532"\w* \w y|strong="H5921"\w* \w siete|strong="H7651"\w* chivos \w como|strong="H5921"\w* sacrificio \w para|strong="H5921"\w* pedir perdón \w por|strong="H5921"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* \w del|strong="H5921"\w* \w reino|strong="H4467"\w*, \w del|strong="H5921"\w* \w santuario|strong="H4720"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w El|strong="H5921"\w* rey \w les|strong="H5921"\w* ordenó \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, descendientes \w de|strong="H5921"\w* Aarón, \w que|strong="H5921"\w* ofrecieran estos sacrificios \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Yahvé.  
\v 22 Así que \w mataron|strong="H7819"\w* \w a|strong="H3068"\w* los toros, \w y|strong="H1241"\w* los \w sacerdotes|strong="H3548"\w* recogieron la \w sangre|strong="H1818"\w* \w y|strong="H1241"\w* rociaron el \w altar|strong="H4196"\w* con ella. Luego \w mataron|strong="H7819"\w* \w a|strong="H3068"\w* los carneros \w y|strong="H1241"\w* también rociaron su \w sangre|strong="H1818"\w* en el \w altar|strong="H4196"\w*. Finalmente, \w mataron|strong="H7819"\w* \w a|strong="H3068"\w* los \w corderos|strong="H3532"\w* \w e|strong="H3068"\w* hicieron lo mismo con la \w sangre|strong="H1818"\w*.  
\v 23 \w Después|strong="H5921"\w* llevaron \w a|strong="H3068"\w* \w los|strong="H5921"\w* chivos \w para|strong="H5921"\w* \w el|strong="H5921"\w* sacrificio \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w pusieron|strong="H5564"\w* frente \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w toda|strong="H5921"\w* \w la|strong="H5921"\w* asamblea, quienes \w les|strong="H5921"\w* impusieron \w las|strong="H5921"\w* \w manos|strong="H3027"\w*.  
\v 24 \w Entonces|strong="H3588"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w los|strong="H5921"\w* \w mataron|strong="H7819"\w*, \w y|strong="H3588"\w* usaron \w su|strong="H3588"\w* \w sangre|strong="H1818"\w* \w para|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, pidiendo perdón \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*; \w pues|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w había|strong="H3588"\w* ordenado \w que|strong="H3588"\w* \w estos|strong="H3605"\w* sacrificios \w y|strong="H3588"\w* \w holocaustos|strong="H5930"\w* \w se|strong="H5921"\w* hicieran \w en|strong="H5921"\w* favor \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* nación.   
\p
\v 25 Luego \w el|strong="H3588"\w* \w rey|strong="H4428"\w* colocó \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w levitas|strong="H3881"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, \w con|strong="H3588"\w* platillos, liras \w y|strong="H3588"\w* \w arpas|strong="H3658"\w*. Todo se hizo \w de|strong="H3588"\w* \w acuerdo|strong="H2374"\w* \w con|strong="H3588"\w* las instrucciones \w de|strong="H3588"\w* \w David|strong="H1732"\w*, del \w vidente|strong="H2374"\w* \w Gad|strong="H1410"\w* \w y|strong="H3588"\w* del \w profeta|strong="H5030"\w* Natán, \w porque|strong="H3588"\w* Yahvé mismo \w había|strong="H5975"\w* dado esa orden \w a|strong="H3068"\w* través \w de|strong="H3588"\w* sus \w profetas|strong="H5030"\w*.  
\v 26 Los \w levitas|strong="H3881"\w* tomaron sus posiciones con los \w instrumentos|strong="H3627"\w* musicales de \w David|strong="H1732"\w*, y los \w sacerdotes|strong="H3548"\w* con sus \w trompetas|strong="H2689"\w*.  
\v 27 \w Entonces|strong="H6256"\w* Ezequías dio \w la|strong="H5921"\w* orden \w de|strong="H5921"\w* ofrecer \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*. \w Y|strong="H3068"\w* justo \w en|strong="H5921"\w* \w el|strong="H5921"\w* momento \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w comenzaron|strong="H2490"\w* \w los|strong="H5921"\w* sacrificios, también empezaron \w los|strong="H5921"\w* cantos \w de|strong="H5921"\w* alabanza \w a|strong="H3068"\w* Yahvé, acompañados \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w instrumentos|strong="H3627"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 28 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea \w adoraba|strong="H7812"\w* \w a|strong="H3068"\w* Dios, \w mientras|strong="H3605"\w* \w los|strong="H3605"\w* \w cantores|strong="H7891"\w* \w cantaban|strong="H7891"\w* \w y|strong="H5704"\w* \w los|strong="H3605"\w* trompetistas \w tocaban|strong="H2690"\w*. Esto continuó \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* se terminó \w de|strong="H5704"\w* quemar \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w holocausto|strong="H5930"\w*.   
\p
\v 29 \w Al|strong="H4428"\w* terminar \w los|strong="H3605"\w* sacrificios, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* presentes se \w arrodillaron|strong="H3766"\w* y \w adoraron|strong="H7812"\w* \w a|strong="H3068"\w* Dios.  
\v 30 \w Después|strong="H5704"\w*, el \w rey|strong="H4428"\w* Ezequías \w y|strong="H5704"\w* sus funcionarios les ordenaron \w a|strong="H3068"\w* los \w levitas|strong="H3881"\w* \w que|strong="H5704"\w* \w alabaran|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé cantando los salmos escritos \w por|strong="H1697"\w* \w David|strong="H1732"\w* \w y|strong="H5704"\w* \w por|strong="H1697"\w* el \w vidente|strong="H2374"\w* Asaf. Ellos cantaron alabanzas \w con|strong="H5704"\w* mucha \w alegría|strong="H8057"\w*, \w e|strong="H3068"\w* inclinaron su rostro \w para|strong="H5704"\w* adorar.   
\p
\v 31 Ezequías les dijo: “\w Ahora|strong="H6258"\w* \w que|strong="H6258"\w* ustedes se han consagrado \w a|strong="H3068"\w* Yahvé, acérquense y \w traigan|strong="H5066"\w* \w al|strong="H5930"\w* \w templo|strong="H1004"\w* sus \w sacrificios|strong="H2077"\w* y ofrendas de agradecimiento”. \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w la|strong="H3605"\w* asamblea trajo sus \w sacrificios|strong="H2077"\w* y ofrendas voluntarias, y \w los|strong="H3605"\w* \w que|strong="H6258"\w* quisieron hacerlo de \w corazón|strong="H3820"\w*, también \w trajeron|strong="H5066"\w* animales \w para|strong="H6258"\w* \w el|strong="H3605"\w* \w holocausto|strong="H5930"\w*.  
\v 32 Ese día, \w la|strong="H3605"\w* gente llevó \w setenta|strong="H7657"\w* toros, \w cien|strong="H3967"\w* carneros \w y|strong="H1241"\w* \w doscientos|strong="H3967"\w* \w corderos|strong="H3532"\w*, \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* \w para|strong="H1961"\w* ser ofrecidos \w como|strong="H1961"\w* \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé.  
\v 33 Además, como ofrendas consagradas, trajeron sevecientas \w vacas|strong="H1241"\w* \w y|strong="H1241"\w* \w tres|strong="H7969"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*.  
\v 34 \w Pero|strong="H3588"\w* \w como|strong="H3588"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w eran|strong="H1961"\w* muy \w pocos|strong="H4592"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* daban abasto \w para|strong="H5704"\w* quitarles \w la|strong="H3588"\w* piel \w a|strong="H3068"\w* tantos animales, sus parientes, \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*, les \w ayudaron|strong="H2388"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* terminaron \w el|strong="H3588"\w* trabajo \w y|strong="H3588"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* otros \w sacerdotes|strong="H3548"\w* terminaron \w de|strong="H3588"\w* purificarse; ya \w que|strong="H3588"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w habían|strong="H1961"\w* \w sido|strong="H1961"\w* \w más|strong="H3588"\w* sinceros \w al|strong="H5704"\w* santificarse \w que|strong="H3588"\w* \w los|strong="H3605"\w* mismos \w sacerdotes|strong="H3548"\w*.  
\v 35 \w Además|strong="H1571"\w* de \w la|strong="H1571"\w* gran cantidad de \w holocaustos|strong="H5930"\w*, \w también|strong="H1571"\w* tuvieron \w que|strong="H1571"\w* quemar \w la|strong="H1571"\w* grasa de los sacrificios de paz \w y|strong="H1571"\w* derramar las ofrendas de vino \w que|strong="H1571"\w* acompañaban \w a|strong="H3068"\w* cada \w holocausto|strong="H5930"\w*. De esta manera, se restableció por completo \w el|strong="H1571"\w* servicio en \w el|strong="H1571"\w* \w templo|strong="H1004"\w* de Yahvé.  
\v 36 Ezequías \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w estaban|strong="H1961"\w* muy felices \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* Dios \w había|strong="H1961"\w* \w hecho|strong="H1961"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* corazón \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w*, especialmente \w porque|strong="H3588"\w* \w todo|strong="H3605"\w* \w se|strong="H1961"\w* logró \w en|strong="H5921"\w* muy poco tiempo.   
\c 30  
\p
\v 1 Ezequías \w mandó|strong="H7971"\w* invitaciones \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* \w Judá|strong="H3063"\w*, \w e|strong="H3068"\w* incluso \w les|strong="H5921"\w* \w escribió|strong="H3789"\w* cartas \w a|strong="H3068"\w* \w las|strong="H5921"\w* tribus \w de|strong="H5921"\w* Efraín \w y|strong="H1571"\w* \w Manasés|strong="H4519"\w*, invitándolos \w a|strong="H3068"\w* venir \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w en|strong="H5921"\w* Jerusalén \w para|strong="H5921"\w* \w celebrar|strong="H6213"\w* \w la|strong="H5921"\w* \w Pascua|strong="H6453"\w* \w en|strong="H5921"\w* honor \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 2 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* se \w había|strong="H6213"\w* puesto \w de|strong="H8269"\w* acuerdo con sus funcionarios y con \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H8269"\w* Jerusalén para \w celebrar|strong="H6213"\w* \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w* en \w el|strong="H3605"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*.  
\v 3 \w No|strong="H3808"\w* habían podido celebrarla \w en|strong="H3588"\w* \w la|strong="H1931"\w* fecha normal \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w había|strong="H6942"\w* suficientes \w sacerdotes|strong="H3548"\w* purificados, \w ni|strong="H3808"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w había|strong="H6942"\w* tenido \w tiempo|strong="H6256"\w* \w de|strong="H3588"\w* reunirse \w en|strong="H3588"\w* Jerusalén.  
\v 4 Como \w a|strong="H3068"\w* \w todos|strong="H3605"\w* les \w pareció|strong="H3474"\w* una excelente idea, tanto \w al|strong="H4428"\w* \w rey|strong="H4428"\w* como \w a|strong="H3068"\w* \w la|strong="H3605"\w* asamblea,  
\v 5 publicaron un decreto \w por|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w desde|strong="H5704"\w* Berseba \w en|strong="H5704"\w* \w el|strong="H3588"\w* sur \w hasta|strong="H5704"\w* \w Dan|strong="H1835"\w* \w en|strong="H5704"\w* \w el|strong="H3588"\w* norte. Invitaron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w a|strong="H3068"\w* venir \w a|strong="H3068"\w* Jerusalén \w para|strong="H5704"\w* \w celebrar|strong="H6213"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w pues|strong="H3588"\w* \w hacía|strong="H6213"\w* \w mucho|strong="H7230"\w* tiempo \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w la|strong="H3588"\w* celebraban \w todos|strong="H3605"\w* juntos \w como|strong="H3588"\w* \w lo|strong="H1697"\w* manda \w la|strong="H3588"\w* ley.   
\p
\v 6 \w Los|strong="H1121"\w* mensajeros salieron con las cartas del \w rey|strong="H4428"\w* y sus funcionarios y recorrieron \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* y \w Judá|strong="H3063"\w*, entregando este mensaje: “¡Israelitas! Regresen \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* Abraham, \w de|strong="H1121"\w* \w Isaac|strong="H3327"\w* y \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, para \w que|strong="H1121"\w* \w él|strong="H3605"\w* regrese \w al|strong="H4428"\w* resto \w de|strong="H1121"\w* ustedes \w que|strong="H1121"\w* lograron \w escapar|strong="H6413"\w* \w de|strong="H1121"\w* las \w manos|strong="H3027"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H1121"\w* Asiria.  
\v 7 \w No|strong="H1961"\w* \w sean|strong="H1961"\w* \w como|strong="H1961"\w* sus antepasados ni \w como|strong="H1961"\w* sus hermanos, \w que|strong="H1961"\w* le \w fueron|strong="H1961"\w* infieles \w a|strong="H3068"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* sus padres. \w Por|strong="H5414"\w* eso él \w los|strong="H1961"\w* destruyó, \w como|strong="H1961"\w* ustedes mismos \w ven|strong="H7200"\w*.  
\v 8 No sean tercos como \w ellos|strong="H3027"\w*. \w Más|strong="H4480"\w* bien, sométanse \w a|strong="H3068"\w* Yahvé, entren \w al|strong="H4480"\w* \w santuario|strong="H4720"\w* \w que|strong="H4480"\w* él consagró \w para|strong="H4480"\w* \w siempre|strong="H5769"\w*, y sirvan \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*. \w Así|strong="H6258"\w* su terrible enojo \w se|strong="H4480"\w* apartará \w de|strong="H4480"\w* ustedes.  
\v 9 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* ustedes regresan \w a|strong="H3068"\w* Yahvé, \w la|strong="H5921"\w* gente \w que|strong="H3588"\w* \w se|strong="H5921"\w* llevó prisioneros \w a|strong="H3068"\w* sus hermanos \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w les|strong="H5921"\w* tendrá compasión, \w y|strong="H3588"\w* \w ellos|strong="H5921"\w* podrán \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra. Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w es|strong="H3588"\w* compasivo \w y|strong="H3588"\w* \w misericordioso|strong="H7349"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w apartará|strong="H5493"\w* \w su|strong="H3588"\w* \w rostro|strong="H6440"\w* \w de|strong="H4480"\w* ustedes \w si|strong="H3588"\w* regresan \w a|strong="H3068"\w* \w él|strong="H5921"\w*”.   
\p
\v 10 \w Los|strong="H5921"\w* mensajeros \w pasaron|strong="H5674"\w* \w de|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w en|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* territorios \w de|strong="H5921"\w* Efraín \w y|strong="H5921"\w* \w Manasés|strong="H4519"\w*, \w y|strong="H5921"\w* llegaron \w hasta|strong="H5704"\w* \w Zabulón|strong="H2074"\w*; pero \w la|strong="H5921"\w* gente simplemente \w se|strong="H1961"\w* burlaba \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* trataba \w como|strong="H1961"\w* locos.  
\v 11 Sin embargo, algunos hombres de las tribus de Aser, \w Manasés|strong="H4519"\w* y \w Zabulón|strong="H2074"\w* se humillaron y viajaron \w a|strong="H3068"\w* Jerusalén.  
\v 12 En \w Judá|strong="H3063"\w*, en cambio, \w la|strong="H1571"\w* \w mano|strong="H3027"\w* \w de|strong="H1697"\w* \w Dios|strong="H3068"\w* actuó \w para|strong="H5414"\w* darles \w a|strong="H3068"\w* todos un solo \w corazón|strong="H3820"\w*, dispuestos \w a|strong="H3068"\w* cumplir \w la|strong="H1571"\w* orden del \w rey|strong="H4428"\w* \w y|strong="H1571"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* líderes, obedeciendo \w la|strong="H1571"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé.   
\p
\v 13 Fue así como una inmensa \w multitud|strong="H6951"\w* \w se|strong="H5971"\w* reunió en Jerusalén en \w el|strong="H6213"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, \w para|strong="H5971"\w* \w celebrar|strong="H6213"\w* la \w fiesta|strong="H2282"\w* \w de|strong="H5971"\w* los Panes sin Levadura.  
\v 14 \w Lo|strong="H3605"\w* primero \w que|strong="H3605"\w* hicieron fue \w quitar|strong="H5493"\w* \w los|strong="H3605"\w* \w altares|strong="H4196"\w* paganos \w que|strong="H3605"\w* había \w en|strong="H5493"\w* Jerusalén. \w Quitaron|strong="H5493"\w* también \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w altares|strong="H4196"\w* de incienso y \w los|strong="H3605"\w* tiraron \w en|strong="H5493"\w* \w el|strong="H3605"\w* \w arroyo|strong="H5158"\w* de Cedrón.  
\v 15 El día catorce del \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, sacrificaron el cordero de la \w Pascua|strong="H6453"\w*. Los \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w* se sintieron \w avergonzados|strong="H3637"\w*, así que se purificaron y llevaron \w holocaustos|strong="H5930"\w* \w al|strong="H5930"\w* \w templo|strong="H1004"\w* de Yahvé.  
\v 16 Luego tomaron sus posiciones acostumbradas \w en|strong="H5921"\w* \w el|strong="H5921"\w* templo, tal \w como|strong="H5921"\w* \w lo|strong="H5921"\w* manda \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w el|strong="H5921"\w* hombre \w de|strong="H5921"\w* Dios. \w Los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w les|strong="H5921"\w* entregaban \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w la|strong="H5921"\w* rociaban \w en|strong="H5921"\w* \w el|strong="H5921"\w* altar.  
\v 17 \w Como|strong="H3588"\w* \w muchas|strong="H7227"\w* personas \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H6951"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* habían \w purificado|strong="H3588"\w*, \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* tuvieron \w que|strong="H3588"\w* encargarse \w de|strong="H5921"\w* matar \w los|strong="H5921"\w* corderos \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w Pascua|strong="H6453"\w* \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* estaban impuros, \w para|strong="H5921"\w* consagrarlos \w a|strong="H3068"\w* Yahvé.  
\v 18 Una \w gran|strong="H7227"\w* parte \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w*, especialmente \w los|strong="H5921"\w* \w de|strong="H5921"\w* Efraín, \w Manasés|strong="H4519"\w*, Isacar \w y|strong="H3588"\w* \w Zabulón|strong="H2074"\w*, \w no|strong="H3808"\w* \w se|strong="H5921"\w* habían \w purificado|strong="H3588"\w*, \w y|strong="H3588"\w* \w aun|strong="H3808"\w* \w así|strong="H3588"\w* comieron \w la|strong="H5921"\w* \w Pascua|strong="H6453"\w*, \w lo|strong="H3808"\w* \w cual|strong="H3588"\w* iba \w en|strong="H5921"\w* \w contra|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* estaba \w escrito|strong="H3789"\w*. \w Pero|strong="H3588"\w* Ezequías \w oró|strong="H6419"\w* \w por|strong="H5921"\w* \w ellos|strong="H5921"\w* diciendo: “\w Que|strong="H3588"\w* \w el|strong="H5921"\w* \w buen|strong="H2896"\w* Yahvé perdone \w a|strong="H3068"\w* todo aquel  
\v 19 \w que|strong="H3808"\w* haya decidido de \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w* buscar \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*, \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de sus antepasados, \w aunque|strong="H3808"\w* \w no|strong="H3808"\w* cumpla con \w los|strong="H3605"\w* requisitos de pureza del \w santuario|strong="H6944"\w*”.   
\p
\v 20 Yahvé \w escuchó|strong="H8085"\w* la oración \w de|strong="H5971"\w* Ezequías y perdonó al \w pueblo|strong="H5971"\w*.  
\v 21 \w Los|strong="H1121"\w* israelitas \w que|strong="H3117"\w* estaban en Jerusalén celebraron la \w fiesta|strong="H2282"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* Panes sin Levadura durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* con muchísima \w alegría|strong="H8057"\w*. Todos \w los|strong="H1121"\w* \w días|strong="H3117"\w*, \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w y|strong="H5797"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* alababan \w a|strong="H3068"\w* Yahvé, tocando \w instrumentos|strong="H3627"\w* con mucha fuerza.  
\v 22 Ezequías felicitó \w y|strong="H5921"\w* animó \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H5921"\w* mostraron tanta dedicación \w en|strong="H5921"\w* su servicio \w a|strong="H3068"\w* Yahvé. \w Así|strong="H1696"\w* celebraron \w los|strong="H5921"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* fiesta, \w ofreciendo|strong="H2076"\w* \w sacrificios|strong="H2077"\w* \w de|strong="H5921"\w* paz \w y|strong="H5921"\w* dando gracias \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* sus antepasados.   
\p
\v 23 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad estaba tan contenta \w que|strong="H3117"\w* decidieron \w celebrar|strong="H6213"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* más. \w Y|strong="H3068"\w* así \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* con mucha \w alegría|strong="H8057"\w*.  
\v 24 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* Ezequías le regaló \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w multitud|strong="H6951"\w* \w mil|strong="H6235"\w* \w toros|strong="H6499"\w* \w y|strong="H3588"\w* \w siete|strong="H7651"\w* \w mil|strong="H6235"\w* \w ovejas|strong="H6629"\w*; \w y|strong="H3588"\w* \w los|strong="H3588"\w* funcionarios regalaron \w mil|strong="H6235"\w* \w toros|strong="H6499"\w* \w y|strong="H3588"\w* \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* \w ovejas|strong="H6629"\w*. \w Y|strong="H3068"\w* \w para|strong="H3588"\w* ese \w entonces|strong="H3588"\w*, ya se \w había|strong="H6942"\w* \w purificado|strong="H3588"\w* un grupo muy \w grande|strong="H7230"\w* \w de|strong="H3588"\w* \w sacerdotes|strong="H3548"\w*.  
\v 25 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea de \w Judá|strong="H3063"\w* hizo fiesta, junto con \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w levitas|strong="H3881"\w*, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* gente \w que|strong="H1616"\w* había venido de \w Israel|strong="H3478"\w*, y \w los|strong="H3427"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H1616"\w* \w vivían|strong="H3427"\w* en \w Israel|strong="H3478"\w* y en \w Judá|strong="H3063"\w*.  
\v 26 \w Hubo|strong="H1961"\w* una \w alegría|strong="H8057"\w* tremenda \w en|strong="H3588"\w* Jerusalén, \w porque|strong="H3588"\w* desde \w la|strong="H3588"\w* época \w de|strong="H3588"\w* \w Salomón|strong="H8010"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* visto una celebración igual \w en|strong="H3588"\w* \w la|strong="H3588"\w* ciudad.  
\v 27 \w Para|strong="H5971"\w* terminar, los \w sacerdotes|strong="H3548"\w* \w levitas|strong="H3881"\w* \w se|strong="H5971"\w* pusieron \w de|strong="H5971"\w* pie y \w bendijeron|strong="H1288"\w* al \w pueblo|strong="H5971"\w*. Su \w voz|strong="H6963"\w* fue escuchada, y su \w oración|strong="H8605"\w* llegó hasta el \w cielo|strong="H8064"\w*, la \w santa|strong="H6944"\w* \w morada|strong="H4583"\w* \w de|strong="H5971"\w* Dios.   
\c 31  
\p
\v 1 \w Al|strong="H5704"\w* terminar \w la|strong="H2063"\w* fiesta, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H5704"\w* estaban allí fueron \w a|strong="H3068"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* \w e|strong="H3068"\w* hicieron pedazos las piedras sagradas, \w cortaron|strong="H1438"\w* las imágenes \w de|strong="H5704"\w* \w la|strong="H2063"\w* diosa Asera \w y|strong="H5704"\w* \w destruyeron|strong="H3615"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* santuarios \w y|strong="H5704"\w* \w altares|strong="H4196"\w* paganos \w en|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w Benjamín|strong="H1144"\w*, Efraín \w y|strong="H5704"\w* \w Manasés|strong="H4519"\w*. \w Después|strong="H5704"\w* \w de|strong="H5704"\w* destruir \w todo|strong="H3605"\w* \w eso|strong="H2063"\w*, \w los|strong="H1121"\w* israelitas regresaron \w a|strong="H3068"\w* sus casas, \w cada|strong="H3605"\w* uno \w a|strong="H3068"\w* su propia \w ciudad|strong="H5892"\w*.   
\p
\v 2 Ezequías reorganizó \w los|strong="H5921"\w* turnos \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w de|strong="H5921"\w* acuerdo \w con|strong="H5921"\w* \w las|strong="H5921"\w* tareas \w de|strong="H5921"\w* cada quien, \w para|strong="H5921"\w* \w que|strong="H5921"\w* ofrecieran \w los|strong="H5921"\w* \w holocaustos|strong="H5930"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* sacrificios \w de|strong="H5921"\w* paz, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* sirvieran, dieran gracias \w y|strong="H5921"\w* cantaran alabanzas \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w del|strong="H5921"\w* templo \w de|strong="H5921"\w* Yahvé.  
\v 3 El \w rey|strong="H4428"\w* aportó \w de|strong="H4480"\w* sus propios bienes los animales \w para|strong="H4480"\w* los \w holocaustos|strong="H5930"\w* \w de|strong="H4480"\w* la \w mañana|strong="H1242"\w* y \w de|strong="H4480"\w* la \w tarde|strong="H6153"\w*, así como los \w de|strong="H4480"\w* los \w sábados|strong="H7676"\w*, las fiestas \w de|strong="H4480"\w* luna nueva y las tres fiestas anuales, tal como lo manda la \w ley|strong="H8451"\w* \w de|strong="H4480"\w* Yahvé.  
\v 4 Además, le ordenó \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* \w de|strong="H5971"\w* Jerusalén \w que|strong="H5971"\w* \w entregara|strong="H5414"\w* la porción \w que|strong="H5971"\w* les correspondía \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w*, \w para|strong="H4616"\w* \w que|strong="H5971"\w* estos pudieran dedicarse \w por|strong="H4616"\w* completo \w a|strong="H3068"\w* enseñar y cumplir la \w ley|strong="H8451"\w* \w de|strong="H5971"\w* Yahvé.  
\v 5 En cuanto se dio \w la|strong="H3605"\w* orden, \w los|strong="H1121"\w* israelitas trajeron con \w mucha|strong="H7235"\w* generosidad las primeras cosechas \w de|strong="H1121"\w* \w trigo|strong="H1715"\w*, \w vino|strong="H8492"\w* nuevo, \w aceite|strong="H3323"\w*, \w miel|strong="H1706"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w frutos|strong="H8393"\w* del \w campo|strong="H7704"\w*. Trajeron en \w abundancia|strong="H7230"\w* \w el|strong="H3605"\w* diezmo \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* producían.  
\v 6 \w También|strong="H1571"\w* \w los|strong="H1992"\w* israelitas \w y|strong="H1571"\w* \w la|strong="H1571"\w* gente \w que|strong="H1571"\w* \w vivía|strong="H3427"\w* en \w las|strong="H1992"\w* \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* trajeron \w el|strong="H1121"\w* diezmo \w de|strong="H1121"\w* \w sus|strong="H1992"\w* \w vacas|strong="H1241"\w* \w y|strong="H1571"\w* \w ovejas|strong="H6629"\w*, \w y|strong="H1571"\w* \w el|strong="H1121"\w* diezmo \w de|strong="H1121"\w* \w las|strong="H1992"\w* \w cosas|strong="H1992"\w* consagradas \w a|strong="H3068"\w* Yahvé \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*, \w y|strong="H1571"\w* amontonaron todo en \w el|strong="H1121"\w* patio del templo.   
\p
\v 7 Empezaron \w a|strong="H3068"\w* formar los montones en el tercer \w mes|strong="H2320"\w* y terminaron en el \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*.  
\v 8 Cuando Ezequías y los líderes fueron y \w vieron|strong="H7200"\w* la cantidad \w de|strong="H5971"\w* cosas amontonadas, \w bendijeron|strong="H1288"\w* \w a|strong="H3068"\w* Yahvé y \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.  
\v 9 Ezequías \w les|strong="H5921"\w* preguntó \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* todos esos montones.  
\v 10 \w Y|strong="H3068"\w* \w el|strong="H3588"\w* \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w* \w Azarías|strong="H5838"\w*, \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w Sadoc|strong="H6659"\w*, le contestó: “\w Desde|strong="H5704"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w empezó|strong="H2490"\w* \w a|strong="H3068"\w* traer las \w ofrendas|strong="H8641"\w* \w al|strong="H5704"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, hemos tenido comida \w de|strong="H3588"\w* sobra. Ha quedado muchísima, \w porque|strong="H3588"\w* Yahvé ha bendecido \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*; \w y|strong="H3588"\w* toda \w esta|strong="H2088"\w* inmensa cantidad \w es|strong="H2088"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* ha sobrado”.   
\p
\v 11 Entonces Ezequías mandó preparar unos cuartos en el \w templo|strong="H1004"\w* de Yahvé para usar como bodegas, y así lo hicieron.  
\v 12 \w Con|strong="H5921"\w* mucho cuidado guardaron allí \w las|strong="H5921"\w* \w ofrendas|strong="H8641"\w*, \w los|strong="H5921"\w* diezmos \w y|strong="H5921"\w* todo \w lo|strong="H5921"\w* \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Dios. \w El|strong="H5921"\w* \w levita|strong="H3881"\w* Conanías fue nombrado administrador principal, \w y|strong="H5921"\w* su hermano Simei era su ayudante.  
\v 13 Bajo las órdenes \w de|strong="H5057"\w* Conanías y su hermano Simei trabajaban como supervisores \w Jehiel|strong="H3171"\w*, \w Azazías|strong="H5812"\w*, Nahat, \w Asael|strong="H6214"\w*, Jerimot, \w Jozabad|strong="H3107"\w*, Eliel, Ismaquías, Mahat y \w Benaía|strong="H1141"\w*. Todos \w ellos|strong="H3027"\w* fueron nombrados \w por|strong="H3027"\w* el \w rey|strong="H4428"\w* Ezequías y \w por|strong="H3027"\w* \w Azarías|strong="H5838"\w*, el encargado del \w templo|strong="H1004"\w* \w de|strong="H5057"\w* Dios.  
\v 14 \w El|strong="H5921"\w* \w levita|strong="H3881"\w* Coré \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Imná|strong="H3232"\w*, \w que|strong="H5921"\w* cuidaba \w la|strong="H5921"\w* puerta \w del|strong="H5921"\w* \w este|strong="H4217"\w*, \w era|strong="H1121"\w* \w el|strong="H5921"\w* encargado \w de|strong="H5921"\w* recibir \w las|strong="H5921"\w* \w ofrendas|strong="H8641"\w* \w voluntarias|strong="H5071"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* repartir \w las|strong="H5921"\w* \w ofrendas|strong="H8641"\w* \w para|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w las|strong="H5921"\w* cosas \w más|strong="H5921"\w* \w sagradas|strong="H6944"\w*.  
\v 15 Edén, \w Miniamín|strong="H4509"\w*, \w Jesúa|strong="H3442"\w*, \w Semaías|strong="H8098"\w*, Amarías \w y|strong="H5921"\w* Secanías eran sus ayudantes \w de|strong="H5921"\w* confianza \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w*. \w Ellos|strong="H3027"\w* repartían \w las|strong="H5921"\w* porciones \w de|strong="H5921"\w* comida \w a|strong="H3068"\w* sus compañeros, \w según|strong="H5921"\w* sus turnos, \w dándoles|strong="H5414"\w* \w a|strong="H3068"\w* todos \w por|strong="H5921"\w* igual, \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w mayor|strong="H1419"\w* \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* \w menor|strong="H6996"\w*.  
\v 16 También se les daba su porción \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w varones|strong="H2145"\w* \w de|strong="H1121"\w* \w tres|strong="H7969"\w* \w años|strong="H8141"\w* para \w arriba|strong="H4605"\w* \w que|strong="H1697"\w* estaban anotados en \w los|strong="H1121"\w* registros familiares y \w que|strong="H1697"\w* entraban al \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé para cumplir con sus tareas diarias, según sus \w turnos|strong="H4931"\w*.  
\v 17 \w El|strong="H1121"\w* registro \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* se llevaba \w por|strong="H3881"\w* \w familias|strong="H1004"\w*, y \w el|strong="H1121"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w de|strong="H1121"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* para \w arriba|strong="H4605"\w*, se llevaba según sus tareas y sus \w turnos|strong="H4931"\w*.  
\v 18 \w Todos|strong="H3605"\w* estaban anotados \w en|strong="H3588"\w* \w el|strong="H3588"\w* registro junto \w con|strong="H3588"\w* sus esposas, sus \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad completa, \w pues|strong="H3588"\w* \w ellos|strong="H3605"\w* se dedicaban fielmente \w a|strong="H3068"\w* mantenerse consagrados \w y|strong="H3588"\w* listos \w para|strong="H3588"\w* servir.  
\v 19 Incluso \w para|strong="H5414"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, descendientes \w de|strong="H1121"\w* Aarón, \w que|strong="H1121"\w* vivían en \w los|strong="H1121"\w* \w campos|strong="H7704"\w* \w de|strong="H1121"\w* pastoreo alrededor \w de|strong="H1121"\w* las \w ciudades|strong="H5892"\w*, había \w hombres|strong="H1121"\w* \w nombrados|strong="H5344"\w* específicamente \w para|strong="H5414"\w* repartirles las \w porciones|strong="H4490"\w* \w de|strong="H1121"\w* comida \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* las familias \w sacerdotales|strong="H3548"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w que|strong="H1121"\w* estaban en \w los|strong="H1121"\w* registros.   
\p
\v 20 \w Todo|strong="H3605"\w* \w esto|strong="H2063"\w* \w lo|strong="H6213"\w* \w hizo|strong="H6213"\w* Ezequías en \w Judá|strong="H3063"\w*. \w Él|strong="H3605"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* era \w bueno|strong="H2896"\w*, correcto y fiel \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé su \w Dios|strong="H3068"\w*.  
\v 21 En \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* emprendió para \w el|strong="H3605"\w* servicio del \w templo|strong="H1004"\w* de Dios, y en su obediencia \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w ley|strong="H8451"\w* y \w los|strong="H3605"\w* \w mandamientos|strong="H4687"\w*, \w buscó|strong="H1875"\w* \w a|strong="H3068"\w* su Dios de \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w* y \w tuvo|strong="H6213"\w* gran éxito en \w todo|strong="H3605"\w*.   
\c 32  
\p
\v 1 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* todo \w esto|strong="H1697"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* ver \w la|strong="H5921"\w* fidelidad \w de|strong="H5921"\w* Ezequías, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Senaquerib \w de|strong="H5921"\w* Asiria invadió \w Judá|strong="H3063"\w*. Acampó frente \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* \w y|strong="H5921"\w* dio \w la|strong="H5921"\w* orden \w de|strong="H5921"\w* atacarlas \w y|strong="H5921"\w* conquistarlas.  
\v 2 \w Cuando|strong="H3588"\w* Ezequías \w vio|strong="H7200"\w* \w que|strong="H3588"\w* Senaquerib \w había|strong="H3588"\w* llegado \w con|strong="H5921"\w* \w la|strong="H5921"\w* clara intención \w de|strong="H5921"\w* atacar Jerusalén,  
\v 3 se reunió \w con|strong="H5973"\w* sus funcionarios y sus oficiales militares y \w les|strong="H5973"\w* propuso tapar \w los|strong="H5973"\w* manantiales \w de|strong="H5973"\w* \w agua|strong="H4325"\w* \w que|strong="H4325"\w* había \w fuera|strong="H2351"\w* \w de|strong="H5973"\w* la \w ciudad|strong="H5892"\w*, y ellos lo apoyaron.  
\v 4 \w Juntaron|strong="H6908"\w* \w a|strong="H3068"\w* \w mucha|strong="H7227"\w* \w gente|strong="H5971"\w* y taparon \w todos|strong="H3605"\w* \w los|strong="H3605"\w* manantiales y \w el|strong="H3605"\w* \w arroyo|strong="H5158"\w* \w que|strong="H4100"\w* corría \w por|strong="H4100"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* del territorio, \w pues|strong="H6908"\w* decían: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* vamos \w a|strong="H3068"\w* dejar \w que|strong="H4100"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H5971"\w* Asiria lleguen y encuentren \w agua|strong="H4325"\w* \w de|strong="H5971"\w* sobra?”   
\p
\v 5 Ezequías \w se|strong="H5921"\w* armó \w de|strong="H5921"\w* valor \w y|strong="H5921"\w* \w reparó|strong="H1129"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* tramos rotos \w de|strong="H5921"\w* \w la|strong="H5921"\w* muralla, levantó \w torres|strong="H4026"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*, construyó \w otra|strong="H6213"\w* muralla exterior, reforzó \w la|strong="H5921"\w* defensa \w del|strong="H5921"\w* terraplén \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w y|strong="H5921"\w* mandó fabricar muchísimas armas \w y|strong="H5921"\w* \w escudos|strong="H4043"\w*.  
\v 6 \w Puso|strong="H5414"\w* \w a|strong="H3068"\w* \w jefes|strong="H8269"\w* militares \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w los|strong="H5921"\w* reunió \w a|strong="H3068"\w* todos \w en|strong="H5921"\w* \w la|strong="H5921"\w* plaza frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* animó diciéndoles:  
\v 7 “¡Sean fuertes \w y|strong="H3588"\w* valientes! \w No|strong="H3588"\w* tengan \w miedo|strong="H3372"\w* \w ni|strong="H5973"\w* se asusten \w por|strong="H3588"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria \w ni|strong="H5973"\w* \w por|strong="H3588"\w* \w el|strong="H5973"\w* enorme \w ejército|strong="H1995"\w* \w que|strong="H3588"\w* \w lo|strong="H3605"\w* acompaña, \w porque|strong="H3588"\w* \w el|strong="H5973"\w* \w que|strong="H3588"\w* está \w con|strong="H5973"\w* \w nosotros|strong="H3605"\w* \w es|strong="H3588"\w* \w más|strong="H3588"\w* \w poderoso|strong="H2388"\w* \w que|strong="H3588"\w* \w el|strong="H5973"\w* \w que|strong="H3588"\w* está \w con|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 8 \w Él|strong="H5921"\w* confía \w en|strong="H5921"\w* \w la|strong="H5921"\w* fuerza humana, pero \w nosotros|strong="H5973"\w* tenemos \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w para|strong="H5921"\w* ayudarnos \w y|strong="H5921"\w* \w para|strong="H5921"\w* pelear nuestras \w batallas|strong="H4421"\w*”. \w Al|strong="H5921"\w* escuchar \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* llenó \w de|strong="H5921"\w* confianza.   
\p
\v 9 Un tiempo \w después|strong="H5921"\w*, \w mientras|strong="H3605"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Senaquerib \w de|strong="H5921"\w* Asiria estaba \w con|strong="H5973"\w* \w todas|strong="H3605"\w* \w sus|strong="H1931"\w* tropas atacando \w la|strong="H1931"\w* ciudad \w de|strong="H5921"\w* Laquis, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w sus|strong="H1931"\w* funcionarios \w a|strong="H3068"\w* Jerusalén \w con|strong="H5973"\w* \w este|strong="H2088"\w* mensaje \w para|strong="H5921"\w* Ezequías \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* gente \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w que|strong="H1931"\w* estaba allí:  
\v 10 “\w Esto|strong="H3541"\w* dice Senaquerib, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria: ‘¿\w En|strong="H5921"\w* \w qué|strong="H4100"\w* confían ustedes \w para|strong="H5921"\w* quedarse encerrados \w en|strong="H5921"\w* Jerusalén?  
\v 11 ¿\w No|strong="H3808"\w* \w se|strong="H3808"\w* \w dan|strong="H5414"\w* cuenta \w de|strong="H5414"\w* \w que|strong="H3808"\w* Ezequías los está engañando \w para|strong="H5414"\w* \w que|strong="H3808"\w* \w mueran|strong="H4191"\w* \w de|strong="H5414"\w* \w hambre|strong="H7458"\w* y \w sed|strong="H6772"\w*, cuando les dice: Yahvé nuestro \w Dios|strong="H3068"\w* nos salvará \w de|strong="H5414"\w* las \w manos|strong="H3709"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria?  
\v 12 ¡\w Si|strong="H3808"\w* \w fue|strong="H1931"\w* \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* Ezequías \w quien|strong="H1931"\w* \w quitó|strong="H5493"\w* \w los|strong="H5921"\w* santuarios \w y|strong="H5921"\w* \w altares|strong="H4196"\w* \w de|strong="H5921"\w* \w ese|strong="H1931"\w* Dios, \w y|strong="H5921"\w* \w les|strong="H5921"\w* ordenó \w a|strong="H3068"\w* ustedes adorar \w y|strong="H5921"\w* quemar incienso \w en|strong="H5921"\w* un \w solo|strong="H1931"\w* \w altar|strong="H4196"\w*!  
\v 13 ¿Acaso \w no|strong="H3808"\w* \w saben|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w yo|strong="H6213"\w* y mis antepasados hemos \w hecho|strong="H6213"\w* con \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* del mundo? ¿Acaso \w los|strong="H3605"\w* dioses \w de|strong="H5971"\w* esos países \w pudieron|strong="H3201"\w* salvar \w a|strong="H3068"\w* su \w gente|strong="H1471"\w* \w de|strong="H5971"\w* mis \w manos|strong="H3027"\w*?  
\v 14 \w De|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* dioses \w de|strong="H3588"\w* esas \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* mis antepasados \w destruyeron|strong="H2763"\w*, ¿\w cuál|strong="H4310"\w* \w de|strong="H3588"\w* \w ellos|strong="H3027"\w* \w pudo|strong="H3201"\w* salvar \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*? ¿\w Qué|strong="H3588"\w* les hace pensar \w que|strong="H3588"\w* \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* ustedes \w podrá|strong="H3201"\w* salvarlos \w de|strong="H3588"\w* mí?  
\v 15 ¡\w No|strong="H3808"\w* dejen \w que|strong="H3588"\w* Ezequías \w los|strong="H3605"\w* \w engañe|strong="H5377"\w* \w ni|strong="H3808"\w* \w los|strong="H3605"\w* convenza \w de|strong="H3588"\w* esa manera! \w No|strong="H3808"\w* le crean. \w Si|strong="H3588"\w* \w ningún|strong="H3605"\w* dios \w de|strong="H3588"\w* \w ninguna|strong="H3605"\w* \w nación|strong="H1471"\w* \w o|strong="H3068"\w* \w reino|strong="H4467"\w* \w ha|strong="H3808"\w* podido salvar \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* mis \w manos|strong="H3027"\w* \w ni|strong="H3808"\w* \w de|strong="H3588"\w* las \w manos|strong="H3027"\w* \w de|strong="H3588"\w* mis padres, ¡mucho \w menos|strong="H3588"\w* \w podrá|strong="H3201"\w* \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* ustedes salvarlos \w a|strong="H3068"\w* ustedes!’”   
\p
\v 16 \w Los|strong="H5921"\w* funcionarios \w de|strong="H5921"\w* Senaquerib siguieron \w diciendo|strong="H1696"\w* barbaridades \w contra|strong="H5921"\w* Yahvé \w Dios|strong="H3068"\w* \w y|strong="H5921"\w* \w contra|strong="H5921"\w* su \w siervo|strong="H5650"\w* Ezequías.  
\v 17 Senaquerib \w también|strong="H3651"\w* \w escribió|strong="H3789"\w* \w cartas|strong="H5612"\w* \w para|strong="H5921"\w* insultar \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w En|strong="H5921"\w* \w ellas|strong="H5921"\w* decía: “\w Así|strong="H3651"\w* \w como|strong="H5921"\w* \w los|strong="H5921"\w* dioses \w de|strong="H5921"\w* \w las|strong="H5921"\w* demás \w naciones|strong="H1471"\w* \w no|strong="H3808"\w* pudieron salvar \w a|strong="H3068"\w* sus \w pueblos|strong="H5971"\w* \w de|strong="H5921"\w* mis \w manos|strong="H3027"\w*, \w tampoco|strong="H3808"\w* \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* Ezequías \w podrá|strong="H3808"\w* salvar \w al|strong="H5921"\w* \w suyo|strong="H5971"\w*”.  
\v 18 \w Los|strong="H5921"\w* asirios \w les|strong="H5921"\w* gritaban muy fuerte \w y|strong="H5921"\w* \w en|strong="H5921"\w* hebreo \w a|strong="H3068"\w* \w los|strong="H5921"\w* habitantes \w de|strong="H5921"\w* Jerusalén \w que|strong="H5921"\w* \w estaban|strong="H5971"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* muralla, \w para|strong="H4616"\w* asustarlos \w y|strong="H5921"\w* meterles terror, \w y|strong="H5921"\w* así poder conquistar \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w más|strong="H5921"\w* fácilmente.  
\v 19 \w Hablaban|strong="H1696"\w* \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* Jerusalén \w como|strong="H5921"\w* \w si|strong="H5921"\w* fuera igual \w a|strong="H3068"\w* \w los|strong="H5921"\w* dioses \w de|strong="H5921"\w* \w los|strong="H5921"\w* demás \w pueblos|strong="H5971"\w* \w del|strong="H5921"\w* mundo, \w que|strong="H5921"\w* \w no|strong="H5921"\w* son \w más|strong="H5921"\w* \w que|strong="H5921"\w* objetos \w hechos|strong="H4639"\w* \w por|strong="H5921"\w* \w manos|strong="H3027"\w* humanas.   
\p
\v 20 Ante \w esta|strong="H2063"\w* situación, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Ezequías \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz \w oraron|strong="H6419"\w* \w y|strong="H5921"\w* \w clamaron|strong="H2199"\w* \w al|strong="H5921"\w* \w cielo|strong="H8064"\w* pidiendo ayuda.   
\p
\v 21 \w Y|strong="H3068"\w* Yahvé \w envió|strong="H7971"\w* un \w ángel|strong="H4397"\w* \w que|strong="H3605"\w* aniquiló \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* guerreros, oficiales y comandantes en \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* del \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Asiria. Así \w que|strong="H3605"\w* Senaquerib tuvo \w que|strong="H3605"\w* regresar \w a|strong="H3068"\w* su país con \w la|strong="H3605"\w* \w cara|strong="H6440"\w* llena \w de|strong="H6440"\w* vergüenza. Un día, \w mientras|strong="H3605"\w* \w estaba|strong="H1004"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H6440"\w* su \w dios|strong="H3068"\w*, sus propios hijos\f + \fr 32:21 \ft es decir, sus propios hijos.\f* \w lo|strong="H3605"\w* asesinaron \w allí|strong="H8033"\w* \w mismo|strong="H3605"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*.  
\v 22 De \w esta|strong="H3427"\w* manera Yahvé \w salvó|strong="H3467"\w* \w a|strong="H3068"\w* Ezequías y \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén de las \w manos|strong="H3027"\w* de Senaquerib, \w rey|strong="H4428"\w* de Asiria, y de \w todos|strong="H3605"\w* sus demás enemigos; y les dio paz en \w todas|strong="H3605"\w* sus fronteras.  
\v 23 \w Mucha|strong="H7227"\w* \w gente|strong="H1471"\w* \w llevó|strong="H5375"\w* ofrendas para Yahvé \w a|strong="H3068"\w* Jerusalén, y valiosos regalos para Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5869"\w* \w Judá|strong="H3063"\w*. \w A|strong="H3068"\w* partir \w de|strong="H5869"\w* \w entonces|strong="H3651"\w*, su prestigio creció ante \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w*.   
\p
\v 24 \w Por|strong="H5704"\w* aquel \w tiempo|strong="H3117"\w*, Ezequías \w se|strong="H1992"\w* \w enfermó|strong="H2470"\w* gravemente \w y|strong="H5704"\w* estuvo \w a|strong="H3068"\w* punto \w de|strong="H5704"\w* \w morir|strong="H4191"\w*. \w Oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé, \w y|strong="H5704"\w* \w Dios|strong="H3068"\w* le respondió \w dándole|strong="H5414"\w* una señal milagrosa.  
\v 25 \w Pero|strong="H3588"\w* Ezequías \w se|strong="H1961"\w* \w volvió|strong="H7725"\w* orgulloso \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w fue|strong="H1961"\w* agradecido \w por|strong="H5921"\w* \w el|strong="H5921"\w* favor \w que|strong="H3588"\w* Dios \w le|strong="H5921"\w* \w había|strong="H1961"\w* \w hecho|strong="H1961"\w*. \w Por|strong="H5921"\w* eso, \w el|strong="H5921"\w* \w enojo|strong="H7110"\w* \w de|strong="H5921"\w* Dios cayó \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* Jerusalén.  
\v 26 \w Sin|strong="H3808"\w* embargo, Ezequías \w se|strong="H1931"\w* arrepintió \w de|strong="H5921"\w* \w su|strong="H1931"\w* orgullo \w y|strong="H5921"\w* \w se|strong="H1931"\w* humilló, \w y|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén hicieron \w lo|strong="H1931"\w* \w mismo|strong="H1931"\w*. Gracias \w a|strong="H3068"\w* \w esto|strong="H1931"\w*, \w el|strong="H1931"\w* \w enojo|strong="H7110"\w* \w de|strong="H5921"\w* Yahvé \w no|strong="H3808"\w* cayó \w sobre|strong="H5921"\w* \w ellos|strong="H1931"\w* mientras Ezequías \w estuvo|strong="H3427"\w* vivo.   
\p
\v 27 Ezequías llegó \w a|strong="H3068"\w* \w tener|strong="H1961"\w* muchísimas \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* fama. \w Se|strong="H1961"\w* construyó bodegas \w para|strong="H1961"\w* guardar su \w plata|strong="H3701"\w*, \w oro|strong="H2091"\w*, piedras \w preciosas|strong="H3368"\w*, \w especias|strong="H1314"\w* aromáticas, \w escudos|strong="H4043"\w* \w y|strong="H3519"\w* \w toda|strong="H3605"\w* clase de objetos de \w gran|strong="H3966"\w* valor.  
\v 28 También construyó graneros para sus enormes cosechas de \w trigo|strong="H1715"\w*, \w vino|strong="H8492"\w* nuevo y \w aceite|strong="H3323"\w*; así como establos y corrales para su inmensa cantidad de ganado y \w rebaños|strong="H5739"\w*.  
\v 29 Mandó construir \w ciudades|strong="H5892"\w*, \w y|strong="H3588"\w* Dios le \w dio|strong="H5414"\w* muchísimas propiedades \w y|strong="H3588"\w* animales, \w pues|strong="H3588"\w* \w lo|strong="H6213"\w* \w hizo|strong="H6213"\w* \w sumamente|strong="H3966"\w* rico.  
\v 30 \w Fue|strong="H1931"\w* \w este|strong="H1931"\w* \w mismo|strong="H1931"\w* Ezequías \w quien|strong="H3605"\w* mandó tapar \w el|strong="H1931"\w* manantial superior \w de|strong="H4325"\w* Gihón y canalizó \w el|strong="H1931"\w* \w agua|strong="H4325"\w* por \w debajo|strong="H4295"\w* \w de|strong="H4325"\w* \w la|strong="H1931"\w* tierra hacia \w el|strong="H1931"\w* lado oeste \w de|strong="H4325"\w* \w la|strong="H1931"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H4325"\w* \w David|strong="H1732"\w*. Ezequías tuvo éxito en \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* hizo.   
\p
\v 31 Sin embargo, \w cuando|strong="H1961"\w* \w los|strong="H5921"\w* gobernantes \w de|strong="H5921"\w* Babilonia \w enviaron|strong="H7971"\w* embajadores \w para|strong="H5921"\w* preguntarle \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* señal milagrosa \w que|strong="H5921"\w* \w había|strong="H1961"\w* ocurrido \w en|strong="H5921"\w* \w el|strong="H5921"\w* país, Dios \w lo|strong="H5921"\w* \w dejó|strong="H5800"\w* solo \w para|strong="H5921"\w* ponerlo \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w y|strong="H5921"\w* ver \w qué|strong="H5921"\w* \w había|strong="H1961"\w* realmente \w en|strong="H5921"\w* su \w corazón|strong="H3824"\w*.   
\p
\v 32 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* Ezequías \w y|strong="H5921"\w* todo \w lo|strong="H1697"\w* bueno \w que|strong="H5921"\w* hizo, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* visiones \w del|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 33 Cuando Ezequías murió, \w lo|strong="H6213"\w* enterraron \w en|strong="H5973"\w* \w la|strong="H3605"\w* parte \w más|strong="H3519"\w* alta \w de|strong="H8478"\w* las tumbas \w de|strong="H8478"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H8478"\w* \w David|strong="H1732"\w*. \w Todo|strong="H3605"\w* \w Judá|strong="H3063"\w* \w y|strong="H3519"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H8478"\w* Jerusalén \w le|strong="H5973"\w* rindieron grandes honores \w en|strong="H5973"\w* su funeral. \w Y|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Manasés|strong="H4519"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 33  
\p
\v 1 \w Manasés|strong="H4519"\w* tenía \w doce|strong="H8147"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* \w cincuenta|strong="H2572"\w* y \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* en Jerusalén.  
\v 2 Pero \w él|strong="H1121"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H6440"\w* Yahvé, siguiendo las horribles costumbres \w de|strong="H6440"\w* las \w naciones|strong="H1471"\w* \w que|strong="H1121"\w* Yahvé \w había|strong="H6213"\w* expulsado del territorio \w de|strong="H6440"\w* \w los|strong="H1121"\w* israelitas.  
\v 3 \w Volvió|strong="H7725"\w* \w a|strong="H3068"\w* reconstruir \w los|strong="H3605"\w* santuarios paganos \w que|strong="H3605"\w* su padre Ezequías \w había|strong="H6213"\w* destruido. \w Levantó|strong="H6965"\w* \w altares|strong="H4196"\w* para adorar \w a|strong="H3068"\w* \w los|strong="H3605"\w* baales, \w hizo|strong="H6213"\w* imágenes de \w la|strong="H3605"\w* diosa Asera, y \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* astros \w del|strong="H4196"\w* \w cielo|strong="H8064"\w* y les rindió culto.  
\v 4 Incluso construyó \w altares|strong="H4196"\w* paganos dentro \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de Yahvé, el mismo lugar \w del|strong="H4196"\w* \w que|strong="H1961"\w* Yahvé \w había|strong="H1961"\w* dicho: “\w Mi|strong="H3389"\w* \w nombre|strong="H8034"\w* \w estará|strong="H1961"\w* en Jerusalén \w para|strong="H1961"\w* \w siempre|strong="H5769"\w*”.  
\v 5 En \w los|strong="H3605"\w* \w dos|strong="H8147"\w* \w patios|strong="H2691"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de Yahvé, Manasés construyó \w altares|strong="H4196"\w* para adorar \w a|strong="H3068"\w* \w los|strong="H3605"\w* astros \w del|strong="H4196"\w* \w cielo|strong="H8064"\w*.  
\v 6 \w Hasta|strong="H1931"\w* sacrificó \w a|strong="H3068"\w* \w sus|strong="H1931"\w* propios \w hijos|strong="H1121"\w* quemándolos en \w el|strong="H1931"\w* fuego en \w el|strong="H1931"\w* \w valle|strong="H1516"\w* \w de|strong="H1121"\w* Ben Hinom. Practicó \w la|strong="H1931"\w* magia, \w la|strong="H1931"\w* adivinación y \w la|strong="H1931"\w* brujería, y consultó \w a|strong="H3068"\w* médiums y espiritistas. \w Hizo|strong="H6213"\w* tantas \w cosas|strong="H7451"\w* \w malas|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H1121"\w* Yahvé, \w que|strong="H1931"\w* provocó \w su|strong="H1931"\w* enojo.  
\v 7 Además, mandó \w hacer|strong="H6213"\w* una \w imagen|strong="H6459"\w* tallada \w de|strong="H1121"\w* un ídolo y \w la|strong="H3605"\w* \w puso|strong="H7760"\w* dentro del \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Dios, \w el|strong="H3605"\w* \w mismo|strong="H3605"\w* lugar del \w que|strong="H1121"\w* Dios les \w había|strong="H6213"\w* dicho \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*: “En \w este|strong="H2088"\w* \w templo|strong="H1004"\w* y en Jerusalén, \w la|strong="H3605"\w* ciudad \w que|strong="H1121"\w* he elegido \w de|strong="H1121"\w* entre \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w pondré|strong="H7760"\w* \w mi|strong="H3389"\w* \w nombre|strong="H8034"\w* para \w siempre|strong="H3605"\w*.  
\v 8 \w Y|strong="H3068"\w* \w nunca|strong="H3808"\w* \w más|strong="H3254"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* expulsar \w a|strong="H3068"\w* \w los|strong="H5921"\w* israelitas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H3808"\w* \w les|strong="H5921"\w* di \w a|strong="H3068"\w* sus antepasados, \w siempre|strong="H3605"\w* \w y|strong="H5921"\w* cuando obedezcan \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w les|strong="H5921"\w* he \w mandado|strong="H6680"\w*, \w es|strong="H3027"\w* decir, \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w*, \w las|strong="H5921"\w* normas \w y|strong="H5921"\w* \w los|strong="H5921"\w* decretos \w que|strong="H3808"\w* \w les|strong="H5921"\w* di \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*”.  
\v 9 Pero \w Manasés|strong="H4519"\w* desvió \w a|strong="H3068"\w* la \w gente|strong="H1471"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* y \w de|strong="H4480"\w* Jerusalén, y \w los|strong="H3427"\w* \w hizo|strong="H6213"\w* cometer peores pecados \w que|strong="H4480"\w* las \w naciones|strong="H1471"\w* paganas \w que|strong="H4480"\w* Yahvé \w había|strong="H6213"\w* destruido \w para|strong="H4480"\w* darles la tierra \w a|strong="H3068"\w* \w los|strong="H3427"\w* israelitas.   
\p
\v 10 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Manasés|strong="H4519"\w* y \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w*, pero ellos \w no|strong="H3808"\w* le hicieron caso.  
\v 11 \w Por|strong="H5921"\w* eso, Yahvé hizo \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w ejército|strong="H6635"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria \w los|strong="H5921"\w* atacara. \w Los|strong="H5921"\w* comandantes asirios capturaron \w a|strong="H3068"\w* \w Manasés|strong="H4519"\w*, \w le|strong="H5921"\w* pusieron garfios, \w lo|strong="H5921"\w* amarraron \w con|strong="H5921"\w* cadenas \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* llevaron prisionero \w a|strong="H3068"\w* Babilonia.   
\p
\v 12 Estando allí, en medio \w de|strong="H6440"\w* su \w gran|strong="H3966"\w* sufrimiento, Manasés le rogó \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w* y se humilló profundamente \w ante|strong="H6440"\w* el \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* sus antepasados.  
\v 13 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w oró|strong="H6419"\w*, \w Dios|strong="H3068"\w* \w se|strong="H3045"\w* conmovió, \w escuchó|strong="H8085"\w* \w su|strong="H1931"\w* \w súplica|strong="H8467"\w* \w y|strong="H3588"\w* \w lo|strong="H1931"\w* hizo regresar \w a|strong="H3068"\w* Jerusalén \w para|strong="H3588"\w* \w que|strong="H3588"\w* volviera \w a|strong="H3068"\w* reinar. \w Entonces|strong="H3588"\w* \w Manasés|strong="H4519"\w* \w reconoció|strong="H3045"\w* \w que|strong="H3588"\w* Yahvé \w es|strong="H1931"\w* \w el|strong="H1931"\w* verdadero \w Dios|strong="H3068"\w*.   
\p
\v 14 Después \w de|strong="H8269"\w* \w esto|strong="H3651"\w*, Manasés reconstruyó \w la|strong="H3605"\w* muralla \w exterior|strong="H2435"\w* \w de|strong="H8269"\w* \w la|strong="H3605"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H8269"\w* \w David|strong="H1732"\w*. \w La|strong="H3605"\w* muralla iba \w por|strong="H3651"\w* \w el|strong="H3605"\w* valle, al oeste del manantial \w de|strong="H8269"\w* Gihón, hasta \w la|strong="H3605"\w* entrada \w de|strong="H8269"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del \w Pescado|strong="H1709"\w*, y rodeaba \w la|strong="H3605"\w* colina \w de|strong="H8269"\w* Ofel. Manasés \w la|strong="H3605"\w* \w hizo|strong="H1129"\w* \w mucho|strong="H3966"\w* más alta y \w puso|strong="H7760"\w* comandantes militares en \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*.  
\v 15 También \w quitó|strong="H5493"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de Yahvé \w los|strong="H3605"\w* dioses extranjeros y \w el|strong="H3605"\w* ídolo \w que|strong="H3605"\w* había puesto allí, destruyó \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w altares|strong="H4196"\w* paganos \w que|strong="H3605"\w* había construido \w en|strong="H5493"\w* \w el|strong="H3605"\w* \w monte|strong="H2022"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w* y \w en|strong="H5493"\w* Jerusalén, y \w los|strong="H3605"\w* tiró \w fuera|strong="H2351"\w* de \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*.  
\v 16 Luego reparó \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w ofreció|strong="H2076"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w sacrificios|strong="H2077"\w* \w de|strong="H5921"\w* paz \w y|strong="H5921"\w* ofrendas \w de|strong="H5921"\w* agradecimiento, \w y|strong="H5921"\w* \w le|strong="H5921"\w* ordenó \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w que|strong="H5921"\w* sirviera \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 17 \w A|strong="H3068"\w* pesar \w de|strong="H5750"\w* esto, el \w pueblo|strong="H5971"\w* seguía \w ofreciendo|strong="H2076"\w* \w sacrificios|strong="H2076"\w* \w en|strong="H5750"\w* los santuarios \w de|strong="H5750"\w* las colinas, \w aunque|strong="H7535"\w* \w solo|strong="H7535"\w* \w se|strong="H5971"\w* los ofrecían \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*.   
\p
\v 18 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* \w Manasés|strong="H4519"\w*, incluyendo \w la|strong="H5921"\w* \w oración|strong="H8605"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* hizo \w a|strong="H3068"\w* \w Dios|strong="H3068"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* mensajes \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w videntes|strong="H2374"\w* \w le|strong="H5921"\w* dieron \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w está|strong="H5921"\w* escrito \w en|strong="H5921"\w* \w los|strong="H5921"\w* registros \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 19 Su \w oración|strong="H8605"\w*, \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* Dios \w lo|strong="H1697"\w* escuchó; \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w que|strong="H5921"\w* \w cometió|strong="H4604"\w* cuando \w le|strong="H5921"\w* fue infiel \w a|strong="H3068"\w* Dios; \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w lugares|strong="H4725"\w* \w donde|strong="H5921"\w* construyó santuarios paganos \w y|strong="H5921"\w* \w puso|strong="H5975"\w* imágenes \w de|strong="H5921"\w* Asera \w y|strong="H5921"\w* otros \w ídolos|strong="H6456"\w* \w antes|strong="H6440"\w* \w de|strong="H5921"\w* arrepentirse, \w todo|strong="H3605"\w* eso \w está|strong="H5975"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* registros \w de|strong="H5921"\w* \w los|strong="H5921"\w* videntes.\f + \fr 33:19 \ft o, de Hozai.\f*  
\v 20 Cuando \w Manasés|strong="H4519"\w* murió, lo enterraron \w en|strong="H5973"\w* \w el|strong="H5973"\w* jardín \w de|strong="H8478"\w* su propio palacio, y su \w hijo|strong="H1121"\w* Amón \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 21 Amón tenía \w veintidós|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén durante \w dos|strong="H8147"\w* \w años|strong="H8141"\w*.  
\v 22 Amón \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, igual \w que|strong="H3605"\w* su padre \w Manasés|strong="H4519"\w*. Adoró y les \w ofreció|strong="H2076"\w* \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ídolos|strong="H6456"\w* \w que|strong="H3605"\w* su padre \w había|strong="H6213"\w* mandado \w hacer|strong="H6213"\w*.  
\v 23 \w Pero|strong="H3588"\w* \w a|strong="H3068"\w* diferencia \w de|strong="H3588"\w* \w su|strong="H1931"\w* padre \w Manasés|strong="H4519"\w*, Amón \w nunca|strong="H3808"\w* \w se|strong="H1931"\w* humilló \w ante|strong="H6440"\w* Yahvé, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* pecó cada vez \w más|strong="H3588"\w*.  
\v 24 Finalmente, sus propios funcionarios hicieron un complot \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* asesinaron \w en|strong="H5921"\w* su palacio.  
\v 25 Pero \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* Judá \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* habían conspirado \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Amón, \w y|strong="H5921"\w* luego pusieron \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Josías|strong="H2977"\w*.   
\c 34  
\p
\v 1 \w Josías|strong="H2977"\w* tenía apenas \w ocho|strong="H8083"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén durante \w treinta|strong="H7970"\w* y un \w años|strong="H8141"\w*.  
\v 2 \w Él|strong="H6213"\w* \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era agradable \w a|strong="H3068"\w* los \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé. \w Siguió|strong="H3212"\w* \w el|strong="H6213"\w* buen ejemplo \w de|strong="H5869"\w* su antepasado \w David|strong="H1732"\w*, y \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* desvió \w ni|strong="H3808"\w* \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*.  
\v 3 \w En|strong="H4480"\w* \w el|strong="H1931"\w* octavo \w año|strong="H8141"\w* \w de|strong="H4480"\w* \w su|strong="H1931"\w* \w reinado|strong="H4427"\w*, cuando \w todavía|strong="H5750"\w* \w era|strong="H8141"\w* un \w muchacho|strong="H5288"\w*, Josías \w empezó|strong="H2490"\w* \w a|strong="H3068"\w* buscar \w al|strong="H4480"\w* Dios \w de|strong="H4480"\w* \w su|strong="H1931"\w* antepasado \w David|strong="H1732"\w*. \w Y|strong="H3068"\w* \w en|strong="H4480"\w* \w el|strong="H1931"\w* \w año|strong="H8141"\w* \w doce|strong="H8147"\w*, \w comenzó|strong="H2490"\w* \w a|strong="H3068"\w* limpiar \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* y \w a|strong="H3068"\w* Jerusalén \w de|strong="H4480"\w* \w los|strong="H1931"\w* santuarios paganos, \w de|strong="H4480"\w* las \w imágenes|strong="H4541"\w* \w de|strong="H4480"\w* Asera y \w de|strong="H4480"\w* \w todos|strong="H8141"\w* \w los|strong="H1931"\w* \w ídolos|strong="H6456"\w* \w de|strong="H4480"\w* madera y \w de|strong="H4480"\w* metal.  
\v 4 \w En|strong="H5921"\w* su \w presencia|strong="H6440"\w*, \w el|strong="H5921"\w* pueblo \w derribó|strong="H5422"\w* \w los|strong="H5921"\w* \w altares|strong="H4196"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* baales, \w y|strong="H5921"\w* \w él|strong="H5921"\w* mismo mandó destruir \w los|strong="H5921"\w* \w altares|strong="H4196"\w* \w de|strong="H5921"\w* incienso \w que|strong="H5921"\w* estaban \w en|strong="H5921"\w* \w lo|strong="H5921"\w* \w alto|strong="H4605"\w*. Hizo pedazos \w las|strong="H5921"\w* \w imágenes|strong="H4541"\w* \w de|strong="H5921"\w* Asera \w y|strong="H5921"\w* todos \w los|strong="H5921"\w* demás \w ídolos|strong="H6456"\w*, \w los|strong="H5921"\w* hizo polvo \w y|strong="H5921"\w* \w los|strong="H5921"\w* esparció \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* tumbas \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* habían ofrecido \w sacrificios|strong="H2076"\w*.  
\v 5 También \w quemó|strong="H8313"\w* \w los|strong="H5921"\w* \w huesos|strong="H6106"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* paganos \w sobre|strong="H5921"\w* sus propios \w altares|strong="H4196"\w*. Así \w fue|strong="H3063"\w* \w como|strong="H5921"\w* purificó \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* Jerusalén.  
\v 6 Hizo \w lo|strong="H5704"\w* mismo \w en|strong="H5704"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5704"\w* las tribus \w de|strong="H5704"\w* \w Manasés|strong="H4519"\w*, Efraín, \w Simeón|strong="H8095"\w*, \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w en|strong="H5704"\w* Neftalí, \w y|strong="H5704"\w* \w en|strong="H5704"\w* las ruinas \w que|strong="H5704"\w* las rodeaban.  
\v 7 \w Destruyó|strong="H5422"\w* \w los|strong="H3605"\w* \w altares|strong="H4196"\w* paganos, hizo polvo las imágenes de Asera y \w los|strong="H3605"\w* \w ídolos|strong="H6456"\w*, y \w derribó|strong="H5422"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w altares|strong="H4196"\w* de incienso en \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de \w Israel|strong="H3478"\w*. Después de hacer \w todo|strong="H3605"\w* esto, regresó \w a|strong="H3068"\w* Jerusalén.   
\p
\v 8 En \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* \w de|strong="H1121"\w* su \w reinado|strong="H4427"\w*, después \w de|strong="H1121"\w* haber purificado \w el|strong="H1121"\w* país y \w el|strong="H1121"\w* \w templo|strong="H1004"\w*, Josías \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Safán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Azalía, al \w gobernador|strong="H8269"\w* \w de|strong="H1121"\w* la \w ciudad|strong="H5892"\w*, \w Maasías|strong="H4641"\w*, y al secretario del \w rey|strong="H4427"\w*, Joa \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joacaz, para \w que|strong="H1121"\w* repararan \w el|strong="H1121"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé su \w Dios|strong="H3068"\w*.  
\v 9 \w Ellos|strong="H3027"\w* fueron \w a|strong="H3068"\w* ver al \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* y le entregaron \w el|strong="H3605"\w* \w dinero|strong="H3701"\w* \w que|strong="H3605"\w* \w la|strong="H8104"\w* gente había depositado en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Dios. \w Los|strong="H3427"\w* \w levitas|strong="H3881"\w* \w que|strong="H3605"\w* cuidaban las puertas habían recolectado ese \w dinero|strong="H3701"\w* \w de|strong="H5414"\w* \w la|strong="H8104"\w* gente \w de|strong="H5414"\w* \w Manasés|strong="H4519"\w*, Efraín y del \w resto|strong="H7611"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*, así como \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w*, \w Benjamín|strong="H1144"\w* y \w de|strong="H5414"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5414"\w* Jerusalén.  
\v 10 \w El|strong="H5921"\w* dinero \w se|strong="H5921"\w* \w lo|strong="H5921"\w* entregaron \w a|strong="H3068"\w* \w los|strong="H5921"\w* supervisores encargados \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w ellos|strong="H3027"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* pagaron \w a|strong="H3068"\w* \w los|strong="H5921"\w* obreros \w que|strong="H5921"\w* estaban reparando \w y|strong="H5921"\w* restaurando \w el|strong="H5921"\w* \w edificio|strong="H1004"\w*.  
\v 11 \w También|strong="H7843"\w* les \w dieron|strong="H5414"\w* dinero \w a|strong="H3068"\w* los \w carpinteros|strong="H2796"\w* y constructores \w para|strong="H5414"\w* que \w compraran|strong="H7069"\w* piedras labradas y \w madera|strong="H6086"\w* \w para|strong="H5414"\w* las uniones y las vigas \w de|strong="H5414"\w* los edificios que los \w reyes|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* habían dejado en ruinas.  
\v 12 \w Los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w hicieron|strong="H6213"\w* su trabajo \w con|strong="H5921"\w* mucha honestidad. Sus supervisores eran \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* Jahat \w y|strong="H5921"\w* \w Abdías|strong="H5662"\w*, descendientes \w de|strong="H4480"\w* \w Merari|strong="H4847"\w*; \w y|strong="H5921"\w* \w Zacarías|strong="H2148"\w* \w y|strong="H5921"\w* Mesulam, descendientes \w de|strong="H4480"\w* Coat. \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* \w levitas|strong="H3881"\w* eran expertos músicos.  
\v 13 \w Ellos|strong="H5921"\w* también supervisaban \w a|strong="H3068"\w* \w los|strong="H5921"\w* cargadores \w y|strong="H5921"\w* dirigían \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* trabajadores \w en|strong="H5921"\w* sus distintas tareas. \w Además|strong="H5921"\w*, \w había|strong="H6213"\w* \w levitas|strong="H3881"\w* \w que|strong="H5921"\w* \w trabajaban|strong="H6213"\w* \w como|strong="H5921"\w* secretarios, \w oficiales|strong="H7860"\w* \w y|strong="H5921"\w* \w porteros|strong="H7778"\w*.   
\p
\v 14 Mientras \w sacaban|strong="H3318"\w* el \w dinero|strong="H3701"\w* \w que|strong="H3027"\w* se \w había|strong="H4672"\w* guardado \w en|strong="H3318"\w* el \w templo|strong="H1004"\w* de Yahvé, el \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* encontró el \w libro|strong="H5612"\w* de la \w ley|strong="H8451"\w* de Yahvé, la misma \w ley|strong="H8451"\w* \w que|strong="H3027"\w* \w Dios|strong="H3068"\w* \w había|strong="H4672"\w* dado \w por|strong="H3027"\w* \w medio|strong="H3027"\w* de \w Moisés|strong="H4872"\w*.  
\v 15 \w Hilcías|strong="H2518"\w* le dijo al \w secretario|strong="H5608"\w* Safán: “¡Mira, encontré el \w libro|strong="H5612"\w* \w de|strong="H5414"\w* la \w ley|strong="H8451"\w* aquí en el \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé!” \w Y|strong="H3068"\w* se \w lo|strong="H5612"\w* \w entregó|strong="H5414"\w*.   
\p
\v 16 Safán le llevó \w el|strong="H3605"\w* \w libro|strong="H5612"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y le \w dio|strong="H5414"\w* \w su|strong="H1992"\w* reporte: “Majestad, \w sus|strong="H1992"\w* \w siervos|strong="H5650"\w* están cumpliendo con \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w se|strong="H1992"\w* \w les|strong="H1992"\w* ordenó.  
\v 17 \w Ya|strong="H3068"\w* sacaron \w el|strong="H5921"\w* \w dinero|strong="H3701"\w* \w que|strong="H5921"\w* \w estaba|strong="H1004"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* entregaron \w a|strong="H3068"\w* \w los|strong="H5921"\w* supervisores \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* trabajadores”.  
\v 18 Luego, el \w secretario|strong="H5608"\w* Safán añadió: “Además, el \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* me \w entregó|strong="H5414"\w* este \w libro|strong="H5612"\w*”. \w Y|strong="H3068"\w* Safán empezó \w a|strong="H3068"\w* leérselo \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.   
\p
\v 19 \w Cuando|strong="H1961"\w* el \w rey|strong="H4428"\w* \w escuchó|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* la \w ley|strong="H8451"\w*, \w se|strong="H1961"\w* \w rasgó|strong="H7167"\w* la ropa en señal \w de|strong="H1697"\w* dolor.  
\v 20 Inmediatamente \w mandó|strong="H6680"\w* llamar \w a|strong="H3068"\w* \w Hilcías|strong="H2518"\w*, \w a|strong="H3068"\w* Ahicam \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán, \w a|strong="H3068"\w* \w Abdón|strong="H5658"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Micaía, \w al|strong="H4428"\w* \w secretario|strong="H5608"\w* Safán y \w a|strong="H3068"\w* \w Asaías|strong="H6222"\w*, un oficial del \w rey|strong="H4428"\w*, y \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w*:  
\v 21 “\w Vayan|strong="H3212"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* gente \w en|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w para|strong="H5921"\w* saber \w qué|strong="H3588"\w* debemos \w hacer|strong="H6213"\w* \w con|strong="H5921"\w* respecto \w a|strong="H3068"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w dice|strong="H1697"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w* \w que|strong="H3588"\w* encontraron. ¡\w El|strong="H5921"\w* terrible \w enojo|strong="H2534"\w* \w de|strong="H5921"\w* Yahvé \w ha|strong="H3808"\w* caído \w sobre|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w porque|strong="H3588"\w* nuestros antepasados \w no|strong="H3808"\w* obedecieron \w su|strong="H3588"\w* \w palabra|strong="H1697"\w* \w ni|strong="H3808"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w*!”   
\p
\v 22 Entonces \w Hilcías|strong="H2518"\w* y \w los|strong="H3427"\w* \w hombres|strong="H1121"\w* enviados \w por|strong="H4428"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w profetisa|strong="H5031"\w* Hulda. \w Ella|strong="H1931"\w* \w estaba|strong="H3427"\w* casada con Salum \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Tocate y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Hasra, \w quien|strong="H1931"\w* \w era|strong="H1931"\w* \w el|strong="H1931"\w* encargado \w de|strong="H1121"\w* \w la|strong="H1931"\w* ropa del templo. Hulda \w vivía|strong="H3427"\w* \w en|strong="H3212"\w* Jerusalén, \w en|strong="H3212"\w* \w el|strong="H1931"\w* Barrio Nuevo. Cuando \w le|strong="H1931"\w* explicaron \w a|strong="H3068"\w* \w qué|strong="H1931"\w* \w iban|strong="H3212"\w*,   
\p
\v 23 ella les dijo: “\w Esto|strong="H3541"\w* dice Yahvé, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: Vayan \w y|strong="H3541"\w* díganle al hombre \w que|strong="H3541"\w* los \w envió|strong="H7971"\w*:  
\v 24 ‘\w Así|strong="H3541"\w* dice Yahvé: Voy \w a|strong="H3068"\w* traer un desastre \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* sus \w habitantes|strong="H3427"\w*. Cumpliré \w todas|strong="H3605"\w* \w las|strong="H5921"\w* maldiciones \w que|strong="H5921"\w* \w están|strong="H3427"\w* \w escritas|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* acaban \w de|strong="H5921"\w* \w leer|strong="H5612"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 25 \w Porque|strong="H3808"\w* me han abandonado y han quemado incienso \w a|strong="H3068"\w* otros dioses; me han provocado \w a|strong="H3068"\w* \w ira|strong="H2534"\w* con \w todas|strong="H3605"\w* las cosas malas \w que|strong="H3808"\w* han \w hecho|strong="H4639"\w*. \w Por|strong="H8478"\w* eso, mi \w enojo|strong="H2534"\w* caerá sobre \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* y \w nada|strong="H3808"\w* \w podrá|strong="H3808"\w* apagarlo’.  
\v 26 Pero \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, \w que|strong="H1697"\w* los \w envió|strong="H7971"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé, díganle \w esto|strong="H1697"\w*: ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*: En cuanto \w a|strong="H3068"\w* las \w cosas|strong="H1697"\w* \w que|strong="H1697"\w* escuchaste,  
\v 27 \w porque|strong="H5921"\w* tu \w corazón|strong="H3824"\w* \w se|strong="H5921"\w* conmovió \w y|strong="H1571"\w* \w te|strong="H5921"\w* humillaste \w ante|strong="H6440"\w* \w Dios|strong="H3068"\w* \w al|strong="H5921"\w* \w escuchar|strong="H8085"\w* sus advertencias \w contra|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w y|strong="H1571"\w* \w contra|strong="H5921"\w* sus \w habitantes|strong="H3427"\w*; \w y|strong="H1571"\w* \w porque|strong="H5921"\w* \w te|strong="H5921"\w* humillaste \w ante|strong="H6440"\w* \w mí|strong="H5921"\w*, \w te|strong="H5921"\w* rasgaste \w la|strong="H5921"\w* ropa \w y|strong="H1571"\w* lloraste \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*, yo \w también|strong="H1571"\w* \w te|strong="H5921"\w* he escuchado, \w dice|strong="H5002"\w* Yahvé.  
\v 28 \w Por|strong="H5921"\w* eso, dejaré \w que|strong="H3808"\w* mueras \w en|strong="H5921"\w* \w paz|strong="H7965"\w* \w y|strong="H5921"\w* seas enterrado \w con|strong="H5921"\w* tus antepasados. Tus \w ojos|strong="H5869"\w* \w no|strong="H3808"\w* \w verán|strong="H7200"\w* \w el|strong="H5921"\w* terrible desastre \w que|strong="H3808"\w* voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* sus \w habitantes|strong="H3427"\w*’”.  
\p \w Los|strong="H3427"\w* hombres regresaron \w y|strong="H5921"\w* \w le|strong="H5921"\w* entregaron \w el|strong="H5921"\w* mensaje \w al|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\p
\v 29 Entonces \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w mandó|strong="H7971"\w* convocar \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes de \w Judá|strong="H3063"\w* y de Jerusalén.  
\v 30 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w subió|strong="H5927"\w* \w al|strong="H5704"\w* \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé acompañado \w por|strong="H1697"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* \w y|strong="H5704"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5704"\w* Jerusalén, incluyendo \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w levitas|strong="H3881"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* importante \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* menos importante. Allí, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* les \w leyó|strong="H7121"\w* \w en|strong="H5704"\w* \w voz|strong="H1419"\w* \w alta|strong="H1419"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5704"\w* decía \w el|strong="H3605"\w* \w libro|strong="H5612"\w* del \w pacto|strong="H1285"\w* \w que|strong="H5704"\w* habían encontrado \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé.  
\v 31 \w Después|strong="H5921"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w puso|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w en|strong="H5921"\w* su lugar \w de|strong="H5921"\w* honor \w y|strong="H5921"\w* allí \w mismo|strong="H3605"\w* \w hizo|strong="H6213"\w* un \w pacto|strong="H1285"\w* \w ante|strong="H6440"\w* Yahvé, prometiendo seguir \w a|strong="H3068"\w* Yahvé \w y|strong="H5921"\w* obedecer sus \w mandamientos|strong="H4687"\w*, sus normas \w y|strong="H5921"\w* sus decretos \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w toda|strong="H3605"\w* \w el|strong="H5921"\w* \w alma|strong="H5315"\w*. Prometió cumplir \w con|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* condiciones \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w escritas|strong="H3789"\w* \w en|strong="H5921"\w* \w ese|strong="H2088"\w* \w libro|strong="H5612"\w*.  
\v 32 Luego \w hizo|strong="H6213"\w* \w que|strong="H3605"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H3605"\w* \w estaban|strong="H5975"\w* allí, \w la|strong="H3605"\w* gente de Jerusalén y de \w Benjamín|strong="H1144"\w*, se comprometieran \w a|strong="H3068"\w* cumplir \w el|strong="H3605"\w* \w pacto|strong="H1285"\w*. \w Y|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén obedecieron \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* de Dios, \w el|strong="H3605"\w* Dios de sus antepasados.  
\v 33 \w Josías|strong="H2977"\w* \w quitó|strong="H5493"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* ídolos repugnantes \w de|strong="H1121"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* territorios \w que|strong="H3808"\w* pertenecían \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, \w e|strong="H3068"\w* hizo \w que|strong="H3808"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H3808"\w* vivían \w en|strong="H5493"\w* \w Israel|strong="H3478"\w* sirvieran \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*. \w Mientras|strong="H3605"\w* \w Josías|strong="H2977"\w* \w vivió|strong="H3117"\w*, \w el|strong="H3605"\w* pueblo \w nunca|strong="H3808"\w* dejó \w de|strong="H1121"\w* seguir \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* sus antepasados.   
\c 35  
\p
\v 1 \w Josías|strong="H2977"\w* celebró la \w Pascua|strong="H6453"\w* en honor \w a|strong="H3068"\w* Yahvé en Jerusalén. Sacrificaron \w el|strong="H6213"\w* cordero de la \w Pascua|strong="H6453"\w* \w el|strong="H6213"\w* día catorce del \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*.  
\v 2 Josías asignó \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w a|strong="H3068"\w* sus \w turnos|strong="H4931"\w* \w de|strong="H5921"\w* servicio \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w animó|strong="H2388"\w* \w a|strong="H3068"\w* cumplir bien \w con|strong="H5921"\w* su trabajo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 3 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*, \w que|strong="H6258"\w* eran \w los|strong="H1121"\w* encargados \w de|strong="H1121"\w* instruir \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* y \w que|strong="H6258"\w* \w estaban|strong="H5971"\w* consagrados \w a|strong="H3068"\w* Yahvé, les dijo: “Pongan \w el|strong="H3605"\w* arca sagrada dentro del \w templo|strong="H1004"\w* \w que|strong="H6258"\w* construyó \w Salomón|strong="H8010"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. \w Ya|strong="H3068"\w* no tendrán \w que|strong="H6258"\w* cargarla sobre sus \w hombros|strong="H3802"\w*. \w Ahora|strong="H6258"\w* dedíquense \w a|strong="H3068"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w* y \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.  
\v 4 Organícense \w por|strong="H4428"\w* \w familias|strong="H1004"\w* y \w por|strong="H4428"\w* turnos, \w de|strong="H1121"\w* acuerdo con las instrucciones escritas \w por|strong="H4428"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w por|strong="H4428"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*.  
\v 5 Tomen sus lugares \w en|strong="H5975"\w* \w el|strong="H1121"\w* \w santuario|strong="H6944"\w* \w para|strong="H5971"\w* ayudar \w a|strong="H3068"\w* sus parientes, la \w gente|strong="H5971"\w* del \w pueblo|strong="H5971"\w*. \w Que|strong="H5971"\w* cada grupo \w de|strong="H1121"\w* \w familias|strong="H1004"\w* del \w pueblo|strong="H5971"\w* tenga un grupo \w de|strong="H1121"\w* \w levitas|strong="H3881"\w* \w que|strong="H5971"\w* les ayude.  
\v 6 Sacrifiquen \w el|strong="H6213"\w* cordero \w de|strong="H1697"\w* la \w Pascua|strong="H6453"\w*, purifíquense ustedes mismos y preparen todo para \w que|strong="H1697"\w* sus hermanos puedan \w celebrar|strong="H6213"\w* la \w Pascua|strong="H6453"\w*, cumpliendo con \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé ordenó \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H1697"\w* \w Moisés|strong="H4872"\w*”.   
\p
\v 7 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w* le regaló \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* del \w pueblo|strong="H5971"\w* \w treinta|strong="H7970"\w* mil \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w cabras|strong="H5795"\w*, \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w todos|strong="H3605"\w* tuvieran un \w cordero|strong="H3532"\w* \w o|strong="H3068"\w* un cabrito \w para|strong="H5971"\w* \w el|strong="H3605"\w* sacrificio \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w*, además \w de|strong="H1121"\w* \w tres|strong="H7969"\w* mil toros. \w Todo|strong="H3605"\w* esto salió del \w ganado|strong="H6629"\w* del \w rey|strong="H4428"\w*.  
\v 8 Sus funcionarios también \w hicieron|strong="H5414"\w* donaciones \w voluntarias|strong="H5071"\w* \w para|strong="H5414"\w* el \w pueblo|strong="H5971"\w*, \w para|strong="H5414"\w* los \w sacerdotes|strong="H3548"\w* \w y|strong="H1241"\w* \w para|strong="H5414"\w* los \w levitas|strong="H3881"\w*. \w Hilcías|strong="H2518"\w*, \w Zacarías|strong="H2148"\w* \w y|strong="H1241"\w* \w Jehiel|strong="H3171"\w*, \w que|strong="H5971"\w* eran los \w principales|strong="H8269"\w* administradores del \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Dios, les regalaron \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* dos \w mil|strong="H3967"\w* \w seiscientos|strong="H8337"\w* corderos \w y|strong="H1241"\w* cabritos, \w y|strong="H1241"\w* \w trescientos|strong="H7969"\w* toros \w para|strong="H5414"\w* la \w Pascua|strong="H6453"\w*.  
\v 9 \w De|strong="H2568"\w* igual manera, los líderes \w de|strong="H2568"\w* los \w levitas|strong="H3881"\w* —Conanías, junto con sus hermanos \w Semaías|strong="H8098"\w* \w y|strong="H1241"\w* Natanael, además \w de|strong="H2568"\w* \w Hasabías|strong="H2811"\w*, \w Jeiel|strong="H3273"\w* \w y|strong="H1241"\w* \w Jozabad|strong="H3107"\w*— les regalaron \w a|strong="H3068"\w* los demás \w levitas|strong="H3881"\w* \w cinco|strong="H2568"\w* \w mil|strong="H3967"\w* corderos \w y|strong="H1241"\w* cabritos, \w y|strong="H1241"\w* \w quinientos|strong="H2568"\w* toros para la \w Pascua|strong="H6453"\w*.   
\p
\v 10 Cuando todo \w estuvo|strong="H5975"\w* listo \w para|strong="H5921"\w* \w el|strong="H5921"\w* servicio, \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* tomaron sus posiciones \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w se|strong="H5921"\w* acomodaron \w según|strong="H5921"\w* sus turnos, tal \w como|strong="H5921"\w* \w lo|strong="H5921"\w* \w había|strong="H5975"\w* ordenado \w el|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 11 Entonces sacrificaron los corderos de la \w Pascua|strong="H6453"\w*. Los \w sacerdotes|strong="H3548"\w* rociaban la sangre \w que|strong="H3027"\w* los \w levitas|strong="H3881"\w* les pasaban, mientras otros \w levitas|strong="H3881"\w* les quitaban la piel \w a|strong="H3068"\w* los animales.  
\v 12 \w Luego|strong="H3651"\w*, separaron las partes \w que|strong="H5971"\w* eran \w para|strong="H5414"\w* \w los|strong="H1121"\w* \w holocaustos|strong="H5930"\w*, \w para|strong="H5414"\w* entregárselas \w a|strong="H3068"\w* las \w familias|strong="H1004"\w* del \w pueblo|strong="H5971"\w* \w y|strong="H1241"\w* \w que|strong="H5971"\w* ellos las ofrecieran \w a|strong="H3068"\w* Yahvé, \w como|strong="H3651"\w* \w está|strong="H3651"\w* \w escrito|strong="H3789"\w* \w en|strong="H5493"\w* \w el|strong="H1121"\w* \w libro|strong="H5612"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*. \w Y|strong="H3068"\w* \w lo|strong="H5612"\w* mismo \w hicieron|strong="H5414"\w* con \w los|strong="H1121"\w* toros.  
\v 13 Asaron \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w* al fuego, \w de|strong="H1121"\w* acuerdo con \w la|strong="H3605"\w* ley, pero las ofrendas \w sagradas|strong="H6944"\w* las cocinaron en ollas, \w calderos|strong="H5518"\w* y sartenes, y \w se|strong="H5971"\w* las repartieron rápidamente \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* del \w pueblo|strong="H5971"\w*.  
\v 14 \w Después|strong="H5704"\w* \w de|strong="H3588"\w* servir \w al|strong="H5704"\w* \w pueblo|strong="H1992"\w*, \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* prepararon \w su|strong="H1992"\w* propia porción \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w*. Tuvieron \w que|strong="H3588"\w* hacerlo \w así|strong="H3588"\w* \w porque|strong="H3588"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w*, descendientes \w de|strong="H3588"\w* Aarón, estuvieron ocupados \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* \w noche|strong="H3915"\w* ofreciendo \w los|strong="H1992"\w* \w holocaustos|strong="H5930"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* grasa \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w animales|strong="H1121"\w*. \w Por|strong="H3588"\w* eso \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* tuvieron \w que|strong="H3588"\w* preparar \w la|strong="H3588"\w* comida \w para|strong="H5704"\w* \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* \w y|strong="H3588"\w* \w para|strong="H5704"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w*.  
\v 15 \w Los|strong="H1121"\w* músicos, descendientes \w de|strong="H5921"\w* Asaf, \w estaban|strong="H4612"\w* \w en|strong="H5921"\w* sus puestos, tal \w como|strong="H3588"\w* \w lo|strong="H5921"\w* habían ordenado \w David|strong="H1732"\w*, Asaf, \w Hemán|strong="H1968"\w* \w y|strong="H3588"\w* Jedutún, \w el|strong="H5921"\w* \w vidente|strong="H2374"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*. \w Los|strong="H1121"\w* \w porteros|strong="H7778"\w* vigilaban cada entrada. Ninguno \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* tuvo \w que|strong="H3588"\w* dejar \w su|strong="H3588"\w* \w puesto|strong="H3588"\w*, \w porque|strong="H3588"\w* sus compañeros \w levitas|strong="H3881"\w* \w les|strong="H5921"\w* prepararon \w y|strong="H3588"\w* llevaron \w su|strong="H3588"\w* porción \w de|strong="H5921"\w* \w la|strong="H5921"\w* Pascua.   
\p
\v 16 \w Así|strong="H1931"\w* \w que|strong="H1931"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* servicio \w para|strong="H5921"\w* Yahvé \w se|strong="H1931"\w* organizó perfectamente \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w para|strong="H5921"\w* \w celebrar|strong="H6213"\w* \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w* \w y|strong="H5921"\w* ofrecer \w los|strong="H5921"\w* \w holocaustos|strong="H5930"\w* \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Yahvé, tal \w como|strong="H5921"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w* \w lo|strong="H1931"\w* \w había|strong="H6213"\w* ordenado.  
\v 17 \w Los|strong="H1121"\w* israelitas \w que|strong="H1931"\w* estaban allí celebraron \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w* en \w esa|strong="H1931"\w* fecha, y continuaron con \w la|strong="H1931"\w* \w fiesta|strong="H2282"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* Panes sin Levadura durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 18 \w Nunca|strong="H3808"\w* antes, desde \w los|strong="H3427"\w* \w días|strong="H3117"\w* del \w profeta|strong="H5030"\w* \w Samuel|strong="H8050"\w*, \w se|strong="H3808"\w* \w había|strong="H4672"\w* celebrado en \w Israel|strong="H3478"\w* \w una|strong="H4672"\w* \w Pascua|strong="H6453"\w* \w como|strong="H3644"\w* \w esta|strong="H3427"\w*. \w Ningún|strong="H3605"\w* \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* \w había|strong="H4672"\w* celebrado \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w* de \w la|strong="H3605"\w* misma manera \w que|strong="H3808"\w* \w lo|strong="H3808"\w* \w hizo|strong="H6213"\w* \w Josías|strong="H2977"\w*, junto con \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w levitas|strong="H3881"\w*, \w la|strong="H3605"\w* gente de \w Judá|strong="H3063"\w* y de \w Israel|strong="H3478"\w* \w que|strong="H3808"\w* asistió, y \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén.  
\v 19 \w Esta|strong="H2088"\w* gran \w Pascua|strong="H6453"\w* se celebró en \w el|strong="H6213"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* del \w reinado|strong="H4438"\w* de \w Josías|strong="H2977"\w*.   
\p
\v 20 Un tiempo \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w Josías|strong="H2977"\w* había terminado \w de|strong="H5921"\w* restaurar \w el|strong="H5921"\w* \w templo|strong="H1004"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Necao \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* marchó \w con|strong="H5921"\w* su ejército \w para|strong="H5921"\w* pelear \w en|strong="H5921"\w* \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* Carquemis, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* río \w Éufrates|strong="H6578"\w*. \w Josías|strong="H2977"\w* \w salió|strong="H3318"\w* \w con|strong="H5921"\w* su ejército \w para|strong="H5921"\w* detenerlo,  
\v 21 \w pero|strong="H3588"\w* Necao \w le|strong="H5921"\w* \w envió|strong="H7971"\w* unos \w mensajeros|strong="H4397"\w* \w con|strong="H5973"\w* este mensaje: “¿\w Qué|strong="H3588"\w* problema hay \w entre|strong="H5921"\w* \w nosotros|strong="H5973"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*? \w Hoy|strong="H3117"\w* \w no|strong="H3808"\w* vengo \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, \w sino|strong="H3588"\w* \w contra|strong="H5921"\w* mis verdaderos enemigos. Dios \w me|strong="H5921"\w* \w ha|strong="H3808"\w* ordenado \w que|strong="H3588"\w* \w me|strong="H5921"\w* \w dé|strong="H5921"\w* prisa. \w Deja|strong="H7971"\w* \w de|strong="H5921"\w* oponerte \w a|strong="H3068"\w* Dios, \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* lado, \w no|strong="H3808"\w* vaya \w a|strong="H3068"\w* ser \w que|strong="H3588"\w* \w él|strong="H5921"\w* \w te|strong="H5921"\w* \w destruya|strong="H7843"\w*”.   
\p
\v 22 \w Pero|strong="H3588"\w* \w Josías|strong="H2977"\w* \w no|strong="H3808"\w* quiso retroceder. \w En|strong="H4480"\w* lugar \w de|strong="H4480"\w* eso, \w se|strong="H4480"\w* disfrazó \w para|strong="H3588"\w* entrar \w a|strong="H3068"\w* \w la|strong="H3588"\w* batalla. \w No|strong="H3808"\w* \w hizo|strong="H3898"\w* caso \w a|strong="H3068"\w* \w la|strong="H3588"\w* advertencia \w de|strong="H4480"\w* Necao, \w que|strong="H3588"\w* \w en|strong="H4480"\w* realidad venía \w de|strong="H4480"\w* Dios, \w y|strong="H3588"\w* \w se|strong="H4480"\w* \w fue|strong="H3808"\w* \w a|strong="H3068"\w* pelear \w al|strong="H4480"\w* valle \w de|strong="H4480"\w* Meguido.  
\v 23 Durante \w la|strong="H3588"\w* batalla, \w los|strong="H3588"\w* arqueros enemigos le dispararon \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w*. \w El|strong="H3588"\w* \w rey|strong="H4428"\w* les gritó \w a|strong="H3068"\w* sus hombres: “¡Sáquenme \w de|strong="H3588"\w* aquí, \w que|strong="H3588"\w* estoy \w muy|strong="H3966"\w* mal herido!”   
\p
\v 24 Sus oficiales \w lo|strong="H5921"\w* bajaron \w de|strong="H4480"\w* su \w carro|strong="H4818"\w* \w de|strong="H4480"\w* guerra, \w lo|strong="H5921"\w* subieron \w a|strong="H3068"\w* otro \w carro|strong="H4818"\w* \w que|strong="H4480"\w* \w traían|strong="H5921"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* llevaron \w a|strong="H3068"\w* Jerusalén, \w donde|strong="H5921"\w* \w murió|strong="H4191"\w*. \w Fue|strong="H3212"\w* \w enterrado|strong="H6912"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* tumbas \w de|strong="H4480"\w* sus antepasados, \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* gente \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* Jerusalén lloró muchísimo su \w muerte|strong="H4191"\w*.  
\v 25 \w El|strong="H5921"\w* profeta \w Jeremías|strong="H3414"\w* compuso un lamento \w en|strong="H5921"\w* memoria \w de|strong="H5921"\w* \w Josías|strong="H2977"\w*. \w Hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w cantores|strong="H7891"\w* \w y|strong="H5921"\w* cantoras recuerdan \w a|strong="H3068"\w* \w Josías|strong="H2977"\w* \w en|strong="H5921"\w* sus canciones fúnebres. \w Esta|strong="H5921"\w* práctica \w se|strong="H5921"\w* convirtió \w en|strong="H5921"\w* una tradición \w en|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* esas canciones están \w escritas|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* libro \w de|strong="H5921"\w* \w los|strong="H5921"\w* Lamentos.  
\v 26 El \w resto|strong="H3499"\w* \w de|strong="H1697"\w* la historia \w de|strong="H1697"\w* \w Josías|strong="H2977"\w* y \w de|strong="H1697"\w* todas sus buenas obras, hechas en obediencia \w a|strong="H3068"\w* la \w ley|strong="H8451"\w* \w de|strong="H1697"\w* Yahvé,  
\v 27 \w y|strong="H5921"\w* todo \w lo|strong="H1697"\w* \w que|strong="H5921"\w* hizo, \w desde|strong="H5921"\w* \w el|strong="H5921"\w* principio \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* fin, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\c 36  
\p
\v 1 Entonces la \w gente|strong="H5971"\w* del \w pueblo|strong="H5971"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* Joacaz, \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Josías|strong="H2977"\w*, y lo hicieron \w rey|strong="H4427"\w* \w en|strong="H8478"\w* Jerusalén \w para|strong="H5971"\w* \w que|strong="H5971"\w* ocupara \w el|strong="H1121"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su padre.  
\v 2 Joacaz tenía \w veintitrés|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* solo \w tres|strong="H7969"\w* \w meses|strong="H2320"\w* en Jerusalén.  
\v 3 El \w rey|strong="H4428"\w* de \w Egipto|strong="H4714"\w* lo \w quitó|strong="H5493"\w* del trono \w en|strong="H5493"\w* Jerusalén y le impuso \w a|strong="H3068"\w* Judá un tributo de más de tres toneladas de \w plata|strong="H3701"\w* y treinta y cuatro kilos\f + \fr 36:3 \ft Un talento son unos 30 kilogramos o 66 libras.\f* de \w oro|strong="H2091"\w*.  
\v 4 Luego, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* puso \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Jerusalén \w a|strong="H3068"\w* Eliaquim, hermano \w de|strong="H5921"\w* Joacaz, \w y|strong="H5921"\w* \w le|strong="H5921"\w* cambió \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w a|strong="H3068"\w* \w Joacim|strong="H3079"\w*. \w A|strong="H3068"\w* Joacaz, \w en|strong="H5921"\w* cambio, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Necao \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w llevó|strong="H3947"\w* prisionero \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*.   
\p
\v 5 \w Joacim|strong="H3079"\w* tenía \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén durante once \w años|strong="H8141"\w*. \w Él|strong="H1121"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H2568"\w* Yahvé su \w Dios|strong="H3068"\w*.  
\v 6 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Nabucodonosor|strong="H5019"\w* \w de|strong="H5921"\w* Babilonia marchó \w contra|strong="H5921"\w* \w él|strong="H5921"\w*, \w lo|strong="H5921"\w* amarró \w con|strong="H5921"\w* cadenas \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* llevó \w a|strong="H3068"\w* Babilonia.  
\v 7 \w Nabucodonosor|strong="H5019"\w* también se robó varios \w de|strong="H5414"\w* los objetos del \w templo|strong="H1964"\w* \w de|strong="H5414"\w* Yahvé y se los llevó \w para|strong="H5414"\w* ponerlos en su \w templo|strong="H1964"\w* en Babilonia.  
\v 8 \w El|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* historia \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w*, \w las|strong="H5921"\w* \w cosas|strong="H1697"\w* asquerosas \w que|strong="H5921"\w* \w hizo|strong="H6213"\w* \w y|strong="H5921"\w* todo \w lo|strong="H1697"\w* malo \w que|strong="H5921"\w* \w se|strong="H5921"\w* encontró \w en|strong="H5921"\w* \w él|strong="H5921"\w*, \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Y|strong="H3068"\w* su \w hijo|strong="H1121"\w* Joaquín \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 9 Joaquín tenía apenas \w ocho|strong="H8083"\w* \w años|strong="H8141"\w* \w cuando|strong="H3117"\w* comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén \w tres|strong="H7969"\w* \w meses|strong="H2320"\w* y \w diez|strong="H6235"\w* \w días|strong="H3117"\w*. \w Él|strong="H1121"\w* también \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H1121"\w* Yahvé.  
\v 10 \w Al|strong="H5921"\w* \w año|strong="H8141"\w* siguiente, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Nabucodonosor|strong="H5019"\w* \w mandó|strong="H7971"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* llevaran \w a|strong="H3068"\w* Babilonia, \w junto|strong="H5921"\w* \w con|strong="H5973"\w* \w los|strong="H5921"\w* objetos \w más|strong="H5921"\w* valiosos \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé. Luego \w puso|strong="H7971"\w* \w como|strong="H5973"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Jerusalén \w a|strong="H3068"\w* Sedequías, pariente \w de|strong="H5921"\w* Joaquín.   
\p
\v 11 Sedequías tenía veintiún \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén durante once \w años|strong="H8141"\w*.  
\v 12 \w Él|strong="H6213"\w* también \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* los \w ojos|strong="H5869"\w* \w de|strong="H6440"\w* Yahvé su \w Dios|strong="H3068"\w*. \w Y|strong="H3068"\w* cuando \w el|strong="H6213"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w le|strong="H5869"\w* habló \w de|strong="H6440"\w* parte \w de|strong="H6440"\w* Yahvé, Sedequías \w no|strong="H3808"\w* \w fue|strong="H3808"\w* humilde \w ni|strong="H3808"\w* \w le|strong="H5869"\w* \w hizo|strong="H6213"\w* caso.  
\v 13 \w Además|strong="H1571"\w*, Sedequías se rebeló \w contra|strong="H3478"\w* \w el|strong="H1571"\w* \w rey|strong="H4428"\w* \w Nabucodonosor|strong="H5019"\w*, \w a|strong="H3068"\w* pesar de \w que|strong="H1571"\w* este le había hecho jurar lealtad en \w el|strong="H1571"\w* nombre de \w Dios|strong="H3068"\w*. Sedequías \w fue|strong="H1571"\w* muy terco \w y|strong="H1571"\w* su \w corazón|strong="H3824"\w* se \w volvió|strong="H7725"\w* duro, negándose \w a|strong="H3068"\w* regresar \w a|strong="H3068"\w* Yahvé, \w el|strong="H1571"\w* \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*.  
\v 14 \w Para|strong="H5971"\w* colmo, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H1571"\w* \w la|strong="H1571"\w* \w gente|strong="H1471"\w* del \w pueblo|strong="H5971"\w* le fueron \w cada|strong="H3605"\w* vez \w más|strong="H1571"\w* infieles \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*. Adoptaron las mismas costumbres asquerosas \w de|strong="H5971"\w* las \w naciones|strong="H1471"\w* paganas \w y|strong="H1571"\w* profanaron \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, \w el|strong="H3605"\w* cual \w él|strong="H3605"\w* \w mismo|strong="H1571"\w* \w había|strong="H6942"\w* consagrado en Jerusalén.   
\p
\v 15 Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* sus antepasados, \w les|strong="H5921"\w* \w enviaba|strong="H7971"\w* mensajes \w de|strong="H5921"\w* advertencia vez tras vez \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* sus profetas, \w porque|strong="H3588"\w* \w le|strong="H5921"\w* daba lástima \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w su|strong="H3588"\w* templo.  
\v 16 Pero la \w gente|strong="H5971"\w* \w se|strong="H1961"\w* burlaba \w de|strong="H5704"\w* \w los|strong="H1961"\w* \w mensajeros|strong="H4397"\w* \w de|strong="H5704"\w* \w Dios|strong="H3068"\w*, \w no|strong="H1961"\w* les importaba \w lo|strong="H1697"\w* \w que|strong="H5704"\w* decían \w y|strong="H5704"\w* \w se|strong="H1961"\w* reían \w de|strong="H5704"\w* sus \w profetas|strong="H5030"\w*. \w Esto|strong="H1697"\w* \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* \w tal|strong="H1697"\w* punto \w que|strong="H5704"\w* \w el|strong="H5030"\w* \w enojo|strong="H2534"\w* \w de|strong="H5704"\w* Yahvé \w se|strong="H1961"\w* desató \w contra|strong="H1961"\w* su \w pueblo|strong="H5971"\w*, \w y|strong="H5704"\w* ya \w no|strong="H1961"\w* \w hubo|strong="H1961"\w* \w manera|strong="H1697"\w* \w de|strong="H5704"\w* salvarlos.   
\p
\v 17 Así \w que|strong="H3808"\w* Dios \w hizo|strong="H5414"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* babilonios \w los|strong="H5921"\w* atacara. Este \w rey|strong="H4428"\w* masacró \w a|strong="H3068"\w* \w los|strong="H5921"\w* jóvenes \w a|strong="H3068"\w* \w espada|strong="H2719"\w* allí \w mismo|strong="H3605"\w* \w dentro|strong="H5921"\w* \w del|strong="H5921"\w* \w santuario|strong="H4720"\w*. \w No|strong="H3808"\w* tuvo compasión \w de|strong="H5921"\w* \w nadie|strong="H3808"\w*: \w mató|strong="H2026"\w* \w a|strong="H3068"\w* jóvenes \w y|strong="H5921"\w* muchachas, \w a|strong="H3068"\w* \w ancianos|strong="H2205"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* estaban enfermos. Dios \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* babilonio.  
\v 18 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* se robó \w todos|strong="H3605"\w* \w los|strong="H3605"\w* objetos del \w templo|strong="H1004"\w* \w de|strong="H8269"\w* \w Dios|strong="H3068"\w*, \w los|strong="H3605"\w* \w grandes|strong="H1419"\w* y \w los|strong="H3605"\w* \w pequeños|strong="H6996"\w*, y se llevó \w a|strong="H3068"\w* Babilonia \w todos|strong="H3605"\w* \w los|strong="H3605"\w* tesoros del \w templo|strong="H1004"\w* \w de|strong="H8269"\w* Yahvé, así como las riquezas del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* Judá y \w de|strong="H8269"\w* sus funcionarios.  
\v 19 Su ejército le prendió fuego al \w templo|strong="H1004"\w* de Dios, \w derribó|strong="H5422"\w* \w la|strong="H3605"\w* muralla de Jerusalén, \w quemó|strong="H8313"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* palacios y \w destruyó|strong="H5422"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* objetos de valor.  
\v 20 \w A|strong="H3068"\w* \w los|strong="H1121"\w* pocos \w que|strong="H4480"\w* lograron escapar \w de|strong="H4480"\w* la \w espada|strong="H2719"\w*, \w se|strong="H1961"\w* \w los|strong="H1121"\w* llevó \w como|strong="H1961"\w* prisioneros \w a|strong="H3068"\w* Babilonia, donde \w fueron|strong="H1961"\w* esclavos \w de|strong="H4480"\w* \w él|strong="H1121"\w* \w y|strong="H5704"\w* \w de|strong="H4480"\w* sus \w hijos|strong="H1121"\w* \w hasta|strong="H5704"\w* \w que|strong="H4480"\w* \w el|strong="H1121"\w* imperio persa tomó \w el|strong="H1121"\w* poder.  
\v 21 Así se \w cumplió|strong="H4390"\w* \w lo|strong="H1697"\w* \w que|strong="H5704"\w* Yahvé había anunciado \w por|strong="H1697"\w* medio del profeta \w Jeremías|strong="H3414"\w*. \w La|strong="H3605"\w* tierra descansó \w y|strong="H5704"\w* recuperó sus \w años|strong="H8141"\w* sabáticos perdidos. Durante \w los|strong="H3605"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w* \w que|strong="H5704"\w* estuvo destruida \w y|strong="H5704"\w* abandonada, \w la|strong="H3605"\w* tierra \w por|strong="H1697"\w* fin descansó.   
\p
\v 22 En \w el|strong="H3605"\w* primer \w año|strong="H8141"\w* del \w reinado|strong="H4428"\w* \w de|strong="H1697"\w* \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Persia|strong="H6539"\w*, Yahvé \w cumplió|strong="H3615"\w* \w la|strong="H1571"\w* promesa \w que|strong="H1571"\w* había hecho \w por|strong="H1697"\w* medio \w de|strong="H1697"\w* \w Jeremías|strong="H3414"\w*. Yahvé impulsó \w el|strong="H3605"\w* corazón del \w rey|strong="H4428"\w* \w Ciro|strong="H3566"\w* para \w que|strong="H1571"\w* publicara este decreto en \w todo|strong="H3605"\w* su imperio, \w y|strong="H1571"\w* para \w que|strong="H1571"\w* \w también|strong="H1571"\w* \w lo|strong="H1697"\w* pusiera \w por|strong="H1697"\w* escrito:  
\v 23 “\w Esto|strong="H1931"\w* dice \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w*: ‘Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w me|strong="H5921"\w* \w ha|strong="H3541"\w* \w entregado|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* tierra, \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w ha|strong="H3541"\w* \w encargado|strong="H6485"\w* \w que|strong="H4310"\w* \w le|strong="H1931"\w* construya un \w templo|strong="H1004"\w* \w en|strong="H5921"\w* Jerusalén, \w en|strong="H5921"\w* \w la|strong="H1931"\w* región \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Cualquiera|strong="H3605"\w* \w de|strong="H5921"\w* ustedes \w que|strong="H4310"\w* pertenezca \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*, puede ir allá \w a|strong="H3068"\w* ayudar, ¡\w y|strong="H5921"\w* \w que|strong="H4310"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w* \w lo|strong="H1931"\w* acompañe!’”.   