\v 26 “\w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w* \w se|strong="H1961"\w* cierre \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w haya|strong="H1961"\w* \w lluvia|strong="H4306"\w* \w porque|strong="H3588"\w* han \w pecado|strong="H2403"\w* \w contra|strong="H1961"\w* ti, \w si|strong="H3588"\w* ellos oran mirando hacia \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, confiesan tu \w nombre|strong="H8034"\w* \w y|strong="H3588"\w* \w se|strong="H1961"\w* arrepienten \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w* \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* hayas castigado,  
\v 27 \w escucha|strong="H8085"\w* tú \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* \w perdona|strong="H5545"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w de|strong="H5921"\w* tus \w siervos|strong="H5650"\w*, tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. Enséñales \w el|strong="H5921"\w* \w buen|strong="H2896"\w* \w camino|strong="H1870"\w* \w que|strong="H3588"\w* deben seguir, \w y|strong="H3588"\w* envía \w lluvia|strong="H4306"\w* \w sobre|strong="H5921"\w* tu tierra, \w la|strong="H5921"\w* \w cual|strong="H3588"\w* \w le|strong="H5921"\w* \w diste|strong="H5414"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w como|strong="H3588"\w* \w herencia|strong="H5159"\w*.   
