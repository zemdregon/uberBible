\v 17 Además, \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w hizo|strong="H6213"\w* un \w gran|strong="H1419"\w* \w trono|strong="H3678"\w* de \w marfil|strong="H8127"\w* y \w lo|strong="H6213"\w* recubrió de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*.  
\v 18 \w El|strong="H5921"\w* \w trono|strong="H3678"\w* tenía \w seis|strong="H8337"\w* \w escalones|strong="H4609"\w* \w y|strong="H5921"\w* un banquillo \w de|strong="H5921"\w* \w oro|strong="H2091"\w* unidos \w a|strong="H3068"\w* \w él|strong="H5921"\w*. Tenía descansabrazos \w a|strong="H3068"\w* cada \w lado|strong="H3027"\w* \w del|strong="H5921"\w* \w asiento|strong="H3678"\w*, \w y|strong="H5921"\w* \w dos|strong="H8147"\w* leones \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* descansabrazos.  
\v 19 \w Había|strong="H5975"\w* otros \w doce|strong="H8147"\w* leones \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w seis|strong="H8337"\w* \w escalones|strong="H4609"\w*, \w seis|strong="H8337"\w* \w de|strong="H5921"\w* un lado \w y|strong="H5921"\w* \w seis|strong="H8337"\w* \w del|strong="H5921"\w* \w otro|strong="H2088"\w*. ¡\w En|strong="H5921"\w* \w ningún|strong="H3605"\w* \w otro|strong="H2088"\w* \w reino|strong="H4467"\w* \w se|strong="H5921"\w* \w había|strong="H5975"\w* \w hecho|strong="H6213"\w* algo igual!  
\v 20 \w Todas|strong="H3605"\w* las copas del \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* eran de \w oro|strong="H2091"\w*, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios del palacio \w Bosque|strong="H3293"\w* del \w Líbano|strong="H3844"\w* eran de \w oro|strong="H2091"\w* \w puro|strong="H5462"\w*. En \w los|strong="H3605"\w* \w tiempos|strong="H3117"\w* de \w Salomón|strong="H8010"\w*, \w la|strong="H3605"\w* \w plata|strong="H3701"\w* no se \w consideraba|strong="H2803"\w* de mucho valor.  
\v 21 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* tenía una flota \w de|strong="H3588"\w* barcos mercantes \w que|strong="H3588"\w* navegaban \w a|strong="H3068"\w* \w Tarsis|strong="H8659"\w* \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w los|strong="H5973"\w* marineros \w de|strong="H3588"\w* \w Hiram|strong="H2361"\w*. \w Cada|strong="H8141"\w* \w tres|strong="H7969"\w* \w años|strong="H8141"\w*, \w los|strong="H5973"\w* barcos regresaban \w de|strong="H3588"\w* \w Tarsis|strong="H8659"\w* \w cargados|strong="H5375"\w* \w de|strong="H3588"\w* \w oro|strong="H2091"\w*, \w plata|strong="H3701"\w*, \w marfil|strong="H8143"\w*, monos \w y|strong="H3588"\w* pavorreales.   
\p
\v 22 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* superó en \w riquezas|strong="H6239"\w* y \w sabiduría|strong="H2451"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w la|strong="H3605"\w* tierra.  
