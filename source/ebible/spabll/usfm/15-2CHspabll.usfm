\v 28 “\w Si|strong="H3588"\w* \w hay|strong="H1961"\w* \w hambre|strong="H7458"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* país, \w o|strong="H3068"\w* peste, tizón, moho, langostas \w o|strong="H3068"\w* gusanos; \w si|strong="H3588"\w* sus enemigos \w los|strong="H3605"\w* sitian \w en|strong="H3588"\w* sus propias \w ciudades|strong="H8179"\w*, \w o|strong="H3068"\w* \w si|strong="H3588"\w* \w hay|strong="H1961"\w* \w cualquier|strong="H3605"\w* otra \w plaga|strong="H5061"\w* \w o|strong="H3068"\w* \w enfermedad|strong="H4245"\w*,  
\v 29 \w escucha|strong="H8605"\w* \w toda|strong="H3605"\w* \w oración|strong="H8605"\w* \w o|strong="H3068"\w* \w súplica|strong="H8467"\w* \w que|strong="H5971"\w* haga \w cualquier|strong="H3605"\w* persona, \w o|strong="H3068"\w* \w todo|strong="H3605"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. \w Cuando|strong="H1961"\w* \w cada|strong="H3605"\w* uno reconozca su propio sufrimiento y \w dolor|strong="H4341"\w*, y levante las \w manos|strong="H3709"\w* hacia \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 30 escúchalo \w desde|strong="H4480"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w*, \w el|strong="H3588"\w* lugar donde \w habitas|strong="H3427"\w*, \w y|strong="H3588"\w* \w perdona|strong="H5545"\w*. Trata \w a|strong="H3068"\w* \w cada|strong="H3605"\w* uno según \w su|strong="H3588"\w* conducta, ya \w que|strong="H3588"\w* tú \w conoces|strong="H3045"\w* \w su|strong="H3588"\w* \w corazón|strong="H3824"\w*. \w Porque|strong="H3588"\w* solo tú \w conoces|strong="H3045"\w* \w el|strong="H3588"\w* \w corazón|strong="H3824"\w* \w de|strong="H4480"\w* \w los|strong="H3427"\w* seres humanos.  
\v 31 \w Así|strong="H1992"\w* \w te|strong="H5921"\w* honrarán \w y|strong="H5921"\w* seguirán tus \w caminos|strong="H1870"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H5921"\w* vivan \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w les|strong="H1992"\w* \w diste|strong="H5414"\w* \w a|strong="H3068"\w* nuestros antepasados.   
\p
\v 32 “En cuanto al \w extranjero|strong="H5237"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* pertenece \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, pero \w que|strong="H1931"\w* viene \w de|strong="H5971"\w* un país lejano atraído \w por|strong="H4616"\w* \w la|strong="H1931"\w* \w fama|strong="H8034"\w* \w de|strong="H5971"\w* tu \w gran|strong="H1419"\w* \w nombre|strong="H8034"\w*, tu \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* \w y|strong="H1571"\w* tu \w brazo|strong="H2220"\w* \w extendido|strong="H5186"\w*; \w cuando|strong="H1571"\w* \w esa|strong="H1931"\w* persona venga \w y|strong="H1571"\w* \w ore|strong="H6419"\w* mirando hacia \w este|strong="H2088"\w* \w templo|strong="H1004"\w*,  
\v 33 escúchala \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w el|strong="H5921"\w* lugar \w donde|strong="H5921"\w* \w habitas|strong="H3427"\w*, \w y|strong="H3588"\w* concédele \w al|strong="H5921"\w* \w extranjero|strong="H5237"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* pida. \w De|strong="H4480"\w* \w este|strong="H2088"\w* modo, \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* tierra \w conocerán|strong="H3045"\w* \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w* \w y|strong="H3588"\w* \w te|strong="H5921"\w* respetarán, igual \w que|strong="H3588"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* he construido lleva \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w*.   
\p
\v 34 “\w Si|strong="H3588"\w* tu \w pueblo|strong="H5971"\w* \w sale|strong="H3318"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w* \w contra|strong="H5921"\w* sus enemigos \w por|strong="H5921"\w* dondequiera \w que|strong="H3588"\w* tú \w los|strong="H5921"\w* envíes, \w y|strong="H3588"\w* oran \w a|strong="H3068"\w* \w ti|strong="H5921"\w* mirando \w hacia|strong="H1870"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3588"\w* elegiste \w y|strong="H3588"\w* \w hacia|strong="H1870"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* he construido \w en|strong="H5921"\w* tu honor,  
\v 35 \w escucha|strong="H8085"\w* \w desde|strong="H4480"\w* \w el|strong="H6213"\w* \w cielo|strong="H8064"\w* su \w oración|strong="H8605"\w* y su \w súplica|strong="H8467"\w*, y defiende su causa.   
\p
\v 36 “\w Si|strong="H3588"\w* pecan \w contra|strong="H6440"\w* ti (\w pues|strong="H3588"\w* \w no|strong="H3808"\w* hay \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w peque|strong="H2398"\w*), \w y|strong="H3588"\w* tú \w te|strong="H3588"\w* enojas \w con|strong="H3588"\w* ellos \w y|strong="H3588"\w* \w los|strong="H3588"\w* entregas al enemigo, \w de|strong="H3588"\w* modo \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w los|strong="H3588"\w* lleven prisioneros \w a|strong="H3068"\w* una tierra lejana \w o|strong="H3068"\w* \w cercana|strong="H7138"\w*;  
\v 37 pero \w si|strong="H7617"\w* recapacitan en la tierra \w donde|strong="H8033"\w* \w están|strong="H3824"\w* prisioneros, se arrepienten y te suplican desde \w allí|strong="H8033"\w*, diciendo: ‘Hemos \w pecado|strong="H2398"\w*, hemos hecho lo malo y hemos actuado perversamente’;  
\v 38 \w si|strong="H7617"\w* se \w vuelven|strong="H7725"\w* \w a|strong="H3068"\w* ti \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w* y con \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w* en \w la|strong="H3605"\w* tierra \w de|strong="H5414"\w* su cautiverio, y oran mirando \w hacia|strong="H1870"\w* \w la|strong="H3605"\w* tierra \w que|strong="H3605"\w* les \w diste|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados, \w hacia|strong="H1870"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3605"\w* elegiste y \w hacia|strong="H1870"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w que|strong="H3605"\w* he construido en tu honor,  
\v 39 \w escucha|strong="H8085"\w* \w desde|strong="H4480"\w* \w el|strong="H6213"\w* \w cielo|strong="H8064"\w*, \w el|strong="H6213"\w* lugar donde \w habitas|strong="H3427"\w*, su \w oración|strong="H8605"\w* y sus peticiones. Defiende su causa, y \w perdona|strong="H5545"\w* \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w* \w que|strong="H4480"\w* ha \w pecado|strong="H2398"\w* \w contra|strong="H4480"\w* \w ti|strong="H4480"\w*.   
\p
\v 40 “\w Ahora|strong="H6258"\w*, Dios mío, \w te|strong="H5869"\w* \w ruego|strong="H4994"\w* \w que|strong="H6258"\w* mantengas tus \w ojos|strong="H5869"\w* \w abiertos|strong="H6605"\w* y tus oídos \w atentos|strong="H7183"\w* \w a|strong="H3068"\w* las oraciones \w que|strong="H6258"\w* \w se|strong="H1961"\w* hagan en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.   
\p
\v 41 “\w Ahora|strong="H6258"\w*, Yahvé \w Dios|strong="H3068"\w*, \w levántate|strong="H6965"\w* \w y|strong="H5797"\w* ven \w a|strong="H3068"\w* tu lugar \w de|strong="H3847"\w* descanso, tú \w y|strong="H5797"\w* el arca \w de|strong="H3847"\w* tu poder. \w Que|strong="H6258"\w* tus \w sacerdotes|strong="H3548"\w*, Yahvé \w Dios|strong="H3068"\w*, se vistan \w de|strong="H3847"\w* salvación, \w y|strong="H5797"\w* \w que|strong="H6258"\w* tus fieles se alegren por tu bondad.   
\p
\v 42 “Yahvé \w Dios|strong="H3068"\w*, \w no|strong="H6440"\w* rechaces al rey que has elegido. \w Acuérdate|strong="H2142"\w* del fiel amor que le prometiste \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*”.   
\c 7  
\p
\v 1 Cuando \w Salomón|strong="H8010"\w* terminó de orar, bajó fuego del \w cielo|strong="H8064"\w* \w y|strong="H3519"\w* \w consumió|strong="H3615"\w* los \w holocaustos|strong="H5930"\w* \w y|strong="H3519"\w* los \w sacrificios|strong="H2077"\w*, \w y|strong="H3519"\w* la \w gloria|strong="H3519"\w* de Yahvé \w llenó|strong="H4390"\w* el \w templo|strong="H1004"\w*.  
\v 2 \w Los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* \w no|strong="H3808"\w* \w podían|strong="H3201"\w* entrar al \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* Yahvé \w lo|strong="H3808"\w* \w había|strong="H3588"\w* llenado \w por|strong="H3588"\w* completo.  
\v 3 \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* fuego bajaba \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* posaba \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w*, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w se|strong="H5921"\w* \w arrodillaron|strong="H3766"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* pavimento, inclinaron \w su|strong="H3588"\w* rostro \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* suelo, \w y|strong="H3588"\w* \w adoraron|strong="H7812"\w* \w y|strong="H3588"\w* dieron gracias \w a|strong="H3068"\w* Yahvé, diciendo:  
\q1 “\w Porque|strong="H3588"\w* \w él|strong="H5921"\w* \w es|strong="H3588"\w* \w bueno|strong="H2896"\w*,  
\q2 \w porque|strong="H3588"\w* \w su|strong="H3588"\w* fiel amor \w es|strong="H3588"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*”.   
\p
\v 4 Luego, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* ofrecieron \w sacrificios|strong="H2077"\w* \w ante|strong="H6440"\w* Yahvé.  
\v 5 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* \w ofreció|strong="H2076"\w* un \w sacrificio|strong="H2077"\w* \w de|strong="H5971"\w* \w veintidós|strong="H6242"\w* \w mil|strong="H3967"\w* \w vacas|strong="H1241"\w* \w y|strong="H1241"\w* \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*. \w De|strong="H5971"\w* esta manera, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w y|strong="H1241"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* dedicaron \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Dios.  
\v 6 \w Los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w estaban|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w en|strong="H5921"\w* sus \w puestos|strong="H5975"\w*; \w y|strong="H3588"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* también, tocando \w los|strong="H5921"\w* \w instrumentos|strong="H3627"\w* musicales \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w había|strong="H5975"\w* \w hecho|strong="H6213"\w* \w para|strong="H5921"\w* \w alabar|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé (cantando: “\w Porque|strong="H3588"\w* \w su|strong="H3588"\w* fiel amor \w es|strong="H3027"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*”), \w cada|strong="H3605"\w* vez \w que|strong="H3588"\w* \w David|strong="H1732"\w* ofrecía alabanzas \w a|strong="H3068"\w* través \w de|strong="H5921"\w* \w ellos|strong="H3027"\w*. \w Los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w tocaban|strong="H2690"\w* \w las|strong="H5921"\w* \w trompetas|strong="H2690"\w* \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w ellos|strong="H3027"\w*, \w mientras|strong="H3605"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* permanecía \w de|strong="H5921"\w* \w pie|strong="H5975"\w*.   
\p
\v 7 \w Además|strong="H3588"\w*, \w Salomón|strong="H8010"\w* consagró \w la|strong="H3588"\w* parte central \w del|strong="H4196"\w* \w patio|strong="H2691"\w* \w que|strong="H3588"\w* \w estaba|strong="H1004"\w* frente \w al|strong="H5930"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* \w allí|strong="H8033"\w* \w ofreció|strong="H6213"\w* \w los|strong="H3588"\w* \w holocaustos|strong="H5930"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* grasa \w de|strong="H3588"\w* \w los|strong="H3588"\w* sacrificios \w de|strong="H3588"\w* paz, ya \w que|strong="H3588"\w* \w en|strong="H8432"\w* \w el|strong="H3588"\w* \w altar|strong="H4196"\w* \w de|strong="H3588"\w* bronce \w que|strong="H3588"\w* \w Salomón|strong="H8010"\w* \w había|strong="H6942"\w* \w hecho|strong="H6213"\w* \w no|strong="H3808"\w* cabían \w los|strong="H3588"\w* \w holocaustos|strong="H5930"\w*, las ofrendas \w de|strong="H3588"\w* grano \w y|strong="H3588"\w* \w la|strong="H3588"\w* grasa.   
\p
\v 8 \w En|strong="H5973"\w* \w aquella|strong="H1931"\w* ocasión, \w Salomón|strong="H8010"\w* \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* celebraron \w la|strong="H1931"\w* \w fiesta|strong="H2282"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*. \w Era|strong="H1931"\w* una \w multitud|strong="H6951"\w* enorme \w que|strong="H1931"\w* \w había|strong="H6213"\w* venido \w desde|strong="H5704"\w* Lebo Hamat \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*.   
