\v 28 \w El|strong="H4264"\w* \w que|strong="H4325"\w* los queme deberá lavar su ropa y bañarse antes \w de|strong="H4325"\w* volver \w a|strong="H3068"\w* entrar al \w campamento|strong="H4264"\w*.   
\p
\v 29 “\w Este|strong="H1961"\w* \w será|strong="H1961"\w* un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H1961"\w* ustedes: \w El|strong="H3605"\w* día diez del \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, ayunarán y \w no|strong="H3808"\w* \w harán|strong="H6213"\w* \w ninguna|strong="H3605"\w* clase de trabajo, \w ni|strong="H3808"\w* \w los|strong="H3605"\w* nacidos \w en|strong="H8432"\w* \w el|strong="H3605"\w* país \w ni|strong="H3808"\w* \w los|strong="H3605"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H3808"\w* vivan \w entre|strong="H8432"\w* ustedes.  
\v 30 \w Porque|strong="H3588"\w* \w en|strong="H5921"\w* \w ese|strong="H2088"\w* \w día|strong="H3117"\w* \w se|strong="H5921"\w* hará \w la|strong="H5921"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* ustedes \w para|strong="H5921"\w* purificarlos, \w y|strong="H3588"\w* quedarán limpios \w de|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w pecados|strong="H2403"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.  
\v 31 \w Será|strong="H1931"\w* para ustedes un día de descanso absoluto y de ayuno. \w Es|strong="H1931"\w* un reglamento \w perpetuo|strong="H5769"\w*.  
\v 32 El \w sacerdote|strong="H3548"\w* \w que|strong="H3027"\w* haya sido \w ungido|strong="H4886"\w* y \w consagrado|strong="H6944"\w* para tomar el \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su padre hará la \w expiación|strong="H3722"\w*. Se pondrá la ropa sagrada \w de|strong="H8478"\w* lino  
\v 33 \w y|strong="H5921"\w* purificará \w el|strong="H5921"\w* Lugar \w Santísimo|strong="H6944"\w*, \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*. También hará \w la|strong="H5921"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad.   
\p
\v 34 “\w Este|strong="H2063"\w* \w será|strong="H1961"\w* un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H5921"\w* ustedes: una vez \w al|strong="H5921"\w* \w año|strong="H8141"\w* \w se|strong="H1961"\w* \w hará|strong="H6213"\w* \w la|strong="H5921"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas”.  
\p \w Y|strong="H3068"\w* Aarón \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w tal|strong="H2063"\w* \w como|strong="H1961"\w* Yahvé \w se|strong="H1961"\w* \w lo|strong="H5921"\w* \w había|strong="H1961"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.   
\c 17  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Diles|strong="H1697"\w* \w a|strong="H3068"\w* Aarón, \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas: ‘\w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé ha \w ordenado|strong="H6680"\w*:  
\v 3 Cualquier hombre de la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w* que degüelle un becerro, un \w cordero|strong="H3775"\w* \w o|strong="H3068"\w* una \w cabra|strong="H5795"\w* dentro del \w campamento|strong="H4264"\w*, \w o|strong="H3068"\w* que lo degüelle \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*,  
\v 4 y \w no|strong="H3808"\w* \w lo|strong="H1931"\w* lleve \w a|strong="H3068"\w* \w la|strong="H1931"\w* entrada \w de|strong="H6440"\w* \w la|strong="H1931"\w* Tienda del Encuentro \w para|strong="H5971"\w* presentarlo \w como|strong="H1931"\w* \w ofrenda|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé \w ante|strong="H6440"\w* \w el|strong="H1931"\w* santuario \w de|strong="H6440"\w* Yahvé, \w será|strong="H1931"\w* considerado culpable \w de|strong="H6440"\w* derramar \w sangre|strong="H1818"\w*. \w Ha|strong="H3808"\w* \w derramado|strong="H8210"\w* \w sangre|strong="H1818"\w*, y \w ese|strong="H1931"\w* hombre \w será|strong="H1931"\w* eliminado \w de|strong="H6440"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 5 \w El|strong="H5921"\w* propósito \w de|strong="H5921"\w* \w esta|strong="H1992"\w* ley es \w que|strong="H5921"\w* \w los|strong="H1992"\w* israelitas lleven \w a|strong="H3068"\w* Yahvé \w los|strong="H1992"\w* \w sacrificios|strong="H2077"\w* \w que|strong="H5921"\w* ahora ofrecen \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* abierto. Deben llevarlos \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, \w para|strong="H4616"\w* ofrecerlos \w a|strong="H3068"\w* Yahvé \w como|strong="H5921"\w* \w sacrificios|strong="H2077"\w* \w de|strong="H5921"\w* paz.  
\v 6 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* rociará \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w de|strong="H5921"\w* Yahvé \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, \w y|strong="H5921"\w* \w quemará|strong="H6999"\w* \w la|strong="H5921"\w* grasa \w como|strong="H5921"\w* aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 7 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* ofrecerán \w más|strong="H5750"\w* \w sus|strong="H1992"\w* \w sacrificios|strong="H2077"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* ídolos \w en|strong="H5750"\w* forma \w de|strong="H5750"\w* chivo, con \w los|strong="H1992"\w* cuales \w se|strong="H1961"\w* han \w estado|strong="H1961"\w* prostituyendo espiritualmente. \w Este|strong="H2063"\w* \w será|strong="H1961"\w* un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H1961"\w* \w todas|strong="H1755"\w* \w sus|strong="H1992"\w* \w generaciones|strong="H1755"\w*’.   
\p
\v 8 “También les dirás: ‘Cualquier hombre \w de|strong="H4480"\w* la \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w o|strong="H3068"\w* cualquier \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* viva \w entre|strong="H8432"\w* ustedes, \w que|strong="H4480"\w* ofrezca un \w holocausto|strong="H5930"\w* \w o|strong="H3068"\w* un \w sacrificio|strong="H2077"\w*,  
\v 9 y \w no|strong="H3808"\w* \w lo|strong="H1931"\w* lleve \w a|strong="H3068"\w* \w la|strong="H1931"\w* entrada \w de|strong="H5971"\w* \w la|strong="H1931"\w* Tienda del Encuentro \w para|strong="H5971"\w* ofrecerlo \w a|strong="H3068"\w* Yahvé, \w ese|strong="H1931"\w* hombre \w será|strong="H1931"\w* eliminado \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 10 “‘\w Si|strong="H6440"\w* \w cualquier|strong="H3605"\w* \w israelita|strong="H3478"\w*, \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* viva \w entre|strong="H8432"\w* ustedes, come \w sangre|strong="H1818"\w* \w de|strong="H4480"\w* \w cualquier|strong="H3605"\w* tipo, \w yo|strong="H4480"\w* \w me|strong="H4480"\w* \w pondré|strong="H5414"\w* \w en|strong="H4480"\w* \w contra|strong="H6440"\w* \w de|strong="H4480"\w* esa \w persona|strong="H5315"\w* y \w la|strong="H3605"\w* eliminaré \w de|strong="H4480"\w* su \w pueblo|strong="H5971"\w*.  
\v 11 \w Porque|strong="H3588"\w* \w la|strong="H1931"\w* \w vida|strong="H5315"\w* \w de|strong="H5921"\w* \w toda|strong="H5921"\w* criatura \w está|strong="H1931"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w*. \w Yo|strong="H3588"\w* \w mismo|strong="H1931"\w* \w se|strong="H1931"\w* \w la|strong="H1931"\w* he \w dado|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w sobre|strong="H5921"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* hagan \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w sus|strong="H1931"\w* \w vidas|strong="H5315"\w*, ya \w que|strong="H3588"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w la|strong="H1931"\w* \w que|strong="H3588"\w* hace \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w la|strong="H1931"\w* \w vida|strong="H5315"\w*.  
\v 12 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w les|strong="H5921"\w* he dicho \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: \w Ninguno|strong="H3808"\w* \w de|strong="H4480"\w* ustedes debe \w comer|strong="H5315"\w* \w sangre|strong="H1818"\w*, \w ni|strong="H3808"\w* \w tampoco|strong="H3808"\w* \w el|strong="H5921"\w* \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* viva \w entre|strong="H8432"\w* ustedes.   
\p
\v 13 “‘Cualquier \w israelita|strong="H3478"\w*, \w o|strong="H3068"\w* cualquier \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* \w viva|strong="H2416"\w* \w entre|strong="H8432"\w* ustedes, \w que|strong="H4480"\w* cace un \w animal|strong="H2416"\w* \w o|strong="H3068"\w* un \w ave|strong="H5775"\w* \w que|strong="H4480"\w* esté permitido comer, deberá derramar su \w sangre|strong="H1818"\w* y cubrirla \w con|strong="H4480"\w* \w tierra|strong="H6083"\w*.  
\v 14 \w Porque|strong="H3588"\w* \w la|strong="H1931"\w* \w vida|strong="H5315"\w* \w de|strong="H3588"\w* \w toda|strong="H3605"\w* criatura \w es|strong="H1931"\w* \w su|strong="H1931"\w* \w sangre|strong="H1818"\w*. \w Por|strong="H3588"\w* \w eso|strong="H1931"\w* les he dicho \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: \w No|strong="H3808"\w* coman \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w de|strong="H3588"\w* \w ninguna|strong="H3605"\w* criatura, \w porque|strong="H3588"\w* \w la|strong="H1931"\w* \w vida|strong="H5315"\w* \w de|strong="H3588"\w* \w toda|strong="H3605"\w* criatura \w es|strong="H1931"\w* \w su|strong="H1931"\w* \w sangre|strong="H1818"\w*. \w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* \w la|strong="H1931"\w* coma \w será|strong="H1931"\w* eliminado.   
\p
\v 15 “‘\w Cualquier|strong="H3605"\w* \w persona|strong="H5315"\w*, sea israelita \w de|strong="H5704"\w* nacimiento \w o|strong="H3068"\w* \w extranjero|strong="H1616"\w*, \w que|strong="H5704"\w* coma carne \w de|strong="H5704"\w* un \w animal|strong="H5315"\w* \w que|strong="H5704"\w* murió \w por|strong="H5704"\w* \w sí|strong="H5315"\w* solo \w o|strong="H3068"\w* \w que|strong="H5704"\w* fue despedazado \w por|strong="H5704"\w* las fieras, deberá lavar su ropa \w y|strong="H5704"\w* bañarse. Quedará impura \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer \w y|strong="H5704"\w* \w después|strong="H5704"\w* quedará pura.  
\v 16 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w lava|strong="H3526"\w* su ropa \w ni|strong="H3808"\w* \w se|strong="H3808"\w* baña, cargará con su culpa’”.   
\c 18  
\p
\v 1 Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas y \w diles|strong="H1696"\w*: ‘Yo soy Yahvé, su \w Dios|strong="H3068"\w*.  
\v 3 \w No|strong="H3808"\w* deben seguir las costumbres de la tierra de \w Egipto|strong="H4714"\w*, \w donde|strong="H8033"\w* ustedes vivieron. \w Tampoco|strong="H3808"\w* sigan las costumbres de la tierra de \w Canaán|strong="H3667"\w*, adonde \w los|strong="H3427"\w* llevo. \w No|strong="H3808"\w* \w se|strong="H3808"\w* guíen por sus reglamentos.  
\v 4 Ustedes deben cumplir mis leyes y obedecer mis reglamentos. Vivan de acuerdo con \w ellos|strong="H2708"\w*. \w Yo|strong="H6213"\w* soy Yahvé, su \w Dios|strong="H3068"\w*.  
\v 5 Obedezcan mis reglamentos y mis leyes, porque \w la|strong="H8104"\w* persona que los cumpla, \w vivirá|strong="H2425"\w* por \w ellos|strong="H2708"\w*. \w Yo|strong="H6213"\w* soy Yahvé.   
\p
\v 6 “‘\w Ninguno|strong="H3808"\w* de ustedes debe tener relaciones sexuales con un pariente cercano. Yo soy Yahvé.   
\p
\v 7 “‘\w No|strong="H3808"\w* deshonrarás \w a|strong="H3068"\w* tu padre teniendo relaciones sexuales con tu madre. \w Ella|strong="H1931"\w* \w es|strong="H1931"\w* tu madre; \w no|strong="H3808"\w* debes tener relaciones con \w ella|strong="H1931"\w*.   
\p
\v 8 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con \w ninguna|strong="H3808"\w* otra esposa de tu padre; \w eso|strong="H1931"\w* deshonraría \w a|strong="H3068"\w* tu padre.   
\p
\v 9 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con tu hermana, ya sea \w hija|strong="H1323"\w* de tu padre \w o|strong="H3068"\w* \w hija|strong="H1323"\w* de tu madre, ya sea \w que|strong="H3808"\w* haya nacido en la misma \w casa|strong="H1004"\w* \w o|strong="H3068"\w* en otra parte.   
\p
\v 10 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales \w con|strong="H3588"\w* tu nieta, ya sea \w la|strong="H3588"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* tu \w hijo|strong="H1121"\w* \w o|strong="H3068"\w* \w la|strong="H3588"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* tu \w hija|strong="H1323"\w*, \w porque|strong="H3588"\w* deshonrarla \w a|strong="H3068"\w* ella \w es|strong="H3588"\w* deshonrarte \w a|strong="H3068"\w* ti mismo.   
\p
\v 11 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con \w la|strong="H1931"\w* \w hija|strong="H1323"\w* de una esposa de tu padre. \w Como|strong="H1931"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* \w hija|strong="H1323"\w* de tu padre, \w es|strong="H1931"\w* tu media hermana.   
\p
\v 12 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con \w la|strong="H1931"\w* hermana de tu padre, \w pues|strong="H1931"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* pariente \w cercana|strong="H7607"\w* de tu padre.   
\p
\v 13 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales \w con|strong="H3588"\w* \w la|strong="H1931"\w* hermana \w de|strong="H3588"\w* tu madre, \w pues|strong="H3588"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* pariente \w cercana|strong="H7607"\w* \w de|strong="H3588"\w* tu madre.   
\p
\v 14 “‘\w No|strong="H3808"\w* deshonrarás al hermano de tu padre teniendo relaciones sexuales con \w su|strong="H1931"\w* esposa. \w Ella|strong="H1931"\w* \w es|strong="H1931"\w* tu tía.   
\p
\v 15 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con tu \w nuera|strong="H3618"\w*. \w Es|strong="H1931"\w* \w la|strong="H1931"\w* \w esposa|strong="H3618"\w* \w de|strong="H1121"\w* tu \w hijo|strong="H1121"\w*; \w no|strong="H3808"\w* debes tener relaciones con \w ella|strong="H1931"\w*.   
\p
\v 16 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con \w la|strong="H1931"\w* esposa de tu hermano, \w pues|strong="H1931"\w* \w eso|strong="H1931"\w* deshonraría \w a|strong="H3068"\w* tu hermano.   
\p
\v 17 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales con una mujer y también con \w su|strong="H1931"\w* \w hija|strong="H1323"\w*. \w Tampoco|strong="H3808"\w* te acostarás con \w su|strong="H1931"\w* nieta, ya sea \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w* \w o|strong="H3068"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w su|strong="H1931"\w* \w hija|strong="H1323"\w*. \w Son|strong="H3808"\w* parientes cercanas, y hacer \w eso|strong="H1931"\w* \w es|strong="H1931"\w* una perversidad.   
\p
\v 18 “‘Mientras tu esposa esté \w viva|strong="H2416"\w*, \w no|strong="H3808"\w* \w te|strong="H5921"\w* casarás \w con|strong="H5921"\w* su hermana \w para|strong="H5921"\w* hacerla su rival \w y|strong="H5921"\w* tener relaciones sexuales \w con|strong="H5921"\w* \w ella|strong="H5921"\w*.   
\p
\v 19 “‘\w No|strong="H3808"\w* te acercarás \w a|strong="H3068"\w* una mujer para tener relaciones sexuales mientras ella esté en su período de impureza menstrual.   
\p
\v 20 “‘\w No|strong="H3808"\w* te acostarás con la esposa \w de|strong="H5414"\w* tu prójimo, pues te contaminarías con ella.   
\p
\v 21 “‘\w No|strong="H3808"\w* entregarás \w a|strong="H3068"\w* \w ninguno|strong="H3808"\w* \w de|strong="H5414"\w* tus \w hijos|strong="H2233"\w* \w para|strong="H5414"\w* \w que|strong="H3808"\w* sea sacrificado en \w el|strong="H5674"\w* fuego \w a|strong="H3068"\w* Moloc. \w No|strong="H3808"\w* profanes \w el|strong="H5674"\w* \w nombre|strong="H8034"\w* \w de|strong="H5414"\w* tu \w Dios|strong="H3068"\w*. Yo soy Yahvé.   
\p
\v 22 “‘\w No|strong="H3808"\w* te acostarás \w con|strong="H4904"\w* un hombre \w como|strong="H1931"\w* \w quien|strong="H1931"\w* \w se|strong="H1931"\w* acuesta \w con|strong="H4904"\w* una mujer; \w es|strong="H1931"\w* algo asqueroso.   
\p
\v 23 “‘\w No|strong="H3808"\w* \w tendrás|strong="H5414"\w* relaciones sexuales con \w ningún|strong="H3605"\w* animal, \w pues|strong="H1931"\w* te contaminarías con \w él|strong="H1931"\w*. \w Ninguna|strong="H3605"\w* mujer debe presentarse \w ante|strong="H6440"\w* un animal \w para|strong="H5414"\w* aparearse con \w él|strong="H1931"\w*; \w es|strong="H1931"\w* una perversión.   
\p
\v 24 “‘\w No|strong="H3588"\w* se contaminen \w con|strong="H3588"\w* \w ninguna|strong="H3605"\w* \w de|strong="H3588"\w* estas cosas, \w porque|strong="H3588"\w* las \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* voy \w a|strong="H3068"\w* expulsar \w de|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ustedes se \w contaminaron|strong="H2930"\w* haciendo \w todo|strong="H3605"\w* esto.  
\v 25 \w La|strong="H5921"\w* tierra misma \w se|strong="H5921"\w* \w contaminó|strong="H2930"\w*. \w Por|strong="H5921"\w* eso \w la|strong="H5921"\w* castigué \w por|strong="H5921"\w* sus \w pecados|strong="H5771"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* tierra vomitó \w a|strong="H3068"\w* sus \w habitantes|strong="H3427"\w*.  
\v 26 Por \w lo|strong="H3808"\w* tanto, ustedes deben obedecer mis reglamentos y mis leyes, y \w no|strong="H3808"\w* cometer \w ninguna|strong="H3605"\w* de \w estas|strong="H6213"\w* cosas asquerosas. \w Esto|strong="H6213"\w* aplica tanto para \w los|strong="H3605"\w* israelitas como para \w los|strong="H3605"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H3808"\w* viven \w entre|strong="H8432"\w* ustedes.  
\v 27 \w Los|strong="H3605"\w* habitantes \w de|strong="H3588"\w* esa tierra \w que|strong="H3588"\w* vivieron \w antes|strong="H6440"\w* \w que|strong="H3588"\w* ustedes \w hicieron|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas asquerosas, \w y|strong="H3588"\w* \w la|strong="H3588"\w* tierra se \w contaminó|strong="H2930"\w*.  
\v 28 \w No|strong="H3808"\w* permitan \w que|strong="H3808"\w* la tierra los vomite \w a|strong="H3068"\w* ustedes \w por|strong="H6440"\w* haberla \w contaminado|strong="H2930"\w*, tal como vomitó \w a|strong="H3068"\w* la \w nación|strong="H1471"\w* \w que|strong="H3808"\w* vivía allí \w antes|strong="H6440"\w* \w que|strong="H3808"\w* ustedes.   
\p
\v 29 “‘\w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* \w haga|strong="H6213"\w* \w alguna|strong="H3605"\w* \w de|strong="H3588"\w* \w estas|strong="H6213"\w* cosas asquerosas, \w será|strong="H6213"\w* eliminado \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 30 Cumplan mis mandamientos. \w No|strong="H3808"\w* practiquen \w ninguna|strong="H3808"\w* \w de|strong="H6440"\w* las costumbres perversas \w que|strong="H3808"\w* \w se|strong="H3808"\w* practicaban \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w que|strong="H3808"\w* ustedes llegaran, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* contaminen con ellas. \w Yo|strong="H6213"\w* soy Yahvé, su \w Dios|strong="H3068"\w*’”.   
\c 19  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Sean|strong="H1961"\w* \w santos|strong="H6918"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w soy|strong="H1961"\w* \w santo|strong="H6918"\w*.   
\p
\v 3 “‘Cada uno \w de|strong="H3372"\w* ustedes debe respetar \w a|strong="H3068"\w* su madre y \w a|strong="H3068"\w* su padre, y deben \w guardar|strong="H8104"\w* mis días \w de|strong="H3372"\w* descanso. Yo soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 4 “‘\w No|strong="H3808"\w* \w se|strong="H3808"\w* vuelvan \w a|strong="H3068"\w* los ídolos \w ni|strong="H3808"\w* \w se|strong="H3808"\w* \w hagan|strong="H6213"\w* dioses de metal fundido. \w Yo|strong="H6213"\w* soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 5 “‘\w Cuando|strong="H3588"\w* ofrezcan un \w sacrificio|strong="H2077"\w* \w de|strong="H3588"\w* paz \w a|strong="H3068"\w* Yahvé, ofrézcanlo \w de|strong="H3588"\w* \w la|strong="H3588"\w* manera correcta \w para|strong="H3588"\w* \w que|strong="H3588"\w* sea aceptado.  
\v 6 La carne debe comerse el mismo \w día|strong="H3117"\w* \w que|strong="H5704"\w* la ofrezcan \w o|strong="H3068"\w* \w al|strong="H5704"\w* \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*. \w Lo|strong="H5704"\w* \w que|strong="H5704"\w* quede \w para|strong="H5704"\w* el tercer \w día|strong="H3117"\w* deberá quemarse \w en|strong="H5704"\w* el fuego.  
\v 7 \w Si|strong="H3808"\w* alguien come \w la|strong="H1931"\w* carne al tercer \w día|strong="H3117"\w*, \w el|strong="H1931"\w* sacrificio \w será|strong="H1931"\w* considerado asqueroso y \w no|strong="H3808"\w* \w será|strong="H1931"\w* aceptado.  
\v 8 Cualquiera \w que|strong="H3588"\w* \w lo|strong="H1931"\w* coma cargará \w con|strong="H3588"\w* \w su|strong="H1931"\w* culpa \w por|strong="H3588"\w* profanar \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w es|strong="H1931"\w* \w sagrado|strong="H6944"\w* \w para|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1931"\w* eliminada \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 9 “‘Cuando coseches los \w campos|strong="H7704"\w* de tu tierra, \w no|strong="H3808"\w* cortes hasta el último rincón del \w campo|strong="H7704"\w*, \w ni|strong="H3808"\w* recojas \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* haya caído de la cosecha.  
\v 10 \w Tampoco|strong="H3808"\w* pases una segunda vez por tu viñedo \w ni|strong="H3808"\w* recojas las uvas \w que|strong="H3808"\w* \w se|strong="H3808"\w* hayan caído. Déjalas para los pobres y para los \w extranjeros|strong="H1616"\w*. Yo soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 11 “‘\w No|strong="H3808"\w* roben.  
\p “‘\w No|strong="H3808"\w* mientan.  
\p “‘\w No|strong="H3808"\w* \w se|strong="H3808"\w* engañen unos \w a|strong="H3068"\w* otros.   
\p
\v 12 “‘\w No|strong="H3808"\w* juren en \w mi|strong="H2490"\w* \w nombre|strong="H8034"\w* para decir una \w mentira|strong="H8267"\w*, \w porque|strong="H3808"\w* estarían \w profanando|strong="H2490"\w* el \w nombre|strong="H8034"\w* de su \w Dios|strong="H3068"\w*. Yo soy Yahvé.   
\p
\v 13 “‘\w No|strong="H3808"\w* \w oprimas|strong="H6231"\w* \w a|strong="H3068"\w* tu \w prójimo|strong="H7453"\w* \w ni|strong="H3808"\w* \w le|strong="H1242"\w* \w robes|strong="H1497"\w*.  
\p “‘\w No|strong="H3808"\w* retengas \w el|strong="H3885"\w* pago \w de|strong="H5704"\w* un trabajador \w hasta|strong="H5704"\w* la \w mañana|strong="H1242"\w* siguiente.   
\p
\v 14 “‘\w No|strong="H3808"\w* maldigas al \w sordo|strong="H2795"\w*, \w ni|strong="H3808"\w* le \w pongas|strong="H5414"\w* \w tropiezos|strong="H4383"\w* al \w ciego|strong="H5787"\w*. \w Más|strong="H3808"\w* bien, \w teme|strong="H3372"\w* \w a|strong="H3068"\w* tu \w Dios|strong="H3068"\w*. Yo soy Yahvé.   
\p
\v 15 “‘\w No|strong="H3808"\w* actúes con injusticia en un \w juicio|strong="H4941"\w*. \w No|strong="H3808"\w* favorezcas al \w pobre|strong="H1800"\w* \w ni|strong="H3808"\w* te dejes llevar \w por|strong="H6440"\w* \w el|strong="H6213"\w* poderoso; \w juzga|strong="H8199"\w* \w a|strong="H3068"\w* \w tu|strong="H8199"\w* prójimo con \w justicia|strong="H6664"\w*.   
\p
\v 16 “‘\w No|strong="H3808"\w* \w andes|strong="H3212"\w* \w chismeando|strong="H7400"\w* \w entre|strong="H5921"\w* tu \w pueblo|strong="H5971"\w*.  
\p “‘\w No|strong="H3808"\w* pongas \w en|strong="H5921"\w* peligro \w la|strong="H5921"\w* vida \w de|strong="H5921"\w* tu \w prójimo|strong="H7453"\w*. Yo soy Yahvé.   
\p
\v 17 “‘\w No|strong="H3808"\w* guardes odio \w en|strong="H5921"\w* tu \w corazón|strong="H3824"\w* \w contra|strong="H5921"\w* tu hermano. \w Reprende|strong="H3198"\w* \w a|strong="H3068"\w* tu prójimo \w con|strong="H5921"\w* franqueza, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* hagas cómplice \w de|strong="H5921"\w* su \w pecado|strong="H2399"\w*.   
\p
\v 18 “‘\w No|strong="H3808"\w* te vengues \w ni|strong="H3808"\w* le guardes \w rencor|strong="H5201"\w* \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* \w de|strong="H1121"\w* tu \w pueblo|strong="H5971"\w*, \w sino|strong="H3808"\w* ama \w a|strong="H3068"\w* tu \w prójimo|strong="H7453"\w* \w como|strong="H3644"\w* \w a|strong="H3068"\w* ti mismo. Yo soy Yahvé.   
\p
\v 19 “‘Obedezcan mis reglamentos.  
\p “‘\w No|strong="H3808"\w* cruces animales \w de|strong="H5921"\w* distintas especies.  
\p “‘\w No|strong="H3808"\w* siembres tu \w campo|strong="H7704"\w* \w con|strong="H5921"\w* dos clases \w de|strong="H5921"\w* semilla.  
\p “‘\w No|strong="H3808"\w* uses ropa hecha \w con|strong="H5921"\w* hilos \w de|strong="H5921"\w* dos clases \w de|strong="H5921"\w* material.   
\p
\v 20 “‘\w Si|strong="H3588"\w* un hombre \w tiene|strong="H1961"\w* relaciones sexuales \w con|strong="H3588"\w* una esclava \w que|strong="H3588"\w* \w está|strong="H1931"\w* prometida \w en|strong="H3588"\w* matrimonio \w a|strong="H3068"\w* otro hombre, \w pero|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* \w sido|strong="H1961"\w* comprada \w ni|strong="H3808"\w* liberada, ambos deberán ser castigados. \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w se|strong="H1961"\w* les condenará \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*, \w porque|strong="H3588"\w* \w ella|strong="H1931"\w* \w no|strong="H3808"\w* \w era|strong="H1961"\w* libre.  
\v 21 El hombre deberá llevar \w a|strong="H3068"\w* la entrada de la Tienda del Encuentro un carnero como su ofrenda por la culpa ante Yahvé.  
\v 22 \w Con|strong="H5921"\w* \w el|strong="H5921"\w* carnero \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa, \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w que|strong="H5921"\w* \w cometió|strong="H2398"\w*, \w y|strong="H5921"\w* su \w pecado|strong="H2403"\w* \w le|strong="H5921"\w* será perdonado.   
\p
\v 23 “‘\w Cuando|strong="H3588"\w* entren \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w y|strong="H3588"\w* planten \w cualquier|strong="H3605"\w* clase \w de|strong="H3588"\w* \w árbol|strong="H6086"\w* frutal, considerarán \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w fruto|strong="H6529"\w* \w está|strong="H1961"\w* prohibido durante \w los|strong="H3605"\w* primeros \w tres|strong="H7969"\w* \w años|strong="H8141"\w*; \w no|strong="H3808"\w* deberán comerlo.  
\v 24 Al \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w*, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w fruto|strong="H6529"\w* \w será|strong="H1961"\w* \w consagrado|strong="H6944"\w* \w para|strong="H1961"\w* alabar \w a|strong="H3068"\w* Yahvé.  
\v 25 \w Y|strong="H3068"\w* en el \w quinto|strong="H2549"\w* \w año|strong="H8141"\w* \w ya|strong="H3254"\w* podrán comer el \w fruto|strong="H6529"\w* del árbol; de esa manera les dará una mayor cosecha. Yo soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 26 “‘\w No|strong="H3808"\w* coman carne \w que|strong="H3808"\w* todavía tenga \w sangre|strong="H1818"\w*. \w No|strong="H3808"\w* practiquen \w la|strong="H5921"\w* adivinación \w ni|strong="H3808"\w* \w la|strong="H5921"\w* hechicería.   
\p
\v 27 “‘\w No|strong="H3808"\w* \w se|strong="H3808"\w* corten el pelo \w a|strong="H3068"\w* los lados de la \w cabeza|strong="H7218"\w* \w ni|strong="H3808"\w* \w se|strong="H3808"\w* recorten los bordes de la \w barba|strong="H2206"\w*.   
\p
\v 28 “‘\w No|strong="H3808"\w* \w se|strong="H3808"\w* hagan cortes en el cuerpo \w por|strong="H5414"\w* los muertos, \w ni|strong="H3808"\w* \w se|strong="H3808"\w* hagan tatuajes. \w Yo|strong="H5315"\w* soy Yahvé.   
\p
\v 29 “‘\w No|strong="H3808"\w* deshonres \w a|strong="H3068"\w* tu \w hija|strong="H1323"\w* haciéndola prostituta, para \w que|strong="H3808"\w* el país \w no|strong="H3808"\w* \w se|strong="H3808"\w* llene de prostitución \w ni|strong="H3808"\w* de perversidad.   
\p
\v 30 “‘\w Guarden|strong="H8104"\w* mis días \w de|strong="H3372"\w* descanso y muestren respeto por mi \w santuario|strong="H4720"\w*. Yo soy Yahvé.   
\p
\v 31 “‘No \w busquen|strong="H1245"\w* el consejo de los médiums ni de los \w adivinos|strong="H3049"\w*; no se contaminen acudiendo \w a|strong="H3068"\w* ellos. Yo soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 32 “‘Ponte \w de|strong="H6440"\w* pie en \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* las canas, muestra respeto \w por|strong="H6440"\w* los \w ancianos|strong="H2205"\w* y \w teme|strong="H3372"\w* \w a|strong="H3068"\w* tu \w Dios|strong="H3068"\w*. Yo soy Yahvé.   
\p
\v 33 “‘\w Cuando|strong="H3588"\w* un \w extranjero|strong="H1616"\w* viva \w entre|strong="H3588"\w* ustedes \w en|strong="H3588"\w* \w su|strong="H3588"\w* país, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* maltraten.  
\v 34 \w Al|strong="H4480"\w* \w extranjero|strong="H1616"\w* \w que|strong="H3588"\w* viva \w con|strong="H4480"\w* ustedes lo tratarán \w como|strong="H3588"\w* \w a|strong="H3068"\w* uno \w de|strong="H4480"\w* sus compatriotas. Ámalo \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w ti|strong="H4480"\w* mismo, \w porque|strong="H3588"\w* también ustedes \w fueron|strong="H1961"\w* \w extranjeros|strong="H1616"\w* \w en|strong="H4480"\w* \w Egipto|strong="H4714"\w*. \w Yo|strong="H4480"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.   
\p
\v 35 “‘\w No|strong="H3808"\w* usen medidas falsas \w para|strong="H4948"\w* medir longitud, \w peso|strong="H4948"\w* \w o|strong="H3068"\w* capacidad.  
\v 36 Usen \w balanzas|strong="H3976"\w* exactas, pesas exactas y medidas exactas. Yo \w soy|strong="H1961"\w* Yahvé, su \w Dios|strong="H3068"\w*, quien \w los|strong="H1961"\w* \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w*.   
\p
\v 37 “‘Obedezcan \w todos|strong="H3605"\w* mis reglamentos y \w todas|strong="H3605"\w* mis leyes, y pónganlos en práctica. \w Yo|strong="H6213"\w* soy Yahvé’”.   
\c 20  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “Diles también \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘Cualquier \w israelita|strong="H3478"\w*, \w o|strong="H3068"\w* cualquier \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* viva \w en|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w que|strong="H4480"\w* \w entregue|strong="H5414"\w* \w a|strong="H3068"\w* uno \w de|strong="H4480"\w* sus \w hijos|strong="H1121"\w* como sacrificio \w a|strong="H3068"\w* Moloc, deberá ser condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*. \w El|strong="H1121"\w* \w pueblo|strong="H5971"\w* \w del|strong="H4480"\w* país lo \w matará|strong="H4191"\w* \w a|strong="H3068"\w* pedradas.  
\v 3 \w Yo|strong="H3588"\w* \w mismo|strong="H1931"\w* \w me|strong="H3588"\w* \w pondré|strong="H5414"\w* \w en|strong="H3588"\w* \w contra|strong="H6440"\w* \w de|strong="H3588"\w* \w ese|strong="H1931"\w* hombre \w y|strong="H3588"\w* \w lo|strong="H1931"\w* eliminaré \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w al|strong="H7130"\w* entregarle \w su|strong="H1931"\w* hijo \w a|strong="H3068"\w* Moloc profanó \w mi|strong="H2490"\w* \w santuario|strong="H4720"\w* \w y|strong="H3588"\w* deshonró \w mi|strong="H2490"\w* \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*.  
\v 4 \w Si|strong="H1931"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w del|strong="H4480"\w* país \w se|strong="H1931"\w* hace \w de|strong="H4480"\w* \w la|strong="H1931"\w* vista gorda cuando \w ese|strong="H1931"\w* hombre \w le|strong="H1931"\w* \w entrega|strong="H5414"\w* \w su|strong="H1931"\w* hijo \w a|strong="H3068"\w* Moloc y \w no|strong="H1115"\w* \w lo|strong="H1931"\w* matan,  
\v 5 yo \w mismo|strong="H1931"\w* me \w pondré|strong="H7760"\w* en \w contra|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H1931"\w* y \w de|strong="H6440"\w* \w su|strong="H1931"\w* \w familia|strong="H4940"\w*, y \w lo|strong="H1931"\w* eliminaré \w de|strong="H6440"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*, \w junto|strong="H5971"\w* con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1931"\w* \w lo|strong="H1931"\w* sigan en \w su|strong="H1931"\w* prostitución espiritual \w para|strong="H5971"\w* adorar \w a|strong="H3068"\w* Moloc.   
\p
\v 6 “‘\w Si|strong="H1931"\w* alguien acude \w a|strong="H3068"\w* médiums y \w adivinos|strong="H3049"\w*, \w prostituyéndose|strong="H2181"\w* \w al|strong="H7130"\w* seguirlos, me \w pondré|strong="H5414"\w* en \w contra|strong="H6440"\w* \w de|strong="H6440"\w* \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* y \w la|strong="H1931"\w* eliminaré \w de|strong="H6440"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 7 “‘\w Por|strong="H3588"\w* lo tanto, conságrense \w y|strong="H3588"\w* \w sean|strong="H1961"\w* \w santos|strong="H6918"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 8 Obedezcan mis reglamentos y pónganlos en práctica. \w Yo|strong="H6213"\w* soy Yahvé, \w el|strong="H6213"\w* que los \w hace|strong="H6213"\w* santos.   
\p
\v 9 “‘Cualquiera \w que|strong="H3588"\w* maldiga \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* madre será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*. Ha maldecido \w a|strong="H3068"\w* sus padres, \w por|strong="H3588"\w* lo \w que|strong="H3588"\w* será \w el|strong="H3588"\w* único responsable \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia \w muerte|strong="H4191"\w*.   
\p
\v 10 “‘Si un hombre comete adulterio con la esposa de \w otro|strong="H7453"\w* hombre —es decir, con la esposa de su \w prójimo|strong="H7453"\w*—, tanto el adúltero como la \w adúltera|strong="H5003"\w* serán condenados \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.   
\p
\v 11 “‘Si un hombre tiene relaciones sexuales con la esposa \w de|strong="H1818"\w* su padre, deshonra \w a|strong="H3068"\w* su padre. Tanto el hombre como la mujer serán condenados \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*; serán los únicos responsables \w de|strong="H1818"\w* su propia \w muerte|strong="H4191"\w*.   
\p
\v 12 “‘Si un hombre tiene relaciones sexuales con su \w nuera|strong="H3618"\w*, \w ambos|strong="H8147"\w* serán condenados \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*. \w Han|strong="H4191"\w* cometido una perversidad; serán los únicos responsables \w de|strong="H1818"\w* su propia \w muerte|strong="H4191"\w*.   
\p
\v 13 “‘Si un hombre tiene relaciones sexuales \w con|strong="H4904"\w* otro hombre como si fuera una mujer, \w ambos|strong="H8147"\w* cometen un acto asqueroso y serán condenados \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*; serán los únicos responsables \w de|strong="H1818"\w* su propia \w muerte|strong="H4191"\w*.   
\p
\v 14 “‘\w Si|strong="H3808"\w* un hombre \w se|strong="H1961"\w* casa con una mujer y también con \w la|strong="H1931"\w* madre de \w ella|strong="H1931"\w*, comete una gran perversidad. \w El|strong="H1931"\w* hombre y las dos mujeres \w serán|strong="H1961"\w* quemados \w en|strong="H8432"\w* \w el|strong="H1931"\w* fuego, \w para|strong="H1961"\w* acabar con \w esa|strong="H1931"\w* perversidad \w entre|strong="H8432"\w* ustedes.   
\p
\v 15 “‘Si un hombre se aparea con un animal, \w será|strong="H5414"\w* condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*, y el animal también \w será|strong="H5414"\w* sacrificado.   
\p
\v 16 “‘Si una mujer se acerca \w a|strong="H3068"\w* un animal para aparearse con \w él|strong="H3605"\w*, deberán matar \w a|strong="H3068"\w* \w la|strong="H3605"\w* mujer y al animal. Serán condenados \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*; serán \w los|strong="H3605"\w* únicos responsables \w de|strong="H1818"\w* su propia \w muerte|strong="H4191"\w*.   
\p
\v 17 “‘\w Si|strong="H1931"\w* un \w hombre|strong="H1121"\w* \w se|strong="H1931"\w* casa con \w su|strong="H1931"\w* hermana, ya sea \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w su|strong="H1931"\w* padre \w o|strong="H3068"\w* \w de|strong="H1121"\w* \w su|strong="H1931"\w* madre, y tienen relaciones sexuales, cometen un acto vergonzoso. \w Serán|strong="H1931"\w* eliminados \w a|strong="H3068"\w* \w la|strong="H1931"\w* vista \w de|strong="H1121"\w* toda \w su|strong="H1931"\w* \w gente|strong="H5971"\w*. \w Ese|strong="H1931"\w* \w hombre|strong="H1121"\w* deshonró \w a|strong="H3068"\w* \w su|strong="H1931"\w* hermana, \w así|strong="H1931"\w* \w que|strong="H1931"\w* cargará con \w su|strong="H1931"\w* culpa.   
\p
\v 18 “‘\w Si|strong="H1931"\w* un hombre \w tiene|strong="H1931"\w* relaciones sexuales con una mujer durante \w su|strong="H1931"\w* período menstrual, deshonra \w la|strong="H1931"\w* \w fuente|strong="H4726"\w* del flujo \w de|strong="H5971"\w* \w la|strong="H1931"\w* mujer, y \w ella|strong="H1931"\w* queda \w descubierta|strong="H1540"\w*. \w Ambos|strong="H8147"\w* \w serán|strong="H1931"\w* eliminados \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 19 “‘\w No|strong="H3808"\w* tendrás relaciones sexuales \w con|strong="H3588"\w* \w la|strong="H3588"\w* hermana \w de|strong="H3588"\w* tu madre \w ni|strong="H3808"\w* \w con|strong="H3588"\w* \w la|strong="H3588"\w* hermana \w de|strong="H3588"\w* tu padre, \w porque|strong="H3588"\w* sería deshonrar \w a|strong="H3068"\w* un pariente cercano. Ambos cargarán \w con|strong="H3588"\w* \w su|strong="H3588"\w* culpa.  
\v 20 Si un hombre tiene relaciones sexuales con la esposa de su \w tío|strong="H1730"\w*, deshonra \w a|strong="H3068"\w* su \w tío|strong="H1730"\w*. Ambos cargarán con su \w pecado|strong="H2399"\w* y \w morirán|strong="H4191"\w* \w sin|strong="H6185"\w* hijos.   
\p
\v 21 “‘\w Si|strong="H1931"\w* un hombre \w se|strong="H1961"\w* casa con \w la|strong="H1931"\w* esposa de \w su|strong="H1931"\w* hermano, comete un acto impuro. Deshonró \w a|strong="H3068"\w* \w su|strong="H1931"\w* hermano y \w no|strong="H1961"\w* \w tendrán|strong="H1961"\w* hijos.   
\p
\v 22 “‘Obedezcan \w todos|strong="H3605"\w* mis reglamentos y \w todas|strong="H3605"\w* mis leyes, y pónganlos en práctica. Así \w no|strong="H3808"\w* \w los|strong="H3427"\w* vomitará \w la|strong="H8104"\w* tierra \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w que|strong="H3808"\w* \w los|strong="H3427"\w* llevo para vivir.  
\v 23 \w No|strong="H3808"\w* sigan las costumbres \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* voy \w a|strong="H3068"\w* expulsar \w de|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ustedes. Ellas \w hicieron|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas asquerosas \w y|strong="H3588"\w* \w por|strong="H3588"\w* eso las detesto.  
\v 24 \w A|strong="H3068"\w* ustedes les he dicho: “Ustedes tomarán posesión \w de|strong="H4480"\w* la tierra \w de|strong="H4480"\w* \w ellos|strong="H4480"\w*. \w Yo|strong="H4480"\w* \w se|strong="H4480"\w* la \w daré|strong="H5414"\w* \w a|strong="H3068"\w* ustedes como herencia, una tierra donde abundan la \w leche|strong="H2461"\w* y la \w miel|strong="H1706"\w*”. \w Yo|strong="H4480"\w* soy Yahvé, su \w Dios|strong="H3068"\w*, \w que|strong="H4480"\w* los \w ha|strong="H3423"\w* separado \w de|strong="H4480"\w* las demás naciones.   
\p
\v 25 “‘Por \w lo|strong="H3808"\w* tanto, deben hacer una distinción \w entre|strong="H3808"\w* \w los|strong="H3605"\w* animales puros y \w los|strong="H3605"\w* impuros, y \w entre|strong="H3808"\w* las \w aves|strong="H5775"\w* puras y las impuras. \w No|strong="H3808"\w* \w se|strong="H3808"\w* vuelvan asquerosos \w a|strong="H3068"\w* ustedes mismos por \w comer|strong="H5315"\w* algún \w animal|strong="H5315"\w*, \w ave|strong="H5775"\w* \w o|strong="H3068"\w* criatura \w que|strong="H3808"\w* \w se|strong="H3808"\w* arrastra por \w el|strong="H3605"\w* suelo, de \w los|strong="H3605"\w* cuales les he dicho \w que|strong="H3808"\w* \w son|strong="H3808"\w* impuros.  
\v 26 \w Sean|strong="H1961"\w* \w santos|strong="H6918"\w* \w para|strong="H3588"\w* \w mí|strong="H1961"\w*, \w porque|strong="H3588"\w* \w yo|strong="H4480"\w*, Yahvé, \w soy|strong="H1961"\w* \w santo|strong="H6918"\w*. \w Yo|strong="H4480"\w* \w los|strong="H1961"\w* he separado \w de|strong="H4480"\w* las demás naciones \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w sean|strong="H1961"\w* míos.   
\p
\v 27 “‘Cualquier hombre \w o|strong="H3068"\w* mujer \w que|strong="H3588"\w* \w sea|strong="H1961"\w* médium \w o|strong="H3068"\w* adivino \w será|strong="H1961"\w* condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*. \w Serán|strong="H1961"\w* apedreados \w y|strong="H3588"\w* \w serán|strong="H1961"\w* \w los|strong="H1961"\w* únicos responsables \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia \w muerte|strong="H4191"\w*’”.   
\c 21  
\p
\v 1 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Diles \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón: ‘\w Ningún|strong="H3808"\w* \w sacerdote|strong="H3548"\w* debe hacerse impuro por asistir al funeral \w de|strong="H1121"\w* alguien \w de|strong="H1121"\w* su \w pueblo|strong="H5971"\w*,  
\v 2 \w a|strong="H3068"\w* \w menos|strong="H3588"\w* \w que|strong="H3588"\w* se trate \w de|strong="H3588"\w* un pariente muy \w cercano|strong="H7138"\w*: \w su|strong="H3588"\w* madre, \w su|strong="H3588"\w* padre, \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*, \w su|strong="H3588"\w* \w hija|strong="H1323"\w* \w o|strong="H3068"\w* \w su|strong="H3588"\w* hermano.  
\v 3 También puede hacerse impuro por su hermana \w virgen|strong="H1330"\w* \w que|strong="H3808"\w* dependa de él y \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w haya|strong="H1961"\w* casado; por ella \w sí|strong="H3808"\w* puede hacerse impuro.  
\v 4 Pero como líder \w de|strong="H5971"\w* su \w pueblo|strong="H5971"\w*, \w no|strong="H3808"\w* debe hacerse impuro \w ni|strong="H3808"\w* profanarse.   
\p
\v 5 “‘Los sacerdotes \w no|strong="H3808"\w* deben raparse la \w cabeza|strong="H7218"\w*, \w ni|strong="H3808"\w* recortarse los bordes de la \w barba|strong="H2206"\w*, \w ni|strong="H3808"\w* hacerse cortes en el cuerpo.  
\v 6 Deben ser \w santos|strong="H6918"\w* \w para|strong="H3588"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* deshonrar \w el|strong="H3588"\w* \w nombre|strong="H8034"\w* \w de|strong="H3588"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*. \w Son|strong="H1961"\w* \w ellos|strong="H1992"\w* quienes presentan \w las|strong="H1992"\w* ofrendas hechas \w por|strong="H3588"\w* fuego \w a|strong="H3068"\w* Yahvé, \w que|strong="H3588"\w* \w son|strong="H1961"\w* \w el|strong="H3588"\w* alimento \w de|strong="H3588"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*; \w por|strong="H3588"\w* \w lo|strong="H3808"\w* tanto, deben ser \w santos|strong="H6918"\w*.   
\p
\v 7 “‘\w No|strong="H3808"\w* deben casarse \w con|strong="H3588"\w* una mujer \w que|strong="H3588"\w* \w se|strong="H1931"\w* haya prostituido \w o|strong="H3068"\w* deshonrado. \w El|strong="H1931"\w* sacerdote \w tampoco|strong="H3808"\w* debe casarse \w con|strong="H3588"\w* una mujer divorciada, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w está|strong="H1931"\w* consagrado \w a|strong="H3068"\w* \w su|strong="H1931"\w* Dios.  
\v 8 \w Por|strong="H3588"\w* \w eso|strong="H1931"\w* deben considerarlo \w santo|strong="H6918"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w él|strong="H1931"\w* \w quien|strong="H1931"\w* \w ofrece|strong="H7126"\w* \w el|strong="H1931"\w* alimento \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*. \w Será|strong="H1961"\w* \w santo|strong="H6918"\w* \w para|strong="H3588"\w* ustedes, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, \w que|strong="H3588"\w* \w los|strong="H1931"\w* hago \w santos|strong="H6918"\w*, \w soy|strong="H1961"\w* \w santo|strong="H6918"\w*.   
\p
\v 9 “‘\w Si|strong="H3588"\w* \w la|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* un \w sacerdote|strong="H3548"\w* \w se|strong="H1931"\w* deshonra volviéndose prostituta, deshonra \w a|strong="H3068"\w* \w su|strong="H1931"\w* padre; deberá ser \w quemada|strong="H8313"\w* \w en|strong="H3588"\w* \w el|strong="H1931"\w* fuego.   
\p
\v 10 “‘\w El|strong="H5921"\w* \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w*, \w el|strong="H5921"\w* líder \w de|strong="H5921"\w* sus hermanos, \w sobre|strong="H5921"\w* cuya \w cabeza|strong="H7218"\w* \w se|strong="H5921"\w* \w derramó|strong="H3332"\w* \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w unción|strong="H4888"\w* \w y|strong="H5921"\w* \w que|strong="H3808"\w* \w fue|strong="H3808"\w* consagrado \w para|strong="H5921"\w* llevar \w la|strong="H5921"\w* ropa sacerdotal, \w no|strong="H3808"\w* debe andar despeinado \w ni|strong="H3808"\w* rasgarse \w la|strong="H5921"\w* ropa \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* luto.  
\v 11 \w No|strong="H3808"\w* debe acercarse \w a|strong="H3068"\w* \w ningún|strong="H3605"\w* cadáver; \w no|strong="H3808"\w* debe hacerse impuro \w ni|strong="H3808"\w* siquiera \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w muerte|strong="H4191"\w* \w de|strong="H5921"\w* su padre \w o|strong="H3068"\w* \w de|strong="H5921"\w* su madre.  
\v 12 \w Tampoco|strong="H3808"\w* debe \w salir|strong="H3318"\w* \w del|strong="H4480"\w* área \w del|strong="H4480"\w* \w santuario|strong="H4720"\w* \w ni|strong="H3808"\w* profanar \w el|strong="H5921"\w* \w santuario|strong="H4720"\w* \w de|strong="H4480"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w porque|strong="H3588"\w* lleva \w sobre|strong="H5921"\w* \w sí|strong="H3588"\w* \w la|strong="H5921"\w* \w consagración|strong="H5145"\w* \w del|strong="H4480"\w* \w aceite|strong="H8081"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w unción|strong="H4888"\w* \w de|strong="H4480"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. \w Yo|strong="H4480"\w* soy Yahvé.   
\p
\v 13 “‘Deberá casarse con una mujer \w virgen|strong="H1331"\w*.  
\v 14 \w No|strong="H3808"\w* debe casarse \w con|strong="H3588"\w* una viuda, \w ni|strong="H3808"\w* \w con|strong="H3588"\w* una divorciada, \w ni|strong="H3808"\w* \w con|strong="H3588"\w* una mujer deshonrada, \w ni|strong="H3808"\w* \w con|strong="H3588"\w* una prostituta. \w Se|strong="H3808"\w* casará \w con|strong="H3588"\w* una \w virgen|strong="H1330"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* propio \w pueblo|strong="H5971"\w*.  
\v 15 \w Así|strong="H3588"\w* \w no|strong="H3808"\w* deshonrará \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w descendencia|strong="H2233"\w* \w entre|strong="H3808"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w lo|strong="H3808"\w* hace \w santo|strong="H6942"\w*’”.   
\p
\v 16 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 17 “Dile \w a|strong="H3068"\w* Aarón: ‘\w Ninguno|strong="H3808"\w* de tus descendientes, de \w ninguna|strong="H3808"\w* \w generación|strong="H1755"\w*, \w que|strong="H3808"\w* \w tenga|strong="H1961"\w* algún defecto físico \w podrá|strong="H3808"\w* acercarse \w a|strong="H3068"\w* ofrecer el alimento de su Dios.  
\v 18 \w Porque|strong="H3588"\w* \w ningún|strong="H3605"\w* hombre \w que|strong="H3588"\w* tenga algún defecto \w podrá|strong="H3808"\w* acercarse: \w ni|strong="H3808"\w* \w el|strong="H3588"\w* \w ciego|strong="H5787"\w*, \w ni|strong="H3808"\w* \w el|strong="H3588"\w* \w cojo|strong="H6455"\w*, \w ni|strong="H3808"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* tenga \w la|strong="H3588"\w* cara deforme, \w ni|strong="H3808"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* tenga \w alguna|strong="H3605"\w* otra deformidad,  
\v 19 ni el \w que|strong="H1961"\w* \w tenga|strong="H1961"\w* fracturado el \w pie|strong="H7272"\w* \w o|strong="H3068"\w* la \w mano|strong="H3027"\w*,  
\v 20 ni el jorobado, ni el enano, ni el que tenga un defecto en el \w ojo|strong="H5869"\w*, ni el que tenga sarna \w o|strong="H3068"\w* tiña, ni el que tenga los testículos aplastados.  
\v 21 \w Ningún|strong="H3605"\w* descendiente del \w sacerdote|strong="H3548"\w* Aarón \w que|strong="H3808"\w* tenga algún defecto físico \w podrá|strong="H3808"\w* acercarse \w a|strong="H3068"\w* presentar las ofrendas hechas por fuego \w a|strong="H3068"\w* Yahvé. \w Ya|strong="H3068"\w* \w que|strong="H3808"\w* tiene un defecto, \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* acercarse \w a|strong="H3068"\w* ofrecer \w el|strong="H3605"\w* alimento de su \w Dios|strong="H3068"\w*.  
\v 22 Sí podrá comer \w del|strong="H4480"\w* alimento \w de|strong="H4480"\w* su Dios, tanto \w de|strong="H4480"\w* las ofrendas muy \w santas|strong="H6944"\w* como \w de|strong="H4480"\w* las ofrendas \w santas|strong="H6944"\w*.  
\v 23 \w Sin|strong="H3808"\w* embargo, \w como|strong="H3588"\w* tiene un defecto físico, \w no|strong="H3808"\w* debe acercarse \w a|strong="H3068"\w* \w la|strong="H3588"\w* cortina \w del|strong="H4196"\w* \w santuario|strong="H4720"\w* \w ni|strong="H3808"\w* acercarse al \w altar|strong="H4196"\w*. \w Así|strong="H3588"\w* \w no|strong="H3808"\w* \w profanará|strong="H2490"\w* mis cosas santas, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* las hace santas’”.   
\p
\v 24 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* le comunicó \w todo|strong="H3605"\w* esto \w a|strong="H3068"\w* Aarón, \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas.   
\c 22  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* \w que|strong="H3808"\w* tengan cuidado con \w las|strong="H1992"\w* ofrendas \w sagradas|strong="H6944"\w* \w que|strong="H3808"\w* \w los|strong="H1992"\w* israelitas me \w consagran|strong="H6942"\w*, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* deshonren \w mi|strong="H2490"\w* \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*. Yo soy Yahvé.   
\p
\v 3 “Diles: ‘\w Cualquiera|strong="H3605"\w* \w de|strong="H5921"\w* \w sus|strong="H1931"\w* descendientes, \w de|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w generación|strong="H1755"\w*, \w que|strong="H1931"\w* estando \w en|strong="H5921"\w* estado \w de|strong="H5921"\w* impureza \w se|strong="H1931"\w* acerque \w a|strong="H3068"\w* \w las|strong="H5921"\w* ofrendas \w sagradas|strong="H6944"\w* \w que|strong="H1931"\w* \w los|strong="H1121"\w* israelitas \w consagran|strong="H6942"\w* \w a|strong="H3068"\w* Yahvé, \w será|strong="H1931"\w* eliminado \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*. \w Yo|strong="H5315"\w* \w soy|strong="H1931"\w* Yahvé.   
\p
\v 4 “‘\w Ningún|strong="H3605"\w* descendiente \w de|strong="H4480"\w* Aarón \w que|strong="H4480"\w* tenga una infección \w de|strong="H4480"\w* lepra \w o|strong="H3068"\w* \w que|strong="H4480"\w* tenga un flujo, \w podrá|strong="H3808"\w* \w comer|strong="H5315"\w* \w de|strong="H4480"\w* las ofrendas \w sagradas|strong="H6944"\w* \w hasta|strong="H5704"\w* \w que|strong="H4480"\w* quede puro. \w El|strong="H1931"\w* \w que|strong="H4480"\w* toque algo \w que|strong="H4480"\w* \w se|strong="H1931"\w* haya vuelto impuro \w por|strong="H4480"\w* causa \w de|strong="H4480"\w* un cadáver, \w o|strong="H3068"\w* \w el|strong="H1931"\w* hombre \w que|strong="H4480"\w* tenga un derrame \w de|strong="H4480"\w* \w semen|strong="H7902"\w*,  
\v 5 \w o|strong="H3068"\w* \w el|strong="H3605"\w* \w que|strong="H3605"\w* toque \w cualquier|strong="H3605"\w* animal \w que|strong="H3605"\w* se arrastra \w que|strong="H3605"\w* pueda hacerlo impuro, \w o|strong="H3068"\w* \w el|strong="H3605"\w* \w que|strong="H3605"\w* toque \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* persona \w que|strong="H3605"\w* \w lo|strong="H3605"\w* haga impuro, \w cualquiera|strong="H3605"\w* \w que|strong="H3605"\w* sea su impureza,  
\v 6 \w la|strong="H3588"\w* \w persona|strong="H5315"\w* \w que|strong="H3588"\w* toque algo \w de|strong="H4480"\w* esto quedará impura \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* atardecer, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* \w comer|strong="H5315"\w* \w de|strong="H4480"\w* las ofrendas \w sagradas|strong="H6944"\w* \w a|strong="H3068"\w* \w menos|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H4480"\w* bañe.  
\v 7 \w Cuando|strong="H3588"\w* \w se|strong="H1931"\w* ponga \w el|strong="H1931"\w* \w sol|strong="H8121"\w*, quedará puro, \w y|strong="H3588"\w* \w entonces|strong="H3588"\w* podrá comer \w de|strong="H4480"\w* las ofrendas \w sagradas|strong="H6944"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w su|strong="H1931"\w* alimento.  
\v 8 \w No|strong="H3808"\w* debe comer carne de \w ningún|strong="H3808"\w* animal \w que|strong="H3808"\w* muera por \w sí|strong="H3808"\w* solo \w o|strong="H3068"\w* \w que|strong="H3808"\w* sea despedazado por las fieras, pues \w se|strong="H3808"\w* volvería impuro por ello. Yo soy Yahvé.   
\p
\v 9 “‘\w Los|strong="H5921"\w* sacerdotes deberán cumplir \w mis|strong="H5375"\w* requisitos; \w de|strong="H5921"\w* \w lo|strong="H3808"\w* contrario, serán culpables \w y|strong="H3588"\w* \w morirán|strong="H4191"\w* \w por|strong="H5921"\w* \w haber|strong="H3808"\w* \w profanado|strong="H2490"\w* \w las|strong="H5921"\w* ofrendas. \w Yo|strong="H3588"\w* soy Yahvé, \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* hace santos.   
\p
\v 10 “‘\w Ninguna|strong="H3605"\w* persona \w que|strong="H3808"\w* \w no|strong="H3808"\w* sea de \w la|strong="H3605"\w* familia del \w sacerdote|strong="H3548"\w* \w podrá|strong="H3808"\w* comer de \w la|strong="H3605"\w* ofrenda sagrada; \w ni|strong="H3808"\w* \w el|strong="H3605"\w* huésped del \w sacerdote|strong="H3548"\w* \w ni|strong="H3808"\w* su empleado \w a|strong="H3068"\w* sueldo podrán comer de \w ella|strong="H3605"\w*.  
\v 11 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* un \w sacerdote|strong="H3548"\w* \w compra|strong="H7069"\w* \w a|strong="H3068"\w* un esclavo \w con|strong="H3588"\w* \w su|strong="H1931"\w* propio \w dinero|strong="H3701"\w*, \w este|strong="H1931"\w* \w sí|strong="H3588"\w* podrá \w comer|strong="H5315"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* ofrenda. También \w los|strong="H1992"\w* esclavos \w nacidos|strong="H3211"\w* \w en|strong="H3588"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w* podrán \w comer|strong="H5315"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* alimento.  
\v 12 \w Si|strong="H3588"\w* \w la|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* un \w sacerdote|strong="H3548"\w* \w se|strong="H1961"\w* casa \w con|strong="H3588"\w* alguien \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w sacerdote|strong="H3548"\w*, ya \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* comer \w de|strong="H3588"\w* las \w ofrendas|strong="H8641"\w* \w sagradas|strong="H6944"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* \w le|strong="H1931"\w* presentan \w a|strong="H3068"\w* Yahvé.  
\v 13 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w ella|strong="H3605"\w* queda viuda \w o|strong="H3068"\w* \w se|strong="H1961"\w* divorcia, \w no|strong="H3808"\w* \w tiene|strong="H1961"\w* \w hijos|strong="H2233"\w* \w y|strong="H3588"\w* regresa \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre \w como|strong="H3588"\w* \w cuando|strong="H3588"\w* \w era|strong="H1961"\w* joven, \w podrá|strong="H3808"\w* comer del alimento \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre. \w Sin|strong="H3808"\w* embargo, \w nadie|strong="H3808"\w* \w más|strong="H3588"\w* \w fuera|strong="H1961"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* del \w sacerdote|strong="H3548"\w* \w podrá|strong="H3808"\w* comer \w de|strong="H3588"\w* ese alimento.   
\p
\v 14 “‘\w Si|strong="H3588"\w* alguien come \w por|strong="H5921"\w* error \w de|strong="H5921"\w* una ofrenda sagrada, deberá pagarle \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w el|strong="H5921"\w* valor \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda sagrada \w más|strong="H3588"\w* una quinta parte \w de|strong="H5921"\w* \w su|strong="H3588"\w* valor \w como|strong="H3588"\w* multa.  
\v 15 \w Los|strong="H1121"\w* sacerdotes \w no|strong="H3808"\w* deben profanar las ofrendas \w sagradas|strong="H6944"\w* \w que|strong="H3808"\w* \w los|strong="H1121"\w* israelitas le presentan \w a|strong="H3068"\w* Yahvé,  
\v 16 al permitir \w que|strong="H3588"\w* gente \w no|strong="H3588"\w* autorizada se las coma \w y|strong="H3588"\w* cargue \w así|strong="H3588"\w* \w con|strong="H3588"\w* \w la|strong="H3588"\w* culpa. \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* las hace \w santas|strong="H6944"\w*’”.   
\p
\v 17 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 18 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* Aarón, \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas, y \w diles|strong="H1696"\w*: ‘\w Cualquier|strong="H3605"\w* \w israelita|strong="H3478"\w*, \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w extranjero|strong="H1616"\w* \w que|strong="H4480"\w* viva \w en|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w que|strong="H4480"\w* \w presente|strong="H7133"\w* un \w holocausto|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé, ya sea \w para|strong="H4480"\w* cumplir una promesa \w o|strong="H3068"\w* como \w ofrenda|strong="H7133"\w* \w voluntaria|strong="H5071"\w*,  
\v 19 deberá ofrecer un \w macho|strong="H2145"\w* sin defecto de entre las \w vacas|strong="H1241"\w*, las ovejas \w o|strong="H3068"\w* las \w cabras|strong="H5795"\w*, para que la ofrenda le sea aceptada.  
\v 20 \w No|strong="H3808"\w* deben ofrecer \w ningún|strong="H3605"\w* animal \w que|strong="H3588"\w* \w tenga|strong="H1961"\w* algún defecto, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* les \w será|strong="H1961"\w* aceptado.  
\v 21 \w Cuando|strong="H3588"\w* alguien le ofrezca \w a|strong="H3068"\w* Yahvé un \w sacrificio|strong="H2077"\w* \w de|strong="H3588"\w* paz, ya \w sea|strong="H1961"\w* del \w ganado|strong="H6629"\w* \w o|strong="H3068"\w* del \w rebaño|strong="H6629"\w*, \w para|strong="H3588"\w* cumplir una promesa \w o|strong="H3068"\w* \w como|strong="H3588"\w* ofrenda \w voluntaria|strong="H5071"\w*, \w el|strong="H3588"\w* animal deberá estar \w en|strong="H8549"\w* perfectas condiciones \w para|strong="H3588"\w* ser aceptado. \w No|strong="H3808"\w* debe \w tener|strong="H1961"\w* \w ningún|strong="H3605"\w* defecto.  
\v 22 \w No|strong="H3808"\w* \w le|strong="H5921"\w* \w ofrecerán|strong="H7126"\w* \w a|strong="H3068"\w* Yahvé \w ningún|strong="H3808"\w* animal \w ciego|strong="H5788"\w*, lastimado, mutilado, \w ni|strong="H3808"\w* \w que|strong="H3808"\w* tenga verrugas, sarna \w o|strong="H3068"\w* tiña; \w no|strong="H3808"\w* \w pondrán|strong="H5414"\w* animales \w con|strong="H5921"\w* \w estos|strong="H1992"\w* defectos \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w como|strong="H5921"\w* ofrenda hecha \w por|strong="H5921"\w* fuego \w a|strong="H3068"\w* Yahvé.  
\v 23 Podrán presentar como ofrenda \w voluntaria|strong="H5071"\w* un toro joven \w o|strong="H3068"\w* un \w cordero|strong="H7716"\w* \w que|strong="H3808"\w* tenga alguna parte del cuerpo \w más|strong="H3808"\w* larga \w o|strong="H3068"\w* \w más|strong="H3808"\w* corta de \w lo|strong="H3808"\w* normal, pero \w no|strong="H3808"\w* \w será|strong="H6213"\w* aceptado para cumplir una promesa.  
\v 24 \w No|strong="H3808"\w* le \w ofrecerán|strong="H7126"\w* \w a|strong="H3068"\w* Yahvé un animal \w que|strong="H3808"\w* tenga los testículos lastimados, aplastados, desgarrados \w o|strong="H3068"\w* cortados. \w Esto|strong="H6213"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* deben \w hacer|strong="H6213"\w* en \w el|strong="H6213"\w* país de ustedes.  
\v 25 \w Tampoco|strong="H3808"\w* aceptarán \w de|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* un \w extranjero|strong="H5236"\w* \w animales|strong="H1121"\w* \w con|strong="H3588"\w* \w estos|strong="H3605"\w* defectos \w para|strong="H3588"\w* ofrecerlos \w como|strong="H3588"\w* \w el|strong="H3588"\w* alimento \w de|strong="H3588"\w* \w su|strong="H3588"\w* Dios. Tienen defectos \w y|strong="H3588"\w* están dañados, \w así|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* les serán aceptados’”.   
\p
\v 26 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 27 “\w Cuando|strong="H3588"\w* nazca un ternero, un corderito \w o|strong="H3068"\w* un cabrito, deberá quedarse \w con|strong="H3588"\w* \w su|strong="H3588"\w* madre durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*. \w A|strong="H3068"\w* partir del \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* podrá ser aceptado \w como|strong="H3588"\w* \w ofrenda|strong="H7133"\w* hecha \w por|strong="H3588"\w* fuego \w a|strong="H3068"\w* Yahvé.  
\v 28 \w No|strong="H3808"\w* degüellen una vaca \w ni|strong="H3808"\w* una \w oveja|strong="H7716"\w* \w el|strong="H1121"\w* mismo \w día|strong="H3117"\w* \w que|strong="H3808"\w* degüellen \w a|strong="H3068"\w* su cría.   
\p
\v 29 “\w Cuando|strong="H3588"\w* le ofrezcan \w a|strong="H3068"\w* Yahvé un \w sacrificio|strong="H2077"\w* \w de|strong="H3588"\w* acción \w de|strong="H3588"\w* gracias, háganlo \w de|strong="H3588"\w* \w la|strong="H3588"\w* manera correcta \w para|strong="H3588"\w* \w que|strong="H3588"\w* les sea aceptado.  
\v 30 Deberán comérselo \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*; \w no|strong="H3808"\w* dejen \w nada|strong="H3808"\w* \w para|strong="H5704"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w* siguiente. \w Yo|strong="H4480"\w* \w soy|strong="H1931"\w* Yahvé.   
\p
\v 31 “Por \w lo|strong="H6213"\w* tanto, obedezcan mis \w mandamientos|strong="H4687"\w* y pónganlos en práctica. \w Yo|strong="H6213"\w* soy Yahvé.  
\v 32 \w No|strong="H3808"\w* deshonren \w mi|strong="H2490"\w* \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*; \w más|strong="H3808"\w* bien, debo ser tratado como \w santo|strong="H6944"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* israelitas. Yo soy Yahvé, \w el|strong="H1121"\w* \w que|strong="H3808"\w* \w los|strong="H1121"\w* hace \w santos|strong="H6944"\w*,  
\v 33 el \w que|strong="H1961"\w* \w los|strong="H1961"\w* \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w* \w para|strong="H1961"\w* ser su \w Dios|strong="H3068"\w*. Yo \w soy|strong="H1961"\w* Yahvé”.   
\c 23  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* israelitas y \w diles|strong="H1696"\w*: ‘\w Estas|strong="H1992"\w* son \w las|strong="H1992"\w* fiestas señaladas \w de|strong="H1121"\w* Yahvé, \w las|strong="H1992"\w* cuales ustedes proclamarán como \w asambleas|strong="H4744"\w* \w santas|strong="H6944"\w*.   
\p
\v 3 “‘Trabajarán durante \w seis|strong="H8337"\w* \w días|strong="H3117"\w*, pero \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w será|strong="H1931"\w* de descanso absoluto, un \w día|strong="H3117"\w* de asamblea \w santa|strong="H6944"\w*. \w No|strong="H3808"\w* \w harán|strong="H6213"\w* \w ninguna|strong="H3605"\w* clase de trabajo. Dondequiera \w que|strong="H1931"\w* ustedes vivan, \w será|strong="H1931"\w* un \w día|strong="H3117"\w* de descanso \w dedicado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé.   
\p
\v 4 “‘Las siguientes son las fiestas señaladas de Yahvé, las \w asambleas|strong="H4744"\w* \w santas|strong="H6944"\w* que deberán proclamar en las fechas establecidas:  
\v 5 El día catorce del \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, al anochecer, se celebrará la \w Pascua|strong="H6453"\w* de Yahvé.  
\v 6 El \w día|strong="H3117"\w* \w quince|strong="H2568"\w* \w de|strong="H2568"\w* \w ese|strong="H2088"\w* mismo \w mes|strong="H2320"\w* comienza la \w Fiesta|strong="H2282"\w* \w de|strong="H2568"\w* los Panes sin Levadura en honor \w a|strong="H3068"\w* Yahvé. Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* comerán pan hecho sin levadura.  
\v 7 \w El|strong="H3605"\w* \w primer|strong="H7223"\w* \w día|strong="H3117"\w* celebrarán una asamblea \w santa|strong="H6944"\w*; \w no|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual.  
\v 8 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* le presentarán \w a|strong="H3068"\w* Yahvé ofrendas hechas por fuego. \w El|strong="H3605"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* celebrarán \w otra|strong="H6213"\w* asamblea \w santa|strong="H6944"\w* y \w tampoco|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual’”.   
\p
\v 9 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 10 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* entren \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* les voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w y|strong="H3588"\w* cosechen \w los|strong="H1121"\w* primeros frutos, le llevarán al \w sacerdote|strong="H3548"\w* un manojo \w de|strong="H3588"\w* las primeras espigas \w de|strong="H3588"\w* \w su|strong="H3588"\w* cosecha.  
\v 11 El \w sacerdote|strong="H3548"\w* \w mecerá|strong="H5130"\w* el manojo \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé para que la ofrenda les sea aceptada; lo \w mecerá|strong="H5130"\w* el día después del día \w de|strong="H6440"\w* descanso.  
\v 12 \w El|strong="H1121"\w* mismo \w día|strong="H3117"\w* \w que|strong="H3117"\w* mezan \w el|strong="H1121"\w* manojo, \w ofrecerán|strong="H6213"\w* un \w cordero|strong="H3532"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w* y sin defecto como \w holocausto|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé.  
\v 13 Lo acompañarán con una \w ofrenda|strong="H4503"\w* de cereal de \w dos|strong="H8147"\w* kilos de harina fina \w amasada|strong="H1101"\w* con \w aceite|strong="H8081"\w*. Esta será una \w ofrenda|strong="H4503"\w* hecha por fuego, de aroma agradable \w a|strong="H3068"\w* Yahvé. La acompañarán también con una \w ofrenda|strong="H4503"\w* de un litro y medio de \w vino|strong="H3196"\w*. \f + \fr 23:13 \ft Un hin es de unos 6,5 litros.\f*  
\v 14 \w No|strong="H3808"\w* deberán comer \w pan|strong="H3899"\w*, \w ni|strong="H3808"\w* grano \w tostado|strong="H7039"\w*, \w ni|strong="H3808"\w* grano nuevo, \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3808"\w* le lleven \w esta|strong="H2088"\w* \w ofrenda|strong="H7133"\w* \w a|strong="H3068"\w* su Dios. \w Este|strong="H2088"\w* \w será|strong="H3808"\w* un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H5704"\w* sus descendientes, dondequiera \w que|strong="H3808"\w* vivan.   
\p
\v 15 “‘\w A|strong="H3068"\w* partir del \w día|strong="H3117"\w* \w después|strong="H1961"\w* del \w día|strong="H3117"\w* de descanso, \w es|strong="H1961"\w* decir, desde el \w día|strong="H3117"\w* \w en|strong="H8549"\w* \w que|strong="H3117"\w* llevaron el manojo de espigas de la \w ofrenda|strong="H8573"\w* mecida, contarán \w siete|strong="H7651"\w* \w semanas|strong="H7676"\w* completas.  
\v 16 Contarán \w cincuenta|strong="H2572"\w* \w días|strong="H3117"\w* \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w después|strong="H5704"\w* del \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* descanso, \w y|strong="H5704"\w* \w entonces|strong="H3117"\w* le presentarán \w a|strong="H3068"\w* Yahvé una \w ofrenda|strong="H4503"\w* \w de|strong="H5704"\w* grano \w nuevo|strong="H2319"\w*.  
\v 17 Desde \w los|strong="H1961"\w* lugares donde vivan, llevarán \w dos|strong="H8147"\w* \w panes|strong="H3899"\w* \w para|strong="H1961"\w* presentarlos \w como|strong="H1961"\w* \w ofrenda|strong="H8573"\w* mecida. \w Estarán|strong="H1961"\w* hechos con \w dos|strong="H8147"\w* kilos de harina fina\f + \fr 23:17 \ft 1 efa equivale a unos 22 litros\f* y horneados con levadura, \w como|strong="H1961"\w* \w los|strong="H1961"\w* primeros frutos \w para|strong="H1961"\w* Yahvé.  
\v 18 \w Junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w*, \w ofrecerán|strong="H7126"\w* \w siete|strong="H7651"\w* \w corderos|strong="H3532"\w* \w de|strong="H5921"\w* un \w año|strong="H8141"\w* \w y|strong="H5921"\w* sin defecto, un \w toro|strong="H6499"\w* joven \w y|strong="H5921"\w* \w dos|strong="H8147"\w* carneros. \w Todos|strong="H8141"\w* estos \w se|strong="H1961"\w* presentarán \w como|strong="H1961"\w* un \w holocausto|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus ofrendas \w de|strong="H5921"\w* cereal \w y|strong="H5921"\w* ofrendas líquidas; \w será|strong="H1961"\w* una \w ofrenda|strong="H4503"\w* hecha \w por|strong="H5921"\w* fuego, \w de|strong="H5921"\w* aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 19 También \w sacrificarán|strong="H6213"\w* un \w macho|strong="H8163"\w* \w cabrío|strong="H5795"\w* como ofrenda por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w*, y \w dos|strong="H8147"\w* \w corderos|strong="H3532"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w* como \w sacrificio|strong="H2077"\w* \w de|strong="H1121"\w* paz.  
\v 20 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w los|strong="H5921"\w* \w mecerá|strong="H5130"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* primeros frutos \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w corderos|strong="H3532"\w*. Estas ofrendas \w son|strong="H1961"\w* \w sagradas|strong="H6944"\w* \w para|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w le|strong="H5921"\w* pertenecerán \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w*.  
\v 21 \w Ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w* convocarán una asamblea \w santa|strong="H6944"\w* y \w no|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual. \w Este|strong="H2088"\w* \w será|strong="H1961"\w* un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H1961"\w* sus descendientes, dondequiera \w que|strong="H3808"\w* vivan.   
\p
\v 22 “‘Cuando cosechen los \w campos|strong="H7704"\w* de su tierra, \w no|strong="H3808"\w* corten hasta el último rincón del \w campo|strong="H7704"\w*, \w ni|strong="H3808"\w* recojan \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* haya caído de la cosecha. Déjenlo para los pobres y para los \w extranjeros|strong="H1616"\w*. Yo soy Yahvé, su \w Dios|strong="H3068"\w*’”.   
\p
\v 23 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 24 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘\w El|strong="H1121"\w* primer \w día|strong="H1121"\w* del \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w* \w será|strong="H1961"\w* un \w día|strong="H1121"\w* \w de|strong="H1121"\w* descanso absoluto \w para|strong="H1961"\w* ustedes. \w Será|strong="H1961"\w* un \w día|strong="H1121"\w* \w de|strong="H1121"\w* conmemoración, anunciado con toques \w de|strong="H1121"\w* trompeta, y celebrarán una asamblea \w santa|strong="H6944"\w*.  
\v 25 \w No|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual, y le presentarán \w a|strong="H3068"\w* Yahvé una ofrenda hecha por fuego’”.   
\p
\v 26 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 27 “\w El|strong="H1931"\w* \w día|strong="H3117"\w* diez del \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w* \w será|strong="H1961"\w* \w el|strong="H1931"\w* \w Día|strong="H3117"\w* de \w la|strong="H1931"\w* Expiación. Celebrarán una asamblea \w santa|strong="H6944"\w*, ayunarán y \w le|strong="H1931"\w* presentarán \w a|strong="H3068"\w* Yahvé una ofrenda hecha \w por|strong="H2088"\w* fuego.  
\v 28 \w No|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo \w en|strong="H5921"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w Día|strong="H3117"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w Expiación|strong="H3722"\w*, \w cuando|strong="H3588"\w* \w se|strong="H1931"\w* \w hace|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* ustedes \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*.  
\v 29 \w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* ayune \w en|strong="H3588"\w* \w ese|strong="H2088"\w* \w día|strong="H3117"\w* \w será|strong="H3808"\w* eliminado \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 30 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w cualquiera|strong="H3605"\w* \w que|strong="H1931"\w* \w haga|strong="H6213"\w* algún trabajo en \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w yo|strong="H5315"\w* \w lo|strong="H1931"\w* destruiré \w de|strong="H5971"\w* \w entre|strong="H7130"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 31 \w No|strong="H3808"\w* \w harán|strong="H6213"\w* \w ninguna|strong="H3605"\w* clase de trabajo. Este \w será|strong="H3808"\w* un reglamento \w perpetuo|strong="H5769"\w* para sus descendientes, dondequiera \w que|strong="H3808"\w* vivan.  
\v 32 \w Será|strong="H1931"\w* \w para|strong="H5704"\w* ustedes un día \w de|strong="H5704"\w* descanso absoluto \w en|strong="H5704"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* ayunarán. Comenzarán \w su|strong="H1931"\w* descanso \w la|strong="H1931"\w* \w tarde|strong="H6153"\w* del día \w nueve|strong="H8672"\w* del \w mes|strong="H2320"\w*, \w y|strong="H5704"\w* \w lo|strong="H1931"\w* guardarán \w desde|strong="H5704"\w* \w esa|strong="H1931"\w* \w tarde|strong="H6153"\w* \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* \w tarde|strong="H6153"\w* siguiente”.   
\p
\v 33 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 34 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘\w El|strong="H1121"\w* \w día|strong="H3117"\w* \w quince|strong="H2568"\w* del \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w* comienza la \w Fiesta|strong="H2282"\w* \w de|strong="H2568"\w* las Enramadas,\f + \fr 23:34 \ft o, fiesta de los Tabernáculos, o Sucot\f* la cual durará \w siete|strong="H7651"\w* \w días|strong="H3117"\w* en honor \w a|strong="H3068"\w* Yahvé.  
\v 35 \w El|strong="H3605"\w* \w primer|strong="H7223"\w* \w día|strong="H3117"\w* celebrarán una asamblea \w santa|strong="H6944"\w* y \w no|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual.  
\v 36 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w le|strong="H1931"\w* presentarán \w a|strong="H3068"\w* Yahvé ofrendas hechas por fuego. \w El|strong="H1931"\w* \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* celebrarán \w otra|strong="H6213"\w* asamblea \w santa|strong="H6944"\w* y \w le|strong="H1931"\w* presentarán \w a|strong="H3068"\w* Yahvé ofrendas hechas por fuego. \w Será|strong="H1961"\w* una asamblea solemne y \w no|strong="H3808"\w* \w harán|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo habitual.   
\p
\v 37 “‘Estas son las fiestas señaladas \w de|strong="H1697"\w* Yahvé, las cuales ustedes proclamarán como \w asambleas|strong="H4744"\w* \w santas|strong="H6944"\w* para presentar ofrendas hechas \w por|strong="H1697"\w* fuego \w a|strong="H3068"\w* Yahvé —\w holocaustos|strong="H5930"\w*, ofrendas \w de|strong="H1697"\w* cereal, \w sacrificios|strong="H2077"\w* y ofrendas líquidas—, \w cada|strong="H1697"\w* una en su \w día|strong="H3117"\w* indicado.  
\v 38 Estas fiestas son adicionales \w a|strong="H3068"\w* \w los|strong="H3605"\w* días \w de|strong="H5414"\w* descanso \w de|strong="H5414"\w* Yahvé, \w a|strong="H3068"\w* \w los|strong="H3605"\w* regalos \w que|strong="H5071"\w* ustedes le den, \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las promesas \w que|strong="H5071"\w* le hagan y \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w ofrendas|strong="H4979"\w* \w voluntarias|strong="H5071"\w* \w que|strong="H5071"\w* le \w presenten|strong="H5414"\w* \w a|strong="H3068"\w* Yahvé.   
\p
\v 39 “‘Así \w que|strong="H3117"\w* el \w día|strong="H3117"\w* \w quince|strong="H2568"\w* del \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*, después \w de|strong="H2568"\w* haber recogido las cosechas \w de|strong="H2568"\w* la tierra, celebrarán la \w fiesta|strong="H2282"\w* \w de|strong="H2568"\w* Yahvé durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*. El \w primer|strong="H7223"\w* \w día|strong="H3117"\w* será \w de|strong="H2568"\w* descanso absoluto, y el \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* también será \w de|strong="H2568"\w* descanso absoluto.  
\v 40 El \w primer|strong="H7223"\w* \w día|strong="H3117"\w* \w tomarán|strong="H3947"\w* \w frutos|strong="H6529"\w* \w de|strong="H6440"\w* los \w árboles|strong="H6086"\w* más hermosos, ramas \w de|strong="H6440"\w* \w palmeras|strong="H8558"\w*, ramas \w de|strong="H6440"\w* \w árboles|strong="H6086"\w* frondosos y sauces \w de|strong="H6440"\w* los \w arroyos|strong="H5158"\w*, y se alegrarán \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé su \w Dios|strong="H3068"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 41 Celebrarán esta \w fiesta|strong="H2282"\w* en honor \w a|strong="H3068"\w* Yahvé durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w cada|strong="H3117"\w* \w año|strong="H8141"\w*. Este será un reglamento \w perpetuo|strong="H5769"\w* para sus descendientes; la celebrarán en el \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*.  
\v 42 Vivirán en enramadas\f + \fr 23:42 \ft o, tabernáculos\f* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*. \w Todos|strong="H3605"\w* \w los|strong="H3427"\w* israelitas de nacimiento vivirán en enramadas,\f + \fr 23:42 \ft o, tabernáculos\f*  
\v 43 \w para|strong="H4616"\w* \w que|strong="H3588"\w* sus descendientes \w sepan|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* hice \w que|strong="H3588"\w* \w los|strong="H3427"\w* israelitas vivieran \w en|strong="H3588"\w* enramadas\f + \fr 23:43 \ft o, tabernáculos\f* \w cuando|strong="H3588"\w* \w los|strong="H3427"\w* \w saqué|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w Yo|strong="H3588"\w* soy Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*’”.   
\p
\v 44 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* les anunció \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas las fiestas señaladas \w de|strong="H1121"\w* Yahvé.   
\c 24  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “Ordénales \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H1121"\w* te \w traigan|strong="H3947"\w* \w aceite|strong="H8081"\w* \w puro|strong="H2134"\w* \w de|strong="H1121"\w* \w olivas|strong="H2132"\w* machacadas para \w el|strong="H1121"\w* alumbrado, \w a|strong="H3068"\w* fin \w de|strong="H1121"\w* \w que|strong="H1121"\w* las \w lámparas|strong="H5216"\w* ardan \w continuamente|strong="H8548"\w*.  
\v 3 Aarón se encargará \w de|strong="H6440"\w* mantener las lámparas encendidas \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w desde|strong="H5704"\w* la \w tarde|strong="H6153"\w* \w hasta|strong="H5704"\w* la \w mañana|strong="H1242"\w* \w de|strong="H6440"\w* manera \w continua|strong="H8548"\w*. Las lámparas estarán \w fuera|strong="H2351"\w* \w de|strong="H6440"\w* la cortina \w que|strong="H5704"\w* oculta el arca del pacto, \w en|strong="H5704"\w* la Tienda del Encuentro. Este será un reglamento \w perpetuo|strong="H5769"\w* \w para|strong="H5704"\w* sus descendientes.  
\v 4 Aarón deberá mantener \w siempre|strong="H8548"\w* \w en|strong="H5921"\w* orden \w las|strong="H5921"\w* \w lámparas|strong="H5216"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* candelabro \w de|strong="H5921"\w* oro \w puro|strong="H2889"\w*, \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.   
\p
\v 5 “\w Tomarás|strong="H3947"\w* harina fina y hornearás \w doce|strong="H8147"\w* panes, usando alrededor de \w dos|strong="H8147"\w* kilos de harina\f + \fr 24:5 \ft 1 efa son unos 22 litros\f* \w para|strong="H1961"\w* cada pan.  
\v 6 \w Los|strong="H5921"\w* colocarás \w en|strong="H5921"\w* \w dos|strong="H8147"\w* hileras, \w seis|strong="H8337"\w* \w en|strong="H5921"\w* cada hilera, \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w de|strong="H5921"\w* oro \w puro|strong="H2889"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.  
\v 7 \w Pondrás|strong="H5414"\w* \w incienso|strong="H3828"\w* \w puro|strong="H2134"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* cada hilera \w de|strong="H5921"\w* \w pan|strong="H3899"\w*. \w El|strong="H5921"\w* \w incienso|strong="H3828"\w* \w servirá|strong="H1961"\w* \w como|strong="H1961"\w* ofrenda memorial, una ofrenda hecha \w por|strong="H5921"\w* fuego \w a|strong="H3068"\w* Yahvé.  
\v 8 \w Cada|strong="H3117"\w* \w día|strong="H3117"\w* \w de|strong="H6440"\w* descanso, \w el|strong="H1121"\w* sacerdote deberá colocar \w el|strong="H1121"\w* pan en orden \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w de|strong="H6440"\w* manera \w continua|strong="H8548"\w*. Es una ofrenda \w de|strong="H6440"\w* parte \w de|strong="H6440"\w* \w los|strong="H1121"\w* israelitas como un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*.  
\v 9 \w El|strong="H1931"\w* pan \w le|strong="H1931"\w* pertenecerá \w a|strong="H3068"\w* Aarón \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w*, quienes \w se|strong="H1961"\w* \w lo|strong="H1931"\w* comerán \w en|strong="H3588"\w* un \w lugar|strong="H4725"\w* \w sagrado|strong="H6944"\w*. \w De|strong="H3588"\w* las ofrendas hechas \w por|strong="H3588"\w* fuego \w a|strong="H3068"\w* Yahvé, \w esta|strong="H1931"\w* \w será|strong="H1961"\w* \w la|strong="H1931"\w* porción \w más|strong="H3588"\w* \w santa|strong="H6944"\w* \w para|strong="H3588"\w* \w ellos|strong="H1931"\w*, \w por|strong="H3588"\w* reglamento \w perpetuo|strong="H5769"\w*”.   
\p
\v 10 Hubo un pleito \w en|strong="H8432"\w* \w el|strong="H1931"\w* \w campamento|strong="H4264"\w* \w entre|strong="H8432"\w* un \w israelita|strong="H3482"\w* y \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* una mujer \w israelita|strong="H3482"\w* \w cuyo|strong="H1931"\w* padre \w era|strong="H1931"\w* \w egipcio|strong="H4713"\w*.  
\v 11 En medio del pleito, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* la mujer \w israelita|strong="H3482"\w* blasfemó \w el|strong="H1121"\w* \w Nombre|strong="H8034"\w* \w de|strong="H1121"\w* Yahvé y lo \w maldijo|strong="H7043"\w*, por lo \w que|strong="H1121"\w* lo llevaron ante \w Moisés|strong="H4872"\w*. La madre \w de|strong="H1121"\w* este \w hombre|strong="H1121"\w* se \w llamaba|strong="H8034"\w* Selomit, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Dibri, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Dan|strong="H1835"\w*.  
\v 12 \w Lo|strong="H5921"\w* \w pusieron|strong="H3240"\w* bajo vigilancia \w hasta|strong="H5921"\w* \w que|strong="H5921"\w* Yahvé \w les|strong="H1992"\w* declarara \w qué|strong="H5921"\w* debían hacer.  
\v 13 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 14 “\w Saca|strong="H3318"\w* \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w al|strong="H5921"\w* hombre \w que|strong="H5921"\w* \w maldijo|strong="H7043"\w* \w mi|strong="H5921"\w* nombre. \w Que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* \w escucharon|strong="H8085"\w* \w pongan|strong="H5564"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*, \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w lo|strong="H5921"\w* mate \w a|strong="H3068"\w* pedradas.  
\v 15 \w Además|strong="H3588"\w*, \w diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘Cualquiera \w que|strong="H3588"\w* maldiga \w a|strong="H3068"\w* \w su|strong="H3588"\w* Dios cargará \w con|strong="H3588"\w* \w su|strong="H3588"\w* \w culpa|strong="H2399"\w*.  
\v 16 \w Cualquiera|strong="H3605"\w* \w que|strong="H1616"\w* blasfeme \w el|strong="H3605"\w* \w nombre|strong="H8034"\w* de Yahvé será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*; \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w lo|strong="H3605"\w* \w matará|strong="H4191"\w* \w a|strong="H3068"\w* pedradas. \w Ya|strong="H3068"\w* sea \w extranjero|strong="H1616"\w* \w o|strong="H3068"\w* israelita de nacimiento, \w el|strong="H3605"\w* \w que|strong="H1616"\w* blasfeme \w el|strong="H3605"\w* \w Nombre|strong="H8034"\w* deberá \w morir|strong="H4191"\w*.   
\p
\v 17 “‘\w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* le quite \w la|strong="H3588"\w* \w vida|strong="H5315"\w* \w a|strong="H3068"\w* otra \w persona|strong="H5315"\w* será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.  
\v 18 Cualquiera que mate el \w animal|strong="H5315"\w* \w de|strong="H8478"\w* otra \w persona|strong="H5315"\w* \w deberá|strong="H7999"\w* pagarle un \w animal|strong="H5315"\w* vivo para reemplazar el que \w mató|strong="H5221"\w*.  
\v 19 \w Si|strong="H3588"\w* alguien lastima \w a|strong="H3068"\w* \w su|strong="H3588"\w* prójimo, \w se|strong="H3651"\w* le \w hará|strong="H6213"\w* \w a|strong="H3068"\w* \w él|strong="H3588"\w* \w lo|strong="H6213"\w* mismo \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w hizo|strong="H6213"\w*:  
\v 20 fractura \w por|strong="H8478"\w* fractura, \w ojo|strong="H5869"\w* \w por|strong="H8478"\w* \w ojo|strong="H5869"\w*, \w diente|strong="H8127"\w* \w por|strong="H8478"\w* \w diente|strong="H8127"\w*. La misma \w lesión|strong="H3971"\w* que \w le|strong="H5869"\w* \w haya|strong="H3971"\w* causado \w a|strong="H3068"\w* la otra persona, \w se|strong="H3651"\w* \w le|strong="H5869"\w* causará \w a|strong="H3068"\w* él.  
\v 21 Así que, el que \w mate|strong="H4191"\w* un animal \w deberá|strong="H7999"\w* reponerlo, pero el que \w mate|strong="H4191"\w* \w a|strong="H3068"\w* una persona será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.  
\v 22 \w Este|strong="H1961"\w* reglamento aplicará \w por|strong="H3588"\w* igual tanto \w para|strong="H3588"\w* \w el|strong="H3588"\w* \w extranjero|strong="H1616"\w* \w como|strong="H3588"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* israelita \w de|strong="H3588"\w* nacimiento, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*’”.   
\p
\v 23 \w Moisés|strong="H4872"\w* \w les|strong="H6680"\w* comunicó todo \w esto|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, y ellos \w sacaron|strong="H3318"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w* al \w hombre|strong="H1121"\w* \w que|strong="H1121"\w* \w había|strong="H6213"\w* maldecido \w el|strong="H1121"\w* Nombre y \w lo|strong="H6213"\w* mataron \w a|strong="H3068"\w* pedradas. \w Así|strong="H7043"\w* \w que|strong="H1121"\w* \w los|strong="H1121"\w* israelitas \w hicieron|strong="H6213"\w* todo tal como Yahvé se \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.   
\c 25  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* en el \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* ustedes entren \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* les \w doy|strong="H5414"\w*, \w la|strong="H3588"\w* tierra deberá tener un año \w de|strong="H3588"\w* \w reposo|strong="H7673"\w* dedicado \w a|strong="H3068"\w* Yahvé.  
\v 3 Durante \w seis|strong="H8337"\w* \w años|strong="H8141"\w* \w sembrarás|strong="H2232"\w* tu \w campo|strong="H7704"\w*, \w podarás|strong="H2168"\w* tu viñedo y recogerás sus \w frutos|strong="H8393"\w*,  
\v 4 pero el \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w* \w será|strong="H1961"\w* un \w año|strong="H8141"\w* de reposo absoluto \w para|strong="H1961"\w* la tierra, un \w año|strong="H8141"\w* de reposo dedicado \w a|strong="H3068"\w* Yahvé. \w No|strong="H3808"\w* \w sembrarás|strong="H2232"\w* tu \w campo|strong="H7704"\w* \w ni|strong="H3808"\w* \w podarás|strong="H2168"\w* tu viñedo.  
\v 5 \w Tampoco|strong="H3808"\w* cosecharás \w lo|strong="H3808"\w* \w que|strong="H3808"\w* crezca por \w sí|strong="H3808"\w* solo de tu cosecha, \w ni|strong="H3808"\w* recogerás las \w uvas|strong="H6025"\w* de tu viñedo \w sin|strong="H3808"\w* podar. \w Será|strong="H1961"\w* un \w año|strong="H8141"\w* de descanso absoluto \w para|strong="H1961"\w* la tierra.  
\v 6 Lo \w que|strong="H1961"\w* la tierra produzca por \w sí|strong="H1961"\w* misma durante su reposo \w servirá|strong="H1961"\w* \w de|strong="H5973"\w* alimento \w para|strong="H1961"\w* \w ti|strong="H5973"\w*, \w para|strong="H1961"\w* tus esclavos y esclavas, \w para|strong="H1961"\w* tus jornaleros y \w para|strong="H1961"\w* \w los|strong="H1961"\w* extranjeros \w que|strong="H1961"\w* vivan \w contigo|strong="H5973"\w*.  
\v 7 \w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* produzca \w la|strong="H3605"\w* tierra también \w servirá|strong="H1961"\w* de alimento \w para|strong="H1961"\w* tu ganado y \w para|strong="H1961"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* silvestres de tu tierra.   
\p
\v 8 “‘Contarás \w siete|strong="H7651"\w* \w años|strong="H8141"\w* de reposo, \w es|strong="H1961"\w* decir, \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w*. Ese período de \w siete|strong="H7651"\w* \w años|strong="H8141"\w* de reposo te dará un total de cuarenta y \w nueve|strong="H8672"\w* \w años|strong="H8141"\w*.  
\v 9 \w Entonces|strong="H3117"\w*, \w el|strong="H3605"\w* \w día|strong="H3117"\w* diez del \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*, harás sonar \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w* por \w todas|strong="H3605"\w* partes. Ese \w día|strong="H3117"\w*, \w que|strong="H3117"\w* es \w el|strong="H3605"\w* \w Día|strong="H3117"\w* de \w la|strong="H3605"\w* Expiación, tocarán \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w* por \w toda|strong="H3605"\w* su tierra.  
\v 10 Consagrarán \w el|strong="H1931"\w* \w año|strong="H8141"\w* \w cincuenta|strong="H2572"\w* y proclamarán \w libertad|strong="H1865"\w* en \w todo|strong="H3605"\w* \w el|strong="H1931"\w* país \w para|strong="H1961"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* \w habitantes|strong="H3427"\w*. \w Será|strong="H1961"\w* un \w año|strong="H8141"\w* de \w jubileo|strong="H3104"\w* \w para|strong="H1961"\w* ustedes, en \w el|strong="H1931"\w* \w que|strong="H1931"\w* \w cada|strong="H3605"\w* uno \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* propiedad familiar y \w a|strong="H3068"\w* \w su|strong="H1931"\w* propia \w familia|strong="H4940"\w*.  
\v 11 \w Ese|strong="H1931"\w* \w año|strong="H8141"\w* \w cincuenta|strong="H2572"\w* \w será|strong="H1961"\w* un \w año|strong="H8141"\w* de \w jubileo|strong="H3104"\w* \w para|strong="H1961"\w* ustedes. Durante \w ese|strong="H1931"\w* \w año|strong="H8141"\w* \w no|strong="H3808"\w* sembrarán, \w ni|strong="H3808"\w* cosecharán \w lo|strong="H1931"\w* \w que|strong="H1931"\w* crezca por \w sí|strong="H3808"\w* \w solo|strong="H1931"\w*, \w ni|strong="H3808"\w* recogerán las uvas de \w los|strong="H1931"\w* \w viñedos|strong="H5139"\w* \w sin|strong="H3808"\w* podar.  
\v 12 \w Porque|strong="H3588"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w jubileo|strong="H3104"\w*, \w y|strong="H3588"\w* \w será|strong="H1961"\w* \w sagrado|strong="H6944"\w* \w para|strong="H3588"\w* ustedes. \w Solo|strong="H1931"\w* comerán \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w campo|strong="H7704"\w* produzca \w por|strong="H3588"\w* \w sí|strong="H3588"\w* \w mismo|strong="H1931"\w*.   
\p
\v 13 “‘En \w este|strong="H2063"\w* \w año|strong="H8141"\w* de \w jubileo|strong="H3104"\w* \w cada|strong="H8141"\w* uno de ustedes \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* su propiedad familiar.   
\p
\v 14 “‘\w Si|strong="H3588"\w* le vendes \w algo|strong="H4465"\w* \w a|strong="H3068"\w* tu prójimo \w o|strong="H3068"\w* le compras \w algo|strong="H4465"\w*, \w no|strong="H3588"\w* se perjudiquen ni se engañen \w el|strong="H3588"\w* uno al otro.  
\v 15 Cuando le compres tierras \w a|strong="H3068"\w* tu prójimo, el precio se fijará de acuerdo con el \w número|strong="H4557"\w* de \w años|strong="H8141"\w* que hayan pasado desde el último \w jubileo|strong="H3104"\w*. El precio de venta se basará en el \w número|strong="H4557"\w* de \w años|strong="H8141"\w* de cosecha que falten para el próximo \w jubileo|strong="H3104"\w*.  
\v 16 \w Si|strong="H3588"\w* faltan \w muchos|strong="H7235"\w* \w años|strong="H8141"\w*, \w el|strong="H1931"\w* precio \w será|strong="H1931"\w* \w mayor|strong="H3588"\w*, \w pero|strong="H3588"\w* \w si|strong="H3588"\w* faltan \w pocos|strong="H4557"\w*, \w el|strong="H1931"\w* precio \w será|strong="H1931"\w* \w menor|strong="H4591"\w*, \w porque|strong="H3588"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w en|strong="H3588"\w* realidad \w te|strong="H3588"\w* \w está|strong="H1931"\w* vendiendo \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w número|strong="H4557"\w* \w de|strong="H3588"\w* cosechas.  
\v 17 \w No|strong="H3808"\w* \w se|strong="H3808"\w* opriman unos \w a|strong="H3068"\w* otros, \w sino|strong="H3588"\w* \w teman|strong="H3372"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. \w Yo|strong="H3588"\w* soy Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.   
\p
\v 18 “‘\w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H5921"\w*, pongan \w en|strong="H5921"\w* práctica mis reglamentos \w y|strong="H5921"\w* cumplan mis leyes. Así vivirán seguros \w en|strong="H5921"\w* su tierra.  
\v 19 \w La|strong="H5921"\w* tierra producirá sus \w frutos|strong="H6529"\w*, ustedes comerán \w hasta|strong="H5921"\w* quedar satisfechos \w y|strong="H5921"\w* vivirán seguros \w en|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 20 Tal vez \w se|strong="H3808"\w* pregunten: “¿\w Qué|strong="H3588"\w* comeremos \w el|strong="H3588"\w* \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w* \w si|strong="H3588"\w* \w no|strong="H3808"\w* sembramos \w ni|strong="H3808"\w* recogemos nuestras cosechas?”.  
\v 21 \w Pues|strong="H1293"\w* bien, \w el|strong="H6213"\w* \w sexto|strong="H8345"\w* \w año|strong="H8141"\w* \w les|strong="H6680"\w* enviaré tal \w bendición|strong="H1293"\w* que la tierra producirá cosechas suficientes para \w tres|strong="H7969"\w* \w años|strong="H8141"\w*.  
\v 22 \w Cuando|strong="H5704"\w* siembren \w en|strong="H4480"\w* el \w octavo|strong="H8066"\w* \w año|strong="H8141"\w*, todavía estarán comiendo \w de|strong="H4480"\w* la cosecha anterior, \w y|strong="H5704"\w* seguirán comiendo \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w hasta|strong="H5704"\w* el \w noveno|strong="H8671"\w* \w año|strong="H8141"\w*, \w cuando|strong="H5704"\w* llegue la nueva cosecha.   
\p
\v 23 “‘\w La|strong="H3588"\w* tierra \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w venderá|strong="H4376"\w* \w de|strong="H3588"\w* forma permanente, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w es|strong="H3588"\w* mía; ustedes \w son|strong="H3588"\w* solo \w extranjeros|strong="H1616"\w* \w y|strong="H3588"\w* huéspedes míos.  
\v 24 \w Por|strong="H5414"\w* \w lo|strong="H3605"\w* tanto, en \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país \w que|strong="H3605"\w* ustedes posean deberán garantizar \w el|strong="H3605"\w* derecho \w de|strong="H5414"\w* rescatar \w la|strong="H3605"\w* tierra.   
\p
\v 25 “‘\w Si|strong="H3588"\w* uno \w de|strong="H3588"\w* tus hermanos se empobrece \w y|strong="H3588"\w* tiene \w que|strong="H3588"\w* vender parte \w de|strong="H3588"\w* \w su|strong="H3588"\w* propiedad, \w su|strong="H3588"\w* \w pariente|strong="H1350"\w* \w más|strong="H3588"\w* \w cercano|strong="H7138"\w* \w podrá|strong="H4376"\w* venir \w y|strong="H3588"\w* comprar lo \w que|strong="H3588"\w* \w su|strong="H3588"\w* hermano haya vendido, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* propiedad vuelva \w a|strong="H3068"\w* \w la|strong="H3588"\w* familia.  
\v 26 \w Si|strong="H3588"\w* \w no|strong="H3808"\w* \w hay|strong="H1961"\w* \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* pueda rescatar \w la|strong="H3588"\w* propiedad, \w pero|strong="H3588"\w* \w el|strong="H3588"\w* hombre prospera \w y|strong="H3588"\w* consigue dinero suficiente \w para|strong="H3588"\w* comprarla \w de|strong="H3588"\w* nuevo,  
\v 27 \w calculará|strong="H2803"\w* los \w años|strong="H8141"\w* que han pasado desde la venta y le devolverá la diferencia al hombre \w a|strong="H3068"\w* quien se la \w vendió|strong="H4376"\w*. De esta manera recuperará su propiedad.  
\v 28 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* consigue dinero suficiente \w para|strong="H5704"\w* recuperarla, la propiedad \w quedará|strong="H1961"\w* \w en|strong="H5704"\w* \w manos|strong="H3027"\w* del comprador \w hasta|strong="H5704"\w* el \w año|strong="H8141"\w* \w de|strong="H5704"\w* \w jubileo|strong="H3104"\w*. \w En|strong="H5704"\w* el \w jubileo|strong="H3104"\w* la propiedad \w quedará|strong="H1961"\w* libre, \w y|strong="H5704"\w* el hombre recuperará su tierra.   
\p
\v 29 “‘\w Si|strong="H3588"\w* alguien \w vende|strong="H4376"\w* una \w casa|strong="H1004"\w* \w de|strong="H3588"\w* vivienda \w en|strong="H5704"\w* una \w ciudad|strong="H5892"\w* rodeada \w de|strong="H3588"\w* murallas, \w tendrá|strong="H1961"\w* \w el|strong="H3588"\w* derecho \w de|strong="H3588"\w* rescatarla durante un \w año|strong="H8141"\w* completo \w a|strong="H3068"\w* partir \w de|strong="H3588"\w* \w la|strong="H3588"\w* fecha \w de|strong="H3588"\w* venta. Solo \w tendrá|strong="H1961"\w* derecho \w de|strong="H3588"\w* rescate durante ese \w año|strong="H8141"\w*.  
\v 30 \w Si|strong="H3808"\w* la \w casa|strong="H1004"\w* \w en|strong="H5704"\w* la \w ciudad|strong="H5892"\w* amurallada \w no|strong="H3808"\w* es rescatada \w antes|strong="H5704"\w* \w de|strong="H5704"\w* cumplirse el \w año|strong="H8141"\w*, \w pasará|strong="H3318"\w* \w a|strong="H3068"\w* ser propiedad definitiva del comprador \w y|strong="H5704"\w* \w de|strong="H5704"\w* sus descendientes. \w No|strong="H3808"\w* \w quedará|strong="H6965"\w* libre \w en|strong="H5704"\w* el \w año|strong="H8141"\w* \w de|strong="H5704"\w* \w jubileo|strong="H3104"\w*.  
\v 31 Sin embargo, \w las|strong="H1992"\w* \w casas|strong="H1004"\w* \w en|strong="H5921"\w* \w las|strong="H1992"\w* \w aldeas|strong="H2691"\w* \w que|strong="H5921"\w* \w no|strong="H1961"\w* \w tienen|strong="H1992"\w* murallas \w se|strong="H1961"\w* considerarán igual \w que|strong="H5921"\w* \w los|strong="H1992"\w* \w campos|strong="H7704"\w* abiertos; podrán ser rescatadas \w y|strong="H5921"\w* quedarán libres \w en|strong="H5921"\w* \w el|strong="H5921"\w* año \w de|strong="H5921"\w* \w jubileo|strong="H3104"\w*.   
\p
\v 32 “‘En cuanto \w a|strong="H3068"\w* las \w ciudades|strong="H5892"\w* de \w los|strong="H1961"\w* \w levitas|strong="H3881"\w*, ellos \w tendrán|strong="H1961"\w* \w siempre|strong="H5769"\w* el derecho de rescatar las \w casas|strong="H1004"\w* en las \w ciudades|strong="H5892"\w* \w que|strong="H1961"\w* les pertenecen.  
\v 33 \w Si|strong="H3588"\w* un \w levita|strong="H3881"\w* \w no|strong="H3588"\w* rescata \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w que|strong="H3588"\w* \w vendió|strong="H4465"\w* \w en|strong="H4480"\w* \w su|strong="H1931"\w* \w ciudad|strong="H5892"\w*, \w de|strong="H4480"\w* todas maneras \w la|strong="H1931"\w* \w casa|strong="H1004"\w* quedará libre \w en|strong="H4480"\w* \w el|strong="H1931"\w* año \w de|strong="H4480"\w* \w jubileo|strong="H3104"\w*, \w porque|strong="H3588"\w* las \w casas|strong="H1004"\w* \w en|strong="H4480"\w* las \w ciudades|strong="H5892"\w* \w levitas|strong="H3881"\w* \w son|strong="H3588"\w* \w su|strong="H1931"\w* propiedad exclusiva \w entre|strong="H8432"\w* \w los|strong="H1121"\w* israelitas.  
\v 34 \w Sin|strong="H3808"\w* embargo, \w los|strong="H3588"\w* \w campos|strong="H7704"\w* \w de|strong="H3588"\w* pastoreo \w que|strong="H3588"\w* rodean \w sus|strong="H1931"\w* \w ciudades|strong="H5892"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* podrán vender, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w su|strong="H1931"\w* posesión permanente.   
\p
\v 35 “‘\w Si|strong="H3588"\w* uno \w de|strong="H3588"\w* tus hermanos se empobrece \w y|strong="H3588"\w* \w no|strong="H3588"\w* puede mantenerse \w por|strong="H3588"\w* \w sí|strong="H3588"\w* mismo \w entre|strong="H5973"\w* ustedes, deberás ayudarlo, \w y|strong="H3588"\w* \w vivirá|strong="H2421"\w* \w contigo|strong="H5973"\w* \w como|strong="H3588"\w* \w si|strong="H3588"\w* fuera un \w extranjero|strong="H1616"\w* \w o|strong="H3068"\w* un huésped.  
\v 36 No \w le|strong="H5973"\w* cobres intereses \w ni|strong="H5973"\w* trates \w de|strong="H5973"\w* sacarle provecho. \w Teme|strong="H3372"\w* \w a|strong="H3068"\w* tu Dios y permite que tu hermano siga viviendo \w entre|strong="H5973"\w* ustedes.  
\v 37 \w No|strong="H3808"\w* le prestes \w dinero|strong="H3701"\w* con intereses \w ni|strong="H3808"\w* le \w des|strong="H5414"\w* comida buscando ganancia.  
\v 38 Yo \w soy|strong="H1961"\w* Yahvé, su \w Dios|strong="H3068"\w*, quien \w los|strong="H1961"\w* \w sacó|strong="H3318"\w* \w de|strong="H5414"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5414"\w* darles la tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w* y \w para|strong="H5414"\w* ser su \w Dios|strong="H3068"\w*.   
\p
\v 39 “‘\w Si|strong="H3588"\w* uno \w de|strong="H3588"\w* tus hermanos \w se|strong="H3808"\w* empobrece \w y|strong="H3588"\w* tiene \w que|strong="H3588"\w* venderse \w a|strong="H3068"\w* \w ti|strong="H5973"\w*, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* hagas trabajar \w como|strong="H3588"\w* esclavo.  
\v 40 \w Lo|strong="H5704"\w* tratarás \w como|strong="H5973"\w* \w a|strong="H3068"\w* un trabajador contratado \w o|strong="H3068"\w* \w como|strong="H5973"\w* \w a|strong="H3068"\w* un huésped, \w y|strong="H5704"\w* trabajará \w para|strong="H5704"\w* \w ti|strong="H5973"\w* \w hasta|strong="H5704"\w* \w el|strong="H5973"\w* \w año|strong="H8141"\w* \w de|strong="H5973"\w* \w jubileo|strong="H3104"\w*.  
\v 41 \w En|strong="H5973"\w* \w ese|strong="H1931"\w* año quedará libre \w de|strong="H5973"\w* \w ti|strong="H5973"\w*, \w él|strong="H1931"\w* y \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w*, y \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* propia \w familia|strong="H4940"\w* y \w a|strong="H3068"\w* \w la|strong="H1931"\w* propiedad \w de|strong="H5973"\w* \w sus|strong="H1931"\w* antepasados.  
\v 42 \w Porque|strong="H3588"\w* \w los|strong="H1992"\w* israelitas \w son|strong="H3588"\w* mis \w siervos|strong="H5650"\w*, \w los|strong="H1992"\w* \w que|strong="H3588"\w* \w saqué|strong="H3318"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w No|strong="H3808"\w* deben ser \w vendidos|strong="H4376"\w* \w como|strong="H3588"\w* esclavos comunes.  
\v 43 \w No|strong="H3808"\w* \w lo|strong="H3808"\w* tratarás con dureza, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w temerás|strong="H3372"\w* \w a|strong="H3068"\w* tu Dios.   
\p
\v 44 “‘Sin embargo, puedes comprar esclavos y esclavas de \w las|strong="H1992"\w* \w naciones|strong="H1471"\w* vecinas.  
\v 45 \w También|strong="H1571"\w* puedes comprar \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w los|strong="H1992"\w* \w extranjeros|strong="H1121"\w* \w que|strong="H1571"\w* vivan \w entre|strong="H5973"\w* ustedes, \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* familiares \w de|strong="H5973"\w* \w aquellos|strong="H1992"\w* \w que|strong="H1571"\w* hayan \w nacido|strong="H3205"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* país. \w Ellos|strong="H1992"\w* pasarán \w a|strong="H3068"\w* ser propiedad tuya.  
\v 46 Podrán dejarlos como herencia para sus \w hijos|strong="H1121"\w*, y serán sus esclavos para \w siempre|strong="H5769"\w*. Pero \w ninguno|strong="H3808"\w* \w de|strong="H1121"\w* ustedes deberá tratar con dureza \w a|strong="H3068"\w* sus compatriotas israelitas.   
\p
\v 47 “‘\w Si|strong="H3588"\w* un \w extranjero|strong="H1616"\w* \w o|strong="H3068"\w* huésped \w que|strong="H3588"\w* vive \w entre|strong="H5973"\w* ustedes se enriquece, \w y|strong="H3588"\w* uno \w de|strong="H3588"\w* tus compatriotas se empobrece \w y|strong="H3588"\w* se \w vende|strong="H4376"\w* \w a|strong="H3068"\w* ese \w extranjero|strong="H1616"\w* \w o|strong="H3068"\w* \w a|strong="H3068"\w* algún pariente \w de|strong="H3588"\w* \w él|strong="H5973"\w*,  
\v 48 el israelita conservará el derecho \w a|strong="H3068"\w* ser rescatado \w después|strong="H1961"\w* de haberse vendido. Cualquiera de sus hermanos \w podrá|strong="H4376"\w* rescatarlo.  
\v 49 También podrán rescatarlo su \w tío|strong="H1730"\w*, su primo \w o|strong="H3068"\w* cualquier otro \w pariente|strong="H1350"\w* cercano \w de|strong="H1121"\w* su \w familia|strong="H4940"\w*. \w O|strong="H3068"\w* si \w el|strong="H1121"\w* \w hombre|strong="H1121"\w* llega \w a|strong="H3068"\w* prosperar, \w él|strong="H1121"\w* mismo podrá pagar \w por|strong="H3027"\w* su libertad.  
\v 50 \w Él|strong="H5973"\w* \w y|strong="H5704"\w* su comprador calcularán \w el|strong="H5973"\w* \w tiempo|strong="H3117"\w* transcurrido \w desde|strong="H5704"\w* \w el|strong="H5973"\w* \w año|strong="H8141"\w* \w en|strong="H5973"\w* \w que|strong="H5704"\w* \w se|strong="H1961"\w* \w vendió|strong="H4376"\w* \w hasta|strong="H5704"\w* \w el|strong="H5973"\w* \w año|strong="H8141"\w* \w de|strong="H5973"\w* \w jubileo|strong="H3104"\w*. \w El|strong="H5973"\w* \w precio|strong="H3701"\w* \w de|strong="H5973"\w* su libertad \w se|strong="H1961"\w* basará \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w número|strong="H4557"\w* \w de|strong="H5973"\w* \w años|strong="H8141"\w*, \w y|strong="H5704"\w* su \w tiempo|strong="H3117"\w* \w de|strong="H5973"\w* servicio \w se|strong="H1961"\w* \w calculará|strong="H2803"\w* \w como|strong="H5973"\w* \w si|strong="H1961"\w* hubiera \w sido|strong="H1961"\w* un trabajador \w a|strong="H3068"\w* sueldo.  
\v 51 Si \w todavía|strong="H5750"\w* faltan \w muchos|strong="H7227"\w* \w años|strong="H8141"\w* para el jubileo, el \w precio|strong="H3701"\w* \w de|strong="H5750"\w* su rescate será \w en|strong="H5750"\w* proporción \w a|strong="H3068"\w* esos \w años|strong="H8141"\w* y devolverá una \w gran|strong="H7227"\w* parte \w de|strong="H5750"\w* lo \w que|strong="H6310"\w* \w pagaron|strong="H7725"\w* \w por|strong="H5750"\w* él.  
\v 52 Si faltan \w pocos|strong="H4592"\w* \w años|strong="H8141"\w* \w para|strong="H5704"\w* el \w jubileo|strong="H3104"\w*, \w harán|strong="H2803"\w* el cálculo \w y|strong="H5704"\w* pagará \w por|strong="H5704"\w* su rescate \w en|strong="H5704"\w* proporción \w a|strong="H3068"\w* los \w años|strong="H8141"\w* \w que|strong="H5704"\w* le faltaban \w por|strong="H5704"\w* servir.  
\v 53 Deberá ser tratado \w como|strong="H5973"\w* un trabajador contratado \w año|strong="H8141"\w* \w tras|strong="H5973"\w* \w año|strong="H8141"\w*, y tú \w no|strong="H3808"\w* permitirás \w que|strong="H3808"\w* su amo extranjero \w lo|strong="H3808"\w* trate \w con|strong="H5973"\w* dureza.  
\v 54 \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* rescatado \w de|strong="H5973"\w* \w ninguna|strong="H3808"\w* \w de|strong="H5973"\w* estas maneras, \w de|strong="H5973"\w* \w todos|strong="H8141"\w* modos quedará \w en|strong="H5973"\w* libertad \w en|strong="H5973"\w* \w el|strong="H1931"\w* \w año|strong="H8141"\w* \w de|strong="H5973"\w* \w jubileo|strong="H3104"\w*, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w*.  
\v 55 \w Porque|strong="H3588"\w* \w los|strong="H1992"\w* israelitas \w son|strong="H3588"\w* mis \w siervos|strong="H5650"\w*; \w son|strong="H3588"\w* \w los|strong="H1992"\w* \w siervos|strong="H5650"\w* \w que|strong="H3588"\w* \w saqué|strong="H3318"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w Yo|strong="H3588"\w* soy Yahvé, \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*.   
\c 26  
\p
\v 1 “‘\w No|strong="H3808"\w* \w se|strong="H5921"\w* \w hagan|strong="H6213"\w* ídolos, \w ni|strong="H3808"\w* levanten imágenes talladas \w ni|strong="H3808"\w* piedras sagradas. \w No|strong="H3808"\w* pongan \w en|strong="H5921"\w* \w su|strong="H3588"\w* tierra piedras grabadas \w para|strong="H5921"\w* inclinarse ante \w ellas|strong="H5921"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.   
\p
\v 2 “‘\w Guarden|strong="H8104"\w* mis días \w de|strong="H3372"\w* descanso y muestren respeto por mi \w santuario|strong="H4720"\w*. Yo soy Yahvé.   
\p
\v 3 “‘Si ustedes viven de acuerdo con mis reglamentos, y obedecen y ponen \w en|strong="H3212"\w* práctica mis \w mandamientos|strong="H4687"\w*,  
\v 4 yo les enviaré las \w lluvias|strong="H1653"\w* \w a|strong="H3068"\w* su debido \w tiempo|strong="H6256"\w*. La tierra \w dará|strong="H5414"\w* sus cosechas y los \w árboles|strong="H6086"\w* del \w campo|strong="H7704"\w* \w darán|strong="H5414"\w* su \w fruto|strong="H6529"\w*.  
\v 5 Tendrán tanto que trillar que seguirán trillando hasta \w el|strong="H3427"\w* tiempo de la recolección de uvas, y la recolección de uvas durará hasta \w el|strong="H3427"\w* tiempo de la \w siembra|strong="H2233"\w*. Comerán hasta quedar satisfechos y vivirán seguros en su tierra.   
\p
\v 6 “‘\w Yo|strong="H4480"\w* traeré \w paz|strong="H7965"\w* \w al|strong="H4480"\w* país, y ustedes podrán dormir \w sin|strong="H3808"\w* \w que|strong="H4480"\w* \w nadie|strong="H3808"\w* los asuste. Quitaré \w del|strong="H4480"\w* país \w a|strong="H3068"\w* los \w animales|strong="H2416"\w* salvajes, y \w ninguna|strong="H3808"\w* guerra \w pasará|strong="H5674"\w* \w por|strong="H4480"\w* la tierra \w de|strong="H4480"\w* ustedes.  
\v 7 \w Perseguirán|strong="H7291"\w* \w a|strong="H3068"\w* sus enemigos, y ellos \w caerán|strong="H5307"\w* \w a|strong="H3068"\w* filo \w de|strong="H6440"\w* \w espada|strong="H2719"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes.  
\v 8 \w Cinco|strong="H2568"\w* \w de|strong="H4480"\w* ustedes \w perseguirán|strong="H7291"\w* \w a|strong="H3068"\w* \w cien|strong="H3967"\w*, y \w cien|strong="H3967"\w* \w de|strong="H4480"\w* ustedes \w perseguirán|strong="H7291"\w* \w a|strong="H3068"\w* diez \w mil|strong="H7233"\w*, y sus enemigos \w caerán|strong="H5307"\w* \w a|strong="H3068"\w* filo \w de|strong="H4480"\w* \w espada|strong="H2719"\w* \w delante|strong="H6440"\w* \w de|strong="H4480"\w* ustedes.   
\p
\v 9 “‘Yo los \w miraré|strong="H6437"\w* con agrado, los haré muy fecundos, \w multiplicaré|strong="H7235"\w* su descendencia y mantendré \w firme|strong="H6965"\w* mi \w pacto|strong="H1285"\w* con ustedes.  
\v 10 Comerán \w de|strong="H6440"\w* las cosechas del año anterior, y tendrán que sacar lo viejo para hacerle espacio \w a|strong="H3068"\w* lo \w nuevo|strong="H2319"\w*.  
\v 11 \w Pondré|strong="H5414"\w* \w mi|strong="H5315"\w* santuario \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5414"\w* ustedes, y \w nunca|strong="H3808"\w* los rechazaré.  
\v 12 \w Caminaré|strong="H1980"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5971"\w* ustedes; yo \w seré|strong="H1961"\w* su Dios y ustedes \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*.  
\v 13 Yo \w soy|strong="H1961"\w* Yahvé su \w Dios|strong="H3068"\w*, quien \w los|strong="H1961"\w* \w sacó|strong="H3318"\w* de \w Egipto|strong="H4714"\w* \w para|strong="H1961"\w* \w que|strong="H1961"\w* ya \w no|strong="H1961"\w* fueran esclavos. Yo rompí el \w yugo|strong="H5923"\w* \w que|strong="H1961"\w* \w los|strong="H1961"\w* oprimía y \w los|strong="H1961"\w* hice caminar con la cabeza \w en|strong="H3318"\w* alto.   
\p
\v 14 “‘Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* me \w escuchan|strong="H8085"\w* y \w no|strong="H3808"\w* \w obedecen|strong="H8085"\w* \w todos|strong="H3605"\w* \w estos|strong="H3605"\w* \w mandamientos|strong="H4687"\w*,  
\v 15 \w si|strong="H5315"\w* rechazan mis reglamentos, desprecian mis leyes, desobedecen mis \w mandamientos|strong="H4687"\w* y rompen \w mi|strong="H5315"\w* \w pacto|strong="H1285"\w*,  
\v 16 entonces \w yo|strong="H5315"\w* \w haré|strong="H6213"\w* \w lo|strong="H5921"\w* siguiente \w con|strong="H5921"\w* ustedes: Traeré \w sobre|strong="H5921"\w* ustedes terror, tuberculosis \w y|strong="H5921"\w* fiebre, males \w que|strong="H5921"\w* \w les|strong="H5921"\w* consumirán \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w y|strong="H5921"\w* \w les|strong="H5921"\w* marchitarán \w la|strong="H5921"\w* \w vida|strong="H5315"\w*. Sembrarán sus semillas \w en|strong="H5921"\w* vano, \w porque|strong="H5921"\w* sus enemigos \w se|strong="H5921"\w* comerán \w las|strong="H5921"\w* cosechas.  
\v 17 Me \w pondré|strong="H5414"\w* en \w contra|strong="H6440"\w* \w de|strong="H6440"\w* ustedes, y sus \w enemigos|strong="H8130"\w* \w los|strong="H7291"\w* derrotarán. \w Los|strong="H7291"\w* que \w los|strong="H7291"\w* odian gobernarán sobre ustedes, y ustedes huirán aunque nadie \w los|strong="H7291"\w* \w persiga|strong="H7291"\w*.   
\p
\v 18 “‘\w Si|strong="H3808"\w* \w a|strong="H3068"\w* pesar \w de|strong="H5921"\w* esto \w no|strong="H3808"\w* \w me|strong="H5921"\w* \w obedecen|strong="H8085"\w*, \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w siete|strong="H7651"\w* \w veces|strong="H7651"\w* \w más|strong="H3254"\w* \w por|strong="H5921"\w* sus \w pecados|strong="H2403"\w*.  
\v 19 \w Quebraré|strong="H7665"\w* el orgullo que tienen \w de|strong="H5414"\w* su poder, \w y|strong="H5797"\w* \w haré|strong="H5414"\w* que el \w cielo|strong="H8064"\w* sea tan duro como el \w hierro|strong="H1270"\w* \w y|strong="H5797"\w* la tierra tan dura como el bronce.  
\v 20 Ustedes gastarán sus \w fuerzas|strong="H3581"\w* en vano, \w porque|strong="H3808"\w* su tierra \w no|strong="H3808"\w* les \w dará|strong="H5414"\w* \w ninguna|strong="H3808"\w* cosecha \w ni|strong="H3808"\w* los \w árboles|strong="H6086"\w* les \w darán|strong="H5414"\w* su \w fruto|strong="H6529"\w*.   
\p
\v 21 “‘\w Si|strong="H3808"\w* siguen rebelándose \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* quieren escucharme, \w les|strong="H5973"\w* enviaré \w siete|strong="H7651"\w* \w veces|strong="H7651"\w* \w más|strong="H3254"\w* \w plagas|strong="H4347"\w* \w por|strong="H5921"\w* causa \w de|strong="H5921"\w* sus \w pecados|strong="H2403"\w*.  
\v 22 \w Enviaré|strong="H7971"\w* \w animales|strong="H2416"\w* salvajes que los atacarán, les arrebatarán \w a|strong="H3068"\w* sus hijos, destruirán su ganado y reducirán la población de ustedes hasta que los \w caminos|strong="H1870"\w* queden desiertos.   
\p
\v 23 “‘\w Si|strong="H3808"\w* después \w de|strong="H5973"\w* todos estos castigos ustedes \w no|strong="H3808"\w* \w se|strong="H3808"\w* vuelven \w a|strong="H3068"\w* mí, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w siguen|strong="H1980"\w* rebelándose,  
\v 24 yo \w también|strong="H1571"\w* \w me|strong="H5921"\w* rebelaré \w contra|strong="H5921"\w* ustedes \w y|strong="H1571"\w* \w los|strong="H5921"\w* castigaré \w siete|strong="H7651"\w* \w veces|strong="H7651"\w* \w más|strong="H1571"\w* \w por|strong="H5921"\w* sus \w pecados|strong="H2403"\w*.  
\v 25 Traeré \w contra|strong="H5921"\w* ustedes ejércitos enemigos \w que|strong="H5921"\w* ejecutarán \w la|strong="H5921"\w* \w venganza|strong="H5359"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pacto|strong="H1285"\w*. Cuando ustedes \w se|strong="H5921"\w* refugien \w en|strong="H5921"\w* sus \w ciudades|strong="H5892"\w*, \w enviaré|strong="H7971"\w* plagas \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* ustedes \w y|strong="H5921"\w* caerán \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w del|strong="H5921"\w* enemigo.  
\v 26 Destruiré su suministro \w de|strong="H7646"\w* \w alimentos|strong="H3899"\w*. Habrá tanta escasez \w que|strong="H3808"\w* \w diez|strong="H6235"\w* mujeres podrán hornear el \w pan|strong="H3899"\w* en un solo \w horno|strong="H8574"\w* y \w se|strong="H3808"\w* \w lo|strong="H3808"\w* repartirán por \w peso|strong="H4948"\w*. Ustedes comerán, pero \w no|strong="H3808"\w* quedarán satisfechos.   
\p
\v 27 “‘\w Si|strong="H3808"\w* \w a|strong="H3068"\w* pesar \w de|strong="H5973"\w* todo \w esto|strong="H2063"\w* todavía \w no|strong="H3808"\w* \w me|strong="H5973"\w* \w escuchan|strong="H8085"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w siguen|strong="H1980"\w* rebelándose,  
\v 28 entonces \w me|strong="H5921"\w* enfrentaré \w a|strong="H3068"\w* ustedes \w con|strong="H5973"\w* mucha \w ira|strong="H2534"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w castigaré|strong="H3256"\w* \w siete|strong="H7651"\w* \w veces|strong="H7651"\w* \w más|strong="H5921"\w* \w por|strong="H5921"\w* sus \w pecados|strong="H2403"\w*.  
\v 29 Llegarán \w a|strong="H3068"\w* tal extremo \w que|strong="H1121"\w* se comerán la \w carne|strong="H1320"\w* \w de|strong="H1121"\w* sus propios \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 30 \w Destruiré|strong="H8045"\w* sus santuarios paganos, derribaré sus \w altares|strong="H1116"\w* \w de|strong="H5921"\w* incienso \w y|strong="H5921"\w* arrojaré sus cadáveres \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w cuerpos|strong="H6297"\w* sin \w vida|strong="H5315"\w* \w de|strong="H5921"\w* sus \w ídolos|strong="H1544"\w*. \w Yo|strong="H5315"\w* mismo \w los|strong="H5921"\w* rechazaré \w por|strong="H5921"\w* completo.  
\v 31 Dejaré sus \w ciudades|strong="H5892"\w* en ruinas y destruiré sus santuarios, y ya \w no|strong="H3808"\w* aceptaré el aroma agradable \w de|strong="H5414"\w* sus ofrendas.  
\v 32 Yo mismo asolaré su tierra, \w a|strong="H3068"\w* tal punto \w que|strong="H5921"\w* sus enemigos \w que|strong="H5921"\w* vengan \w a|strong="H3068"\w* ocuparla \w se|strong="H5921"\w* \w quedarán|strong="H3427"\w* asombrados.  
\v 33 \w Los|strong="H1961"\w* \w esparciré|strong="H2219"\w* \w a|strong="H3068"\w* ustedes entre las \w naciones|strong="H1471"\w* y \w los|strong="H1961"\w* perseguiré con la \w espada|strong="H2719"\w* desenvainada. Su tierra \w quedará|strong="H1961"\w* \w desolada|strong="H8077"\w* y sus \w ciudades|strong="H5892"\w* en ruinas.  
\v 34 \w Entonces|strong="H3117"\w* \w la|strong="H3605"\w* tierra disfrutará de sus \w años|strong="H3117"\w* de \w reposo|strong="H7673"\w* \w mientras|strong="H3605"\w* esté desolada y ustedes estén en \w la|strong="H3605"\w* tierra de sus enemigos. Por fin \w la|strong="H3605"\w* tierra \w descansará|strong="H7676"\w* y disfrutará de \w los|strong="H3605"\w* \w años|strong="H3117"\w* de \w reposo|strong="H7673"\w*.  
\v 35 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H3808"\w* \w la|strong="H5921"\w* tierra esté desolada tendrá \w el|strong="H5921"\w* descanso \w que|strong="H3808"\w* ustedes \w no|strong="H3808"\w* \w le|strong="H5921"\w* dieron durante \w los|strong="H3427"\w* \w años|strong="H3117"\w* \w de|strong="H5921"\w* \w reposo|strong="H7673"\w* \w cuando|strong="H3117"\w* \w vivían|strong="H3427"\w* allí.   
\p
\v 36 “‘\w A|strong="H3068"\w* \w los|strong="H7291"\w* que sobrevivan en las tierras enemigas, les infundiré tal cobardía en \w el|strong="H5307"\w* \w corazón|strong="H3824"\w* que \w el|strong="H5307"\w* simple \w ruido|strong="H6963"\w* de una hoja arrastrada \w por|strong="H5127"\w* \w el|strong="H5307"\w* viento \w los|strong="H7291"\w* hará huir. Huirán como si \w los|strong="H7291"\w* persiguieran con una \w espada|strong="H2719"\w*, y \w caerán|strong="H5307"\w* aunque nadie \w los|strong="H7291"\w* \w persiga|strong="H7291"\w*.  
\v 37 \w Tropezarán|strong="H3782"\w* unos con otros \w como|strong="H1961"\w* \w si|strong="H3808"\w* huyeran \w de|strong="H6440"\w* una batalla, \w aunque|strong="H3808"\w* \w no|strong="H3808"\w* \w haya|strong="H1961"\w* \w nadie|strong="H3808"\w* persiguiéndolos. \w No|strong="H3808"\w* \w tendrán|strong="H1961"\w* fuerzas \w para|strong="H1961"\w* hacerles frente \w a|strong="H3068"\w* sus enemigos.  
\v 38 Morirán en las \w naciones|strong="H1471"\w* extranjeras y la tierra de sus enemigos se los tragará.  
\v 39 Los sobrevivientes se pudrirán en las tierras enemigas por causa de sus propios \w pecados|strong="H5771"\w* y también por los \w pecados|strong="H5771"\w* de sus antepasados.   
\p
\v 40 “‘Pero si confiesan sus propios \w pecados|strong="H5771"\w* y \w los|strong="H5973"\w* \w pecados|strong="H5771"\w* \w de|strong="H5973"\w* sus antepasados, si reconocen que \w fueron|strong="H1980"\w* infieles y que se rebelaron \w contra|strong="H5973"\w* mí,  
\v 41 lo \w cual|strong="H5973"\w* \w me|strong="H5973"\w* obligó \w a|strong="H3068"\w* rebelarme \w contra|strong="H5973"\w* ellos y \w a|strong="H3068"\w* enviarlos \w a|strong="H3068"\w* la tierra \w de|strong="H5973"\w* sus enemigos, y si por fin su terco \w corazón|strong="H3824"\w* se humilla y aceptan \w el|strong="H5973"\w* castigo por sus \w pecados|strong="H5771"\w*,  
\v 42 entonces yo me acordaré de mi \w pacto|strong="H1285"\w* con \w Jacob|strong="H3290"\w*, de mi \w pacto|strong="H1285"\w* con \w Isaac|strong="H3327"\w* y de mi \w pacto|strong="H1285"\w* con Abraham. También me acordaré de la tierra.  
\v 43 \w Porque|strong="H3282"\w* la tierra deberá \w ser|strong="H5315"\w* \w abandonada|strong="H5800"\w* \w por|strong="H3282"\w* \w ellos|strong="H1992"\w* \w para|strong="H3282"\w* \w que|strong="H1992"\w* pueda disfrutar de \w sus|strong="H1992"\w* años de reposo mientras esté desolada. \w Ellos|strong="H1992"\w* tendrán \w que|strong="H1992"\w* pagar \w por|strong="H3282"\w* \w sus|strong="H1992"\w* \w pecados|strong="H5771"\w*, \w porque|strong="H3282"\w* despreciaron mis leyes y rechazaron mis reglamentos.  
\v 44 \w A|strong="H3068"\w* pesar \w de|strong="H3588"\w* todo, \w mientras|strong="H3588"\w* \w estén|strong="H1961"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* país \w de|strong="H3588"\w* sus enemigos, \w no|strong="H3808"\w* \w los|strong="H1961"\w* rechazaré \w por|strong="H3588"\w* completo \w ni|strong="H3808"\w* \w los|strong="H1961"\w* destruiré, \w porque|strong="H3588"\w* \w eso|strong="H2063"\w* anularía \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* \w con|strong="H3588"\w* \w ellos|strong="H1571"\w*. \w Yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 45 \w A|strong="H3068"\w* favor \w de|strong="H5869"\w* ellos, me acordaré del \w pacto|strong="H1285"\w* \w que|strong="H1961"\w* hice con sus antepasados, \w a|strong="H3068"\w* quienes \w saqué|strong="H3318"\w* \w de|strong="H5869"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* la vista \w de|strong="H5869"\w* todas las \w naciones|strong="H1471"\w*, \w para|strong="H1961"\w* ser su \w Dios|strong="H3068"\w*. Yo \w soy|strong="H1961"\w* Yahvé’”.   
\p
\v 46 Estos son \w los|strong="H1121"\w* reglamentos, \w leyes|strong="H8451"\w* \w e|strong="H3068"\w* instrucciones \w que|strong="H1121"\w* Yahvé \w estableció|strong="H5414"\w* entre \w él|strong="H1121"\w* y \w los|strong="H1121"\w* israelitas en \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w*, \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*.   
\c 27  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w y|strong="H3588"\w* \w diles|strong="H1696"\w*: ‘\w Cuando|strong="H3588"\w* alguien haga una promesa especial \w para|strong="H3588"\w* dedicar \w a|strong="H3068"\w* una \w persona|strong="H5315"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3588"\w* valor \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w persona|strong="H5315"\w* se calculará \w de|strong="H3588"\w* \w la|strong="H3588"\w* siguiente manera:  
\v 3 \w Si|strong="H1961"\w* \w es|strong="H1961"\w* un \w hombre|strong="H1121"\w* \w de|strong="H5704"\w* \w veinte|strong="H6242"\w* \w a|strong="H3068"\w* \w sesenta|strong="H8346"\w* \w años|strong="H8141"\w*, su valor \w se|strong="H1961"\w* calculará \w en|strong="H5704"\w* \w cincuenta|strong="H2572"\w* \w monedas|strong="H3701"\w* \w de|strong="H5704"\w* \w plata|strong="H3701"\w*, según \w el|strong="H1121"\w* peso oficial del \w santuario|strong="H6944"\w*.\f + \fr 27:3 \ft Un siclo equivale a unos 10 gramos.\f*  
\v 4 \w Si|strong="H1931"\w* \w es|strong="H1931"\w* una mujer de \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* edad, \w el|strong="H1931"\w* valor \w será|strong="H1961"\w* de \w treinta|strong="H7970"\w* monedas de plata.  
\v 5 \w Si|strong="H1961"\w* \w es|strong="H1961"\w* un joven \w de|strong="H5704"\w* \w cinco|strong="H2568"\w* \w a|strong="H3068"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w*, \w el|strong="H1121"\w* valor \w será|strong="H1961"\w* \w de|strong="H5704"\w* \w veinte|strong="H6242"\w* monedas \w de|strong="H5704"\w* plata, \w y|strong="H5704"\w* \w si|strong="H1961"\w* \w es|strong="H1961"\w* una joven, \w será|strong="H1961"\w* \w de|strong="H5704"\w* \w diez|strong="H6235"\w* monedas.  
\v 6 \w Si|strong="H1961"\w* \w es|strong="H1961"\w* un niño \w de|strong="H5704"\w* un \w mes|strong="H2320"\w* \w a|strong="H3068"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w*, \w el|strong="H1121"\w* valor \w será|strong="H1961"\w* \w de|strong="H5704"\w* \w cinco|strong="H2568"\w* \w monedas|strong="H3701"\w* \w de|strong="H5704"\w* \w plata|strong="H3701"\w*, \w y|strong="H5704"\w* \w si|strong="H1961"\w* \w es|strong="H1961"\w* una niña, \w será|strong="H1961"\w* \w de|strong="H5704"\w* \w tres|strong="H7969"\w* \w monedas|strong="H3701"\w*.  
\v 7 \w Si|strong="H1961"\w* \w es|strong="H1961"\w* un \w hombre|strong="H1121"\w* \w de|strong="H2568"\w* \w sesenta|strong="H8346"\w* \w años|strong="H8141"\w* \w o|strong="H3068"\w* más, \w el|strong="H1121"\w* valor \w será|strong="H1961"\w* \w de|strong="H2568"\w* \w quince|strong="H2568"\w* monedas \w de|strong="H2568"\w* plata, y \w si|strong="H1961"\w* \w es|strong="H1961"\w* una mujer, \w será|strong="H1961"\w* \w de|strong="H2568"\w* \w diez|strong="H6235"\w* monedas.  
\v 8 Pero \w si|strong="H1931"\w* \w la|strong="H1931"\w* \w persona|strong="H6440"\w* \w es|strong="H1931"\w* demasiado pobre \w para|strong="H5921"\w* pagar \w la|strong="H1931"\w* cantidad establecida, deberá presentarse \w ante|strong="H6440"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w*, \w y|strong="H5921"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* fijará un valor diferente, dependiendo \w de|strong="H5921"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* pueda pagar \w la|strong="H1931"\w* \w persona|strong="H6440"\w* \w que|strong="H1931"\w* hizo \w la|strong="H1931"\w* \w promesa|strong="H5087"\w*.   
\p
\v 9 “‘\w Si|strong="H1961"\w* \w lo|strong="H3605"\w* \w que|strong="H4480"\w* \w se|strong="H1961"\w* promete \w es|strong="H1961"\w* un animal \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w que|strong="H4480"\w* \w se|strong="H1961"\w* le pueden ofrecer \w a|strong="H3068"\w* Yahvé, ese animal \w será|strong="H1961"\w* considerado \w santo|strong="H6944"\w*.  
\v 10 \w No|strong="H3808"\w* \w se|strong="H1961"\w* \w podrá|strong="H3808"\w* cambiar por otro animal, \w ni|strong="H3808"\w* uno \w bueno|strong="H2896"\w* por uno \w malo|strong="H7451"\w*, \w ni|strong="H3808"\w* uno \w malo|strong="H7451"\w* por uno \w bueno|strong="H2896"\w*. \w Si|strong="H3808"\w* alguien llegara \w a|strong="H3068"\w* cambiar un animal por otro, ambos animales quedarán consagrados \w a|strong="H3068"\w* Yahvé.  
\v 11 \w Si|strong="H3808"\w* \w se|strong="H4480"\w* trata \w de|strong="H4480"\w* un animal impuro \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w se|strong="H4480"\w* pueden ofrecer \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* dueño deberá llevarlo \w ante|strong="H6440"\w* \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w*,  
\v 12 y el \w sacerdote|strong="H3548"\w* calculará su valor, ya \w sea|strong="H1961"\w* \w bueno|strong="H2896"\w* \w o|strong="H3068"\w* \w malo|strong="H7451"\w*. El precio \w será|strong="H1961"\w* el \w que|strong="H1961"\w* fije el \w sacerdote|strong="H3548"\w*.  
\v 13 \w Si|strong="H5921"\w* \w el|strong="H5921"\w* dueño quiere recuperar \w el|strong="H5921"\w* animal, tendrá \w que|strong="H5921"\w* pagar \w el|strong="H5921"\w* precio fijado \w más|strong="H3254"\w* una quinta parte \w como|strong="H5921"\w* recargo.   
\p
\v 14 “‘\w Si|strong="H3588"\w* alguien consagra \w su|strong="H3588"\w* \w casa|strong="H1004"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* calculará \w el|strong="H3588"\w* valor \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w*, ya sea \w buena|strong="H2896"\w* \w o|strong="H3068"\w* \w mala|strong="H7451"\w*. \w El|strong="H3588"\w* precio será \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* determine.  
\v 15 \w Si|strong="H1961"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* consagró desea recuperarla, \w tendrá|strong="H1961"\w* \w que|strong="H5921"\w* pagar \w el|strong="H5921"\w* \w precio|strong="H3701"\w* fijado \w más|strong="H3254"\w* una quinta parte \w de|strong="H5921"\w* recargo, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* ser suya.   
\p
\v 16 “‘\w Si|strong="H1961"\w* alguien dedica \w a|strong="H3068"\w* Yahvé una parte de \w los|strong="H1961"\w* \w campos|strong="H7704"\w* de su propiedad familiar, el valor \w se|strong="H1961"\w* calculará de acuerdo con la cantidad de semilla \w que|strong="H1961"\w* \w se|strong="H1961"\w* necesite \w para|strong="H1961"\w* sembrarlo. La \w siembra|strong="H2233"\w* de un costal grande de \w cebada|strong="H8184"\w*\f + \fr 27:16 \ft 1 homer equivale a unos 220 litros.\f* \w se|strong="H1961"\w* calculará en \w cincuenta|strong="H2572"\w* \w monedas|strong="H3701"\w* de \w plata|strong="H3701"\w*.  
\v 17 Si el hombre dedica su \w campo|strong="H7704"\w* durante el \w año|strong="H8141"\w* del \w jubileo|strong="H3104"\w*, el precio completo de la valoración se mantendrá.  
\v 18 Pero \w si|strong="H5921"\w* dedica su \w campo|strong="H7704"\w* \w después|strong="H5921"\w* \w del|strong="H5921"\w* \w jubileo|strong="H3104"\w*, \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w calculará|strong="H2803"\w* \w el|strong="H5921"\w* valor dependiendo \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w años|strong="H8141"\w* \w que|strong="H5921"\w* falten \w para|strong="H5704"\w* \w el|strong="H5921"\w* próximo \w jubileo|strong="H3104"\w*, \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w precio|strong="H3701"\w* total \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w hará|strong="H6310"\w* un descuento.  
\v 19 \w Si|strong="H5921"\w* \w el|strong="H5921"\w* hombre desea recuperar su \w campo|strong="H7704"\w*, tendrá \w que|strong="H5921"\w* pagar \w el|strong="H5921"\w* \w precio|strong="H3701"\w* fijado \w más|strong="H3254"\w* una quinta parte \w de|strong="H5921"\w* recargo, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* seguirá siendo suyo.  
\v 20 \w Si|strong="H3808"\w* decide \w no|strong="H3808"\w* recuperarlo, \w o|strong="H3068"\w* \w si|strong="H3808"\w* ya \w se|strong="H3808"\w* \w lo|strong="H3808"\w* \w ha|strong="H3808"\w* vendido \w a|strong="H3068"\w* \w otro|strong="H5750"\w*, el \w campo|strong="H7704"\w* \w jamás|strong="H5750"\w* \w podrá|strong="H3808"\w* ser recuperado.  
\v 21 \w Cuando|strong="H1961"\w* el \w campo|strong="H7704"\w* \w quede|strong="H1961"\w* libre \w en|strong="H3318"\w* el año del \w jubileo|strong="H3104"\w*, \w será|strong="H1961"\w* considerado \w como|strong="H1961"\w* un \w campo|strong="H7704"\w* \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé de manera permanente y \w pasará|strong="H3318"\w* \w a|strong="H3068"\w* ser propiedad de \w los|strong="H1961"\w* \w sacerdotes|strong="H3548"\w*.   
\p
\v 22 “‘\w Si|strong="H3808"\w* alguien consagra \w a|strong="H3068"\w* Yahvé un \w campo|strong="H7704"\w* \w que|strong="H3808"\w* \w ha|strong="H3808"\w* \w comprado|strong="H4736"\w*, y \w que|strong="H3808"\w* \w no|strong="H3808"\w* es parte de su propiedad familiar,  
\v 23 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w calculará|strong="H2803"\w* \w el|strong="H1931"\w* precio \w de|strong="H5704"\w* \w la|strong="H1931"\w* valoración \w en|strong="H5704"\w* proporción \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w años|strong="H8141"\w* \w que|strong="H1931"\w* falten \w para|strong="H5704"\w* \w el|strong="H1931"\w* \w jubileo|strong="H3104"\w*. \w El|strong="H1931"\w* hombre deberá pagar \w esa|strong="H1931"\w* cantidad \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* \w como|strong="H5704"\w* algo \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé.  
\v 24 En el \w año|strong="H8141"\w* del \w jubileo|strong="H3104"\w*, el \w campo|strong="H7704"\w* \w volverá|strong="H7725"\w* al que lo vendió originalmente, es decir, al dueño de la propiedad familiar.  
\v 25 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* precios \w se|strong="H1961"\w* calcularán según \w el|strong="H3605"\w* peso oficial del \w santuario|strong="H6944"\w*, donde \w cada|strong="H3605"\w* moneda de plata equivale \w a|strong="H3068"\w* \w veinte|strong="H6242"\w* \w geras|strong="H1626"\w*.\f + \fr 27:25 \ft Un siclo equivale a veinte geras.\f*   
\p
\v 26 “‘\w Nadie|strong="H3808"\w* \w podrá|strong="H3808"\w* consagrar \w el|strong="H1931"\w* primer hijo de un animal, \w porque|strong="H3808"\w* las primeras crías, sean \w vacas|strong="H7794"\w* u ovejas, ya \w le|strong="H1931"\w* pertenecen \w a|strong="H3068"\w* Yahvé.  
\v 27 \w Si|strong="H3808"\w* \w se|strong="H5921"\w* trata \w de|strong="H5921"\w* un animal impuro, \w el|strong="H5921"\w* dueño \w podrá|strong="H3808"\w* recuperarlo pagando \w el|strong="H5921"\w* precio fijado \w más|strong="H3254"\w* una quinta parte \w de|strong="H5921"\w* recargo. \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* recupera, \w el|strong="H5921"\w* animal \w podrá|strong="H3808"\w* ser vendido \w por|strong="H5921"\w* \w el|strong="H5921"\w* precio fijado.   
\p
\v 28 “‘\w Sin|strong="H3808"\w* embargo, \w nada|strong="H3808"\w* de \w lo|strong="H1931"\w* \w que|strong="H1931"\w* una persona consagre \w a|strong="H3068"\w* Yahvé para destrucción total \w podrá|strong="H4376"\w* ser vendido \w ni|strong="H3808"\w* recuperado, ya sean personas, animales \w o|strong="H3068"\w* \w campos|strong="H7704"\w* de \w su|strong="H1931"\w* propiedad familiar. \w Todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* entrega para destrucción total \w es|strong="H1931"\w* \w santísimo|strong="H6944"\w*, \w pues|strong="H1931"\w* \w le|strong="H1931"\w* pertenece exclusivamente \w a|strong="H3068"\w* Yahvé.   
\p
\v 29 “‘\w Ninguna|strong="H3605"\w* persona \w consagrada|strong="H2764"\w* \w para|strong="H4480"\w* destrucción total \w podrá|strong="H3808"\w* ser rescatada. Deberá ser condenada \w a|strong="H3068"\w* \w muerte|strong="H4191"\w* \w sin|strong="H3808"\w* falta.   
\p
\v 30 “‘\w La|strong="H1931"\w* \w décima|strong="H4643"\w* parte de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* productos de \w la|strong="H1931"\w* tierra, ya sean cereales \w o|strong="H3068"\w* frutas, \w le|strong="H1931"\w* pertenece \w a|strong="H3068"\w* Yahvé y \w es|strong="H1931"\w* algo \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* \w él|strong="H1931"\w*.  
\v 31 \w Si|strong="H5921"\w* alguien desea recuperar alguna parte \w de|strong="H5921"\w* su diezmo, tendrá \w que|strong="H5921"\w* pagar su valor \w más|strong="H3254"\w* una quinta parte \w de|strong="H5921"\w* recargo.  
\v 32 Uno \w de|strong="H8478"\w* \w cada|strong="H3605"\w* diez animales del \w ganado|strong="H6629"\w* \w o|strong="H3068"\w* del \w rebaño|strong="H6629"\w* \w que|strong="H1961"\w* pasen \w bajo|strong="H8478"\w* \w la|strong="H3605"\w* \w vara|strong="H7626"\w* del pastor \w para|strong="H1961"\w* ser contados \w será|strong="H1961"\w* \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé.  
\v 33 \w El|strong="H1931"\w* dueño \w no|strong="H3808"\w* debe ponerse \w a|strong="H3068"\w* buscar \w si|strong="H3808"\w* \w el|strong="H1931"\w* animal \w es|strong="H1931"\w* \w bueno|strong="H2896"\w* \w o|strong="H3068"\w* \w malo|strong="H7451"\w*, \w ni|strong="H3808"\w* debe cambiarlo. \w Si|strong="H3808"\w* \w lo|strong="H1931"\w* llega \w a|strong="H3068"\w* cambiar, tanto \w el|strong="H1931"\w* primer animal \w como|strong="H1961"\w* \w su|strong="H1931"\w* sustituto quedarán consagrados y \w no|strong="H3808"\w* podrán ser recuperados’”.   
\p
\v 34 Estos son \w los|strong="H1121"\w* \w mandamientos|strong="H4687"\w* \w que|strong="H1121"\w* Yahvé le entregó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* en \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* para \w los|strong="H1121"\w* israelitas.   