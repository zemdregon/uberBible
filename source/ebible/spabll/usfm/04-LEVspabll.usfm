\v 9 Sus \w hijos|strong="H1121"\w* \w le|strong="H5921"\w* acercaron \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*; \w él|strong="H5921"\w* mojó su dedo \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*, untó \w los|strong="H1121"\w* \w cuernos|strong="H7161"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* \w derramó|strong="H3332"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w al|strong="H5921"\w* \w pie|strong="H3247"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 10 Pero la grasa, los \w riñones|strong="H3629"\w* y la parte superior \w del|strong="H4480"\w* \w hígado|strong="H3516"\w* \w de|strong="H4480"\w* la ofrenda \w por|strong="H4480"\w* el \w pecado|strong="H2403"\w*, los quemó \w en|strong="H4480"\w* el \w altar|strong="H4196"\w*, tal como Yahvé \w se|strong="H4480"\w* lo había \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.  
