\c 5  
\p
\v 1 “‘\w Si|strong="H3588"\w* alguien \w peca|strong="H2398"\w* al \w escuchar|strong="H8085"\w* un juramento público \w para|strong="H3588"\w* testificar, \w siendo|strong="H1931"\w* \w él|strong="H1931"\w* \w testigo|strong="H5707"\w* \w de|strong="H3588"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w ha|strong="H3808"\w* \w visto|strong="H7200"\w* \w o|strong="H3068"\w* sabido, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* denuncia, \w entonces|strong="H3588"\w* cargará \w con|strong="H3588"\w* \w su|strong="H1931"\w* culpa.   
\p
\v 2 “‘\w O|strong="H3068"\w* \w si|strong="H1931"\w* alguien \w toca|strong="H5060"\w* \w algo|strong="H1697"\w* impuro, ya sea \w el|strong="H1931"\w* cadáver \w de|strong="H4480"\w* un \w animal|strong="H2416"\w* salvaje, \w o|strong="H3068"\w* \w el|strong="H1931"\w* cadáver \w de|strong="H4480"\w* un \w animal|strong="H2416"\w* doméstico, \w o|strong="H3068"\w* \w el|strong="H1931"\w* cadáver \w de|strong="H4480"\w* un \w reptil|strong="H8318"\w* impuro, aunque no \w se|strong="H1931"\w* \w dé|strong="H4480"\w* \w cuenta|strong="H1697"\w* \w de|strong="H4480"\w* \w ello|strong="H1931"\w*, \w si|strong="H1931"\w* \w se|strong="H1931"\w* contamina, entonces \w será|strong="H1931"\w* culpable.   
\p
\v 3 “‘\w O|strong="H3068"\w* \w si|strong="H3588"\w* \w toca|strong="H5060"\w* \w la|strong="H1931"\w* impureza \w de|strong="H4480"\w* un ser humano, \w cualquier|strong="H3605"\w* impureza \w con|strong="H4480"\w* \w la|strong="H1931"\w* \w que|strong="H3588"\w* pueda contaminarse, \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w se|strong="H3045"\w* da cuenta; \w cuando|strong="H3588"\w* \w lo|strong="H1931"\w* \w sepa|strong="H3045"\w*, \w entonces|strong="H3588"\w* \w será|strong="H1931"\w* culpable.   
\p
\v 4 “‘\w O|strong="H3068"\w* \w si|strong="H3588"\w* alguien \w jura|strong="H7650"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* ligera \w con|strong="H4480"\w* \w sus|strong="H1931"\w* \w labios|strong="H8193"\w* \w para|strong="H3588"\w* hacer \w el|strong="H1931"\w* \w mal|strong="H7489"\w* \w o|strong="H3068"\w* \w para|strong="H3588"\w* hacer \w el|strong="H1931"\w* \w bien|strong="H3190"\w*, \w cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* \w que|strong="H3588"\w* una \w persona|strong="H5315"\w* pueda decir sin pensar mediante un \w juramento|strong="H7621"\w*, \w y|strong="H3588"\w* \w le|strong="H1931"\w* pasa inadvertido; \w cuando|strong="H3588"\w* \w se|strong="H3045"\w* \w dé|strong="H4480"\w* cuenta, \w entonces|strong="H3588"\w* \w será|strong="H1931"\w* culpable \w de|strong="H4480"\w* una \w de|strong="H4480"\w* estas \w cosas|strong="H3045"\w*.  
\v 5 \w Cuando|strong="H3588"\w* \w sea|strong="H1961"\w* culpable \w de|strong="H5921"\w* una \w de|strong="H5921"\w* estas cosas, deberá confesar aquello \w en|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* ha \w pecado|strong="H2398"\w*;  
\v 6 \w y|strong="H5921"\w* \w le|strong="H5921"\w* traerá \w a|strong="H3068"\w* Yahvé su ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa debido \w al|strong="H5921"\w* \w pecado|strong="H2403"\w* \w que|strong="H4480"\w* \w cometió|strong="H2398"\w*: una \w hembra|strong="H5347"\w* \w del|strong="H4480"\w* \w rebaño|strong="H6629"\w*, oveja \w o|strong="H3068"\w* \w cabra|strong="H5795"\w*, \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*; \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w* respecto \w a|strong="H3068"\w* su \w pecado|strong="H2403"\w*.   
\p
\v 7 “‘\w Si|strong="H3808"\w* \w no|strong="H3808"\w* le alcanza para comprar un \w cordero|strong="H7716"\w*, entonces traerá \w a|strong="H3068"\w* Yahvé, \w como|strong="H5060"\w* ofrenda \w por|strong="H3027"\w* la culpa del \w pecado|strong="H2403"\w* \w que|strong="H3808"\w* \w cometió|strong="H2398"\w*, \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones; uno para la ofrenda \w por|strong="H3027"\w* \w el|strong="H1121"\w* \w pecado|strong="H2403"\w* y \w el|strong="H1121"\w* otro para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*.  
\v 8 Los llevará al \w sacerdote|strong="H3548"\w*, quien \w ofrecerá|strong="H7126"\w* \w primero|strong="H7223"\w* el \w que|strong="H3808"\w* es para la ofrenda por el \w pecado|strong="H2403"\w*. Le romperá el cuello \w a|strong="H3068"\w* la altura de la \w cabeza|strong="H7218"\w*, pero \w sin|strong="H3808"\w* separar la \w cabeza|strong="H7218"\w* por completo.  
\v 9 \w Rociará|strong="H5137"\w* un poco \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* \w a|strong="H3068"\w* un lado \w del|strong="H5921"\w* \w altar|strong="H4196"\w*, \w y|strong="H5921"\w* \w el|strong="H1931"\w* resto \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w se|strong="H1931"\w* exprimirá \w al|strong="H5921"\w* \w pie|strong="H3247"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*. \w Es|strong="H1931"\w* una ofrenda \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*.  
\v 10 \w Ofrecerá|strong="H6213"\w* \w la|strong="H5921"\w* \w segunda|strong="H8145"\w* ave \w como|strong="H5921"\w* \w holocausto|strong="H5930"\w*, \w conforme|strong="H5921"\w* \w al|strong="H5921"\w* reglamento. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w que|strong="H5921"\w* \w cometió|strong="H2398"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* persona \w será|strong="H6213"\w* perdonada.   
\p
\v 11 “‘\w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3808"\w* \w tiene|strong="H1931"\w* recursos \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* pichones, \w entonces|strong="H3588"\w* traerá \w como|strong="H3588"\w* \w ofrenda|strong="H7133"\w* \w por|strong="H5921"\w* \w su|strong="H1931"\w* \w pecado|strong="H2403"\w* \w la|strong="H1931"\w* décima parte \w de|strong="H5921"\w* un efa \w de|strong="H5921"\w* harina fina \w como|strong="H3588"\w* \w ofrenda|strong="H7133"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*. \w No|strong="H3808"\w* \w le|strong="H1931"\w* \w pondrá|strong="H5414"\w* \w aceite|strong="H8081"\w* \w ni|strong="H3808"\w* \w incienso|strong="H3828"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* una \w ofrenda|strong="H7133"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*.  
\v 12 \w La|strong="H1931"\w* llevará \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w*, \w y|strong="H5921"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w tomará|strong="H7062"\w* un puñado \w de|strong="H4480"\w* \w la|strong="H1931"\w* harina \w como|strong="H5921"\w* porción memorial, \w y|strong="H5921"\w* \w la|strong="H1931"\w* \w quemará|strong="H6999"\w* \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w*, \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* ofrendas \w a|strong="H3068"\w* Yahvé hechas \w por|strong="H5921"\w* fuego. \w Es|strong="H1931"\w* una ofrenda \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*.  
\v 13 Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H1961"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w que|strong="H5921"\w* esa persona \w haya|strong="H1961"\w* cometido \w en|strong="H5921"\w* cualquiera \w de|strong="H5921"\w* estas cosas, \w y|strong="H5921"\w* \w será|strong="H1961"\w* perdonada. \w El|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* harina \w será|strong="H1961"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w*, \w como|strong="H1961"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal’”.   
\p
\v 14 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 15 “\w Si|strong="H3588"\w* alguien comete una \w falta|strong="H4603"\w* \w y|strong="H3588"\w* \w peca|strong="H2398"\w* \w por|strong="H3588"\w* error \w en|strong="H4480"\w* \w contra|strong="H4480"\w* \w de|strong="H4480"\w* las cosas \w sagradas|strong="H6944"\w* \w de|strong="H4480"\w* Yahvé, traerá \w a|strong="H3068"\w* Yahvé \w su|strong="H3588"\w* ofrenda \w por|strong="H3588"\w* \w la|strong="H3588"\w* culpa: un carnero sin defecto \w del|strong="H4480"\w* \w rebaño|strong="H6629"\w*, tasado \w en|strong="H4480"\w* \w siclos|strong="H8255"\w* \w de|strong="H4480"\w* \w plata|strong="H3701"\w* según \w la|strong="H3588"\w* medida \w del|strong="H4480"\w* \w santuario|strong="H6944"\w*, \w como|strong="H3588"\w* ofrenda \w por|strong="H3588"\w* \w la|strong="H3588"\w* culpa.  
\v 16 \w Deberá|strong="H7999"\w* restituir \w lo|strong="H5921"\w* \w que|strong="H4480"\w* haya defraudado \w de|strong="H4480"\w* \w las|strong="H5921"\w* cosas \w sagradas|strong="H6944"\w*, \w le|strong="H5921"\w* \w añadirá|strong="H3254"\w* una quinta parte \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w dará|strong="H5414"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w*. \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H5414"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* carnero \w de|strong="H4480"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa, \w y|strong="H5921"\w* \w será|strong="H5414"\w* perdonado.   
\p
\v 17 “\w Si|strong="H3588"\w* alguien \w peca|strong="H2398"\w* \w haciendo|strong="H6213"\w* algo \w que|strong="H3588"\w* Yahvé \w ha|strong="H3808"\w* prohibido, \w aunque|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sepa|strong="H3045"\w*, \w es|strong="H3588"\w* culpable \w y|strong="H3588"\w* cargará \w con|strong="H3588"\w* \w su|strong="H3588"\w* culpa.  
\v 18 Llevará \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* un carnero \w sin|strong="H3808"\w* defecto \w del|strong="H4480"\w* \w rebaño|strong="H6629"\w*, tasado \w según|strong="H5921"\w* tu valoración, \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H1931"\w* culpa. \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* error \w que|strong="H4480"\w* \w esa|strong="H1931"\w* persona \w cometió|strong="H7683"\w* \w sin|strong="H3808"\w* \w saberlo|strong="H3045"\w*, \w y|strong="H5921"\w* \w será|strong="H1931"\w* perdonada.  
\v 19 \w Es|strong="H1931"\w* una ofrenda por \w la|strong="H1931"\w* culpa, \w pues|strong="H1931"\w* verdaderamente resultó culpable ante Yahvé”.   
\c 6  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Si|strong="H1931"\w* alguien peca \w y|strong="H5921"\w* comete una falta \w contra|strong="H5921"\w* Yahvé engañando \w a|strong="H3068"\w* \w su|strong="H1931"\w* prójimo \w en|strong="H5921"\w* cuestión \w de|strong="H5921"\w* un depósito, un objeto \w en|strong="H5921"\w* custodia \w o|strong="H3068"\w* un robo, \w o|strong="H3068"\w* \w si|strong="H1931"\w* ha extorsionado \w a|strong="H3068"\w* \w su|strong="H1931"\w* prójimo,  
\v 3 \w o|strong="H3068"\w* \w si|strong="H5921"\w* encuentra algo perdido \w y|strong="H5921"\w* miente \w al|strong="H5921"\w* respecto, \w y|strong="H5921"\w* jura \w en|strong="H5921"\w* falso \w por|strong="H5921"\w* cualquiera \w de|strong="H5921"\w* estas cosas \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* suele pecar \w el|strong="H5921"\w* ser humano,  
\v 4 si ha pecado y es culpable, deberá devolver lo que robó, \w o|strong="H3068"\w* lo que obtuvo por extorsión, \w o|strong="H3068"\w* \w el|strong="H4264"\w* depósito que se le confió, \w o|strong="H3068"\w* la cosa perdida que encontró,  
\v 5 \w o|strong="H3068"\w* cualquier cosa \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* cual haya jurado \w en|strong="H5921"\w* falso. \w La|strong="H5921"\w* restituirá \w por|strong="H5921"\w* completo \w y|strong="H5921"\w* \w le|strong="H5921"\w* añadirá una quinta parte. \w Se|strong="H5921"\w* \w lo|strong="H3808"\w* devolverá \w al|strong="H5921"\w* dueño \w el|strong="H5921"\w* mismo día \w que|strong="H3808"\w* presente su ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa.  
\v 6 \w Y|strong="H3068"\w* \w como|strong="H5921"\w* su ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w a|strong="H3068"\w* Yahvé, \w le|strong="H5921"\w* llevará \w al|strong="H5921"\w* sacerdote un carnero \w sin|strong="H3808"\w* defecto \w del|strong="H5921"\w* rebaño, tasado \w según|strong="H5921"\w* tu valoración.  
\v 7 \w El|strong="H1121"\w* sacerdote hará expiación \w por|strong="H6440"\w* \w él|strong="H1121"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, y será perdonado \w por|strong="H6440"\w* cualquier \w cosa|strong="H2063"\w* \w que|strong="H1121"\w* haya hecho y \w que|strong="H1121"\w* lo haya hecho culpable”.   
\p
\v 8 Yahvé \w le|strong="H5921"\w* habló \w a|strong="H3068"\w* Moisés \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo:  
\v 9 “Dales esta orden \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*: ‘Esta es la ley \w del|strong="H4480"\w* holocausto: \w el|strong="H1121"\w* holocausto deberá quedarse \w sobre|strong="H4480"\w* \w el|strong="H1121"\w* hogar \w del|strong="H4480"\w* altar toda la noche, hasta la mañana, y \w el|strong="H1121"\w* fuego \w del|strong="H4480"\w* altar debe mantenerse encendido.  
\v 10 \w El|strong="H1931"\w* sacerdote \w se|strong="H1931"\w* \w pondrá|strong="H5414"\w* \w su|strong="H1931"\w* túnica \w de|strong="H5414"\w* lino y \w su|strong="H1931"\w* ropa interior \w de|strong="H5414"\w* lino; \w luego|strong="H1931"\w* recogerá las cenizas \w que|strong="H1931"\w* queden en \w el|strong="H1931"\w* altar cuando \w el|strong="H1931"\w* fuego haya consumido \w el|strong="H1931"\w* holocausto, y las \w pondrá|strong="H5414"\w* \w a|strong="H3068"\w* un lado del altar.  
\v 11 Después se cambiará \w de|strong="H1121"\w* ropa y llevará las cenizas fuera del campamento \w a|strong="H3068"\w* un lugar ceremonialmente limpio.  
\v 12 El fuego del altar debe mantenerse encendido; no se debe apagar. Cada mañana el sacerdote le pondrá más leña, acomodará el holocausto encima y quemará ahí la grasa de los sacrificios de paz.  
\v 13 \w El|strong="H1121"\w* fuego debe mantenerse encendido en \w el|strong="H1121"\w* altar \w continuamente|strong="H8548"\w*; no debe apagarse.   
\p
\v 14 “‘\w Esta|strong="H5921"\w* es \w la|strong="H5921"\w* ley \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal: \w los|strong="H5921"\w* hijos \w de|strong="H5921"\w* Aarón \w la|strong="H5921"\w* presentarán ante Yahvé, frente \w al|strong="H5921"\w* altar.  
\v 15 \w El|strong="H1121"\w* \w sacerdote|strong="H3548"\w* tomará un puñado \w de|strong="H8478"\w* la harina fina \w de|strong="H8478"\w* la ofrenda, con su aceite y \w todo|strong="H3632"\w* \w el|strong="H1121"\w* incienso \w que|strong="H1121"\w* está sobre ella, y \w lo|strong="H6213"\w* \w quemará|strong="H6999"\w* \w en|strong="H8478"\w* \w el|strong="H1121"\w* altar \w como|strong="H8478"\w* aroma agradable, \w como|strong="H8478"\w* su porción memorial para Yahvé.  
\v 16 \w Lo|strong="H3808"\w* \w que|strong="H3808"\w* \w quede|strong="H1961"\w* de \w la|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w lo|strong="H3808"\w* comerán Aarón y sus hijos. Deberá comerse \w sin|strong="H3808"\w* levadura en un lugar sagrado; \w lo|strong="H3808"\w* comerán en \w el|strong="H3605"\w* atrio de \w la|strong="H3605"\w* Tienda del Encuentro.  
\v 17 No se horneará con levadura. Se lo he dado \w a|strong="H3068"\w* ellos como su porción de mis ofrendas hechas por fuego. Es una parte muy santa, igual que la ofrenda por el pecado y la ofrenda por la culpa.  
\v 18 Cualquier varón \w de|strong="H6440"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H6440"\w* Aarón podrá comer \w de|strong="H6440"\w* \w ella|strong="H1931"\w*. \w Es|strong="H1931"\w* un estatuto perpetuo para todas \w sus|strong="H1931"\w* generaciones, en cuanto \w a|strong="H3068"\w* las ofrendas hechas \w por|strong="H6440"\w* fuego \w a|strong="H3068"\w* Yahvé. Todo \w lo|strong="H1931"\w* \w que|strong="H1931"\w* toque \w estas|strong="H2063"\w* ofrendas quedará \w consagrado|strong="H6944"\w*’”.   
\p
\v 19 Yahvé le habló \w a|strong="H3068"\w* Moisés y le dijo:  
\v 20 “\w Esta|strong="H5921"\w* es \w la|strong="H5921"\w* ofrenda \w que|strong="H5921"\w* Aarón \w y|strong="H5921"\w* sus hijos presentarán \w a|strong="H3068"\w* Yahvé \w el|strong="H5921"\w* día \w en|strong="H5921"\w* \w que|strong="H5921"\w* sean ungidos: \w la|strong="H5921"\w* décima \w parte|strong="H4725"\w* \w de|strong="H5921"\w* un efa \w de|strong="H5921"\w* harina fina \w como|strong="H5921"\w* ofrenda regular \w de|strong="H5921"\w* cereal, \w la|strong="H5921"\w* mitad \w por|strong="H5921"\w* \w la|strong="H5921"\w* mañana \w y|strong="H5921"\w* \w la|strong="H5921"\w* otra mitad \w por|strong="H5921"\w* \w la|strong="H5921"\w* tarde.  
\v 21 Se preparará en una plancha con aceite. La llevarás bien mezclada, y presentarás la ofrenda \w de|strong="H4325"\w* cereal en pedazos cocidos, como un aroma agradable \w a|strong="H3068"\w* Yahvé.  
\v 22 \w La|strong="H1931"\w* ofrecerá \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* ungido \w que|strong="H1931"\w* tome \w el|strong="H1931"\w* lugar de Aarón de entre \w sus|strong="H1931"\w* hijos. \w Como|strong="H1931"\w* un estatuto perpetuo, \w se|strong="H1931"\w* quemará por completo para Yahvé.  
\v 23 \w Toda|strong="H3605"\w* ofrenda \w de|strong="H1818"\w* cereal \w de|strong="H1818"\w* un sacerdote debe quemarse por completo; \w no|strong="H3808"\w* \w se|strong="H3808"\w* comerá”.   
\p
\v 24 Yahvé le habló \w a|strong="H3068"\w* Moisés y le dijo:  
\v 25 “Diles \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus hijos: ‘Esta es la ley para el sacrificio por el pecado: la víctima por el pecado se degollará ante Yahvé en el mismo lugar donde se degüella el holocausto. Es una ofrenda muy santa.  
\v 26 El sacerdote que la ofrezca por el pecado la comerá. Deberá comerse en un lugar sagrado, en el atrio de la Tienda del Encuentro.  
\v 27 Todo lo que toque su carne quedará consagrado. Si la sangre salpica la ropa, lavarás la ropa manchada en un lugar santo.  
\v 28 La olla de barro en la que se haya cocido la carne deberá romperse; pero si se coció en una olla de bronce, esta deberá fregarse y enjuagarse con agua.  
\v 29 Cualquier varón de entre los sacerdotes podrá comer de esta carne. Es una ofrenda muy santa.  
\v 30 Pero no se comerá ninguna ofrenda por el pecado si parte de su sangre se llevó al interior de la Tienda del Encuentro para hacer expiación en el Lugar Santo. Esa carne deberá quemarse en el fuego.   
\c 7  
\p
\v 1 “‘\w Esta|strong="H2063"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w ley|strong="H8451"\w* de \w la|strong="H1931"\w* ofrenda por \w la|strong="H1931"\w* culpa: \w es|strong="H1931"\w* muy \w santa|strong="H6944"\w*.  
\v 2 \w La|strong="H5921"\w* víctima \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w se|strong="H5921"\w* degollará \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* \w se|strong="H5921"\w* degüella \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w*, \w y|strong="H5921"\w* su \w sangre|strong="H1818"\w* \w se|strong="H5921"\w* rociará \w por|strong="H5921"\w* todos \w los|strong="H5921"\w* \w lados|strong="H5439"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 3 \w Se|strong="H4480"\w* \w ofrecerá|strong="H7126"\w* \w toda|strong="H3605"\w* su grasa: \w la|strong="H3605"\w* cola gorda, \w la|strong="H3605"\w* grasa \w que|strong="H4480"\w* \w cubre|strong="H3680"\w* las entrañas,  
\v 4 \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w riñones|strong="H3629"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* grasa \w que|strong="H5921"\w* \w los|strong="H5921"\w* cubre \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* lomos, \w y|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w del|strong="H5921"\w* \w hígado|strong="H3516"\w*, \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w quitará|strong="H5493"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w riñones|strong="H3629"\w*.  
\v 5 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w los|strong="H1931"\w* \w quemará|strong="H6999"\w* en \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w como|strong="H1931"\w* ofrenda hecha por fuego \w a|strong="H3068"\w* Yahvé. \w Es|strong="H1931"\w* una ofrenda por \w la|strong="H1931"\w* culpa.  
\v 6 \w Cualquier|strong="H3605"\w* \w varón|strong="H2145"\w* de \w la|strong="H1931"\w* familia sacerdotal podrá comer de \w ella|strong="H1931"\w*. Deberá comerse en un \w lugar|strong="H4725"\w* \w sagrado|strong="H6944"\w*, \w pues|strong="H1931"\w* \w es|strong="H1931"\w* muy \w santa|strong="H6944"\w*.   
\p
\v 7 “‘La ofrenda por el \w pecado|strong="H2403"\w* y la ofrenda por la culpa \w tienen|strong="H1961"\w* la misma \w ley|strong="H8451"\w*. La carne \w será|strong="H1961"\w* \w para|strong="H1961"\w* el \w sacerdote|strong="H3548"\w* \w que|strong="H1961"\w* haga la \w expiación|strong="H3722"\w* con ella.  
\v 8 El \w sacerdote|strong="H3548"\w* \w que|strong="H1961"\w* ofrezca el \w holocausto|strong="H5930"\w* por alguien \w se|strong="H1961"\w* \w quedará|strong="H1961"\w* con la \w piel|strong="H5785"\w* del animal ofrecido.  
\v 9 \w Toda|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal \w que|strong="H5921"\w* \w se|strong="H1961"\w* hornee, \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* prepare \w en|strong="H5921"\w* \w sartén|strong="H4227"\w* \w o|strong="H3068"\w* \w en|strong="H5921"\w* plancha, \w será|strong="H1961"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* ofrezca.  
\v 10 Pero \w toda|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H1121"\w* cereal, ya \w sea|strong="H1961"\w* \w amasada|strong="H1101"\w* con \w aceite|strong="H8081"\w* \w o|strong="H3068"\w* seca, \w se|strong="H1961"\w* repartirá por igual entre \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón.   
\p
\v 11 “‘\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w ley|strong="H8451"\w* del \w sacrificio|strong="H2077"\w* de paz que se presenta \w a|strong="H3068"\w* Yahvé:  
\v 12 \w Si|strong="H5921"\w* \w se|strong="H5921"\w* \w ofrece|strong="H7126"\w* \w en|strong="H5921"\w* acción \w de|strong="H5921"\w* gracias, \w se|strong="H5921"\w* presentarán \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w sacrificio|strong="H2077"\w* \w tortas|strong="H2471"\w* sin levadura \w amasadas|strong="H1101"\w* \w con|strong="H5921"\w* \w aceite|strong="H8081"\w*, hojuelas sin levadura \w untadas|strong="H4886"\w* \w con|strong="H5921"\w* \w aceite|strong="H8081"\w*, \w y|strong="H5921"\w* \w tortas|strong="H2471"\w* \w de|strong="H5921"\w* harina fina bien mezcladas \w con|strong="H5921"\w* \w aceite|strong="H8081"\w*.  
\v 13 \w Además|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w tortas|strong="H2471"\w* sin levadura, \w se|strong="H5921"\w* \w presentará|strong="H7126"\w* \w pan|strong="H3899"\w* \w con|strong="H5921"\w* levadura \w como|strong="H5921"\w* parte \w de|strong="H5921"\w* su \w ofrenda|strong="H7133"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* su \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* paz \w en|strong="H5921"\w* acción \w de|strong="H5921"\w* gracias.  
\v 14 \w De|strong="H4480"\w* \w cada|strong="H3605"\w* clase \w de|strong="H4480"\w* \w ofrenda|strong="H7133"\w* \w se|strong="H1961"\w* \w presentará|strong="H7126"\w* una porción \w como|strong="H1961"\w* \w ofrenda|strong="H7133"\w* especial \w para|strong="H4480"\w* Yahvé; \w será|strong="H1961"\w* \w para|strong="H4480"\w* \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w que|strong="H4480"\w* rocíe \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w de|strong="H4480"\w* \w los|strong="H3605"\w* sacrificios \w de|strong="H4480"\w* paz.  
\v 15 La \w carne|strong="H1320"\w* \w del|strong="H4480"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H4480"\w* paz \w en|strong="H4480"\w* acción \w de|strong="H4480"\w* gracias debe comerse el mismo \w día|strong="H3117"\w* \w que|strong="H4480"\w* \w se|strong="H3808"\w* ofrezca. \w No|strong="H3808"\w* \w se|strong="H3808"\w* debe dejar \w nada|strong="H3808"\w* \w para|strong="H5704"\w* la \w mañana|strong="H1242"\w* siguiente.   
\p
\v 16 “‘Pero si el \w sacrificio|strong="H2077"\w* \w que|strong="H4480"\w* \w ofrece|strong="H7126"\w* es \w para|strong="H4480"\w* cumplir una promesa \w o|strong="H3068"\w* es una \w ofrenda|strong="H7133"\w* \w voluntaria|strong="H5071"\w*, la carne \w se|strong="H4480"\w* comerá el \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* ofrezca el \w sacrificio|strong="H2077"\w*, y lo \w que|strong="H4480"\w* \w sobre|strong="H4480"\w* \w se|strong="H4480"\w* podrá comer \w al|strong="H4480"\w* \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*.  
\v 17 Sin embargo, si \w queda|strong="H3498"\w* algo de \w carne|strong="H1320"\w* del \w sacrificio|strong="H2077"\w* para el tercer \w día|strong="H3117"\w*, deberá quemarse en el fuego.  
\v 18 \w Si|strong="H3808"\w* alguien llega \w a|strong="H3068"\w* \w comer|strong="H5315"\w* la \w carne|strong="H1320"\w* \w del|strong="H4480"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H4480"\w* paz \w al|strong="H4480"\w* tercer \w día|strong="H3117"\w*, la ofrenda \w no|strong="H3808"\w* \w será|strong="H1961"\w* aceptada \w ni|strong="H3808"\w* \w se|strong="H1961"\w* le tomará \w en|strong="H4480"\w* cuenta \w al|strong="H4480"\w* \w que|strong="H4480"\w* la \w ofreció|strong="H7126"\w*. \w Será|strong="H1961"\w* considerada algo asqueroso, y el \w que|strong="H4480"\w* la coma \w cargará|strong="H1961"\w* \w con|strong="H4480"\w* su culpa.   
\p
\v 19 “‘\w La|strong="H3605"\w* \w carne|strong="H1320"\w* \w que|strong="H3808"\w* toque \w cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* impura \w no|strong="H3808"\w* deberá comerse; \w se|strong="H3808"\w* \w quemará|strong="H8313"\w* en \w el|strong="H3605"\w* fuego. En cuanto \w a|strong="H3068"\w* \w la|strong="H3605"\w* demás \w carne|strong="H1320"\w*, \w podrá|strong="H3808"\w* comerla \w cualquiera|strong="H3605"\w* \w que|strong="H3808"\w* esté ceremonialmente \w limpio|strong="H2889"\w*.  
\v 20 Pero \w si|strong="H1931"\w* alguien \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w en|strong="H5921"\w* estado \w de|strong="H5921"\w* impureza come \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w carne|strong="H1320"\w* \w del|strong="H5921"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* paz \w que|strong="H1931"\w* \w le|strong="H1931"\w* pertenece \w a|strong="H3068"\w* Yahvé, \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1931"\w* eliminada \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 21 \w Si|strong="H3588"\w* alguien \w toca|strong="H5060"\w* \w cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* impura, ya sea impureza humana, un \w animal|strong="H5315"\w* impuro \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* repulsiva \w e|strong="H3068"\w* impura, \w y|strong="H3588"\w* \w luego|strong="H1931"\w* come \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w carne|strong="H1320"\w* del \w sacrificio|strong="H2077"\w* \w de|strong="H3588"\w* paz \w que|strong="H3588"\w* \w le|strong="H1931"\w* pertenece \w a|strong="H3068"\w* Yahvé, \w esa|strong="H1931"\w* \w persona|strong="H5315"\w* \w será|strong="H1931"\w* eliminada \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*’”.   
\p
\v 22 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 23 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: \w No|strong="H3808"\w* deben comer \w nada|strong="H3808"\w* \w de|strong="H1121"\w* grasa \w de|strong="H1121"\w* toros, ovejas \w o|strong="H3068"\w* \w cabras|strong="H5795"\w*.  
\v 24 \w La|strong="H3605"\w* grasa de un animal \w que|strong="H3808"\w* muere por \w sí|strong="H3808"\w* solo, \w o|strong="H3068"\w* de uno despedazado por las fieras, \w podrá|strong="H3808"\w* usarse para \w cualquier|strong="H3605"\w* otro propósito, pero de \w ninguna|strong="H3605"\w* manera deberán comerla.  
\v 25 \w Todo|strong="H3605"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* coma \w la|strong="H3588"\w* grasa \w de|strong="H4480"\w* un \w animal|strong="H5315"\w* \w del|strong="H4480"\w* \w cual|strong="H3588"\w* \w se|strong="H4480"\w* presenta una ofrenda quemada \w a|strong="H3068"\w* Yahvé, será eliminado \w de|strong="H4480"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 26 \w Y|strong="H3068"\w* dondequiera \w que|strong="H3808"\w* ustedes vivan, \w no|strong="H3808"\w* deben comer \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* \w ningún|strong="H3605"\w* \w ave|strong="H5775"\w* \w ni|strong="H3808"\w* \w de|strong="H1818"\w* \w ningún|strong="H3605"\w* animal.  
\v 27 \w Cualquiera|strong="H3605"\w* \w que|strong="H1931"\w* coma \w sangre|strong="H1818"\w* \w será|strong="H1931"\w* eliminado \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*”.   
\p
\v 28 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 29 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: ‘\w El|strong="H1121"\w* \w que|strong="H1121"\w* \w presente|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé su \w sacrificio|strong="H2077"\w* \w de|strong="H1121"\w* paz, debe llevarle \w a|strong="H3068"\w* Yahvé una parte \w de|strong="H1121"\w* ese \w sacrificio|strong="H2077"\w* como \w ofrenda|strong="H7133"\w*.  
\v 30 Traerá \w con|strong="H5921"\w* sus propias \w manos|strong="H3027"\w* \w las|strong="H5921"\w* ofrendas hechas \w por|strong="H5921"\w* fuego \w a|strong="H3068"\w* Yahvé. Traerá \w la|strong="H5921"\w* grasa \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* pecho, \w para|strong="H5921"\w* presentar \w el|strong="H5921"\w* pecho \w como|strong="H5921"\w* \w ofrenda|strong="H8573"\w* mecida \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.  
\v 31 \w El|strong="H1121"\w* \w sacerdote|strong="H3548"\w* \w quemará|strong="H6999"\w* la grasa en \w el|strong="H1121"\w* \w altar|strong="H4196"\w*, pero \w el|strong="H1121"\w* pecho \w será|strong="H1961"\w* \w para|strong="H1961"\w* Aarón y sus \w hijos|strong="H1121"\w*.  
\v 32 Le \w darán|strong="H5414"\w* al \w sacerdote|strong="H3548"\w* el muslo \w derecho|strong="H3225"\w* como \w ofrenda|strong="H8641"\w* especial tomada \w de|strong="H5414"\w* sus \w sacrificios|strong="H2077"\w* \w de|strong="H5414"\w* paz.  
\v 33 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Aarón \w que|strong="H1121"\w* ofrezca la \w sangre|strong="H1818"\w* y la grasa \w de|strong="H1121"\w* \w los|strong="H1121"\w* sacrificios \w de|strong="H1121"\w* paz recibirá \w el|strong="H1121"\w* muslo \w derecho|strong="H3225"\w* \w como|strong="H1961"\w* su \w porción|strong="H4490"\w*.  
\v 34 \w Porque|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w sacrificios|strong="H2077"\w* \w de|strong="H3588"\w* paz \w de|strong="H3588"\w* \w los|strong="H1121"\w* israelitas he \w tomado|strong="H3947"\w* \w el|strong="H3588"\w* pecho \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ofrenda|strong="H8641"\w* mecida \w y|strong="H3588"\w* \w el|strong="H3588"\w* muslo \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ofrenda|strong="H8641"\w* especial, \w y|strong="H3588"\w* se \w los|strong="H1121"\w* he \w dado|strong="H5414"\w* al \w sacerdote|strong="H3548"\w* Aarón \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w como|strong="H3588"\w* un \w estatuto|strong="H2706"\w* \w perpetuo|strong="H5769"\w* \w para|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*’”.   
\p
\v 35 \w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* porción \w de|strong="H1121"\w* las ofrendas hechas por fuego \w a|strong="H3068"\w* Yahvé \w que|strong="H3117"\w* les corresponde \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* desde \w el|strong="H1121"\w* \w día|strong="H3117"\w* en \w que|strong="H3117"\w* fueron presentados para servir \w a|strong="H3068"\w* Yahvé como sacerdotes.  
\v 36 Yahvé \w ordenó|strong="H6680"\w* \w que|strong="H3117"\w* \w los|strong="H1121"\w* israelitas \w les|strong="H6680"\w* dieran estas porciones \w el|strong="H1121"\w* \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w los|strong="H1121"\w* \w ungió|strong="H4886"\w*. Es un \w estatuto|strong="H2708"\w* \w perpetuo|strong="H5769"\w* \w para|strong="H5414"\w* \w todas|strong="H1755"\w* sus \w generaciones|strong="H1755"\w*.  
\v 37 \w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w ley|strong="H8451"\w* para el \w holocausto|strong="H5930"\w*, \w la|strong="H2063"\w* \w ofrenda|strong="H4503"\w* de cereal, \w la|strong="H2063"\w* \w ofrenda|strong="H4503"\w* por el \w pecado|strong="H2403"\w*, \w la|strong="H2063"\w* \w ofrenda|strong="H4503"\w* por \w la|strong="H2063"\w* culpa, \w la|strong="H2063"\w* \w ofrenda|strong="H4503"\w* de consagración y el \w sacrificio|strong="H2077"\w* de paz.  
\v 38 Yahvé se la \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* en \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* \w el|strong="H1121"\w* \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w mandó|strong="H6680"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H3117"\w* presentaran sus \w ofrendas|strong="H7133"\w* \w a|strong="H3068"\w* Yahvé en \w el|strong="H1121"\w* \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* \w Sinaí|strong="H5514"\w*.   
\c 8  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Toma|strong="H3947"\w* \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, junto con sus vestiduras, \w el|strong="H1121"\w* \w aceite|strong="H8081"\w* \w de|strong="H1121"\w* la \w unción|strong="H4888"\w*, \w el|strong="H1121"\w* \w becerro|strong="H6499"\w* \w de|strong="H1121"\w* la ofrenda por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w*, \w los|strong="H1121"\w* \w dos|strong="H8147"\w* carneros y la canasta \w de|strong="H1121"\w* pan sin levadura;  
\v 3 y reúne \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada de \w la|strong="H3605"\w* Tienda del Encuentro”.   
\p
\v 4 \w Moisés|strong="H4872"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5712"\w* Yahvé le \w ordenó|strong="H6680"\w*, y la comunidad se reunió \w a|strong="H3068"\w* la entrada de la Tienda del Encuentro.  
\v 5 \w Moisés|strong="H4872"\w* le dijo \w a|strong="H3068"\w* la comunidad: “\w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé ha \w mandado|strong="H6680"\w* \w hacer|strong="H6213"\w*”.  
\v 6 \w Moisés|strong="H4872"\w* hizo acercarse \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, y \w los|strong="H1121"\w* \w lavó|strong="H7364"\w* con \w agua|strong="H4325"\w*.  
\v 7 \w Le|strong="H5921"\w* \w puso|strong="H5414"\w* \w la|strong="H5921"\w* túnica \w a|strong="H3068"\w* Aarón, \w le|strong="H5921"\w* ató \w el|strong="H5921"\w* cinturón, \w lo|strong="H5921"\w* \w vistió|strong="H3847"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w manto|strong="H4598"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w puso|strong="H5414"\w* \w el|strong="H5921"\w* efod. Luego \w le|strong="H5921"\w* amarró \w el|strong="H5921"\w* cinturón tejido \w del|strong="H5921"\w* efod \w para|strong="H5921"\w* sujetarlo.  
\v 8 \w Le|strong="H5921"\w* \w puso|strong="H7760"\w* también \w el|strong="H5921"\w* pectoral, \w y|strong="H5921"\w* \w dentro|strong="H5921"\w* \w del|strong="H5921"\w* pectoral colocó \w el|strong="H5921"\w* Urim \w y|strong="H5921"\w* \w el|strong="H5921"\w* Tumim.  
\v 9 \w Le|strong="H5921"\w* \w puso|strong="H7760"\w* \w el|strong="H5921"\w* turbante \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte delantera \w del|strong="H5921"\w* turbante colocó \w la|strong="H5921"\w* lámina \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w la|strong="H5921"\w* diadema sagrada, tal \w como|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* \w lo|strong="H5921"\w* había \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.  
\v 10 Después \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w el|strong="H3605"\w* \w aceite|strong="H8081"\w* de \w la|strong="H3605"\w* \w unción|strong="H4888"\w*, \w ungió|strong="H4886"\w* \w el|strong="H3605"\w* \w tabernáculo|strong="H4908"\w* y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* \w había|strong="H6942"\w* en \w él|strong="H3605"\w*, y \w los|strong="H3605"\w* consagró.  
\v 11 Roció un poco \w de|strong="H4480"\w* aceite \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w siete|strong="H7651"\w* \w veces|strong="H6471"\w*, \w y|strong="H5921"\w* \w ungió|strong="H4886"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, \w todos|strong="H3605"\w* sus utensilios, \w y|strong="H5921"\w* \w el|strong="H5921"\w* lavamanos \w con|strong="H5921"\w* su base, \w para|strong="H5921"\w* consagrarlos.  
\v 12 Luego \w derramó|strong="H3332"\w* parte \w del|strong="H5921"\w* \w aceite|strong="H8081"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w unción|strong="H4888"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* Aarón \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w ungió|strong="H4886"\w* \w para|strong="H5921"\w* consagrarlo.  
\v 13 \w Moisés|strong="H4872"\w* hizo acercarse \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, \w los|strong="H1121"\w* \w vistió|strong="H3847"\w* con \w túnicas|strong="H3801"\w*, \w les|strong="H6680"\w* puso cinturones y \w les|strong="H6680"\w* ajustó \w los|strong="H1121"\w* turbantes, tal como Yahvé se lo había \w ordenado|strong="H6680"\w*.   
\p
\v 14 Luego hizo traer \w el|strong="H5921"\w* \w becerro|strong="H6499"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*, \w y|strong="H5921"\w* Aarón \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w pusieron|strong="H5564"\w* sus \w manos|strong="H3027"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w del|strong="H5921"\w* \w becerro|strong="H6499"\w*.  
\v 15 \w Moisés|strong="H4872"\w* \w degolló|strong="H7819"\w* \w el|strong="H5921"\w* becerro, \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w y|strong="H5921"\w*, \w con|strong="H5921"\w* su dedo, untó \w los|strong="H5921"\w* \w cuernos|strong="H7161"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w* \w por|strong="H5921"\w* todos \w lados|strong="H5439"\w* \w para|strong="H5921"\w* purificarlo. \w Derramó|strong="H3332"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w al|strong="H5921"\w* \w pie|strong="H3247"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*, consagrándolo así \w para|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 16 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* grasa \w que|strong="H5921"\w* cubría \w las|strong="H5921"\w* entrañas, \w la|strong="H5921"\w* parte superior \w del|strong="H5921"\w* \w hígado|strong="H3516"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w riñones|strong="H3629"\w* \w con|strong="H5921"\w* su grasa, \w y|strong="H5921"\w* \w los|strong="H5921"\w* quemó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 17 Pero \w el|strong="H4264"\w* resto del \w becerro|strong="H6499"\w*, su \w piel|strong="H5785"\w*, su \w carne|strong="H1320"\w* y su excremento, los \w quemó|strong="H8313"\w* en \w el|strong="H4264"\w* fuego \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*, tal como Yahvé se lo había \w ordenado|strong="H6680"\w*.  
