\v 12 \w Después|strong="H5921"\w* \w degolló|strong="H7819"\w* \w el|strong="H5921"\w* animal \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w*. Sus \w hijos|strong="H1121"\w* \w le|strong="H5921"\w* entregaron \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w la|strong="H5921"\w* roció \w por|strong="H5921"\w* todos \w los|strong="H1121"\w* \w lados|strong="H5439"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*.  
