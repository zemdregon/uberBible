\v 14 \w Lavó|strong="H7364"\w* \w las|strong="H5921"\w* entrañas \w y|strong="H5921"\w* \w las|strong="H5921"\w* patas, \w y|strong="H5921"\w* \w las|strong="H5921"\w* quemó \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 15 Luego presentó la \w ofrenda|strong="H7133"\w* del \w pueblo|strong="H5971"\w*. \w Tomó|strong="H3947"\w* el \w macho|strong="H8163"\w* cabrío \w de|strong="H5971"\w* la \w ofrenda|strong="H7133"\w* por el \w pecado|strong="H2403"\w* del \w pueblo|strong="H5971"\w*, lo \w degolló|strong="H7819"\w* y lo \w ofreció|strong="H7126"\w* por el \w pecado|strong="H2403"\w*, igual \w que|strong="H5971"\w* el \w primero|strong="H7223"\w*.  
\v 16 Presentó \w el|strong="H6213"\w* \w holocausto|strong="H5930"\w* y \w lo|strong="H6213"\w* \w ofreció|strong="H7126"\w* según \w el|strong="H6213"\w* reglamento.  
\v 17 Presentó también \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H4480"\w* cereal; tomó un puñado \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* quemó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*, \w además|strong="H5921"\w* \w del|strong="H4480"\w* \w holocausto|strong="H5930"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w*.  
\v 18 \w Degolló|strong="H7819"\w* \w el|strong="H5921"\w* toro \w y|strong="H5921"\w* \w el|strong="H5921"\w* carnero \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* paz \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*. Sus \w hijos|strong="H1121"\w* \w le|strong="H5921"\w* pasaron \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w la|strong="H5921"\w* roció \w por|strong="H5921"\w* todos \w los|strong="H1121"\w* \w lados|strong="H5439"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 19 Tomaron las partes grasosas \w del|strong="H4480"\w* toro \w y|strong="H7794"\w* \w del|strong="H4480"\w* carnero, la cola gorda, la grasa \w que|strong="H4480"\w* cubre las entrañas, los \w riñones|strong="H3629"\w* \w y|strong="H7794"\w* la parte superior \w del|strong="H4480"\w* \w hígado|strong="H3516"\w*,  
\v 20 \w y|strong="H5921"\w* \w pusieron|strong="H7760"\w* \w toda|strong="H5921"\w* esa grasa \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* pechos \w de|strong="H5921"\w* \w los|strong="H5921"\w* animales. Entonces Aarón quemó \w la|strong="H5921"\w* grasa \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 21 Aarón presentó los pechos y el muslo \w derecho|strong="H3225"\w* como \w ofrenda|strong="H8573"\w* mecida \w ante|strong="H6440"\w* Yahvé, tal como \w Moisés|strong="H4872"\w* lo había \w ordenado|strong="H6680"\w*.  
\v 22 Después Aarón \w levantó|strong="H5375"\w* sus \w manos|strong="H3027"\w* \w hacia|strong="H6213"\w* \w el|strong="H6213"\w* \w pueblo|strong="H5971"\w* y \w lo|strong="H6213"\w* \w bendijo|strong="H1288"\w*. Una vez \w que|strong="H5971"\w* terminó \w de|strong="H5971"\w* presentar la ofrenda \w por|strong="H3027"\w* \w el|strong="H6213"\w* \w pecado|strong="H2403"\w*, \w el|strong="H6213"\w* \w holocausto|strong="H5930"\w* y los sacrificios \w de|strong="H5971"\w* paz, bajó del altar.   
\p
\v 23 \w Moisés|strong="H4872"\w* \w y|strong="H3519"\w* Aarón entraron \w en|strong="H3318"\w* \w la|strong="H3605"\w* Tienda del Encuentro. Cuando \w salieron|strong="H3318"\w*, \w bendijeron|strong="H1288"\w* al \w pueblo|strong="H5971"\w*, \w y|strong="H3519"\w* \w la|strong="H3605"\w* \w gloria|strong="H3519"\w* \w de|strong="H5971"\w* Yahvé \w se|strong="H5971"\w* le \w apareció|strong="H7200"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*.  
\v 24 \w Salió|strong="H3318"\w* fuego \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* consumió \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* grasa \w que|strong="H5921"\w* \w estaban|strong="H5971"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*. \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* esto, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* gritó \w de|strong="H5921"\w* alegría \w y|strong="H5921"\w* \w se|strong="H5921"\w* postró \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra.   
\c 10  
\p
\v 1 \w Nadab|strong="H5070"\w* \w y|strong="H5921"\w* Abiú, \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Aarón, \w tomaron|strong="H3947"\w* cada uno su incensario, \w le|strong="H5921"\w* \w pusieron|strong="H7760"\w* fuego, \w le|strong="H5921"\w* echaron incienso \w encima|strong="H5921"\w* \w y|strong="H5921"\w* ofrecieron \w ante|strong="H6440"\w* Yahvé un fuego \w no|strong="H3808"\w* autorizado, algo \w que|strong="H3808"\w* \w él|strong="H5921"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* había \w mandado|strong="H6680"\w*.  
\v 2 Entonces \w salió|strong="H3318"\w* fuego \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé y los consumió, y \w murieron|strong="H4191"\w* allí mismo, \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.   
\p
\v 3 \w Moisés|strong="H4872"\w* \w le|strong="H1931"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Aarón: “\w Esto|strong="H1931"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* Yahvé quería decir cuando declaró:  
\q1 ‘\w A|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* acercan \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w les|strong="H5921"\w* mostraré \w mi|strong="H5921"\w* santidad,  
\q2 \w y|strong="H5921"\w* \w ante|strong="H6440"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* revelaré \w mi|strong="H5921"\w* \w gloria|strong="H3605"\w*’”.  
\p \w Y|strong="H3068"\w* Aarón \w se|strong="H1931"\w* quedó callado.  
\v 4 \w Moisés|strong="H4872"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Misael|strong="H4332"\w* y \w a|strong="H3068"\w* Elzafán, \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* Uziel, \w tío|strong="H1730"\w* \w de|strong="H6440"\w* Aarón, y les dijo: “Acérquense y llévense \w a|strong="H3068"\w* sus parientes \w de|strong="H6440"\w* \w enfrente|strong="H6440"\w* del \w santuario|strong="H6944"\w* \w hacia|strong="H6440"\w* \w afuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*”.  
\v 5 Ellos se acercaron y se los \w llevaron|strong="H5375"\w* agarrados de sus \w túnicas|strong="H3801"\w* hacia \w afuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*, tal como \w Moisés|strong="H4872"\w* lo había ordenado.   
\p
\v 6 Luego \w Moisés|strong="H4872"\w* \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* Aarón \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus otros \w hijos|strong="H1121"\w*, Eleazar \w e|strong="H3068"\w* Itamar: “\w No|strong="H3808"\w* \w se|strong="H5921"\w* despeinen \w ni|strong="H3808"\w* \w se|strong="H5921"\w* rasguen \w la|strong="H5921"\w* ropa \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* luto, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H3808"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H5921"\w* enoje \w con|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad. Sus hermanos, \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w son|strong="H3808"\w* \w los|strong="H1121"\w* \w que|strong="H3808"\w* deben llorar \w por|strong="H5921"\w* este fuego \w que|strong="H3808"\w* Yahvé \w ha|strong="H3808"\w* encendido.  
\v 7 \w No|strong="H3808"\w* \w se|strong="H5921"\w* alejen \w de|strong="H5921"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w del|strong="H5921"\w* Encuentro, \w no|strong="H3808"\w* \w sea|strong="H6435"\w* \w que|strong="H3588"\w* \w mueran|strong="H4191"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w unción|strong="H4888"\w* \w de|strong="H5921"\w* Yahvé \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* ustedes”. \w Y|strong="H3068"\w* \w ellos|strong="H5921"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w les|strong="H5921"\w* dijo.  
\v 8 Entonces Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* Aarón y le \w dijo|strong="H1696"\w*:  
\v 9 “Tú y tus \w hijos|strong="H1121"\w* \w no|strong="H3808"\w* deben \w beber|strong="H8354"\w* \w vino|strong="H3196"\w* \w ni|strong="H3808"\w* \w ninguna|strong="H3808"\w* \w bebida|strong="H7941"\w* alcohólica cuando entren \w a|strong="H3068"\w* la Tienda \w del|strong="H8354"\w* Encuentro, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w*. Este \w será|strong="H3808"\w* un \w estatuto|strong="H2708"\w* \w perpetuo|strong="H5769"\w* para \w todas|strong="H1755"\w* sus \w generaciones|strong="H1755"\w*.  
\v 10 Ustedes deben hacer distinción entre lo \w santo|strong="H6944"\w* y lo común, y entre lo impuro y lo \w puro|strong="H2889"\w*.  
\v 11 Además, deben enseñarles \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w todas|strong="H3605"\w* las leyes \w que|strong="H1121"\w* Yahvé les ha dado \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*”.   
\p
\v 12 \w Moisés|strong="H4872"\w* les \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Aarón \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w que|strong="H3588"\w* \w le|strong="H1931"\w* quedaban, Eleazar \w e|strong="H3068"\w* Itamar: “\w Tomen|strong="H3947"\w* \w la|strong="H1931"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H3588"\w* cereal \w que|strong="H3588"\w* sobró \w de|strong="H3588"\w* las ofrendas hechas \w por|strong="H3588"\w* fuego \w a|strong="H3068"\w* Yahvé, \w y|strong="H3588"\w* cómanla sin levadura junto al \w altar|strong="H4196"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* una \w ofrenda|strong="H4503"\w* muy \w santa|strong="H6944"\w*.  
\v 13 Deben comerla \w en|strong="H3588"\w* un \w lugar|strong="H4725"\w* sagrado, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* porción \w que|strong="H3588"\w* \w les|strong="H6680"\w* corresponde \w a|strong="H3068"\w* ti \w y|strong="H3588"\w* \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* las ofrendas hechas \w por|strong="H3588"\w* fuego \w a|strong="H3068"\w* Yahvé; \w así|strong="H3651"\w* \w se|strong="H1931"\w* \w me|strong="H3588"\w* ha \w ordenado|strong="H6680"\w*.  
\v 14 \w Además|strong="H3588"\w*, \w el|strong="H3588"\w* pecho \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ofrenda|strong="H8641"\w* mecida \w y|strong="H3588"\w* \w el|strong="H3588"\w* muslo \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ofrenda|strong="H8641"\w* especial podrán comerlos tú, tus \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* tus \w hijas|strong="H1323"\w* \w en|strong="H3588"\w* un \w lugar|strong="H4725"\w* ceremonialmente \w limpio|strong="H2889"\w*, \w porque|strong="H3588"\w* se les han \w dado|strong="H5414"\w* \w como|strong="H3588"\w* \w su|strong="H3588"\w* porción \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w sacrificios|strong="H2077"\w* \w de|strong="H3588"\w* paz \w de|strong="H3588"\w* \w los|strong="H1121"\w* israelitas.  
\v 15 Traerán \w el|strong="H5921"\w* muslo \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H8641"\w* especial \w y|strong="H5921"\w* \w el|strong="H5921"\w* pecho \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H8641"\w* mecida \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* grasa \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ofrendas|strong="H8641"\w* hechas \w por|strong="H5921"\w* fuego, \w para|strong="H5921"\w* presentarlos \w como|strong="H1961"\w* \w ofrenda|strong="H8641"\w* mecida \w ante|strong="H6440"\w* Yahvé. \w Esta|strong="H1961"\w* \w será|strong="H1961"\w* \w la|strong="H5921"\w* porción \w perpetua|strong="H5769"\w* \w para|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* tus \w hijos|strong="H1121"\w*, tal \w como|strong="H1961"\w* Yahvé \w lo|strong="H5921"\w* ha \w ordenado|strong="H6680"\w*”.   
\p
\v 16 Cuando \w Moisés|strong="H4872"\w* preguntó \w qué|strong="H5921"\w* había pasado \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w macho|strong="H8163"\w* cabrío \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*, \w se|strong="H5921"\w* dio cuenta \w de|strong="H5921"\w* \w que|strong="H5921"\w* ya \w lo|strong="H5921"\w* habían quemado. \w Se|strong="H5921"\w* enojó mucho \w con|strong="H5921"\w* Eleazar \w e|strong="H3068"\w* Itamar, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* quedaban \w a|strong="H3068"\w* Aarón, \w y|strong="H5921"\w* \w les|strong="H5921"\w* reclamó:  
\v 17 “¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* comieron \w la|strong="H1931"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* \w en|strong="H5921"\w* \w el|strong="H1931"\w* área \w del|strong="H5921"\w* \w santuario|strong="H6944"\w*? \w Es|strong="H1931"\w* una ofrenda muy \w santa|strong="H6944"\w*, \w y|strong="H3588"\w* \w se|strong="H1931"\w* \w les|strong="H5921"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w para|strong="H5921"\w* quitar \w la|strong="H1931"\w* culpa \w de|strong="H5921"\w* \w la|strong="H1931"\w* comunidad, haciendo \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ellos|strong="H1931"\w* \w ante|strong="H6440"\w* Yahvé.  
\v 18 Como la \w sangre|strong="H1818"\w* del animal \w no|strong="H3808"\w* \w se|strong="H3808"\w* llevó al interior del \w santuario|strong="H6944"\w*, ustedes debieron haberse comido la carne en el área del \w santuario|strong="H6944"\w*, tal como \w yo|strong="H6680"\w* \w lo|strong="H3808"\w* \w ordené|strong="H6680"\w*”.   
\p
\v 19 Aarón \w le|strong="H5869"\w* respondió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Mira|strong="H2005"\w*, \w hoy|strong="H3117"\w* ellos presentaron su ofrenda \w por|strong="H6440"\w* el \w pecado|strong="H2403"\w* y su \w holocausto|strong="H5930"\w* \w ante|strong="H6440"\w* Yahvé, ¡y \w a|strong="H3068"\w* mí me han pasado estas tragedias! \w Si|strong="H2005"\w* yo me hubiera comido \w hoy|strong="H3117"\w* la ofrenda \w por|strong="H6440"\w* el \w pecado|strong="H2403"\w*, ¿\w le|strong="H5869"\w* habría agradado eso \w a|strong="H3068"\w* Yahvé?”.   
\p
\v 20 Cuando \w Moisés|strong="H4872"\w* \w escuchó|strong="H8085"\w* esto, estuvo \w de|strong="H5869"\w* acuerdo.   
\c 11  
\p
\v 1 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les \w dijo|strong="H1696"\w*:  
\v 2 “Díganles \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘\w De|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w animales|strong="H2416"\w* \w que|strong="H5921"\w* \w viven|strong="H2416"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w estos|strong="H2063"\w* son \w los|strong="H1121"\w* \w que|strong="H5921"\w* ustedes pueden comer:  
\v 3 Podrán comer \w cualquier|strong="H3605"\w* animal \w que|strong="H3605"\w* tenga \w la|strong="H3605"\w* \w pezuña|strong="H6536"\w* partida en dos y \w que|strong="H3605"\w* además rumie.   
\p
\v 4 “‘\w Sin|strong="H3808"\w* embargo, \w de|strong="H3588"\w* \w los|strong="H1931"\w* animales \w que|strong="H3588"\w* \w solo|strong="H1931"\w* \w rumian|strong="H5927"\w* \w o|strong="H3068"\w* \w que|strong="H3588"\w* \w solo|strong="H1931"\w* \w tienen|strong="H6536"\w* \w la|strong="H1931"\w* \w pezuña|strong="H6536"\w* partida, \w no|strong="H3808"\w* podrán comer \w los|strong="H1931"\w* siguientes: \w el|strong="H1931"\w* \w camello|strong="H1581"\w*, \w porque|strong="H3588"\w* \w rumia|strong="H1625"\w* \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w tiene|strong="H1931"\w* \w la|strong="H1931"\w* \w pezuña|strong="H6536"\w* partida; \w lo|strong="H1931"\w* considerarán impuro.  
\v 5 \w El|strong="H1931"\w* tejón, \w porque|strong="H3588"\w* \w rumia|strong="H1625"\w* \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w tiene|strong="H1931"\w* \w la|strong="H1931"\w* \w pezuña|strong="H6536"\w* partida; \w lo|strong="H1931"\w* considerarán impuro.  
\v 6 \w La|strong="H1931"\w* liebre, \w porque|strong="H3588"\w* \w rumia|strong="H1625"\w* \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w tiene|strong="H1931"\w* \w la|strong="H1931"\w* \w pezuña|strong="H6536"\w* partida; \w la|strong="H1931"\w* considerarán impura.  
\v 7 \w Y|strong="H3068"\w* \w el|strong="H1931"\w* cerdo, \w porque|strong="H3588"\w* \w tiene|strong="H1931"\w* \w la|strong="H1931"\w* \w pezuña|strong="H6536"\w* partida \w en|strong="H3588"\w* dos, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w rumia|strong="H1625"\w*; \w lo|strong="H1931"\w* considerarán impuro.  
\v 8 \w No|strong="H3808"\w* comerán la \w carne|strong="H1320"\w* de \w estos|strong="H1992"\w* animales \w ni|strong="H3808"\w* \w tocarán|strong="H5060"\w* \w sus|strong="H1992"\w* cadáveres. \w Los|strong="H1992"\w* considerarán impuros.   
\p
\v 9 “‘\w De|strong="H4325"\w* \w todas|strong="H3605"\w* las criaturas \w que|strong="H4325"\w* viven en \w el|strong="H3605"\w* \w agua|strong="H4325"\w*, en \w los|strong="H3605"\w* \w mares|strong="H3220"\w* y en \w los|strong="H3605"\w* ríos, podrán comer \w todas|strong="H3605"\w* las \w que|strong="H4325"\w* tengan aletas y escamas.  
\v 10 Pero \w todas|strong="H3605"\w* \w las|strong="H1992"\w* criaturas \w que|strong="H4325"\w* \w viven|strong="H2416"\w* en \w los|strong="H1992"\w* \w mares|strong="H3220"\w* y en \w los|strong="H1992"\w* ríos \w que|strong="H4325"\w* no tengan aletas ni escamas, ya sean \w las|strong="H1992"\w* \w que|strong="H4325"\w* \w se|strong="H1992"\w* mueven en grupos \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* otra criatura del \w agua|strong="H4325"\w*, \w las|strong="H1992"\w* considerarán algo asqueroso.  
\v 11 Las \w tendrán|strong="H1961"\w* por cosas repugnantes: \w no|strong="H3808"\w* comerán su \w carne|strong="H1320"\w* y detestarán sus cadáveres.  
\v 12 \w Cualquier|strong="H3605"\w* criatura del \w agua|strong="H4325"\w* \w que|strong="H1931"\w* no tenga aletas ni escamas \w será|strong="H1931"\w* algo asqueroso para ustedes.   
\p
\v 13 “‘\w De|strong="H4480"\w* \w las|strong="H1992"\w* \w aves|strong="H5775"\w*, detestarán \w las|strong="H1992"\w* siguientes y \w no|strong="H3808"\w* \w las|strong="H1992"\w* comerán \w por|strong="H4480"\w* ser asquerosas: \w el|strong="H1992"\w* águila, \w el|strong="H1992"\w* quebrantahuesos, \w el|strong="H1992"\w* águila pescadora,  
\v 14 el milano, cualquier \w especie|strong="H4327"\w* de halcón,  
\v 15 \w cualquier|strong="H3605"\w* \w especie|strong="H4327"\w* de \w cuervo|strong="H6158"\w*,  
\v 16 el avestruz, la lechuza, la gaviota, cualquier \w especie|strong="H4327"\w* de gavilán,  
\v 17 el búho pequeño, el cormorán, el búho grande,  
\v 18 la lechuza blanca, el pelícano, el buitre,  
\v 19 la cigüeña, cualquier \w especie|strong="H4327"\w* de garza, la abubilla y el murciélago.   
\p
\v 20 “‘\w Cualquier|strong="H3605"\w* insecto \w alado|strong="H5775"\w* \w que|strong="H1931"\w* camine \w en|strong="H5921"\w* cuatro patas \w lo|strong="H1931"\w* considerarán asqueroso.  
\v 21 \w Sin|strong="H3808"\w* embargo, podrán comer \w los|strong="H5921"\w* insectos alados \w que|strong="H3808"\w* \w caminan|strong="H1980"\w* \w en|strong="H5921"\w* cuatro patas \w y|strong="H5921"\w* \w que|strong="H3808"\w* \w además|strong="H5921"\w* tienen patas traseras articuladas \w para|strong="H5921"\w* saltar \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 22 De \w estos|strong="H1992"\w* podrán comer: cualquier \w especie|strong="H4327"\w* de langosta, \w el|strong="H1992"\w* grillo calvo, \w el|strong="H1992"\w* grillo común y cualquier \w especie|strong="H4327"\w* de saltamontes.  
\v 23 Pero \w cualquier|strong="H3605"\w* otro insecto \w alado|strong="H5775"\w* de cuatro patas \w lo|strong="H1931"\w* considerarán asqueroso.   
\p
\v 24 “‘\w Con|strong="H5060"\w* \w los|strong="H3605"\w* siguientes animales ustedes quedarán impuros. \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* toque sus cadáveres quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.  
\v 25 \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* levante \w el|strong="H3605"\w* cadáver \w de|strong="H5704"\w* \w alguno|strong="H3605"\w* \w de|strong="H5704"\w* \w ellos|strong="H3605"\w* deberá lavar su ropa \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.   
\p
\v 26 “‘\w Cualquier|strong="H3605"\w* animal \w que|strong="H1931"\w* tenga pezuñas pero no partidas en dos, \w o|strong="H3068"\w* \w que|strong="H1931"\w* no rumie, \w lo|strong="H1931"\w* considerarán impuro. \w Cualquiera|strong="H3605"\w* \w que|strong="H1931"\w* \w lo|strong="H1931"\w* toque quedará impuro.  
\v 27 \w De|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w animales|strong="H2416"\w* \w de|strong="H5921"\w* cuatro patas, \w los|strong="H1992"\w* \w que|strong="H5921"\w* \w caminan|strong="H1980"\w* \w sobre|strong="H5921"\w* \w sus|strong="H1992"\w* garras \w los|strong="H1992"\w* considerarán impuros. \w Cualquiera|strong="H3605"\w* \w que|strong="H5921"\w* toque \w sus|strong="H1992"\w* cadáveres quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* atardecer.  
\v 28 \w El|strong="H1992"\w* \w que|strong="H5704"\w* recoja \w sus|strong="H1992"\w* cadáveres deberá lavar \w su|strong="H1992"\w* ropa \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H1992"\w* atardecer. \w Los|strong="H1992"\w* considerarán impuros.   
\p
\v 29 “‘\w De|strong="H5921"\w* \w los|strong="H5921"\w* animales \w que|strong="H5921"\w* \w se|strong="H5921"\w* arrastran \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo, considerarán impuros \w los|strong="H5921"\w* siguientes: \w el|strong="H5921"\w* topo, \w el|strong="H5921"\w* ratón, cualquier \w especie|strong="H4327"\w* \w de|strong="H5921"\w* lagarto grande,  
\v 30 el gecko, el lagarto monitor, la lagartija común, el eslizón y el camaleón.  
\v 31 \w De|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* animales \w que|strong="H5704"\w* se arrastran, \w estos|strong="H3605"\w* \w los|strong="H3605"\w* considerarán impuros. \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* \w los|strong="H3605"\w* toque \w cuando|strong="H5704"\w* estén muertos quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.  
\v 32 \w Cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w caiga|strong="H5307"\w* uno \w de|strong="H5921"\w* \w estos|strong="H1992"\w* animales muertos quedará impura, ya sea un artículo \w de|strong="H5921"\w* \w madera|strong="H6086"\w*, \w de|strong="H5921"\w* tela, \w de|strong="H5921"\w* cuero \w o|strong="H3068"\w* un costal. \w Cualquier|strong="H3605"\w* objeto \w que|strong="H5921"\w* \w se|strong="H5921"\w* use \w para|strong="H5704"\w* \w trabajar|strong="H6213"\w* deberá meterse \w en|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* atardecer; \w después|strong="H5921"\w* \w de|strong="H5921"\w* eso quedará \w limpio|strong="H2891"\w*.  
\v 33 Si uno de \w estos|strong="H1992"\w* animales \w cae|strong="H5307"\w* \w dentro|strong="H8432"\w* de una olla de barro, \w todo|strong="H3605"\w* \w lo|strong="H1992"\w* \w que|strong="H1992"\w* esté adentro quedará impuro, y deberán quebrar \w la|strong="H3605"\w* olla.  
\v 34 \w Cualquier|strong="H3605"\w* alimento \w que|strong="H5921"\w* \w se|strong="H5921"\w* pueda comer quedará impuro \w si|strong="H5921"\w* \w le|strong="H5921"\w* cae \w agua|strong="H4325"\w* \w de|strong="H5921"\w* esa olla. \w Cualquier|strong="H3605"\w* líquido \w que|strong="H5921"\w* \w se|strong="H5921"\w* pueda \w beber|strong="H8354"\w* \w de|strong="H5921"\w* esa olla quedará impuro.  
\v 35 \w Cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w caiga|strong="H5307"\w* un pedazo \w de|strong="H5921"\w* \w sus|strong="H1992"\w* cadáveres \w quedará|strong="H1961"\w* impura; \w si|strong="H1961"\w* \w es|strong="H1961"\w* un \w horno|strong="H8574"\w* \w o|strong="H3068"\w* un fogón \w de|strong="H5921"\w* barro, deberán destruirlo. \w Son|strong="H1961"\w* impuros \w y|strong="H5921"\w* \w los|strong="H1992"\w* considerarán impuros.  
\v 36 Sin embargo, un manantial \w o|strong="H3068"\w* una cisterna donde \w se|strong="H1961"\w* junte \w agua|strong="H4325"\w* seguirá siendo \w limpio|strong="H2889"\w*, pero quien toque el cadáver del animal allí dentro \w quedará|strong="H1961"\w* impuro.  
\v 37 \w Si|strong="H3588"\w* un pedazo \w del|strong="H5921"\w* cadáver \w cae|strong="H5307"\w* \w sobre|strong="H5921"\w* semillas \w que|strong="H3588"\w* \w se|strong="H1931"\w* van \w a|strong="H3068"\w* sembrar, \w las|strong="H5921"\w* semillas seguirán estando \w limpias|strong="H2889"\w*.  
\v 38 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* ha \w echado|strong="H5307"\w* \w agua|strong="H4325"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* semilla \w y|strong="H3588"\w* \w luego|strong="H1931"\w* \w le|strong="H1931"\w* \w cae|strong="H5307"\w* un pedazo \w del|strong="H5921"\w* cadáver, considerarán \w la|strong="H1931"\w* semilla \w como|strong="H3588"\w* impura.   
\p
\v 39 “‘\w Si|strong="H3588"\w* muere un animal \w de|strong="H4480"\w* \w los|strong="H1931"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* ustedes \w se|strong="H1931"\w* les permite comer, \w el|strong="H1931"\w* \w que|strong="H3588"\w* toque \w su|strong="H1931"\w* cadáver quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* atardecer.  
\v 40 El \w que|strong="H5704"\w* se coma parte del cadáver deberá lavar su ropa \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* el atardecer. El \w que|strong="H5704"\w* recoja el cadáver también deberá lavar su ropa \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* el atardecer.   
\p
\v 41 “‘\w Cualquier|strong="H3605"\w* animal \w que|strong="H1931"\w* \w se|strong="H1931"\w* arrastre \w por|strong="H5921"\w* \w el|strong="H1931"\w* suelo \w es|strong="H1931"\w* asqueroso; \w no|strong="H3808"\w* \w se|strong="H1931"\w* debe comer.  
\v 42 \w No|strong="H3808"\w* deben comer \w ningún|strong="H3605"\w* animal \w que|strong="H3588"\w* \w se|strong="H5921"\w* arrastre \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo, ya sea \w que|strong="H3588"\w* \w se|strong="H5921"\w* mueva \w sobre|strong="H5921"\w* \w su|strong="H1992"\w* vientre, \w sobre|strong="H5921"\w* cuatro patas \w o|strong="H3068"\w* \w sobre|strong="H5921"\w* \w muchas|strong="H7235"\w* patas, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* asquerosos.  
\v 43 \w No|strong="H3808"\w* \w se|strong="H3808"\w* vuelvan asquerosos \w a|strong="H3068"\w* ustedes mismos comiendo \w ninguno|strong="H3808"\w* de \w estos|strong="H3605"\w* animales \w que|strong="H3808"\w* \w se|strong="H3808"\w* arrastran. \w No|strong="H3808"\w* \w se|strong="H3808"\w* hagan impuros con \w ellos|strong="H3605"\w* \w ni|strong="H3808"\w* \w se|strong="H3808"\w* contaminen por su culpa.  
\v 44 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. \w Por|strong="H5921"\w* \w lo|strong="H3808"\w* \w tanto|strong="H5921"\w*, conságrense \w y|strong="H3588"\w* \w sean|strong="H1961"\w* \w santos|strong="H6918"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* \w santo|strong="H6918"\w*. \w No|strong="H3808"\w* \w se|strong="H1961"\w* contaminen \w con|strong="H5921"\w* \w ningún|strong="H3605"\w* \w animal|strong="H5315"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* arrastre \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 45 \w Yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w sacó|strong="H5927"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w para|strong="H3588"\w* ser \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. \w Sean|strong="H1961"\w* \w santos|strong="H6918"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* \w santo|strong="H6918"\w*.   
\p
\v 46 “‘\w Este|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H5921"\w* reglamento \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w*, \w las|strong="H5921"\w* \w aves|strong="H5775"\w*, \w todas|strong="H3605"\w* \w las|strong="H5921"\w* criaturas \w que|strong="H5921"\w* \w se|strong="H5921"\w* mueven \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* arrastran \w por|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 47 Sirve para distinguir \w entre|strong="H3808"\w* \w lo|strong="H3808"\w* impuro y \w lo|strong="H3808"\w* \w limpio|strong="H2889"\w*, y \w entre|strong="H3808"\w* los \w animales|strong="H2416"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* pueden comer y los \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* deben comer’”.   
\c 12  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘\w Si|strong="H3588"\w* una mujer queda embarazada \w y|strong="H3588"\w* \w da|strong="H2232"\w* \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* un niño, \w será|strong="H2930"\w* ceremonialmente impura durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*; \w será|strong="H2930"\w* impura tal \w como|strong="H3588"\w* lo \w es|strong="H3588"\w* durante \w su|strong="H3588"\w* período menstrual.  
\v 3 Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w*, el niño deberá ser \w circuncidado|strong="H4135"\w*.  
\v 4 \w Después|strong="H3427"\w*, \w la|strong="H3605"\w* mujer deberá esperar \w treinta|strong="H7970"\w* \w y|strong="H5704"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w para|strong="H5704"\w* purificarse del sangrado del parto. \w No|strong="H3808"\w* debe \w tocar|strong="H5060"\w* \w nada|strong="H3808"\w* \w sagrado|strong="H6944"\w* \w ni|strong="H3808"\w* entrar \w al|strong="H5704"\w* \w santuario|strong="H4720"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w cumpla|strong="H4390"\w* \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* \w de|strong="H5704"\w* su purificación.  
\v 5 Pero \w si|strong="H5921"\w* da \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* una niña, \w será|strong="H2930"\w* impura durante \w dos|strong="H3117"\w* \w semanas|strong="H7620"\w*, tal \w como|strong="H5921"\w* \w en|strong="H5921"\w* su período menstrual, \w y|strong="H5921"\w* deberá esperar \w sesenta|strong="H8346"\w* \w y|strong="H5921"\w* \w seis|strong="H8337"\w* \w días|strong="H3117"\w* \w para|strong="H5921"\w* purificarse \w del|strong="H5921"\w* sangrado.   
\p
\v 6 “‘\w Cuando|strong="H3117"\w* se \w cumpla|strong="H4390"\w* \w el|strong="H1121"\w* \w tiempo|strong="H3117"\w* \w de|strong="H1121"\w* su purificación, ya sea por un niño \w o|strong="H3068"\w* por una niña, la mujer llevará \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la Tienda del Encuentro un \w cordero|strong="H3532"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w* para un \w holocausto|strong="H5930"\w*, y un pichón \w o|strong="H3068"\w* una tórtola para una ofrenda por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w*, y se \w los|strong="H1121"\w* entregará \w al|strong="H5930"\w* \w sacerdote|strong="H3548"\w*.  
\v 7 \w El|strong="H5921"\w* sacerdote \w los|strong="H5921"\w* \w ofrecerá|strong="H7126"\w* \w ante|strong="H6440"\w* Yahvé \w y|strong="H5921"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ella|strong="H5921"\w*. \w De|strong="H5921"\w* \w esta|strong="H2063"\w* manera \w la|strong="H5921"\w* mujer quedará purificada \w de|strong="H5921"\w* su flujo \w de|strong="H5921"\w* \w sangre|strong="H1818"\w*.  
\p “‘\w Este|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H5921"\w* reglamento \w para|strong="H5921"\w* \w la|strong="H5921"\w* mujer \w que|strong="H5921"\w* da \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* un niño \w o|strong="H3068"\w* \w a|strong="H3068"\w* una niña.  
\v 8 \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w le|strong="H5921"\w* alcanza \w para|strong="H5921"\w* comprar un \w cordero|strong="H7716"\w*, \w podrá|strong="H3808"\w* llevar \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones: uno \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* otro \w para|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*. \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ella|strong="H5921"\w*, \w y|strong="H5921"\w* quedará purificada’”.   
\c 13  
\p
\v 1 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les \w dijo|strong="H1696"\w*:  
\v 2 “\w Si|strong="H3588"\w* \w a|strong="H3068"\w* alguien le sale \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w piel|strong="H5785"\w* una \w hinchazón|strong="H7613"\w*, una erupción \w o|strong="H3068"\w* una mancha brillante \w que|strong="H3588"\w* pueda convertirse \w en|strong="H3588"\w* una infección \w de|strong="H3588"\w* \w lepra|strong="H6883"\w*, esa persona deberá ser llevada ante \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* Aarón, \w o|strong="H3068"\w* ante uno \w de|strong="H3588"\w* sus \w hijos|strong="H1121"\w*, \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*.  
\v 3 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* examinará \w la|strong="H1931"\w* infección en \w la|strong="H1931"\w* \w piel|strong="H5785"\w*. \w Si|strong="H1931"\w* \w el|strong="H1931"\w* vello en \w la|strong="H1931"\w* zona infectada \w se|strong="H1931"\w* ha vuelto \w blanco|strong="H3836"\w*, y \w la|strong="H1931"\w* infección parece haber penetrado más allá de \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, \w se|strong="H1931"\w* trata de una infección de \w lepra|strong="H6883"\w*. Al examinar \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará impura.  
\v 4 Pero \w si|strong="H3808"\w* \w la|strong="H1931"\w* mancha \w en|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w* \w es|strong="H1931"\w* \w blanca|strong="H3836"\w*, y \w no|strong="H3808"\w* parece ser \w más|strong="H4480"\w* \w profunda|strong="H6013"\w* \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w* \w ni|strong="H3808"\w* \w el|strong="H1931"\w* vello \w se|strong="H1931"\w* \w ha|strong="H3808"\w* vuelto \w blanco|strong="H3836"\w*, \w entonces|strong="H3117"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* aislará \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona infectada durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 5 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, el \w sacerdote|strong="H3548"\w* la examinará \w de|strong="H5869"\w* nuevo. \w Si|strong="H3808"\w* \w a|strong="H3068"\w* su \w parecer|strong="H5869"\w* la infección \w se|strong="H3808"\w* \w ha|strong="H3808"\w* detenido y \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* extendido por la \w piel|strong="H5785"\w*, el \w sacerdote|strong="H3548"\w* la aislará durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w más|strong="H3808"\w*.  
\v 6 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará por \w segunda|strong="H8145"\w* vez al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*. \w Si|strong="H3808"\w* \w la|strong="H1931"\w* infección \w se|strong="H1931"\w* \w ha|strong="H3808"\w* desvanecido y \w no|strong="H3808"\w* \w se|strong="H1931"\w* \w ha|strong="H3808"\w* extendido por \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará pura; \w se|strong="H1931"\w* trata \w solo|strong="H1931"\w* de una erupción. \w La|strong="H1931"\w* persona \w lavará|strong="H3526"\w* \w su|strong="H1931"\w* ropa y quedará pura.  
\v 7 Sin embargo, si la erupción se extiende por la \w piel|strong="H5785"\w* \w después|strong="H8145"\w* de haberse presentado ante el \w sacerdote|strong="H3548"\w* para ser declarada pura, deberá presentarse de nuevo ante él.  
\v 8 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará, y \w si|strong="H1931"\w* \w ve|strong="H7200"\w* \w que|strong="H1931"\w* \w la|strong="H1931"\w* erupción \w se|strong="H1931"\w* ha extendido, \w la|strong="H1931"\w* declarará impura; \w es|strong="H1931"\w* \w lepra|strong="H6883"\w*.   
\p
\v 9 “\w Cuando|strong="H3588"\w* alguien \w tenga|strong="H1961"\w* una infección \w de|strong="H3588"\w* \w lepra|strong="H6883"\w*, \w será|strong="H1961"\w* llevado ante \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w*,  
\v 10 \w quien|strong="H1931"\w* \w lo|strong="H1931"\w* examinará. \w Si|strong="H1931"\w* en \w la|strong="H1931"\w* \w piel|strong="H5785"\w* hay una \w hinchazón|strong="H7613"\w* \w blanca|strong="H3836"\w* \w que|strong="H1931"\w* ha vuelto \w blanco|strong="H3836"\w* \w el|strong="H1931"\w* vello, y hay \w carne|strong="H1320"\w* \w viva|strong="H2416"\w* en \w la|strong="H1931"\w* \w hinchazón|strong="H7613"\w*,  
\v 11 \w se|strong="H1931"\w* trata \w de|strong="H3588"\w* \w lepra|strong="H6883"\w* crónica \w en|strong="H3588"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w*. \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará impura \w a|strong="H3068"\w* \w esa|strong="H1931"\w* persona, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w la|strong="H1931"\w* aislará, \w porque|strong="H3588"\w* ya \w es|strong="H1931"\w* impura.   
\p
\v 12 “Si \w la|strong="H3605"\w* \w lepra|strong="H6883"\w* brota \w por|strong="H5704"\w* \w todas|strong="H3605"\w* partes \w y|strong="H5704"\w* \w cubre|strong="H3680"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w piel|strong="H5785"\w* \w de|strong="H5704"\w* \w la|strong="H3605"\w* persona infectada, \w de|strong="H5704"\w* \w la|strong="H3605"\w* \w cabeza|strong="H7218"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w pies|strong="H7272"\w*, \w hasta|strong="H5704"\w* donde \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* pueda ver,  
\v 13 entonces \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará. \w Si|strong="H1931"\w* \w la|strong="H1931"\w* \w lepra|strong="H6883"\w* ha cubierto \w todo|strong="H3605"\w* \w el|strong="H1931"\w* cuerpo, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará \w pura|strong="H2889"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona. \w Todo|strong="H3605"\w* \w su|strong="H1931"\w* cuerpo \w se|strong="H1931"\w* ha vuelto \w blanco|strong="H3836"\w*, \w así|strong="H1931"\w* \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w puro|strong="H2889"\w*.  
\v 14 Pero el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* le \w aparezca|strong="H7200"\w* \w carne|strong="H1320"\w* \w viva|strong="H2416"\w*, la persona \w será|strong="H2930"\w* impura.  
\v 15 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* examinará \w la|strong="H1931"\w* \w carne|strong="H1320"\w* \w viva|strong="H2416"\w* y \w la|strong="H1931"\w* declarará impura. \w La|strong="H1931"\w* \w carne|strong="H1320"\w* \w viva|strong="H2416"\w* \w es|strong="H1931"\w* impura; \w es|strong="H1931"\w* \w lepra|strong="H6883"\w*.  
\v 16 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w la|strong="H3588"\w* \w carne|strong="H1320"\w* \w viva|strong="H2416"\w* cambia \w y|strong="H3588"\w* \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* ponerse \w blanca|strong="H3836"\w*, \w la|strong="H3588"\w* persona irá \w a|strong="H3068"\w* ver al \w sacerdote|strong="H3548"\w*.  
\v 17 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará, y \w si|strong="H1931"\w* \w la|strong="H1931"\w* \w llaga|strong="H5061"\w* \w se|strong="H1931"\w* ha puesto \w blanca|strong="H3836"\w*, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará \w pura|strong="H2889"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona; \w está|strong="H1931"\w* \w pura|strong="H2889"\w*.   
\p
\v 18 “\w Si|strong="H3588"\w* \w a|strong="H3068"\w* alguien le sale un forúnculo \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w piel|strong="H5785"\w* \w y|strong="H3588"\w* \w se|strong="H1961"\w* le \w cura|strong="H7495"\w*,  
\v 19 pero en su \w lugar|strong="H4725"\w* aparece una \w hinchazón|strong="H7613"\w* \w blanca|strong="H3836"\w* \w o|strong="H3068"\w* una mancha brillante de color \w blanco|strong="H3836"\w* rojizo, la persona deberá \w mostrarse|strong="H7200"\w* al \w sacerdote|strong="H3548"\w*.  
\v 20 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará, y \w si|strong="H1931"\w* \w la|strong="H1931"\w* mancha parece \w más|strong="H4480"\w* profunda \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w* y \w el|strong="H1931"\w* vello \w se|strong="H1931"\w* ha vuelto \w blanco|strong="H3836"\w*, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará impura. \w Es|strong="H1931"\w* una infección \w de|strong="H4480"\w* \w lepra|strong="H6883"\w* \w que|strong="H4480"\w* ha brotado \w en|strong="H4480"\w* \w el|strong="H1931"\w* forúnculo.  
\v 21 Pero \w si|strong="H1931"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examina y \w ve|strong="H7200"\w* \w que|strong="H4480"\w* no \w tiene|strong="H1931"\w* vello \w blanco|strong="H3836"\w* ni \w es|strong="H1931"\w* \w más|strong="H4480"\w* profunda \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, y \w que|strong="H4480"\w* ha ido desapareciendo, \w entonces|strong="H3117"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* aislará durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 22 \w Si|strong="H1931"\w* \w la|strong="H1931"\w* mancha \w se|strong="H1931"\w* extiende por \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará impura; \w es|strong="H1931"\w* una infección.  
\v 23 Pero \w si|strong="H3808"\w* \w la|strong="H1931"\w* mancha brillante \w no|strong="H3808"\w* cambia \w ni|strong="H3808"\w* \w se|strong="H1931"\w* extiende, \w es|strong="H1931"\w* \w solo|strong="H1931"\w* \w la|strong="H1931"\w* cicatriz del forúnculo, y \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará pura.   
\p
\v 24 “\w Si|strong="H3588"\w* alguien \w se|strong="H1961"\w* hace una \w quemadura|strong="H4348"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w piel|strong="H5785"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w carne|strong="H1320"\w* viva \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w quemadura|strong="H4348"\w* \w se|strong="H1961"\w* convierte \w en|strong="H3588"\w* una \w mancha|strong="H4348"\w* brillante \w de|strong="H3588"\w* color \w blanco|strong="H3836"\w* rojizo \w o|strong="H3068"\w* \w blanco|strong="H3836"\w*,  
\v 25 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará. \w Si|strong="H1931"\w* \w el|strong="H1931"\w* vello \w en|strong="H4480"\w* \w la|strong="H1931"\w* \w mancha|strong="H4348"\w* \w se|strong="H1931"\w* ha vuelto \w blanco|strong="H3836"\w* y \w la|strong="H1931"\w* \w mancha|strong="H4348"\w* parece \w más|strong="H4480"\w* \w profunda|strong="H6013"\w* \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, \w es|strong="H1931"\w* \w lepra|strong="H6883"\w* \w que|strong="H4480"\w* ha brotado \w en|strong="H4480"\w* \w la|strong="H1931"\w* \w quemadura|strong="H4348"\w*. \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará impura \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona; \w es|strong="H1931"\w* una infección \w de|strong="H4480"\w* \w lepra|strong="H6883"\w*.  
\v 26 Pero \w si|strong="H1931"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examina y \w ve|strong="H7200"\w* \w que|strong="H4480"\w* no \w tiene|strong="H1931"\w* vello \w blanco|strong="H3836"\w* ni \w es|strong="H1931"\w* \w más|strong="H4480"\w* profunda \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, y \w que|strong="H4480"\w* ha ido desapareciendo, \w entonces|strong="H3117"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* aislará durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 27 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará de nuevo. \w Si|strong="H1931"\w* \w la|strong="H1931"\w* mancha \w se|strong="H1931"\w* ha extendido por \w la|strong="H1931"\w* \w piel|strong="H5785"\w*, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* declarará impura; \w es|strong="H1931"\w* una infección de \w lepra|strong="H6883"\w*.  
\v 28 \w Si|strong="H3588"\w* \w la|strong="H1931"\w* \w mancha|strong="H4348"\w* brillante \w no|strong="H3808"\w* cambia \w ni|strong="H3808"\w* \w se|strong="H1931"\w* extiende, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w ha|strong="H3808"\w* ido desapareciendo, \w es|strong="H1931"\w* \w solo|strong="H1931"\w* \w la|strong="H1931"\w* \w hinchazón|strong="H7613"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w quemadura|strong="H4348"\w*. \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará pura \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona, \w pues|strong="H3588"\w* \w es|strong="H1931"\w* \w solo|strong="H1931"\w* \w la|strong="H1931"\w* cicatriz \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w quemadura|strong="H4348"\w*.   
\p
\v 29 “\w Si|strong="H3588"\w* \w a|strong="H3068"\w* un hombre \w o|strong="H3068"\w* \w a|strong="H3068"\w* una mujer le sale una \w llaga|strong="H5061"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w o|strong="H3068"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w barba|strong="H2206"\w*,  
\v 30 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* examinará \w la|strong="H1931"\w* \w llaga|strong="H5061"\w*. \w Si|strong="H1931"\w* parece \w más|strong="H4480"\w* \w profunda|strong="H6013"\w* \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w piel|strong="H5785"\w* y \w el|strong="H1931"\w* \w pelo|strong="H8181"\w* \w en|strong="H4480"\w* \w esa|strong="H1931"\w* parte \w es|strong="H1931"\w* amarillento y fino, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* declarará impura \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona. \w Se|strong="H1931"\w* trata \w de|strong="H4480"\w* \w tiña|strong="H5424"\w*, \w que|strong="H4480"\w* \w es|strong="H1931"\w* \w lepra|strong="H6883"\w* \w en|strong="H4480"\w* \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w o|strong="H3068"\w* \w en|strong="H4480"\w* \w la|strong="H1931"\w* \w barba|strong="H2206"\w*.  
\v 31 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* examina \w la|strong="H3588"\w* infección \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w tiña|strong="H5424"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* parece ser \w más|strong="H3588"\w* \w profunda|strong="H6013"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w piel|strong="H5785"\w*, \w aunque|strong="H3588"\w* \w no|strong="H3588"\w* tenga \w pelo|strong="H8181"\w* \w negro|strong="H7838"\w*, aislará \w a|strong="H3068"\w* \w la|strong="H3588"\w* persona infectada durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 32 \w Al|strong="H4480"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* el \w sacerdote|strong="H3548"\w* examinará la infección. \w Si|strong="H3808"\w* la \w tiña|strong="H5424"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w ha|strong="H3808"\w* extendido \w ni|strong="H3808"\w* \w tiene|strong="H1961"\w* \w pelo|strong="H8181"\w* amarillento, y \w no|strong="H3808"\w* parece ser \w más|strong="H4480"\w* \w profunda|strong="H6013"\w* \w que|strong="H4480"\w* la \w piel|strong="H5785"\w*,  
\v 33 la persona deberá rasurarse, pero \w no|strong="H3808"\w* \w se|strong="H3808"\w* rasurará la parte afectada por la \w tiña|strong="H5424"\w*. Luego el \w sacerdote|strong="H3548"\w* la aislará durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w más|strong="H3808"\w*.  
\v 34 \w Al|strong="H4480"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* el \w sacerdote|strong="H3548"\w* examinará la \w tiña|strong="H5424"\w*. \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H4480"\w* \w ha|strong="H3808"\w* extendido \w por|strong="H4480"\w* la \w piel|strong="H5785"\w* \w ni|strong="H3808"\w* parece ser \w más|strong="H4480"\w* \w profunda|strong="H6013"\w*, el \w sacerdote|strong="H3548"\w* declarará pura \w a|strong="H3068"\w* la persona. Esta deberá lavar su ropa y quedará pura.  
\v 35 Pero si la \w tiña|strong="H5424"\w* se extiende por la \w piel|strong="H5785"\w* después de que la persona fue declarada pura,  
\v 36 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w la|strong="H1931"\w* examinará de nuevo. \w Si|strong="H3808"\w* \w la|strong="H1931"\w* \w tiña|strong="H5424"\w* \w se|strong="H1931"\w* \w ha|strong="H3808"\w* extendido, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* ya \w no|strong="H3808"\w* tendrá \w que|strong="H1931"\w* buscar \w el|strong="H1931"\w* \w pelo|strong="H8181"\w* amarillento; \w la|strong="H1931"\w* persona \w es|strong="H1931"\w* impura.  
\v 37 Pero \w si|strong="H1931"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w parecer|strong="H5869"\w* \w la|strong="H1931"\w* \w tiña|strong="H5424"\w* ha dejado \w de|strong="H5869"\w* extenderse y \w le|strong="H1931"\w* ha salido \w pelo|strong="H8181"\w* \w negro|strong="H7838"\w*, \w la|strong="H1931"\w* \w tiña|strong="H5424"\w* \w está|strong="H1931"\w* curada. \w La|strong="H1931"\w* persona \w está|strong="H1931"\w* \w pura|strong="H2889"\w*, y \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w así|strong="H1931"\w* \w lo|strong="H1931"\w* declarará.   
\p
\v 38 “\w Si|strong="H3588"\w* \w a|strong="H3068"\w* un hombre \w o|strong="H3068"\w* \w a|strong="H3068"\w* una mujer le salen manchas brillantes \w y|strong="H3588"\w* \w blancas|strong="H3836"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w piel|strong="H5785"\w*,  
\v 39 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* deberá examinar \w a|strong="H3068"\w* \w la|strong="H1931"\w* persona. \w Si|strong="H1931"\w* las manchas en \w la|strong="H1931"\w* \w piel|strong="H5785"\w* son de un \w blanco|strong="H3836"\w* pálido, \w es|strong="H1931"\w* una erupción inofensiva \w que|strong="H1931"\w* ha brotado en \w la|strong="H1931"\w* \w piel|strong="H5785"\w*. \w La|strong="H1931"\w* persona \w está|strong="H1931"\w* \w pura|strong="H2889"\w*.   
\p
\v 40 “\w Si|strong="H3588"\w* \w a|strong="H3068"\w* un hombre \w se|strong="H1931"\w* \w le|strong="H1931"\w* cae \w el|strong="H1931"\w* pelo \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w y|strong="H3588"\w* \w se|strong="H1931"\w* queda \w calvo|strong="H7142"\w*, \w está|strong="H1931"\w* \w puro|strong="H2889"\w*.  
\v 41 \w Si|strong="H1931"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* cae \w el|strong="H1931"\w* pelo \w de|strong="H6440"\w* \w la|strong="H1931"\w* parte \w de|strong="H6440"\w* \w enfrente|strong="H6440"\w* y \w se|strong="H1931"\w* queda medio calvo, \w está|strong="H1931"\w* \w puro|strong="H2889"\w*.  
\v 42 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H1931"\w* parte \w calva|strong="H7146"\w*, ya \w sea|strong="H1961"\w* atrás \w o|strong="H3068"\w* adelante, \w le|strong="H1931"\w* sale una \w llaga|strong="H5061"\w* \w de|strong="H3588"\w* color \w blanco|strong="H3836"\w* rojizo, \w es|strong="H1931"\w* \w lepra|strong="H6883"\w* \w que|strong="H3588"\w* \w está|strong="H1931"\w* brotando.  
\v 43 Entonces el \w sacerdote|strong="H3548"\w* lo examinará. \w Si|strong="H2009"\w* la \w hinchazón|strong="H7613"\w* de la \w llaga|strong="H5061"\w* es de color \w blanco|strong="H3836"\w* rojizo, parecida \w a|strong="H3068"\w* la \w lepra|strong="H6883"\w* en el resto del cuerpo,  
\v 44 \w el|strong="H1931"\w* hombre \w está|strong="H1931"\w* \w leproso|strong="H6879"\w*. \w Es|strong="H1931"\w* impuro, y \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* sin duda \w lo|strong="H1931"\w* declarará impuro; \w la|strong="H1931"\w* infección \w la|strong="H1931"\w* \w tiene|strong="H1931"\w* en \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w*.   
\p
\v 45 “\w La|strong="H5921"\w* persona enferma \w de|strong="H5921"\w* lepra deberá andar \w con|strong="H5921"\w* \w la|strong="H5921"\w* ropa rasgada \w y|strong="H5921"\w* \w el|strong="H5921"\w* pelo despeinado. Deberá cubrirse \w la|strong="H5921"\w* parte inferior \w de|strong="H5921"\w* \w la|strong="H5921"\w* cara \w y|strong="H5921"\w* gritar: ‘¡Impuro! ¡Impuro!’.  
\v 46 \w Mientras|strong="H3605"\w* \w le|strong="H1931"\w* dure \w la|strong="H1931"\w* enfermedad, \w será|strong="H1931"\w* impura. \w Como|strong="H1931"\w* \w es|strong="H1931"\w* impura, deberá vivir aislada; \w su|strong="H1931"\w* lugar de residencia \w estará|strong="H3427"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*.   
\p
\v 47 “\w Si|strong="H3588"\w* \w en|strong="H3588"\w* una prenda \w de|strong="H3588"\w* \w lana|strong="H6785"\w* \w o|strong="H3068"\w* \w de|strong="H3588"\w* \w lino|strong="H6593"\w* aparece una mancha \w de|strong="H3588"\w* moho parecido \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w lepra|strong="H6883"\w*,  
\v 48 ya sea en \w el|strong="H3605"\w* tejido \w o|strong="H3068"\w* en \w el|strong="H3605"\w* hilado del \w lino|strong="H6593"\w* \w o|strong="H3068"\w* de \w la|strong="H3605"\w* \w lana|strong="H6785"\w*, \w o|strong="H3068"\w* en algún artículo de cuero,  
\v 49 y \w si|strong="H1931"\w* \w la|strong="H1931"\w* mancha \w es|strong="H1931"\w* verdosa \w o|strong="H3068"\w* rojiza, \w se|strong="H1961"\w* trata de una \w plaga|strong="H5061"\w* de moho y deberá \w mostrarse|strong="H7200"\w* al \w sacerdote|strong="H3548"\w*.  
\v 50 El \w sacerdote|strong="H3548"\w* examinará la mancha y aislará el artículo afectado durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 51 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w lo|strong="H1931"\w* examinará \w de|strong="H3588"\w* nuevo. \w Si|strong="H3588"\w* \w la|strong="H1931"\w* mancha \w se|strong="H1931"\w* ha extendido \w en|strong="H3588"\w* \w el|strong="H1931"\w* vestido, \w en|strong="H3588"\w* \w el|strong="H1931"\w* tejido, \w en|strong="H3588"\w* \w el|strong="H1931"\w* hilado \w o|strong="H3068"\w* \w en|strong="H3588"\w* \w el|strong="H1931"\w* cuero, sin importar \w para|strong="H3588"\w* \w qué|strong="H3588"\w* \w se|strong="H1931"\w* use \w el|strong="H1931"\w* cuero, \w la|strong="H1931"\w* \w plaga|strong="H5061"\w* \w es|strong="H1931"\w* un moho destructivo \w y|strong="H3588"\w* \w el|strong="H1931"\w* artículo \w es|strong="H1931"\w* impuro.  
\v 52 \w El|strong="H1931"\w* sacerdote deberá quemar \w la|strong="H1931"\w* \w prenda|strong="H3627"\w*, \w el|strong="H1931"\w* tejido \w o|strong="H3068"\w* \w el|strong="H1931"\w* hilado, ya \w sea|strong="H1961"\w* \w de|strong="H3588"\w* \w lana|strong="H6785"\w* \w o|strong="H3068"\w* \w de|strong="H3588"\w* \w lino|strong="H6593"\w*, \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* artículo \w de|strong="H3588"\w* cuero \w que|strong="H3588"\w* \w tenga|strong="H1961"\w* \w la|strong="H1931"\w* \w plaga|strong="H5061"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* un moho destructivo. Deberá quemarse \w por|strong="H3588"\w* completo.   
\p
\v 53 “Pero \w si|strong="H3808"\w* \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w lo|strong="H3808"\w* examina y \w ve|strong="H7200"\w* \w que|strong="H3808"\w* \w la|strong="H3605"\w* mancha \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* extendido,  
\v 54 ordenará \w que|strong="H3117"\w* laven el artículo afectado y lo aislará durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* más.  
\v 55 Después \w de|strong="H5869"\w* \w que|strong="H1931"\w* \w el|strong="H1931"\w* artículo haya sido lavado, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w lo|strong="H1931"\w* examinará. \w Si|strong="H3808"\w* \w la|strong="H1931"\w* mancha \w no|strong="H3808"\w* \w ha|strong="H3808"\w* cambiado \w de|strong="H5869"\w* aspecto, \w aunque|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* haya extendido, \w el|strong="H1931"\w* artículo \w es|strong="H1931"\w* impuro y deberás quemarlo. \w Es|strong="H1931"\w* una \w corrosión|strong="H6356"\w*, \w sin|strong="H3808"\w* importar \w de|strong="H5869"\w* \w qué|strong="H1931"\w* lado \w esté|strong="H1931"\w* \w el|strong="H1931"\w* desgaste.  
\v 56 \w Si|strong="H2009"\w* el \w sacerdote|strong="H3548"\w* lo examina y \w ve|strong="H7200"\w* \w que|strong="H4480"\w* la mancha \w se|strong="H4480"\w* ha desvanecido después \w de|strong="H4480"\w* lavarlo, entonces recortará la parte manchada \w del|strong="H4480"\w* vestido, \w del|strong="H4480"\w* cuero, \w del|strong="H4480"\w* tejido \w o|strong="H3068"\w* \w del|strong="H4480"\w* hilado.  
\v 57 Pero \w si|strong="H1931"\w* \w la|strong="H1931"\w* mancha vuelve \w a|strong="H3068"\w* aparecer, significa \w que|strong="H1931"\w* \w la|strong="H1931"\w* \w plaga|strong="H5061"\w* \w se|strong="H1931"\w* \w está|strong="H1931"\w* extendiendo. Deberás quemar \w el|strong="H1931"\w* artículo \w que|strong="H1931"\w* tenga \w la|strong="H1931"\w* \w plaga|strong="H5061"\w*.  
\v 58 \w En|strong="H5493"\w* cambio, si al lavar \w la|strong="H3605"\w* \w prenda|strong="H3627"\w*, \w el|strong="H3605"\w* tejido, \w el|strong="H3605"\w* hilado \w o|strong="H3068"\w* \w el|strong="H3605"\w* artículo de cuero, \w la|strong="H3605"\w* mancha desaparece, \w se|strong="H1992"\w* \w lavará|strong="H3526"\w* por \w segunda|strong="H8145"\w* vez y \w el|strong="H3605"\w* artículo quedará puro”.   
\p
\v 59 \w Este|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H3605"\w* reglamento sobre \w la|strong="H2063"\w* \w plaga|strong="H5061"\w* de moho en una \w prenda|strong="H3627"\w* de \w lana|strong="H6785"\w* \w o|strong="H3068"\w* de \w lino|strong="H6593"\w*, en un tejido, en un hilado \w o|strong="H3068"\w* en un artículo de cuero, para declararlos puros \w o|strong="H3068"\w* impuros.   
\c 14  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:   
\p
\v 2 “\w Este|strong="H2063"\w* \w será|strong="H1961"\w* el reglamento \w para|strong="H1961"\w* \w la|strong="H2063"\w* persona con lepra en el \w día|strong="H3117"\w* de su purificación. \w La|strong="H2063"\w* persona \w será|strong="H1961"\w* llevada ante el \w sacerdote|strong="H3548"\w*,  
\v 3 quien \w saldrá|strong="H3318"\w* \w fuera|strong="H2351"\w* \w del|strong="H4480"\w* \w campamento|strong="H4264"\w* \w para|strong="H4480"\w* examinarla. \w Si|strong="H2009"\w* la infección \w de|strong="H4480"\w* \w lepra|strong="H6883"\w* \w se|strong="H4480"\w* le ha curado,  
\v 4 el \w sacerdote|strong="H3548"\w* ordenará que \w traigan|strong="H3947"\w* \w dos|strong="H8147"\w* aves \w vivas|strong="H2416"\w* y puras, \w madera|strong="H6086"\w* de cedro, hilo escarlata y ramas de hisopo para la persona que se \w va|strong="H3068"\w* \w a|strong="H3068"\w* purificar.  
\v 5 Luego \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* ordenará \w que|strong="H5921"\w* degüellen una \w de|strong="H5921"\w* \w las|strong="H5921"\w* aves \w sobre|strong="H5921"\w* una olla \w de|strong="H5921"\w* barro \w con|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* manantial.  
\v 6 \w Tomará|strong="H3947"\w* \w el|strong="H5921"\w* \w ave|strong="H6833"\w* \w viva|strong="H2416"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w madera|strong="H6086"\w* \w de|strong="H5921"\w* cedro, \w el|strong="H5921"\w* hilo escarlata \w y|strong="H5921"\w* \w el|strong="H5921"\w* hisopo, \w y|strong="H5921"\w* \w los|strong="H5921"\w* mojará todos, incluida \w el|strong="H5921"\w* \w ave|strong="H6833"\w* \w viva|strong="H2416"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w del|strong="H5921"\w* \w ave|strong="H6833"\w* degollada \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* manantial.  
\v 7 \w Rociará|strong="H5137"\w* esa sangre \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w persona|strong="H6440"\w* \w que|strong="H4480"\w* \w se|strong="H5921"\w* \w está|strong="H5921"\w* purificando \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w lepra|strong="H6883"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* declarará pura. \w Después|strong="H5921"\w* soltará \w el|strong="H5921"\w* \w ave|strong="H6833"\w* \w viva|strong="H2416"\w* \w en|strong="H5921"\w* \w campo|strong="H7704"\w* abierto.   
\p
\v 8 “\w La|strong="H3605"\w* persona \w que|strong="H3117"\w* se \w está|strong="H3427"\w* purificando deberá lavar su ropa, rasurarse \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pelo|strong="H8181"\w* y bañarse; \w de|strong="H4325"\w* este modo quedará pura. \w Después|strong="H3427"\w* podrá entrar al \w campamento|strong="H4264"\w*, pero tendrá \w que|strong="H3117"\w* quedarse \w fuera|strong="H2351"\w* \w de|strong="H4325"\w* su propia tienda durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 9 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* volverá \w a|strong="H3068"\w* rasurarse \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pelo|strong="H8181"\w*: \w la|strong="H3605"\w* \w cabeza|strong="H7218"\w*, \w la|strong="H3605"\w* \w barba|strong="H2206"\w*, las cejas y \w cualquier|strong="H3605"\w* otro \w pelo|strong="H8181"\w* \w que|strong="H3117"\w* \w tenga|strong="H1961"\w*. \w Lavará|strong="H3526"\w* su ropa y \w se|strong="H1961"\w* bañará, y \w entonces|strong="H3117"\w* \w quedará|strong="H1961"\w* pura.   
\p
\v 10 “Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w*, la persona \w tomará|strong="H3947"\w* \w dos|strong="H8147"\w* \w corderos|strong="H3532"\w* sin defecto, una \w cordera|strong="H3535"\w* de un \w año|strong="H8141"\w* sin defecto, \w tres|strong="H7969"\w* kilos de harina fina \w amasada|strong="H1101"\w* con \w aceite|strong="H8081"\w* como \w ofrenda|strong="H4503"\w* de cereal, y un \w log|strong="H3849"\w* de \w aceite|strong="H8081"\w*.  
\v 11 El \w sacerdote|strong="H3548"\w* que realiza la purificación \w presentará|strong="H5975"\w* \w a|strong="H3068"\w* la \w persona|strong="H6440"\w*, junto con sus ofrendas, \w ante|strong="H6440"\w* Yahvé \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Tienda del Encuentro.   
\p
\v 12 “El \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* uno \w de|strong="H6440"\w* los \w corderos|strong="H3532"\w* y el \w log|strong="H3849"\w* \w de|strong="H6440"\w* \w aceite|strong="H8081"\w*, y los \w presentará|strong="H7126"\w* como \w ofrenda|strong="H8573"\w* \w por|strong="H6440"\w* la culpa; los \w presentará|strong="H7126"\w* \w ante|strong="H6440"\w* Yahvé como \w ofrenda|strong="H8573"\w* mecida.  
\v 13 Degollará \w el|strong="H1931"\w* \w cordero|strong="H3532"\w* \w en|strong="H3588"\w* \w el|strong="H1931"\w* área del \w santuario|strong="H6944"\w*, \w en|strong="H3588"\w* \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* \w lugar|strong="H4725"\w* \w donde|strong="H4725"\w* \w se|strong="H1931"\w* \w degüellan|strong="H7819"\w* \w los|strong="H1931"\w* animales \w para|strong="H3588"\w* \w la|strong="H1931"\w* ofrenda \w por|strong="H3588"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w* \w y|strong="H3588"\w* \w para|strong="H3588"\w* \w el|strong="H1931"\w* \w holocausto|strong="H5930"\w*. \w El|strong="H1931"\w* sacrificio \w por|strong="H3588"\w* \w la|strong="H1931"\w* culpa, \w al|strong="H5930"\w* igual \w que|strong="H3588"\w* \w el|strong="H1931"\w* sacrificio \w por|strong="H3588"\w* \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*, \w le|strong="H1931"\w* pertenece \w al|strong="H5930"\w* \w sacerdote|strong="H3548"\w*; \w es|strong="H1931"\w* una ofrenda muy \w santa|strong="H6944"\w*.  
\v 14 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* un poco \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* untará \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona \w en|strong="H5921"\w* \w el|strong="H5921"\w* lóbulo \w de|strong="H5921"\w* \w la|strong="H5921"\w* oreja \w derecha|strong="H3233"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* pulgar \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w derecha|strong="H3233"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* dedo gordo \w del|strong="H5921"\w* \w pie|strong="H7272"\w* \w derecho|strong="H3233"\w*.  
\v 15 Luego \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w echará|strong="H3332"\w* un poco \w del|strong="H5921"\w* \w log|strong="H3849"\w* \w de|strong="H5921"\w* \w aceite|strong="H8081"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* palma \w de|strong="H5921"\w* su propia \w mano|strong="H3709"\w* \w izquierda|strong="H8042"\w*,  
\v 16 mojará \w el|strong="H5921"\w* dedo \w derecho|strong="H3233"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w rociará|strong="H5137"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* dedo \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w delante|strong="H6440"\w* \w de|strong="H4480"\w* Yahvé.  
\v 17 \w Del|strong="H5921"\w* \w aceite|strong="H8081"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* quede \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w le|strong="H5921"\w* untará un poco \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona \w en|strong="H5921"\w* \w el|strong="H5921"\w* lóbulo \w de|strong="H5921"\w* \w la|strong="H5921"\w* oreja \w derecha|strong="H3233"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* pulgar \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w derecha|strong="H3233"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* dedo gordo \w del|strong="H5921"\w* \w pie|strong="H7272"\w* \w derecho|strong="H3233"\w*, exactamente \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa.  
\v 18 \w Y|strong="H3068"\w* \w el|strong="H5921"\w* resto \w del|strong="H5921"\w* \w aceite|strong="H8081"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* quede \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3709"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* untará \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w persona|strong="H6440"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H5414"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* esa \w persona|strong="H6440"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.   
\p
\v 19 “\w Después|strong="H5921"\w* \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* presentará \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w para|strong="H5921"\w* \w hacer|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* persona \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w está|strong="H5921"\w* purificando. Luego degollará \w el|strong="H5921"\w* animal \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w*,  
\v 20 \w y|strong="H5921"\w* ofrecerá \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w tanto|strong="H5921"\w* \w el|strong="H5921"\w* \w holocausto|strong="H5930"\w* \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* persona, \w y|strong="H5921"\w* \w esta|strong="H5921"\w* quedará pura.   
\p
\v 21 “Pero \w si|strong="H1931"\w* \w la|strong="H1931"\w* persona \w es|strong="H1931"\w* \w pobre|strong="H1800"\w* \w y|strong="H5921"\w* \w no|strong="H5921"\w* \w le|strong="H1931"\w* alcanza \w para|strong="H5921"\w* \w tanto|strong="H5921"\w*, \w tomará|strong="H3947"\w* \w solo|strong="H1931"\w* un \w cordero|strong="H3532"\w* \w como|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w por|strong="H5921"\w* \w la|strong="H1931"\w* culpa. \w El|strong="H1931"\w* \w cordero|strong="H3532"\w* \w se|strong="H1931"\w* presentará \w como|strong="H5921"\w* \w ofrenda|strong="H4503"\w* mecida \w para|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ella|strong="H1931"\w*. \w Además|strong="H5921"\w*, \w llevará|strong="H3947"\w* un kilo \w de|strong="H5921"\w* harina fina \w amasada|strong="H1101"\w* \w con|strong="H5921"\w* \w aceite|strong="H8081"\w* \w como|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal, un \w log|strong="H3849"\w* \w de|strong="H5921"\w* \w aceite|strong="H8081"\w*,  
\v 22 y \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones, según lo \w que|strong="H1121"\w* pueda pagar. Una \w de|strong="H1121"\w* las aves \w será|strong="H1961"\w* \w para|strong="H1961"\w* la ofrenda \w por|strong="H3027"\w* \w el|strong="H1121"\w* \w pecado|strong="H2403"\w* y la otra \w para|strong="H1961"\w* \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*.   
\p
\v 23 “Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* llevará todo esto al \w sacerdote|strong="H3548"\w* para su purificación, \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Tienda del Encuentro, \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 24 El \w sacerdote|strong="H3548"\w* \w tomará|strong="H3947"\w* el \w cordero|strong="H3532"\w* \w de|strong="H6440"\w* la \w ofrenda|strong="H8573"\w* \w por|strong="H6440"\w* la culpa y el \w log|strong="H3849"\w* \w de|strong="H6440"\w* \w aceite|strong="H8081"\w*, y los presentará \w ante|strong="H6440"\w* Yahvé como \w ofrenda|strong="H8573"\w* mecida.  
\v 25 Luego degollará \w el|strong="H5921"\w* \w cordero|strong="H3532"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa, \w tomará|strong="H3947"\w* un poco \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* untará \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona \w en|strong="H5921"\w* \w el|strong="H5921"\w* lóbulo \w de|strong="H5921"\w* \w la|strong="H5921"\w* oreja \w derecha|strong="H3233"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* pulgar \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w derecha|strong="H3233"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* dedo gordo \w del|strong="H5921"\w* \w pie|strong="H7272"\w* \w derecho|strong="H3233"\w*.  
\v 26 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w echará|strong="H3332"\w* un poco \w del|strong="H4480"\w* \w aceite|strong="H8081"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* palma \w de|strong="H4480"\w* su propia \w mano|strong="H3709"\w* \w izquierda|strong="H8042"\w*,  
\v 27 \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* dedo \w derecho|strong="H3233"\w* \w rociará|strong="H5137"\w* \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w delante|strong="H6440"\w* \w de|strong="H4480"\w* Yahvé.  
\v 28 Luego \w le|strong="H5921"\w* untará un poco \w de|strong="H4480"\w* ese \w aceite|strong="H8081"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* persona \w en|strong="H5921"\w* \w el|strong="H5921"\w* lóbulo \w de|strong="H4480"\w* \w la|strong="H5921"\w* oreja \w derecha|strong="H3233"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* pulgar \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w derecha|strong="H3233"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* dedo gordo \w del|strong="H4480"\w* \w pie|strong="H7272"\w* \w derecho|strong="H3233"\w*, exactamente \w en|strong="H5921"\w* \w el|strong="H5921"\w* mismo \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* \w le|strong="H5921"\w* untó \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa.  
\v 29 \w El|strong="H5921"\w* \w aceite|strong="H8081"\w* \w que|strong="H4480"\w* \w le|strong="H5921"\w* \w sobre|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3709"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* untará \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w persona|strong="H6440"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w para|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ella|strong="H4480"\w* \w delante|strong="H6440"\w* \w de|strong="H4480"\w* Yahvé.  
\v 30 Finalmente, \w el|strong="H1121"\w* sacerdote \w ofrecerá|strong="H6213"\w* las \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w los|strong="H1121"\w* pichones \w que|strong="H4480"\w* la persona haya podido pagar.  
\v 31 Presentará una \w de|strong="H5921"\w* \w las|strong="H5921"\w* aves \w como|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* otra \w como|strong="H5921"\w* \w holocausto|strong="H5930"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* cereal. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* hará \w expiación|strong="H3722"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w persona|strong="H6440"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w está|strong="H5921"\w* purificando”.   
\p
\v 32 \w Este|strong="H2063"\w* \w es|strong="H3027"\w* el reglamento para el \w que|strong="H3808"\w* tiene una infección de \w lepra|strong="H6883"\w* y \w no|strong="H3808"\w* le alcanza para pagar las ofrendas normales para su purificación.   
\p
\v 33 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les \w dijo|strong="H1696"\w*:  
\v 34 “\w Cuando|strong="H3588"\w* ustedes entren \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Canaán|strong="H3667"\w*, \w la|strong="H3588"\w* \w cual|strong="H3588"\w* les \w doy|strong="H5414"\w* \w en|strong="H3588"\w* posesión, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* envíe una \w plaga|strong="H5061"\w* \w de|strong="H3588"\w* moho sobre alguna \w de|strong="H3588"\w* las \w casas|strong="H1004"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* tierra,  
\v 35 el dueño de la \w casa|strong="H1004"\w* irá y le dirá al \w sacerdote|strong="H3548"\w*: ‘Me parece que hay una \w plaga|strong="H5061"\w* de moho en mi \w casa|strong="H1004"\w*’.  
\v 36 \w El|strong="H3605"\w* \w sacerdote|strong="H3548"\w* ordenará \w que|strong="H3808"\w* desocupen \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w antes|strong="H2962"\w* de entrar \w a|strong="H3068"\w* examinar \w la|strong="H3605"\w* \w plaga|strong="H5061"\w*, para \w que|strong="H3808"\w* \w nada|strong="H3808"\w* de \w lo|strong="H3808"\w* \w que|strong="H3808"\w* hay \w adentro|strong="H1004"\w* sea declarado impuro. Después de \w eso|strong="H3651"\w*, \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* entrará \w a|strong="H3068"\w* examinar \w la|strong="H3605"\w* \w casa|strong="H1004"\w*.  
\v 37 Examinará la mancha, y \w si|strong="H2009"\w* \w ve|strong="H7200"\w* \w que|strong="H4480"\w* \w en|strong="H4480"\w* las paredes hay cavidades verdosas \w o|strong="H3068"\w* rojizas \w que|strong="H4480"\w* parecen penetrar \w más|strong="H4480"\w* allá \w de|strong="H4480"\w* la superficie,  
\v 38 \w saldrá|strong="H3318"\w* \w de|strong="H4480"\w* la \w casa|strong="H1004"\w*, \w cerrará|strong="H5462"\w* la \w puerta|strong="H6607"\w* y la dejará aislada durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.  
\v 39 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, el \w sacerdote|strong="H3548"\w* regresará y la examinará. \w Si|strong="H2009"\w* la mancha se ha extendido por las paredes,  
\v 40 ordenará que quiten las piedras manchadas y las tiren en un \w lugar|strong="H4725"\w* impuro \w fuera|strong="H2351"\w* de la \w ciudad|strong="H5892"\w*.  
\v 41 Hará que raspen \w todo|strong="H5439"\w* el interior de la \w casa|strong="H1004"\w*, y el \w polvo|strong="H6083"\w* raspado lo echarán en un \w lugar|strong="H4725"\w* impuro \w fuera|strong="H2351"\w* de la \w ciudad|strong="H5892"\w*.  
\v 42 Luego pondrán otras piedras \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* las primeras y revocarán la \w casa|strong="H1004"\w* con mezcla nueva.   
\p
\v 43 “Si la \w plaga|strong="H5061"\w* \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* aparecer en la \w casa|strong="H1004"\w* después de que le quitaron las piedras, la rasparon y la revocaron,  
\v 44 \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* entrará \w a|strong="H3068"\w* examinarla. \w Si|strong="H1931"\w* \w la|strong="H1931"\w* mancha \w se|strong="H1931"\w* ha extendido, \w es|strong="H1931"\w* un moho destructivo en \w la|strong="H1931"\w* \w casa|strong="H1004"\w*, y \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w es|strong="H1931"\w* impura.  
\v 45 Deberán derrumbar \w la|strong="H3605"\w* \w casa|strong="H1004"\w* por completo —las piedras, \w la|strong="H3605"\w* \w madera|strong="H6086"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* revoco— y llevarán \w los|strong="H3605"\w* escombros \w a|strong="H3068"\w* un \w lugar|strong="H4725"\w* impuro \w fuera|strong="H2351"\w* de \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*.   
\p
\v 46 “\w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* entre \w en|strong="H5704"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w mientras|strong="H3605"\w* esté \w cerrada|strong="H5462"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.  
\v 47 El que duerma \w o|strong="H3068"\w* coma allí dentro deberá lavar su ropa.   
\p
\v 48 “\w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* entra \w a|strong="H3068"\w* examinar \w la|strong="H3588"\w* \w casa|strong="H1004"\w* después \w de|strong="H3588"\w* \w haber|strong="H3808"\w* sido revocada \w y|strong="H3588"\w* \w ve|strong="H7200"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* mancha \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* extendido, \w la|strong="H3588"\w* declarará pura, \w pues|strong="H3588"\w* \w la|strong="H3588"\w* \w plaga|strong="H5061"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* curado.  
\v 49 Para purificar la \w casa|strong="H1004"\w*, \w tomará|strong="H3947"\w* \w dos|strong="H8147"\w* aves, \w madera|strong="H6086"\w* de cedro, hilo escarlata y ramas de hisopo.  
\v 50 Degollará una \w de|strong="H5921"\w* \w las|strong="H5921"\w* aves \w sobre|strong="H5921"\w* una olla \w de|strong="H5921"\w* barro \w con|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* manantial.  
\v 51 Luego \w tomará|strong="H3947"\w* la \w madera|strong="H6086"\w* \w de|strong="H1818"\w* cedro, el hisopo, el hilo escarlata y el \w ave|strong="H6833"\w* \w viva|strong="H2416"\w*, los mojará en la \w sangre|strong="H1818"\w* del \w ave|strong="H6833"\w* degollada y en el \w agua|strong="H4325"\w* \w de|strong="H1818"\w* manantial, y \w rociará|strong="H5137"\w* la \w casa|strong="H1004"\w* \w siete|strong="H7651"\w* \w veces|strong="H6471"\w*.  
\v 52 Purificará la \w casa|strong="H1004"\w* con la \w sangre|strong="H1818"\w* del \w ave|strong="H6833"\w*, el \w agua|strong="H4325"\w* \w de|strong="H1818"\w* manantial, el \w ave|strong="H6833"\w* \w viva|strong="H2416"\w*, la \w madera|strong="H6086"\w* \w de|strong="H1818"\w* cedro, el hisopo y el hilo escarlata.  
\v 53 Finalmente, soltará \w el|strong="H5921"\w* \w ave|strong="H6833"\w* \w viva|strong="H2416"\w* \w fuera|strong="H2351"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w en|strong="H5921"\w* \w campo|strong="H7704"\w* abierto. Así hará \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w y|strong="H5921"\w* \w esta|strong="H5921"\w* quedará pura”.   
\p
\v 54 \w Este|strong="H2063"\w* \w es|strong="H2063"\w* \w el|strong="H3605"\w* reglamento para \w cualquier|strong="H3605"\w* clase de infección de \w lepra|strong="H6883"\w* \w o|strong="H3068"\w* \w tiña|strong="H5424"\w*,  
\v 55 para el moho en la ropa \w o|strong="H3068"\w* en las \w casas|strong="H1004"\w*,  
\v 56 y para las hinchazones, erupciones y manchas brillantes.  
\v 57 Sirve para \w enseñar|strong="H3384"\w* \w cuándo|strong="H3117"\w* algo \w es|strong="H2063"\w* impuro y \w cuándo|strong="H3117"\w* \w es|strong="H2063"\w* \w puro|strong="H2889"\w*.  
\p \w Este|strong="H2063"\w* \w es|strong="H2063"\w* el reglamento sobre \w la|strong="H2063"\w* \w lepra|strong="H6883"\w*.   
\c 15  
\p
\v 1 Yahvé les \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les \w dijo|strong="H1696"\w*:  
\v 2 “Díganles \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘Cualquier \w hombre|strong="H1121"\w* \w que|strong="H3588"\w* \w tenga|strong="H1961"\w* un \w flujo|strong="H2101"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* cuerpo \w es|strong="H1931"\w* impuro \w a|strong="H3068"\w* causa \w de|strong="H3588"\w* \w ese|strong="H1931"\w* \w flujo|strong="H2101"\w*.  
\v 3 \w Su|strong="H1931"\w* impureza consiste en \w lo|strong="H1931"\w* siguiente: ya \w sea|strong="H1961"\w* \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w flujo|strong="H2101"\w* \w le|strong="H1931"\w* salga del cuerpo \w o|strong="H3068"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* \w le|strong="H1931"\w* retenga, \w el|strong="H1931"\w* hombre \w es|strong="H1931"\w* impuro.   
\p
\v 4 “‘\w Cualquier|strong="H3605"\w* \w cama|strong="H4904"\w* \w donde|strong="H5921"\w* \w se|strong="H5921"\w* acueste \w y|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w mueble|strong="H3627"\w* \w donde|strong="H5921"\w* \w se|strong="H5921"\w* siente serán impuros.  
\v 5 El \w que|strong="H5704"\w* toque la \w cama|strong="H4904"\w* del hombre impuro deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* el atardecer.  
\v 6 \w El|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* siente \w en|strong="H5921"\w* \w el|strong="H5921"\w* mismo lugar \w donde|strong="H5921"\w* \w se|strong="H5921"\w* sentó \w el|strong="H5921"\w* hombre impuro deberá lavar su ropa \w y|strong="H5921"\w* bañarse, \w y|strong="H5921"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* atardecer.   
\p
\v 7 “‘El \w que|strong="H5704"\w* toque el cuerpo \w de|strong="H5704"\w* ese hombre deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* el atardecer.   
\p
\v 8 “‘\w Si|strong="H3588"\w* \w el|strong="H3588"\w* hombre del flujo le escupe \w a|strong="H3068"\w* alguien \w que|strong="H3588"\w* está \w puro|strong="H2889"\w*, esa persona deberá lavar \w su|strong="H3588"\w* ropa \w y|strong="H3588"\w* bañarse, \w y|strong="H3588"\w* quedará impura \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* atardecer.   
\p
\v 9 “‘\w Cualquier|strong="H3605"\w* montura \w que|strong="H5921"\w* use \w el|strong="H5921"\w* hombre \w del|strong="H5921"\w* flujo \w será|strong="H2930"\w* impura.  
\v 10 \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* toque \w lo|strong="H5704"\w* \w que|strong="H5704"\w* \w haya|strong="H1961"\w* \w estado|strong="H1961"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w él|strong="H3605"\w* \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer. \w El|strong="H3605"\w* \w que|strong="H5704"\w* cargue \w con|strong="H5060"\w* esas cosas deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.   
\p
\v 11 “‘\w Si|strong="H3808"\w* \w el|strong="H3605"\w* hombre del flujo \w toca|strong="H5060"\w* \w a|strong="H3068"\w* alguien \w sin|strong="H3808"\w* haberse lavado primero las \w manos|strong="H3027"\w*, esa persona deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* quedará impura \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.   
\p
\v 12 “‘\w Cualquier|strong="H3605"\w* olla \w de|strong="H4325"\w* barro \w que|strong="H4325"\w* toque \w el|strong="H3605"\w* hombre del flujo deberá romperse, y \w cualquier|strong="H3605"\w* utensilio \w de|strong="H4325"\w* \w madera|strong="H6086"\w* \w que|strong="H4325"\w* toque deberá lavarse \w con|strong="H5060"\w* \w agua|strong="H4325"\w*.   
\p
\v 13 “‘\w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* hombre sane \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w flujo|strong="H2101"\w*, \w contará|strong="H5608"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w para|strong="H3588"\w* \w su|strong="H3588"\w* purificación. Luego \w lavará|strong="H3526"\w* \w su|strong="H3588"\w* ropa \w y|strong="H3588"\w* se bañará \w en|strong="H3588"\w* \w agua|strong="H4325"\w* \w de|strong="H3588"\w* manantial, \w y|strong="H3588"\w* quedará puro.   
\p
\v 14 “‘Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* \w tomará|strong="H3947"\w* \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones, se presentará \w ante|strong="H6440"\w* Yahvé \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Tienda del Encuentro y se \w los|strong="H1121"\w* \w entregará|strong="H5414"\w* al \w sacerdote|strong="H3548"\w*.  
\v 15 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w ofrecerá|strong="H6213"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* aves \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w otra|strong="H6213"\w* \w como|strong="H5921"\w* \w holocausto|strong="H5930"\w*. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* su \w flujo|strong="H2101"\w*.   
\p
\v 16 “‘\w Si|strong="H3588"\w* \w a|strong="H3068"\w* un hombre le \w sale|strong="H3318"\w* \w semen|strong="H7902"\w*, deberá bañar \w todo|strong="H3605"\w* \w su|strong="H3588"\w* cuerpo \w en|strong="H4480"\w* \w agua|strong="H4325"\w* \w y|strong="H3588"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* atardecer.  
\v 17 \w Cualquier|strong="H3605"\w* ropa \w o|strong="H3068"\w* cuero \w que|strong="H5921"\w* \w se|strong="H1961"\w* manche \w de|strong="H5921"\w* \w semen|strong="H7902"\w* deberá \w lavarse|strong="H3526"\w* \w con|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* atardecer.  
\v 18 Si un hombre \w y|strong="H5704"\w* una mujer tienen relaciones sexuales \w y|strong="H5704"\w* \w a|strong="H3068"\w* él le sale \w semen|strong="H7902"\w*, ambos deberán bañarse \w y|strong="H5704"\w* quedarán impuros \w hasta|strong="H5704"\w* el atardecer.   
\p
\v 19 “‘\w Cuando|strong="H3588"\w* una mujer \w tenga|strong="H1961"\w* \w su|strong="H3588"\w* período menstrual, \w su|strong="H3588"\w* impureza durará \w siete|strong="H7651"\w* \w días|strong="H3117"\w*. \w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* toque \w quedará|strong="H1961"\w* impuro \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* atardecer.   
\p
\v 20 “‘\w Cualquier|strong="H3605"\w* lugar \w donde|strong="H5921"\w* \w ella|strong="H3605"\w* \w se|strong="H5921"\w* acueste \w o|strong="H3068"\w* \w se|strong="H5921"\w* siente durante su período \w será|strong="H2930"\w* impuro.  
\v 21 \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* toque \w la|strong="H3605"\w* \w cama|strong="H4904"\w* \w de|strong="H5704"\w* \w ella|strong="H3605"\w* deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.  
\v 22 \w Cualquiera|strong="H3605"\w* \w que|strong="H5921"\w* toque \w el|strong="H5921"\w* \w mueble|strong="H3627"\w* \w donde|strong="H5921"\w* \w ella|strong="H3605"\w* \w se|strong="H5921"\w* sentó deberá lavar su ropa \w y|strong="H5921"\w* bañarse, \w y|strong="H5921"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* atardecer.  
\v 23 \w Ya|strong="H3068"\w* sea \w que|strong="H1931"\w* toque \w la|strong="H1931"\w* \w cama|strong="H4904"\w* \w o|strong="H3068"\w* \w el|strong="H1931"\w* \w mueble|strong="H3627"\w*, quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* atardecer.   
\p
\v 24 “‘\w Si|strong="H1961"\w* un hombre \w se|strong="H1961"\w* acuesta \w con|strong="H5921"\w* \w ella|strong="H5921"\w* \w y|strong="H5921"\w* entra \w en|strong="H5921"\w* contacto \w con|strong="H5921"\w* \w la|strong="H5921"\w* sangre \w de|strong="H5921"\w* su menstruación, \w quedará|strong="H1961"\w* impuro durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, \w y|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w cama|strong="H4904"\w* \w donde|strong="H5921"\w* \w él|strong="H5921"\w* \w se|strong="H1961"\w* acueste \w será|strong="H1961"\w* impura.   
\p
\v 25 “‘\w Si|strong="H3588"\w* una mujer \w tiene|strong="H1961"\w* un \w flujo|strong="H2101"\w* \w de|strong="H5921"\w* \w sangre|strong="H1818"\w* durante \w muchos|strong="H7227"\w* \w días|strong="H3117"\w* \w fuera|strong="H1961"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* período normal, \w o|strong="H3068"\w* \w si|strong="H3588"\w* \w el|strong="H1931"\w* sangrado \w le|strong="H1931"\w* dura \w más|strong="H3588"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5921"\w* \w lo|strong="H1931"\w* normal, \w será|strong="H1961"\w* impura \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w que|strong="H3588"\w* \w le|strong="H1931"\w* dure \w el|strong="H1931"\w* \w flujo|strong="H2101"\w*, tal \w como|strong="H3588"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* menstruación.  
\v 26 \w Cualquier|strong="H3605"\w* \w cama|strong="H4904"\w* \w donde|strong="H5921"\w* \w se|strong="H1961"\w* acueste \w y|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w mueble|strong="H3627"\w* \w donde|strong="H5921"\w* \w se|strong="H1961"\w* siente durante esos \w días|strong="H3117"\w* \w serán|strong="H1961"\w* impuros, igual \w que|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H3427"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* su menstruación.  
\v 27 \w Cualquiera|strong="H3605"\w* \w que|strong="H5704"\w* toque esas cosas quedará impuro, \w por|strong="H5704"\w* \w lo|strong="H5704"\w* \w que|strong="H5704"\w* deberá lavar su ropa \w y|strong="H5704"\w* bañarse, \w y|strong="H5704"\w* quedará impuro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* atardecer.   
\p
\v 28 “‘\w Cuando|strong="H3117"\w* la mujer sane de su \w flujo|strong="H2101"\w*, \w contará|strong="H5608"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, y después quedará pura.  
\v 29 Al \w octavo|strong="H8066"\w* \w día|strong="H3117"\w* \w tomará|strong="H3947"\w* \w dos|strong="H8147"\w* \w tórtolas|strong="H8449"\w* \w o|strong="H3068"\w* \w dos|strong="H8147"\w* pichones y se \w los|strong="H1121"\w* \w llevará|strong="H3947"\w* al \w sacerdote|strong="H3548"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la Tienda del Encuentro.  
\v 30 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w ofrecerá|strong="H6213"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* aves \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w otra|strong="H6213"\w* \w como|strong="H5921"\w* \w holocausto|strong="H5930"\w*. Así \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w hará|strong="H6213"\w* \w expiación|strong="H3722"\w* \w por|strong="H5921"\w* \w ella|strong="H5921"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* su \w flujo|strong="H2101"\w* impuro.   
\p
\v 31 “‘\w De|strong="H1121"\w* esta manera ustedes mantendrán \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas separados \w de|strong="H1121"\w* sus cosas impuras, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w mueran|strong="H4191"\w* por contaminar mi santuario \w que|strong="H3808"\w* está \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* ellos’”.   
\p
\v 32 \w Este|strong="H2063"\w* \w es|strong="H2063"\w* el reglamento \w para|strong="H4480"\w* el hombre \w que|strong="H4480"\w* tiene un flujo \w o|strong="H3068"\w* \w al|strong="H4480"\w* \w que|strong="H4480"\w* le \w sale|strong="H3318"\w* \w semen|strong="H7902"\w* y queda impuro;  
\v 33 \w para|strong="H5973"\w* la mujer que está \w en|strong="H5973"\w* su período menstrual; \w para|strong="H5973"\w* \w el|strong="H5973"\w* hombre \w o|strong="H3068"\w* la mujer que tenga un \w flujo|strong="H2101"\w*, y \w para|strong="H5973"\w* \w el|strong="H5973"\w* hombre que se acueste \w con|strong="H5973"\w* una mujer impura.   
\c 16  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* después \w de|strong="H6440"\w* la \w muerte|strong="H4194"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* Aarón, quienes \w murieron|strong="H4191"\w* al acercarse \w a|strong="H3068"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 2 \w Le|strong="H5921"\w* \w dijo|strong="H1696"\w*: “Adviértele \w a|strong="H3068"\w* tu hermano Aarón \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w entre|strong="H5921"\w* \w a|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w hora|strong="H6256"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* Lugar \w Santísimo|strong="H6944"\w*, \w que|strong="H3588"\w* \w está|strong="H5921"\w* detrás \w de|strong="H5921"\w* \w la|strong="H5921"\w* cortina, \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tapa \w del|strong="H5921"\w* arca. \w Si|strong="H3588"\w* \w lo|strong="H3808"\w* hace, \w morirá|strong="H4191"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w me|strong="H5921"\w* apareceré \w en|strong="H5921"\w* una \w nube|strong="H6051"\w* \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* esa tapa.   
\p
\v 3 “\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* manera en \w que|strong="H1121"\w* Aarón debe entrar \w al|strong="H5930"\w* \w santuario|strong="H6944"\w*: deberá llevar un \w becerro|strong="H6499"\w* para \w la|strong="H2063"\w* ofrenda por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w* \w y|strong="H1241"\w* un carnero para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*.  
\v 4 Deberá ponerse \w la|strong="H5921"\w* túnica sagrada \w de|strong="H5921"\w* lino \w y|strong="H5921"\w* \w la|strong="H5921"\w* ropa interior \w de|strong="H5921"\w* lino. \w Además|strong="H5921"\w*, \w se|strong="H1961"\w* pondrá \w el|strong="H5921"\w* cinturón \w de|strong="H5921"\w* lino \w y|strong="H5921"\w* \w el|strong="H5921"\w* turbante \w de|strong="H5921"\w* lino. \w Como|strong="H1961"\w* \w es|strong="H1961"\w* ropa sagrada, deberá bañarse primero \w y|strong="H5921"\w* luego ponérsela.  
\v 5 \w De|strong="H1121"\w* parte \w de|strong="H1121"\w* la comunidad \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w tomará|strong="H3947"\w* \w dos|strong="H8147"\w* \w machos|strong="H8163"\w* cabríos para la ofrenda por \w el|strong="H1121"\w* \w pecado|strong="H2403"\w* y un carnero para \w el|strong="H1121"\w* \w holocausto|strong="H5930"\w*.   
\p
\v 6 “Aarón \w ofrecerá|strong="H7126"\w* el \w becerro|strong="H6499"\w* de la ofrenda \w por|strong="H1157"\w* el \w pecado|strong="H2403"\w*, el cual es para él mismo, y hará \w expiación|strong="H3722"\w* \w por|strong="H1157"\w* él y \w por|strong="H1157"\w* su \w familia|strong="H1004"\w*.  
\v 7 Luego \w tomará|strong="H3947"\w* los \w dos|strong="H8147"\w* \w machos|strong="H8163"\w* cabríos y los \w presentará|strong="H5975"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Tienda del Encuentro.  
\v 8 Allí echará \w suertes|strong="H1486"\w* \w para|strong="H5921"\w* decidir cuál \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w será|strong="H5414"\w* \w para|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* cuál \w será|strong="H5414"\w* \w para|strong="H5921"\w* soltarlo \w en|strong="H5921"\w* \w el|strong="H5921"\w* desierto.  
\v 9 \w El|strong="H5921"\w* \w macho|strong="H8163"\w* cabrío \w que|strong="H5921"\w* \w le|strong="H5921"\w* toque \w a|strong="H3068"\w* Yahvé, Aarón \w lo|strong="H5921"\w* \w presentará|strong="H7126"\w* \w como|strong="H5921"\w* ofrenda \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*.  
\v 10 Pero \w el|strong="H5921"\w* \w macho|strong="H8163"\w* cabrío \w que|strong="H5921"\w* sea apartado \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w se|strong="H5921"\w* \w presentará|strong="H5975"\w* \w vivo|strong="H2416"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w para|strong="H5921"\w* hacer \w expiación|strong="H3722"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*, \w y|strong="H5921"\w* \w luego|strong="H5927"\w* será soltado \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*.   
\p
