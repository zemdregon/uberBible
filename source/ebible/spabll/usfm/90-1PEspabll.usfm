\p
\v 17 \w Y|strong="G2532"\w* \w si|strong="G1487"\w* \w invocan|strong="G1941"\w* \w como|strong="G2532"\w* \w Padre|strong="G3962"\w* \w a|strong="G1722"\w* \w aquel|strong="G3588"\w* \w que|strong="G3588"\w*, \w sin|strong="G2532"\w* favoritismos, \w juzga|strong="G2919"\w* \w según|strong="G2596"\w* \w la|strong="G3588"\w* \w obra|strong="G2041"\w* \w de|strong="G1722"\w* \w cada|strong="G1538"\w* \w uno|strong="G1538"\w*, pasen \w el|strong="G3588"\w* \w tiempo|strong="G5550"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* estadía \w en|strong="G1722"\w* \w la|strong="G3588"\w* tierra \w con|strong="G1722"\w* \w temor|strong="G5401"\w* reverente,  
