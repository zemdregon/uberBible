\v 5 Ustedes \w también|strong="G2532"\w*, \w como|strong="G5613"\w* \w piedras|strong="G3037"\w* \w vivas|strong="G2198"\w*, sean edificados \w como|strong="G5613"\w* \w casa|strong="G3624"\w* \w espiritual|strong="G4152"\w* \w y|strong="G2532"\w* \w sacerdocio|strong="G2406"\w* santo, \w para|strong="G1519"\w* ofrecer \w sacrificios|strong="G2378"\w* \w espirituales|strong="G4152"\w* aceptables \w a|strong="G1519"\w* \w Dios|strong="G2316"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1519"\w* \w Jesucristo|strong="G2424"\w*.  
