\id ZEC  
\h ZACARÍAS 
\toc3 Zacarías 
\toc1 ZACARÍAS 
\toc2 ZACARÍAS 
\mt1 Zacarías  
\c 1  
\p
\v 1 En \w el|strong="H1121"\w* \w octavo|strong="H8066"\w* \w mes|strong="H2320"\w* del \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* \w de|strong="H1121"\w* \w Darío|strong="H1867"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w vino|strong="H1961"\w* al \w profeta|strong="H5030"\w* \w Zacarías|strong="H2148"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Berequías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Iddo|strong="H5714"\w*:  
\v 2 “Yahvé \w se|strong="H5921"\w* \w enojó|strong="H7110"\w* mucho \w con|strong="H5921"\w* \w los|strong="H5921"\w* antepasados \w de|strong="H5921"\w* ustedes.  
\v 3 Por lo tanto, diles \w que|strong="H3541"\w* el \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w* \w dice|strong="H5002"\w*: ‘Vuélvanse \w a|strong="H3068"\w* mí’, \w dice|strong="H5002"\w* el \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w*, ‘\w y|strong="H3541"\w* yo \w me|strong="H3541"\w* \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* ustedes’, \w dice|strong="H5002"\w* el \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w*.  
\v 4 \w No|strong="H3808"\w* \w sean|strong="H1961"\w* \w como|strong="H1961"\w* sus antepasados, \w a|strong="H3068"\w* quienes \w los|strong="H1961"\w* antiguos \w profetas|strong="H5030"\w* les decían: \w El|strong="H5030"\w* \w Señor|strong="H3068"\w* \w de|strong="H7451"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w dice|strong="H5002"\w*: ‘Abandonen \w ahora|strong="H4994"\w* sus \w malos|strong="H7451"\w* \w caminos|strong="H1870"\w* \w y|strong="H3541"\w* sus \w malas|strong="H7451"\w* acciones’; pero ellos \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* \w me|strong="H3541"\w* hicieron caso, \w dice|strong="H5002"\w* \w el|strong="H5030"\w* \w Señor|strong="H3068"\w*.  
\v 5 \w Sus|strong="H1992"\w* antepasados, ¿dónde están? \w Y|strong="H3068"\w* \w los|strong="H1992"\w* \w profetas|strong="H5030"\w*, ¿acaso viven para \w siempre|strong="H5769"\w*?  
\v 6 Pero mis \w palabras|strong="H1697"\w* y mis decretos, \w que|strong="H3808"\w* \w ordené|strong="H6680"\w* \w a|strong="H3068"\w* mis \w siervos|strong="H5650"\w* los \w profetas|strong="H5030"\w*, ¿\w no|strong="H3808"\w* \w alcanzaron|strong="H5381"\w* \w a|strong="H3068"\w* sus antepasados?  
\p “\w Entonces|strong="H3651"\w* ellos \w se|strong="H3808"\w* arrepintieron y \w dijeron|strong="H1697"\w*: ‘\w Tal|strong="H3651"\w* \w como|strong="H3651"\w* Yahvé \w de|strong="H1697"\w* los \w Ejércitos|strong="H6635"\w* decidió tratarnos, según nuestros \w caminos|strong="H1870"\w* y nuestras acciones, \w así|strong="H3651"\w* \w lo|strong="H1697"\w* \w ha|strong="H3808"\w* \w hecho|strong="H6213"\w*’”.   
\p
\v 7 \w El|strong="H1931"\w* \w día|strong="H3117"\w* \w veinticuatro|strong="H6242"\w* del \w mes|strong="H2320"\w* \w undécimo|strong="H6249"\w*, \w que|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w de|strong="H1121"\w* Shebat, en \w el|strong="H1931"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* \w de|strong="H1121"\w* \w Darío|strong="H1867"\w*, \w vino|strong="H1961"\w* \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé al \w profeta|strong="H5030"\w* \w Zacarías|strong="H2148"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Berequías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Iddo|strong="H5714"\w*:  
\v 8 “Tuve una visión durante \w la|strong="H1931"\w* \w noche|strong="H3915"\w*: \w Vi|strong="H7200"\w* \w a|strong="H3068"\w* un hombre \w montado|strong="H7392"\w* \w en|strong="H5921"\w* un \w caballo|strong="H5483"\w* rojo, parado \w entre|strong="H5921"\w* \w los|strong="H5921"\w* \w arrayanes|strong="H1918"\w* \w que|strong="H1931"\w* \w había|strong="H5975"\w* \w en|strong="H5921"\w* una hondonada; \w y|strong="H5921"\w* detrás \w de|strong="H5921"\w* \w él|strong="H1931"\w* \w había|strong="H5975"\w* \w caballos|strong="H5483"\w* rojos, castaños \w y|strong="H5921"\w* \w blancos|strong="H3836"\w*.  
\v 9 Entonces pregunté: “Señor mío, ¿\w qué|strong="H4100"\w* son \w estos|strong="H1992"\w*?”.  
\p \w El|strong="H1992"\w* \w ángel|strong="H4397"\w* \w que|strong="H4100"\w* \w hablaba|strong="H1696"\w* conmigo me \w dijo|strong="H1696"\w*: “Yo te \w mostraré|strong="H7200"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* son”.   
\p
\v 10 El hombre que \w estaba|strong="H5975"\w* entre los mirtos \w respondió|strong="H6030"\w*: “Estos son los que Yahvé ha \w enviado|strong="H7971"\w* para recorrer toda la tierra”.   
\p
\v 11 \w Ellos|strong="H3605"\w* le informaron al \w ángel|strong="H4397"\w* de Yahvé, \w que|strong="H3605"\w* \w estaba|strong="H5975"\w* entre \w los|strong="H3427"\w* mirtos: “Hemos recorrido \w la|strong="H3605"\w* tierra, y hemos visto \w que|strong="H3605"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w está|strong="H5975"\w* tranquila y \w en|strong="H5975"\w* paz”.   
\p
\v 12 Entonces el \w ángel|strong="H4397"\w* \w de|strong="H5704"\w* Yahvé dijo: “Oh Yahvé \w de|strong="H5704"\w* los \w Ejércitos|strong="H6635"\w*, ¿\w hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* seguirás \w sin|strong="H3808"\w* tener piedad \w de|strong="H5704"\w* Jerusalén \w y|strong="H5704"\w* \w de|strong="H5704"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w con|strong="H5704"\w* las \w que|strong="H3808"\w* has estado enojado \w estos|strong="H2088"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*?”.   
\p
\v 13 El \w Señor|strong="H3068"\w* le \w respondió|strong="H6030"\w* al \w ángel|strong="H4397"\w* \w que|strong="H1697"\w* \w hablaba|strong="H1696"\w* conmigo con \w palabras|strong="H1697"\w* \w buenas|strong="H2896"\w* y consoladoras.  
\v 14 El \w ángel|strong="H4397"\w* \w que|strong="H3541"\w* \w hablaba|strong="H1696"\w* conmigo \w me|strong="H3541"\w* \w dijo|strong="H1696"\w*: “Proclama \w esto|strong="H3541"\w*: El \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w* \w dice|strong="H1696"\w*: “Siento un \w gran|strong="H1419"\w* \w celo|strong="H7068"\w* por Jerusalén \w y|strong="H3541"\w* por \w Sión|strong="H6726"\w*.  
\v 15 Estoy muy \w enojado|strong="H7107"\w* \w con|strong="H5921"\w* \w las|strong="H1992"\w* \w naciones|strong="H1471"\w* \w que|strong="H5921"\w* viven tranquilas; \w porque|strong="H5921"\w* yo estaba solo un \w poco|strong="H4592"\w* \w enojado|strong="H7107"\w*, pero \w ellas|strong="H1992"\w* aumentaron \w la|strong="H5921"\w* desgracia”.  
\v 16 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w dice|strong="H5002"\w* Yahvé: “He \w vuelto|strong="H7725"\w* \w a|strong="H3068"\w* Jerusalén \w con|strong="H5921"\w* compasión. \w Mi|strong="H5921"\w* \w casa|strong="H1004"\w* será reconstruida \w en|strong="H5921"\w* \w ella|strong="H5921"\w* — \w dice|strong="H5002"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* — \w y|strong="H5921"\w* \w el|strong="H5921"\w* cordel \w de|strong="H5921"\w* medir \w se|strong="H5921"\w* \w extenderá|strong="H5186"\w* \w sobre|strong="H5921"\w* Jerusalén”.   
\p
\v 17 “Proclama \w también|strong="H5750"\w*: “El \w Señor|strong="H3068"\w* \w de|strong="H5750"\w* los \w Ejércitos|strong="H6635"\w* dice: “Mis \w ciudades|strong="H5892"\w* volverán \w a|strong="H3068"\w* rebosar \w de|strong="H5750"\w* bienestar; el \w Señor|strong="H3068"\w* \w consolará|strong="H5162"\w* \w de|strong="H5750"\w* nuevo \w a|strong="H3068"\w* \w Sión|strong="H6726"\w* \w y|strong="H3541"\w* elegirá \w otra|strong="H5750"\w* vez \w a|strong="H3068"\w* Jerusalén””.   
\p
\v 18 Levanté la vista y vi cuatro cuernos.  
\v 19 Le pregunté al ángel que hablaba conmigo: “¿Qué significa esto?”.  
\p Él me respondió: “Estos son los cuernos que dispersaron \w a|strong="H3068"\w* Judá, \w a|strong="H3068"\w* Israel y \w a|strong="H3068"\w* Jerusalén”.   
\p
\v 20 Luego el Señor me mostró \w a|strong="H3068"\w* cuatro artesanos.  
\v 21 Yo pregunté: “¿\w A|strong="H3068"\w* qué vienen estos?”.  
\p Él respondió: “Aquellos son los cuernos que dispersaron \w a|strong="H3068"\w* Judá, de modo que nadie podía levantar la cabeza; pero estos artesanos han venido para aterrorizarlos y para derribar los cuernos de las naciones que atacaron la tierra de Judá para dispersar \w a|strong="H3068"\w* su gente”.   
\c 2  
\p
\v 1 Levanté la vista y \w vi|strong="H7200"\w* \w a|strong="H3068"\w* un hombre que tenía un cordel \w de|strong="H5869"\w* medir en la mano.  
\v 2 Entonces le pregunté: “¿\w A|strong="H3068"\w* dónde vas?”.  
\p Él me respondió: “Voy \w a|strong="H3068"\w* medir \w a|strong="H3068"\w* Jerusalén, para ver \w cuánto|strong="H4100"\w* tiene de ancho y \w cuánto|strong="H4100"\w* de largo”.   
\p
\v 3 En ese momento, el ángel que hablaba conmigo se adelantó, y otro ángel le salió al encuentro  
\v 4 y le dijo: “Corre y dile \w a|strong="H3068"\w* ese joven: ‘Jerusalén \w será|strong="H3808"\w* habitada \w como|strong="H4100"\w* una ciudad \w sin|strong="H3808"\w* murallas, debido \w a|strong="H3068"\w* la gran cantidad de hombres y de ganado \w que|strong="H4100"\w* habrá en ella.  
\v 5 \w Porque|strong="H2009"\w* \w yo|strong="H2009"\w* mismo — dice Yahvé — seré para ella un muro \w de|strong="H5869"\w* fuego \w a|strong="H3068"\w* su alrededor, y seré su gloria en \w medio|strong="H3027"\w* \w de|strong="H5869"\w* ella’”.   
\p
\v 6 “¡Vengan! ¡Vengan! ¡Escapen de la tierra del norte!”, dice Yahvé; “\w porque|strong="H4100"\w* yo los dispersé \w por|strong="H4100"\w* los cuatro vientos del cielo”, dice Yahvé.  
\v 7 “¡Vengan, habitantes de Sión! ¡Escapen ustedes, los que viven con la hija de Babilonia!”.  
\v 8 Porque \w el|strong="H3427"\w* Señor de \w los|strong="H3427"\w* Ejércitos \w dice|strong="H1696"\w*: “\w Después|strong="H3427"\w* de que su gloria se haya manifestado, \w él|strong="H3427"\w* me ha enviado \w a|strong="H3068"\w* las naciones que \w los|strong="H3427"\w* saquearon \w a|strong="H3068"\w* ustedes; porque \w el|strong="H3427"\w* que \w los|strong="H3427"\w* toca \w a|strong="H3068"\w* ustedes, toca la niña de sus ojos.  
\v 9 Yo levantaré \w mi|strong="H1961"\w* mano \w contra|strong="H1961"\w* ellas, \w y|strong="H3519"\w* sus propios esclavos las saquearán; así sabrán \w que|strong="H1961"\w* el \w Señor|strong="H3068"\w* de \w los|strong="H1961"\w* Ejércitos me ha enviado.  
\v 10 ¡Canta \w y|strong="H3588"\w* alégrate, hija \w de|strong="H3588"\w* Sión! \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* vengo \w a|strong="H3068"\w* habitar \w en|strong="H3588"\w* medio \w de|strong="H3588"\w* ti”, \w dice|strong="H5002"\w* Yahvé.  
\v 11 En aquel día, muchas naciones se unirán \w a|strong="H3068"\w* Yahvé y serán mi pueblo. “Yo \w habitaré|strong="H3427"\w* en medio de ustedes, y entonces sabrán \w que|strong="H1323"\w* Yahvé de \w los|strong="H3427"\w* Ejércitos me ha enviado \w a|strong="H3068"\w* ustedes.  
\v 12 Yahvé tomará posesión \w de|strong="H3588"\w* Judá \w como|strong="H3588"\w* \w su|strong="H3588"\w* heredad \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra santa, \w y|strong="H3588"\w* volverá \w a|strong="H3068"\w* elegir \w a|strong="H3068"\w* Jerusalén”.  
\v 13 ¡\w Que|strong="H3588"\w* \w toda|strong="H5921"\w* \w la|strong="H5921"\w* humanidad guarde silencio ante Yahvé, \w porque|strong="H3588"\w* \w él|strong="H5921"\w* ya \w se|strong="H3045"\w* ha levantado \w de|strong="H5921"\w* \w su|strong="H3588"\w* santa morada!”.   
\c 3  
\p
\v 1 Luego \w me|strong="H5921"\w* \w mostró|strong="H7200"\w* \w al|strong="H5921"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w*, \w el|strong="H5921"\w* cual \w estaba|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé; \w y|strong="H5921"\w* Satanás \w estaba|strong="H5975"\w* \w a|strong="H3068"\w* su mano \w derecha|strong="H3225"\w* \w para|strong="H5921"\w* acusarlo.  
\v 2 Yahvé le dijo \w a|strong="H3068"\w* Satanás: “¡\w Que|strong="H3808"\w* Yahvé te reprenda, Satanás! ¡\w Que|strong="H3808"\w* Yahvé, quien \w ha|strong="H3808"\w* elegido \w a|strong="H3068"\w* Jerusalén, te reprenda! ¿\w No|strong="H3808"\w* \w es|strong="H2088"\w* \w este|strong="H2088"\w* hombre un tizón rescatado del fuego?”.   
\p
\v 3 \w Josué|strong="H3091"\w*, \w que|strong="H1961"\w* \w estaba|strong="H1961"\w* \w ante|strong="H6440"\w* el \w ángel|strong="H4397"\w*, vestía ropas muy sucias.  
\v 4 \w El|strong="H5921"\w* ángel \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w estaban|strong="H5975"\w* allí \w para|strong="H5921"\w* servirle: “Quítenle esas ropas sucias”. \w Y|strong="H3068"\w* \w a|strong="H3068"\w* Josué \w le|strong="H5921"\w* dijo: “\w Mira|strong="H7200"\w*, he quitado tu \w pecado|strong="H5771"\w*, \w y|strong="H5921"\w* ahora voy \w a|strong="H3068"\w* vestirte \w con|strong="H5921"\w* ropas \w de|strong="H5921"\w* \w gala|strong="H4254"\w*”.   
\p
\v 5 Entonces yo dije: “Pónganle también un turbante \w limpio|strong="H2889"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*”.  
\p Así \w que|strong="H5921"\w* \w le|strong="H5921"\w* \w pusieron|strong="H7760"\w* \w el|strong="H5921"\w* turbante \w limpio|strong="H2889"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* vistieron, mientras \w el|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé permanecía allí \w de|strong="H5921"\w* \w pie|strong="H5975"\w*.   
\p
\v 6 Entonces el \w ángel|strong="H4397"\w* de Yahvé le advirtió \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*:  
\v 7 “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5414"\w* los \w Ejércitos|strong="H6635"\w*: ‘\w Si|strong="H1571"\w* caminas \w por|strong="H1870"\w* \w mis|strong="H5414"\w* sendas \w y|strong="H1571"\w* cumples \w con|strong="H1571"\w* \w mis|strong="H5414"\w* mandatos, tú gobernarás mi \w templo|strong="H1004"\w* \w y|strong="H1571"\w* cuidarás \w mis|strong="H5414"\w* \w atrios|strong="H2691"\w*, \w y|strong="H1571"\w* te \w daré|strong="H5414"\w* un lugar entre \w estos|strong="H1571"\w* \w que|strong="H1571"\w* están \w aquí|strong="H3541"\w*’.  
\v 8 \w Escucha|strong="H8085"\w* \w bien|strong="H3588"\w*, \w Josué|strong="H3091"\w*, \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w*, tú \w y|strong="H3588"\w* tus \w compañeros|strong="H7453"\w* \w que|strong="H3588"\w* \w se|strong="H1992"\w* sientan frente \w a|strong="H3068"\w* ti, \w porque|strong="H3588"\w* todos ustedes \w son|strong="H3588"\w* un símbolo \w de|strong="H3588"\w* \w lo|strong="H1992"\w* \w que|strong="H3588"\w* vendrá: ¡Voy \w a|strong="H3068"\w* traer \w a|strong="H3068"\w* \w mi|strong="H4994"\w* \w siervo|strong="H5650"\w*, \w el|strong="H3588"\w* \w Renuevo|strong="H6780"\w*!  
\v 9 Miren \w la|strong="H1931"\w* piedra \w que|strong="H3588"\w* he \w puesto|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w Josué|strong="H3091"\w*; \w en|strong="H5921"\w* \w esta|strong="H1931"\w* única piedra hay \w siete|strong="H7651"\w* \w ojos|strong="H5869"\w*. \w Yo|strong="H3588"\w* \w mismo|strong="H1931"\w* grabaré \w su|strong="H1931"\w* inscripción — \w dice|strong="H5002"\w* \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* — \w y|strong="H3588"\w* \w en|strong="H5921"\w* un \w solo|strong="H1931"\w* \w día|strong="H3117"\w* borraré \w el|strong="H1931"\w* \w pecado|strong="H5771"\w* \w de|strong="H5921"\w* \w esta|strong="H1931"\w* tierra.  
\v 10 \w En|strong="H8478"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* — \w dice|strong="H5002"\w* \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* \w de|strong="H8478"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w* — \w cada|strong="H3117"\w* uno \w de|strong="H8478"\w* ustedes invitará \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w prójimo|strong="H7453"\w* \w a|strong="H3068"\w* sentarse \w a|strong="H3068"\w* \w la|strong="H1931"\w* sombra \w de|strong="H8478"\w* \w su|strong="H1931"\w* \w vid|strong="H1612"\w* y \w de|strong="H8478"\w* \w su|strong="H1931"\w* higuera’”.   
\c 4  
\p
\v 1 El \w ángel|strong="H4397"\w* que \w hablaba|strong="H1696"\w* conmigo regresó y me \w despertó|strong="H5782"\w*, como quien \w despierta|strong="H5782"\w* \w a|strong="H3068"\w* alguien de su \w sueño|strong="H8142"\w*.  
\v 2 \w Me|strong="H5921"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w ves|strong="H7200"\w*?”.  
\p \w Yo|strong="H2009"\w* respondí: “He estado mirando, \w y|strong="H5921"\w* \w veo|strong="H7200"\w* un candelabro \w de|strong="H5921"\w* \w oro|strong="H2091"\w* puro \w con|strong="H5921"\w* un tazón \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior. Tiene \w siete|strong="H7651"\w* \w lámparas|strong="H5216"\w*, \w y|strong="H5921"\w* \w cada|strong="H3605"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w lámparas|strong="H5216"\w* tiene \w siete|strong="H7651"\w* tubos.  
\v 3 También hay \w dos|strong="H8147"\w* olivos \w junto|strong="H5921"\w* \w al|strong="H5921"\w* candelabro, uno \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w del|strong="H5921"\w* tazón \w y|strong="H5921"\w* \w el|strong="H5921"\w* otro \w a|strong="H3068"\w* su \w izquierda|strong="H8040"\w*”.   
\p
\v 4 Entonces le pregunté al \w ángel|strong="H4397"\w* \w que|strong="H4100"\w* \w hablaba|strong="H1696"\w* conmigo: “¿\w Qué|strong="H4100"\w* significa esto, \w mi|strong="H6030"\w* señor?”.   
\p
\v 5 \w El|strong="H1992"\w* \w ángel|strong="H4397"\w* me \w respondió|strong="H6030"\w*: “¿Acaso \w no|strong="H3808"\w* \w sabes|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w son|strong="H3808"\w* \w estas|strong="H1992"\w* \w cosas|strong="H1992"\w*?”.  
\p “\w No|strong="H3808"\w*, \w mi|strong="H6030"\w* señor”, le contesté.   
\p
\v 6 \w Entonces|strong="H3588"\w* \w él|strong="H3588"\w* \w me|strong="H3588"\w* explicó: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* \w el|strong="H3588"\w* mensaje \w de|strong="H3588"\w* Yahvé \w para|strong="H3588"\w* \w Zorobabel|strong="H2216"\w*: ‘\w No|strong="H3808"\w* \w será|strong="H3808"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w fuerza|strong="H3581"\w* \w ni|strong="H3808"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w poder|strong="H3581"\w*, \w sino|strong="H3588"\w* \w por|strong="H3588"\w* \w mi|strong="H6030"\w* \w Espíritu|strong="H7307"\w*’, \w dice|strong="H1697"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*.  
\v 7 ¿\w Quién|strong="H4310"\w* te crees tú, \w gran|strong="H1419"\w* montaña? ¡\w Ante|strong="H6440"\w* \w Zorobabel|strong="H2216"\w* te convertirás \w en|strong="H3318"\w* una llanura! \w Y|strong="H3068"\w* \w él|strong="H4310"\w* \w sacará|strong="H3318"\w* la piedra \w principal|strong="H1419"\w* entre gritos \w de|strong="H6440"\w*: ‘¡\w Qué|strong="H4310"\w* belleza! ¡\w Qué|strong="H4310"\w* belleza!’”.   
\p
\v 8 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* otra vez:  
\v 9 “\w Zorobabel|strong="H2216"\w* ha \w puesto|strong="H3588"\w* \w con|strong="H3588"\w* sus propias \w manos|strong="H3027"\w* \w los|strong="H3588"\w* \w cimientos|strong="H3245"\w* \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w*, \w y|strong="H3588"\w* \w él|strong="H3588"\w* mismo \w lo|strong="H2088"\w* terminará. \w Así|strong="H2088"\w* \w sabrán|strong="H3045"\w* ustedes \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* \w me|strong="H3588"\w* ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* ustedes.  
\v 10 ¿\w Quién|strong="H4310"\w* \w se|strong="H1992"\w* atreve \w a|strong="H3068"\w* despreciar \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* comienzos humildes? \w Estos|strong="H1992"\w* \w siete|strong="H7651"\w* \w se|strong="H1992"\w* alegrarán \w cuando|strong="H3588"\w* \w vean|strong="H7200"\w* \w la|strong="H3588"\w* plomada \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w mano|strong="H3027"\w* \w de|strong="H3588"\w* \w Zorobabel|strong="H2216"\w*. \w Estos|strong="H1992"\w* \w siete|strong="H7651"\w* \w son|strong="H3588"\w* \w los|strong="H1992"\w* \w ojos|strong="H5869"\w* \w de|strong="H3588"\w* Yahvé, \w que|strong="H3588"\w* vigilan \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra”.   
\p
\v 11 Luego \w le|strong="H5921"\w* pregunté: “¿\w Qué|strong="H4100"\w* significan esos \w dos|strong="H8147"\w* olivos \w que|strong="H4100"\w* están \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w* \w del|strong="H5921"\w* candelabro?”.   
\p
\v 12 \w Y|strong="H3068"\w* \w por|strong="H5921"\w* \w segunda|strong="H8145"\w* vez \w le|strong="H5921"\w* pregunté: “¿\w Qué|strong="H4100"\w* son esas \w dos|strong="H8147"\w* \w ramas|strong="H7641"\w* \w de|strong="H5921"\w* olivo \w que|strong="H4100"\w* están \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w tubos|strong="H6804"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w por|strong="H5921"\w* \w donde|strong="H5921"\w* fluye \w el|strong="H5921"\w* aceite dorado?”.   
\p
\v 13 Él me respondió: “¿\w No|strong="H3808"\w* \w sabes|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w son|strong="H3808"\w*?”.  
\p Yo le dije: “\w No|strong="H3808"\w*, mi señor”.   
\p
\v 14 Entonces \w él|strong="H5921"\w* dijo: “\w Estos|strong="H3605"\w* son \w los|strong="H1121"\w* \w dos|strong="H8147"\w* ungidos \w que|strong="H5921"\w* están \w al|strong="H5921"\w* servicio \w del|strong="H5921"\w* Señor \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra”.   
\c 5  
\p
\v 1 \w Volví|strong="H7725"\w* \w a|strong="H3068"\w* levantar la vista y \w vi|strong="H7200"\w* un \w rollo|strong="H4039"\w* que volaba.  
\v 2 El ángel me preguntó: “¿\w Qué|strong="H4100"\w* \w ves|strong="H7200"\w*?”.  
\p Yo respondí: “\w Veo|strong="H7200"\w* un \w rollo|strong="H4039"\w* \w volador|strong="H5774"\w*, \w que|strong="H4100"\w* mide nueve metros de largo \w por|strong="H4100"\w* cuatro y medio de ancho”.   
\p
\v 3 \w Entonces|strong="H3588"\w* \w me|strong="H5921"\w* explicó: “\w Esta|strong="H2063"\w* \w es|strong="H2088"\w* \w la|strong="H5921"\w* maldición \w que|strong="H3588"\w* \w se|strong="H5921"\w* extiende \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra. \w Según|strong="H5921"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* dice un lado \w del|strong="H5921"\w* rollo, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H3588"\w* robe será eliminado; \w y|strong="H3588"\w* \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w otro|strong="H2088"\w* lado, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w jure|strong="H7650"\w* \w en|strong="H5921"\w* falso \w también|strong="H3318"\w* será eliminado.  
\v 4 Yo la he enviado — \w dice|strong="H5002"\w* \w el|strong="H3885"\w* \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w* — y entrará \w en|strong="H8432"\w* la \w casa|strong="H1004"\w* del \w ladrón|strong="H1590"\w* y \w en|strong="H8432"\w* la \w casa|strong="H1004"\w* del que \w jura|strong="H7650"\w* \w en|strong="H8432"\w* \w falso|strong="H8267"\w* por mi \w nombre|strong="H8034"\w*. Esa maldición se quedará \w dentro|strong="H8432"\w* de sus \w casas|strong="H1004"\w* y las destruirá por completo, junto con sus vigas y sus piedras”.   
\p
\v 5 El \w ángel|strong="H4397"\w* \w que|strong="H4100"\w* \w hablaba|strong="H1696"\w* conmigo \w se|strong="H4100"\w* acercó y me \w dijo|strong="H1696"\w*: “\w Levanta|strong="H5375"\w* \w la|strong="H2063"\w* vista y \w mira|strong="H7200"\w* \w qué|strong="H4100"\w* \w es|strong="H2063"\w* \w eso|strong="H2063"\w* \w que|strong="H4100"\w* \w está|strong="H2063"\w* apareciendo”.   
\p
\v 6 Yo pregunté: “¿\w Qué|strong="H4100"\w* \w es|strong="H1931"\w* \w eso|strong="H1931"\w*?”.  
\p \w Él|strong="H1931"\w* me contestó: “\w Es|strong="H1931"\w* una canasta \w de|strong="H5869"\w* un efa”. \w Y|strong="H3068"\w* añadió: “\w Esta|strong="H2063"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* maldad \w de|strong="H5869"\w* \w ellos|strong="H1931"\w* \w en|strong="H3318"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* tierra”.  
\v 7 \w En|strong="H8432"\w* \w eso|strong="H2063"\w*, se \w levantó|strong="H5375"\w* \w la|strong="H2063"\w* tapa de plomo de \w la|strong="H2063"\w* canasta, y vi que adentro de ella \w estaba|strong="H3427"\w* sentada una mujer.  
\v 8 El ángel dijo: “\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w maldad|strong="H7564"\w*”; entonces \w la|strong="H2063"\w* empujó al fondo de \w la|strong="H2063"\w* canasta y volvió \w a|strong="H3068"\w* tapar \w la|strong="H2063"\w* entrada con el pesado disco de plomo.   
\p
\v 9 \w Luego|strong="H3318"\w* levanté la vista y \w vi|strong="H7200"\w* \w a|strong="H3068"\w* \w dos|strong="H8147"\w* mujeres que aparecieron con el \w viento|strong="H7307"\w* \w a|strong="H3068"\w* su favor; tenían \w alas|strong="H3671"\w* \w como|strong="H2007"\w* \w de|strong="H5869"\w* cigüeña y elevaron la canasta entre la tierra y el \w cielo|strong="H8064"\w*.  
\v 10 Le pregunté al \w ángel|strong="H4397"\w* \w que|strong="H1992"\w* \w hablaba|strong="H1696"\w* conmigo: “¿\w A|strong="H3068"\w* dónde \w llevan|strong="H3212"\w* la canasta?”.   
\p
\v 11 \w Él|strong="H5921"\w* \w me|strong="H5921"\w* respondió: “\w La|strong="H5921"\w* llevan \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Babilonia \w para|strong="H5921"\w* construirle un \w templo|strong="H1004"\w*. Cuando esté terminado, \w pondrán|strong="H3240"\w* \w la|strong="H5921"\w* canasta \w allí|strong="H8033"\w*, \w en|strong="H5921"\w* su lugar”.   
\c 6  
\p
\v 1 \w De|strong="H5869"\w* nuevo levanté la vista y \w vi|strong="H7200"\w* que cuatro \w carros|strong="H4818"\w* \w salían|strong="H3318"\w* \w de|strong="H5869"\w* entre \w dos|strong="H8147"\w* montañas; y las montañas eran \w de|strong="H5869"\w* bronce.  
\v 2 El \w primer|strong="H7223"\w* \w carro|strong="H4818"\w* tenía \w caballos|strong="H5483"\w* rojos; el \w segundo|strong="H8145"\w*, \w caballos|strong="H5483"\w* \w negros|strong="H7838"\w*;  
\v 3 el \w tercero|strong="H7992"\w*, \w caballos|strong="H5483"\w* \w blancos|strong="H3836"\w*; y el \w cuarto|strong="H7243"\w*, \w caballos|strong="H5483"\w* manchados, todos ellos muy fuertes.  
\v 4 Entonces le pregunté al \w ángel|strong="H4397"\w* \w que|strong="H4100"\w* \w hablaba|strong="H1696"\w* conmigo: “¿\w Qué|strong="H4100"\w* significan estos carros, \w mi|strong="H6030"\w* señor?”.   
\p
\v 5 \w El|strong="H5921"\w* \w ángel|strong="H4397"\w* \w me|strong="H5921"\w* \w respondió|strong="H6030"\w*: “\w Estos|strong="H3605"\w* son \w los|strong="H5921"\w* cuatro \w espíritus|strong="H7307"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w que|strong="H5921"\w* \w salen|strong="H3318"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* haberse presentado ante \w el|strong="H5921"\w* Señor \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra.  
\v 6 El carro de los \w caballos|strong="H5483"\w* \w negros|strong="H7838"\w* \w va|strong="H3068"\w* hacia el país del \w norte|strong="H6828"\w*, el de los \w blancos|strong="H3836"\w* \w va|strong="H3068"\w* detrás de ellos, y el de los manchados \w va|strong="H3068"\w* hacia el país del sur”.  
\v 7 Aquellos caballos fuertes \w salieron|strong="H3318"\w* ansiosos por recorrer toda la tierra. El ángel les dijo: “¡\w Vayan|strong="H3212"\w* y recorran la tierra!”. \w Y|strong="H3068"\w* ellos la recorrieron.   
\p
\v 8 \w Luego|strong="H3318"\w* el ángel me \w llamó|strong="H2199"\w* y me \w dijo|strong="H1696"\w*: “\w Mira|strong="H7200"\w*, los que fueron hacia el país del \w norte|strong="H6828"\w* han hecho que mi \w espíritu|strong="H7307"\w* \w repose|strong="H5117"\w* \w en|strong="H3318"\w* esa tierra”.   
\p
\v 9 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 10 “Acepta las ofrendas \w de|strong="H1121"\w* \w los|strong="H1121"\w* desterrados Heldai, \w Tobías|strong="H2900"\w* y \w Jedaías|strong="H3048"\w*, \w que|strong="H1931"\w* han llegado \w de|strong="H1121"\w* Babilonia. Ve \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sofonías|strong="H6846"\w*.  
\v 11 \w Tomen|strong="H3947"\w* la \w plata|strong="H3701"\w* y \w el|strong="H1121"\w* \w oro|strong="H2091"\w*, \w hagan|strong="H6213"\w* una \w corona|strong="H5850"\w* y pónganla en la \w cabeza|strong="H7218"\w* del \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac.  
\v 12 Háblenle \w de|strong="H8478"\w* \w mi|strong="H2009"\w* parte: “\w Así|strong="H3541"\w* dice el \w Señor|strong="H3068"\w* \w de|strong="H8478"\w* los \w Ejércitos|strong="H6635"\w*: ‘¡\w Aquí|strong="H2009"\w* está el hombre cuyo \w nombre|strong="H8034"\w* \w es|strong="H3541"\w* el \w Renuevo|strong="H6780"\w*! Él \w brotará|strong="H6779"\w* \w de|strong="H8478"\w* \w donde|strong="H8478"\w* está \w y|strong="H3541"\w* reconstruirá el \w templo|strong="H1964"\w* \w de|strong="H8478"\w* Yahvé’.  
\v 13 \w Él|strong="H1931"\w* reconstruirá \w el|strong="H1931"\w* \w templo|strong="H1964"\w* \w de|strong="H5921"\w* Yahvé, \w se|strong="H1961"\w* cubrirá \w de|strong="H5921"\w* \w gloria|strong="H1935"\w*, \w y|strong="H5921"\w* \w se|strong="H1961"\w* sentará \w a|strong="H3068"\w* gobernar \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w trono|strong="H3678"\w*. También un \w sacerdote|strong="H3548"\w* \w se|strong="H1961"\w* sentará \w en|strong="H5921"\w* \w su|strong="H1931"\w* propio \w trono|strong="H3678"\w*, \w y|strong="H5921"\w* \w habrá|strong="H1961"\w* perfecta armonía \w entre|strong="H5921"\w* \w los|strong="H3427"\w* \w dos|strong="H8147"\w*.  
\v 14 La \w corona|strong="H5850"\w* \w se|strong="H1961"\w* \w quedará|strong="H1961"\w* en \w el|strong="H1121"\w* \w templo|strong="H1964"\w* \w de|strong="H1121"\w* Yahvé \w como|strong="H1961"\w* un recordatorio en honor \w de|strong="H1121"\w* Helem, \w Tobías|strong="H2900"\w*, \w Jedaías|strong="H3048"\w* y Hen \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sofonías|strong="H6846"\w*.   
\p
\v 15 Personas \w de|strong="H3588"\w* tierras lejanas vendrán \w para|strong="H3588"\w* ayudar \w a|strong="H3068"\w* construir \w el|strong="H3588"\w* \w templo|strong="H1964"\w* \w de|strong="H3588"\w* Yahvé. \w Así|strong="H3588"\w* \w sabrán|strong="H3045"\w* ustedes \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w me|strong="H3588"\w* ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* ustedes. Todo esto \w sucederá|strong="H1961"\w* \w si|strong="H3588"\w* \w obedecen|strong="H8085"\w* \w con|strong="H3588"\w* cuidado \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*”.   
\c 7  
\p
\v 1 El cuarto día del \w noveno|strong="H8671"\w* \w mes|strong="H2320"\w*, \w que|strong="H1697"\w* \w es|strong="H1961"\w* el \w mes|strong="H2320"\w* \w de|strong="H1697"\w* Quisleu, en el cuarto \w año|strong="H8141"\w* del \w reinado|strong="H4428"\w* \w de|strong="H1697"\w* \w Darío|strong="H1867"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Zacarías|strong="H2148"\w*.  
\v 2 \w El|strong="H1008"\w* pueblo \w de|strong="H6440"\w* Betel \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Sarezer y \w a|strong="H3068"\w* Regem Melec, junto con sus hombres, \w a|strong="H3068"\w* buscar \w el|strong="H1008"\w* favor \w de|strong="H6440"\w* Yahvé.  
\v 3 Ellos fueron \w a|strong="H3068"\w* preguntar \w a|strong="H3068"\w* los \w profetas|strong="H5030"\w* y \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* del \w templo|strong="H1004"\w* de Yahvé de los \w Ejércitos|strong="H6635"\w*: “¿Debemos seguir \w llorando|strong="H1058"\w* y ayunando en \w el|strong="H6213"\w* \w quinto|strong="H2549"\w* \w mes|strong="H2320"\w*, \w como|strong="H4100"\w* \w lo|strong="H4100"\w* hemos \w hecho|strong="H6213"\w* durante \w todos|strong="H8141"\w* \w estos|strong="H2088"\w* \w años|strong="H8141"\w*?”.   
\p
\v 4 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*:  
\v 5 “Dile \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w*: ‘\w Cuando|strong="H3588"\w* ustedes ayunaron \w y|strong="H3588"\w* lloraron \w en|strong="H3588"\w* \w los|strong="H3605"\w* meses \w quinto|strong="H2549"\w* \w y|strong="H3588"\w* \w séptimo|strong="H7637"\w* durante \w estos|strong="H2088"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*, ¿realmente \w lo|strong="H2088"\w* hicieron \w para|strong="H3588"\w* mí?  
\v 6 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* comen \w y|strong="H3588"\w* \w beben|strong="H8354"\w*, ¿\w no|strong="H3808"\w* \w lo|strong="H3808"\w* hacen solo \w para|strong="H3588"\w* ustedes mismos?  
\v 7 ¿\w No|strong="H3808"\w* \w son|strong="H1961"\w* estas las mismas \w palabras|strong="H1697"\w* \w que|strong="H3808"\w* Yahvé \w proclamó|strong="H7121"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H1697"\w* \w los|strong="H3427"\w* antiguos \w profetas|strong="H5030"\w*, \w cuando|strong="H1961"\w* Jerusalén y sus \w ciudades|strong="H5892"\w* vecinas \w estaban|strong="H1961"\w* \w habitadas|strong="H3427"\w* y tranquilas, y también \w el|strong="H5030"\w* sur y \w los|strong="H3427"\w* valles \w estaban|strong="H1961"\w* poblados?’”.   
\p
\v 8 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Zacarías|strong="H2148"\w*, diciendo:  
\v 9 “\w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*: ‘\w Hagan|strong="H6213"\w* \w justicia|strong="H4941"\w* verdadera, \w y|strong="H3541"\w* sean buenos \w y|strong="H3541"\w* compasivos cada uno con su hermano.  
\v 10 No opriman \w a|strong="H3068"\w* la viuda ni al \w huérfano|strong="H3490"\w*, ni al \w extranjero|strong="H1616"\w* ni al \w pobre|strong="H6041"\w*; y \w que|strong="H1616"\w* ninguno \w de|strong="H7451"\w* ustedes \w piense|strong="H2803"\w* en hacerle \w mal|strong="H7451"\w* \w a|strong="H3068"\w* su hermano’.  
\v 11 Pero ellos \w no|strong="H3985"\w* \w quisieron|strong="H3985"\w* \w escuchar|strong="H8085"\w*; se \w pusieron|strong="H5414"\w* tercos y se taparon los \w oídos|strong="H8085"\w* \w para|strong="H5414"\w* \w no|strong="H3985"\w* \w oír|strong="H8085"\w*.  
\v 12 Endurecieron su \w corazón|strong="H3820"\w* \w como|strong="H1961"\w* \w el|strong="H5030"\w* diamante \w para|strong="H1961"\w* \w no|strong="H1961"\w* \w obedecer|strong="H8085"\w* la \w ley|strong="H8451"\w* ni las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* \w el|strong="H5030"\w* \w Señor|strong="H3068"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w enviaba|strong="H7971"\w* \w por|strong="H1697"\w* su \w Espíritu|strong="H7307"\w* \w a|strong="H3068"\w* través \w de|strong="H1697"\w* \w los|strong="H1961"\w* antiguos \w profetas|strong="H5030"\w*. \w Por|strong="H1697"\w* eso \w el|strong="H5030"\w* \w Señor|strong="H3068"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w se|strong="H1961"\w* \w enojó|strong="H7110"\w* \w mucho|strong="H1419"\w* con \w ellos|strong="H3027"\w*.  
\v 13 \w Y|strong="H3068"\w* \w sucedió|strong="H1961"\w* \w que|strong="H3808"\w*, \w así|strong="H3651"\w* \w como|strong="H1961"\w* él \w los|strong="H1961"\w* \w llamó|strong="H7121"\w* y ellos \w no|strong="H3808"\w* quisieron \w escuchar|strong="H8085"\w*, \w también|strong="H3651"\w* ellos \w llamarán|strong="H7121"\w* y yo \w no|strong="H3808"\w* \w los|strong="H1961"\w* \w escucharé|strong="H8085"\w*”, dice el \w Señor|strong="H3068"\w* de \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*.  
\v 14 “Yo \w los|strong="H5921"\w* dispersé \w como|strong="H5921"\w* un torbellino \w entre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w conocían|strong="H3045"\w*. \w La|strong="H5921"\w* tierra quedó tan desolada \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* \w se|strong="H3045"\w* atrevía \w a|strong="H3068"\w* \w pasar|strong="H5674"\w* \w por|strong="H5921"\w* allí; así convirtieron una tierra hermosa \w en|strong="H5921"\w* un desierto”.   
\c 8  
\p
\v 1 La \w palabra|strong="H1697"\w* del \w Señor|strong="H3068"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*: ‘Siento un \w gran|strong="H1419"\w* \w celo|strong="H7068"\w* por \w Sión|strong="H6726"\w*; mi ardor por ella \w es|strong="H3541"\w* tan \w grande|strong="H1419"\w* \w que|strong="H3541"\w* llega \w a|strong="H3068"\w* la \w ira|strong="H2534"\w*’”.   
\p
\v 3 Yahvé dice: “He regresado \w a|strong="H3068"\w* \w Sión|strong="H6726"\w* \w y|strong="H3541"\w* \w habitaré|strong="H7931"\w* \w en|strong="H8432"\w* el centro de Jerusalén. Jerusalén será llamada ‘\w Ciudad|strong="H5892"\w* de la Verdad’, \w y|strong="H3541"\w* el \w monte|strong="H2022"\w* de Yahvé de los \w Ejércitos|strong="H6635"\w*, ‘\w Monte|strong="H2022"\w* \w Santo|strong="H6944"\w*’”.   
\p
\v 4 \w El|strong="H3427"\w* \w Señor|strong="H3068"\w* \w de|strong="H5750"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w* dice: “\w Los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w y|strong="H3541"\w* las ancianas volverán \w a|strong="H3068"\w* sentarse \w en|strong="H5750"\w* las \w calles|strong="H7339"\w* \w de|strong="H5750"\w* Jerusalén, \w cada|strong="H3117"\w* uno apoyado \w en|strong="H5750"\w* su bastón \w por|strong="H3027"\w* su avanzada \w edad|strong="H3117"\w*.  
\v 5 Las \w calles|strong="H7339"\w* de la \w ciudad|strong="H5892"\w* se llenarán de \w niños|strong="H3206"\w* y niñas que jugarán en ellas”.   
\p
\v 6 \w El|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w* \w dice|strong="H5002"\w*: “\w Aunque|strong="H3588"\w* \w esto|strong="H2088"\w* \w les|strong="H1992"\w* parezca imposible \w a|strong="H3068"\w* \w los|strong="H1992"\w* sobrevivientes \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w en|strong="H3588"\w* \w estos|strong="H1992"\w* \w días|strong="H3117"\w*, ¿acaso será imposible \w para|strong="H3588"\w* mí?”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*.   
\p
\v 7 El \w Señor|strong="H3068"\w* \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w* dice: “Yo \w salvaré|strong="H3467"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* los países del \w oriente|strong="H4217"\w* \w y|strong="H3541"\w* \w de|strong="H5971"\w* los países del occidente.  
\v 8 \w Los|strong="H1961"\w* traeré \w de|strong="H5971"\w* vuelta \w para|strong="H1961"\w* \w que|strong="H5971"\w* vivan \w en|strong="H8432"\w* Jerusalén; ellos \w serán|strong="H1961"\w* \w mi|strong="H3389"\w* \w pueblo|strong="H5971"\w* y yo \w seré|strong="H1961"\w* su Dios, con toda verdad y \w justicia|strong="H6666"\w*”.   
\p
\v 9 \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* los \w Ejércitos|strong="H6635"\w*: “¡Cobren \w ánimo|strong="H2388"\w* ustedes, los \w que|strong="H1697"\w* \w ahora|strong="H3117"\w* \w escuchan|strong="H8085"\w* estas \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w boca|strong="H6310"\w* \w de|strong="H1697"\w* los \w profetas|strong="H5030"\w*! \w Ellos|strong="H3027"\w* \w hablaron|strong="H1697"\w* desde \w el|strong="H5030"\w* \w día|strong="H3117"\w* en \w que|strong="H1697"\w* se echaron los \w cimientos|strong="H3245"\w* para reconstruir \w el|strong="H5030"\w* \w templo|strong="H1964"\w*, la \w casa|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* los \w Ejércitos|strong="H6635"\w*.  
\v 10 \w Antes|strong="H6440"\w* \w de|strong="H4480"\w* ese \w tiempo|strong="H3117"\w*, \w no|strong="H3808"\w* \w había|strong="H1961"\w* \w paga|strong="H7939"\w* \w para|strong="H3588"\w* \w los|strong="H1992"\w* hombres \w ni|strong="H3808"\w* \w para|strong="H3588"\w* \w los|strong="H1992"\w* animales. \w Por|strong="H3588"\w* \w causa|strong="H6440"\w* \w del|strong="H4480"\w* \w enemigo|strong="H6862"\w*, \w nadie|strong="H3808"\w* \w podía|strong="H3808"\w* entrar \w ni|strong="H3808"\w* \w salir|strong="H3318"\w* \w en|strong="H4480"\w* \w paz|strong="H7965"\w*, \w porque|strong="H3588"\w* \w yo|strong="H4480"\w* puse \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w unos|strong="H1992"\w* \w contra|strong="H6440"\w* otros.  
\v 11 Pero \w ahora|strong="H6258"\w* \w ya|strong="H2088"\w* \w no|strong="H3808"\w* trataré al \w resto|strong="H7611"\w* \w de|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* como en el pasado”, \w dice|strong="H5002"\w* el \w Señor|strong="H3068"\w* \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w*.  
\v 12 “Habrá una \w siembra|strong="H2233"\w* \w de|strong="H3588"\w* \w paz|strong="H7965"\w*: \w la|strong="H3588"\w* \w vid|strong="H1612"\w* \w dará|strong="H5414"\w* \w su|strong="H3588"\w* \w fruto|strong="H6529"\w*, \w la|strong="H3588"\w* tierra sus cosechas \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w* \w su|strong="H3588"\w* \w rocío|strong="H2919"\w*. \w Yo|strong="H3588"\w* \w haré|strong="H5414"\w* \w que|strong="H3588"\w* \w los|strong="H3605"\w* sobrevivientes \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* hereden \w todo|strong="H3605"\w* \w esto|strong="H2088"\w*.  
\v 13 \w Así|strong="H3651"\w* \w como|strong="H1961"\w* ustedes, \w casas|strong="H1004"\w* \w de|strong="H3372"\w* \w Judá|strong="H3063"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w*, \w fueron|strong="H1961"\w* objeto \w de|strong="H3372"\w* \w maldición|strong="H7045"\w* entre las \w naciones|strong="H1471"\w*, ahora yo \w los|strong="H1961"\w* \w salvaré|strong="H3467"\w* y \w serán|strong="H1961"\w* una \w bendición|strong="H1293"\w*. ¡\w No|strong="H1961"\w* tengan \w miedo|strong="H3372"\w*! ¡\w Sean|strong="H1961"\w* valientes!”.   
\p
\v 14 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* dice: “\w Así|strong="H3541"\w* \w como|strong="H3588"\w* decidí castigarlos \w cuando|strong="H3588"\w* sus antepasados \w me|strong="H3588"\w* \w hicieron|strong="H7489"\w* enojar — dice \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* — \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* eché \w para|strong="H3588"\w* atrás,  
\v 15 \w así|strong="H3651"\w* \w también|strong="H3651"\w* \w ahora|strong="H3117"\w* he decidido \w hacerle|strong="H3190"\w* \w bien|strong="H3190"\w* \w a|strong="H3068"\w* Jerusalén y \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H3372"\w* \w Judá|strong="H3063"\w*. No tengan \w miedo|strong="H3372"\w*.  
\v 16 \w Esto|strong="H1697"\w* \w es|strong="H1697"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* deben \w hacer|strong="H6213"\w*: Díganle la verdad \w a|strong="H3068"\w* su \w prójimo|strong="H7453"\w*. Juzguen con la verdad y busquen la \w paz|strong="H7965"\w* en sus tribunales.  
\v 17 \w Que|strong="H3588"\w* \w ninguno|strong="H3605"\w* \w de|strong="H3588"\w* ustedes planee \w en|strong="H3588"\w* \w su|strong="H3588"\w* interior hacerle \w mal|strong="H7451"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w prójimo|strong="H7453"\w*, ni se aficionen \w a|strong="H3068"\w* \w los|strong="H3605"\w* juramentos \w falsos|strong="H8267"\w*; \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w aborrezco|strong="H8130"\w* \w todo|strong="H3605"\w* eso”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 18 La \w palabra|strong="H1697"\w* del \w Señor|strong="H3068"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*:  
\v 19 “\w Así|strong="H3541"\w* dice el \w Señor|strong="H3068"\w* de \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*: ‘\w Los|strong="H1961"\w* ayunos de \w los|strong="H1961"\w* meses \w cuarto|strong="H7243"\w*, \w quinto|strong="H2549"\w*, \w séptimo|strong="H7637"\w* \w y|strong="H3541"\w* \w décimo|strong="H6224"\w* \w se|strong="H1961"\w* convertirán en días de felicidad, de \w alegría|strong="H8057"\w* \w y|strong="H3541"\w* de fiesta \w para|strong="H1961"\w* la \w casa|strong="H1004"\w* de \w Judá|strong="H3063"\w*. Por lo tanto, amen la verdad \w y|strong="H3541"\w* la \w paz|strong="H7965"\w*’”.   
\p
\v 20 \w El|strong="H3427"\w* \w Señor|strong="H3068"\w* \w de|strong="H5750"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w* dice: “\w Todavía|strong="H5750"\w* vendrán \w pueblos|strong="H5971"\w* \w y|strong="H3541"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5750"\w* \w muchas|strong="H7227"\w* \w ciudades|strong="H5892"\w*.  
\v 21 \w Los|strong="H3427"\w* \w de|strong="H6440"\w* una ciudad \w irán|strong="H3212"\w* \w a|strong="H3068"\w* otra \w y|strong="H1571"\w* dirán: ‘\w Vayamos|strong="H3212"\w* \w de|strong="H6440"\w* inmediato \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Yahvé \w y|strong="H1571"\w* \w a|strong="H3068"\w* suplicar \w el|strong="H3427"\w* favor \w de|strong="H6440"\w* Yahvé \w de|strong="H6440"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*. ¡Yo \w también|strong="H1571"\w* \w iré|strong="H3212"\w*!’.  
\v 22 \w Muchos|strong="H7227"\w* \w pueblos|strong="H5971"\w* y \w naciones|strong="H1471"\w* poderosas vendrán \w a|strong="H3068"\w* Jerusalén \w para|strong="H5971"\w* buscar \w a|strong="H3068"\w* Yahvé \w de|strong="H6440"\w* los \w Ejércitos|strong="H6635"\w* y \w para|strong="H5971"\w* pedir su favor”.  
\v 23 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*: “\w En|strong="H5973"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w diez|strong="H6235"\w* hombres \w de|strong="H3588"\w* diferentes \w naciones|strong="H1471"\w* \w y|strong="H3588"\w* lenguas \w se|strong="H1992"\w* agarrarán \w de|strong="H3588"\w* \w la|strong="H3588"\w* ropa \w de|strong="H3588"\w* un \w judío|strong="H3064"\w* \w y|strong="H3588"\w* \w le|strong="H5973"\w* dirán: ‘Queremos \w ir|strong="H3212"\w* \w con|strong="H5973"\w* ustedes, \w porque|strong="H3588"\w* hemos \w oído|strong="H8085"\w* \w que|strong="H3588"\w* \w Dios|strong="H3068"\w* \w está|strong="H1992"\w* \w con|strong="H5973"\w* ustedes’”.   
\c 9  
\p
\v 1 Esta \w es|strong="H3588"\w* una profecía.  
\q1 \w La|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé está \w contra|strong="H3478"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* Hadrac,  
\q2 \w y|strong="H3588"\w* se establecerá sobre \w Damasco|strong="H1834"\w* —  
\q1 \w porque|strong="H3588"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* humanidad  
\q2 \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* están puestos \w en|strong="H3588"\w* Yahvé —   
\q1
\v 2 \w y|strong="H1571"\w* \w también|strong="H1571"\w* contra Jamat, \w que|strong="H3588"\w* colinda \w con|strong="H3588"\w* ella,  
\q2 \w y|strong="H1571"\w* contra \w Tiro|strong="H6865"\w* \w y|strong="H1571"\w* \w Sidón|strong="H6721"\w*, \w aunque|strong="H3588"\w* se crean \w muy|strong="H3966"\w* sabias.   
\q1
\v 3 \w Tiro|strong="H6865"\w* se construyó una \w fortaleza|strong="H4692"\w*;  
\q2 amontonó \w plata|strong="H3701"\w* como si \w fuera|strong="H2351"\w* \w polvo|strong="H6083"\w*,  
\q2 y oro fino como si \w fuera|strong="H2351"\w* el lodo de las \w calles|strong="H2351"\w*.   
\q1
\v 4 Pero miren, \w el|strong="H1931"\w* Señor \w le|strong="H1931"\w* quitará \w sus|strong="H1931"\w* posesiones;  
\q2 destruirá \w su|strong="H1931"\w* poder \w en|strong="H5221"\w* \w el|strong="H1931"\w* \w mar|strong="H3220"\w*,  
\q2 y \w ella|strong="H1931"\w* \w será|strong="H1931"\w* consumida por \w el|strong="H1931"\w* fuego.   
\b  
\q1
\v 5 Ascalón \w lo|strong="H3808"\w* \w verá|strong="H7200"\w* \w y|strong="H3588"\w* tendrá \w miedo|strong="H3372"\w*;  
\q2 \w Gaza|strong="H5804"\w* también, \w y|strong="H3588"\w* \w se|strong="H3808"\w* retorcerá \w de|strong="H3588"\w* \w dolor|strong="H2342"\w*.  
