\q2 y las llamas consumirán \w todo|strong="H3605"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*”.   
\q1
\v 33 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*: “\w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w y|strong="H3541"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* han sido \w oprimidos|strong="H6231"\w* por igual.  
\q2 Quienes \w los|strong="H1121"\w* capturaron \w los|strong="H1121"\w* tienen retenidos  
\q2 \w y|strong="H3541"\w* se niegan \w a|strong="H3068"\w* dejarlos libres.   
\q1
\v 34 Pero \w el|strong="H3427"\w* \w Redentor|strong="H1350"\w* de ellos es poderoso;  
\q2 su \w nombre|strong="H8034"\w* es Yahvé de \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*.  
\q1 \w Él|strong="H3427"\w* defenderá su \w causa|strong="H7378"\w* con firmeza  
\q2 \w para|strong="H4616"\w* dar paz \w a|strong="H3068"\w* la tierra  
\q2 y terror \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H4616"\w* viven en Babilonia.   
\b  
\q1
\v 35 ¡Guerra \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w*! — \w dice|strong="H5002"\w* Yahvé —.  
\q2 ¡Guerra \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* viven \w en|strong="H5921"\w* Babilonia,  
\q2 \w contra|strong="H5921"\w* sus \w jefes|strong="H8269"\w* \w y|strong="H5921"\w* \w contra|strong="H5921"\w* sus \w sabios|strong="H2450"\w*!   
\q1
\v 36 ¡Guerra contra sus falsos profetas!, para que queden como tontos.  
\q2 ¡Guerra contra sus guerreros!, para que se mueran de miedo.   
\q1
\v 37 ¡Guerra \w contra|strong="H1961"\w* sus \w caballos|strong="H5483"\w* y sus \w carros|strong="H7393"\w*,  
\q2 y \w contra|strong="H1961"\w* \w todos|strong="H3605"\w* sus mercenarios!, \w para|strong="H1961"\w* \w que|strong="H1961"\w* \w se|strong="H1961"\w* vuelvan \w como|strong="H1961"\w* mujeres.  
\q1 ¡Guerra \w contra|strong="H1961"\w* sus tesoros!, \w para|strong="H1961"\w* \w que|strong="H1961"\w* \w sean|strong="H1961"\w* saqueados.   
\q1
\v 38 ¡Sequía sobre \w sus|strong="H1931"\w* \w aguas|strong="H4325"\w*!, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H1931"\w* sequen.  
\q2 \w Porque|strong="H3588"\w* \w es|strong="H1931"\w* una tierra llena \w de|strong="H3588"\w* \w ídolos|strong="H6456"\w*,  
