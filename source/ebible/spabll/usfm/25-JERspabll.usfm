\q1 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H3808"\w* \w pase|strong="H5674"\w* \w por|strong="H5921"\w* Babilonia \w se|strong="H1961"\w* asombrará  
\q2 \w y|strong="H5921"\w* \w se|strong="H1961"\w* burlará \w de|strong="H5921"\w* \w todas|strong="H3605"\w* sus \w heridas|strong="H4347"\w*.   
\q1
\v 14 Fórmense \w en|strong="H5921"\w* orden \w de|strong="H5921"\w* batalla \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* Babilonia,  
\q2 \w todos|strong="H3605"\w* ustedes \w los|strong="H5921"\w* \w que|strong="H3588"\w* tensan \w el|strong="H5921"\w* \w arco|strong="H7198"\w*.  
\q1 Disparen \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*, \w no|strong="H3588"\w* ahorren flechas,  
\q2 \w porque|strong="H3588"\w* \w ella|strong="H5921"\w* ha \w pecado|strong="H2398"\w* \w contra|strong="H5921"\w* Yahvé.  
\v 15 Lancen gritos \w de|strong="H5921"\w* guerra \w contra|strong="H5921"\w* \w ella|strong="H1931"\w* \w por|strong="H5921"\w* todos \w lados|strong="H5439"\w*;  
\q2 ¡\w ella|strong="H1931"\w* ya \w se|strong="H1931"\w* rindió!  
\q1 \w Sus|strong="H1931"\w* torres han \w caído|strong="H5307"\w*,  
\q2 \w sus|strong="H1931"\w* \w muros|strong="H2346"\w* han sido \w derribados|strong="H2040"\w*;  
\q1 \w esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w venganza|strong="H5360"\w* \w de|strong="H5921"\w* Yahvé.  
\q2 Vénguense \w de|strong="H5921"\w* \w ella|strong="H1931"\w*; \w hagan|strong="H6213"\w* \w con|strong="H5921"\w* \w ella|strong="H1931"\w* \w lo|strong="H1931"\w* \w mismo|strong="H1931"\w* \w que|strong="H3588"\w* \w ella|strong="H1931"\w* \w hizo|strong="H6213"\w*.   
\q1
\v 16 Eliminen \w de|strong="H6440"\w* Babilonia \w al|strong="H6256"\w* \w que|strong="H5971"\w* siembra  
\q2 y \w al|strong="H6256"\w* \w que|strong="H5971"\w* maneja la hoz en la cosecha.  
\q1 \w Por|strong="H6440"\w* miedo \w a|strong="H3068"\w* la \w espada|strong="H2719"\w* enemiga,  
\q2 cada uno regresará \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w*  
\q2 y cada cual \w huirá|strong="H5127"\w* \w a|strong="H3068"\w* su propia tierra.   
\b  
\q1
\v 17 \w Israel|strong="H3478"\w* \w es|strong="H2088"\w* como una \w oveja|strong="H7716"\w* dispersada,  
\q2 \w a|strong="H3068"\w* la \w que|strong="H2088"\w* los leones ahuyentaron.  
\q1 \w Primero|strong="H7223"\w* \w lo|strong="H2088"\w* devoró el \w rey|strong="H4428"\w* de Asiria,  
\q2 y ahora \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* de Babilonia, le ha roto los huesos”.   
\p
\v 18 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*:  
\q1 “Yo voy \w a|strong="H3068"\w* castigar \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Babilonia \w y|strong="H3541"\w* \w a|strong="H3068"\w* su tierra,  
\q2 \w tal|strong="H3651"\w* \w como|strong="H3651"\w* castigué \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Asiria.   
\q1
\v 19 Haré que \w Israel|strong="H3478"\w* \w vuelva|strong="H7725"\w* \w a|strong="H3068"\w* sus prados,  
\q2 y pastará en el Carmelo y en \w Basán|strong="H1316"\w*;  
\q2 su hambre será saciada en los \w montes|strong="H2022"\w* \w de|strong="H7646"\w* Efraín y \w de|strong="H7646"\w* \w Galaad|strong="H1568"\w*.   
\q1
\v 20 \w En|strong="H3588"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* — \w dice|strong="H5002"\w* Yahvé —,  
\q2 \w se|strong="H1931"\w* \w buscará|strong="H1245"\w* \w la|strong="H1931"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* existirá,  
\q1 \w y|strong="H3588"\w* \w los|strong="H1992"\w* \w pecados|strong="H2403"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* hallarán;  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w perdonaré|strong="H5545"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w que|strong="H3588"\w* deje \w como|strong="H3588"\w* sobrevivientes.   
\b  
\q1
\v 21 ¡Ataquen \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Merataim \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Pecod!  
\q2 Persíganlos, mátenlos \w y|strong="H5921"\w* destrúyanlos \w por|strong="H5921"\w* completo — \w dice|strong="H5002"\w* Yahvé —;  
\q1 cumplan \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* he \w mandado|strong="H6680"\w*.   
\q1
\v 22 ¡Se oye \w estruendo|strong="H6963"\w* de \w guerra|strong="H4421"\w* en el país,  
\q2 y de \w gran|strong="H1419"\w* destrucción!   
\q1
\v 23 ¡\w Cómo|strong="H1961"\w* ha \w sido|strong="H1961"\w* roto y \w hecho|strong="H1961"\w* pedazos \w el|strong="H3605"\w* martillo de \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra!  
\q2 ¡\w Cómo|strong="H1961"\w* ha quedado Babilonia convertida en \w espanto|strong="H8047"\w* entre las \w naciones|strong="H1471"\w*!   
\q1
\v 24 \w Te|strong="H3588"\w* puse \w una|strong="H4672"\w* trampa \w y|strong="H1571"\w* caíste \w en|strong="H3588"\w* ella, Babilonia,  
\q2 \w sin|strong="H3808"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* dieras cuenta.  
\q1 Fuiste encontrada \w y|strong="H1571"\w* capturada  
\q2 \w porque|strong="H3588"\w* \w te|strong="H3588"\w* rebelaste contra Yahvé.   
\q1
\v 25 Yahvé ha \w abierto|strong="H6605"\w* \w su|strong="H1931"\w* arsenal  
\q2 \w y|strong="H3588"\w* ha \w sacado|strong="H3318"\w* las \w armas|strong="H3627"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* enojo;  
\q1 \w porque|strong="H3588"\w* \w esta|strong="H1931"\w* \w es|strong="H1931"\w* una tarea del \w Señor|strong="H3068"\w*, Yahvé \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*,  
\q2 \w en|strong="H3588"\w* \w la|strong="H1931"\w* tierra \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w caldeos|strong="H3778"\w*.   
\q1
\v 26 Atáquenla desde \w los|strong="H1961"\w* confines de la tierra;  
\q2 abran sus almacenes de grano.  
\q1 Amontónenla \w como|strong="H3644"\w* \w a|strong="H3068"\w* las gavillas,  
