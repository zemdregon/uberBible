\q1 ¿\w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w quién|strong="H4310"\w* elegiré \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w la|strong="H5921"\w* gobierne?  
\q2 \w Porque|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* \w es|strong="H2088"\w* igual \w a|strong="H3068"\w* \w mí|strong="H5921"\w*? ¿\w Quién|strong="H4310"\w* \w me|strong="H5921"\w* puede pedir cuentas?  
\q2 ¿\w Qué|strong="H3588"\w* \w pastor|strong="H7462"\w* podrá hacerme frente?”.   
\q1
\v 45 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w escuchen|strong="H8085"\w* \w el|strong="H5921"\w* plan \w que|strong="H3808"\w* Yahvé \w ha|strong="H3808"\w* preparado \w contra|strong="H5921"\w* Babilonia,  
\q2 \w y|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w ha|strong="H3808"\w* decidido \w contra|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w*:  
\q1 \w Aun|strong="H3808"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w más|strong="H5921"\w* pequeños \w del|strong="H5921"\w* \w rebaño|strong="H6629"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* llevarán arrastrando,  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* sus pastizales quedarán desolados.   
\q1
\v 46 Con el \w estruendo|strong="H6963"\w* de la caída de Babilonia \w tiembla|strong="H7493"\w* la tierra,  
\q2 y sus \w gritos|strong="H2201"\w* se \w oyen|strong="H8085"\w* entre las \w naciones|strong="H1471"\w*.   
\c 51  
\p
\v 1 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Miren, yo \w levanto|strong="H6965"\w* un \w viento|strong="H7307"\w* destructor \w contra|strong="H5921"\w* Babilonia  
\q2 \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* viven \w en|strong="H5921"\w* Leb Camai.   
\q1
\v 2 \w Enviaré|strong="H7971"\w* \w a|strong="H3068"\w* Babilonia extraños \w que|strong="H3588"\w* \w la|strong="H5921"\w* aventarán  
\q2 \w y|strong="H3588"\w* \w dejarán|strong="H7971"\w* \w vacía|strong="H1238"\w* \w su|strong="H3588"\w* tierra;  
\q2 \w porque|strong="H3588"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w del|strong="H5921"\w* desastre \w la|strong="H5921"\w* atacarán \w por|strong="H5921"\w* todos \w lados|strong="H5439"\w*.   
\q1
\v 3 \w Que|strong="H1869"\w* \w el|strong="H3605"\w* arquero no tese su \w arco|strong="H7198"\w*  
\q2 ni se jacte de su coraza;  
\q1 no perdonen \w a|strong="H3068"\w* sus jóvenes,  
\q2 destruyan por completo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H6635"\w*.   
\q1
\v 4 \w Caerán|strong="H5307"\w* \w muertos|strong="H2491"\w* en la tierra de los \w caldeos|strong="H3778"\w*  
\q2 y atravesados en sus \w calles|strong="H2351"\w*.   
\q1
\v 5 \w Porque|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w Judá|strong="H3063"\w* \w no|strong="H3808"\w* han sido abandonados \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*,  
\q2 \w por|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*,  
\q2 \w aun|strong="H3808"\w* \w cuando|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* ellos está \w llena|strong="H4390"\w* \w de|strong="H3588"\w* culpa ante \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.   
\b  
\q1
\v 6 ¡Huyan \w de|strong="H3588"\w* Babilonia!  
\q2 ¡\w Que|strong="H3588"\w* cada uno salve \w su|strong="H1931"\w* \w vida|strong="H5315"\w*!  
\q1 \w No|strong="H3588"\w* mueran \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* \w ella|strong="H1931"\w*,  
\q2 \w porque|strong="H3588"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w venganza|strong="H5360"\w* \w de|strong="H3588"\w* Yahvé;  
\q2 \w él|strong="H1931"\w* \w le|strong="H1931"\w* \w dará|strong="H7999"\w* \w su|strong="H1931"\w* merecido.   
\q1
\v 7 Babilonia ha sido una copa \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé,  
\q2 \w que|strong="H5921"\w* emborrachó \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra;  
\q1 \w de|strong="H5921"\w* su \w vino|strong="H3196"\w* \w bebieron|strong="H8354"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*,  
\q2 \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w se|strong="H5921"\w* han vuelto locas.   
\q1
\v 8 \w De|strong="H5921"\w* repente \w cayó|strong="H5307"\w* Babilonia \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w hizo|strong="H5307"\w* pedazos;  
\q2 ¡lloren \w por|strong="H5921"\w* \w ella|strong="H5921"\w*!  
\q1 Busquen \w bálsamo|strong="H6875"\w* \w para|strong="H5921"\w* su \w dolor|strong="H4341"\w*;  
\q2 tal vez pueda sanar.   
\b  
\q1
\v 9 Quisimos sanar \w a|strong="H3068"\w* Babilonia, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w sanó|strong="H7495"\w*;  
\q2 déjenla, \w y|strong="H3588"\w* vámonos cada uno \w a|strong="H3068"\w* \w su|strong="H3588"\w* país;  
\q1 \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w juicio|strong="H4941"\w* \w ha|strong="H3808"\w* \w llegado|strong="H5060"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w*  
\q2 \w y|strong="H3588"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* elevado \w hasta|strong="H5704"\w* las nubes.   
\q1
\v 10 Yahvé ha \w hecho|strong="H4639"\w* brillar nuestra \w justicia|strong="H6666"\w*;  
\q2 vengan, y anunciemos \w en|strong="H3318"\w* \w Sión|strong="H6726"\w* la \w obra|strong="H4639"\w* de Yahvé nuestro \w Dios|strong="H3068"\w*.   
\b  
\q1
\v 11 ¡Afilen \w las|strong="H5921"\w* flechas! ¡Preparen \w los|strong="H5921"\w* \w escudos|strong="H7982"\w*!  
\q2 Yahvé ha despertado \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Media|strong="H4074"\w*,  
\q1 \w porque|strong="H3588"\w* \w su|strong="H1931"\w* plan \w contra|strong="H5921"\w* Babilonia \w es|strong="H1931"\w* destruirla;  
\q2 \w pues|strong="H3588"\w* \w esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w venganza|strong="H5360"\w* \w de|strong="H5921"\w* Yahvé, \w la|strong="H1931"\w* \w venganza|strong="H5360"\w* \w por|strong="H5921"\w* \w su|strong="H1931"\w* \w templo|strong="H1964"\w*.   
\q1
\v 12 ¡Levanten \w bandera|strong="H5251"\w* contra \w los|strong="H3427"\w* \w muros|strong="H2346"\w* \w de|strong="H3588"\w* Babilonia!  
\q2 Refuercen \w la|strong="H1571"\w* guardia,  
\q1 pongan \w centinelas|strong="H8104"\w*  
\q2 \w y|strong="H1571"\w* preparen emboscadas;  
\q1 \w porque|strong="H3588"\w* Yahvé se propuso \w y|strong="H1571"\w* ha \w cumplido|strong="H6213"\w*  
\q2 \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w dijo|strong="H1696"\w* contra \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* Babilonia.   
\q1
\v 13 Tú, \w la|strong="H5921"\w* \w que|strong="H5921"\w* vives \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w* \w y|strong="H5921"\w* tienes \w grandes|strong="H7227"\w* tesoros,  
\q2 ha llegado tu \w fin|strong="H7093"\w*, \w el|strong="H5921"\w* límite \w de|strong="H5921"\w* tu ambición.   
\q1
\v 14 Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* ha \w jurado|strong="H7650"\w* \w por|strong="H5921"\w* \w sí|strong="H3588"\w* mismo:  
\q2 ‘\w Te|strong="H5921"\w* llenaré \w de|strong="H5921"\w* hombres \w como|strong="H3588"\w* \w si|strong="H3588"\w* fueran langostas,  
\q2 \w y|strong="H3588"\w* lanzarán \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* gritos \w de|strong="H5921"\w* victoria’.   
\b  
\q1
\v 15 \w Él|strong="H6213"\w* \w hizo|strong="H6213"\w* \w la|strong="H2451"\w* tierra con su \w poder|strong="H3581"\w*,  
\q2 estableció \w el|strong="H6213"\w* \w mundo|strong="H8398"\w* con su \w sabiduría|strong="H2451"\w*  
\q2 y \w extendió|strong="H5186"\w* los \w cielos|strong="H8064"\w* con su \w inteligencia|strong="H8394"\w*.   
\q1
\v 16 Cuando \w él|strong="H6213"\w* truena, hay un \w estruendo|strong="H6963"\w* \w de|strong="H5414"\w* \w aguas|strong="H4325"\w* \w en|strong="H3318"\w* \w el|strong="H6213"\w* \w cielo|strong="H8064"\w*;  
\q2 \w hace|strong="H6213"\w* \w subir|strong="H5927"\w* las \w nubes|strong="H5387"\w* desde los extremos \w de|strong="H5414"\w* la tierra.  
\q1 \w Él|strong="H6213"\w* \w produce|strong="H3318"\w* los \w relámpagos|strong="H1300"\w* \w para|strong="H5414"\w* la \w lluvia|strong="H4306"\w*  
\q2 y \w saca|strong="H3318"\w* \w el|strong="H6213"\w* \w viento|strong="H7307"\w* \w de|strong="H5414"\w* sus depósitos.   
\b  
\q1
\v 17 \w Todo|strong="H3605"\w* hombre \w es|strong="H3588"\w* torpe \w y|strong="H3588"\w* le falta \w conocimiento|strong="H1847"\w*;  
\q2 \w todo|strong="H3605"\w* orfebre \w se|strong="H3808"\w* avergüenza \w de|strong="H3588"\w* \w su|strong="H3588"\w* ídolo,  
\q1 \w porque|strong="H3588"\w* sus imágenes fundidas \w son|strong="H3588"\w* \w mentira|strong="H8267"\w*  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* hay vida \w en|strong="H3588"\w* ellas.   
\q1
\v 18 Son \w vanidad|strong="H1892"\w*, \w obra|strong="H4639"\w* \w de|strong="H6256"\w* burla;  
\q2 en \w el|strong="H1992"\w* \w tiempo|strong="H6256"\w* \w de|strong="H6256"\w* \w su|strong="H1992"\w* castigo perecerán.   
\q1
\v 19 \w El|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w como|strong="H3588"\w* \w ellos|strong="H1931"\w*,  
\q2 \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* Hacedor \w de|strong="H3588"\w* \w todo|strong="H3605"\w*,  
\q2 \w e|strong="H3068"\w* Israel \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w tribu|strong="H7626"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w heredad|strong="H5159"\w*;  
\q2 Yahvé \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* \w nombre|strong="H8034"\w*.   
\b  
\q1
\v 20 “Tú eres mi \w martillo|strong="H4661"\w* y mi arma de \w guerra|strong="H4421"\w*;  
\q2 por medio de ti despedazaré \w naciones|strong="H1471"\w*  
\q2 y por medio de ti \w destruiré|strong="H7843"\w* \w reinos|strong="H4467"\w*.   
\q1
\v 21 Por medio de ti despedazaré al \w caballo|strong="H5483"\w* y \w a|strong="H3068"\w* su jinete,  
\q2 y por medio de ti despedazaré al \w carro|strong="H7393"\w* y al que lo maneja.   
\q1
\v 22 Por medio de ti despedazaré \w a|strong="H3068"\w* hombres y mujeres,  
\q2 por medio de ti despedazaré \w a|strong="H3068"\w* \w ancianos|strong="H2205"\w* y jóvenes,  
\q1 y por medio de ti despedazaré \w a|strong="H3068"\w* muchachos y muchachas.   
\q1
\v 23 Por medio de ti despedazaré al \w pastor|strong="H7462"\w* y \w a|strong="H3068"\w* su rebaño,  
\q2 por medio de ti despedazaré al agricultor y \w a|strong="H3068"\w* su yunta;  
\q1 y por medio de ti despedazaré \w a|strong="H3068"\w* \w gobernadores|strong="H6346"\w* y oficiales.   
\p
\v 24 \w Yo|strong="H6213"\w* les \w pagaré|strong="H7999"\w* \w a|strong="H3068"\w* Babilonia y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5869"\w* Caldea \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w mal|strong="H7451"\w* \w que|strong="H3605"\w* \w hicieron|strong="H6213"\w* en \w Sión|strong="H6726"\w* ante \w los|strong="H3427"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* ustedes — \w dice|strong="H5002"\w* Yahvé —.   
\q1
\v 25 \w Aquí|strong="H2005"\w* estoy \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, montaña destructora — \w dice|strong="H5002"\w* Yahvé —,  
\q2 tú \w que|strong="H4480"\w* destruyes \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra;  
\q1 \w extenderé|strong="H5186"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*,  
\q2 \w te|strong="H5921"\w* \w haré|strong="H5414"\w* rodar \w desde|strong="H4480"\w* \w las|strong="H5921"\w* peñas  
\q2 \w y|strong="H5921"\w* \w te|strong="H5921"\w* convertiré \w en|strong="H5921"\w* una montaña quemada.   
\q1
\v 26 \w Nadie|strong="H3808"\w* \w tomará|strong="H3947"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w* una piedra \w para|strong="H3588"\w* una esquina  
\q2 \w ni|strong="H3808"\w* una piedra \w para|strong="H3588"\w* \w los|strong="H1961"\w* cimientos;  
\q2 \w porque|strong="H3588"\w* quedarás \w desolada|strong="H8077"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w* — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 27 ¡Levanten \w bandera|strong="H5251"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra!  
\q2 ¡Toquen \w la|strong="H5921"\w* \w trompeta|strong="H7782"\w* \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*!  
\q1 Preparen \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*,  
\q2 convoquen \w contra|strong="H5921"\w* \w ella|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* Ararat, \w de|strong="H5921"\w* Mini \w y|strong="H5921"\w* \w de|strong="H5921"\w* Asquenaz;  
\q1 nombren \w contra|strong="H5921"\w* \w ella|strong="H5921"\w* \w a|strong="H3068"\w* un comandante,  
\q2 hagan \w subir|strong="H5927"\w* \w caballos|strong="H5483"\w* \w como|strong="H5921"\w* langostas erizadas.   
\q1
\v 28 Preparen \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*;  
\q2 \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Media|strong="H4074"\w*, \w a|strong="H3068"\w* sus \w gobernadores|strong="H6346"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus oficiales, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* su dominio.   
\q1
\v 29 \w La|strong="H5921"\w* tierra \w tiembla|strong="H7493"\w* \w y|strong="H3588"\w* \w se|strong="H5921"\w* retuerce;  
\q2 \w porque|strong="H3588"\w* \w los|strong="H3427"\w* planes \w de|strong="H5921"\w* Yahvé \w contra|strong="H5921"\w* Babilonia \w se|strong="H5921"\w* mantienen firmes,  
\q2 \w para|strong="H5921"\w* convertir \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Babilonia \w en|strong="H5921"\w* un desierto \w donde|strong="H5921"\w* nadie viva.   
\q1
\v 30 \w Los|strong="H3427"\w* guerreros \w de|strong="H3898"\w* Babilonia \w dejaron|strong="H2308"\w* \w de|strong="H3898"\w* pelear,  
\q2 \w se|strong="H1961"\w* \w quedaron|strong="H1961"\w* en sus \w fortalezas|strong="H4679"\w*;  
\q1 \w se|strong="H1961"\w* les agotaron las fuerzas, \w se|strong="H1961"\w* volvieron \w como|strong="H1961"\w* mujeres;  
\q2 sus casas \w fueron|strong="H1961"\w* incendiadas, sus \w cerrojos|strong="H1280"\w* rotos.   
\q1
\v 31 Un \w mensajero|strong="H5046"\w* \w corre|strong="H7323"\w* \w al|strong="H4428"\w* encuentro \w de|strong="H3588"\w* \w otro|strong="H7097"\w*,  
\q2 \w y|strong="H3588"\w* un heraldo \w al|strong="H4428"\w* encuentro \w de|strong="H3588"\w* \w otro|strong="H7097"\w*,  
\q2 \w para|strong="H3588"\w* anunciarle \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w ciudad|strong="H5892"\w* ha sido \w tomada|strong="H3920"\w* \w por|strong="H3588"\w* todos lados.   
\q1
\v 32 Los vados han sido capturados,  
\q2 los pantanos han sido quemados con fuego  
\q2 y los soldados están aterrorizados”.   
\p
\v 33 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*:  
\q1 “\w La|strong="H3588"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* Babilonia \w es|strong="H3588"\w* \w como|strong="H3588"\w* una \w era|strong="H6256"\w* \w cuando|strong="H3588"\w* \w es|strong="H3588"\w* trillada;  
\q2 \w dentro|strong="H5750"\w* \w de|strong="H3588"\w* \w poco|strong="H4592"\w* le llegará \w el|strong="H3588"\w* \w tiempo|strong="H6256"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* cosecha”.   
\b  
\q1
\v 34 “\w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* de Babilonia, me \w devoró|strong="H1104"\w* y me desmenuzó;  
\q2 me dejó como un plato \w vacío|strong="H7385"\w*.  
\q2 Me tragó como un monstruo, \w llenó|strong="H4390"\w* su vientre con mis mejores comidas y luego me expulsó.   
\q1
\v 35 ¡\w Que|strong="H5921"\w* caiga \w sobre|strong="H5921"\w* Babilonia \w la|strong="H5921"\w* \w violencia|strong="H2555"\w* hecha \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* pueblo!”, dirá \w la|strong="H5921"\w* \w que|strong="H5921"\w* vive \w en|strong="H5921"\w* \w Sión|strong="H6726"\w*;  
\q2 \w y|strong="H5921"\w*: “¡\w Que|strong="H5921"\w* \w mi|strong="H5921"\w* \w sangre|strong="H1818"\w* caiga \w sobre|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Caldea!”, dirá Jerusalén.   
\b  
\p
\v 36 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé:  
\q1 “\w Mira|strong="H2005"\w*, yo defenderé tu \w causa|strong="H7378"\w* \w y|strong="H3541"\w* llevaré \w a|strong="H3068"\w* cabo tu \w venganza|strong="H5360"\w*;  
\q2 \w secaré|strong="H2717"\w* su \w mar|strong="H3220"\w* \w y|strong="H3541"\w* dejaré secos sus manantiales.   
\q1
\v 37 Babilonia \w se|strong="H1961"\w* convertirá en un \w montón|strong="H1530"\w* de ruinas,  
\q2 en refugio de chacales,  
\q2 en objeto de horror y de burla, donde nadie viva.   
\q1
\v 38 \w Todos|strong="H3162"\w* ellos rugirán \w como|strong="H3715"\w* leones,  
\q2 gruñirán \w como|strong="H3715"\w* \w cachorros|strong="H1484"\w* de león.   
\q1
\v 39 Cuando estén enardecidos, les serviré su \w banquete|strong="H4960"\w*,  
\q2 los emborracharé \w para|strong="H4616"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* alegren,  
\q1 y duerman un \w sueño|strong="H8142"\w* \w eterno|strong="H5769"\w* del \w que|strong="H3808"\w* \w no|strong="H3808"\w* despierten”  
\q2 — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 40 “\w Los|strong="H5973"\w* haré bajar \w como|strong="H5973"\w* \w corderos|strong="H3733"\w* al matadero,  
\q2 \w como|strong="H5973"\w* carneros \w junto|strong="H5973"\w* \w con|strong="H5973"\w* machos cabríos.   
\b  
\q1
\v 41 ¡\w Cómo|strong="H1961"\w* ha \w sido|strong="H1961"\w* capturada Babilonia!  
\q2 ¡\w Cómo|strong="H1961"\w* ha \w sido|strong="H1961"\w* apresada \w la|strong="H3605"\w* \w que|strong="H1961"\w* \w era|strong="H1961"\w* \w el|strong="H3605"\w* orgullo de \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra!  
\q2 ¡\w Cómo|strong="H1961"\w* ha quedado Babilonia convertida en \w espanto|strong="H8047"\w* entre las \w naciones|strong="H1471"\w*!   
\q1
\v 42 \w El|strong="H5921"\w* \w mar|strong="H3220"\w* \w subió|strong="H5927"\w* \w sobre|strong="H5921"\w* Babilonia;  
\q2 fue cubierta \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H1995"\w* \w de|strong="H5921"\w* sus olas.   
\q1
\v 43 Sus \w ciudades|strong="H5892"\w* \w quedaron|strong="H1961"\w* desoladas,  
\q2 \w la|strong="H3605"\w* tierra \w quedó|strong="H1961"\w* \w seca|strong="H6723"\w* y \w desierta|strong="H6160"\w*,  
\q2 una tierra donde \w nadie|strong="H3808"\w* vive \w ni|strong="H3808"\w* \w pasa|strong="H5674"\w* \w ningún|strong="H3605"\w* ser humano.   
\q1
\v 44 Yo castigaré \w al|strong="H5921"\w* dios \w Bel|strong="H1078"\w* \w en|strong="H5921"\w* Babilonia,  
\q2 \w y|strong="H1571"\w* \w le|strong="H5921"\w* sacaré \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* tragó.  
\q1 \w Las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w no|strong="H3808"\w* correrán \w más|strong="H5750"\w* \w hacia|strong="H5921"\w* \w él|strong="H5921"\w*,  
\q2 \w y|strong="H1571"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w* \w de|strong="H5921"\w* Babilonia \w caerá|strong="H5307"\w*.   
\b  
\q1
\v 45 ¡\w Salgan|strong="H3318"\w* \w de|strong="H5971"\w* ella, \w pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*!  
\q2 ¡\w Que|strong="H5971"\w* cada uno salve su \w vida|strong="H5315"\w* del ardor \w de|strong="H5971"\w* la \w ira|strong="H3318"\w* \w de|strong="H5971"\w* Yahvé!   
\q1
\v 46 \w No|strong="H6435"\w* \w se|strong="H5921"\w* desanimen \w ni|strong="H6435"\w* tengan \w miedo|strong="H3372"\w*  
\q2 \w por|strong="H5921"\w* \w los|strong="H5921"\w* rumores \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w oyen|strong="H8085"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* país;  
\q1 \w porque|strong="H5921"\w* un \w año|strong="H8141"\w* vendrá un \w rumor|strong="H8052"\w*,  
\q2 \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w año|strong="H8141"\w* siguiente \w otro|strong="H8141"\w* \w rumor|strong="H8052"\w*;  
\q2 habrá \w violencia|strong="H2555"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* un gobernante luchará \w contra|strong="H5921"\w* \w otro|strong="H8141"\w*.   
\q1
\v 47 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* castigaré \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w ídolos|strong="H6456"\w* \w de|strong="H5921"\w* Babilonia,  
\q2 \w y|strong="H5921"\w* \w toda|strong="H3605"\w* su tierra quedará avergonzada,  
\q2 \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w muertos|strong="H2491"\w* \w caerán|strong="H5307"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w ella|strong="H5921"\w*.   
\q1
\v 48 \w Los|strong="H5921"\w* \w cielos|strong="H8064"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* tierra, \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* hay \w en|strong="H5921"\w* \w ellos|strong="H5921"\w*,  
\q2 \w cantarán|strong="H7442"\w* \w de|strong="H5921"\w* alegría \w sobre|strong="H5921"\w* Babilonia;  
\q1 \w porque|strong="H3588"\w* \w del|strong="H5921"\w* \w norte|strong="H6828"\w* vendrán \w contra|strong="H5921"\w* \w ella|strong="H5921"\w* \w los|strong="H5921"\w* destructores” — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 49 “\w Como|strong="H1571"\w* Babilonia \w hizo|strong="H5307"\w* \w caer|strong="H5307"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w muertos|strong="H2491"\w* de \w Israel|strong="H3478"\w*,  
\q2 \w así|strong="H1571"\w* \w caerán|strong="H5307"\w* en Babilonia \w los|strong="H3605"\w* \w muertos|strong="H2491"\w* de \w toda|strong="H3605"\w* \w la|strong="H1571"\w* tierra.   
\q1
\v 50 Ustedes \w que|strong="H5921"\w* escaparon \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, ¡vayan!, \w no|strong="H5921"\w* \w se|strong="H5921"\w* detengan;  
\q2 acuérdense \w de|strong="H5921"\w* Yahvé \w desde|strong="H5921"\w* \w lejos|strong="H7350"\w*  
\q2 \w y|strong="H5921"\w* tengan presente \w a|strong="H3068"\w* Jerusalén \w en|strong="H5921"\w* sus pensamientos”.   
\b  
\q1
\v 51 “Estamos avergonzados \w porque|strong="H3588"\w* hemos \w oído|strong="H8085"\w* insultos;  
\q2 \w la|strong="H5921"\w* \w deshonra|strong="H2781"\w* \w cubre|strong="H3680"\w* nuestra \w cara|strong="H6440"\w*,  
\q1 \w porque|strong="H3588"\w* extranjeros han entrado \w en|strong="H5921"\w* \w los|strong="H5921"\w* lugares santos \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé”.   
\b  
\q1
\v 52 “\w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w*”, \w dice|strong="H5002"\w* Yahvé,  
\q2 “\w en|strong="H5921"\w* \w que|strong="H5921"\w* castigaré \w a|strong="H3068"\w* sus \w ídolos|strong="H6456"\w*,  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w toda|strong="H3605"\w* su tierra gemirán \w los|strong="H5921"\w* \w heridos|strong="H2491"\w*.   
\q1
\v 53 \w Aunque|strong="H3588"\w* Babilonia \w suba|strong="H5927"\w* hasta \w el|strong="H3588"\w* \w cielo|strong="H8064"\w*  
\q2 \w y|strong="H3588"\w* fortifique \w en|strong="H3588"\w* lo \w alto|strong="H4791"\w* \w su|strong="H3588"\w* \w fortaleza|strong="H5797"\w*,  
\q2 \w yo|strong="H3588"\w* enviaré destructores contra ella” — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 54 “¡Se oyen \w gritos|strong="H2201"\w* desde Babilonia,  
\q2 \w gran|strong="H1419"\w* desastre en la tierra de los \w caldeos|strong="H3778"\w*!   
\q1
\v 55 \w Porque|strong="H3588"\w* Yahvé \w destruye|strong="H7703"\w* \w a|strong="H3068"\w* Babilonia  
\q2 \w y|strong="H3588"\w* acaba \w con|strong="H4480"\w* \w su|strong="H3588"\w* \w gran|strong="H1419"\w* bullicio;  
\q1 braman sus olas \w como|strong="H3588"\w* \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w*  
\q2 \w y|strong="H3588"\w* resuena \w el|strong="H3588"\w* estrépito \w de|strong="H4480"\w* \w su|strong="H3588"\w* \w voz|strong="H6963"\w*.   
\q1
\v 56 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* destructor vino \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*, \w contra|strong="H5921"\w* Babilonia;  
\q2 sus guerreros fueron capturados,  
\q1 sus \w arcos|strong="H7198"\w* fueron hechos pedazos;  
\q2 \w porque|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* un \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* da \w el|strong="H5921"\w* pago merecido.   
\q1
\v 57 Emborracharé \w a|strong="H3068"\w* sus \w jefes|strong="H8269"\w* y \w a|strong="H3068"\w* sus \w sabios|strong="H2450"\w*,  
\q2 \w a|strong="H3068"\w* sus \w gobernadores|strong="H6346"\w*, oficiales y guerreros;  
\q1 dormirán un \w sueño|strong="H8142"\w* \w eterno|strong="H5769"\w* y \w no|strong="H3808"\w* despertarán”,  
\q2 \w dice|strong="H5002"\w* el \w Rey|strong="H4428"\w*, cuyo \w nombre|strong="H8034"\w* es Yahvé \w de|strong="H8269"\w* \w los|strong="H2450"\w* \w Ejércitos|strong="H6635"\w*.   
\p
\v 58 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w*:  
\q1 “Los \w muros|strong="H2346"\w* anchos \w de|strong="H5971"\w* Babilonia serán totalmente derribados,  
\q2 \w y|strong="H3541"\w* sus altas \w puertas|strong="H8179"\w* serán \w quemadas|strong="H3341"\w* con fuego;  
\q1 \w así|strong="H3541"\w* \w que|strong="H5971"\w* los \w pueblos|strong="H5971"\w* habrán trabajado \w para|strong="H5971"\w* nada,  
\q2 \w y|strong="H3541"\w* las naciones \w se|strong="H5971"\w* habrán \w cansado|strong="H3021"\w* solo \w para|strong="H5971"\w* \w que|strong="H5971"\w* todo termine en el fuego”.   
\p
\v 59 Este \w es|strong="H1697"\w* \w el|strong="H1121"\w* mensaje \w que|strong="H1697"\w* \w el|strong="H1121"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* le dio \w a|strong="H3068"\w* \w Seraías|strong="H8304"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maasías, cuando este \w iba|strong="H3212"\w* con Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* Babilonia, \w en|strong="H3212"\w* \w el|strong="H1121"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H1121"\w* su \w reinado|strong="H4427"\w*. \w Seraías|strong="H8304"\w* \w era|strong="H8141"\w* \w el|strong="H1121"\w* \w jefe|strong="H8269"\w* \w de|strong="H1121"\w* suministros.  
\v 60 \w Jeremías|strong="H3414"\w* \w escribió|strong="H3789"\w* en un solo \w libro|strong="H5612"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* desastres \w que|strong="H1697"\w* le vendrían \w a|strong="H3068"\w* Babilonia, \w es|strong="H1697"\w* decir, \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w* \w escritas|strong="H3789"\w* \w contra|strong="H3789"\w* \w ella|strong="H3605"\w*.  
\v 61 \w Jeremías|strong="H3414"\w* le dijo \w a|strong="H3068"\w* \w Seraías|strong="H8304"\w*: “En cuanto llegues \w a|strong="H3068"\w* Babilonia, asegúrate \w de|strong="H1697"\w* \w leer|strong="H7121"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*.  
\v 62 \w Luego|strong="H2088"\w* \w dirás|strong="H1696"\w*: ‘\w Señor|strong="H3068"\w*, tú has \w dicho|strong="H1696"\w* \w que|strong="H3588"\w* destruirás \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w quede|strong="H1961"\w* \w en|strong="H5704"\w* \w él|strong="H3588"\w* nadie, \w ni|strong="H5704"\w* hombre \w ni|strong="H5704"\w* animal, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w será|strong="H1961"\w* una desolación \w eterna|strong="H5769"\w*’.  
\v 63 \w Cuando|strong="H1961"\w* acabes \w de|strong="H5921"\w* \w leer|strong="H5612"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w*, átale una piedra \w y|strong="H5921"\w* arrójalo \w al|strong="H5921"\w* fondo \w del|strong="H5921"\w* \w Éufrates|strong="H6578"\w*.  
\v 64 Entonces dirás: ‘\w Así|strong="H3602"\w* \w se|strong="H5921"\w* hundirá Babilonia \w y|strong="H5921"\w* \w no|strong="H3808"\w* volverá \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*, \w por|strong="H5921"\w* \w el|strong="H5921"\w* desastre \w que|strong="H3808"\w* yo traigo \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*; \w y|strong="H5921"\w* quedarán agotados’”.  
\p \w Aquí|strong="H2008"\w* terminan \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* \w Jeremías|strong="H3414"\w*.   
\c 52  
\p
\v 1 Sedequías tenía veintiún \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y \w reinó|strong="H4427"\w* en Jerusalén once \w años|strong="H8141"\w*. Su madre se \w llamaba|strong="H8034"\w* \w Hamutal|strong="H2537"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w Jeremías|strong="H3414"\w*, \w de|strong="H1121"\w* la ciudad \w de|strong="H1121"\w* \w Libna|strong="H3841"\w*.  
\v 2 Pero Sedequías \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, siguiendo \w el|strong="H3605"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* \w Joacim|strong="H3079"\w*.  
\v 3 \w Por|strong="H5921"\w* eso \w la|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé \w se|strong="H1961"\w* encendió \w contra|strong="H5921"\w* Jerusalén \w y|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* arrojó \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w presencia|strong="H6440"\w*. \w Y|strong="H3068"\w* \w sucedió|strong="H1961"\w* \w que|strong="H3588"\w* Sedequías \w se|strong="H1961"\w* rebeló \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia.   
\p
\v 4 \w En|strong="H5921"\w* \w el|strong="H1931"\w* \w noveno|strong="H8671"\w* \w año|strong="H8141"\w* \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Sedequías, \w el|strong="H1931"\w* día diez \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w décimo|strong="H6224"\w*, \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, marchó \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w su|strong="H1931"\w* \w ejército|strong="H2428"\w* \w contra|strong="H5921"\w* Jerusalén. Acamparon frente \w a|strong="H3068"\w* \w la|strong="H1931"\w* ciudad \w y|strong="H5921"\w* construyeron rampas \w de|strong="H5921"\w* asalto \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w alrededor|strong="H5439"\w*.  
\v 5 La \w ciudad|strong="H5892"\w* estuvo bajo sitio \w hasta|strong="H5704"\w* el \w año|strong="H8141"\w* \w undécimo|strong="H6249"\w* del \w rey|strong="H4428"\w* Sedequías.   
\p
\v 6 El día \w nueve|strong="H8672"\w* del \w mes|strong="H2320"\w* \w cuarto|strong="H7243"\w*, el \w hambre|strong="H7458"\w* en la \w ciudad|strong="H5892"\w* \w era|strong="H1961"\w* ya tan grave \w que|strong="H3808"\w* la \w gente|strong="H5971"\w* del \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* \w tenía|strong="H1961"\w* \w nada|strong="H3808"\w* \w que|strong="H3808"\w* comer.  
\v 7 Entonces \w se|strong="H5921"\w* abrió una brecha \w en|strong="H5921"\w* \w la|strong="H5921"\w* muralla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* soldados \w huyeron|strong="H1272"\w*. \w Salieron|strong="H3318"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w entre|strong="H5921"\w* \w los|strong="H5921"\w* dos \w muros|strong="H2346"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* jardín \w real|strong="H4428"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* dirigieron \w hacia|strong="H1870"\w* \w el|strong="H5921"\w* valle \w del|strong="H5921"\w* Arabá, \w a|strong="H3068"\w* pesar \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w* tenían rodeada \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.  
