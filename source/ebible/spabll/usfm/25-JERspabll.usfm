\q2 y \w buscarán|strong="H1245"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*.   
\q1
\v 5 \w Preguntarán|strong="H7592"\w* \w por|strong="H1870"\w* el \w camino|strong="H1870"\w* \w de|strong="H6440"\w* \w Sión|strong="H6726"\w* y \w hacia|strong="H1870"\w* \w allá|strong="H6440"\w* dirigirán la mirada,  
\q2 diciendo: ‘Vengan y unámonos \w a|strong="H3068"\w* Yahvé en un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*  
\q2 \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* olvide’.   
\q1
\v 6 \w Mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* ha \w sido|strong="H1961"\w* \w como|strong="H1961"\w* \w ovejas|strong="H6629"\w* perdidas;  
\q2 sus \w pastores|strong="H7462"\w* las hicieron extraviarse.  
\q1 Las dejaron vagar por \w los|strong="H1961"\w* \w montes|strong="H2022"\w*;  
\q2 \w anduvieron|strong="H1980"\w* \w de|strong="H5971"\w* \w monte|strong="H2022"\w* en colina  
\q2 y \w olvidaron|strong="H7911"\w* su lugar \w de|strong="H5971"\w* descanso.   
\q1
\v 7 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3808"\w* las encontraban las devoraban;  
\q2 sus \w enemigos|strong="H6862"\w* decían: ‘\w No|strong="H3808"\w* somos culpables’,  
\q1 \w porque|strong="H3808"\w* \w ellos|strong="H3605"\w* \w pecaron|strong="H2398"\w* contra Yahvé,  
\q2 \w la|strong="H3605"\w* verdadera \w morada|strong="H5116"\w* \w de|strong="H8478"\w* \w justicia|strong="H6664"\w* y \w esperanza|strong="H4723"\w* \w de|strong="H8478"\w* sus antepasados.   
\b  
\q1
\v 8 ¡Huyan \w de|strong="H6440"\w* Babilonia!  
\q2 \w Salgan|strong="H3318"\w* \w de|strong="H6440"\w* la tierra \w de|strong="H6440"\w* \w los|strong="H1961"\w* \w caldeos|strong="H3778"\w*,  
\q2 y \w sean|strong="H1961"\w* \w como|strong="H1961"\w* \w los|strong="H1961"\w* machos cabríos \w que|strong="H1961"\w* guían al \w rebaño|strong="H6629"\w*.   
\q1
\v 9 \w Porque|strong="H3588"\w* miren, \w yo|strong="H3588"\w* voy \w a|strong="H3068"\w* incitar  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* lanzar \w contra|strong="H5921"\w* Babilonia una alianza \w de|strong="H5921"\w* \w grandes|strong="H1419"\w* \w naciones|strong="H1471"\w* \w del|strong="H5921"\w* \w norte|strong="H6828"\w*.  
\q1 \w Se|strong="H5921"\w* formarán \w en|strong="H5921"\w* orden \w de|strong="H5921"\w* batalla \w contra|strong="H5921"\w* \w ella|strong="H8033"\w* \w y|strong="H3588"\w* \w desde|strong="H5921"\w* \w allá|strong="H8033"\w* \w será|strong="H3808"\w* conquistada.  
\q1 Sus flechas \w son|strong="H3588"\w* \w como|strong="H3588"\w* \w las|strong="H5921"\w* \w de|strong="H5921"\w* un guerrero experto  
\q2 \w que|strong="H3588"\w* \w nunca|strong="H3808"\w* falla \w el|strong="H5921"\w* tiro.   
\q1
\v 10 Caldea \w será|strong="H1961"\w* saqueada;  
\q2 \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* \w la|strong="H3605"\w* saqueen quedarán satisfechos” — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 11 “\w Aunque|strong="H3588"\w* ustedes se alegren \w y|strong="H3588"\w* se regocijen  
\q2 \w mientras|strong="H3588"\w* saquean mi \w heredad|strong="H5159"\w*;  
