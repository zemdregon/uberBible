\c 33  
\p
\v 1 \w La|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H5750"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w por|strong="H1697"\w* \w segunda|strong="H8145"\w* vez, \w mientras|strong="H5750"\w* \w él|strong="H1931"\w* \w todavía|strong="H5750"\w* \w estaba|strong="H1961"\w* recluido \w en|strong="H5750"\w* \w el|strong="H1931"\w* \w patio|strong="H2691"\w* \w de|strong="H5750"\w* \w la|strong="H1931"\w* guardia:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé, \w el|strong="H6213"\w* \w que|strong="H3541"\w* \w hizo|strong="H6213"\w* la tierra, Yahvé \w que|strong="H3541"\w* la \w formó|strong="H3335"\w* \w y|strong="H3541"\w* la estableció — Yahvé \w es|strong="H3541"\w* su \w nombre|strong="H8034"\w* —:  
\v 3 ‘\w Clama|strong="H7121"\w* \w a|strong="H3068"\w* \w mí|strong="H6030"\w* y yo te \w responderé|strong="H6030"\w*, y te daré \w a|strong="H3068"\w* conocer \w cosas|strong="H3045"\w* \w grandes|strong="H1419"\w* \w e|strong="H3068"\w* inaccesibles \w que|strong="H3808"\w* tú \w no|strong="H3808"\w* \w conoces|strong="H3045"\w*’.  
\v 4 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* palacios \w reales|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w que|strong="H3588"\w* han sido derribados \w para|strong="H5921"\w* defenderse \w de|strong="H5921"\w* \w las|strong="H5921"\w* rampas \w de|strong="H5921"\w* asalto \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*:  
\v 5 ‘Aunque \w ellos|strong="H5921"\w* vengan \w a|strong="H3068"\w* luchar \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w*, solo será \w para|strong="H5921"\w* llenar \w las|strong="H5921"\w* casas \w con|strong="H5921"\w* \w los|strong="H5921"\w* cadáveres \w de|strong="H5921"\w* \w aquellos|strong="H3605"\w* \w a|strong="H3068"\w* quienes \w herí|strong="H5221"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w furor|strong="H2534"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w ira|strong="H2534"\w*; pues \w escondí|strong="H5641"\w* \w mi|strong="H5921"\w* \w rostro|strong="H6440"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w por|strong="H5921"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* \w toda|strong="H3605"\w* su \w maldad|strong="H7451"\w*.  
\v 6 Pero miren, yo \w les|strong="H1992"\w* traeré \w salud|strong="H4832"\w* y bienestar; \w los|strong="H1992"\w* \w sanaré|strong="H7495"\w* y \w les|strong="H1992"\w* revelaré una \w abundancia|strong="H6283"\w* de \w paz|strong="H7965"\w* y de seguridad.  
\v 7 Cambiaré la suerte de \w Judá|strong="H3063"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w*, y los reconstruiré para que sean como al principio.  
\v 8 \w Los|strong="H3605"\w* purificaré de \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w maldad|strong="H5771"\w* con \w que|strong="H3605"\w* \w pecaron|strong="H2398"\w* contra mí, y \w perdonaré|strong="H5545"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pecados|strong="H5771"\w* con \w que|strong="H3605"\w* se rebelaron contra mí.  
\v 9 \w Y|strong="H3068"\w* \w esta|strong="H1961"\w* ciudad \w será|strong="H1961"\w* \w para|strong="H5921"\w* \w mí|strong="H5921"\w* motivo \w de|strong="H5921"\w* \w gozo|strong="H8342"\w*, \w alabanza|strong="H8416"\w* \w y|strong="H5921"\w* \w gloria|strong="H8597"\w* ante \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w que|strong="H5921"\w* \w oirán|strong="H8085"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w bien|strong="H2896"\w* \w que|strong="H5921"\w* \w yo|strong="H6213"\w* \w les|strong="H5921"\w* \w hago|strong="H6213"\w*; \w y|strong="H5921"\w* temerán \w y|strong="H5921"\w* \w temblarán|strong="H7264"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* bienestar \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w paz|strong="H7965"\w* \w que|strong="H5921"\w* \w yo|strong="H6213"\w* \w les|strong="H5921"\w* daré’”.   
\p
\v 10 \w Así|strong="H3541"\w* dice Yahvé: “\w En|strong="H5750"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* del \w cual|strong="H1931"\w* ustedes dicen: ‘\w Está|strong="H2088"\w* desolado, sin hombres ni animales’, \w en|strong="H5750"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5750"\w* \w Judá|strong="H3063"\w* \w y|strong="H3541"\w* \w en|strong="H5750"\w* las \w calles|strong="H2351"\w* \w de|strong="H5750"\w* Jerusalén \w que|strong="H1931"\w* \w están|strong="H3427"\w* abandonadas, sin gente, sin \w habitantes|strong="H3427"\w* \w y|strong="H3541"\w* sin animales, \w se|strong="H1931"\w* volverá \w a|strong="H3068"\w* \w oír|strong="H8085"\w*:  
\v 11 gritos \w de|strong="H3588"\w* \w gozo|strong="H8057"\w* \w y|strong="H3588"\w* \w alegría|strong="H8057"\w*, \w la|strong="H3588"\w* \w voz|strong="H6963"\w* del novio \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* novia, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* digan: ‘Den gracias \w a|strong="H3068"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w porque|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* \w bueno|strong="H2896"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* amor \w es|strong="H3588"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*’; \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* traigan ofrendas \w de|strong="H3588"\w* gratitud \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé. \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* cambiaré \w la|strong="H3588"\w* suerte \w de|strong="H3588"\w* esta tierra \w para|strong="H3588"\w* \w que|strong="H3588"\w* sea \w como|strong="H3588"\w* al principio — dice Yahvé —”.   
\p
\v 12 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5750"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*: “\w En|strong="H5704"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* desolado, sin hombres \w ni|strong="H5704"\w* animales, \w y|strong="H5704"\w* \w en|strong="H5704"\w* \w todas|strong="H3605"\w* sus \w ciudades|strong="H5892"\w*, volverá \w a|strong="H3068"\w* \w haber|strong="H1961"\w* pastizales \w donde|strong="H4725"\w* \w los|strong="H3605"\w* \w pastores|strong="H7462"\w* hagan descansar \w a|strong="H3068"\w* sus rebaños.  
\v 13 \w En|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* montaña, \w de|strong="H5921"\w* \w la|strong="H5921"\w* llanura \w y|strong="H5921"\w* \w del|strong="H5921"\w* sur, \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*, \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w alrededores|strong="H5439"\w* \w de|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, volverán \w a|strong="H3068"\w* \w pasar|strong="H5674"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* bajo \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w del|strong="H5921"\w* \w que|strong="H5921"\w* \w las|strong="H5921"\w* \w cuenta|strong="H4487"\w* — dice Yahvé —”.   
\p
\v 14 “Miren \w que|strong="H5921"\w* vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H5921"\w* \w que|strong="H5921"\w* cumpliré \w la|strong="H5921"\w* \w buena|strong="H2896"\w* promesa \w que|strong="H5921"\w* hice \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\q1
\v 15 En \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* y en \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*,  
\q2 \w haré|strong="H6213"\w* brotar para \w David|strong="H1732"\w* un \w Renuevo|strong="H6780"\w* \w de|strong="H6256"\w* \w justicia|strong="H6666"\w*;  
\q2 \w él|strong="H1931"\w* \w hará|strong="H6213"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w es|strong="H1931"\w* justo y recto en \w la|strong="H1931"\w* tierra.   
\q1
\v 16 En esos \w días|strong="H3117"\w* \w Judá|strong="H3063"\w* será \w salvo|strong="H3467"\w*  
\q2 y Jerusalén vivirá segura.  
\q1 \w Y|strong="H3068"\w* \w este|strong="H2088"\w* \w es|strong="H2088"\w* \w el|strong="H1992"\w* \w nombre|strong="H7121"\w* con \w que|strong="H3117"\w* será llamada:  
\q2 ‘Yahvé, \w justicia|strong="H6664"\w* nuestra’.   
\p
\v 17 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: ‘\w Nunca|strong="H3808"\w* \w le|strong="H5921"\w* \w faltará|strong="H3772"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* un sucesor \w que|strong="H3588"\w* \w se|strong="H5921"\w* siente \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Tampoco|strong="H3808"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w levitas|strong="H3881"\w* les \w faltará|strong="H3772"\w* \w nunca|strong="H3808"\w* alguien \w que|strong="H3808"\w* me ofrezca \w holocaustos|strong="H5930"\w*, queme ofrendas \w de|strong="H6440"\w* grano y \w presente|strong="H4503"\w* \w sacrificios|strong="H2077"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w*’”.   
\p
\v 19 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 20 “\w Así|strong="H3541"\w* dice Yahvé: ‘\w Si|strong="H1961"\w* ustedes pudieran romper \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* con el \w día|strong="H3117"\w* \w y|strong="H3541"\w* \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w* con la \w noche|strong="H3915"\w*, \w de|strong="H6256"\w* manera \w que|strong="H1115"\w* el \w día|strong="H3117"\w* \w y|strong="H3541"\w* la \w noche|strong="H3915"\w* \w no|strong="H1961"\w* llegaran \w a|strong="H3068"\w* su \w tiempo|strong="H6256"\w*,  
\v 21 \w entonces|strong="H1571"\w* \w también|strong="H1571"\w* podría romperse \w mi|strong="H5921"\w* \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*, \w y|strong="H1571"\w* \w él|strong="H5921"\w* dejaría \w de|strong="H5921"\w* \w tener|strong="H1961"\w* un \w hijo|strong="H1121"\w* \w que|strong="H5921"\w* \w reine|strong="H4427"\w* \w en|strong="H5921"\w* su \w trono|strong="H3678"\w*; \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w se|strong="H1961"\w* rompería \w mi|strong="H5921"\w* \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w levitas|strong="H3881"\w*, \w que|strong="H5921"\w* \w son|strong="H1961"\w* mis \w ministros|strong="H8334"\w*.  
\v 22 \w Como|strong="H3651"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* pueden \w contar|strong="H5608"\w* las estrellas del \w cielo|strong="H8064"\w* \w ni|strong="H3808"\w* medir la arena del \w mar|strong="H3220"\w*, \w así|strong="H3651"\w* \w multiplicaré|strong="H7235"\w* la \w descendencia|strong="H2233"\w* de mi \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* y de los \w levitas|strong="H3881"\w* \w que|strong="H3808"\w* me sirven’”.   
\p
\v 23 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 24 “¿\w No|strong="H3808"\w* has notado \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w dice|strong="H1696"\w* \w esta|strong="H2088"\w* \w gente|strong="H1471"\w*: ‘Yahvé \w ha|strong="H3808"\w* rechazado \w a|strong="H3068"\w* las \w dos|strong="H8147"\w* \w familias|strong="H4940"\w* \w que|strong="H4100"\w* \w había|strong="H1961"\w* elegido’? \w Así|strong="H2088"\w* desprecian \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*, y \w ya|strong="H2088"\w* \w no|strong="H3808"\w* \w lo|strong="H4100"\w* \w consideran|strong="H7200"\w* una \w nación|strong="H1471"\w*.  
\v 25 \w Así|strong="H3541"\w* dice Yahvé: ‘\w Si|strong="H3808"\w* mi \w pacto|strong="H1285"\w* con el \w día|strong="H3119"\w* \w y|strong="H3541"\w* con la \w noche|strong="H3915"\w* \w no|strong="H3808"\w* fuera firme, \w y|strong="H3541"\w* \w si|strong="H3808"\w* yo \w no|strong="H3808"\w* hubiera establecido las leyes del \w cielo|strong="H8064"\w* \w y|strong="H3541"\w* de la tierra,  
\v 26 \w entonces|strong="H3588"\w* \w sí|strong="H3588"\w* rechazaría \w yo|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H1571"\w* \w descendencia|strong="H2233"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w* \w y|strong="H1571"\w* \w de|strong="H3588"\w* mi \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*, \w y|strong="H1571"\w* \w no|strong="H3588"\w* tomaría \w de|strong="H3588"\w* sus descendientes \w a|strong="H3068"\w* quien gobernara sobre \w la|strong="H1571"\w* posteridad \w de|strong="H3588"\w* Abraham, \w de|strong="H3588"\w* Isaac \w y|strong="H1571"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w*. \w Pero|strong="H3588"\w* \w yo|strong="H3588"\w* cambiaré \w su|strong="H3588"\w* suerte \w y|strong="H1571"\w* les tendré compasión’”.   
\c 34  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w que|strong="H5921"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* Yahvé, \w cuando|strong="H1961"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H2428"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra bajo su dominio, atacaban \w a|strong="H3068"\w* Jerusalén \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* vecinas:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*: ‘\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* habla con Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3541"\w* dile \w que|strong="H3541"\w* \w así|strong="H3541"\w* dice Yahvé: “\w Mira|strong="H2005"\w*, yo \w voy|strong="H1980"\w* \w a|strong="H3068"\w* entregar \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Babilonia, \w y|strong="H3541"\w* él le prenderá fuego.  
\v 3 Tú \w no|strong="H3808"\w* \w escaparás|strong="H4422"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* serás capturado \w y|strong="H3588"\w* \w entregado|strong="H5414"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w poder|strong="H3027"\w*. \w Verás|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia cara \w a|strong="H3068"\w* cara, \w él|strong="H3588"\w* \w te|strong="H5869"\w* \w hablará|strong="H1696"\w* personalmente \w y|strong="H3588"\w* serás llevado \w a|strong="H3068"\w* Babilonia” ’.   
\p
\v 4 \w Sin|strong="H3808"\w* embargo, \w escucha|strong="H8085"\w* \w la|strong="H5921"\w* promesa \w de|strong="H5921"\w* Yahvé, Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w*: ‘\w No|strong="H3808"\w* \w morirás|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*.  
\v 5 \w Morirás|strong="H4191"\w* \w en|strong="H3588"\w* \w paz|strong="H7965"\w*; \w y|strong="H3588"\w* \w así|strong="H3651"\w* \w como|strong="H3588"\w* quemaron perfumes \w en|strong="H3588"\w* honor \w de|strong="H3588"\w* tus antepasados, \w los|strong="H1961"\w* \w reyes|strong="H4428"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* precedieron, \w así|strong="H3651"\w* \w los|strong="H1961"\w* \w quemarán|strong="H8313"\w* \w por|strong="H3588"\w* ti. Harán duelo \w por|strong="H3588"\w* ti \w diciendo|strong="H1696"\w*: “¡\w Ay|strong="H1945"\w*, \w señor|strong="H3068"\w*!”, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* mismo \w lo|strong="H1697"\w* he prometido’ — \w dice|strong="H5002"\w* Yahvé —”.   
\p
\v 6 \w El|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* le \w dijo|strong="H1696"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w* \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, en Jerusalén,  
\v 7 \w mientras|strong="H3605"\w* \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia atacaba \w a|strong="H3068"\w* Jerusalén \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w que|strong="H3588"\w* \w aún|strong="H3588"\w* resistían, \w es|strong="H3588"\w* decir, Laquis \w y|strong="H3588"\w* \w Azeca|strong="H5825"\w*; \w porque|strong="H3588"\w* solo \w estas|strong="H2007"\w* \w ciudades|strong="H5892"\w* fortificadas quedaban \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\p
\v 8 \w La|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w después|strong="H1961"\w* \w de|strong="H5971"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* Sedequías \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* con \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Jerusalén \w para|strong="H1961"\w* proclamar \w la|strong="H3605"\w* \w libertad|strong="H1865"\w* \w de|strong="H5971"\w* \w los|strong="H1992"\w* esclavos:  
\v 9 cada \w uno|strong="H1115"\w* debía dejar \w libre|strong="H2670"\w* \w a|strong="H3068"\w* su esclavo y \w a|strong="H3068"\w* su esclava \w hebreos|strong="H5680"\w*, para \w que|strong="H1115"\w* nadie mantuviera como esclavo \w a|strong="H3068"\w* un hermano \w judío|strong="H3064"\w*.  
\v 10 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* y \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* habían aceptado \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* \w de|strong="H5750"\w* liberar \w a|strong="H3068"\w* sus esclavos y esclavas \w obedecieron|strong="H8085"\w* y \w los|strong="H3605"\w* dejaron \w ir|strong="H7971"\w*.  
\v 11 Pero después cambiaron de parecer y obligaron \w a|strong="H3068"\w* regresar \w a|strong="H3068"\w* los esclavos y esclavas que habían liberado, y los sometieron de nuevo \w a|strong="H3068"\w* la esclavitud.   
\p
\v 12 \w Por|strong="H1697"\w* eso, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 13 “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: ‘Yo \w hice|strong="H3772"\w* un \w pacto|strong="H1285"\w* con sus antepasados el \w día|strong="H3117"\w* \w que|strong="H3117"\w* los \w saqué|strong="H3318"\w* de \w Egipto|strong="H4714"\w*, ese lugar de esclavitud. Les dije:  
\v 14 Al cabo \w de|strong="H5973"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w*, \w cada|strong="H8141"\w* uno \w de|strong="H5973"\w* ustedes debe liberar \w a|strong="H3068"\w* su hermano \w hebreo|strong="H5680"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* haya vendido \w a|strong="H3068"\w* ustedes. Después \w de|strong="H5973"\w* servirles \w seis|strong="H8337"\w* \w años|strong="H8141"\w*, \w lo|strong="H3808"\w* \w dejarán|strong="H7971"\w* \w ir|strong="H7971"\w* \w libre|strong="H2670"\w*. Pero sus antepasados \w no|strong="H3808"\w* \w me|strong="H5973"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* \w me|strong="H5973"\w* \w obedecieron|strong="H8085"\w*.  
\v 15 \w Hace|strong="H6213"\w* poco ustedes \w se|strong="H5921"\w* habían arrepentido \w y|strong="H5921"\w* habían \w hecho|strong="H6213"\w* \w lo|strong="H5921"\w* \w recto|strong="H3477"\w* \w ante|strong="H6440"\w* mis \w ojos|strong="H5869"\w* \w al|strong="H5921"\w* proclamar \w la|strong="H5921"\w* \w libertad|strong="H1865"\w* \w de|strong="H5921"\w* su \w prójimo|strong="H7453"\w*. Incluso \w hicieron|strong="H6213"\w* un \w pacto|strong="H1285"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w que|strong="H5921"\w* lleva \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*.  
\v 16 Pero ahora \w se|strong="H1961"\w* han \w vuelto|strong="H7725"\w* atrás y han \w profanado|strong="H2490"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*; cada uno de ustedes ha obligado \w a|strong="H3068"\w* regresar \w a|strong="H3068"\w* \w los|strong="H1961"\w* esclavos y esclavas \w que|strong="H1961"\w* \w habían|strong="H1961"\w* liberado, y \w los|strong="H1961"\w* han forzado \w a|strong="H3068"\w* \w ser|strong="H5315"\w* sus esclavos otra vez’”.   
\p
\v 17 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé: “Ustedes \w no|strong="H3808"\w* \w me|strong="H3541"\w* han obedecido \w ni|strong="H3808"\w* han proclamado \w la|strong="H3605"\w* \w libertad|strong="H1865"\w* \w de|strong="H5414"\w* sus hermanos \w y|strong="H3541"\w* \w de|strong="H5414"\w* su \w prójimo|strong="H7453"\w*. \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, yo \w proclamo|strong="H7121"\w* \w para|strong="H5414"\w* ustedes una ‘\w libertad|strong="H1865"\w*’ — \w dice|strong="H5002"\w* Yahvé —: ¡\w libertad|strong="H1865"\w* \w para|strong="H5414"\w* morir \w por|strong="H3651"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w*, \w la|strong="H3605"\w* peste \w y|strong="H3541"\w* \w el|strong="H3605"\w* \w hambre|strong="H7458"\w*! \w Haré|strong="H5414"\w* \w que|strong="H3808"\w* ustedes sean motivo \w de|strong="H5414"\w* horror \w para|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H5414"\w* \w la|strong="H3605"\w* tierra.  
\v 18 \w A|strong="H3068"\w* los \w hombres|strong="H8147"\w* \w que|strong="H3808"\w* violaron mi \w pacto|strong="H1285"\w* y \w no|strong="H3808"\w* cumplieron las condiciones \w que|strong="H3808"\w* pactaron en mi \w presencia|strong="H6440"\w*, los trataré como al \w becerro|strong="H5695"\w* \w que|strong="H3808"\w* \w cortaron|strong="H3772"\w* en \w dos|strong="H8147"\w* \w para|strong="H5414"\w* \w pasar|strong="H5674"\w* \w por|strong="H1697"\w* medio \w de|strong="H6440"\w* las \w partes|strong="H1335"\w*:  
\v 19 \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w* y \w de|strong="H5971"\w* Jerusalén, \w a|strong="H3068"\w* \w los|strong="H3605"\w* oficiales \w de|strong="H5971"\w* \w la|strong="H3605"\w* corte, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w pasó|strong="H5674"\w* por medio \w de|strong="H5971"\w* las \w partes|strong="H1335"\w* del \w becerro|strong="H5695"\w*.  
\v 20 \w Los|strong="H1961"\w* \w entregaré|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus enemigos y \w de|strong="H5414"\w* \w los|strong="H1961"\w* \w que|strong="H1961"\w* quieren matarlos. Sus cadáveres \w servirán|strong="H1961"\w* \w de|strong="H5414"\w* \w comida|strong="H3978"\w* \w para|strong="H5414"\w* las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w* y las fieras \w de|strong="H5414"\w* la tierra.   
\p
\v 21 \w A|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w jefes|strong="H8269"\w*, \w los|strong="H5921"\w* \w entregaré|strong="H5414"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* sus enemigos \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w buscan|strong="H1245"\w* su muerte; \w los|strong="H5921"\w* \w entregaré|strong="H5414"\w* \w al|strong="H5921"\w* \w ejército|strong="H2428"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w que|strong="H5921"\w* ahora \w se|strong="H5921"\w* ha retirado \w de|strong="H5921"\w* ustedes.  
\v 22 Pero miren, \w yo|strong="H6680"\w* \w daré|strong="H5414"\w* \w la|strong="H5921"\w* \w orden|strong="H6680"\w* — \w dice|strong="H5002"\w* Yahvé — \w y|strong="H5921"\w* \w los|strong="H3427"\w* \w haré|strong="H5414"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*. \w La|strong="H5921"\w* atacarán, \w la|strong="H5921"\w* tomarán \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w prenderán|strong="H3920"\w* fuego. Convertiré \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w en|strong="H5921"\w* un desierto \w donde|strong="H5921"\w* \w no|strong="H5921"\w* viva nadie”.   
\c 35  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w que|strong="H1697"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*:  
\v 2 “\w Ve|strong="H1980"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de los recabitas y \w habla|strong="H1696"\w* con ellos. Hazlos entrar en uno de los aposentos de la \w casa|strong="H1004"\w* de Yahvé y dales de \w beber|strong="H8248"\w* \w vino|strong="H3196"\w*”.   
\p
\v 3 Entonces \w tomé|strong="H3947"\w* \w a|strong="H3068"\w* Jaazanías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeremías|strong="H3414"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Habasinías, junto con sus hermanos, \w todos|strong="H3605"\w* sus \w hijos|strong="H1121"\w* y \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* recabitas.  
\v 4 \w Los|strong="H1121"\w* llevé \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé, al \w aposento|strong="H1004"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Hanán|strong="H2605"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Igdalías, \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* \w Dios|strong="H3068"\w*. Ese \w aposento|strong="H1004"\w* \w estaba|strong="H1004"\w* junto al \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w*, y \w encima|strong="H4605"\w* del \w aposento|strong="H1004"\w* \w de|strong="H1121"\w* \w Maasías|strong="H4641"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Salum, guardián \w de|strong="H1121"\w* \w la|strong="H8104"\w* puerta.  
\v 5 \w Puse|strong="H5414"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H6440"\w* la \w familia|strong="H1004"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* recabitas jarras \w llenas|strong="H4392"\w* \w de|strong="H6440"\w* \w vino|strong="H3196"\w* y \w copas|strong="H1375"\w*, y les dije: “¡\w Beban|strong="H8354"\w* \w vino|strong="H3196"\w*!”.   
\p
\v 6 \w Pero|strong="H3588"\w* \w ellos|strong="H5921"\w* respondieron: “\w Nosotros|strong="H5921"\w* \w no|strong="H3808"\w* \w bebemos|strong="H8354"\w* \w vino|strong="H3196"\w*. \w Porque|strong="H3588"\w* nuestro antepasado \w Jonadab|strong="H3122"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Recab \w nos|strong="H5921"\w* dio \w esta|strong="H5921"\w* \w orden|strong="H6680"\w*: ‘\w No|strong="H3808"\w* \w beberán|strong="H8354"\w* \w vino|strong="H3196"\w* \w jamás|strong="H5769"\w*, \w ni|strong="H3808"\w* ustedes \w ni|strong="H3808"\w* sus \w hijos|strong="H1121"\w*.  
\v 7 \w Tampoco|strong="H3808"\w* construirán \w casas|strong="H1004"\w*, \w ni|strong="H3808"\w* sembrarán campos, \w ni|strong="H3808"\w* \w plantarán|strong="H5193"\w* viñedos, \w ni|strong="H3808"\w* poseerán \w nada|strong="H3808"\w* \w de|strong="H5921"\w* eso. \w Más|strong="H3588"\w* \w bien|strong="H3588"\w*, \w vivirán|strong="H2421"\w* \w siempre|strong="H3605"\w* \w en|strong="H5921"\w* tiendas \w de|strong="H5921"\w* campaña, \w para|strong="H4616"\w* \w que|strong="H3588"\w* vivan \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w donde|strong="H8033"\w* \w habitan|strong="H3427"\w* \w como|strong="H3588"\w* extranjeros’.  
\v 8 \w Y|strong="H3068"\w* \w nosotros|strong="H3605"\w* hemos obedecido en \w todo|strong="H3605"\w* las órdenes \w de|strong="H1121"\w* nuestro antepasado Jonadab \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Recab. En \w toda|strong="H3605"\w* nuestra \w vida|strong="H3117"\w* \w no|strong="H1115"\w* hemos \w bebido|strong="H8354"\w* \w vino|strong="H3196"\w*, \w ni|strong="H1115"\w* \w nosotros|strong="H3605"\w*, \w ni|strong="H1115"\w* nuestras esposas, \w ni|strong="H1115"\w* nuestros \w hijos|strong="H1121"\w* \w ni|strong="H1115"\w* nuestras \w hijas|strong="H1323"\w*.  
\v 9 \w Tampoco|strong="H3808"\w* hemos construido \w casas|strong="H1004"\w* \w para|strong="H1961"\w* vivir, \w ni|strong="H3808"\w* tenemos viñedos, \w ni|strong="H3808"\w* \w campos|strong="H7704"\w* \w ni|strong="H3808"\w* semillas.  
\v 10 Hemos vivido en tiendas y hemos \w cumplido|strong="H6213"\w* \w fielmente|strong="H8085"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* nos \w mandó|strong="H6680"\w* nuestro antepasado \w Jonadab|strong="H3122"\w*.  
\v 11 Sin embargo, \w cuando|strong="H1961"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Babilonia, invadió \w el|strong="H3427"\w* país, dijimos: ‘¡\w Vengan|strong="H5927"\w*! \w Vamos|strong="H5927"\w* \w a|strong="H3068"\w* Jerusalén \w para|strong="H1961"\w* protegernos del \w ejército|strong="H2428"\w* \w de|strong="H6440"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w* y del \w ejército|strong="H2428"\w* \w de|strong="H6440"\w* \w los|strong="H3427"\w* arameos’. \w Por|strong="H6440"\w* eso nos hemos quedado en Jerusalén”.   
\p
\v 12 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 13 “\w Así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé \w de|strong="H1697"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3427"\w* \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*: ‘\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* dile \w a|strong="H3068"\w* la gente \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* \w y|strong="H3541"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H1697"\w* Jerusalén: “¿Acaso \w no|strong="H3808"\w* \w van|strong="H1980"\w* \w a|strong="H3068"\w* aprender la lección \w y|strong="H3541"\w* \w obedecer|strong="H8085"\w* mis \w palabras|strong="H1697"\w*?”, \w dice|strong="H5002"\w* Yahvé.  
\v 14 “\w Los|strong="H1121"\w* descendientes \w de|strong="H3588"\w* Jonadab \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Recab han cumplido \w su|strong="H3588"\w* \w orden|strong="H6680"\w* \w de|strong="H3588"\w* \w no|strong="H3808"\w* \w beber|strong="H8354"\w* \w vino|strong="H3196"\w*, \w y|strong="H3588"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w* \w no|strong="H3808"\w* \w lo|strong="H1697"\w* \w beben|strong="H8354"\w* \w por|strong="H3588"\w* respeto \w al|strong="H5704"\w* mandato \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre. \w Yo|strong="H3588"\w*, \w en|strong="H5704"\w* cambio, \w les|strong="H6680"\w* he \w hablado|strong="H1696"\w* \w a|strong="H3068"\w* ustedes una \w y|strong="H3588"\w* otra vez, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* han obedecido.  
\v 15 También les \w envié|strong="H7971"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w mis|strong="H5414"\w* \w siervos|strong="H5650"\w* \w los|strong="H3427"\w* \w profetas|strong="H5030"\w*, enviándolos una y otra vez con este mensaje: ‘\w Que|strong="H3808"\w* \w cada|strong="H3605"\w* uno \w de|strong="H5414"\w* ustedes \w se|strong="H3808"\w* \w vuelva|strong="H7725"\w* \w de|strong="H5414"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*, mejore sus acciones y \w no|strong="H3808"\w* siga \w a|strong="H3068"\w* otros dioses \w para|strong="H5414"\w* servirles. \w Entonces|strong="H7725"\w* podrán vivir \w en|strong="H3212"\w* \w la|strong="H3605"\w* tierra \w que|strong="H3808"\w* les \w di|strong="H5414"\w* \w a|strong="H3068"\w* ustedes y \w a|strong="H3068"\w* sus antepasados’. Pero ustedes \w no|strong="H3808"\w* me \w prestaron|strong="H5414"\w* atención \w ni|strong="H3808"\w* me \w escucharon|strong="H8085"\w*.  
\v 16 \w Los|strong="H1121"\w* descendientes \w de|strong="H3588"\w* Jonadab \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Recab cumplieron \w la|strong="H3588"\w* \w orden|strong="H6680"\w* \w que|strong="H3588"\w* \w les|strong="H6680"\w* dejó \w su|strong="H3588"\w* padre, \w pero|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* obedecido” ’.   
\p
\v 17 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘Miren, voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén \w todo|strong="H3605"\w* \w el|strong="H5921"\w* desastre \w que|strong="H3808"\w* \w les|strong="H5921"\w* advertí. \w Porque|strong="H5921"\w* \w les|strong="H5921"\w* \w hablé|strong="H1696"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w me|strong="H5921"\w* \w escucharon|strong="H8085"\w*; \w los|strong="H3427"\w* \w llamé|strong="H7121"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w me|strong="H5921"\w* \w respondieron|strong="H6030"\w*’”.   
\p
\v 18 Luego \w Jeremías|strong="H3414"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* recabitas: “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘\w Por|strong="H5921"\w* \w cuanto|strong="H3282"\w* ustedes han obedecido \w las|strong="H5921"\w* órdenes \w de|strong="H5921"\w* su antepasado Jonadab, han \w guardado|strong="H8104"\w* \w todos|strong="H3605"\w* sus preceptos \w y|strong="H5921"\w* han \w hecho|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w les|strong="H5921"\w* \w mandó|strong="H6680"\w*,  
\v 19 \w por|strong="H6440"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*: \w Jonadab|strong="H3122"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Recab \w nunca|strong="H3808"\w* dejará \w de|strong="H6440"\w* \w tener|strong="H3651"\w* un descendiente \w que|strong="H3808"\w* \w esté|strong="H5975"\w* \w a|strong="H3068"\w* mi servicio’”.   
\c 36  
\p
\v 1 En \w el|strong="H1121"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 2 “\w Toma|strong="H3947"\w* un \w rollo|strong="H4039"\w* \w y|strong="H5921"\w* \w escribe|strong="H3789"\w* \w en|strong="H5921"\w* \w él|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* he \w hablado|strong="H1696"\w* \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w contra|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*, \w desde|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w que|strong="H5921"\w* empecé \w a|strong="H3068"\w* \w hablarte|strong="H1696"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w tiempos|strong="H3117"\w* \w de|strong="H5921"\w* \w Josías|strong="H2977"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 3 Quizá cuando \w el|strong="H3605"\w* pueblo \w de|strong="H7451"\w* \w Judá|strong="H3063"\w* \w oiga|strong="H8085"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w mal|strong="H7451"\w* \w que|strong="H4616"\w* \w pienso|strong="H2803"\w* \w hacerles|strong="H6213"\w*, \w cada|strong="H3605"\w* uno se arrepienta \w de|strong="H7451"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*, y \w yo|strong="H6213"\w* \w perdone|strong="H5545"\w* su \w maldad|strong="H5771"\w* y su \w pecado|strong="H2403"\w*”.   
\p
\v 4 \w Jeremías|strong="H3414"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Nerías, \w y|strong="H5921"\w* Baruc \w escribió|strong="H3789"\w* \w en|strong="H5921"\w* un \w rollo|strong="H4039"\w*, \w según|strong="H5921"\w* \w el|strong="H5921"\w* dictado \w de|strong="H5921"\w* \w Jeremías|strong="H3414"\w*, \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* había \w hablado|strong="H1696"\w*.  
\v 5 Luego \w Jeremías|strong="H3414"\w* le dio esta \w orden|strong="H6680"\w* \w a|strong="H3068"\w* Baruc: “\w Yo|strong="H6680"\w* estoy bajo arresto y \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* entrar en la \w casa|strong="H1004"\w* de Yahvé.  
\v 6 \w Por|strong="H1697"\w* eso, ve tú \w y|strong="H1571"\w* \w lee|strong="H7121"\w* en voz alta las \w palabras|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé \w que|strong="H1571"\w* \w escribiste|strong="H3789"\w* \w de|strong="H5971"\w* mi \w boca|strong="H6310"\w*. Léelas en \w el|strong="H3605"\w* \w rollo|strong="H4039"\w* ante \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* en \w la|strong="H1571"\w* \w casa|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, \w el|strong="H3605"\w* \w día|strong="H3117"\w* del \w ayuno|strong="H6685"\w*. Haz \w lo|strong="H1697"\w* \w mismo|strong="H1571"\w* ante \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w* \w que|strong="H1571"\w* vengan \w de|strong="H5971"\w* sus \w ciudades|strong="H5892"\w*.  
\v 7 \w Tal|strong="H2088"\w* vez presenten \w su|strong="H3588"\w* \w súplica|strong="H8467"\w* \w ante|strong="H6440"\w* Yahvé \w y|strong="H3588"\w* cada uno \w se|strong="H5971"\w* \w vuelva|strong="H7725"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*, \w porque|strong="H3588"\w* \w es|strong="H2088"\w* \w grande|strong="H1419"\w* \w el|strong="H3588"\w* \w enojo|strong="H2534"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w ira|strong="H2534"\w* \w que|strong="H3588"\w* Yahvé ha pronunciado \w contra|strong="H6440"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*”.   
\p
\v 8 Baruc \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w el|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* le \w mandó|strong="H6680"\w*, y \w leyó|strong="H7121"\w* en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé las \w palabras|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w que|strong="H1697"\w* estaban en \w el|strong="H3605"\w* rollo.  
\v 9 En \w el|strong="H3605"\w* \w noveno|strong="H8671"\w* \w mes|strong="H2320"\w* del \w quinto|strong="H2549"\w* \w año|strong="H8141"\w* \w de|strong="H6440"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w se|strong="H1961"\w* \w proclamó|strong="H7121"\w* un \w ayuno|strong="H6685"\w* \w ante|strong="H6440"\w* Yahvé \w para|strong="H1961"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w de|strong="H6440"\w* Jerusalén y \w para|strong="H1961"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5971"\w* venían \w de|strong="H6440"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*.  
\v 10 Entonces Baruc \w leyó|strong="H7121"\w* ante \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* las \w palabras|strong="H1697"\w* \w de|strong="H1121"\w* \w Jeremías|strong="H3414"\w* \w que|strong="H5971"\w* \w estaban|strong="H5971"\w* en \w el|strong="H3605"\w* rollo. \w Lo|strong="H1697"\w* hizo en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé, en \w la|strong="H3605"\w* sala \w de|strong="H1121"\w* Gemarías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán \w el|strong="H3605"\w* \w escriba|strong="H5608"\w*, en \w el|strong="H3605"\w* \w atrio|strong="H2691"\w* superior, \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w puerta|strong="H6607"\w* \w Nueva|strong="H2319"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé.   
\p
\v 11 Cuando Micaías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Gemarías, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Safán, \w oyó|strong="H8085"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w que|strong="H5921"\w* estaban \w en|strong="H5921"\w* \w el|strong="H5921"\w* rollo,  
\v 12 bajó \w al|strong="H5921"\w* palacio \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* sala \w del|strong="H5921"\w* \w secretario|strong="H5608"\w*. \w Allí|strong="H8033"\w* \w estaban|strong="H3427"\w* \w sentados|strong="H3427"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w jefes|strong="H8269"\w*: \w el|strong="H5921"\w* \w secretario|strong="H5608"\w* Elisama, Delaías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Semaías|strong="H8098"\w*, Elnatán \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Acbor, Gemarías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Safán, Sedequías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Ananías|strong="H2608"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* demás \w jefes|strong="H8269"\w*.  
\v 13 Micaías les \w contó|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* había \w oído|strong="H8085"\w* cuando Baruc \w leyó|strong="H7121"\w* \w el|strong="H3605"\w* rollo ante \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*.  
\v 14 Entonces \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w enviaron|strong="H7971"\w* \w a|strong="H3068"\w* Jehudí \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Selemías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Cusi, \w para|strong="H5971"\w* decirle \w a|strong="H3068"\w* Baruc: “Trae \w el|strong="H3605"\w* \w rollo|strong="H4039"\w* \w que|strong="H5971"\w* \w leíste|strong="H7121"\w* ante \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*, y \w ven|strong="H3212"\w* acá”.  
\p Baruc \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías \w tomó|strong="H3947"\w* \w el|strong="H3605"\w* \w rollo|strong="H4039"\w* \w en|strong="H3212"\w* su \w mano|strong="H3027"\w* y \w se|strong="H5971"\w* presentó ante \w ellos|strong="H3027"\w*.  
\v 15 Ellos le dijeron: “\w Siéntate|strong="H3427"\w*, por favor, y léenoslo”.  
\p \w Y|strong="H3068"\w* Baruc se lo \w leyó|strong="H7121"\w*.   
\p
\v 16 \w Cuando|strong="H1961"\w* terminaron \w de|strong="H1697"\w* \w oír|strong="H8085"\w* \w todas|strong="H3605"\w* esas \w palabras|strong="H1697"\w*, \w se|strong="H1961"\w* miraron unos \w a|strong="H3068"\w* otros con temor y le \w dijeron|strong="H1697"\w* \w a|strong="H3068"\w* Baruc: “\w Es|strong="H1961"\w* necesario \w que|strong="H1697"\w* le informemos \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w todo|strong="H3605"\w* \w esto|strong="H1697"\w*”.  
\v 17 \w Luego|strong="H4994"\w* le \w preguntaron|strong="H7592"\w* \w a|strong="H3068"\w* Baruc: “Dinos, ¿cómo \w escribiste|strong="H3789"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*? ¿Te las dictó \w él|strong="H3605"\w*?”.   
\p
\v 18 Baruc \w les|strong="H5921"\w* respondió: “\w Él|strong="H5921"\w* \w me|strong="H5921"\w* \w dictaba|strong="H7121"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*, \w y|strong="H5921"\w* yo \w las|strong="H5921"\w* iba escribiendo \w con|strong="H5921"\w* tinta \w en|strong="H5921"\w* \w el|strong="H5921"\w* rollo”.   
\p
\v 19 Entonces los \w jefes|strong="H8269"\w* le dijeron \w a|strong="H3068"\w* Baruc: “\w Vayan|strong="H3212"\w* y escóndanse, tú y \w Jeremías|strong="H3414"\w*, y \w que|strong="H3045"\w* nadie \w sepa|strong="H3045"\w* dónde están”.   
\p
\v 20 Después \w de|strong="H1697"\w* dejar \w el|strong="H3605"\w* \w rollo|strong="H4039"\w* en \w la|strong="H3605"\w* sala del \w secretario|strong="H5608"\w* Elisama, fueron \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w al|strong="H4428"\w* \w atrio|strong="H2691"\w* y le informaron \w de|strong="H1697"\w* \w todo|strong="H3605"\w*.  
\v 21 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Jehudí \w a|strong="H3068"\w* buscar \w el|strong="H5921"\w* \w rollo|strong="H4039"\w*. Jehudí \w lo|strong="H5921"\w* trajo \w de|strong="H5921"\w* \w la|strong="H5921"\w* sala \w del|strong="H5921"\w* \w secretario|strong="H5608"\w* Elisama \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w leyó|strong="H7121"\w* ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* ante \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w jefes|strong="H8269"\w* \w que|strong="H5921"\w* \w estaban|strong="H5975"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 22 Como era \w el|strong="H3427"\w* \w mes|strong="H2320"\w* \w noveno|strong="H8671"\w*, \w el|strong="H3427"\w* \w rey|strong="H4428"\w* \w estaba|strong="H3427"\w* en su residencia \w de|strong="H6440"\w* invierno, \w sentado|strong="H3427"\w* frente \w a|strong="H3068"\w* un brasero \w encendido|strong="H1197"\w*.  
\v 23 \w Cada|strong="H3605"\w* vez \w que|strong="H5921"\w* Jehudí terminaba \w de|strong="H5921"\w* \w leer|strong="H7121"\w* \w tres|strong="H7969"\w* \w o|strong="H3068"\w* cuatro columnas, \w el|strong="H5921"\w* rey \w las|strong="H5921"\w* cortaba \w con|strong="H5921"\w* un cortaplumas \w y|strong="H5921"\w* \w las|strong="H5921"\w* echaba \w al|strong="H5921"\w* fuego \w del|strong="H5921"\w* brasero, \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w rollo|strong="H4039"\w* \w se|strong="H1961"\w* consumió.  
\v 24 \w Ni|strong="H3808"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w ni|strong="H3808"\w* sus \w siervos|strong="H5650"\w* sintieron \w miedo|strong="H6342"\w* \w ni|strong="H3808"\w* \w se|strong="H3808"\w* \w rasgaron|strong="H7167"\w* las vestiduras \w al|strong="H4428"\w* \w oír|strong="H8085"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*.  
\v 25 \w Aunque|strong="H1571"\w* Elnatán, Delaías \w y|strong="H1571"\w* Gemarías le suplicaron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w quemara|strong="H8313"\w* \w el|strong="H1571"\w* \w rollo|strong="H4039"\w*, \w él|strong="H1571"\w* \w no|strong="H3808"\w* les hizo caso.  
\v 26 \w Al|strong="H4428"\w* contrario, \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Jerameel|strong="H3396"\w*, \w hijo|strong="H1121"\w* del \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w Seraías|strong="H8304"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Azriel|strong="H5837"\w* y \w a|strong="H3068"\w* Selemías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abdeel, \w que|strong="H1121"\w* arrestaran \w al|strong="H4428"\w* \w escriba|strong="H5608"\w* Baruc y \w al|strong="H4428"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w*. Pero Yahvé \w los|strong="H1121"\w* había \w escondido|strong="H5641"\w*.   
\p
\v 27 \w Después|strong="H1961"\w* \w de|strong="H1697"\w* \w que|strong="H1697"\w* el \w rey|strong="H4428"\w* \w quemó|strong="H8313"\w* el \w rollo|strong="H4039"\w* con las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* Baruc \w había|strong="H1961"\w* \w escrito|strong="H3789"\w* \w al|strong="H4428"\w* dictado \w de|strong="H1697"\w* \w Jeremías|strong="H3414"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 28 “\w Toma|strong="H3947"\w* otro \w rollo|strong="H4039"\w* \w y|strong="H5921"\w* \w escribe|strong="H3789"\w* \w en|strong="H5921"\w* \w él|strong="H5921"\w* \w las|strong="H5921"\w* mismas \w palabras|strong="H1697"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w primer|strong="H7223"\w* \w rollo|strong="H4039"\w*, \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w quemó|strong="H8313"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 29 \w Y|strong="H3068"\w* dile \w a|strong="H3068"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*: ‘\w Así|strong="H3541"\w* dice Yahvé: “Tú \w quemaste|strong="H8313"\w* ese \w rollo|strong="H4039"\w* diciendo: ‘¿\w Por|strong="H5921"\w* \w qué|strong="H4480"\w* \w escribiste|strong="H3789"\w* \w en|strong="H5921"\w* \w él|strong="H5921"\w* \w que|strong="H4480"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia vendrá sin falta \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w esta|strong="H2063"\w* tierra \w y|strong="H5921"\w* \w a|strong="H3068"\w* borrar \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w a|strong="H3068"\w* hombres \w y|strong="H5921"\w* animales?’” ’.  
\v 30 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*: ‘\w Ningún|strong="H3808"\w* descendiente suyo \w se|strong="H1961"\w* sentará \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*. Su cadáver \w será|strong="H1961"\w* arrojado \w y|strong="H5921"\w* \w quedará|strong="H1961"\w* expuesto \w al|strong="H5921"\w* calor \w del|strong="H5921"\w* \w día|strong="H3117"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* helada \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w*.  
