\p
\v 19 Yahvé \w me|strong="H3541"\w* dijo \w esto|strong="H3541"\w*: “\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* \w ponte|strong="H5975"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del \w pueblo|strong="H5971"\w*, \w por|strong="H4428"\w* donde entran \w y|strong="H3541"\w* \w salen|strong="H3318"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3541"\w* \w en|strong="H3318"\w* \w todas|strong="H3605"\w* las \w puertas|strong="H8179"\w* \w de|strong="H1121"\w* Jerusalén.  
\v 20 \w Y|strong="H3068"\w* \w diles|strong="H1697"\w*: ‘\w Escuchen|strong="H8085"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, ustedes \w reyes|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, y \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* y \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H1697"\w* Jerusalén \w que|strong="H1697"\w* entran \w por|strong="H1697"\w* estas \w puertas|strong="H8179"\w*.  
\v 21 \w Así|strong="H3541"\w* dice Yahvé: Cuídense por su propia \w vida|strong="H5315"\w* de no cargar nada en el \w día|strong="H3117"\w* de reposo, ni de introducirlo por las \w puertas|strong="H8179"\w* de Jerusalén.  
\v 22 \w No|strong="H3808"\w* saquen \w carga|strong="H4853"\w* de sus \w casas|strong="H1004"\w* \w en|strong="H3318"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* de reposo. \w No|strong="H3808"\w* \w hagan|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo, \w sino|strong="H3808"\w* santifiquen \w el|strong="H3605"\w* \w día|strong="H3117"\w* de reposo, tal como \w se|strong="H3808"\w* \w lo|strong="H3808"\w* \w mandé|strong="H6680"\w* \w a|strong="H3068"\w* sus antepasados.  
\v 23 Pero ellos \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* prestaron atención, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* pusieron tercos para \w no|strong="H3808"\w* \w oír|strong="H8085"\w* \w ni|strong="H3808"\w* \w recibir|strong="H3947"\w* instrucción.  
\v 24 Pero \w si|strong="H1961"\w* ustedes me \w escuchan|strong="H8085"\w* con atención — \w dice|strong="H5002"\w* Yahvé —, y \w no|strong="H6213"\w* introducen \w carga|strong="H4853"\w* por las \w puertas|strong="H8179"\w* de \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* en \w el|strong="H3605"\w* \w día|strong="H3117"\w* de reposo, sino \w que|strong="H1115"\w* \w santifican|strong="H6942"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* de reposo y \w no|strong="H6213"\w* \w hacen|strong="H6213"\w* en \w él|strong="H3605"\w* \w ningún|strong="H3605"\w* trabajo,  
\v 25 entonces entrarán \w por|strong="H5921"\w* \w las|strong="H1992"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w reyes|strong="H4428"\w* \w y|strong="H5921"\w* \w príncipes|strong="H8269"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* sientan \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*. Vendrán \w en|strong="H5921"\w* \w carros|strong="H7393"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w caballo|strong="H5483"\w*, \w ellos|strong="H1992"\w* \w y|strong="H5921"\w* \w sus|strong="H1992"\w* \w jefes|strong="H8269"\w*, \w los|strong="H1992"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén; \w y|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* será \w habitada|strong="H3427"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*.  
\v 26 Vendrán \w de|strong="H4480"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* y \w de|strong="H4480"\w* los \w alrededores|strong="H5439"\w* \w de|strong="H4480"\w* Jerusalén, \w de|strong="H4480"\w* la tierra \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*, \w de|strong="H4480"\w* la llanura, \w de|strong="H4480"\w* las montañas y \w del|strong="H4480"\w* sur, trayendo \w holocaustos|strong="H5930"\w*, \w sacrificios|strong="H2077"\w*, ofrendas y perfume, y trayendo \w sacrificios|strong="H2077"\w* \w de|strong="H4480"\w* gratitud \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé.  
\v 27 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* me \w obedecen|strong="H8085"\w* para santificar el \w día|strong="H3117"\w* de reposo, y para \w no|strong="H3808"\w* cargar \w nada|strong="H3808"\w* al entrar por las \w puertas|strong="H8179"\w* de Jerusalén en el \w día|strong="H3117"\w* de reposo, \w entonces|strong="H3117"\w* prenderé fuego \w a|strong="H3068"\w* sus \w puertas|strong="H8179"\w*, el cual consumirá los palacios de Jerusalén y \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w apagará|strong="H3518"\w*’”.   
\c 18  
\p
\v 1 \w Palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé dirigió \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 2 “\w Levántate|strong="H6965"\w* y \w baja|strong="H3381"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* del alfarero, y \w allí|strong="H8033"\w* te daré mi mensaje”.   
\p
\v 3 \w Yo|strong="H2009"\w* bajé \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w del|strong="H5921"\w* alfarero, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* encontré trabajando \w en|strong="H5921"\w* \w el|strong="H5921"\w* torno.  
\v 4 \w La|strong="H1931"\w* \w vasija|strong="H3627"\w* \w de|strong="H5869"\w* \w barro|strong="H2563"\w* \w que|strong="H1931"\w* estaba \w haciendo|strong="H6213"\w* \w le|strong="H1931"\w* salió mal, \w así|strong="H1931"\w* \w que|strong="H1931"\w* con \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* \w barro|strong="H2563"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w otra|strong="H6213"\w*, según \w su|strong="H1931"\w* propio diseño.   
\p
\v 5 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*:  
\v 6 “Pueblo de \w Israel|strong="H3478"\w*, ¿acaso \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* \w hacer|strong="H6213"\w* con ustedes \w lo|strong="H2088"\w* mismo \w que|strong="H3808"\w* \w hace|strong="H6213"\w* \w este|strong="H2088"\w* alfarero? — \w dice|strong="H5002"\w* Yahvé —. Ustedes, pueblo de \w Israel|strong="H3478"\w*, \w son|strong="H3808"\w* en \w mi|strong="H2009"\w* \w mano|strong="H3027"\w* \w como|strong="H3651"\w* \w el|strong="H6213"\w* \w barro|strong="H2563"\w* en la \w mano|strong="H3027"\w* del alfarero.  
\v 7 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w momento|strong="H7281"\w* \w que|strong="H5921"\w* yo decida \w que|strong="H5921"\w* una \w nación|strong="H1471"\w* \w o|strong="H3068"\w* un \w reino|strong="H4467"\w* sea arrancado, derribado \w o|strong="H3068"\w* destruido,  
\v 8 \w si|strong="H1931"\w* \w esa|strong="H1931"\w* \w nación|strong="H1471"\w* \w se|strong="H1931"\w* arrepiente \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w maldad|strong="H7451"\w*, \w yo|strong="H6213"\w* \w también|strong="H2803"\w* desistiré \w del|strong="H5921"\w* \w castigo|strong="H7451"\w* \w que|strong="H1931"\w* \w pensaba|strong="H2803"\w* lanzarle.  
\v 9 \w Y|strong="H3068"\w* \w si|strong="H5921"\w* \w en|strong="H5921"\w* otro \w momento|strong="H7281"\w* decido \w que|strong="H5921"\w* una \w nación|strong="H1471"\w* \w o|strong="H3068"\w* un \w reino|strong="H4467"\w* sea construido \w y|strong="H5921"\w* \w plantado|strong="H5193"\w*,  
\v 10 pero \w ellos|strong="H5921"\w* \w hacen|strong="H6213"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* ofende \w y|strong="H5921"\w* \w no|strong="H6213"\w* \w me|strong="H5921"\w* \w obedecen|strong="H8085"\w*, entonces \w yo|strong="H6213"\w* \w no|strong="H6213"\w* \w les|strong="H5921"\w* enviaré \w el|strong="H5921"\w* \w bien|strong="H2896"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* \w había|strong="H6213"\w* prometido.   
\p
\v 11 “\w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H5921"\w*, diles \w ahora|strong="H6258"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H6258"\w* viven \w en|strong="H5921"\w* Jerusalén: ‘\w Así|strong="H3541"\w* dice Yahvé: Miren, \w yo|strong="H2009"\w* estoy preparando un desastre \w contra|strong="H5921"\w* ustedes \w y|strong="H5921"\w* trazando un plan \w en|strong="H5921"\w* su \w contra|strong="H5921"\w*. ¡\w Vuelvan|strong="H7725"\w* \w ya|strong="H6258"\w* \w de|strong="H5921"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*! Mejoren su conducta \w y|strong="H5921"\w* sus acciones’.  
\v 12 \w Pero|strong="H3588"\w* ellos responderán: ‘¡\w No|strong="H6213"\w* pierdas \w el|strong="H3588"\w* tiempo! Nosotros \w seguiremos|strong="H6213"\w* nuestros propios planes; cada uno \w de|strong="H3588"\w* nosotros \w hará|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* le dicte \w su|strong="H3588"\w* terco \w y|strong="H3588"\w* \w malvado|strong="H7451"\w* \w corazón|strong="H3820"\w*’”.   
\p
\v 13 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé:  
\q1 “Pregunten entre las \w naciones|strong="H1471"\w*:  
\q2 ¿\w quién|strong="H4310"\w* \w ha|strong="H3541"\w* \w oído|strong="H8085"\w* algo \w semejante|strong="H3651"\w*?  
\q2 ¡\w Es|strong="H3541"\w* algo horrible \w lo|strong="H6213"\w* \w que|strong="H4310"\w* \w ha|strong="H3541"\w* \w hecho|strong="H6213"\w* la \w virgen|strong="H1330"\w* de \w Israel|strong="H3478"\w*!   
\q1
\v 14 ¿Acaso falta la nieve del \w Líbano|strong="H3844"\w* en las rocas del \w campo|strong="H7704"\w*?  
\q2 ¿Se agotan las \w aguas|strong="H4325"\w* frescas \w que|strong="H4325"\w* fluyen \w de|strong="H4325"\w* lejos?   
\q1
\v 15 \w Sin|strong="H3808"\w* embargo, mi \w pueblo|strong="H5971"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* olvidado  
\q2 \w y|strong="H3588"\w* ofrece incienso \w a|strong="H3068"\w* dioses \w inútiles|strong="H3808"\w*.  
\q1 \w Tropezaron|strong="H3782"\w* \w en|strong="H3588"\w* sus \w caminos|strong="H1870"\w*,  
\q2 \w en|strong="H3588"\w* las sendas \w antiguas|strong="H5769"\w*,  
\q2 \w para|strong="H3588"\w* irse \w por|strong="H3588"\w* \w veredas|strong="H5410"\w* \w y|strong="H3588"\w* \w caminos|strong="H1870"\w* \w sin|strong="H3808"\w* pavimentar.   
\q1
\v 16 Convirtieron su tierra \w en|strong="H5921"\w* algo espantoso,  
\q2 \w en|strong="H5921"\w* motivo \w de|strong="H5921"\w* burla \w eterna|strong="H5769"\w*.  
\q1 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w pase|strong="H5674"\w* \w por|strong="H5921"\w* allí \w se|strong="H5921"\w* quedará aterrado  
\q2 \w y|strong="H5921"\w* sacudirá \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*.   
\q1
\v 17 Como con un \w viento|strong="H7307"\w* del este, los dispersaré frente al enemigo.  
\q2 Les daré la espalda y \w no|strong="H3808"\w* la \w cara|strong="H6440"\w*  
\q2 en el \w día|strong="H3117"\w* \w de|strong="H6440"\w* su perdición”.   
\p
\v 18 \w Entonces|strong="H3588"\w* \w dijeron|strong="H1697"\w*: “¡Vengan! Hagamos planes \w contra|strong="H5921"\w* \w Jeremías|strong="H3414"\w*; \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w nos|strong="H5921"\w* faltará \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w que|strong="H3588"\w* \w nos|strong="H5921"\w* enseñe \w la|strong="H5921"\w* \w ley|strong="H8451"\w*, \w ni|strong="H3808"\w* \w el|strong="H5921"\w* \w sabio|strong="H2450"\w* \w que|strong="H3588"\w* \w nos|strong="H5921"\w* \w dé|strong="H5921"\w* \w consejos|strong="H6098"\w*, \w ni|strong="H3808"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w que|strong="H3588"\w* \w nos|strong="H5921"\w* traiga \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Dios. ¡Vengan! Ataquémoslo \w con|strong="H5921"\w* sus propias \w palabras|strong="H1697"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* hagamos caso \w a|strong="H3068"\w* \w nada|strong="H3808"\w* \w de|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* diga”.   
\q1
\v 19 ¡\w Escúchame|strong="H8085"\w*, Yahvé!  
\q2 ¡Presta atención \w a|strong="H3068"\w* lo que dicen mis enemigos!   
\q1
\v 20 ¿Acaso \w se|strong="H5921"\w* \w paga|strong="H7999"\w* \w el|strong="H5921"\w* \w bien|strong="H2896"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w mal|strong="H7451"\w*?  
\q2 ¡\w Pues|strong="H3588"\w* \w ellos|strong="H1992"\w* han cavado una fosa \w para|strong="H5921"\w* quitarme \w la|strong="H5921"\w* \w vida|strong="H5315"\w*!  
\q1 Recuerda \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w me|strong="H5921"\w* presenté \w ante|strong="H6440"\w* \w ti|strong="H5921"\w* \w para|strong="H5921"\w* interceder \w por|strong="H5921"\w* \w ellos|strong="H1992"\w*,  
\q2 \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* descargaras tu \w enojo|strong="H2534"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w*.   
\q1
\v 21 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, ¡\w entrega|strong="H5414"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w al|strong="H5921"\w* \w hambre|strong="H7458"\w*  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* mueran \w a|strong="H3068"\w* punta \w de|strong="H5921"\w* \w espada|strong="H2719"\w*!  
\q1 ¡\w Que|strong="H5921"\w* sus esposas \w se|strong="H1961"\w* queden viudas \w y|strong="H5921"\w* sin \w hijos|strong="H1121"\w*!  
\q2 ¡\w Que|strong="H5921"\w* sus \w hombres|strong="H1121"\w* mueran asesinados  
\q2 \w y|strong="H5921"\w* sus jóvenes caigan \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*!   
\q1
\v 22 ¡\w Que|strong="H3588"\w* \w se|strong="H5921"\w* \w oigan|strong="H8085"\w* \w gritos|strong="H2201"\w* \w de|strong="H5921"\w* terror \w en|strong="H5921"\w* sus \w casas|strong="H1004"\w*  
\q2 \w cuando|strong="H3588"\w* mandes \w de|strong="H5921"\w* repente un \w ejército|strong="H1416"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*!  
\q1 \w Porque|strong="H3588"\w* \w cavaron|strong="H3738"\w* una fosa \w para|strong="H5921"\w* atraparme  
\q2 \w y|strong="H3588"\w* \w escondieron|strong="H2934"\w* trampas \w para|strong="H5921"\w* mis \w pies|strong="H7272"\w*.   
\q1
\v 23 Pero \w tú|strong="H6213"\w*, Yahvé, \w conoces|strong="H3045"\w* bien sus planes \w para|strong="H5921"\w* matarme.  
\q2 ¡\w No|strong="H6213"\w* \w les|strong="H5921"\w* \w perdones|strong="H3722"\w* su \w maldad|strong="H5771"\w*  
\q2 ni \w borres|strong="H4229"\w* su \w pecado|strong="H2403"\w* \w de|strong="H5921"\w* \w tu|strong="H6213"\w* vista!  
\q1 ¡\w Haz|strong="H6213"\w* \w que|strong="H5921"\w* caigan derrotados \w ante|strong="H6440"\w* \w ti|strong="H5921"\w*!  
\q2 ¡Castígalos \w mientras|strong="H3605"\w* \w estés|strong="H1961"\w* enojado!   
\c 19  
\p
\v 1 \w Así|strong="H3541"\w* dijo Yahvé: “\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* \w compra|strong="H7069"\w* una vasija \w de|strong="H5971"\w* barro \w de|strong="H5971"\w* alfarero. Lleva \w contigo|strong="H5971"\w* \w a|strong="H3068"\w* algunos \w de|strong="H5971"\w* los \w ancianos|strong="H2205"\w* del \w pueblo|strong="H5971"\w* \w y|strong="H3541"\w* \w de|strong="H5971"\w* los líderes \w de|strong="H5971"\w* los \w sacerdotes|strong="H3548"\w*,  
\v 2 y \w sal|strong="H3318"\w* al \w valle|strong="H1516"\w* \w de|strong="H1121"\w* Ben-Hinom, \w que|strong="H1697"\w* \w está|strong="H8033"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la \w puerta|strong="H6607"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* Tiestos, y proclama \w allí|strong="H8033"\w* \w el|strong="H1121"\w* mensaje \w que|strong="H1697"\w* yo te comunicaré.  
\v 3 \w Diles|strong="H1697"\w*: ‘\w Escuchen|strong="H8085"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé, \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén. \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ¡Miren! Voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* una desgracia \w tal|strong="H2088"\w*, \w que|strong="H5921"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* \w oiga|strong="H8085"\w* \w le|strong="H5921"\w* zumbarán \w los|strong="H3427"\w* \w oídos|strong="H8085"\w*.  
\v 4 \w Porque|strong="H3282"\w* ustedes me abandonaron \w y|strong="H5355"\w* profanaron \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*. Ofrecieron incienso \w a|strong="H3068"\w* dioses extraños \w que|strong="H3808"\w* \w ni|strong="H3808"\w* ustedes, \w ni|strong="H3808"\w* \w sus|strong="H1992"\w* antepasados \w ni|strong="H3808"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H1818"\w* \w Judá|strong="H3063"\w* \w conocían|strong="H3045"\w*, \w y|strong="H5355"\w* \w llenaron|strong="H4390"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* con \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* gente \w inocente|strong="H5355"\w*.  
\v 5 Construyeron santuarios paganos \w para|strong="H5921"\w* \w Baal|strong="H1168"\w*, \w para|strong="H5921"\w* quemar \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* fuego \w como|strong="H5921"\w* \w holocaustos|strong="H5930"\w*; algo \w que|strong="H3808"\w* \w yo|strong="H6680"\w* \w nunca|strong="H3808"\w* \w les|strong="H5921"\w* \w mandé|strong="H6680"\w* \w ni|strong="H3808"\w* \w les|strong="H5921"\w* \w dije|strong="H1696"\w*, \w y|strong="H5921"\w* \w que|strong="H3808"\w* \w jamás|strong="H3808"\w* \w me|strong="H5921"\w* pasó \w por|strong="H5921"\w* \w la|strong="H5921"\w* mente.  
\v 6 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H3588"\w* \w que|strong="H3588"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w ya|strong="H2088"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w llamará|strong="H7121"\w* Tofet \w ni|strong="H3808"\w* \w valle|strong="H1516"\w* \w de|strong="H3588"\w* Ben-Hinom, \w sino|strong="H3588"\w* \w Valle|strong="H1516"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* Matanza.   
\p
\v 7 “‘En \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* frustraré los planes \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* y \w de|strong="H6440"\w* Jerusalén. \w Haré|strong="H5414"\w* \w que|strong="H2088"\w* \w caigan|strong="H5307"\w* \w a|strong="H3068"\w* punta \w de|strong="H6440"\w* \w espada|strong="H2719"\w* frente \w a|strong="H3068"\w* sus enemigos y \w a|strong="H3068"\w* \w manos|strong="H3027"\w* \w de|strong="H6440"\w* los \w que|strong="H2088"\w* quieren matarlos. Dejaré sus cadáveres como \w comida|strong="H3978"\w* \w para|strong="H5414"\w* las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w* y las fieras \w de|strong="H6440"\w* la tierra.  
\v 8 Convertiré \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w en|strong="H5921"\w* un lugar \w de|strong="H5921"\w* horror \w y|strong="H5921"\w* \w de|strong="H5921"\w* burla. \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w pase|strong="H5674"\w* \w por|strong="H5921"\w* aquí \w se|strong="H5921"\w* quedará aterrado \w y|strong="H5921"\w* \w se|strong="H5921"\w* burlará \w al|strong="H5921"\w* ver \w todas|strong="H3605"\w* sus \w heridas|strong="H4347"\w*.  
\v 9 Haré \w que|strong="H1121"\w* se coman la \w carne|strong="H1320"\w* \w de|strong="H1121"\w* sus propios \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*; se comerán unos \w a|strong="H3068"\w* otros por la desesperación del asedio y la angustia \w que|strong="H1121"\w* les causarán sus enemigos y \w los|strong="H1121"\w* \w que|strong="H1121"\w* \w buscan|strong="H1245"\w* matarlos’.   
\p
\v 10 “Luego romperás la vasija \w a|strong="H3068"\w* la vista \w de|strong="H5869"\w* los hombres que \w te|strong="H5869"\w* acompañan,  
\v 11 \w y|strong="H3541"\w* les dirás: ‘\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5750"\w* los \w Ejércitos|strong="H6635"\w*: \w De|strong="H5750"\w* \w esta|strong="H2063"\w* misma forma romperé \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3541"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w como|strong="H5750"\w* quien rompe una \w vasija|strong="H3627"\w* \w de|strong="H5750"\w* barro \w que|strong="H3808"\w* \w ya|strong="H2088"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w puede|strong="H3201"\w* reparar. \w Y|strong="H3068"\w* tendrán \w que|strong="H3808"\w* enterrar \w a|strong="H3068"\w* los muertos \w en|strong="H6912"\w* Tofet \w hasta|strong="H2088"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* quede \w más|strong="H5750"\w* espacio.  
\v 12 \w Eso|strong="H3651"\w* \w es|strong="H2088"\w* \w lo|strong="H2088"\w* \w que|strong="H2088"\w* \w haré|strong="H6213"\w* con \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* y con sus \w habitantes|strong="H3427"\w* — \w dice|strong="H5002"\w* Yahvé —; dejaré \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w como|strong="H3651"\w* \w a|strong="H3068"\w* Tofet.  
\v 13 \w Las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w* \w los|strong="H5921"\w* palacios \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* quedarán tan impuros \w como|strong="H1961"\w* Tofet, \w porque|strong="H5921"\w* \w en|strong="H5921"\w* sus azoteas ofrecieron incienso \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* estrellas \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* \w derramaron|strong="H5258"\w* \w ofrendas|strong="H5258"\w* \w de|strong="H5921"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* dioses extraños’”.   
\p
\v 14 \w Jeremías|strong="H3414"\w* regresó \w de|strong="H5971"\w* Tofet, \w a|strong="H3068"\w* \w donde|strong="H8033"\w* Yahvé \w lo|strong="H3605"\w* \w había|strong="H5975"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* profetizar, \w se|strong="H5971"\w* \w puso|strong="H5975"\w* \w de|strong="H5971"\w* \w pie|strong="H5975"\w* \w en|strong="H5975"\w* \w el|strong="H3605"\w* \w atrio|strong="H2691"\w* del \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé y le dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*:  
\v 15 “\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘Miren, voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* sus alrededores \w toda|strong="H3605"\w* \w la|strong="H5921"\w* desgracia \w que|strong="H3588"\w* he anunciado \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*, \w porque|strong="H3588"\w* \w se|strong="H5921"\w* han \w puesto|strong="H3588"\w* tercos \w y|strong="H3588"\w* \w no|strong="H3588"\w* han querido \w obedecer|strong="H8085"\w* mis \w palabras|strong="H1697"\w*’”.   
\c 20  
\p
\v 1 \w El|strong="H1931"\w* \w sacerdote|strong="H3548"\w* Pasjur \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Imer, \w que|strong="H1931"\w* \w era|strong="H1931"\w* \w el|strong="H1931"\w* \w jefe|strong="H6496"\w* principal del \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé, \w oyó|strong="H8085"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* profetizar estas \w cosas|strong="H1697"\w*.  
\v 2 Entonces Pasjur mandó golpear \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w puso|strong="H5414"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cepo|strong="H4115"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* superior \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*, \w la|strong="H5921"\w* cual \w estaba|strong="H1004"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 3 \w Al|strong="H4480"\w* día \w siguiente|strong="H4283"\w*, \w cuando|strong="H3588"\w* Pasjur \w sacó|strong="H3318"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w del|strong="H4480"\w* \w cepo|strong="H4115"\w*, \w Jeremías|strong="H3414"\w* le dijo: “Yahvé ya \w no|strong="H3808"\w* \w te|strong="H4480"\w* \w llama|strong="H7121"\w* Pasjur, \w sino|strong="H3588"\w* Magor-misabib\f + \fr 20:3 \ft “Magor-misabib” significa “terror por todas partes”.\f*.  
\v 4 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: ‘\w Te|strong="H5869"\w* voy \w a|strong="H3068"\w* convertir \w en|strong="H3588"\w* un terror \w para|strong="H3588"\w* ti \w mismo|strong="H3605"\w* \w y|strong="H3588"\w* \w para|strong="H3588"\w* \w todos|strong="H3605"\w* tus amigos. \w Ellos|strong="H3027"\w* morirán \w a|strong="H3068"\w* punta \w de|strong="H3588"\w* \w espada|strong="H2719"\w* frente \w a|strong="H3068"\w* sus enemigos, \w y|strong="H3588"\w* tú \w mismo|strong="H3605"\w* \w lo|strong="H3605"\w* \w verás|strong="H7200"\w*. \w Entregaré|strong="H5414"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* \w en|strong="H3588"\w* \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia, \w quien|strong="H3605"\w* \w los|strong="H3605"\w* llevará \w cautivos|strong="H1540"\w* \w a|strong="H3068"\w* Babilonia \w y|strong="H3588"\w* \w los|strong="H3605"\w* matará \w a|strong="H3068"\w* \w espada|strong="H2719"\w*.  
\v 5 \w Entregaré|strong="H5414"\w* también \w todas|strong="H3605"\w* las riquezas \w de|strong="H5414"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, sus ganancias, sus objetos valiosos y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* tesoros \w de|strong="H5414"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus enemigos. \w Ellos|strong="H3027"\w* \w los|strong="H3605"\w* saquearán, \w los|strong="H3605"\w* \w tomarán|strong="H3947"\w* y se \w los|strong="H3605"\w* llevarán \w a|strong="H3068"\w* Babilonia.  
\v 6 \w Y|strong="H3068"\w* tú, Pasjur, y \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w que|strong="H1992"\w* viven \w en|strong="H6912"\w* tu \w casa|strong="H1004"\w* \w irán|strong="H3212"\w* al \w cautiverio|strong="H7628"\w*. Llegarás \w a|strong="H3068"\w* Babilonia y \w allí|strong="H8033"\w* \w morirás|strong="H4191"\w* y serás \w enterrado|strong="H6912"\w*, junto con \w todos|strong="H3605"\w* tus amigos \w a|strong="H3068"\w* quienes \w les|strong="H1992"\w* \w has|strong="H4191"\w* \w profetizado|strong="H5012"\w* \w mentiras|strong="H8267"\w*’”.   
\b  
\q1
\v 7 ¡Me convenciste, Yahvé, y me dejé convencer!  
\q2 \w Fuiste|strong="H1961"\w* más fuerte \w que|strong="H3117"\w* yo y me dominaste.  
\q1 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w soy|strong="H1961"\w* motivo de risa;  
\q2 \w todo|strong="H3605"\w* \w el|strong="H3605"\w* mundo \w se|strong="H1961"\w* burla de \w mí|strong="H1961"\w*.   
\q1
\v 8 \w Cada|strong="H3605"\w* vez \w que|strong="H3588"\w* \w hablo|strong="H1696"\w*, \w tengo|strong="H1696"\w* \w que|strong="H3588"\w* gritar;  
\q2 \w grito|strong="H2199"\w*: “¡\w Violencia|strong="H2555"\w*! ¡\w Destrucción|strong="H7701"\w*!”.  
\q1 \w Por|strong="H3588"\w* eso \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* ha traído  
\q2 insultos \w y|strong="H3588"\w* burlas durante \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w*.   
\q1
\v 9 \w A|strong="H3068"\w* veces digo: “\w No|strong="H3808"\w* me acordaré \w más|strong="H5750"\w* \w de|strong="H5750"\w* él,  
\q2 \w ni|strong="H3808"\w* \w hablaré|strong="H1696"\w* \w más|strong="H5750"\w* \w en|strong="H5750"\w* su \w nombre|strong="H8034"\w*”.  
\q1 Pero entonces tu \w palabra|strong="H1696"\w* \w en|strong="H5750"\w* \w mi|strong="H1961"\w* interior \w se|strong="H1961"\w* vuelve un fuego \w ardiente|strong="H1197"\w*  
\q2 \w que|strong="H3808"\w* me quema hasta \w los|strong="H1961"\w* \w huesos|strong="H6106"\w*.  
\q2 Hago un esfuerzo \w por|strong="H5750"\w* aguantarlo, pero ya \w no|strong="H3808"\w* \w puedo|strong="H3201"\w*.   
\q1
\v 10 He \w oído|strong="H8085"\w* \w a|strong="H3068"\w* \w muchos|strong="H7227"\w* \w decir|strong="H8085"\w* \w con|strong="H4480"\w* desprecio:  
\q2 “¡Miren, ahí viene \w el|strong="H3588"\w* ‘Terror \w por|strong="H3588"\w* \w todas|strong="H3605"\w* \w partes|strong="H5439"\w*’!  
\q2 ¡Denúncienlo! ¡Vamos \w a|strong="H3068"\w* denunciarlo!”.  
\q1 Hasta mis mejores \w amigos|strong="H7227"\w* esperan \w que|strong="H3588"\w* \w yo|strong="H4480"\w* tropiece:  
\q2 “\w A|strong="H3068"\w* \w lo|strong="H3605"\w* mejor \w lo|strong="H3605"\w* \w podemos|strong="H3201"\w* engañar — dicen —,  
\q2 \w y|strong="H3588"\w* \w así|strong="H3588"\w* le ganaremos  
\q2 \w y|strong="H3588"\w* \w nos|strong="H4480"\w* vengaremos \w de|strong="H4480"\w* \w él|strong="H3588"\w*”.   
\q1
\v 11 \w Pero|strong="H3588"\w* Yahvé \w está|strong="H3651"\w* conmigo \w como|strong="H3588"\w* un guerrero invencible.  
\q2 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* mis \w perseguidores|strong="H7291"\w* \w tropezarán|strong="H3782"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* vencerme.  
\q1 Quedarán totalmente avergonzados \w por|strong="H5921"\w* \w su|strong="H3588"\w* fracaso;  
\q2 \w su|strong="H3588"\w* deshonra \w será|strong="H3808"\w* \w eterna|strong="H5769"\w* \w y|strong="H3588"\w* \w nadie|strong="H3808"\w* \w la|strong="H5921"\w* olvidará.   
\q1
\v 12 Yahvé \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*, tú \w que|strong="H3588"\w* examinas \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w justos|strong="H6662"\w*  
\q2 \w y|strong="H3588"\w* conoces \w los|strong="H1992"\w* pensamientos \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w corazón|strong="H3820"\w*,  
\q1 déjame \w ver|strong="H7200"\w* \w cómo|strong="H3588"\w* \w te|strong="H3588"\w* vengas \w de|strong="H3588"\w* \w ellos|strong="H1992"\w*,  
\q2 \w porque|strong="H3588"\w* \w en|strong="H3588"\w* tus manos he \w puesto|strong="H3588"\w* mi defensa.   
\q1
\v 13 ¡Canten \w a|strong="H3068"\w* Yahvé!  
\q2 ¡\w Alaben|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé!  
\q2 \w Porque|strong="H3588"\w* \w él|strong="H3588"\w* rescata al necesitado \w de|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* malvados.   
\q1
\v 14 ¡Maldito \w sea|strong="H1961"\w* el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w nací|strong="H3205"\w*!  
\q2 \w Que|strong="H3117"\w* \w no|strong="H1961"\w* \w sea|strong="H1961"\w* \w bendito|strong="H1288"\w* el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w mi|strong="H1961"\w* madre me dio \w a|strong="H3068"\w* luz.   
\q1
\v 15 ¡Maldito \w el|strong="H1121"\w* \w hombre|strong="H1121"\w* \w que|strong="H1121"\w* le dio la noticia \w a|strong="H3068"\w* mi padre:  
\q2 “¡Te ha \w nacido|strong="H3205"\w* un \w hijo|strong="H1121"\w* \w varón|strong="H2145"\w*!”, y lo llenó \w de|strong="H1121"\w* alegría!   
\q1
\v 16 \w Que|strong="H1931"\w* \w ese|strong="H1931"\w* hombre \w sea|strong="H1961"\w* \w como|strong="H1961"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H1931"\w* Yahvé destruyó  
\q2 \w sin|strong="H3808"\w* tenerles compasión.  
\q1 \w Que|strong="H1931"\w* \w oiga|strong="H8085"\w* \w gritos|strong="H8643"\w* \w de|strong="H6256"\w* auxilio por \w la|strong="H1931"\w* \w mañana|strong="H1242"\w*  
\q2 y \w gritos|strong="H8643"\w* \w de|strong="H6256"\w* guerra \w al|strong="H6256"\w* mediodía,   
\q1
\v 17 \w porque|strong="H3808"\w* \w no|strong="H3808"\w* me \w mató|strong="H4191"\w* antes de \w que|strong="H3808"\w* yo naciera.  
\q2 Así \w mi|strong="H1961"\w* madre habría \w sido|strong="H1961"\w* \w mi|strong="H1961"\w* tumba,  
\q2 y yo me habría quedado \w siempre|strong="H5769"\w* en su vientre.   
\q1
\v 18 ¿Para \w qué|strong="H4100"\w* \w salí|strong="H3318"\w* del vientre materno?  
\q2 ¿Solo para \w ver|strong="H7200"\w* sufrimientos y \w dolor|strong="H5999"\w*,  
\q2 y para terminar mis \w días|strong="H3117"\w* avergonzado?   
\c 21  
\p
\v 1 \w Palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé dirigió \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*, \w cuando|strong="H1961"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w* Sedequías \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w hablar|strong="H1697"\w* con \w él|strong="H1121"\w* \w a|strong="H3068"\w* Pasjur \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Malquías y \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* \w Sofonías|strong="H6846"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Maasías|strong="H4641"\w*, \w para|strong="H1961"\w* decirle:  
\v 2 “\w Por|strong="H5921"\w* favor, consulta \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* \w nosotros|strong="H3605"\w*, \w porque|strong="H3588"\w* \w Nabucodonosor|strong="H5019"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w nos|strong="H5921"\w* \w está|strong="H5921"\w* atacando. Tal vez Yahvé \w haga|strong="H6213"\w* un milagro \w por|strong="H5921"\w* \w nosotros|strong="H3605"\w*, \w como|strong="H3588"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w hacía|strong="H6213"\w* \w antes|strong="H3588"\w*, \w y|strong="H3588"\w* obligue \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* retirarse”.   
\p
\v 3 \w Jeremías|strong="H3414"\w* les respondió: “Digan \w a|strong="H3068"\w* Sedequías lo siguiente:  
\v 4 ‘\w Así|strong="H3541"\w* dice Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: “Miren, voy \w a|strong="H3068"\w* inutilizar \w las|strong="H5921"\w* \w armas|strong="H3627"\w* \w de|strong="H5921"\w* \w guerra|strong="H4421"\w* \w que|strong="H5921"\w* ustedes traen \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* están \w peleando|strong="H3898"\w* \w fuera|strong="H2351"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* murallas \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* tienen rodeados. Yo mismo meteré esas \w armas|strong="H3627"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*.  
\v 5 Yo pelearé contra ustedes con \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* y \w brazo|strong="H2220"\w* \w fuerte|strong="H2389"\w*; los atacaré con toda mi furia, con \w ira|strong="H2534"\w* y con un \w enojo|strong="H2534"\w* terrible.  
\v 6 Castigaré \w a|strong="H3068"\w* \w los|strong="H3427"\w* que viven \w en|strong="H5221"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*; tanto hombres como animales \w morirán|strong="H4191"\w* por una peste espantosa.  
\v 7 \w Después|strong="H5921"\w* \w de|strong="H4480"\w* \w eso|strong="H3651"\w* — \w dice|strong="H5002"\w* Yahvé — \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* sus oficiales \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H4480"\w* haya sobrevivido \w a|strong="H3068"\w* \w la|strong="H5921"\w* peste, \w a|strong="H3068"\w* \w la|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w hambre|strong="H7458"\w*, \w los|strong="H5921"\w* \w entregaré|strong="H5414"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H4480"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia. Caerán \w en|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H4480"\w* sus enemigos \w y|strong="H5921"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w que|strong="H4480"\w* quieren \w matarlos|strong="H5221"\w*. \w Él|strong="H5921"\w* \w los|strong="H5921"\w* matará \w a|strong="H3068"\w* punta \w de|strong="H4480"\w* \w espada|strong="H2719"\w*; \w no|strong="H3808"\w* \w les|strong="H5921"\w* tendrá lástima, \w ni|strong="H3808"\w* perdón \w ni|strong="H3808"\w* compasión”’.   
\p
\v 8 “\w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* dile: ‘\w Así|strong="H3541"\w* dice Yahvé: “Miren, yo \w pongo|strong="H5414"\w* \w ante|strong="H6440"\w* ustedes el \w camino|strong="H1870"\w* \w de|strong="H6440"\w* la \w vida|strong="H2416"\w* \w y|strong="H3541"\w* el \w camino|strong="H1870"\w* \w de|strong="H6440"\w* la \w muerte|strong="H4194"\w*.  
\v 9 \w El|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* \w quede|strong="H1961"\w* \w en|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w morirá|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, \w el|strong="H5921"\w* \w hambre|strong="H7458"\w* \w o|strong="H3068"\w* \w la|strong="H5921"\w* peste. Pero \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w salga|strong="H3318"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* rinda \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w* \w que|strong="H5921"\w* \w los|strong="H3427"\w* \w tienen|strong="H1961"\w* rodeados, salvará su \w vida|strong="H5315"\w* \w y|strong="H5921"\w* podrá escapar.  
\v 10 \w Porque|strong="H3588"\w* he decidido ponerme \w en|strong="H3588"\w* \w contra|strong="H6440"\w* \w de|strong="H3588"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w para|strong="H3588"\w* \w su|strong="H3588"\w* \w mal|strong="H7451"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w para|strong="H3588"\w* \w su|strong="H3588"\w* \w bien|strong="H2896"\w* — \w dice|strong="H5002"\w* Yahvé —. \w Será|strong="H3808"\w* \w entregada|strong="H5414"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia, \w y|strong="H3588"\w* \w él|strong="H3588"\w* le prenderá fuego”’.   
\p
\v 11 “\w A|strong="H3068"\w* la \w familia|strong="H1004"\w* \w real|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, díganles \w lo|strong="H1697"\w* siguiente: ‘\w Escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé:  
\v 12 \w Familia|strong="H1004"\w* \w de|strong="H6440"\w* \w David|strong="H1732"\w*, \w así|strong="H3541"\w* dice Yahvé:  
\q1 “Hagan \w justicia|strong="H4941"\w* cada \w mañana|strong="H1242"\w*  
\q2 \w y|strong="H3541"\w* liberen al explotado del \w poder|strong="H3027"\w* del opresor.  
\q1 \w De|strong="H6440"\w* lo contrario, mi \w enojo|strong="H2534"\w* \w se|strong="H6435"\w* encenderá como un fuego;  
\q2 \w arderá|strong="H1197"\w* \w por|strong="H6440"\w* \w la|strong="H1197"\w* \w maldad|strong="H7455"\w* \w de|strong="H6440"\w* sus acciones  
\q2 \w y|strong="H3541"\w* \w no|strong="H6435"\w* habrá quien lo apague.   
\q1
\v 13 \w Aquí|strong="H2005"\w* estoy \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, ciudad \w que|strong="H4310"\w* reinas \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w valle|strong="H6010"\w*,  
\q2 \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w roca|strong="H6697"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* llanura — \w dice|strong="H5002"\w* Yahvé —.  
\q1 Ustedes dicen: ‘¿\w Quién|strong="H4310"\w* \w se|strong="H5921"\w* atreverá \w a|strong="H3068"\w* atacarnos?’  
\q2 \w o|strong="H3068"\w* ‘¿\w Quién|strong="H4310"\w* podrá entrar \w en|strong="H5921"\w* nuestros refugios?’.   
\q1
\v 14 Yo \w los|strong="H5921"\w* castigaré \w como|strong="H5921"\w* \w se|strong="H5921"\w* merecen sus acciones — \w dice|strong="H5002"\w* Yahvé —.  
\q2 \w Le|strong="H5921"\w* prenderé fuego \w a|strong="H3068"\w* su \w bosque|strong="H3293"\w*  
\q2 \w y|strong="H5921"\w* \w las|strong="H5921"\w* llamas devorarán \w todo|strong="H3605"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*”’”.   
\c 22  
\p
\v 1 \w Así|strong="H3541"\w* \w dijo|strong="H1696"\w* Yahvé: “\w Baja|strong="H3381"\w* \w al|strong="H4428"\w* palacio del \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* \w y|strong="H3541"\w* proclama \w allí|strong="H8033"\w* \w este|strong="H2088"\w* mensaje:  
\v 2 ‘\w Escucha|strong="H8085"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w que|strong="H5921"\w* \w te|strong="H5921"\w* sientas \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*. Escúchenla también tus oficiales \w y|strong="H5921"\w* tu \w pueblo|strong="H5971"\w*, todos \w los|strong="H3427"\w* \w que|strong="H5921"\w* entran \w por|strong="H5921"\w* estas \w puertas|strong="H8179"\w*.  
\v 3 \w Así|strong="H3541"\w* dice Yahvé: “Practiquen \w el|strong="H6213"\w* \w derecho|strong="H4941"\w* \w y|strong="H3541"\w* la \w justicia|strong="H6666"\w*. Libren al explotado del \w poder|strong="H3027"\w* del opresor. \w No|strong="H6213"\w* maltraten \w ni|strong="H5355"\w* traten con violencia al \w extranjero|strong="H1616"\w*, al \w huérfano|strong="H3490"\w* \w o|strong="H3068"\w* \w a|strong="H3068"\w* la viuda. \w No|strong="H6213"\w* derramen \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w* \w en|strong="H5355"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 4 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* ustedes \w de|strong="H5921"\w* veras cumplen \w estas|strong="H2088"\w* órdenes, \w entonces|strong="H3588"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w que|strong="H3588"\w* ocupan \w el|strong="H1931"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* seguirán entrando \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w este|strong="H2088"\w* palacio, \w montados|strong="H7393"\w* \w en|strong="H5921"\w* \w carros|strong="H7393"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w caballo|strong="H5483"\w*, acompañados \w de|strong="H5921"\w* \w sus|strong="H1931"\w* oficiales \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 5 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3808"\w* \w obedecen|strong="H8085"\w* \w estas|strong="H2088"\w* \w palabras|strong="H1697"\w*, \w juro|strong="H7650"\w* \w por|strong="H3588"\w* \w mí|strong="H1961"\w* mismo — \w dice|strong="H5002"\w* Yahvé — \w que|strong="H3588"\w* \w este|strong="H2088"\w* palacio \w quedará|strong="H1961"\w* convertido \w en|strong="H3588"\w* ruinas”’”.   
\p
\v 6 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w del|strong="H5921"\w* palacio \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*:  
\q1 “Tú eres \w para|strong="H5921"\w* \w mí|strong="H5921"\w* \w como|strong="H3588"\w* \w Galaad|strong="H1568"\w*,  
\q2 \w como|strong="H3588"\w* \w la|strong="H5921"\w* \w cumbre|strong="H7218"\w* \w del|strong="H5921"\w* \w Líbano|strong="H3844"\w*;  
\q1 \w pero|strong="H3588"\w* \w te|strong="H5921"\w* juro \w que|strong="H3588"\w* \w te|strong="H5921"\w* convertiré \w en|strong="H5921"\w* un \w desierto|strong="H4057"\w*,  
\q2 \w en|strong="H5921"\w* una \w ciudad|strong="H5892"\w* \w donde|strong="H5921"\w* \w nadie|strong="H3808"\w* viva.   
\q1
\v 7 Voy \w a|strong="H3068"\w* preparar destructores \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*,  
\q2 cada uno \w con|strong="H5921"\w* sus herramientas;  
\q1 talarán tus cedros \w más|strong="H5921"\w* hermosos  
\q2 \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w echarán|strong="H5307"\w* \w al|strong="H5921"\w* fuego.   
\p
\v 8 “\w Gente|strong="H1471"\w* \w de|strong="H5921"\w* \w muchas|strong="H7227"\w* \w naciones|strong="H1471"\w* \w pasará|strong="H5674"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* preguntarán unos \w a|strong="H3068"\w* otros: ‘¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* Yahvé \w le|strong="H5921"\w* \w hizo|strong="H6213"\w* \w esto|strong="H2063"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w gran|strong="H1419"\w* \w ciudad|strong="H5892"\w*?’.  
\v 9 \w Y|strong="H3068"\w* \w la|strong="H5921"\w* respuesta será: ‘\w Porque|strong="H5921"\w* abandonaron \w el|strong="H5921"\w* \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w*; \w adoraron|strong="H7812"\w* \w a|strong="H3068"\w* otros dioses \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w sirvieron|strong="H5647"\w*’”.   
\q1
\v 10 \w No|strong="H3808"\w* \w lloren|strong="H1058"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* rey \w que|strong="H3588"\w* \w murió|strong="H4191"\w*,  
\q2 \w ni|strong="H3808"\w* \w se|strong="H3808"\w* lamenten \w por|strong="H3588"\w* \w él|strong="H3588"\w*;  
\q1 \w más|strong="H5750"\w* \w bien|strong="H3588"\w*, \w lloren|strong="H1058"\w* \w amargamente|strong="H1058"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* llevan al destierro,  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w volverá|strong="H7725"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w*,  
\q2 \w ni|strong="H3808"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w la|strong="H3588"\w* tierra donde nació.   
\m
\v 11 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé acerca \w de|strong="H4480"\w* Salum \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w que|strong="H3588"\w* \w reinó|strong="H4427"\w* \w en|strong="H4480"\w* \w lugar|strong="H4725"\w* \w de|strong="H4480"\w* \w su|strong="H3588"\w* padre \w Josías|strong="H2977"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w fue|strong="H3063"\w* \w sacado|strong="H3318"\w* \w de|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*: “\w No|strong="H3808"\w* \w volverá|strong="H7725"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w*.  
\v 12 \w Morirá|strong="H4191"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w lo|strong="H3808"\w* llevaron cautivo, \w y|strong="H3588"\w* \w no|strong="H3808"\w* volverá \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w esta|strong="H2063"\w* tierra”.   
\q1
\v 13 “¡\w Ay|strong="H1945"\w* del \w que|strong="H3808"\w* construye su \w casa|strong="H1004"\w* con injusticias  
\q2 y sus habitaciones con falta \w de|strong="H5414"\w* \w derecho|strong="H4941"\w*!  
\q1 El \w que|strong="H3808"\w* hace trabajar \w a|strong="H3068"\w* su \w prójimo|strong="H7453"\w* gratis,  
\q2 y \w no|strong="H3808"\w* le paga su sueldo;   
\q1
\v 14 el que dice: ‘Me voy \w a|strong="H3068"\w* construir una mansión amplia, con habitaciones espaciosas’;  
\q2 le pone \w ventanas|strong="H2474"\w* grandes,  
\q1 la recubre con madera de cedro  
\q2 y la pinta de rojo.   
\b  
\q1
\v 15 “¿Acaso crees \w que|strong="H3588"\w* eres \w más|strong="H3588"\w* \w rey|strong="H4427"\w* \w porque|strong="H3588"\w* usas \w más|strong="H3588"\w* cedro \w que|strong="H3588"\w* \w los|strong="H3588"\w* demás?  
\q2 \w Tu|strong="H6213"\w* padre \w tuvo|strong="H6213"\w* comida \w y|strong="H3588"\w* bebida,  
\q2 \w pero|strong="H3588"\w* también practicó \w la|strong="H3588"\w* \w justicia|strong="H6666"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w derecho|strong="H4941"\w*,  
\q2 \w y|strong="H3588"\w* \w por|strong="H3588"\w* eso le \w fue|strong="H3808"\w* \w bien|strong="H2896"\w*.   
\q1
\v 16 \w Él|strong="H1931"\w* defendió \w la|strong="H1931"\w* \w causa|strong="H1779"\w* del \w pobre|strong="H6041"\w* y del necesitado,  
\q2 y por \w eso|strong="H1931"\w* todo marchaba \w bien|strong="H2896"\w*.  
\q1 ¿\w No|strong="H3808"\w* \w es|strong="H1931"\w* \w eso|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* significa conocerme?”  
\q2 \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 17 “\w Pero|strong="H3588"\w* \w tú|strong="H6213"\w* solo tienes \w ojos|strong="H5869"\w* \w y|strong="H3588"\w* \w corazón|strong="H3820"\w* \w para|strong="H5921"\w* \w tu|strong="H6213"\w* \w avaricia|strong="H1215"\w*,  
\q2 \w para|strong="H5921"\w* derramar \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w*,  
\q2 \w para|strong="H5921"\w* oprimir \w y|strong="H3588"\w* \w para|strong="H5921"\w* actuar \w con|strong="H5921"\w* \w violencia|strong="H6233"\w*”.   
\m
\v 18 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé acerca \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*:  
\q1 “\w Nadie|strong="H3808"\w* llorará \w por|strong="H3651"\w* \w él|strong="H1121"\w*,  
\q2 diciendo: ‘¡\w Ay|strong="H1945"\w*, mi hermano!’ \w o|strong="H3068"\w* ‘¡\w Ay|strong="H1945"\w*, mi hermana!’.  
\q1 \w Nadie|strong="H3808"\w* \w se|strong="H3808"\w* \w lamentará|strong="H5594"\w* \w por|strong="H3651"\w* \w él|strong="H1121"\w*,  
\q2 diciendo: ‘¡\w Ay|strong="H1945"\w*, \w señor|strong="H3068"\w*!’ \w o|strong="H3068"\w* ‘¡\w Ay|strong="H1945"\w*, su majestad!’.   
\q1
\v 19 Tendrá el entierro de un burro:  
\q2 lo arrastrarán y lo \w echarán|strong="H7993"\w* fuera de las \w puertas|strong="H8179"\w* de Jerusalén”.   
\b  
\q1
\v 20 “¡\w Sube|strong="H5927"\w* al \w Líbano|strong="H3844"\w* \w y|strong="H3588"\w* \w grita|strong="H6963"\w*!  
\q2 ¡Eleva tu \w voz|strong="H6963"\w* \w en|strong="H3588"\w* \w Basán|strong="H1316"\w*!  
\q1 ¡\w Grita|strong="H6963"\w* desde \w Abarim|strong="H5682"\w*,  
\q2 \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* tus amantes han sido destruidos!   
\q1
\v 21 \w Yo|strong="H3588"\w* \w te|strong="H3588"\w* \w hablé|strong="H1696"\w* \w cuando|strong="H3588"\w* estabas \w en|strong="H3588"\w* prosperidad,  
\q2 \w pero|strong="H3588"\w* \w dijiste|strong="H1696"\w*: ‘\w No|strong="H3808"\w* quiero \w escuchar|strong="H8085"\w*’.  
\q1 \w Así|strong="H2088"\w* \w te|strong="H3588"\w* has portado desde tu \w juventud|strong="H5271"\w*:  
\q2 ¡\w nunca|strong="H3808"\w* has querido \w obedecerme|strong="H8085"\w*!   
\q1
\v 22 \w El|strong="H3588"\w* \w viento|strong="H7307"\w* dispersará \w a|strong="H3068"\w* \w todos|strong="H3605"\w* tus gobernantes,  
\q2 \w y|strong="H3588"\w* tus amantes \w irán|strong="H3212"\w* al \w cautiverio|strong="H7628"\w*.  
\q1 \w Entonces|strong="H3588"\w* quedarás avergonzada  
\q2 \w y|strong="H3588"\w* humillada \w por|strong="H3588"\w* \w toda|strong="H3605"\w* tu \w maldad|strong="H7451"\w*.   
\q1
\v 23 Tú, \w que|strong="H4100"\w* vives en \w el|strong="H3427"\w* \w Líbano|strong="H3844"\w*  
\q2 y tienes tu nido entre \w los|strong="H3427"\w* cedros,  
\q1 ¡\w cómo|strong="H4100"\w* vas \w a|strong="H3068"\w* gemir \w cuando|strong="H4100"\w* te lleguen \w los|strong="H3427"\w* \w dolores|strong="H2256"\w*,  
\q2 \w dolores|strong="H2256"\w* \w como|strong="H4100"\w* de una mujer de parto!   
\p
\v 24 “¡Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w vivo|strong="H2416"\w*! — \w dice|strong="H5002"\w* Yahvé —. \w Aunque|strong="H3588"\w* \w Conías|strong="H3659"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w fuera|strong="H1961"\w* \w el|strong="H5921"\w* anillo \w de|strong="H5921"\w* sello \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w derecha|strong="H3225"\w*, \w de|strong="H5921"\w* \w allí|strong="H8033"\w* \w lo|strong="H5921"\w* arrancaría.  
\v 25 \w Te|strong="H5315"\w* \w entregaré|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* los \w que|strong="H3027"\w* quieren \w matarte|strong="H5315"\w* y \w de|strong="H6440"\w* aquellos \w a|strong="H3068"\w* quienes tanto \w temes|strong="H3016"\w*: en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Babilonia, y en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* los \w caldeos|strong="H3778"\w*.  
\v 26 \w A|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* madre \w que|strong="H3808"\w* \w te|strong="H5921"\w* dio \w a|strong="H3068"\w* luz \w los|strong="H5921"\w* arrojaré \w a|strong="H3068"\w* otro país \w donde|strong="H8033"\w* \w no|strong="H3808"\w* \w nacieron|strong="H3205"\w*, \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w morirán|strong="H4191"\w*.  
\v 27 \w Jamás|strong="H3808"\w* \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w que|strong="H3808"\w* \w tanto|strong="H5921"\w* desean regresar”.   
\q1
\v 28 ¿\w Es|strong="H1931"\w* \w este|strong="H2088"\w* hombre, \w Conías|strong="H3659"\w*, un objeto despreciable \w y|strong="H5921"\w* roto?  
\q2 ¿\w Es|strong="H1931"\w* un recipiente \w que|strong="H1931"\w* \w nadie|strong="H3808"\w* quiere?  
\q1 ¿\w Por|strong="H5921"\w* \w qué|strong="H1931"\w* han sido expulsados \w él|strong="H1931"\w* \w y|strong="H5921"\w* \w su|strong="H1931"\w* \w descendencia|strong="H2233"\w*,  
\q2 \w y|strong="H5921"\w* arrojados \w a|strong="H3068"\w* una tierra \w que|strong="H1931"\w* \w no|strong="H3808"\w* \w conocen|strong="H3045"\w*?   
\q1
\v 29 ¡Tierra, tierra, tierra!  
\q2 ¡\w Escucha|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé!   
\q1
\v 30 \w Así|strong="H3541"\w* dice Yahvé:  
\q2 “Anoten \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w hombre|strong="H1397"\w* \w como|strong="H3588"\w* alguien \w que|strong="H3588"\w* \w no|strong="H3808"\w* tuvo \w hijos|strong="H2233"\w*,  
\q2 \w como|strong="H3588"\w* un \w hombre|strong="H1397"\w* \w que|strong="H3588"\w* fracasó \w en|strong="H5921"\w* \w su|strong="H3588"\w* \w vida|strong="H3117"\w*;  
\q1 \w porque|strong="H3588"\w* \w nadie|strong="H3808"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w descendencia|strong="H2233"\w* logrará  
\q2 sentarse \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*  
\q2 \w ni|strong="H3808"\w* gobernar \w jamás|strong="H5750"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*”.   
\c 23  
\p
\v 1 “¡\w Ay|strong="H1945"\w* de los \w pastores|strong="H7462"\w* que destruyen y dispersan \w a|strong="H3068"\w* las \w ovejas|strong="H6629"\w* de mi \w rebaño|strong="H6629"\w*!”, \w dice|strong="H5002"\w* Yahvé.  
\v 2 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w pastores|strong="H7462"\w* \w que|strong="H3808"\w* guían \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*: “Ustedes han dispersado \w a|strong="H3068"\w* mis \w ovejas|strong="H6629"\w*, \w las|strong="H5921"\w* han espantado \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w las|strong="H5921"\w* han cuidado. ¡\w Pues|strong="H3651"\w* miren, \w ahora|strong="H3541"\w* yo \w les|strong="H5921"\w* voy \w a|strong="H3068"\w* pedir cuentas \w por|strong="H5921"\w* sus malas acciones!”, \w dice|strong="H5002"\w* Yahvé.  
\v 3 “Yo \w mismo|strong="H3605"\w* reuniré \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* queden \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w rebaño|strong="H6629"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* países \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w los|strong="H5921"\w* expulsé, \w y|strong="H5921"\w* \w los|strong="H5921"\w* haré \w volver|strong="H7725"\w* \w a|strong="H3068"\w* sus praderas, \w donde|strong="H8033"\w* tendrán crías \w y|strong="H5921"\w* \w se|strong="H5921"\w* multiplicarán.  
\v 4 Pondré \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w pastores|strong="H7462"\w* \w que|strong="H3808"\w* \w de|strong="H5921"\w* verdad \w los|strong="H5921"\w* cuiden; ya \w no|strong="H3808"\w* tendrán \w miedo|strong="H3372"\w* \w ni|strong="H3808"\w* \w se|strong="H5921"\w* asustarán, \w y|strong="H5921"\w* \w ninguna|strong="H3808"\w* oveja \w se|strong="H5921"\w* volverá \w a|strong="H3068"\w* perder”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 5 “Vienen \w días|strong="H3117"\w*”, \w dice|strong="H5002"\w* Yahvé,  
\q2 “en \w que|strong="H3117"\w* le daré \w a|strong="H3068"\w* \w David|strong="H1732"\w* un \w renuevo|strong="H6780"\w* \w justo|strong="H6662"\w*;  
\q1 \w él|strong="H6213"\w* \w reinará|strong="H4427"\w* con sabiduría como un verdadero \w rey|strong="H4428"\w*,  
\q2 y practicará \w el|strong="H6213"\w* \w derecho|strong="H4941"\w* y la \w justicia|strong="H6666"\w* en \w el|strong="H6213"\w* país.   
\q1
\v 6 En sus \w días|strong="H3117"\w*, \w Judá|strong="H3063"\w* estará \w a|strong="H3068"\w* \w salvo|strong="H3467"\w*  
\q2 \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* vivirá confiado.  
\q1 \w Y|strong="H3068"\w* \w este|strong="H2088"\w* \w es|strong="H2088"\w* el \w nombre|strong="H8034"\w* con el \w que|strong="H3117"\w* \w lo|strong="H2088"\w* \w llamarán|strong="H7121"\w*:  
\q2 ‘Yahvé \w es|strong="H2088"\w* nuestra \w justicia|strong="H6664"\w*’.   
\m
\v 7 “\w Por|strong="H5750"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H5750"\w* \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* \w se|strong="H3808"\w* jurará diciendo: ‘\w Por|strong="H5750"\w* la \w vida|strong="H2416"\w* \w de|strong="H5750"\w* Yahvé, \w que|strong="H3808"\w* \w sacó|strong="H5927"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w de|strong="H5750"\w* \w Egipto|strong="H4714"\w*’,  
\v 8 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* dirá: ‘\w Por|strong="H5921"\w* \w la|strong="H5921"\w* \w vida|strong="H2416"\w* \w de|strong="H5921"\w* Yahvé, \w que|strong="H3588"\w* \w sacó|strong="H5927"\w* \w y|strong="H3588"\w* trajo \w a|strong="H3068"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tierras \w del|strong="H5921"\w* \w norte|strong="H6828"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* países \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w los|strong="H3427"\w* \w había|strong="H3588"\w* expulsado’. \w Entonces|strong="H3588"\w* vivirán \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia tierra”.   
\p
\v 9 En cuanto \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w*: Tengo \w el|strong="H3605"\w* \w corazón|strong="H3820"\w* destrozado y me \w tiemblan|strong="H7363"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w huesos|strong="H6106"\w*. \w Por|strong="H1697"\w* \w causa|strong="H1697"\w* \w de|strong="H6440"\w* Yahvé y \w de|strong="H6440"\w* sus \w santas|strong="H6944"\w* \w palabras|strong="H1697"\w*, parezco un borracho, un \w hombre|strong="H1397"\w* \w al|strong="H7130"\w* \w que|strong="H1697"\w* \w se|strong="H1961"\w* le han subido \w los|strong="H3605"\w* vapores del \w vino|strong="H3196"\w*.   
\q1
\v 10 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* país \w está|strong="H1961"\w* \w lleno|strong="H4390"\w* \w de|strong="H3588"\w* gente infiel;  
\q2 \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w la|strong="H3588"\w* maldición \w el|strong="H3588"\w* país \w está|strong="H1961"\w* \w de|strong="H3588"\w* luto  
\q1 \w y|strong="H3588"\w* \w los|strong="H1961"\w* pastizales del \w desierto|strong="H4057"\w* \w se|strong="H1961"\w* han secado.  
\q2 \w Los|strong="H1961"\w* profetas corren \w hacia|strong="H6440"\w* \w lo|strong="H3808"\w* \w malo|strong="H7451"\w*  
\q2 \w y|strong="H3588"\w* usan \w su|strong="H3588"\w* poder \w para|strong="H3588"\w* \w la|strong="H3588"\w* injusticia.   
\q1
\v 11 “Tanto \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w son|strong="H3588"\w* unos impíos;  
\q2 ¡hasta \w en|strong="H3588"\w* mi propio \w templo|strong="H1004"\w* he visto \w su|strong="H3588"\w* \w maldad|strong="H7451"\w*!”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 12 “\w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w su|strong="H1992"\w* \w camino|strong="H1870"\w* \w será|strong="H1961"\w* resbaladizo;  
\q2 \w en|strong="H5921"\w* \w la|strong="H5921"\w* oscuridad \w serán|strong="H1961"\w* empujados \w y|strong="H3588"\w* \w caerán|strong="H5307"\w*.  
\q1 \w Yo|strong="H3588"\w* traeré \w la|strong="H5921"\w* desgracia \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w* \w cuando|strong="H3588"\w* llegue \w el|strong="H5921"\w* tiempo \w de|strong="H5921"\w* \w su|strong="H1992"\w* \w castigo|strong="H7451"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\b  
\q1
\v 13 “En los \w profetas|strong="H5030"\w* \w de|strong="H5971"\w* \w Samaria|strong="H8111"\w* \w vi|strong="H7200"\w* algo absurdo:  
\q2 \w profetizaban|strong="H5012"\w* en nombre \w de|strong="H5971"\w* \w Baal|strong="H1168"\w*  
\q2 y hacían \w que|strong="H5971"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w se|strong="H5971"\w* extraviara.   
\q1
\v 14 Pero en \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* \w de|strong="H7451"\w* Jerusalén he \w visto|strong="H7200"\w* algo horrible:  
\q2 cometen adulterio, viven en \w la|strong="H3605"\w* \w mentira|strong="H8267"\w*  
\q1 y animan \w a|strong="H3068"\w* \w los|strong="H3427"\w* malvados  
\q2 \w para|strong="H1961"\w* \w que|strong="H1115"\w* \w nadie|strong="H3605"\w* \w se|strong="H1961"\w* arrepienta \w de|strong="H7451"\w* su \w maldad|strong="H7451"\w*.  
\q1 \w Para|strong="H1961"\w* \w mí|strong="H3389"\w*, \w todos|strong="H3605"\w* \w ellos|strong="H3027"\w* \w son|strong="H1961"\w* \w como|strong="H1961"\w* \w Sodoma|strong="H5467"\w*,  
\q2 y \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H7451"\w* \w la|strong="H3605"\w* ciudad \w son|strong="H1961"\w* \w como|strong="H1961"\w* \w Gomorra|strong="H6017"\w*”.   
\p
\v 15 \w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* \w contra|strong="H5921"\w* esos \w profetas|strong="H5030"\w*:  
\q1 “Voy \w a|strong="H3068"\w* darles \w de|strong="H5921"\w* comer comida amarga  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* darles \w de|strong="H5921"\w* \w beber|strong="H8248"\w* \w agua|strong="H4325"\w* envenenada;  
\q2 \w porque|strong="H3588"\w* \w desde|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* \w de|strong="H5921"\w* Jerusalén \w se|strong="H5921"\w* \w ha|strong="H3541"\w* extendido \w la|strong="H5921"\w* maldad \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país”.   
\p
\v 16 \w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*:  
\q1 “\w No|strong="H3808"\w* \w les|strong="H1992"\w* hagan \w caso|strong="H3820"\w* \w a|strong="H3068"\w* esos \w profetas|strong="H5030"\w* \w que|strong="H3808"\w* \w les|strong="H1992"\w* anuncian puras fantasías.  
\q2 \w Lo|strong="H1697"\w* \w que|strong="H3808"\w* \w ellos|strong="H1992"\w* \w dicen|strong="H1696"\w* \w son|strong="H6310"\w* solo inventos \w de|strong="H5921"\w* \w su|strong="H1992"\w* imaginación;  
\q2 \w no|strong="H3808"\w* vienen \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé.   
\q1
\v 17 \w A|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w me|strong="H5921"\w* desprecian \w les|strong="H5921"\w* aseguran:  
\q2 ‘Yahvé \w dice|strong="H1696"\w* \w que|strong="H3808"\w* ustedes \w tendrán|strong="H1961"\w* \w paz|strong="H7965"\w*’.  
\q1 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w siguen|strong="H1980"\w* \w la|strong="H5921"\w* terquedad \w de|strong="H5921"\w* su \w corazón|strong="H3820"\w* \w les|strong="H5921"\w* \w dicen|strong="H1696"\w*:  
\q2 ‘\w No|strong="H3808"\w* \w les|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar \w nada|strong="H3808"\w* \w malo|strong="H7451"\w*’.   
\q1
\v 18 ¿\w Pero|strong="H3588"\w* \w quién|strong="H4310"\w* \w de|strong="H3588"\w* ellos ha \w estado|strong="H5975"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w consejo|strong="H5475"\w* \w de|strong="H3588"\w* Yahvé  
\q2 \w para|strong="H3588"\w* \w ver|strong="H7200"\w* \w y|strong="H3588"\w* \w escuchar|strong="H8085"\w* \w su|strong="H3588"\w* \w palabra|strong="H1697"\w*?  
\q2 ¿\w Quién|strong="H4310"\w* ha prestado atención \w a|strong="H3068"\w* \w su|strong="H3588"\w* mensaje \w para|strong="H3588"\w* obedecerlo?   
\q1
\v 19 ¡Miren! \w La|strong="H5921"\w* \w tempestad|strong="H5591"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* ha desatado \w con|strong="H5921"\w* furia;  
\q2 es un torbellino \w que|strong="H5921"\w* gira \w con|strong="H5921"\w* fuerza  
\q2 \w y|strong="H5921"\w* descargará \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* malvados.   
\q1
\v 20 \w El|strong="H6213"\w* enojo \w de|strong="H5704"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H3808"\w* calmará  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* haya realizado sus planes.  
\q2 \w En|strong="H5704"\w* \w el|strong="H6213"\w* futuro, entenderán \w esto|strong="H6213"\w* claramente.   
\q1
\v 21 Yo \w no|strong="H3808"\w* \w envié|strong="H7971"\w* \w a|strong="H3068"\w* esos \w profetas|strong="H5030"\w*, pero \w ellos|strong="H1992"\w* salieron \w corriendo|strong="H7323"\w*;  
\q2 yo \w no|strong="H3808"\w* \w les|strong="H1992"\w* \w hablé|strong="H1696"\w*, pero \w ellos|strong="H1992"\w* \w se|strong="H3808"\w* pusieron \w a|strong="H3068"\w* profetizar.   
\q1
\v 22 Si hubieran \w estado|strong="H5975"\w* \w en|strong="H5975"\w* mi \w consejo|strong="H5475"\w*,  
\q2 le habrían anunciado mis \w palabras|strong="H1697"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*  
\q1 \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* apartara \w de|strong="H5971"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*  
\q2 y dejara \w de|strong="H5971"\w* hacer \w lo|strong="H1697"\w* \w malo|strong="H7451"\w*.   
\b  
\q1
\v 23 “¿Acaso soy yo \w Dios|strong="H3068"\w* solo de \w cerca|strong="H7138"\w* y \w no|strong="H3808"\w* también de \w lejos|strong="H7350"\w*?”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 24 “¿\w Podrá|strong="H3808"\w* alguien esconderse en un rincón secreto  
\q2 donde yo \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w vea|strong="H7200"\w*? — \w dice|strong="H5002"\w* Yahvé —.  
\q2 ¿Acaso \w no|strong="H3808"\w* \w lleno|strong="H4390"\w* yo el \w cielo|strong="H8064"\w* y la tierra?”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 25 “He \w oído|strong="H8085"\w* lo que dicen esos \w profetas|strong="H5030"\w* que mienten en mi \w nombre|strong="H8034"\w* y aseguran: ‘¡Tuve un sueño! ¡Tuve un sueño!’.  
\v 26 ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* seguirán así estos \w profetas|strong="H5030"\w* \w que|strong="H5704"\w* anuncian \w mentiras|strong="H8267"\w* \w y|strong="H5704"\w* los engaños \w de|strong="H5704"\w* su propia mente?  
\v 27 Con los \w sueños|strong="H2472"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* \w cuentan|strong="H5608"\w* unos \w a|strong="H3068"\w* otros, solo buscan \w que|strong="H5971"\w* mi \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* olvide \w de|strong="H5971"\w* mi \w nombre|strong="H8034"\w*, tal como sus antepasados \w se|strong="H5971"\w* \w olvidaron|strong="H7911"\w* \w de|strong="H5971"\w* mí por causa \w de|strong="H5971"\w* \w Baal|strong="H1168"\w*.  
\v 28 \w El|strong="H5030"\w* \w profeta|strong="H5030"\w* \w que|strong="H4100"\w* tenga un \w sueño|strong="H2472"\w*, \w que|strong="H4100"\w* \w lo|strong="H1697"\w* \w cuente|strong="H5608"\w* \w como|strong="H4100"\w* un \w sueño|strong="H2472"\w*; pero \w el|strong="H5030"\w* \w que|strong="H4100"\w* tenga mi \w palabra|strong="H1697"\w*, \w que|strong="H4100"\w* la anuncie con fidelidad. ¿\w Qué|strong="H4100"\w* tiene \w que|strong="H4100"\w* ver la \w paja|strong="H8401"\w* con \w el|strong="H5030"\w* \w trigo|strong="H1250"\w*?”, \w dice|strong="H5002"\w* Yahvé.  
\v 29 “¿Acaso mi \w palabra|strong="H1697"\w* \w no|strong="H3808"\w* \w es|strong="H1697"\w* como el fuego \w y|strong="H3541"\w* como un martillo \w que|strong="H3808"\w* hace pedazos la \w roca|strong="H5553"\w*?”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 30 “\w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, yo estoy \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* — \w dice|strong="H5002"\w* Yahvé — \w que|strong="H5921"\w* \w se|strong="H5921"\w* roban mis \w palabras|strong="H1697"\w* unos \w a|strong="H3068"\w* otros.  
\v 31 Yo estoy \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* — \w dice|strong="H5002"\w* Yahvé — \w que|strong="H5921"\w* menean \w la|strong="H5921"\w* \w lengua|strong="H3956"\w* \w y|strong="H5921"\w* dicen: ‘Yahvé ha \w dicho|strong="H5002"\w*’.  
\v 32 \w Yo|strong="H6680"\w* estoy \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w profetizan|strong="H5012"\w* \w sueños|strong="H2472"\w* \w mentirosos|strong="H8267"\w* — \w dice|strong="H5002"\w* Yahvé —; \w al|strong="H5921"\w* contarlos, hacen \w que|strong="H3808"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* pierda \w con|strong="H5921"\w* sus \w mentiras|strong="H8267"\w* \w y|strong="H5921"\w* sus jactancias. \w Yo|strong="H6680"\w* \w no|strong="H3808"\w* \w los|strong="H5921"\w* \w envié|strong="H7971"\w* \w ni|strong="H3808"\w* \w les|strong="H5921"\w* di \w ninguna|strong="H3808"\w* \w orden|strong="H6680"\w*, \w así|strong="H2088"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* sirven \w para|strong="H5921"\w* \w nada|strong="H3808"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 33 “\w Cuando|strong="H3588"\w* alguien del \w pueblo|strong="H5971"\w*, \w o|strong="H3068"\w* un \w profeta|strong="H5030"\w* \w o|strong="H3068"\w* un \w sacerdote|strong="H3548"\w* \w te|strong="H3588"\w* \w pregunte|strong="H7592"\w*: ‘¿\w Cuál|strong="H4100"\w* \w es|strong="H2088"\w* \w el|strong="H3588"\w* mensaje \w de|strong="H3588"\w* Yahvé?’, tú les responderás: ‘¿\w Cuál|strong="H4100"\w* mensaje? ¡Ustedes \w son|strong="H3588"\w* una \w carga|strong="H4853"\w* \w y|strong="H3588"\w* \w me|strong="H3588"\w* \w los|strong="H3588"\w* voy \w a|strong="H3068"\w* quitar \w de|strong="H3588"\w* encima!’, \w dice|strong="H5002"\w* Yahvé.  
\v 34 \w Si|strong="H1931"\w* un \w profeta|strong="H5030"\w*, un \w sacerdote|strong="H3548"\w* \w o|strong="H3068"\w* alguien \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w* dice: ‘\w Este|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* mensaje \w de|strong="H5921"\w* Yahvé’, yo \w lo|strong="H1931"\w* castigaré \w a|strong="H3068"\w* \w él|strong="H1931"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w familia|strong="H1004"\w*.  
\v 35 \w Lo|strong="H4100"\w* \w que|strong="H4100"\w* cada uno debe preguntar \w a|strong="H3068"\w* su \w amigo|strong="H7453"\w* \w o|strong="H3068"\w* \w a|strong="H3068"\w* su hermano \w es|strong="H3541"\w*: ‘¿\w Qué|strong="H4100"\w* \w ha|strong="H3541"\w* respondido Yahvé?’, \w o|strong="H3068"\w* ‘¿\w Qué|strong="H4100"\w* \w ha|strong="H3541"\w* \w dicho|strong="H1696"\w* Yahvé?’.  
\v 36 \w Pero|strong="H3588"\w* \w no|strong="H3808"\w* vuelvan \w a|strong="H3068"\w* mencionar \w la|strong="H3588"\w* frase ‘Mensaje \w de|strong="H3588"\w* Yahvé’, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* mensaje \w para|strong="H3588"\w* \w cada|strong="H1697"\w* uno \w será|strong="H1961"\w* \w su|strong="H3588"\w* propia \w palabra|strong="H1697"\w*; \w pues|strong="H3588"\w* ustedes han pervertido las \w palabras|strong="H1697"\w* del \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*, \w de|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*, nuestro \w Dios|strong="H3068"\w*.  
\v 37 \w Esto|strong="H3541"\w* \w es|strong="H3541"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* le preguntarás al \w profeta|strong="H5030"\w*: ‘¿\w Qué|strong="H4100"\w* te \w ha|strong="H3541"\w* respondido Yahvé?’, \w o|strong="H3068"\w* ‘¿\w Qué|strong="H4100"\w* \w ha|strong="H3541"\w* \w dicho|strong="H1696"\w* Yahvé?’.  
\v 38 Pero \w si|strong="H3808"\w* ustedes dicen: ‘Mensaje \w de|strong="H1697"\w* Yahvé’, \w entonces|strong="H3651"\w* Yahvé les advierte: ‘\w Por|strong="H3282"\w* \w haber|strong="H3808"\w* usado la frase “Mensaje \w de|strong="H1697"\w* Yahvé”, \w a|strong="H3068"\w* pesar \w de|strong="H1697"\w* \w que|strong="H3808"\w* yo les prohibí \w que|strong="H3808"\w* la usaran,  
\v 39 yo \w me|strong="H5921"\w* olvidaré \w de|strong="H5921"\w* ustedes \w y|strong="H5921"\w* \w los|strong="H5921"\w* arrojaré lejos \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus antepasados.  
\v 40 \w Los|strong="H5921"\w* cubriré \w de|strong="H5921"\w* una vergüenza \w eterna|strong="H5769"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* una \w deshonra|strong="H2781"\w* \w que|strong="H3808"\w* \w jamás|strong="H5769"\w* \w será|strong="H5414"\w* \w olvidada|strong="H7911"\w*’”.   
\c 24  
\p
\v 1 \w El|strong="H1121"\w* \w Señor|strong="H3068"\w* me \w mostró|strong="H7200"\w* \w dos|strong="H8147"\w* canastas \w de|strong="H6440"\w* \w higos|strong="H8384"\w* \w puestas|strong="H3259"\w* frente \w al|strong="H4428"\w* \w templo|strong="H1964"\w* del \w Señor|strong="H3068"\w*. Esto sucedió después \w de|strong="H6440"\w* \w que|strong="H1121"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Babilonia, se llevó \w cautivos|strong="H1540"\w* \w a|strong="H3068"\w* Babilonia \w a|strong="H3068"\w* Jeconías \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, junto con \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w los|strong="H1121"\w* artesanos y \w los|strong="H1121"\w* herreros \w de|strong="H6440"\w* Jerusalén.  
\v 2 Una canasta tenía \w higos|strong="H8384"\w* \w muy|strong="H3966"\w* \w buenos|strong="H2896"\w*, como los \w de|strong="H7451"\w* la primera cosecha; la otra canasta tenía \w higos|strong="H8384"\w* \w tan|strong="H3966"\w* \w malos|strong="H7451"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* podían comer.   
\p
\v 3 Entonces Yahvé me preguntó: “¿\w Qué|strong="H4100"\w* \w ves|strong="H7200"\w*, \w Jeremías|strong="H3414"\w*?”  
\p Yo respondí: “\w Veo|strong="H7200"\w* \w higos|strong="H8384"\w*. Los \w buenos|strong="H2896"\w* \w son|strong="H3808"\w* \w muy|strong="H3966"\w* \w buenos|strong="H2896"\w*; pero los \w malos|strong="H7451"\w* \w son|strong="H3808"\w* \w tan|strong="H3966"\w* \w malos|strong="H7451"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* pueden comer”.   
\p
\v 4 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 5 “\w Así|strong="H3541"\w* dice Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*: ‘\w Al|strong="H4480"\w* igual \w que|strong="H4480"\w* \w a|strong="H3068"\w* \w estos|strong="H2088"\w* \w higos|strong="H8384"\w* \w buenos|strong="H2896"\w*, \w así|strong="H3541"\w* veré \w con|strong="H4480"\w* \w buenos|strong="H2896"\w* ojos \w a|strong="H3068"\w* los cautivos \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w que|strong="H4480"\w* \w envié|strong="H7971"\w* \w de|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* la tierra \w de|strong="H4480"\w* los \w caldeos|strong="H3778"\w*.  
\v 6 Yo \w los|strong="H5921"\w* cuidaré \w para|strong="H5921"\w* su \w bien|strong="H2896"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w haré|strong="H7760"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* tierra. \w Los|strong="H5921"\w* reconstruiré \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w los|strong="H5921"\w* \w destruiré|strong="H2040"\w*; \w los|strong="H5921"\w* \w plantaré|strong="H5193"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w los|strong="H5921"\w* \w arrancaré|strong="H5428"\w*.  
\v 7 Les \w daré|strong="H5414"\w* un \w corazón|strong="H3820"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* reconozca \w como|strong="H3588"\w* Yahvé. \w Ellos|strong="H3605"\w* \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w porque|strong="H3588"\w* \w se|strong="H3045"\w* \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*.   
\p
\v 8 ‘\w Pero|strong="H3588"\w* \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* sus \w jefes|strong="H8269"\w* \w y|strong="H3588"\w* \w al|strong="H4428"\w* \w resto|strong="H7611"\w* \w de|strong="H3588"\w* Jerusalén \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w quedó|strong="H7604"\w* \w en|strong="H3588"\w* \w este|strong="H2063"\w* país \w o|strong="H3068"\w* \w que|strong="H3588"\w* vive \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w los|strong="H3427"\w* trataré \w como|strong="H3588"\w* \w a|strong="H3068"\w* esos \w higos|strong="H8384"\w* \w malos|strong="H7451"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* pueden comer’, dice \w el|strong="H3588"\w* \w Señor|strong="H3068"\w*.  
\v 9 ‘\w Haré|strong="H5414"\w* \w que|strong="H3605"\w* sean objeto \w de|strong="H5414"\w* horror y \w de|strong="H5414"\w* burla en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H5414"\w* \w la|strong="H3605"\w* tierra; serán motivo \w de|strong="H5414"\w* desprecio, \w de|strong="H5414"\w* refranes, \w de|strong="H5414"\w* mofa y \w de|strong="H5414"\w* \w maldición|strong="H7045"\w* en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* yo \w los|strong="H3605"\w* expulse.  
\v 10 \w Enviaré|strong="H7971"\w* \w contra|strong="H5921"\w* \w ellos|strong="H1992"\w* \w la|strong="H5921"\w* guerra, \w el|strong="H5921"\w* \w hambre|strong="H7458"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* peste, \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* desaparezcan \w por|strong="H5921"\w* completo \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w les|strong="H1992"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* antepasados’”.   
\c 25  
\p
\v 1 \w Palabra|strong="H1697"\w* \w que|strong="H1931"\w* recibió \w Jeremías|strong="H3414"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* (\w que|strong="H1931"\w* \w era|strong="H1961"\w* \w el|strong="H1931"\w* primer \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia).  
\v 2 \w El|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* comunicó este mensaje \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén:  
\v 3 “Durante \w veintitrés|strong="H6242"\w* \w años|strong="H8141"\w*, \w desde|strong="H4480"\w* \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w trece|strong="H7969"\w* \w de|strong="H4480"\w* \w Josías|strong="H2977"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Amón, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w hoy|strong="H3117"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* Yahvé \w ha|strong="H3808"\w* venido \w a|strong="H3068"\w* \w mí|strong="H1961"\w*. \w Yo|strong="H4480"\w* les he \w hablado|strong="H1696"\w* una \w y|strong="H5704"\w* otra vez, pero ustedes \w no|strong="H3808"\w* han escuchado.   
\p
\v 4 Además, Yahvé les \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w siervos|strong="H5650"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w*, enviándolos insistentemente, pero ustedes \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* prestaron atención para \w oír|strong="H8085"\w*.  
\v 5 \w Ellos|strong="H5921"\w* decían: ‘\w Vuelvan|strong="H7725"\w* \w ahora|strong="H4994"\w* cada uno \w de|strong="H4480"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w* \w y|strong="H5921"\w* \w de|strong="H4480"\w* sus \w malas|strong="H7451"\w* acciones, \w y|strong="H5921"\w* podrán vivir \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H4480"\w* Yahvé \w les|strong="H5921"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus antepasados \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 6 \w No|strong="H3808"\w* \w se|strong="H3808"\w* \w vayan|strong="H3212"\w* tras otros dioses para servirles \w ni|strong="H3808"\w* adorarles, \w ni|strong="H3808"\w* me provoquen \w a|strong="H3068"\w* \w ira|strong="H3212"\w* con \w lo|strong="H3808"\w* \w que|strong="H3808"\w* sus \w manos|strong="H3027"\w* fabrican; así \w no|strong="H3808"\w* les haré \w ningún|strong="H3808"\w* daño’.   
\p
\v 7 “Pero ustedes \w no|strong="H3808"\w* me \w escucharon|strong="H8085"\w* — \w dice|strong="H5002"\w* Yahvé —; prefirieron provocarme \w a|strong="H3068"\w* ira con \w lo|strong="H3808"\w* \w que|strong="H3808"\w* sus \w manos|strong="H3027"\w* hicieron, \w para|strong="H4616"\w* su propio \w mal|strong="H7451"\w*”.   
\p
\v 8 \w Por|strong="H3282"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* los \w Ejércitos|strong="H6635"\w*: “\w Como|strong="H3651"\w* \w no|strong="H3808"\w* han obedecido mis \w palabras|strong="H1697"\w*,  
\v 9 voy \w a|strong="H3068"\w* mandar \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w familias|strong="H4940"\w* \w del|strong="H5921"\w* \w norte|strong="H6828"\w* — \w dice|strong="H5002"\w* Yahvé — \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia. \w Los|strong="H3427"\w* traeré \w contra|strong="H5921"\w* \w este|strong="H2063"\w* país, \w contra|strong="H5921"\w* sus \w habitantes|strong="H3427"\w* \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* vecinas. \w Los|strong="H3427"\w* destruiré \w por|strong="H5921"\w* completo \w y|strong="H5921"\w* \w los|strong="H3427"\w* convertiré \w en|strong="H5921"\w* algo \w que|strong="H5921"\w* cause horror, burla \w y|strong="H5921"\w* desolación \w eterna|strong="H5769"\w*.  
\v 10 Haré \w que|strong="H1992"\w* \w se|strong="H1992"\w* apaguen entre \w ellos|strong="H1992"\w* \w los|strong="H1992"\w* gritos de \w gozo|strong="H8057"\w* y \w alegría|strong="H8057"\w*, \w las|strong="H1992"\w* \w voces|strong="H6963"\w* del novio y de la novia, \w el|strong="H1992"\w* \w ruido|strong="H6963"\w* del molino y la luz de la \w lámpara|strong="H5216"\w*.  
\v 11 \w Todo|strong="H3605"\w* \w este|strong="H2063"\w* país \w quedará|strong="H1961"\w* en ruinas y \w será|strong="H1961"\w* un \w espanto|strong="H8047"\w*; \w estas|strong="H2063"\w* \w naciones|strong="H1471"\w* \w servirán|strong="H5647"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Babilonia durante \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*.   
\p
\v 12 “\w Y|strong="H3068"\w* \w sucederá|strong="H1961"\w* \w que|strong="H1931"\w* \w cuando|strong="H1961"\w* \w se|strong="H1961"\w* cumplan \w los|strong="H5921"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*, castigaré \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w esa|strong="H1931"\w* \w nación|strong="H1471"\w* \w por|strong="H5921"\w* \w su|strong="H1931"\w* \w pecado|strong="H5771"\w* — \w dice|strong="H5002"\w* \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* —; también castigaré \w la|strong="H1931"\w* tierra \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w* \w y|strong="H5921"\w* \w la|strong="H1931"\w* dejaré \w desolada|strong="H8077"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*.  
\v 13 Cumpliré \w contra|strong="H5921"\w* \w ese|strong="H1931"\w* país \w todas|strong="H3605"\w* \w las|strong="H5921"\w* amenazas \w que|strong="H1931"\w* he pronunciado \w contra|strong="H5921"\w* \w él|strong="H1931"\w*, \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w está|strong="H2088"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w* \w y|strong="H5921"\w* \w que|strong="H1931"\w* \w Jeremías|strong="H3414"\w* \w profetizó|strong="H5012"\w* \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.  
\v 14 \w Porque|strong="H3588"\w* \w muchas|strong="H7227"\w* \w naciones|strong="H1471"\w* \w y|strong="H1571"\w* \w grandes|strong="H1419"\w* \w reyes|strong="H4428"\w* \w los|strong="H1992"\w* esclavizarán \w también|strong="H1571"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w*; \w les|strong="H1992"\w* \w pagaré|strong="H7999"\w* según \w sus|strong="H1992"\w* acciones \w y|strong="H1571"\w* según \w lo|strong="H1992"\w* \w que|strong="H3588"\w* \w sus|strong="H1992"\w* \w manos|strong="H3027"\w* hicieron”.   
\p
\v 15 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* \w me|strong="H3588"\w* dijo Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: “\w Toma|strong="H3947"\w* \w de|strong="H3588"\w* mi \w mano|strong="H3027"\w* \w esta|strong="H2063"\w* copa llena del \w vino|strong="H3196"\w* \w de|strong="H3588"\w* mi \w furor|strong="H2534"\w*, \w y|strong="H3588"\w* haz \w que|strong="H3588"\w* beban \w de|strong="H3588"\w* \w ella|strong="H3605"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w a|strong="H3068"\w* las \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w envíe|strong="H7971"\w*.  
\v 16 \w Beberán|strong="H8354"\w*, y se tambalearán y se volverán locos \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* la guerra que voy \w a|strong="H3068"\w* enviar entre ellos”.   
\p
\v 17 Entonces \w tomé|strong="H3947"\w* \w la|strong="H3605"\w* copa de \w la|strong="H3605"\w* \w mano|strong="H3027"\w* de Yahvé, y les di de \w beber|strong="H8248"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w a|strong="H3068"\w* las \w que|strong="H3605"\w* Yahvé me \w envió|strong="H7971"\w*:  
\v 18 \w a|strong="H3068"\w* Jerusalén y \w a|strong="H3068"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*, con sus \w reyes|strong="H4428"\w* y sus \w jefes|strong="H8269"\w*, \w para|strong="H5414"\w* convertirlas en ruinas, en algo \w que|strong="H3117"\w* cause \w espanto|strong="H8047"\w*, burla y \w maldición|strong="H7045"\w*, como sucede \w hoy|strong="H3117"\w*;  
\v 19 \w al|strong="H4428"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*, con sus oficiales, sus \w jefes|strong="H8269"\w* y \w todo|strong="H3605"\w* su \w pueblo|strong="H5971"\w*;  
\v 20 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* pueblos extranjeros, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w la|strong="H3605"\w* tierra de \w Uz|strong="H5780"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* (es decir, Ascalón, \w Gaza|strong="H5804"\w*, \w Ecrón|strong="H6138"\w* y \w lo|strong="H3605"\w* \w que|strong="H3605"\w* queda de Asdod);  
\v 21 \w a|strong="H3068"\w* Edom, \w a|strong="H3068"\w* \w Moab|strong="H4124"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* amonitas;  
\v 22 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w Tiro|strong="H6865"\w* y de \w Sidón|strong="H6721"\w*, y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de las costas \w que|strong="H3605"\w* están \w al|strong="H4428"\w* otro \w lado|strong="H5676"\w* del \w mar|strong="H3220"\w*;  
\v 23 \w a|strong="H3068"\w* \w Dedán|strong="H1719"\w*, Tema, Buz y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* se cortan \w el|strong="H3605"\w* cabello de las sienes;  
\v 24 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w Arabia|strong="H6152"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de las tribus mezcladas \w que|strong="H3605"\w* \w habitan|strong="H7931"\w* en \w el|strong="H3605"\w* \w desierto|strong="H4057"\w*;  
\v 25 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de \w Zimri|strong="H2174"\w*, de \w Elam|strong="H5867"\w* y de \w Media|strong="H4074"\w*;  
\v 26 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w del|strong="H5921"\w* \w norte|strong="H6828"\w*, \w tanto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* \w cerca|strong="H7138"\w* \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* \w lejos|strong="H7350"\w*, \w a|strong="H3068"\w* unos \w y|strong="H5921"\w* \w a|strong="H3068"\w* otros; \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w del|strong="H5921"\w* mundo \w que|strong="H5921"\w* están \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra. \w Por|strong="H5921"\w* último, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w beberá|strong="H8354"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.   
\p
\v 27 “\w Y|strong="H3068"\w* les dirás: ‘\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H6440"\w* los \w Ejércitos|strong="H6635"\w*, \w el|strong="H5307"\w* \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*: \w Beban|strong="H8354"\w* \w y|strong="H3541"\w* emborráchense, vomiten \w y|strong="H3541"\w* cáiganse para \w no|strong="H3808"\w* \w levantarse|strong="H6965"\w* \w más|strong="H3808"\w*, \w por|strong="H6440"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* la \w espada|strong="H2719"\w* \w que|strong="H3808"\w* voy \w a|strong="H3068"\w* enviar \w entre|strong="H3808"\w* ustedes’.  
\v 28 \w Si|strong="H3588"\w* \w se|strong="H1961"\w* niegan \w a|strong="H3068"\w* \w tomar|strong="H3947"\w* \w la|strong="H3588"\w* copa \w de|strong="H3588"\w* tu \w mano|strong="H3027"\w* \w para|strong="H3588"\w* \w beber|strong="H8354"\w*, les dirás: ‘\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*: ¡\w Tienen|strong="H1961"\w* \w que|strong="H3588"\w* \w beberla|strong="H8354"\w* sin falta!  
\v 29 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* \w yo|strong="H3588"\w* \w comienzo|strong="H2490"\w* \w a|strong="H3068"\w* castigar \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w donde|strong="H5921"\w* \w se|strong="H5921"\w* invoca \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, ¿acaso creen \w que|strong="H3588"\w* ustedes \w quedarán|strong="H3427"\w* \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w*? \w No|strong="H3808"\w* \w quedarán|strong="H3427"\w* impunes, \w porque|strong="H3588"\w* voy \w a|strong="H3068"\w* traer \w la|strong="H5921"\w* \w guerra|strong="H6635"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w del|strong="H5921"\w* mundo, \w dice|strong="H5002"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*’.   
\p
\v 30 “\w Por|strong="H5921"\w* eso, tú \w profetizarás|strong="H5012"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w* \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w dirás|strong="H6030"\w*:  
\q1 ‘Yahvé \w rugirá|strong="H7580"\w* \w desde|strong="H5921"\w* \w lo|strong="H1697"\w* \w alto|strong="H4791"\w*,  
\q2 tronará su \w voz|strong="H6963"\w* \w desde|strong="H5921"\w* su \w santa|strong="H6944"\w* \w morada|strong="H3427"\w*.  
\q2 \w Rugirá|strong="H7580"\w* \w con|strong="H5921"\w* fuerza \w contra|strong="H5921"\w* su propio rebaño;  
\q1 lanzará un grito, \w como|strong="H5921"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* \w pisan|strong="H1869"\w* \w las|strong="H5921"\w* uvas,  
\q2 \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.   
\q1
\v 31 \w El|strong="H1931"\w* estruendo llegará \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w último|strong="H7097"\w* rincón del mundo,  
\q2 \w porque|strong="H3588"\w* Yahvé \w tiene|strong="H1931"\w* un \w pleito|strong="H7379"\w* contra las \w naciones|strong="H1471"\w*;  
\q1 \w él|strong="H1931"\w* \w juzgará|strong="H8199"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* humanidad  
\q2 \w y|strong="H3588"\w* \w entregará|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* malvados \w a|strong="H3068"\w* \w la|strong="H1931"\w* muerte’, \w dice|strong="H5002"\w* Yahvé”.   
\p
\v 32 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H7451"\w* los \w Ejércitos|strong="H6635"\w*:  
\q1 “Miren, la desgracia se extiende \w de|strong="H7451"\w* \w nación|strong="H1471"\w* \w en|strong="H3318"\w* \w nación|strong="H1471"\w*,  
\q2 una \w gran|strong="H1419"\w* tormenta se levanta desde los confines \w de|strong="H7451"\w* la tierra”.   
\m
\v 33 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w los|strong="H5921"\w* \w que|strong="H1931"\w* mueran \w por|strong="H5921"\w* \w la|strong="H1931"\w* \w mano|strong="H1931"\w* \w de|strong="H5921"\w* Yahvé quedarán tendidos \w de|strong="H5921"\w* un \w extremo|strong="H7097"\w* \w a|strong="H3068"\w* \w otro|strong="H7097"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* tierra. \w Nadie|strong="H3808"\w* llorará \w por|strong="H5921"\w* \w ellos|strong="H1931"\w*, \w ni|strong="H3808"\w* \w serán|strong="H1961"\w* recogidos \w ni|strong="H3808"\w* \w enterrados|strong="H6912"\w*; quedarán \w como|strong="H1961"\w* abono \w sobre|strong="H5921"\w* \w el|strong="H1931"\w* suelo.   
\q1
\v 34 ¡Giman \w y|strong="H3588"\w* griten, \w pastores|strong="H7462"\w*!  
\q2 ¡Revuélquense \w en|strong="H3588"\w* \w el|strong="H3588"\w* polvo, jefes del \w rebaño|strong="H6629"\w*!  
\q1 \w Porque|strong="H3588"\w* ha llegado \w el|strong="H3588"\w* \w tiempo|strong="H3117"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* matanza \w y|strong="H3588"\w* dispersión;  
\q2 \w caerán|strong="H5307"\w* \w y|strong="H3588"\w* se harán pedazos \w como|strong="H3588"\w* vajilla fina.   
\q1
\v 35 Los \w pastores|strong="H7462"\w* no tendrán \w a|strong="H3068"\w* dónde huir,  
\q2 los jefes \w del|strong="H4480"\w* \w rebaño|strong="H6629"\w* no podrán \w escapar|strong="H6413"\w*.   
\q1
\v 36 ¡Escuchen \w los|strong="H3588"\w* gritos \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w pastores|strong="H7462"\w*  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* lamento \w de|strong="H3588"\w* \w los|strong="H3588"\w* jefes del \w rebaño|strong="H6629"\w*!  
\q2 \w Porque|strong="H3588"\w* Yahvé está destruyendo sus pastizales.   
\q1
\v 37 Los campos pacíficos han quedado en silencio  
\q2 \w por|strong="H6440"\w* el ardiente enojo \w de|strong="H6440"\w* Yahvé.   
\q1
\v 38 \w Como|strong="H3588"\w* un león, \w él|strong="H3588"\w* ha dejado \w su|strong="H3588"\w* guarida;  
\q2 \w el|strong="H3588"\w* país ha quedado convertido \w en|strong="H3588"\w* un \w espanto|strong="H8047"\w*  
\q2 \w por|strong="H3588"\w* \w la|strong="H3588"\w* furia del opresor \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* ardiente enojo.   
\c 26  
\p
\v 1 \w Al|strong="H4428"\w* comienzo del \w reinado|strong="H4428"\w* \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, llegó \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* parte \w de|strong="H1121"\w* Yahvé:  
\v 2 “\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé: ‘\w Ponte|strong="H5975"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w habla|strong="H1696"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w que|strong="H5921"\w* vienen \w a|strong="H3068"\w* adorar \w allí|strong="H3541"\w*. \w Diles|strong="H1697"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w yo|strong="H6680"\w* \w te|strong="H5921"\w* \w mande|strong="H6680"\w*; \w no|strong="H5921"\w* omitas ni una sola \w palabra|strong="H1697"\w*.  
\v 3 Tal vez \w escuchen|strong="H8085"\w* y cada uno se arrepienta \w de|strong="H6440"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*; \w entonces|strong="H7725"\w* \w yo|strong="H6213"\w* desistiré del \w castigo|strong="H7451"\w* que \w pienso|strong="H2803"\w* lanzarles \w por|strong="H1870"\w* la \w maldad|strong="H7451"\w* \w de|strong="H6440"\w* sus acciones’.  
\v 4 Les dirás \w lo|strong="H3808"\w* siguiente: ‘\w Así|strong="H3541"\w* dice Yahvé: \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w me|strong="H3541"\w* \w obedecen|strong="H8085"\w* \w ni|strong="H3808"\w* viven conforme \w a|strong="H3068"\w* la \w ley|strong="H8451"\w* \w que|strong="H3808"\w* les he propuesto,  
\v 5 \w y|strong="H5921"\w* \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w escuchan|strong="H8085"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* mis \w siervos|strong="H5650"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w*, \w a|strong="H3068"\w* quienes \w les|strong="H5921"\w* he \w enviado|strong="H7971"\w* una \w y|strong="H5921"\w* otra vez — \w a|strong="H3068"\w* pesar \w de|strong="H5921"\w* \w que|strong="H3808"\w* ustedes \w no|strong="H3808"\w* han hecho caso —,  
\v 6 entonces \w haré|strong="H5414"\w* con \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w lo|strong="H2088"\w* \w mismo|strong="H3605"\w* \w que|strong="H2088"\w* hice con \w Silo|strong="H7887"\w*, y convertiré \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* en objeto \w de|strong="H5414"\w* \w maldición|strong="H7045"\w* \w para|strong="H5414"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* del mundo’”.   
\p
\v 7 \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w oyeron|strong="H8085"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w decir|strong="H8085"\w* estas \w palabras|strong="H1697"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé.  
\v 8 Pero en cuanto \w Jeremías|strong="H3414"\w* terminó \w de|strong="H5971"\w* decir \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H5971"\w* Yahvé le \w había|strong="H1961"\w* \w ordenado|strong="H6680"\w*, \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w lo|strong="H3605"\w* agarraron y le gritaron: “¡Vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*!  
\v 9 ¿\w Por|strong="H4069"\w* \w qué|strong="H5971"\w* \w profetizas|strong="H5012"\w* en \w nombre|strong="H8034"\w* \w de|strong="H5971"\w* Yahvé diciendo \w que|strong="H5971"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* \w Silo|strong="H7887"\w*, y \w que|strong="H5971"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w quedará|strong="H1961"\w* desolada y sin \w habitantes|strong="H3427"\w*?”. \w Y|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1961"\w* amontonó \w contra|strong="H1961"\w* \w Jeremías|strong="H3414"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé.   
\p
\v 10 Cuando \w los|strong="H3427"\w* \w jefes|strong="H8269"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* se enteraron \w de|strong="H1697"\w* \w esto|strong="H1697"\w*, \w subieron|strong="H5927"\w* del palacio \w real|strong="H4428"\w* \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé y se \w sentaron|strong="H3427"\w* \w a|strong="H3068"\w* juzgar \w a|strong="H3068"\w* la entrada \w de|strong="H1697"\w* la \w Puerta|strong="H6607"\w* \w Nueva|strong="H2319"\w*.  
\v 11 \w Entonces|strong="H3588"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* les dijeron \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*: “\w Este|strong="H2088"\w* hombre merece \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*, \w porque|strong="H3588"\w* ha \w profetizado|strong="H5012"\w* contra \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w tal|strong="H2088"\w* \w como|strong="H3588"\w* ustedes \w lo|strong="H2088"\w* han \w oído|strong="H8085"\w* \w con|strong="H3588"\w* sus propios \w oídos|strong="H8085"\w*”.   
\p
\v 12 Pero \w Jeremías|strong="H3414"\w* les respondió \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*: “Yahvé fue \w quien|strong="H3605"\w* me \w envió|strong="H7971"\w* \w a|strong="H3068"\w* profetizar contra \w este|strong="H2088"\w* \w templo|strong="H1004"\w* y contra \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* ustedes han escuchado.  
\v 13 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* mejoren \w ahora|strong="H6258"\w* su conducta \w y|strong="H5921"\w* sus acciones, \w y|strong="H5921"\w* obedezcan \w la|strong="H5921"\w* \w voz|strong="H6963"\w* \w de|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w*; entonces Yahvé desistirá \w del|strong="H5921"\w* \w castigo|strong="H7451"\w* \w que|strong="H6258"\w* ha anunciado \w contra|strong="H5921"\w* ustedes.  
\v 14 En cuanto \w a|strong="H3068"\w* mí, \w aquí|strong="H2005"\w* me tienen; estoy en sus \w manos|strong="H3027"\w*. \w Hagan|strong="H6213"\w* \w conmigo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3027"\w* les parezca \w bueno|strong="H2896"\w* y justo.  
\v 15 \w Pero|strong="H3588"\w* \w eso|strong="H2063"\w* \w sí|strong="H3588"\w*, \w sepan|strong="H3045"\w* \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w si|strong="H3588"\w* \w me|strong="H5921"\w* matan, \w se|strong="H3045"\w* harán culpables \w de|strong="H5921"\w* derramar \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w*, \w tanto|strong="H5921"\w* ustedes \w como|strong="H3588"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* sus \w habitantes|strong="H3427"\w*; \w porque|strong="H3588"\w*, \w en|strong="H5921"\w* verdad, Yahvé \w me|strong="H5921"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decirles \w todas|strong="H3605"\w* \w estas|strong="H2063"\w* \w palabras|strong="H1697"\w*”.   
\p
\v 16 \w Entonces|strong="H3588"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* les \w dijeron|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w*: “\w Este|strong="H2088"\w* hombre \w no|strong="H3588"\w* merece \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*, \w porque|strong="H3588"\w* nos ha \w hablado|strong="H1696"\w* \w en|strong="H3588"\w* \w nombre|strong="H8034"\w* \w de|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*”.   
\p
\v 17 Algunos \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* del país \w se|strong="H5971"\w* \w levantaron|strong="H6965"\w* y \w se|strong="H5971"\w* dirigieron \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea del \w pueblo|strong="H5971"\w*:  
\v 18 “\w Miqueas|strong="H4320"\w* \w de|strong="H5971"\w* Moréset \w profetizó|strong="H5012"\w* en \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H5971"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3541"\w* le dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*: ‘\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*:  
\q1 \w Sión|strong="H6726"\w* \w será|strong="H1961"\w* \w arada|strong="H2790"\w* \w como|strong="H1961"\w* un \w campo|strong="H7704"\w*,  
\q2 Jerusalén \w quedará|strong="H1961"\w* hecha un montón \w de|strong="H5971"\w* escombros  
\q2 \w y|strong="H3541"\w* \w el|strong="H3605"\w* \w monte|strong="H2022"\w* del \w templo|strong="H1004"\w* \w se|strong="H1961"\w* cubrirá \w de|strong="H5971"\w* maleza \w como|strong="H1961"\w* un \w bosque|strong="H3293"\w*’.   
\m
\v 19 ¿Acaso \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Ezequías \w y|strong="H5921"\w* \w el|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w lo|strong="H3808"\w* \w mataron|strong="H4191"\w*? ¿\w No|strong="H3808"\w* es verdad \w que|strong="H3808"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w tuvo|strong="H6213"\w* temor \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* buscó su favor, \w y|strong="H5921"\w* \w que|strong="H3808"\w* Yahvé desistió \w del|strong="H5921"\w* \w castigo|strong="H7451"\w* \w que|strong="H3808"\w* \w había|strong="H6213"\w* anunciado \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*? \w Si|strong="H3808"\w* \w lo|strong="H3808"\w* matamos, ¡\w nosotros|strong="H3605"\w* mismos \w nos|strong="H5921"\w* buscaremos una desgracia terrible!”.   
\p
\v 20 \w También|strong="H1571"\w* \w hubo|strong="H1961"\w* otro \w hombre|strong="H1121"\w* \w que|strong="H5921"\w* profetizaba \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé: Urías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Semaías|strong="H8098"\w*, \w de|strong="H5921"\w* Quiriat-jearim. \w Él|strong="H5921"\w* \w profetizó|strong="H5012"\w* \w contra|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w y|strong="H1571"\w* \w contra|strong="H5921"\w* \w este|strong="H2063"\w* país \w en|strong="H5921"\w* \w los|strong="H1121"\w* mismos términos \w que|strong="H5921"\w* \w Jeremías|strong="H3414"\w*.  
\v 21 Cuando \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w Joacim|strong="H3079"\w*, sus oficiales y sus \w jefes|strong="H8269"\w* \w oyeron|strong="H8085"\w* sus \w palabras|strong="H1697"\w*, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* intentó \w matarlo|strong="H4191"\w*. Urías se enteró, \w tuvo|strong="H3372"\w* \w miedo|strong="H3372"\w* y \w huyó|strong="H1272"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*.  
\v 22 Pero \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w Joacim|strong="H3079"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* Elnatán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Acbor, acompañado \w de|strong="H1121"\w* otros \w hombres|strong="H1121"\w*.  
\v 23 Ellos \w sacaron|strong="H3318"\w* \w a|strong="H3068"\w* Urías \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w* y lo llevaron ante \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w Joacim|strong="H3079"\w*, quien mandó \w que|strong="H5971"\w* lo mataran \w a|strong="H3068"\w* \w espada|strong="H2719"\w* y \w arrojaran|strong="H7993"\w* su cadáver \w a|strong="H3068"\w* la fosa común.   
\p
\v 24 Sin embargo, Ahicam \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán protegió \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*, evitando así \w que|strong="H5971"\w* \w fuera|strong="H1961"\w* \w entregado|strong="H5414"\w* al \w pueblo|strong="H5971"\w* \w para|strong="H5414"\w* \w que|strong="H5971"\w* lo \w mataran|strong="H4191"\w*.   
\c 27  
\p
\v 1 \w Al|strong="H4428"\w* comienzo del \w reinado|strong="H4428"\w* \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w vino|strong="H1961"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* parte \w de|strong="H1121"\w* Yahvé \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 2 \w Así|strong="H3541"\w* \w me|strong="H5921"\w* \w ha|strong="H3541"\w* dicho Yahvé: “\w Hazte|strong="H6213"\w* \w de|strong="H5921"\w* correas \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w yugos|strong="H4133"\w*, \w y|strong="H5921"\w* póntelos \w al|strong="H5921"\w* \w cuello|strong="H6677"\w*.  
\v 3 Luego envíalos \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Edom, \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Moab|strong="H4124"\w*, \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas, \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Tiro|strong="H6865"\w* y \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Sidón|strong="H6721"\w*, \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w embajadores|strong="H4397"\w* \w que|strong="H1121"\w* han venido \w a|strong="H3068"\w* Jerusalén para ver \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 4 Dales esta \w orden|strong="H6680"\w* para sus señores: “El \w Señor|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, dice \w así|strong="H3541"\w*: “Digan \w a|strong="H3068"\w* sus señores:  
\v 5 ‘\w Yo|strong="H6213"\w* \w hice|strong="H6213"\w* \w la|strong="H5921"\w* tierra, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* hombres \w y|strong="H5921"\w* \w los|strong="H5921"\w* animales \w que|strong="H5921"\w* están \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w con|strong="H5921"\w* \w mi|strong="H5921"\w* \w gran|strong="H1419"\w* \w poder|strong="H3581"\w* \w y|strong="H5921"\w* \w mi|strong="H5921"\w* \w brazo|strong="H2220"\w* \w extendido|strong="H5186"\w*. \w Yo|strong="H6213"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* \w doy|strong="H5414"\w* \w a|strong="H3068"\w* \w quien|strong="H6213"\w* \w me|strong="H5921"\w* parece \w bien|strong="H5869"\w*.  
\v 6 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w* yo he \w entregado|strong="H5414"\w* \w todas|strong="H3605"\w* estas \w tierras|strong="H7704"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Babilonia, mi \w siervo|strong="H5650"\w*. Incluso \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w animales|strong="H2416"\w* del \w campo|strong="H7704"\w* se \w los|strong="H3605"\w* he \w dado|strong="H5414"\w* \w para|strong="H5414"\w* \w que|strong="H6258"\w* le sirvan.  
\v 7 \w Todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w le|strong="H1931"\w* \w servirán|strong="H5647"\w* \w a|strong="H3068"\w* \w él|strong="H1931"\w*, \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w* \w y|strong="H1571"\w* \w al|strong="H5704"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w*, \w hasta|strong="H5704"\w* \w que|strong="H1931"\w* llegue \w el|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5704"\w* \w su|strong="H1931"\w* propia tierra. \w Entonces|strong="H6256"\w* \w muchas|strong="H7227"\w* \w naciones|strong="H1471"\w* \w y|strong="H1571"\w* \w grandes|strong="H1419"\w* \w reyes|strong="H4428"\w* \w lo|strong="H1931"\w* esclavizarán \w a|strong="H3068"\w* \w él|strong="H1931"\w*.   
\p
\v 8 ‘\w Y|strong="H3068"\w* \w sucederá|strong="H1961"\w* \w que|strong="H1931"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w nación|strong="H1471"\w* \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w reino|strong="H4467"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* sirvan \w a|strong="H3068"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w y|strong="H5921"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* pongan \w su|strong="H1931"\w* \w cuello|strong="H6677"\w* bajo \w el|strong="H1931"\w* \w yugo|strong="H5923"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia’, \w dice|strong="H5002"\w* Yahvé, ‘\w los|strong="H5921"\w* castigaré \w con|strong="H5921"\w* \w espada|strong="H2719"\w*, \w con|strong="H5921"\w* \w hambre|strong="H7458"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* peste, \w hasta|strong="H5704"\w* \w que|strong="H1931"\w* \w los|strong="H5921"\w* \w haya|strong="H1961"\w* aniquilado \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w mano|strong="H3027"\w*.  
\v 9 \w Por|strong="H4428"\w* tanto, ustedes \w no|strong="H3808"\w* \w escuchen|strong="H8085"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w profetas|strong="H5030"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w adivinos|strong="H7080"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* soñadores, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w agoreros|strong="H6049"\w* \w o|strong="H3068"\w* hechiceros \w que|strong="H3808"\w* \w les|strong="H1992"\w* dicen: “\w No|strong="H3808"\w* \w servirán|strong="H5647"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Babilonia”;  
\v 10 \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w mentira|strong="H8267"\w*, \w para|strong="H4616"\w* alejarlos \w de|strong="H5921"\w* \w su|strong="H1992"\w* tierra, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w los|strong="H1992"\w* arroje \w y|strong="H3588"\w* ustedes mueran.  
\v 11 Pero \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w nación|strong="H1471"\w* \w que|strong="H5921"\w* someta su \w cuello|strong="H6677"\w* \w al|strong="H5921"\w* \w yugo|strong="H5923"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w sirva|strong="H5647"\w*, \w a|strong="H3068"\w* esa \w nación|strong="H1471"\w* \w la|strong="H5921"\w* dejaré \w en|strong="H5921"\w* su propia tierra — \w dice|strong="H5002"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* — \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* cultive \w y|strong="H5921"\w* viva \w en|strong="H5921"\w* \w ella|strong="H5921"\w*””.   
\p
\v 12 \w Hablé|strong="H1696"\w* también \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w*, conforme \w a|strong="H3068"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*: “Sometan su \w cuello|strong="H6677"\w* \w al|strong="H4428"\w* \w yugo|strong="H5923"\w* del \w rey|strong="H4428"\w* \w de|strong="H5971"\w* Babilonia; sírvanle \w a|strong="H3068"\w* \w él|strong="H3605"\w* y \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w*, y \w vivirán|strong="H2421"\w*.  
\v 13 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w morirán|strong="H4191"\w* tú y tu \w pueblo|strong="H5971"\w* \w por|strong="H4100"\w* la \w espada|strong="H2719"\w*, el \w hambre|strong="H7458"\w* y la peste, tal \w como|strong="H4100"\w* el \w Señor|strong="H3068"\w* \w ha|strong="H3808"\w* \w dicho|strong="H1696"\w* \w de|strong="H5971"\w* la \w nación|strong="H1471"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* \w sirva|strong="H5647"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H5971"\w* Babilonia?  
\v 14 \w No|strong="H3808"\w* \w escuchen|strong="H8085"\w* \w las|strong="H1992"\w* \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w les|strong="H1992"\w* dicen: “\w No|strong="H3808"\w* \w servirán|strong="H5647"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia”, \w porque|strong="H3588"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w mentira|strong="H8267"\w*.  
\v 15 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H1992"\w* \w envié|strong="H7971"\w* — \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* —, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w ellos|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w falsamente|strong="H8267"\w* \w en|strong="H3588"\w* mi \w nombre|strong="H8034"\w*, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w los|strong="H1992"\w* arroje \w y|strong="H3588"\w* perezcan tanto ustedes \w como|strong="H3588"\w* \w los|strong="H1992"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w*.”   
\p
\v 16 \w También|strong="H2088"\w* \w les|strong="H1992"\w* \w dije|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*: \w Así|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w*: “\w No|strong="H3588"\w* \w escuchen|strong="H8085"\w* \w las|strong="H1992"\w* \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* \w sus|strong="H1992"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w diciendo|strong="H1696"\w*: ‘Miren, \w los|strong="H1992"\w* utensilios \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé \w volverán|strong="H7725"\w* \w pronto|strong="H4120"\w* \w de|strong="H3588"\w* Babilonia’; \w porque|strong="H3588"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w mentira|strong="H8267"\w*.  
\v 17 \w No|strong="H1961"\w* \w los|strong="H1961"\w* \w escuchen|strong="H8085"\w*. Sirvan \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Babilonia y \w vivirán|strong="H2421"\w*. ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* ha de \w quedar|strong="H1961"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* en ruinas?  
\v 18 Pero \w si|strong="H4994"\w* \w ellos|strong="H1992"\w* son \w profetas|strong="H5030"\w*, y \w si|strong="H4994"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w está|strong="H3426"\w* con \w ellos|strong="H1992"\w*, \w que|strong="H4994"\w* intercedan \w ahora|strong="H4994"\w* ante Yahvé \w de|strong="H1697"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w* para \w que|strong="H4994"\w* \w los|strong="H1992"\w* utensilios \w que|strong="H4994"\w* han quedado en la \w casa|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé, en la \w casa|strong="H1004"\w* del \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* y en Jerusalén, \w no|strong="H1115"\w* sean llevados \w a|strong="H3068"\w* Babilonia.  
\v 19 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w columnas|strong="H5982"\w*, \w del|strong="H5921"\w* estanque \w de|strong="H5921"\w* bronce, \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w basas|strong="H4350"\w* \w y|strong="H3588"\w* \w del|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* utensilios \w que|strong="H3588"\w* quedan \w en|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*,  
\v 20 \w los|strong="H1121"\w* cuales \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w llevó|strong="H3947"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia, cuando transportó \w de|strong="H1121"\w* Jerusalén \w a|strong="H3068"\w* Babilonia \w a|strong="H3068"\w* Jeconías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, junto con \w todos|strong="H3605"\w* \w los|strong="H1121"\w* nobles \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w de|strong="H1121"\w* Jerusalén;  
\v 21 \w sí|strong="H3588"\w*, \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* utensilios \w que|strong="H3588"\w* \w quedaron|strong="H3498"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* Jerusalén:  
\v 22 ‘\w Serán|strong="H1961"\w* llevados \w a|strong="H3068"\w* Babilonia, \w y|strong="H5704"\w* \w allá|strong="H8033"\w* \w se|strong="H1961"\w* quedarán \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H5704"\w* yo \w los|strong="H1961"\w* visite — \w dice|strong="H5002"\w* Yahvé —; \w entonces|strong="H3117"\w* \w los|strong="H1961"\w* haré traer \w y|strong="H5704"\w* \w los|strong="H1961"\w* restauraré \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.’”   
\c 28  
\p
\v 1 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w año|strong="H8141"\w*, \w al|strong="H4428"\w* \w principio|strong="H7225"\w* del \w reinado|strong="H4428"\w* \w de|strong="H1121"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, en \w el|strong="H1931"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w*, en \w el|strong="H1931"\w* \w quinto|strong="H2549"\w* \w mes|strong="H2320"\w*, \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Azur|strong="H5809"\w*, \w que|strong="H1931"\w* \w era|strong="H1961"\w* \w de|strong="H1121"\w* \w Gabaón|strong="H1391"\w*, me habló en \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé ante \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* y \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w*. Dijo:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: ‘He roto el \w yugo|strong="H5923"\w* del \w rey|strong="H4428"\w* de Babilonia.  
\v 3 \w Dentro|strong="H5750"\w* \w de|strong="H4480"\w* \w dos|strong="H8141"\w* \w años|strong="H8141"\w* exactos traeré \w de|strong="H4480"\w* vuelta \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé \w que|strong="H4480"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia, \w se|strong="H4480"\w* \w llevó|strong="H3947"\w* \w de|strong="H4480"\w* \w aquí|strong="H2088"\w* \w a|strong="H3068"\w* Babilonia.  
\v 4 \w También|strong="H2088"\w* regresaré \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* Jeconías \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Joacim|strong="H3079"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* desterrados \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w que|strong="H3588"\w* se fueron \w a|strong="H3068"\w* Babilonia — \w dice|strong="H5002"\w* Yahvé —, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* romperé \w el|strong="H3588"\w* \w yugo|strong="H5923"\w* del \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia’”.   
\p
\v 5 Entonces \w el|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w le|strong="H5869"\w* respondió al \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w* \w delante|strong="H5869"\w* \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w de|strong="H5971"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w estaba|strong="H5975"\w* \w en|strong="H5975"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé.  
\v 6 \w El|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* dijo: “¡Amén! ¡\w Que|strong="H1697"\w* \w así|strong="H3651"\w* \w lo|strong="H1697"\w* \w haga|strong="H6213"\w* Yahvé! \w Que|strong="H1697"\w* Yahvé \w cumpla|strong="H6965"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* has \w profetizado|strong="H5012"\w* y \w haga|strong="H6213"\w* \w volver|strong="H7725"\w* \w de|strong="H1697"\w* Babilonia \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w los|strong="H3605"\w* utensilios \w de|strong="H1697"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* desterrados.  
\v 7 Pero \w escucha|strong="H8085"\w* \w ahora|strong="H4994"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w que|strong="H4994"\w* digo \w a|strong="H3068"\w* tus \w oídos|strong="H8085"\w* y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w oídos|strong="H8085"\w* \w de|strong="H5971"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*:  
\v 8 \w Los|strong="H5921"\w* \w profetas|strong="H5030"\w* \w que|strong="H4480"\w* \w estuvieron|strong="H1961"\w* \w antes|strong="H6440"\w* \w de|strong="H4480"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w antes|strong="H6440"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w* \w en|strong="H5921"\w* tiempos \w antiguos|strong="H5769"\w*, \w profetizaron|strong="H5012"\w* \w contra|strong="H5921"\w* \w muchas|strong="H7227"\w* tierras \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w grandes|strong="H1419"\w* \w reinos|strong="H4467"\w* \w sobre|strong="H5921"\w* \w guerra|strong="H4421"\w*, calamidad \w y|strong="H5921"\w* peste.  
\v 9 En cuanto al \w profeta|strong="H5030"\w* \w que|strong="H3045"\w* \w profetiza|strong="H5012"\w* \w paz|strong="H7965"\w*, solo cuando su \w palabra|strong="H1697"\w* \w se|strong="H3045"\w* cumpla \w se|strong="H3045"\w* reconocerá \w que|strong="H3045"\w* Yahvé realmente \w lo|strong="H1697"\w* \w envió|strong="H7971"\w*”.   
\p
\v 10 Entonces \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w* \w le|strong="H5921"\w* \w quitó|strong="H3947"\w* \w el|strong="H5921"\w* \w yugo|strong="H5921"\w* \w del|strong="H5921"\w* \w cuello|strong="H6677"\w* \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* rompió.  
\v 11 \w Y|strong="H3068"\w* \w Hananías|strong="H2608"\w* dijo ante \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*: “\w Así|strong="H3541"\w* dice Yahvé: ‘\w De|strong="H5921"\w* \w esta|strong="H5921"\w* misma manera, \w dentro|strong="H5750"\w* \w de|strong="H5921"\w* \w dos|strong="H8141"\w* \w años|strong="H8141"\w* exactos, romperé \w el|strong="H5921"\w* \w yugo|strong="H5923"\w* \w que|strong="H5921"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w ha|strong="H3541"\w* puesto \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w cuello|strong="H6677"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*’”. \w Y|strong="H3068"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w se|strong="H5921"\w* \w fue|strong="H3212"\w* \w por|strong="H5921"\w* su \w camino|strong="H1870"\w*.   
\p
\v 12 \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w* rompió \w el|strong="H5921"\w* \w yugo|strong="H5921"\w* \w del|strong="H5921"\w* \w cuello|strong="H6677"\w* \w del|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w*, \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 13 “\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* dile \w a|strong="H3068"\w* \w Hananías|strong="H2608"\w* \w que|strong="H3541"\w* \w así|strong="H3541"\w* dice Yahvé: ‘\w Tú|strong="H6213"\w* rompiste un \w yugo|strong="H4133"\w* \w de|strong="H8478"\w* \w madera|strong="H6086"\w*, pero \w en|strong="H8478"\w* su \w lugar|strong="H8478"\w* has \w hecho|strong="H6213"\w* un \w yugo|strong="H4133"\w* \w de|strong="H8478"\w* \w hierro|strong="H1270"\w*’.  
\v 14 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘He \w puesto|strong="H3588"\w* un \w yugo|strong="H5923"\w* \w de|strong="H5921"\w* \w hierro|strong="H1270"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w cuello|strong="H6677"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* estas \w naciones|strong="H1471"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* sirvan \w a|strong="H3068"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia; \w y|strong="H1571"\w* tendrán \w que|strong="H3588"\w* servirle. \w Hasta|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* \w del|strong="H5921"\w* \w campo|strong="H7704"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* he \w entregado|strong="H5414"\w*’”.   
\p
\v 15 Entonces \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w*: “¡\w Escucha|strong="H8085"\w*, \w Hananías|strong="H2608"\w*! Yahvé \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w*, \w y|strong="H5921"\w* tú has hecho \w que|strong="H3808"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* confíe \w en|strong="H5921"\w* una \w mentira|strong="H8267"\w*.  
\v 16 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé: ‘\w Te|strong="H5921"\w* voy \w a|strong="H3068"\w* quitar \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra. Este mismo \w año|strong="H8141"\w* \w morirás|strong="H4191"\w*, \w porque|strong="H3588"\w* \w has|strong="H4191"\w* incitado \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w rebelión|strong="H5627"\w* \w contra|strong="H5921"\w* Yahvé’”.   
\p
\v 17 \w Y|strong="H3068"\w* \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w Hananías|strong="H2608"\w* \w murió|strong="H4191"\w* \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w año|strong="H8141"\w*, en \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w mes|strong="H2320"\w*.   
\c 29  
\p
\v 1 Estas son las \w palabras|strong="H1697"\w* \w de|strong="H5971"\w* \w la|strong="H3605"\w* \w carta|strong="H5612"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w envió|strong="H7971"\w* desde Jerusalén al \w resto|strong="H3499"\w* \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* del exilio, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w Nabucodonosor|strong="H5019"\w* había llevado cautivo \w de|strong="H5971"\w* Jerusalén \w a|strong="H3068"\w* Babilonia.  
\v 2 Esto sucedió después \w de|strong="H8269"\w* que \w salieron|strong="H3318"\w* \w de|strong="H8269"\w* Jerusalén el \w rey|strong="H4428"\w* Jeconías y la \w reina|strong="H4428"\w* madre, los oficiales \w de|strong="H8269"\w* la corte, los \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w* y \w de|strong="H8269"\w* Jerusalén, los artesanos y los herreros.  
\v 3 La carta \w fue|strong="H3063"\w* enviada \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* Elasá \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán y \w de|strong="H1121"\w* Gemarías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hilcías|strong="H2518"\w*, \w a|strong="H3068"\w* quienes Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Babilonia para presentarse ante \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia. Decía:   
\mi
\v 4 “\w Así|strong="H3541"\w* dice Yahvé de \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* hice transportar de Jerusalén \w a|strong="H3068"\w* Babilonia:  
\v 5 ‘Construyan \w casas|strong="H1004"\w* y \w habiten|strong="H3427"\w* en ellas; planten \w huertos|strong="H1593"\w* y coman de su \w fruto|strong="H6529"\w*.  
\v 6 Cásense y tengan \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*; den \w mujeres|strong="H1323"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* y den sus \w hijas|strong="H1323"\w* en matrimonio \w para|strong="H5414"\w* \w que|strong="H1121"\w* también ellas tengan \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*. Multiplíquense \w allá|strong="H8033"\w* y no disminuyan.  
\v 7 Busquen \w el|strong="H3588"\w* bienestar \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* hice transportar, \w y|strong="H3588"\w* rueguen \w por|strong="H3588"\w* \w ella|strong="H8033"\w* \w a|strong="H3068"\w* Yahvé; \w porque|strong="H3588"\w* \w si|strong="H3588"\w* \w ella|strong="H8033"\w* \w tiene|strong="H1961"\w* \w paz|strong="H7965"\w*, también ustedes \w la|strong="H3588"\w* \w tendrán|strong="H1961"\w*’.  
\v 8 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: ‘\w No|strong="H3588"\w* dejen \w que|strong="H3588"\w* \w los|strong="H3588"\w* engañen sus \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* están \w entre|strong="H7130"\w* ustedes, ni sus \w adivinos|strong="H7080"\w*; ni presten atención \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w sueños|strong="H2472"\w* \w que|strong="H3588"\w* ellos sueñan.  
\v 9 \w Porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w les|strong="H1992"\w* \w profetizan|strong="H5012"\w* \w mentiras|strong="H8267"\w* \w en|strong="H3588"\w* mi \w nombre|strong="H8034"\w*. \w Yo|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H1992"\w* he \w enviado|strong="H7971"\w*’, \w dice|strong="H5002"\w* Yahvé.  
\v 10 \w Pues|strong="H3588"\w* \w así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: ‘\w Cuando|strong="H3588"\w* \w se|strong="H5921"\w* cumplan \w los|strong="H5921"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w* \w de|strong="H5921"\w* Babilonia, \w yo|strong="H3588"\w* \w los|strong="H5921"\w* \w visitaré|strong="H6485"\w* \w y|strong="H3588"\w* cumpliré \w mi|strong="H5921"\w* \w buena|strong="H2896"\w* promesa \w en|strong="H5921"\w* favor \w de|strong="H5921"\w* ustedes, \w para|strong="H5921"\w* hacerlos \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 11 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w los|strong="H5921"\w* planes \w que|strong="H3588"\w* \w tengo|strong="H2803"\w* \w para|strong="H5921"\w* ustedes — \w dice|strong="H5002"\w* Yahvé —, planes \w de|strong="H5921"\w* bienestar \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w de|strong="H5921"\w* calamidad, \w para|strong="H5921"\w* darles un futuro \w y|strong="H3588"\w* una \w esperanza|strong="H8615"\w*.  
\v 12 Entonces ustedes me invocarán, vendrán y orarán \w a|strong="H3068"\w* mí, y yo los \w escucharé|strong="H8085"\w*.  
\v 13 \w Me|strong="H3588"\w* \w buscarán|strong="H1245"\w* \w y|strong="H3588"\w* \w me|strong="H3588"\w* hallarán, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* \w buscarán|strong="H1245"\w* \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*.  
\v 14 Me dejaré \w hallar|strong="H4672"\w* de ustedes — \w dice|strong="H5002"\w* Yahvé —, y restauraré su bienestar; \w los|strong="H3605"\w* reuniré de \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* y de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* adonde \w los|strong="H3605"\w* arrojé, \w dice|strong="H5002"\w* Yahvé, y \w los|strong="H3605"\w* haré \w volver|strong="H7725"\w* al \w lugar|strong="H4725"\w* de \w donde|strong="H8033"\w* \w los|strong="H3605"\w* hice transportar’.   
\mi
\v 15 \w Pero|strong="H3588"\w* \w como|strong="H3588"\w* ustedes han dicho: ‘Yahvé nos ha levantado \w profetas|strong="H5030"\w* \w en|strong="H3588"\w* Babilonia’,  
\v 16 \w así|strong="H3541"\w* dice Yahvé acerca del \w rey|strong="H4428"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* sienta \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w trono|strong="H3678"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w*, \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* vive \w en|strong="H3588"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w es|strong="H3588"\w* decir, \w de|strong="H3588"\w* sus hermanos \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w salieron|strong="H3318"\w* \w con|strong="H3588"\w* ustedes \w al|strong="H4428"\w* exilio;  
\v 17 \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5414"\w* los \w Ejércitos|strong="H6635"\w*: ‘Miren, yo \w envío|strong="H7971"\w* contra ellos \w espada|strong="H2719"\w*, \w hambre|strong="H7458"\w* \w y|strong="H3541"\w* peste, \w y|strong="H3541"\w* los \w pondré|strong="H5414"\w* como esos \w higos|strong="H8384"\w* podridos \w que|strong="H3808"\w* \w de|strong="H5414"\w* tan malos \w no|strong="H3808"\w* \w se|strong="H3808"\w* pueden comer.  
\v 18 \w Los|strong="H3605"\w* \w perseguiré|strong="H7291"\w* con \w espada|strong="H2719"\w*, \w hambre|strong="H7458"\w* y peste, y \w haré|strong="H5414"\w* \w que|strong="H3605"\w* sean motivo \w de|strong="H5414"\w* \w espanto|strong="H8047"\w* \w para|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H5414"\w* \w la|strong="H3605"\w* tierra; serán objeto \w de|strong="H5414"\w* maldición, \w de|strong="H5414"\w* horror, \w de|strong="H5414"\w* burla y \w de|strong="H5414"\w* vergüenza \w entre|strong="H8033"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* adonde \w los|strong="H3605"\w* he arrojado.  
\v 19 \w Esto|strong="H1697"\w* sucederá \w porque|strong="H3808"\w* \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* mis \w palabras|strong="H1697"\w* — \w dice|strong="H5002"\w* Yahvé —, las cuales les \w envié|strong="H7971"\w* \w por|strong="H8478"\w* medio \w de|strong="H8478"\w* mis \w siervos|strong="H5650"\w* los \w profetas|strong="H5030"\w* una y otra vez; pero ustedes \w no|strong="H3808"\w* quisieron \w escuchar|strong="H8085"\w*’, \w dice|strong="H5002"\w* Yahvé.   
\mi
\v 20 \w Escuchen|strong="H8085"\w*, \w pues|strong="H7971"\w*, \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, \w todos|strong="H3605"\w* ustedes \w los|strong="H3605"\w* del exilio \w que|strong="H1697"\w* \w envié|strong="H7971"\w* \w de|strong="H1697"\w* Jerusalén \w a|strong="H3068"\w* Babilonia.  
\v 21 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, acerca \w de|strong="H1121"\w* Acab \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Colaías \w y|strong="H3541"\w* \w de|strong="H1121"\w* Sedequías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Maasías|strong="H4641"\w*, \w que|strong="H1121"\w* les \w profetizan|strong="H5012"\w* \w mentira|strong="H8267"\w* \w en|strong="H5221"\w* mi \w nombre|strong="H8034"\w*: ‘Miren, yo \w los|strong="H1121"\w* \w entrego|strong="H5414"\w* \w en|strong="H5221"\w* \w manos|strong="H3027"\w* \w de|strong="H1121"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia, \w y|strong="H3541"\w* \w él|strong="H1121"\w* \w los|strong="H1121"\w* matará ante \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H1121"\w* ustedes.  
\v 22 De \w ellos|strong="H1992"\w* \w se|strong="H1992"\w* \w tomará|strong="H3947"\w* \w esta|strong="H1992"\w* \w maldición|strong="H7045"\w* entre \w todos|strong="H3605"\w* \w los|strong="H1992"\w* desterrados de \w Judá|strong="H3063"\w* \w que|strong="H1992"\w* están en Babilonia: “¡\w Que|strong="H1992"\w* Yahvé te trate como \w a|strong="H3068"\w* Sedequías y como \w a|strong="H3068"\w* Acab, \w a|strong="H3068"\w* quienes \w el|strong="H3605"\w* \w rey|strong="H4428"\w* de Babilonia asó \w al|strong="H4428"\w* fuego!”;  
\v 23 \w porque|strong="H3282"\w* \w cometieron|strong="H6213"\w* infamias en \w Israel|strong="H3478"\w*: \w cometieron|strong="H6213"\w* adulterio con las mujeres \w de|strong="H1697"\w* sus \w prójimos|strong="H7453"\w* y \w hablaron|strong="H1696"\w* \w falsamente|strong="H8267"\w* en mi \w nombre|strong="H8034"\w* \w palabras|strong="H1697"\w* \w que|strong="H3808"\w* \w yo|strong="H6680"\w* \w no|strong="H3808"\w* \w les|strong="H6680"\w* \w mandé|strong="H6680"\w*. \w Yo|strong="H6680"\w* soy \w el|strong="H6213"\w* \w que|strong="H3808"\w* \w sabe|strong="H3045"\w* y soy \w testigo|strong="H5707"\w*’, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 24 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w Semaías|strong="H8098"\w* el nehelamita le dirás:  
\v 25 “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: ‘\w Por|strong="H3282"\w* \w cuanto|strong="H3282"\w* \w enviaste|strong="H7971"\w* en tu \w nombre|strong="H8034"\w* \w cartas|strong="H5612"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* está en Jerusalén, al \w sacerdote|strong="H3548"\w* \w Sofonías|strong="H6846"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Maasías|strong="H4641"\w* \w y|strong="H3541"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, diciendo:  
\v 26 “Yahvé te ha \w puesto|strong="H5414"\w* \w como|strong="H1961"\w* \w sacerdote|strong="H3548"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* del \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*, \w para|strong="H5414"\w* \w que|strong="H1961"\w* \w seas|strong="H1961"\w* \w el|strong="H3605"\w* encargado \w en|strong="H8478"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H8478"\w* Yahvé \w de|strong="H8478"\w* vigilar \w a|strong="H3068"\w* \w todo|strong="H3605"\w* hombre loco \w que|strong="H1961"\w* \w se|strong="H1961"\w* las \w dé|strong="H8478"\w* \w de|strong="H8478"\w* profeta, y \w lo|strong="H3605"\w* \w pongas|strong="H5414"\w* \w en|strong="H8478"\w* \w el|strong="H3605"\w* \w cepo|strong="H4115"\w* y \w en|strong="H8478"\w* \w el|strong="H3605"\w* calabozo.  
\v 27 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w*, entonces, \w no|strong="H3808"\w* has \w reprendido|strong="H1605"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* de Anatot, \w que|strong="H4100"\w* \w se|strong="H3808"\w* hace pasar \w por|strong="H4100"\w* profeta ante ustedes?  
\v 28 \w Pues|strong="H3588"\w* \w él|strong="H1931"\w* \w nos|strong="H5921"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decir \w a|strong="H3068"\w* Babilonia: \w El|strong="H1931"\w* exilio \w será|strong="H1931"\w* largo; construyan \w casas|strong="H1004"\w* \w y|strong="H3588"\w* \w habiten|strong="H3427"\w* \w en|strong="H5921"\w* \w ellas|strong="H5921"\w*; planten \w huertos|strong="H1593"\w* \w y|strong="H3588"\w* coman \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w fruto|strong="H6529"\w*” ’.   
\p
\v 29 \w El|strong="H5030"\w* \w sacerdote|strong="H3548"\w* \w Sofonías|strong="H6846"\w* \w leyó|strong="H7121"\w* \w esta|strong="H2088"\w* \w carta|strong="H5612"\w* ante \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w*.  
\v 30 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 31 “\w Envía|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* exiliados: ‘\w Así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Semaías|strong="H8098"\w* \w el|strong="H5921"\w* nehelamita: \w Por|strong="H5921"\w* \w cuanto|strong="H3282"\w* \w Semaías|strong="H8098"\w* \w les|strong="H5921"\w* \w profetizó|strong="H5012"\w* \w sin|strong="H3808"\w* \w que|strong="H3808"\w* yo \w lo|strong="H3808"\w* hubiera \w enviado|strong="H7971"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* hizo confiar \w en|strong="H5921"\w* una \w mentira|strong="H8267"\w*,  
\v 32 \w por|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé: \w Yo|strong="H3588"\w* castigaré \w a|strong="H3068"\w* \w Semaías|strong="H8098"\w* \w el|strong="H5921"\w* nehelamita \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w descendencia|strong="H2233"\w*. \w No|strong="H3808"\w* \w tendrá|strong="H1961"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* suyos \w que|strong="H3588"\w* viva \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, \w ni|strong="H3808"\w* \w verá|strong="H7200"\w* \w el|strong="H5921"\w* \w bien|strong="H2896"\w* \w que|strong="H3588"\w* \w haré|strong="H6213"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* — \w dice|strong="H5002"\w* Yahvé —, \w porque|strong="H3588"\w* \w ha|strong="H3541"\w* incitado \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w rebelión|strong="H5627"\w* \w contra|strong="H5921"\w* Yahvé’”.   
\c 30  
\p
\v 1 \w Palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w que|strong="H1697"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*, diciendo:  
\v 2 “\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*: ‘\w Escribe|strong="H3789"\w* en un \w libro|strong="H5612"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* te he \w hablado|strong="H1696"\w*.  
\v 3 \w Porque|strong="H3588"\w* vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H3588"\w* \w que|strong="H3588"\w* cambiaré \w la|strong="H3588"\w* suerte \w de|strong="H3588"\w* \w mi|strong="H2009"\w* \w pueblo|strong="H5971"\w*, \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w Judá|strong="H3063"\w* — \w dice|strong="H5002"\w* Yahvé —. \w Los|strong="H3588"\w* \w haré|strong="H5414"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados, \w y|strong="H3588"\w* ellos \w la|strong="H3588"\w* \w poseerán|strong="H3423"\w*’”.   
\p
\v 4 Estas son las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé \w habló|strong="H1696"\w* \w acerca|strong="H1697"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w* y \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*.  
\v 5 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Hemos \w oído|strong="H8085"\w* un grito \w de|strong="H3588"\w* \w terror|strong="H6343"\w*;  
\q2 hay pánico \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w paz|strong="H7965"\w*.   
\q1
\v 6 Pregunten \w ahora|strong="H4994"\w* \w y|strong="H5921"\w* \w vean|strong="H7200"\w*: ¿Acaso puede un \w hombre|strong="H1397"\w* dar \w a|strong="H3068"\w* luz?  
\q2 ¿\w Por|strong="H5921"\w* \w qué|strong="H4994"\w*, entonces, \w veo|strong="H7200"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w hombres|strong="H1397"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* cintura, \w como|strong="H4069"\w* mujer \w de|strong="H5921"\w* parto,  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w qué|strong="H4994"\w* \w se|strong="H5921"\w* han puesto \w pálidos|strong="H3420"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w rostros|strong="H6440"\w*?   
\q1
\v 7 ¡\w Ay|strong="H1945"\w*, \w qué|strong="H3588"\w* \w grande|strong="H1419"\w* \w es|strong="H1931"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*! \w No|strong="H3588"\w* hay otro igual.  
\q2 \w Es|strong="H1931"\w* un \w tiempo|strong="H6256"\w* \w de|strong="H4480"\w* \w angustia|strong="H6869"\w* \w para|strong="H3588"\w* \w Jacob|strong="H3290"\w*,  
\q2 \w pero|strong="H3588"\w* \w de|strong="H4480"\w* \w ella|strong="H1931"\w* \w será|strong="H1931"\w* librado.   
\q1
\v 8 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* —, romperé \w el|strong="H1931"\w* \w yugo|strong="H5923"\w* \w de|strong="H5921"\w* tu \w cuello|strong="H6677"\w*  
\q2 \w y|strong="H5921"\w* haré pedazos tus correas.  
\q2 \w Los|strong="H5921"\w* extranjeros \w no|strong="H3808"\w* volverán \w a|strong="H3068"\w* esclavizarlo.   
\q1
\v 9 En cambio, \w servirán|strong="H5647"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*,  
\q2 y \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w su|strong="H1992"\w* \w rey|strong="H4428"\w*,  
\q2 \w a|strong="H3068"\w* quien yo \w les|strong="H1992"\w* \w levantaré|strong="H6965"\w*.   
\q1
\v 10 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* tú, \w siervo|strong="H5650"\w* mío \w Jacob|strong="H3290"\w*, \w no|strong="H3588"\w* \w temas|strong="H3372"\w* — \w dice|strong="H5002"\w* Yahvé —;  
\q2 ni \w te|strong="H3588"\w* desanimes, \w Israel|strong="H3478"\w*.  
\q1 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w salvaré|strong="H3467"\w* desde \w lejos|strong="H7350"\w*,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w su|strong="H3588"\w* exilio.  
\q1 \w Jacob|strong="H3290"\w* \w volverá|strong="H7725"\w* \w y|strong="H3588"\w* vivirá tranquilo,  
\q2 estará \w en|strong="H3588"\w* paz \w y|strong="H3588"\w* \w no|strong="H3588"\w* habrá quien \w lo|strong="H7350"\w* asuste.   
\q1
\v 11 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w contigo|strong="H8033"\w* \w para|strong="H3588"\w* salvarte — \w dice|strong="H5002"\w* Yahvé —.  
\q2 Destruiré \w por|strong="H3588"\w* completo \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w entre|strong="H3808"\w* las cuales \w te|strong="H3588"\w* dispersé;  
\q2 \w pero|strong="H3588"\w* \w a|strong="H3068"\w* ti \w no|strong="H3808"\w* \w te|strong="H3588"\w* destruiré \w por|strong="H3588"\w* completo,  
\q1 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w castigaré|strong="H3256"\w* \w con|strong="H3588"\w* \w justicia|strong="H4941"\w*;  
\q2 \w pues|strong="H3588"\w* \w de|strong="H3588"\w* \w ninguna|strong="H3605"\w* manera \w te|strong="H3588"\w* dejaré \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w*”.   
\p
\v 12 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé:  
\q1 “Tu herida \w es|strong="H3588"\w* incurable,  
\q2 \w y|strong="H3588"\w* tu \w llaga|strong="H4347"\w* \w es|strong="H3588"\w* gravísima.   
\q1
\v 13 No hay quien defienda tu \w causa|strong="H1779"\w* ni quien vende tu herida;  
\q2 no hay para ti medicina que te sane.   
\q1
\v 14 \w Todos|strong="H3605"\w* tus amantes \w te|strong="H5921"\w* han olvidado,  
\q2 ya \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w buscan|strong="H1875"\w*.  
\q1 \w Pues|strong="H3588"\w* \w te|strong="H5921"\w* \w herí|strong="H5221"\w* \w como|strong="H3588"\w* \w hiere|strong="H5221"\w* un enemigo, \w con|strong="H5921"\w* \w el|strong="H5921"\w* castigo \w de|strong="H5921"\w* un hombre cruel,  
\q2 \w por|strong="H5921"\w* \w la|strong="H5921"\w* gravedad \w de|strong="H5921"\w* tu \w maldad|strong="H5771"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* tus \w muchos|strong="H7230"\w* \w pecados|strong="H2403"\w*.   
\q1
\v 15 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w gritas|strong="H2199"\w* \w a|strong="H3068"\w* causa \w de|strong="H5921"\w* \w tu|strong="H6213"\w* herida?  
\q2 \w Tu|strong="H6213"\w* \w dolor|strong="H4341"\w* es incurable.  
\q1 \w Por|strong="H5921"\w* \w la|strong="H5921"\w* magnitud \w de|strong="H5921"\w* \w tu|strong="H6213"\w* \w maldad|strong="H5771"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* tus \w muchos|strong="H7230"\w* \w pecados|strong="H2403"\w*  
\q2 \w te|strong="H5921"\w* he \w hecho|strong="H6213"\w* \w esto|strong="H6213"\w*.   
\q1
\v 16 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* te devoran \w serán|strong="H1961"\w* devorados;  
\q2 \w todos|strong="H3605"\w* tus \w enemigos|strong="H6862"\w* \w irán|strong="H3212"\w* al \w cautiverio|strong="H7628"\w*.  
\q1 \w Los|strong="H3605"\w* \w que|strong="H1961"\w* te saqueen \w serán|strong="H1961"\w* saqueados,  
\q2 y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* te despojan \w los|strong="H3605"\w* \w entregaré|strong="H5414"\w* al despojo.   
\q1
\v 17 \w Pero|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* devolveré \w la|strong="H1931"\w* salud  
\q2 \w y|strong="H3588"\w* \w sanaré|strong="H7495"\w* tus \w heridas|strong="H4347"\w* — \w dice|strong="H5002"\w* Yahvé —;  
\q1 \w porque|strong="H3588"\w* \w te|strong="H3588"\w* \w llamaron|strong="H7121"\w* ‘\w La|strong="H1931"\w* Desechada’, diciendo:  
\q2 ‘\w Esta|strong="H1931"\w* \w es|strong="H1931"\w* \w Sión|strong="H6726"\w*, \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w que|strong="H3588"\w* nadie \w se|strong="H1931"\w* acuerda’”.   
\p
\v 18 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Yo restauraré \w el|strong="H5921"\w* bienestar \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w tiendas|strong="H4908"\w* \w de|strong="H5921"\w* \w Jacob|strong="H3290"\w*  
\q2 \w y|strong="H5921"\w* tendré compasión \w de|strong="H5921"\w* sus \w moradas|strong="H4908"\w*.  
\q1 \w La|strong="H5921"\w* \w ciudad|strong="H5892"\w* será reconstruida \w sobre|strong="H5921"\w* sus ruinas,  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* palacio \w se|strong="H5921"\w* levantará \w en|strong="H5921"\w* su lugar debido.   
\q1
\v 19 De \w ellos|strong="H1992"\w* \w saldrán|strong="H3318"\w* cantos de gratitud  
\q2 y \w voces|strong="H6963"\w* de gente alegre.  
\q1 \w Los|strong="H1992"\w* \w multiplicaré|strong="H7235"\w* y \w no|strong="H3808"\w* disminuirán;  
\q2 \w los|strong="H1992"\w* honraré y \w no|strong="H3808"\w* \w serán|strong="H1992"\w* despreciados.   
\q1
\v 20 Sus \w hijos|strong="H1121"\w* \w serán|strong="H1961"\w* \w como|strong="H1961"\w* \w antes|strong="H6440"\w*,  
\q2 su asamblea \w se|strong="H1961"\w* mantendrá \w firme|strong="H3559"\w* \w ante|strong="H6440"\w* \w mí|strong="H5921"\w*,  
\q2 \w y|strong="H5921"\w* castigaré \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus opresores.   
\q1
\v 21 \w Su|strong="H1931"\w* líder \w será|strong="H1961"\w* uno \w de|strong="H4480"\w* \w ellos|strong="H1931"\w* mismos,  
\q2 \w de|strong="H4480"\w* \w en|strong="H4480"\w* \w medio|strong="H7130"\w* \w de|strong="H4480"\w* \w ellos|strong="H1931"\w* \w saldrá|strong="H3318"\w* \w su|strong="H1931"\w* gobernante.  
\q1 \w Yo|strong="H4480"\w* \w lo|strong="H1931"\w* haré acercarse \w y|strong="H3588"\w* \w él|strong="H1931"\w* \w vendrá|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*;  
\q2 \w porque|strong="H3588"\w* ¿\w quién|strong="H4310"\w* \w se|strong="H1961"\w* atrevería \w por|strong="H3588"\w* \w sí|strong="H3588"\w* \w mismo|strong="H1931"\w* \w a|strong="H3068"\w* acercarse \w a|strong="H3068"\w* \w mí|strong="H1961"\w*? — \w dice|strong="H5002"\w* Yahvé —.   
\q1
\v 22 Ustedes \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*,  
\q2 y yo \w seré|strong="H1961"\w* su Dios.   
\q1
\v 23 ¡Miren! \w La|strong="H5921"\w* tormenta \w de|strong="H5921"\w* Yahvé \w sale|strong="H3318"\w* \w con|strong="H5921"\w* furia;  
\q2 un torbellino arrollador descarga \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* malvados.   
\q1
\v 24 La \w ira|strong="H2740"\w* ardiente \w de|strong="H5704"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H3808"\w* calmará \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* haya realizado  
\q2 \w y|strong="H5704"\w* \w cumplido|strong="H6213"\w* los propósitos \w de|strong="H5704"\w* su \w corazón|strong="H3820"\w*.  
\q2 \w En|strong="H5704"\w* los \w días|strong="H3117"\w* venideros ustedes entenderán \w esto|strong="H6213"\w*”.   
\c 31  
\p
\v 1 “En \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* — \w dice|strong="H5002"\w* Yahvé —, yo \w seré|strong="H1961"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* \w todas|strong="H3605"\w* \w las|strong="H1992"\w* \w familias|strong="H4940"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*, y \w ellos|strong="H1992"\w* \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*”.   
\p
\v 2 \w Así|strong="H3541"\w* dice Yahvé: “El \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* sobrevivió \w a|strong="H3068"\w* la \w espada|strong="H2719"\w* \w halló|strong="H4672"\w* \w gracia|strong="H2580"\w* en el \w desierto|strong="H4057"\w*; cuando \w Israel|strong="H3478"\w* caminaba hacia su descanso”.   
\p
\v 3 Yahvé \w se|strong="H5921"\w* \w me|strong="H5921"\w* \w apareció|strong="H7200"\w* hace mucho tiempo, diciendo:  
\q1 “\w Con|strong="H5921"\w* amor \w eterno|strong="H5769"\w* \w te|strong="H5921"\w* he amado;  
\q2 \w por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w te|strong="H5921"\w* he extendido \w mi|strong="H5921"\w* bondad.   
\q1
\v 4 \w Aún|strong="H5750"\w* te reconstruiré, y serás reconstruida, oh \w virgen|strong="H1330"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*.  
\q1 Volverás \w a|strong="H3068"\w* adornarte con tus panderetas  
\q2 y \w saldrás|strong="H3318"\w* \w en|strong="H3318"\w* las danzas \w de|strong="H5750"\w* los que se alegran.   
\q1
\v 5 Volverás \w a|strong="H3068"\w* plantar viñedos \w en|strong="H5750"\w* los \w montes|strong="H2022"\w* \w de|strong="H5750"\w* \w Samaria|strong="H8111"\w*;  
\q2 los que plantan \w plantarán|strong="H5193"\w*,  
\q2 y disfrutarán \w de|strong="H5750"\w* la cosecha.   
\q1
\v 6 \w Porque|strong="H3588"\w* \w vendrá|strong="H5927"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w en|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* centinelas gritarán \w en|strong="H3588"\w* \w los|strong="H3588"\w* \w montes|strong="H2022"\w* \w de|strong="H3588"\w* Efraín:  
\q2 ‘¡\w Levántense|strong="H6965"\w*, \w y|strong="H3588"\w* \w subamos|strong="H5927"\w* \w a|strong="H3068"\w* \w Sión|strong="H6726"\w*, \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w*!’”.   
\p
\v 7 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé:  
\q1 “\w Canten|strong="H7442"\w* \w con|strong="H3588"\w* \w alegría|strong="H8057"\w* \w por|strong="H3588"\w* \w Jacob|strong="H3290"\w*  
\q2 \w y|strong="H3588"\w* den gritos \w de|strong="H3588"\w* júbilo \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w*.  
\q1 Anuncien, \w alaben|strong="H1984"\w* \w y|strong="H3588"\w* digan:  
\q2 ‘¡Oh Yahvé, \w salva|strong="H3467"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*,  
\q2 al \w resto|strong="H7611"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*!’.   
\q1
\v 8 Miren, yo los traigo del país del \w norte|strong="H6828"\w*  
\q2 y los reuniré de los confines de la tierra;  
\q1 entre ellos vendrán el \w ciego|strong="H5787"\w* y el \w cojo|strong="H6455"\w*,  
\q2 la mujer embarazada y la \w que|strong="H6951"\w* está dando \w a|strong="H3068"\w* luz;  
\q2 en una \w gran|strong="H1419"\w* \w multitud|strong="H6951"\w* regresarán \w aquí|strong="H2008"\w*.   
\q1
\v 9 Vendrán \w con|strong="H3588"\w* \w llanto|strong="H1065"\w*,  
\q2 \w pero|strong="H3588"\w* \w entre|strong="H3808"\w* súplicas \w los|strong="H1931"\w* guiaré.  
\q1 \w Los|strong="H1931"\w* haré caminar junto \w a|strong="H3068"\w* corrientes \w de|strong="H3588"\w* \w agua|strong="H4325"\w*,  
\q2 \w por|strong="H3588"\w* un \w camino|strong="H1870"\w* \w derecho|strong="H3477"\w* \w en|strong="H3588"\w* \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w tropezarán|strong="H3782"\w*;  
\q1 \w porque|strong="H3588"\w* \w soy|strong="H1961"\w* un padre \w para|strong="H3588"\w* \w Israel|strong="H3478"\w*,  
\q2 \w y|strong="H3588"\w* Efraín \w es|strong="H1931"\w* \w mi|strong="H1961"\w* \w primogénito|strong="H1060"\w*.   
\b  
\q1
\v 10 \w Escuchen|strong="H8085"\w* \w la|strong="H8104"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, \w naciones|strong="H1471"\w*,  
\q2 y anúncienla en las costas lejanas. Digan:  
\q1 ‘El \w que|strong="H1697"\w* dispersó \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w lo|strong="H1697"\w* reunirá  
\q2 y \w lo|strong="H1697"\w* cuidará \w como|strong="H2219"\w* un \w pastor|strong="H7462"\w* \w a|strong="H3068"\w* su rebaño’.   
\q1
\v 11 \w Porque|strong="H3588"\w* Yahvé ha rescatado \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*  
\q2 \w y|strong="H3588"\w* lo ha redimido \w del|strong="H4480"\w* \w que|strong="H3588"\w* era \w más|strong="H3588"\w* \w fuerte|strong="H2389"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w*.   
\q1
\v 12 \w Vendrán|strong="H5102"\w* \w y|strong="H5921"\w* \w cantarán|strong="H7442"\w* \w de|strong="H5921"\w* alegría \w en|strong="H5921"\w* \w lo|strong="H3808"\w* \w alto|strong="H4791"\w* \w de|strong="H5921"\w* \w Sión|strong="H6726"\w*,  
\q2 \w y|strong="H5921"\w* correrán \w hacia|strong="H5921"\w* \w los|strong="H1121"\w* bienes \w de|strong="H5921"\w* Yahvé:  
\q1 \w al|strong="H5921"\w* \w trigo|strong="H1715"\w*, \w al|strong="H5921"\w* \w vino|strong="H1961"\w* nuevo, \w al|strong="H5921"\w* \w aceite|strong="H3323"\w*,  
\q2 \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* crías \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w vacas|strong="H1241"\w*.  
\q1 Su \w vida|strong="H5315"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* un jardín \w bien|strong="H2898"\w* regado  
\q2 \w y|strong="H5921"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* desmayar.   
\q1
\v 13 Entonces la joven se alegrará en la danza,  
\q2 \w junto|strong="H3162"\w* con los jóvenes y los \w ancianos|strong="H2205"\w*;  
\q1 porque cambiaré su llanto en \w gozo|strong="H8342"\w*  
\q2 y los consolaré, y los alegraré de su \w dolor|strong="H3015"\w*.   
\q1
\v 14 Satisfaré por completo \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* con abundancia,  
\q2 y \w mi|strong="H5315"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* saciará \w de|strong="H5971"\w* \w mi|strong="H5315"\w* \w bondad|strong="H2898"\w*” — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\p
\v 15 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “\w Se|strong="H5921"\w* \w oye|strong="H8085"\w* una \w voz|strong="H6963"\w* \w en|strong="H5921"\w* \w Ramá|strong="H7414"\w*,  
\q2 lamento \w y|strong="H3588"\w* \w llanto|strong="H1065"\w* \w amargo|strong="H8563"\w*;  
\q1 \w es|strong="H3588"\w* Raquel \w que|strong="H3588"\w* \w llora|strong="H1058"\w* \w por|strong="H5921"\w* sus \w hijos|strong="H1121"\w*,  
\q2 \w y|strong="H3588"\w* \w no|strong="H3985"\w* quiso ser consolada \w por|strong="H5921"\w* sus \w hijos|strong="H1121"\w*,  
\q2 \w porque|strong="H3588"\w* ya \w no|strong="H3985"\w* existen”.   
\p
\v 16 \w Así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé:  
\q1 “Deja ya \w de|strong="H3588"\w* llorar,  
\q2 seca las \w lágrimas|strong="H1832"\w* \w de|strong="H3588"\w* tus \w ojos|strong="H5869"\w*;  
\q2 \w porque|strong="H3588"\w* \w tu|strong="H3426"\w* trabajo tendrá \w su|strong="H3588"\w* \w recompensa|strong="H6468"\w* — \w dice|strong="H5002"\w* Yahvé —.  
\q2 Ellos \w volverán|strong="H7725"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra del enemigo.   
\q1
\v 17 \w Hay|strong="H3426"\w* \w esperanza|strong="H8615"\w* para \w tu|strong="H3426"\w* futuro — \w dice|strong="H5002"\w* Yahvé —;  
\q2 tus \w hijos|strong="H1121"\w* \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* su propia tierra.   
\b  
\q1
\v 18 \w Ciertamente|strong="H3588"\w* he \w oído|strong="H8085"\w* \w a|strong="H3068"\w* Efraín lamentarse:  
\q2 ‘\w Me|strong="H3588"\w* castigaste,  
\q2 \w y|strong="H3588"\w* \w fui|strong="H3808"\w* castigado \w como|strong="H3588"\w* un novillo \w indómito|strong="H3808"\w*;  
\q1 hazme \w volver|strong="H7725"\w* \w y|strong="H3588"\w* \w volveré|strong="H7725"\w*,  
\q2 \w porque|strong="H3588"\w* tú eres Yahvé mi \w Dios|strong="H3068"\w*.   
\q1
\v 19 \w Porque|strong="H3588"\w* \w después|strong="H5921"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* aparté, \w me|strong="H5921"\w* arrepentí;  
\q2 \w y|strong="H1571"\w* \w después|strong="H5921"\w* \w que|strong="H3588"\w* fui instruido, \w me|strong="H5921"\w* golpeé \w el|strong="H5921"\w* \w muslo|strong="H3409"\w* \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor.  
\q1 \w Me|strong="H5921"\w* avergoncé \w y|strong="H1571"\w* \w me|strong="H5921"\w* sentí confundido,  
\q2 \w porque|strong="H3588"\w* cargué \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w deshonra|strong="H2781"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w juventud|strong="H5271"\w*’.   
\q1
\v 20 ¿Acaso \w no|strong="H3588"\w* \w es|strong="H3588"\w* Efraín \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* amado?  
\q2 ¿\w No|strong="H3588"\w* \w es|strong="H3588"\w* \w el|strong="H5921"\w* niño \w en|strong="H5921"\w* quien \w me|strong="H5921"\w* deleito?  
\q1 \w Pues|strong="H3588"\w* \w siempre|strong="H5921"\w* \w que|strong="H3588"\w* \w hablo|strong="H1696"\w* \w contra|strong="H5921"\w* \w él|strong="H5921"\w*,  
\q2 \w lo|strong="H5921"\w* recuerdo \w con|strong="H5921"\w* \w más|strong="H5750"\w* cariño.  
\q1 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w mi|strong="H5921"\w* corazón \w se|strong="H5921"\w* conmueve \w por|strong="H5921"\w* \w él|strong="H5921"\w*;  
\q2 \w ciertamente|strong="H3588"\w* tendré \w de|strong="H5921"\w* \w él|strong="H5921"\w* compasión” — \w dice|strong="H5002"\w* Yahvé —.   
\b  
\q1
\v 21 “Coloca \w señales|strong="H6725"\w* en el \w camino|strong="H1870"\w*,  
\q2 \w pon|strong="H7760"\w* postes de guía;  
\q1 fíjate bien en la \w calzada|strong="H4546"\w*,  
\q2 en el \w camino|strong="H1870"\w* \w por|strong="H1870"\w* donde pasaste.  
\q1 Regresa, \w virgen|strong="H1330"\w* de \w Israel|strong="H3478"\w*;  
\q2 regresen \w a|strong="H3068"\w* estas \w ciudades|strong="H5892"\w* suyas.   
\q1
\v 22 ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H3588"\w* andarás vagando,  
\q2 oh \w hija|strong="H1323"\w* rebelde?  
\q1 \w Porque|strong="H3588"\w* Yahvé ha creado algo \w nuevo|strong="H2319"\w* \w en|strong="H5704"\w* \w la|strong="H3588"\w* tierra:  
\q2 \w la|strong="H3588"\w* mujer rodeará \w al|strong="H5704"\w* \w hombre|strong="H1397"\w*”.   
\b  
\p
\v 23 \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H5750"\w* los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*: “\w Todavía|strong="H5750"\w* dirán \w estas|strong="H2088"\w* \w palabras|strong="H1697"\w* \w en|strong="H5750"\w* la tierra \w de|strong="H5750"\w* \w Judá|strong="H3063"\w* \w y|strong="H3541"\w* \w en|strong="H5750"\w* sus \w ciudades|strong="H5892"\w*, cuando yo cambie su suerte: ‘¡\w Que|strong="H1697"\w* Yahvé te \w bendiga|strong="H1288"\w*, oh \w morada|strong="H5116"\w* \w de|strong="H5750"\w* \w justicia|strong="H6664"\w*, \w monte|strong="H2022"\w* \w de|strong="H5750"\w* \w santidad|strong="H6944"\w*!’.  
\v 24 \w Y|strong="H3068"\w* \w habitarán|strong="H3427"\w* allí \w Judá|strong="H3063"\w* y \w todas|strong="H3605"\w* sus \w ciudades|strong="H5892"\w*, \w los|strong="H3427"\w* agricultores y \w los|strong="H3427"\w* \w que|strong="H3605"\w* andan con \w los|strong="H3427"\w* \w rebaños|strong="H5739"\w*.  
\v 25 \w Porque|strong="H3588"\w* he dado \w de|strong="H3588"\w* beber al \w que|strong="H3588"\w* estaba agotado \w y|strong="H3588"\w* he saciado \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w alma|strong="H5315"\w* \w entristecida|strong="H1669"\w*”.   
\p
\v 26 \w En|strong="H5921"\w* \w esto|strong="H2063"\w* \w me|strong="H5921"\w* desperté \w y|strong="H5921"\w* abrí \w los|strong="H5921"\w* ojos, \w y|strong="H5921"\w* \w mi|strong="H5921"\w* \w sueño|strong="H8142"\w* \w me|strong="H5921"\w* resultó agradable.   
\p
\v 27 “Miren \w que|strong="H3117"\w* vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — en \w que|strong="H3117"\w* sembraré la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w* y la \w casa|strong="H1004"\w* de \w Judá|strong="H3063"\w* con semilla de hombre y con semilla de animal.  
\v 28 \w Y|strong="H3068"\w* \w así|strong="H3651"\w* \w como|strong="H1961"\w* \w estuve|strong="H1961"\w* atento \w para|strong="H5921"\w* arrancar \w y|strong="H5921"\w* derribar, \w para|strong="H5921"\w* destruir, arruinar \w y|strong="H5921"\w* afligir, \w así|strong="H3651"\w* estaré atento \w para|strong="H5921"\w* \w edificar|strong="H1129"\w* \w y|strong="H5921"\w* plantar” — \w dice|strong="H5002"\w* Yahvé —.  
\v 29 “\w En|strong="H5750"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* ya \w no|strong="H3808"\w* dirán:  
\q1 ‘\w Los|strong="H1992"\w* padres comieron \w las|strong="H1992"\w* uvas agrias  
\q2 y \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* sufren la dentera’.   
\m
\v 30 \w Sino|strong="H3588"\w* \w que|strong="H3588"\w* \w cada|strong="H3605"\w* uno \w morirá|strong="H4191"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* propia \w maldad|strong="H5771"\w*; \w quien|strong="H3605"\w* coma las uvas agrias, ese tendrá \w la|strong="H3588"\w* dentera.   
\p
\v 31 Miren \w que|strong="H3117"\w* vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — en \w que|strong="H3117"\w* \w haré|strong="H3772"\w* un \w nuevo|strong="H2319"\w* \w pacto|strong="H1285"\w* con la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w* y con la \w casa|strong="H1004"\w* de \w Judá|strong="H3063"\w*.  
\v 32 \w No|strong="H3808"\w* \w será|strong="H3808"\w* como \w el|strong="H1992"\w* \w pacto|strong="H1285"\w* \w que|strong="H3808"\w* \w hice|strong="H3772"\w* con \w sus|strong="H1992"\w* antepasados \w el|strong="H1992"\w* \w día|strong="H3117"\w* \w que|strong="H3808"\w* \w los|strong="H1992"\w* \w tomé|strong="H2388"\w* de la \w mano|strong="H3027"\w* para sacarlos de \w Egipto|strong="H4714"\w*; \w porque|strong="H3808"\w* \w ellos|strong="H1992"\w* \w rompieron|strong="H6565"\w* mi \w pacto|strong="H1285"\w*, \w aunque|strong="H3808"\w* yo \w fui|strong="H3808"\w* como un esposo para \w ellos|strong="H1992"\w* — \w dice|strong="H5002"\w* Yahvé —.  
\v 33 \w Pero|strong="H3588"\w* \w este|strong="H2063"\w* \w es|strong="H1961"\w* \w el|strong="H5921"\w* \w pacto|strong="H1285"\w* \w que|strong="H3588"\w* \w haré|strong="H5414"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé —:  
\q1 \w Pondré|strong="H5414"\w* \w mi|strong="H5921"\w* \w ley|strong="H8451"\w* \w en|strong="H5921"\w* \w su|strong="H1992"\w* mente  
\q2 \w y|strong="H3588"\w* \w la|strong="H5921"\w* escribiré \w en|strong="H5921"\w* \w su|strong="H1992"\w* \w corazón|strong="H3820"\w*;  
\q1 \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*,  
\q2 \w y|strong="H3588"\w* \w ellos|strong="H1992"\w* \w serán|strong="H1961"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*.   
\q1
\v 34 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* tendrá \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* enseñar \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w prójimo|strong="H7453"\w*,  
\q2 \w ni|strong="H3808"\w* \w nadie|strong="H3808"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* hermano, diciendo: ‘\w Conoce|strong="H3045"\w* \w a|strong="H3068"\w* Yahvé’;  
\q1 \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w me|strong="H3588"\w* \w conocerán|strong="H3045"\w*,  
\q2 \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H5750"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H5750"\w* \w grande|strong="H1419"\w* — \w dice|strong="H5002"\w* Yahvé —;  
\q1 \w porque|strong="H3588"\w* \w perdonaré|strong="H5545"\w* \w su|strong="H3588"\w* \w maldad|strong="H5771"\w*  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* acordaré \w más|strong="H5750"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w*”.   
\q1
\v 35 \w Así|strong="H3541"\w* dice Yahvé, \w que|strong="H3541"\w* \w da|strong="H5414"\w* el \w sol|strong="H8121"\w* \w para|strong="H5414"\w* alumbrar el \w día|strong="H3119"\w*,  
\q2 \w y|strong="H3541"\w* las leyes \w de|strong="H5414"\w* la \w luna|strong="H3394"\w* \w y|strong="H3541"\w* \w de|strong="H5414"\w* las \w estrellas|strong="H3556"\w* \w para|strong="H5414"\w* alumbrar la \w noche|strong="H3915"\w*,  
\q1 \w que|strong="H3541"\w* agita el \w mar|strong="H3220"\w* \w para|strong="H5414"\w* \w que|strong="H3541"\w* rujan sus olas;  
\q2 Yahvé \w de|strong="H5414"\w* los \w Ejércitos|strong="H6635"\w* \w es|strong="H3541"\w* su \w nombre|strong="H8034"\w*:   
\q1
\v 36 “\w Si|strong="H1571"\w* estas leyes llegaran \w a|strong="H3068"\w* faltar \w ante|strong="H6440"\w* \w mí|strong="H1961"\w* — \w dice|strong="H5002"\w* Yahvé —,  
\q2 \w también|strong="H1571"\w* \w la|strong="H1571"\w* \w descendencia|strong="H2233"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* dejaría \w de|strong="H6440"\w* ser una \w nación|strong="H1471"\w* \w ante|strong="H6440"\w* \w mí|strong="H1961"\w* \w para|strong="H1961"\w* \w siempre|strong="H3605"\w*”.   
\q1
\v 37 \w Así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé: “\w Si|strong="H1571"\w* \w se|strong="H5921"\w* pudieran medir \w los|strong="H5921"\w* \w cielos|strong="H8064"\w* \w arriba|strong="H4605"\w*,  
\q2 \w y|strong="H1571"\w* explorarse \w abajo|strong="H4295"\w* \w los|strong="H5921"\w* cimientos \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra,  
\q2 \w también|strong="H1571"\w* \w yo|strong="H6213"\w* desecharía \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w descendencia|strong="H2233"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* han \w hecho|strong="H6213"\w*” — \w dice|strong="H5002"\w* Yahvé —.   
\p
\v 38 “Miren \w que|strong="H3117"\w* vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — en \w que|strong="H3117"\w* la \w ciudad|strong="H5892"\w* será reconstruida para Yahvé, desde la \w torre|strong="H4026"\w* de Hananel \w hasta|strong="H3117"\w* la \w puerta|strong="H8179"\w* del Ángulo.  
\v 39 \w El|strong="H5921"\w* cordel \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w medida|strong="H4060"\w* \w se|strong="H5921"\w* extenderá \w en|strong="H5921"\w* línea recta \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* colina \w de|strong="H5921"\w* \w Gareb|strong="H1619"\w*, \w y|strong="H5921"\w* \w luego|strong="H3318"\w* girará \w hacia|strong="H5921"\w* Goa.  
\v 40 \w Y|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w valle|strong="H6010"\w* \w de|strong="H5750"\w* \w los|strong="H3605"\w* cadáveres \w y|strong="H5704"\w* \w de|strong="H5750"\w* \w la|strong="H3605"\w* ceniza, \w y|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* campos \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5750"\w* Cedrón, \w hasta|strong="H5704"\w* \w la|strong="H3605"\w* esquina \w de|strong="H5750"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* \w de|strong="H5750"\w* \w los|strong="H3605"\w* \w Caballos|strong="H5483"\w* \w al|strong="H5704"\w* \w oriente|strong="H4217"\w*, serán consagrados \w a|strong="H3068"\w* Yahvé. \w Nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w será|strong="H3808"\w* arrancada \w ni|strong="H3808"\w* derribada”.   
\c 32  
\p
\v 1 \w Esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w que|strong="H1931"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* en \w el|strong="H1931"\w* \w décimo|strong="H6224"\w* \w año|strong="H8141"\w* \w de|strong="H1697"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, \w que|strong="H1931"\w* \w fue|strong="H1961"\w* \w el|strong="H1931"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* \w de|strong="H1697"\w* \w Nabucodonosor|strong="H5019"\w*.  
\v 2 \w En|strong="H5921"\w* aquel tiempo, \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w tenía|strong="H1961"\w* cercada \w a|strong="H3068"\w* Jerusalén. \w El|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w estaba|strong="H1961"\w* recluido \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w patio|strong="H2691"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia, \w en|strong="H5921"\w* \w el|strong="H5921"\w* palacio \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\p
\v 3 El \w rey|strong="H4428"\w* Sedequías lo había encarcelado \w allí|strong="H3541"\w*, diciéndole: “¿\w Por|strong="H4069"\w* \w qué|strong="H3541"\w* \w profetizas|strong="H5012"\w* diciendo: ‘\w Así|strong="H3541"\w* dice Yahvé: “Voy \w a|strong="H3068"\w* entregar \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Babilonia, \w y|strong="H3541"\w* él \w la|strong="H2063"\w* capturará;  
\v 4 Sedequías, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w no|strong="H3808"\w* \w escapará|strong="H4422"\w* \w de|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H5973"\w* \w caldeos|strong="H3778"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w será|strong="H3808"\w* \w entregado|strong="H5414"\w* \w sin|strong="H3808"\w* falta \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia; \w hablará|strong="H1696"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* cara \w a|strong="H3068"\w* cara \w y|strong="H3588"\w* \w lo|strong="H3808"\w* \w verá|strong="H7200"\w* \w con|strong="H5973"\w* sus propios \w ojos|strong="H5869"\w*;  
\v 5 \w él|strong="H3588"\w* \w llevará|strong="H3212"\w* \w a|strong="H3068"\w* Sedequías \w a|strong="H3068"\w* Babilonia, \w y|strong="H3588"\w* \w allí|strong="H8033"\w* \w se|strong="H1961"\w* \w quedará|strong="H1961"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w lo|strong="H3808"\w* visite — \w dice|strong="H5002"\w* Yahvé —; \w aunque|strong="H3588"\w* ustedes luchen \w contra|strong="H1961"\w* \w los|strong="H1961"\w* \w caldeos|strong="H3778"\w*, \w no|strong="H3808"\w* \w tendrán|strong="H1961"\w* éxito” ’?”   
\p
\v 6 \w Jeremías|strong="H3414"\w* respondió: “\w Vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, diciendo:  
\v 7 ‘Hanamel \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* tu \w tío|strong="H1730"\w* Salum vendrá \w a|strong="H3068"\w* decirte: “\w Compra|strong="H7069"\w* \w mi|strong="H2009"\w* \w campo|strong="H7704"\w* \w que|strong="H3588"\w* está \w en|strong="H3588"\w* Anatot, \w porque|strong="H3588"\w* tú tienes \w el|strong="H3588"\w* \w derecho|strong="H4941"\w* \w de|strong="H3588"\w* rescate \w para|strong="H3588"\w* comprarlo” ’”.   
\p
\v 8 \w Y|strong="H3068"\w* \w tal|strong="H1697"\w* \w como|strong="H3588"\w* Yahvé \w lo|strong="H1931"\w* \w había|strong="H3588"\w* \w dicho|strong="H1697"\w*, \w mi|strong="H4994"\w* primo Hanamel vino \w a|strong="H3068"\w* verme al \w patio|strong="H2691"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* guardia \w y|strong="H3588"\w* \w me|strong="H3588"\w* dijo: “\w Por|strong="H3588"\w* favor, \w compra|strong="H7069"\w* \w mi|strong="H4994"\w* \w campo|strong="H7704"\w* \w que|strong="H3588"\w* \w está|strong="H1931"\w* \w en|strong="H3588"\w* Anatot, \w en|strong="H3588"\w* \w la|strong="H1931"\w* región \w de|strong="H3588"\w* \w Benjamín|strong="H1144"\w*; \w porque|strong="H3588"\w* tú \w tienes|strong="H3045"\w* \w el|strong="H1931"\w* \w derecho|strong="H4941"\w* \w de|strong="H3588"\w* \w posesión|strong="H3425"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* rescate. Cómpralo \w para|strong="H3588"\w* ti”.  
\p \w Entonces|strong="H3588"\w* comprendí \w que|strong="H3588"\w* \w esta|strong="H1931"\w* \w era|strong="H1931"\w* \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé.  
\v 9 Compré, pues, \w el|strong="H1121"\w* \w campo|strong="H7704"\w* \w de|strong="H1121"\w* mi primo Hanamel, allá en Anatot, y le \w pesé|strong="H8254"\w* \w el|strong="H1121"\w* \w dinero|strong="H3701"\w*: \w diecisiete|strong="H7651"\w* \w siclos|strong="H8255"\w*\f + \fr 32:9 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas.\f* \w de|strong="H1121"\w* \w plata|strong="H3701"\w*.  
\v 10 Firmé la \w escritura|strong="H3789"\w* y la sellé, llamé \w a|strong="H3068"\w* \w testigos|strong="H5707"\w* y \w pesé|strong="H8254"\w* el \w dinero|strong="H3701"\w* en la balanza.  
\v 11 Luego \w tomé|strong="H3947"\w* el documento de la compra, tanto la copia \w sellada|strong="H2856"\w* con las condiciones y reglamentos, como la copia abierta.  
\v 12 \w Y|strong="H3068"\w* \w entregué|strong="H5414"\w* \w el|strong="H3605"\w* documento \w de|strong="H1121"\w* \w la|strong="H3605"\w* compra \w a|strong="H3068"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maasías, en presencia \w de|strong="H1121"\w* mi primo Hanamel y \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w testigos|strong="H5707"\w* \w que|strong="H1121"\w* habían firmado \w el|strong="H3605"\w* documento, ante \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w judíos|strong="H3064"\w* \w que|strong="H1121"\w* \w estaban|strong="H3427"\w* \w sentados|strong="H3427"\w* en \w el|strong="H3605"\w* \w patio|strong="H2691"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* guardia.   
\p
\v 13 En presencia \w de|strong="H5869"\w* ellos \w le|strong="H5869"\w* di estas instrucciones \w a|strong="H3068"\w* Baruc:  
\v 14 “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5414"\w* los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*: ‘\w Toma|strong="H3947"\w* \w estos|strong="H2088"\w* documentos, tanto la escritura \w de|strong="H5414"\w* compra \w sellada|strong="H2856"\w* como la abierta, \w y|strong="H3541"\w* ponlos \w en|strong="H5975"\w* una \w vasija|strong="H3627"\w* \w de|strong="H5414"\w* barro \w para|strong="H4616"\w* \w que|strong="H3117"\w* se conserven \w por|strong="H4616"\w* \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w*’.  
\v 15 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: ‘\w Todavía|strong="H5750"\w* se volverán \w a|strong="H3068"\w* comprar \w casas|strong="H1004"\w*, \w campos|strong="H7704"\w* \w y|strong="H3588"\w* viñedos \w en|strong="H3588"\w* \w esta|strong="H2063"\w* tierra’”.   
\p
\v 16 Después \w de|strong="H1121"\w* entregar \w el|strong="H1121"\w* documento \w de|strong="H1121"\w* compra \w a|strong="H3068"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías, \w oré|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé con estas palabras:   
\b  
\mi
\v 17 “¡Ah, Señor Yahvé! \w Tú|strong="H6213"\w* \w hiciste|strong="H6213"\w* \w el|strong="H3605"\w* \w cielo|strong="H8064"\w* y \w la|strong="H3605"\w* tierra \w con|strong="H4480"\w* \w tu|strong="H6213"\w* \w gran|strong="H1419"\w* \w poder|strong="H3581"\w* y \w con|strong="H4480"\w* \w tu|strong="H6213"\w* \w brazo|strong="H2220"\w* \w extendido|strong="H5186"\w*. ¡\w No|strong="H3808"\w* hay \w nada|strong="H3808"\w* \w que|strong="H4480"\w* sea \w difícil|strong="H6381"\w* \w para|strong="H4480"\w* \w ti|strong="H4480"\w*!  
\v 18 \w Tú|strong="H6213"\w* muestras \w tu|strong="H6213"\w* bondad \w a|strong="H3068"\w* miles \w de|strong="H1121"\w* personas, pero también pides cuentas \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* por la \w maldad|strong="H5771"\w* \w de|strong="H1121"\w* sus padres. \w Dios|strong="H3068"\w* \w grande|strong="H1419"\w* y \w poderoso|strong="H1368"\w*, \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w* es Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*.  
\v 19 Tus planes son grandiosos \w y|strong="H5921"\w* tus \w hechos|strong="H4611"\w* son poderosos. Tus \w ojos|strong="H5869"\w* están atentos \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* hacen \w los|strong="H1121"\w* \w hombres|strong="H1121"\w*, \w para|strong="H5921"\w* \w darle|strong="H5414"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* uno \w lo|strong="H5921"\w* \w que|strong="H5921"\w* merece \w según|strong="H5921"\w* su conducta \w y|strong="H5921"\w* sus acciones.  
\v 20 \w Hiciste|strong="H6213"\w* señales \w y|strong="H5704"\w* \w prodigios|strong="H4159"\w* \w en|strong="H5704"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w* los sigues \w haciendo|strong="H6213"\w* tanto \w en|strong="H5704"\w* \w Israel|strong="H3478"\w* \w como|strong="H5704"\w* entre toda la humanidad; \w así|strong="H2088"\w* te has ganado \w el|strong="H6213"\w* renombre \w que|strong="H5704"\w* tienes \w hoy|strong="H3117"\w*.  
\v 21 \w Sacaste|strong="H3318"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w* con señales y milagros, con \w mano|strong="H3027"\w* \w fuerte|strong="H2389"\w* y brazo \w extendido|strong="H5186"\w*, y causando un \w gran|strong="H1419"\w* terror.  
