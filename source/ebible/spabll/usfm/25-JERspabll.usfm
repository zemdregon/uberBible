\id JER  
\toc3 Jeremías 
\toc1 JEREMÍAS 
\toc2 JEREMÍAS 
\mt2 El libro de  
\mt1 Jeramías  
\c 1  
\p
\v 1 \w Palabras|strong="H1697"\w* \w de|strong="H4480"\w* \w Jeremías|strong="H3414"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Hilcías|strong="H2518"\w*, uno \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H4480"\w* vivían \w en|strong="H4480"\w* Anatot, \w en|strong="H4480"\w* la región \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*.  
\v 2 La \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé\f + \fr 1:2 \ft “Yahvé” es el nombre propio de Dios, que en otras traducciones suele aparecer como “SEÑOR” (en mayúsculas).\f* llegó \w a|strong="H3068"\w* \w él|strong="H1121"\w* en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* \w Josías|strong="H2977"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amón, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, en \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w trece|strong="H7969"\w* \w de|strong="H1121"\w* su \w reinado|strong="H4427"\w*.  
\v 3 También \w llegó|strong="H5704"\w* \w en|strong="H5704"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5704"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* fin del \w año|strong="H8141"\w* \w once|strong="H6249"\w* \w de|strong="H5704"\w* Sedequías \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w cuando|strong="H3117"\w* la población \w de|strong="H5704"\w* Jerusalén \w fue|strong="H1961"\w* llevada \w al|strong="H5704"\w* cautiverio \w en|strong="H5704"\w* \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w quinto|strong="H2549"\w*.  
\v 4 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w se|strong="H1961"\w* dirigió \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:   
\q1
\v 5 “\w Antes|strong="H2962"\w* \w de|strong="H5414"\w* formarte \w en|strong="H3318"\w* \w el|strong="H5030"\w* vientre, ya te \w conocía|strong="H3045"\w*.  
\q2 \w Antes|strong="H2962"\w* \w de|strong="H5414"\w* \w que|strong="H3045"\w* nacieras, te aparté \w para|strong="H5414"\w* mi servicio.  
\q2 Te designé como \w profeta|strong="H5030"\w* \w para|strong="H5414"\w* las \w naciones|strong="H1471"\w*”.   
\p
\v 6 \w Yo|strong="H3588"\w* respondí: “¡Ay, Señor\f + \fr 1:6 \ft La palabra traducida como “Señor” es “Adonai”.\f* Yahvé! ¡\w Mira|strong="H2009"\w*\f + \fr 1:6 \ft “He aquí” o “mira” proviene del hebreo “הִנֵּה”, que invita a observar con atención o contemplar algo.\f* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w sé|strong="H3045"\w* \w hablar|strong="H1696"\w*, \w porque|strong="H3588"\w* todavía soy muy joven!”   
\p
\v 7 \w Pero|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w No|strong="H3588"\w* \w digas|strong="H1696"\w*: ‘Soy muy joven’; \w porque|strong="H3588"\w* \w irás|strong="H3212"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H5921"\w* \w envíe|strong="H7971"\w*, \w y|strong="H3588"\w* \w dirás|strong="H1696"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H5921"\w* \w mande|strong="H6680"\w*.  
\v 8 \w No|strong="H3588"\w* les tengas \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w contigo|strong="H6440"\w* \w para|strong="H3588"\w* protegerte”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* Yahvé.   
\p
\v 9 Entonces Yahvé \w extendió|strong="H7971"\w* su \w mano|strong="H3027"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w tocó|strong="H5060"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w*, \w y|strong="H5921"\w* \w me|strong="H5921"\w* dijo: “\w Mira|strong="H2009"\w*, he \w puesto|strong="H5414"\w* \w mis|strong="H5414"\w* \w palabras|strong="H1697"\w* \w en|strong="H5921"\w* tu \w boca|strong="H6310"\w*.  
\v 10 Fíjate \w que|strong="H5921"\w* \w hoy|strong="H3117"\w* \w te|strong="H5921"\w* he dado autoridad \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w*, \w para|strong="H5921"\w* arrancar \w y|strong="H5921"\w* \w para|strong="H5921"\w* derribar, \w para|strong="H5921"\w* destruir \w y|strong="H5921"\w* \w para|strong="H5921"\w* derrocar, \w para|strong="H5921"\w* \w edificar|strong="H1129"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* plantar”.   
\p
\v 11 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* una vez más: “\w Jeremías|strong="H3414"\w*, ¿\w qué|strong="H4100"\w* \w es|strong="H1961"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w ves|strong="H7200"\w*?”  
\p Yo respondí: “\w Veo|strong="H7200"\w* una rama \w de|strong="H1697"\w* almendro”.   
\p
\v 12 \w Entonces|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* dijo: “Has \w visto|strong="H7200"\w* \w bien|strong="H3190"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy atento \w a|strong="H3068"\w* \w que|strong="H3588"\w* \w mi|strong="H5921"\w* \w palabra|strong="H1697"\w* \w se|strong="H5921"\w* cumpla”.   
\p
\v 13 La \w palabra|strong="H1697"\w* \w de|strong="H6440"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w por|strong="H1697"\w* \w segunda|strong="H8145"\w* vez: “¿\w Qué|strong="H4100"\w* \w es|strong="H1961"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w ves|strong="H7200"\w*?”  
\p Yo respondí: “\w Veo|strong="H7200"\w* una \w olla|strong="H5518"\w* hirviendo \w que|strong="H4100"\w* \w se|strong="H1961"\w* vuelca \w desde|strong="H6440"\w* el \w norte|strong="H6828"\w*”.   
\p
\v 14 Entonces Yahvé \w me|strong="H5921"\w* explicó: “\w Desde|strong="H5921"\w* \w el|strong="H5921"\w* \w norte|strong="H6828"\w* \w se|strong="H5921"\w* derramará \w el|strong="H5921"\w* \w mal|strong="H7451"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w esta|strong="H3427"\w* tierra.  
\v 15 \w Porque|strong="H3588"\w* voy \w a|strong="H3068"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w familias|strong="H4940"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w del|strong="H5921"\w* \w norte|strong="H6828"\w* — \w dice|strong="H5002"\w* Yahvé —.  
\q1 Vendrán, \w y|strong="H3588"\w* \w cada|strong="H3605"\w* uno \w pondrá|strong="H5414"\w* \w su|strong="H3588"\w* \w trono|strong="H3678"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada misma \w de|strong="H5921"\w* Jerusalén,  
\q2 \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* sus murallas \w y|strong="H3588"\w* \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\q1
\v 16 Dictaré \w mi|strong="H5921"\w* \w sentencia|strong="H4941"\w* \w contra|strong="H5921"\w* \w ellos|strong="H3027"\w* \w por|strong="H5921"\w* \w toda|strong="H3605"\w* su \w maldad|strong="H7451"\w*;  
\q2 \w porque|strong="H5921"\w* \w me|strong="H5921"\w* abandonaron,  
\q2 ofrecieron incienso \w a|strong="H3068"\w* otros dioses  
\q2 \w y|strong="H5921"\w* \w adoraron|strong="H7812"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* sus \w manos|strong="H3027"\w* fabricaron.   
\p
\v 17 “¡\w Así|strong="H1696"\w* \w que|strong="H6435"\w* prepárate! \w Levántate|strong="H6965"\w* y \w diles|strong="H1696"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H6435"\w* \w yo|strong="H6680"\w* te \w ordene|strong="H6680"\w*. \w No|strong="H6435"\w* te asustes \w ante|strong="H6440"\w* \w ellos|strong="H3605"\w*, \w porque|strong="H6435"\w* \w si|strong="H6440"\w* \w lo|strong="H3605"\w* haces, \w yo|strong="H6680"\w* \w mismo|strong="H3605"\w* te haré temblar en su \w presencia|strong="H6440"\w*.  
\v 18 \w Mira|strong="H2009"\w*, \w hoy|strong="H3117"\w* \w te|strong="H5921"\w* he convertido \w en|strong="H5921"\w* una \w ciudad|strong="H5892"\w* fortificada, \w en|strong="H5921"\w* una \w columna|strong="H5982"\w* \w de|strong="H5921"\w* \w hierro|strong="H1270"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* una muralla \w de|strong="H5921"\w* bronce \w para|strong="H5921"\w* \w que|strong="H5921"\w* enfrentes \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país: \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* sus \w jefes|strong="H8269"\w*, \w a|strong="H3068"\w* sus \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w en|strong="H5921"\w* \w general|strong="H8269"\w*.  
\v 19 Ellos pelearán contra ti, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* vencerte; \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy contigo \w para|strong="H3588"\w* rescatarte”, \w dice|strong="H5002"\w* Yahvé.   
\c 2  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w se|strong="H1961"\w* dirigió \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Ve|strong="H3212"\w* \w y|strong="H3541"\w* proclama \w a|strong="H3068"\w* oídos de Jerusalén \w lo|strong="H3808"\w* siguiente: ‘\w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Recuerdo con cariño tu \w juventud|strong="H5271"\w*,  
\q2 el amor \w que|strong="H3808"\w* \w me|strong="H3541"\w* tenías cuando eras \w mi|strong="H3389"\w* novia,  
\q1 cómo \w me|strong="H3541"\w* seguías por el \w desierto|strong="H4057"\w*,  
\q2 por una tierra \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* había \w sembrado|strong="H2232"\w*.   
\q1
\v 3 \w Israel|strong="H3478"\w* estaba \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé,  
\q2 era \w el|strong="H3605"\w* primer \w fruto|strong="H8393"\w* \w de|strong="H7451"\w* su cosecha.  
\q1 \w Cualquiera|strong="H3605"\w* \w que|strong="H3605"\w* intentara devorarlo se hacía culpable,  
\q2 y \w el|strong="H3605"\w* \w mal|strong="H7451"\w* caía sobre \w ellos|strong="H3605"\w*”, \w dice|strong="H5002"\w* Yahvé’”.   
\p
\v 4 ¡\w Escuchen|strong="H8085"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, descendientes \w de|strong="H1697"\w* \w Jacob|strong="H3290"\w* y \w todas|strong="H3605"\w* las \w familias|strong="H4940"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*!  
\v 5 \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*:  
\q1 “¿\w Qué|strong="H3588"\w* falta encontraron sus antepasados \w en|strong="H5921"\w* \w mí|strong="H5921"\w*,  
\q2 \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* alejaran \w tanto|strong="H5921"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* lado?  
\q1 \w Se|strong="H5921"\w* \w fueron|strong="H3212"\w* tras ídolos inútiles  
\q2 \w y|strong="H3588"\w* terminaron haciéndose inútiles \w ellos|strong="H5921"\w* mismos.   
\q1
\v 6 \w Nunca|strong="H3808"\w* preguntaron: ‘¿\w Dónde|strong="H8033"\w* \w está|strong="H3427"\w* Yahvé, \w el|strong="H5674"\w* \w que|strong="H3808"\w* nos \w sacó|strong="H5927"\w* de \w Egipto|strong="H4714"\w*,  
\q2 \w el|strong="H5674"\w* \w que|strong="H3808"\w* nos \w guió|strong="H3212"\w* por \w el|strong="H5674"\w* \w desierto|strong="H4057"\w*,  
\q2 por una tierra de llanuras y barrancos,  
\q2 por una tierra \w seca|strong="H6723"\w* y de sombras de \w muerte|strong="H6757"\w*,  
\q2 por una tierra \w donde|strong="H8033"\w* \w nadie|strong="H3808"\w* \w pasa|strong="H5674"\w*  
\q2 y \w donde|strong="H8033"\w* \w ningún|strong="H3808"\w* ser humano vive?’.   
\q1
\v 7 Yo los traje \w a|strong="H3068"\w* una tierra fértil  
\q2 para que comieran de sus \w frutos|strong="H6529"\w* y de su abundancia.  
\q1 Pero ustedes entraron y \w contaminaron|strong="H2930"\w* mi tierra;  
\q2 \w hicieron|strong="H7760"\w* de mi \w heredad|strong="H5159"\w* algo repugnante.   
\q1
\v 8 Los \w sacerdotes|strong="H3548"\w* \w no|strong="H3808"\w* preguntaron: ‘¿Dónde está Yahvé?’.  
\q2 Los expertos en la \w ley|strong="H8451"\w* \w no|strong="H3808"\w* me \w conocieron|strong="H3045"\w*,  
\q1 los gobernantes \w se|strong="H3045"\w* rebelaron contra mí,  
\q2 los \w profetas|strong="H5030"\w* hablaron en nombre de \w Baal|strong="H1168"\w*  
\q2 y \w se|strong="H3045"\w* \w fueron|strong="H1980"\w* tras \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w sirve|strong="H3276"\w* para \w nada|strong="H3808"\w*.   
\q1
\v 9 “\w Por|strong="H5750"\w* \w eso|strong="H3651"\w*, \w todavía|strong="H5750"\w* voy \w a|strong="H3068"\w* entablar un pleito contra ustedes”, \w dice|strong="H5002"\w* Yahvé,  
\q2 “y \w también|strong="H3651"\w* contra \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5750"\w* sus \w hijos|strong="H1121"\w*.   
\q1
\v 10 Crucen \w a|strong="H3068"\w* las islas \w de|strong="H3588"\w* Chipre \w y|strong="H3588"\w* miren;  
\q2 envíen \w a|strong="H3068"\w* alguien \w a|strong="H3068"\w* \w Cedar|strong="H6938"\w* \w y|strong="H3588"\w* fíjense \w bien|strong="H3588"\w*,  
\q2 \w vean|strong="H7200"\w* \w si|strong="H3588"\w* alguna vez ha \w pasado|strong="H5674"\w* algo parecido.   
\q1
\v 11 ¿Hay alguna \w nación|strong="H1471"\w* \w que|strong="H3808"\w* haya cambiado \w sus|strong="H1992"\w* dioses,  
\q2 \w aunque|strong="H3808"\w* en realidad \w no|strong="H3808"\w* \w son|strong="H3808"\w* dioses?  
\q2 ¡Pero mi \w pueblo|strong="H5971"\w* \w ha|strong="H3808"\w* cambiado al \w que|strong="H3808"\w* es \w su|strong="H1992"\w* \w gloria|strong="H3519"\w* por algo \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w sirve|strong="H3276"\w* \w para|strong="H5971"\w* \w nada|strong="H3808"\w*!   
\q1
\v 12 “¡Espántense, \w cielos|strong="H8064"\w*, ante \w esto|strong="H2063"\w*!  
\q2 ¡Tiemblen \w de|strong="H5921"\w* horror \w y|strong="H5921"\w* queden desolados!”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 13 “\w Porque|strong="H3588"\w* mi \w pueblo|strong="H5971"\w* \w ha|strong="H3808"\w* cometido \w dos|strong="H8147"\w* pecados:  
\q2 \w me|strong="H3588"\w* abandonaron \w a|strong="H3068"\w* mí, \w que|strong="H3588"\w* soy \w la|strong="H3588"\w* \w fuente|strong="H4726"\w* \w de|strong="H3588"\w* \w agua|strong="H4325"\w* \w viva|strong="H2416"\w*,  
\q2 \w y|strong="H3588"\w* cavaron sus propias cisternas, cisternas \w rotas|strong="H7665"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* pueden retener \w el|strong="H3588"\w* \w agua|strong="H4325"\w*.   
\q1
\v 14 ¿\w Es|strong="H1931"\w* \w Israel|strong="H3478"\w* un esclavo?  
\q2 ¿Acaso \w nació|strong="H1961"\w* en \w la|strong="H1931"\w* esclavitud?  
\q2 ¿\w Por|strong="H4069"\w* \w qué|strong="H1931"\w*, entonces, \w lo|strong="H1931"\w* han convertido en botín de guerra?   
\q1
\v 15 \w Los|strong="H3427"\w* leones han rugido \w contra|strong="H5921"\w* \w él|strong="H5921"\w*, lanzando sus gritos.  
\q2 Han dejado su tierra desolada,  
\q2 sus \w ciudades|strong="H5892"\w* \w están|strong="H3427"\w* \w quemadas|strong="H3341"\w* \w y|strong="H5921"\w* nadie vive \w en|strong="H5921"\w* \w ellas|strong="H5921"\w*.   
\q1
\v 16 Incluso \w la|strong="H1571"\w* gente \w de|strong="H1121"\w* Menfis \w y|strong="H1571"\w* \w de|strong="H1121"\w* Tafnes te han roto \w la|strong="H1571"\w* cabeza.   
\q1
\v 17 “¿\w No|strong="H3808"\w* te buscaste \w esto|strong="H2063"\w* \w tú|strong="H6213"\w* misma  
\q2 \w por|strong="H1870"\w* \w haber|strong="H3808"\w* abandonado \w a|strong="H3068"\w* Yahvé \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w*,\f + \fr 2:17 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f*  
\q2 precisamente \w cuando|strong="H6256"\w* \w él|strong="H6213"\w* te guiaba \w por|strong="H1870"\w* \w el|strong="H6213"\w* \w camino|strong="H1870"\w*?   
\q1
\v 18 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w*, ¿\w qué|strong="H4100"\w* ganas con ir \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w beber|strong="H8354"\w* el \w agua|strong="H4325"\w* \w del|strong="H8354"\w* Nilo?  
\q2 ¿\w O|strong="H3068"\w* \w qué|strong="H4100"\w* ganas con ir \w a|strong="H3068"\w* Asiria \w a|strong="H3068"\w* \w beber|strong="H8354"\w* el \w agua|strong="H4325"\w* \w del|strong="H8354"\w* Éufrates?\f + \fr 2:18 \ft El texto original se refiere a “el Río”, es decir, el Éufrates.\f*   
\q1
\v 19 “Tu propia \w maldad|strong="H7451"\w* \w te|strong="H3588"\w* dará una lección,  
\q2 \w y|strong="H3588"\w* tu infidelidad \w te|strong="H3588"\w* \w castigará|strong="H3256"\w*.  
\q1 \w Reconoce|strong="H3045"\w* \w y|strong="H3588"\w* \w mira|strong="H7200"\w* \w qué|strong="H3588"\w* \w malo|strong="H7451"\w* \w y|strong="H3588"\w* \w amargo|strong="H4751"\w* resulta  
\q2 \w que|strong="H3588"\w* hayas abandonado \w a|strong="H3068"\w* Yahvé tu \w Dios|strong="H3069"\w*,  
\q2 \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* tengas \w ningún|strong="H3808"\w* temor”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w*, Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*.   
\q1
\v 20 “\w Porque|strong="H3588"\w* hace mucho tiempo \w que|strong="H3588"\w* rompí tu \w yugo|strong="H5923"\w*  
\q2 \w y|strong="H3588"\w* \w te|strong="H5921"\w* quité \w las|strong="H5921"\w* cadenas;  
\q1 \w pero|strong="H3588"\w* tú dijiste: ‘¡\w No|strong="H3808"\w* quiero \w servir|strong="H5647"\w*!’.  
\q2 \w En|strong="H5921"\w* cambio, \w en|strong="H5921"\w* \w cada|strong="H3605"\w* colina \w alta|strong="H1364"\w* \w y|strong="H3588"\w* \w bajo|strong="H8478"\w* \w todo|strong="H3605"\w* \w árbol|strong="H6086"\w* \w frondoso|strong="H7488"\w*,  
\q2 \w te|strong="H5921"\w* entregaste \w a|strong="H3068"\w* \w la|strong="H5921"\w* prostitución.   
\q1
\v 21 Yo te había \w plantado|strong="H5193"\w* como una \w vid|strong="H1612"\w* de \w la|strong="H3605"\w* mejor calidad,  
\q2 con una semilla totalmente pura.  
\q2 ¿Cómo es \w que|strong="H3605"\w* te has vuelto ante mis ojos una \w vid|strong="H1612"\w* \w extraña|strong="H5237"\w* y degenerada?   
\q1
\v 22 \w Aunque|strong="H3588"\w* \w te|strong="H3588"\w* laves \w con|strong="H3588"\w* lejía  
\q2 \w y|strong="H3588"\w* uses \w mucho|strong="H7235"\w* \w jabón|strong="H1287"\w*,  
\q2 \w la|strong="H3588"\w* mancha \w de|strong="H3588"\w* tu \w pecado|strong="H5771"\w* sigue estando frente \w a|strong="H3068"\w* mí”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor Yahvé.   
\q1
\v 23 “¿\w Cómo|strong="H4100"\w* te atreves \w a|strong="H3068"\w* decir: ‘\w No|strong="H3808"\w* me he \w contaminado|strong="H2930"\w*,  
\q2 \w no|strong="H3808"\w* me he ido tras los baales’?  
\q1 \w Mira|strong="H7200"\w* \w cómo|strong="H4100"\w* te portaste en \w el|strong="H6213"\w* \w valle|strong="H1516"\w*;  
\q2 \w reconoce|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* has \w hecho|strong="H6213"\w*.  
\q1 Eres \w como|strong="H4100"\w* una camella ligera \w que|strong="H4100"\w* corre de un lado \w a|strong="H3068"\w* otro,  
\v 24 como \w una|strong="H4672"\w* burra salvaje acostumbrada al \w desierto|strong="H4057"\w*, \w que|strong="H4310"\w* olfatea \w el|strong="H3605"\w* \w viento|strong="H7307"\w* en su ardor.  
\q2 Cuando está en celo, ¿\w quién|strong="H4310"\w* \w la|strong="H3605"\w* puede frenar?  
\q2 \w Los|strong="H3605"\w* \w que|strong="H4310"\w* \w la|strong="H3605"\w* \w buscan|strong="H1245"\w* \w no|strong="H3808"\w* tienen \w que|strong="H4310"\w* cansarse; en su época de celo \w la|strong="H3605"\w* encontrarán.   
\q1
\v 25 “\w No|strong="H3808"\w* corras hasta \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w te|strong="H3588"\w* gasten \w los|strong="H3588"\w* \w pies|strong="H7272"\w*,  
\q2 \w ni|strong="H3808"\w* hasta \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w te|strong="H3588"\w* seque \w la|strong="H3588"\w* garganta.  
\q1 \w Pero|strong="H3588"\w* tú respondes: ‘¡\w No|strong="H3808"\w* pierdas \w el|strong="H3588"\w* tiempo!  
\q2 \w Yo|strong="H3588"\w* amo \w a|strong="H3068"\w* \w los|strong="H3588"\w* extraños  
\q2 \w y|strong="H3588"\w* \w me|strong="H3588"\w* \w iré|strong="H3212"\w* tras ellos’.   
\q1
\v 26 \w Así|strong="H3651"\w* \w como|strong="H3588"\w* un \w ladrón|strong="H1590"\w* \w se|strong="H1992"\w* siente avergonzado \w cuando|strong="H3588"\w* \w lo|strong="H1992"\w* atrapan,  
\q2 \w así|strong="H3651"\w* \w se|strong="H1992"\w* avergonzará \w el|strong="H3588"\w* \w pueblo|strong="H1992"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*:  
\q2 \w ellos|strong="H1992"\w*, \w sus|strong="H1992"\w* \w reyes|strong="H4428"\w*, \w sus|strong="H1992"\w* \w jefes|strong="H8269"\w*, \w sus|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w sus|strong="H1992"\w* \w profetas|strong="H5030"\w*.   
\q1
\v 27 \w A|strong="H3068"\w* un trozo \w de|strong="H3588"\w* \w madera|strong="H6086"\w* le dicen: ‘Tú eres mi padre’,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* una piedra: ‘Tú \w me|strong="H3588"\w* diste \w la|strong="H3588"\w* vida’.  
\q1 \w Me|strong="H3588"\w* han dado \w la|strong="H3588"\w* espalda  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w la|strong="H3588"\w* \w cara|strong="H6440"\w*;  
\q2 \w pero|strong="H3588"\w* \w cuando|strong="H3588"\w* están \w en|strong="H3588"\w* problemas dicen: ‘¡\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* \w sálvanos|strong="H3467"\w*!’.   
\q1
\v 28 “¿\w Y|strong="H3068"\w* dónde \w están|strong="H1961"\w* esos dioses \w que|strong="H3588"\w* \w te|strong="H3588"\w* fabricaste?  
\q2 ¡\w Que|strong="H3588"\w* \w se|strong="H1961"\w* levanten ellos, \w a|strong="H3068"\w* ver \w si|strong="H3588"\w* pueden salvarte \w cuando|strong="H3588"\w* \w estés|strong="H1961"\w* \w en|strong="H3588"\w* aprietos!  
\q2 \w Porque|strong="H3588"\w* \w tú|strong="H6213"\w*, \w Judá|strong="H3063"\w*, tienes tantos dioses \w como|strong="H3588"\w* \w ciudades|strong="H5892"\w*.   
\q1
\v 29 “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* quieren discutir conmigo?  
\q2 \w Todos|strong="H3605"\w* ustedes \w se|strong="H4100"\w* han rebelado contra mí”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 30 “\w De|strong="H1121"\w* \w nada|strong="H3808"\w* sirvió \w que|strong="H3808"\w* castigara \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*,  
\q2 pues \w no|strong="H3808"\w* aceptaron la \w corrección|strong="H4148"\w*.  
\q1 Su propia \w espada|strong="H2719"\w* devoró \w a|strong="H3068"\w* sus \w profetas|strong="H5030"\w*  
\q2 como un león feroz.   
\q1
\v 31 Ustedes, \w los|strong="H1961"\w* \w de|strong="H5750"\w* \w esta|strong="H1961"\w* \w generación|strong="H1755"\w*, presten atención \w a|strong="H3068"\w* la \w palabra|strong="H1697"\w* \w de|strong="H5750"\w* Yahvé:  
\q2 ¿Acaso he \w sido|strong="H1961"\w* yo \w como|strong="H1961"\w* un \w desierto|strong="H4057"\w* \w para|strong="H1961"\w* \w Israel|strong="H3478"\w*,  
\q2 \w o|strong="H3068"\w* \w como|strong="H1961"\w* una tierra \w de|strong="H5750"\w* oscuridad total?  
\q1 ¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w dice|strong="H1697"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*: ‘\w Somos|strong="H1961"\w* nuestros propios dueños,  
\q2 \w no|strong="H3808"\w* volveremos \w a|strong="H3068"\w* ti’?   
\q1
\v 32 “¿\w Se|strong="H5971"\w* olvida una joven \w de|strong="H5971"\w* sus joyas,  
\q2 \w o|strong="H3068"\w* una novia \w de|strong="H5971"\w* su vestido \w de|strong="H5971"\w* bodas?  
\q2 ¡Pues mi \w pueblo|strong="H5971"\w* me ha olvidado por muchísimos \w días|strong="H3117"\w*!   
\q1
\v 33 ¡\w Qué|strong="H4100"\w* \w bien|strong="H3190"\w* sabes maniobrar para buscar amantes!  
\q2 ¡Hasta \w a|strong="H3068"\w* las mujeres malvadas les has enseñado tus \w caminos|strong="H1870"\w*!   
\q1
\v 34 \w En|strong="H5921"\w* \w los|strong="H5921"\w* bordes \w de|strong="H5921"\w* tu ropa \w se|strong="H5921"\w* encontró \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*  
\q2 \w de|strong="H5921"\w* gente pobre \w e|strong="H3068"\w* \w inocente|strong="H5355"\w*,  
\q2 \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w ni|strong="H3808"\w* siquiera sorprendiste robando.   
\q1
\v 35 “\w Y|strong="H3068"\w* todavía dices: ‘Soy inocente;  
\q2 seguramente \w su|strong="H3588"\w* enojo ya \w se|strong="H4480"\w* apartó \w de|strong="H4480"\w* \w mí|strong="H5921"\w*’.  
\q1 \w Pues|strong="H3588"\w* \w mira|strong="H2005"\w*, \w yo|strong="H4480"\w* voy \w a|strong="H3068"\w* juzgarte  
\q2 \w porque|strong="H3588"\w* dices: ‘\w No|strong="H3808"\w* he \w pecado|strong="H2398"\w*’.   
\q1
\v 36 ¿\w Por|strong="H1870"\w* \w qué|strong="H4100"\w* te rebajas \w tanto|strong="H3966"\w* cambiando \w de|strong="H8138"\w* parecer?  
\q2 \w También|strong="H1571"\w* \w Egipto|strong="H4714"\w* te \w va|strong="H3068"\w* \w a|strong="H3068"\w* fallar,  
\q2 \w así|strong="H1571"\w* \w como|strong="H4100"\w* te falló Asiria.   
\q1
\v 37 \w También|strong="H1571"\w* \w de|strong="H5921"\w* allí \w saldrás|strong="H3318"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*;  
\q2 \w porque|strong="H3588"\w* Yahvé \w ha|strong="H3808"\w* rechazado \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* tú elegiste \w como|strong="H3588"\w* aliados,  
\q2 \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w irá|strong="H3318"\w* \w bien|strong="H3588"\w* \w con|strong="H5921"\w* \w ellos|strong="H3027"\w*”.   
\c 3  
\p
\v 1 “\w Se|strong="H1961"\w* \w dice|strong="H5002"\w*: ‘\w Si|strong="H2005"\w* un hombre \w se|strong="H1961"\w* divorcia \w de|strong="H5750"\w* \w su|strong="H1931"\w* esposa, y \w ella|strong="H1931"\w* \w se|strong="H1961"\w* \w va|strong="H3068"\w* con \w otro|strong="H5750"\w*, ¿\w podrá|strong="H3808"\w* \w él|strong="H1931"\w* \w volver|strong="H7725"\w* con \w ella|strong="H1931"\w*? ¿Acaso \w no|strong="H3808"\w* quedaría \w esa|strong="H1931"\w* tierra totalmente contaminada?’. \w Pues|strong="H1931"\w* tú te has prostituido con \w muchos|strong="H7227"\w* amantes; ¡y ahora pretendes \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*!”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 2 “\w Levanta|strong="H5375"\w* \w la|strong="H5921"\w* mirada \w a|strong="H3068"\w* \w las|strong="H5921"\w* colinas desnudas \w y|strong="H5921"\w* \w mira|strong="H7200"\w*: ¿\w en|strong="H5921"\w* \w qué|strong="H3808"\w* lugar \w no|strong="H3808"\w* \w te|strong="H5869"\w* has acostado? \w Te|strong="H5869"\w* sentabas \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w camino|strong="H1870"\w* \w para|strong="H5921"\w* esperar \w a|strong="H3068"\w* tus amantes, \w como|strong="H5921"\w* un nómada \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*. Has contaminado \w la|strong="H5921"\w* tierra \w con|strong="H5921"\w* tu prostitución \w y|strong="H5921"\w* \w con|strong="H5921"\w* tu \w maldad|strong="H7451"\w*.  
\v 3 Por eso \w se|strong="H1961"\w* detuvieron las \w lluvias|strong="H7241"\w* y \w no|strong="H3808"\w* \w hubo|strong="H1961"\w* \w lluvias|strong="H7241"\w* de primavera; pero tú tienes cara de prostituta y \w no|strong="H3808"\w* conoces la \w vergüenza|strong="H3637"\w*.  
\v 4 ¿\w No|strong="H3808"\w* acabas de llamarme: ‘¡Padre mío, tú eres el amigo de mi \w juventud|strong="H5271"\w*!’?   
\p
\v 5 Piensas: ‘¿Estará enojado para \w siempre|strong="H5769"\w*? ¿Mantendrá su ira hasta \w el|strong="H6213"\w* final?’. \w Así|strong="H1696"\w* hablas, pero \w haces|strong="H6213"\w* todo \w el|strong="H6213"\w* \w mal|strong="H7451"\w* que \w puedes|strong="H3201"\w* y te sales con \w la|strong="H8104"\w* tuya”.   
\p
\v 6 \w En|strong="H5921"\w* \w tiempos|strong="H3117"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w*, Yahvé \w me|strong="H5921"\w* dijo: “¿Has \w visto|strong="H7200"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* ha \w hecho|strong="H6213"\w* \w la|strong="H1931"\w* infiel \w Israel|strong="H3478"\w*? \w Se|strong="H1931"\w* \w fue|strong="H1980"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w monte|strong="H2022"\w* \w alto|strong="H1364"\w* \w y|strong="H5921"\w* \w bajo|strong="H8478"\w* \w todo|strong="H3605"\w* \w árbol|strong="H6086"\w* \w frondoso|strong="H7488"\w* \w para|strong="H5921"\w* entregarse \w a|strong="H3068"\w* \w la|strong="H1931"\w* prostitución.  
\v 7 \w Yo|strong="H6213"\w* pensaba: ‘Después de \w hacer|strong="H6213"\w* \w todo|strong="H3605"\w* \w esto|strong="H6213"\w*, \w ella|strong="H3605"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* mí’; pero \w no|strong="H3808"\w* \w volvió|strong="H7725"\w*. \w Y|strong="H3068"\w* su hermana, \w la|strong="H3605"\w* traidora \w Judá|strong="H3063"\w*, \w lo|strong="H3808"\w* \w vio|strong="H7200"\w* \w todo|strong="H3605"\w*.  
\v 8 \w Israel|strong="H3478"\w* \w me|strong="H5921"\w* \w fue|strong="H3212"\w* infiel \w y|strong="H1571"\w* cometió adulterio, \w por|strong="H5921"\w* \w eso|strong="H1931"\w* \w le|strong="H1931"\w* \w di|strong="H5414"\w* \w su|strong="H1931"\w* \w carta|strong="H5612"\w* \w de|strong="H5921"\w* divorcio \w y|strong="H1571"\w* \w la|strong="H1931"\w* \w envié|strong="H7971"\w* lejos. \w Pero|strong="H3588"\w* \w vi|strong="H7200"\w* \w que|strong="H3588"\w* \w su|strong="H1931"\w* hermana, \w la|strong="H1931"\w* traidora \w Judá|strong="H3063"\w*, \w no|strong="H3808"\w* \w tuvo|strong="H3372"\w* \w ningún|strong="H3605"\w* \w temor|strong="H3372"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w también|strong="H1571"\w* \w ella|strong="H1931"\w* \w se|strong="H1931"\w* convirtió \w en|strong="H5921"\w* prostituta.  
\v 9 \w Como|strong="H1961"\w* \w no|strong="H1961"\w* le dio importancia \w a|strong="H3068"\w* su prostitución, contaminó la tierra y cometió adulterio al adorar ídolos de piedra y de \w madera|strong="H6086"\w*.  
\v 10 \w A|strong="H3068"\w* pesar \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, \w su|strong="H3588"\w* hermana, \w la|strong="H1571"\w* traidora \w Judá|strong="H3063"\w*, \w no|strong="H3808"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* mí \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* solo fingió hacerlo”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 11 Yahvé me explicó: “La infiel \w Israel|strong="H3478"\w* ha resultado \w ser|strong="H5315"\w* más justa que la traidora \w Judá|strong="H3063"\w*.  
\v 12 \w Ve|strong="H1980"\w* \w y|strong="H3588"\w* proclama este mensaje \w hacia|strong="H6440"\w* \w el|strong="H3588"\w* \w norte|strong="H6828"\w*: ‘¡\w Vuelve|strong="H7725"\w*, \w Israel|strong="H3478"\w* \w rebelde|strong="H7725"\w*!’, \w dice|strong="H5002"\w* Yahvé. ‘\w No|strong="H3808"\w* \w te|strong="H3588"\w* miraré \w con|strong="H3588"\w* enojo, \w porque|strong="H3588"\w* soy \w misericordioso|strong="H2623"\w*’, \w dice|strong="H5002"\w* Yahvé. ‘\w No|strong="H3808"\w* estaré enojado \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*.  
\v 13 Solo \w reconoce|strong="H3045"\w* tu culpa: \w que|strong="H3588"\w* \w te|strong="H3588"\w* rebelaste contra Yahvé tu \w Dios|strong="H3068"\w*, \w que|strong="H3588"\w* \w te|strong="H3588"\w* entregaste \w a|strong="H3068"\w* extraños \w bajo|strong="H8478"\w* \w todo|strong="H3605"\w* \w árbol|strong="H6086"\w* \w frondoso|strong="H7488"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* mi \w voz|strong="H6963"\w*’”, \w dice|strong="H5002"\w* Yahvé.  
\v 14 “\w Vuelvan|strong="H7725"\w*, \w hijos|strong="H1121"\w* \w rebeldes|strong="H7726"\w* — \w dice|strong="H5002"\w* Yahvé —, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy \w su|strong="H3588"\w* dueño. \w Los|strong="H1121"\w* \w tomaré|strong="H3947"\w*, uno \w de|strong="H3588"\w* cada \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w dos|strong="H8147"\w* \w de|strong="H3588"\w* cada \w familia|strong="H4940"\w*, \w y|strong="H3588"\w* \w los|strong="H1121"\w* llevaré \w a|strong="H3068"\w* \w Sión|strong="H6726"\w*.  
\v 15 Les \w daré|strong="H5414"\w* \w pastores|strong="H7462"\w* que actúen según mi \w corazón|strong="H3820"\w*, \w para|strong="H5414"\w* que los guíen con \w conocimiento|strong="H1844"\w* y \w sabiduría|strong="H1844"\w*.  
\v 16 \w En|strong="H5921"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w cuando|strong="H3588"\w* ustedes ya \w se|strong="H1961"\w* hayan multiplicado \w y|strong="H3588"\w* crecido \w en|strong="H5921"\w* \w el|strong="H5921"\w* país — \w dice|strong="H5002"\w* Yahvé —, ya \w no|strong="H3808"\w* \w se|strong="H1961"\w* hablará \w más|strong="H5750"\w* \w del|strong="H5921"\w* ‘Arca \w del|strong="H5921"\w* \w Pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé’. \w Nadie|strong="H3808"\w* pensará \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w ni|strong="H3808"\w* \w la|strong="H5921"\w* recordará; \w no|strong="H3808"\w* \w la|strong="H5921"\w* echarán \w de|strong="H5921"\w* \w menos|strong="H3588"\w* \w ni|strong="H3808"\w* volverán \w a|strong="H3068"\w* fabricar \w otra|strong="H5750"\w*.  
\v 17 \w En|strong="H5750"\w* \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w llamarán|strong="H7121"\w* \w a|strong="H3068"\w* Jerusalén ‘\w Trono|strong="H3678"\w* \w de|strong="H5750"\w* Yahvé’. \w Todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w se|strong="H1931"\w* reunirán \w en|strong="H5750"\w* Jerusalén para honrar \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* \w de|strong="H5750"\w* Yahvé, y ya \w no|strong="H3808"\w* seguirán \w la|strong="H1931"\w* terquedad \w de|strong="H5750"\w* \w su|strong="H1931"\w* \w malvado|strong="H7451"\w* \w corazón|strong="H3820"\w*.  
\v 18 \w En|strong="H5921"\w* esos \w días|strong="H3117"\w*, \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w se|strong="H5921"\w* unirá \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w juntas|strong="H3162"\w* vendrán \w desde|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w del|strong="H5921"\w* \w norte|strong="H6828"\w* \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* \w les|strong="H1992"\w* di \w como|strong="H5921"\w* herencia \w a|strong="H3068"\w* \w sus|strong="H1992"\w* antepasados.   
\p
\v 19 “Yo mismo dije: ‘¡\w Qué|strong="H3808"\w* ganas tengo \w de|strong="H1121"\w* tratarte como \w a|strong="H3068"\w* un \w hijo|strong="H1121"\w* y darte una tierra envidiable, la \w herencia|strong="H5159"\w* \w más|strong="H1471"\w* hermosa \w de|strong="H1121"\w* todas las \w naciones|strong="H1471"\w*!’.   
\p
\v 20 “Pero \w así|strong="H3651"\w* \w como|strong="H3651"\w* una mujer traiciona \w a|strong="H3068"\w* su esposo, \w así|strong="H3651"\w* me han traicionado ustedes, pueblo de \w Israel|strong="H3478"\w*”, \w dice|strong="H5002"\w* Yahvé.  
\v 21 \w Se|strong="H5921"\w* \w escucha|strong="H8085"\w* un grito \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas: \w es|strong="H3588"\w* \w el|strong="H5921"\w* \w llanto|strong="H1065"\w* \w y|strong="H3588"\w* \w el|strong="H5921"\w* ruego \w del|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* han torcido \w su|strong="H3588"\w* \w camino|strong="H1870"\w* \w y|strong="H3588"\w* \w se|strong="H5921"\w* han olvidado \w de|strong="H5921"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 22 “\w Vuelvan|strong="H7725"\w*, \w hijos|strong="H1121"\w* \w rebeldes|strong="H7726"\w*, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* perdonaré \w su|strong="H3588"\w* infidelidad”.  
\p “\w Aquí|strong="H2005"\w* estamos, venimos \w a|strong="H3068"\w* ti, \w porque|strong="H3588"\w* tú eres Yahvé nuestro \w Dios|strong="H3068"\w*.  
\v 23 De nada sirve buscar ayuda en las colinas \w o|strong="H3068"\w* el \w alboroto|strong="H1995"\w* de los \w montes|strong="H2022"\w*; solo en Yahvé nuestro \w Dios|strong="H3068"\w* está la salvación de \w Israel|strong="H3478"\w*.  
\v 24 Desde nuestra \w juventud|strong="H5271"\w*, ese ídolo \w vergonzoso|strong="H1322"\w* se ha devorado \w el|strong="H1121"\w* fruto del \w trabajo|strong="H3018"\w* \w de|strong="H1121"\w* nuestros antepasados: sus rebaños \w y|strong="H1241"\w* sus \w vacas|strong="H1241"\w*, \w y|strong="H1241"\w* hasta \w a|strong="H3068"\w* nuestros \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 25 Hundámonos \w en|strong="H5704"\w* nuestra \w vergüenza|strong="H3639"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* nos cubra nuestra deshonra, \w porque|strong="H3588"\w* hemos \w pecado|strong="H2398"\w* contra Yahvé nuestro \w Dios|strong="H3068"\w*; tanto nosotros \w como|strong="H3588"\w* nuestros antepasados, \w desde|strong="H5704"\w* nuestra \w juventud|strong="H5271"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w*, \w no|strong="H3808"\w* hemos obedecido \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*”.   
\c 4  
\p
\v 1 “\w Si|strong="H3808"\w* decides \w volver|strong="H7725"\w*, \w Israel|strong="H3478"\w* — \w dice|strong="H5002"\w* Yahvé —, \w si|strong="H3808"\w* \w vuelves|strong="H7725"\w* \w a|strong="H3068"\w* mí y quitas tus ídolos asquerosos \w de|strong="H6440"\w* mi vista, \w entonces|strong="H5493"\w* \w no|strong="H3808"\w* serás expulsado.  
\v 2 Si juras: ‘Por la \w vida|strong="H2416"\w* de Yahvé’, con verdad, \w justicia|strong="H6666"\w* y rectitud, entonces las \w naciones|strong="H1471"\w* \w serán|strong="H4941"\w* bendecidas por él y en él encontrarán su motivo de orgullo”.   
\p
\v 3 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w a|strong="H3068"\w* \w los|strong="H3588"\w* hombres \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén: “Preparen \w su|strong="H3588"\w* tierra virgen \w y|strong="H3588"\w* \w no|strong="H3588"\w* siembren \w entre|strong="H3588"\w* \w espinos|strong="H6975"\w*.  
\v 4 Conságrense \w a|strong="H3068"\w* Yahvé \w y|strong="H1197"\w* quiten \w la|strong="H1197"\w* \w maldad|strong="H7455"\w* \w de|strong="H6440"\w* su \w corazón|strong="H3824"\w*, hombres \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* \w y|strong="H1197"\w* \w habitantes|strong="H3427"\w* \w de|strong="H6440"\w* Jerusalén. \w No|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H6435"\w* \w mi|strong="H3389"\w* \w enojo|strong="H2534"\w* \w se|strong="H6435"\w* encienda como un fuego \w y|strong="H1197"\w* arda sin \w que|strong="H6435"\w* nadie pueda apagarlo, \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* sus malas acciones.  
\v 5 Den \w aviso|strong="H5046"\w* en \w Judá|strong="H3063"\w* y anúncienlo en Jerusalén. Digan: ‘¡Toquen la \w trompeta|strong="H7782"\w* por todo el país!’. Griten con todas sus fuerzas: ‘¡Júntense! ¡Vayamos \w a|strong="H3068"\w* las \w ciudades|strong="H5892"\w* protegidas!’.  
\v 6 ¡Levanten \w la|strong="H3588"\w* señal hacia \w Sión|strong="H6726"\w*! ¡Busquen refugio, \w no|strong="H3588"\w* se detengan! \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* traigo desde \w el|strong="H3588"\w* \w norte|strong="H6828"\w* \w el|strong="H3588"\w* desastre \w y|strong="H3588"\w* una destrucción terrible”.   
\p
\v 7 Un león ha \w salido|strong="H3318"\w* de su escondite; un destructor de \w naciones|strong="H1471"\w* se ha \w puesto|strong="H5927"\w* \w en|strong="H3318"\w* marcha. Ha dejado su \w lugar|strong="H4725"\w* para reducir tu tierra \w a|strong="H3068"\w* cenizas; tus \w ciudades|strong="H5892"\w* \w quedarán|strong="H3427"\w* \w en|strong="H3318"\w* ruinas y nadie vivirá \w en|strong="H3318"\w* ellas.  
\v 8 \w Por|strong="H5921"\w* \w eso|strong="H2063"\w*, vístanse \w de|strong="H4480"\w* luto, lloren \w y|strong="H3588"\w* laméntense, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* fuego \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w ira|strong="H2740"\w* \w de|strong="H4480"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H5921"\w* \w ha|strong="H3808"\w* apartado \w de|strong="H4480"\w* \w nosotros|strong="H5921"\w*.  
\v 9 “En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w el|strong="H1931"\w* \w rey|strong="H4428"\w* perderá \w el|strong="H1931"\w* valor, y también \w sus|strong="H1931"\w* \w jefes|strong="H8269"\w*. \w Los|strong="H1931"\w* \w sacerdotes|strong="H3548"\w* \w se|strong="H1961"\w* quedarán pasmados y \w los|strong="H1931"\w* \w profetas|strong="H5030"\w* \w no|strong="H1961"\w* podrán creer \w lo|strong="H1931"\w* \w que|strong="H1931"\w* ven”.   
\p
\v 10 Entonces \w yo|strong="H5315"\w* dije: “¡Ay, Señor Yahvé! \w De|strong="H5704"\w* verdad has engañado \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* Jerusalén \w al|strong="H5704"\w* decirles: ‘\w Tendrán|strong="H1961"\w* \w paz|strong="H7965"\w*’, \w cuando|strong="H5704"\w* \w en|strong="H5704"\w* realidad \w tienen|strong="H1961"\w* la \w espada|strong="H2719"\w* \w en|strong="H5704"\w* la garganta”.   
\p
\v 11 En \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w se|strong="H1931"\w* dirá \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* y \w a|strong="H3068"\w* Jerusalén: “Un \w viento|strong="H7307"\w* abrasador sopla desde las lomas del \w desierto|strong="H4057"\w* \w hacia|strong="H1870"\w* \w mi|strong="H3389"\w* \w pueblo|strong="H5971"\w*; \w no|strong="H3808"\w* \w es|strong="H1931"\w* un \w viento|strong="H7307"\w* \w para|strong="H5971"\w* limpiar \w el|strong="H1931"\w* trigo.  
\v 12 Es un \w viento|strong="H7307"\w* mucho \w más|strong="H1571"\w* fuerte \w el|strong="H1571"\w* \w que|strong="H6258"\w* viene por orden mía. \w Ahora|strong="H6258"\w* soy yo quien \w va|strong="H3068"\w* \w a|strong="H3068"\w* dictar \w sentencia|strong="H4941"\w* contra \w ellos|strong="H1571"\w*”.   
\p
\v 13 ¡Miren! \w El|strong="H3588"\w* enemigo avanza \w como|strong="H3588"\w* las \w nubes|strong="H6051"\w*; sus \w carros|strong="H4818"\w* parecen un \w torbellino|strong="H5492"\w* \w y|strong="H3588"\w* sus \w caballos|strong="H5483"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* rápidos \w que|strong="H3588"\w* las águilas. ¡Pobres \w de|strong="H3588"\w* nosotros, estamos perdidos!  
\v 14 Jerusalén, limpia tu \w corazón|strong="H3820"\w* \w de|strong="H5704"\w* tanta \w maldad|strong="H7451"\w* \w para|strong="H5704"\w* \w que|strong="H5704"\w* puedas salvarte. ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* seguirás alimentando tus \w malos|strong="H7451"\w* \w pensamientos|strong="H4284"\w*?  
\v 15 \w Ya|strong="H3068"\w* se \w escuchan|strong="H8085"\w* noticias desde \w Dan|strong="H1835"\w*; desde \w los|strong="H3588"\w* cerros \w de|strong="H3588"\w* Efraín anuncian \w la|strong="H3588"\w* desgracia.  
\v 16 “Avisen \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*; anuncien \w contra|strong="H5921"\w* Jerusalén: ‘Viene un ejército sitiador \w de|strong="H5921"\w* una tierra \w lejana|strong="H4801"\w* \w y|strong="H5921"\w* ya gritan sus gritos \w de|strong="H5921"\w* guerra \w contra|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*’.  
\v 17 \w La|strong="H5921"\w* \w rodean|strong="H5439"\w* \w como|strong="H3588"\w* quienes cuidan un \w campo|strong="H7704"\w*, \w porque|strong="H3588"\w* \w ella|strong="H5921"\w* \w se|strong="H1961"\w* rebeló \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*”, \w dice|strong="H5002"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w*.  
\v 18 “\w Tu|strong="H6213"\w* propia conducta \w y|strong="H3588"\w* tus acciones \w te|strong="H3588"\w* han traído \w esto|strong="H2063"\w*. \w Este|strong="H2063"\w* \w es|strong="H3588"\w* \w tu|strong="H6213"\w* \w castigo|strong="H7451"\w*, \w y|strong="H3588"\w* \w es|strong="H3588"\w* muy \w amargo|strong="H4751"\w*; ¡\w te|strong="H3588"\w* ha herido \w en|strong="H5704"\w* \w lo|strong="H6213"\w* \w más|strong="H3588"\w* profundo del \w corazón|strong="H3820"\w*!”.   
\p
\v 19 ¡\w Qué|strong="H3588"\w* \w dolor|strong="H2342"\w*, \w qué|strong="H3588"\w* \w dolor|strong="H2342"\w*! ¡Siento \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w corazón|strong="H3820"\w* \w se|strong="H3808"\w* \w me|strong="H3588"\w* parte! \w Me|strong="H3588"\w* late \w el|strong="H3588"\w* pecho \w con|strong="H3588"\w* fuerza \w y|strong="H3588"\w* \w no|strong="H3808"\w* puedo quedarme callado. \w Porque|strong="H3588"\w* he escuchado \w el|strong="H3588"\w* toque \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w trompeta|strong="H7782"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* grito \w de|strong="H3588"\w* \w guerra|strong="H4421"\w*.  
\v 20 \w Se|strong="H5921"\w* anuncia un desastre tras otro, \w pues|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país ha sido devastado. \w En|strong="H5921"\w* un instante mis tiendas fueron destruidas; \w en|strong="H5921"\w* un \w momento|strong="H7281"\w* mis campamentos quedaron \w en|strong="H5921"\w* ruinas.  
\v 21 ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* tendré \w que|strong="H5704"\w* \w ver|strong="H7200"\w* banderas \w de|strong="H5704"\w* guerra \w y|strong="H5704"\w* \w escuchar|strong="H8085"\w* el toque \w de|strong="H5704"\w* la \w trompeta|strong="H7782"\w*?   
\p
\v 22 “\w Es|strong="H3588"\w* \w que|strong="H3588"\w* mi \w pueblo|strong="H5971"\w* \w es|strong="H3588"\w* \w necio|strong="H5530"\w*, \w no|strong="H3808"\w* \w me|strong="H3588"\w* \w conocen|strong="H3045"\w*. \w Son|strong="H3588"\w* \w como|strong="H3588"\w* niños tontos \w que|strong="H3588"\w* \w no|strong="H3808"\w* entienden \w nada|strong="H3808"\w*. \w Son|strong="H3588"\w* expertos \w para|strong="H3588"\w* hacer \w lo|strong="H3808"\w* malo, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w saben|strong="H3045"\w* \w cómo|strong="H3588"\w* hacer \w lo|strong="H3808"\w* bueno”.  
\v 23 \w Miré|strong="H7200"\w* la tierra, y \w estaba|strong="H2009"\w* vacía y en caos; \w miré|strong="H7200"\w* los \w cielos|strong="H8064"\w*, y no tenían luz.  
\v 24 \w Miré|strong="H7200"\w* las montañas, y estaban temblando; \w todos|strong="H3605"\w* \w los|strong="H3605"\w* cerros se sacudían.  
\v 25 \w Miré|strong="H7200"\w*, y ya no había \w nadie|strong="H3605"\w*; hasta las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w* habían salido huyendo.  
\v 26 \w Miré|strong="H7200"\w*, y \w el|strong="H3605"\w* campo fértil se había vuelto un \w desierto|strong="H4057"\w*; \w todas|strong="H3605"\w* sus \w ciudades|strong="H5892"\w* estaban \w derribadas|strong="H5422"\w* \w ante|strong="H6440"\w* \w la|strong="H3605"\w* \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w por|strong="H6440"\w* su ardiente enojo.  
\v 27 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: “\w Todo|strong="H3605"\w* \w el|strong="H3588"\w* país \w quedará|strong="H1961"\w* desolado, \w aunque|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* destruiré \w por|strong="H3588"\w* completo.  
\v 28 \w Por|strong="H5921"\w* \w esto|strong="H2063"\w* \w la|strong="H5921"\w* tierra \w se|strong="H5921"\w* pondrá \w de|strong="H4480"\w* luto \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w se|strong="H5921"\w* oscurecerá; \w porque|strong="H3588"\w* \w yo|strong="H4480"\w* \w lo|strong="H3808"\w* he \w dicho|strong="H1696"\w* \w y|strong="H3588"\w* \w lo|strong="H3808"\w* he decidido; \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* arrepentirme \w ni|strong="H3808"\w* voy \w a|strong="H3068"\w* dar marcha atrás”.   
\p
\v 29 Al oír \w el|strong="H3605"\w* \w ruido|strong="H6963"\w* de \w la|strong="H3605"\w* caballería y de \w los|strong="H3427"\w* arqueros, \w todos|strong="H3605"\w* salen \w huyendo|strong="H1272"\w*. Unos se esconden en \w el|strong="H3605"\w* bosque y otros trepan por las rocas. \w Todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* han sido abandonadas; no queda ni un solo habitante.  
\v 30 \w Y|strong="H3068"\w* \w tú|strong="H6213"\w*, \w que|strong="H3588"\w* \w estás|strong="H6213"\w* condenada \w a|strong="H3068"\w* \w la|strong="H3588"\w* ruina, ¿\w qué|strong="H3588"\w* piensas \w hacer|strong="H6213"\w*? \w Aunque|strong="H3588"\w* \w te|strong="H5869"\w* vistas \w de|strong="H3588"\w* lujo, \w te|strong="H5869"\w* pongas joyas \w de|strong="H3588"\w* \w oro|strong="H2091"\w* \w y|strong="H3588"\w* \w te|strong="H5869"\w* \w pintes|strong="H7167"\w* mucho \w los|strong="H3588"\w* \w ojos|strong="H5869"\w*, \w de|strong="H3588"\w* nada \w te|strong="H5869"\w* \w sirve|strong="H6213"\w* arreglarte tanto. Tus amantes \w te|strong="H5869"\w* desprecian; \w lo|strong="H4100"\w* \w que|strong="H3588"\w* quieren \w es|strong="H3588"\w* \w matarte|strong="H5315"\w*.  
\v 31 \w Oigo|strong="H8085"\w* gritos \w como|strong="H3588"\w* \w de|strong="H3588"\w* una mujer \w de|strong="H3588"\w* parto, \w como|strong="H3588"\w* \w los|strong="H3588"\w* \w de|strong="H3588"\w* alguien \w que|strong="H3588"\w* da \w a|strong="H3068"\w* luz \w por|strong="H3588"\w* primera vez. \w Es|strong="H3588"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* ciudad \w de|strong="H3588"\w* \w Sión|strong="H6726"\w*, \w que|strong="H3588"\w* respira \w con|strong="H3588"\w* dificultad \w y|strong="H3588"\w* \w extiende|strong="H6566"\w* \w los|strong="H3588"\w* brazos diciendo: “¡Ay \w de|strong="H3588"\w* \w mí|strong="H4994"\w*, \w que|strong="H3588"\w* \w me|strong="H3588"\w* muero \w en|strong="H3588"\w* \w manos|strong="H3709"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* asesinos!”.   
\c 5  
\p
\v 1 “Recorran las \w calles|strong="H2351"\w* de Jerusalén, miren \w bien|strong="H7200"\w* y pregunten; \w busquen|strong="H1245"\w* por todas sus \w plazas|strong="H7339"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w si|strong="H4994"\w* encuentran \w a|strong="H3068"\w* alguien \w que|strong="H4994"\w* actúe con \w justicia|strong="H4941"\w* y \w que|strong="H4994"\w* \w busque|strong="H1245"\w* la verdad. \w Si|strong="H4994"\w* \w lo|strong="H6213"\w* encuentran, \w yo|strong="H4994"\w* \w perdonaré|strong="H5545"\w* \w a|strong="H3068"\w* la ciudad.  
\v 2 Porque aunque juren: ‘\w Por|strong="H3651"\w* la \w vida|strong="H2416"\w* de Yahvé’, en realidad están jurando en \w falso|strong="H8267"\w*”.   
\p
\v 3 Yahvé, ¿acaso \w no|strong="H3808"\w* buscas tú la sinceridad? Los castigaste, pero \w no|strong="H3808"\w* les dolió; los estabas destruyendo, pero \w no|strong="H3808"\w* \w quisieron|strong="H3985"\w* aprender la lección. \w Se|strong="H3808"\w* pusieron \w más|strong="H3808"\w* tercos \w que|strong="H3808"\w* una \w roca|strong="H5553"\w* y \w no|strong="H3808"\w* \w quisieron|strong="H3985"\w* arrepentirse.   
\p
\v 4 \w Entonces|strong="H3588"\w* \w yo|strong="H3588"\w* pensé: “Seguramente \w estos|strong="H1992"\w* \w son|strong="H3588"\w* \w los|strong="H1992"\w* \w pobres|strong="H1800"\w*, \w que|strong="H3588"\w* actúan \w con|strong="H3588"\w* necedad \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w conocen|strong="H3045"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* Yahvé \w ni|strong="H3808"\w* \w las|strong="H1992"\w* leyes \w de|strong="H3588"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*.  
\v 5 \w Iré|strong="H3212"\w* \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H3588"\w* \w los|strong="H1992"\w* dirigentes, \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w sí|strong="H3588"\w* \w conocen|strong="H3045"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* \w las|strong="H1992"\w* leyes \w de|strong="H3588"\w* \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*”. \w Pero|strong="H3588"\w* resultó \w que|strong="H3588"\w* \w también|strong="H3162"\w* \w ellos|strong="H1992"\w*, \w todos|strong="H3162"\w* \w a|strong="H3068"\w* una, \w se|strong="H3045"\w* habían sacudido \w el|strong="H3588"\w* \w yugo|strong="H5923"\w* \w y|strong="H3588"\w* roto \w las|strong="H1992"\w* cadenas.  
\v 6 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, un león \w de|strong="H5921"\w* \w la|strong="H5921"\w* selva \w los|strong="H5921"\w* atacará, un \w lobo|strong="H2061"\w* \w del|strong="H5921"\w* desierto \w los|strong="H5921"\w* \w destruirá|strong="H7703"\w* \w y|strong="H3588"\w* un leopardo \w acechará|strong="H8245"\w* sus \w ciudades|strong="H5892"\w*. \w Cualquiera|strong="H3605"\w* \w que|strong="H3588"\w* intente \w salir|strong="H3318"\w* será despedazado, \w porque|strong="H3588"\w* sus \w rebeliones|strong="H6588"\w* \w son|strong="H3588"\w* muchas \w y|strong="H3588"\w* \w su|strong="H3588"\w* infidelidad ha crecido demasiado.   
\p
\v 7 “¿Cómo quieres \w que|strong="H3808"\w* te \w perdone|strong="H5545"\w*? Tus \w hijos|strong="H1121"\w* me abandonaron y \w juraron|strong="H7650"\w* por dioses \w que|strong="H3808"\w* \w no|strong="H3808"\w* existen. Yo les di todo \w lo|strong="H3808"\w* necesario, pero ellos me fueron infieles y \w se|strong="H3808"\w* amontonaron en \w los|strong="H1121"\w* burdeles.  
\v 8 Parecen \w caballos|strong="H5483"\w* sementales, bien alimentados y fogosos; cada uno relincha por la mujer de su \w prójimo|strong="H7453"\w*.  
\v 9 ¿Acaso \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* castigarlos \w por|strong="H5921"\w* \w esto|strong="H2088"\w*? — \w dice|strong="H5002"\w* Yahvé —. ¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* voy \w a|strong="H3068"\w* vengar \w de|strong="H5921"\w* una \w nación|strong="H1471"\w* \w así|strong="H2088"\w*?   
\p
\v 10 “¡Ataquen \w sus|strong="H1992"\w* viñedos \w y|strong="H3588"\w* destrúyanlos, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* acaben \w con|strong="H3588"\w* todo! Quiten \w sus|strong="H1992"\w* sarmientos, \w porque|strong="H3588"\w* ya \w no|strong="H3808"\w* le pertenecen \w a|strong="H3068"\w* Yahvé.  
\v 11 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w me|strong="H3588"\w* han traicionado \w por|strong="H3588"\w* completo — \w dice|strong="H5002"\w* Yahvé —.   
\p
\v 12 Han negado \w a|strong="H3068"\w* Yahvé diciendo: ‘\w Él|strong="H1931"\w* \w no|strong="H3808"\w* hará \w nada|strong="H3808"\w*. \w No|strong="H3808"\w* \w nos|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar \w nada|strong="H3808"\w* \w malo|strong="H7451"\w*; \w no|strong="H3808"\w* \w veremos|strong="H7200"\w* guerra \w ni|strong="H3808"\w* \w hambre|strong="H7458"\w*.  
\v 13 \w Los|strong="H1961"\w* \w profetas|strong="H5030"\w* \w no|strong="H6213"\w* \w son|strong="H1961"\w* más \w que|strong="H1961"\w* \w viento|strong="H7307"\w*; \w no|strong="H6213"\w* \w tienen|strong="H1961"\w* la palabra de Dios. ¡\w Que|strong="H1961"\w* les pase \w a|strong="H3068"\w* ellos \w lo|strong="H6213"\w* \w que|strong="H1961"\w* andan diciendo!’”.   
\p
\v 14 \w Por|strong="H3282"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w*: “\w Por|strong="H3282"\w* haber \w hablado|strong="H1696"\w* \w de|strong="H5971"\w* \w esa|strong="H3651"\w* \w manera|strong="H1697"\w*, voy \w a|strong="H3068"\w* hacer \w que|strong="H5971"\w* \w mis|strong="H5414"\w* \w palabras|strong="H1697"\w* en tu \w boca|strong="H6310"\w* sean \w como|strong="H3651"\w* fuego, \w y|strong="H3541"\w* \w que|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* sea la \w leña|strong="H6086"\w* \w que|strong="H5971"\w* el fuego devore.  
\v 15 Pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, voy \w a|strong="H3068"\w* traer \w contra|strong="H5921"\w* ustedes \w a|strong="H3068"\w* una \w nación|strong="H1471"\w* \w de|strong="H5921"\w* lejos — \w dice|strong="H5002"\w* Yahvé —. \w Es|strong="H1931"\w* una \w nación|strong="H1471"\w* poderosa \w y|strong="H5921"\w* \w antigua|strong="H5769"\w*, un pueblo \w que|strong="H4100"\w* \w habla|strong="H1696"\w* un idioma \w que|strong="H4100"\w* ustedes \w no|strong="H3808"\w* \w conocen|strong="H3045"\w* \w y|strong="H5921"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* podrán entender.  
\v 16 Sus flechas traen \w la|strong="H3605"\w* muerte, son como un \w sepulcro|strong="H6913"\w* \w abierto|strong="H6605"\w*; \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* son guerreros \w valientes|strong="H1368"\w*.  
\v 17 Se comerán sus cosechas \w y|strong="H1241"\w* su \w comida|strong="H3899"\w*, la \w que|strong="H1121"\w* \w era|strong="H1121"\w* para sus \w hijos|strong="H1121"\w* \w y|strong="H1241"\w* sus \w hijas|strong="H1323"\w*. Devorarán sus \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* sus \w vacas|strong="H1241"\w*, se acabarán sus \w viñas|strong="H1612"\w* \w y|strong="H1241"\w* sus \w higueras|strong="H8384"\w*, \w y|strong="H1241"\w* destruirán \w a|strong="H3068"\w* punta \w de|strong="H1121"\w* \w espada|strong="H2719"\w* las \w ciudades|strong="H5892"\w* amuralladas en las \w que|strong="H1121"\w* ustedes confían.   
\p
\v 18 “\w Sin|strong="H3808"\w* embargo, \w aun|strong="H1571"\w* en esos \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w no|strong="H3808"\w* \w los|strong="H1992"\w* destruiré por completo.  
\v 19 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w la|strong="H3588"\w* gente pregunte: ‘¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*, \w nos|strong="H4100"\w* \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w esto|strong="H3651"\w*?’, \w tú|strong="H6213"\w* les responderás: ‘\w Así|strong="H3651"\w* \w como|strong="H4100"\w* ustedes \w me|strong="H3588"\w* abandonaron \w para|strong="H3588"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* dioses extraños \w en|strong="H3588"\w* \w su|strong="H3588"\w* propia tierra, \w así|strong="H3651"\w* \w tendrán|strong="H1961"\w* \w que|strong="H3588"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* extranjeros \w en|strong="H3588"\w* una tierra \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1961"\w* \w la|strong="H3588"\w* suya’.   
\p
\v 20 “Anuncien \w esto|strong="H2063"\w* en \w la|strong="H2063"\w* \w familia|strong="H1004"\w* de \w Jacob|strong="H3290"\w* y proclámenlo en \w Judá|strong="H3063"\w*:  
\v 21 ‘\w Escuchen|strong="H8085"\w* \w esto|strong="H2063"\w*, \w pueblo|strong="H5971"\w* \w necio|strong="H5530"\w* y \w sin|strong="H3808"\w* cerebro, \w que|strong="H3808"\w* tiene \w ojos|strong="H5869"\w* pero \w no|strong="H3808"\w* \w ve|strong="H7200"\w*, \w que|strong="H3808"\w* tiene \w oídos|strong="H8085"\w* pero \w no|strong="H3808"\w* \w oye|strong="H8085"\w*.  
\v 22 ¿Acaso \w no|strong="H3808"\w* me tienen \w miedo|strong="H3372"\w*? — \w dice|strong="H5002"\w* Yahvé —. ¿\w No|strong="H3808"\w* van \w a|strong="H3068"\w* temblar \w ante|strong="H6440"\w* mi \w presencia|strong="H6440"\w*? Yo soy \w el|strong="H5674"\w* \w que|strong="H3808"\w* \w puso|strong="H7760"\w* \w la|strong="H1366"\w* \w arena|strong="H2342"\w* \w como|strong="H1993"\w* límite del \w mar|strong="H3220"\w*, una frontera \w eterna|strong="H5769"\w* \w que|strong="H3808"\w* las aguas \w no|strong="H3808"\w* \w pueden|strong="H3201"\w* cruzar. \w Aunque|strong="H3808"\w* las olas \w se|strong="H3808"\w* agiten, \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* \w pasar|strong="H5674"\w*; \w aunque|strong="H3808"\w* rujan con fuerza, \w no|strong="H3808"\w* cruzarán ese límite.   
\p
\v 23 “Pero \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w tiene|strong="H1961"\w* un \w corazón|strong="H3820"\w* \w rebelde|strong="H5637"\w* y terco; \w se|strong="H1961"\w* apartaron \w de|strong="H5971"\w* \w mí|strong="H1961"\w* y \w se|strong="H1961"\w* \w fueron|strong="H1961"\w* \w por|strong="H2088"\w* su lado.  
\v 24 \w No|strong="H3808"\w* \w se|strong="H3808"\w* \w pusieron|strong="H5414"\w* \w a|strong="H3068"\w* pensar: ‘Tengamos respeto \w a|strong="H3068"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*, \w que|strong="H3808"\w* nos manda \w a|strong="H3068"\w* \w tiempo|strong="H6256"\w* las \w lluvias|strong="H1653"\w* \w de|strong="H3372"\w* otoño y \w de|strong="H3372"\w* primavera, y nos asegura las \w semanas|strong="H7620"\w* \w de|strong="H3372"\w* \w la|strong="H8104"\w* cosecha’.   
\p
\v 25 Pero las \w maldades|strong="H5771"\w* \w de|strong="H4480"\w* ustedes han echado \w a|strong="H3068"\w* perder todo eso; sus \w pecados|strong="H2403"\w* les han quitado esos beneficios.  
\v 26 \w Porque|strong="H3588"\w* \w entre|strong="H3588"\w* mi \w pueblo|strong="H5971"\w* hay hombres malvados \w que|strong="H3588"\w* acechan \w como|strong="H3588"\w* cazadores escondidos; ponen trampas \w para|strong="H3588"\w* atrapar \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w*.  
\v 27 Sus \w casas|strong="H1004"\w* están \w llenas|strong="H4392"\w* \w de|strong="H5921"\w* \w engaño|strong="H4820"\w*, \w como|strong="H5921"\w* jaulas \w llenas|strong="H4392"\w* \w de|strong="H5921"\w* pájaros; \w así|strong="H3651"\w* fue \w como|strong="H5921"\w* \w se|strong="H5921"\w* hicieron poderosos \w y|strong="H5921"\w* ricos.  
\v 28 Están gordos \w y|strong="H1571"\w* relucientes, \w y|strong="H1571"\w* su \w maldad|strong="H7451"\w* \w no|strong="H3808"\w* tiene límites. \w No|strong="H3808"\w* hacen \w justicia|strong="H4941"\w* al \w huérfano|strong="H3490"\w* para \w que|strong="H3808"\w* prospere, \w ni|strong="H3808"\w* defienden los \w derechos|strong="H4941"\w* \w de|strong="H1697"\w* los pobres.   
\p
\v 29 ¿Acaso \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* castigarlos \w por|strong="H5921"\w* \w esto|strong="H2088"\w*? — \w dice|strong="H5002"\w* Yahvé —. ¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* voy \w a|strong="H3068"\w* vengar \w de|strong="H5921"\w* una \w nación|strong="H1471"\w* \w así|strong="H2088"\w*?   
\p
\v 30 “Algo terrible y espantoso \w está|strong="H1961"\w* pasando en el país:  
\v 31 \w Los|strong="H5921"\w* \w profetas|strong="H5030"\w* dicen \w mentiras|strong="H8267"\w*, \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* gobiernan \w a|strong="H3068"\w* su antojo, ¡\w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w le|strong="H5921"\w* encanta \w que|strong="H4100"\w* sea \w así|strong="H3651"\w*! Pero, ¿\w qué|strong="H4100"\w* van \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w cuando|strong="H4100"\w* llegue \w el|strong="H5921"\w* final?’”.   
\c 6  
\p
\v 1 “¡Huyan \w para|strong="H5921"\w* ponerse \w a|strong="H3068"\w* salvo, descendientes \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*! ¡Salgan \w de|strong="H5921"\w* Jerusalén! Toquen \w la|strong="H5921"\w* \w trompeta|strong="H7782"\w* \w en|strong="H5921"\w* Tecoa \w y|strong="H3588"\w* den \w la|strong="H5921"\w* señal \w de|strong="H5921"\w* alarma \w en|strong="H5921"\w* Bet-Haquerem, \w porque|strong="H3588"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w norte|strong="H6828"\w* \w se|strong="H5921"\w* asoma \w el|strong="H5921"\w* desastre \w y|strong="H3588"\w* una destrucción total.  
\v 2 Voy \w a|strong="H3068"\w* destruir \w a|strong="H3068"\w* la \w hermosa|strong="H5000"\w* y delicada ciudad de \w Sión|strong="H6726"\w*.  
\v 3 \w Los|strong="H5921"\w* \w pastores|strong="H7462"\w* vendrán \w con|strong="H5921"\w* sus \w rebaños|strong="H5739"\w* \w y|strong="H5921"\w* armarán sus campamentos \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* \w ella|strong="H5921"\w*; cada uno alimentará \w a|strong="H3068"\w* sus animales \w en|strong="H5921"\w* su propio lugar”.   
\p
\v 4 “¡Preparen \w la|strong="H5921"\w* \w guerra|strong="H4421"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*! ¡\w Levántense|strong="H6965"\w*! Ataquemos \w al|strong="H5921"\w* mediodía. ¡Pobres \w de|strong="H5921"\w* \w nosotros|strong="H5921"\w*!, \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w se|strong="H5921"\w* acaba \w y|strong="H3588"\w* \w las|strong="H5921"\w* sombras \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w* ya \w se|strong="H5921"\w* alargan.  
\v 5 ¡\w Levántense|strong="H6965"\w*! Ataquemos de \w noche|strong="H3915"\w* y \w destruyamos|strong="H7843"\w* sus palacios”.  
\v 6 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: “Talen \w los|strong="H5921"\w* árboles \w y|strong="H3588"\w* levanten una rampa \w de|strong="H5921"\w* asalto \w contra|strong="H5921"\w* Jerusalén. \w Esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3588"\w* debe ser castigada; \w no|strong="H3588"\w* hay \w más|strong="H3588"\w* \w que|strong="H3588"\w* opresión \w en|strong="H5921"\w* \w ella|strong="H1931"\w*.  
\v 7 \w Así|strong="H3651"\w* \w como|strong="H5921"\w* un pozo mantiene fresca su \w agua|strong="H4325"\w*, \w así|strong="H3651"\w* Jerusalén mantiene fresca su \w maldad|strong="H7451"\w*. \w No|strong="H5921"\w* \w se|strong="H5921"\w* \w oye|strong="H8085"\w* \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w más|strong="H5921"\w* \w que|strong="H5921"\w* \w violencia|strong="H2555"\w* \w y|strong="H5921"\w* \w destrucción|strong="H7701"\w*; \w siempre|strong="H8548"\w* veo \w ante|strong="H6440"\w* \w mí|strong="H5921"\w* sus \w enfermedades|strong="H2483"\w* \w y|strong="H5921"\w* sus \w heridas|strong="H4347"\w*.  
\v 8 Aprende la lección, Jerusalén, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w yo|strong="H4480"\w* \w no|strong="H3808"\w* \w me|strong="H4480"\w* aleje \w de|strong="H4480"\w* \w ti|strong="H4480"\w*; \w no|strong="H3808"\w* \w sea|strong="H6435"\w* \w que|strong="H4480"\w* \w te|strong="H4480"\w* convierta \w en|strong="H4480"\w* un lugar desolado, \w en|strong="H4480"\w* una tierra donde \w nadie|strong="H3808"\w* viva”.   
\p
\v 9 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: “\w Rebuscarán|strong="H5953"\w* \w al|strong="H5921"\w* \w resto|strong="H7611"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w como|strong="H5921"\w* quien busca uvas \w en|strong="H5921"\w* una \w vid|strong="H1612"\w*. Pasa tu \w mano|strong="H3027"\w* otra vez \w por|strong="H5921"\w* \w las|strong="H5921"\w* ramas, \w como|strong="H5921"\w* quien cosecha uvas”.   
\p
\v 10 ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w puedo|strong="H3201"\w* \w hablarle|strong="H1696"\w*? ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w puedo|strong="H3201"\w* advertirle \w para|strong="H5921"\w* \w que|strong="H4310"\w* \w me|strong="H5921"\w* \w escuche|strong="H7181"\w*? \w Tienen|strong="H1961"\w* \w los|strong="H5921"\w* \w oídos|strong="H8085"\w* tapados \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w pueden|strong="H3201"\w* prestar atención. \w Se|strong="H1961"\w* burlan \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé; \w no|strong="H3808"\w* \w les|strong="H5921"\w* agrada \w en|strong="H5921"\w* absoluto.  
\v 11 \w Por|strong="H5921"\w* eso estoy \w lleno|strong="H4392"\w* \w del|strong="H5921"\w* \w enojo|strong="H2534"\w* \w de|strong="H5921"\w* Yahvé; ¡\w ya|strong="H1571"\w* \w no|strong="H3588"\w* puedo aguantarlo \w más|strong="H3588"\w*!  
\q1 “Derrámalo \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w niños|strong="H5768"\w* \w que|strong="H3588"\w* juegan \w en|strong="H5921"\w* \w la|strong="H5921"\w* calle  
\q2 \w y|strong="H1571"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* grupos \w de|strong="H5921"\w* jóvenes;  
\q1 \w porque|strong="H3588"\w* \w el|strong="H5921"\w* marido \w y|strong="H1571"\w* \w la|strong="H5921"\w* mujer serán atrapados,  
\q2 \w lo|strong="H5921"\w* \w mismo|strong="H1571"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w* \w y|strong="H1571"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* \w edad|strong="H3117"\w* avanzada.   
\q1
\v 12 Sus \w casas|strong="H1004"\w* pasarán \w a|strong="H3068"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* otros,  
\q2 \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus \w campos|strong="H7704"\w* \w y|strong="H3588"\w* sus esposas;  
\q1 \w porque|strong="H3588"\w* voy \w a|strong="H3068"\w* castigar \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* este país”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 13 “\w Porque|strong="H3588"\w* \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* importante, \w todos|strong="H3605"\w* se dejan llevar \w por|strong="H3588"\w* \w la|strong="H3588"\w* codicia. \w Desde|strong="H5704"\w* \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w*, \w todos|strong="H3605"\w* \w son|strong="H3588"\w* unos \w mentirosos|strong="H8267"\w*.   
\q1
\v 14 Han curado \w las|strong="H5921"\w* heridas \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* solo \w por|strong="H5921"\w* \w encima|strong="H5921"\w*,  
\q2 diciendo: ‘¡Todo \w está|strong="H5921"\w* \w bien|strong="H7965"\w*, todo \w está|strong="H5921"\w* \w bien|strong="H7965"\w*!’, cuando \w en|strong="H5921"\w* realidad nada \w está|strong="H5921"\w* \w bien|strong="H7965"\w*.   
\q1
\v 15 ¿Acaso \w se|strong="H3045"\w* avergonzaron \w de|strong="H3588"\w* sus actos asquerosos?  
\q2 ¡\w Para|strong="H3588"\w* \w nada|strong="H3808"\w*! \w Ni|strong="H3808"\w* siquiera \w saben|strong="H3045"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w la|strong="H1571"\w* \w vergüenza|strong="H3637"\w*.  
\q1 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w caerán|strong="H5307"\w* junto \w con|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w ya|strong="H1571"\w* han \w caído|strong="H5307"\w*;  
\q2 \w cuando|strong="H3588"\w* llegue \w el|strong="H3588"\w* momento \w de|strong="H3588"\w* castigarlos, serán destruidos”, dice Yahvé.   
\p
\v 16 \w Así|strong="H3541"\w* dice Yahvé: “Deténganse \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w caminos|strong="H1870"\w* \w y|strong="H5921"\w* observen; pregunten \w por|strong="H5921"\w* \w las|strong="H5921"\w* sendas \w antiguas|strong="H5769"\w*: ‘¿\w Cuál|strong="H5315"\w* \w es|strong="H2088"\w* \w el|strong="H5921"\w* \w buen|strong="H2896"\w* \w camino|strong="H1870"\w*?’. Caminen \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* encontrarán descanso \w para|strong="H5921"\w* su \w vida|strong="H5315"\w*”. Pero \w ellos|strong="H5921"\w* respondieron: ‘\w No|strong="H3808"\w* queremos caminar \w por|strong="H5921"\w* ahí’.  
\v 17 “También puse vigilantes \w sobre|strong="H5921"\w* ustedes \w que|strong="H3808"\w* \w les|strong="H5921"\w* dijeran: ‘¡Presten atención \w al|strong="H5921"\w* toque \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w trompeta|strong="H7782"\w*!’. Pero ustedes dijeron: ‘\w No|strong="H3808"\w* vamos \w a|strong="H3068"\w* hacer caso’”.  
\v 18 “\w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w escuchen|strong="H8085"\w*, \w naciones|strong="H1471"\w*; fíjense \w bien|strong="H3651"\w*, testigos, en lo \w que|strong="H3045"\w* le \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar \w a|strong="H3068"\w* este pueblo.  
\v 19 ¡\w Escucha|strong="H8085"\w*, tierra! Voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* una desgracia \w que|strong="H3588"\w* \w es|strong="H2088"\w* \w fruto|strong="H6529"\w* \w de|strong="H5921"\w* sus propias intrigas, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* hicieron caso \w a|strong="H3068"\w* mis \w palabras|strong="H1697"\w* \w y|strong="H3588"\w* rechazaron \w mi|strong="H5921"\w* enseñanza.  
\v 20 ¿Para \w qué|strong="H4100"\w* me traen \w incienso|strong="H3828"\w* de Sabá \w o|strong="H3068"\w* \w caña|strong="H7070"\w* dulce de tierras lejanas? Sus \w sacrificios|strong="H2077"\w* \w no|strong="H3808"\w* me agradan \w ni|strong="H3808"\w* \w acepto|strong="H7522"\w* sus ofrendas”.   
\p
\v 21 \w Por|strong="H2088"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé: “Voy \w a|strong="H3068"\w* ponerle obstáculos \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*. Padres \w e|strong="H3068"\w* \w hijos|strong="H1121"\w* \w tropezarán|strong="H3782"\w* con ellos; \w vecinos|strong="H7934"\w* \w y|strong="H3541"\w* \w amigos|strong="H7453"\w* morirán \w por|strong="H2088"\w* igual”.  
\v 22 \w Así|strong="H3541"\w* dice Yahvé: “Miren, un ejército viene desde el \w norte|strong="H6828"\w*; una \w gran|strong="H1419"\w* \w nación|strong="H1471"\w* \w se|strong="H5971"\w* levanta desde los rincones \w más|strong="H1471"\w* lejanos \w de|strong="H5971"\w* la tierra.  
\v 23 Vienen armados \w con|strong="H5921"\w* \w arcos|strong="H7198"\w* \w y|strong="H5921"\w* lanzas; \w son|strong="H3808"\w* crueles \w y|strong="H5921"\w* \w no|strong="H3808"\w* tienen compasión. \w Sus|strong="H1931"\w* gritos suenan \w como|strong="H5921"\w* \w el|strong="H1931"\w* rugido \w del|strong="H5921"\w* \w mar|strong="H3220"\w*. Vienen montados \w a|strong="H3068"\w* \w caballo|strong="H5483"\w*, listos \w para|strong="H5921"\w* \w la|strong="H1931"\w* \w batalla|strong="H4421"\w* \w como|strong="H5921"\w* un \w solo|strong="H1931"\w* hombre, \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, ciudad \w de|strong="H5921"\w* \w Sión|strong="H6726"\w*”.   
\p
\v 24 Al \w oír|strong="H8085"\w* las noticias, se nos quitaron las fuerzas. Nos atrapó la \w angustia|strong="H6869"\w*; sentimos dolores como de mujer de parto.  
\v 25 \w No|strong="H3588"\w* \w salgan|strong="H3318"\w* al \w campo|strong="H7704"\w* ni \w anden|strong="H3212"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* enemigo está armado \w y|strong="H3588"\w* \w el|strong="H3588"\w* terror nos rodea.  
\v 26 ¡\w Pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*, vístete \w de|strong="H5921"\w* luto \w y|strong="H3588"\w* \w revuélcate|strong="H6428"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* ceniza! Llora \w con|strong="H5921"\w* amargura, \w como|strong="H3588"\w* \w si|strong="H3588"\w* \w se|strong="H5921"\w* \w te|strong="H5921"\w* hubiera \w muerto|strong="H7703"\w* \w tu|strong="H6213"\w* \w único|strong="H3173"\w* hijo, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* destructor vendrá \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w cuando|strong="H3588"\w* \w menos|strong="H3588"\w* \w lo|strong="H5921"\w* esperemos.   
\p
\v 27 “Jeremías, te he \w puesto|strong="H5414"\w* como quien prueba los metales \w para|strong="H5414"\w* \w que|strong="H5971"\w* examines \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* y conozcas su conducta.  
\v 28 \w Todos|strong="H3605"\w* \w ellos|strong="H1992"\w* son muy rebeldes y \w andan|strong="H1980"\w* contando chismes. Son tercos como \w el|strong="H3605"\w* bronce y \w el|strong="H3605"\w* \w hierro|strong="H1270"\w*; \w todos|strong="H3605"\w* son \w unos|strong="H1992"\w* corruptos.  
\v 29 El fuelle sopla con fuerza para quemar el plomo, pero \w de|strong="H7451"\w* \w nada|strong="H3808"\w* sirve \w que|strong="H3808"\w* el refinador siga trabajando, \w porque|strong="H3808"\w* la \w maldad|strong="H7451"\w* \w de|strong="H7451"\w* esta gente \w no|strong="H3808"\w* \w se|strong="H3808"\w* quita.  
\v 30 Se les \w llamará|strong="H7121"\w* ‘\w plata|strong="H3701"\w* \w desechada|strong="H3988"\w*’, \w porque|strong="H3588"\w* Yahvé \w los|strong="H3588"\w* ha rechazado”.   
\c 7  
\p
\v 1 \w Palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé dirigió \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 2 “\w Ponte|strong="H5975"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada del \w templo|strong="H1004"\w* \w de|strong="H1697"\w* Yahvé y proclama \w allí|strong="H8033"\w* \w este|strong="H2088"\w* mensaje: ‘\w Escuchen|strong="H8085"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, \w todos|strong="H3605"\w* ustedes \w los|strong="H3605"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* \w que|strong="H1697"\w* entran \w por|strong="H1697"\w* \w estas|strong="H5975"\w* \w puertas|strong="H8179"\w* para adorar \w a|strong="H3068"\w* Yahvé’”.   
\p
\v 3 \w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: “Mejoren su conducta \w y|strong="H3541"\w* sus acciones, \w y|strong="H3541"\w* yo los dejaré vivir en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 4 No confíen en esas \w palabras|strong="H1697"\w* mentirosas \w que|strong="H1697"\w* dicen: ‘¡Este \w es|strong="H1697"\w* \w el|strong="H1992"\w* \w templo|strong="H1964"\w* \w de|strong="H1697"\w* Yahvé, \w el|strong="H1992"\w* \w templo|strong="H1964"\w* \w de|strong="H1697"\w* Yahvé, \w el|strong="H1992"\w* \w templo|strong="H1964"\w* \w de|strong="H1697"\w* Yahvé!’.  
\v 5 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w de|strong="H3588"\w* veras mejoran \w su|strong="H3588"\w* conducta \w y|strong="H3588"\w* sus acciones, \w y|strong="H3588"\w* \w si|strong="H3588"\w* \w de|strong="H3588"\w* veras practican \w la|strong="H3588"\w* \w justicia|strong="H4941"\w* \w entre|strong="H3588"\w* ustedes;  
\v 6 \w si|strong="H3808"\w* dejan \w de|strong="H1818"\w* oprimir al \w extranjero|strong="H1616"\w*, al \w huérfano|strong="H3490"\w* \w y|strong="H5355"\w* \w a|strong="H3068"\w* la viuda; \w si|strong="H3808"\w* \w no|strong="H3808"\w* derraman \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w* \w en|strong="H3212"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w ni|strong="H3808"\w* \w se|strong="H3808"\w* van tras otros dioses para su propio \w mal|strong="H7451"\w*,  
\v 7 entonces los dejaré vivir \w en|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, \w en|strong="H4480"\w* la tierra \w que|strong="H4480"\w* les \w di|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 8 Pero miren, ustedes confían \w en|strong="H5921"\w* \w palabras|strong="H1697"\w* mentirosas \w que|strong="H5921"\w* \w no|strong="H5921"\w* sirven \w para|strong="H5921"\w* \w nada|strong="H1697"\w*.  
\v 9 ¿Acaso piensan \w que|strong="H3808"\w* pueden robar, matar, cometer adulterio, jurar en \w falso|strong="H8267"\w*, ofrecer incienso \w a|strong="H3068"\w* \w Baal|strong="H1168"\w* y seguir \w a|strong="H3068"\w* otros dioses \w que|strong="H3808"\w* \w ni|strong="H3808"\w* \w conocen|strong="H3045"\w*,  
\v 10 \w y|strong="H5921"\w* \w luego|strong="H2088"\w* venir \w a|strong="H3068"\w* presentarse \w ante|strong="H6440"\w* \w mí|strong="H5921"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w que|strong="H5921"\w* lleva \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w y|strong="H5921"\w* \w decir|strong="H7121"\w*: ‘Estamos \w a|strong="H3068"\w* salvo’, \w para|strong="H4616"\w* seguir cometiendo \w todas|strong="H3605"\w* \w estas|strong="H5975"\w* cosas despreciables?  
\v 11 ¿Creen ustedes \w que|strong="H5921"\w* \w este|strong="H2088"\w* \w templo|strong="H1004"\w* \w donde|strong="H5921"\w* \w se|strong="H1961"\w* invoca \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w* \w es|strong="H1961"\w* una \w cueva|strong="H4631"\w* \w de|strong="H5921"\w* ladrones? ¡\w Yo|strong="H2009"\w* \w mismo|strong="H1571"\w* \w lo|strong="H2088"\w* he \w visto|strong="H7200"\w*! — \w dice|strong="H5002"\w* Yahvé —.   
\p
\v 12 “\w Vayan|strong="H3212"\w* \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* \w mi|strong="H4994"\w* santuario \w en|strong="H3588"\w* \w Silo|strong="H7887"\w*, \w donde|strong="H8033"\w* al principio \w hice|strong="H6213"\w* habitar \w mi|strong="H4994"\w* \w nombre|strong="H8034"\w*, \w y|strong="H3588"\w* \w vean|strong="H7200"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* le \w hice|strong="H6213"\w* \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H7451"\w* \w de|strong="H3588"\w* \w mi|strong="H4994"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.  
\v 13 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w*, como ustedes han \w hecho|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas — \w dice|strong="H5002"\w* Yahvé — y, \w a|strong="H3068"\w* pesar de \w que|strong="H3808"\w* les \w hablé|strong="H1696"\w* insistentemente, \w no|strong="H3808"\w* me \w escucharon|strong="H8085"\w*, y \w a|strong="H3068"\w* pesar de \w que|strong="H3808"\w* \w los|strong="H3605"\w* \w llamé|strong="H7121"\w*, \w no|strong="H3808"\w* me \w respondieron|strong="H6030"\w*;  
\v 14 \w por|strong="H5921"\w* eso, \w lo|strong="H5921"\w* mismo \w que|strong="H5921"\w* \w le|strong="H5921"\w* \w hice|strong="H6213"\w* \w a|strong="H3068"\w* \w Silo|strong="H7887"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* voy \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w a|strong="H3068"\w* este \w templo|strong="H1004"\w* \w que|strong="H5921"\w* lleva \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* cual ustedes confían, \w y|strong="H5921"\w* \w a|strong="H3068"\w* este \w lugar|strong="H4725"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus antepasados.  
\v 15 \w Los|strong="H5921"\w* arrojaré \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*, tal \w como|strong="H5921"\w* arrojé \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus hermanos, \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w descendencia|strong="H2233"\w*\f + \fr 7:15 \ft O bien, semilla.\f* \w de|strong="H5921"\w* Efraín.   
\p
\v 16 “\w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w a|strong="H3068"\w* ti, Jeremías, \w no|strong="H3588"\w* \w ores|strong="H6419"\w* \w por|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*. \w No|strong="H3588"\w* \w me|strong="H3588"\w* eleves ningún \w clamor|strong="H7440"\w* ni \w oración|strong="H8605"\w* \w por|strong="H3588"\w* ellos, ni \w me|strong="H3588"\w* insistas, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* \w te|strong="H3588"\w* voy \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w*.  
\v 17 ¿\w No|strong="H6213"\w* \w ves|strong="H7200"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w hacen|strong="H6213"\w* en \w las|strong="H1992"\w* \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w* y en \w las|strong="H1992"\w* \w calles|strong="H2351"\w* de Jerusalén?  
\v 18 \w Los|strong="H1121"\w* niños \w recogen|strong="H3950"\w* \w la|strong="H1197"\w* \w leña|strong="H6086"\w*, \w los|strong="H1121"\w* padres \w encienden|strong="H1197"\w* \w el|strong="H1121"\w* fuego \w y|strong="H1197"\w* las mujeres preparan \w la|strong="H1197"\w* masa \w para|strong="H4616"\w* \w hacerle|strong="H6213"\w* \w tortas|strong="H3561"\w* \w a|strong="H3068"\w* \w la|strong="H1197"\w* ‘Reina del \w Cielo|strong="H8064"\w*’ \w y|strong="H1197"\w* ofrecer \w libaciones|strong="H5262"\w* \w a|strong="H3068"\w* otros dioses, solo \w para|strong="H4616"\w* provocar mi enojo.  
\v 19 ¿Pero es \w a|strong="H3068"\w* mí \w a|strong="H3068"\w* quien ofenden? — \w dice|strong="H5002"\w* Yahvé —. ¿\w No|strong="H3808"\w* \w se|strong="H1992"\w* dañan \w más|strong="H3808"\w* bien \w a|strong="H3068"\w* \w sí|strong="H3808"\w* \w mismos|strong="H1992"\w*, \w para|strong="H4616"\w* \w su|strong="H1992"\w* propia vergüenza?”.   
\p
\v 20 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: “\w Mi|strong="H5921"\w* furia \w y|strong="H5921"\w* \w mi|strong="H5921"\w* \w ira|strong="H2534"\w* \w se|strong="H5921"\w* van \w a|strong="H3068"\w* derramar \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*: \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* gente \w y|strong="H5921"\w* \w los|strong="H5921"\w* animales, \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w árboles|strong="H6086"\w* \w del|strong="H5921"\w* \w campo|strong="H7704"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w frutos|strong="H6529"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra; \w y|strong="H5921"\w* \w arderá|strong="H1197"\w* \w como|strong="H5921"\w* un fuego \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* \w podrá|strong="H3808"\w* apagar”.   
\p
\v 21 \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: “¡Sigan acumulando sus \w holocaustos|strong="H5930"\w* \w y|strong="H5921"\w* sus \w sacrificios|strong="H2077"\w*, \w y|strong="H5921"\w* cómanse \w la|strong="H5921"\w* \w carne|strong="H1320"\w* ustedes mismos!  
\v 22 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w saqué|strong="H3318"\w* \w a|strong="H3068"\w* sus antepasados \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w di|strong="H1696"\w* órdenes \w sobre|strong="H5921"\w* \w holocaustos|strong="H5930"\w* \w o|strong="H3068"\w* \w sacrificios|strong="H2077"\w*.  
\v 23 \w Lo|strong="H1697"\w* \w que|strong="H3588"\w* \w sí|strong="H3588"\w* \w les|strong="H6680"\w* \w ordené|strong="H6680"\w* \w fue|strong="H1961"\w* \w esto|strong="H2088"\w*: ‘\w Escuchen|strong="H8085"\w* \w mi|strong="H1961"\w* \w voz|strong="H6963"\w*, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H3588"\w* Dios \w y|strong="H3588"\w* ustedes \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*. Caminen \w por|strong="H3588"\w* \w todo|strong="H3605"\w* \w camino|strong="H1870"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w les|strong="H6680"\w* \w mande|strong="H6680"\w*, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w les|strong="H6680"\w* vaya \w bien|strong="H3190"\w*’.  
\v 24 Pero ellos \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* prestaron atención, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* siguieron sus propias ideas y la terquedad \w de|strong="H6440"\w* su \w malvado|strong="H7451"\w* \w corazón|strong="H3820"\w*; \w caminaron|strong="H3212"\w* \w hacia|strong="H6440"\w* atrás y \w no|strong="H3808"\w* \w hacia|strong="H6440"\w* adelante.  
\v 25 \w Desde|strong="H4480"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* sus antepasados \w salieron|strong="H3318"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, les he \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* mis \w siervos|strong="H5650"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w*, una \w y|strong="H5704"\w* otra vez.  
\v 26 Pero \w no|strong="H3808"\w* me \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* me prestaron atención, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* pusieron tercos y \w se|strong="H3808"\w* portaron \w peor|strong="H7489"\w* \w que|strong="H3808"\w* sus antepasados.   
\p
\v 27 “Tú les \w dirás|strong="H1696"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*, pero \w no|strong="H3808"\w* te van \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w*; \w los|strong="H3605"\w* \w llamarás|strong="H7121"\w*, pero \w no|strong="H3808"\w* te van \w a|strong="H3068"\w* \w responder|strong="H6030"\w*.  
\v 28 Entonces les dirás: ‘\w Esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w nación|strong="H1471"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w escuchó|strong="H8085"\w* la \w voz|strong="H6963"\w* de Yahvé su \w Dios|strong="H3068"\w*, \w ni|strong="H3808"\w* quiso ser corregida. La verdad \w ha|strong="H3808"\w* muerto; \w ha|strong="H3808"\w* sido borrada de sus labios’.  
\v 29 Ráscate \w la|strong="H5921"\w* cabeza \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* luto \w y|strong="H3588"\w* \w eleva|strong="H5375"\w* un lamento \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas desoladas, \w porque|strong="H3588"\w* Yahvé ha rechazado \w y|strong="H3588"\w* abandonado \w a|strong="H3068"\w* \w esta|strong="H5921"\w* \w generación|strong="H1755"\w* \w que|strong="H3588"\w* provocó \w su|strong="H3588"\w* ira.   
\p
\v 30 “\w Porque|strong="H3588"\w* \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* ha \w hecho|strong="H6213"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* ofende — \w dice|strong="H5002"\w* Yahvé —. \w Pusieron|strong="H7760"\w* sus ídolos asquerosos \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w que|strong="H3588"\w* lleva \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w para|strong="H5921"\w* profanarlo.  
\v 31 Construyeron \w los|strong="H1121"\w* santuarios paganos \w de|strong="H5921"\w* Tofet, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w valle|strong="H1516"\w* \w de|strong="H5921"\w* Ben-Hinom, \w para|strong="H5921"\w* quemar \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w hijas|strong="H1323"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* fuego; algo \w que|strong="H3808"\w* \w yo|strong="H6680"\w* \w nunca|strong="H3808"\w* \w ordené|strong="H6680"\w* \w ni|strong="H3808"\w* \w jamás|strong="H3808"\w* \w me|strong="H5921"\w* pasó \w por|strong="H5921"\w* \w la|strong="H5921"\w* mente.  
\v 32 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H3588"\w* \w que|strong="H3588"\w* ya \w no|strong="H3808"\w* \w se|strong="H3808"\w* llamará \w más|strong="H5750"\w* Tofet \w ni|strong="H3808"\w* \w valle|strong="H1516"\w* \w de|strong="H3588"\w* Ben-Hinom, \w sino|strong="H3588"\w* ‘\w Valle|strong="H1516"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* Matanza’; \w y|strong="H3588"\w* tendrán \w que|strong="H3588"\w* enterrar \w a|strong="H3068"\w* \w los|strong="H1121"\w* muertos \w en|strong="H3588"\w* Tofet \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w habrá|strong="H3117"\w* \w más|strong="H5750"\w* \w lugar|strong="H4725"\w*.  
\v 33 \w Los|strong="H1961"\w* cadáveres \w de|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w servirán|strong="H1961"\w* \w de|strong="H5971"\w* \w comida|strong="H3978"\w* \w a|strong="H3068"\w* las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w* y \w a|strong="H3068"\w* las fieras \w de|strong="H5971"\w* la tierra, y \w no|strong="H1961"\w* \w habrá|strong="H1961"\w* nadie \w que|strong="H5971"\w* las espante.  
\v 34 Haré \w que|strong="H3588"\w* \w en|strong="H3588"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* las \w calles|strong="H2351"\w* \w de|strong="H3588"\w* Jerusalén \w se|strong="H1961"\w* apaguen \w los|strong="H1961"\w* gritos \w de|strong="H3588"\w* \w alegría|strong="H8057"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* entusiasmo, \w y|strong="H3588"\w* las \w voces|strong="H6963"\w* del novio \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* novia; \w porque|strong="H3588"\w* todo \w el|strong="H3588"\w* país \w quedará|strong="H1961"\w* convertido \w en|strong="H3588"\w* un desierto”.   
\c 8  
\p
\v 1 “\w En|strong="H3318"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* — \w dice|strong="H5002"\w* Yahvé — \w sacarán|strong="H3318"\w* \w de|strong="H8269"\w* \w sus|strong="H1931"\w* tumbas \w los|strong="H3427"\w* \w huesos|strong="H6106"\w* \w de|strong="H8269"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*, \w los|strong="H3427"\w* \w huesos|strong="H6106"\w* \w de|strong="H8269"\w* \w sus|strong="H1931"\w* \w jefes|strong="H8269"\w*, \w los|strong="H3427"\w* \w huesos|strong="H6106"\w* \w de|strong="H8269"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w huesos|strong="H6106"\w* \w de|strong="H8269"\w* \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* y \w los|strong="H3427"\w* \w huesos|strong="H6106"\w* \w de|strong="H8269"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H8269"\w* Jerusalén.  
\v 2 \w Los|strong="H5921"\w* dejarán desparramados bajo \w el|strong="H5921"\w* \w sol|strong="H8121"\w*, \w la|strong="H5921"\w* \w luna|strong="H3394"\w* \w y|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* estrellas \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w ellos|strong="H5921"\w* amaron, \w sirvieron|strong="H5647"\w* \w y|strong="H5921"\w* consultaron, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w caminaron|strong="H1980"\w* siguiendo \w y|strong="H5921"\w* \w adoraron|strong="H7812"\w*. \w No|strong="H3808"\w* \w serán|strong="H1961"\w* recogidos \w ni|strong="H3808"\w* \w enterrados|strong="H6912"\w*; \w se|strong="H1961"\w* quedarán \w como|strong="H1961"\w* abono \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\v 3 \w En|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* \w por|strong="H4480"\w* \w donde|strong="H8033"\w* \w yo|strong="H4480"\w* \w los|strong="H3605"\w* haya dispersado, \w los|strong="H3605"\w* sobrevivientes \w de|strong="H4480"\w* \w esta|strong="H2063"\w* nación malvada preferirán \w la|strong="H2063"\w* \w muerte|strong="H4194"\w* \w antes|strong="H4480"\w* \w que|strong="H4480"\w* \w la|strong="H2063"\w* \w vida|strong="H2416"\w*”, \w dice|strong="H5002"\w* Yahvé \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*.  
\v 4 “Diles también \w que|strong="H3808"\w* \w así|strong="H3541"\w* dice Yahvé:  
\q1 “‘¿Acaso \w si|strong="H3808"\w* uno \w se|strong="H3808"\w* \w cae|strong="H5307"\w*, \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* \w levantar|strong="H6965"\w*?  
\q2 \w Si|strong="H3808"\w* uno \w se|strong="H3808"\w* equivoca de camino, ¿\w no|strong="H3808"\w* regresa?   
\q1
\v 5 ¿\w Por|strong="H4069"\w* \w qué|strong="H5971"\w*, \w entonces|strong="H7725"\w*, \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Jerusalén persiste en su rebeldía?  
\q2 \w Se|strong="H5971"\w* aferran \w a|strong="H3068"\w* sus mentiras  
\q2 y \w se|strong="H5971"\w* niegan \w a|strong="H3068"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H3389"\w*.   
\q1
\v 6 He escuchado \w con|strong="H5921"\w* atención, pero \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w dicen|strong="H1696"\w* \w no|strong="H3808"\w* es \w la|strong="H5921"\w* \w verdad|strong="H3651"\w*.  
\q2 \w No|strong="H3808"\w* hay \w nadie|strong="H3808"\w* \w que|strong="H4100"\w* \w se|strong="H5921"\w* arrepienta \w de|strong="H5921"\w* su \w maldad|strong="H7451"\w* \w y|strong="H5921"\w* \w diga|strong="H1696"\w*: “¿\w Qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* he \w hecho|strong="H6213"\w*?”.  
\q1 \w Cada|strong="H3605"\w* uno sigue su propio \w camino|strong="H7451"\w*,  
\q2 \w como|strong="H4100"\w* \w caballo|strong="H5483"\w* \w que|strong="H4100"\w* \w se|strong="H5921"\w* lanza desbocado \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w*.   
\q1
\v 7 Hasta \w la|strong="H1571"\w* cigüeña en \w el|strong="H1571"\w* \w cielo|strong="H8064"\w* \w conoce|strong="H3045"\w* sus estaciones;  
\q2 \w la|strong="H1571"\w* tórtola, \w la|strong="H1571"\w* golondrina \w y|strong="H1571"\w* \w la|strong="H1571"\w* grulla \w saben|strong="H3045"\w* \w cuándo|strong="H1571"\w* deben volver;  
\q2 pero mi \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* \w conoce|strong="H3045"\w* las leyes \w de|strong="H5971"\w* Yahvé.   
\b  
\q1
\v 8 “‘¿Cómo se atreven \w a|strong="H3068"\w* decir: “Somos \w sabios|strong="H2450"\w*, y tenemos la \w ley|strong="H8451"\w* de Yahvé”?  
\q2 ¡\w Si|strong="H2009"\w* la pluma \w mentirosa|strong="H8267"\w* de \w los|strong="H2450"\w* \w escribas|strong="H5608"\w* la ha falsificado!   
\q1
\v 9 \w Los|strong="H2450"\w* \w sabios|strong="H2450"\w* quedarán avergonzados,  
\q2 espantados y atrapados.  
\q1 \w Si|strong="H2009"\w* han rechazado \w la|strong="H2451"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé,  
\q2 ¿\w qué|strong="H4100"\w* \w sabiduría|strong="H2451"\w* les queda?   
\q1
\v 10 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w daré|strong="H5414"\w* sus esposas \w a|strong="H3068"\w* otros  
\q2 \w y|strong="H3588"\w* sus \w campos|strong="H7704"\w* \w a|strong="H3068"\w* nuevos dueños.  
\q1 \w Porque|strong="H3588"\w* \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* importante, \w todos|strong="H3605"\w* \w se|strong="H3651"\w* dejan llevar \w por|strong="H3588"\w* \w la|strong="H3588"\w* codicia;  
\q2 \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w*, \w todos|strong="H3605"\w* \w son|strong="H3588"\w* unos \w mentirosos|strong="H8267"\w*.   
\q1
\v 11 Han curado \w la|strong="H5921"\w* herida \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* solo \w por|strong="H5921"\w* \w encima|strong="H5921"\w*,  
\q2 diciendo: “¡Todo \w está|strong="H5921"\w* \w bien|strong="H7965"\w*, todo \w está|strong="H5921"\w* \w bien|strong="H7965"\w*!”, cuando \w en|strong="H5921"\w* realidad nada \w está|strong="H5921"\w* \w bien|strong="H7965"\w*.   
\q1
\v 12 ¿\w Se|strong="H3045"\w* avergonzaron \w de|strong="H3588"\w* sus actos asquerosos?  
\q2 ¡\w Para|strong="H3588"\w* \w nada|strong="H3808"\w*! \w Ni|strong="H3808"\w* siquiera \w saben|strong="H3045"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w la|strong="H1571"\w* \w vergüenza|strong="H3637"\w*.  
\q1 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w caerán|strong="H5307"\w* junto \w con|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w ya|strong="H1571"\w* han \w caído|strong="H5307"\w*;  
\q2 \w cuando|strong="H3588"\w* llegue \w el|strong="H3588"\w* momento \w de|strong="H3588"\w* castigarlos, serán destruidos, dice Yahvé.   
\b  
\q1
\v 13 “‘Voy \w a|strong="H3068"\w* acabar con \w ellos|strong="H1992"\w*, \w dice|strong="H5002"\w* Yahvé.  
\q2 No \w quedarán|strong="H5414"\w* \w uvas|strong="H6025"\w* en la \w vid|strong="H1612"\w*,  
\q2 ni \w higos|strong="H8384"\w* en la higuera;  
\q2 hasta \w las|strong="H1992"\w* \w hojas|strong="H5929"\w* \w se|strong="H1992"\w* marchitarán.  
\q1 Todo \w lo|strong="H1992"\w* \w que|strong="H1992"\w* \w les|strong="H1992"\w* he \w dado|strong="H5414"\w*,  
\q2 \w lo|strong="H1992"\w* van \w a|strong="H3068"\w* perder’”.   
\b  
\q1
\v 14 “¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* \w nos|strong="H5921"\w* quedamos \w aquí|strong="H8033"\w* \w sentados|strong="H3427"\w*?  
\q2 ¡Júntense!  
\q2 Entremos \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* fortificadas \w y|strong="H3588"\w* esperemos \w allí|strong="H8033"\w* \w el|strong="H5921"\w* final;  
\q1 \w porque|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w nos|strong="H5921"\w* ha condenado \w a|strong="H3068"\w* morir,  
\q2 \w y|strong="H3588"\w* \w nos|strong="H5921"\w* ha dado \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w agua|strong="H4325"\w* envenenada,  
\q2 \w porque|strong="H3588"\w* \w pecamos|strong="H2398"\w* \w contra|strong="H5921"\w* \w él|strong="H5921"\w*.   
\q1
\v 15 \w Esperábamos|strong="H6960"\w* la \w paz|strong="H7965"\w*, pero no llegó nada \w bueno|strong="H2896"\w*;  
\q2 \w esperábamos|strong="H6960"\w* un \w tiempo|strong="H6256"\w* \w de|strong="H6256"\w* sanidad, ¡y solo \w hubo|strong="H2009"\w* terror!   
\q1
\v 16 Desde \w la|strong="H3605"\w* región de \w Dan|strong="H1835"\w* se \w escucha|strong="H8085"\w* \w el|strong="H3605"\w* resoplido de sus \w caballos|strong="H5483"\w*;  
\q2 \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w tiembla|strong="H7493"\w* por \w el|strong="H3605"\w* relincho de sus sementales.  
\q1 Vienen \w a|strong="H3068"\w* devorar \w el|strong="H3605"\w* país y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* hay en \w él|strong="H3605"\w*,  
\q2 \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w habitantes|strong="H3427"\w*”.   
\q1
\v 17 “Miren \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w envío|strong="H7971"\w* contra ustedes \w serpientes|strong="H5175"\w*,  
\q2 víboras \w que|strong="H3588"\w* \w no|strong="H3588"\w* se pueden encantar  
\q2 \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* morderán”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 18 ¡\w El|strong="H5921"\w* \w dolor|strong="H3015"\w* \w me|strong="H5921"\w* consume \w y|strong="H5921"\w* \w no|strong="H5921"\w* hallo consuelo!  
\q2 \w Se|strong="H5921"\w* \w me|strong="H5921"\w* desmaya \w el|strong="H5921"\w* \w corazón|strong="H3820"\w*.   
\q1
\v 19 Escuchen los gritos \w de|strong="H5971"\w* \w mi|strong="H2009"\w* \w pueblo|strong="H5971"\w* desde una tierra \w lejana|strong="H4801"\w*:  
\q2 “¿Acaso ya no está Yahvé en \w Sión|strong="H6726"\w*?  
\q2 ¿\w Ya|strong="H3068"\w* no está su \w Rey|strong="H4428"\w* en ella?”.  
\b  
\q1 “¿\w Por|strong="H4069"\w* \w qué|strong="H5971"\w* me hicieron enojar con sus \w ídolos|strong="H6456"\w*,  
\q2 con esos dioses extranjeros \w que|strong="H5971"\w* no sirven \w para|strong="H5971"\w* nada?”.   
\b  
\q1
\v 20 “\w Pasó|strong="H5674"\w* la cosecha,  
\q2 \w se|strong="H3808"\w* \w acabó|strong="H3615"\w* \w el|strong="H5674"\w* \w verano|strong="H7019"\w*,  
\q2 y nosotros \w no|strong="H3808"\w* fuimos salvados”.   
\b  
\q1
\v 21 Estoy deshecho \w por|strong="H5921"\w* \w el|strong="H5921"\w* dolor \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*;  
\q2 camino sombrío,  
\q2 \w me|strong="H5921"\w* ha atrapado \w el|strong="H5921"\w* terror.   
\q1
\v 22 ¿Acaso \w no|strong="H3808"\w* hay \w bálsamo|strong="H6875"\w* \w en|strong="H3588"\w* \w Galaad|strong="H1568"\w*?  
\q2 ¿\w No|strong="H3808"\w* hay \w allí|strong="H8033"\w* \w ningún|strong="H3808"\w* \w médico|strong="H7495"\w*?  
\q1 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w*, \w entonces|strong="H3588"\w*, \w no|strong="H3808"\w* \w ha|strong="H3808"\w* sanado \w la|strong="H3588"\w* herida \w de|strong="H3588"\w* mi \w pueblo|strong="H5971"\w*?   
\c 9  
\q1
\v 1 ¡\w Ojalá|strong="H4310"\w* mi cabeza fuera un manantial  
\q2 \w y|strong="H3588"\w* \w mis|strong="H5414"\w* ojos una fuente \w de|strong="H3588"\w* lágrimas,  
\q1 \w para|strong="H3588"\w* llorar \w de|strong="H3588"\w* día \w y|strong="H3588"\w* \w de|strong="H3588"\w* noche  
\q2 \w por|strong="H3588"\w* \w los|strong="H3605"\w* muertos \w de|strong="H3588"\w* mi querido \w pueblo|strong="H5971"\w*!   
\q1
\v 2 ¡Ojalá tuviera \w yo|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* desierto  
\q2 un lugar \w para|strong="H3588"\w* pasar \w la|strong="H3588"\w* noche,  
\q1 \w para|strong="H3588"\w* alejarme \w de|strong="H3588"\w* mi pueblo  
\q2 \w y|strong="H3588"\w* dejarlo atrás!  
\q1 \w Porque|strong="H3588"\w* todos ellos \w son|strong="H3588"\w* adúlteros,  
\q2 una banda \w de|strong="H3588"\w* traidores.   
\q1
\v 3 “Preparan \w su|strong="H3588"\w* lengua \w como|strong="H3588"\w* un arco \w para|strong="H5921"\w* lanzar mentiras;  
\q2 \w en|strong="H5921"\w* \w el|strong="H5921"\w* país han cobrado fuerza, \w pero|strong="H3588"\w* \w no|strong="H3588"\w* \w para|strong="H5921"\w* buscar \w la|strong="H5921"\w* verdad.  
\q1 Pasan \w de|strong="H5921"\w* una maldad \w a|strong="H3068"\w* otra,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w no|strong="H3588"\w* \w me|strong="H5921"\w* conocen”, dice Yahvé.   
\q1
\v 4 “Cuídese cada uno \w de|strong="H3811"\w* su vecino,  
\q2 y \w no|strong="H3808"\w* confíen \w ni|strong="H3808"\w* en su propio hermano;  
\q1 \w porque|strong="H3808"\w* cada hermano actúa con \w engaño|strong="H8267"\w*,  
\q2 y cada \w amigo|strong="H7453"\w* anda contando chismes.   
\q1
\v 5 Todos \w se|strong="H3045"\w* engañan \w entre|strong="H8432"\w* sí,  
\q2 nadie \w dice|strong="H5002"\w* la verdad.  
\q1 Han acostumbrado su lengua \w a|strong="H3068"\w* mentir;  
\q2 \w se|strong="H3045"\w* agotan cometiendo maldades.   
\q1
\v 6 \w Tú|strong="H6213"\w* vives \w en|strong="H3588"\w* medio del engaño;  
\q2 \w por|strong="H3588"\w* \w su|strong="H3588"\w* falsedad, \w se|strong="H3651"\w* niegan \w a|strong="H3068"\w* conocerme”, dice Yahvé.   
\p
\v 7 Por eso, \w así|strong="H1696"\w* \w dice|strong="H1696"\w* Yahvé de los Ejércitos:  
\q1 “Miren, voy \w a|strong="H3068"\w* purificarlos y \w a|strong="H3068"\w* ponerlos \w a|strong="H3068"\w* prueba;  
\q2 pues ¿\w qué|strong="H6310"\w* \w más|strong="H7453"\w* puedo hacer con mi pueblo?   
\q1
\v 8 Su lengua \w es|strong="H2088"\w* una flecha venenosa, solo habla mentiras.  
\q2 \w Con|strong="H5921"\w* \w la|strong="H5921"\w* boca saludan amablemente \w a|strong="H3068"\w* su prójimo,  
\q1 pero \w por|strong="H5921"\w* \w dentro|strong="H5921"\w* \w le|strong="H5921"\w* \w están|strong="H2088"\w* tendiendo una trampa.   
\q1
\v 9 ¿Acaso \w no|strong="H3808"\w* \w voy|strong="H1980"\w* \w a|strong="H3068"\w* castigarlos \w por|strong="H5921"\w* esto? — dice Yahvé —.  
\q2 ¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* \w voy|strong="H1980"\w* \w a|strong="H3068"\w* vengar \w de|strong="H5921"\w* una nación \w así|strong="H3588"\w*?   
\q1
\v 10 Lloraré y me lamentaré \w por|strong="H5414"\w* las montañas,  
\q2 y elevaré un lamento \w por|strong="H5414"\w* las pasturas del desierto;  
\q1 porque \w están|strong="H3427"\w* tan quemadas que ya nadie pasa \w por|strong="H5414"\w* ellas,  
\q2 y ya \w no|strong="H1097"\w* se escucha \w el|strong="H3427"\w* mugido del ganado.  
\q1 Tanto las aves del cielo como \w los|strong="H3427"\w* animales  
\q2 salieron huyendo y desaparecieron.   
\b  
\q1
\v 11 “Voy \w a|strong="H3068"\w* convertir \w a|strong="H3068"\w* Jerusalén \w en|strong="H5921"\w* un montón \w de|strong="H5921"\w* escombros,  
\q2 \w en|strong="H5921"\w* una guarida \w de|strong="H5921"\w* chacales.  
\q1 Dejaré \w las|strong="H5921"\w* ciudades \w de|strong="H5921"\w* Judá \w desiertas|strong="H4057"\w*,  
\q2 \w sin|strong="H1097"\w* un solo habitante”.   
\p
\v 12 ¿Quién es tan sabio \w que|strong="H3808"\w* pueda entender esto? ¿\w A|strong="H3068"\w* quién \w le|strong="H5921"\w* \w ha|strong="H3808"\w* hablado Yahvé \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* explique? ¿\w Por|strong="H5921"\w* \w qué|strong="H3808"\w* \w el|strong="H5921"\w* país \w está|strong="H5921"\w* arruinado \w y|strong="H5921"\w* seco \w como|strong="H5921"\w* un desierto, \w de|strong="H5921"\w* modo \w que|strong="H3808"\w* ya \w nadie|strong="H3808"\w* \w se|strong="H5921"\w* atreve \w a|strong="H3068"\w* pasar?   
\p
\v 13 Yahvé respondió: “Es porque abandonaron la enseñanza que les di; no me obedecieron ni vivieron como les ordené.  
\v 14 Al contrario, siguieron la terquedad \w de|strong="H5971"\w* su corazón \w y|strong="H3541"\w* \w se|strong="H3651"\w* fueron tras los baales, \w tal|strong="H3651"\w* \w como|strong="H3651"\w* les enseñaron sus antepasados”.  
\v 15 \w Por|strong="H5704"\w* eso, \w así|strong="H1992"\w* dice Yahvé \w de|strong="H5704"\w* \w los|strong="H1992"\w* Ejércitos, Dios \w de|strong="H5704"\w* Israel: “Miren, \w a|strong="H3068"\w* este \w pueblo|strong="H1992"\w* le daré \w a|strong="H3068"\w* comer comida amarga \w y|strong="H5704"\w* le daré \w a|strong="H3068"\w* beber agua envenenada.  
\v 16 \w Los|strong="H2450"\w* dispersaré entre naciones \w que|strong="H3541"\w* ni ellos ni sus antepasados conocieron, \w y|strong="H3541"\w* haré \w que|strong="H3541"\w* \w los|strong="H2450"\w* persigan \w a|strong="H3068"\w* punta de espada hasta \w que|strong="H3541"\w* \w los|strong="H2450"\w* haya aniquilado”.   
\p
\v 17 Así dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* Ejércitos:  
\q1 “¡Fíjense \w bien|strong="H5869"\w*! Llamen \w a|strong="H3068"\w* \w las|strong="H5921"\w* plañideras \w para|strong="H5921"\w* \w que|strong="H5921"\w* vengan;  
\q2 manden \w traer|strong="H5375"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w más|strong="H5921"\w* expertas \w en|strong="H5921"\w* lamentaciones.   
\q1
\v 18 \w Que|strong="H3588"\w* se apuren  
\q2 \w y|strong="H3588"\w* eleven un lamento \w por|strong="H3588"\w* nosotros,  
\q1 \w para|strong="H3588"\w* \w que|strong="H3588"\w* nuestros ojos se deshagan \w en|strong="H3588"\w* \w llanto|strong="H5092"\w*  
\q2 \w y|strong="H3588"\w* se nos inunden \w los|strong="H3588"\w* párpados.   
\q1
\v 19 \w Ya|strong="H3068"\w* se \w oye|strong="H8085"\w* un grito \w de|strong="H3588"\w* dolor desde Sión:  
\q2 ‘¡\w Qué|strong="H3588"\w* desastre! ¡Estamos acabados!  
\q1 ¡\w Qué|strong="H3588"\w* vergüenza tan grande!  
\q2 Tenemos \w que|strong="H3588"\w* dejar nuestra tierra,  
\q2 \w porque|strong="H3588"\w* han destruido nuestras casas’”.   
\b  
\q1
\v 20 Escuchen, mujeres, \w la|strong="H3588"\w* palabra \w de|strong="H3588"\w* Yahvé;  
\q2 presten atención \w a|strong="H3068"\w* lo \w que|strong="H3588"\w* \w él|strong="H3588"\w* dice.  
\q1 Enseñen \w a|strong="H3068"\w* sus hijas cantos \w de|strong="H3588"\w* luto;  
\q2 \w que|strong="H3588"\w* cada una enseñe \w a|strong="H3068"\w* \w su|strong="H3588"\w* amiga un lamento.   
\q1
\v 21 \w Porque|strong="H5921"\w* \w la|strong="H5921"\w* muerte \w se|strong="H5921"\w* \w ha|strong="H3541"\w* metido \w por|strong="H5921"\w* nuestras ventanas,  
\q2 \w ha|strong="H3541"\w* entrado \w en|strong="H5921"\w* nuestros palacios;  
\q1 \w ha|strong="H3541"\w* venido \w para|strong="H5921"\w* eliminar \w a|strong="H3068"\w* \w los|strong="H5921"\w* niños \w de|strong="H5921"\w* \w las|strong="H5921"\w* calles  
\q2 \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* jóvenes \w de|strong="H5921"\w* \w las|strong="H5921"\w* plazas.   
\p
\v 22 Di: “\w Así|strong="H3541"\w* dice Yahvé:  
\q1 ‘\w Los|strong="H2450"\w* cadáveres quedarán tirados como estiércol en el campo,  
\q2 como el trigo \w que|strong="H3541"\w* cae detrás del segador  
\q2 \w y|strong="H3541"\w* nadie lo recoge’”.   
\p
\v 23 \w Así|strong="H2063"\w* \w dice|strong="H5002"\w* Yahvé:  
\q1 “\w Que|strong="H3588"\w* \w el|strong="H3588"\w* sabio \w no|strong="H6213"\w* \w se|strong="H3045"\w* jacte \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w sabiduría|strong="H3045"\w*,  
\q2 ni \w el|strong="H3588"\w* fuerte \w de|strong="H3588"\w* \w su|strong="H3588"\w* fuerza,  
\q2 ni \w el|strong="H3588"\w* rico \w de|strong="H3588"\w* \w su|strong="H3588"\w* riqueza.   
\q1
\v 24 \w El|strong="H5921"\w* \w que|strong="H5921"\w* quiera jactarse, \w que|strong="H5921"\w* \w se|strong="H5921"\w* jacte \w de|strong="H5921"\w* esto:  
\q2 \w de|strong="H5921"\w* conocerme \w y|strong="H5921"\w* \w de|strong="H5921"\w* entender  
\q1 \w que|strong="H5921"\w* \w yo|strong="H2009"\w* soy Yahvé, \w que|strong="H5921"\w* actúo \w con|strong="H5921"\w* amor fiel, \w con|strong="H5921"\w* justicia \w y|strong="H5921"\w* rectitud \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra;  
\q2 \w porque|strong="H5921"\w* esto es \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w me|strong="H5921"\w* agrada”, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 25 “Vienen días — dice Yahvé — \w en|strong="H5921"\w* \w que|strong="H3588"\w* castigaré \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H3588"\w* \w están|strong="H3427"\w* circuncidados solo \w del|strong="H5921"\w* cuerpo:  
\v 26 \w a|strong="H3068"\w* Egipto, \w a|strong="H3068"\w* Judá, \w a|strong="H3068"\w* Edom, \w a|strong="H3068"\w* los amonitas y \w a|strong="H3068"\w* los moabitas, y \w a|strong="H3068"\w* todos los que se rapan las sienes y viven en el desierto. Porque todas las naciones son incircuncisas, pero todo el pueblo de Israel tiene el corazón incircunciso”.   
\c 10  
\p
\v 1 ¡\w Escuchen|strong="H8085"\w*, pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé \w les|strong="H5921"\w* dirige!  
\v 2 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “\w No|strong="H3588"\w* aprendan \w las|strong="H1992"\w* costumbres \w de|strong="H3588"\w* \w las|strong="H1992"\w* \w naciones|strong="H1471"\w*,  
\q2 ni \w se|strong="H1992"\w* espanten \w por|strong="H3588"\w* \w las|strong="H1992"\w* señales del \w cielo|strong="H8064"\w*,  
\q2 \w aunque|strong="H3588"\w* \w las|strong="H1992"\w* \w naciones|strong="H1471"\w* \w les|strong="H1992"\w* tengan miedo.   
\q1
\v 3 \w Porque|strong="H3588"\w* las costumbres \w de|strong="H3588"\w* esos \w pueblos|strong="H5971"\w* \w no|strong="H3588"\w* valen nada;  
\q2 cortan un tronco \w en|strong="H3588"\w* \w el|strong="H1931"\w* \w bosque|strong="H3293"\w*,  
\q2 \w y|strong="H3588"\w* un artesano \w lo|strong="H1931"\w* labra \w con|strong="H3588"\w* \w su|strong="H1931"\w* herramienta.   
\q1
\v 4 \w Lo|strong="H3808"\w* adornan con \w plata|strong="H3701"\w* y \w oro|strong="H2091"\w*;  
\q2 \w lo|strong="H3808"\w* aseguran con clavos y martillo  
\q2 para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* tambalee.   
\q1
\v 5 Esos ídolos parecen espantapájaros \w en|strong="H3588"\w* un cultivo \w de|strong="H3588"\w* pepinos: \w no|strong="H3808"\w* pueden \w hablar|strong="H1696"\w*;  
\q2 \w tienen|strong="H1992"\w* \w que|strong="H3588"\w* cargarlos,  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3808"\w* pueden dar un paso.  
\q1 \w No|strong="H3808"\w* \w les|strong="H1992"\w* tengan \w miedo|strong="H3372"\w*,  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3808"\w* pueden hacerles daño,  
\q2 \w ni|strong="H3808"\w* \w tampoco|strong="H1571"\w* \w tienen|strong="H1992"\w* poder \w para|strong="H3588"\w* hacerles \w ningún|strong="H3808"\w* \w bien|strong="H3190"\w*”.   
\q1
\v 6 ¡No hay nadie \w como|strong="H3644"\w* tú, Yahvé!  
\q2 Tú eres \w grande|strong="H1419"\w*,  
\q2 y tu \w nombre|strong="H8034"\w* es poderoso.   
\q1
\v 7 ¿\w Quién|strong="H4310"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w temerá|strong="H3372"\w*,  
\q2 \w Rey|strong="H4428"\w* \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w*?  
\q2 ¡Tú \w te|strong="H3588"\w* mereces \w todo|strong="H3605"\w* \w el|strong="H3588"\w* respeto!  
\q1 \w Porque|strong="H3588"\w* \w entre|strong="H3808"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w sabios|strong="H2450"\w* \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w*  
\q2 \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w todos|strong="H3605"\w* sus \w reinos|strong="H4438"\w*,  
\q2 \w no|strong="H3808"\w* \w hay|strong="H3372"\w* \w nadie|strong="H3808"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w te|strong="H3588"\w* compare.   
\q1
\v 8 Todos \w ellos|strong="H1931"\w* son necios \w e|strong="H3068"\w* ignorantes;  
\q2 \w su|strong="H1931"\w* \w enseñanza|strong="H4148"\w* no vale nada,  
\q2 \w es|strong="H1931"\w* pura \w madera|strong="H6086"\w*.   
\q1
\v 9 Traen \w plata|strong="H3701"\w* laminada de \w Tarsis|strong="H8659"\w*  
\q2 y \w oro|strong="H2091"\w* de Ufaz,  
\q2 \w obra|strong="H4639"\w* de artesanos y orfebres.  
\q1 \w Los|strong="H3605"\w* visten de azul y de púrpura;  
\q2 \w todos|strong="H3605"\w* \w ellos|strong="H3027"\w* son \w obra|strong="H4639"\w* de gente experta.   
\q1
\v 10 Pero Yahvé \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* verdadero;  
\q2 \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*  
\q2 y \w el|strong="H1931"\w* \w Rey|strong="H4428"\w* \w eterno|strong="H5769"\w*.  
\q1 Cuando \w él|strong="H1931"\w* \w se|strong="H1931"\w* enoja, \w la|strong="H1931"\w* tierra \w tiembla|strong="H7493"\w*;  
\q2 las \w naciones|strong="H1471"\w* \w no|strong="H3808"\w* pueden aguantar \w su|strong="H1931"\w* furia.   
\p
\v 11 “Ustedes les dirán \w esto|strong="H1836"\w*: ‘Los dioses \w que|strong="H1768"\w* \w no|strong="H3809"\w* \w hicieron|strong="H5648"\w* \w ni|strong="H3809"\w* el \w cielo|strong="H8065"\w* \w ni|strong="H3809"\w* la tierra, desaparecerán \w de|strong="H4481"\w* \w este|strong="H1836"\w* mundo \w y|strong="H3809"\w* \w de|strong="H4481"\w* \w debajo|strong="H8460"\w* \w del|strong="H4481"\w* \w cielo|strong="H8065"\w*’”.   
\q1
\v 12 Dios \w hizo|strong="H6213"\w* \w la|strong="H2451"\w* tierra con su \w poder|strong="H3581"\w*,  
\q2 creó \w el|strong="H6213"\w* \w mundo|strong="H8398"\w* con su \w sabiduría|strong="H2451"\w*  
\q2 y desplegó los \w cielos|strong="H8064"\w* con su \w inteligencia|strong="H8394"\w*.   
\q1
\v 13 Cuando \w él|strong="H6213"\w* truena,  
\q2 retumban las \w aguas|strong="H4325"\w* \w en|strong="H3318"\w* \w el|strong="H6213"\w* \w cielo|strong="H8064"\w*;  
\q2 \w él|strong="H6213"\w* \w hace|strong="H6213"\w* \w que|strong="H4325"\w* las \w nubes|strong="H5387"\w* suban desde \w el|strong="H6213"\w* horizonte.  
\q1 \w Produce|strong="H3318"\w* los \w relámpagos|strong="H1300"\w* \w que|strong="H4325"\w* acompañan la \w lluvia|strong="H4306"\w*  
\q2 y \w saca|strong="H3318"\w* \w el|strong="H6213"\w* \w viento|strong="H7307"\w* \w de|strong="H5414"\w* sus depósitos.   
\q1
\v 14 \w Toda|strong="H3605"\w* \w la|strong="H1197"\w* gente \w es|strong="H3588"\w* necia \w y|strong="H3588"\w* \w no|strong="H3808"\w* entiende \w nada|strong="H3808"\w*;  
\q2 \w los|strong="H3605"\w* orfebres \w se|strong="H3808"\w* avergüenzan \w de|strong="H3588"\w* sus ídolos,  
\q1 \w porque|strong="H3588"\w* sus estatuas \w son|strong="H3588"\w* un \w engaño|strong="H8267"\w*  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* tienen vida.   
\q1
\v 15 No valen nada, son \w obras|strong="H4639"\w* ridículas;  
\q2 \w cuando|strong="H6256"\w* llegue \w el|strong="H1992"\w* juicio, \w serán|strong="H1992"\w* destruidas.   
\q1
\v 16 \w Pero|strong="H3588"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w como|strong="H3588"\w* \w ellos|strong="H1931"\w*;  
\q2 \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* Creador \w de|strong="H3588"\w* \w todas|strong="H3605"\w* las cosas,  
\q1 \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* propiedad exclusiva;  
\q2 \w su|strong="H1931"\w* \w nombre|strong="H8034"\w* \w es|strong="H1931"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*.   
\q1
\v 17 Recojan sus pertenencias,  
\q2 ustedes que \w están|strong="H3427"\w* bajo asedio.   
\q1
\v 18 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé:  
\q2 “\w Esta|strong="H2063"\w* \w vez|strong="H6471"\w* voy \w a|strong="H3068"\w* lanzar lejos \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* \w este|strong="H2063"\w* país,  
\q2 \w y|strong="H3588"\w* \w les|strong="H1992"\w* traeré \w tal|strong="H2063"\w* \w angustia|strong="H6887"\w* \w que|strong="H3588"\w* \w por|strong="H3588"\w* fin \w me|strong="H3588"\w* sentirán”.   
\q1
\v 19 ¡Ay \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, \w por|strong="H5921"\w* \w mi|strong="H5921"\w* desgracia!  
\q2 \w Mi|strong="H5921"\w* herida \w no|strong="H5921"\w* tiene cura.  
\q1 Pero yo \w me|strong="H5921"\w* dije:  
\q2 “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* \w mi|strong="H5921"\w* sufrimiento, \w y|strong="H5921"\w* \w tengo|strong="H5921"\w* \w que|strong="H5921"\w* aguantarlo”.   
\q1
\v 20 Mi campamento ha sido \w destruido|strong="H7703"\w*  
\q2 y se cortaron \w todas|strong="H3605"\w* mis cuerdas;  
\q1 mis \w hijos|strong="H1121"\w* me han dejado y ya no están.  
\q2 No \w hay|strong="H5750"\w* \w nadie|strong="H3605"\w* \w que|strong="H1121"\w* vuelva \w a|strong="H3068"\w* \w levantar|strong="H6965"\w* mi tienda  
\q2 ni \w quien|strong="H3605"\w* coloque mis \w cortinas|strong="H3407"\w*.   
\q1
\v 21 \w Porque|strong="H3588"\w* \w los|strong="H5921"\w* gobernantes \w se|strong="H5921"\w* portaron \w como|strong="H3588"\w* necios  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* consultaron \w a|strong="H3068"\w* Yahvé;  
\q1 \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w no|strong="H3808"\w* \w prosperaron|strong="H7919"\w*  
\q2 \w y|strong="H3588"\w* \w todos|strong="H3605"\w* sus rebaños \w se|strong="H5921"\w* dispersaron.   
\q1
\v 22 ¡Escuchen! \w Ya|strong="H3068"\w* llega una noticia,  
\q2 un \w gran|strong="H1419"\w* \w estruendo|strong="H6963"\w* desde el \w norte|strong="H6828"\w*,  
\q1 para convertir las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w* en un desierto,  
\q2 en una guarida de chacales.   
\q1
\v 23 Yahvé, \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w no|strong="H3808"\w* \w es|strong="H3588"\w* dueño \w de|strong="H3588"\w* \w su|strong="H3588"\w* destino,  
\q2 \w ni|strong="H3808"\w* tiene \w el|strong="H3588"\w* poder \w de|strong="H3588"\w* dirigir sus propios \w pasos|strong="H6806"\w*.   
\q1
\v 24 Corrígeme, Yahvé, pero con \w justicia|strong="H4941"\w*;  
\q2 \w no|strong="H6435"\w* lo hagas con enojo,  
\q2 \w porque|strong="H6435"\w* me destruirías.   
\q1
\v 25 Descarga tu furia \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w conocen|strong="H3045"\w*  
\q2 \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w pueblos|strong="H1471"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w invocan|strong="H7121"\w* tu \w nombre|strong="H8034"\w*;  
\q1 \w porque|strong="H3588"\w* devoraron \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*,  
\q2 \w lo|strong="H3808"\w* \w destruyeron|strong="H3615"\w* \w por|strong="H5921"\w* completo  
\q2 \w y|strong="H3588"\w* dejaron \w su|strong="H3588"\w* hogar \w en|strong="H5921"\w* ruinas.   
\c 11  
\p
\v 1 \w Palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé dirigió \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 2 “\w Escuchen|strong="H8085"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* \w este|strong="H2063"\w* \w pacto|strong="H1285"\w*. \w Habla|strong="H1696"\w* \w con|strong="H5921"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén,  
\v 3 \w y|strong="H3541"\w* \w diles|strong="H1697"\w* \w que|strong="H3808"\w* \w así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*: ‘Maldito sea el \w que|strong="H3808"\w* \w no|strong="H3808"\w* obedezca las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w este|strong="H2063"\w* \w pacto|strong="H1285"\w*,  
\v 4 \w el|strong="H3605"\w* cual \w ordené|strong="H6680"\w* \w a|strong="H3068"\w* sus antepasados \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w que|strong="H5971"\w* \w los|strong="H3605"\w* \w saqué|strong="H3318"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H5971"\w* \w aquel|strong="H3605"\w* horno \w de|strong="H5971"\w* \w hierro|strong="H1270"\w*’. \w Yo|strong="H6680"\w* \w les|strong="H6680"\w* dije: ‘Obedezcan \w mi|strong="H1961"\w* \w voz|strong="H6963"\w* y pongan \w en|strong="H3318"\w* práctica \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w les|strong="H6680"\w* \w mando|strong="H6680"\w*; así ustedes \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* y \w yo|strong="H6680"\w* \w seré|strong="H1961"\w* su Dios’.  
\v 5 \w Lo|strong="H2088"\w* \w hice|strong="H7650"\w* \w para|strong="H4616"\w* cumplir \w el|strong="H1992"\w* \w juramento|strong="H7621"\w* \w que|strong="H3117"\w* \w les|strong="H1992"\w* \w hice|strong="H7650"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* antepasados: \w que|strong="H3117"\w* \w les|strong="H1992"\w* \w daría|strong="H5414"\w* una tierra donde siempre abundan la \w leche|strong="H2461"\w* y la \w miel|strong="H1706"\w*, como sucede \w hasta|strong="H3117"\w* \w el|strong="H1992"\w* \w día|strong="H3117"\w* \w de|strong="H5414"\w* \w hoy|strong="H3117"\w*”.  
\p Yo \w respondí|strong="H6030"\w*: “Amén, Yahvé”.   
\p
\v 6 Entonces Yahvé me dijo: “Proclama \w todo|strong="H3605"\w* \w este|strong="H2063"\w* mensaje en las \w ciudades|strong="H5892"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w* y en las \w calles|strong="H2351"\w* \w de|strong="H1697"\w* Jerusalén. Di: ‘\w Escuchen|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w este|strong="H2063"\w* \w pacto|strong="H1285"\w* y pónganlas en práctica’.  
\v 7 \w Porque|strong="H3588"\w* \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* \w saqué|strong="H5927"\w* \w a|strong="H3068"\w* sus antepasados \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w y|strong="H3588"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w*, les he advertido una \w y|strong="H3588"\w* otra vez: ‘Obedezcan mi \w voz|strong="H6963"\w*’.  
\v 8 Pero \w ellos|strong="H5921"\w* \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* prestaron atención, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w cada|strong="H3605"\w* uno \w siguió|strong="H3212"\w* \w la|strong="H5921"\w* terquedad \w de|strong="H5921"\w* su \w malvado|strong="H7451"\w* \w corazón|strong="H3820"\w*. \w Por|strong="H5921"\w* \w eso|strong="H2063"\w*, \w hice|strong="H6213"\w* \w que|strong="H3808"\w* cayera \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w castigo|strong="H7451"\w* anunciado \w en|strong="H5921"\w* \w este|strong="H2063"\w* \w pacto|strong="H1285"\w*, \w el|strong="H5921"\w* cual \w les|strong="H5921"\w* \w mandé|strong="H6680"\w* cumplir \w y|strong="H5921"\w* \w no|strong="H3808"\w* cumplieron”.   
\p
\v 9 Yahvé me dijo además: “Se ha descubierto \w una|strong="H4672"\w* conspiración entre \w los|strong="H3427"\w* hombres de \w Judá|strong="H3063"\w* y \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén.  
\v 10 Han \w vuelto|strong="H7725"\w* \w a|strong="H3068"\w* \w las|strong="H1992"\w* mismas \w maldades|strong="H5771"\w* \w de|strong="H5921"\w* \w sus|strong="H1992"\w* antiguos antepasados, \w los|strong="H1992"\w* cuales \w se|strong="H5921"\w* negaron \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w* mis \w palabras|strong="H1697"\w*. \w Se|strong="H5921"\w* \w fueron|strong="H1980"\w* tras otros dioses \w para|strong="H5921"\w* servirlos; \w tanto|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H1992"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w rompieron|strong="H6565"\w* \w el|strong="H5921"\w* \w pacto|strong="H1285"\w* \w que|strong="H5921"\w* yo había \w hecho|strong="H3772"\w* \w con|strong="H5921"\w* \w sus|strong="H1992"\w* padres”.  
\v 11 \w Por|strong="H4480"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé: “Miren, voy \w a|strong="H3068"\w* traer \w sobre|strong="H4480"\w* \w ellos|strong="H4480"\w* una desgracia \w de|strong="H4480"\w* la \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* escapar. \w Clamarán|strong="H2199"\w* \w a|strong="H3068"\w* mí, pero \w no|strong="H3808"\w* los voy \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w*.  
\v 12 \w Entonces|strong="H6256"\w* \w las|strong="H1992"\w* \w ciudades|strong="H5892"\w* \w de|strong="H7451"\w* \w Judá|strong="H3063"\w* y \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* \w de|strong="H7451"\w* Jerusalén \w irán|strong="H1980"\w* \w a|strong="H3068"\w* pedir \w ayuda|strong="H3467"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* dioses \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w que|strong="H3808"\w* \w les|strong="H1992"\w* ofrecen incienso, pero \w ellos|strong="H1992"\w* \w no|strong="H3808"\w* podrán salvarlos \w cuando|strong="H6256"\w* llegue \w el|strong="H3427"\w* desastre.  
\v 13 \w Porque|strong="H3588"\w* tú, \w Judá|strong="H3063"\w*, tienes tantos dioses \w como|strong="H3588"\w* \w ciudades|strong="H5892"\w*; \w y|strong="H3588"\w* ustedes, \w los|strong="H1961"\w* \w de|strong="H3588"\w* Jerusalén, han \w puesto|strong="H3588"\w* tantos \w altares|strong="H4196"\w* \w para|strong="H3588"\w* quemar incienso \w a|strong="H3068"\w* ese ídolo \w vergonzoso|strong="H1322"\w* llamado \w Baal|strong="H1168"\w*, \w como|strong="H3588"\w* \w calles|strong="H2351"\w* \w tiene|strong="H1961"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*.   
\p
\v 14 “\w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w a|strong="H3068"\w* ti, Jeremías, \w no|strong="H3588"\w* \w ores|strong="H6419"\w* \w por|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*. \w No|strong="H3588"\w* \w me|strong="H3588"\w* eleves ningún \w clamor|strong="H7440"\w* ni \w oración|strong="H8605"\w* \w por|strong="H3588"\w* ellos, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* \w los|strong="H3588"\w* voy \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w* \w cuando|strong="H3588"\w* \w me|strong="H3588"\w* \w invoquen|strong="H7121"\w* \w a|strong="H3068"\w* causa \w de|strong="H3588"\w* \w su|strong="H3588"\w* desgracia.   
\q1
\v 15 ¿\w Qué|strong="H3588"\w* derecho tiene \w mi|strong="H5921"\w* amada \w a|strong="H3068"\w* estar \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w templo|strong="H1004"\w*,  
\q2 \w si|strong="H3588"\w* ha cometido tantas infamias?  
\q2 ¿Crees \w que|strong="H3588"\w* \w las|strong="H5921"\w* ofrendas \w sagradas|strong="H6944"\w* \w te|strong="H5921"\w* librarán \w de|strong="H5921"\w* \w tu|strong="H6213"\w* \w castigo|strong="H7451"\w*?  
\q1 ¿Acaso puedes estar alegre  
\q2 \w mientras|strong="H3588"\w* \w haces|strong="H6213"\w* \w lo|strong="H4100"\w* \w malo|strong="H7451"\w*?”.   
\b  
\q1
\v 16 Yahvé \w te|strong="H5921"\w* había puesto \w por|strong="H5921"\w* \w nombre|strong="H8034"\w*: “Olivo \w frondoso|strong="H7488"\w*,  
\q2 cargado \w de|strong="H5921"\w* \w hermosos|strong="H3303"\w* \w frutos|strong="H6529"\w*”.  
\q1 Pero \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w estruendo|strong="H6963"\w* \w de|strong="H5921"\w* una \w gran|strong="H1419"\w* tormenta \w le|strong="H5921"\w* prendió fuego,  
\q2 \w y|strong="H5921"\w* sus ramas quedaron arruinadas.   
\m
\v 17 Yahvé \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*, \w quien|strong="H6213"\w* \w te|strong="H5921"\w* \w plantó|strong="H5193"\w*, ha decretado \w tu|strong="H6213"\w* ruina \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w maldad|strong="H7451"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H1992"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* han cometido; \w ellos|strong="H1992"\w* provocaron \w mi|strong="H5921"\w* enojo \w al|strong="H5921"\w* ofrecer incienso \w a|strong="H3068"\w* \w Baal|strong="H1168"\w*.   
\p
\v 18 Yahvé me lo hizo \w saber|strong="H3045"\w* y por eso me enteré; él me \w mostró|strong="H7200"\w* lo \w que|strong="H3045"\w* estaban tramando.  
\v 19 \w Yo|strong="H3588"\w* era \w como|strong="H3588"\w* un \w cordero|strong="H3532"\w* manso \w que|strong="H3588"\w* llevan \w al|strong="H5921"\w* matadero; \w no|strong="H3808"\w* \w sabía|strong="H3045"\w* \w que|strong="H3588"\w* estaban conspirando \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*, diciendo:  
\q1 “\w Destruyamos|strong="H7843"\w* \w el|strong="H5921"\w* \w árbol|strong="H6086"\w* \w con|strong="H5921"\w* todo \w y|strong="H3588"\w* \w su|strong="H3588"\w* fruto;  
\q2 borrémoslo \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w vivos|strong="H2416"\w*  
\q2 \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w nadie|strong="H3808"\w* vuelva \w a|strong="H3068"\w* \w acordarse|strong="H2142"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*”.   
\q1
\v 20 \w Pero|strong="H3588"\w* \w tú|strong="H8199"\w*, Yahvé \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w Ejércitos|strong="H6635"\w*, \w que|strong="H3588"\w* juzgas \w con|strong="H3588"\w* \w justicia|strong="H6664"\w*  
\q2 \w y|strong="H3588"\w* pones \w a|strong="H3068"\w* prueba \w la|strong="H3588"\w* mente \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w corazón|strong="H3820"\w*,  
\q1 déjame \w ver|strong="H7200"\w* \w cómo|strong="H3588"\w* \w te|strong="H3588"\w* vengas \w de|strong="H3588"\w* \w ellos|strong="H1992"\w*,  
\q2 \w porque|strong="H3588"\w* \w en|strong="H3588"\w* tus manos he \w puesto|strong="H3588"\w* mi defensa.   
\p
\v 21 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Anatot \w que|strong="H3808"\w* quieren \w matarte|strong="H4191"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* amenazan diciendo: “\w No|strong="H3808"\w* \w profetices|strong="H5012"\w* \w en|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé, \w si|strong="H3808"\w* \w no|strong="H3808"\w* quieres \w morir|strong="H4191"\w* \w a|strong="H3068"\w* \w manos|strong="H3027"\w* nuestras”;  
\v 22 \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*: “Miren, yo \w los|strong="H1121"\w* voy \w a|strong="H3068"\w* castigar. Sus jóvenes \w morirán|strong="H4191"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H6635"\w*, \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w* \w morirán|strong="H4191"\w* \w de|strong="H5921"\w* \w hambre|strong="H7458"\w*.  
\v 23 \w No|strong="H3808"\w* \w quedará|strong="H1961"\w* \w ni|strong="H3808"\w* uno solo \w de|strong="H3588"\w* ellos, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* traeré \w la|strong="H3588"\w* desgracia \w sobre|strong="H1961"\w* \w los|strong="H1961"\w* hombres \w de|strong="H3588"\w* Anatot \w cuando|strong="H3588"\w* llegue \w el|strong="H3588"\w* tiempo \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w castigo|strong="H7451"\w*”.   
\c 12  
\q1
\v 1 Tú eres \w justo|strong="H6662"\w*, Yahvé,  
\q2 \w cuando|strong="H3588"\w* presento mi queja ante ti;  
\q1 sin embargo, quisiera presentarte mi caso.  
\q2 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* les \w va|strong="H3068"\w* tan \w bien|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* malvados?  
\q2 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w viven|strong="H7563"\w* tranquilos \w los|strong="H3605"\w* \w que|strong="H3588"\w* \w son|strong="H3588"\w* unos traidores?   
\q1
\v 2 \w Tú|strong="H6213"\w* los has \w plantado|strong="H5193"\w* \w y|strong="H1571"\w* han echado raíces;  
\q2 crecen \w y|strong="H1571"\w* hasta dan \w fruto|strong="H6529"\w*.  
\q1 Te tienen \w cerca|strong="H7138"\w* de sus labios,  
\q2 pero muy \w lejos|strong="H7350"\w* de su corazón.   
\q1
\v 3 Pero tú, Yahvé, me \w conoces|strong="H3045"\w*;  
\q2 me \w ves|strong="H7200"\w* y pones \w a|strong="H3068"\w* prueba lo \w que|strong="H3045"\w* siento por ti.  
\q1 Arréstralos como \w a|strong="H3068"\w* \w ovejas|strong="H6629"\w* al matadero;  
\q2 apártalos para el \w día|strong="H3117"\w* de la matanza.   
\q1
\v 4 ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H3588"\w* \w estará|strong="H3427"\w* \w de|strong="H3588"\w* luto \w la|strong="H3588"\w* tierra  
\q2 \w y|strong="H3588"\w* \w se|strong="H3808"\w* \w secará|strong="H3001"\w* \w el|strong="H3588"\w* pasto \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w campo|strong="H7704"\w*?  
\q1 \w Por|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H7451"\w* \w de|strong="H3588"\w* sus \w habitantes|strong="H3427"\w*,  
\q2 \w se|strong="H3808"\w* \w están|strong="H3427"\w* acabando \w los|strong="H3427"\w* animales \w y|strong="H3588"\w* las \w aves|strong="H5775"\w*;  
\q1 \w porque|strong="H3588"\w* esa gente dice:  
\q2 “Dios \w no|strong="H3808"\w* \w verá|strong="H7200"\w* \w en|strong="H5704"\w* \w qué|strong="H3588"\w* terminamos”.   
\q1
\v 5 “\w Si|strong="H3588"\w* \w te|strong="H3588"\w* cansas \w corriendo|strong="H7323"\w* contra hombres,  
\q2 ¿\w cómo|strong="H3588"\w* podrás competir contra \w caballos|strong="H5483"\w*?  
\q1 \w Si|strong="H3588"\w* solo \w en|strong="H3588"\w* tierra segura \w te|strong="H3588"\w* sientes confiado,  
\q2 ¿\w qué|strong="H3588"\w* vas \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* bosque espeso del \w Jordán|strong="H3383"\w*?   
\q1
\v 6 \w Porque|strong="H3588"\w* hasta tus hermanos \w y|strong="H1571"\w* tu propia \w familia|strong="H1004"\w*  
\q2 \w te|strong="H3588"\w* han traicionado;  
\q2 ¡hasta \w ellos|strong="H1992"\w* \w te|strong="H3588"\w* han gritado insultos!  
\q1 \w No|strong="H3588"\w* \w te|strong="H3588"\w* fíes \w de|strong="H3588"\w* \w ellos|strong="H1992"\w*  
\q2 \w aunque|strong="H3588"\w* \w te|strong="H3588"\w* digan \w cosas|strong="H1992"\w* bonitas”.   
\b  
\q1
\v 7 “He abandonado \w mi|strong="H5315"\w* \w casa|strong="H1004"\w*,  
\q2 he rechazado \w mi|strong="H5315"\w* propiedad.  
\q2 He \w entregado|strong="H5414"\w* lo que más amo en \w manos|strong="H3709"\w* \w de|strong="H5414"\w* sus enemigos.   
\q1
\v 8 \w Mi|strong="H5921"\w* propiedad \w se|strong="H1961"\w* ha portado conmigo \w como|strong="H1961"\w* un león \w en|strong="H5921"\w* \w la|strong="H5921"\w* selva;  
\q2 rugió \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*,  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w la|strong="H5921"\w* he rechazado.   
\q1
\v 9 ¿Acaso \w mi|strong="H5921"\w* propiedad es un \w ave|strong="H5861"\w* \w de|strong="H5921"\w* rapiña \w de|strong="H5921"\w* muchos colores?  
\q2 ¿Hay otras \w aves|strong="H5861"\w* \w de|strong="H5921"\w* rapiña rodeándola \w para|strong="H5921"\w* atacarla?  
\q1 ¡Vengan, reúnan \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* salvajes;  
\q2 tráiganlos \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w la|strong="H5921"\w* coman!   
\q1
\v 10 \w Muchos|strong="H7227"\w* gobernantes han \w destruido|strong="H8077"\w* mi viñedo,  
\q2 han pisoteado mi terreno;  
\q2 convirtieron mi hermoso campo en un \w desierto|strong="H4057"\w* horrible.   
\q1
\v 11 \w Lo|strong="H5921"\w* dejaron desolado,  
\q2 \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* \w soledad|strong="H8077"\w* \w me|strong="H5921"\w* lanza sus quejas.  
\q1 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* país \w está|strong="H5921"\w* \w en|strong="H5921"\w* ruinas  
\q2 \w porque|strong="H3588"\w* \w a|strong="H3068"\w* \w nadie|strong="H3605"\w* \w le|strong="H5921"\w* importa.   
\q1
\v 12 \w Por|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* colinas \w desiertas|strong="H4057"\w* llegaron \w los|strong="H5921"\w* destructores,  
\q2 \w porque|strong="H3588"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w de|strong="H5921"\w* Yahvé devora \w de|strong="H5921"\w* un \w extremo|strong="H7097"\w* \w a|strong="H3068"\w* \w otro|strong="H7097"\w* \w del|strong="H5921"\w* país.  
\q2 \w Nadie|strong="H3605"\w* puede estar \w en|strong="H5921"\w* \w paz|strong="H7965"\w*.   
\q1
\v 13 \w Sembraron|strong="H2232"\w* \w trigo|strong="H2406"\w* y cosecharon \w espinas|strong="H6975"\w*;  
\q2 \w se|strong="H3808"\w* agotaron trabajando y \w no|strong="H3808"\w* sacaron \w ningún|strong="H3808"\w* \w provecho|strong="H3276"\w*.  
\q1 Ustedes \w se|strong="H3808"\w* avergonzarán de sus cosechas  
\q2 por culpa del ardiente enojo de Yahvé”.   
\b  
\p
\v 14 \w Así|strong="H3541"\w* dice Yahvé: “\w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* mis \w vecinos|strong="H7934"\w* malvados \w que|strong="H5921"\w* \w se|strong="H5921"\w* atreven \w a|strong="H3068"\w* \w tocar|strong="H5060"\w* \w la|strong="H5921"\w* \w heredad|strong="H5159"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* di \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*: Miren, yo \w los|strong="H5921"\w* voy \w a|strong="H3068"\w* arrancar \w de|strong="H5921"\w* sus tierras, \w y|strong="H5921"\w* también \w arrancaré|strong="H5428"\w* \w de|strong="H5921"\w* \w entre|strong="H8432"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 15 Pero \w después|strong="H1961"\w* de \w que|strong="H1961"\w* \w los|strong="H1961"\w* \w haya|strong="H1961"\w* arrancado, \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* \w tener|strong="H1961"\w* compasión de ellos; \w los|strong="H1961"\w* haré \w volver|strong="H7725"\w*, cada uno \w a|strong="H3068"\w* su propiedad y cada uno \w a|strong="H3068"\w* su tierra.  
\v 16 \w Y|strong="H3068"\w* \w si|strong="H1961"\w* \w de|strong="H5971"\w* verdad \w aprenden|strong="H3925"\w* las costumbres \w de|strong="H5971"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* y juran \w por|strong="H1870"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*, diciendo: ‘\w Por|strong="H1870"\w* la \w vida|strong="H2416"\w* \w de|strong="H5971"\w* Yahvé’, tal \w como|strong="H1961"\w* ellos enseñaron \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* \w a|strong="H3068"\w* jurar \w por|strong="H1870"\w* \w Baal|strong="H1168"\w*, entonces prosperarán \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5971"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*.  
\v 17 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* quieren \w escuchar|strong="H8085"\w*, entonces \w arrancaré|strong="H5428"\w* \w a|strong="H3068"\w* \w esa|strong="H1931"\w* \w nación|strong="H1471"\w*; \w la|strong="H1931"\w* \w arrancaré|strong="H5428"\w* y \w la|strong="H1931"\w* destruiré por completo”, \w dice|strong="H5002"\w* Yahvé.   
\c 13  
\p
\v 1 Yahvé \w me|strong="H5921"\w* dijo: “\w Ve|strong="H1980"\w* \w y|strong="H5921"\w* \w cómprate|strong="H7069"\w* un cinturón \w de|strong="H5921"\w* \w lino|strong="H6593"\w*, póntelo \w en|strong="H5921"\w* \w la|strong="H5921"\w* cintura pero \w no|strong="H3808"\w* dejes \w que|strong="H3808"\w* toque \w el|strong="H5921"\w* \w agua|strong="H4325"\w*”.   
\p
\v 2 Así \w que|strong="H5921"\w* compré \w el|strong="H5921"\w* cinturón, \w tal|strong="H1697"\w* \w como|strong="H5921"\w* Yahvé \w me|strong="H5921"\w* \w lo|strong="H1697"\w* \w ordenó|strong="H7760"\w*, \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w lo|strong="H1697"\w* \w puse|strong="H7760"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* cintura.   
\p
\v 3 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w por|strong="H1697"\w* \w segunda|strong="H8145"\w* vez:  
\v 4 “\w Toma|strong="H3947"\w* \w el|strong="H5921"\w* cinturón \w que|strong="H5921"\w* \w compraste|strong="H7069"\w* \w y|strong="H5921"\w* \w que|strong="H5921"\w* llevas puesto, \w y|strong="H5921"\w* \w vete|strong="H3212"\w* ahora mismo \w al|strong="H5921"\w* río \w Éufrates|strong="H6578"\w*; escóndelo \w allí|strong="H8033"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* grieta \w de|strong="H5921"\w* una \w roca|strong="H5553"\w*”.   
\p
\v 5 \w Yo|strong="H6680"\w* \w fui|strong="H3212"\w* y lo escondí junto al \w Éufrates|strong="H6578"\w*, \w como|strong="H2934"\w* Yahvé me había \w mandado|strong="H6680"\w*.   
\p
\v 6 \w Muchos|strong="H7227"\w* \w días|strong="H3117"\w* \w después|strong="H1961"\w*, Yahvé me dijo: “\w Anda|strong="H3212"\w*, vuelve al \w Éufrates|strong="H6578"\w* y busca el cinturón \w que|strong="H3117"\w* te \w mandé|strong="H6680"\w* esconder \w allá|strong="H8033"\w*”.   
\p
\v 7 \w Fui|strong="H3212"\w* \w al|strong="H4480"\w* \w Éufrates|strong="H6578"\w*, cavé y saqué \w el|strong="H3605"\w* cinturón \w del|strong="H4480"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w lo|strong="H3808"\w* había escondido; pero \w el|strong="H3605"\w* cinturón ya \w estaba|strong="H2009"\w* podrido y \w no|strong="H3808"\w* servía \w para|strong="H4480"\w* \w nada|strong="H3808"\w*.   
\p
\v 8 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*:  
\v 9 “\w Así|strong="H3541"\w* dice Yahvé: ‘De esta misma manera voy \w a|strong="H3068"\w* pudrir el orgullo de \w Judá|strong="H3063"\w* \w y|strong="H3541"\w* la \w gran|strong="H7227"\w* \w soberbia|strong="H1347"\w* de Jerusalén.  
\v 10 \w Este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w malvado|strong="H7451"\w*, \w que|strong="H3808"\w* \w se|strong="H1961"\w* niega \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w* mis \w palabras|strong="H1697"\w*, \w que|strong="H3808"\w* sigue \w la|strong="H3605"\w* terquedad \w de|strong="H5971"\w* \w su|strong="H1992"\w* \w corazón|strong="H3820"\w* y \w que|strong="H3808"\w* \w se|strong="H1961"\w* \w va|strong="H3068"\w* tras otros dioses \w para|strong="H1961"\w* servirlos y adorarlos, \w vendrá|strong="H1961"\w* \w a|strong="H3068"\w* ser \w como|strong="H1961"\w* \w este|strong="H2088"\w* cinturón, \w que|strong="H3808"\w* \w ya|strong="H2088"\w* \w no|strong="H3808"\w* sirve \w para|strong="H1961"\w* \w nada|strong="H3808"\w*.  
\v 11 \w Porque|strong="H3588"\w* \w así|strong="H3651"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* cinturón \w se|strong="H1961"\w* ajusta \w a|strong="H3068"\w* \w la|strong="H3588"\w* cintura del hombre, \w así|strong="H3651"\w* hice \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w se|strong="H1961"\w* ajustaran \w a|strong="H3068"\w* \w mí|strong="H1961"\w* — \w dice|strong="H5002"\w* Yahvé —, \w para|strong="H3588"\w* \w que|strong="H3588"\w* fueran \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H3588"\w* \w me|strong="H3588"\w* dieran renombre, \w alabanza|strong="H8416"\w* \w y|strong="H3588"\w* \w gloria|strong="H8597"\w*; \w pero|strong="H3588"\w* \w no|strong="H3808"\w* quisieron \w escuchar|strong="H8085"\w*’.   
\p
\v 12 “\w Diles|strong="H1697"\w* \w también|strong="H2088"\w* \w lo|strong="H1697"\w* siguiente: ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: “\w Toda|strong="H3605"\w* vasija debe llenarse \w de|strong="H3588"\w* \w vino|strong="H3196"\w*”’. \w Ellos|strong="H3605"\w* \w te|strong="H3588"\w* responderán: ‘¿Acaso \w no|strong="H3808"\w* \w sabemos|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w toda|strong="H3605"\w* vasija debe llenarse \w de|strong="H3588"\w* \w vino|strong="H3196"\w*?’.  
\v 13 Entonces tú \w les|strong="H5921"\w* dirás: ‘\w Así|strong="H3541"\w* dice Yahvé: “Voy \w a|strong="H3068"\w* llenar \w de|strong="H5921"\w* embriaguez \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w este|strong="H2063"\w* país: \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* sientan \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* viven \w en|strong="H5921"\w* Jerusalén.  
\v 14 Haré \w que|strong="H3808"\w* choquen unos contra otros, incluso \w los|strong="H1121"\w* padres contra \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* — \w dice|strong="H5002"\w* Yahvé —. \w No|strong="H3808"\w* tendré piedad, \w ni|strong="H3808"\w* lástima, \w ni|strong="H3808"\w* compasión; \w nada|strong="H3808"\w* me detendrá para \w destruirlos|strong="H7843"\w*”’”.   
\q1
\v 15 \w Escuchen|strong="H8085"\w* \w y|strong="H3588"\w* presten atención; \w no|strong="H3588"\w* sean orgullosos,  
\q2 \w porque|strong="H3588"\w* Yahvé ha \w hablado|strong="H1696"\w*.   
\q1
\v 16 \w Den|strong="H7760"\w* \w gloria|strong="H3519"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*  
\q2 \w antes|strong="H2962"\w* \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* traiga \w las|strong="H5921"\w* tinieblas,  
\q2 \w y|strong="H5921"\w* \w antes|strong="H2962"\w* \w de|strong="H5921"\w* \w que|strong="H5921"\w* sus \w pies|strong="H7272"\w* \w tropiecen|strong="H5062"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* montañas oscuras.  
\q1 Ustedes \w esperan|strong="H6960"\w* \w la|strong="H5921"\w* \w luz|strong="H6757"\w*,  
\q2 pero \w él|strong="H5921"\w* \w la|strong="H5921"\w* convertirá \w en|strong="H5921"\w* sombras \w de|strong="H5921"\w* \w muerte|strong="H6757"\w*,  
\q2 \w en|strong="H5921"\w* una \w oscuridad|strong="H6205"\w* profunda.   
\q1
\v 17 \w Si|strong="H3588"\w* \w no|strong="H3808"\w* quieren hacer caso,  
\q2 \w lloraré|strong="H1058"\w* \w en|strong="H3588"\w* secreto \w por|strong="H3588"\w* \w el|strong="H3588"\w* orgullo \w de|strong="H3588"\w* ustedes.  
\q1 Mis \w ojos|strong="H5869"\w* \w llorarán|strong="H1058"\w* \w amargamente|strong="H1830"\w*  
\q2 \w y|strong="H3588"\w* \w se|strong="H3808"\w* inundarán \w de|strong="H3588"\w* \w lágrimas|strong="H1832"\w*,  
\q2 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* rebaño \w de|strong="H3588"\w* Yahvé \w será|strong="H3808"\w* llevado al cautiverio.   
\q1
\v 18 Díganle \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w reina|strong="H4428"\w* madre:  
\q2 “Humíllense \w y|strong="H3588"\w* siéntense \w en|strong="H3588"\w* \w el|strong="H3588"\w* suelo,  
\q1 \w porque|strong="H3588"\w* \w de|strong="H3588"\w* sus cabezas ha caído  
\q2 \w la|strong="H3588"\w* \w corona|strong="H5850"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w gloria|strong="H8597"\w*”.   
\q1
\v 19 Las \w ciudades|strong="H5892"\w* del sur han quedado bloqueadas  
\q2 y no hay \w quien|strong="H3605"\w* las abra;  
\q1 \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* ha sido llevado al destierro,  
\q2 \w todos|strong="H3605"\w* han partido al cautiverio.   
\q1
\v 20 Levanten la vista  
\q2 y \w vean|strong="H7200"\w* \w a|strong="H3068"\w* los que vienen del \w norte|strong="H6828"\w*.  
\q1 ¿Dónde está el \w rebaño|strong="H6629"\w* que se \w te|strong="H5869"\w* confió,  
\q2 ese \w rebaño|strong="H6629"\w* tan \w hermoso|strong="H8597"\w*?   
\q1
\v 21 ¿\w Qué|strong="H3588"\w* dirás \w cuando|strong="H3588"\w* Yahvé \w ponga|strong="H6485"\w* \w como|strong="H4100"\w* \w jefes|strong="H7218"\w* tuyos  
\q2 \w a|strong="H3068"\w* esos mismos \w que|strong="H3588"\w* tú \w enseñaste|strong="H3925"\w* \w a|strong="H3068"\w* ser tus aliados?  
\q1 ¿\w No|strong="H3808"\w* \w te|strong="H5921"\w* vendrán \w dolores|strong="H2256"\w*  
\q2 \w como|strong="H4100"\w* \w de|strong="H5921"\w* mujer \w de|strong="H5921"\w* parto?   
\q1
\v 22 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w te|strong="H3588"\w* preguntas:  
\q2 “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w me|strong="H3588"\w* está pasando esto?”,  
\q1 \w pues|strong="H3588"\w* \w es|strong="H3588"\w* \w por|strong="H3588"\w* tu gran \w maldad|strong="H5771"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* han levantado \w la|strong="H3588"\w* falda  
\q2 \w y|strong="H3588"\w* \w te|strong="H3588"\w* han tratado \w con|strong="H3588"\w* violencia.   
\q1
\v 23 ¿\w Puede|strong="H3201"\w* un \w etíope|strong="H3569"\w* cambiar \w el|strong="H1571"\w* color de su \w piel|strong="H5785"\w*,  
\q2 \w o|strong="H3068"\w* un leopardo quitarse sus manchas?  
\q1 ¡\w Pues|strong="H1571"\w* \w tampoco|strong="H1571"\w* ustedes \w podrán|strong="H3201"\w* hacer \w el|strong="H1571"\w* \w bien|strong="H3190"\w*,  
\q2 \w cuando|strong="H1571"\w* están tan acostumbrados \w a|strong="H3068"\w* hacer \w el|strong="H1571"\w* \w mal|strong="H7489"\w*!   
\b  
\q1
\v 24 “Por eso los dispersaré  
\q2 como paja que se lleva  
\q2 \w el|strong="H5674"\w* \w viento|strong="H7307"\w* del \w desierto|strong="H4057"\w*.   
\q1
\v 25 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w suerte|strong="H1486"\w* \w que|strong="H2088"\w* te ha tocado,  
\q2 la \w parte|strong="H4490"\w* \w que|strong="H2088"\w* yo mismo te he medido — \w dice|strong="H5002"\w* Yahvé —,  
\q1 porque te \w olvidaste|strong="H7911"\w* \w de|strong="H7911"\w* mí  
\q2 y confiaste en dioses \w falsos|strong="H8267"\w*.   
\q1
\v 26 Yo \w también|strong="H1571"\w* \w te|strong="H5921"\w* levantaré \w la|strong="H5921"\w* falda \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w*  
\q2 \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w vea|strong="H7200"\w* tu vergüenza,   
\q1
\v 27 tus adulterios \w y|strong="H5921"\w* tus relinchos, \w y|strong="H5921"\w* tu vergonzosa prostitución  
\q2 \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w campos|strong="H7704"\w*.  
\q1 ¡Pobre \w de|strong="H5921"\w* \w ti|strong="H5921"\w*, Jerusalén!  
\q2 ¿\w Hasta|strong="H5921"\w* \w cuándo|strong="H4970"\w* seguirás así, \w sin|strong="H3808"\w* purificarte?”   
\c 14  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w que|strong="H5921"\w* recibió \w Jeremías|strong="H3414"\w* \w con|strong="H5921"\w* \w motivo|strong="H1697"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* gran sequía:   
\q1
\v 2 “\w Judá|strong="H3063"\w* está de luto,  
\q2 sus \w ciudades|strong="H8179"\w* se están hundiendo.  
\q1 La gente se sienta en el suelo vestida de luto,  
\q2 y los gritos de Jerusalén \w suben|strong="H5927"\w* hasta el cielo.   
\q1
\v 3 \w Los|strong="H5921"\w* ricos mandan \w a|strong="H3068"\w* sus criados \w por|strong="H5921"\w* \w agua|strong="H4325"\w*;  
\q2 \w ellos|strong="H5921"\w* van \w a|strong="H3068"\w* \w los|strong="H5921"\w* pozos  
\q2 pero \w no|strong="H3808"\w* encuentran \w nada|strong="H3808"\w*.  
\q1 Regresan \w con|strong="H5921"\w* sus vasijas \w vacías|strong="H7387"\w*;  
\q2 \w avergonzados|strong="H3637"\w* \w y|strong="H5921"\w* desesperados,  
\q2 \w se|strong="H5921"\w* cubren \w la|strong="H5921"\w* cara \w con|strong="H5921"\w* \w las|strong="H5921"\w* manos.   
\q1
\v 4 \w Como|strong="H3588"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* \w llovido|strong="H1653"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* país,  
\q2 \w la|strong="H3588"\w* tierra \w se|strong="H1961"\w* \w ha|strong="H3808"\w* agrietado;  
\q1 \w los|strong="H1961"\w* campesinos \w están|strong="H1961"\w* angustiados  
\q2 \w y|strong="H3588"\w* \w se|strong="H1961"\w* cubren \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*.   
\q1
\v 5 Hasta \w la|strong="H1571"\w* cierva \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w campo|strong="H7704"\w* abandona \w a|strong="H3068"\w* \w su|strong="H3588"\w* cría recién nacida,  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w hay|strong="H1961"\w* \w nada|strong="H3808"\w* \w de|strong="H3588"\w* pasto.   
\q1
\v 6 \w Los|strong="H5921"\w* burros salvajes \w se|strong="H5921"\w* paran \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas peladas  
\q2 \w y|strong="H3588"\w* jadean \w como|strong="H3588"\w* chacales buscando aire;  
\q1 \w su|strong="H3588"\w* vista \w se|strong="H5921"\w* apaga  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3588"\w* hay vegetación alguna.   
\q1
\v 7 Yahvé, \w aunque|strong="H3588"\w* nuestras culpas nos acusen,  
\q2 actúa \w por|strong="H3588"\w* honor \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w*.  
\q1 Muchas veces \w te|strong="H3588"\w* hemos sido infieles,  
\q2 hemos \w pecado|strong="H5771"\w* contra ti.   
\q1
\v 8 Tú, \w esperanza|strong="H4723"\w* \w de|strong="H6256"\w* \w Israel|strong="H3478"\w*,  
\q2 su \w salvador|strong="H3467"\w* en \w tiempos|strong="H6256"\w* \w de|strong="H6256"\w* \w angustia|strong="H6869"\w*,  
\q1 ¿\w por|strong="H4100"\w* \w qué|strong="H4100"\w* te portas \w como|strong="H4100"\w* un extraño en nuestro país,  
\q2 \w como|strong="H4100"\w* un viajero \w que|strong="H4100"\w* solo \w se|strong="H1961"\w* detiene \w para|strong="H1961"\w* pasar la noche?   
\q1
\v 9 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* pareces un \w hombre|strong="H1368"\w* confundido,  
\q2 \w como|strong="H4100"\w* un guerrero \w que|strong="H4100"\w* \w no|strong="H3808"\w* \w tiene|strong="H1961"\w* fuerza \w para|strong="H5921"\w* \w salvar|strong="H3467"\w*?  
\q1 \w Sin|strong="H3808"\w* embargo, Yahvé, tú estás \w entre|strong="H5921"\w* \w nosotros|strong="H5921"\w*  
\q2 \w y|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w somos|strong="H1961"\w* tu pueblo;  
\q2 ¡\w no|strong="H3808"\w* \w nos|strong="H5921"\w* abandones!”.   
\p
\v 10 \w Así|strong="H3541"\w* dice Yahvé acerca \w de|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*:  
\q1 “\w Como|strong="H3651"\w* les encantó andar \w de|strong="H5971"\w* un lado \w a|strong="H3068"\w* \w otro|strong="H2088"\w*  
\q2 \w y|strong="H3541"\w* \w no|strong="H3808"\w* supieron frenar sus pasos,  
\q1 yo, Yahvé, \w no|strong="H3808"\w* los acepto.  
\q2 \w Ahora|strong="H6258"\w* voy \w a|strong="H3068"\w* pedirles cuentas \w de|strong="H5971"\w* su \w maldad|strong="H5771"\w*  
\q2 \w y|strong="H3541"\w* \w a|strong="H3068"\w* castigarlos \w por|strong="H2088"\w* sus \w pecados|strong="H2403"\w*”.   
\p
\v 11 \w Luego|strong="H2088"\w* Yahvé me dijo: “No me pidas \w que|strong="H5971"\w* \w le|strong="H1157"\w* vaya \w bien|strong="H2896"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*.  
\v 12 \w Aunque|strong="H3588"\w* ayunen, \w no|strong="H3588"\w* \w escucharé|strong="H8085"\w* sus ruegos; \w aunque|strong="H3588"\w* \w me|strong="H3588"\w* traigan sacrificios \w y|strong="H3588"\w* ofrendas, \w no|strong="H3588"\w* \w los|strong="H3588"\w* aceptaré. \w Al|strong="H5930"\w* contrario, \w los|strong="H3588"\w* voy \w a|strong="H3068"\w* exterminar \w con|strong="H3588"\w* \w la|strong="H3588"\w* guerra, \w el|strong="H3588"\w* \w hambre|strong="H7458"\w* \w y|strong="H3588"\w* las enfermedades”.   
\p
\v 13 \w Entonces|strong="H3588"\w* \w yo|strong="H3588"\w* respondí: “¡Ay, Señor Yahvé! \w El|strong="H3588"\w* problema \w es|strong="H1961"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w profetas|strong="H5030"\w* les dicen: ‘Ustedes \w no|strong="H3808"\w* \w verán|strong="H7200"\w* \w la|strong="H3588"\w* guerra \w ni|strong="H3808"\w* pasarán \w hambre|strong="H7458"\w*, \w porque|strong="H3588"\w* \w Dios|strong="H3069"\w* les \w dará|strong="H5414"\w* una \w paz|strong="H7965"\w* duradera \w en|strong="H3588"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*’”.   
\p
\v 14 Pero Yahvé me contestó: “Esos \w profetas|strong="H5030"\w* \w dicen|strong="H1696"\w* \w mentiras|strong="H8267"\w* en mi \w nombre|strong="H8034"\w*. \w Yo|strong="H6680"\w* \w no|strong="H3808"\w* \w los|strong="H1992"\w* \w envié|strong="H7971"\w*, \w ni|strong="H3808"\w* \w les|strong="H1992"\w* \w di|strong="H1696"\w* \w ninguna|strong="H3808"\w* \w orden|strong="H6680"\w*, \w ni|strong="H3808"\w* \w les|strong="H1992"\w* \w hablé|strong="H1696"\w*. \w Lo|strong="H3808"\w* \w que|strong="H3808"\w* \w ellos|strong="H1992"\w* \w les|strong="H1992"\w* anuncian \w son|strong="H3808"\w* visiones falsas, inventos de \w su|strong="H1992"\w* imaginación y engaños de \w su|strong="H1992"\w* propio \w corazón|strong="H3820"\w*.  
\v 15 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* digo yo, Yahvé, \w sobre|strong="H5921"\w* esos \w profetas|strong="H5030"\w* \w que|strong="H3808"\w* dicen hablar \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w* \w sin|strong="H3808"\w* \w que|strong="H3808"\w* yo \w los|strong="H1992"\w* \w haya|strong="H1961"\w* \w enviado|strong="H7971"\w*, \w y|strong="H5921"\w* \w que|strong="H3808"\w* aseguran \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* guerra \w ni|strong="H3808"\w* \w hambre|strong="H7458"\w* \w en|strong="H5921"\w* \w este|strong="H2063"\w* país: ¡Esos \w mismos|strong="H1992"\w* \w profetas|strong="H5030"\w* morirán \w por|strong="H5921"\w* \w la|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w hambre|strong="H7458"\w*!  
\v 16 \w Y|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w ellos|strong="H1992"\w* \w les|strong="H1992"\w* hablan acabará tirada \w en|strong="H5921"\w* \w las|strong="H1992"\w* \w calles|strong="H2351"\w* \w de|strong="H5921"\w* Jerusalén, víctima \w del|strong="H5921"\w* \w hambre|strong="H7458"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guerra. \w No|strong="H1961"\w* \w habrá|strong="H1961"\w* quien \w los|strong="H1992"\w* \w entierre|strong="H6912"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w*, ni \w a|strong="H3068"\w* \w sus|strong="H1992"\w* esposas, ni \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* ni \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijas|strong="H1323"\w*. ¡Voy \w a|strong="H3068"\w* derramar \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w* \w su|strong="H1992"\w* propia \w maldad|strong="H7451"\w*!”.   
\p
\v 17 “\w Diles|strong="H1697"\w* \w también|strong="H2088"\w* \w estas|strong="H2088"\w* \w palabras|strong="H1697"\w*:  
\q1 “‘\w Que|strong="H3588"\w* mis \w ojos|strong="H5869"\w* \w se|strong="H5971"\w* inunden \w de|strong="H3588"\w* \w lágrimas|strong="H1832"\w* \w noche|strong="H3915"\w* \w y|strong="H3588"\w* \w día|strong="H3119"\w*,  
\q2 sin parar ni un momento;  
\q1 \w porque|strong="H3588"\w* mi \w pueblo|strong="H5971"\w*, mi \w hija|strong="H1323"\w* amada, ha sufrido un golpe terrible,  
\q2 \w le|strong="H5869"\w* han causado una herida mortal.   
\q1
\v 18 \w Si|strong="H3588"\w* \w salgo|strong="H3318"\w* al \w campo|strong="H7704"\w*,  
\q2 ¡veo \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* murieron \w en|strong="H3588"\w* combate!  
\q1 \w Si|strong="H3588"\w* entro \w en|strong="H3588"\w* \w la|strong="H1571"\w* \w ciudad|strong="H5892"\w*,  
\q2 ¡veo \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* mueren \w de|strong="H3588"\w* \w hambre|strong="H7458"\w*!  
\q1 Hasta \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* \w y|strong="H1571"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* andan \w por|strong="H3588"\w* \w el|strong="H3588"\w* país  
\q2 \w sin|strong="H3808"\w* \w saber|strong="H3045"\w* \w qué|strong="H3588"\w* está pasando’”.   
\b  
\q1
\v 19 ¿Acaso has rechazado \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w por|strong="H4069"\w* completo?  
\q2 ¿\w Ya|strong="H3068"\w* no soportas \w a|strong="H3068"\w* \w Sión|strong="H6726"\w*?  
\q1 ¿\w Por|strong="H4069"\w* \w qué|strong="H6256"\w* nos \w heriste|strong="H5221"\w* tanto \w que|strong="H6256"\w* ya no tenemos \w remedio|strong="H4832"\w*?  
\q2 \w Esperábamos|strong="H6960"\w* la \w paz|strong="H7965"\w*, y no llegó nada \w bueno|strong="H2896"\w*;  
\q2 buscábamos sanidad, ¡y solo encontramos terror!   
\q1
\v 20 Yahvé, \w reconocemos|strong="H3045"\w* nuestra \w maldad|strong="H5771"\w*  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* culpa \w de|strong="H3588"\w* nuestros antepasados;  
\q2 hemos \w pecado|strong="H5771"\w* contra ti.   
\q1
\v 21 \w Por|strong="H4616"\w* honor \w a|strong="H3068"\w* tu \w nombre|strong="H8034"\w*, no nos desprecies;  
\q2 no permitas \w que|strong="H4616"\w* tu \w glorioso|strong="H3519"\w* \w trono|strong="H3678"\w* sea humillado.  
\q1 ¡\w Acuérdate|strong="H2142"\w* de nosotros \w y|strong="H3519"\w* no rompas tu \w pacto|strong="H1285"\w*!   
\q1
\v 22 ¿\w Hay|strong="H3426"\w* algún ídolo \w entre|strong="H3808"\w* las \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* pueda \w hacer|strong="H6213"\w* llover?  
\q2 ¿Acaso \w el|strong="H1931"\w* \w cielo|strong="H8064"\w* puede mandar aguaceros \w por|strong="H3588"\w* \w sí|strong="H3588"\w* \w solo|strong="H1931"\w*?  
\q2 ¡\w No|strong="H3808"\w*! ¡\w Solo|strong="H1931"\w* \w tú|strong="H6213"\w* puedes hacerlo, Yahvé nuestro \w Dios|strong="H3068"\w*!  
\q1 \w Por|strong="H3588"\w* \w eso|strong="H1931"\w* ponemos nuestra esperanza \w en|strong="H3588"\w* ti,  
\q2 \w porque|strong="H3588"\w* \w tú|strong="H6213"\w* \w eres|strong="H1931"\w* \w quien|strong="H3605"\w* \w hace|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas.   
\c 15  
\p
\v 1 Entonces Yahvé \w me|strong="H5921"\w* dijo: “Aunque \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w Samuel|strong="H8050"\w* \w se|strong="H5921"\w* presentaran \w ante|strong="H6440"\w* \w mí|strong="H5921"\w* \w para|strong="H5921"\w* interceder, \w yo|strong="H5315"\w* \w no|strong="H5921"\w* sentiría compasión \w por|strong="H5921"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*. ¡\w Échalos|strong="H7971"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*! ¡\w Que|strong="H5921"\w* \w se|strong="H5921"\w* vayan!  
\v 2 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w te|strong="H3588"\w* preguntan: ‘¿\w A|strong="H3068"\w* dónde vamos \w a|strong="H3068"\w* ir?’, diles \w que|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé:  
\q1 \w El|strong="H3588"\w* \w que|strong="H3588"\w* \w está|strong="H1961"\w* destinado \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*, \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*;  
\q1 \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*, \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*;  
\q1 \w el|strong="H3588"\w* \w que|strong="H3588"\w* al \w hambre|strong="H7458"\w*, al \w hambre|strong="H7458"\w*;  
\q1 \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* al \w cautiverio|strong="H7628"\w*, al \w cautiverio|strong="H7628"\w*’.   
\p
\v 3 \w Enviaré|strong="H6485"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* cuatro clases \w de|strong="H5921"\w* castigo”, \w dice|strong="H5002"\w* Yahvé: “\w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w para|strong="H5921"\w* matar, \w los|strong="H5921"\w* \w perros|strong="H3611"\w* \w para|strong="H5921"\w* despedazar, \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* fieras \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w para|strong="H5921"\w* devorar \w y|strong="H5921"\w* \w destruir|strong="H7843"\w*.  
\v 4 \w Haré|strong="H6213"\w* \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w se|strong="H5921"\w* horroricen \w al|strong="H5921"\w* verlos, \w por|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w Manasés|strong="H4519"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w hizo|strong="H6213"\w* \w en|strong="H5921"\w* Jerusalén.   
\q1
\v 5 \w Porque|strong="H3588"\w* ¿\w quién|strong="H4310"\w* \w te|strong="H5921"\w* tendrá lástima, Jerusalén?  
\q2 ¿\w Quién|strong="H4310"\w* llorará \w por|strong="H5921"\w* \w ti|strong="H5921"\w*?  
\q2 ¿\w Quién|strong="H4310"\w* \w se|strong="H5921"\w* detendrá \w a|strong="H3068"\w* preguntar \w cómo|strong="H3588"\w* estás?   
\q1
\v 6 Tú \w me|strong="H5921"\w* rechazaste”, \w dice|strong="H5002"\w* Yahvé.  
\q2 “\w Te|strong="H5921"\w* volviste atrás.  
\q1 \w Por|strong="H5921"\w* eso levanté \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*  
\q2 \w y|strong="H5921"\w* \w te|strong="H5921"\w* destruí.  
\q2 \w Ya|strong="H3068"\w* estoy \w cansado|strong="H3811"\w* \w de|strong="H5921"\w* tenerte compasión.   
\q1
\v 7 Los dispersé \w como|strong="H2219"\w* paja al viento \w por|strong="H1870"\w* todo el país.  
\q2 Los dejé \w sin|strong="H3808"\w* hijos.  
\q1 He destruido \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*,  
\q2 \w porque|strong="H3808"\w* \w no|strong="H3808"\w* quisieron dejar sus malos \w caminos|strong="H1870"\w*.   
\q1
\v 8 \w Sus|strong="H1992"\w* viudas son ahora \w más|strong="H5921"\w* numerosas \w que|strong="H5921"\w* \w la|strong="H5921"\w* arena \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\q2 \w En|strong="H5921"\w* pleno mediodía traje un destructor \w contra|strong="H5921"\w* \w las|strong="H1992"\w* madres \w de|strong="H5921"\w* \w los|strong="H1992"\w* jóvenes.  
\q2 Hice \w que|strong="H5921"\w* \w de|strong="H5921"\w* repente cayeran \w sobre|strong="H5921"\w* \w ellas|strong="H1992"\w* \w la|strong="H5921"\w* angustia \w y|strong="H5921"\w* \w el|strong="H5921"\w* terror.   
\q1
\v 9 La madre \w que|strong="H7651"\w* tuvo \w siete|strong="H7651"\w* hijos se desmaya.  
\q2 Se queda sin aliento.  
\q1 Su \w sol|strong="H8121"\w* se \w puso|strong="H5414"\w* cuando \w todavía|strong="H5750"\w* era \w de|strong="H6440"\w* \w día|strong="H3119"\w*.  
\q2 Quedó avergonzada y humillada.  
\q2 \w A|strong="H3068"\w* los \w que|strong="H7651"\w* queden \w de|strong="H6440"\w* ellos, los \w entregaré|strong="H5414"\w* \w a|strong="H3068"\w* la \w espada|strong="H2719"\w* frente \w a|strong="H3068"\w* sus enemigos”, \w dice|strong="H5002"\w* Yahvé.   
\b  
\q1
\v 10 ¡Ay \w de|strong="H3588"\w* mí, madre mía! ¡\w Me|strong="H3588"\w* diste \w a|strong="H3068"\w* luz \w para|strong="H3588"\w* ser un hombre \w de|strong="H3588"\w* pleitos  
\q2 \w y|strong="H3588"\w* \w de|strong="H3588"\w* discusiones \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* país!  
\q1 \w A|strong="H3068"\w* \w nadie|strong="H3808"\w* le he prestado dinero, \w ni|strong="H3808"\w* \w nadie|strong="H3808"\w* \w me|strong="H3588"\w* \w lo|strong="H3808"\w* \w ha|strong="H3808"\w* prestado \w a|strong="H3068"\w* mí;  
\q2 \w y|strong="H3588"\w* \w sin|strong="H3808"\w* embargo, \w todos|strong="H3605"\w* \w me|strong="H3588"\w* maldicen.   
\p
\v 11 Yahvé respondió:  
\q1 “Te aseguro \w que|strong="H3808"\w* te fortaleceré para \w que|strong="H3808"\w* te vaya \w bien|strong="H2896"\w*.  
\q2 Haré \w que|strong="H3808"\w*, en \w tiempos|strong="H6256"\w* \w de|strong="H7451"\w* desgracia y \w aflicción|strong="H6869"\w*,  
\q2 sea el enemigo quien te pida ayuda \w a|strong="H3068"\w* ti.   
\q1
\v 12 ¿Se puede romper el \w hierro|strong="H1270"\w*,  
\q2 especialmente el \w hierro|strong="H1270"\w* del \w norte|strong="H6828"\w* y el bronce?   
\q1
\v 13 Tus \w riquezas|strong="H2428"\w* y tesoros \w los|strong="H3605"\w* \w entregaré|strong="H5414"\w* como botín, \w sin|strong="H3808"\w* cobrar \w nada|strong="H3808"\w*,  
\q2 \w por|strong="H5414"\w* causa \w de|strong="H5414"\w* \w todos|strong="H3605"\w* tus \w pecados|strong="H2403"\w*  
\q2 en \w todo|strong="H3605"\w* tu territorio.   
\q1
\v 14 Haré \w que|strong="H3588"\w* seas esclavo \w de|strong="H5921"\w* tus enemigos \w en|strong="H5921"\w* una tierra \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w conoces|strong="H3045"\w*;  
\q2 \w porque|strong="H3588"\w* \w mi|strong="H5921"\w* enojo \w ha|strong="H3808"\w* \w encendido|strong="H3344"\w* un fuego  
\q2 \w que|strong="H3588"\w* \w arderá|strong="H3344"\w* \w contra|strong="H5921"\w* ustedes”.   
\b  
\q1
\v 15 Yahvé, tú \w lo|strong="H5921"\w* \w sabes|strong="H3045"\w* todo.  
\q2 \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* ven \w a|strong="H3068"\w* ayudarme;  
\q2 ¡véngate \w de|strong="H5921"\w* \w mis|strong="H5375"\w* \w perseguidores|strong="H7291"\w*!  
\q1 \w No|strong="H5921"\w* dejes \w que|strong="H5921"\w* \w me|strong="H5921"\w* maten, pues tú eres muy paciente.  
\q2 \w Mira|strong="H3045"\w* \w que|strong="H5921"\w* \w por|strong="H5921"\w* \w ti|strong="H5921"\w* \w sufro|strong="H5375"\w* insultos.   
\q1
\v 16 \w Al|strong="H5921"\w* encontrar tus \w palabras|strong="H1697"\w*,  
\q2 \w yo|strong="H3588"\w* \w las|strong="H5921"\w* devoré.  
\q1 Tus \w palabras|strong="H1697"\w* \w son|strong="H1961"\w* \w mi|strong="H5921"\w* \w gozo|strong="H8057"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* \w alegría|strong="H8057"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w corazón|strong="H3824"\w*,  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H5921"\w* pertenezco, Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*.   
\q1
\v 17 \w No|strong="H3808"\w* \w me|strong="H3588"\w* junté \w con|strong="H3588"\w* \w los|strong="H3427"\w* \w que|strong="H3588"\w* solo piensan \w en|strong="H3588"\w* divertirse.  
\q2 \w Me|strong="H3588"\w* he quedado solo \w porque|strong="H3588"\w* tú pusiste tu \w mano|strong="H3027"\w* sobre mí,  
\q2 \w y|strong="H3588"\w* \w me|strong="H3588"\w* llenaste \w de|strong="H3588"\w* indignación.   
\q1
\v 18 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w mi|strong="H1961"\w* dolor \w no|strong="H3808"\w* \w se|strong="H1961"\w* termina?  
\q2 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w mi|strong="H1961"\w* herida \w es|strong="H1961"\w* incurable  
\q2 y \w no|strong="H3808"\w* \w quiere|strong="H3985"\w* sanar?  
\q1 ¿Vas \w a|strong="H3068"\w* ser \w para|strong="H1961"\w* \w mí|strong="H1961"\w* \w como|strong="H4100"\w* un arroyo engañoso,  
\q2 \w como|strong="H4100"\w* esas \w aguas|strong="H4325"\w* \w que|strong="H4100"\w* \w de|strong="H4325"\w* pronto \w se|strong="H1961"\w* agotan?   
\p
\v 19 \w Por|strong="H6440"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé:  
\q1 “\w Si|strong="H3808"\w* te arrepientes, yo te restauraré  
\q2 \w para|strong="H1961"\w* \w que|strong="H3808"\w* puedas servirme.  
\q1 \w Si|strong="H3808"\w* dejas \w de|strong="H6440"\w* decir \w cosas|strong="H1992"\w* \w sin|strong="H3808"\w* valor \w y|strong="H3541"\w* hablas \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w es|strong="H1961"\w* valioso,  
\q2 tú \w serás|strong="H1961"\w* \w mi|strong="H1961"\w* portavoz.  
\q1 \w Que|strong="H3808"\w* \w ellos|strong="H1992"\w* \w se|strong="H1961"\w* \w vuelvan|strong="H7725"\w* \w a|strong="H3068"\w* ti,  
\q2 pero tú \w no|strong="H3808"\w* te \w vuelvas|strong="H7725"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w*.   
\q1
\v 20 Frente \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w te|strong="H3588"\w* \w pondré|strong="H5414"\w* \w como|strong="H3588"\w* un \w muro|strong="H2346"\w* \w de|strong="H3588"\w* bronce fortificado.  
\q2 Pelearán contra ti,  
\q2 \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* vencerte;  
\q1 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w con|strong="H3588"\w* ustedes \w para|strong="H3588"\w* salvarlos  
\q2 \w y|strong="H3588"\w* \w para|strong="H3588"\w* rescatarte”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 21 “Te \w libraré|strong="H5337"\w* del \w poder|strong="H3027"\w* \w de|strong="H7451"\w* los malvados,  
\q2 y te rescataré \w de|strong="H7451"\w* las \w manos|strong="H3027"\w* \w de|strong="H7451"\w* los violentos”.   
\c 16  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w se|strong="H1961"\w* dirigió \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w No|strong="H3808"\w* te desesperes \w por|strong="H2088"\w* casarte, \w ni|strong="H3808"\w* tengas \w hijos|strong="H1121"\w* \w ni|strong="H3808"\w* \w hijas|strong="H1323"\w* en \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*”.  
\v 3 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* \w que|strong="H3588"\w* nazcan \w aquí|strong="H2088"\w*, \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* madres \w que|strong="H3588"\w* \w los|strong="H1121"\w* den \w a|strong="H3068"\w* luz, \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* padres \w que|strong="H3588"\w* \w los|strong="H1121"\w* \w engendren|strong="H3205"\w* \w en|strong="H5921"\w* \w este|strong="H2088"\w* país:  
\v 4 “\w Morirán|strong="H4191"\w* \w de|strong="H5921"\w* \w enfermedades|strong="H8463"\w* terribles. \w Nadie|strong="H3808"\w* llorará \w por|strong="H5921"\w* \w ellos|strong="H5921"\w* \w ni|strong="H3808"\w* \w los|strong="H5921"\w* \w enterrarán|strong="H6912"\w*; quedarán tirados \w como|strong="H1961"\w* estiércol \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra. \w Morirán|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w hambre|strong="H7458"\w*, \w y|strong="H5921"\w* sus cadáveres \w serán|strong="H1961"\w* \w comida|strong="H3978"\w* \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w las|strong="H5921"\w* fieras \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra”.   
\p
\v 5 \w Así|strong="H3541"\w* \w dice|strong="H5002"\w* Yahvé: “\w No|strong="H3588"\w* entres \w en|strong="H3588"\w* ninguna \w casa|strong="H1004"\w* donde estén \w de|strong="H3588"\w* luto; \w no|strong="H3588"\w* \w vayas|strong="H3212"\w* \w a|strong="H3068"\w* llorarles ni \w a|strong="H3068"\w* darles \w el|strong="H3588"\w* pésame. \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* he retirado mi \w paz|strong="H7965"\w* \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* — \w dice|strong="H5002"\w* Yahvé —, \w y|strong="H3588"\w* les he quitado mi amor fiel \w y|strong="H3588"\w* mi compasión.  
\v 6 \w En|strong="H6912"\w* \w este|strong="H2063"\w* país \w morirán|strong="H4191"\w* todos, desde \w el|strong="H1992"\w* \w más|strong="H4191"\w* importante hasta \w el|strong="H1992"\w* \w más|strong="H4191"\w* humilde. \w Nadie|strong="H3808"\w* \w los|strong="H1992"\w* enterrará \w ni|strong="H3808"\w* llorará por \w ellos|strong="H1992"\w*; \w nadie|strong="H3808"\w* \w se|strong="H3808"\w* hará cortes \w en|strong="H6912"\w* \w el|strong="H1992"\w* cuerpo \w ni|strong="H3808"\w* \w se|strong="H3808"\w* rapará \w la|strong="H2063"\w* cabeza \w en|strong="H6912"\w* señal de duelo.  
\v 7 \w Nadie|strong="H3808"\w* ofrecerá \w el|strong="H5921"\w* pan \w del|strong="H5921"\w* \w consuelo|strong="H5162"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* estén \w de|strong="H5921"\w* luto, \w ni|strong="H3808"\w* \w les|strong="H5921"\w* darán \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* copa \w del|strong="H5921"\w* \w consuelo|strong="H5162"\w*, \w ni|strong="H3808"\w* siquiera \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w muerte|strong="H4191"\w* \w de|strong="H5921"\w* su padre \w o|strong="H3068"\w* \w de|strong="H5921"\w* su madre.   
\p
\v 8 “\w Tampoco|strong="H3808"\w* entres en \w ninguna|strong="H3808"\w* \w casa|strong="H1004"\w* donde haya \w banquete|strong="H4960"\w* para sentarte con ellos \w a|strong="H3068"\w* comer y \w beber|strong="H8354"\w*”.  
\v 9 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H4480"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*: “Miren, voy \w a|strong="H3068"\w* hacer \w que|strong="H3588"\w* \w en|strong="H4480"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, \w y|strong="H3588"\w* \w mientras|strong="H3588"\w* ustedes todavía vivan, \w se|strong="H4480"\w* acaben \w los|strong="H3588"\w* gritos \w de|strong="H4480"\w* \w alegría|strong="H8057"\w* \w y|strong="H3588"\w* \w de|strong="H4480"\w* entusiasmo, \w y|strong="H3588"\w* las \w voces|strong="H6963"\w* \w del|strong="H4480"\w* novio \w y|strong="H3588"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* novia.  
\v 10 \w Cuando|strong="H3588"\w* tú \w le|strong="H5921"\w* anuncies \w todo|strong="H3605"\w* \w esto|strong="H2063"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w ellos|strong="H5921"\w* \w te|strong="H5921"\w* pregunten: ‘¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* Yahvé ha decretado \w esta|strong="H2063"\w* desgracia tan \w grande|strong="H1419"\w* \w contra|strong="H5921"\w* \w nosotros|strong="H3605"\w*? ¿\w Cuál|strong="H4100"\w* \w es|strong="H1961"\w* nuestro \w delito|strong="H5771"\w*? ¿\w Qué|strong="H3588"\w* \w pecado|strong="H2403"\w* hemos cometido \w contra|strong="H5921"\w* Yahvé nuestro \w Dios|strong="H3068"\w*?’,  
\v 11 tú \w les|strong="H5921"\w* responderás: ‘Es \w porque|strong="H5921"\w* sus antepasados \w me|strong="H5921"\w* abandonaron — \w dice|strong="H5002"\w* Yahvé —. \w Se|strong="H5921"\w* \w fueron|strong="H3212"\w* tras otros dioses \w para|strong="H5921"\w* servirlos \w y|strong="H5921"\w* adorarlos; \w me|strong="H5921"\w* abandonaron \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* cumplieron \w mi|strong="H5921"\w* \w ley|strong="H8451"\w*.  
\v 12 ¡Pero ustedes se han portado \w peor|strong="H7489"\w* \w que|strong="H1115"\w* sus antepasados! Miren cómo cada \w uno|strong="H1115"\w* \w de|strong="H7451"\w* ustedes sigue la terquedad \w de|strong="H7451"\w* su \w malvado|strong="H7451"\w* \w corazón|strong="H3820"\w* y se niega \w a|strong="H3068"\w* \w obedecerme|strong="H8085"\w*.  
\v 13 \w Por|strong="H5921"\w* \w eso|strong="H2063"\w*, \w los|strong="H5921"\w* expulsaré \w de|strong="H5921"\w* \w este|strong="H2063"\w* país \w a|strong="H3068"\w* una tierra \w que|strong="H3808"\w* \w ni|strong="H3808"\w* ustedes \w ni|strong="H3808"\w* sus antepasados \w conocieron|strong="H3045"\w*. \w Allá|strong="H8033"\w* \w servirán|strong="H5647"\w* \w a|strong="H3068"\w* otros dioses \w de|strong="H5921"\w* \w día|strong="H3119"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w*, \w porque|strong="H5921"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* tendré \w ninguna|strong="H3808"\w* compasión’.   
\p
\v 14 “\w Sin|strong="H3808"\w* embargo, vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé — \w en|strong="H5750"\w* \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* \w se|strong="H3808"\w* dirá: ‘\w Por|strong="H5750"\w* la \w vida|strong="H2416"\w* \w de|strong="H5750"\w* Yahvé, \w que|strong="H3808"\w* \w sacó|strong="H5927"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w de|strong="H5750"\w* \w Egipto|strong="H4714"\w*’,  
\v 15 \w sino|strong="H3588"\w*: ‘\w Por|strong="H5921"\w* \w la|strong="H5921"\w* \w vida|strong="H2416"\w* \w de|strong="H5921"\w* Yahvé, \w que|strong="H3588"\w* \w sacó|strong="H5927"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w del|strong="H5921"\w* \w norte|strong="H6828"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* países \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w los|strong="H1121"\w* \w había|strong="H3588"\w* expulsado’. \w Yo|strong="H3588"\w* \w los|strong="H1121"\w* \w haré|strong="H5414"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w que|strong="H3588"\w* \w les|strong="H5921"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados.   
\p
\v 16 “Miren, voy \w a|strong="H3068"\w* mandar \w a|strong="H3068"\w* \w muchos|strong="H7227"\w* \w pescadores|strong="H7227"\w* — \w dice|strong="H5002"\w* Yahvé — \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* pesquen. \w Después|strong="H5921"\w* mandaré \w a|strong="H3068"\w* \w muchos|strong="H7227"\w* \w cazadores|strong="H6719"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* cacen \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w y|strong="H5921"\w* colinas, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* grietas \w de|strong="H5921"\w* \w las|strong="H5921"\w* rocas.  
\v 17 \w Yo|strong="H3588"\w* veo \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* hacen; \w nada|strong="H3808"\w* \w de|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* hacen \w se|strong="H5921"\w* \w me|strong="H5921"\w* oculta, \w ni|strong="H3808"\w* \w su|strong="H3588"\w* \w maldad|strong="H5771"\w* puede esconderse \w de|strong="H5921"\w* \w mi|strong="H5921"\w* vista.  
\v 18 Pero \w primero|strong="H7223"\w* \w les|strong="H5921"\w* \w pagaré|strong="H7999"\w* \w el|strong="H5921"\w* doble \w por|strong="H5921"\w* su \w maldad|strong="H5771"\w* \w y|strong="H5921"\w* su \w pecado|strong="H2403"\w*, \w porque|strong="H5921"\w* \w contaminaron|strong="H2490"\w* \w mi|strong="H5921"\w* tierra \w con|strong="H5921"\w* sus ídolos asquerosos \w y|strong="H5921"\w* \w llenaron|strong="H4390"\w* \w mi|strong="H5921"\w* \w heredad|strong="H5159"\w* \w con|strong="H5921"\w* sus actos repugnantes”.   
\b  
\q1
\v 19 Yahvé, tú eres mi fuerza, mi \w fortaleza|strong="H5797"\w*  
\q2 \w y|strong="H5797"\w* mi \w refugio|strong="H4498"\w* en \w tiempos|strong="H3117"\w* de \w angustia|strong="H6869"\w*.  
\q1 \w A|strong="H3068"\w* ti vendrán las \w naciones|strong="H1471"\w* desde los rincones \w más|strong="H1471"\w* lejanos de la tierra,  
\q2 \w y|strong="H5797"\w* dirán:  
\q1 “Nuestros antepasados solo heredaron \w mentiras|strong="H8267"\w*,  
\q2 ídolos inútiles \w que|strong="H3117"\w* no sirven para nada.   
\q1
\v 20 ¿Acaso puede \w el|strong="H6213"\w* hombre fabricar \w sus|strong="H1992"\w* propios dioses?  
\q2 ¡\w Si|strong="H3808"\w* \w los|strong="H1992"\w* fabrica, \w no|strong="H3808"\w* \w son|strong="H3808"\w* dioses!”.   
\b  
\q1
\v 21 “\w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w esta|strong="H2063"\w* \w vez|strong="H6471"\w* voy \w a|strong="H3068"\w* darles \w una|strong="H6471"\w* lección:  
\q2 les haré conocer mi \w mano|strong="H3027"\w* \w y|strong="H3588"\w* mi \w poder|strong="H3027"\w*.  
\q2 ¡\w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* mi \w nombre|strong="H8034"\w* \w es|strong="H3027"\w* Yahvé!”.   
\c 17  
\q1
\v 1 “\w El|strong="H5921"\w* \w pecado|strong="H2403"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w con|strong="H5921"\w* cincel \w de|strong="H5921"\w* \w hierro|strong="H1270"\w*  
\q2 \w y|strong="H5921"\w* \w con|strong="H5921"\w* punta \w de|strong="H5921"\w* diamante.  
\q1 Grabado \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tabla \w de|strong="H5921"\w* su \w corazón|strong="H3820"\w*  
\q2 \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w cuernos|strong="H7161"\w* \w de|strong="H5921"\w* sus \w altares|strong="H4196"\w*.   
\q1
\v 2 Mientras sus \w hijos|strong="H1121"\w* \w se|strong="H5921"\w* acuerdan \w de|strong="H5921"\w* sus \w altares|strong="H4196"\w*  
\q2 \w y|strong="H5921"\w* \w de|strong="H5921"\w* sus imágenes \w de|strong="H5921"\w* Asera \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w árboles|strong="H6086"\w* verdes \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas altas.   
\q1
\v 3 Oh montaña mía en \w el|strong="H3605"\w* \w campo|strong="H7704"\w*,  
\q2 tus \w riquezas|strong="H2428"\w* y \w todos|strong="H3605"\w* tus tesoros \w entregaré|strong="H5414"\w* al saqueo,  
\q2 y tus santuarios paganos \w a|strong="H3068"\w* causa del \w pecado|strong="H2403"\w* en \w todo|strong="H3605"\w* tu territorio.   
\q1
\v 4 Tú misma perderás \w la|strong="H3588"\w* \w herencia|strong="H5159"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w di|strong="H5414"\w*.  
\q2 \w Te|strong="H3588"\w* \w haré|strong="H5414"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* tus enemigos \w en|strong="H5704"\w* una tierra \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w conoces|strong="H3045"\w*;  
\q2 \w porque|strong="H3588"\w* han \w encendido|strong="H3344"\w* \w el|strong="H3588"\w* fuego \w de|strong="H3588"\w* mi enojo, \w que|strong="H3588"\w* \w arderá|strong="H3344"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*”.   
\p
\v 5 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Maldito el \w hombre|strong="H1397"\w* \w que|strong="H4480"\w* confía \w en|strong="H4480"\w* el \w hombre|strong="H1397"\w*,  
\q2 \w que|strong="H4480"\w* \w se|strong="H4480"\w* apoya \w en|strong="H4480"\w* fuerzas humanas,  
\q2 \w y|strong="H3541"\w* cuyo \w corazón|strong="H3820"\w* \w se|strong="H4480"\w* \w aparta|strong="H5493"\w* \w de|strong="H4480"\w* Yahvé.   
\q1
\v 6 \w Pues|strong="H3588"\w* \w será|strong="H1961"\w* \w como|strong="H3588"\w* un matorral \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*,  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w verá|strong="H7200"\w* \w cuando|strong="H3588"\w* llegue \w el|strong="H3588"\w* \w bien|strong="H2896"\w*,  
\q1 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w habitará|strong="H7931"\w* \w en|strong="H3588"\w* \w los|strong="H3427"\w* sequedales del \w desierto|strong="H4057"\w*,  
\q2 \w en|strong="H3588"\w* tierra \w de|strong="H3588"\w* sal donde \w nadie|strong="H3808"\w* vive.   
\b  
\q1
\v 7 “\w Bendito|strong="H1288"\w* el \w hombre|strong="H1397"\w* \w que|strong="H1961"\w* confía en Yahvé,  
\q2 y cuya \w confianza|strong="H4009"\w* \w es|strong="H1961"\w* Yahvé.   
\q1
\v 8 \w Porque|strong="H3588"\w* \w será|strong="H1961"\w* \w como|strong="H3588"\w* un \w árbol|strong="H6086"\w* \w plantado|strong="H8362"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*,  
\q2 \w que|strong="H3588"\w* \w extiende|strong="H7971"\w* sus \w raíces|strong="H8328"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* corriente,  
\q1 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w temerá|strong="H3372"\w* \w cuando|strong="H3588"\w* llegue \w el|strong="H5921"\w* calor,  
\q2 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* hoja \w estará|strong="H1961"\w* \w verde|strong="H7488"\w*;  
\q1 \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* sequía \w no|strong="H3808"\w* \w se|strong="H1961"\w* angustiará,  
\q2 \w ni|strong="H3808"\w* dejará \w de|strong="H5921"\w* dar \w fruto|strong="H6529"\w*.   
\q1
\v 9 \w El|strong="H1931"\w* \w corazón|strong="H3820"\w* \w es|strong="H1931"\w* \w engañoso|strong="H6121"\w* más \w que|strong="H4310"\w* \w todas|strong="H3605"\w* las \w cosas|strong="H3045"\w*,  
\q2 y perverso;  
\q2 ¿\w quién|strong="H4310"\w* puede conocerlo?   
\b  
\q1
\v 10 “Yo, Yahvé, exploro la mente.  
\q2 Examino el \w corazón|strong="H3820"\w*,  
\q1 \w para|strong="H5414"\w* \w dar|strong="H5414"\w* \w a|strong="H3068"\w* cada uno según su conducta,  
\q2 según el \w fruto|strong="H6529"\w* \w de|strong="H5414"\w* sus acciones”.   
\b  
\q1
\v 11 \w Como|strong="H1961"\w* la \w perdiz|strong="H7124"\w* \w que|strong="H3808"\w* empolla huevos \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w puso|strong="H3205"\w*,  
\q2 así \w es|strong="H1961"\w* \w el|strong="H6213"\w* \w que|strong="H3808"\w* junta \w riquezas|strong="H6239"\w* injustamente.  
\q1 \w A|strong="H3068"\w* la mitad de su \w vida|strong="H3117"\w* las perderá,  
\q2 y al final resultará un necio.   
\q1
\v 12 \w Trono|strong="H3678"\w* de \w gloria|strong="H3519"\w*, \w excelso|strong="H4791"\w* desde el principio,  
\q2 es el \w lugar|strong="H4725"\w* de nuestro \w santuario|strong="H4720"\w*.   
\q1
\v 13 ¡Yahvé, \w esperanza|strong="H4723"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*!,  
\q2 \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w abandonan|strong="H5800"\w* quedarán defraudados.  
\q1 \w Los|strong="H3605"\w* \w que|strong="H3588"\w* se apartan \w de|strong="H3588"\w* ti serán borrados \w de|strong="H3588"\w* \w la|strong="H3605"\w* tierra,  
