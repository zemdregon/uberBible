\q1
\v 27 Maten \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w novillos|strong="H6499"\w*;  
\q2 \w que|strong="H3588"\w* bajen \w todos|strong="H3605"\w* \w al|strong="H5921"\w* matadero.  
\q1 ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*!, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w día|strong="H3117"\w* ha llegado,  
\q2 \w el|strong="H5921"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* castigo.   
\q1
\v 28 Se oye la \w voz|strong="H6963"\w* de los que huyen y escapan de Babilonia  
\q2 para \w anunciar|strong="H5046"\w* en \w Sión|strong="H6726"\w* la \w venganza|strong="H5360"\w* de Yahvé nuestro \w Dios|strong="H3068"\w*,  
\q2 la \w venganza|strong="H5360"\w* \w por|strong="H5127"\w* lo que hicieron con su \w templo|strong="H1964"\w*.   
\b  
\q1
\v 29 Llamen \w a|strong="H3068"\w* \w los|strong="H5921"\w* arqueros \w contra|strong="H5921"\w* Babilonia,  
\q2 \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* tensan \w el|strong="H5921"\w* \w arco|strong="H7198"\w*.  
\q1 Rodéenla \w con|strong="H5921"\w* sus campamentos; \w que|strong="H3588"\w* \w nadie|strong="H3605"\w* escape.  
\q2 Páguenle \w según|strong="H5921"\w* sus \w obras|strong="H6467"\w*;  
\q1 \w hagan|strong="H6213"\w* \w con|strong="H5921"\w* \w ella|strong="H5921"\w* \w lo|strong="H5921"\w* \w mismo|strong="H3605"\w* \w que|strong="H3588"\w* \w ella|strong="H5921"\w* \w hizo|strong="H6213"\w*,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H1961"\w* llenó \w de|strong="H5921"\w* soberbia \w contra|strong="H5921"\w* Yahvé, \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\q1
\v 30 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w* \w sus|strong="H1931"\w* jóvenes \w caerán|strong="H5307"\w* en las \w plazas|strong="H7339"\w*,  
\q2 y \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* soldados \w morirán|strong="H1826"\w* en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé —.   
\q1
\v 31 \w Yo|strong="H3588"\w* estoy contra ti, criatura soberbia — \w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor, Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* —;  
\q2 \w porque|strong="H3588"\w* tu \w día|strong="H3117"\w* ha llegado, \w el|strong="H3588"\w* \w tiempo|strong="H6256"\w* \w en|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* voy \w a|strong="H3068"\w* castigar.   
\q1
\v 32 \w El|strong="H3605"\w* orgulloso \w tropezará|strong="H3782"\w* y \w caerá|strong="H5307"\w*,  
\q2 y no habrá \w quien|strong="H3605"\w* \w lo|strong="H3605"\w* levante.  
