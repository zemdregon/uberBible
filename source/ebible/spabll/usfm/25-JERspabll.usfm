\p
\v 1 \w El|strong="H1121"\w* \w rey|strong="H4428"\w* Sedequías \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Josías|strong="H2977"\w* \w reinó|strong="H4427"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w Conías|strong="H3659"\w* \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Joacim|strong="H3079"\w*, pues \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H8478"\w* Babilonia, lo puso \w como|strong="H8478"\w* \w rey|strong="H4428"\w* \w en|strong="H8478"\w* la tierra \w de|strong="H8478"\w* \w Judá|strong="H3063"\w*.  
