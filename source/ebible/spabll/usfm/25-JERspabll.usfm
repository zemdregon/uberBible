\q2 \w la|strong="H3605"\w* \w fuente|strong="H4726"\w* \w de|strong="H3588"\w* \w aguas|strong="H4325"\w* \w vivas|strong="H2416"\w*.   
\q1
\v 14 \w Sáname|strong="H7495"\w*, Yahvé, \w y|strong="H3588"\w* quedaré \w sano|strong="H7495"\w*;  
\q2 \w sálvame|strong="H3467"\w*, \w y|strong="H3588"\w* seré \w salvo|strong="H3467"\w*;  
