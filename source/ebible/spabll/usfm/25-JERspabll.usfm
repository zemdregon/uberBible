\q1 \w Su|strong="H1992"\w* rugido es \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w bramido|strong="H6963"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*  
\q2 \w y|strong="H5921"\w* vienen montados \w a|strong="H3068"\w* \w caballo|strong="H5483"\w*.  
