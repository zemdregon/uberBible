\v 11 \w A|strong="H3068"\w* Sedequías \w le|strong="H5869"\w* sacó los \w ojos|strong="H5869"\w* \w y|strong="H5704"\w* \w lo|strong="H5704"\w* encadenó \w con|strong="H5704"\w* grilletes \w de|strong="H5704"\w* bronce; \w luego|strong="H5704"\w* el \w rey|strong="H4428"\w* \w de|strong="H5704"\w* Babilonia \w lo|strong="H5704"\w* llevó \w a|strong="H3068"\w* Babilonia \w y|strong="H5704"\w* \w lo|strong="H5704"\w* mantuvo \w en|strong="H5704"\w* prisión \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* su \w muerte|strong="H4194"\w*.   
\p
\v 12 \w El|strong="H1931"\w* día \w diez|strong="H6240"\w* del \w mes|strong="H2320"\w* \w quinto|strong="H2549"\w* del \w año|strong="H8141"\w* \w diecinueve|strong="H8672"\w* del \w reinado|strong="H4428"\w* \w de|strong="H6440"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Babilonia, \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H6440"\w* \w la|strong="H1931"\w* guardia y consejero del \w rey|strong="H4428"\w*, entró \w en|strong="H5975"\w* Jerusalén.  
