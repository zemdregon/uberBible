\v 20 \w Y|strong="H3068"\w* \w dijo|strong="H1696"\w* \w Jeremías|strong="H3414"\w*: “\w No|strong="H3808"\w* \w te|strong="H5315"\w* entregarán. \w Oye|strong="H8085"\w* \w ahora|strong="H4994"\w*, \w te|strong="H5315"\w* \w ruego|strong="H4994"\w*, la \w voz|strong="H6963"\w* \w de|strong="H5414"\w* Yahvé en \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w yo|strong="H5315"\w* \w te|strong="H5315"\w* \w hablo|strong="H1696"\w*, y \w te|strong="H5315"\w* irá \w bien|strong="H3190"\w* y \w vivirá|strong="H2421"\w* tu \w alma|strong="H5315"\w*.  
\v 21 Pero si no quieres entregarte, \w esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w palabra|strong="H1697"\w* \w que|strong="H1697"\w* me ha mostrado Yahvé:  
\v 22 ‘He \w aquí|strong="H2009"\w* \w que|strong="H3605"\w* \w todas|strong="H3605"\w* las mujeres \w que|strong="H3605"\w* han quedado \w en|strong="H3318"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w* serán sacadas \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w* del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* Babilonia; y \w ellas|strong="H2007"\w* mismas dirán:  
\q1 “Tus amigos íntimos te han engañado,  
\q2 y han prevalecido contra ti;  
\q1 se hundieron tus \w pies|strong="H7272"\w* \w en|strong="H3318"\w* \w el|strong="H3605"\w* lodo,  
\q2 y \w ellos|strong="H3605"\w* se volvieron atrás”.   
\p
\v 23 Llevarán, \w pues|strong="H3588"\w*, \w todas|strong="H3605"\w* tus mujeres \w y|strong="H3588"\w* tus \w hijos|strong="H1121"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w caldeos|strong="H3778"\w*, \w y|strong="H3588"\w* tú \w no|strong="H3808"\w* \w escaparás|strong="H4422"\w* \w de|strong="H3588"\w* sus \w manos|strong="H3027"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w por|strong="H3588"\w* \w mano|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia serás apresado; \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* le pondrán fuego’”.   
\p
\v 24 Entonces dijo Sedequías \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*: “\w Nadie|strong="H3808"\w* \w sepa|strong="H3045"\w* estas \w palabras|strong="H1697"\w*, y \w no|strong="H3808"\w* \w morirás|strong="H4191"\w*.  
\v 25 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w los|strong="H3588"\w* \w príncipes|strong="H8269"\w* \w oyeren|strong="H8085"\w* \w que|strong="H3588"\w* \w yo|strong="H4480"\w* he \w hablado|strong="H1696"\w* contigo, \w y|strong="H3588"\w* vinieren \w a|strong="H3068"\w* \w ti|strong="H4480"\w* \w y|strong="H3588"\w* \w te|strong="H4480"\w* dijeren: ‘\w Decláranos|strong="H5046"\w* \w ahora|strong="H4994"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w hablaste|strong="H1696"\w* \w con|strong="H4480"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w*, \w no|strong="H3808"\w* \w nos|strong="H4480"\w* \w lo|strong="H4100"\w* \w encubras|strong="H3582"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H4480"\w* \w mataremos|strong="H4191"\w*; dinos también \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w te|strong="H4480"\w* \w ha|strong="H3808"\w* \w dicho|strong="H1696"\w*’,  
\v 26 les dirás: ‘Presenté \w mi|strong="H1115"\w* \w ruego|strong="H8467"\w* \w delante|strong="H6440"\w* del \w rey|strong="H4428"\w*, para \w que|strong="H1115"\w* \w no|strong="H1115"\w* me hiciese \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w casa|strong="H1004"\w* \w de|strong="H6440"\w* Jonatán para \w morir|strong="H4191"\w* \w allí|strong="H8033"\w*’”.   
\p
\v 27 \w Y|strong="H3068"\w* \w vinieron|strong="H5046"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w príncipes|strong="H8269"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*, \w y|strong="H3588"\w* le \w preguntaron|strong="H7592"\w*; \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w les|strong="H1992"\w* respondió conforme \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w aquellas|strong="H1992"\w* \w palabras|strong="H1697"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* le \w había|strong="H3588"\w* \w mandado|strong="H6680"\w*. \w Con|strong="H4480"\w* \w esto|strong="H1697"\w* \w se|strong="H4480"\w* retiraron \w de|strong="H4480"\w* \w él|strong="H3588"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w asunto|strong="H1697"\w* \w no|strong="H3808"\w* \w se|strong="H4480"\w* \w había|strong="H3588"\w* divulgado.   
\p
\v 28 \w Y|strong="H3068"\w* \w quedó|strong="H1961"\w* \w Jeremías|strong="H3414"\w* \w en|strong="H5704"\w* \w el|strong="H3427"\w* \w patio|strong="H2691"\w* \w de|strong="H5704"\w* la guardia \w hasta|strong="H5704"\w* \w el|strong="H3427"\w* \w día|strong="H3117"\w* \w que|strong="H5704"\w* \w fue|strong="H1961"\w* \w tomada|strong="H3920"\w* Jerusalén.   
\c 39  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w mes|strong="H2320"\w* \w décimo|strong="H6224"\w* \w del|strong="H5921"\w* \w noveno|strong="H8671"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, llegó \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H2428"\w* \w a|strong="H3068"\w* Jerusalén \w y|strong="H5921"\w* puso sitio \w a|strong="H3068"\w* \w la|strong="H5921"\w* ciudad.  
\v 2 El día \w nueve|strong="H8672"\w* del \w mes|strong="H2320"\w* \w cuarto|strong="H7243"\w* del \w año|strong="H8141"\w* \w undécimo|strong="H6249"\w* de Sedequías, se abrió una brecha en el muro de la \w ciudad|strong="H5892"\w*.  
\v 3 Entonces \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w jefes|strong="H8269"\w* del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* Babilonia entraron y se instalaron \w en|strong="H8432"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* del \w Medio|strong="H8432"\w*: \w Nergal-sarezer|strong="H5371"\w*, \w Samgar-nebo|strong="H5562"\w*, Sarsequim \w el|strong="H3605"\w* \w Rabsaris|strong="H7249"\w*, \w Nergal-sarezer|strong="H5371"\w* \w el|strong="H3605"\w* \w Rabmag|strong="H7248"\w*, y \w todos|strong="H3605"\w* \w los|strong="H3427"\w* demás \w jefes|strong="H8269"\w* del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* Babilonia.  
\v 4 \w Al|strong="H4480"\w* verlos Sedequías, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, y \w todos|strong="H3605"\w* sus soldados, \w huyeron|strong="H1272"\w* \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*. \w Salieron|strong="H3318"\w* \w de|strong="H4480"\w* \w noche|strong="H3915"\w* \w por|strong="H4480"\w* \w el|strong="H3605"\w* \w camino|strong="H1870"\w* \w del|strong="H4480"\w* jardín \w real|strong="H4428"\w*, \w por|strong="H4480"\w* \w la|strong="H3605"\w* \w puerta|strong="H8179"\w* \w que|strong="H4480"\w* \w está|strong="H1961"\w* \w entre|strong="H4480"\w* \w los|strong="H3605"\w* dos \w muros|strong="H2346"\w*, y tomaron \w el|strong="H3605"\w* \w camino|strong="H1870"\w* \w del|strong="H4480"\w* Arabá.   
\p
\v 5 Pero el \w ejército|strong="H2428"\w* de \w los|strong="H7291"\w* \w caldeos|strong="H3778"\w* \w los|strong="H7291"\w* \w persiguió|strong="H7291"\w* y \w alcanzó|strong="H5381"\w* \w a|strong="H3068"\w* Sedequías en las llanuras de \w Jericó|strong="H3405"\w*. Lo capturaron y lo \w llevaron|strong="H3947"\w* ante \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* de Babilonia, en Ribla, en la tierra de Hamat, donde el \w rey|strong="H4428"\w* \w pronunció|strong="H1696"\w* \w sentencia|strong="H4941"\w* contra él.  
\v 6 Allí en Ribla, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia mandó degollar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Sedequías ante sus propios \w ojos|strong="H5869"\w*, y también \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* nobles \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 7 Luego \w le|strong="H5869"\w* sacó los \w ojos|strong="H5869"\w* \w a|strong="H3068"\w* Sedequías y lo encadenó para llevarlo \w a|strong="H3068"\w* Babilonia.   
\p
\v 8 Los \w caldeos|strong="H3778"\w* incendiaron el palacio \w real|strong="H4428"\w* y las \w casas|strong="H1004"\w* del \w pueblo|strong="H5971"\w*, y derribaron las murallas \w de|strong="H5971"\w* Jerusalén.  
\v 9 \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia, \w se|strong="H5921"\w* llevó deportados \w a|strong="H3068"\w* Babilonia \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* aún quedaban \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* habían rendido \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w*.  
\v 10 Sin embargo, \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H4480"\w* \w la|strong="H1931"\w* guardia, \w dejó|strong="H7604"\w* \w en|strong="H4480"\w* \w la|strong="H1931"\w* tierra \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w más|strong="H4480"\w* \w pobre|strong="H1800"\w*, \w que|strong="H4480"\w* no \w tenía|strong="H1931"\w* \w nada|strong="H3972"\w*, y \w en|strong="H4480"\w* \w ese|strong="H1931"\w* momento \w les|strong="H3972"\w* \w dio|strong="H5414"\w* viñedos y campos.   
\p
\v 11 \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w le|strong="H5921"\w* dio estas órdenes \w a|strong="H3068"\w* \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia, \w con|strong="H5921"\w* respecto \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 12 “Búscalo \w y|strong="H3588"\w* cuida \w de|strong="H5921"\w* \w él|strong="H5921"\w*; \w no|strong="H6213"\w* \w le|strong="H5921"\w* \w hagas|strong="H6213"\w* ningún daño. \w Al|strong="H5921"\w* contrario, trátalo \w según|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w él|strong="H5921"\w* \w te|strong="H5869"\w* pida”.   
\p
\v 13 Entonces \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* de \w la|strong="H3605"\w* guardia, junto con Nabusazbán \w el|strong="H3605"\w* \w Rabsaris|strong="H7249"\w*, \w Nergal-sarezer|strong="H5371"\w* \w el|strong="H3605"\w* \w Rabmag|strong="H7248"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* oficiales del \w rey|strong="H4428"\w* de Babilonia, mandaron \w a|strong="H3068"\w* buscarlo.  
\v 14 \w Sacaron|strong="H3318"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* del \w patio|strong="H2691"\w* \w de|strong="H1121"\w* la guardia y lo \w pusieron|strong="H5414"\w* bajo \w el|strong="H1121"\w* cuidado \w de|strong="H1121"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán, \w para|strong="H5414"\w* \w que|strong="H5971"\w* lo \w llevara|strong="H3947"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*. \w De|strong="H1121"\w* \w esta|strong="H3427"\w* manera, \w Jeremías|strong="H3414"\w* \w se|strong="H5971"\w* \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir con su \w pueblo|strong="H5971"\w*.   
\p
\v 15 Mientras \w Jeremías|strong="H3414"\w* \w estaba|strong="H1961"\w* todavía bajo arresto en el \w patio|strong="H2691"\w* \w de|strong="H1697"\w* la guardia, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* él:  
\v 16 “\w Ve|strong="H1980"\w* \w y|strong="H3541"\w* dile \w a|strong="H3068"\w* \w Ebed-melec|strong="H5663"\w* \w el|strong="H1931"\w* \w etíope|strong="H3569"\w*: ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H6440"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*: \w Voy|strong="H1980"\w* \w a|strong="H3068"\w* cumplir mis advertencias \w contra|strong="H6440"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w para|strong="H1961"\w* desastre \w y|strong="H3541"\w* \w no|strong="H3808"\w* \w para|strong="H1961"\w* bienestar; \w y|strong="H3541"\w* en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* tú \w mismo|strong="H1931"\w* \w lo|strong="H1931"\w* verás.  
\v 17 Pero en \w ese|strong="H1931"\w* \w día|strong="H3117"\w* yo te \w libraré|strong="H5337"\w* — \w dice|strong="H5002"\w* Yahvé — y \w no|strong="H3808"\w* serás \w entregado|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H6440"\w* \w los|strong="H1931"\w* hombres \w a|strong="H3068"\w* quienes \w temes|strong="H3016"\w*.  
\v 18 \w Ciertamente|strong="H3588"\w* \w te|strong="H3588"\w* salvaré; \w no|strong="H3808"\w* morirás \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* salvarás tu \w vida|strong="H5315"\w* \w porque|strong="H3588"\w* confiaste \w en|strong="H3588"\w* \w mí|strong="H1961"\w* — \w dice|strong="H5002"\w* Yahvé —’”.   
\c 40  
\p
\v 1 \w Esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* Yahvé \w que|strong="H4480"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*, \w después|strong="H1961"\w* \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H4480"\w* \w la|strong="H1931"\w* guardia, \w lo|strong="H1931"\w* \w dejó|strong="H7971"\w* libre \w en|strong="H4480"\w* \w Ramá|strong="H7414"\w*. \w Nabuzaradán|strong="H5018"\w* \w lo|strong="H1931"\w* \w había|strong="H1961"\w* encontrado encadenado \w entre|strong="H8432"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w cautivos|strong="H1540"\w* \w de|strong="H4480"\w* Jerusalén y \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w que|strong="H4480"\w* \w eran|strong="H1961"\w* llevados \w al|strong="H4480"\w* exilio \w en|strong="H4480"\w* Babilonia.  
\v 2 El \w capitán|strong="H7227"\w* \w de|strong="H7451"\w* \w la|strong="H2063"\w* guardia \w mandó|strong="H1696"\w* llamar \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* y le \w dijo|strong="H1696"\w*: “Yahvé tu \w Dios|strong="H3068"\w* anunció \w este|strong="H2088"\w* desastre sobre \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*;  
\v 3 \w y|strong="H3588"\w* ahora Yahvé \w lo|strong="H1697"\w* \w ha|strong="H3808"\w* traído \w y|strong="H3588"\w* \w lo|strong="H1697"\w* \w ha|strong="H3808"\w* \w cumplido|strong="H6213"\w* \w tal|strong="H2088"\w* \w como|strong="H3588"\w* \w lo|strong="H1697"\w* advirtió. \w Porque|strong="H3588"\w* ustedes \w pecaron|strong="H2398"\w* \w contra|strong="H1961"\w* Yahvé \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* \w su|strong="H3588"\w* \w voz|strong="H6963"\w*, \w es|strong="H1961"\w* \w que|strong="H3588"\w* les \w ha|strong="H3808"\w* sucedido \w esto|strong="H2088"\w*.  
\v 4 Pero \w mira|strong="H7200"\w*, \w hoy|strong="H3117"\w* \w te|strong="H5869"\w* quito \w las|strong="H5921"\w* cadenas \w de|strong="H4480"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w*. \w Si|strong="H6440"\w* \w te|strong="H5869"\w* parece \w bien|strong="H2896"\w* \w venir|strong="H3212"\w* conmigo \w a|strong="H3068"\w* Babilonia, \w ven|strong="H3212"\w*, \w y|strong="H5921"\w* \w yo|strong="H4480"\w* \w te|strong="H5869"\w* cuidaré; pero \w si|strong="H6440"\w* \w no|strong="H2308"\w* quieres \w venir|strong="H3212"\w*, \w no|strong="H2308"\w* \w lo|strong="H5921"\w* hagas. \w Tienes|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país \w delante|strong="H6440"\w* \w de|strong="H4480"\w* \w ti|strong="H5921"\w*; \w ve|strong="H3212"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w te|strong="H5869"\w* \w parezca|strong="H7200"\w* \w mejor|strong="H2896"\w* \w y|strong="H5921"\w* \w más|strong="H4480"\w* conveniente”.  
\v 5 \w Como|strong="H5750"\w* Jeremías \w aún|strong="H5750"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* decidía \w a|strong="H3068"\w* irse, \w el|strong="H3605"\w* \w capitán|strong="H7227"\w* añadió: “Regresa \w entonces|strong="H7725"\w* con \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H5750"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H5750"\w* Safán, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w de|strong="H5750"\w* Babilonia \w ha|strong="H3808"\w* nombrado gobernador \w de|strong="H5750"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5750"\w* \w Judá|strong="H3063"\w*. \w Quédate|strong="H3427"\w* con \w él|strong="H3605"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* del \w pueblo|strong="H5971"\w*, \w o|strong="H3068"\w* \w ve|strong="H3212"\w* \w a|strong="H3068"\w* donde prefieras”.  
\p \w Entonces|strong="H7725"\w* \w el|strong="H3605"\w* \w capitán|strong="H7227"\w* \w de|strong="H5750"\w* \w la|strong="H3605"\w* guardia \w le|strong="H5869"\w* \w dio|strong="H5414"\w* provisiones y un regalo, y \w lo|strong="H3808"\w* \w dejó|strong="H7971"\w* \w ir|strong="H3212"\w*.  
\v 6 \w Jeremías|strong="H3414"\w* \w se|strong="H5971"\w* fue \w a|strong="H3068"\w* Mizpa \w para|strong="H5971"\w* quedarse con \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam, y vivió allí con la \w gente|strong="H5971"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* había quedado \w en|strong="H8432"\w* \w el|strong="H1121"\w* país.   
\p
\v 7 \w Todos|strong="H3605"\w* \w los|strong="H1992"\w* \w jefes|strong="H8269"\w* \w de|strong="H3588"\w* \w las|strong="H1992"\w* tropas \w que|strong="H3588"\w* estaban \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w campo|strong="H7704"\w* supieron, junto \w con|strong="H3588"\w* \w sus|strong="H1992"\w* \w hombres|strong="H1121"\w*, \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia \w había|strong="H3588"\w* nombrado \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ahicam \w como|strong="H3588"\w* \w gobernador|strong="H8269"\w* del país. Supieron también \w que|strong="H3588"\w* le \w había|strong="H3588"\w* confiado \w el|strong="H3588"\w* cuidado \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w hombres|strong="H1121"\w*, \w las|strong="H1992"\w* mujeres \w y|strong="H3588"\w* \w los|strong="H1992"\w* \w niños|strong="H2945"\w* \w más|strong="H3588"\w* pobres \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra, \w que|strong="H3588"\w* \w no|strong="H3808"\w* habían sido llevados \w al|strong="H4428"\w* exilio \w en|strong="H3588"\w* Babilonia.  
\v 8 Entonces fueron \w a|strong="H3068"\w* Mizpa para ver \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w*; allí llegaron \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías, \w Johanán|strong="H3110"\w* y Jonatán \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w*, \w Seraías|strong="H8304"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Tanhumet, \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Efai \w de|strong="H1121"\w* Netofa, y Jezanías \w hijo|strong="H1121"\w* del maacateo, todos \w ellos|strong="H1992"\w* con \w sus|strong="H1992"\w* \w hombres|strong="H1121"\w*.  
\v 9 \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán, les hizo un juramento \w a|strong="H3068"\w* ellos y \w a|strong="H3068"\w* sus \w hombres|strong="H1121"\w*: “No tengan \w miedo|strong="H3372"\w* \w de|strong="H1121"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w*. Quédense en \w el|strong="H1121"\w* país y sirvan \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia, y les irá \w bien|strong="H3190"\w*.  
\v 10 \w Por|strong="H6440"\w* mi parte, yo me \w quedaré|strong="H3427"\w* \w en|strong="H5975"\w* \w Mizpa|strong="H4709"\w* para representarlos \w ante|strong="H6440"\w* \w los|strong="H3427"\w* \w caldeos|strong="H3778"\w* que vengan \w a|strong="H3068"\w* vernos; pero ustedes cosechen \w el|strong="H3427"\w* \w vino|strong="H3196"\w*, \w el|strong="H3427"\w* \w aceite|strong="H8081"\w* y \w los|strong="H3427"\w* \w frutos|strong="H7019"\w* \w de|strong="H6440"\w* \w verano|strong="H7019"\w*, almacénenlos y vivan \w en|strong="H5975"\w* las \w ciudades|strong="H5892"\w* que han ocupado”.   
\p
\v 11 \w También|strong="H1571"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* \w que|strong="H3588"\w* estaban \w en|strong="H5921"\w* \w Moab|strong="H4124"\w*, Amón, Edom \w y|strong="H1571"\w* \w en|strong="H5921"\w* \w los|strong="H1121"\w* otros países, \w oyeron|strong="H8085"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w había|strong="H3588"\w* dejado \w a|strong="H3068"\w* un grupo \w de|strong="H5921"\w* sobrevivientes \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H1571"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* \w puesto|strong="H3588"\w* \w como|strong="H3588"\w* gobernador \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Safán.  
\v 12 \w Entonces|strong="H7725"\w* \w todos|strong="H3605"\w* esos \w judíos|strong="H3064"\w* regresaron de \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* adonde habían sido expulsados y fueron \w a|strong="H3068"\w* \w la|strong="H3605"\w* tierra de \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* en Mizpa; y recogieron una \w gran|strong="H3966"\w* cantidad de \w vino|strong="H3196"\w* y de \w frutos|strong="H7019"\w* de \w verano|strong="H7019"\w*.   
\p
\v 13 Pero \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H1121"\w* las tropas \w que|strong="H1121"\w* estaban en \w el|strong="H3605"\w* \w campo|strong="H7704"\w* fueron \w a|strong="H3068"\w* Mizpa para ver \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w*,  
\v 14 \w y|strong="H3588"\w* le advirtieron: “¿Usted \w sabe|strong="H3045"\w* \w que|strong="H3588"\w* Baalis, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* amonitas, \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Netanías \w para|strong="H3588"\w* matarlo?”.  
\p \w Pero|strong="H3588"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ahicam \w no|strong="H3808"\w* les creyó.  
\v 15 Entonces \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* habló \w en|strong="H3212"\w* secreto con \w Gedalías|strong="H1436"\w* \w en|strong="H3212"\w* \w Mizpa|strong="H4709"\w*: “Déjeme \w ir|strong="H3212"\w* \w a|strong="H3068"\w* matar \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías, y \w nadie|strong="H3808"\w* \w se|strong="H3045"\w* enterará. ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* dejar \w que|strong="H4100"\w* \w él|strong="H3605"\w* \w lo|strong="H4100"\w* mate y \w que|strong="H4100"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* judíos \w que|strong="H4100"\w* \w se|strong="H3045"\w* han unido \w a|strong="H3068"\w* usted vuelvan \w a|strong="H3068"\w* dispersarse, y \w que|strong="H4100"\w* \w el|strong="H3605"\w* \w resto|strong="H7611"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* perezca?”.   
\p
\v 16 \w Pero|strong="H3588"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ahicam le respondió \w a|strong="H3068"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Carea|strong="H7143"\w*: “\w No|strong="H6213"\w* \w hagas|strong="H6213"\w* eso, \w porque|strong="H3588"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w dices|strong="H1696"\w* \w acerca|strong="H1696"\w* \w de|strong="H3588"\w* \w Ismael|strong="H3458"\w* \w es|strong="H2088"\w* \w mentira|strong="H8267"\w*”.   
\c 41  
\p
\v 1 En \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Elisama, \w que|strong="H1121"\w* \w era|strong="H1961"\w* \w de|strong="H1121"\w* la familia \w real|strong="H4428"\w* y uno \w de|strong="H1121"\w* \w los|strong="H1121"\w* oficiales \w más|strong="H7227"\w* altos del \w rey|strong="H4428"\w*, \w fue|strong="H1961"\w* \w a|strong="H3068"\w* \w Mizpa|strong="H4709"\w* con \w diez|strong="H6235"\w* \w hombres|strong="H1121"\w* \w para|strong="H1961"\w* visitar \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam. Mientras comían \w juntos|strong="H3162"\w* \w allí|strong="H8033"\w* en \w Mizpa|strong="H4709"\w*,  
\v 2 \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías y sus \w diez|strong="H6235"\w* \w hombres|strong="H1121"\w* \w se|strong="H1961"\w* \w levantaron|strong="H6965"\w* y atacaron \w a|strong="H3068"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán. Así \w mataron|strong="H5221"\w* \w al|strong="H4428"\w* \w hombre|strong="H1121"\w* \w que|strong="H1121"\w* \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia \w había|strong="H1961"\w* nombrado gobernador del país.  
\v 3 \w Ismael|strong="H3458"\w* también \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w judíos|strong="H3064"\w* \w que|strong="H1961"\w* \w estaban|strong="H1961"\w* con \w Gedalías|strong="H1436"\w* \w en|strong="H5221"\w* \w Mizpa|strong="H4709"\w*, y \w a|strong="H3068"\w* \w los|strong="H3605"\w* soldados \w caldeos|strong="H3778"\w* \w que|strong="H1961"\w* \w se|strong="H1961"\w* encontraban \w allí|strong="H8033"\w*.   
\p
\v 4 Al \w día|strong="H3117"\w* \w siguiente|strong="H8145"\w* del asesinato de \w Gedalías|strong="H1436"\w*, \w cuando|strong="H3117"\w* todavía \w nadie|strong="H3808"\w* \w sabía|strong="H3045"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w había|strong="H1961"\w* pasado,  
\v 5 llegaron \w ochenta|strong="H8084"\w* hombres de Siquem, de \w Silo|strong="H7887"\w* y de \w Samaria|strong="H8111"\w*. Venían con la \w barba|strong="H2206"\w* rasurada, la ropa rasgada y el cuerpo con heridas \w que|strong="H7927"\w* \w ellos|strong="H3027"\w* mismos se habían hecho; traían ofrendas de grano \w e|strong="H3068"\w* \w incienso|strong="H3828"\w* para presentarlos en el \w templo|strong="H1004"\w* de Yahvé.  
\v 6 \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Netanías \w salió|strong="H3318"\w* \w de|strong="H4480"\w* \w Mizpa|strong="H4709"\w* \w a|strong="H3068"\w* recibirlos, \w llorando|strong="H1058"\w* \w por|strong="H4480"\w* \w el|strong="H1121"\w* \w camino|strong="H1980"\w*. \w Cuando|strong="H1961"\w* \w se|strong="H1961"\w* encontró \w con|strong="H4480"\w* \w ellos|strong="H4480"\w*, les dijo: “Vengan \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Ahicam”.  
\v 7 Pero \w en|strong="H8432"\w* cuanto entraron al centro \w de|strong="H1121"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*, \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías y \w sus|strong="H1931"\w* \w hombres|strong="H1121"\w* \w los|strong="H1121"\w* \w mataron|strong="H7819"\w* y arrojaron \w sus|strong="H1931"\w* cuerpos \w a|strong="H3068"\w* una cisterna.  
\v 8 \w Sin|strong="H3808"\w* embargo, \w diez|strong="H6235"\w* \w de|strong="H3588"\w* esos hombres le dijeron \w a|strong="H3068"\w* \w Ismael|strong="H3458"\w*: “¡\w No|strong="H3808"\w* nos \w mates|strong="H4191"\w*! \w Tenemos|strong="H3426"\w* escondidos \w en|strong="H8432"\w* \w el|strong="H3588"\w* \w campo|strong="H7704"\w* depósitos \w de|strong="H3588"\w* \w trigo|strong="H2406"\w*, \w cebada|strong="H8184"\w*, \w aceite|strong="H8081"\w* \w y|strong="H3588"\w* \w miel|strong="H1706"\w*”.  
\p Ante esto, \w Ismael|strong="H3458"\w* \w se|strong="H3808"\w* detuvo \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H3588"\w* \w mató|strong="H4191"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* otros.  
\v 9 \w La|strong="H1931"\w* cisterna \w donde|strong="H8033"\w* \w Ismael|strong="H3458"\w* arrojó \w todos|strong="H3605"\w* \w los|strong="H1121"\w* cadáveres \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w que|strong="H1931"\w* \w había|strong="H6213"\w* matado \w junto|strong="H3027"\w* con \w Gedalías|strong="H1436"\w*, \w era|strong="H1931"\w* \w la|strong="H1931"\w* \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Asa \w había|strong="H6213"\w* construido para defenderse \w de|strong="H6440"\w* \w Baasa|strong="H1201"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Netanías \w la|strong="H1931"\w* \w llenó|strong="H4390"\w* \w de|strong="H6440"\w* \w muertos|strong="H2491"\w*.   
\p
\v 10 \w Luego|strong="H5674"\w* \w Ismael|strong="H3458"\w* tomó \w cautivo|strong="H7617"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w resto|strong="H7611"\w* del \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* estaba \w en|strong="H3212"\w* \w Mizpa|strong="H4709"\w*, incluyendo \w a|strong="H3068"\w* las \w hijas|strong="H1323"\w* del \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w capitán|strong="H7227"\w* \w Nabuzaradán|strong="H5018"\w* había dejado bajo \w el|strong="H3605"\w* cuidado \w de|strong="H1121"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam. \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías \w se|strong="H5971"\w* \w los|strong="H1121"\w* llevó cautivos y \w se|strong="H5971"\w* \w puso|strong="H6485"\w* \w en|strong="H3212"\w* marcha hacia \w el|strong="H3605"\w* territorio \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas.   
\p
\v 11 Pero cuando \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares \w que|strong="H1121"\w* \w lo|strong="H6213"\w* acompañaban se enteraron \w de|strong="H1121"\w* \w todas|strong="H3605"\w* las atrocidades \w que|strong="H1121"\w* \w había|strong="H6213"\w* cometido \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías,  
\v 12 reunieron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w hombres|strong="H1121"\w* y \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5973"\w* \w él|strong="H5973"\w*. \w Lo|strong="H3605"\w* alcanzaron \w junto|strong="H5973"\w* al \w gran|strong="H7227"\w* estanque \w que|strong="H4325"\w* hay \w en|strong="H5973"\w* \w Gabaón|strong="H1391"\w*.  
\v 13 \w Cuando|strong="H1961"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w que|strong="H5971"\w* \w Ismael|strong="H3458"\w* \w llevaba|strong="H1961"\w* cautiva \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares, \w se|strong="H1961"\w* alegraron mucho.  
\v 14 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w que|strong="H4480"\w* \w Ismael|strong="H3458"\w* \w se|strong="H4480"\w* había llevado \w de|strong="H4480"\w* \w Mizpa|strong="H4709"\w* \w se|strong="H4480"\w* \w dio|strong="H7725"\w* \w la|strong="H3605"\w* \w vuelta|strong="H5437"\w* y \w se|strong="H4480"\w* unió \w a|strong="H3068"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Carea|strong="H7143"\w*.  
\v 15 Pero \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Netanías logró \w escapar|strong="H4422"\w* \w de|strong="H6440"\w* \w Johanán|strong="H3110"\w* con \w ocho|strong="H8083"\w* \w hombres|strong="H1121"\w* y huyó \w hacia|strong="H6440"\w* \w el|strong="H1121"\w* país \w de|strong="H6440"\w* \w los|strong="H1121"\w* amonitas.   
\p
\v 16 \w Entonces|strong="H7725"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Carea|strong="H7143"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares \w que|strong="H4480"\w* \w estaban|strong="H5971"\w* \w con|strong="H4480"\w* \w él|strong="H3605"\w* \w se|strong="H4480"\w* \w hicieron|strong="H5221"\w* cargo \w de|strong="H4480"\w* \w los|strong="H1121"\w* sobrevivientes \w que|strong="H4480"\w* habían rescatado \w de|strong="H4480"\w* \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Netanías \w en|strong="H4480"\w* \w Mizpa|strong="H4709"\w*, después \w de|strong="H4480"\w* \w que|strong="H4480"\w* este \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Ahicam. Había soldados, mujeres, \w niños|strong="H2945"\w* y oficiales \w de|strong="H4480"\w* \w la|strong="H3605"\w* corte \w que|strong="H4480"\w* \w Johanán|strong="H3110"\w* trajo \w de|strong="H4480"\w* regreso \w desde|strong="H4480"\w* \w Gabaón|strong="H1391"\w*.  
\v 17 Todos ellos se pusieron \w en|strong="H3212"\w* marcha y se detuvieron \w en|strong="H3212"\w* Gerut Quimam, cerca de Belén, con la intención de seguir hacia \w Egipto|strong="H4714"\w*.  
\v 18 Querían huir \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w caldeos|strong="H3778"\w* \w porque|strong="H3588"\w* les tenían \w miedo|strong="H3372"\w*, ya \w que|strong="H3588"\w* \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Netanías \w había|strong="H3588"\w* asesinado \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ahicam, \w a|strong="H3068"\w* quien \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia \w había|strong="H3588"\w* nombrado gobernador del país.   
\c 42  
\p
\v 1 Entonces \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares, \w junto|strong="H5971"\w* \w con|strong="H5704"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Carea|strong="H7143"\w*, Jezanías \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Oseas \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w grande|strong="H1419"\w*, \w se|strong="H5971"\w* acercaron  
\v 2 \w y|strong="H3588"\w* \w le|strong="H5869"\w* dijeron \w al|strong="H5704"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w*: “\w Le|strong="H5869"\w* rogamos \w que|strong="H3588"\w* acepte nuestra \w súplica|strong="H8467"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w ore|strong="H6419"\w* \w por|strong="H3588"\w* \w nosotros|strong="H3605"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*; ruegue \w por|strong="H3588"\w* \w todo|strong="H3605"\w* \w este|strong="H2063"\w* \w resto|strong="H7611"\w* \w de|strong="H3588"\w* nuestro pueblo. \w Como|strong="H3588"\w* usted puede \w ver|strong="H7200"\w*, \w antes|strong="H6440"\w* éramos \w muchos|strong="H7235"\w*, \w pero|strong="H3588"\w* \w ahora|strong="H4994"\w* quedamos solo unos \w cuantos|strong="H3605"\w*.  
\v 3 \w Que|strong="H1697"\w* Yahvé su \w Dios|strong="H3068"\w* nos muestre \w el|strong="H6213"\w* \w camino|strong="H1870"\w* \w por|strong="H1870"\w* donde debemos \w ir|strong="H3212"\w* y \w lo|strong="H1697"\w* \w que|strong="H1697"\w* debemos \w hacer|strong="H6213"\w*”.   
\p
\v 4 \w El|strong="H3605"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* les \w respondió|strong="H6030"\w*: “\w Ya|strong="H3068"\w* \w los|strong="H3605"\w* \w escuché|strong="H8085"\w*. Voy \w a|strong="H3068"\w* orar \w a|strong="H3068"\w* Yahvé \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* ustedes, \w tal|strong="H1697"\w* \w como|strong="H1961"\w* \w me|strong="H4480"\w* \w lo|strong="H1697"\w* han pedido. \w Todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H4480"\w* Yahvé les \w responda|strong="H6030"\w* \w se|strong="H1961"\w* \w lo|strong="H1697"\w* haré \w saber|strong="H5046"\w*; \w no|strong="H3808"\w* les ocultaré \w nada|strong="H3808"\w*”.   
\p
\v 5 \w Ellos|strong="H1992"\w* le \w dijeron|strong="H1697"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*: “\w Que|strong="H3808"\w* Yahvé \w sea|strong="H1961"\w* un \w testigo|strong="H5707"\w* fiel y verdadero \w contra|strong="H1961"\w* \w nosotros|strong="H3605"\w*, \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w hacemos|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* Yahvé \w su|strong="H1992"\w* \w Dios|strong="H3068"\w* le mande decirnos.  
\v 6 Sea \w bueno|strong="H2896"\w* \w o|strong="H3068"\w* sea \w malo|strong="H7451"\w*, \w obedeceremos|strong="H8085"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, \w a|strong="H3068"\w* quien lo \w enviamos|strong="H7971"\w* \w a|strong="H3068"\w* consultar. \w Así|strong="H3588"\w*, al \w obedecer|strong="H8085"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, nos irá \w bien|strong="H2896"\w*”.   
\p
\v 7 \w Diez|strong="H6235"\w* \w días|strong="H3117"\w* \w después|strong="H1961"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*.  
\v 8 Entonces \w él|strong="H3605"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Carea|strong="H7143"\w*, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares \w que|strong="H5704"\w* \w estaban|strong="H5971"\w* \w con|strong="H5704"\w* \w él|strong="H3605"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w grande|strong="H1419"\w*,  
\v 9 \w y|strong="H3541"\w* les dijo: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* quien ustedes \w me|strong="H3541"\w* \w enviaron|strong="H7971"\w* para presentar su \w súplica|strong="H8467"\w*:  
\v 10 ‘\w Si|strong="H3588"\w* \w se|strong="H3808"\w* quedan \w en|strong="H3588"\w* \w esta|strong="H2063"\w* tierra, \w yo|strong="H3588"\w* \w los|strong="H3427"\w* \w edificaré|strong="H1129"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H3427"\w* \w destruiré|strong="H2040"\w*; \w los|strong="H3427"\w* \w plantaré|strong="H5193"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H3427"\w* \w arrancaré|strong="H5428"\w*, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* duele \w el|strong="H3588"\w* \w castigo|strong="H7451"\w* \w que|strong="H3588"\w* les he enviado.  
\v 11 \w No|strong="H3588"\w* le tengan \w miedo|strong="H3372"\w* \w al|strong="H4480"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia — \w dice|strong="H5002"\w* Yahvé —; \w no|strong="H3588"\w* le \w teman|strong="H3372"\w*, \w porque|strong="H3588"\w* \w yo|strong="H4480"\w* estoy \w con|strong="H4480"\w* ustedes \w para|strong="H3588"\w* salvarlos \w y|strong="H3588"\w* librarlos \w de|strong="H4480"\w* \w su|strong="H3588"\w* \w poder|strong="H3027"\w*.  
\v 12 Tendré compasión \w de|strong="H5414"\w* ustedes, y \w haré|strong="H5414"\w* que él también les tenga compasión y los deje \w volver|strong="H7725"\w* \w a|strong="H3068"\w* su propia tierra’.   
\p
\v 13 ‘Pero \w si|strong="H3808"\w* ustedes dicen: “\w No|strong="H3808"\w* nos quedaremos en \w esta|strong="H2063"\w* tierra”, desobedeciendo \w así|strong="H2063"\w* \w la|strong="H2063"\w* \w voz|strong="H6963"\w* de Yahvé su \w Dios|strong="H3068"\w*,  
\v 14 \w y|strong="H3588"\w* dicen: “\w No|strong="H3808"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* nos iremos \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, \w donde|strong="H8033"\w* \w no|strong="H3808"\w* \w veremos|strong="H7200"\w* \w guerra|strong="H4421"\w* \w ni|strong="H3808"\w* \w oiremos|strong="H8085"\w* \w sonido|strong="H6963"\w* \w de|strong="H3588"\w* \w trompeta|strong="H7782"\w*, \w ni|strong="H3808"\w* pasaremos \w hambre|strong="H7456"\w*, \w y|strong="H3588"\w* \w allí|strong="H8033"\w* viviremos”;  
\v 15 \w entonces|strong="H3651"\w*, \w escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H6440"\w* Yahvé, \w resto|strong="H7611"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*. \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé \w de|strong="H6440"\w* los \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*: “\w Si|strong="H6440"\w* ustedes están decididos \w a|strong="H3068"\w* irse \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w para|strong="H6258"\w* vivir \w allá|strong="H8033"\w*,  
\v 16 la \w espada|strong="H2719"\w* \w que|strong="H4480"\w* tanto \w temen|strong="H3372"\w* \w los|strong="H1961"\w* \w alcanzará|strong="H5381"\w* \w en|strong="H4480"\w* \w Egipto|strong="H4714"\w*, y el \w hambre|strong="H7458"\w* \w que|strong="H4480"\w* tanto les asusta \w los|strong="H1961"\w* perseguirá hasta \w allá|strong="H8033"\w*; y \w en|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w morirán|strong="H4191"\w*.  
\v 17 \w Todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w estén|strong="H1961"\w* decididos \w a|strong="H3068"\w* irse \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w morirán|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, \w el|strong="H5921"\w* \w hambre|strong="H7458"\w* \w o|strong="H3068"\w* \w la|strong="H5921"\w* peste. \w Ninguno|strong="H3808"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* sobrevivirá \w ni|strong="H3808"\w* \w escapará|strong="H3808"\w* \w al|strong="H5921"\w* desastre \w que|strong="H3808"\w* enviaré \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*” ’.  
\v 18 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘\w Así|strong="H3541"\w* \w como|strong="H3588"\w* \w mi|strong="H5921"\w* \w ira|strong="H2534"\w* \w y|strong="H3588"\w* \w mi|strong="H5921"\w* \w furor|strong="H2534"\w* \w se|strong="H1961"\w* derramaron \w sobre|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén, \w así|strong="H3541"\w* \w se|strong="H1961"\w* derramará \w mi|strong="H5921"\w* fuego \w sobre|strong="H5921"\w* ustedes \w si|strong="H3588"\w* entran \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*. \w Serán|strong="H1961"\w* objeto \w de|strong="H5921"\w* burla, \w de|strong="H5921"\w* horror, \w de|strong="H5921"\w* \w maldición|strong="H7045"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* vergüenza; \w y|strong="H3588"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* volverán \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*’.   
\p
\v 19 “Yahvé \w les|strong="H5921"\w* \w dice|strong="H1696"\w* \w a|strong="H3068"\w* ustedes, \w resto|strong="H7611"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*: ‘\w No|strong="H3588"\w* \w se|strong="H3045"\w* vayan \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*’. \w Sepan|strong="H3045"\w* \w con|strong="H5921"\w* seguridad \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* \w se|strong="H3045"\w* \w lo|strong="H5921"\w* he advertido.  
\v 20 Ustedes \w se|strong="H3651"\w* \w engañan|strong="H8582"\w* \w a|strong="H3068"\w* \w sí|strong="H3588"\w* mismos, \w pues|strong="H3588"\w* \w me|strong="H3588"\w* \w enviaron|strong="H7971"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* diciendo: ‘\w Ora|strong="H6419"\w* \w por|strong="H3588"\w* \w nosotros|strong="H3605"\w* \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, \w y|strong="H3588"\w* dinos \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w te|strong="H3588"\w* mande, \w y|strong="H3588"\w* \w nosotros|strong="H3605"\w* \w lo|strong="H6213"\w* \w haremos|strong="H6213"\w*’.  
\v 21 \w Hoy|strong="H3117"\w* \w se|strong="H3808"\w* \w lo|strong="H3808"\w* he comunicado, pero ustedes \w no|strong="H3808"\w* han querido \w obedecer|strong="H8085"\w* \w la|strong="H3605"\w* \w voz|strong="H6963"\w* de Yahvé su \w Dios|strong="H3068"\w* en \w nada|strong="H3808"\w* de \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w él|strong="H3605"\w* me \w mandó|strong="H7971"\w* decirles.  
\v 22 \w Por|strong="H3588"\w* lo tanto, \w sepan|strong="H3045"\w* \w ahora|strong="H6258"\w* \w con|strong="H3588"\w* toda seguridad \w que|strong="H3588"\w* \w morirán|strong="H4191"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*, \w el|strong="H3588"\w* \w hambre|strong="H7458"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* peste \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* quieren ir \w a|strong="H3068"\w* vivir”.   
\c 43  
\p
\v 1 \w Cuando|strong="H1961"\w* \w Jeremías|strong="H3414"\w* terminó \w de|strong="H5971"\w* decirle \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé su \w Dios|strong="H3068"\w*, \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé le \w había|strong="H1961"\w* encargado decirles,  
\v 2 \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Oseas, \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* y \w todos|strong="H3605"\w* esos \w hombres|strong="H1121"\w* arrogantes le \w dijeron|strong="H1696"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*: “¡Es \w mentira|strong="H8267"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w dices|strong="H1696"\w*! Yahvé nuestro \w Dios|strong="H3068"\w* \w no|strong="H3808"\w* te \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decirnos: ‘\w No|strong="H3808"\w* \w se|strong="H3808"\w* vayan \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* vivir \w allá|strong="H8033"\w*’.  
\v 3 Lo \w que|strong="H3588"\w* pasa \w es|strong="H3027"\w* \w que|strong="H3588"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Nerías \w te|strong="H3588"\w* está \w poniendo|strong="H5414"\w* \w en|strong="H3588"\w* contra nuestra, \w para|strong="H4616"\w* entregarnos \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w caldeos|strong="H3778"\w*, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w ellos|strong="H3027"\w* nos maten \w o|strong="H3068"\w* nos lleven desterrados \w a|strong="H3068"\w* Babilonia”.   
\p
\v 4 Así \w que|strong="H3808"\w* \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w*, \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w jefes|strong="H8269"\w* militares y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* desobedecieron \w la|strong="H3605"\w* \w voz|strong="H6963"\w* \w de|strong="H1121"\w* Yahvé, \w que|strong="H3808"\w* les ordenaba quedarse en \w la|strong="H3605"\w* tierra \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 5 Al contrario, \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Carea|strong="H7143"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* militares se \w llevaron|strong="H3947"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w resto|strong="H7611"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* \w que|strong="H1121"\w* había regresado \w de|strong="H1121"\w* las \w naciones|strong="H1471"\w* adonde habían sido expulsados para vivir en \w Judá|strong="H3063"\w*:  
\v 6 se llevaron \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w*, \w a|strong="H3068"\w* las \w mujeres|strong="H1323"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w niños|strong="H2945"\w*, \w a|strong="H3068"\w* las \w hijas|strong="H1323"\w* del \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w personas|strong="H5315"\w* \w que|strong="H1121"\w* \w Nabuzaradán|strong="H5018"\w*, \w capitán|strong="H7227"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* guardia, había dejado \w al|strong="H4428"\w* cuidado \w de|strong="H1121"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahicam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán. También se llevaron \w por|strong="H4428"\w* \w la|strong="H3605"\w* fuerza \w al|strong="H4428"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* y \w a|strong="H3068"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Nerías.  
\v 7 Entraron \w en|strong="H5704"\w* \w Egipto|strong="H4714"\w*, \w pues|strong="H3588"\w* \w no|strong="H3808"\w* quisieron \w obedecer|strong="H8085"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* llegaron \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* ciudad \w de|strong="H3588"\w* Tafnes.   
\p
\v 8 Allí en Tafnes, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 9 “\w Toma|strong="H3947"\w* unas piedras \w grandes|strong="H1419"\w* y húndelas, \w a|strong="H3068"\w* la vista \w de|strong="H5869"\w* los hombres \w de|strong="H5869"\w* Judá, en la mezcla del pavimento \w de|strong="H5869"\w* ladrillo \w que|strong="H3027"\w* está \w a|strong="H3068"\w* la entrada del palacio del \w faraón|strong="H6547"\w* en Tafnes.  
\v 10 Luego diles: ‘\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: Miren, yo voy \w a|strong="H3068"\w* mandar \w a|strong="H3068"\w* llamar \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia. \w Pondré|strong="H7760"\w* su \w trono|strong="H3678"\w* \w sobre|strong="H5921"\w* estas piedras \w que|strong="H5921"\w* he escondido, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w extenderá|strong="H7971"\w* su toldo \w real|strong="H4428"\w* \w sobre|strong="H5921"\w* \w ellas|strong="H5921"\w*.  
\v 11 Él vendrá y atacará la tierra de \w Egipto|strong="H4714"\w*: los que estén destinados \w a|strong="H3068"\w* la \w muerte|strong="H4194"\w*, morirán; los que estén destinados al \w cautiverio|strong="H7628"\w*, irán \w cautivos|strong="H7628"\w*; y los que estén destinados \w a|strong="H3068"\w* la \w espada|strong="H2719"\w*, morirán \w a|strong="H3068"\w* \w espada|strong="H2719"\w*.  
\v 12 Le prenderá fuego \w a|strong="H3068"\w* los templos de los dioses de \w Egipto|strong="H4714"\w*; los \w quemará|strong="H8313"\w* y se llevará \w a|strong="H3068"\w* sus ídolos. Limpiará la tierra de \w Egipto|strong="H4714"\w* como un \w pastor|strong="H7462"\w* limpia su ropa de piojos, y se \w irá|strong="H3318"\w* de \w aquí|strong="H8033"\w* \w en|strong="H3318"\w* \w paz|strong="H7965"\w*.  
\v 13 Hará pedazos las \w columnas|strong="H4676"\w* de Bet-semes, en la tierra de \w Egipto|strong="H4714"\w*, y prenderá fuego \w a|strong="H3068"\w* los templos de los dioses \w egipcios|strong="H4714"\w*’”.   
\c 44  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w que|strong="H1697"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w* \w para|strong="H1961"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w judíos|strong="H3064"\w* \w que|strong="H1697"\w* \w vivían|strong="H3427"\w* en \w Egipto|strong="H4714"\w*, \w es|strong="H1961"\w* decir, \w los|strong="H3427"\w* \w que|strong="H1697"\w* \w habitaban|strong="H3427"\w* en \w Migdol|strong="H4024"\w*, Tafnes, Menfis y en \w la|strong="H3605"\w* región \w de|strong="H1697"\w* Patros:  
\v 2 “\w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘Ustedes han \w visto|strong="H7200"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* desastre \w que|strong="H5921"\w* traje \w sobre|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. Miren \w cómo|strong="H5921"\w* \w están|strong="H3427"\w* \w hoy|strong="H3117"\w*: son una ruina \w y|strong="H5921"\w* \w nadie|strong="H3605"\w* vive \w en|strong="H5921"\w* \w ellas|strong="H5921"\w*.  
\v 3 \w Esto|strong="H6213"\w* sucedió \w por|strong="H6440"\w* la \w maldad|strong="H7451"\w* \w que|strong="H3808"\w* \w ellos|strong="H1992"\w* \w cometieron|strong="H6213"\w* para provocar mi enojo, pues \w se|strong="H3045"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* quemar incienso y \w a|strong="H3068"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* dioses extraños \w que|strong="H3808"\w* \w ni|strong="H3808"\w* \w ellos|strong="H1992"\w*, \w ni|strong="H3808"\w* ustedes, \w ni|strong="H3808"\w* \w sus|strong="H1992"\w* antepasados \w conocían|strong="H3045"\w*.  
\v 4 Una y \w otra|strong="H6213"\w* vez les \w envié|strong="H7971"\w* \w a|strong="H3068"\w* mis \w siervos|strong="H5650"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w* para decirles: “\w No|strong="H6213"\w* \w hagan|strong="H6213"\w* esa \w cosa|strong="H1697"\w* tan despreciable \w que|strong="H4994"\w* \w yo|strong="H4994"\w* \w aborrezco|strong="H8130"\w*”.  
\v 5 Pero ellos \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* prestaron atención; \w no|strong="H3808"\w* \w se|strong="H3808"\w* arrepintieron \w de|strong="H7451"\w* su \w maldad|strong="H7451"\w* \w ni|strong="H3808"\w* dejaron \w de|strong="H7451"\w* quemar incienso \w a|strong="H3068"\w* otros dioses.  
\v 6 \w Por|strong="H2088"\w* eso \w se|strong="H1961"\w* derramó \w mi|strong="H3389"\w* \w ira|strong="H2534"\w* \w y|strong="H1197"\w* \w mi|strong="H3389"\w* \w furor|strong="H2534"\w*, \w y|strong="H1197"\w* ardió en las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w* \w y|strong="H1197"\w* en las \w calles|strong="H2351"\w* de Jerusalén, las cuales \w quedaron|strong="H1961"\w* convertidas en un desierto desolado, \w tal|strong="H2088"\w* \w como|strong="H1961"\w* \w están|strong="H1961"\w* \w hoy|strong="H3117"\w*’.   
\p
\v 7 “\w Por|strong="H4100"\w* eso, \w ahora|strong="H6258"\w* \w así|strong="H3541"\w* dice Yahvé \w de|strong="H7451"\w* los \w Ejércitos|strong="H6635"\w*, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* \w de|strong="H7451"\w* \w Israel|strong="H3478"\w*: ‘¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w se|strong="H4100"\w* \w hacen|strong="H6213"\w* ustedes mismos un daño tan \w grande|strong="H1419"\w*? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* quieren \w que|strong="H4100"\w* hombres \w y|strong="H3541"\w* mujeres, \w niños|strong="H5768"\w* \w y|strong="H3541"\w* recién nacidos \w de|strong="H7451"\w* \w Judá|strong="H3063"\w* sean eliminados, hasta \w que|strong="H4100"\w* \w no|strong="H6213"\w* quede nadie \w de|strong="H7451"\w* ustedes?  
\v 8 Me provocan \w a|strong="H3068"\w* ira con \w lo|strong="H3605"\w* \w que|strong="H1961"\w* hacen sus \w manos|strong="H3027"\w*, quemando incienso \w a|strong="H3068"\w* dioses extraños \w aquí|strong="H8033"\w* en \w Egipto|strong="H4714"\w*, \w donde|strong="H8033"\w* han venido \w a|strong="H3068"\w* vivir. Así solo logran ser eliminados y convertirse en objeto de \w maldición|strong="H7045"\w* y de burla \w entre|strong="H8033"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* de \w la|strong="H3605"\w* tierra.  
\v 9 ¿Acaso ya \w olvidaron|strong="H7911"\w* las \w maldades|strong="H7451"\w* \w de|strong="H7911"\w* sus antepasados, las \w de|strong="H7911"\w* los \w reyes|strong="H4428"\w* \w de|strong="H7911"\w* \w Judá|strong="H3063"\w* y sus esposas, y las que \w cometieron|strong="H6213"\w* ustedes mismos y sus propias mujeres en la tierra \w de|strong="H7911"\w* \w Judá|strong="H3063"\w* y en las \w calles|strong="H2351"\w* \w de|strong="H7911"\w* Jerusalén?  
\v 10 \w Hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H6440"\w* \w hoy|strong="H3117"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* han humillado \w ni|strong="H3808"\w* han sentido \w temor|strong="H3372"\w*; \w no|strong="H3808"\w* han seguido mi \w ley|strong="H8451"\w* \w ni|strong="H3808"\w* los mandamientos \w que|strong="H3808"\w* \w puse|strong="H5414"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes \w y|strong="H5704"\w* \w de|strong="H6440"\w* sus antepasados’.   
\p
\v 11 “\w Por|strong="H6440"\w* \w lo|strong="H3605"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w de|strong="H6440"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*: ‘He decidido ponerme en \w contra|strong="H6440"\w* \w de|strong="H6440"\w* ustedes para \w mal|strong="H7451"\w* \w y|strong="H3541"\w* para destruir \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w*.  
\v 12 Me llevaré \w al|strong="H5704"\w* \w resto|strong="H7611"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* \w que|strong="H5704"\w* \w se|strong="H1961"\w* empeñó \w en|strong="H5704"\w* venir \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5704"\w* \w aquí|strong="H8033"\w* \w en|strong="H5704"\w* \w Egipto|strong="H4714"\w* \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* \w morirán|strong="H4191"\w*. \w Caerán|strong="H5307"\w* \w por|strong="H6440"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w* \w o|strong="H3068"\w* \w morirán|strong="H4191"\w* \w de|strong="H6440"\w* \w hambre|strong="H7458"\w*; \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H4191"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H4191"\w* \w grande|strong="H1419"\w* \w morirán|strong="H4191"\w* \w por|strong="H6440"\w* \w la|strong="H3605"\w* guerra \w o|strong="H3068"\w* \w el|strong="H3605"\w* \w hambre|strong="H7458"\w*. \w Se|strong="H1961"\w* convertirán \w en|strong="H5704"\w* objeto \w de|strong="H6440"\w* horror, \w de|strong="H6440"\w* \w espanto|strong="H8047"\w*, \w de|strong="H6440"\w* \w maldición|strong="H7045"\w* \w y|strong="H5704"\w* \w de|strong="H6440"\w* insulto.  
\v 13 Castigaré \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* viven \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w como|strong="H5921"\w* castigué \w a|strong="H3068"\w* Jerusalén: \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, \w el|strong="H5921"\w* \w hambre|strong="H7458"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* peste.  
\v 14 \w De|strong="H3588"\w* \w los|strong="H1992"\w* sobrevivientes \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w que|strong="H3588"\w* vinieron \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, \w ninguno|strong="H3808"\w* \w escapará|strong="H3808"\w* \w ni|strong="H3808"\w* \w quedará|strong="H1961"\w* \w con|strong="H3588"\w* \w vida|strong="H5315"\w* \w para|strong="H3588"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*. \w Aunque|strong="H3588"\w* desean \w con|strong="H3588"\w* toda \w el|strong="H3588"\w* \w alma|strong="H5315"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* vivir \w allá|strong="H8033"\w*, \w no|strong="H3808"\w* regresarán, excepto \w algunos|strong="H7611"\w* cuantos refugiados’”.   
\p
\v 15 \w Entonces|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w que|strong="H3588"\w* \w sabían|strong="H3045"\w* \w que|strong="H3588"\w* sus mujeres quemaban incienso \w a|strong="H3068"\w* otros dioses, \w junto|strong="H5971"\w* \w con|strong="H3588"\w* \w todas|strong="H3605"\w* las mujeres \w que|strong="H3588"\w* \w estaban|strong="H5975"\w* allí \w presentes|strong="H5975"\w* — una \w gran|strong="H1419"\w* \w multitud|strong="H6951"\w* — \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w vivía|strong="H3427"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* sur \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w en|strong="H3588"\w* Patros, le \w respondieron|strong="H6030"\w* \w a|strong="H3068"\w* \w Jeremías|strong="H3414"\w*:  
\v 16 “No vamos \w a|strong="H3068"\w* hacerle caso \w a|strong="H3068"\w* ese mensaje \w que|strong="H1697"\w* nos has dado en el \w nombre|strong="H8034"\w* \w de|strong="H1697"\w* Yahvé.  
\v 17 \w Al|strong="H4428"\w* contrario, \w cumpliremos|strong="H6213"\w* \w sin|strong="H3808"\w* falta \w todas|strong="H3605"\w* las promesas \w que|strong="H3588"\w* hemos \w hecho|strong="H6213"\w*: quemaremos incienso \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w Reina|strong="H4428"\w* del \w Cielo|strong="H8064"\w* \w y|strong="H3588"\w* le presentaremos \w ofrendas|strong="H5258"\w* líquidas, \w tal|strong="H1697"\w* \w como|strong="H3588"\w* \w lo|strong="H1697"\w* \w hicimos|strong="H6213"\w* \w nosotros|strong="H3605"\w*, nuestros antepasados, nuestros \w reyes|strong="H4428"\w* \w y|strong="H3588"\w* nuestros \w jefes|strong="H8269"\w* \w en|strong="H3588"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* las \w calles|strong="H2351"\w* \w de|strong="H3588"\w* Jerusalén. \w En|strong="H3588"\w* \w aquel|strong="H3605"\w* tiempo teníamos \w comida|strong="H3899"\w* \w de|strong="H3588"\w* sobra, nos iba muy \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* sufríamos \w ninguna|strong="H3605"\w* desgracia.  
\v 18 Pero \w desde|strong="H4480"\w* \w que|strong="H4480"\w* dejamos \w de|strong="H4480"\w* quemar incienso \w a|strong="H3068"\w* \w la|strong="H3605"\w* Reina \w del|strong="H4480"\w* \w Cielo|strong="H8064"\w* y \w de|strong="H4480"\w* ofrecerle \w libaciones|strong="H5262"\w*, \w nos|strong="H4480"\w* ha faltado \w todo|strong="H3605"\w* y \w la|strong="H3605"\w* guerra y \w el|strong="H3605"\w* \w hambre|strong="H7458"\w* \w nos|strong="H4480"\w* están destruyendo”.   
\p
\v 19 \w Y|strong="H3068"\w* las mujeres añadieron: “\w Cuando|strong="H3588"\w* nosotras quemamos incienso \w a|strong="H3068"\w* \w la|strong="H3588"\w* Reina del \w Cielo|strong="H8064"\w* \w y|strong="H3588"\w* le presentamos \w ofrendas|strong="H5258"\w* líquidas, ¿acaso creen \w que|strong="H3588"\w* \w hicimos|strong="H6213"\w* las \w tortas|strong="H3561"\w* \w con|strong="H3588"\w* \w su|strong="H3588"\w* imagen \w y|strong="H3588"\w* le ofrecimos \w libaciones|strong="H5262"\w* \w sin|strong="H1107"\w* \w que|strong="H3588"\w* nuestros esposos \w lo|strong="H6213"\w* supieran?”.   
\p
\v 20 Entonces \w Jeremías|strong="H3414"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w tanto|strong="H5921"\w* \w a|strong="H3068"\w* \w hombres|strong="H1397"\w* \w como|strong="H5921"\w* \w a|strong="H3068"\w* mujeres \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* habían respondido:  
\v 21 “¿Creen \w que|strong="H3808"\w* Yahvé \w no|strong="H3808"\w* \w se|strong="H5921"\w* acordaba \w del|strong="H5921"\w* incienso \w que|strong="H3808"\w* ustedes, sus antepasados, sus \w reyes|strong="H4428"\w*, sus \w jefes|strong="H8269"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w* quemaban \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w calles|strong="H2351"\w* \w de|strong="H5921"\w* Jerusalén? ¿Creen \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w le|strong="H5921"\w* pasaba \w por|strong="H5921"\w* \w la|strong="H5921"\w* mente?  
\v 22 Yahvé \w ya|strong="H2088"\w* \w no|strong="H3808"\w* \w pudo|strong="H3201"\w* soportar \w más|strong="H5750"\w* la \w maldad|strong="H7455"\w* \w de|strong="H6440"\w* sus acciones \w ni|strong="H3808"\w* las cosas tan despreciables \w que|strong="H3808"\w* ustedes \w hacían|strong="H6213"\w*. \w Por|strong="H6440"\w* eso la tierra \w de|strong="H6440"\w* ustedes \w se|strong="H1961"\w* convirtió \w en|strong="H5750"\w* una ruina desolada y maldita, donde \w nadie|strong="H3808"\w* vive, \w como|strong="H1961"\w* sucede \w hasta|strong="H3117"\w* \w hoy|strong="H3117"\w*.  
\v 23 Precisamente \w porque|strong="H5921"\w* ustedes quemaron incienso \w y|strong="H5921"\w* \w pecaron|strong="H2398"\w* \w contra|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* su \w voz|strong="H6963"\w* \w ni|strong="H3808"\w* \w siguieron|strong="H1980"\w* su \w ley|strong="H8451"\w*, sus mandatos \w y|strong="H5921"\w* sus enseñanzas, \w es|strong="H2088"\w* \w que|strong="H3808"\w* \w les|strong="H5921"\w* \w ha|strong="H3808"\w* sobrevenido \w este|strong="H2088"\w* desastre, \w tal|strong="H3651"\w* \w como|strong="H5921"\w* \w se|strong="H5921"\w* \w ve|strong="H1980"\w* \w hoy|strong="H3117"\w*”.   
\p
\v 24 \w Jeremías|strong="H3414"\w* también le dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* y \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las mujeres: “\w Escuchen|strong="H8085"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé, \w todos|strong="H3605"\w* ustedes \w los|strong="H3605"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w* \w que|strong="H5971"\w* están en \w Egipto|strong="H4714"\w*.  
\v 25 \w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé de los \w Ejércitos|strong="H6635"\w*, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: ‘Ustedes \w y|strong="H3541"\w* sus mujeres han \w dicho|strong="H6310"\w* con su \w boca|strong="H6310"\w* \w lo|strong="H6213"\w* \w que|strong="H6310"\w* han \w cumplido|strong="H6213"\w* con sus \w manos|strong="H3027"\w*: “Sin falta \w cumpliremos|strong="H6213"\w* las promesas \w que|strong="H6310"\w* \w hicimos|strong="H6213"\w* de quemar incienso \w a|strong="H3068"\w* la Reina del \w Cielo|strong="H8064"\w* \w y|strong="H3541"\w* de ofrecerle \w libaciones|strong="H5262"\w*”. ¡Muy bien, vayan \w y|strong="H3541"\w* confirmen sus promesas; cumplan sus \w votos|strong="H5087"\w*!’.   
\p
\v 26 “Pero \w escuchen|strong="H8085"\w* \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w de|strong="H5750"\w* Yahvé, \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w de|strong="H5750"\w* \w Judá|strong="H3063"\w* \w que|strong="H1697"\w* \w viven|strong="H2416"\w* \w en|strong="H5750"\w* \w Egipto|strong="H4714"\w*: ‘He \w jurado|strong="H7650"\w* \w por|strong="H1697"\w* \w mi|strong="H1961"\w* \w gran|strong="H1419"\w* \w nombre|strong="H8034"\w* — \w dice|strong="H1697"\w* Yahvé — \w que|strong="H1697"\w* \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w* \w no|strong="H1961"\w* volverá \w a|strong="H3068"\w* ser pronunciado \w por|strong="H1697"\w* \w ningún|strong="H3605"\w* hombre \w de|strong="H5750"\w* \w Judá|strong="H3063"\w* \w en|strong="H5750"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*. \w Nadie|strong="H3605"\w* volverá \w a|strong="H3068"\w* \w decir|strong="H8085"\w*: “Tan \w cierto|strong="H3651"\w* \w como|strong="H1961"\w* \w que|strong="H1697"\w* \w vive|strong="H2416"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* Yahvé”.  
\v 27 Yo estoy vigilándolos \w para|strong="H5704"\w* \w mal|strong="H7451"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w para|strong="H5704"\w* \w bien|strong="H2896"\w*. \w Todos|strong="H3605"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w que|strong="H3808"\w* están \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w* morirán \w por|strong="H5921"\w* \w la|strong="H5921"\w* guerra \w o|strong="H3068"\w* \w el|strong="H5921"\w* \w hambre|strong="H7458"\w*, \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* desaparezcan \w por|strong="H5921"\w* completo.  
\v 28 Solo \w unos|strong="H1992"\w* \w cuantos|strong="H3605"\w* escaparán \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w* y \w volverán|strong="H7725"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* tierra \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*. \w Entonces|strong="H7725"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w resto|strong="H7611"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w* \w que|strong="H4480"\w* vino \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w sabrá|strong="H3045"\w* \w cuál|strong="H4310"\w* \w palabra|strong="H1697"\w* \w se|strong="H3045"\w* cumple: si \w la|strong="H3605"\w* mía \w o|strong="H3068"\w* \w la|strong="H3605"\w* \w de|strong="H4480"\w* \w ellos|strong="H1992"\w*.   
\p
\v 29 “‘\w Esta|strong="H2063"\w* será \w para|strong="H4616"\w* ustedes \w la|strong="H5921"\w* señal — \w dice|strong="H5002"\w* Yahvé — \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w los|strong="H5921"\w* castigaré \w en|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w sepan|strong="H3045"\w* \w que|strong="H3588"\w* mis advertencias \w de|strong="H5921"\w* \w castigo|strong="H7451"\w* \w contra|strong="H5921"\w* ustedes \w se|strong="H3045"\w* cumplirán sin falta’.  
\v 30 \w Así|strong="H3541"\w* dice Yahvé: ‘Miren, \w yo|strong="H5315"\w* voy \w a|strong="H3068"\w* entregar \w al|strong="H4428"\w* faraón Hofra, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Egipto|strong="H4714"\w*, en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus enemigos \w y|strong="H3541"\w* \w de|strong="H5414"\w* los \w que|strong="H3541"\w* quieren matarlo, tal como \w entregué|strong="H5414"\w* \w a|strong="H3068"\w* Sedequías, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*, en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* su enemigo \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Babilonia, \w que|strong="H3541"\w* quería quitarle la \w vida|strong="H5315"\w*’”.   
\c 45  
\p
\v 1 Este \w es|strong="H1697"\w* \w el|strong="H5921"\w* mensaje \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* dirigió \w a|strong="H3068"\w* Baruc \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Nerías, cuando Baruc \w escribía|strong="H3789"\w* \w en|strong="H5921"\w* un rollo estas \w palabras|strong="H1697"\w* \w que|strong="H5921"\w* \w Jeremías|strong="H3414"\w* \w le|strong="H5921"\w* dictaba, \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*:  
\v 2 “\w Así|strong="H3541"\w* \w te|strong="H5921"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, Baruc:  
\v 3 ‘Tú has dicho: “¡Ay \w de|strong="H5921"\w* \w mí|strong="H5921"\w*! \w Porque|strong="H3588"\w* Yahvé \w ha|strong="H3808"\w* añadido \w tristeza|strong="H3015"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w dolor|strong="H4341"\w*. Estoy \w cansado|strong="H3021"\w* \w de|strong="H5921"\w* mis lamentos \w y|strong="H3588"\w* \w no|strong="H3808"\w* encuentro \w descanso|strong="H4496"\w*” ’.   
\p
\v 4 “Dile \w a|strong="H3068"\w* Baruc: ‘\w Así|strong="H3541"\w* dice Yahvé: “\w Mira|strong="H2009"\w*, \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w yo|strong="H2009"\w* construí, \w lo|strong="H1931"\w* voy \w a|strong="H3068"\w* derribar; \w y|strong="H3541"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w yo|strong="H2009"\w* \w planté|strong="H5193"\w*, \w lo|strong="H1931"\w* voy \w a|strong="H3068"\w* arrancar; \w y|strong="H3541"\w* \w esto|strong="H1931"\w* en \w todo|strong="H3605"\w* \w el|strong="H1931"\w* país”.  
\v 5 ¿\w Y|strong="H3068"\w* tú \w buscas|strong="H1245"\w* \w para|strong="H5921"\w* \w ti|strong="H5921"\w* \w grandes|strong="H1419"\w* \w cosas|strong="H7451"\w*? \w No|strong="H3588"\w* \w las|strong="H5921"\w* \w busques|strong="H1245"\w*; \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* voy \w a|strong="H3068"\w* traer una desgracia \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* humanidad — \w dice|strong="H5002"\w* Yahvé —, \w pero|strong="H3588"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w te|strong="H5921"\w* dejaré salvar \w la|strong="H5921"\w* \w vida|strong="H5315"\w*; \w te|strong="H5921"\w* \w daré|strong="H5414"\w* tu \w vida|strong="H5315"\w* \w por|strong="H5921"\w* botín dondequiera \w que|strong="H3588"\w* \w vayas|strong="H3212"\w*’”.   
\c 46  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w que|strong="H5921"\w* \w vino|strong="H1961"\w* \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.   
\p
\v 2 Respecto \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*: \w acerca|strong="H5921"\w* \w del|strong="H5921"\w* \w ejército|strong="H2428"\w* \w del|strong="H5921"\w* faraón Necao, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w* \w en|strong="H5921"\w* Carquemis, \w y|strong="H5921"\w* \w al|strong="H5921"\w* cual \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, derrotó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Josías|strong="H2977"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\q1
\v 3 “¡Preparen \w el|strong="H5066"\w* \w escudo|strong="H4043"\w* y la rodela,  
\q2 y avancen \w a|strong="H3068"\w* la \w batalla|strong="H4421"\w*!   
\q1
\v 4 Aparejen los \w caballos|strong="H5483"\w* y monten, \w jinetes|strong="H6571"\w*;  
\q2 pónganse los cascos.  
\q1 Saquen punta \w a|strong="H3068"\w* las \w lanzas|strong="H7420"\w*,  
\q2 \w vístanse|strong="H3847"\w* las corazas.   
\q1
\v 5 ¿\w Qué|strong="H3808"\w* es \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w veo|strong="H7200"\w*?  
\q2 Están aterrados y retroceden.  
\q1 \w Sus|strong="H1992"\w* guerreros han sido derrotados;  
\q2 huyen \w a|strong="H3068"\w* toda prisa \w sin|strong="H3808"\w* \w mirar|strong="H7200"\w* atrás.  
\q1 ¡Hay terror \w por|strong="H4069"\w* \w todas|strong="H5439"\w* \w partes|strong="H5439"\w*!”,  
\q2 \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 6 “\w Que|strong="H5921"\w* \w no|strong="H5921"\w* \w escape|strong="H4422"\w* \w el|strong="H5921"\w* \w más|strong="H5921"\w* veloz,  
\q2 ni \w el|strong="H5921"\w* \w más|strong="H5921"\w* \w fuerte|strong="H1368"\w* \w se|strong="H5921"\w* salve.  
\q1 Allá \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w norte|strong="H6828"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w Éufrates|strong="H6578"\w*,  
\q2 \w tropezaron|strong="H3782"\w* \w y|strong="H5921"\w* \w cayeron|strong="H5307"\w*.   
\b  
\q1
\v 7 ¿\w Quién|strong="H4310"\w* \w es|strong="H2088"\w* \w este|strong="H2088"\w* \w que|strong="H4310"\w* \w sube|strong="H5927"\w* como \w el|strong="H4310"\w* Nilo,  
\q2 como \w ríos|strong="H2975"\w* \w de|strong="H4325"\w* \w aguas|strong="H4325"\w* agitadas?   
\q1
\v 8 \w Egipto|strong="H4714"\w* \w sube|strong="H5927"\w* como \w el|strong="H2975"\w* Nilo,  
\q2 y sus \w aguas|strong="H4325"\w* se agitan como \w ríos|strong="H2975"\w*.  
\q1 \w Él|strong="H2975"\w* dice: ‘Me levantaré y \w cubriré|strong="H3680"\w* la tierra;  
\q2 destruiré las \w ciudades|strong="H5892"\w* y \w a|strong="H3068"\w* sus \w habitantes|strong="H3427"\w*’.   
\q1
\v 9 ¡Ataquen, \w caballos|strong="H5483"\w*! ¡Corran, \w carros|strong="H7393"\w*!  
\q2 ¡\w Que|strong="H1869"\w* \w salgan|strong="H3318"\w* los \w valientes|strong="H1368"\w*:  
\q1 los de \w Etiopía|strong="H3568"\w* y los de Libia \w que|strong="H1869"\w* usan \w escudo|strong="H4043"\w*,  
\q2 y los de Lidia \w que|strong="H1869"\w* manejan y tensan el \w arco|strong="H7198"\w*!   
\q1
\v 10 \w Pero|strong="H3588"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w es|strong="H1931"\w* del Señor, Yahvé \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*,  
\q2 \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w venganza|strong="H5360"\w* \w para|strong="H3588"\w* cobrarles \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w enemigos|strong="H6862"\w*.  
\q1 \w La|strong="H1931"\w* \w espada|strong="H2719"\w* devorará \w hasta|strong="H3117"\w* saciarse,  
\q2 \w y|strong="H3588"\w* \w se|strong="H1931"\w* emborrachará \w con|strong="H3588"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w de|strong="H3588"\w* \w ellos|strong="H1931"\w*;  
\q1 \w porque|strong="H3588"\w* \w el|strong="H1931"\w* Señor, Yahvé \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*, \w tiene|strong="H1931"\w* un \w sacrificio|strong="H2077"\w*  
\q2 \w en|strong="H3588"\w* \w la|strong="H1931"\w* tierra del \w norte|strong="H6828"\w*, junto al \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w*.   
\q1
\v 11 \w Sube|strong="H5927"\w* \w a|strong="H3068"\w* \w Galaad|strong="H1568"\w* por \w bálsamo|strong="H6875"\w*, \w virgen|strong="H1330"\w* \w hija|strong="H1323"\w* de \w Egipto|strong="H4714"\w*;  
\q2 por \w más|strong="H7235"\w* \w que|strong="H1323"\w* uses \w muchas|strong="H7235"\w* \w medicinas|strong="H7499"\w*,  
\q2 no habrá remedio para ti.   
\q1
\v 12 Las \w naciones|strong="H1471"\w* ya saben \w de|strong="H3588"\w* tu deshonra,  
\q2 \w y|strong="H3588"\w* tu grito \w llena|strong="H4390"\w* \w la|strong="H3588"\w* tierra;  
\q1 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w valiente|strong="H1368"\w* \w tropezó|strong="H3782"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w valiente|strong="H1368"\w*,  
\q2 \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w dos|strong="H8147"\w* \w cayeron|strong="H5307"\w* \w juntos|strong="H3162"\w*”.   
\b  
\p
\v 13 Esta \w es|strong="H1697"\w* la \w palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé le \w habló|strong="H1696"\w* \w al|strong="H4428"\w* \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w acerca|strong="H1697"\w* \w de|strong="H1697"\w* la venida \w de|strong="H1697"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Babilonia, para atacar la tierra \w de|strong="H1697"\w* \w Egipto|strong="H4714"\w*:   
\q1
\v 14 “Anúncienlo \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*, prolámenlo \w en|strong="H3588"\w* \w Migdol|strong="H4024"\w*;  
\q2 júrenlo \w en|strong="H3588"\w* Menfis \w y|strong="H3588"\w* \w en|strong="H3588"\w* Tafnes.  
\q1 Digan: ‘\w Ponte|strong="H3320"\w* \w en|strong="H3588"\w* pie \w y|strong="H3588"\w* prepárate,  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w* devora \w todo|strong="H5439"\w* \w a|strong="H3068"\w* tu \w alrededor|strong="H5439"\w*’.   
\q1
\v 15 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* han sido derribados tus guerreros?  
\q2 \w No|strong="H3808"\w* pudieron mantenerse \w en|strong="H3588"\w* \w pie|strong="H5975"\w* \w porque|strong="H3588"\w* Yahvé \w los|strong="H3588"\w* empujó.   
\q1
\v 16 \w Él|strong="H5307"\w* \w hizo|strong="H5307"\w* tropezar \w a|strong="H3068"\w* \w muchos|strong="H7235"\w*;  
\q2 \w cayeron|strong="H5307"\w* uno sobre \w otro|strong="H7453"\w*.  
\q1 \w Y|strong="H3068"\w* dijeron: ‘¡\w Levántate|strong="H6965"\w*! Regresemos \w a|strong="H3068"\w* nuestro \w pueblo|strong="H5971"\w*  
\q2 \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w la|strong="H1571"\w* tierra donde nacimos,  
\q2 huyendo \w de|strong="H6440"\w* \w la|strong="H1571"\w* \w espada|strong="H2719"\w* enemiga’.   
\q1
\v 17 \w Allí|strong="H8033"\w* \w gritaron|strong="H7121"\w*: ‘¡\w El|strong="H5674"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* de \w Egipto|strong="H4714"\w*, es pura fanfarria;  
\q2 dejó \w pasar|strong="H5674"\w* su oportunidad!’.   
\b  
\q1
\v 18 ¡Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w vivo|strong="H2416"\w*!, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Rey|strong="H4428"\w*,  
\q2 cuyo \w nombre|strong="H8034"\w* \w es|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*,  
\q1 \w que|strong="H3588"\w* vendrá alguien \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w Tabor|strong="H8396"\w* \w entre|strong="H3588"\w* \w los|strong="H3588"\w* \w montes|strong="H2022"\w*  
\q2 \w y|strong="H3588"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* Carmelo junto \w al|strong="H4428"\w* \w mar|strong="H3220"\w*.   
\q1
\v 19 Prepara \w tu|strong="H6213"\w* equipaje \w para|strong="H3588"\w* \w el|strong="H3588"\w* exilio,  
\q2 \w hija|strong="H1323"\w* \w que|strong="H3588"\w* vives \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*;  
\q1 \w porque|strong="H3588"\w* Menfis \w quedará|strong="H1961"\w* convertida \w en|strong="H3588"\w* desierto,  
\q2 \w será|strong="H1961"\w* incendiada \w y|strong="H3588"\w* nadie vivirá \w en|strong="H3588"\w* ella.   
\b  
\q1
\v 20 \w Egipto|strong="H4714"\w* es una ternera muy hermosa,  
\q2 pero del \w norte|strong="H6828"\w* viene un tábano contra ella; ¡ya viene!   
\q1
\v 21 \w Sus|strong="H1992"\w* soldados mercenarios \w son|strong="H3588"\w* \w como|strong="H3588"\w* \w becerros|strong="H5695"\w* \w de|strong="H5921"\w* engorde;  
\q2 \w ellos|strong="H1992"\w* \w también|strong="H1571"\w* \w se|strong="H5921"\w* \w volvieron|strong="H6437"\w* \w y|strong="H1571"\w* \w huyeron|strong="H5127"\w* \w juntos|strong="H3162"\w*.  
\q1 \w No|strong="H3808"\w* pudieron resistir,  
\q2 \w porque|strong="H3588"\w* \w les|strong="H1992"\w* llegó \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w su|strong="H1992"\w* desastre,  
\q2 \w el|strong="H5921"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5921"\w* \w su|strong="H1992"\w* castigo.   
\q1
\v 22 \w Su|strong="H3588"\w* \w voz|strong="H6963"\w* se escucha \w como|strong="H3588"\w* \w el|strong="H3588"\w* silbido \w de|strong="H3588"\w* una \w serpiente|strong="H5175"\w*,  
\q2 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* enemigo viene \w con|strong="H3588"\w* un \w ejército|strong="H2428"\w*;  
\q1 vienen contra ella \w con|strong="H3588"\w* hachas,  
\q2 \w como|strong="H3588"\w* \w si|strong="H3588"\w* fueran \w leñadores|strong="H2404"\w*.   
\q1
\v 23 Talarán \w su|strong="H1992"\w* \w bosque|strong="H3293"\w* — \w dice|strong="H5002"\w* Yahvé —,  
\q2 \w por|strong="H3588"\w* muy espeso \w que|strong="H3588"\w* sea;  
\q1 \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* numerosos \w que|strong="H3588"\w* \w las|strong="H1992"\w* langostas,  
\q2 \w son|strong="H3588"\w* imposibles \w de|strong="H3588"\w* contar.   
\q1
\v 24 La \w hija|strong="H1323"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w* quedará avergonzada;  
\q2 \w será|strong="H5414"\w* \w entregada|strong="H5414"\w* en \w manos|strong="H3027"\w* del \w pueblo|strong="H5971"\w* del \w norte|strong="H6828"\w*”.   
\p
\v 25 Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, dice: “Yo voy \w a|strong="H3068"\w* castigar \w a|strong="H3068"\w* Amón, \w el|strong="H5921"\w* \w dios|strong="H3068"\w* \w de|strong="H5921"\w* Tebas, \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w faraón|strong="H6547"\w*, \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, \w a|strong="H3068"\w* sus dioses \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w reyes|strong="H4428"\w*; \w tanto|strong="H5921"\w* \w al|strong="H5921"\w* \w faraón|strong="H6547"\w* \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* confían \w en|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 26 Los \w entregaré|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* quienes quieren matarlos, en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Babilonia, y \w de|strong="H5414"\w* sus oficiales. Pero después, Egipto volverá \w a|strong="H3068"\w* \w ser|strong="H5315"\w* habitado \w como|strong="H3651"\w* en los \w tiempos|strong="H3117"\w* \w antiguos|strong="H6924"\w* — \w dice|strong="H5002"\w* Yahvé —.   
\q1
\v 27 \w Pero|strong="H3588"\w* tú \w no|strong="H3588"\w* \w temas|strong="H3372"\w*, \w siervo|strong="H5650"\w* mío \w Jacob|strong="H3290"\w*,  
\q2 ni \w te|strong="H3588"\w* desanimes, \w Israel|strong="H3478"\w*;  
\q1 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w salvaré|strong="H3467"\w* desde \w lejos|strong="H7350"\w*,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* tu \w descendencia|strong="H2233"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w su|strong="H3588"\w* exilio.  
\q1 \w Jacob|strong="H3290"\w* \w volverá|strong="H7725"\w* \w y|strong="H3588"\w* vivirá tranquilo,  
\q2 estará \w en|strong="H3588"\w* paz \w y|strong="H3588"\w* \w no|strong="H3588"\w* habrá quien \w lo|strong="H7350"\w* asuste.   
\q1
\v 28 \w Tú|strong="H6213"\w*, \w siervo|strong="H5650"\w* mío \w Jacob|strong="H3290"\w*, \w no|strong="H3808"\w* \w temas|strong="H3372"\w* — \w dice|strong="H5002"\w* Yahvé —,  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w con|strong="H3588"\w* ustedes.  
\q1 Destruiré \w por|strong="H3588"\w* completo \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* adonde \w los|strong="H3605"\w* he dispersado,  
\q2 \w pero|strong="H3588"\w* \w a|strong="H3068"\w* ti \w no|strong="H3808"\w* \w te|strong="H3588"\w* destruiré \w por|strong="H3588"\w* completo,  
\q1 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w castigaré|strong="H3256"\w* \w con|strong="H3588"\w* \w justicia|strong="H4941"\w*;  
\q2 \w de|strong="H3588"\w* \w ninguna|strong="H3605"\w* manera \w te|strong="H3588"\w* dejaré \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w*”.   
\c 47  
\p
\v 1 \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w que|strong="H1697"\w* \w vino|strong="H1961"\w* al \w profeta|strong="H5030"\w* \w Jeremías|strong="H3414"\w* \w acerca|strong="H1697"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w*, \w antes|strong="H2962"\w* \w de|strong="H1697"\w* \w que|strong="H1697"\w* \w el|strong="H5030"\w* \w faraón|strong="H6547"\w* atacara \w a|strong="H3068"\w* \w Gaza|strong="H5804"\w*.   
\p
\v 2 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Miren \w cómo|strong="H1961"\w* \w suben|strong="H5927"\w* las \w aguas|strong="H4325"\w* desde \w el|strong="H3605"\w* \w norte|strong="H6828"\w*,  
\q2 \w se|strong="H1961"\w* convertirán en un \w torrente|strong="H5158"\w* desbordado;  
\q1 inundarán \w la|strong="H3605"\w* tierra \w y|strong="H3541"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H4325"\w* \w hay|strong="H1961"\w* en \w ella|strong="H3605"\w*,  
\q2 \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3541"\w* \w los|strong="H3427"\w* \w que|strong="H4325"\w* viven en \w ella|strong="H3605"\w*.  
\q1 \w Los|strong="H3427"\w* hombres \w gritarán|strong="H2199"\w* \w de|strong="H4325"\w* dolor,  
\q2 \w y|strong="H3541"\w* gemirán \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H4325"\w* \w la|strong="H3605"\w* tierra.   
\q1
\v 3 \w Por|strong="H3027"\w* \w el|strong="H1121"\w* \w estruendo|strong="H6963"\w* del galope \w de|strong="H1121"\w* sus poderosos caballos,  
\q2 \w por|strong="H3027"\w* \w el|strong="H1121"\w* correr \w de|strong="H1121"\w* sus \w carros|strong="H7393"\w*  
\q2 y \w el|strong="H1121"\w* retumbar \w de|strong="H1121"\w* sus ruedas,  
\q1 \w los|strong="H1121"\w* padres \w no|strong="H3808"\w* \w se|strong="H3808"\w* vuelven para ayudar \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*,  
\q2 pues les faltan las fuerzas;   
\q1
\v 4 \w porque|strong="H3588"\w* ha llegado \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* destruir \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*,  
\q2 \w de|strong="H5921"\w* privar \w a|strong="H3068"\w* \w Tiro|strong="H6865"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w Sidón|strong="H6721"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* aliado \w que|strong="H3588"\w* \w les|strong="H5921"\w* quede;  
\q1 \w porque|strong="H3588"\w* Yahvé \w destruirá|strong="H7703"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*,  
\q2 \w al|strong="H5921"\w* \w resto|strong="H7611"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* isla \w de|strong="H5921"\w* Caftor.   
\q1
\v 5 La calvicie \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* \w Gaza|strong="H5804"\w*;  
\q2 Ascalón ha sido silenciada.  
\q1 Tú, \w resto|strong="H7611"\w* \w de|strong="H5704"\w* su \w valle|strong="H6010"\w*,  
\q2 ¿\w hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* te harás heridas \w de|strong="H5704"\w* duelo?   
\b  
\q1
\v 6 ¡\w Ay|strong="H1945"\w*, \w espada|strong="H2719"\w* \w de|strong="H5704"\w* Yahvé! ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* vas \w a|strong="H3068"\w* seguir?  
\q2 Vuelve \w a|strong="H3068"\w* tu vaina,  
\q2 descansa \w y|strong="H5704"\w* quédate tranquila.   
\b  
\q1
\v 7 ¿Cómo podrá quedarse quieta,  
\q2 si Yahvé le ha dado una \w orden|strong="H6680"\w*?  
\q1 Contra Ascalón y contra la orilla del \w mar|strong="H3220"\w*,  
\q2 \w allí|strong="H8033"\w* la ha enviado”.   
\c 48  
\p
\v 1 Acerca \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*. \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*:  
\q1 “¡\w Ay|strong="H1945"\w* \w de|strong="H3588"\w* \w Nebo|strong="H5015"\w*,  
\q2 \w porque|strong="H3588"\w* \w ha|strong="H3541"\w* sido \w destruida|strong="H7703"\w*!  
\q1 Quiriataim \w ha|strong="H3541"\w* sido humillada \w y|strong="H3588"\w* capturada;  
\q2 \w la|strong="H3588"\w* fortaleza\f + \fr 48:1 \ft o, Misgab\f* \w ha|strong="H3541"\w* sido avergonzada \w y|strong="H3588"\w* derribada.   
\q1
\v 2 \w Ya|strong="H3068"\w* \w no|strong="H5921"\w* existe \w la|strong="H5921"\w* fama \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*;  
\q2 \w en|strong="H5921"\w* \w Hesbón|strong="H2809"\w* planearon \w el|strong="H5921"\w* \w mal|strong="H7451"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*, diciendo:  
\q2 ‘¡Vengan \w y|strong="H1571"\w* borrémonos \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*!’.  
\q1 \w También|strong="H1571"\w* tú, Madmén, serás silenciada;  
\q2 \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w te|strong="H5921"\w* perseguirá.   
\q1
\v 3 Se oyen gritos desde \w Horonaim|strong="H2773"\w*:  
\q2 ‘¡Desolación y \w gran|strong="H1419"\w* \w destrucción|strong="H7701"\w*!’.   
\q1
\v 4 \w Moab|strong="H4124"\w* ha sido destruida;  
\q2 sus niños han hecho \w oír|strong="H8085"\w* su \w clamor|strong="H2201"\w*.   
\q1
\v 5 \w Por|strong="H3588"\w* \w la|strong="H3588"\w* cuesta \w de|strong="H3588"\w* Luhit \w suben|strong="H5927"\w* \w llorando|strong="H1065"\w* sin cesar;  
\q2 \w en|strong="H3588"\w* \w la|strong="H3588"\w* bajada \w de|strong="H3588"\w* \w Horonaim|strong="H2773"\w* se \w oyen|strong="H8085"\w* gritos \w de|strong="H3588"\w* dolor \w por|strong="H3588"\w* \w el|strong="H3588"\w* desastre.   
\q1
\v 6 ¡Huyan! ¡Salven sus \w vidas|strong="H5315"\w*!  
\q2 \w Sean|strong="H1961"\w* \w como|strong="H1961"\w* el arbusto en el \w desierto|strong="H4057"\w*.   
\q1
\v 7 \w Por|strong="H3588"\w* \w cuanto|strong="H3588"\w* confiaste \w en|strong="H3588"\w* tus \w obras|strong="H4639"\w* \w y|strong="H1571"\w* \w en|strong="H3588"\w* tus tesoros,  
\q2 \w también|strong="H1571"\w* tú serás capturada.  
\q1 \w El|strong="H3588"\w* dios Quemos \w irá|strong="H3318"\w* al \w cautiverio|strong="H1473"\w*,  
\q2 \w junto|strong="H3162"\w* \w con|strong="H3588"\w* sus \w sacerdotes|strong="H3548"\w* \w y|strong="H1571"\w* sus \w jefes|strong="H8269"\w*.   
\q1
\v 8 \w El|strong="H3605"\w* destructor vendrá sobre \w cada|strong="H3605"\w* \w ciudad|strong="H5892"\w*,  
\q2 y \w ninguna|strong="H3605"\w* \w escapará|strong="H4422"\w*;  
\q1 \w el|strong="H3605"\w* \w valle|strong="H6010"\w* \w será|strong="H3808"\w* arruinado y \w la|strong="H3605"\w* llanura \w destruida|strong="H7703"\w*, tal como Yahvé \w ha|strong="H3808"\w* dicho.   
\q1
\v 9 Denle \w alas|strong="H6731"\w* \w a|strong="H3068"\w* \w Moab|strong="H4124"\w*,  
\q2 \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* \w escape|strong="H3318"\w* volando;  
\q1 sus \w ciudades|strong="H5892"\w* \w quedarán|strong="H3427"\w* \w desiertas|strong="H8047"\w*,  
\q2 \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w habrá|strong="H1961"\w* quien viva \w en|strong="H3588"\w* ellas.   
\b  
\q1
\v 10 Maldito \w el|strong="H6213"\w* que \w haga|strong="H6213"\w* con descuido la \w obra|strong="H4399"\w* \w de|strong="H1818"\w* Yahvé,  
\q2 y maldito \w el|strong="H6213"\w* que retire su \w espada|strong="H2719"\w* \w de|strong="H1818"\w* la \w sangre|strong="H1818"\w*.   
\b  
\q1
\v 11 \w Moab|strong="H4124"\w* \w ha|strong="H3808"\w* \w estado|strong="H5975"\w* tranquilo \w desde|strong="H5921"\w* \w su|strong="H1931"\w* \w juventud|strong="H5271"\w*,  
\q2 reposando \w como|strong="H5921"\w* \w el|strong="H1931"\w* \w vino|strong="H1980"\w* \w sobre|strong="H5921"\w* \w su|strong="H1931"\w* sedimento;  
\q1 \w no|strong="H3808"\w* \w ha|strong="H3808"\w* sido trasvasado \w de|strong="H5921"\w* \w vasija|strong="H3627"\w* \w en|strong="H5921"\w* \w vasija|strong="H3627"\w*,  
\q2 \w ni|strong="H3808"\w* \w ha|strong="H3808"\w* ido \w jamás|strong="H3808"\w* \w al|strong="H5921"\w* exilio.  
\q1 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* conserva \w su|strong="H1931"\w* \w sabor|strong="H2940"\w* original,  
\q2 \w y|strong="H5921"\w* \w su|strong="H1931"\w* aroma \w no|strong="H3808"\w* \w ha|strong="H3808"\w* cambiado.   
\q1
\v 12 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, vienen \w días|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé —  
\q2 en \w que|strong="H3117"\w* le \w enviaré|strong="H7971"\w* trasvasadores \w que|strong="H3117"\w* lo trasvasarán;  
\q1 vaciarán sus vasijas  
\q2 y harán pedazos sus ánforas.   
\q1
\v 13 Entonces \w Moab|strong="H4124"\w* se avergonzará de Quemos,  
\q2 como la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w* se avergonzó de Betel, en quien confiaba.   
\b  
\q1
\v 14 ¿Cómo pueden decir: ‘Somos guerreros  
\q2 y \w hombres|strong="H1368"\w* \w valientes|strong="H1368"\w* para la \w batalla|strong="H4421"\w*’?   
\q1
\v 15 \w Moab|strong="H4124"\w* ha sido asolado y sus \w ciudades|strong="H5892"\w* invadidas;  
\q2 sus mejores jóvenes han bajado \w al|strong="H4428"\w* matadero”,  
\q2 \w dice|strong="H5002"\w* el \w Rey|strong="H4428"\w*, cuyo \w nombre|strong="H8034"\w* es Yahvé de los \w Ejércitos|strong="H6635"\w*.   
\q1
\v 16 “El desastre \w de|strong="H7451"\w* \w Moab|strong="H4124"\w* está por llegar,  
\q2 su desgracia se apresura.   
\q1
\v 17 Lloren por \w él|strong="H3605"\w* \w todos|strong="H3605"\w* ustedes, sus vecinos,  
\q2 \w y|strong="H5797"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3045"\w* \w conocen|strong="H3045"\w* su \w fama|strong="H8034"\w*, digan:  
\q1 ‘¡Cómo \w se|strong="H3045"\w* rompió \w el|strong="H3605"\w* bastón \w de|strong="H5110"\w* mando,  
\q2 \w la|strong="H3605"\w* \w vara|strong="H4294"\w* \w de|strong="H5110"\w* esplendor!’.   
\b  
\q1
\v 18 \w Desciende|strong="H3381"\w* \w de|strong="H3588"\w* tu \w gloria|strong="H3519"\w* \w y|strong="H3588"\w* \w siéntate|strong="H3427"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w sed|strong="H6772"\w*,  
\q2 habitante \w de|strong="H3588"\w* \w Dibón|strong="H1769"\w*;  
\q1 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* destructor \w de|strong="H3588"\w* \w Moab|strong="H4124"\w* ha \w subido|strong="H5927"\w* contra ti  
\q2 \w y|strong="H3588"\w* ha demolido tus fortalezas.   
\q1
\v 19 \w Ponte|strong="H5975"\w* \w en|strong="H5975"\w* \w el|strong="H3427"\w* \w camino|strong="H1870"\w* y observa, habitante de \w Aroer|strong="H6177"\w*;  
\q2 pregúntale al \w que|strong="H4100"\w* \w huye|strong="H5127"\w* y \w a|strong="H3068"\w* la \w que|strong="H4100"\w* \w escapa|strong="H4422"\w*:  
\q2 ‘¿\w Qué|strong="H4100"\w* ha pasado?’.   
\q1
\v 20 \w Moab|strong="H4124"\w* ha quedado humillado \w y|strong="H3588"\w* \w deshecho|strong="H2865"\w*;  
\q2 ¡lamenten \w y|strong="H3588"\w* griten!  
\q1 Anuncien junto al Arnón \w que|strong="H3588"\w* \w Moab|strong="H4124"\w* ha sido \w destruido|strong="H7703"\w*.   
\q1
\v 21 \w El|strong="H5921"\w* \w juicio|strong="H4941"\w* ha llegado \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w la|strong="H5921"\w* llanura;  
\q2 \w sobre|strong="H5921"\w* Holón, \w sobre|strong="H5921"\w* Jahaza \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* Mefaat,   
\q2
\v 22 \w sobre|strong="H5921"\w* \w Dibón|strong="H1769"\w*, \w sobre|strong="H5921"\w* \w Nebo|strong="H5015"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* Bet-diblataim,   
\q2
\v 23 \w sobre|strong="H5921"\w* Quiriataim, \w sobre|strong="H5921"\w* Bet-gamul \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* Bet-meón,   
\q2
\v 24 \w sobre|strong="H5921"\w* Queriot \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w Bosra|strong="H1224"\w*,  
\q2 \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, estén \w lejos|strong="H7350"\w* \w o|strong="H3068"\w* \w cerca|strong="H7138"\w*.   
\q1
\v 25 El poder de \w Moab|strong="H4124"\w* ha sido \w cortado|strong="H1438"\w*  
\q2 y su \w brazo|strong="H2220"\w* ha sido roto”, \w dice|strong="H5002"\w* Yahvé.   
\b  
\q1
\v 26 “Emborráchenlo,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H1961"\w* \w engrandeció|strong="H1431"\w* \w contra|strong="H5921"\w* Yahvé.  
\q1 \w Moab|strong="H4124"\w* \w se|strong="H1961"\w* revolcará \w en|strong="H5921"\w* \w su|strong="H1931"\w* propio \w vómito|strong="H6892"\w*,  
\q2 \w y|strong="H1571"\w* \w él|strong="H1931"\w* \w también|strong="H1571"\w* \w será|strong="H1961"\w* motivo \w de|strong="H5921"\w* burla.   
\q1
\v 27 ¿Acaso \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w fue|strong="H1961"\w* \w para|strong="H3588"\w* ti objeto \w de|strong="H3588"\w* burla?  
\q2 ¿Acaso \w fue|strong="H1961"\w* sorprendido \w entre|strong="H3808"\w* \w ladrones|strong="H1590"\w*?  
\q1 \w Pues|strong="H3588"\w* \w cada|strong="H1697"\w* vez \w que|strong="H3588"\w* hablas \w de|strong="H3588"\w* \w él|strong="H3588"\w*,  
\q2 \w te|strong="H3588"\w* burlas moviendo \w la|strong="H3588"\w* cabeza.   
\q1
\v 28 Abandonen las \w ciudades|strong="H5892"\w* y vivan entre las rocas, \w habitantes|strong="H3427"\w* de \w Moab|strong="H4124"\w*;  
\q2 \w sean|strong="H1961"\w* \w como|strong="H1961"\w* la \w paloma|strong="H3123"\w* \w que|strong="H1961"\w* hace su nido en las paredes de un precipicio.   
\b  
\q1
\v 29 Hemos \w oído|strong="H8085"\w* del orgullo de \w Moab|strong="H4124"\w*; ¡es \w muy|strong="H3966"\w* orgulloso!  
\q2 De su altivez, de su \w soberbia|strong="H1347"\w*,  
\q2 de su arrogancia y de la \w soberbia|strong="H1347"\w* de su \w corazón|strong="H3820"\w*.   
\q1
\v 30 \w Yo|strong="H6213"\w* \w conozco|strong="H3045"\w* su arrogancia — \w dice|strong="H5002"\w* Yahvé —, pero es vana;  
\q2 sus jactancias \w no|strong="H3808"\w* sirven para \w nada|strong="H3808"\w*.   
\q1
\v 31 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* lloraré \w por|strong="H5921"\w* \w Moab|strong="H4124"\w*,  
\q2 gritaré \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w Moab|strong="H4124"\w*  
\q2 \w y|strong="H5921"\w* \w gemiré|strong="H1897"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Quir-heres.   
\q1
\v 32 \w Más|strong="H5921"\w* \w que|strong="H5921"\w* \w por|strong="H5921"\w* \w Jazer|strong="H3270"\w*, \w lloraré|strong="H1058"\w* \w por|strong="H5921"\w* \w ti|strong="H5921"\w*, \w vid|strong="H1612"\w* \w de|strong="H5921"\w* Sibma;  
\q2 tus sarmientos llegaban \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, alcanzaban \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w de|strong="H5921"\w* \w Jazer|strong="H3270"\w*.  
\q1 Pero \w sobre|strong="H5921"\w* tu cosecha \w y|strong="H5921"\w* tu vendimia  
\q2 ha \w caído|strong="H5307"\w* \w el|strong="H5921"\w* destructor.   
\q1
\v 33 La \w alegría|strong="H8057"\w* y el \w gozo|strong="H8057"\w* \w se|strong="H3808"\w* han ido de los huertos  
\q2 y de la tierra de \w Moab|strong="H4124"\w*.  
\q1 He detenido el \w vino|strong="H3196"\w* de los lagares;  
\q2 ya \w nadie|strong="H3808"\w* los pisa con gritos de júbilo;  
\q2 \w si|strong="H3808"\w* hay gritos, \w no|strong="H3808"\w* \w son|strong="H3808"\w* de \w alegría|strong="H8057"\w*.   
\q1
\v 34 \w Los|strong="H1961"\w* \w gritos|strong="H2201"\w* \w desde|strong="H5704"\w* \w Hesbón|strong="H2809"\w* llegan \w hasta|strong="H5704"\w* Eleale \w y|strong="H1571"\w* Jahaza;  
\q2 \w se|strong="H1961"\w* oye \w su|strong="H3588"\w* \w voz|strong="H6963"\w* \w desde|strong="H5704"\w* \w Zoar|strong="H6820"\w* \w hasta|strong="H5704"\w* \w Horonaim|strong="H2773"\w* \w y|strong="H1571"\w* Eglat-selisiyá;  
\q2 \w porque|strong="H3588"\w* \w hasta|strong="H5704"\w* las \w aguas|strong="H4325"\w* \w de|strong="H3588"\w* Nimrim \w se|strong="H1961"\w* han secado.   
\q1
\v 35 Haré que desaparezca de \w Moab|strong="H4124"\w* — \w dice|strong="H5002"\w* Yahvé —  
\q2 el que ofrece sacrificios en los lugares \w altos|strong="H1116"\w*  
\q2 y el que quema incienso \w a|strong="H3068"\w* sus dioses.   
\q1
\v 36 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w mi|strong="H5921"\w* \w corazón|strong="H3820"\w* resuena \w por|strong="H5921"\w* \w Moab|strong="H4124"\w* \w como|strong="H5921"\w* una flauta,  
\q2 resuena \w como|strong="H5921"\w* flauta \w por|strong="H5921"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Quir-heres;  
\q2 \w porque|strong="H5921"\w* \w las|strong="H5921"\w* riquezas \w que|strong="H5921"\w* ganaron \w se|strong="H5921"\w* perdieron.   
\q1
\v 37 \w Toda|strong="H3605"\w* \w cabeza|strong="H7218"\w* \w está|strong="H5921"\w* calva  
\q2 \w y|strong="H3588"\w* \w toda|strong="H3605"\w* \w barba|strong="H2206"\w* ha sido rasurada;  
\q1 \w todos|strong="H3605"\w* \w se|strong="H5921"\w* han hecho heridas \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w*  
\q2 \w y|strong="H3588"\w* \w se|strong="H5921"\w* han vestido \w con|strong="H5921"\w* ropas \w de|strong="H5921"\w* luto.   
\q1
\v 38 \w En|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* azoteas \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* sus \w calles|strong="H7339"\w* \w no|strong="H3588"\w* hay \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w llanto|strong="H4553"\w*;  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* rompí \w a|strong="H3068"\w* \w Moab|strong="H4124"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* una \w vasija|strong="H3627"\w* \w que|strong="H3588"\w* \w nadie|strong="H3605"\w* quiere”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 39 “¡\w Cómo|strong="H1961"\w* \w quedó|strong="H1961"\w* destrozado! ¡Lamenten!  
\q2 ¡\w Cómo|strong="H1961"\w* \w volvió|strong="H6437"\w* \w Moab|strong="H4124"\w* \w la|strong="H3605"\w* espalda avergonzado!  
\q1 \w Moab|strong="H4124"\w* \w se|strong="H1961"\w* ha vuelto motivo de burla  
\q2 y de espanto \w para|strong="H1961"\w* \w todos|strong="H3605"\w* sus vecinos”.   
\q1
\v 40 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: “Miren \w que|strong="H3588"\w* \w el|strong="H3588"\w* enemigo \w volará|strong="H1675"\w* \w como|strong="H3588"\w* un águila,  
\q2 \w y|strong="H3588"\w* extenderá sus \w alas|strong="H3671"\w* contra \w Moab|strong="H4124"\w*.   
\q1
\v 41 Queriot \w será|strong="H1961"\w* capturada  
\q2 y las \w fortalezas|strong="H4679"\w* \w serán|strong="H1961"\w* \w tomadas|strong="H3920"\w*;  
\q1 \w el|strong="H1931"\w* \w corazón|strong="H3820"\w* de \w los|strong="H1931"\w* \w valientes|strong="H1368"\w* de \w Moab|strong="H4124"\w* en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*  
\q2 \w será|strong="H1961"\w* \w como|strong="H1961"\w* \w el|strong="H1931"\w* de una mujer de parto.   
\q1
\v 42 \w Moab|strong="H4124"\w* será destruido \w como|strong="H3588"\w* \w pueblo|strong="H5971"\w*,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H5921"\w* rebeló \w contra|strong="H5921"\w* Yahvé.   
\q1
\v 43 \w El|strong="H5921"\w* \w terror|strong="H6343"\w*, \w la|strong="H5921"\w* fosa \w y|strong="H5921"\w* \w la|strong="H5921"\w* trampa \w te|strong="H5921"\w* acechan,  
\q2 habitante \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 44 “\w El|strong="H3588"\w* \w que|strong="H3588"\w* huya \w del|strong="H4480"\w* \w terror|strong="H6343"\w* \w caerá|strong="H5307"\w* \w en|strong="H4480"\w* \w la|strong="H3588"\w* fosa,  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* salga \w de|strong="H4480"\w* \w la|strong="H3588"\w* fosa quedará atrapado \w en|strong="H4480"\w* \w la|strong="H3588"\w* trampa;  
\q1 \w porque|strong="H3588"\w* \w yo|strong="H4480"\w* traeré \w sobre|strong="H4480"\w* \w Moab|strong="H4124"\w*  
\q2 \w el|strong="H3588"\w* \w año|strong="H8141"\w* \w de|strong="H4480"\w* \w su|strong="H3588"\w* castigo”, \w dice|strong="H5002"\w* Yahvé.   
\b  
\q1
\v 45 \w A|strong="H3068"\w* \w la|strong="H3588"\w* \w sombra|strong="H6738"\w* \w de|strong="H3588"\w* \w Hesbón|strong="H2809"\w* se detuvieron \w los|strong="H1121"\w* \w que|strong="H3588"\w* huían, \w pero|strong="H3588"\w* ya \w no|strong="H3588"\w* tenían \w fuerzas|strong="H3581"\w*;  
\q2 \w porque|strong="H3588"\w* \w salió|strong="H3318"\w* fuego \w de|strong="H3588"\w* \w Hesbón|strong="H2809"\w*  
\q2 \w y|strong="H3588"\w* una \w llama|strong="H3852"\w* \w de|strong="H3588"\w* \w en|strong="H3588"\w* medio \w de|strong="H3588"\w* \w Sehón|strong="H5511"\w*,  
\q1 \w que|strong="H3588"\w* devoró las fronteras \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* cabeza \w de|strong="H3588"\w* \w los|strong="H1121"\w* rebeldes.   
\q1
\v 46 ¡Ay \w de|strong="H3588"\w* ti, \w Moab|strong="H4124"\w*!  
\q2 \w El|strong="H3588"\w* \w pueblo|strong="H5971"\w* del dios Quemos ha perecido;  
\q1 tus \w hijos|strong="H1121"\w* han sido llevados \w cautivos|strong="H7628"\w*  
\q2 \w y|strong="H3588"\w* tus \w hijas|strong="H1323"\w* al exilio.   
\b  
\q1
\v 47 “Pero \w en|strong="H5704"\w* los \w días|strong="H3117"\w* venideros yo restauraré la suerte \w de|strong="H5704"\w* \w Moab|strong="H4124"\w*”,  
\q2 \w dice|strong="H5002"\w* Yahvé.  
\p \w Hasta|strong="H5704"\w* \w aquí|strong="H2008"\w* el \w juicio|strong="H4941"\w* \w de|strong="H5704"\w* \w Moab|strong="H4124"\w*.   
\c 49  
\p
\v 1 Acerca \w de|strong="H1121"\w* \w los|strong="H3427"\w* amonitas. \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “¿Acaso \w Israel|strong="H3478"\w* no tiene \w hijos|strong="H1121"\w*?  
\q2 ¿Acaso no tiene \w heredero|strong="H3423"\w*?  
\q1 ¿\w Por|strong="H4069"\w* \w qué|strong="H5971"\w*, entonces, \w el|strong="H1121"\w* \w dios|strong="H3068"\w* Malcam \w se|strong="H5971"\w* apoderó \w de|strong="H1121"\w* \w Gad|strong="H1410"\w*,  
\q2 \w y|strong="H3541"\w* su \w pueblo|strong="H5971"\w* vive en las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* esa tribu?   
\q1
\v 2 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, vienen \w días|strong="H3117"\w*”, \w dice|strong="H5002"\w* Yahvé,  
\q1 “en \w que|strong="H3117"\w* haré \w que|strong="H3117"\w* \w se|strong="H1961"\w* \w oiga|strong="H8085"\w* \w el|strong="H1121"\w* grito \w de|strong="H1121"\w* \w guerra|strong="H4421"\w* en Rabá \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas;  
\q2 \w quedará|strong="H1961"\w* convertida en un \w montón|strong="H8510"\w* \w de|strong="H1121"\w* ruinas,  
\q2 y sus \w aldeas|strong="H1323"\w* \w serán|strong="H1961"\w* \w quemadas|strong="H3341"\w* con fuego.  
\q1 \w Entonces|strong="H3117"\w* \w Israel|strong="H3478"\w* despojará \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w que|strong="H3117"\w* lo despojaron”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 3 “¡Grita \w de|strong="H3588"\w* dolor, \w Hesbón|strong="H2809"\w*, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* ciudad \w de|strong="H3588"\w* \w Hai|strong="H5857"\w* ha sido \w destruida|strong="H7703"\w*!  
\q2 ¡Clamen, \w hijas|strong="H1323"\w* \w de|strong="H3588"\w* Rabá!  
\q1 Vístanse \w de|strong="H3588"\w* luto \w y|strong="H3588"\w* laméntense;  
\q2 corran \w de|strong="H3588"\w* \w un|strong="H3162"\w* lado \w a|strong="H3068"\w* otro \w por|strong="H3588"\w* \w los|strong="H3588"\w* cercados,  
\q1 \w porque|strong="H3588"\w* Malcam \w irá|strong="H3212"\w* \w al|strong="H4428"\w* destierro  
\q2 \w junto|strong="H3162"\w* \w con|strong="H3588"\w* sus \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* sus \w jefes|strong="H8269"\w*.   
\q1
\v 4 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* presumes de tus \w valles|strong="H6010"\w*,  
\q2 de tus \w valles|strong="H6010"\w* tan fértiles, \w hija|strong="H1323"\w* rebelde?  
\q1 Tú confías en tus tesoros y dices:  
\q2 ‘¿\w Quién|strong="H4310"\w* \w se|strong="H4100"\w* atreverá \w a|strong="H3068"\w* venir contra mí?’.   
\q1
\v 5 \w Mira|strong="H2005"\w*, yo traigo \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w el|strong="H5921"\w* \w terror|strong="H6343"\w*”, \w dice|strong="H5002"\w* \w el|strong="H5921"\w* Señor, Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*,  
\q1 “\w de|strong="H5921"\w* \w todos|strong="H3605"\w* tus \w alrededores|strong="H5439"\w*.  
\q2 \w Todos|strong="H3605"\w* ustedes serán expulsados, \w cada|strong="H3605"\w* uno \w por|strong="H5921"\w* su lado,  
\q2 \w y|strong="H5921"\w* \w no|strong="H5921"\w* habrá \w nadie|strong="H3605"\w* \w que|strong="H5921"\w* reúna \w a|strong="H3068"\w* \w los|strong="H5921"\w* fugitivos.   
\b  
\q1
\v 6 Pero después \w de|strong="H1121"\w* \w esto|strong="H3651"\w*, cambiaré la suerte \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas”, \w dice|strong="H5002"\w* Yahvé.   
\b  
\p
\v 7 Acerca \w de|strong="H5750"\w* Edom. \w Así|strong="H3541"\w* dice Yahvé \w de|strong="H5750"\w* los \w Ejércitos|strong="H6635"\w*:  
\q1 “¿\w Ya|strong="H3068"\w* no queda \w sabiduría|strong="H2451"\w* \w en|strong="H5750"\w* \w Temán|strong="H8487"\w*?  
\q2 ¿Acaso se acabó el \w consejo|strong="H6098"\w* \w de|strong="H5750"\w* los prudentes?  
\q2 ¿Se echó \w a|strong="H3068"\w* perder su \w sabiduría|strong="H2451"\w*?   
\q1
\v 8 ¡Huyan! ¡Den media vuelta!  
\q2 Escondanse \w en|strong="H5921"\w* \w las|strong="H5921"\w* profundidades, \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w Dedán|strong="H1719"\w*;  
\q1 \w porque|strong="H3588"\w* voy \w a|strong="H3068"\w* traer \w sobre|strong="H5921"\w* \w Esaú|strong="H6215"\w* \w su|strong="H3588"\w* desastre  
\q2 \w al|strong="H5921"\w* \w tiempo|strong="H6256"\w* \w que|strong="H3588"\w* \w lo|strong="H5921"\w* tenga \w que|strong="H3588"\w* castigar.   
\q1
\v 9 \w Si|strong="H3808"\w* vinieran \w vendimiadores|strong="H1219"\w* \w a|strong="H3068"\w* tus viñas,  
\q2 ¿\w no|strong="H3808"\w* dejarían al menos algunos rebuscos?  
\q1 \w Si|strong="H3808"\w* vinieran \w ladrones|strong="H1590"\w* de \w noche|strong="H3915"\w*,  
\q2 ¿\w no|strong="H3808"\w* robarían solo \w lo|strong="H3808"\w* \w que|strong="H3808"\w* les hiciera falta?   
\q1
\v 10 \w Pero|strong="H3588"\w* \w yo|strong="H3588"\w* he desnudado \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w*,  
\q2 he descubierto sus escondites  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w podrá|strong="H3201"\w* ocultarse.  
\q1 \w Su|strong="H3588"\w* \w descendencia|strong="H2233"\w* \w ha|strong="H3808"\w* sido \w destruida|strong="H7703"\w*,  
\q2 junto \w con|strong="H3588"\w* sus hermanos \w y|strong="H3588"\w* sus \w vecinos|strong="H7934"\w*, \w y|strong="H3588"\w* \w él|strong="H3588"\w* mismo ya \w no|strong="H3808"\w* existe.   
\q1
\v 11 \w Deja|strong="H5800"\w* \w a|strong="H3068"\w* tus \w huérfanos|strong="H3490"\w*, \w que|strong="H5921"\w* yo \w los|strong="H5921"\w* mantendré \w con|strong="H5921"\w* \w vida|strong="H2421"\w*;  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* tus viudas confíen \w en|strong="H5921"\w* \w mí|strong="H5921"\w*”.   
\p
\v 12 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: “\w Si|strong="H3588"\w* incluso \w los|strong="H1931"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* merecían \w beber|strong="H8354"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* copa \w del|strong="H8354"\w* \w castigo|strong="H5352"\w* tuvieron \w que|strong="H3588"\w* \w beberla|strong="H8354"\w*, ¿crees \w que|strong="H3588"\w* tú quedarás \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w*? \w No|strong="H3808"\w* quedarás impune, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* tendrás \w que|strong="H3588"\w* \w beberla|strong="H8354"\w*.  
\v 13 \w Pues|strong="H3588"\w* he \w jurado|strong="H7650"\w* \w por|strong="H3588"\w* \w mí|strong="H1961"\w* \w mismo|strong="H3605"\w* — \w dice|strong="H5002"\w* Yahvé — \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w de|strong="H3588"\w* \w Bosra|strong="H1224"\w* \w se|strong="H1961"\w* convertirá \w en|strong="H3588"\w* objeto \w de|strong="H3588"\w* horror, \w de|strong="H3588"\w* insulto, \w de|strong="H3588"\w* ruina \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w maldición|strong="H7045"\w*. \w Todas|strong="H3605"\w* sus \w ciudades|strong="H5892"\w* quedarán \w en|strong="H3588"\w* ruinas \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*”.   
\q1
\v 14 He \w oído|strong="H8085"\w* un mensaje \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* Yahvé:  
\q2 un heraldo ha sido \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w para|strong="H5921"\w* decirles:  
\q1 “¡Reúnanse \w y|strong="H5921"\w* ataquen \w a|strong="H3068"\w* Edom!  
