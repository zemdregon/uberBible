\c 2  
\p
\v 1 \w Catorce|strong="G1180"\w* \w años|strong="G2094"\w* \w después|strong="G3326"\w*, subí \w de|strong="G1519"\w* nuevo \w a|strong="G1519"\w* Jerusalén \w con|strong="G3326"\w* Bernabé, \w y|strong="G2532"\w* llevé \w también|strong="G2532"\w* \w a|strong="G1519"\w* \w Tito|strong="G5103"\w* \w conmigo|strong="G3326"\w*.  
\v 2 Fui \w porque|strong="G1161"\w* Dios \w me|strong="G1519"\w* \w lo|strong="G3588"\w* reveló, \w y|strong="G2532"\w* \w en|strong="G1722"\w* \w una|strong="G3588"\w* reunión privada \w con|strong="G1722"\w* \w los|strong="G3588"\w* líderes \w más|strong="G1161"\w* respetados, \w les|strong="G1519"\w* expliqué \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w que|strong="G3588"\w* \w predico|strong="G2784"\w* \w entre|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w no|strong="G3361"\w* son judíos, \w para|strong="G1519"\w* asegurarme \w de|strong="G1722"\w* \w que|strong="G3588"\w* \w mi|strong="G3588"\w* trabajo, \w tanto|strong="G3739"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* pasado \w como|strong="G2532"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w presente|strong="G2596"\w*, \w no|strong="G3361"\w* \w fuera|strong="G1722"\w* \w en|strong="G1722"\w* \w vano|strong="G2756"\w*.  
\v 3 Sin embargo, \w ni|strong="G3761"\w* siquiera \w Tito|strong="G5103"\w*, \w que|strong="G3588"\w* estaba \w conmigo|strong="G4862"\w* \w y|strong="G1510"\w* \w era|strong="G1510"\w* \w griego|strong="G1672"\w*, fue obligado a circuncidarse.  
\v 4 \w El|strong="G3588"\w* problema surgió \w por|strong="G1223"\w* \w unos|strong="G3588"\w* falsos hermanos \w que|strong="G3588"\w* se infiltraron \w entre|strong="G1722"\w* \w nosotros|strong="G2249"\w* \w para|strong="G2443"\w* espiar \w la|strong="G3588"\w* \w libertad|strong="G1657"\w* \w que|strong="G3588"\w* \w tenemos|strong="G2192"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*, \w con|strong="G1722"\w* \w el|strong="G3588"\w* fin \w de|strong="G1722"\w* volvernos esclavos \w de|strong="G1722"\w* \w la|strong="G3588"\w* ley.  
\v 5 Pero \w ni|strong="G3761"\w* \w por|strong="G4314"\w* \w un|strong="G3588"\w* momento \w cedimos|strong="G1502"\w* \w a|strong="G4314"\w* \w sus|strong="G3588"\w* presiones, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w la|strong="G3588"\w* verdad \w del|strong="G3588"\w* \w evangelio|strong="G2098"\w* permaneciera \w con|strong="G4314"\w* ustedes.  
\v 6 \w En|strong="G3588"\w* \w cuanto|strong="G3588"\w* \w a|strong="G1161"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* eran reconocidos como líderes importantes, \w a|strong="G1161"\w* \w mí|strong="G3588"\w* \w no|strong="G3756"\w* \w me|strong="G1473"\w* importa \w lo|strong="G3588"\w* \w que|strong="G3588"\w* hayan sido, \w porque|strong="G1063"\w* \w Dios|strong="G2316"\w* \w no|strong="G3756"\w* muestra favoritismo. Esos líderes \w no|strong="G3756"\w* le añadieron \w nada|strong="G3762"\w* nuevo \w a|strong="G1161"\w* \w mi|strong="G3588"\w* mensaje.  
\v 7 \w Al|strong="G3588"\w* contrario, se dieron cuenta \w de|strong="G3588"\w* \w que|strong="G3754"\w* Dios me había confiado \w la|strong="G3588"\w* tarea \w de|strong="G3588"\w* predicar \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* a \w los|strong="G3588"\w* no judíos, \w así|strong="G2531"\w* \w como|strong="G2531"\w* le había confiado a \w Pedro|strong="G4074"\w* \w la|strong="G3588"\w* predicación a \w los|strong="G3588"\w* judíos.  
\v 8 \w Pues|strong="G1063"\w* \w el|strong="G3588"\w* mismo Dios \w que|strong="G3588"\w* actuó \w por|strong="G1519"\w* medio \w de|strong="G1519"\w* \w Pedro|strong="G4074"\w* \w como|strong="G2532"\w* apóstol \w para|strong="G1519"\w* \w los|strong="G3588"\w* judíos, \w también|strong="G2532"\w* actuó \w por|strong="G1519"\w* medio \w de|strong="G1519"\w* \w mí|strong="G3588"\w* \w para|strong="G1519"\w* \w los|strong="G3588"\w* no judíos.  
\v 9 \w Al|strong="G3588"\w* \w reconocer|strong="G1097"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w que|strong="G3588"\w* \w yo|strong="G1473"\w* había recibido, Santiago, Pedro \w y|strong="G2532"\w* \w Juan|strong="G2491"\w*, \w que|strong="G3588"\w* eran considerados \w las|strong="G3588"\w* \w columnas|strong="G4769"\w* \w de|strong="G1519"\w* \w la|strong="G3588"\w* iglesia, nos \w dieron|strong="G1325"\w* \w la|strong="G3588"\w* mano \w a|strong="G1519"\w* \w mí|strong="G3588"\w* \w y|strong="G2532"\w* \w a|strong="G1519"\w* Bernabé \w en|strong="G1519"\w* señal \w de|strong="G1519"\w* compañerismo, \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w nosotros|strong="G2249"\w* \w fuéramos|strong="G1510"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* no judíos, \w y|strong="G2532"\w* \w ellos|strong="G3588"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* judíos.  
\v 10 \w Lo|strong="G3588"\w* único \w que|strong="G3588"\w* nos pidieron fue \w que|strong="G3588"\w* nos acordáramos \w de|strong="G3588"\w* \w los|strong="G3588"\w* \w pobres|strong="G4434"\w*, algo \w que|strong="G3588"\w* yo mismo \w siempre|strong="G3588"\w* he procurado \w hacer|strong="G4160"\w* \w con|strong="G2532"\w* mucho esmero.   
