\v 19 \w Entonces|strong="G3767"\w*, ¿\w cuál|strong="G3739"\w* era \w el|strong="G3588"\w* propósito \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w ley|strong="G3551"\w*? \w Fue|strong="G2064"\w* añadida \w por|strong="G1223"\w* \w causa|strong="G1223"\w* \w de|strong="G1722"\w* \w los|strong="G3588"\w* pecados, hasta \w que|strong="G3588"\w* llegara \w la|strong="G3588"\w* descendencia \w a|strong="G1722"\w* \w quien|strong="G5101"\w* se \w le|strong="G1722"\w* había hecho \w la|strong="G3588"\w* promesa. \w La|strong="G3588"\w* \w ley|strong="G3551"\w* \w fue|strong="G2064"\w* promulgada \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1722"\w* ángeles \w y|strong="G3767"\w* entregada \w por|strong="G1223"\w* \w un|strong="G3588"\w* \w mediador|strong="G3316"\w*.  
\v 20 \w Sin|strong="G3756"\w* embargo, \w un|strong="G1520"\w* \w mediador|strong="G3316"\w* \w no|strong="G3756"\w* representa \w a|strong="G1161"\w* \w una|strong="G1520"\w* sola parte, \w y|strong="G1161"\w* \w Dios|strong="G2316"\w* \w es|strong="G3756"\w* \w uno|strong="G1520"\w* \w solo|strong="G1520"\w*.   
\p
