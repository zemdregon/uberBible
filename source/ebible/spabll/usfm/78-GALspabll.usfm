\v 15 \w Porque|strong="G1063"\w* en Cristo Jesús, de \w nada|strong="G5100"\w* sirve estar o \w no|strong="G3777"\w* estar \w circuncidado|strong="G4061"\w*; \w lo|strong="G5101"\w* \w que|strong="G5101"\w* cuenta es ser \w una|strong="G5100"\w* \w nueva|strong="G2537"\w* \w creación|strong="G2937"\w*.  
\v 16 \w Que|strong="G3588"\w* \w la|strong="G3588"\w* \w paz|strong="G1515"\w* \w y|strong="G2532"\w* \w la|strong="G3588"\w* \w misericordia|strong="G1656"\w* \w de|strong="G1909"\w* \w Dios|strong="G2316"\w* estén \w con|strong="G1909"\w* \w todos|strong="G3745"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* viven \w de|strong="G1909"\w* acuerdo \w a|strong="G1909"\w* \w esta|strong="G3778"\w* \w regla|strong="G2583"\w*, \w y|strong="G2532"\w* \w con|strong="G1909"\w* \w el|strong="G3588"\w* \w Israel|strong="G2474"\w* \w de|strong="G1909"\w* \w Dios|strong="G2316"\w*.   
