\v 14 \w Yo|strong="G1473"\w* superaba \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w judaísmo|strong="G2454"\w* \w a|strong="G1722"\w* \w muchos|strong="G4183"\w* \w de|strong="G1722"\w* mis compatriotas \w de|strong="G1722"\w* \w mi|strong="G3588"\w* misma edad, \w y|strong="G2532"\w* \w era|strong="G5225"\w* \w mucho|strong="G4183"\w* \w más|strong="G2532"\w* fanático \w de|strong="G1722"\w* \w las|strong="G3588"\w* \w tradiciones|strong="G3862"\w* \w de|strong="G1722"\w* mis antepasados.  
\v 15 \w Pero|strong="G1161"\w* Dios \w me|strong="G1473"\w* apartó \w desde|strong="G1537"\w* \w el|strong="G3588"\w* \w vientre|strong="G2836"\w* \w de|strong="G1537"\w* \w mi|strong="G3588"\w* \w madre|strong="G3384"\w* \w y|strong="G2532"\w* \w me|strong="G1473"\w* \w llamó|strong="G2564"\w* \w por|strong="G1223"\w* \w su|strong="G3588"\w* \w gracia|strong="G5485"\w*. \w Cuando|strong="G3753"\w* \w a|strong="G1537"\w* \w él|strong="G3588"\w* le \w agradó|strong="G2106"\w*  
\v 16 revelar \w a|strong="G1722"\w* \w su|strong="G3588"\w* \w Hijo|strong="G5207"\w* \w en|strong="G1722"\w* \w mí|strong="G3588"\w* \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w yo|strong="G1473"\w* \w lo|strong="G3588"\w* predicara \w entre|strong="G1722"\w* \w los|strong="G3588"\w* \w no|strong="G3756"\w* judíos, \w no|strong="G3756"\w* fui \w de|strong="G1722"\w* inmediato \w a|strong="G1722"\w* consultar \w con|strong="G1722"\w* \w ningún|strong="G3756"\w* ser humano,  
\v 17 \w ni|strong="G3761"\w* subí \w a|strong="G1519"\w* Jerusalén \w para|strong="G1519"\w* ver \w a|strong="G1519"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* eran apóstoles \w antes|strong="G4253"\w* \w que|strong="G3588"\w* \w yo|strong="G1473"\w*; sino \w que|strong="G3588"\w* \w me|strong="G1473"\w* fui \w a|strong="G1519"\w* Arabia, \w y|strong="G2532"\w* \w después|strong="G2532"\w* regresé \w a|strong="G1519"\w* \w Damasco|strong="G1154"\w*.   
