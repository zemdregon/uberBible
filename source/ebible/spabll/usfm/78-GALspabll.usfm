\v 1 \w Pablo|strong="G3972"\w*, apóstol, \w no|strong="G3756"\w* \w por|strong="G1223"\w* encargo \w de|strong="G1537"\w* hombres \w ni|strong="G3761"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1537"\w* \w ningún|strong="G3756"\w* ser humano, sino \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1537"\w* \w Jesucristo|strong="G2424"\w* \w y|strong="G2532"\w* \w de|strong="G1537"\w* \w Dios|strong="G2316"\w* \w el|strong="G3588"\w* \w Padre|strong="G3962"\w*, \w que|strong="G3588"\w* \w lo|strong="G3588"\w* \w resucitó|strong="G1453"\w* \w de|strong="G1537"\w* \w entre|strong="G1537"\w* \w los|strong="G3588"\w* \w muertos|strong="G3498"\w*,  
