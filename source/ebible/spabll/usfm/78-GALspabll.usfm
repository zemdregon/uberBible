\v 21 \w envidias|strong="G5355"\w*, \w borracheras|strong="G3178"\w*, fiestas desenfrenadas \w y|strong="G2532"\w* \w cosas|strong="G3739"\w* \w por|strong="G3754"\w* \w el|strong="G3588"\w* estilo. Les advierto \w ahora|strong="G3739"\w*, \w como|strong="G2531"\w* \w ya|strong="G2532"\w* \w lo|strong="G3588"\w* hice \w antes|strong="G2532"\w*, \w que|strong="G3754"\w* \w los|strong="G3588"\w* \w que|strong="G3754"\w* practican \w tales|strong="G5108"\w* \w cosas|strong="G3739"\w* \w no|strong="G3756"\w* \w heredarán|strong="G2816"\w* \w el|strong="G3588"\w* reino \w de|strong="G3588"\w* \w Dios|strong="G2316"\w*.   
