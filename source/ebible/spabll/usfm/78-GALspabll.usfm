\v 4 \w Él|strong="G3588"\w* \w se|strong="G1438"\w* entregó \w a|strong="G1537"\w* \w sí|strong="G1438"\w* mismo \w por|strong="G5228"\w* nuestros pecados \w para|strong="G3704"\w* rescatarnos \w de|strong="G1537"\w* \w este|strong="G3588"\w* mundo \w malvado|strong="G4190"\w* \w en|strong="G2596"\w* \w el|strong="G3588"\w* \w que|strong="G3588"\w* vivimos, \w según|strong="G2596"\w* \w la|strong="G3588"\w* \w voluntad|strong="G2307"\w* \w de|strong="G1537"\w* \w nuestro|strong="G2249"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w Padre|strong="G3962"\w*,  
