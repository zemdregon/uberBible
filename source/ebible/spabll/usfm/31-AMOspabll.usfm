\mt1 Amós  
\c 1  
\p
\v 1 \w Las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* \w Amós|strong="H5986"\w*, \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* \w entre|strong="H5921"\w* \w los|strong="H1121"\w* pastores \w de|strong="H5921"\w* Tecoa, \w las|strong="H5921"\w* cuales \w tuvo|strong="H1961"\w* \w en|strong="H5921"\w* visión \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Uzías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w dos|strong="H3117"\w* \w años|strong="H8141"\w* \w antes|strong="H6440"\w* \w del|strong="H5921"\w* terremoto.  
\v 2 Dijo:  
\q1 “Yahvé \w rugirá|strong="H7580"\w* desde \w Sión|strong="H6726"\w*,  
\q2 y \w hará|strong="H5414"\w* oír su \w voz|strong="H6963"\w* desde Jerusalén;  
\q1 y los pastizales \w de|strong="H5414"\w* los \w pastores|strong="H7462"\w* estarán \w de|strong="H5414"\w* luto,  
\q2 y la cima del Carmelo se marchitará”.   
\p
\v 3 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Damasco|strong="H1834"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* han aplastado \w a|strong="H3068"\w* \w Galaad|strong="H1568"\w* \w con|strong="H5921"\w* trillos \w de|strong="H5921"\w* \w hierro|strong="H1270"\w*;   
\q1
\v 4 pero \w enviaré|strong="H7971"\w* fuego \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* de \w Hazael|strong="H2371"\w*,  
\q2 y devorará los palacios de Ben Hadad.   
\q1
\v 5 Romperé la tranca \w de|strong="H5971"\w* \w Damasco|strong="H1834"\w*,  
\q2 y eliminaré al habitante del valle \w de|strong="H5971"\w* Avén,  
\q2 y al \w que|strong="H5971"\w* tiene \w el|strong="H3427"\w* \w cetro|strong="H7626"\w* \w de|strong="H5971"\w* la \w casa|strong="H1004"\w* \w de|strong="H5971"\w* Edén;  
\q2 y \w el|strong="H3427"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Siria irá en cautiverio \w a|strong="H3068"\w* Kir”,  
\p dice Yahvé.   
\p
\v 6 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Gaza|strong="H5804"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* \w se|strong="H5921"\w* llevaron \w cautivos|strong="H1540"\w* \w a|strong="H3068"\w* pueblos enteros,  
\q2 \w para|strong="H5921"\w* entregarlos \w a|strong="H3068"\w* Edom;   
\q1
\v 7 pero \w enviaré|strong="H7971"\w* fuego sobre la muralla de \w Gaza|strong="H5804"\w*,  
\q2 y devorará sus palacios.   
\q1
\v 8 Eliminaré \w al|strong="H5921"\w* habitante \w de|strong="H5921"\w* Asdod,  
\q2 \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w que|strong="H5921"\w* tiene \w el|strong="H5921"\w* \w cetro|strong="H7626"\w* \w de|strong="H5921"\w* Ascalón;  
\q1 \w y|strong="H5921"\w* \w volveré|strong="H7725"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w Ecrón|strong="H6138"\w*;  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w resto|strong="H7611"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w* \w perecerá|strong="H3772"\w*”,  
\p dice \w el|strong="H5921"\w* Señor Yahvé.   
\p
\v 9 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Tiro|strong="H6865"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo;  
\q2 \w porque|strong="H5921"\w* \w entregaron|strong="H5462"\w* \w a|strong="H3068"\w* un pueblo entero \w a|strong="H3068"\w* Edom,  
\q2 \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* acordaron \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w entre|strong="H5921"\w* hermanos;   
\q1
\v 10 pero \w enviaré|strong="H7971"\w* fuego sobre la muralla de \w Tiro|strong="H6865"\w*,  
\q2 y devorará sus palacios”.   
\p
\v 11 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* Edom, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* \w persiguió|strong="H7291"\w* \w a|strong="H3068"\w* su hermano \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*  
\q2 \w y|strong="H5921"\w* hizo \w a|strong="H3068"\w* un lado \w toda|strong="H5921"\w* compasión,  
\q2 su enojo \w no|strong="H3808"\w* cesaba,  
\q2 \w y|strong="H5921"\w* mantuvo su furia \w para|strong="H5921"\w* \w siempre|strong="H5703"\w*;   
\q1
\v 12 pero \w enviaré|strong="H7971"\w* fuego sobre \w Temán|strong="H8487"\w*,  
\q2 y devorará los palacios de \w Bosra|strong="H1224"\w*”.   
\p
\v 13 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Amón, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* \w les|strong="H5921"\w* \w abrieron|strong="H1234"\w* \w el|strong="H5921"\w* vientre \w a|strong="H3068"\w* \w las|strong="H5921"\w* mujeres embarazadas \w de|strong="H5921"\w* \w Galaad|strong="H1568"\w*,  
\q2 \w para|strong="H4616"\w* poder agrandar su territorio.   
\q1
\v 14 Pero yo encenderé fuego en la muralla de Rabá,  
\q2 y devorará sus palacios,  
\q2 con \w gritos|strong="H8643"\w* en el \w día|strong="H3117"\w* de la \w batalla|strong="H4421"\w*,  
\q2 con una tormenta en el \w día|strong="H3117"\w* del \w torbellino|strong="H5492"\w*;   
\q1
\v 15 y \w su|strong="H1931"\w* \w rey|strong="H4428"\w* \w irá|strong="H1980"\w* \w al|strong="H4428"\w* \w cautiverio|strong="H1473"\w*,  
\q2 \w él|strong="H1931"\w* \w junto|strong="H3162"\w* con \w sus|strong="H1931"\w* líderes”,  
\p dice Yahvé.   
\c 2  
\p
\v 1 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* \w quemó|strong="H8313"\w* \w los|strong="H5921"\w* \w huesos|strong="H6106"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Edom \w hasta|strong="H5921"\w* hacerlos ceniza;   
\q1
\v 2 pero \w enviaré|strong="H7971"\w* fuego sobre \w Moab|strong="H4124"\w*,  
\q2 y devorará los palacios de Queriot;  
\q2 y \w Moab|strong="H4124"\w* \w morirá|strong="H4191"\w* en medio del tumulto, entre \w gritos|strong="H8643"\w* y el \w sonido|strong="H6963"\w* de \w trompeta|strong="H7782"\w*;   
\q1
\v 3 y eliminaré \w al|strong="H7130"\w* \w juez|strong="H8199"\w* \w de|strong="H5973"\w* \w entre|strong="H7130"\w* \w ellos|strong="H3605"\w*,  
\q2 y \w mataré|strong="H2026"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w príncipes|strong="H8269"\w* \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*”,  
\p dice Yahvé.   
\p
\v 4 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* han rechazado \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* Yahvé,  
\q2 \w y|strong="H5921"\w* \w no|strong="H3808"\w* han obedecido sus \w mandamientos|strong="H2706"\w*,  
\q2 \w y|strong="H5921"\w* sus \w mentiras|strong="H3577"\w* \w los|strong="H5921"\w* han desviado \w del|strong="H5921"\w* \w camino|strong="H1980"\w*,  
\q2 \w las|strong="H5921"\w* mismas \w mentiras|strong="H3577"\w* \w que|strong="H3808"\w* \w siguieron|strong="H1980"\w* sus antepasados;   
\q1
\v 5 pero \w enviaré|strong="H7971"\w* fuego sobre \w Judá|strong="H3063"\w*,  
\q2 y devorará los palacios de Jerusalén”.   
\p
\v 6 Yahvé dice:  
\q1 “\w Por|strong="H5921"\w* \w tres|strong="H7969"\w* \w pecados|strong="H6588"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w hasta|strong="H5921"\w* \w por|strong="H5921"\w* cuatro,  
\q2 \w no|strong="H3808"\w* retiraré su castigo,  
\q2 \w porque|strong="H5921"\w* han vendido \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w justos|strong="H6662"\w* \w por|strong="H5921"\w* \w dinero|strong="H3701"\w*,  
\q2 \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* necesitados \w por|strong="H5921"\w* un par \w de|strong="H5921"\w* sandalias;   
\q2
\v 7 Pisotean \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pobres|strong="H1800"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tierra|strong="H6083"\w*  
\q2 \w y|strong="H5921"\w* \w les|strong="H5921"\w* niegan \w la|strong="H5921"\w* justicia \w a|strong="H3068"\w* \w los|strong="H5921"\w* oprimidos.  
\q1 \w El|strong="H5921"\w* hijo \w y|strong="H5921"\w* \w el|strong="H5921"\w* padre \w se|strong="H5921"\w* acuestan \w con|strong="H5921"\w* \w la|strong="H5921"\w* misma mujer, \w profanando|strong="H2490"\w* \w mi|strong="H5921"\w* \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*.   
\q2
\v 8 \w Se|strong="H5921"\w* acuestan \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w altar|strong="H4196"\w* \w sobre|strong="H5921"\w* ropas recibidas \w en|strong="H5921"\w* garantía.  
\q2 \w En|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* su Dios \w beben|strong="H8354"\w* \w el|strong="H5921"\w* \w vino|strong="H3196"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* fueron multados.   
\q1
\v 9 Sin embargo, yo \w destruí|strong="H8045"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* amorreos \w delante|strong="H6440"\w* \w de|strong="H8478"\w* \w ellos|strong="H1931"\w*,  
\q2 \w que|strong="H1931"\w* eran altos \w como|strong="H8478"\w* cedros  
\q2 y fuertes \w como|strong="H8478"\w* robles;  
\q2 yo \w destruí|strong="H8045"\w* \w su|strong="H1931"\w* \w fruto|strong="H6529"\w* \w arriba|strong="H4605"\w*  
\q2 y \w sus|strong="H1931"\w* \w raíces|strong="H8328"\w* \w abajo|strong="H8478"\w*.   
\q1
\v 10 También \w a|strong="H3068"\w* ustedes los \w saqué|strong="H5927"\w* de \w Egipto|strong="H4714"\w*  
\q2 y los guié cuarenta \w años|strong="H8141"\w* por el \w desierto|strong="H4057"\w*,  
\q2 para que tomaran posesión de la tierra del amorreo.   
\q1
\v 11 Yo levanté \w a|strong="H3068"\w* algunos \w de|strong="H1121"\w* sus \w hijos|strong="H1121"\w* como \w profetas|strong="H5030"\w*,  
\q2 y \w a|strong="H3068"\w* algunos \w de|strong="H1121"\w* sus jóvenes como nazireos.  
\q1 ¿No \w es|strong="H2063"\w* \w esto|strong="H2063"\w* verdad,  
\q2 \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*?”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 12 “Pero ustedes \w les|strong="H5921"\w* dieron \w de|strong="H5921"\w* \w beber|strong="H8248"\w* \w vino|strong="H3196"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* nazireos,  
\q2 \w y|strong="H5921"\w* \w les|strong="H5921"\w* ordenaron \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w*: “¡\w No|strong="H3808"\w* profeticen!”.   
\q1
\v 13 Pues miren, \w yo|strong="H2009"\w* los voy \w a|strong="H3068"\w* aplastar,  
\q2 \w como|strong="H8478"\w* aplasta un \w carro|strong="H5699"\w* cargado \w de|strong="H8478"\w* grano.   
\q1
\v 14 El \w más|strong="H3808"\w* rápido \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* huir,  
\q2 el \w fuerte|strong="H2389"\w* \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* usar su \w fuerza|strong="H3581"\w*,  
\q2 \w ni|strong="H3808"\w* el \w valiente|strong="H1368"\w* \w podrá|strong="H3808"\w* salvarse.   
\q1
\v 15 El arquero \w no|strong="H3808"\w* \w se|strong="H3808"\w* mantendrá firme,  
\q2 el de \w pies|strong="H7272"\w* \w ligeros|strong="H7031"\w* \w no|strong="H3808"\w* \w escapará|strong="H4422"\w*,  
\q2 \w ni|strong="H3808"\w* el \w que|strong="H3808"\w* \w monta|strong="H7392"\w* \w a|strong="H3068"\w* \w caballo|strong="H5483"\w* \w se|strong="H3808"\w* \w salvará|strong="H4422"\w*.   
\q1
\v 16 \w El|strong="H1931"\w* más \w valiente|strong="H1368"\w* entre \w los|strong="H1931"\w* guerreros  
\q2 \w huirá|strong="H5127"\w* \w desnudo|strong="H6174"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*”,  
\p \w dice|strong="H5002"\w* Yahvé.   
\c 3  
\p
\v 1 \w Escuchen|strong="H8085"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé ha pronunciado \w contra|strong="H5921"\w* ustedes, \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w contra|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w familia|strong="H4940"\w* \w que|strong="H5921"\w* \w saqué|strong="H5927"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*:   
\q1
\v 2 “\w Solo|strong="H7535"\w* \w a|strong="H3068"\w* ustedes \w los|strong="H5921"\w* he elegido \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w familias|strong="H4940"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra;  
\q2 \w por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w los|strong="H5921"\w* castigaré \w por|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w pecados|strong="H5771"\w*”.   
\q1
\v 3 ¿Caminan \w dos|strong="H8147"\w* \w juntos|strong="H3162"\w* si \w no|strong="H1115"\w* se han puesto de acuerdo?   
\q1
\v 4 ¿Ruge el león en la selva si \w no|strong="H1115"\w* tiene una presa?  
\q2 ¿Gruñe el cachorro \w de|strong="H5414"\w* león desde su cueva si \w no|strong="H1115"\w* ha atrapado nada?   
\q1
\v 5 ¿\w Cae|strong="H5307"\w* un \w pájaro|strong="H6833"\w* \w en|strong="H5921"\w* una trampa \w en|strong="H5921"\w* \w el|strong="H5921"\w* suelo \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w ha|strong="H3808"\w* \w puesto|strong="H5927"\w* un cebo?  
\q2 ¿\w Se|strong="H5921"\w* dispara una trampa \w del|strong="H4480"\w* suelo \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* atrapado \w algo|strong="H3920"\w*?   
\q1
\v 6 ¿Suena la \w trompeta|strong="H7782"\w* \w de|strong="H5971"\w* alarma en una \w ciudad|strong="H5892"\w* \w sin|strong="H3808"\w* \w que|strong="H3808"\w* la \w gente|strong="H5971"\w* \w se|strong="H1961"\w* asuste?  
\q2 ¿Le sucede un \w mal|strong="H7451"\w* \w a|strong="H3068"\w* una \w ciudad|strong="H5892"\w* \w sin|strong="H3808"\w* \w que|strong="H3808"\w* Yahvé \w lo|strong="H3808"\w* \w haya|strong="H1961"\w* enviado?   
\q1
\v 7 \w Ciertamente|strong="H3588"\w*, \w el|strong="H3588"\w* Señor Yahvé \w no|strong="H3808"\w* \w hace|strong="H6213"\w* \w nada|strong="H3808"\w*  
\q2 \w sin|strong="H3808"\w* revelar \w su|strong="H3588"\w* plan \w a|strong="H3068"\w* sus \w siervos|strong="H5650"\w* \w los|strong="H3588"\w* \w profetas|strong="H5030"\w*.   
\q1
\v 8 \w El|strong="H4310"\w* león \w ha|strong="H3808"\w* rugido, ¿\w quién|strong="H4310"\w* \w no|strong="H3808"\w* tendrá \w miedo|strong="H3372"\w*?  
\q2 \w El|strong="H4310"\w* Señor Yahvé \w ha|strong="H3808"\w* \w hablado|strong="H1696"\w*, ¿\w quién|strong="H4310"\w* puede negarse \w a|strong="H3068"\w* profetizar?   
\q1
\v 9 Anuncien \w en|strong="H5921"\w* \w los|strong="H5921"\w* palacios \w de|strong="H5921"\w* Asdod \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* palacios \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*:  
\q2 “Reúnanse \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w de|strong="H5921"\w* \w Samaria|strong="H8111"\w*,  
\q2 \w y|strong="H5921"\w* \w vean|strong="H7200"\w* \w el|strong="H5921"\w* \w gran|strong="H7227"\w* desorden \w que|strong="H5921"\w* hay \w en|strong="H5921"\w* \w ella|strong="H5921"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* opresión \w que|strong="H5921"\w* sufre su \w pueblo|strong="H7227"\w*”.   
\q1
\v 10 “Ellos \w no|strong="H3808"\w* \w saben|strong="H3045"\w* \w hacer|strong="H6213"\w* \w lo|strong="H3808"\w* correcto”, \w dice|strong="H5002"\w* Yahvé,  
\q2 “pues acumulan en sus palacios \w lo|strong="H3808"\w* \w que|strong="H3808"\w* roban y arrebatan”.   
\p
\v 11 \w Por|strong="H4480"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice el Señor Yahvé:  
\q1 “Un \w enemigo|strong="H6862"\w* invadirá el país,  
\q2 derribará tus fortalezas  
\q2 \w y|strong="H3541"\w* saqueará tus palacios”.   
\p
\v 12 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “\w Como|strong="H3651"\w* \w el|strong="H1121"\w* \w pastor|strong="H7462"\w* rescata \w de|strong="H1121"\w* la \w boca|strong="H6310"\w* del león apenas \w dos|strong="H8147"\w* patas \w o|strong="H3068"\w* un pedazo \w de|strong="H1121"\w* oreja,  
\q2 \w así|strong="H3541"\w* \w serán|strong="H6310"\w* rescatados \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1121"\w* viven en \w Samaria|strong="H8111"\w*,  
\q2 \w los|strong="H3427"\w* \w que|strong="H1121"\w* \w ahora|strong="H3541"\w* \w se|strong="H3651"\w* reclinan en la esquina \w de|strong="H1121"\w* un sofá \w y|strong="H3541"\w* en cojines \w de|strong="H1121"\w* seda”.   
\p
\v 13 “\w Escuchen|strong="H8085"\w* y den testimonio contra la \w familia|strong="H1004"\w* de \w Jacob|strong="H3290"\w*”, \w dice|strong="H5002"\w* el Señor Yahvé, el \w Dios|strong="H3069"\w* de los \w Ejércitos|strong="H6635"\w*:   
\q1
\v 14 “\w El|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* pida cuentas \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w por|strong="H5921"\w* sus \w pecados|strong="H6588"\w*,  
\q2 destruiré también \w los|strong="H5921"\w* \w altares|strong="H4196"\w* \w de|strong="H5921"\w* Betel;  
\q2 \w los|strong="H5921"\w* \w cuernos|strong="H7161"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w* serán cortados \w y|strong="H3588"\w* \w caerán|strong="H5307"\w* \w por|strong="H5921"\w* tierra.   
\q1
\v 15 Derribaré \w tanto|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* invierno \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w de|strong="H5921"\w* \w verano|strong="H7019"\w*;  
\q2 \w las|strong="H5921"\w* \w casas|strong="H1004"\w* decoradas \w con|strong="H5921"\w* \w marfil|strong="H8127"\w* serán destruidas,  
\q2 \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w grandes|strong="H7227"\w* mansiones llegarán \w a|strong="H3068"\w* su \w fin|strong="H7019"\w*”,  
\p \w dice|strong="H5002"\w* Yahvé.   
\c 4  
\p
\v 1 \w Escuchen|strong="H8085"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w*, \w vacas|strong="H6510"\w* \w de|strong="H1697"\w* \w Basán|strong="H1316"\w*, \w que|strong="H1697"\w* viven en el \w monte|strong="H2022"\w* \w de|strong="H1697"\w* \w Samaria|strong="H8111"\w*, ustedes \w que|strong="H1697"\w* oprimen \w a|strong="H3068"\w* los \w pobres|strong="H1800"\w*, \w que|strong="H1697"\w* aplastan \w a|strong="H3068"\w* los necesitados, y \w que|strong="H1697"\w* les dicen \w a|strong="H3068"\w* sus esposos: “¡Traigan \w algo|strong="H1697"\w* \w de|strong="H1697"\w* \w beber|strong="H8354"\w*!”.   
\q1
\v 2 \w El|strong="H5921"\w* Señor Yahvé ha \w jurado|strong="H7650"\w* \w por|strong="H5921"\w* \w su|strong="H3588"\w* \w santidad|strong="H6944"\w*:  
\q2 “Vienen \w días|strong="H3117"\w* \w sobre|strong="H5921"\w* ustedes \w en|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* \w las|strong="H5921"\w* \w llevarán|strong="H5375"\w* \w con|strong="H5921"\w* garfios,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* últimas \w de|strong="H5921"\w* ustedes \w con|strong="H5921"\w* anzuelos \w de|strong="H5921"\w* pesca.   
\q1
\v 3 \w Saldrán|strong="H3318"\w* por las brechas \w de|strong="H5048"\w* la muralla, cada una \w de|strong="H5048"\w* \w frente|strong="H5048"\w* hacia adelante,  
\q2 y las \w arrojarán|strong="H7993"\w* hacia el Harmon”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 4 “Vayan \w a|strong="H3068"\w* Betel y pequen;  
\q2 vayan \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w* y pequen todavía \w más|strong="H7235"\w*.  
\q1 Traigan sus \w sacrificios|strong="H2077"\w* \w cada|strong="H3117"\w* \w mañana|strong="H1242"\w*,  
\q2 y sus diezmos \w cada|strong="H3117"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*.   
\q2
\v 5 Ofrezcan sacrificios \w de|strong="H3588"\w* gratitud \w con|strong="H3588"\w* pan \w con|strong="H3588"\w* levadura,  
\q2 \w y|strong="H3588"\w* anuncien sus ofrendas \w voluntarias|strong="H5071"\w*; presuman \w de|strong="H3588"\w* ellas,  
\q2 \w porque|strong="H3588"\w* \w eso|strong="H3651"\w* \w es|strong="H3588"\w* lo \w que|strong="H3588"\w* \w a|strong="H3068"\w* ustedes les gusta, \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor Yahvé.   
\q1
\v 6 “Yo hice \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w quedaran|strong="H5414"\w* \w sin|strong="H3808"\w* \w nada|strong="H3808"\w* \w que|strong="H3808"\w* comer \w en|strong="H5704"\w* \w todas|strong="H3605"\w* sus \w ciudades|strong="H5892"\w*,  
\q2 \w y|strong="H1571"\w* \w que|strong="H3808"\w* faltara \w el|strong="H3605"\w* \w pan|strong="H3899"\w* \w en|strong="H5704"\w* \w todos|strong="H3605"\w* sus pueblos;  
\q2 pero ustedes \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* mí”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 7 “\w También|strong="H1571"\w* \w les|strong="H5921"\w* negué \w la|strong="H5921"\w* \w lluvia|strong="H1653"\w*  
\q2 \w cuando|strong="H1571"\w* \w todavía|strong="H5750"\w* faltaban \w tres|strong="H7969"\w* \w meses|strong="H2320"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* cosecha;  
\q2 hice \w que|strong="H4480"\w* lloviera \w en|strong="H5921"\w* una \w ciudad|strong="H5892"\w*  
\q2 \w y|strong="H1571"\w* \w en|strong="H5921"\w* \w otra|strong="H5750"\w* \w no|strong="H3808"\w*.  
\q1 \w En|strong="H5921"\w* un campo \w llovió|strong="H4305"\w*,  
\q2 pero \w el|strong="H5921"\w* campo \w donde|strong="H5921"\w* \w no|strong="H3808"\w* \w llovió|strong="H4305"\w* \w se|strong="H5921"\w* marchitó.   
\q1
\v 8 Así \w que|strong="H3808"\w* \w la|strong="H7646"\w* gente \w de|strong="H5704"\w* \w dos|strong="H8147"\w* \w o|strong="H3068"\w* \w tres|strong="H7969"\w* \w ciudades|strong="H5892"\w* iba \w a|strong="H3068"\w* otra \w para|strong="H5704"\w* \w beber|strong="H8354"\w* \w agua|strong="H4325"\w*,  
\q2 \w y|strong="H5704"\w* \w no|strong="H3808"\w* lograban calmar su sed;  
\q2 pero ustedes \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* mí”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 9 “\w Muchas|strong="H7235"\w* veces castigué sus \w huertos|strong="H1593"\w* \w y|strong="H5704"\w* viñedos \w con|strong="H5704"\w* plagas \w y|strong="H5704"\w* moho,  
\q2 \w y|strong="H5704"\w* las langostas devoraron sus \w higueras|strong="H8384"\w* \w y|strong="H5704"\w* sus olivos;  
\q2 pero ustedes \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* mí”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 10 “Mandé \w contra|strong="H5973"\w* ustedes plagas \w como|strong="H5973"\w* las \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*.  
\q2 \w Maté|strong="H2026"\w* \w a|strong="H3068"\w* sus jóvenes \w con|strong="H5973"\w* la \w espada|strong="H2719"\w*  
\q2 \w y|strong="H5704"\w* permití \w que|strong="H3808"\w* \w se|strong="H3808"\w* llevaran sus \w caballos|strong="H5483"\w*.  
\q1 Hice \w que|strong="H3808"\w* \w el|strong="H5973"\w* mal olor \w de|strong="H5973"\w* sus \w campamentos|strong="H4264"\w* \w les|strong="H5973"\w* llegara \w hasta|strong="H5704"\w* la nariz,  
\q2 pero ustedes \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* mí”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 11 “\w A|strong="H3068"\w* algunos \w de|strong="H5704"\w* ustedes \w los|strong="H1961"\w* destruí,  
\q2 \w como|strong="H1961"\w* \w cuando|strong="H5704"\w* \w Dios|strong="H3068"\w* destruyó \w a|strong="H3068"\w* \w Sodoma|strong="H5467"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w Gomorra|strong="H6017"\w*;  
\q2 \w quedaron|strong="H1961"\w* \w como|strong="H1961"\w* un palo ardiendo sacado del fuego,  
\q2 pero ustedes \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 12 “\w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w Israel|strong="H3478"\w*, voy \w a|strong="H3068"\w* actuar \w así|strong="H3541"\w* contigo;  
\q2 \w y|strong="H3588"\w* \w como|strong="H3588"\w* voy \w a|strong="H3068"\w* hacerlo,  
\q2 ¡prepárate, \w Israel|strong="H3478"\w*, \w para|strong="H3588"\w* enfrentarte \w con|strong="H3588"\w* \w tu|strong="H6213"\w* Dios!”.   
\q1
\v 13 \w Porque|strong="H3588"\w* miren: \w él|strong="H5921"\w* \w es|strong="H3588"\w* \w quien|strong="H4100"\w* forma \w las|strong="H5921"\w* montañas \w y|strong="H3588"\w* \w crea|strong="H1254"\w* \w el|strong="H5921"\w* \w viento|strong="H7307"\w*;  
\q2 \w él|strong="H5921"\w* revela \w al|strong="H5921"\w* hombre sus pensamientos,  
\q2 convierte \w el|strong="H5921"\w* amanecer \w en|strong="H5921"\w* \w oscuridad|strong="H5890"\w* \w y|strong="H3588"\w* camina \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* alturas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\q2 Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w es|strong="H3588"\w* \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*.   
\c 5  
\p
\v 1 \w Escuchad|strong="H8085"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w que|strong="H5921"\w* yo entono \w como|strong="H5921"\w* lamento \w por|strong="H5921"\w* \w vosotros|strong="H8085"\w*, \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*:   
\q1
\v 2 “\w La|strong="H5921"\w* \w virgen|strong="H1330"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w ha|strong="H3808"\w* \w caído|strong="H5307"\w*;  
\q2 \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w levantará|strong="H6965"\w* \w más|strong="H3254"\w*.  
\q1 \w Está|strong="H6965"\w* abatida \w en|strong="H5921"\w* su tierra;  
\q2 \w no|strong="H3808"\w* hay \w nadie|strong="H3808"\w* \w que|strong="H3808"\w* \w la|strong="H5921"\w* levante”.   
\p
\v 3 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice \w el|strong="H3588"\w* Señor Yahvé:  
\q1 “\w A|strong="H3068"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w que|strong="H3588"\w* \w salía|strong="H3318"\w* \w con|strong="H3588"\w* \w mil|strong="H3967"\w*, le quedarán \w cien|strong="H3967"\w*;  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w que|strong="H3588"\w* \w salía|strong="H3318"\w* \w con|strong="H3588"\w* \w cien|strong="H3967"\w*, le quedarán \w diez|strong="H6235"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 4 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*:  
\q1 “\w Buscadme|strong="H1875"\w* \w y|strong="H3588"\w* viviréis;   
\q1
\v 5 \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w busquéis|strong="H1875"\w* \w a|strong="H3068"\w* Betel,  
\q2 \w ni|strong="H3808"\w* entréis \w en|strong="H3588"\w* \w Gilgal|strong="H1537"\w*,  
\q2 \w ni|strong="H3808"\w* \w paséis|strong="H5674"\w* \w a|strong="H3068"\w* Beerseba;  
\q1 \w porque|strong="H3588"\w* \w Gilgal|strong="H1537"\w* irá \w ciertamente|strong="H3588"\w* al cautiverio,  
\q2 \w y|strong="H3588"\w* Betel \w será|strong="H1961"\w* reducida \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w nada|strong="H3808"\w*”.   
\q1
\v 6 \w Buscad|strong="H1875"\w* \w a|strong="H3068"\w* Yahvé y viviréis,  
\q2 para \w que|strong="H6435"\w* \w no|strong="H6435"\w* estalle como fuego en la \w casa|strong="H1004"\w* de \w José|strong="H3130"\w*,  
\q2 y la devore sin \w que|strong="H6435"\w* haya en Betel quien lo apague.   
\q1
\v 7 ¡Ay de los que convertís el \w derecho|strong="H4941"\w* en ajenjo,  
\q2 y echáis por tierra la \w justicia|strong="H6666"\w*!   
\q1
\v 8 Buscad \w al|strong="H5921"\w* \w que|strong="H5921"\w* \w hizo|strong="H6213"\w* \w las|strong="H5921"\w* Pléyades \w y|strong="H5921"\w* \w el|strong="H5921"\w* Orión,  
\q2 \w el|strong="H5921"\w* \w que|strong="H5921"\w* convierte \w las|strong="H5921"\w* tinieblas \w en|strong="H5921"\w* aurora  
\q2 \w y|strong="H5921"\w* \w hace|strong="H6213"\w* \w oscurecer|strong="H2821"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w noche|strong="H3915"\w*;  
\q2 \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w llama|strong="H7121"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*  
\q2 \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w derrama|strong="H8210"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra: Yahvé es su \w nombre|strong="H8034"\w*.   
\q1
\v 9 \w Él|strong="H5921"\w* trae \w la|strong="H5921"\w* \w destrucción|strong="H7701"\w* repentina \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w fuerte|strong="H5794"\w*,  
\q2 \w de|strong="H5921"\w* modo \w que|strong="H5921"\w* \w la|strong="H5921"\w* ruina caiga \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w fortaleza|strong="H4013"\w*.   
\q1
\v 10 Odian al que \w reprende|strong="H3198"\w* \w en|strong="H8549"\w* la \w puerta|strong="H8179"\w* de la ciudad,  
\q2 y \w aborrecen|strong="H8130"\w* al que \w habla|strong="H1696"\w* con integridad.   
\q1
\v 11 \w Por|strong="H5921"\w* \w tanto|strong="H3651"\w*, ya \w que|strong="H4480"\w* pisoteáis \w al|strong="H5921"\w* \w pobre|strong="H1800"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* cobráis tributo \w de|strong="H4480"\w* \w trigo|strong="H1250"\w*,  
\q2 \w habéis|strong="H8354"\w* construido \w casas|strong="H1004"\w* \w de|strong="H4480"\w* piedra labrada, pero \w no|strong="H3808"\w* \w habitaréis|strong="H3427"\w* \w en|strong="H5921"\w* \w ellas|strong="H5921"\w*;  
\q1 \w habéis|strong="H8354"\w* \w plantado|strong="H5193"\w* viñedos hermosos,  
\q2 pero \w no|strong="H3808"\w* \w beberéis|strong="H8354"\w* su \w vino|strong="H3196"\w*.   
\q1
\v 12 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w cuán|strong="H3588"\w* numerosas \w son|strong="H3588"\w* vuestras \w rebeliones|strong="H6588"\w*  
\q2 \w y|strong="H3588"\w* \w cuán|strong="H3588"\w* \w grandes|strong="H7227"\w* vuestros \w pecados|strong="H2403"\w*;  
\q2 oprimís al \w justo|strong="H6662"\w*, recibís soborno  
\q2 \w y|strong="H3588"\w* rechazáis \w a|strong="H3068"\w* \w los|strong="H3588"\w* pobres \w en|strong="H3588"\w* \w los|strong="H3588"\w* tribunales.   
\q1
\v 13 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w es|strong="H1931"\w* \w prudente|strong="H7919"\w* calla \w en|strong="H3588"\w* \w tales|strong="H3651"\w* \w tiempos|strong="H6256"\w*,  
\q2 \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w es|strong="H1931"\w* \w malo|strong="H7451"\w*.   
\q1
\v 14 \w Buscad|strong="H1875"\w* el \w bien|strong="H2896"\w* y \w no|strong="H1961"\w* el \w mal|strong="H7451"\w*,  
\q2 \w para|strong="H4616"\w* \w que|strong="H1961"\w* \w viváis|strong="H2421"\w*;  
\q2 y \w así|strong="H3651"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H7451"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*, \w estará|strong="H1961"\w* con vosotros,  
\q2 \w tal|strong="H3651"\w* \w como|strong="H1961"\w* decís.   
\q1
\v 15 Odiad el \w mal|strong="H7451"\w* y amad el \w bien|strong="H2896"\w*,  
\q2 y estableced la \w justicia|strong="H4941"\w* en los tribunales;  
\q2 quizá Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H7451"\w* los \w Ejércitos|strong="H6635"\w*, tenga piedad del remanente \w de|strong="H7451"\w* \w José|strong="H3130"\w*.   
\p
\v 16 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H3605"\w* \w Señor|strong="H3068"\w*:  
\q1 “En \w todas|strong="H3605"\w* las \w plazas|strong="H7339"\w* habrá \w llanto|strong="H4553"\w*,  
\q2 \w y|strong="H3541"\w* en \w todas|strong="H3605"\w* las \w calles|strong="H7339"\w* dirán: ‘¡\w Ay|strong="H1930"\w*! ¡\w Ay|strong="H1930"\w*!’.  
\q2 \w Llamarán|strong="H7121"\w* al labrador al luto,  
\q2 \w y|strong="H3541"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3045"\w* son expertos en lamentos, \w a|strong="H3068"\w* \w la|strong="H3605"\w* lamentación.   
\q1
\v 17 \w En|strong="H3588"\w* \w todas|strong="H3605"\w* las \w viñas|strong="H3754"\w* habrá \w llanto|strong="H4553"\w*,  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w pasaré|strong="H5674"\w* \w por|strong="H3588"\w* \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ti”, dice Yahvé.   
\q1
\v 18 “¡\w Ay|strong="H1945"\w* de \w los|strong="H1931"\w* \w que|strong="H4100"\w* deseáis \w el|strong="H1931"\w* \w día|strong="H3117"\w* de Yahvé!  
\q2 ¿Para \w qué|strong="H4100"\w* queréis \w el|strong="H1931"\w* \w día|strong="H3117"\w* de Yahvé?  
\q1 \w Será|strong="H1931"\w* de \w tinieblas|strong="H2822"\w*  
\q2 y \w no|strong="H3808"\w* de luz.   
\q1
\v 19 Será \w como|strong="H5921"\w* \w si|strong="H6440"\w* un hombre huyera \w delante|strong="H6440"\w* \w de|strong="H5921"\w* un león  
\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* encontrara \w con|strong="H5921"\w* un \w oso|strong="H1677"\w*;  
\q1 \w o|strong="H3068"\w* \w como|strong="H5921"\w* \w si|strong="H6440"\w* entrara \w en|strong="H5921"\w* \w casa|strong="H1004"\w*, apoyara su \w mano|strong="H3027"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w pared|strong="H7023"\w*  
\q2 \w y|strong="H5921"\w* \w le|strong="H5921"\w* mordiera una \w serpiente|strong="H5175"\w*.   
\q1
\v 20 ¿\w No|strong="H3808"\w* \w será|strong="H3808"\w* el \w día|strong="H3117"\w* de Yahvé \w oscuridad|strong="H2822"\w* y \w no|strong="H3808"\w* luz?  
\q2 ¿\w No|strong="H3808"\w* \w será|strong="H3808"\w* sombra densa, \w sin|strong="H3808"\w* \w nada|strong="H3808"\w* de \w resplandor|strong="H5051"\w*?   
\q1
\v 21 Detesto y rechazo vuestras fiestas,  
\q2 y \w no|strong="H3808"\w* me agradan vuestras asambleas solemnes.   
\q1
\v 22 \w Aunque|strong="H3588"\w* \w me|strong="H3588"\w* ofrezcáis vuestros \w holocaustos|strong="H5930"\w* \w y|strong="H3588"\w* vuestras ofrendas \w de|strong="H3588"\w* grano,  
\q2 \w no|strong="H3808"\w* \w los|strong="H3588"\w* aceptaré;  
\q2 \w ni|strong="H3808"\w* \w miraré|strong="H5027"\w* las ofrendas \w de|strong="H3588"\w* paz \w de|strong="H3588"\w* vuestros animales cebados.   
\q1
\v 23 Aleja \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w el|strong="H5921"\w* estrépito \w de|strong="H5921"\w* tus cánticos,  
\q2 pues \w no|strong="H3808"\w* \w escucharé|strong="H8085"\w* \w la|strong="H5921"\w* \w música|strong="H7892"\w* \w de|strong="H5921"\w* tus arpas.   
\q1
\v 24 Pero corra el \w derecho|strong="H4941"\w* como el \w agua|strong="H4325"\w*,  
\q2 y la \w justicia|strong="H6666"\w* como un \w torrente|strong="H5158"\w* inagotable.   
\p
\v 25 ¿Me ofrecisteis \w sacrificios|strong="H2077"\w* y ofrendas en \w el|strong="H5066"\w* \w desierto|strong="H4057"\w* durante cuarenta \w años|strong="H8141"\w*, \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*?  
\v 26 Antes bien, llevasteis la tienda de vuestro \w rey|strong="H6213"\w* y \w el|strong="H6213"\w* pedestal de vuestras \w imágenes|strong="H6754"\w*, la \w estrella|strong="H3556"\w* de vuestro dios que os fabricasteis.  
\v 27 Por tanto, os haré ir al cautiverio más \w allá|strong="H1973"\w* de \w Damasco|strong="H1834"\w*”, dice Yahvé, cuyo \w nombre|strong="H8034"\w* es \w Dios|strong="H3068"\w* de los \w Ejércitos|strong="H6635"\w*.   
\c 6  
\p
\v 1 ¡\w Ay|strong="H1945"\w* de \w los|strong="H1992"\w* \w que|strong="H1992"\w* viven tranquilos en \w Sión|strong="H6726"\w*,  
\q2 y de \w los|strong="H1992"\w* \w que|strong="H1992"\w* \w se|strong="H1992"\w* sienten seguros en \w el|strong="H1992"\w* \w monte|strong="H2022"\w* de \w Samaria|strong="H8111"\w*!  
\q2 Ustedes, \w los|strong="H1992"\w* personajes importantes de la \w nación|strong="H1471"\w* principal,  
\q2 \w a|strong="H3068"\w* quienes \w el|strong="H1992"\w* \w pueblo|strong="H1992"\w* de \w Israel|strong="H3478"\w* acude en busca de ayuda.   
\q1
\v 2 \w Vayan|strong="H3212"\w* \w a|strong="H3068"\w* Calne y miren;  
\q2 \w de|strong="H4480"\w* \w allí|strong="H8033"\w* pasen \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w gran|strong="H7227"\w* ciudad \w de|strong="H4480"\w* Hamat,  
\q2 y \w luego|strong="H5674"\w* bajen \w a|strong="H3068"\w* Gat \w de|strong="H4480"\w* los \w filisteos|strong="H6430"\w*.  
\q1 ¿Acaso son \w ellos|strong="H4480"\w* \w mejores|strong="H2896"\w* \w que|strong="H4480"\w* estos \w reinos|strong="H4467"\w*?  
\q2 ¿Es su territorio \w más|strong="H4480"\w* \w grande|strong="H7227"\w* \w que|strong="H4480"\w* \w el|strong="H5674"\w* \w de|strong="H4480"\w* ustedes?   
\q1
\v 3 Ustedes quieren alejar \w el|strong="H5066"\w* \w día|strong="H3117"\w* del desastre,  
\q2 pero lo \w que|strong="H3117"\w* hacen es acercar \w el|strong="H5066"\w* reinado \w de|strong="H7451"\w* la \w violencia|strong="H2555"\w*.   
\q2
\v 4 \w Se|strong="H5921"\w* acuestan \w en|strong="H5921"\w* \w camas|strong="H4296"\w* \w de|strong="H5921"\w* \w marfil|strong="H8127"\w*  
\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* estiran perezosamente \w en|strong="H5921"\w* sus sofás;  
\q2 comen \w los|strong="H5921"\w* mejores \w corderos|strong="H3733"\w* \w del|strong="H5921"\w* \w rebaño|strong="H6629"\w*  
\q2 \w y|strong="H5921"\w* \w los|strong="H5921"\w* terneros \w más|strong="H5921"\w* gordos \w del|strong="H5921"\w* establo.   
\q2
\v 5 Canturrean \w al|strong="H5921"\w* \w son|strong="H6310"\w* \w del|strong="H5921"\w* arpa,  
\q2 \w y|strong="H5921"\w* \w como|strong="H5921"\w* \w si|strong="H5921"\w* fueran \w David|strong="H1732"\w*, inventan \w instrumentos|strong="H3627"\w* musicales.   
\q2
\v 6 \w Beben|strong="H8354"\w* \w vino|strong="H3196"\w* \w en|strong="H5921"\w* grandes copas  
\q2 \w y|strong="H5921"\w* \w se|strong="H3808"\w* perfuman \w con|strong="H5921"\w* \w los|strong="H5921"\w* aceites \w más|strong="H5921"\w* finos,  
\q2 pero \w no|strong="H3808"\w* \w les|strong="H5921"\w* duele \w en|strong="H5921"\w* \w nada|strong="H3808"\w* \w la|strong="H5921"\w* ruina \w de|strong="H5921"\w* \w la|strong="H5921"\w* familia \w de|strong="H5921"\w* \w José|strong="H3130"\w*.   
\q1
\v 7 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w ahora|strong="H6258"\w* serán los primeros \w en|strong="H5493"\w* ir al cautiverio;  
\q2 \w así|strong="H3651"\w* \w se|strong="H3651"\w* acabarán sus parrandas y su holgazanería.   
\q1
\v 8 El \w Señor|strong="H3068"\w* Yahvé ha \w jurado|strong="H7650"\w* por \w sí|strong="H5315"\w* mismo, \w dice|strong="H5002"\w* Yahvé, el \w Dios|strong="H3069"\w* de los \w Ejércitos|strong="H6635"\w*:  
\q2 “\w Aborrezco|strong="H8130"\w* el orgullo de \w Jacob|strong="H3290"\w*,  
\q2 y detesto sus fortalezas;  
\q2 por eso voy \w a|strong="H3068"\w* entregar la \w ciudad|strong="H5892"\w* con todo lo que hay en ella”.   
\q1
\v 9 \w Y|strong="H3068"\w* \w si|strong="H1961"\w* en una \w casa|strong="H1004"\w* quedan \w diez|strong="H6235"\w* hombres,  
\q2 también ellos \w morirán|strong="H4191"\w*.   
\p
\v 10 \w Cuando|strong="H3588"\w* un pariente venga \w a|strong="H3068"\w* sacar \w el|strong="H5973"\w* cuerpo \w de|strong="H4480"\w* un muerto \w para|strong="H3588"\w* quemarlo, \w le|strong="H5973"\w* preguntará \w al|strong="H4480"\w* \w que|strong="H3588"\w* esté escondido \w en|strong="H4480"\w* \w el|strong="H5973"\w* fondo \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w*: “¿Queda alguien \w más|strong="H5750"\w* ahí \w contigo|strong="H5973"\w*?”. \w Y|strong="H3068"\w* \w si|strong="H3588"\w* este responde: “\w No|strong="H3808"\w*”, \w el|strong="H5973"\w* \w otro|strong="H5750"\w* \w le|strong="H5973"\w* dirá: “¡Cállate! \w No|strong="H3808"\w* debemos \w ni|strong="H3808"\w* mencionar \w el|strong="H5973"\w* \w nombre|strong="H8034"\w* \w de|strong="H4480"\w* Yahvé”.   
\b  
\q1
\v 11 \w Porque|strong="H3588"\w* miren, Yahvé ha dado \w la|strong="H3588"\w* \w orden|strong="H6680"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w grande|strong="H1419"\w* caerá hecha pedazos,  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w pequeña|strong="H6996"\w* quedará \w en|strong="H3588"\w* ruinas.   
\q1
\v 12 ¿Acaso \w corren|strong="H7323"\w* \w los|strong="H3588"\w* \w caballos|strong="H5483"\w* \w por|strong="H3588"\w* las rocas?  
\q2 ¿Se puede arar \w el|strong="H3588"\w* mar \w con|strong="H3588"\w* \w bueyes|strong="H1241"\w*?  
\q1 ¡\w Pero|strong="H3588"\w* ustedes han convertido \w la|strong="H3588"\w* \w justicia|strong="H6666"\w* \w en|strong="H3588"\w* \w veneno|strong="H7219"\w*,  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w fruto|strong="H6529"\w* del \w derecho|strong="H4941"\w* \w en|strong="H3588"\w* algo amargo!   
\q1
\v 13 Ustedes \w se|strong="H3808"\w* \w alegran|strong="H8055"\w* \w por|strong="H1697"\w* \w haber|strong="H3808"\w* conquistado un pueblo \w de|strong="H1697"\w* \w nada|strong="H3808"\w*, y dicen:  
\q2 “¿Acaso \w no|strong="H3808"\w* somos fuertes y poderosos \w por|strong="H1697"\w* nosotros mismos?”.   
\q1
\v 14 “\w Pues|strong="H3588"\w* miren, \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w yo|strong="H3588"\w* voy \w a|strong="H3068"\w* enviar \w contra|strong="H5921"\w* ustedes \w a|strong="H3068"\w* una \w nación|strong="H1471"\w*”,  
\q2 \w dice|strong="H5002"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*;  
\q2 “\w y|strong="H3588"\w* \w ellos|strong="H5921"\w* \w los|strong="H5921"\w* oprimirán \w desde|strong="H5704"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* Hamat \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w arroyo|strong="H5158"\w* \w del|strong="H5921"\w* Arabá”.   
\c 7  
\p
\v 1 \w Así|strong="H3541"\w* \w me|strong="H3541"\w* lo \w mostró|strong="H7200"\w* el Señor Yahvé: él \w estaba|strong="H2009"\w* formando una plaga de langostas cuando comenzaba \w a|strong="H3068"\w* brotar la segunda cosecha, la \w que|strong="H3541"\w* sale después de la cosecha del \w rey|strong="H4428"\w*.  
\v 2 \w Cuando|strong="H3588"\w* las langostas terminaron \w de|strong="H3588"\w* comerse toda \w la|strong="H1931"\w* \w hierba|strong="H6212"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* tierra, \w yo|strong="H3588"\w* dije: “Señor Yahvé, ¡perdónanos, \w por|strong="H3588"\w* favor! ¿\w Cómo|strong="H3588"\w* podrá sobrevivir \w Jacob|strong="H3290"\w*? ¡\w Es|strong="H1931"\w* \w tan|strong="H1931"\w* \w pequeño|strong="H6996"\w*!”.   
\p
\v 3 Entonces Yahvé \w se|strong="H1961"\w* arrepintió \w de|strong="H5921"\w* \w esto|strong="H2063"\w*. “\w Eso|strong="H2063"\w* \w no|strong="H3808"\w* \w sucederá|strong="H1961"\w*”, dijo Yahvé.   
\p
\v 4 El Señor Yahvé \w me|strong="H3541"\w* \w mostró|strong="H7200"\w* lo siguiente: el Señor Yahvé mandaba un juicio con fuego; el fuego secó el \w gran|strong="H7227"\w* océano \w y|strong="H3541"\w* comenzó \w a|strong="H3068"\w* devorar la tierra.  
\v 5 \w Yo|strong="H3588"\w* dije: “Señor Yahvé, ¡detente, \w por|strong="H3588"\w* favor! ¿\w Cómo|strong="H3588"\w* podrá sobrevivir \w Jacob|strong="H3290"\w*? ¡\w Es|strong="H1931"\w* \w tan|strong="H1931"\w* \w pequeño|strong="H6996"\w*!”.   
\p
\v 6 \w Y|strong="H3068"\w* Yahvé \w se|strong="H1961"\w* arrepintió \w de|strong="H5921"\w* \w esto|strong="H2063"\w*. “\w Esto|strong="H2063"\w* \w tampoco|strong="H1571"\w* \w sucederá|strong="H1961"\w*”, dijo \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* Yahvé.   
\p
\v 7 Luego \w me|strong="H5921"\w* \w mostró|strong="H7200"\w* \w esto|strong="H3541"\w*: \w el|strong="H5921"\w* Señor \w estaba|strong="H5324"\w* \w de|strong="H5921"\w* pie \w junto|strong="H5921"\w* \w a|strong="H3068"\w* un \w muro|strong="H2346"\w* construido \w a|strong="H3068"\w* plomo, \w y|strong="H5921"\w* tenía una plomada \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*.  
\v 8 Yahvé me preguntó: “¿\w Qué|strong="H4100"\w* \w ves|strong="H7200"\w*, \w Amós|strong="H5986"\w*?”. Yo respondí: “Una plomada”. Entonces \w el|strong="H5674"\w* \w Señor|strong="H3068"\w* dijo: “Miren, voy \w a|strong="H3068"\w* poner una plomada \w en|strong="H5750"\w* \w medio|strong="H7130"\w* \w de|strong="H5750"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*; \w no|strong="H3808"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* \w pasar|strong="H5674"\w* \w por|strong="H4100"\w* alto sus pecados.  
\v 9 \w Los|strong="H5921"\w* lugares \w de|strong="H5921"\w* culto \w de|strong="H5921"\w* Isaac quedarán desiertos, \w los|strong="H5921"\w* santuarios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* serán \w destruidos|strong="H8074"\w*, \w y|strong="H5921"\w* atacaré \w con|strong="H5921"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Jeroboam|strong="H3379"\w*”.   
\p
\v 10 Entonces Amasías, \w sacerdote|strong="H3548"\w* \w de|strong="H5921"\w* Betel, \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* decirle \w a|strong="H3068"\w* \w Jeroboam|strong="H3379"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: “\w Amós|strong="H5986"\w* \w está|strong="H5921"\w* conspirando \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* corazón \w mismo|strong="H3605"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w El|strong="H5921"\w* país ya \w no|strong="H3808"\w* aguanta \w más|strong="H5921"\w* sus \w palabras|strong="H1697"\w*.  
\v 11 \w Porque|strong="H3588"\w* \w Amós|strong="H5986"\w* anda diciendo: ‘\w Jeroboam|strong="H3379"\w* \w morirá|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* será llevado cautivo lejos \w de|strong="H5921"\w* \w su|strong="H3588"\w* tierra’”.   
\p
\v 12 Luego Amasías le dijo \w a|strong="H3068"\w* \w Amós|strong="H5986"\w*: “¡\w Vete|strong="H3212"\w* de \w aquí|strong="H8033"\w*, \w vidente|strong="H2374"\w*! Huye \w a|strong="H3068"\w* la tierra de \w Judá|strong="H3063"\w*; gánate \w allá|strong="H8033"\w* la vida y \w profetiza|strong="H5012"\w* \w allá|strong="H8033"\w*.  
\v 13 \w Pero|strong="H3588"\w* \w no|strong="H3808"\w* vuelvas \w a|strong="H3068"\w* profetizar \w en|strong="H3588"\w* Betel, \w porque|strong="H3588"\w* \w este|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w santuario|strong="H4720"\w* del \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w* principal del \w reino|strong="H4467"\w*”.   
\p
\v 14 \w Amós|strong="H5986"\w* le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* Amasías: “\w Yo|strong="H3588"\w* \w no|strong="H3808"\w* soy \w profeta|strong="H5030"\w*, \w ni|strong="H3808"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w profeta|strong="H5030"\w*; soy pastor \w y|strong="H3588"\w* también cultivo higos silvestres.  
\v 15 Pero Yahvé me \w quitó|strong="H3947"\w* \w de|strong="H5971"\w* seguir al \w rebaño|strong="H6629"\w* y me dijo: ‘\w Ve|strong="H3212"\w* y \w profetiza|strong="H5012"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*’.  
\v 16 \w Así|strong="H6258"\w* \w que|strong="H3808"\w* \w ahora|strong="H6258"\w*, \w escucha|strong="H8085"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé. Tú \w dices|strong="H1697"\w*: ‘\w No|strong="H3808"\w* \w profetices|strong="H5012"\w* \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w ni|strong="H3808"\w* \w hables|strong="H5197"\w* \w contra|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* Isaac’.  
\v 17 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé: ‘Tu esposa \w se|strong="H5921"\w* volverá una prostituta \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, tus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* tus \w hijas|strong="H1323"\w* \w morirán|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, tu tierra será medida \w y|strong="H5921"\w* repartida \w entre|strong="H5921"\w* otros, \w y|strong="H5921"\w* tú mismo \w morirás|strong="H4191"\w* \w en|strong="H5921"\w* una tierra pagana. \w E|strong="H3068"\w* \w Israel|strong="H3478"\w* será llevado cautivo lejos \w de|strong="H5921"\w* su tierra’”.   
\c 8  
\p
\v 1 El Señor Yahvé \w me|strong="H3541"\w* \w mostró|strong="H7200"\w* \w esto|strong="H3541"\w*: \w vi|strong="H7200"\w* una canasta de fruta de \w verano|strong="H7019"\w*.   
\p
\v 2 \w Él|strong="H5674"\w* me preguntó: “\w Amós|strong="H5986"\w*, ¿\w qué|strong="H4100"\w* \w ves|strong="H7200"\w*?”. Yo respondí: “Una canasta \w de|strong="H5750"\w* fruta \w de|strong="H5750"\w* \w verano|strong="H7019"\w*”. Entonces Yahvé me dijo:  
\q1 “\w Ha|strong="H3808"\w* llegado \w el|strong="H5674"\w* \w fin|strong="H7093"\w* \w para|strong="H5971"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*;  
\q2 \w no|strong="H3808"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* \w pasar|strong="H5674"\w* \w por|strong="H4100"\w* alto su maldad.   
\q1
\v 3 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w los|strong="H3605"\w* cantos del \w templo|strong="H1964"\w* \w se|strong="H1931"\w* volverán lamentos”, \w dice|strong="H5002"\w* \w el|strong="H1931"\w* Señor Yahvé.  
\q2 “¡\w Habrá|strong="H3117"\w* cadáveres por \w todas|strong="H3605"\w* partes! En silencio \w los|strong="H3605"\w* \w arrojarán|strong="H7993"\w* fuera.   
\q1
\v 4 \w Escuchen|strong="H8085"\w* \w esto|strong="H2063"\w*, ustedes que explotan \w a|strong="H3068"\w* los necesitados  
\q2 y quieren acabar con los pobres de \w la|strong="H2063"\w* tierra,   
\q2
\v 5 ustedes \w que|strong="H4970"\w* dicen: ‘¿\w Cuándo|strong="H4970"\w* \w pasará|strong="H5674"\w* la fiesta de luna nueva para \w que|strong="H4970"\w* podamos vender \w el|strong="H5674"\w* grano?  
\q2 ¿\w Cuándo|strong="H4970"\w* \w pasará|strong="H5674"\w* \w el|strong="H5674"\w* \w sábado|strong="H7676"\w* para \w que|strong="H4970"\w* abramos la venta de \w trigo|strong="H1250"\w*?  
\q2 Entonces achicaremos la medida, aumentaremos \w el|strong="H5674"\w* precio,  
\q2 usaremos \w balanzas|strong="H3976"\w* trucadas para engañar;   
\q1
\v 6 compraremos \w a|strong="H3068"\w* los \w pobres|strong="H1800"\w* \w por|strong="H5668"\w* \w dinero|strong="H3701"\w*  
\q2 y \w a|strong="H3068"\w* los necesitados \w por|strong="H5668"\w* un par de sandalias,  
\q2 y venderemos hasta las sobras del \w trigo|strong="H1250"\w*’”.   
\q1
\v 7 Yahvé ha \w jurado|strong="H7650"\w* por \w el|strong="H3605"\w* orgullo \w de|strong="H7911"\w* \w Jacob|strong="H3290"\w*:  
\q2 “\w Nunca|strong="H5331"\w* \w olvidaré|strong="H7911"\w* \w nada|strong="H3605"\w* \w de|strong="H7911"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* han \w hecho|strong="H4639"\w*.   
\q1
\v 8 ¿Acaso \w no|strong="H3808"\w* temblará \w la|strong="H5921"\w* tierra \w por|strong="H5921"\w* \w esto|strong="H2063"\w*?  
\q2 ¿\w No|strong="H3808"\w* llorarán \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H3808"\w* viven \w en|strong="H5921"\w* \w ella|strong="H5921"\w*?  
\q1 \w La|strong="H5921"\w* tierra entera \w se|strong="H5921"\w* levantará \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w río|strong="H2975"\w* Nilo;  
\q2 \w se|strong="H5921"\w* agitará \w y|strong="H5921"\w* \w luego|strong="H5927"\w* \w se|strong="H5921"\w* hundirá, \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w río|strong="H2975"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*.   
\q1
\v 9 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*”, \w dice|strong="H5002"\w* \w el|strong="H1931"\w* Señor Yahvé,  
\q2 “haré \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w* \w se|strong="H1961"\w* oculte al mediodía,  
\q2 y en pleno \w día|strong="H3117"\w* llenaré \w la|strong="H1931"\w* tierra de oscuridad.   
\q1
\v 10 Convertiré sus fiestas \w en|strong="H5921"\w* funerales  
\q2 \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus cantos \w en|strong="H5921"\w* lamentos;  
\q1 \w los|strong="H5921"\w* \w haré|strong="H7760"\w* vestirse \w de|strong="H5921"\w* luto  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* rapen \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor.  
\q1 Será \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w llanto|strong="H7015"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* muerte \w de|strong="H5921"\w* un hijo \w único|strong="H3173"\w*,  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* final \w de|strong="H5921"\w* ese \w día|strong="H3117"\w* será \w de|strong="H5921"\w* \w amargura|strong="H4751"\w* total.   
\q1
\v 11 Vienen \w días|strong="H3117"\w*”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* Yahvé,  
\q2 “\w en|strong="H3588"\w* \w que|strong="H3588"\w* \w enviaré|strong="H7971"\w* \w hambre|strong="H7458"\w* al país;  
\q2 \w no|strong="H3808"\w* \w será|strong="H3808"\w* \w hambre|strong="H7458"\w* \w de|strong="H3588"\w* \w pan|strong="H3899"\w*, \w ni|strong="H3808"\w* \w sed|strong="H6772"\w* \w de|strong="H3588"\w* \w agua|strong="H4325"\w*,  
\q2 \w sino|strong="H3588"\w* \w de|strong="H3588"\w* \w oír|strong="H8085"\w* \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé.   
\q1
\v 12 La gente andará \w errante|strong="H5128"\w* \w de|strong="H5704"\w* \w mar|strong="H3220"\w* \w a|strong="H3068"\w* \w mar|strong="H3220"\w*;  
\q2 vagarán del \w norte|strong="H6828"\w* \w al|strong="H5704"\w* \w oriente|strong="H4217"\w*  
\q2 \w buscando|strong="H1245"\w* la \w palabra|strong="H1697"\w* \w de|strong="H5704"\w* Yahvé,  
\q2 pero \w no|strong="H3808"\w* la encontrarán.   
\q1
\v 13 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, las jóvenes \w hermosas|strong="H3303"\w*  
\q2 y \w los|strong="H1931"\w* muchachos valientes \w se|strong="H1931"\w* \w desmayarán|strong="H5968"\w* de \w sed|strong="H6772"\w*.   
\q1
\v 14 Los \w que|strong="H3808"\w* juran \w por|strong="H1870"\w* \w el|strong="H5307"\w* ídolo \w de|strong="H5750"\w* \w Samaria|strong="H8111"\w*,  
\q2 y dicen: ‘¡\w Por|strong="H1870"\w* la \w vida|strong="H2416"\w* \w de|strong="H5750"\w* tu dios, \w Dan|strong="H1835"\w*!’  
\q2 \w o|strong="H3068"\w* ‘¡\w Por|strong="H1870"\w* la \w vida|strong="H2416"\w* del dios \w de|strong="H5750"\w* Beerseba!’,  
\q2 \w caerán|strong="H5307"\w* para \w no|strong="H3808"\w* volver \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*”.   
\c 9  
\p
\v 1 \w Vi|strong="H7200"\w* \w al|strong="H5921"\w* Señor \w de|strong="H5921"\w* pie \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w altar|strong="H4196"\w*, \w y|strong="H5921"\w* \w él|strong="H5921"\w* dijo: “Golpea \w los|strong="H5921"\w* capiteles \w de|strong="H5921"\w* \w las|strong="H5921"\w* columnas \w para|strong="H5921"\w* \w que|strong="H3808"\w* tiemblen \w los|strong="H5921"\w* umbrales, \w y|strong="H5921"\w* hazlos pedazos \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w ellos|strong="H5921"\w*. \w A|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* queden, \w los|strong="H5921"\w* \w mataré|strong="H2026"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*; \w ni|strong="H3808"\w* uno solo \w podrá|strong="H3808"\w* huir, \w ni|strong="H3808"\w* uno solo \w escapará|strong="H4422"\w*.  
\v 2 \w Aunque|strong="H8033"\w* bajen hasta lo profundo del Seol, de \w allí|strong="H8033"\w* los \w sacará|strong="H5927"\w* mi \w mano|strong="H3027"\w*; \w aunque|strong="H8033"\w* suban hasta el \w cielo|strong="H8064"\w*, de \w allí|strong="H8033"\w* los haré bajar.  
\v 3 \w Aunque|strong="H8033"\w* se escondan en la \w cumbre|strong="H7218"\w* del monte Carmelo, \w allí|strong="H8033"\w* los buscaré y los atraparé; \w aunque|strong="H8033"\w* intenten esconderse \w de|strong="H5048"\w* mi vista en el fondo del \w mar|strong="H3220"\w*, \w allí|strong="H8033"\w* \w le|strong="H5869"\w* daré órdenes \w a|strong="H3068"\w* la \w serpiente|strong="H5175"\w* para que los muerda.  
\v 4 \w Aunque|strong="H8033"\w* sus enemigos \w se|strong="H5921"\w* \w los|strong="H5921"\w* lleven \w al|strong="H5921"\w* \w cautiverio|strong="H7628"\w*, \w allí|strong="H8033"\w* ordenaré \w que|strong="H3808"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w los|strong="H5921"\w* \w mate|strong="H2026"\w*. He decidido vigilarlos \w para|strong="H5921"\w* su \w mal|strong="H7451"\w*, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w para|strong="H5921"\w* su \w bien|strong="H2896"\w*”.  
\v 5 \w El|strong="H3605"\w* Señor, Yahvé de \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w toca|strong="H5060"\w* \w la|strong="H3605"\w* tierra y \w ella|strong="H3605"\w* se derrite, y \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H3605"\w* viven en \w ella|strong="H3605"\w* se ponen de luto. \w La|strong="H3605"\w* tierra entera \w sube|strong="H5927"\w* \w como|strong="H5060"\w* \w el|strong="H3605"\w* \w río|strong="H2975"\w* Nilo y vuelve \w a|strong="H3068"\w* bajar \w como|strong="H5060"\w* \w el|strong="H3605"\w* \w río|strong="H2975"\w* de \w Egipto|strong="H4714"\w*.  
\v 6 \w Dios|strong="H3068"\w* construye su palacio \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H5921"\w* pone \w los|strong="H5921"\w* \w cimientos|strong="H3245"\w* \w de|strong="H5921"\w* su bóveda \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra; \w él|strong="H5921"\w* \w llama|strong="H7121"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w derrama|strong="H8210"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra: Yahvé es su \w nombre|strong="H8034"\w*.  
\v 7 “\w Hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, ¿acaso \w no|strong="H3808"\w* \w son|strong="H3808"\w* ustedes para mí como \w los|strong="H1121"\w* etíopes?”, \w dice|strong="H5002"\w* Yahvé. “¿\w No|strong="H3808"\w* \w saqué|strong="H5927"\w* yo \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w de|strong="H1121"\w* Caftor y \w a|strong="H3068"\w* \w los|strong="H1121"\w* sirios \w de|strong="H1121"\w* Kir?  
\v 8 Miren, \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w del|strong="H5921"\w* \w Señor|strong="H3068"\w* Yahvé \w están|strong="H2009"\w* \w sobre|strong="H5921"\w* este \w reino|strong="H4467"\w* pecador. Voy \w a|strong="H3068"\w* borrarlo \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w destruiré|strong="H8045"\w* \w por|strong="H5921"\w* completo \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Jacob|strong="H3290"\w*”, \w dice|strong="H5002"\w* Yahvé.  
\v 9 “\w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* daré \w la|strong="H3588"\w* \w orden|strong="H6680"\w* \w y|strong="H3588"\w* zarandearé \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w entre|strong="H3808"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w*, \w como|strong="H3588"\w* \w se|strong="H3808"\w* zarandea \w el|strong="H3588"\w* grano \w en|strong="H3588"\w* un cedazo, \w sin|strong="H3808"\w* \w que|strong="H3588"\w* \w caiga|strong="H5307"\w* \w a|strong="H3068"\w* tierra \w ni|strong="H3808"\w* una sola piedrita.  
\v 10 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pecadores|strong="H2400"\w* \w de|strong="H5704"\w* mi \w pueblo|strong="H5971"\w* \w morirán|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*; \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3808"\w* dicen: ‘\w El|strong="H3605"\w* desastre \w nunca|strong="H3808"\w* nos \w alcanzará|strong="H5066"\w* \w ni|strong="H3808"\w* nos encontrará’.  
\v 11 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, yo restauraré \w la|strong="H1931"\w* choza caída de \w David|strong="H1732"\w*. Repararé \w sus|strong="H1931"\w* grietas, \w levantaré|strong="H6965"\w* \w sus|strong="H1931"\w* ruinas y \w la|strong="H1931"\w* volveré \w a|strong="H3068"\w* construir para \w que|strong="H1931"\w* sea \w como|strong="H1931"\w* en \w los|strong="H1931"\w* \w tiempos|strong="H3117"\w* \w antiguos|strong="H5769"\w*;  
\v 12 \w para|strong="H4616"\w* \w que|strong="H5921"\w* \w ellos|strong="H5921"\w* \w posean|strong="H3423"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* queda \w de|strong="H5921"\w* Edom \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H5921"\w* llevan \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*”, \w dice|strong="H5002"\w* Yahvé, \w quien|strong="H3605"\w* \w hace|strong="H6213"\w* \w estas|strong="H2063"\w* cosas.   
\q1
\v 13 “Vienen \w días|strong="H3117"\w*”, \w dice|strong="H5002"\w* Yahvé,  
\q2 “en \w que|strong="H1869"\w* \w el|strong="H3605"\w* \w que|strong="H1869"\w* \w ara|strong="H2790"\w* \w alcanzará|strong="H5066"\w* al \w que|strong="H1869"\w* cosecha,  
\q2 y \w el|strong="H3605"\w* \w que|strong="H1869"\w* pisa las \w uvas|strong="H6025"\w* al \w que|strong="H1869"\w* \w siembra|strong="H2233"\w* \w la|strong="H3605"\w* semilla.  
\q2 De las montañas goteará vino dulce,  
\q2 y de \w todas|strong="H3605"\w* las colinas fluirá.   
\q1
\v 14 Traeré \w de|strong="H5971"\w* vuelta \w del|strong="H8354"\w* cautiverio \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*;  
\q2 ellos reconstruirán las \w ciudades|strong="H5892"\w* arruinadas y vivirán en ellas;  
\q2 \w plantarán|strong="H5193"\w* viñedos y \w beberán|strong="H8354"\w* su \w vino|strong="H3196"\w*;  
\q1 cultivarán \w huertos|strong="H1593"\w*  
\q2 y comerán sus \w frutos|strong="H6529"\w*.   
\q1
\v 15 \w Los|strong="H1992"\w* \w plantaré|strong="H5193"\w* \w en|strong="H5921"\w* \w su|strong="H1992"\w* propia tierra,  
\q2 \w y|strong="H5921"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w serán|strong="H1992"\w* arrancados \w del|strong="H5921"\w* país \w que|strong="H3808"\w* yo \w les|strong="H1992"\w* \w di|strong="H5414"\w*”,  
\q2 dice Yahvé, \w su|strong="H1992"\w* \w Dios|strong="H3068"\w*.   