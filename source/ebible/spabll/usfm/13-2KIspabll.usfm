\v 25 \w No|strong="H3808"\w* \w hubo|strong="H1961"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w él|strong="H3605"\w* \w ningún|strong="H3605"\w* \w rey|strong="H4428"\w* \w que|strong="H3808"\w*, \w como|strong="H3644"\w* \w él|strong="H3605"\w*, \w se|strong="H1961"\w* volviera \w a|strong="H3068"\w* Yahvé con \w todo|strong="H3605"\w* su \w corazón|strong="H3824"\w*, con \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w* y con \w todas|strong="H3605"\w* sus fuerzas, conforme \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w ley|strong="H8451"\w* \w de|strong="H6440"\w* \w Moisés|strong="H4872"\w*; \w ni|strong="H3808"\w* \w hubo|strong="H1961"\w* otro igual \w después|strong="H1961"\w* \w de|strong="H6440"\w* \w él|strong="H3605"\w*.  
