\v 20 Cuando Acaz murió, fue \w sepultado|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*. Su \w hijo|strong="H1121"\w* Ezequías \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 17  
\p
\v 1 \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ela comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* durante \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w doce|strong="H8147"\w* \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Acaz \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Reinó|strong="H4427"\w* \w nueve|strong="H8672"\w* \w años|strong="H8141"\w*.  
\v 2 Pero \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* ofende \w a|strong="H3068"\w* Yahvé, \w aunque|strong="H7535"\w* \w no|strong="H3808"\w* tanto \w como|strong="H1961"\w* \w los|strong="H1961"\w* \w reyes|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* precedieron.  
\v 3 \w Salmanasar|strong="H8022"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, marchó \w contra|strong="H5921"\w* \w él|strong="H5921"\w*, \w y|strong="H5921"\w* \w Oseas|strong="H1954"\w* \w se|strong="H1961"\w* convirtió \w en|strong="H5921"\w* su vasallo \w y|strong="H5921"\w* comenzó \w a|strong="H3068"\w* pagarle \w tributo|strong="H4503"\w*.  
