\p
\v 40 \w Pero|strong="H3588"\w* \w ellos|strong="H1992"\w* \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* siguieron \w con|strong="H3588"\w* \w sus|strong="H1992"\w* \w antiguas|strong="H7223"\w* costumbres.  
\v 41 \w Así|strong="H1571"\w* \w que|strong="H5704"\w* \w estas|strong="H2088"\w* \w naciones|strong="H1471"\w* adoraban \w a|strong="H3068"\w* Yahvé, pero \w al|strong="H5704"\w* \w mismo|strong="H1571"\w* \w tiempo|strong="H3117"\w* servían \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w ídolos|strong="H6456"\w*. \w Y|strong="H3068"\w* \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* \w y|strong="H1571"\w* \w sus|strong="H1992"\w* \w nietos|strong="H1121"\w* siguen \w haciendo|strong="H6213"\w* \w lo|strong="H2088"\w* \w mismo|strong="H1571"\w* \w que|strong="H5704"\w* \w hicieron|strong="H6213"\w* \w sus|strong="H1992"\w* antepasados.   
\c 18  
\p
\v 1 Ezequías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Acaz comenzó \w a|strong="H3068"\w* reinar en \w Judá|strong="H3063"\w* durante \w el|strong="H1121"\w* tercer \w año|strong="H8141"\w* del \w reinado|strong="H4427"\w* \w de|strong="H1121"\w* \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ela en \w Israel|strong="H3478"\w*.  
\v 2 \w Tenía|strong="H1961"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w veintinueve|strong="H6242"\w* \w años|strong="H8141"\w*. Su madre \w era|strong="H1961"\w* Abi, \w hija|strong="H1323"\w* \w de|strong="H2568"\w* \w Zacarías|strong="H2148"\w*.  
\v 3 Ezequías \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w le|strong="H5869"\w* agrada \w a|strong="H3068"\w* Yahvé, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* su antepasado \w David|strong="H1732"\w*.  
\v 4 \w Quitó|strong="H5493"\w* \w los|strong="H1992"\w* santuarios paganos, destrozó \w las|strong="H1992"\w* piedras sagradas \w y|strong="H3588"\w* derribó \w las|strong="H1992"\w* imágenes \w de|strong="H3588"\w* \w la|strong="H1931"\w* diosa Asera. También \w hizo|strong="H6213"\w* pedazos \w la|strong="H1931"\w* \w serpiente|strong="H5175"\w* \w de|strong="H3588"\w* bronce \w que|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w había|strong="H1961"\w* fabricado, \w porque|strong="H3588"\w* \w hasta|strong="H5704"\w* \w ese|strong="H1931"\w* \w tiempo|strong="H3117"\w* \w los|strong="H1992"\w* israelitas todavía \w le|strong="H1931"\w* quemaban incienso \w y|strong="H3588"\w* \w la|strong="H1931"\w* \w llamaban|strong="H7121"\w* Nehustán.  
\v 5 Ezequías puso su confianza en Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w No|strong="H3808"\w* \w hubo|strong="H1961"\w* otro \w como|strong="H3644"\w* \w él|strong="H3605"\w* \w entre|strong="H3808"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w ni|strong="H3808"\w* \w antes|strong="H6440"\w* \w ni|strong="H3808"\w* \w después|strong="H1961"\w* \w de|strong="H6440"\w* su tiempo.  
\v 6 \w Se|strong="H3808"\w* mantuvo fiel \w a|strong="H3068"\w* Yahvé y \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartó de él; obedeció todos los \w mandamientos|strong="H4687"\w* \w que|strong="H3808"\w* Yahvé le había dado \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.  
\v 7 \w Por|strong="H4428"\w* eso Yahvé \w estaba|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*, y Ezequías \w tenía|strong="H1961"\w* éxito \w en|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* emprendía. \w Se|strong="H1961"\w* rebeló \w contra|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w* \w de|strong="H5973"\w* Asiria y dejó \w de|strong="H5973"\w* ser su vasallo.  
\v 8 Derrotó \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w* \w hasta|strong="H5704"\w* \w Gaza|strong="H5804"\w* \w y|strong="H5704"\w* \w sus|strong="H1931"\w* alrededores, \w desde|strong="H5704"\w* las \w torres|strong="H4026"\w* \w de|strong="H5704"\w* vigilancia \w hasta|strong="H5704"\w* las \w ciudades|strong="H5892"\w* fortificadas.   
\p
\v 9 \w En|strong="H5921"\w* \w el|strong="H1931"\w* \w cuarto|strong="H7243"\w* \w año|strong="H8141"\w* \w del|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* Ezequías, \w que|strong="H1931"\w* \w era|strong="H1961"\w* \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ela \w en|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w Salmanasar|strong="H8022"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, marchó \w contra|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w y|strong="H5921"\w* \w la|strong="H1931"\w* sitió.  
\v 10 \w Al|strong="H4428"\w* \w cabo|strong="H7097"\w* de \w tres|strong="H7969"\w* \w años|strong="H8141"\w*, \w los|strong="H1931"\w* asirios \w la|strong="H1931"\w* conquistaron. \w Samaria|strong="H8111"\w* cayó en \w el|strong="H1931"\w* sexto \w año|strong="H8141"\w* de Ezequías, \w que|strong="H1931"\w* \w era|strong="H8141"\w* \w el|strong="H1931"\w* noveno \w año|strong="H8141"\w* de \w Oseas|strong="H1954"\w* en \w Israel|strong="H3478"\w*.  
\v 11 El \w rey|strong="H4428"\w* de Asiria deportó \w a|strong="H3068"\w* los israelitas \w a|strong="H3068"\w* Asiria y los estableció en Hala, en \w Gozán|strong="H1470"\w* junto \w al|strong="H4428"\w* \w río|strong="H5104"\w* Habor, y en las \w ciudades|strong="H5892"\w* de los medos.  
\v 12 \w Esto|strong="H6213"\w* sucedió \w porque|strong="H5921"\w* \w los|strong="H5921"\w* israelitas \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* quebrantaron su \w pacto|strong="H1285"\w*. \w No|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w ni|strong="H3808"\w* \w pusieron|strong="H6213"\w* \w en|strong="H5921"\w* práctica \w nada|strong="H3808"\w* \w de|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w Moisés|strong="H4872"\w*, \w siervo|strong="H5650"\w* \w de|strong="H5921"\w* Yahvé, \w les|strong="H5921"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w*.   
\p
\v 13 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* catorce \w del|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* Ezequías, Senaquerib, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, atacó \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* conquistó.  
\v 14 \w Entonces|strong="H7725"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w le|strong="H5921"\w* \w envió|strong="H7971"\w* este mensaje \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, \w que|strong="H5921"\w* \w estaba|strong="H7760"\w* \w en|strong="H5921"\w* Laquis: “Reconozco \w que|strong="H5921"\w* \w me|strong="H5921"\w* he equivocado. \w Por|strong="H5921"\w* favor, retírate \w y|strong="H5921"\w* yo \w te|strong="H5921"\w* \w pagaré|strong="H5414"\w* \w el|strong="H5921"\w* tributo \w que|strong="H5921"\w* \w me|strong="H5921"\w* impongas”. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria \w le|strong="H5921"\w* exigió \w a|strong="H3068"\w* Ezequías nueve \w mil|strong="H3967"\w* kilos \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* novecientos kilos\f + \fr 18:14 \ft Un talento equivale a unos 30 kilogramos o 66 libras o 965 onzas troyanas\f* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.  
\v 15 Ezequías le \w entregó|strong="H5414"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w plata|strong="H3701"\w* \w que|strong="H3605"\w* \w había|strong="H4672"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé y en \w los|strong="H3605"\w* tesoros del palacio \w real|strong="H4428"\w*.  
\v 16 En \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* ocasión, Ezequías despojó \w de|strong="H5414"\w* \w su|strong="H1931"\w* oro las \w puertas|strong="H1817"\w* del \w templo|strong="H1964"\w* \w de|strong="H5414"\w* Yahvé y \w los|strong="H1931"\w* marcos \w que|strong="H1931"\w* \w él|strong="H1931"\w* \w mismo|strong="H1931"\w* había recubierto, y \w se|strong="H1931"\w* \w lo|strong="H1931"\w* \w entregó|strong="H5414"\w* todo \w al|strong="H6256"\w* \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria.   
\p
\v 17 Pero el \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Asiria \w envió|strong="H7971"\w* \w desde|strong="H4480"\w* Laquis \w a|strong="H3068"\w* su general \w en|strong="H4480"\w* jefe, \w a|strong="H3068"\w* su oficial principal y \w a|strong="H3068"\w* su comandante \w de|strong="H4480"\w* \w campo|strong="H7704"\w*, acompañados \w de|strong="H4480"\w* un gran \w ejército|strong="H2426"\w*, \w para|strong="H4480"\w* enfrentarse \w al|strong="H4480"\w* \w rey|strong="H4428"\w* Ezequías \w en|strong="H4480"\w* Jerusalén. \w Al|strong="H4480"\w* llegar \w a|strong="H3068"\w* la ciudad, \w se|strong="H4480"\w* detuvieron junto \w al|strong="H4480"\w* acueducto \w del|strong="H4480"\w* \w estanque|strong="H1295"\w* superior, \w en|strong="H4480"\w* el \w camino|strong="H4546"\w* \w que|strong="H4480"\w* lleva \w al|strong="H4480"\w* \w Campo|strong="H7704"\w* \w del|strong="H4480"\w* Lavandero.  
\v 18 \w Llamaron|strong="H7121"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, \w y|strong="H5921"\w* \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* recibirlos Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hilcías|strong="H2518"\w*, \w el|strong="H5921"\w* administrador \w del|strong="H5921"\w* palacio, \w el|strong="H5921"\w* \w secretario|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* cronista Joa \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Asaf.  
\v 19 El comandante de campo les dijo: “Díganle \w a|strong="H3068"\w* Ezequías \w que|strong="H4100"\w* \w así|strong="H3541"\w* dice el \w gran|strong="H1419"\w* \w rey|strong="H4428"\w*, el \w rey|strong="H4428"\w* de Asiria: ‘¿En \w qué|strong="H4100"\w* basas tu confianza?  
\v 20 Tú \w dices|strong="H1697"\w* \w que|strong="H3588"\w* tienes estrategia \w y|strong="H3588"\w* poder \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*, \w pero|strong="H3588"\w* \w no|strong="H3588"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w palabras|strong="H1697"\w* vacías. ¿\w En|strong="H5921"\w* \w quién|strong="H4310"\w* confías \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* rebeles \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*?  
\v 21 ¡Miren! Ustedes \w están|strong="H2088"\w* confiando \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w ese|strong="H2088"\w* bastón \w de|strong="H5921"\w* \w caña|strong="H7070"\w* astillada \w que|strong="H6258"\w* \w le|strong="H5921"\w* atraviesa \w la|strong="H5921"\w* \w mano|strong="H3709"\w* \w a|strong="H3068"\w* \w cualquiera|strong="H3605"\w* \w que|strong="H6258"\w* \w se|strong="H5921"\w* apoye \w en|strong="H5921"\w* \w él|strong="H5921"\w*. ¡\w Eso|strong="H3651"\w* \w es|strong="H2088"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w para|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H6258"\w* \w confían|strong="H5564"\w* \w en|strong="H5921"\w* \w él|strong="H5921"\w*!  
\v 22 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w me|strong="H3588"\w* dicen: “\w Nosotros|strong="H1931"\w* confiamos \w en|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*”, ¿acaso \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w él|strong="H1931"\w* \w mismo|strong="H1931"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* Ezequías \w le|strong="H1931"\w* \w quitó|strong="H5493"\w* \w los|strong="H1931"\w* santuarios \w y|strong="H3588"\w* \w los|strong="H1931"\w* \w altares|strong="H4196"\w*, ordenándole \w a|strong="H3068"\w* \w la|strong="H1931"\w* gente \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén \w que|strong="H3588"\w* adore \w solo|strong="H1931"\w* \w ante|strong="H6440"\w* \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w en|strong="H3588"\w* Jerusalén?’  
\v 23 Hagan \w ahora|strong="H6258"\w* un \w trato|strong="H5414"\w* \w con|strong="H5921"\w* \w mi|strong="H5921"\w* señor, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria: ¡\w Yo|strong="H4994"\w* \w les|strong="H5921"\w* \w daré|strong="H5414"\w* dos mil \w caballos|strong="H5483"\w* \w si|strong="H4994"\w* ustedes \w pueden|strong="H3201"\w* conseguir jinetes \w que|strong="H6258"\w* \w los|strong="H5921"\w* monten!  
\v 24 ¿\w Cómo|strong="H5921"\w* piensan rechazar \w el|strong="H5921"\w* ataque \w de|strong="H5921"\w* uno solo \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w más|strong="H5921"\w* insignificantes \w de|strong="H5921"\w* \w mi|strong="H5921"\w* señor, \w si|strong="H6440"\w* confían \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5921"\w* conseguir \w carros|strong="H7393"\w* \w y|strong="H5921"\w* \w jinetes|strong="H6571"\w*?  
\v 25 ¿Acaso creen \w que|strong="H6258"\w* he venido \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w sin|strong="H1107"\w* \w el|strong="H5921"\w* permiso \w de|strong="H5921"\w* Yahvé? ¡Fue Yahvé mismo quien \w me|strong="H5921"\w* dijo: “Ataca esa tierra \w y|strong="H5921"\w* destrúyela”!’”   
\p
\v 26 \w Entonces|strong="H3588"\w* Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hilcías|strong="H2518"\w*, \w Sebna|strong="H7644"\w* \w y|strong="H3588"\w* Joa \w le|strong="H5921"\w* \w dijeron|strong="H1696"\w* \w al|strong="H5921"\w* comandante: “\w Por|strong="H5921"\w* favor, háblenos \w en|strong="H5921"\w* arameo, \w que|strong="H3588"\w* \w nosotros|strong="H5973"\w* \w lo|strong="H5921"\w* entendemos. \w No|strong="H3588"\w* \w nos|strong="H5921"\w* \w hable|strong="H1696"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* lengua \w de|strong="H5921"\w* \w los|strong="H1121"\w* judíos, \w porque|strong="H3588"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* muralla \w nos|strong="H5921"\w* \w está|strong="H5921"\w* \w escuchando|strong="H8085"\w*”.   
\p
\v 27 Pero \w el|strong="H5921"\w* comandante \w les|strong="H5973"\w* respondió: “¿Creen \w que|strong="H3808"\w* \w mi|strong="H5921"\w* señor \w me|strong="H5921"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decirles \w esto|strong="H1697"\w* solo \w a|strong="H3068"\w* ustedes \w y|strong="H5921"\w* \w a|strong="H3068"\w* su rey? ¡\w No|strong="H3808"\w*! También \w se|strong="H5921"\w* \w lo|strong="H1697"\w* digo \w a|strong="H3068"\w* \w los|strong="H3427"\w* hombres \w que|strong="H3808"\w* \w están|strong="H3427"\w* \w sentados|strong="H3427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* muralla, quienes \w junto|strong="H5921"\w* \w con|strong="H5973"\w* ustedes tendrán \w que|strong="H3808"\w* comerse su propio excremento \w y|strong="H5921"\w* beberse su propia orina”.   
\p
\v 28 Entonces el comandante se \w puso|strong="H5975"\w* \w de|strong="H1697"\w* \w pie|strong="H5975"\w* y \w gritó|strong="H7121"\w* con todas sus fuerzas \w en|strong="H5975"\w* la lengua \w de|strong="H1697"\w* los judíos: “¡\w Escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* del \w gran|strong="H1419"\w* \w rey|strong="H4428"\w*, el \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Asiria!  
\v 29 \w Así|strong="H3541"\w* dice \w el|strong="H3588"\w* \w rey|strong="H4428"\w*: ‘\w No|strong="H3808"\w* dejen \w que|strong="H3588"\w* Ezequías \w los|strong="H3588"\w* \w engañe|strong="H5377"\w*, \w porque|strong="H3588"\w* \w él|strong="H3588"\w* \w no|strong="H3808"\w* \w podrá|strong="H3201"\w* librarlos \w de|strong="H3588"\w* mi \w poder|strong="H3027"\w*.  
\v 30 \w No|strong="H3808"\w* permitan \w que|strong="H3808"\w* Ezequías los convenza \w de|strong="H5414"\w* confiar en Yahvé diciendo: “\w Ciertamente|strong="H5414"\w* Yahvé nos \w librará|strong="H5337"\w*, y \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w no|strong="H3808"\w* caerá en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria”.  
\v 31 \w No|strong="H6213"\w* le \w hagan|strong="H6213"\w* caso \w a|strong="H3068"\w* Ezequías’. \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria: ‘\w Hagan|strong="H6213"\w* las paces \w conmigo|strong="H6213"\w* \w y|strong="H3588"\w* ríndanse. \w Así|strong="H3541"\w* cada uno \w de|strong="H3588"\w* ustedes podrá comer \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia \w vid|strong="H1612"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia higuera, \w y|strong="H3588"\w* \w beber|strong="H8354"\w* \w agua|strong="H4325"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia cisterna,  
\v 32 \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* venga \w y|strong="H3588"\w* \w los|strong="H3588"\w* lleve \w a|strong="H3068"\w* una tierra \w como|strong="H3588"\w* \w la|strong="H3588"\w* suya: una tierra \w de|strong="H3588"\w* \w trigo|strong="H1715"\w* \w y|strong="H3588"\w* \w vino|strong="H8492"\w*, \w de|strong="H3588"\w* \w pan|strong="H3899"\w* \w y|strong="H3588"\w* viñedos, \w de|strong="H3588"\w* olivos \w y|strong="H3588"\w* \w miel|strong="H1706"\w*. ¡\w Así|strong="H3588"\w* \w vivirán|strong="H2421"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w morirán|strong="H4191"\w*! \w No|strong="H3808"\w* \w escuchen|strong="H8085"\w* \w a|strong="H3068"\w* Ezequías, \w porque|strong="H3588"\w* \w los|strong="H3588"\w* está engañando \w al|strong="H5704"\w* decirles \w que|strong="H3588"\w* Yahvé \w los|strong="H3588"\w* \w librará|strong="H5337"\w*.  
\v 33 ¿Acaso alguno de los dioses de las \w naciones|strong="H1471"\w* ha podido \w librar|strong="H5337"\w* \w a|strong="H3068"\w* su país del \w poder|strong="H3027"\w* del \w rey|strong="H4428"\w* de Asiria?  
\v 34 ¿Dónde están \w los|strong="H3588"\w* dioses \w de|strong="H3588"\w* Hamat \w y|strong="H3588"\w* \w de|strong="H3588"\w* Arpad? ¿Dónde están \w los|strong="H3588"\w* dioses \w de|strong="H3588"\w* Sefarvaim, \w de|strong="H3588"\w* Hena \w y|strong="H3588"\w* \w de|strong="H3588"\w* Iva? ¿Pudieron \w ellos|strong="H3027"\w* \w librar|strong="H5337"\w* \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w* \w de|strong="H3588"\w* mi \w poder|strong="H3027"\w*?  
\v 35 ¿\w Cuál|strong="H4310"\w* \w de|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* dioses \w de|strong="H3588"\w* esas naciones ha \w librado|strong="H5337"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* país \w de|strong="H3588"\w* \w mi|strong="H3389"\w* \w poder|strong="H3027"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* ahora Yahvé pueda \w librar|strong="H5337"\w* \w a|strong="H3068"\w* Jerusalén?’”   
\p
\v 36 \w Pero|strong="H3588"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1931"\w* quedó callado \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w respondió|strong="H6030"\w* \w ni|strong="H3808"\w* una \w palabra|strong="H1697"\w*, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w así|strong="H3588"\w* \w lo|strong="H1931"\w* \w había|strong="H3588"\w* ordenado.  
\v 37 Luego Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Hilcías|strong="H2518"\w*, \w el|strong="H5921"\w* administrador \w del|strong="H5921"\w* palacio, \w el|strong="H5921"\w* \w secretario|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* cronista Joa \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Asaf, fueron \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Ezequías \w con|strong="H5921"\w* \w la|strong="H5921"\w* ropa rasgada \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor \w y|strong="H5921"\w* \w le|strong="H5921"\w* informaron \w lo|strong="H1697"\w* \w que|strong="H5921"\w* había \w dicho|strong="H1697"\w* \w el|strong="H5921"\w* comandante asirio.   
\c 19  
\p
\v 1 En cuanto el \w rey|strong="H4428"\w* Ezequías \w escuchó|strong="H8085"\w* el mensaje, \w se|strong="H1961"\w* \w rasgó|strong="H7167"\w* la ropa en señal de dolor, \w se|strong="H1961"\w* vistió de luto y \w fue|strong="H1961"\w* \w al|strong="H4428"\w* \w templo|strong="H1004"\w* de Yahvé.  
\v 2 Luego \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Eliaquim, \w el|strong="H5921"\w* administrador \w del|strong="H5921"\w* palacio, \w al|strong="H5921"\w* \w secretario|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, todos \w vestidos|strong="H3680"\w* \w de|strong="H5921"\w* luto, \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amós.  
\v 3 Ellos le dijeron: “\w Así|strong="H3541"\w* dice Ezequías: “\w Hoy|strong="H3117"\w* \w es|strong="H2088"\w* un \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w angustia|strong="H6869"\w*, \w de|strong="H3588"\w* castigo \w y|strong="H3588"\w* \w de|strong="H3588"\w* humillación. Estamos \w como|strong="H3588"\w* una mujer \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w a|strong="H3068"\w* punto \w de|strong="H3588"\w* dar \w a|strong="H3068"\w* luz, \w pero|strong="H3588"\w* \w no|strong="H3588"\w* tiene \w fuerzas|strong="H3581"\w* \w para|strong="H5704"\w* \w que|strong="H3588"\w* nazca \w el|strong="H3588"\w* bebé.  
\v 4 \w Tal|strong="H1697"\w* vez Yahvé su \w Dios|strong="H3068"\w* \w oiga|strong="H8085"\w* \w todas|strong="H3605"\w* las ofensas del comandante \w de|strong="H1697"\w* campo, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* su \w señor|strong="H3068"\w*, \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Asiria, \w envió|strong="H7971"\w* para insultar \w al|strong="H4428"\w* \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*. ¡\w Que|strong="H1697"\w* Yahvé su \w Dios|strong="H3068"\w* \w lo|strong="H1697"\w* castigue \w por|strong="H1157"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* ha \w oído|strong="H8085"\w*! \w Por|strong="H1157"\w* favor, eleve usted \w una|strong="H4672"\w* \w oración|strong="H8605"\w* \w por|strong="H1157"\w* \w los|strong="H3605"\w* pocos \w que|strong="H1697"\w* hemos quedado””.   
\p
\v 5 \w Cuando|strong="H5650"\w* los oficiales del \w rey|strong="H4428"\w* Ezequías llegaron ante \w Isaías|strong="H3470"\w*,  
\v 6 él les dijo: “Díganle \w a|strong="H3068"\w* su \w señor|strong="H3068"\w*: “\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: \w No|strong="H6440"\w* tengas \w miedo|strong="H3372"\w* \w por|strong="H1697"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* has \w oído|strong="H8085"\w*, con las \w que|strong="H1697"\w* los sirvientes del \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Asiria \w me|strong="H3541"\w* han insultado.  
\v 7 Yo voy \w a|strong="H3068"\w* \w poner|strong="H5414"\w* un \w espíritu|strong="H7307"\w* en \w él|strong="H5307"\w*; \w oirá|strong="H8085"\w* un \w rumor|strong="H8052"\w* que lo \w hará|strong="H5414"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* su país, y allá \w haré|strong="H5414"\w* que lo maten \w a|strong="H3068"\w* \w espada|strong="H2719"\w*””.   
\p
\v 8 \w El|strong="H5921"\w* comandante regresó \w y|strong="H3588"\w* encontró \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria atacando \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* \w Libna|strong="H3841"\w*, \w pues|strong="H3588"\w* \w se|strong="H5921"\w* enteró \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w había|strong="H4672"\w* retirado \w de|strong="H5921"\w* Laquis.  
\v 9 \w Entonces|strong="H7725"\w* el \w rey|strong="H4428"\w* \w de|strong="H3898"\w* Asiria recibió noticias \w de|strong="H3898"\w* que Tirhaca, el \w rey|strong="H4428"\w* \w de|strong="H3898"\w* \w Etiopía|strong="H3568"\w*, venía marchando para pelear contra él. \w Por|strong="H4428"\w* eso \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* enviar \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* Ezequías con este mensaje:  
\v 10 “Díganle \w a|strong="H3068"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*: “\w No|strong="H3808"\w* dejes \w que|strong="H3808"\w* tu Dios, en quien confías, te \w engañe|strong="H5377"\w* diciéndote \w que|strong="H3808"\w* Jerusalén \w no|strong="H3808"\w* caerá en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria.  
\v 11 \w Tú|strong="H6213"\w* bien sabes \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de Asiria han \w hecho|strong="H6213"\w* en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* países: \w los|strong="H3605"\w* han destruido \w por|strong="H4428"\w* completo. ¿\w Y|strong="H3068"\w* crees \w que|strong="H3605"\w* \w tú|strong="H6213"\w* te vas \w a|strong="H3068"\w* salvar?  
\v 12 ¿Acaso \w los|strong="H1121"\w* dioses \w de|strong="H1121"\w* esas \w naciones|strong="H1471"\w* las \w libraron|strong="H5337"\w*? Mis antepasados \w destruyeron|strong="H7843"\w* \w a|strong="H3068"\w* \w Gozán|strong="H1470"\w*, \w Harán|strong="H2771"\w*, Rezef y \w a|strong="H3068"\w* la \w gente|strong="H1471"\w* \w de|strong="H1121"\w* Edén \w que|strong="H1121"\w* estaba en Telasar.  
\v 13 ¿Dónde están ahora el \w rey|strong="H4428"\w* de Hamat, el de Arpad, y los \w reyes|strong="H4428"\w* de Sefarvaim, Hena \w e|strong="H3068"\w* Iva?””.   
\p
\v 14 Ezequías \w tomó|strong="H3947"\w* la \w carta|strong="H5612"\w* \w de|strong="H6440"\w* \w mano|strong="H3027"\w* \w de|strong="H6440"\w* los \w mensajeros|strong="H4397"\w* y la \w leyó|strong="H7121"\w*. \w Luego|strong="H5927"\w* \w subió|strong="H5927"\w* al \w templo|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé, \w extendió|strong="H6566"\w* la \w carta|strong="H5612"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* él  
\v 15 y \w oró|strong="H6419"\w* \w así|strong="H1931"\w*: “Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w que|strong="H1931"\w* reinas sobre \w los|strong="H3427"\w* \w querubines|strong="H3742"\w*: \w solo|strong="H1931"\w* \w tú|strong="H6213"\w* \w eres|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w reinos|strong="H4467"\w* \w de|strong="H6440"\w* \w la|strong="H1931"\w* tierra. \w Tú|strong="H6213"\w* \w hiciste|strong="H6213"\w* \w el|strong="H1931"\w* \w cielo|strong="H8064"\w* y \w la|strong="H1931"\w* tierra.  
\v 16 Presta atención, Yahvé, y \w escucha|strong="H8085"\w*; \w abre|strong="H6491"\w* tus \w ojos|strong="H5869"\w*, Yahvé, y \w mira|strong="H7200"\w*. \w Oye|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* Senaquerib ha \w enviado|strong="H7971"\w* para insultar al \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*.  
\v 17 Es verdad, Yahvé, que los \w reyes|strong="H4428"\w* de Asiria han arrasado \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* y sus tierras,  
\v 18 \w y|strong="H3588"\w* han echado \w sus|strong="H1992"\w* dioses al fuego. \w Pero|strong="H3588"\w* \w ellos|strong="H1992"\w* \w no|strong="H3808"\w* \w eran|strong="H3808"\w* dioses, \w sino|strong="H3588"\w* objetos \w de|strong="H3588"\w* \w madera|strong="H6086"\w* \w y|strong="H3588"\w* piedra \w hechos|strong="H4639"\w* \w por|strong="H3588"\w* \w manos|strong="H3027"\w* humanas; \w por|strong="H3588"\w* eso pudieron destruirlos.  
\v 19 \w Ahora|strong="H6258"\w*, Yahvé, \w Dios|strong="H3068"\w* nuestro, \w líbranos|strong="H3467"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w poder|strong="H3027"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H3588"\w* \w la|strong="H3605"\w* tierra \w sepan|strong="H3045"\w* \w que|strong="H3588"\w* solo tú, Yahvé, eres \w Dios|strong="H3068"\w*”.   
\p
\v 20 Entonces \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amós le \w envió|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* Ezequías: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: He escuchado la oración \w que|strong="H1121"\w* \w me|strong="H3541"\w* hiciste acerca \w de|strong="H1121"\w* Senaquerib, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Asiria.  
\v 21 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé ha pronunciado \w contra|strong="H5921"\w* \w él|strong="H5921"\w*: “\w La|strong="H5921"\w* \w virgen|strong="H1330"\w* ciudad \w de|strong="H5921"\w* \w Sión|strong="H6726"\w* \w te|strong="H5921"\w* desprecia \w y|strong="H5921"\w* \w se|strong="H5921"\w* burla \w de|strong="H5921"\w* \w ti|strong="H5921"\w*; \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* Jerusalén mueve \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* mientras \w te|strong="H5921"\w* ves \w obligado|strong="H5921"\w* \w a|strong="H3068"\w* huir.  
\v 22 ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* has insultado \w y|strong="H5921"\w* ofendido? ¿\w Contra|strong="H5921"\w* \w quién|strong="H4310"\w* has levantado \w la|strong="H5921"\w* \w voz|strong="H6963"\w* \w y|strong="H5921"\w* mirado \w con|strong="H5921"\w* \w tanto|strong="H5921"\w* orgullo? ¡\w Contra|strong="H5921"\w* \w el|strong="H5921"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*!  
\v 23 \w Por|strong="H3027"\w* \w medio|strong="H3027"\w* de tus \w mensajeros|strong="H4397"\w* has insultado al Señor. Has dicho: Con mis muchísimos \w carros|strong="H7393"\w* de guerra he \w subido|strong="H5927"\w* \w a|strong="H3068"\w* las cumbres de los \w montes|strong="H2022"\w*, hasta lo más profundo del \w Líbano|strong="H3844"\w*. He talado sus cedros más altos y sus mejores cipreses. He llegado \w a|strong="H3068"\w* sus refugios más lejanos, \w a|strong="H3068"\w* sus bosques más frondosos.  
\v 24 He cavado pozos y \w bebido|strong="H8354"\w* \w agua|strong="H4325"\w* en \w tierras|strong="H2114"\w* extrañas; ¡con \w la|strong="H3605"\w* planta \w de|strong="H4325"\w* mis \w pies|strong="H6471"\w* he secado \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ríos|strong="H2975"\w* \w de|strong="H4325"\w* Egipto!  
\v 25 ¿Acaso \w no|strong="H3808"\w* has \w oído|strong="H8085"\w* \w que|strong="H3808"\w* \w hace|strong="H6213"\w* mucho \w tiempo|strong="H3117"\w* \w yo|strong="H6213"\w* \w lo|strong="H3808"\w* planeé? Desde \w tiempos|strong="H3117"\w* \w antiguos|strong="H6924"\w* \w lo|strong="H3808"\w* diseñé, y \w ahora|strong="H6258"\w* \w lo|strong="H3808"\w* he llevado \w a|strong="H3068"\w* cabo: \w tú|strong="H6213"\w* has convertido las \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* en montones de ruinas.  
\v 26 Sus \w habitantes|strong="H3427"\w* \w se|strong="H1961"\w* \w quedaron|strong="H1961"\w* sin fuerzas, llenos \w de|strong="H6440"\w* miedo y vergüenza. \w Eran|strong="H1961"\w* \w como|strong="H1961"\w* la \w hierba|strong="H6212"\w* del \w campo|strong="H7704"\w*, \w como|strong="H1961"\w* pasto tierno, \w como|strong="H1961"\w* maleza en \w los|strong="H3427"\w* techos \w que|strong="H1961"\w* \w se|strong="H1961"\w* seca \w antes|strong="H6440"\w* \w de|strong="H6440"\w* crecer.  
\v 27 Yo \w sé|strong="H3045"\w* cuándo te sientas y cuándo \w sales|strong="H3318"\w*, cuándo entras y cómo te enfureces contra mí.  
\v 28 \w Porque|strong="H3282"\w* te has enfurecido contra mí y tu arrogancia ha llegado \w a|strong="H3068"\w* mis oídos, te \w pondré|strong="H7760"\w* un gancho en la nariz y un freno en la \w boca|strong="H8193"\w*, y te \w haré|strong="H7760"\w* \w volver|strong="H7725"\w* \w por|strong="H3282"\w* el mismo \w camino|strong="H1870"\w* \w por|strong="H3282"\w* donde viniste”.   
\p
\v 29 “\w Y|strong="H3068"\w* \w esta|strong="H2088"\w* será la señal para ustedes: \w Este|strong="H2088"\w* \w año|strong="H8141"\w* comerán \w lo|strong="H2088"\w* \w que|strong="H2088"\w* brote \w por|strong="H2088"\w* sí solo, y el próximo \w año|strong="H8141"\w* \w lo|strong="H2088"\w* \w que|strong="H2088"\w* nazca de eso mismo. Pero al tercer \w año|strong="H8141"\w*, ustedes siembren y cosechen, planten viñedos y coman de su \w fruto|strong="H6529"\w*.  
\v 30 Los sobrevivientes de la \w familia|strong="H1004"\w* de \w Judá|strong="H3063"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* echar \w raíces|strong="H8328"\w* y \w a|strong="H3068"\w* dar \w fruto|strong="H6529"\w*.  
\v 31 \w Porque|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén \w saldrá|strong="H3318"\w* un pequeño grupo \w de|strong="H3588"\w* sobrevivientes; un \w resto|strong="H7611"\w* del \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w*. ¡\w El|strong="H3588"\w* \w celo|strong="H7068"\w* \w de|strong="H3588"\w* Yahvé \w lo|strong="H6213"\w* llevará \w a|strong="H3068"\w* cabo!   
\p
\v 32 “\w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria: “\w Él|strong="H5921"\w* \w no|strong="H3808"\w* entrará \w en|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w ni|strong="H3808"\w* disparará una sola flecha \w contra|strong="H5921"\w* \w ella|strong="H8033"\w*. \w No|strong="H3808"\w* \w se|strong="H5921"\w* acercará \w con|strong="H5921"\w* \w escudos|strong="H4043"\w* \w ni|strong="H3808"\w* levantará rampas \w para|strong="H5921"\w* atacarla.  
\v 33 Tendrá \w que|strong="H3808"\w* \w volver|strong="H7725"\w* \w por|strong="H1870"\w* el mismo \w camino|strong="H1870"\w* \w por|strong="H1870"\w* donde \w vino|strong="H1870"\w*; en \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w no|strong="H3808"\w* entrará. Yo, Yahvé, \w lo|strong="H3808"\w* afirmo.  
\v 34 Yo mismo protegeré \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* y \w la|strong="H2063"\w* \w salvaré|strong="H3467"\w*, \w por|strong="H4616"\w* consideración \w a|strong="H3068"\w* mi nombre y \w a|strong="H3068"\w* mi \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*””.   
\p
\v 35 \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w*, \w el|strong="H1931"\w* \w ángel|strong="H4397"\w* \w de|strong="H2568"\w* Yahvé \w salió|strong="H3318"\w* y \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* y \w cinco|strong="H2568"\w* \w mil|strong="H3967"\w* soldados \w en|strong="H3318"\w* \w el|strong="H1931"\w* \w campamento|strong="H4264"\w* \w de|strong="H2568"\w* \w los|strong="H3605"\w* asirios. \w Cuando|strong="H1961"\w* \w los|strong="H3605"\w* sobrevivientes \w se|strong="H1961"\w* levantaron \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w* siguiente, ¡vieron \w que|strong="H1931"\w* \w todo|strong="H3605"\w* \w estaba|strong="H1961"\w* lleno \w de|strong="H2568"\w* cadáveres!  
\v 36 \w Entonces|strong="H7725"\w* Senaquerib, \w rey|strong="H4428"\w* de Asiria, levantó \w el|strong="H3427"\w* campamento y regresó \w a|strong="H3068"\w* \w Nínive|strong="H5210"\w*, donde se \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir.  
\v 37 Un \w día|strong="H1121"\w*, mientras \w estaba|strong="H1961"\w* \w adorando|strong="H7812"\w* \w en|strong="H8478"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H8478"\w* \w su|strong="H1931"\w* dios Nisroc, \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* Adramelec y Sharezer \w lo|strong="H1931"\w* \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w* y \w luego|strong="H1931"\w* huyeron \w a|strong="H3068"\w* \w la|strong="H1931"\w* tierra \w de|strong="H8478"\w* Ararat. \w Su|strong="H1931"\w* \w hijo|strong="H1121"\w* Esarjadón \w reinó|strong="H4427"\w* \w en|strong="H8478"\w* \w su|strong="H1931"\w* \w lugar|strong="H8478"\w*.   
\c 20  
\p
\v 1 \w Por|strong="H3588"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, Ezequías \w se|strong="H3808"\w* \w enfermó|strong="H2470"\w* \w de|strong="H3588"\w* \w muerte|strong="H4191"\w*. \w El|strong="H3588"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Amós \w fue|strong="H3808"\w* \w a|strong="H3068"\w* verlo \w y|strong="H3588"\w* le dijo: “\w Así|strong="H3541"\w* dice Yahvé: “Pon tus asuntos \w en|strong="H3588"\w* \w orden|strong="H6680"\w*, \w porque|strong="H3588"\w* vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*; \w no|strong="H3808"\w* \w te|strong="H3588"\w* recuperarás””.   
\p
\v 2 Ezequías volvió la \w cara|strong="H6440"\w* \w hacia|strong="H6440"\w* la \w pared|strong="H7023"\w* y \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé:  
\v 3 “\w Te|strong="H5869"\w* \w ruego|strong="H4994"\w*, Yahvé, \w que|strong="H4994"\w* \w te|strong="H5869"\w* acuerdes \w de|strong="H6440"\w* \w que|strong="H4994"\w* me he conducido \w ante|strong="H6440"\w* ti con sinceridad y \w de|strong="H6440"\w* todo \w corazón|strong="H3824"\w*, y \w que|strong="H4994"\w* he \w hecho|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H4994"\w* \w te|strong="H5869"\w* \w agrada|strong="H2896"\w*”. \w Y|strong="H3068"\w* Ezequías \w lloró|strong="H1058"\w* \w amargamente|strong="H1058"\w*.   
\p
\v 4 Antes \w de|strong="H1697"\w* \w que|strong="H3808"\w* \w Isaías|strong="H3470"\w* \w saliera|strong="H3318"\w* al patio central, Yahvé le dio \w este|strong="H1961"\w* mensaje:  
\v 5 “Regresa \w y|strong="H3541"\w* dile \w a|strong="H3068"\w* Ezequías, el soberano \w de|strong="H5971"\w* mi \w pueblo|strong="H5971"\w*: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* tu antepasado \w David|strong="H1732"\w*: He escuchado tu \w oración|strong="H8605"\w* \w y|strong="H3541"\w* he \w visto|strong="H7200"\w* tus \w lágrimas|strong="H1832"\w*. Yo te voy \w a|strong="H3068"\w* sanar, \w y|strong="H3541"\w* pasado mañana mismo podrás ir al \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé.  
\v 6 \w Te|strong="H5921"\w* daré \w quince|strong="H2568"\w* \w años|strong="H8141"\w* \w más|strong="H3254"\w* \w de|strong="H5921"\w* \w vida|strong="H3117"\w*. \w Además|strong="H5921"\w*, \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w los|strong="H5921"\w* \w libraré|strong="H5337"\w* \w del|strong="H5921"\w* poder \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria. Yo mismo protegeré \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w por|strong="H5921"\w* consideración \w a|strong="H3068"\w* \w mi|strong="H5921"\w* nombre \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*””.   
\p
\v 7 Entonces \w Isaías|strong="H3470"\w* \w ordenó|strong="H7760"\w*: “Preparen una pasta \w de|strong="H5921"\w* \w higos|strong="H8384"\w*”.  
\p Así \w lo|strong="H5921"\w* \w hicieron|strong="H7760"\w*; \w la|strong="H5921"\w* aplicaron \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* parte infectada, \w y|strong="H5921"\w* \w el|strong="H5921"\w* rey sanó.   
\p
\v 8 Ezequías le \w había|strong="H3588"\w* preguntado \w a|strong="H3068"\w* \w Isaías|strong="H3470"\w*: “¿\w Qué|strong="H3588"\w* señal \w me|strong="H3588"\w* dará Yahvé \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* sanará \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* pasado mañana podré ir al \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé?”   
\p
\v 9 \w Isaías|strong="H3470"\w* \w respondió|strong="H7725"\w*: “\w Esta|strong="H2088"\w* \w es|strong="H2088"\w* \w la|strong="H3588"\w* señal \w que|strong="H3588"\w* Yahvé les \w dará|strong="H7725"\w* \w para|strong="H3588"\w* confirmar \w que|strong="H3588"\w* \w cumplirá|strong="H6213"\w* \w su|strong="H3588"\w* promesa: ¿Quieres \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w sombra|strong="H6738"\w* avance \w diez|strong="H6235"\w* \w grados|strong="H4609"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* reloj, \w o|strong="H3068"\w* \w que|strong="H3588"\w* retroceda \w diez|strong="H6235"\w* \w grados|strong="H4609"\w*?”   
\p
\v 10 “\w Es|strong="H3588"\w* \w fácil|strong="H7043"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w sombra|strong="H6738"\w* avance \w diez|strong="H6235"\w* \w grados|strong="H4609"\w* —contestó Ezequías—; \w lo|strong="H3808"\w* difícil \w es|strong="H3588"\w* \w que|strong="H3588"\w* retroceda”.   
\p
\v 11 \w El|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* invocó \w a|strong="H3068"\w* Yahvé, y Yahvé hizo que la \w sombra|strong="H6738"\w* retrocediera los \w diez|strong="H6235"\w* \w grados|strong="H4609"\w* que ya había bajado en \w el|strong="H5030"\w* reloj de sol de Acaz.   
\p
\v 12 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, Merodac Baladán \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Baladán, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia, \w le|strong="H1931"\w* \w envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w y|strong="H3588"\w* un regalo \w a|strong="H3068"\w* Ezequías, \w pues|strong="H3588"\w* \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* estado \w enfermo|strong="H2470"\w*.  
\v 13 Ezequías recibió \w a|strong="H3068"\w* \w los|strong="H5921"\w* mensajeros \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w mostró|strong="H7200"\w* \w todos|strong="H3605"\w* sus \w almacenes|strong="H3627"\w*: \w la|strong="H5921"\w* \w plata|strong="H3701"\w*, \w el|strong="H5921"\w* \w oro|strong="H2091"\w*, \w los|strong="H5921"\w* perfumes, \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* fino, su arsenal \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w había|strong="H1961"\w* \w en|strong="H5921"\w* sus tesoros. \w No|strong="H3808"\w* \w hubo|strong="H1961"\w* \w nada|strong="H3808"\w* \w en|strong="H5921"\w* su palacio \w ni|strong="H3808"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* su \w reino|strong="H1961"\w* \w que|strong="H3808"\w* Ezequías \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w mostrara|strong="H7200"\w*.   
\p
\v 14 Entonces \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* fue \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* Ezequías y le preguntó: “¿\w Qué|strong="H4100"\w* dijeron esos hombres, y de dónde vinieron?”  
\p “Vinieron de un país muy lejano, de Babilonia”, respondió Ezequías.   
\p
\v 15 “¿\w Y|strong="H3068"\w* \w qué|strong="H4100"\w* \w vieron|strong="H7200"\w* en tu palacio?”, volvió \w a|strong="H3068"\w* preguntar \w el|strong="H3605"\w* profeta.  
\p “\w Vieron|strong="H7200"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w hay|strong="H1961"\w* en \w mi|strong="H1961"\w* palacio —contestó Ezequías—. \w No|strong="H3808"\w* \w hay|strong="H1961"\w* \w nada|strong="H3808"\w* en mis tesoros \w que|strong="H4100"\w* \w no|strong="H3808"\w* les \w haya|strong="H1961"\w* mostrado”.   
\p
\v 16 Entonces \w Isaías|strong="H3470"\w* le dijo \w a|strong="H3068"\w* Ezequías: “\w Escucha|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé:  
\v 17 “Viene \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3808"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* hay \w en|strong="H5704"\w* tu palacio, \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* tus antepasados han acumulado \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w será|strong="H3808"\w* \w llevado|strong="H5375"\w* \w a|strong="H3068"\w* Babilonia. \w No|strong="H3808"\w* \w quedará|strong="H3498"\w* \w nada|strong="H3808"\w*”, \w dice|strong="H1697"\w* Yahvé.  
\v 18 “Incluso \w a|strong="H3068"\w* algunos \w de|strong="H4480"\w* tus \w hijos|strong="H1121"\w*, tus propios descendientes, \w se|strong="H1961"\w* \w los|strong="H1121"\w* llevarán \w para|strong="H4480"\w* \w que|strong="H4480"\w* sirvan \w como|strong="H1961"\w* \w eunucos|strong="H5631"\w* \w en|strong="H4480"\w* \w el|strong="H1121"\w* palacio \w del|strong="H4480"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia””.   
\p
\v 19 Ezequías respondió: “El mensaje \w de|strong="H1697"\w* Yahvé \w que|strong="H3808"\w* me has dado \w es|strong="H1961"\w* \w bueno|strong="H2896"\w*”. \w Y|strong="H3068"\w* \w es|strong="H1961"\w* \w que|strong="H3808"\w* pensaba: “Al menos mientras yo viva \w habrá|strong="H1961"\w* \w paz|strong="H7965"\w* y seguridad”.   
\p
\v 20 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Ezequías, \w sus|strong="H1992"\w* hazañas \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* construyó \w la|strong="H5921"\w* alberca \w y|strong="H5921"\w* \w el|strong="H5921"\w* túnel \w para|strong="H5921"\w* llevar \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 21 Cuando Ezequías murió, fue sepultado \w con|strong="H5973"\w* sus antepasados. Su \w hijo|strong="H1121"\w* \w Manasés|strong="H4519"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\c 21  
\p
\v 1 \w Manasés|strong="H4519"\w* tenía \w doce|strong="H8147"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w cincuenta|strong="H2572"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w*. Su madre se \w llamaba|strong="H8034"\w* Hefzibá.  
\v 2 Pero \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H1121"\w* ofende \w a|strong="H3068"\w* Yahvé, pues siguió las prácticas repugnantes \w de|strong="H6440"\w* las \w naciones|strong="H1471"\w* \w que|strong="H1121"\w* Yahvé \w había|strong="H6213"\w* expulsado al paso \w de|strong="H6440"\w* \w los|strong="H1121"\w* israelitas.  
\v 3 Reconstruyó \w los|strong="H3605"\w* santuarios paganos \w que|strong="H3605"\w* su padre Ezequías \w había|strong="H6213"\w* destruido; también \w levantó|strong="H6965"\w* \w altares|strong="H4196"\w* en honor \w a|strong="H3068"\w* \w Baal|strong="H1168"\w* \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* una imagen de \w la|strong="H3605"\w* diosa Asera, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* Acab, \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*. Además, \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* astros \w del|strong="H4196"\w* \w cielo|strong="H8064"\w* y les rindió culto.  
\v 4 Construyó \w altares|strong="H4196"\w* paganos incluso en el \w templo|strong="H1004"\w* de Yahvé, \w donde|strong="H8034"\w* Yahvé había dicho: “En Jerusalén \w pondré|strong="H7760"\w* \w mi|strong="H3389"\w* \w nombre|strong="H8034"\w*”.  
\v 5 En \w los|strong="H3605"\w* \w dos|strong="H8147"\w* \w atrios|strong="H2691"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w* de Yahvé construyó \w altares|strong="H4196"\w* para rendir culto \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* astros \w del|strong="H4196"\w* \w cielo|strong="H8064"\w*.  
\v 6 Incluso sacrificó \w a|strong="H3068"\w* su propio \w hijo|strong="H1121"\w* en \w el|strong="H1121"\w* fuego, practicó la hechicería y la adivinación, y consultó \w a|strong="H3068"\w* espiritistas y \w a|strong="H3068"\w* quienes practicaban la magia. \w Hizo|strong="H6213"\w* \w muchas|strong="H7235"\w* \w cosas|strong="H7451"\w* \w que|strong="H1121"\w* ofenden \w a|strong="H3068"\w* Yahvé, provocando así su ira.  
\v 7 Tomó \w la|strong="H3605"\w* \w imagen|strong="H6459"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* diosa Asera \w que|strong="H1121"\w* \w él|strong="H3605"\w* \w mismo|strong="H3605"\w* \w había|strong="H6213"\w* mandado \w hacer|strong="H6213"\w* y \w la|strong="H3605"\w* \w puso|strong="H7760"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w*, \w aquel|strong="H2088"\w* lugar del cual Yahvé les \w había|strong="H6213"\w* dicho \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*: “En \w este|strong="H2088"\w* \w templo|strong="H1004"\w*, y en Jerusalén, \w la|strong="H3605"\w* ciudad \w que|strong="H1121"\w* elegí entre \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w pondré|strong="H7760"\w* \w mi|strong="H3389"\w* \w nombre|strong="H8034"\w* para \w siempre|strong="H5769"\w*.  
\v 8 \w Si|strong="H3808"\w* \w los|strong="H3605"\w* israelitas \w se|strong="H4480"\w* cuidan \w de|strong="H4480"\w* obedecer \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H4480"\w* \w les|strong="H6680"\w* he \w mandado|strong="H6680"\w* y \w de|strong="H4480"\w* seguir \w toda|strong="H3605"\w* \w la|strong="H8104"\w* \w ley|strong="H8451"\w* \w que|strong="H4480"\w* mi \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w* \w les|strong="H6680"\w* \w entregó|strong="H5414"\w*, \w no|strong="H3808"\w* permitiré \w que|strong="H4480"\w* vuelvan \w a|strong="H3068"\w* andar errantes lejos \w de|strong="H4480"\w* \w la|strong="H8104"\w* tierra \w que|strong="H4480"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* sus antepasados”.  
\v 9 Pero \w el|strong="H1121"\w* pueblo \w no|strong="H3808"\w* \w escuchó|strong="H8085"\w*, y \w Manasés|strong="H4519"\w* \w los|strong="H1121"\w* desvió \w para|strong="H4480"\w* \w que|strong="H4480"\w* hicieran \w más|strong="H4480"\w* \w mal|strong="H7451"\w* \w que|strong="H4480"\w* las \w naciones|strong="H1471"\w* \w que|strong="H4480"\w* Yahvé \w había|strong="H6213"\w* destruido \w delante|strong="H6440"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* israelitas.   
\p
\v 10 Entonces Yahvé \w habló|strong="H1696"\w* \w por|strong="H3027"\w* \w medio|strong="H3027"\w* de sus \w siervos|strong="H5650"\w* los \w profetas|strong="H5030"\w*:  
\v 11 “\w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w Manasés|strong="H4519"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* ha cometido \w estas|strong="H6213"\w* prácticas asquerosas. Ha \w hecho|strong="H6213"\w* \w más|strong="H1571"\w* \w mal|strong="H7489"\w* \w que|strong="H1571"\w* \w los|strong="H3605"\w* amorreos \w que|strong="H1571"\w* vivieron \w antes|strong="H6440"\w* \w que|strong="H1571"\w* \w él|strong="H3605"\w*, \w y|strong="H1571"\w* \w con|strong="H1571"\w* sus \w ídolos|strong="H1544"\w* ha \w hecho|strong="H6213"\w* \w que|strong="H1571"\w* \w Judá|strong="H3063"\w* \w peque|strong="H2398"\w*.  
\v 12 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘Voy \w a|strong="H3068"\w* enviar \w tal|strong="H3651"\w* desgracia \w sobre|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w que|strong="H5921"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* \w oiga|strong="H8085"\w* \w le|strong="H5921"\w* zumbarán \w los|strong="H5921"\w* \w oídos|strong="H8085"\w*’.  
\v 13 Usaré \w con|strong="H5921"\w* Jerusalén \w la|strong="H5921"\w* misma medida \w que|strong="H5921"\w* usé \w con|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* misma plomada \w que|strong="H5921"\w* usé \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* Acab. Limpiaré \w a|strong="H3068"\w* Jerusalén \w como|strong="H5921"\w* quien limpia un tazón \w y|strong="H5921"\w* \w lo|strong="H5921"\w* voltea boca abajo.  
\v 14 Abandonaré \w a|strong="H3068"\w* \w los|strong="H3605"\w* sobrevivientes \w de|strong="H5414"\w* \w mi|strong="H1961"\w* pueblo y \w los|strong="H3605"\w* \w entregaré|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* sus enemigos; \w se|strong="H1961"\w* convertirán en botín y presa \w de|strong="H5414"\w* \w todos|strong="H3605"\w* sus adversarios.  
\v 15 \w Haré|strong="H6213"\w* \w esto|strong="H2088"\w* \w porque|strong="H3282"\w* han \w hecho|strong="H6213"\w* \w lo|strong="H2088"\w* \w que|strong="H4480"\w* \w me|strong="H4480"\w* ofende \w y|strong="H5704"\w* han provocado \w mi|strong="H1961"\w* \w ira|strong="H3318"\w* \w desde|strong="H4480"\w* \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* sus antepasados \w salieron|strong="H3318"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*”.   
\p
\v 16 \w Además|strong="H1571"\w* \w de|strong="H5704"\w* haber arrastrado \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w al|strong="H5704"\w* \w pecado|strong="H2403"\w* \w de|strong="H5704"\w* \w hacer|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5704"\w* ofende \w a|strong="H3068"\w* Yahvé, \w Manasés|strong="H4519"\w* \w derramó|strong="H8210"\w* tanta \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w* \w que|strong="H5704"\w* \w llenó|strong="H4390"\w* \w a|strong="H3068"\w* Jerusalén \w de|strong="H5704"\w* un extremo \w a|strong="H3068"\w* otro.   
\p
\v 17 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Manasés|strong="H4519"\w*, \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* \w y|strong="H5921"\w* \w los|strong="H1992"\w* \w pecados|strong="H2403"\w* \w que|strong="H3808"\w* \w cometió|strong="H2398"\w*, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 18 Cuando \w Manasés|strong="H4519"\w* murió, fue \w sepultado|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* \w el|strong="H5973"\w* jardín \w de|strong="H8478"\w* su palacio, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w el|strong="H5973"\w* jardín \w de|strong="H8478"\w* Uza. Su \w hijo|strong="H1121"\w* Amón \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 19 Amón tenía \w veintidós|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó \w en|strong="H4480"\w* Jerusalén \w dos|strong="H8147"\w* \w años|strong="H8141"\w*. Su madre \w se|strong="H4480"\w* \w llamaba|strong="H8034"\w* Mesulmet, \w hija|strong="H1323"\w* \w de|strong="H4480"\w* Haruz, \w de|strong="H4480"\w* la ciudad \w de|strong="H4480"\w* \w Jotba|strong="H3192"\w*.  
\v 20 Amón \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que ofende \w a|strong="H3068"\w* Yahvé, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* su padre \w Manasés|strong="H4519"\w*.  
\v 21 \w Siguió|strong="H3212"\w* \w el|strong="H3605"\w* mal ejemplo de su padre y \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* mismos \w ídolos|strong="H1544"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* su padre había servido.  
\v 22 Abandonó \w a|strong="H3068"\w* Yahvé, el \w Dios|strong="H3068"\w* de sus antepasados, y \w no|strong="H3808"\w* quiso seguir su \w camino|strong="H1870"\w*.  
\v 23 \w Los|strong="H5921"\w* oficiales \w de|strong="H5921"\w* Amón \w conspiraron|strong="H7194"\w* \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* asesinaron \w en|strong="H5921"\w* su propio palacio.  
\v 24 Pero \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w del|strong="H5921"\w* país \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* habían conspirado \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Amón, \w y|strong="H5921"\w* nombraron \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Josías|strong="H2977"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w*.  
\v 25 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Amón están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 26 Amón fue \w sepultado|strong="H6912"\w* \w en|strong="H6912"\w* su tumba, \w en|strong="H6912"\w* \w el|strong="H1121"\w* jardín \w de|strong="H8478"\w* Uza, y su \w hijo|strong="H1121"\w* \w Josías|strong="H2977"\w* \w reinó|strong="H4427"\w* \w en|strong="H6912"\w* su \w lugar|strong="H8478"\w*.   
\c 22  
\p
\v 1 \w Josías|strong="H2977"\w* tenía \w ocho|strong="H8083"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w treinta|strong="H7970"\w* y un \w años|strong="H8141"\w*. Su madre se \w llamaba|strong="H8034"\w* Jedidá \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w Adaías|strong="H5718"\w*, \w de|strong="H1121"\w* Bozcat.  
\v 2 Josías \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w le|strong="H5869"\w* agrada \w a|strong="H3068"\w* Yahvé y \w siguió|strong="H3212"\w* \w en|strong="H5493"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* ejemplo \w de|strong="H5869"\w* su antepasado \w David|strong="H1732"\w*, \w sin|strong="H3808"\w* desviarse \w para|strong="H5493"\w* \w nada|strong="H3808"\w* \w de|strong="H5869"\w* ese \w camino|strong="H1870"\w*.   
\p
\v 3 En \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* \w de|strong="H1121"\w* su \w reinado|strong="H4428"\w*, \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w* \w envió|strong="H7971"\w* \w al|strong="H4428"\w* \w secretario|strong="H5608"\w* Safán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Azalía y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Mesulam \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé con \w esta|strong="H1961"\w* orden:  
\v 4 “\w Ve|strong="H5927"\w* \w a|strong="H3068"\w* ver al \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* y dile \w que|strong="H5971"\w* junte el \w dinero|strong="H3701"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* ha recaudado en el \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, el cual los guardianes \w de|strong="H5971"\w* \w la|strong="H8104"\w* entrada han recibido del \w pueblo|strong="H5971"\w*.  
\v 5 Entreguen ese dinero \w a|strong="H3068"\w* \w los|strong="H5921"\w* supervisores \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w obra|strong="H4399"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w ellos|strong="H3027"\w* \w les|strong="H5921"\w* paguen \w a|strong="H3068"\w* \w los|strong="H5921"\w* trabajadores \w que|strong="H5921"\w* están reparando \w los|strong="H5921"\w* \w daños|strong="H5414"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*;  
\v 6 es decir, \w a|strong="H3068"\w* los \w carpinteros|strong="H2796"\w*, \w a|strong="H3068"\w* los maestros de obra y \w a|strong="H3068"\w* los \w albañiles|strong="H2796"\w*. Que se use también para comprar \w madera|strong="H6086"\w* y piedra labrada para la restauración del \w edificio|strong="H1004"\w*.  
\v 7 \w Pero|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w les|strong="H1992"\w* pidan cuentas \w del|strong="H5921"\w* \w dinero|strong="H3701"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w les|strong="H1992"\w* \w entregue|strong="H5414"\w*, \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w son|strong="H3588"\w* hombres \w de|strong="H5921"\w* \w toda|strong="H5921"\w* confianza.”   
\p
\v 8 Entonces \w el|strong="H5921"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w secretario|strong="H5608"\w* Safán: “He encontrado \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé”. \w Hilcías|strong="H2518"\w* \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w a|strong="H3068"\w* Safán, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w lo|strong="H5921"\w* \w leyó|strong="H7121"\w*.  
\v 9 \w Luego|strong="H7725"\w* Safán fue \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* informó: “Sus servidores han recogido \w el|strong="H5921"\w* \w dinero|strong="H3701"\w* \w que|strong="H5921"\w* \w estaba|strong="H1004"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H1697"\w* han \w entregado|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* supervisores \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w obra|strong="H4399"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.”  
\v 10 Además, el \w secretario|strong="H5608"\w* Safán le \w dijo|strong="H5046"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “El \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w* me \w entregó|strong="H5414"\w* un \w libro|strong="H5612"\w*”. \w Y|strong="H3068"\w* Safán \w lo|strong="H5612"\w* \w leyó|strong="H7121"\w* en \w presencia|strong="H6440"\w* del \w rey|strong="H4428"\w*.   
\p
\v 11 \w Cuando|strong="H1961"\w* el \w rey|strong="H4428"\w* \w escuchó|strong="H8085"\w* las \w palabras|strong="H1697"\w* del \w libro|strong="H5612"\w* \w de|strong="H1697"\w* la \w ley|strong="H8451"\w*, \w se|strong="H1961"\w* \w rasgó|strong="H7167"\w* la ropa en señal \w de|strong="H1697"\w* dolor.  
\v 12 Luego \w les|strong="H6680"\w* dio estas órdenes \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w*, \w a|strong="H3068"\w* Ajicam \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Safán, \w a|strong="H3068"\w* Acbor \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Micaías, \w al|strong="H4428"\w* \w secretario|strong="H5608"\w* Safán y \w a|strong="H3068"\w* \w Asaías|strong="H6222"\w*, \w el|strong="H1121"\w* oficial del \w rey|strong="H4428"\w*:  
\v 13 “\w Vayan|strong="H3212"\w* \w y|strong="H3588"\w* consulten \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* \w mí|strong="H5921"\w*, \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w*, \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w dice|strong="H1697"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w* \w que|strong="H3588"\w* han encontrado. \w La|strong="H1931"\w* \w ira|strong="H2534"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H1931"\w* encendió \w contra|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w porque|strong="H3588"\w* nuestros antepasados \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w dice|strong="H1697"\w* \w este|strong="H2088"\w* \w libro|strong="H5612"\w* \w ni|strong="H3808"\w* cumplieron \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w escrito|strong="H3789"\w* \w para|strong="H5921"\w* \w nosotros|strong="H3605"\w*.”   
\p
\v 14 Entonces \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w Hilcías|strong="H2518"\w*, Ajicam, Acbor, Safán y \w Asaías|strong="H6222"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w profetisa|strong="H5031"\w* Hulda. \w Ella|strong="H1931"\w* \w era|strong="H1931"\w* esposa \w de|strong="H1121"\w* Salum \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ticvá y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Harhas, \w el|strong="H1931"\w* encargado del vestuario. Hulda \w vivía|strong="H3427"\w* \w en|strong="H3212"\w* \w el|strong="H1931"\w* \w segundo|strong="H4932"\w* barrio \w de|strong="H1121"\w* Jerusalén. Cuando \w hablaron|strong="H1696"\w* con \w ella|strong="H1931"\w*,  
\v 15 ella les respondió: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*: Díganle al hombre \w que|strong="H3541"\w* los \w envió|strong="H7971"\w* \w a|strong="H3068"\w* mí:  
\v 16 ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: Voy \w a|strong="H3068"\w* enviar una desgracia \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* sus \w habitantes|strong="H3427"\w*, \w tal|strong="H2088"\w* \w como|strong="H5921"\w* \w dice|strong="H1697"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w ha|strong="H3541"\w* leído.  
\v 17 \w Porque|strong="H3808"\w* me han abandonado y han quemado incienso \w a|strong="H3068"\w* otros dioses, provocando mi \w ira|strong="H2534"\w* con \w todos|strong="H3605"\w* sus ídolos; \w por|strong="H8478"\w* eso mi \w furor|strong="H2534"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* encendido contra \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* y \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w apagará|strong="H3518"\w*.’  
\v 18 Pero \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Judá|strong="H3063"\w*, \w que|strong="H1697"\w* los \w envió|strong="H7971"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé, díganle \w esto|strong="H1697"\w*: ‘\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*, \w acerca|strong="H1697"\w* \w de|strong="H1697"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* has escuchado:  
\v 19 \w Como|strong="H1571"\w* tu \w corazón|strong="H3824"\w* \w se|strong="H1961"\w* conmovió \w y|strong="H1571"\w* \w te|strong="H5921"\w* humillaste \w ante|strong="H6440"\w* Yahvé \w al|strong="H5921"\w* \w oír|strong="H8085"\w* \w lo|strong="H2088"\w* \w que|strong="H5921"\w* \w dije|strong="H1696"\w* \w contra|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w* \w y|strong="H1571"\w* sus \w habitantes|strong="H3427"\w* —\w que|strong="H5921"\w* serían objeto \w de|strong="H5921"\w* horror \w y|strong="H1571"\w* \w de|strong="H5921"\w* \w maldición|strong="H7045"\w*—, \w y|strong="H1571"\w* \w como|strong="H1571"\w* \w te|strong="H5921"\w* rasgaste \w la|strong="H5921"\w* ropa \w y|strong="H1571"\w* lloraste \w ante|strong="H6440"\w* \w mí|strong="H5921"\w*, yo \w también|strong="H1571"\w* \w te|strong="H5921"\w* he escuchado. Yo, Yahvé, \w lo|strong="H2088"\w* afirmo.  
\v 20 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, cuando mueras, serás sepultado \w en|strong="H5921"\w* \w paz|strong="H7965"\w* \w con|strong="H5921"\w* tus antepasados. \w No|strong="H3808"\w* \w verán|strong="H7200"\w* tus \w ojos|strong="H5869"\w* \w la|strong="H5921"\w* desgracia \w que|strong="H3808"\w* voy \w a|strong="H3068"\w* enviar \w sobre|strong="H5921"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*’”. \w Y|strong="H3068"\w* \w ellos|strong="H5921"\w* regresaron \w a|strong="H3068"\w* llevarle \w la|strong="H5921"\w* \w respuesta|strong="H1697"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\c 23  
\p
\v 1 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* \w mandó|strong="H7971"\w* llamar \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* de \w Judá|strong="H3063"\w* y de Jerusalén para \w que|strong="H3605"\w* se reunieran con \w él|strong="H3605"\w*.  
\v 2 \w Luego|strong="H5927"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w subió|strong="H5927"\w* \w al|strong="H5704"\w* \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé acompañado \w de|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5704"\w* Jerusalén, \w junto|strong="H5971"\w* \w con|strong="H5704"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w más|strong="H5704"\w* \w grande|strong="H1419"\w*. Allí, ante \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w*, \w leyó|strong="H7121"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* del \w libro|strong="H5612"\w* del \w pacto|strong="H1285"\w* \w que|strong="H5704"\w* habían encontrado \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé.  
\v 3 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w puso|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w columna|strong="H5982"\w* \w y|strong="H5921"\w* renovó \w la|strong="H5921"\w* \w alianza|strong="H1285"\w* \w en|strong="H5921"\w* \w presencia|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé. \w Se|strong="H5921"\w* comprometió \w a|strong="H3068"\w* seguir \w a|strong="H3068"\w* Yahvé \w y|strong="H5921"\w* \w a|strong="H3068"\w* cumplir sus \w mandamientos|strong="H4687"\w*, mandatos \w y|strong="H5921"\w* leyes \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su \w corazón|strong="H3820"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w toda|strong="H3605"\w* su \w alma|strong="H5315"\w*, poniendo \w en|strong="H5921"\w* práctica \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w escritas|strong="H3789"\w* \w en|strong="H5921"\w* \w aquel|strong="H2088"\w* \w libro|strong="H5612"\w*. \w Y|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* comprometió \w también|strong="H2088"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w alianza|strong="H1285"\w*.   
\p
\v 4 Entonces \w el|strong="H1008"\w* \w rey|strong="H4428"\w* \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w* \w al|strong="H4428"\w* \w gran|strong="H1419"\w* \w sacerdote|strong="H3548"\w* Jilquías, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* de \w segundo|strong="H4932"\w* rango y \w a|strong="H3068"\w* \w los|strong="H3605"\w* guardianes de \w la|strong="H8104"\w* puerta, \w que|strong="H3605"\w* \w sacaran|strong="H3318"\w* del \w templo|strong="H1964"\w* de Yahvé \w todos|strong="H3605"\w* \w los|strong="H3605"\w* objetos \w que|strong="H3605"\w* se habían fabricado para \w Baal|strong="H1168"\w*, para \w la|strong="H8104"\w* diosa Asera y para \w todos|strong="H3605"\w* \w los|strong="H3605"\w* astros del \w cielo|strong="H8064"\w*. \w El|strong="H1008"\w* \w rey|strong="H4428"\w* \w quemó|strong="H8313"\w* \w todo|strong="H3605"\w* \w esto|strong="H6213"\w* \w fuera|strong="H2351"\w* de Jerusalén, \w en|strong="H3318"\w* \w los|strong="H3605"\w* campos del Cedrón, y \w mandó|strong="H6680"\w* llevar las cenizas \w a|strong="H3068"\w* Betel.  
\v 5 Destituyó \w a|strong="H3068"\w* \w los|strong="H3605"\w* sacerdotes paganos \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* habían nombrado \w para|strong="H5414"\w* quemar incienso en \w los|strong="H3605"\w* santuarios locales \w de|strong="H5414"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* y en \w los|strong="H3605"\w* alrededores \w de|strong="H5414"\w* Jerusalén, así como \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* quemaban incienso \w a|strong="H3068"\w* \w Baal|strong="H1168"\w*, \w al|strong="H4428"\w* \w sol|strong="H8121"\w*, \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w luna|strong="H3394"\w*, \w a|strong="H3068"\w* las constelaciones y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* astros del \w cielo|strong="H8064"\w*.  
\v 6 \w También|strong="H3318"\w* \w sacó|strong="H3318"\w* \w la|strong="H5921"\w* imagen \w de|strong="H5921"\w* \w la|strong="H5921"\w* diosa Asera \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w la|strong="H5921"\w* llevó \w fuera|strong="H2351"\w* \w de|strong="H5921"\w* Jerusalén, \w al|strong="H5921"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5921"\w* Cedrón. Allí \w la|strong="H5921"\w* \w quemó|strong="H8313"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* molió \w hasta|strong="H5921"\w* hacerla \w polvo|strong="H6083"\w*, \w y|strong="H5921"\w* esparció \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* tumbas \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* común.  
\v 7 Además, \w derribó|strong="H5422"\w* las \w casas|strong="H1004"\w* de prostitución sagrada que estaban \w dentro|strong="H8033"\w* del \w templo|strong="H1004"\w* de Yahvé, \w donde|strong="H8033"\w* las mujeres tejían mantos para la diosa Asera.  
\v 8 \w El|strong="H5921"\w* rey trajo \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* profanó \w los|strong="H5921"\w* santuarios locales \w donde|strong="H8033"\w* \w ellos|strong="H5921"\w* quemaban incienso, \w desde|strong="H5704"\w* Geba \w hasta|strong="H5704"\w* Berseba. También \w derribó|strong="H5422"\w* \w los|strong="H5921"\w* \w altares|strong="H1116"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w*, especialmente \w el|strong="H5921"\w* \w que|strong="H5921"\w* estaba \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w* \w de|strong="H5921"\w* \w Josué|strong="H3091"\w*, \w el|strong="H5921"\w* \w gobernador|strong="H8269"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w a|strong="H3068"\w* mano \w izquierda|strong="H8040"\w* \w de|strong="H5921"\w* \w quien|strong="H3605"\w* entra \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w* \w principal|strong="H8269"\w*.  
\v 9 \w Sin|strong="H3808"\w* embargo, \w los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H3588"\w* habían servido \w en|strong="H8432"\w* esos santuarios locales \w no|strong="H3808"\w* podían oficiar \w en|strong="H8432"\w* \w el|strong="H3588"\w* \w altar|strong="H4196"\w* \w de|strong="H3588"\w* Yahvé \w en|strong="H8432"\w* Jerusalén, \w aunque|strong="H3588"\w* \w sí|strong="H3588"\w* comían pan \w sin|strong="H3808"\w* levadura \w con|strong="H3588"\w* sus compañeros \w sacerdotes|strong="H3548"\w*.  
\v 10 Josías también profanó \w el|strong="H1121"\w* lugar llamado Tofet, en \w el|strong="H1121"\w* \w valle|strong="H1516"\w* \w de|strong="H1121"\w* Ben Hinom, para \w que|strong="H1115"\w* nadie volviera \w a|strong="H3068"\w* sacrificar en \w el|strong="H1121"\w* fuego \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w o|strong="H3068"\w* \w a|strong="H3068"\w* su \w hija|strong="H1323"\w* en honor al dios Moloc.  
\v 11 \w Quitó|strong="H7673"\w* los \w caballos|strong="H5483"\w* que los \w reyes|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w* habían dedicado \w al|strong="H4428"\w* \w sol|strong="H8121"\w* \w a|strong="H3068"\w* la entrada del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé, cerca \w de|strong="H5414"\w* la habitación del oficial Natán Melec, en el patio, y \w quemó|strong="H8313"\w* los \w carros|strong="H4818"\w* dedicados \w al|strong="H4428"\w* \w sol|strong="H8121"\w*.  
\v 12 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w derribó|strong="H5422"\w* \w los|strong="H5921"\w* \w altares|strong="H4196"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* habían construido \w en|strong="H5921"\w* \w la|strong="H5921"\w* azotea \w de|strong="H5921"\w* \w la|strong="H5921"\w* sala \w de|strong="H5921"\w* Acaz, así \w como|strong="H5921"\w* \w los|strong="H5921"\w* \w altares|strong="H4196"\w* \w que|strong="H5921"\w* \w Manasés|strong="H4519"\w* \w había|strong="H6213"\w* levantado \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w atrios|strong="H2691"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé. \w Los|strong="H5921"\w* \w hizo|strong="H6213"\w* pedazos \w y|strong="H5921"\w* arrojó \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w al|strong="H5921"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5921"\w* Cedrón.  
\v 13 También profanó \w los|strong="H1121"\w* santuarios \w que|strong="H5921"\w* estaban \w al|strong="H5921"\w* oriente \w de|strong="H5921"\w* Jerusalén, \w al|strong="H5921"\w* sur \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* Destrucción, \w los|strong="H1121"\w* cuales \w Salomón|strong="H8010"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, había construido \w para|strong="H5921"\w* Astoret, \w la|strong="H5921"\w* asquerosa diosa \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w sidonios|strong="H6722"\w*; \w para|strong="H5921"\w* Quemos, \w el|strong="H5921"\w* asqueroso dios \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w y|strong="H5921"\w* \w para|strong="H5921"\w* Milcom, \w el|strong="H5921"\w* detestable dios \w de|strong="H5921"\w* \w los|strong="H1121"\w* amonitas.  
\v 14 Destrozó las piedras sagradas, derribó las imágenes de la diosa Asera y \w llenó|strong="H4390"\w* esos \w lugares|strong="H4725"\w* con \w huesos|strong="H6106"\w* humanos.   
\p
\v 15 Incluso \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w de|strong="H1121"\w* Betel \w y|strong="H1571"\w* \w el|strong="H1931"\w* santuario \w que|strong="H1931"\w* \w había|strong="H6213"\w* construido \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w*, \w el|strong="H1931"\w* \w que|strong="H1931"\w* \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, Josías \w los|strong="H1121"\w* \w derribó|strong="H5422"\w*. \w Quemó|strong="H8313"\w* \w el|strong="H1931"\w* santuario \w y|strong="H1571"\w* \w lo|strong="H1931"\w* molió \w hasta|strong="H1931"\w* hacerlo \w polvo|strong="H6083"\w*; \w también|strong="H1571"\w* \w quemó|strong="H8313"\w* \w la|strong="H1931"\w* imagen \w de|strong="H1121"\w* \w la|strong="H1931"\w* diosa Asera.  
