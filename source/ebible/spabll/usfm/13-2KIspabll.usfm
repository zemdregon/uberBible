\toc1 SEGUNDO LIBRO DE LOS REYES 
\toc2 2 REYES 
\mt2 Segundo libro de los  
\mt1 Reyes  
\c 1  
\p
\v 1 \w Moab|strong="H4124"\w* se rebeló \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w* después de la \w muerte|strong="H4194"\w* de Ajab.   
\p
\v 2 Ocozías se \w cayó|strong="H5307"\w* \w por|strong="H1157"\w* la rejilla de su habitación superior \w en|strong="H3212"\w* \w Samaria|strong="H8111"\w* y quedó herido. Entonces \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* con \w esta|strong="H2088"\w* orden: “\w Vayan|strong="H3212"\w* y consulten \w a|strong="H3068"\w* Baal Zebub, \w el|strong="H5307"\w* dios de \w Ecrón|strong="H6138"\w*, para saber \w si|strong="H1157"\w* voy \w a|strong="H3068"\w* sanar de \w esta|strong="H2088"\w* \w enfermedad|strong="H2483"\w*”.   
\p
\v 3 Pero el \w ángel|strong="H4397"\w* de Yahvé\f + \fr 1:3 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Elías el tisbita: “\w Levántate|strong="H6965"\w*, sal \w al|strong="H4428"\w* encuentro de los \w mensajeros|strong="H4397"\w* del \w rey|strong="H4428"\w* de \w Samaria|strong="H8111"\w* y \w diles|strong="H1696"\w*: ‘¿Acaso \w no|strong="H1097"\w* hay \w Dios|strong="H3068"\w*\f + \fr 1:3 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* en \w Israel|strong="H3478"\w*, que \w van|strong="H1980"\w* ustedes \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Baal Zebub, el \w dios|strong="H3068"\w* de \w Ecrón|strong="H6138"\w*?  
\v 4 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé: “\w No|strong="H3808"\w* \w te|strong="H4480"\w* \w levantarás|strong="H5927"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w cama|strong="H4296"\w* \w donde|strong="H8033"\w* estás acostado, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w ciertamente|strong="H3588"\w* \w morirás|strong="H4191"\w*””. \w Y|strong="H3068"\w* Elías \w se|strong="H4480"\w* \w fue|strong="H3212"\w*.   
\p
\v 5 \w Cuando|strong="H4100"\w* los \w mensajeros|strong="H4397"\w* regresaron, el rey les preguntó: “¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* regresaron tan pronto?”.   
\p
\v 6 \w Ellos|strong="H4480"\w* le \w respondieron|strong="H1696"\w*: “Un hombre \w nos|strong="H4480"\w* \w salió|strong="H5927"\w* \w al|strong="H4480"\w* encuentro \w y|strong="H3588"\w* \w nos|strong="H4480"\w* \w dijo|strong="H1696"\w*: “\w Vayan|strong="H3212"\w*, regresen \w al|strong="H4480"\w* \w rey|strong="H4428"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w envió|strong="H7971"\w* \w y|strong="H3588"\w* díganle: ‘\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé: ¿Acaso \w no|strong="H3808"\w* hay \w Dios|strong="H3068"\w* \w en|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w que|strong="H3588"\w* mandan ustedes \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Baal Zebub, \w el|strong="H3588"\w* \w dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Ecrón|strong="H6138"\w*? \w Por|strong="H3588"\w* \w lo|strong="H3808"\w* \w tanto|strong="H3651"\w*, \w no|strong="H3808"\w* \w te|strong="H4480"\w* \w levantarás|strong="H5927"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w cama|strong="H4296"\w* \w donde|strong="H8033"\w* estás acostado, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w ciertamente|strong="H3588"\w* \w morirás|strong="H4191"\w*’”.   
\p
\v 7 El rey les preguntó: “¿\w Cómo|strong="H4100"\w* era el hombre \w que|strong="H4100"\w* les \w salió|strong="H5927"\w* al encuentro y les \w dijo|strong="H1696"\w* esas \w palabras|strong="H1697"\w*?”   
\p
\v 8 \w Ellos|strong="H1931"\w* contestaron: “\w Era|strong="H1931"\w* un hombre \w que|strong="H1931"\w* usaba un manto de \w pelo|strong="H8181"\w* y llevaba un cinturón de cuero en \w la|strong="H1931"\w* cintura”.  
\p Entonces \w el|strong="H1931"\w* rey dijo: “\w Es|strong="H1931"\w* Elías \w el|strong="H1931"\w* tisbita”.   
\p
\v 9 \w Luego|strong="H5927"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* un \w capitán|strong="H8269"\w* \w con|strong="H5921"\w* sus \w cincuenta|strong="H2572"\w* hombres \w a|strong="H3068"\w* buscarlo. \w El|strong="H5921"\w* \w capitán|strong="H8269"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* \w donde|strong="H5921"\w* \w estaba|strong="H3427"\w* Elías, \w que|strong="H5921"\w* \w estaba|strong="H3427"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cumbre|strong="H7218"\w* \w del|strong="H5921"\w* \w monte|strong="H2022"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w dijo|strong="H1696"\w*: “Hombre \w de|strong="H5921"\w* Dios, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* ordena \w que|strong="H5921"\w* bajes”.   
\p
\v 10 Elías le \w respondió|strong="H6030"\w* \w al|strong="H4480"\w* \w capitán|strong="H8269"\w*: “Si soy hombre \w de|strong="H4480"\w* Dios, ¡\w que|strong="H4480"\w* baje fuego \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* y los consuma \w a|strong="H3068"\w* \w ti|strong="H4480"\w* y \w a|strong="H3068"\w* tus \w cincuenta|strong="H2572"\w* hombres!” \w En|strong="H4480"\w* ese momento bajó fuego \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* y los consumió \w a|strong="H3068"\w* él y \w a|strong="H3068"\w* sus \w cincuenta|strong="H2572"\w*.   
\p
\v 11 El \w rey|strong="H4428"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* enviar \w a|strong="H3068"\w* otro \w capitán|strong="H8269"\w* con otros \w cincuenta|strong="H2572"\w* hombres. Este le \w dijo|strong="H1696"\w*: “Hombre \w de|strong="H8269"\w* Dios, el \w rey|strong="H4428"\w* ordena: ‘¡\w Baja|strong="H3381"\w* \w de|strong="H8269"\w* inmediato!’”.   
\p
\v 12 Elías les \w respondió|strong="H6030"\w*: “Si soy hombre \w de|strong="H4480"\w* Dios, ¡\w que|strong="H4480"\w* baje fuego \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* y los consuma \w a|strong="H3068"\w* ustedes y \w a|strong="H3068"\w* sus \w cincuenta|strong="H2572"\w*!” \w Y|strong="H3068"\w* el fuego \w de|strong="H4480"\w* Dios bajó \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* y lo consumió \w a|strong="H3068"\w* él y \w a|strong="H3068"\w* sus \w cincuenta|strong="H2572"\w*.   
\p
\v 13 \w Por|strong="H5921"\w* \w tercera|strong="H7992"\w* vez, \w el|strong="H5921"\w* rey \w envió|strong="H7971"\w* \w a|strong="H3068"\w* un \w capitán|strong="H8269"\w* \w con|strong="H5921"\w* sus \w cincuenta|strong="H2572"\w* hombres. Este tercer \w capitán|strong="H8269"\w* \w subió|strong="H5927"\w*, \w se|strong="H5921"\w* \w puso|strong="H7971"\w* \w de|strong="H5921"\w* \w rodillas|strong="H1290"\w* \w delante|strong="H5048"\w* \w de|strong="H5921"\w* Elías \w y|strong="H5921"\w* \w le|strong="H5921"\w* suplicó: “Hombre \w de|strong="H5921"\w* Dios, \w le|strong="H5921"\w* \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w vida|strong="H5315"\w* \w de|strong="H5921"\w* estos \w cincuenta|strong="H2572"\w* \w siervos|strong="H5650"\w* suyos tengan algún \w valor|strong="H3365"\w* ante sus \w ojos|strong="H5869"\w*.  
\v 14 \w Ya|strong="H3068"\w* \w sé|strong="H4480"\w* \w que|strong="H4480"\w* ha bajado fuego \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* y consumió \w a|strong="H3068"\w* los \w dos|strong="H8147"\w* \w primeros|strong="H7223"\w* \w capitanes|strong="H8269"\w* \w con|strong="H4480"\w* sus \w hombres|strong="H8147"\w*. Pero \w ahora|strong="H6258"\w*, \w por|strong="H4480"\w* favor, respete \w mi|strong="H2009"\w* \w vida|strong="H5315"\w*”.   
\p
\v 15 Entonces el \w ángel|strong="H4397"\w* \w de|strong="H6440"\w* Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Elías: “\w Baja|strong="H3381"\w* con él; \w no|strong="H6440"\w* le tengas \w miedo|strong="H3372"\w*”.  
\p \w Así|strong="H1696"\w* que Elías se \w levantó|strong="H6965"\w* y bajó con él para ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 16 \w Y|strong="H3068"\w* le \w dijo|strong="H1696"\w* \w al|strong="H4480"\w* rey: “\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* Yahvé: ‘\w Porque|strong="H3588"\w* \w enviaste|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Baal Zebub, \w dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Ecrón|strong="H6138"\w*, \w como|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3808"\w* hubiera \w Dios|strong="H3068"\w* \w en|strong="H4480"\w* \w Israel|strong="H3478"\w* \w para|strong="H3588"\w* consultar \w su|strong="H3588"\w* \w palabra|strong="H1697"\w*, \w no|strong="H3808"\w* \w te|strong="H4480"\w* \w levantarás|strong="H5927"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w cama|strong="H4296"\w* \w donde|strong="H8033"\w* estás acostado, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w morirás|strong="H4191"\w* \w sin|strong="H3808"\w* remedio’”.   
\p
\v 17 Ocozías \w murió|strong="H4191"\w*, \w tal|strong="H1697"\w* \w como|strong="H3588"\w* Yahvé \w lo|strong="H1697"\w* \w había|strong="H1961"\w* \w dicho|strong="H1697"\w* \w por|strong="H3588"\w* medio \w de|strong="H3588"\w* Elías. \w Como|strong="H3588"\w* \w no|strong="H3808"\w* \w tenía|strong="H1961"\w* \w hijos|strong="H1121"\w*, \w Joram|strong="H3088"\w* comenzó \w a|strong="H3068"\w* reinar \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w lugar|strong="H8478"\w*. \w Esto|strong="H1697"\w* \w sucedió|strong="H1961"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* \w de|strong="H3588"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*.  
\v 18 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Ocozías están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\c 2  
\p
\v 1 \w Cuando|strong="H1961"\w* Yahvé \w estaba|strong="H1961"\w* \w por|strong="H4480"\w* llevarse \w a|strong="H3068"\w* Elías \w al|strong="H4480"\w* \w cielo|strong="H8064"\w* \w en|strong="H4480"\w* un torbellino, Elías y Eliseo \w salieron|strong="H5927"\w* \w de|strong="H4480"\w* \w Gilgal|strong="H1537"\w*.  
\v 2 Elías le dijo \w a|strong="H3068"\w* Eliseo: “\w Por|strong="H3588"\w* favor, \w quédate|strong="H3427"\w* \w aquí|strong="H6311"\w*, \w porque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* Betel”.  
\p \w Pero|strong="H3588"\w* Eliseo le respondió: “Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w vive|strong="H2416"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* tú \w vives|strong="H2416"\w*, \w no|strong="H3588"\w* \w te|strong="H3588"\w* \w dejaré|strong="H7971"\w* solo”. \w Así|strong="H3588"\w* \w que|strong="H3588"\w* ambos \w bajaron|strong="H3381"\w* \w a|strong="H3068"\w* Betel.   
\p
\v 3 \w Los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w estaban|strong="H7218"\w* \w en|strong="H5921"\w* Betel \w salieron|strong="H3318"\w* \w al|strong="H5921"\w* encuentro \w de|strong="H5921"\w* Eliseo \w y|strong="H1571"\w* \w le|strong="H5921"\w* preguntaron: “¿\w Sabes|strong="H3045"\w* \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* \w mismo|strong="H1571"\w* Yahvé \w se|strong="H3045"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* llevar \w a|strong="H3068"\w* tu maestro?”  
\p \w Él|strong="H5921"\w* respondió: “\w Sí|strong="H3588"\w*, \w ya|strong="H1571"\w* \w lo|strong="H5921"\w* \w sé|strong="H3045"\w*. \w No|strong="H3588"\w* digan nada”.   
\p
\v 4 Elías le volvió \w a|strong="H3068"\w* decir: “Eliseo, \w por|strong="H3588"\w* favor, \w quédate|strong="H3427"\w* \w aquí|strong="H6311"\w*, \w porque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*”.  
\p \w Pero|strong="H3588"\w* \w él|strong="H3588"\w* insistió: “Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w vive|strong="H2416"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* tú \w vives|strong="H2416"\w*, \w no|strong="H3588"\w* \w te|strong="H3588"\w* \w dejaré|strong="H7971"\w* solo”. \w Así|strong="H3588"\w* \w que|strong="H3588"\w* llegaron \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*.   
\p
\v 5 \w Los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w estaban|strong="H7218"\w* \w en|strong="H5921"\w* \w Jericó|strong="H3405"\w* \w se|strong="H3045"\w* acercaron \w a|strong="H3068"\w* Eliseo \w y|strong="H1571"\w* \w le|strong="H5921"\w* preguntaron: “¿\w Sabes|strong="H3045"\w* \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* \w mismo|strong="H1571"\w* Yahvé \w se|strong="H3045"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* llevar \w a|strong="H3068"\w* tu maestro?”  
\p \w Él|strong="H5921"\w* respondió: “\w Sí|strong="H3588"\w*, \w ya|strong="H1571"\w* \w lo|strong="H5921"\w* \w sé|strong="H3045"\w*. Guarden silencio”.   
\p
\v 6 \w Luego|strong="H4994"\w* Elías le dijo: “\w Te|strong="H3588"\w* \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* quedes \w aquí|strong="H6311"\w*, \w porque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* ha \w enviado|strong="H7971"\w* al \w Jordán|strong="H3383"\w*”.  
\p \w Pero|strong="H3588"\w* Eliseo repitió: “Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w vive|strong="H2416"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* tú \w vives|strong="H2416"\w*, \w no|strong="H3588"\w* \w te|strong="H3588"\w* \w dejaré|strong="H7971"\w* solo”. \w Entonces|strong="H3588"\w* \w los|strong="H3427"\w* \w dos|strong="H8147"\w* siguieron adelante.  
\v 7 \w Cincuenta|strong="H2572"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* escuela \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w fueron|strong="H1980"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* pararon \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* cierta \w distancia|strong="H7350"\w*, mientras \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w se|strong="H5921"\w* detenían \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*.  
\v 8 Elías \w tomó|strong="H3947"\w* su capa, la enrolló y golpeó \w el|strong="H5674"\w* \w agua|strong="H4325"\w*. \w El|strong="H5674"\w* \w agua|strong="H4325"\w* se dividió \w en|strong="H5221"\w* \w dos|strong="H8147"\w*, y los \w dos|strong="H8147"\w* cruzaron por tierra seca.  
\v 9 \w Cuando|strong="H4100"\w* \w ya|strong="H4994"\w* \w habían|strong="H1961"\w* cruzado, Elías \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* Eliseo: “Dime \w qué|strong="H4100"\w* quieres \w que|strong="H4100"\w* \w haga|strong="H6213"\w* \w por|strong="H4100"\w* \w ti|strong="H5973"\w* \w antes|strong="H2962"\w* \w de|strong="H5973"\w* \w que|strong="H4100"\w* \w me|strong="H5973"\w* separen \w de|strong="H5973"\w* \w tu|strong="H6213"\w* \w lado|strong="H7307"\w*”.  
\p Eliseo respondió: “\w Te|strong="H5973"\w* pido \w que|strong="H4100"\w* \w me|strong="H5973"\w* dejes una doble porción \w de|strong="H5973"\w* \w tu|strong="H6213"\w* \w espíritu|strong="H7307"\w*”.   
\p
\v 10 Elías le dijo: “Has pedido algo muy difícil. \w Si|strong="H3808"\w* logras verme \w cuando|strong="H1961"\w* me lleven, \w se|strong="H1961"\w* te concederá; pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* me \w ves|strong="H7200"\w*, \w no|strong="H3808"\w* \w será|strong="H1961"\w* \w así|strong="H3651"\w*”.   
\p
\v 11 Mientras \w ellos|strong="H1992"\w* \w iban|strong="H1980"\w* \w caminando|strong="H1980"\w* y \w hablando|strong="H1696"\w*, de pronto apareció un \w carro|strong="H7393"\w* de fuego con \w caballos|strong="H5483"\w* de fuego \w que|strong="H1961"\w* \w los|strong="H1992"\w* separó, y Elías \w subió|strong="H5927"\w* al \w cielo|strong="H8064"\w* en un torbellino.  
\v 12 Al \w ver|strong="H7200"\w* \w esto|strong="H1931"\w*, Eliseo gritó: “¡Padre mío, padre mío! ¡\w Carros|strong="H7393"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w* y \w su|strong="H1931"\w* caballería!”  
\p \w Y|strong="H3068"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w*. Entonces Eliseo agarró \w su|strong="H1931"\w* propia ropa y \w la|strong="H1931"\w* \w rasgó|strong="H7167"\w* \w en|strong="H5750"\w* \w dos|strong="H8147"\w*.  
\v 13 \w Después|strong="H5921"\w* recogió \w la|strong="H5921"\w* capa \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* \w había|strong="H5975"\w* \w caído|strong="H5307"\w* \w a|strong="H3068"\w* Elías, regresó \w y|strong="H5921"\w* \w se|strong="H5921"\w* detuvo \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*.  
\v 14 \w Tomó|strong="H3947"\w* \w la|strong="H1931"\w* capa \w que|strong="H1931"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* había \w caído|strong="H5307"\w* \w a|strong="H3068"\w* Elías, golpeó \w el|strong="H1931"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* dijo: “¿\w Dónde|strong="H2008"\w* \w está|strong="H1931"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* Elías?” \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* golpeó \w el|strong="H1931"\w* \w agua|strong="H4325"\w*, \w esta|strong="H1931"\w* \w se|strong="H1931"\w* dividió \w en|strong="H5921"\w* dos, \w y|strong="H5921"\w* Eliseo cruzó.   
\p
\v 15 \w Los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w de|strong="H5921"\w* \w Jericó|strong="H3405"\w*, \w que|strong="H5921"\w* estaban \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w*, \w lo|strong="H5921"\w* \w vieron|strong="H7200"\w* \w y|strong="H5921"\w* dijeron: “\w El|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Elías ahora \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* Eliseo”. Entonces fueron \w a|strong="H3068"\w* recibirlo \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinaron \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* suelo ante \w él|strong="H5921"\w*.  
\v 16 \w Luego|strong="H4994"\w* le dijeron: “Mire, \w aquí|strong="H2009"\w* \w entre|strong="H3808"\w* nosotros \w hay|strong="H3426"\w* \w cincuenta|strong="H2572"\w* \w hombres|strong="H1121"\w* \w fuertes|strong="H2428"\w*. \w Deje|strong="H7971"\w* \w que|strong="H3808"\w* \w vayan|strong="H3212"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* su maestro. Tal vez \w el|strong="H1121"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H1121"\w* Yahvé \w se|strong="H3808"\w* \w lo|strong="H3808"\w* \w llevó|strong="H5375"\w* y \w lo|strong="H3808"\w* \w dejó|strong="H7971"\w* \w en|strong="H3212"\w* alguna montaña \w o|strong="H3068"\w* \w en|strong="H3212"\w* algún \w valle|strong="H1516"\w*”.  
\p \w Él|strong="H1121"\w* les respondió: “\w No|strong="H3808"\w* \w los|strong="H1121"\w* manden”.   
\p
\v 17 Pero ellos le insistieron tanto \w que|strong="H3808"\w*, \w por|strong="H5704"\w* vergüenza, les dijo: “Está bien, mándenlos”.  
\p Así \w que|strong="H3808"\w* mandaron \w a|strong="H3068"\w* los \w cincuenta|strong="H2572"\w* hombres, quienes \w lo|strong="H3808"\w* \w buscaron|strong="H1245"\w* \w por|strong="H5704"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontraron.  
\v 18 Cuando regresaron \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*, \w donde|strong="H1931"\w* Eliseo \w se|strong="H1931"\w* había quedado, \w él|strong="H1931"\w* les dijo: “¿Acaso \w no|strong="H3808"\w* les dije \w que|strong="H1931"\w* \w no|strong="H3808"\w* fueran?”   
\p
\v 19 Los hombres \w de|strong="H4325"\w* la \w ciudad|strong="H5892"\w* le dijeron \w a|strong="H3068"\w* Eliseo: “\w Mire|strong="H7200"\w*, señor, como usted puede \w ver|strong="H7200"\w*, la ubicación \w de|strong="H4325"\w* esta \w ciudad|strong="H5892"\w* es muy \w buena|strong="H2896"\w*, pero el \w agua|strong="H4325"\w* es \w mala|strong="H7451"\w* y la tierra no produce nada”.   
\p
\v 20 Él les dijo: “Tráiganme un frasco \w nuevo|strong="H2319"\w* y pónganle \w sal|strong="H4417"\w*”. \w Y|strong="H3068"\w* se lo \w llevaron|strong="H3947"\w*.  
\v 21 Eliseo \w fue|strong="H1961"\w* al manantial, \w echó|strong="H7993"\w* la \w sal|strong="H3318"\w* \w en|strong="H3318"\w* el \w agua|strong="H4325"\w* \w y|strong="H3541"\w* dijo: “\w Así|strong="H3541"\w* dice Yahvé: ‘Yo \w sano|strong="H7495"\w* \w esta|strong="H1961"\w* \w agua|strong="H4325"\w*. \w Nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w causará|strong="H3318"\w* \w muerte|strong="H4194"\w* \w ni|strong="H3808"\w* \w hará|strong="H1961"\w* \w que|strong="H3808"\w* la tierra \w sea|strong="H1961"\w* estéril’”.  
\v 22 \w Y|strong="H3068"\w* el \w agua|strong="H4325"\w* quedó \w sana|strong="H7495"\w* \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w tal|strong="H2088"\w* \w como|strong="H5704"\w* Eliseo \w lo|strong="H1697"\w* había \w dicho|strong="H1697"\w*.   
\p
\v 23 \w De|strong="H4480"\w* \w allí|strong="H8033"\w* Eliseo \w subió|strong="H5927"\w* \w a|strong="H3068"\w* Betel. Mientras iba \w por|strong="H4480"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w*, unos muchachos \w salieron|strong="H3318"\w* \w de|strong="H4480"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* y empezaron \w a|strong="H3068"\w* burlarse \w de|strong="H4480"\w* \w él|strong="H1931"\w* diciendo: “¡\w Sube|strong="H5927"\w*, \w calvo|strong="H7142"\w*! ¡\w Sube|strong="H5927"\w*, \w calvo|strong="H7142"\w*!”  
\v 24 \w Él|strong="H1992"\w* \w se|strong="H4480"\w* dio vuelta, \w los|strong="H1992"\w* \w miró|strong="H7200"\w* y \w los|strong="H1992"\w* \w maldijo|strong="H7043"\w* \w en|strong="H4480"\w* \w el|strong="H1992"\w* \w nombre|strong="H8034"\w* \w de|strong="H4480"\w* Yahvé. \w En|strong="H4480"\w* ese momento \w salieron|strong="H3318"\w* \w dos|strong="H8147"\w* osas \w del|strong="H4480"\w* \w bosque|strong="H3293"\w* y despedazaron \w a|strong="H3068"\w* cuarenta y \w dos|strong="H8147"\w* \w de|strong="H4480"\w* esos \w muchachos|strong="H3206"\w*.  
\v 25 De \w allí|strong="H8033"\w* Eliseo se \w fue|strong="H3212"\w* al \w monte|strong="H2022"\w* Carmelo, y después regresó \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*.   
\c 3  
\p
\v 1 \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Acab comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w dieciocho|strong="H8083"\w* \w de|strong="H5921"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*; \w y|strong="H5921"\w* \w reinó|strong="H4427"\w* \w doce|strong="H8147"\w* \w años|strong="H8141"\w*.  
\v 2 \w Hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w malo|strong="H7451"\w* ante los \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* Yahvé, \w aunque|strong="H7535"\w* \w no|strong="H3808"\w* tanto como su padre y su madre, pues \w quitó|strong="H5493"\w* la \w estatua|strong="H4676"\w* \w de|strong="H5869"\w* \w Baal|strong="H1168"\w* \w que|strong="H3808"\w* su padre \w había|strong="H6213"\w* mandado \w hacer|strong="H6213"\w*.  
\v 3 \w Sin|strong="H3808"\w* embargo, persistió \w en|strong="H4480"\w* \w los|strong="H1121"\w* mismos \w pecados|strong="H2403"\w* \w con|strong="H4480"\w* \w los|strong="H1121"\w* \w que|strong="H4480"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Nabat|strong="H5028"\w* hizo \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, y \w no|strong="H3808"\w* \w se|strong="H4480"\w* apartó \w de|strong="H4480"\w* \w ellos|strong="H4480"\w*.   
\p
\v 4 Mesá, \w rey|strong="H4428"\w* de \w Moab|strong="H4124"\w*, \w se|strong="H1961"\w* dedicaba \w a|strong="H3068"\w* la cría de ovejas y le pagaba \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* un tributo de \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* \w corderos|strong="H3733"\w* y la \w lana|strong="H6785"\w* de \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* carneros.  
\v 5 Pero \w al|strong="H4428"\w* morir Acab, el \w rey|strong="H4428"\w* de \w Moab|strong="H4124"\w* \w se|strong="H1961"\w* rebeló \w contra|strong="H1961"\w* el \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*.  
\v 6 \w En|strong="H3318"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H3117"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Joram|strong="H3088"\w* \w salió|strong="H3318"\w* de \w Samaria|strong="H8111"\w* y movilizó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 7 También le \w envió|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w*: “El \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Moab|strong="H4124"\w* \w se|strong="H5971"\w* ha rebelado contra mí. ¿Vendrás conmigo \w a|strong="H3068"\w* la \w guerra|strong="H4421"\w* contra \w Moab|strong="H4124"\w*?”  
\p Josafat respondió: “¡Claro \w que|strong="H5971"\w* \w iré|strong="H3212"\w*! Yo estoy \w contigo|strong="H5971"\w*, mi \w pueblo|strong="H5971"\w* con tu \w pueblo|strong="H5971"\w* y mis \w caballos|strong="H5483"\w* con tus \w caballos|strong="H5483"\w*”.  
\v 8 \w Y|strong="H3068"\w* preguntó: “¿\w Por|strong="H1870"\w* \w qué|strong="H2088"\w* ruta atacaremos?”  
\p Joram contestó: “\w Por|strong="H1870"\w* el \w camino|strong="H1870"\w* del \w desierto|strong="H4057"\w* de Edom”.   
\p
\v 9 Así \w que|strong="H3808"\w* \w el|strong="H4264"\w* \w rey|strong="H4428"\w* \w de|strong="H4325"\w* \w Israel|strong="H3478"\w* \w salió|strong="H3212"\w* con \w el|strong="H4264"\w* \w rey|strong="H4428"\w* \w de|strong="H4325"\w* \w Judá|strong="H3063"\w* y \w el|strong="H4264"\w* \w rey|strong="H4428"\w* \w de|strong="H4325"\w* Edom. \w Después|strong="H1961"\w* \w de|strong="H4325"\w* dar rodeos \w por|strong="H1870"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, \w se|strong="H1961"\w* \w quedaron|strong="H1961"\w* \w sin|strong="H3808"\w* \w agua|strong="H4325"\w* \w para|strong="H1961"\w* \w el|strong="H4264"\w* \w ejército|strong="H4264"\w* y \w para|strong="H1961"\w* \w los|strong="H1961"\w* animales \w que|strong="H3808"\w* \w llevaban|strong="H1961"\w*.  
\v 10 \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* exclamó: “¡\w Qué|strong="H3588"\w* desgracia! Yahvé ha reunido \w a|strong="H3068"\w* estos \w tres|strong="H7969"\w* \w reyes|strong="H4428"\w* solo \w para|strong="H3588"\w* entregarlos \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* moabitas”.   
\p
\v 11 Pero Josafat preguntó: “¿\w No|strong="H5921"\w* hay \w aquí|strong="H6311"\w* algún \w profeta|strong="H5030"\w* \w de|strong="H5921"\w* Yahvé \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w consultemos|strong="H1875"\w* \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*?”  
\p Uno \w de|strong="H5921"\w* \w los|strong="H1121"\w* oficiales \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w respondió|strong="H6030"\w*: “\w Aquí|strong="H6311"\w* \w está|strong="H5921"\w* Eliseo \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Safat, \w el|strong="H5921"\w* \w que|strong="H5921"\w* servía \w a|strong="H3068"\w* Elías”.   
\p
\v 12 Josafat dijo: “Él \w tiene|strong="H3426"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé”. Entonces el \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*, Josafat y el \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Edom fueron \w a|strong="H3068"\w* verlo.   
\p
\v 13 \w Pero|strong="H3588"\w* Eliseo le dijo \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: “¿\w Qué|strong="H3588"\w* tengo \w que|strong="H3588"\w* ver \w yo|strong="H3588"\w* \w con|strong="H3588"\w* usted? \w Vaya|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w profetas|strong="H5030"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* madre”.  
\p \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* le respondió: “\w No|strong="H3588"\w*, \w porque|strong="H3588"\w* \w es|strong="H3027"\w* Yahvé \w quien|strong="H4100"\w* ha reunido \w a|strong="H3068"\w* estos \w tres|strong="H7969"\w* \w reyes|strong="H4428"\w* \w para|strong="H3588"\w* entregarlos \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*”.   
\p
\v 14 Eliseo dijo: “Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w vive|strong="H2416"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, \w a|strong="H3068"\w* quien sirvo, \w que|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3884"\w* fuera \w por|strong="H3588"\w* \w el|strong="H3588"\w* respeto \w que|strong="H3588"\w* le tengo \w a|strong="H3068"\w* Josafat, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* usted ni lo miraría ni le haría caso.  
\v 15 Pero \w ahora|strong="H6258"\w*, tráiganme \w a|strong="H3068"\w* un músico”. Mientras \w el|strong="H5921"\w* músico \w tocaba|strong="H5059"\w*, \w el|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* Eliseo,  
\v 16 \w y|strong="H3541"\w* \w él|strong="H6213"\w* dijo: “\w Así|strong="H3541"\w* dice Yahvé: ‘Llenen \w este|strong="H2088"\w* valle de zanjas’.  
\v 17 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: ‘\w No|strong="H3808"\w* \w verán|strong="H7200"\w* \w viento|strong="H7307"\w* \w ni|strong="H3808"\w* \w lluvia|strong="H1653"\w*, \w pero|strong="H3588"\w* \w este|strong="H1931"\w* valle \w se|strong="H1931"\w* \w llenará|strong="H4390"\w* \w de|strong="H3588"\w* \w agua|strong="H4325"\w*, \w y|strong="H3588"\w* \w beberán|strong="H8354"\w* ustedes, \w sus|strong="H1931"\w* \w ganados|strong="H4735"\w* \w y|strong="H3588"\w* \w sus|strong="H1931"\w* animales’.  
\v 18 \w Esto|strong="H2063"\w* \w es|strong="H3027"\w* poca \w cosa|strong="H2063"\w* \w para|strong="H5414"\w* Yahvé; él también les \w entregará|strong="H5414"\w* \w a|strong="H3068"\w* los moabitas.  
\v 19 Ustedes destruirán \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* fortificadas y las \w ciudades|strong="H5892"\w* principales, talarán \w los|strong="H3605"\w* \w mejores|strong="H2896"\w* \w árboles|strong="H6086"\w*, taparán \w todos|strong="H3605"\w* \w los|strong="H3605"\w* manantiales y arruinarán con piedras \w todos|strong="H3605"\w* \w los|strong="H3605"\w* campos \w fértiles|strong="H2896"\w*”.   
\p
\v 20 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w a|strong="H3068"\w* la hora del sacrificio, el \w agua|strong="H4325"\w* empezó \w a|strong="H3068"\w* fluir \w por|strong="H1870"\w* el \w camino|strong="H1870"\w* \w de|strong="H4325"\w* Edom, y la tierra \w se|strong="H1961"\w* \w llenó|strong="H4390"\w* \w de|strong="H4325"\w* \w agua|strong="H4325"\w*.   
\p
\v 21 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* moabitas \w se|strong="H5921"\w* enteraron \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* habían \w subido|strong="H5927"\w* \w a|strong="H3068"\w* atacarlos, convocaron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w estaban|strong="H5975"\w* \w en|strong="H5921"\w* edad \w de|strong="H5921"\w* usar armadura, \w desde|strong="H5921"\w* \w los|strong="H5921"\w* \w más|strong="H3588"\w* jóvenes \w hasta|strong="H5921"\w* \w los|strong="H5921"\w* \w más|strong="H3588"\w* viejos, \w y|strong="H3588"\w* \w se|strong="H5921"\w* apostaron \w en|strong="H5921"\w* \w la|strong="H5921"\w* frontera.  
\v 22 \w Al|strong="H5921"\w* levantarse muy temprano, \w el|strong="H5921"\w* \w sol|strong="H8121"\w* \w se|strong="H5921"\w* reflejaba \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* moabitas \w la|strong="H5921"\w* \w vieron|strong="H7200"\w* roja \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*.  
\v 23 Entonces gritaron: “¡\w Es|strong="H2088"\w* \w sangre|strong="H1818"\w*! Seguramente los \w reyes|strong="H4428"\w* se pelearon entre sí y se \w mataron|strong="H5221"\w* unos \w a|strong="H3068"\w* otros. ¡Moabitas, \w al|strong="H4428"\w* saqueo!”   
\p
\v 24 Pero cuando llegaron al \w campamento|strong="H4264"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, los israelitas atacaron \w a|strong="H3068"\w* los moabitas, quienes \w huyeron|strong="H5127"\w* \w ante|strong="H6440"\w* ellos. Los israelitas los persiguieron \w por|strong="H6440"\w* todo \w el|strong="H4264"\w* país, matando \w a|strong="H3068"\w* los moabitas.  
\v 25 Destruyeron las \w ciudades|strong="H5892"\w*, \w y|strong="H5704"\w* \w cada|strong="H3605"\w* uno lanzaba piedras \w en|strong="H5704"\w* \w los|strong="H3605"\w* campos \w fértiles|strong="H2896"\w* \w hasta|strong="H5704"\w* cubrirlos; taparon \w todos|strong="H3605"\w* \w los|strong="H3605"\w* manantiales \w y|strong="H5704"\w* talaron \w los|strong="H3605"\w* \w mejores|strong="H2896"\w* \w árboles|strong="H6086"\w*. Solo \w en|strong="H5704"\w* Quir Jareset \w quedaron|strong="H7604"\w* las piedras \w de|strong="H5704"\w* \w la|strong="H3605"\w* muralla, pero \w los|strong="H3605"\w* honderos \w la|strong="H3605"\w* rodearon \w y|strong="H5704"\w* \w la|strong="H3605"\w* atacaron.  
\v 26 \w Al|strong="H4480"\w* \w ver|strong="H7200"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Moab|strong="H4124"\w* \w que|strong="H3588"\w* estaba perdiendo \w la|strong="H3588"\w* \w batalla|strong="H4421"\w*, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w setecientos|strong="H7651"\w* hombres armados \w con|strong="H4480"\w* \w espadas|strong="H2719"\w* \w para|strong="H3588"\w* intentar abrirse paso \w hacia|strong="H4480"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Edom, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w*.  
\v 27 \w Entonces|strong="H7725"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w mayor|strong="H1419"\w*, \w el|strong="H5921"\w* \w que|strong="H5921"\w* debía reinar \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w sacrificó|strong="H5927"\w* \w como|strong="H1961"\w* un \w holocausto|strong="H5930"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* muralla. Esto causó un \w gran|strong="H1419"\w* horror \w contra|strong="H5921"\w* \w los|strong="H1121"\w* israelitas, quienes \w se|strong="H1961"\w* retiraron \w de|strong="H5921"\w* allí \w y|strong="H5921"\w* regresaron \w a|strong="H3068"\w* su propia tierra.   
\c 4  
\p
\v 1 \w La|strong="H3588"\w* viuda \w de|strong="H3588"\w* uno \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* Eliseo \w y|strong="H3588"\w* le suplicó: “\w Mi|strong="H1961"\w* esposo, \w su|strong="H3588"\w* \w siervo|strong="H5650"\w*, ha \w muerto|strong="H4191"\w*, \w y|strong="H3588"\w* usted \w sabe|strong="H3045"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w era|strong="H1961"\w* un \w hombre|strong="H1121"\w* fiel \w a|strong="H3068"\w* Yahvé. \w Pero|strong="H3588"\w* ahora \w el|strong="H3588"\w* acreedor ha venido \w para|strong="H3588"\w* llevarse \w a|strong="H3068"\w* mis \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w como|strong="H3588"\w* esclavos”.   
\p
\v 2 Eliseo le preguntó: “¿\w Cómo|strong="H4100"\w* puedo ayudarte? Dime, ¿\w qué|strong="H3588"\w* \w tienes|strong="H3426"\w* \w en|strong="H3588"\w* \w casa|strong="H1004"\w*?”  
\p \w Ella|strong="H3605"\w* respondió: “\w Su|strong="H3588"\w* servidora \w no|strong="H6213"\w* \w tiene|strong="H3426"\w* \w nada|strong="H3605"\w* \w en|strong="H3588"\w* \w casa|strong="H1004"\w*, excepto un frasco \w de|strong="H3588"\w* \w aceite|strong="H8081"\w*”.   
\p
\v 3 Eliseo le dijo: “\w Vayan|strong="H3212"\w* y pidan \w prestados|strong="H4480"\w* frascos \w vacíos|strong="H7386"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w vecinos|strong="H7934"\w*. Pidan \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H4480"\w* puedan.  
\v 4 Luego entren \w en|strong="H5921"\w* \w la|strong="H5921"\w* casa, cierren \w la|strong="H5921"\w* \w puerta|strong="H1817"\w* \w tras|strong="H1157"\w* \w de|strong="H5921"\w* ustedes \w y|strong="H5921"\w* echen \w el|strong="H5921"\w* aceite \w en|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* frascos; \w a|strong="H3068"\w* medida \w que|strong="H5921"\w* \w se|strong="H5921"\w* llenen, pónganlos \w aparte|strong="H5265"\w*”.   
\p
\v 5 \w La|strong="H1931"\w* mujer \w se|strong="H1931"\w* \w fue|strong="H3212"\w*, \w se|strong="H1931"\w* encerró con \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* y empezó \w a|strong="H3068"\w* llenar \w los|strong="H1992"\w* frascos \w que|strong="H1931"\w* \w ellos|strong="H1992"\w* \w le|strong="H1931"\w* traían.  
\v 6 \w Cuando|strong="H1961"\w* todos \w los|strong="H1121"\w* frascos \w estuvieron|strong="H1961"\w* \w llenos|strong="H4390"\w*, ella le dijo \w a|strong="H3068"\w* uno \w de|strong="H5750"\w* sus \w hijos|strong="H1121"\w*: “\w Tráeme|strong="H5066"\w* \w otro|strong="H5750"\w* frasco”.  
\p \w Él|strong="H1121"\w* le respondió: “\w Ya|strong="H3068"\w* \w no|strong="H1961"\w* \w hay|strong="H1961"\w* \w más|strong="H5750"\w*”. \w En|strong="H5750"\w* ese momento \w el|strong="H1121"\w* \w aceite|strong="H8081"\w* dejó \w de|strong="H5750"\w* fluir.   
\p
\v 7 Ella \w fue|strong="H3212"\w* y se lo \w contó|strong="H5046"\w* al \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Dios, quien le \w dijo|strong="H5046"\w*: “\w Vayan|strong="H3212"\w*, vendan \w el|strong="H1121"\w* \w aceite|strong="H8081"\w* y paguen su deuda. Usted y sus \w hijos|strong="H1121"\w* pueden \w vivir|strong="H2421"\w* \w de|strong="H1121"\w* lo \w que|strong="H1121"\w* les \w sobre|strong="H3498"\w*”.   
\p
\v 8 Un \w día|strong="H3117"\w*, \w cuando|strong="H3117"\w* Eliseo \w pasaba|strong="H5674"\w* por \w Sunem|strong="H7766"\w*, una mujer muy rica de \w allí|strong="H8033"\w* lo invitó \w a|strong="H3068"\w* comer. \w Desde|strong="H1767"\w* \w entonces|strong="H3117"\w*, \w cada|strong="H3117"\w* vez \w que|strong="H3117"\w* \w él|strong="H5674"\w* \w pasaba|strong="H5674"\w* por ese lugar, \w se|strong="H1961"\w* quedaba \w a|strong="H3068"\w* comer \w en|strong="H5493"\w* su casa.  
\v 9 \w Ella|strong="H1931"\w* \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* \w su|strong="H1931"\w* esposo: “\w Mira|strong="H2009"\w*, \w yo|strong="H3588"\w* \w me|strong="H5921"\w* doy cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w este|strong="H1931"\w* hombre \w que|strong="H3588"\w* \w siempre|strong="H8548"\w* \w nos|strong="H5921"\w* visita \w es|strong="H1931"\w* un \w santo|strong="H6918"\w* hombre \w de|strong="H5921"\w* Dios.  
\v 10 \w Hagamos|strong="H6213"\w* un \w pequeño|strong="H6996"\w* cuarto \w en|strong="H5493"\w* la azotea y pongámosle una \w cama|strong="H4296"\w*, una \w mesa|strong="H7979"\w*, una silla y una lámpara. Así, \w cuando|strong="H1961"\w* \w venga|strong="H1961"\w* \w a|strong="H3068"\w* visitarnos, \w tendrá|strong="H1961"\w* un lugar \w donde|strong="H8033"\w* quedarse”.   
\p
\v 11 Un \w día|strong="H3117"\w* \w que|strong="H3117"\w* Eliseo llegó de visita, subió al cuarto y \w se|strong="H1961"\w* acostó \w a|strong="H3068"\w* descansar.  
\v 12 Entonces le dijo \w a|strong="H3068"\w* su sirviente \w Giezi|strong="H1522"\w*: “\w Llama|strong="H7121"\w* \w a|strong="H3068"\w* \w la|strong="H2063"\w* \w sunamita|strong="H7767"\w*”. \w Giezi|strong="H1522"\w* \w la|strong="H2063"\w* \w llamó|strong="H7121"\w*, y ella se presentó \w ante|strong="H6440"\w* él.  
\v 13 Eliseo le \w había|strong="H3426"\w* \w dicho|strong="H1696"\w* \w a|strong="H3068"\w* Giezi: “Dile \w que|strong="H4100"\w* apreciamos mucho \w toda|strong="H3605"\w* \w la|strong="H2063"\w* atención \w que|strong="H4100"\w* ha tenido con \w nosotros|strong="H3605"\w*, y pregúntale \w qué|strong="H4100"\w* podemos \w hacer|strong="H6213"\w* \w por|strong="H4100"\w* \w ella|strong="H3605"\w*. ¿Quiere \w que|strong="H4100"\w* \w hablemos|strong="H1696"\w* \w de|strong="H5971"\w* parte suya \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w o|strong="H3068"\w* \w al|strong="H4428"\w* \w capitán|strong="H8269"\w* del \w ejército|strong="H6635"\w*?”  
\p Pero \w ella|strong="H3605"\w* respondió: “Estoy bien \w aquí|strong="H2009"\w*, viviendo \w entre|strong="H8432"\w* \w mi|strong="H2009"\w* propia \w gente|strong="H5971"\w*”.   
\p
\v 14 Más tarde Eliseo preguntó: “¿\w Qué|strong="H4100"\w* \w se|strong="H4100"\w* podrá \w hacer|strong="H6213"\w* \w por|strong="H4100"\w* ella?”  
\p \w Giezi|strong="H1522"\w* respondió: “Bueno, ella \w no|strong="H6213"\w* tiene \w hijos|strong="H1121"\w* y su esposo ya es anciano”.   
\p
\v 15 “\w Llámala|strong="H7121"\w* de nuevo”, \w ordenó|strong="H5975"\w* Eliseo. Giezi la \w llamó|strong="H7121"\w*, y ella se \w quedó|strong="H5975"\w* \w a|strong="H3068"\w* la entrada del cuarto.  
\v 16 \w Entonces|strong="H6256"\w* Eliseo le dijo: “\w El|strong="H1121"\w* año \w que|strong="H1121"\w* viene, \w por|strong="H2088"\w* \w estas|strong="H2088"\w* fechas, tendrás un \w hijo|strong="H1121"\w* en tus brazos”.  
\p Ella exclamó: “¡No, mi señor, \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* Dios! ¡No engañe usted \w a|strong="H3068"\w* su servidora!”   
\p
\v 17 Pero \w tal|strong="H2088"\w* como Eliseo se \w lo|strong="H2088"\w* había \w dicho|strong="H1696"\w*, la mujer quedó \w embarazada|strong="H2029"\w* y \w al|strong="H6256"\w* año siguiente dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*.  
\v 18 El niño \w creció|strong="H1431"\w*, y un \w día|strong="H3117"\w* \w salió|strong="H3318"\w* al campo \w para|strong="H1961"\w* estar con su padre y \w los|strong="H1961"\w* segadores.  
\v 19 De repente le gritó \w a|strong="H3068"\w* su padre: “¡Ay, \w mi|strong="H5375"\w* \w cabeza|strong="H7218"\w*! ¡Me duele la \w cabeza|strong="H7218"\w*!”  
\p El padre le ordenó \w a|strong="H3068"\w* un \w criado|strong="H5288"\w*: “\w Llévalo|strong="H5375"\w* con su madre”.   
\p
\v 20 \w El|strong="H5921"\w* criado \w lo|strong="H5921"\w* \w llevó|strong="H5375"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* niño \w estuvo|strong="H3427"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* piernas \w de|strong="H5921"\w* su madre \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* mediodía, hora \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w murió|strong="H4191"\w*.  
\v 21 Entonces \w ella|strong="H5921"\w* \w subió|strong="H5927"\w*, \w lo|strong="H5921"\w* puso \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cama|strong="H4296"\w* \w del|strong="H5921"\w* hombre \w de|strong="H5921"\w* Dios, \w cerró|strong="H5462"\w* \w la|strong="H5921"\w* puerta \w y|strong="H5921"\w* \w salió|strong="H3318"\w*.  
\v 22 \w Llamó|strong="H7121"\w* \w a|strong="H3068"\w* su esposo \w y|strong="H5704"\w* le dijo: “Préstame \w a|strong="H3068"\w* uno \w de|strong="H4480"\w* los \w criados|strong="H5288"\w* \w y|strong="H5704"\w* un burro. Necesito \w ir|strong="H7971"\w* rápido \w a|strong="H3068"\w* ver \w al|strong="H4480"\w* hombre \w de|strong="H4480"\w* Dios, pero \w volveré|strong="H7725"\w* pronto”.   
\p
\v 23 “¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w hoy|strong="H3117"\w*?”, preguntó él. “\w No|strong="H3808"\w* es fiesta de luna nueva \w ni|strong="H3808"\w* \w día|strong="H3117"\w* de descanso”.  
\p “\w No|strong="H3808"\w* te preocupes, todo está \w bien|strong="H7965"\w*”, respondió ella.   
\p
\v 24 Ella mandó ensillar \w el|strong="H3588"\w* burro \w y|strong="H3588"\w* le dijo al \w criado|strong="H5288"\w*: “¡Vámonos! \w No|strong="H3588"\w* \w te|strong="H3588"\w* detengas \w por|strong="H3588"\w* nada, \w a|strong="H3068"\w* \w menos|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* lo pida”.   
\p
\v 25 Así \w partió|strong="H3212"\w* y \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* donde \w estaba|strong="H1961"\w* el hombre \w de|strong="H5048"\w* Dios, \w en|strong="H3212"\w* el \w monte|strong="H2022"\w* Carmelo. \w Cuando|strong="H1961"\w* el hombre \w de|strong="H5048"\w* Dios la \w vio|strong="H7200"\w* \w venir|strong="H3212"\w* \w a|strong="H3068"\w* lo lejos, le dijo \w a|strong="H3068"\w* su sirviente \w Giezi|strong="H1522"\w*: “¡\w Mira|strong="H7200"\w*, ahí viene la \w sunamita|strong="H7767"\w*!  
\v 26 \w Corre|strong="H7323"\w* \w a|strong="H3068"\w* recibirla y pregúntale: ‘¿Cómo estás? ¿Cómo están tu esposo y tu hijo?’”  
\p Ella le respondió \w a|strong="H3068"\w* Giezi: “Todos estamos \w bien|strong="H7965"\w*”.   
\p
\v 27 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w llegó|strong="H5066"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* montaña \w y|strong="H3588"\w* vio \w al|strong="H4480"\w* hombre \w de|strong="H4480"\w* \w Dios|strong="H3068"\w*, \w se|strong="H4480"\w* abrazó \w a|strong="H3068"\w* sus \w pies|strong="H7272"\w*. \w Giezi|strong="H1522"\w* \w se|strong="H4480"\w* \w acercó|strong="H5066"\w* \w para|strong="H3588"\w* apartarla, \w pero|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w de|strong="H4480"\w* \w Dios|strong="H3068"\w* le \w dijo|strong="H5046"\w*: “\w Déjala|strong="H7503"\w* tranquila, \w porque|strong="H3588"\w* está muy angustiada \w y|strong="H3588"\w* Yahvé \w no|strong="H3808"\w* \w me|strong="H4480"\w* \w ha|strong="H3808"\w* dicho \w qué|strong="H3588"\w* le pasa”.   
\p
\v 28 Entonces ella dijo: “¿Acaso yo le \w pedí|strong="H7592"\w* un \w hijo|strong="H1121"\w*, mi señor? ¿\w No|strong="H3808"\w* le rogué \w que|strong="H3808"\w* \w no|strong="H3808"\w* me ilusionara?”   
\p
\v 29 Eliseo \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Giezi|strong="H1522"\w*: “Prepárate \w para|strong="H5921"\w* salir. \w Toma|strong="H3947"\w* \w mi|strong="H5921"\w* bastón \w y|strong="H3588"\w* \w vete|strong="H3212"\w* ya. \w No|strong="H3808"\w* saludes \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* camino, \w y|strong="H3588"\w* \w si|strong="H3588"\w* alguien \w te|strong="H5921"\w* saluda, \w no|strong="H3808"\w* \w te|strong="H5921"\w* detengas \w a|strong="H3068"\w* contestar. \w En|strong="H5921"\w* \w cuanto|strong="H3588"\w* llegues, \w pon|strong="H7760"\w* \w mi|strong="H5921"\w* bastón \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w* \w del|strong="H5921"\w* \w niño|strong="H5288"\w*”.   
\p
\v 30 Pero la madre del \w niño|strong="H5288"\w* dijo: “Tan cierto como que Yahvé \w vive|strong="H2416"\w* y que usted \w vive|strong="H2416"\w*, no me \w iré|strong="H3212"\w* de aquí sin usted”.  
\p Entonces Eliseo se \w levantó|strong="H6965"\w* y la \w siguió|strong="H3212"\w*.   
\p
\v 31 \w Giezi|strong="H1522"\w* \w se|strong="H5921"\w* adelantó \w y|strong="H5921"\w* \w puso|strong="H7760"\w* \w el|strong="H5921"\w* bastón \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w* \w del|strong="H5921"\w* \w niño|strong="H5288"\w*, pero \w el|strong="H5921"\w* \w niño|strong="H5288"\w* \w no|strong="H3808"\w* reaccionó. Así \w que|strong="H3808"\w* \w Giezi|strong="H1522"\w* regresó \w al|strong="H5921"\w* encuentro \w de|strong="H5921"\w* Eliseo \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w dijo|strong="H5046"\w*: “\w El|strong="H5921"\w* \w niño|strong="H5288"\w* \w no|strong="H3808"\w* \w despierta|strong="H6974"\w*”.   
\p
\v 32 Cuando Eliseo entró \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w*, \w vio|strong="H2009"\w* \w al|strong="H5921"\w* \w niño|strong="H5288"\w* \w muerto|strong="H4191"\w*, tendido \w sobre|strong="H5921"\w* su propia \w cama|strong="H4296"\w*.  
\v 33 Entró en el cuarto, \w cerró|strong="H5462"\w* la \w puerta|strong="H1817"\w* y \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé.  
\v 34 \w Luego|strong="H5927"\w* \w se|strong="H5921"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* cama \w y|strong="H5921"\w* \w se|strong="H5921"\w* tendió \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* niño, \w poniendo|strong="H7760"\w* su \w boca|strong="H6310"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w del|strong="H5921"\w* niño, sus \w ojos|strong="H5869"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* suyos \w y|strong="H5921"\w* sus \w manos|strong="H3709"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w de|strong="H5921"\w* \w él|strong="H5921"\w*. Mientras \w estaba|strong="H7760"\w* así tendido, \w el|strong="H5921"\w* cuerpo \w del|strong="H5921"\w* niño empezó \w a|strong="H3068"\w* calentarse.  
\v 35 Eliseo \w se|strong="H5921"\w* levantó \w y|strong="H5921"\w* caminó \w de|strong="H5921"\w* un lado \w a|strong="H3068"\w* otro \w de|strong="H5921"\w* \w la|strong="H5921"\w* habitación; \w luego|strong="H5927"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* tenderse \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w niño|strong="H5288"\w*. \w Entonces|strong="H7725"\w* \w el|strong="H5921"\w* \w niño|strong="H5288"\w* estornudó \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* \w y|strong="H5921"\w* \w abrió|strong="H6491"\w* \w los|strong="H5921"\w* \w ojos|strong="H5869"\w*.  
\v 36 Eliseo \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Giezi|strong="H1522"\w* y le dijo: “\w Llama|strong="H7121"\w* \w a|strong="H3068"\w* \w la|strong="H2063"\w* \w sunamita|strong="H7767"\w*”. \w Giezi|strong="H1522"\w* \w la|strong="H2063"\w* \w llamó|strong="H7121"\w*.  
\p Cuando ella entró, Eliseo le dijo: “Aquí tienes \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w*”.   
\p
\v 37 \w Ella|strong="H5921"\w* entró, \w se|strong="H5921"\w* lanzó \w a|strong="H3068"\w* sus \w pies|strong="H7272"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinó \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* suelo \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* gratitud. \w Después|strong="H5921"\w* \w tomó|strong="H5375"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w y|strong="H5921"\w* \w salió|strong="H3318"\w* \w del|strong="H5921"\w* cuarto.   
\p
\v 38 Eliseo regresó \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w* en un tiempo en \w que|strong="H1121"\w* había mucha \w hambre|strong="H7458"\w* en la región. Mientras \w los|strong="H3427"\w* \w profetas|strong="H5030"\w* \w estaban|strong="H3427"\w* \w sentados|strong="H3427"\w* con \w él|strong="H1121"\w*, Eliseo le dijo \w a|strong="H3068"\w* su sirviente: “\w Pon|strong="H8239"\w* la \w olla|strong="H5518"\w* \w grande|strong="H1419"\w* al fuego y prepara un guisado para ellos”.   
\p
\v 39 Uno \w de|strong="H4480"\w* \w los|strong="H3588"\w* profetas \w salió|strong="H3318"\w* \w al|strong="H4480"\w* \w campo|strong="H7704"\w* \w a|strong="H3068"\w* recoger hierbas \w y|strong="H3588"\w* encontró \w una|strong="H4672"\w* planta trepadora silvestre. \w Recogió|strong="H3950"\w* todos \w los|strong="H3588"\w* frutos \w que|strong="H3588"\w* pudo \w y|strong="H3588"\w*, \w al|strong="H4480"\w* regresar, \w los|strong="H3588"\w* cortó \w en|strong="H4480"\w* trozos \w y|strong="H3588"\w* \w los|strong="H3588"\w* echó \w en|strong="H4480"\w* \w la|strong="H3588"\w* \w olla|strong="H5518"\w*, \w aunque|strong="H3588"\w* \w no|strong="H3808"\w* \w sabía|strong="H3045"\w* \w qué|strong="H3588"\w* \w eran|strong="H3808"\w*.  
\v 40 Luego sirvieron la comida \w a|strong="H3068"\w* \w los|strong="H1992"\w* hombres, pero en cuanto probaron \w el|strong="H1992"\w* guisado, gritaron: “¡Hombre de Dios, \w esta|strong="H1961"\w* comida \w es|strong="H1961"\w* veneno!” \w Y|strong="H3068"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* comerla.   
\p
\v 41 Pero Eliseo dijo: “Tráiganme un poco \w de|strong="H5971"\w* \w harina|strong="H7058"\w*”. La \w echó|strong="H7993"\w* en la \w olla|strong="H5518"\w* y dijo: “Sirvan \w de|strong="H5971"\w* nuevo \w a|strong="H3068"\w* la \w gente|strong="H5971"\w*”. \w Y|strong="H3068"\w* el guisado ya \w no|strong="H3808"\w* les hizo daño.   
\p
\v 42 En esos días llegó un hombre \w de|strong="H5971"\w* Baal Salisa trayéndole al hombre \w de|strong="H5971"\w* Dios \w veinte|strong="H6242"\w* \w panes|strong="H3899"\w* \w de|strong="H5971"\w* \w cebada|strong="H8184"\w*, hechos con los primeros granos \w de|strong="H5971"\w* la cosecha, y algunas espigas \w de|strong="H5971"\w* trigo nuevo. Eliseo ordenó: “Dáselos \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* \w para|strong="H5414"\w* \w que|strong="H5971"\w* coman”.   
\p
\v 43 \w Pero|strong="H3588"\w* \w su|strong="H3588"\w* sirviente exclamó: “¿\w Cómo|strong="H4100"\w* voy \w a|strong="H3068"\w* repartir \w esto|strong="H2088"\w* \w entre|strong="H3588"\w* \w cien|strong="H3967"\w* hombres?”  
\p Eliseo insistió: “Dáselos, \w porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: ‘Comerán \w y|strong="H3588"\w* \w hasta|strong="H2088"\w* sobrará’”.   
\p
\v 44 El sirviente se los sirvió, y todos comieron y hasta sobró, \w tal|strong="H1697"\w* como Yahvé \w lo|strong="H1697"\w* había \w dicho|strong="H1697"\w*.   
\c 5  
\p
\v 1 \w Naamán|strong="H5283"\w*, \w general|strong="H8269"\w* del \w ejército|strong="H2428"\w* del \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Siria, \w era|strong="H1961"\w* un \w hombre|strong="H1368"\w* muy importante \w para|strong="H3588"\w* \w su|strong="H3588"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* gozaba \w de|strong="H3588"\w* \w mucho|strong="H1419"\w* prestigio, \w porque|strong="H3588"\w* \w por|strong="H3588"\w* medio \w de|strong="H3588"\w* \w él|strong="H3588"\w* Yahvé le \w había|strong="H1961"\w* \w dado|strong="H5414"\w* \w la|strong="H3588"\w* victoria \w a|strong="H3068"\w* Siria. \w Era|strong="H1961"\w* un soldado \w valiente|strong="H1368"\w*, \w pero|strong="H3588"\w* padecía \w de|strong="H3588"\w* lepra.  
\v 2 \w En|strong="H3318"\w* una \w de|strong="H6440"\w* sus incursiones, \w los|strong="H1961"\w* sirios \w habían|strong="H1961"\w* capturado \w a|strong="H3068"\w* una niña israelí, \w que|strong="H1961"\w* \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* al servicio \w de|strong="H6440"\w* la esposa \w de|strong="H6440"\w* \w Naamán|strong="H5283"\w*.  
\v 3 Un día, la niña le dijo \w a|strong="H3068"\w* su ama: “Ojalá mi señor fuera \w a|strong="H3068"\w* ver al \w profeta|strong="H5030"\w* que está en \w Samaria|strong="H8111"\w*; \w él|strong="H5030"\w* lo sanaría \w de|strong="H6440"\w* su \w lepra|strong="H6883"\w*”.   
\p
\v 4 Naamán fue y le \w contó|strong="H5046"\w* \w a|strong="H3068"\w* su rey lo que \w la|strong="H2063"\w* muchacha israelí había \w dicho|strong="H1696"\w*.   
\p
\v 5 El \w rey|strong="H4428"\w* de Siria le respondió: “\w Ve|strong="H3212"\w*, \w que|strong="H3027"\w* yo te daré una \w carta|strong="H5612"\w* para el \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*”.  
\p Naamán se \w fue|strong="H3212"\w* y \w llevó|strong="H3947"\w* consigo unos trescientos kilos\f + \fr 5:5 \ft Un talento son unos 30 kilogramos o 66 libras\f* de \w plata|strong="H3701"\w*, \w seis|strong="H8337"\w* \w mil|strong="H6235"\w* piezas de \w oro|strong="H2091"\w* y \w diez|strong="H6235"\w* \w mudas|strong="H2487"\w* de ropa.  
\v 6 \w También|strong="H2088"\w* le entregó \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* la \w carta|strong="H5612"\w*, \w que|strong="H6258"\w* decía: “\w Cuando|strong="H5650"\w* recibas \w esta|strong="H2088"\w* \w carta|strong="H5612"\w*, sabrás \w que|strong="H6258"\w* te \w envío|strong="H7971"\w* \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w siervo|strong="H5650"\w* \w Naamán|strong="H5283"\w* \w para|strong="H6258"\w* \w que|strong="H6258"\w* \w lo|strong="H2088"\w* sanes de su \w lepra|strong="H6883"\w*”.   
\p
\v 7 \w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w leyó|strong="H7121"\w* \w la|strong="H1931"\w* \w carta|strong="H5612"\w*, \w se|strong="H3045"\w* \w rasgó|strong="H7167"\w* \w la|strong="H1931"\w* ropa \w y|strong="H3588"\w* exclamó: “¿Acaso \w soy|strong="H1961"\w* Dios, \w que|strong="H3588"\w* da \w la|strong="H1931"\w* \w vida|strong="H2421"\w* \w y|strong="H3588"\w* \w la|strong="H1931"\w* quita, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w este|strong="H2088"\w* \w me|strong="H3588"\w* pida sanar \w a|strong="H3068"\w* un hombre \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w lepra|strong="H6883"\w*? ¡Fíjense \w bien|strong="H3588"\w* \w y|strong="H3588"\w* \w verán|strong="H7200"\w* \w que|strong="H3588"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* quiere \w es|strong="H1931"\w* buscar pleito conmigo!”   
\p
\v 8 \w Cuando|strong="H3588"\w* Eliseo, \w el|strong="H3588"\w* hombre \w de|strong="H3588"\w* Dios, \w se|strong="H3045"\w* enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w se|strong="H3045"\w* \w había|strong="H1961"\w* rasgado \w la|strong="H3588"\w* ropa, le \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* \w decir|strong="H8085"\w*: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w está|strong="H1961"\w* usted tan angustiado? Mande \w al|strong="H4428"\w* hombre \w a|strong="H3068"\w* verme, \w y|strong="H3588"\w* \w sabrá|strong="H3045"\w* \w que|strong="H3588"\w* \w hay|strong="H3426"\w* un \w profeta|strong="H5030"\w* \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 9 Entonces \w Naamán|strong="H5283"\w* llegó con sus \w caballos|strong="H5483"\w* y sus \w carros|strong="H7393"\w*, y se detuvo \w a|strong="H3068"\w* la \w puerta|strong="H6607"\w* de la \w casa|strong="H1004"\w* de Eliseo.  
\v 10 Eliseo \w envió|strong="H7971"\w* \w a|strong="H3068"\w* un \w mensajero|strong="H4397"\w* para decirle: “Vaya y lávese \w siete|strong="H7651"\w* \w veces|strong="H6471"\w* en el río \w Jordán|strong="H3383"\w*; así su piel se recuperará y quedará \w limpio|strong="H2891"\w*”.   
\p
\v 11 Pero \w Naamán|strong="H5283"\w* se \w fue|strong="H3212"\w* muy \w enojado|strong="H7107"\w*, diciendo: “\w Yo|strong="H2009"\w* pensé \w que|strong="H3027"\w* el profeta saldría personalmente \w a|strong="H3068"\w* recibirme, \w que|strong="H3027"\w* se pondría de \w pie|strong="H5975"\w* para invocar el \w nombre|strong="H8034"\w* de Yahvé su \w Dios|strong="H3068"\w*, y \w que|strong="H3027"\w* pasaría su \w mano|strong="H3027"\w* sobre la \w parte|strong="H4725"\w* enferma para sanarme de la lepra.  
\v 12 ¿Acaso \w los|strong="H3605"\w* ríos \w de|strong="H4325"\w* \w Damasco|strong="H1834"\w*, \w el|strong="H3605"\w* Abaná y \w el|strong="H3605"\w* Farfar, \w no|strong="H3808"\w* \w son|strong="H3808"\w* \w mejores|strong="H2896"\w* \w que|strong="H3808"\w* \w todas|strong="H3605"\w* las \w aguas|strong="H4325"\w* \w de|strong="H4325"\w* \w Israel|strong="H3478"\w*? ¿\w No|strong="H3808"\w* podría yo lavarme \w en|strong="H3212"\w* \w ellos|strong="H3605"\w* y quedar \w limpio|strong="H2891"\w*?” \w Y|strong="H3068"\w* muy furioso, dio media vuelta y \w se|strong="H3808"\w* \w fue|strong="H3212"\w*.   
\p
\v 13 \w Pero|strong="H3588"\w* sus \w criados|strong="H5650"\w* \w se|strong="H3808"\w* acercaron \w y|strong="H3588"\w* le \w dijeron|strong="H1697"\w*: “Señor, \w si|strong="H3588"\w* \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* le hubiera pedido \w algo|strong="H1697"\w* difícil, ¿\w no|strong="H3808"\w* \w lo|strong="H1697"\w* habría \w hecho|strong="H6213"\w* usted? ¡\w Con|strong="H3588"\w* cuánta \w más|strong="H3588"\w* razón ahora \w que|strong="H3588"\w* solo le \w dice|strong="H1696"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* lave \w y|strong="H3588"\w* quedará \w limpio|strong="H2891"\w*!”   
\p
\v 14 \w Entonces|strong="H7725"\w* Naamán bajó al \w Jordán|strong="H3383"\w* y se sumergió \w siete|strong="H7651"\w* \w veces|strong="H6471"\w*, conforme \w a|strong="H3068"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* el hombre \w de|strong="H1697"\w* Dios le había ordenado. ¡\w Y|strong="H3068"\w* su piel se \w volvió|strong="H7725"\w* como la \w de|strong="H1697"\w* un \w niño|strong="H5288"\w*, y quedó \w limpio|strong="H2891"\w*!  
\v 15 \w Luego|strong="H4994"\w* Naamán \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* acompañantes regresaron \w a|strong="H3068"\w* ver al hombre \w de|strong="H3588"\w* Dios. Al llegar, Naamán \w se|strong="H3045"\w* presentó \w ante|strong="H6440"\w* \w él|strong="H1931"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dijo: “\w Ahora|strong="H6258"\w* \w estoy|strong="H5975"\w* convencido \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w en|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* tierra \w no|strong="H3588"\w* hay \w más|strong="H3588"\w* Dios \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*. \w Por|strong="H3588"\w* favor, acepte usted un regalo \w de|strong="H3588"\w* \w este|strong="H1931"\w* servidor \w suyo|strong="H1931"\w*”.   
\p
\v 16 Pero Eliseo respondió: “Tan cierto como que \w vive|strong="H2416"\w* Yahvé, \w a|strong="H3068"\w* quien sirvo, que \w no|strong="H3985"\w* aceptaré nada”.  
\p \w Y|strong="H3068"\w* \w por|strong="H6440"\w* más que Naamán le insistió, Eliseo \w no|strong="H3985"\w* quiso aceptar el regalo.  
\v 17 \w Entonces|strong="H3588"\w* \w Naamán|strong="H5283"\w* dijo: “\w Si|strong="H3588"\w* \w no|strong="H3808"\w* acepta \w nada|strong="H3808"\w*, \w por|strong="H3588"\w* \w lo|strong="H3808"\w* \w menos|strong="H3588"\w* permita \w que|strong="H3588"\w* \w me|strong="H3588"\w* den un poco \w de|strong="H3588"\w* tierra \w de|strong="H3588"\w* este país, \w la|strong="H3588"\w* \w que|strong="H3588"\w* puedan cargar dos mulas; \w porque|strong="H3588"\w* \w de|strong="H3588"\w* \w ahora|strong="H4994"\w* \w en|strong="H3588"\w* \w adelante|strong="H5750"\w* este servidor suyo \w no|strong="H3808"\w* \w ofrecerá|strong="H6213"\w* \w sacrificios|strong="H2077"\w* \w ni|strong="H3808"\w* \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* \w ningún|strong="H3808"\w* \w otro|strong="H5750"\w* \w dios|strong="H3068"\w*, \w sino|strong="H3588"\w* solo \w a|strong="H3068"\w* Yahvé.  
\v 18 \w Solo|strong="H1931"\w* una \w cosa|strong="H1697"\w* \w le|strong="H1931"\w* pido \w a|strong="H3068"\w* Yahvé \w que|strong="H1931"\w* \w me|strong="H5921"\w* \w perdone|strong="H5545"\w*: \w que|strong="H1931"\w* \w cuando|strong="H5650"\w* \w mi|strong="H5921"\w* \w señor|strong="H3068"\w* \w el|strong="H1931"\w* rey \w entre|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Rimón \w para|strong="H5921"\w* adorar, \w y|strong="H5921"\w* \w se|strong="H1931"\w* apoye \w en|strong="H5921"\w* \w mi|strong="H5921"\w* brazo, \w y|strong="H5921"\w* \w yo|strong="H4994"\w* \w también|strong="H2088"\w* tenga \w que|strong="H1931"\w* inclinarme \w allí|strong="H8033"\w*, \w que|strong="H1931"\w* Yahvé \w perdone|strong="H5545"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w siervo|strong="H5650"\w* \w suyo|strong="H1931"\w* \w por|strong="H5921"\w* tener \w que|strong="H1931"\w* hacer \w eso|strong="H1931"\w*”.   
\p
\v 19 “\w Vete|strong="H3212"\w* \w en|strong="H3212"\w* \w paz|strong="H7965"\w*”, le contestó Eliseo.  
\p Naamán ya se había alejado una corta distancia,  
\v 20 \w cuando|strong="H3588"\w* \w Giezi|strong="H1522"\w*, \w el|strong="H3588"\w* \w criado|strong="H5288"\w* \w de|strong="H3588"\w* Eliseo, hombre \w de|strong="H3588"\w* \w Dios|strong="H3068"\w*, pensó: “\w Mi|strong="H2009"\w* amo fue muy blando \w con|strong="H3588"\w* \w este|strong="H2088"\w* sirio \w Naamán|strong="H5283"\w* al \w no|strong="H3588"\w* aceptarle \w nada|strong="H3972"\w* \w de|strong="H3588"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* traía. Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w vive|strong="H2416"\w*, \w que|strong="H3588"\w* voy \w a|strong="H3068"\w* correr tras \w él|strong="H3588"\w* \w para|strong="H3588"\w* ver \w qué|strong="H3588"\w* le saco”.   
\p
\v 21 Así \w que|strong="H5921"\w* \w Giezi|strong="H1522"\w* salió \w corriendo|strong="H7323"\w* tras \w Naamán|strong="H5283"\w*. Cuando \w Naamán|strong="H5283"\w* \w vio|strong="H7200"\w* \w que|strong="H5921"\w* alguien \w lo|strong="H5921"\w* seguía, \w se|strong="H5921"\w* bajó \w de|strong="H5921"\w* su \w carro|strong="H4818"\w* \w para|strong="H5921"\w* recibirlo \w y|strong="H5921"\w* \w le|strong="H5921"\w* preguntó: “¿Pasa algo malo?”   
\p
\v 22 “No, nada malo”, respondió Giezi. “Solo \w que|strong="H6258"\w* \w mi|strong="H2009"\w* amo me \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decirle \w que|strong="H6258"\w* acaban \w de|strong="H1121"\w* llegar \w dos|strong="H8147"\w* jóvenes \w profetas|strong="H5030"\w* \w de|strong="H1121"\w* la región montañosa \w de|strong="H1121"\w* Efraín, y le pide \w el|strong="H1121"\w* favor \w de|strong="H1121"\w* \w que|strong="H6258"\w* les \w dé|strong="H1121"\w* unos treinta kilos\f + \fr 5:22 \ft Un codo es la longitud desde la punta del dedo corazón hasta el codo del brazo de un hombre, es decir, unas 18 pulgadas o 46 centímetros.\f* \w de|strong="H1121"\w* \w plata|strong="H3701"\w* y \w dos|strong="H8147"\w* \w mudas|strong="H2487"\w* \w de|strong="H1121"\w* ropa”.   
\p
\v 23 “\w Por|strong="H6440"\w* favor, llévate sesenta kilos”, insistió \w Naamán|strong="H5283"\w*. \w Y|strong="H3068"\w* tanto le rogó que \w puso|strong="H5414"\w* la \w plata|strong="H3701"\w* en \w dos|strong="H8147"\w* bolsas y, junto con las \w dos|strong="H8147"\w* \w mudas|strong="H2487"\w* \w de|strong="H6440"\w* ropa, se las \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w de|strong="H6440"\w* sus \w criados|strong="H5288"\w* \w para|strong="H5414"\w* que las \w llevaran|strong="H5375"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Giezi.  
\v 24 Al llegar \w a|strong="H3068"\w* la colina, Giezi \w tomó|strong="H3947"\w* las cosas y las guardó \w en|strong="H3212"\w* la \w casa|strong="H1004"\w*; luego \w despidió|strong="H7971"\w* \w a|strong="H3068"\w* los hombres y \w ellos|strong="H3027"\w* se \w fueron|strong="H3212"\w*.  
\v 25 \w Cuando|strong="H5650"\w* \w Giezi|strong="H1522"\w* entró y \w se|strong="H1931"\w* presentó ante \w su|strong="H1931"\w* amo, Eliseo \w le|strong="H1931"\w* preguntó: “¿De \w dónde|strong="H1931"\w* vienes, \w Giezi|strong="H1522"\w*?”  
\p “\w Su|strong="H1931"\w* servidor \w no|strong="H3808"\w* \w ha|strong="H3808"\w* ido \w a|strong="H3068"\w* \w ninguna|strong="H3808"\w* parte”, respondió \w él|strong="H1931"\w*.   
\p
\v 26 Pero Eliseo \w le|strong="H5921"\w* dijo: “¿\w No|strong="H3808"\w* estaba ahí \w mi|strong="H5921"\w* espíritu \w cuando|strong="H5650"\w* aquel hombre \w se|strong="H5921"\w* bajó \w de|strong="H5921"\w* su \w carro|strong="H4818"\w* \w para|strong="H5921"\w* recibirte? ¿Acaso es este \w el|strong="H5921"\w* momento \w de|strong="H5921"\w* \w recibir|strong="H3947"\w* \w dinero|strong="H3701"\w*, ropa, huertos \w de|strong="H5921"\w* olivos, viñedos, \w ovejas|strong="H6629"\w*, \w bueyes|strong="H1241"\w*, esclavos \w y|strong="H5921"\w* esclavas?  
\v 27 \w Por|strong="H6440"\w* eso, la \w lepra|strong="H6883"\w* \w de|strong="H6440"\w* \w Naamán|strong="H5283"\w* se te \w pegará|strong="H1692"\w* \w a|strong="H3068"\w* ti y \w a|strong="H3068"\w* tus descendientes para \w siempre|strong="H5769"\w*”.  
\p \w En|strong="H3318"\w* cuanto Giezi \w salió|strong="H3318"\w* \w de|strong="H6440"\w* su \w presencia|strong="H6440"\w*, ya estaba cubierto \w de|strong="H6440"\w* \w lepra|strong="H6883"\w*, blanco como la nieve.   
\c 6  
\p
\v 1 \w Los|strong="H3427"\w* \w profetas|strong="H5030"\w* le dijeron \w a|strong="H3068"\w* Eliseo: “Como usted puede ver, \w el|strong="H1121"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w nos|strong="H4480"\w* reunimos \w con|strong="H4480"\w* usted \w ya|strong="H4994"\w* \w nos|strong="H4480"\w* queda muy chico.  
\v 2 \w Por|strong="H5704"\w* favor, déjenos \w ir|strong="H3212"\w* \w al|strong="H5704"\w* \w Jordán|strong="H3383"\w* \w para|strong="H5704"\w* \w que|strong="H4994"\w* \w cada|strong="H8033"\w* uno \w traiga|strong="H3947"\w* un tronco \w y|strong="H5704"\w* construyamos \w allí|strong="H8033"\w* un \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* vivir”.  
\p Eliseo respondió: “\w Está|strong="H3427"\w* bien, \w vayan|strong="H3212"\w*”.   
\p
\v 3 Uno de ellos le rogó: “Por favor, acepte \w venir|strong="H3212"\w* con sus \w siervos|strong="H5650"\w*”.  
\p Él respondió: “Iría con gusto”.  
\v 4 Así que se \w fue|strong="H3212"\w* con ellos. Al llegar al \w Jordán|strong="H3383"\w*, empezaron \w a|strong="H3068"\w* cortar \w leña|strong="H6086"\w*.  
\v 5 Pero mientras uno \w de|strong="H4325"\w* \w ellos|strong="H1931"\w* derribaba un árbol, \w se|strong="H1961"\w* \w le|strong="H1931"\w* zafó \w el|strong="H1931"\w* hacha y \w cayó|strong="H5307"\w* al \w agua|strong="H4325"\w*. Entonces gritó: “¡Ay, \w mi|strong="H1961"\w* señor! ¡\w Esa|strong="H1931"\w* hacha \w era|strong="H1961"\w* \w prestada|strong="H7592"\w*!”   
\p
\v 6 \w El|strong="H5307"\w* hombre de Dios preguntó: “¿\w Dónde|strong="H8033"\w* \w cayó|strong="H5307"\w*?”. \w El|strong="H5307"\w* hombre le \w mostró|strong="H7200"\w* \w el|strong="H5307"\w* \w lugar|strong="H4725"\w*. Entonces Eliseo cortó un \w palo|strong="H6086"\w*, lo lanzó \w allí|strong="H8033"\w* mismo y logró que \w el|strong="H5307"\w* \w hierro|strong="H1270"\w* flotara.  
\v 7 “Sácalo”, le ordenó. \w Y|strong="H3068"\w* el hombre estiró la \w mano|strong="H3027"\w* y lo \w tomó|strong="H3947"\w*.   
\p
\v 8 El \w rey|strong="H4428"\w* \w de|strong="H3898"\w* Siria, \w que|strong="H1961"\w* \w estaba|strong="H1961"\w* en \w guerra|strong="H3898"\w* \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*, consultó con sus oficiales y les dijo: “Voy \w a|strong="H3068"\w* poner \w mi|strong="H1961"\w* campamento en tal y tal \w lugar|strong="H4725"\w*”.   
\p
\v 9 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w de|strong="H3588"\w* Dios le \w mandó|strong="H7971"\w* un aviso \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: “Tenga cuidado \w de|strong="H3588"\w* \w no|strong="H3588"\w* \w pasar|strong="H5674"\w* \w por|strong="H3588"\w* \w ese|strong="H2088"\w* \w lugar|strong="H4725"\w*, \w porque|strong="H3588"\w* \w los|strong="H3588"\w* sirios van \w a|strong="H3068"\w* bajar \w por|strong="H3588"\w* \w allí|strong="H8033"\w*”.  
\v 10 Entonces el \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* \w mandó|strong="H7971"\w* gente \w al|strong="H4428"\w* \w lugar|strong="H4725"\w* \w que|strong="H3808"\w* el hombre de Dios le había indicado. Así \w se|strong="H3808"\w* salvó en varias ocasiones, \w pues|strong="H7971"\w* Eliseo siempre \w lo|strong="H3808"\w* mantenía avisado.  
\v 11 \w Esto|strong="H2088"\w* puso \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria muy furioso. \w Llamó|strong="H7121"\w* \w a|strong="H3068"\w* sus oficiales \w y|strong="H5921"\w* \w les|strong="H5921"\w* preguntó: “¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* van \w a|strong="H3068"\w* \w decir|strong="H7121"\w* \w quién|strong="H4310"\w* \w de|strong="H5921"\w* ustedes \w está|strong="H2088"\w* \w de|strong="H5921"\w* parte \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*?”   
\p
\v 12 Uno \w de|strong="H3588"\w* sus oficiales respondió: “\w No|strong="H3808"\w* \w es|strong="H3588"\w* \w nadie|strong="H3808"\w* \w de|strong="H3588"\w* nosotros, \w su|strong="H3588"\w* majestad. \w Lo|strong="H1697"\w* \w que|strong="H3588"\w* pasa \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w profeta|strong="H5030"\w* Eliseo, \w que|strong="H3588"\w* está \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*, le \w cuenta|strong="H5046"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* hasta \w lo|strong="H1697"\w* \w que|strong="H3588"\w* usted \w dice|strong="H1696"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* propia recámara”.   
\p
\v 13 \w El|strong="H1931"\w* rey ordenó: “\w Vayan|strong="H3212"\w* y averigüen \w dónde|strong="H1931"\w* \w está|strong="H1931"\w*, para \w que|strong="H1931"\w* mande \w a|strong="H3068"\w* capturarlo”.  
\p Cuando \w le|strong="H1931"\w* avisaron \w que|strong="H1931"\w* Eliseo \w estaba|strong="H2009"\w* \w en|strong="H3212"\w* Dotán,   
\p
\v 14 \w el|strong="H5921"\w* rey \w envió|strong="H7971"\w* \w allá|strong="H8033"\w* un gran \w ejército|strong="H2428"\w* \w con|strong="H5921"\w* \w caballos|strong="H5483"\w* \w y|strong="H5921"\w* \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra. Llegaron \w de|strong="H5921"\w* \w noche|strong="H3915"\w* \w y|strong="H5921"\w* rodearon \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.  
\v 15 \w A|strong="H3068"\w* la mañana siguiente, cuando \w el|strong="H6213"\w* sirviente del hombre de Dios se \w levantó|strong="H6965"\w* y \w salió|strong="H3318"\w*, \w vio|strong="H2009"\w* que un \w ejército|strong="H2428"\w* con \w caballos|strong="H5483"\w* y \w carros|strong="H7393"\w* rodeaba la \w ciudad|strong="H5892"\w*. Entonces le dijo \w a|strong="H3068"\w* Eliseo: “¡Ay, \w mi|strong="H2009"\w* señor! ¿Qué vamos \w a|strong="H3068"\w* \w hacer|strong="H6213"\w*?”   
\p
\v 16 “\w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*”, respondió Eliseo, “\w porque|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* están \w con|strong="H3588"\w* nosotros \w son|strong="H3588"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* están \w con|strong="H3588"\w* ellos”.  
\v 17 \w Luego|strong="H4994"\w* Eliseo \w oró|strong="H6419"\w*: “Yahvé, por favor, ábrele los \w ojos|strong="H5869"\w* para \w que|strong="H4994"\w* pueda \w ver|strong="H7200"\w*”. Yahvé \w le|strong="H5869"\w* \w abrió|strong="H6491"\w* los \w ojos|strong="H5869"\w* al joven, y este \w vio|strong="H7200"\w* \w que|strong="H4994"\w* la montaña \w estaba|strong="H2009"\w* \w llena|strong="H4390"\w* \w de|strong="H5869"\w* \w caballos|strong="H5483"\w* y \w carros|strong="H7393"\w* \w de|strong="H5869"\w* fuego \w alrededor|strong="H5439"\w* \w de|strong="H5869"\w* Eliseo.  
\v 18 Cuando los sirios \w bajaron|strong="H3381"\w* para atacarlo, Eliseo \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé: “\w Por|strong="H1697"\w* favor, castiga \w a|strong="H3068"\w* \w esta|strong="H2088"\w* \w gente|strong="H1471"\w* con ceguera”.  
\p \w Y|strong="H3068"\w* Yahvé los dejó ciegos, \w tal|strong="H2088"\w* como Eliseo se \w lo|strong="H1697"\w* había pedido.   
\p
\v 19 Entonces Eliseo les dijo: “\w Este|strong="H2088"\w* \w no|strong="H3808"\w* \w es|strong="H2088"\w* el \w camino|strong="H1870"\w* \w ni|strong="H3808"\w* \w esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w ciudad|strong="H5892"\w*. Síganme, y los llevaré \w hasta|strong="H2088"\w* el hombre \w que|strong="H3808"\w* \w buscan|strong="H1245"\w*”. \w Y|strong="H3068"\w* los \w guio|strong="H3212"\w* \w hasta|strong="H2088"\w* \w Samaria|strong="H8111"\w*.  
\v 20 \w En|strong="H8432"\w* cuanto entraron \w en|strong="H8432"\w* \w Samaria|strong="H8111"\w*, Eliseo dijo: “Yahvé, ábreles \w los|strong="H1961"\w* \w ojos|strong="H5869"\w* \w a|strong="H3068"\w* estos hombres \w para|strong="H1961"\w* \w que|strong="H1961"\w* \w vean|strong="H7200"\w*”.  
\p El \w Señor|strong="H3068"\w* les \w abrió|strong="H6491"\w* \w los|strong="H1961"\w* \w ojos|strong="H5869"\w* y \w se|strong="H1961"\w* dieron cuenta \w de|strong="H5869"\w* \w que|strong="H1961"\w* \w estaban|strong="H1961"\w* \w en|strong="H8432"\w* pleno centro \w de|strong="H5869"\w* \w Samaria|strong="H8111"\w*.   
\p
\v 21 Cuando el \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* los \w vio|strong="H7200"\w*, le preguntó \w a|strong="H3068"\w* Eliseo: “¿Los \w mato|strong="H5221"\w*, padre mío? ¿Los \w mato|strong="H5221"\w* de una vez?”   
\p
\v 22 Pero él respondió: “\w No|strong="H3808"\w* los mate. ¿Acaso mataría usted \w a|strong="H3068"\w* los \w que|strong="H3808"\w* captura \w en|strong="H3212"\w* batalla con su \w espada|strong="H2719"\w* y su \w arco|strong="H7198"\w*? Mejor sírvales \w pan|strong="H3899"\w* y \w agua|strong="H4325"\w* para \w que|strong="H3808"\w* coman y \w beban|strong="H8354"\w*, y luego regresen con su patrón”.   
\p
\v 23 \w Así|strong="H1992"\w* \w que|strong="H3808"\w* \w el|strong="H1992"\w* rey \w les|strong="H1992"\w* preparó un \w gran|strong="H1419"\w* banquete. Después \w de|strong="H5750"\w* \w que|strong="H3808"\w* comieron y \w bebieron|strong="H8354"\w*, \w los|strong="H1992"\w* \w despidió|strong="H7971"\w* y \w ellos|strong="H1992"\w* regresaron con \w su|strong="H1992"\w* rey. Desde entonces, \w las|strong="H1992"\w* bandas \w de|strong="H5750"\w* sirios dejaron \w de|strong="H5750"\w* invadir \w el|strong="H1992"\w* territorio \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*.   
\p
\v 24 Tiempo \w después|strong="H5921"\w*, Ben-hadad, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria, movilizó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H4264"\w* \w y|strong="H5921"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* sitiar \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* \w Samaria|strong="H8111"\w*.  
\v 25 Debido \w al|strong="H5921"\w* sitio, \w hubo|strong="H1961"\w* un \w hambre|strong="H7458"\w* terrible \w en|strong="H5921"\w* \w la|strong="H5921"\w* ciudad, \w a|strong="H3068"\w* tal grado \w que|strong="H5921"\w* una \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* burro \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* costar \w ochenta|strong="H8084"\w* \w monedas|strong="H3701"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w*, \w y|strong="H5921"\w* un puñado \w de|strong="H5921"\w* estiércol \w de|strong="H5921"\w* paloma costaba \w cinco|strong="H2568"\w* \w monedas|strong="H3701"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w*.  
\v 26 Un día, mientras \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w pasaba|strong="H5674"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* muralla, una mujer \w le|strong="H5921"\w* gritó: “¡Ayúdeme, su majestad!”   
\p
\v 27 El rey respondió: “Si Yahvé no \w te|strong="H4480"\w* \w ayuda|strong="H3467"\w*, ¿\w de|strong="H4480"\w* dónde voy \w a|strong="H3068"\w* sacar \w ayuda|strong="H3467"\w* \w para|strong="H4480"\w* \w ti|strong="H4480"\w*? ¿\w Del|strong="H4480"\w* granero \w o|strong="H3068"\w* \w del|strong="H4480"\w* \w lagar|strong="H3342"\w*?”  
\v 28 Sin embargo, \w el|strong="H1121"\w* \w rey|strong="H4428"\w* le preguntó: “¿\w Qué|strong="H4100"\w* te pasa?”  
\p Ella respondió: “\w Esta|strong="H2063"\w* mujer me dijo: ‘\w Trae|strong="H5414"\w* \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w* \w para|strong="H5414"\w* \w que|strong="H4100"\w* \w nos|strong="H4100"\w* \w lo|strong="H4100"\w* comamos \w hoy|strong="H3117"\w*, y \w mañana|strong="H4279"\w* \w nos|strong="H4100"\w* comeremos \w al|strong="H4428"\w* mío’.  
\v 29 Así \w que|strong="H3117"\w* cocinamos \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* y nos lo comimos. Al \w día|strong="H3117"\w* siguiente le dije: ‘\w Ahora|strong="H3117"\w* \w trae|strong="H5414"\w* \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w* \w para|strong="H5414"\w* \w que|strong="H3117"\w* nos lo comamos’, ¡pero ella ya lo había \w escondido|strong="H2244"\w*!”   
\p
\v 30 \w Al|strong="H5921"\w* \w oír|strong="H8085"\w* \w las|strong="H5921"\w* \w palabras|strong="H1697"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* mujer, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w se|strong="H1961"\w* \w rasgó|strong="H7167"\w* \w la|strong="H1931"\w* ropa \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor. Mientras caminaba \w por|strong="H5921"\w* \w la|strong="H1931"\w* muralla, \w la|strong="H1931"\w* \w gente|strong="H5971"\w* pudo \w ver|strong="H7200"\w* \w que|strong="H1931"\w* debajo \w de|strong="H5921"\w* \w su|strong="H1931"\w* ropa \w llevaba|strong="H1961"\w* puesto cilicio.  
\v 31 \w Entonces|strong="H3117"\w* \w el|strong="H5921"\w* \w rey|strong="H6213"\w* exclamó: “¡\w Que|strong="H5921"\w* Dios \w me|strong="H5921"\w* castigue duramente \w si|strong="H5921"\w* \w para|strong="H5921"\w* antes \w de|strong="H5921"\w* \w que|strong="H5921"\w* termine \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* Eliseo \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Safat sigue todavía \w sobre|strong="H5921"\w* sus hombros!”   
\p
\v 32 Eliseo \w estaba|strong="H3427"\w* \w en|strong="H3588"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w* \w sentado|strong="H3427"\w* \w con|strong="H3588"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w*. \w El|strong="H1931"\w* rey \w envió|strong="H7971"\w* \w a|strong="H3068"\w* uno \w de|strong="H3588"\w* \w sus|strong="H1931"\w* \w mensajeros|strong="H4397"\w*, \w pero|strong="H3588"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H1931"\w* \w hombre|strong="H1121"\w* llegara, Eliseo les dijo \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w*: “¿\w Ya|strong="H3068"\w* \w vieron|strong="H7200"\w* \w cómo|strong="H3588"\w* \w este|strong="H2088"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* asesino manda \w a|strong="H3068"\w* alguien \w para|strong="H3588"\w* cortarme \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w*? Estén atentos; \w cuando|strong="H3588"\w* llegue \w el|strong="H1931"\w* \w mensajero|strong="H4397"\w*, cierren \w la|strong="H1931"\w* \w puerta|strong="H1817"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* dejen entrar. ¿\w No|strong="H3808"\w* \w se|strong="H1931"\w* oyen \w ya|strong="H2088"\w* \w los|strong="H3427"\w* pasos \w de|strong="H3588"\w* \w su|strong="H1931"\w* amo \w que|strong="H3588"\w* viene detrás \w de|strong="H3588"\w* \w él|strong="H1931"\w*?”   
\p
\v 33 \w Todavía|strong="H5750"\w* \w estaba|strong="H2009"\w* \w hablando|strong="H1696"\w* \w con|strong="H5973"\w* ellos \w cuando|strong="H4100"\w* \w el|strong="H5973"\w* \w mensajero|strong="H4397"\w* llegó y \w el|strong="H5973"\w* rey \w dijo|strong="H1696"\w*: “Toda \w esta|strong="H2063"\w* desgracia viene \w de|strong="H5973"\w* Yahvé. ¿\w Para|strong="H5973"\w* \w qué|strong="H4100"\w* voy \w a|strong="H3068"\w* seguir \w esperando|strong="H3176"\w* algo \w de|strong="H5973"\w* \w él|strong="H5973"\w*?”   
\c 7  
\p
\v 1 Eliseo dijo: “\w Escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé. \w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: ‘\w Mañana|strong="H4279"\w* \w a|strong="H3068"\w* esta \w hora|strong="H6256"\w*, en la entrada \w de|strong="H1697"\w* \w Samaria|strong="H8111"\w*, se podrán comprar siete litros \w de|strong="H1697"\w* harina fina \w por|strong="H1697"\w* una moneda \w de|strong="H1697"\w* plata, \w y|strong="H3541"\w* quince litros \w de|strong="H1697"\w* \w cebada|strong="H8184"\w* también \w por|strong="H1697"\w* una moneda \w de|strong="H1697"\w* plata’”.   
\p
\v 2 \w El|strong="H5921"\w* oficial \w que|strong="H3808"\w* \w era|strong="H1961"\w* \w el|strong="H5921"\w* brazo derecho \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* hombre \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*: “¡\w Mire|strong="H7200"\w*! ¡\w Ni|strong="H3808"\w* \w aunque|strong="H8033"\w* Yahvé abriera ventanas \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* podría pasar \w algo|strong="H1697"\w* \w así|strong="H2088"\w*!”  
\p Pero Eliseo \w le|strong="H5921"\w* \w respondió|strong="H6030"\w*: “\w Pues|strong="H2088"\w* \w lo|strong="H1697"\w* \w verás|strong="H7200"\w* \w con|strong="H5921"\w* tus propios \w ojos|strong="H5869"\w*, pero \w no|strong="H3808"\w* comerás \w nada|strong="H3808"\w* \w de|strong="H5921"\w* eso”.   
\p
\v 3 \w Había|strong="H1961"\w* cuatro hombres \w que|strong="H4100"\w* \w tenían|strong="H1961"\w* lepra \w a|strong="H3068"\w* la entrada \w de|strong="H5704"\w* la ciudad. Ellos \w se|strong="H1961"\w* dijeron unos \w a|strong="H3068"\w* otros: “¿\w Qué|strong="H4100"\w* hacemos \w aquí|strong="H6311"\w* \w sentados|strong="H3427"\w* esperando la \w muerte|strong="H4191"\w*?  
\v 4 Si decidimos entrar \w en|strong="H3212"\w* la \w ciudad|strong="H5892"\w*, nos \w moriremos|strong="H4191"\w* de \w hambre|strong="H7458"\w*, \w porque|strong="H8033"\w* \w allá|strong="H8033"\w* no hay nada \w que|strong="H6258"\w* comer. \w Y|strong="H3068"\w* si nos quedamos \w aquí|strong="H6311"\w*, también \w moriremos|strong="H4191"\w*. \w Así|strong="H6258"\w* \w que|strong="H6258"\w* vengan, \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* entregarnos al \w campamento|strong="H4264"\w* de \w los|strong="H3427"\w* sirios. Si nos perdonan la \w vida|strong="H2421"\w*, \w viviremos|strong="H2421"\w*; y si nos matan, de todos modos íbamos \w a|strong="H3068"\w* \w morir|strong="H4191"\w*”.   
\p
\v 5 \w Al|strong="H5704"\w* anochecer, se \w levantaron|strong="H6965"\w* \w y|strong="H5704"\w* se fueron \w hacia|strong="H8033"\w* \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w de|strong="H5704"\w* los sirios. \w Cuando|strong="H5704"\w* llegaron \w a|strong="H3068"\w* la entrada del \w campamento|strong="H4264"\w*, ¡vieron \w que|strong="H5704"\w* no había nadie!  
\v 6 \w Y|strong="H3068"\w* es \w que|strong="H5921"\w* \w el|strong="H5921"\w* Señor había hecho \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* sirio oyera un \w estruendo|strong="H6963"\w* \w de|strong="H5921"\w* \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra, \w caballos|strong="H5483"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* un \w gran|strong="H1419"\w* \w ejército|strong="H2428"\w*. \w Los|strong="H5921"\w* sirios \w se|strong="H5921"\w* dijeron unos \w a|strong="H3068"\w* otros: “¡Miren! \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* ha contratado \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* hititas \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w nos|strong="H5921"\w* ataquen”.  
\v 7 \w Por|strong="H5127"\w* \w eso|strong="H1931"\w* \w se|strong="H1931"\w* \w levantaron|strong="H6965"\w* y \w huyeron|strong="H5127"\w* al anochecer, abandonando \w sus|strong="H1931"\w* tiendas, \w sus|strong="H1931"\w* \w caballos|strong="H5483"\w* y \w sus|strong="H1931"\w* burros. \w Dejaron|strong="H5800"\w* \w el|strong="H1931"\w* \w campamento|strong="H4264"\w* tal \w como|strong="H1931"\w* estaba y salieron huyendo para salvar \w la|strong="H1931"\w* \w vida|strong="H5315"\w*.  
\v 8 \w Cuando|strong="H5704"\w* los \w leprosos|strong="H6879"\w* llegaron \w al|strong="H5704"\w* borde \w del|strong="H8354"\w* \w campamento|strong="H4264"\w*, \w entraron|strong="H3212"\w* \w en|strong="H5704"\w* una tienda, comieron \w y|strong="H5704"\w* \w bebieron|strong="H8354"\w*; \w luego|strong="H7725"\w* se \w llevaron|strong="H5375"\w* \w plata|strong="H3701"\w*, \w oro|strong="H2091"\w* \w y|strong="H5704"\w* ropa, \w y|strong="H5704"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* esconderlo todo. Regresaron, \w entraron|strong="H3212"\w* \w en|strong="H5704"\w* otra tienda, \w tomaron|strong="H5375"\w* también varias cosas \w y|strong="H5704"\w* las \w escondieron|strong="H2934"\w*.  
\v 9 \w Entonces|strong="H3117"\w* \w se|strong="H1931"\w* dijeron unos \w a|strong="H3068"\w* otros: “\w No|strong="H3808"\w* estamos \w haciendo|strong="H6213"\w* \w bien|strong="H3651"\w*. \w Hoy|strong="H3117"\w* \w es|strong="H1931"\w* un \w día|strong="H3117"\w* \w de|strong="H5704"\w* buenas noticias \w y|strong="H5704"\w* nos estamos quedando callados. \w Si|strong="H3808"\w* esperamos \w hasta|strong="H5704"\w* \w que|strong="H1931"\w* amanezca, nos van \w a|strong="H3068"\w* castigar. ¡Vengan! \w Vamos|strong="H3212"\w* \w de|strong="H5704"\w* \w una|strong="H4672"\w* vez \w al|strong="H5704"\w* palacio del \w rey|strong="H4428"\w* \w para|strong="H5704"\w* dar \w el|strong="H1931"\w* \w aviso|strong="H5046"\w*”.   
\p
\v 10 Fueron, \w pues|strong="H3588"\w*, \w y|strong="H3588"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* guardias \w de|strong="H3588"\w* \w la|strong="H3588"\w* puerta \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w les|strong="H1992"\w* dijeron: “Fuimos al \w campamento|strong="H4264"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* sirios \w y|strong="H3588"\w* \w no|strong="H3588"\w* encontramos \w a|strong="H3068"\w* nadie; \w no|strong="H3588"\w* \w se|strong="H1992"\w* oía ni un alma. Solo estaban \w los|strong="H1992"\w* \w caballos|strong="H5483"\w* \w y|strong="H3588"\w* \w los|strong="H1992"\w* burros amarrados, \w y|strong="H3588"\w* \w las|strong="H1992"\w* tiendas tal \w como|strong="H3588"\w* \w las|strong="H1992"\w* dejaron”.   
\p
\v 11 Entonces los guardias \w gritaron|strong="H7121"\w* la noticia y el \w aviso|strong="H5046"\w* llegó hasta el palacio del \w rey|strong="H4428"\w*.   
\p
\v 12 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w se|strong="H3045"\w* \w levantó|strong="H6965"\w* \w a|strong="H3068"\w* media \w noche|strong="H3915"\w* \w y|strong="H3588"\w* les \w dijo|strong="H5046"\w* \w a|strong="H3068"\w* sus oficiales: “\w Ahora|strong="H4994"\w* les voy \w a|strong="H3068"\w* explicar \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* sirios \w nos|strong="H4480"\w* están \w haciendo|strong="H6213"\w*. \w Como|strong="H3588"\w* \w saben|strong="H3045"\w* \w que|strong="H3588"\w* tenemos mucha hambre, \w se|strong="H3045"\w* \w salieron|strong="H3318"\w* \w del|strong="H4480"\w* \w campamento|strong="H4264"\w* \w para|strong="H3588"\w* \w esconderse|strong="H2247"\w* \w en|strong="H4480"\w* \w el|strong="H3588"\w* \w campo|strong="H4264"\w*. Han \w de|strong="H4480"\w* estar pensando: ‘\w En|strong="H4480"\w* \w cuanto|strong="H3588"\w* \w salgan|strong="H3318"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*, \w los|strong="H3588"\w* atraparemos \w vivos|strong="H2416"\w* \w y|strong="H3588"\w* entraremos \w en|strong="H4480"\w* Samaria’”.   
\p
\v 13 Pero uno \w de|strong="H4480"\w* sus oficiales \w respondió|strong="H6030"\w*: “\w Por|strong="H4480"\w* favor, \w deje|strong="H7971"\w* \w que|strong="H4480"\w* unos hombres \w tomen|strong="H3947"\w* \w cinco|strong="H2568"\w* \w de|strong="H4480"\w* \w los|strong="H3605"\w* pocos \w caballos|strong="H5483"\w* \w que|strong="H4480"\w* \w nos|strong="H4480"\w* quedan (total, \w a|strong="H3068"\w* esos \w caballos|strong="H5483"\w* les \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar \w lo|strong="H3605"\w* \w mismo|strong="H3605"\w* \w que|strong="H4480"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas \w que|strong="H4480"\w* quedan \w aquí|strong="H2009"\w*, \w que|strong="H4480"\w* \w ya|strong="H4994"\w* \w están|strong="H2009"\w* \w por|strong="H4480"\w* morir). Mandémoslos \w para|strong="H4480"\w* \w ver|strong="H7200"\w* \w qué|strong="H4480"\w* pasa”.   
\p
\v 14 Así que \w tomaron|strong="H3947"\w* \w dos|strong="H8147"\w* \w carros|strong="H7393"\w* con sus \w caballos|strong="H5483"\w*, y \w el|strong="H4264"\w* \w rey|strong="H4428"\w* los \w envió|strong="H7971"\w* hacia \w el|strong="H4264"\w* \w ejército|strong="H4264"\w* sirio con esta orden: “\w Vayan|strong="H3212"\w* y \w vean|strong="H7200"\w* qué pasó”.   
\p
\v 15 \w Los|strong="H3605"\w* \w mensajeros|strong="H4397"\w* siguieron \w el|strong="H3605"\w* rastro \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* río \w Jordán|strong="H3383"\w*, \w y|strong="H5704"\w* vieron \w que|strong="H5704"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w camino|strong="H1870"\w* \w estaba|strong="H2009"\w* \w lleno|strong="H4392"\w* \w de|strong="H5704"\w* ropa \w y|strong="H5704"\w* equipo \w que|strong="H5704"\w* \w los|strong="H3605"\w* sirios habían tirado \w en|strong="H5704"\w* su apuro \w por|strong="H1870"\w* escapar. \w Luego|strong="H7725"\w* regresaron \w y|strong="H5704"\w* se \w lo|strong="H5704"\w* informaron \w al|strong="H5704"\w* \w rey|strong="H4428"\w*.  
\v 16 Entonces la \w gente|strong="H5971"\w* \w salió|strong="H3318"\w* y saqueó \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w de|strong="H5971"\w* \w los|strong="H1961"\w* sirios. Así \w fue|strong="H1961"\w* \w como|strong="H1961"\w* \w se|strong="H1961"\w* vendieron siete litros \w de|strong="H5971"\w* harina fina \w por|strong="H1697"\w* una moneda \w de|strong="H5971"\w* plata, y quince litros \w de|strong="H5971"\w* \w cebada|strong="H8184"\w* \w por|strong="H1697"\w* una moneda \w de|strong="H5971"\w* plata, \w tal|strong="H1697"\w* \w como|strong="H1961"\w* Yahvé \w lo|strong="H1697"\w* \w había|strong="H1961"\w* \w dicho|strong="H1697"\w*.  
\v 17 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* había puesto \w al|strong="H5921"\w* oficial \w que|strong="H5921"\w* era su brazo derecho \w a|strong="H3068"\w* \w cargo|strong="H3027"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudad, pero \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w lo|strong="H5921"\w* atropelló \w y|strong="H5921"\w* \w murió|strong="H4191"\w* pisoteado, tal \w como|strong="H5921"\w* \w el|strong="H5921"\w* hombre \w de|strong="H5921"\w* Dios \w lo|strong="H5921"\w* había anunciado cuando \w el|strong="H5921"\w* \w rey|strong="H4428"\w* fue \w a|strong="H3068"\w* verlo.  
\v 18 \w Sucedió|strong="H1961"\w* exactamente lo \w que|strong="H1961"\w* el hombre \w de|strong="H6256"\w* Dios le \w había|strong="H1961"\w* \w dicho|strong="H1696"\w* \w al|strong="H6256"\w* \w rey|strong="H4428"\w*: “\w Mañana|strong="H4279"\w* \w a|strong="H3068"\w* \w esta|strong="H1961"\w* \w hora|strong="H6256"\w*, en la entrada \w de|strong="H6256"\w* \w Samaria|strong="H8111"\w*, \w se|strong="H1961"\w* venderán quince litros \w de|strong="H6256"\w* \w cebada|strong="H8184"\w* \w por|strong="H4428"\w* una moneda \w de|strong="H6256"\w* plata, y siete litros \w de|strong="H6256"\w* harina fina \w por|strong="H4428"\w* una moneda \w de|strong="H6256"\w* plata”.  
\v 19 \w Aquel|strong="H2088"\w* oficial \w le|strong="H5869"\w* \w había|strong="H1961"\w* respondido al hombre \w de|strong="H1697"\w* \w Dios|strong="H3068"\w*: “¡\w Ni|strong="H3808"\w* \w aunque|strong="H8033"\w* Yahvé abriera ventanas en \w el|strong="H6213"\w* \w cielo|strong="H8064"\w* podría pasar \w algo|strong="H1697"\w* \w así|strong="H2088"\w*!” \w Y|strong="H3068"\w* Eliseo \w le|strong="H5869"\w* \w había|strong="H1961"\w* \w dicho|strong="H1697"\w*: “\w Pues|strong="H2088"\w* \w lo|strong="H1697"\w* \w verás|strong="H7200"\w* con tus propios \w ojos|strong="H5869"\w*, pero \w no|strong="H3808"\w* comerás \w nada|strong="H3808"\w* \w de|strong="H1697"\w* eso”.  
\v 20 \w Y|strong="H3068"\w* \w así|strong="H3651"\w* le pasó: la \w gente|strong="H5971"\w* lo atropelló en la \w puerta|strong="H8179"\w* \w de|strong="H5971"\w* la ciudad, y allí \w murió|strong="H4191"\w*.   
\c 8  
\p
\v 1 Eliseo le \w había|strong="H3588"\w* \w dicho|strong="H1696"\w* \w a|strong="H3068"\w* \w la|strong="H1571"\w* mujer \w a|strong="H3068"\w* cuyo \w hijo|strong="H1121"\w* \w él|strong="H3588"\w* \w había|strong="H3588"\w* resucitado: “Prepárate \w y|strong="H1571"\w* \w vete|strong="H3212"\w* \w con|strong="H3588"\w* tu \w familia|strong="H1004"\w* \w a|strong="H3068"\w* \w vivir|strong="H2421"\w* donde puedas, \w porque|strong="H3588"\w* Yahvé ha anunciado un \w hambre|strong="H7458"\w* \w que|strong="H3588"\w* \w durará|strong="H6965"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w en|strong="H3588"\w* todo \w el|strong="H3588"\w* país”.   
\p
\v 2 \w La|strong="H1931"\w* mujer \w siguió|strong="H3212"\w* las instrucciones del hombre \w de|strong="H1697"\w* Dios, \w se|strong="H1931"\w* \w fue|strong="H3212"\w* con \w su|strong="H1931"\w* \w familia|strong="H1004"\w* y vivió \w en|strong="H3212"\w* \w la|strong="H1931"\w* tierra \w de|strong="H1697"\w* \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w* durante \w siete|strong="H7651"\w* \w años|strong="H8141"\w*.  
\v 3 \w Cuando|strong="H1961"\w* pasaron \w los|strong="H1961"\w* \w siete|strong="H7651"\w* \w años|strong="H8141"\w*, la mujer regresó de la tierra de \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* y \w fue|strong="H1961"\w* \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w para|strong="H1961"\w* pedirle \w que|strong="H1961"\w* le devolviera su \w casa|strong="H1004"\w* y sus \w tierras|strong="H7704"\w*.  
\v 4 En ese momento \w el|strong="H3605"\w* \w rey|strong="H4428"\w* estaba \w hablando|strong="H1696"\w* con \w Giezi|strong="H1522"\w*, \w el|strong="H3605"\w* sirviente del hombre de Dios, y le decía: “\w Por|strong="H4428"\w* favor, cuéntame \w todas|strong="H3605"\w* las cosas asombrosas \w que|strong="H4994"\w* ha \w hecho|strong="H6213"\w* Eliseo”.  
\v 5 Mientras \w Giezi|strong="H1522"\w* \w le|strong="H1931"\w* contaba \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w cómo|strong="H1961"\w* Eliseo \w había|strong="H1961"\w* resucitado \w al|strong="H5921"\w* niño, \w la|strong="H1931"\w* mujer \w se|strong="H1961"\w* presentó ante \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w para|strong="H5921"\w* reclamar \w su|strong="H1931"\w* \w casa|strong="H1004"\w* \w y|strong="H5921"\w* \w sus|strong="H1931"\w* \w tierras|strong="H7704"\w*. \w Giezi|strong="H1522"\w* exclamó: “¡Majestad, \w esta|strong="H2063"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* mujer! ¡\w Y|strong="H3068"\w* \w este|strong="H2088"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w*, \w el|strong="H1931"\w* \w que|strong="H1931"\w* Eliseo resucitó!”   
\p
\v 6 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* le \w hizo|strong="H5414"\w* \w preguntas|strong="H7592"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* mujer, \w y|strong="H5704"\w* \w ella|strong="H3605"\w* le \w contó|strong="H5608"\w* \w todo|strong="H3605"\w*. \w Entonces|strong="H3117"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w* ordenó \w a|strong="H3068"\w* un oficial: “Devuélvele \w todo|strong="H3605"\w* \w lo|strong="H5704"\w* \w que|strong="H6258"\w* era suyo, junto \w con|strong="H5704"\w* \w todas|strong="H3605"\w* las cosechas \w que|strong="H6258"\w* se hayan producido \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H6258"\w* \w ella|strong="H3605"\w* se fue \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*”.   
\p
\v 7 Eliseo se fue \w a|strong="H3068"\w* \w Damasco|strong="H1834"\w*. \w Por|strong="H5704"\w* entonces Ben-hadad, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* Siria, estaba \w enfermo|strong="H2470"\w*. \w Cuando|strong="H5704"\w* le avisaron \w que|strong="H5704"\w* el hombre \w de|strong="H5704"\w* Dios andaba \w por|strong="H5704"\w* allá,   
\p
\v 8 el \w rey|strong="H4428"\w* le dijo \w a|strong="H3068"\w* \w Hazael|strong="H2371"\w*: “\w Lleva|strong="H3212"\w* un regalo y \w ve|strong="H3212"\w* \w a|strong="H3068"\w* \w recibir|strong="H3947"\w* \w al|strong="H4428"\w* hombre de \w Dios|strong="H3068"\w*. Pídele \w que|strong="H2088"\w* consulte \w a|strong="H3068"\w* Yahvé para saber si voy \w a|strong="H3068"\w* sanar de \w esta|strong="H2088"\w* \w enfermedad|strong="H2483"\w*”.   
\p
\v 9 \w Hazael|strong="H2371"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w recibir|strong="H3947"\w* \w a|strong="H3068"\w* Eliseo, \w llevando|strong="H3947"\w* consigo \w lo|strong="H2088"\w* mejor \w de|strong="H6440"\w* \w Damasco|strong="H1834"\w*; necesitó cuarenta \w camellos|strong="H1581"\w* para cargar \w todos|strong="H3605"\w* \w los|strong="H1121"\w* regalos. Cuando \w llegó|strong="H3212"\w* \w ante|strong="H6440"\w* \w él|strong="H3605"\w*, le dijo: “Su \w hijo|strong="H1121"\w* Ben-hadad, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Siria, me \w envía|strong="H7971"\w* \w a|strong="H3068"\w* preguntarle: ‘¿Voy \w a|strong="H3068"\w* sanar \w de|strong="H6440"\w* \w esta|strong="H2088"\w* \w enfermedad|strong="H2483"\w*?’”   
\p
\v 10 Eliseo le respondió: “\w Ve|strong="H3212"\w* \w y|strong="H3588"\w* dile \w que|strong="H3588"\w* \w ciertamente|strong="H3588"\w* sanará, \w aunque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* \w ha|strong="H3808"\w* revelado \w que|strong="H3588"\w* \w en|strong="H3588"\w* realidad \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w morir|strong="H4191"\w*”.  
\v 11 \w Luego|strong="H5704"\w* Eliseo se le \w quedó|strong="H5975"\w* mirando fijamente \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* Hazael se sintió muy incómodo. \w De|strong="H6440"\w* pronto, el hombre \w de|strong="H6440"\w* Dios se echó \w a|strong="H3068"\w* llorar.   
\p
\v 12 \w Hazael|strong="H2371"\w* le preguntó: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w llora|strong="H1058"\w* mi señor?”  
\p \w Él|strong="H3588"\w* respondió: “\w Porque|strong="H3588"\w* \w sé|strong="H3045"\w* \w el|strong="H3588"\w* daño \w que|strong="H3588"\w* vas \w a|strong="H3068"\w* \w hacerle|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas. Vas \w a|strong="H3068"\w* incendiar sus ciudades fortificadas, \w matarás|strong="H2026"\w* \w a|strong="H3068"\w* sus jóvenes \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, estrellarás \w contra|strong="H3478"\w* \w el|strong="H3588"\w* suelo \w a|strong="H3068"\w* sus \w niños|strong="H5768"\w* \w y|strong="H3588"\w* les abrirás \w el|strong="H3588"\w* vientre \w a|strong="H3068"\w* las mujeres embarazadas”.   
\p
\v 13 \w Hazael|strong="H2371"\w* exclamó: “¿\w Quién|strong="H4100"\w* \w es|strong="H2088"\w* \w este|strong="H2088"\w* servidor suyo, \w que|strong="H3588"\w* \w no|strong="H6213"\w* \w es|strong="H2088"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* un \w perro|strong="H3611"\w*, \w para|strong="H5921"\w* \w hacer|strong="H6213"\w* \w algo|strong="H1697"\w* tan terrible?”  
\p Eliseo contestó: “Yahvé \w me|strong="H5921"\w* ha mostrado \w que|strong="H3588"\w* \w tú|strong="H6213"\w* serás \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria”.   
\p
\v 14 Hazael \w se|strong="H4100"\w* despidió de Eliseo y regresó \w a|strong="H3068"\w* donde estaba su rey, \w quien|strong="H4100"\w* le preguntó: “¿\w Qué|strong="H4100"\w* te dijo Eliseo?”  
\p Él respondió: “Me dijo \w que|strong="H4100"\w* usted \w ciertamente|strong="H2421"\w* sanará”.   
\p
\v 15 Pero \w al|strong="H5921"\w* día \w siguiente|strong="H4283"\w*, \w Hazael|strong="H2371"\w* \w tomó|strong="H3947"\w* una manta, \w la|strong="H5921"\w* empapó \w en|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w la|strong="H5921"\w* puso \w al|strong="H5921"\w* \w rey|strong="H4427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w* \w hasta|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* asfixió. Así \w murió|strong="H4191"\w* \w el|strong="H5921"\w* \w rey|strong="H4427"\w*, \w y|strong="H5921"\w* \w Hazael|strong="H2371"\w* \w reinó|strong="H4427"\w* \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 16 \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* Josafat comenzó \w a|strong="H3068"\w* reinar en \w Judá|strong="H3063"\w* durante \w el|strong="H1121"\w* quinto \w año|strong="H8141"\w* del \w reinado|strong="H4427"\w* \w de|strong="H2568"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* Acab en \w Israel|strong="H3478"\w*, mientras Josafat todavía \w era|strong="H8141"\w* \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Judá|strong="H3063"\w*.  
\v 17 \w Tenía|strong="H1961"\w* \w treinta|strong="H7970"\w* y \w dos|strong="H8147"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w ocho|strong="H8083"\w* \w años|strong="H8141"\w*.  
\v 18 \w Pero|strong="H3588"\w* \w siguió|strong="H3212"\w* \w el|strong="H3588"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w reyes|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Acab, \w pues|strong="H3588"\w* \w se|strong="H1961"\w* casó \w con|strong="H3588"\w* una \w hija|strong="H1323"\w* \w de|strong="H3588"\w* Acab. \w Hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* ofende \w a|strong="H3068"\w* Yahvé.  
\v 19 \w Sin|strong="H3808"\w* embargo, Yahvé \w no|strong="H3808"\w* quiso \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w por|strong="H4616"\w* amor \w a|strong="H3068"\w* su \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*, pues le había prometido \w que|strong="H3808"\w* su descendencia \w siempre|strong="H3605"\w* brillaría como una \w lámpara|strong="H5216"\w* ante \w él|strong="H3605"\w*.   
\p
\v 20 Durante \w el|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Joram, \w los|strong="H5921"\w* \w de|strong="H5921"\w* Edom \w se|strong="H5921"\w* rebelaron \w contra|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* nombraron su propio \w rey|strong="H4428"\w*.  
\v 21 \w Por|strong="H5127"\w* \w eso|strong="H1931"\w* \w Joram|strong="H3141"\w* \w fue|strong="H1961"\w* \w con|strong="H5973"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* \w carros|strong="H7393"\w* \w de|strong="H5973"\w* guerra \w a|strong="H3068"\w* Zair. \w Los|strong="H3605"\w* edomitas rodearon \w a|strong="H3068"\w* \w Joram|strong="H3141"\w* y \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w capitanes|strong="H8269"\w*, pero \w él|strong="H1931"\w* atacó \w de|strong="H5973"\w* \w noche|strong="H3915"\w* y logró abrirse \w paso|strong="H5674"\w*, aunque \w sus|strong="H1931"\w* soldados \w huyeron|strong="H5127"\w* \w a|strong="H3068"\w* \w sus|strong="H1931"\w* casas.  
\v 22 \w De|strong="H8478"\w* \w ese|strong="H1931"\w* modo Edom \w se|strong="H1931"\w* independizó \w de|strong="H8478"\w* \w Judá|strong="H3063"\w* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H8478"\w* \w hoy|strong="H3117"\w*. \w En|strong="H5704"\w* \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w también|strong="H2088"\w* \w se|strong="H1931"\w* rebeló \w la|strong="H1931"\w* ciudad \w de|strong="H8478"\w* \w Libna|strong="H3841"\w*.  
\v 23 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Joram|strong="H3141"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 24 Cuando \w Joram|strong="H3141"\w* murió, fue \w sepultado|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H8478"\w* \w David|strong="H1732"\w*. Su \w hijo|strong="H1121"\w* Ocozías \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 25 Ocozías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joram|strong="H3088"\w* comenzó \w a|strong="H3068"\w* reinar en \w Judá|strong="H3063"\w* durante \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w doce|strong="H8147"\w* del \w reinado|strong="H4427"\w* \w de|strong="H1121"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Acab en \w Israel|strong="H3478"\w*.  
\v 26 Ocozías tenía \w veintidós|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén un \w año|strong="H8141"\w*. Su madre \w era|strong="H8141"\w* \w Atalía|strong="H6271"\w*, nieta \w de|strong="H1121"\w* \w Omrí|strong="H6018"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 27 Ocozías también \w siguió|strong="H3212"\w* \w el|strong="H1931"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* Acab \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* ofende \w a|strong="H3068"\w* Yahvé, \w pues|strong="H3588"\w* \w estaba|strong="H1004"\w* emparentado \w con|strong="H3588"\w* \w ellos|strong="H1931"\w*.   
\p
\v 28 Ocozías se alió \w con|strong="H5973"\w* \w Joram|strong="H3141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Acab \w para|strong="H5973"\w* pelear \w contra|strong="H5973"\w* \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* Siria, \w en|strong="H5973"\w* Ramot \w de|strong="H5973"\w* \w Galaad|strong="H1568"\w*. Allí \w los|strong="H1121"\w* sirios \w hirieron|strong="H5221"\w* \w a|strong="H3068"\w* \w Joram|strong="H3141"\w*,  
\v 29 \w y|strong="H3588"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w Joram|strong="H3088"\w* tuvo \w que|strong="H3588"\w* regresar \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w* \w para|strong="H3588"\w* curarse \w de|strong="H4480"\w* las \w heridas|strong="H4347"\w* \w que|strong="H3588"\w* \w le|strong="H1931"\w* habían causado \w en|strong="H4480"\w* \w Ramá|strong="H7414"\w*. \w Entonces|strong="H3588"\w* Ocozías \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Joram|strong="H3088"\w*, \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w fue|strong="H1931"\w* \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w* \w para|strong="H3588"\w* visitar \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Acab, \w porque|strong="H3588"\w* estaba herido.   
\c 9  
\p
\v 1 \w El|strong="H1121"\w* \w profeta|strong="H5030"\w* Eliseo \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* uno \w de|strong="H1121"\w* \w los|strong="H1121"\w* jóvenes \w profetas|strong="H5030"\w* y le dijo: “Prepárate para salir, \w toma|strong="H3947"\w* \w este|strong="H2088"\w* frasco \w de|strong="H1121"\w* \w aceite|strong="H8081"\w* y \w ve|strong="H3212"\w* \w a|strong="H3068"\w* Ramot \w de|strong="H1121"\w* \w Galaad|strong="H1568"\w*.  
\v 2 \w En|strong="H8432"\w* cuanto llegues, busca \w a|strong="H3068"\w* \w Jehú|strong="H3058"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josafat y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Nimsí. Entra \w en|strong="H8432"\w* \w donde|strong="H8033"\w* esté, apártalo \w de|strong="H1121"\w* sus compañeros y llévalo \w a|strong="H3068"\w* un cuarto privado.  
\v 3 Entonces \w toma|strong="H3947"\w* \w el|strong="H5921"\w* frasco, derrámalo \w sobre|strong="H5921"\w* su \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* dile: ‘\w Así|strong="H3541"\w* dice Yahvé: \w Te|strong="H5921"\w* he \w ungido|strong="H4886"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*’. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* eso, \w abre|strong="H6605"\w* \w la|strong="H5921"\w* \w puerta|strong="H1817"\w* \w y|strong="H5921"\w* \w huye|strong="H5127"\w* \w sin|strong="H3808"\w* detenerte”.   
\p
\v 4 \w El|strong="H5030"\w* joven \w profeta|strong="H5030"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* Ramot de \w Galaad|strong="H1568"\w*.  
\v 5 Al llegar, encontró \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w capitanes|strong="H8269"\w* del \w ejército|strong="H2428"\w* \w que|strong="H4310"\w* \w estaban|strong="H3427"\w* reunidos. \w Él|strong="H3605"\w* dijo: “\w Capitán|strong="H8269"\w*, traigo un mensaje para usted”.  
\p \w Jehú|strong="H3058"\w* preguntó: “¿Para \w cuál|strong="H4310"\w* \w de|strong="H1697"\w* \w todos|strong="H3605"\w* \w nosotros|strong="H3605"\w*?”  
\p \w El|strong="H3605"\w* joven respondió: “Para usted, \w capitán|strong="H8269"\w*”.  
\v 6 Jehú \w se|strong="H5971"\w* \w levantó|strong="H6965"\w* \w y|strong="H3541"\w* entró en la \w casa|strong="H1004"\w*. Entonces el joven \w derramó|strong="H3332"\w* el \w aceite|strong="H8081"\w* sobre la \w cabeza|strong="H7218"\w* \w de|strong="H5971"\w* Jehú \w y|strong="H3541"\w* le dijo: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*: ‘Te he \w ungido|strong="H4886"\w* como \w rey|strong="H4428"\w* sobre \w Israel|strong="H3478"\w*, el \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Yahvé.  
\v 7 Tú destruirás \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* \w de|strong="H1818"\w* tu \w señor|strong="H3068"\w* Acab. Así yo vengaré \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* mis \w siervos|strong="H5650"\w* \w los|strong="H3605"\w* \w profetas|strong="H5030"\w*, y \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w siervos|strong="H5650"\w* \w de|strong="H1818"\w* Yahvé \w que|strong="H3605"\w* fue derramada \w por|strong="H3027"\w* Jezabel.  
\v 8 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* de Acab \w perecerá|strong="H3772"\w*. Eliminaré de \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de Acab \w a|strong="H3068"\w* \w todo|strong="H3605"\w* varón, tanto \w a|strong="H3068"\w* esclavos como \w a|strong="H3068"\w* libres en \w Israel|strong="H3478"\w*.  
\v 9 Dejaré \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H1121"\w* Acab como dejé \w a|strong="H3068"\w* la \w de|strong="H1121"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w* y \w a|strong="H3068"\w* la \w de|strong="H1121"\w* \w Baasa|strong="H1201"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ahías|strong="H3379"\w*.  
\v 10 \w En|strong="H6912"\w* cuanto \w a|strong="H3068"\w* Jezabel, los \w perros|strong="H3611"\w* se la comerán \w en|strong="H6912"\w* el campo de \w Jezreel|strong="H3157"\w*, y nadie le dará sepultura’”. Al terminar de hablar, el joven \w abrió|strong="H6605"\w* la \w puerta|strong="H1817"\w* y salió huyendo.   
\p
\v 11 \w Cuando|strong="H5650"\w* \w Jehú|strong="H3058"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* reunirse con los oficiales de su señor, uno de ellos le preguntó: “¿Todo \w bien|strong="H7965"\w*? ¿\w A|strong="H3068"\w* \w qué|strong="H3045"\w* vino \w a|strong="H3068"\w* verte \w ese|strong="H2088"\w* loco?”  
\p \w Jehú|strong="H3058"\w* les contestó: “Ustedes \w ya|strong="H2088"\w* \w conocen|strong="H3045"\w* \w a|strong="H3068"\w* \w ese|strong="H2088"\w* tipo y sus tonterías”.   
\p
\v 12 Pero ellos insistieron: “¡No \w es|strong="H2063"\w* cierto! \w Cuéntanos|strong="H5046"\w* \w la|strong="H2063"\w* verdad”.  
\p Jehú les \w dijo|strong="H5046"\w*: “\w Pues|strong="H4994"\w* \w me|strong="H3541"\w* \w dijo|strong="H5046"\w* \w esto|strong="H2063"\w* \w y|strong="H3541"\w* aquello, \w y|strong="H3541"\w* \w que|strong="H4994"\w* Yahvé dice: ‘Te he \w ungido|strong="H4886"\w* como \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*’”.   
\p
\v 13 \w Al|strong="H8478"\w* oír esto, todos se apresuraron \w a|strong="H3068"\w* quitarse sus capas y las \w pusieron|strong="H7760"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w Jehú|strong="H3058"\w*, \w en|strong="H8478"\w* lo \w alto|strong="H4609"\w* \w de|strong="H8478"\w* la escalera. Luego \w tocaron|strong="H8628"\w* la \w trompeta|strong="H7782"\w* y gritaron: “¡\w Jehú|strong="H3058"\w* es el \w rey|strong="H4427"\w*!”   
\p
\v 14 Entonces \w Jehú|strong="H3058"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Josafat y \w nieto|strong="H1121"\w* \w de|strong="H6440"\w* Nimsí \w conspiró|strong="H7194"\w* \w contra|strong="H6440"\w* \w Joram|strong="H3141"\w*. (En \w aquel|strong="H1931"\w* tiempo \w Joram|strong="H3141"\w* \w estaba|strong="H1961"\w* defendiendo \w a|strong="H3068"\w* Ramot \w de|strong="H6440"\w* \w Galaad|strong="H1568"\w* junto con \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* frente \w a|strong="H3068"\w* \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Siria;  
\v 15 pero el \w rey|strong="H4428"\w* \w Joram|strong="H3088"\w* \w había|strong="H3426"\w* regresado \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w* \w para|strong="H4480"\w* recuperarse \w de|strong="H4480"\w* las \w heridas|strong="H4347"\w* \w que|strong="H4480"\w* los sirios le habían causado \w en|strong="H4480"\w* la batalla). Así \w que|strong="H4480"\w* \w Jehú|strong="H3058"\w* \w dijo|strong="H5046"\w*: “\w Si|strong="H3426"\w* ustedes \w están|strong="H3426"\w* \w de|strong="H4480"\w* acuerdo conmigo, \w que|strong="H4480"\w* nadie \w se|strong="H4480"\w* \w escape|strong="H3318"\w* \w de|strong="H4480"\w* la \w ciudad|strong="H5892"\w* \w para|strong="H4480"\w* \w ir|strong="H3212"\w* \w con|strong="H4480"\w* el chisme \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w*”.  
\v 16 Luego \w Jehú|strong="H3058"\w* montó \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w carro|strong="H7392"\w* \w y|strong="H3588"\w* se \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w*, \w donde|strong="H8033"\w* \w Joram|strong="H3141"\w* \w estaba|strong="H7901"\w* guardando cama. También Ocozías, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*, \w había|strong="H3588"\w* \w ido|strong="H3212"\w* \w allá|strong="H8033"\w* \w para|strong="H3588"\w* visitarlo.  
\v 17 \w El|strong="H5921"\w* \w centinela|strong="H6822"\w* \w que|strong="H5921"\w* \w estaba|strong="H5975"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* \w Jezreel|strong="H3157"\w* \w vio|strong="H7200"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* acercaba \w la|strong="H5921"\w* tropa \w de|strong="H5921"\w* \w Jehú|strong="H3058"\w* \w y|strong="H5921"\w* gritó: “¡\w Veo|strong="H7200"\w* \w que|strong="H5921"\w* viene un grupo \w de|strong="H5921"\w* gente!”  
\p \w Joram|strong="H3088"\w* \w ordenó|strong="H5975"\w*: “Manda \w a|strong="H3068"\w* un jinete \w a|strong="H3068"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w reciba|strong="H3947"\w* \w y|strong="H5921"\w* \w les|strong="H5921"\w* pregunte \w si|strong="H5921"\w* vienen \w en|strong="H5921"\w* son \w de|strong="H5921"\w* \w paz|strong="H7965"\w*”.   
\p
\v 18 \w El|strong="H1992"\w* jinete \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w su|strong="H1992"\w* encuentro \w y|strong="H5704"\w* \w dijo|strong="H5046"\w*: “\w El|strong="H1992"\w* \w rey|strong="H4428"\w* pregunta \w si|strong="H3808"\w* vienen \w en|strong="H5704"\w* \w son|strong="H3808"\w* \w de|strong="H5704"\w* \w paz|strong="H7965"\w*”.  
\p \w Jehú|strong="H3058"\w* le \w respondió|strong="H7725"\w*: “¿\w Qué|strong="H4100"\w* te importa \w a|strong="H3068"\w* ti la \w paz|strong="H7965"\w*? ¡Ponte atrás \w de|strong="H5704"\w* mí!”  
\p \w El|strong="H1992"\w* \w centinela|strong="H6822"\w* \w avisó|strong="H5046"\w*: “\w El|strong="H1992"\w* \w mensajero|strong="H4397"\w* \w llegó|strong="H5704"\w* \w hasta|strong="H5704"\w* \w ellos|strong="H1992"\w*, pero \w no|strong="H3808"\w* regresa”.   
\p
\v 19 Joram \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* un \w segundo|strong="H8145"\w* jinete, \w quien|strong="H4100"\w* llegó \w y|strong="H3541"\w* les dijo: “El \w rey|strong="H4428"\w* pregunta si vienen en son de \w paz|strong="H7965"\w*”.  
\p \w Jehú|strong="H3058"\w* contestó: “¿\w Qué|strong="H4100"\w* te importa \w a|strong="H3068"\w* ti la \w paz|strong="H7965"\w*? ¡Ponte atrás de mí!”   
\p
\v 20 \w El|strong="H3588"\w* \w centinela|strong="H6822"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* informar: “\w Ya|strong="H3068"\w* \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* donde están ellos, \w pero|strong="H3588"\w* \w tampoco|strong="H3808"\w* regresa. \w Por|strong="H3588"\w* \w la|strong="H3588"\w* forma \w de|strong="H3588"\w* manejar, parece \w Jehú|strong="H3058"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Nimsí, \w porque|strong="H3588"\w* maneja \w como|strong="H3588"\w* un loco”.   
\p
\v 21 “¡Preparen mi \w carro|strong="H7393"\w*!”, ordenó \w Joram|strong="H3088"\w*.  
\p \w En|strong="H3318"\w* cuanto el \w carro|strong="H7393"\w* estuvo listo, \w Joram|strong="H3088"\w* \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w* y Ocozías \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w* \w salieron|strong="H3318"\w*, cada uno \w en|strong="H3318"\w* su propio \w carro|strong="H7393"\w*, \w al|strong="H4428"\w* encuentro de \w Jehú|strong="H3058"\w*. Lo encontraron \w en|strong="H3318"\w* el terreno que \w había|strong="H4672"\w* sido de Nabot de Jezreel.  
\v 22 \w Cuando|strong="H4100"\w* \w Joram|strong="H3088"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w Jehú|strong="H3058"\w*, le preguntó: “¿Vienes \w en|strong="H5704"\w* \w son|strong="H1961"\w* \w de|strong="H5704"\w* \w paz|strong="H7965"\w*, \w Jehú|strong="H3058"\w*?”  
\p \w Jehú|strong="H3058"\w* respondió: “¿\w Cómo|strong="H4100"\w* puede \w haber|strong="H1961"\w* \w paz|strong="H7965"\w* \w mientras|strong="H5704"\w* sigan las idolatrías \w y|strong="H5704"\w* las brujerías \w de|strong="H5704"\w* tu madre Jezabel?”   
\p
\v 23 \w Joram|strong="H3088"\w* dio media \w vuelta|strong="H2015"\w* para huir y le gritó \w a|strong="H3068"\w* Ocozías: “¡\w Es|strong="H3027"\w* una \w traición|strong="H4820"\w*, Ocozías!”   
\p
\v 24 Pero \w Jehú|strong="H3058"\w* tensó su \w arco|strong="H7198"\w* con todas sus fuerzas y le disparó \w a|strong="H3068"\w* \w Joram|strong="H3088"\w* una flecha \w que|strong="H3027"\w* le entró \w por|strong="H3027"\w* la espalda y le atravesó el \w corazón|strong="H3820"\w*. \w Joram|strong="H3088"\w* cayó \w muerto|strong="H5221"\w* \w en|strong="H3318"\w* su \w carro|strong="H7393"\w*.  
\v 25 \w Entonces|strong="H3588"\w* Jehú \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Bidcar, \w su|strong="H3588"\w* oficial: “\w Levanta|strong="H5375"\w* \w el|strong="H5921"\w* cuerpo \w y|strong="H3588"\w* \w échalo|strong="H7993"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* terreno \w que|strong="H3588"\w* \w era|strong="H2088"\w* \w de|strong="H5921"\w* Nabot \w de|strong="H5921"\w* Jezreel. \w Acuérdate|strong="H2142"\w* \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w cuando|strong="H3588"\w* tú \w y|strong="H3588"\w* \w yo|strong="H3588"\w* íbamos \w juntos|strong="H6776"\w* \w a|strong="H3068"\w* caballo detrás \w de|strong="H5921"\w* \w su|strong="H3588"\w* padre Acab, Yahvé \w pronunció|strong="H5375"\w* \w esta|strong="H2088"\w* sentencia \w contra|strong="H5921"\w* \w él|strong="H5921"\w*:  
\v 26 ‘Tan \w cierto|strong="H3808"\w* como \w que|strong="H3808"\w* ayer \w vi|strong="H7200"\w* \w la|strong="H2063"\w* \w sangre|strong="H1818"\w* \w de|strong="H1121"\w* Nabot y \w de|strong="H1121"\w* sus \w hijos|strong="H1121"\w*, \w dice|strong="H5002"\w* Yahvé, \w que|strong="H3808"\w* te \w lo|strong="H1697"\w* \w pagaré|strong="H7999"\w* en \w este|strong="H2063"\w* mismo terreno’. \w Así|strong="H2063"\w* \w que|strong="H3808"\w* levántalo y \w échalo|strong="H7993"\w* allí, \w tal|strong="H1697"\w* como Yahvé \w lo|strong="H1697"\w* advirtió”.   
\p
\v 27 \w Cuando|strong="H1571"\w* Ocozías \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w* \w vio|strong="H7200"\w* lo \w que|strong="H1571"\w* pasaba, \w huyó|strong="H5127"\w* \w hacia|strong="H1870"\w* \w la|strong="H1571"\w* \w casa|strong="H1004"\w* del jardín. \w Jehú|strong="H3058"\w* lo \w persiguió|strong="H7291"\w* gritando: “¡Maten \w también|strong="H1571"\w* \w a|strong="H3068"\w* ese!” Le dispararon \w en|strong="H5221"\w* su \w carro|strong="H4818"\w* \w en|strong="H5221"\w* \w la|strong="H1571"\w* subida de Gur, cerca de Ibleam, pero \w él|strong="H1571"\w* logró llegar hasta Meguido \w y|strong="H1571"\w* \w allí|strong="H8033"\w* \w murió|strong="H4191"\w*.  
\v 28 Sus oficiales llevaron \w el|strong="H5973"\w* cuerpo \w en|strong="H5973"\w* un \w carro|strong="H7392"\w* \w a|strong="H3068"\w* Jerusalén y lo \w sepultaron|strong="H6912"\w* \w con|strong="H5973"\w* sus antepasados \w en|strong="H5973"\w* la \w Ciudad|strong="H5892"\w* \w de|strong="H5973"\w* \w David|strong="H1732"\w*.  
\v 29 Ocozías había comenzado \w a|strong="H3068"\w* reinar \w en|strong="H5921"\w* \w Judá|strong="H3063"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* once \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* \w Joram|strong="H3141"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Acab.   
\p
\v 30 Cuando \w Jehú|strong="H3058"\w* llegó \w a|strong="H3068"\w* \w Jezreel|strong="H3157"\w*, Jezabel se enteró. Entonces se pintó los \w ojos|strong="H5869"\w*, se arregló el cabello y se asomó \w por|strong="H1157"\w* la ventana.  
\v 31 Al entrar \w Jehú|strong="H3058"\w* por la \w puerta|strong="H8179"\w* de la ciudad, ella le gritó: “¿Cómo te \w va|strong="H3068"\w*, \w Zimri|strong="H2174"\w*, asesino de tu señor?”  
\v 32 Jehú \w levantó|strong="H5375"\w* la vista \w hacia|strong="H6440"\w* la ventana y gritó: “¿\w Quién|strong="H4310"\w* está \w de|strong="H6440"\w* \w mi|strong="H5375"\w* parte? ¿\w Quién|strong="H4310"\w*?”  
\p \w Dos|strong="H8147"\w* \w o|strong="H3068"\w* \w tres|strong="H7969"\w* oficiales se asomaron para verlo.   
\p
\v 33 “¡Échenla abajo!”, ordenó Jehú.  
\p Ellos la arrojaron por la ventana, y su \w sangre|strong="H1818"\w* \w salpicó|strong="H5137"\w* la \w pared|strong="H7023"\w* y \w a|strong="H3068"\w* los \w caballos|strong="H5483"\w*; y Jehú le pasó encima con su carro.  
\v 34 \w Luego|strong="H4994"\w* Jehú entró, comió \w y|strong="H3588"\w* \w bebió|strong="H8354"\w*, \w y|strong="H3588"\w* después dijo: “Vayan \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w esa|strong="H1931"\w* mujer maldita \w y|strong="H3588"\w* entiérrenla; \w al|strong="H4428"\w* fin \w y|strong="H3588"\w* \w al|strong="H4428"\w* cabo \w era|strong="H1931"\w* \w hija|strong="H1323"\w* \w de|strong="H3588"\w* un \w rey|strong="H4428"\w*”.   
\p
\v 35 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* enterrarla, solo encontraron \w el|strong="H3588"\w* cráneo, \w los|strong="H3588"\w* \w pies|strong="H7272"\w* \w y|strong="H3588"\w* las \w palmas|strong="H3709"\w* \w de|strong="H3588"\w* las \w manos|strong="H3027"\w*.  
\v 36 \w Cuando|strong="H5650"\w* regresaron para informarle \w a|strong="H3068"\w* Jehú, \w él|strong="H1931"\w* comentó: “\w Esto|strong="H1697"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* Yahvé \w dijo|strong="H1696"\w* \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H1697"\w* \w su|strong="H1931"\w* \w siervo|strong="H5650"\w* Elías \w el|strong="H1931"\w* \w de|strong="H1697"\w* Tisbe: ‘En \w el|strong="H1931"\w* campo \w de|strong="H1697"\w* \w Jezreel|strong="H3157"\w* \w los|strong="H1931"\w* \w perros|strong="H3611"\w* \w se|strong="H1931"\w* comerán \w la|strong="H1931"\w* \w carne|strong="H1320"\w* \w de|strong="H1697"\w* Jezabel.  
\v 37 Sus restos quedarán esparcidos \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* \w como|strong="H1961"\w* estiércol, \w de|strong="H5921"\w* modo \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* pueda decir: \w Esta|strong="H2063"\w* \w es|strong="H1961"\w* Jezabel’”.   
\c 10  
\p
\v 1 Acab tenía \w setenta|strong="H7657"\w* \w hijos|strong="H1121"\w* en \w Samaria|strong="H8111"\w*. \w Por|strong="H3789"\w* eso \w Jehú|strong="H3058"\w* \w escribió|strong="H3789"\w* \w cartas|strong="H5612"\w* y las \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H1121"\w* \w Jezreel|strong="H3157"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* tutores \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Acab, diciendo:  
\v 2 “En cuanto reciban \w esta|strong="H2088"\w* \w carta|strong="H5612"\w*, \w ya|strong="H2088"\w* \w que|strong="H6258"\w* tienen con ustedes \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* su señor, y cuentan con \w carros|strong="H7393"\w*, \w caballos|strong="H5483"\w*, una \w ciudad|strong="H5892"\w* fortificada y \w armas|strong="H5402"\w*,  
