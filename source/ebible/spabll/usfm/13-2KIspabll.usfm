\p
\v 28 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Josías|strong="H2977"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 29 Durante su \w reinado|strong="H4428"\w*, \w el|strong="H5921"\w* faraón Necao, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, marchó \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w* \w para|strong="H5921"\w* ayudar \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w Josías|strong="H2977"\w* \w salió|strong="H5927"\w* \w a|strong="H3068"\w* enfrentarlo, pero \w el|strong="H5921"\w* faraón \w lo|strong="H5921"\w* \w mató|strong="H4191"\w* \w en|strong="H5921"\w* Meguido \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w lo|strong="H5921"\w* \w vio|strong="H7200"\w*.  
\v 30 Sus oficiales \w llevaron|strong="H3947"\w* \w el|strong="H1121"\w* cuerpo \w en|strong="H6912"\w* un \w carro|strong="H7392"\w* desde Meguido hasta Jerusalén, y lo \w sepultaron|strong="H6912"\w* \w en|strong="H6912"\w* su propia tumba. Entonces la \w gente|strong="H5971"\w* del país \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* Joacaz \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Josías|strong="H2977"\w*, lo \w ungieron|strong="H4886"\w* y lo proclamaron \w rey|strong="H4427"\w* \w en|strong="H6912"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su padre.   
\p
\v 31 Joacaz tenía \w veintitrés|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w tres|strong="H7969"\w* \w meses|strong="H2320"\w*. Su madre se \w llamaba|strong="H8034"\w* \w Hamutal|strong="H2537"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w Jeremías|strong="H3414"\w*, \w de|strong="H1121"\w* la ciudad \w de|strong="H1121"\w* \w Libna|strong="H3841"\w*.  
\v 32 Pero \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* ofende \w a|strong="H3068"\w* Yahvé, siguiendo \w el|strong="H3605"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* sus antepasados.  
\v 33 \w El|strong="H5921"\w* faraón Necao \w lo|strong="H5921"\w* \w puso|strong="H5414"\w* preso \w en|strong="H5921"\w* Ribla, \w en|strong="H5921"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* Hamat, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w no|strong="H5921"\w* \w reinara|strong="H4427"\w* \w en|strong="H5921"\w* Jerusalén, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w impuso|strong="H5414"\w* \w al|strong="H5921"\w* país un tributo \w de|strong="H5921"\w* tres \w mil|strong="H3967"\w* trescientos kilos \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* treinta \w y|strong="H5921"\w* tres kilos\f + \fr 23:33 \ft Un talento es de unos 30 kilogramos o 66 libras o 965 onzas troyanas\f* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.  
\v 34 Además, \w el|strong="H1121"\w* faraón Necao nombró \w rey|strong="H4427"\w* \w a|strong="H3068"\w* Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Josías|strong="H2977"\w*, \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* su padre \w Josías|strong="H2977"\w*, y le cambió \w el|strong="H1121"\w* \w nombre|strong="H8034"\w* \w por|strong="H8478"\w* \w el|strong="H1121"\w* \w de|strong="H8478"\w* \w Joacim|strong="H3079"\w*. \w A|strong="H3068"\w* Joacaz se lo \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, y \w allá|strong="H8033"\w* \w murió|strong="H4191"\w*.  
\v 35 \w Joacim|strong="H3079"\w* \w le|strong="H5921"\w* \w pagó|strong="H5414"\w* \w al|strong="H5921"\w* \w faraón|strong="H6547"\w* \w el|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w plata|strong="H3701"\w*, pero \w para|strong="H5921"\w* hacerlo tuvo \w que|strong="H5921"\w* cobrarle impuestos \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w según|strong="H5921"\w* \w las|strong="H5921"\w* órdenes \w del|strong="H5921"\w* \w faraón|strong="H6547"\w*. \w Le|strong="H5921"\w* exigió \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w la|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w oro|strong="H2091"\w*, \w a|strong="H3068"\w* cada uno \w según|strong="H5921"\w* sus posibilidades, \w para|strong="H5921"\w* entregárselo \w al|strong="H5921"\w* \w faraón|strong="H6547"\w* Necao.  
\v 36 \w Joacim|strong="H3079"\w* tenía \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó \w en|strong="H4480"\w* Jerusalén once \w años|strong="H8141"\w*. Su madre \w se|strong="H4480"\w* \w llamaba|strong="H8034"\w* Zebuda \w hija|strong="H1323"\w* \w de|strong="H4480"\w* Pedaías, \w de|strong="H4480"\w* \w Ruma|strong="H7316"\w*.  
\v 37 Pero \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* ofende \w a|strong="H3068"\w* Yahvé, siguiendo \w el|strong="H3605"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* sus antepasados.   
\c 24  
\p
\v 1 Durante su \w reinado|strong="H4428"\w*, \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* de Babilonia, invadió el país, y \w Joacim|strong="H3079"\w* \w se|strong="H1961"\w* convirtió en su vasallo durante \w tres|strong="H7969"\w* \w años|strong="H8141"\w*. Pero \w después|strong="H1961"\w* \w Joacim|strong="H3079"\w* cambió de parecer y \w se|strong="H1961"\w* rebeló \w contra|strong="H1961"\w* él.  
\v 2 Entonces Yahvé \w envió|strong="H7971"\w* contra \w Judá|strong="H3063"\w* bandas \w de|strong="H1121"\w* \w caldeos|strong="H3778"\w*, sirios, moabitas y amonitas para destruirla, \w tal|strong="H1697"\w* como Yahvé \w lo|strong="H1697"\w* había anunciado \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* sus \w siervos|strong="H5650"\w* \w los|strong="H1121"\w* \w profetas|strong="H5030"\w*.  
\v 3 \w No|strong="H6213"\w* \w hay|strong="H1961"\w* duda \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w esto|strong="H6213"\w* \w le|strong="H5921"\w* \w sucedió|strong="H1961"\w* \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w por|strong="H5921"\w* orden \w de|strong="H5921"\w* Yahvé, \w para|strong="H5921"\w* quitarlos \w de|strong="H5921"\w* su \w presencia|strong="H6440"\w* \w por|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w que|strong="H5921"\w* \w cometió|strong="H6213"\w* \w Manasés|strong="H4519"\w*,  
\v 4 \w y|strong="H1571"\w* \w también|strong="H1571"\w* por toda \w la|strong="H1571"\w* \w sangre|strong="H1818"\w* \w inocente|strong="H5355"\w* \w que|strong="H3808"\w* \w derramó|strong="H8210"\w*; \w pues|strong="H1571"\w* \w llenó|strong="H4390"\w* \w a|strong="H3068"\w* Jerusalén \w de|strong="H1818"\w* víctimas inocentes, \w y|strong="H1571"\w* Yahvé \w no|strong="H3808"\w* quiso \w perdonar|strong="H5545"\w*.  
\v 5 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Joacim|strong="H3079"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 6 Cuando \w Joacim|strong="H3079"\w* murió, fue sepultado \w con|strong="H5973"\w* sus antepasados, y su \w hijo|strong="H1121"\w* Joaquín \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 7 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w no|strong="H3808"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w salir|strong="H3318"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* país, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia \w se|strong="H1961"\w* apoderó \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w le|strong="H3254"\w* pertenecía, \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w torrente|strong="H5158"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w*.   
\p
\v 8 Joaquín tenía \w dieciocho|strong="H8083"\w* \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w tres|strong="H7969"\w* \w meses|strong="H2320"\w*. Su madre se \w llamaba|strong="H8034"\w* Nehusta \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Elnatán, \w de|strong="H1121"\w* Jerusalén.  
\v 9 Pero Joaquín \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* ofende \w a|strong="H3068"\w* Yahvé, siguiendo \w el|strong="H3605"\w* \w mal|strong="H7451"\w* ejemplo \w de|strong="H5869"\w* su padre.  
\v 10 En \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w los|strong="H1931"\w* oficiales \w de|strong="H6256"\w* \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H6256"\w* Babilonia, marcharon contra Jerusalén y \w la|strong="H1931"\w* sitiaron.  
\v 11 Mientras sus oficiales rodeaban \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w Nabucodonosor|strong="H5019"\w* mismo llegó \w a|strong="H3068"\w* Jerusalén.  
\v 12 Entonces Joaquín, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w se|strong="H1931"\w* rindió ante \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w su|strong="H1931"\w* madre, \w sus|strong="H1931"\w* oficiales, \w sus|strong="H1931"\w* líderes \w y|strong="H5921"\w* \w sus|strong="H1931"\w* consejeros. \w El|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w lo|strong="H1931"\w* \w tomó|strong="H3947"\w* prisionero \w en|strong="H5921"\w* \w el|strong="H1931"\w* octavo \w año|strong="H8141"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w reinado|strong="H4427"\w*.  
\v 13 Tal como Yahvé \w lo|strong="H6213"\w* \w había|strong="H6213"\w* advertido, Nabucodonosor se llevó \w todos|strong="H3605"\w* \w los|strong="H3605"\w* tesoros del \w templo|strong="H1964"\w* de Yahvé y \w los|strong="H3605"\w* del palacio \w real|strong="H4428"\w*, y rompió \w todos|strong="H3605"\w* \w los|strong="H3605"\w* objetos de \w oro|strong="H2091"\w* \w que|strong="H3605"\w* \w Salomón|strong="H8010"\w*, \w rey|strong="H4428"\w* de \w Israel|strong="H3478"\w*, \w había|strong="H6213"\w* fabricado para \w el|strong="H3605"\w* \w templo|strong="H1964"\w*.  
\v 14 \w Se|strong="H3808"\w* llevó al \w cautiverio|strong="H1473"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* Jerusalén: \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes, \w a|strong="H3068"\w* \w los|strong="H3605"\w* mejores soldados y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* artesanos y herreros; en total \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* \w cautivos|strong="H1473"\w*. \w No|strong="H3808"\w* \w quedó|strong="H7604"\w* \w nadie|strong="H3808"\w* en \w el|strong="H3605"\w* país, \w excepto|strong="H2108"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w más|strong="H3808"\w* pobre.  
\v 15 Nabucodonosor se llevó \w a|strong="H3068"\w* Joaquín \w a|strong="H3068"\w* Babilonia, junto con la madre del \w rey|strong="H4428"\w*, sus esposas, sus oficiales y los hombres más importantes del país. Los llevó desterrados de Jerusalén \w a|strong="H3068"\w* Babilonia.  
\v 16 \w El|strong="H3605"\w* \w rey|strong="H4428"\w* de Babilonia también deportó \w a|strong="H3068"\w* \w siete|strong="H7651"\w* mil \w hombres|strong="H1368"\w* de \w guerra|strong="H4421"\w*, y \w a|strong="H3068"\w* mil artesanos y herreros, \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* \w hombres|strong="H1368"\w* \w fuertes|strong="H2428"\w* y aptos para \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*.  
\v 17 \w En|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* Joaquín, el \w rey|strong="H4428"\w* \w de|strong="H8478"\w* Babilonia nombró \w como|strong="H8478"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* su \w tío|strong="H1730"\w* Matanías, y le cambió el \w nombre|strong="H8034"\w* \w por|strong="H8478"\w* el \w de|strong="H8478"\w* Sedequías.   
\p
\v 18 Sedequías tenía veintiún \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén once \w años|strong="H8141"\w*. Su madre se \w llamaba|strong="H8034"\w* \w Hamutal|strong="H2537"\w* \w hija|strong="H1323"\w* \w de|strong="H1121"\w* \w Jeremías|strong="H3414"\w*, \w de|strong="H1121"\w* \w Libna|strong="H3841"\w*.  
\v 19 Sedequías \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* ofende \w a|strong="H3068"\w* Yahvé, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w Joacim|strong="H3079"\w*.  
\v 20 Todo esto \w sucedió|strong="H1961"\w* \w en|strong="H5921"\w* Jerusalén \w y|strong="H3588"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w* \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w por|strong="H5921"\w* fin \w los|strong="H5921"\w* arrojó lejos \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w presencia|strong="H6440"\w*.  
\p Tiempo \w después|strong="H5921"\w*, Sedequías \w se|strong="H1961"\w* rebeló \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia.   
\c 25  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H1931"\w* día diez \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w décimo|strong="H6224"\w* \w del|strong="H5921"\w* \w noveno|strong="H8671"\w* \w año|strong="H8141"\w* \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Sedequías, \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, marchó \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w su|strong="H1931"\w* \w ejército|strong="H2428"\w* \w contra|strong="H5921"\w* Jerusalén. Acampó frente \w a|strong="H3068"\w* \w la|strong="H1931"\w* ciudad \w y|strong="H5921"\w* levantó rampas \w de|strong="H5921"\w* asalto \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w alrededor|strong="H5439"\w*.  
\v 2 La \w ciudad|strong="H5892"\w* estuvo bajo sitio \w hasta|strong="H5704"\w* el \w año|strong="H8141"\w* \w once|strong="H6249"\w* del \w rey|strong="H4428"\w* Sedequías.  
\v 3 \w Para|strong="H1961"\w* el día \w nueve|strong="H8672"\w* del \w mes|strong="H2320"\w* cuarto, el \w hambre|strong="H7458"\w* en la \w ciudad|strong="H5892"\w* \w era|strong="H1961"\w* tan terrible \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* \w había|strong="H1961"\w* \w nada|strong="H3808"\w* \w que|strong="H3808"\w* comer \w para|strong="H1961"\w* la \w gente|strong="H5971"\w* del país.  
\v 4 Entonces \w abrieron|strong="H1234"\w* una brecha \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w muro|strong="H2346"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* soldados huyeron \w de|strong="H5921"\w* \w noche|strong="H3915"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w que|strong="H5921"\w* estaba \w entre|strong="H5921"\w* \w los|strong="H5921"\w* dos \w muros|strong="H2346"\w*, \w cerca|strong="H5921"\w* \w del|strong="H5921"\w* jardín \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, aunque \w los|strong="H5921"\w* \w caldeos|strong="H3778"\w* tenían rodeada \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* escapó \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w del|strong="H5921"\w* Arabá.  
\v 5 Pero \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* caldeo \w persiguió|strong="H7291"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w alcanzó|strong="H5381"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* llanuras \w de|strong="H5921"\w* \w Jericó|strong="H3405"\w*, \w mientras|strong="H3605"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H2428"\w* \w se|strong="H5921"\w* dispersaba.  
\v 6 Capturaron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* y lo llevaron ante el \w rey|strong="H4428"\w* de Babilonia, en Ribla, donde le dictaron \w sentencia|strong="H4941"\w*.  
\v 7 \w Mataron|strong="H7819"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Sedequías en su propia presencia, y luego \w a|strong="H3068"\w* \w él|strong="H1121"\w* \w le|strong="H5869"\w* \w sacaron|strong="H5786"\w* \w los|strong="H1121"\w* \w ojos|strong="H5869"\w*, lo ataron con cadenas \w de|strong="H1121"\w* bronce y se lo llevaron \w a|strong="H3068"\w* Babilonia.   
\p
\v 8 \w El|strong="H1931"\w* día \w siete|strong="H7651"\w* del \w mes|strong="H2320"\w* \w quinto|strong="H2549"\w* del \w año|strong="H8141"\w* \w diecinueve|strong="H8672"\w* del \w reinado|strong="H4428"\w* de \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* de Babilonia, llegó \w a|strong="H3068"\w* Jerusalén \w Nabuzaradán|strong="H5018"\w*, comandante de \w la|strong="H1931"\w* guardia y oficial del \w rey|strong="H4428"\w* de Babilonia.  
\v 9 Incendió \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé, \w el|strong="H3605"\w* palacio \w real|strong="H4428"\w* y \w todas|strong="H3605"\w* las \w casas|strong="H1004"\w* de Jerusalén; prendió fuego \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w casas|strong="H1004"\w* de \w la|strong="H3605"\w* gente importante.  
\v 10 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w ejército|strong="H2428"\w* caldeo, bajo \w el|strong="H3605"\w* mando del comandante de \w la|strong="H3605"\w* guardia, \w derribó|strong="H5422"\w* las murallas \w que|strong="H3605"\w* rodeaban Jerusalén.  
\v 11 \w Nabuzaradán|strong="H5018"\w*, comandante \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia, \w se|strong="H5921"\w* llevó \w al|strong="H5921"\w* destierro \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H5921"\w* aún quedaba \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* habían rendido ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w resto|strong="H3499"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* población.  
\v 12 Sin embargo, el comandante \w dejó|strong="H7604"\w* en el país \w a|strong="H3068"\w* la gente \w más|strong="H7227"\w* pobre para que trabajaran en los viñedos y en los campos.   
\p
\v 13 Los \w caldeos|strong="H3778"\w* destrozaron las \w columnas|strong="H5982"\w* de bronce que estaban en el \w templo|strong="H1004"\w* de Yahvé, así como los pedestales y el gran tanque de bronce que había en el \w templo|strong="H1004"\w*, y se \w llevaron|strong="H5375"\w* todo el bronce \w a|strong="H3068"\w* Babilonia.  
\v 14 También se \w llevaron|strong="H3947"\w* las ollas, las palas, las tenazas, las \w cucharas|strong="H3709"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios de bronce \w que|strong="H3605"\w* se usaban en \w el|strong="H3605"\w* servicio del templo.  
\v 15 El comandante de la guardia se \w llevó|strong="H3947"\w* además los \w incensarios|strong="H4289"\w* y los \w tazones|strong="H4219"\w*; todo lo que era de \w oro|strong="H2091"\w* puro y de \w plata|strong="H3701"\w* pura.  
\v 16 \w El|strong="H3605"\w* bronce de las \w dos|strong="H8147"\w* \w columnas|strong="H5982"\w*, del tanque de bronce y de \w los|strong="H3605"\w* pedestales \w que|strong="H3808"\w* \w Salomón|strong="H8010"\w* \w había|strong="H1961"\w* \w hecho|strong="H6213"\w* \w para|strong="H4948"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé, \w era|strong="H1961"\w* tanto \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w podía|strong="H3808"\w* pesar.  
\v 17 \w Cada|strong="H3605"\w* \w columna|strong="H5982"\w* medía \w ocho|strong="H8083"\w* metros\f + \fr 25:17 \ft Un codo es la longitud desde la punta del dedo corazón hasta el codo del brazo de un hombre, es decir, unas 18 pulgadas o 46 centímetros.\f* \w de|strong="H5921"\w* \w altura|strong="H6967"\w*. \w El|strong="H5921"\w* \w capitel|strong="H3805"\w* \w que|strong="H5921"\w* tenía \w encima|strong="H5921"\w* era \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* medía un metro \w y|strong="H5921"\w* medio \w de|strong="H5921"\w* alto; estaba decorado \w alrededor|strong="H5439"\w* \w con|strong="H5921"\w* una red \w y|strong="H5921"\w* figuras \w de|strong="H5921"\w* \w granadas|strong="H7416"\w*, \w todo|strong="H3605"\w* \w de|strong="H5921"\w* bronce. \w La|strong="H5921"\w* \w otra|strong="H8145"\w* \w columna|strong="H5982"\w* era igual \w y|strong="H5921"\w* tenía \w el|strong="H5921"\w* \w mismo|strong="H3605"\w* diseño \w de|strong="H5921"\w* red.   
\p
\v 18 El comandante de \w la|strong="H8104"\w* guardia \w tomó|strong="H3947"\w* prisioneros \w a|strong="H3068"\w* \w Seraías|strong="H8304"\w*, el \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w*, \w a|strong="H3068"\w* \w Sofonías|strong="H6846"\w*, el \w segundo|strong="H4932"\w* \w sacerdote|strong="H3548"\w*, y \w a|strong="H3068"\w* los \w tres|strong="H7969"\w* guardianes de \w la|strong="H8104"\w* puerta.  
\v 19 \w De|strong="H4480"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w se|strong="H1931"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* un oficial \w que|strong="H4480"\w* estaba \w al|strong="H5921"\w* mando \w de|strong="H4480"\w* \w los|strong="H5921"\w* soldados, \w a|strong="H3068"\w* \w cinco|strong="H2568"\w* consejeros personales \w del|strong="H4480"\w* \w rey|strong="H4428"\w* \w que|strong="H4480"\w* aún \w estaban|strong="H5971"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*, \w al|strong="H5921"\w* \w secretario|strong="H5608"\w* \w del|strong="H4480"\w* \w comandante|strong="H8269"\w* \w del|strong="H4480"\w* \w ejército|strong="H6635"\w* —encargado \w de|strong="H4480"\w* reclutar \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w del|strong="H4480"\w* país— \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w sesenta|strong="H8346"\w* ciudadanos comunes \w que|strong="H4480"\w* \w estaban|strong="H5971"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*.  
\v 20 \w Nabuzaradán|strong="H5018"\w*, \w el|strong="H5921"\w* comandante \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia, \w los|strong="H5921"\w* \w llevó|strong="H3947"\w* ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia \w en|strong="H5921"\w* Ribla.  
\v 21 Allí, \w en|strong="H5921"\w* Ribla, \w en|strong="H5921"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* Hamat, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia mandó \w que|strong="H5921"\w* \w los|strong="H5921"\w* ejecutaran. Así \w fue|strong="H1540"\w* \w como|strong="H5921"\w* \w la|strong="H5921"\w* gente \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w fue|strong="H1540"\w* deportada lejos \w de|strong="H5921"\w* su tierra.   
\p
\v 22 \w Nabucodonosor|strong="H5019"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia, nombró \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahicam \w y|strong="H5921"\w* \w nieto|strong="H1121"\w* \w de|strong="H5921"\w* Safán \w como|strong="H5921"\w* gobernador \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H5921"\w* permitió \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w quedara|strong="H7604"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 23 \w Cuando|strong="H3588"\w* \w los|strong="H1992"\w* \w capitanes|strong="H8269"\w* \w de|strong="H3588"\w* \w las|strong="H1992"\w* tropas \w y|strong="H3588"\w* \w sus|strong="H1992"\w* \w hombres|strong="H1121"\w* \w se|strong="H1992"\w* enteraron \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia \w había|strong="H3588"\w* nombrado \w gobernador|strong="H8269"\w* \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w*, fueron \w a|strong="H3068"\w* verlo \w a|strong="H3068"\w* \w Mizpa|strong="H4709"\w*. \w Estos|strong="H1992"\w* eran: \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Netanías, \w Johanán|strong="H3110"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Carea|strong="H7143"\w*, \w Seraías|strong="H8304"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Tanhumet \w el|strong="H3588"\w* \w netofatita|strong="H5200"\w*, \w y|strong="H3588"\w* Jaazanías \w hijo|strong="H1121"\w* del maacateo, junto \w con|strong="H3588"\w* \w sus|strong="H1992"\w* \w hombres|strong="H1121"\w*.  
\v 24 \w Gedalías|strong="H1436"\w* les hizo un juramento \w a|strong="H3068"\w* ellos y \w a|strong="H3068"\w* sus hombres: “No tengan \w miedo|strong="H3372"\w* \w de|strong="H3372"\w* \w los|strong="H3427"\w* oficiales \w caldeos|strong="H3778"\w*. Quédense en \w el|strong="H3427"\w* país y sirvan \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3372"\w* Babilonia, y les irá \w bien|strong="H3190"\w*”.   
\p
\v 25 Pero \w en|strong="H5221"\w* \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, \w Ismael|strong="H3458"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Netanías y \w nieto|strong="H1121"\w* \w de|strong="H1121"\w* Elisama, \w que|strong="H1121"\w* \w era|strong="H1961"\w* \w de|strong="H1121"\w* la familia \w real|strong="H4410"\w*, \w fue|strong="H1961"\w* \w a|strong="H3068"\w* \w Mizpa|strong="H4709"\w* con \w diez|strong="H6235"\w* \w hombres|strong="H1121"\w* y asesinó \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w*, y también \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w judíos|strong="H3064"\w* y \w caldeos|strong="H3778"\w* \w que|strong="H1121"\w* \w estaban|strong="H1961"\w* con \w él|strong="H1121"\w*.  
\v 26 \w Entonces|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w más|strong="H3588"\w* \w grande|strong="H1419"\w*, \w junto|strong="H5971"\w* \w con|strong="H3588"\w* \w los|strong="H3605"\w* \w capitanes|strong="H8269"\w* \w de|strong="H3588"\w* las tropas, huyeron \w hacia|strong="H6440"\w* \w Egipto|strong="H4714"\w* \w por|strong="H3588"\w* \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w caldeos|strong="H3778"\w*.  
\v 27 El día \w veintisiete|strong="H6242"\w* del \w mes|strong="H2320"\w* \w doce|strong="H8147"\w* del \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* y \w siete|strong="H7651"\w* del exilio de Joaquín, \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w*, Evil Merodac, \w rey|strong="H4428"\w* de Babilonia, en el \w año|strong="H8141"\w* \w que|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, le perdonó la vida \w a|strong="H3068"\w* Joaquín y lo sacó de la cárcel.  
\v 28 \w Lo|strong="H5921"\w* \w trató|strong="H5414"\w* \w con|strong="H5921"\w* mucha amabilidad \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w dio|strong="H5414"\w* un lugar \w de|strong="H5921"\w* honor \w más|strong="H5921"\w* alto \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* otros \w reyes|strong="H4428"\w* \w que|strong="H5921"\w* estaban \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* Babilonia.  
\v 29 Le permitió quitarse \w la|strong="H3605"\w* ropa \w de|strong="H6440"\w* prisión, y Joaquín comió \w a|strong="H3068"\w* \w la|strong="H3605"\w* mesa del rey \w por|strong="H6440"\w* \w el|strong="H3605"\w* resto \w de|strong="H6440"\w* su \w vida|strong="H2416"\w*.  
\v 30 \w Mientras|strong="H3605"\w* \w vivió|strong="H3117"\w*, Joaquín recibió del \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Babilonia una \w ración|strong="H1697"\w* \w diaria|strong="H3117"\w* \w de|strong="H1697"\w* comida \w para|strong="H5414"\w* su sustento personal.   