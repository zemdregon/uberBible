\v 30 Entonces \w Oseas|strong="H1954"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ela \w conspiró|strong="H7194"\w* \w contra|strong="H5921"\w* \w Peka|strong="H6492"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Remalías; \w lo|strong="H5921"\w* atacó \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w mató|strong="H5221"\w*. \w Oseas|strong="H1954"\w* comenzó \w a|strong="H3068"\w* reinar \w en|strong="H5921"\w* su \w lugar|strong="H8478"\w* durante \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w veinte|strong="H6242"\w* \w del|strong="H5921"\w* \w reinado|strong="H4427"\w* \w de|strong="H5921"\w* Jotam \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Uzías.  
\v 31 \w Los|strong="H5921"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Peka|strong="H6492"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w hizo|strong="H6213"\w* \w están|strong="H2009"\w* \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 32 Jotam \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Uzías comenzó \w a|strong="H3068"\w* reinar en \w Judá|strong="H3063"\w* durante \w el|strong="H1121"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* del \w reinado|strong="H4427"\w* \w de|strong="H1121"\w* \w Peka|strong="H6492"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Remalías en \w Israel|strong="H3478"\w*.  
\v 33 \w Tenía|strong="H1961"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y gobernó en Jerusalén \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w*. Su madre \w era|strong="H1961"\w* Jerusa, \w hija|strong="H1323"\w* \w de|strong="H2568"\w* \w Sadoc|strong="H6659"\w*.  
\v 34 Jotam \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w le|strong="H5869"\w* agrada \w a|strong="H3068"\w* Yahvé, tal como \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* su padre Uzías.  
\v 35 \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w se|strong="H1931"\w* \w quitaron|strong="H5493"\w* \w los|strong="H1931"\w* santuarios paganos, y \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* seguía \w ofreciendo|strong="H2076"\w* \w sacrificios|strong="H2076"\w* y quemando incienso \w en|strong="H5493"\w* \w ellos|strong="H1931"\w*. Jotam \w fue|strong="H1931"\w* \w quien|strong="H1931"\w* construyó \w la|strong="H1931"\w* \w puerta|strong="H8179"\w* superior del \w templo|strong="H1004"\w* \w de|strong="H5750"\w* Yahvé.  
\v 36 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Jotam \w y|strong="H5921"\w* todo \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
