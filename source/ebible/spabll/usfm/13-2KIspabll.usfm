\v 29 \w Sin|strong="H3808"\w* embargo, \w Jehú|strong="H3058"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartó \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w pecados|strong="H2399"\w* con \w los|strong="H1121"\w* \w que|strong="H3808"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w* hizo \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, es decir, del culto \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w becerros|strong="H5695"\w* \w de|strong="H1121"\w* \w oro|strong="H2091"\w* \w que|strong="H3808"\w* estaban \w en|strong="H5493"\w* Betel y \w en|strong="H5493"\w* \w Dan|strong="H1835"\w*.  
\v 30 \w Por|strong="H5921"\w* eso Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Jehú|strong="H3058"\w*: “Has \w hecho|strong="H6213"\w* \w bien|strong="H2895"\w* \w en|strong="H5921"\w* cumplir \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* agrada \w y|strong="H5921"\w* \w en|strong="H5921"\w* tratar \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* Acab tal \w como|strong="H5921"\w* \w yo|strong="H6213"\w* quería. \w Por|strong="H5921"\w* eso, tus descendientes ocuparán \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* cuarta generación”.   
\p
\v 31 Pero \w Jehú|strong="H3058"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* esforzó \w por|strong="H5921"\w* seguir \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su \w corazón|strong="H3824"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w ni|strong="H3808"\w* \w se|strong="H5921"\w* apartó \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pecados|strong="H2403"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w Jeroboam|strong="H3379"\w* hizo \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.   
\p
\v 32 \w En|strong="H5221"\w* \w aquel|strong="H3605"\w* \w tiempo|strong="H3117"\w*, Yahvé \w comenzó|strong="H2490"\w* \w a|strong="H3068"\w* reducir \w el|strong="H3605"\w* territorio de \w Israel|strong="H3478"\w*. \w Hazael|strong="H2371"\w* \w los|strong="H1992"\w* derrotó \w en|strong="H5221"\w* \w todas|strong="H3605"\w* \w las|strong="H1992"\w* fronteras de \w Israel|strong="H3478"\w*:  
\v 33 \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w Jordán|strong="H3383"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w oriente|strong="H4217"\w*, \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w de|strong="H4480"\w* \w Galaad|strong="H1568"\w*, \w los|strong="H5921"\w* territorios \w de|strong="H4480"\w* \w Gad|strong="H1425"\w*, Rubén \w y|strong="H5921"\w* Manasés, \w desde|strong="H4480"\w* \w Aroer|strong="H6177"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* valle \w del|strong="H4480"\w* Arnón, incluyendo \w Galaad|strong="H1568"\w* \w y|strong="H5921"\w* \w Basán|strong="H1316"\w*.  
\v 34 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Jehú|strong="H3058"\w*, \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* \w y|strong="H5921"\w* \w sus|strong="H1992"\w* hazañas, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 35 Cuando \w Jehú|strong="H3058"\w* murió, fue \w sepultado|strong="H6912"\w* \w en|strong="H5973"\w* \w Samaria|strong="H8111"\w*. Su \w hijo|strong="H1121"\w* Joacaz \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.  
\v 36 \w Jehú|strong="H3058"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* durante \w veintiocho|strong="H6242"\w* \w años|strong="H8141"\w*.   
\c 11  
\p
\v 1 \w Cuando|strong="H3588"\w* \w Atalía|strong="H6271"\w*, \w la|strong="H3588"\w* madre \w de|strong="H3588"\w* Ocozías, se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* \w había|strong="H3588"\w* \w muerto|strong="H4191"\w*, decidió acabar \w con|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* familia \w real|strong="H4467"\w*.  
\v 2 Pero \w Josaba|strong="H3089"\w*, \w que|strong="H3808"\w* \w era|strong="H1121"\w* \w hija|strong="H1323"\w* del \w rey|strong="H4428"\w* \w Joram|strong="H3141"\w* y hermana \w de|strong="H6440"\w* Ocozías, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w Joás|strong="H3101"\w*, \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* pequeño \w de|strong="H6440"\w* Ocozías, y \w lo|strong="H3808"\w* sacó \w a|strong="H3068"\w* escondidas \w de|strong="H6440"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* del \w rey|strong="H4428"\w* \w a|strong="H3068"\w* quienes estaban \w matando|strong="H4191"\w*. \w Lo|strong="H3808"\w* \w escondió|strong="H5641"\w* con su nodriza \w en|strong="H8432"\w* una recámara, y así lograron ocultarlo \w de|strong="H6440"\w* \w Atalía|strong="H6271"\w* para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w mataran|strong="H4191"\w*.  
\v 3 Joás \w estuvo|strong="H1961"\w* \w escondido|strong="H2244"\w* \w con|strong="H5921"\w* \w ella|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé durante \w seis|strong="H8337"\w* \w años|strong="H8141"\w*, mientras \w Atalía|strong="H6271"\w* \w reinaba|strong="H4427"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* país.   
\p
\v 4 \w Al|strong="H4428"\w* \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w*, \w Joiada|strong="H3077"\w* \w mandó|strong="H7971"\w* llamar \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w capitanes|strong="H8269"\w* \w de|strong="H1121"\w* la guardia y \w de|strong="H1121"\w* \w los|strong="H1992"\w* escoltas, y \w los|strong="H1992"\w* \w hizo|strong="H3772"\w* venir \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé. Allí \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* con \w ellos|strong="H1992"\w*, \w les|strong="H1992"\w* \w tomó|strong="H3947"\w* juramento y \w les|strong="H1992"\w* presentó \w al|strong="H4428"\w* \w hijo|strong="H1121"\w* del \w rey|strong="H4428"\w*.  
\v 5 Entonces \w les|strong="H6680"\w* dio \w estas|strong="H2088"\w* órdenes: “\w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H4480"\w* ustedes deben \w hacer|strong="H6213"\w*: una \w tercera|strong="H7992"\w* parte \w de|strong="H4480"\w* los \w que|strong="H4480"\w* entran \w de|strong="H4480"\w* servicio \w el|strong="H6213"\w* \w sábado|strong="H7676"\w* vigilarán \w el|strong="H6213"\w* palacio \w real|strong="H4428"\w*;  
\v 6 otra \w tercera|strong="H7992"\w* parte estará en \w la|strong="H8104"\w* \w puerta|strong="H8179"\w* de Sur, y \w la|strong="H8104"\w* otra \w tercera|strong="H7992"\w* parte en \w la|strong="H8104"\w* \w puerta|strong="H8179"\w* que está detrás de \w la|strong="H8104"\w* guardia. Así vigilarán el \w templo|strong="H1004"\w* por todos lados.  
\v 7 \w Los|strong="H3605"\w* otros \w dos|strong="H8147"\w* grupos de ustedes, \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w salen|strong="H3318"\w* de servicio \w el|strong="H3605"\w* \w sábado|strong="H7676"\w*, se quedarán \w en|strong="H3318"\w* \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé para proteger \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 8 Rodeen \w al|strong="H5921"\w* \w rey|strong="H4428"\w*, cada uno \w con|strong="H5921"\w* sus \w armas|strong="H3627"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*. \w Si|strong="H1961"\w* alguien intenta acercarse \w a|strong="H3068"\w* \w las|strong="H5921"\w* filas, mátenlo. Deben estar \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H5921"\w* \w él|strong="H5921"\w* vaya”.   
\p
\v 9 \w Los|strong="H3605"\w* \w capitanes|strong="H8269"\w* \w hicieron|strong="H6213"\w* \w todo|strong="H3605"\w* tal \w como|strong="H5973"\w* \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w* \w les|strong="H5973"\w* \w ordenó|strong="H6680"\w*. \w Cada|strong="H3605"\w* uno \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* sus hombres, tanto \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* entraban \w de|strong="H5973"\w* servicio \w el|strong="H5973"\w* \w sábado|strong="H7676"\w* \w como|strong="H5973"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w salían|strong="H3318"\w*, y se presentaron ante \w el|strong="H5973"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w*.  
\v 10 El \w sacerdote|strong="H3548"\w* les \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* los \w capitanes|strong="H8269"\w* las lanzas y los \w escudos|strong="H7982"\w* que habían sido del \w rey|strong="H4428"\w* \w David|strong="H1732"\w* y que estaban guardados en el \w templo|strong="H1004"\w* \w de|strong="H8269"\w* Yahvé.  
\v 11 \w Los|strong="H5921"\w* guardias \w se|strong="H5921"\w* \w pusieron|strong="H5975"\w* \w en|strong="H5921"\w* sus \w puestos|strong="H5975"\w*, cada uno \w con|strong="H5921"\w* sus \w armas|strong="H3627"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w desde|strong="H5704"\w* \w el|strong="H5921"\w* \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w izquierdo|strong="H8042"\w*, rodeando \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w para|strong="H5704"\w* proteger \w al|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 12 Entonces Joiada \w sacó|strong="H3318"\w* \w al|strong="H5921"\w* \w hijo|strong="H1121"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w le|strong="H5921"\w* \w puso|strong="H5414"\w* \w la|strong="H5921"\w* corona \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* una copia \w del|strong="H5921"\w* pacto. Así \w lo|strong="H5921"\w* proclamaron \w rey|strong="H4428"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w ungieron|strong="H4886"\w*; todos aplaudieron \w y|strong="H5921"\w* gritaron: “¡\w Viva|strong="H2421"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*!”   
\p
\v 13 Cuando \w Atalía|strong="H6271"\w* \w oyó|strong="H8085"\w* el alboroto \w que|strong="H5971"\w* hacían los guardias y el \w pueblo|strong="H5971"\w*, fue al \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé, donde \w estaba|strong="H1004"\w* la \w gente|strong="H5971"\w*.  
\v 14 \w Al|strong="H5921"\w* \w mirar|strong="H7200"\w*, \w vio|strong="H7200"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w estaba|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w columna|strong="H5982"\w*, \w como|strong="H5921"\w* era \w la|strong="H5921"\w* \w costumbre|strong="H4941"\w*. \w Los|strong="H5921"\w* \w capitanes|strong="H8269"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* trompetistas \w estaban|strong="H5975"\w* \w a|strong="H3068"\w* su lado, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w estaba|strong="H5975"\w* feliz tocando \w las|strong="H5921"\w* \w trompetas|strong="H2689"\w*. Entonces \w Atalía|strong="H6271"\w* \w se|strong="H5921"\w* \w rasgó|strong="H7167"\w* \w la|strong="H5921"\w* ropa \w y|strong="H5921"\w* \w gritó|strong="H7121"\w*: “¡\w Traición|strong="H7195"\w*! ¡\w Traición|strong="H7195"\w*!”   
\p
\v 15 \w El|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w Joiada|strong="H3077"\w* \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w capitanes|strong="H8269"\w* \w que|strong="H3588"\w* estaban al \w mando|strong="H6680"\w* del \w ejército|strong="H2428"\w*: “Sáquenla \w de|strong="H3588"\w* aquí, \w y|strong="H3588"\w* \w si|strong="H3588"\w* alguien intenta seguirla, mátenlo \w a|strong="H3068"\w* \w espada|strong="H2719"\w*”. \w Y|strong="H3068"\w* \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w no|strong="H3588"\w* quería \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w mataran|strong="H4191"\w* dentro del \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé.  
\v 16 Así \w que|strong="H3027"\w* la atraparon, la llevaron \w por|strong="H1870"\w* el \w camino|strong="H1870"\w* de la \w entrada|strong="H3996"\w* de los \w caballos|strong="H5483"\w* \w hacia|strong="H1870"\w* el palacio, y \w allí|strong="H8033"\w* la \w mataron|strong="H4191"\w*.   
\p
\v 17 \w Después|strong="H1961"\w* \w Joiada|strong="H3077"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* entre Yahvé, el \w rey|strong="H4428"\w* y el \w pueblo|strong="H5971"\w*, \w para|strong="H1961"\w* \w que|strong="H5971"\w* ellos fueran el \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* Yahvé. También \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* entre el \w rey|strong="H4428"\w* y el \w pueblo|strong="H5971"\w*.  
\v 18 Entonces \w todos|strong="H3605"\w* \w los|strong="H5921"\w* habitantes \w del|strong="H5921"\w* país fueron \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Baal|strong="H1168"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* derribaron. Destruyeron \w por|strong="H5921"\w* completo sus \w altares|strong="H4196"\w* \w y|strong="H5921"\w* sus \w imágenes|strong="H6754"\w*, \w y|strong="H5921"\w* \w mataron|strong="H2026"\w* \w a|strong="H3068"\w* Matán, \w el|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w de|strong="H5921"\w* \w Baal|strong="H1168"\w*, frente \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w altares|strong="H4196"\w*. \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Joiada \w puso|strong="H7760"\w* guardias \w para|strong="H5921"\w* cuidar \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 19 \w Luego|strong="H7323"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w capitanes|strong="H8269"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* escoltas, \w a|strong="H3068"\w* \w los|strong="H3427"\w* guardias \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H5921"\w* escoltaron \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* palacio \w real|strong="H4428"\w*, entrando \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia. Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* sentó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w real|strong="H4428"\w*.  
\v 20 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w estaba|strong="H1004"\w* muy alegre y \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* quedó en paz, después \w de|strong="H5971"\w* \w que|strong="H5971"\w* \w mataron|strong="H4191"\w* \w a|strong="H3068"\w* \w Atalía|strong="H6271"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w* en \w el|strong="H3605"\w* palacio.   
\p
\v 21 Joás tenía siete años cuando comenzó \w a|strong="H3068"\w* reinar.   
\c 12  
\p
\v 1 \w Joás|strong="H3060"\w* comenzó \w a|strong="H3068"\w* reinar en \w el|strong="H1121"\w* \w séptimo|strong="H7651"\w* \w año|strong="H8141"\w* \w de|strong="H1121"\w* Jehú, y gobernó en Jerusalén cuarenta \w años|strong="H8141"\w*. Su madre se llamaba Sibía y \w era|strong="H8141"\w* \w de|strong="H1121"\w* Berseba.  
\v 2 Durante toda su vida, \w Joás|strong="H3060"\w* hizo lo \w que|strong="H7651"\w* le agrada \w a|strong="H3068"\w* Yahvé, pues siguió las enseñanzas del sacerdote Joiada.  
\v 3 Sin embargo, \w no|strong="H6213"\w* se quitaron \w los|strong="H3605"\w* santuarios paganos, y \w el|strong="H3605"\w* pueblo seguía ofreciendo sacrificios y quemando incienso en esos lugares \w de|strong="H5869"\w* culto.   
\p
\v 4 Joás les dijo \w a|strong="H3068"\w* los sacerdotes: “Todo el dinero \w de|strong="H5750"\w* las ofrendas sagradas \w que|strong="H3808"\w* \w se|strong="H3808"\w* traiga al templo \w de|strong="H5750"\w* Yahvé —tanto el dinero \w de|strong="H5750"\w* los impuestos personales \w como|strong="H5750"\w* las ofrendas voluntarias \w que|strong="H3808"\w* la \w gente|strong="H5971"\w* decida traer—,  
\v 5 recíbanlo ustedes \w de|strong="H5921"\w* mano \w de|strong="H5921"\w* sus propios tesoreros. Ese \w dinero|strong="H3701"\w* deberá usarse \w para|strong="H5921"\w* reparar \w los|strong="H5921"\w* daños \w que|strong="H5921"\w* tenga \w el|strong="H5921"\w* \w templo|strong="H1004"\w*, dondequiera \w que|strong="H5921"\w* \w se|strong="H5921"\w* encuentren.”   
\p
\v 6 Pero llegó \w el|strong="H3605"\w* año veintitrés del reinado de Joás y \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* todavía no habían reparado \w los|strong="H1992"\w* daños del \w templo|strong="H1004"\w*.  
\v 7 Entonces el \w rey|strong="H4428"\w* \w Joás|strong="H3060"\w* llamó \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* Joiada y \w a|strong="H3068"\w* \w los|strong="H1961"\w* demás \w sacerdotes|strong="H3548"\w*, y les reclamó: “¿\w Por|strong="H4428"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* han reparado \w los|strong="H1961"\w* daños del \w templo|strong="H1004"\w*? De ahora en adelante, ya \w no|strong="H3808"\w* \w se|strong="H1961"\w* queden con el dinero \w que|strong="H3808"\w* reciben de sus donantes; entréguenlo \w para|strong="H1961"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* repare el \w templo|strong="H1004"\w*.”   
\p
\v 8 \w Los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* aceptaron \w no|strong="H3588"\w* \w recibir|strong="H3947"\w* \w más|strong="H3588"\w* \w dinero|strong="H3701"\w* directamente del pueblo \w y|strong="H3588"\w* también renunciaron \w a|strong="H3068"\w* encargarse \w de|strong="H3588"\w* las reparaciones.  
\v 9 Entonces el \w sacerdote|strong="H3548"\w* Joiada \w tomó|strong="H3947"\w* un cofre, le hizo una ranura en la tapa y lo puso al lado derecho del altar, según \w se|strong="H5971"\w* entra al \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Yahvé. Los \w sacerdotes|strong="H3548"\w* \w que|strong="H5971"\w* cuidaban la entrada ponían en el cofre todo el \w dinero|strong="H3701"\w* \w que|strong="H5971"\w* la \w gente|strong="H5971"\w* traía al \w templo|strong="H1004"\w*.  
\v 10 Cuando veían \w que|strong="H3605"\w* ya había mucho \w dinero|strong="H3701"\w* en \w el|strong="H3605"\w* cofre, \w el|strong="H3605"\w* secretario \w del|strong="H4196"\w* rey y \w el|strong="H3605"\w* sumo \w sacerdote|strong="H3548"\w* venían, contaban \w el|strong="H3605"\w* \w dinero|strong="H3701"\w* \w que|strong="H3605"\w* había en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé y \w lo|strong="H3605"\w* \w ponían|strong="H5414"\w* en bolsas.  
\v 11 \w Una|strong="H4672"\w* vez pesado \w el|strong="H3588"\w* \w dinero|strong="H3701"\w*, \w se|strong="H1961"\w* lo entregaban \w a|strong="H3068"\w* \w los|strong="H1961"\w* supervisores \w de|strong="H3588"\w* \w la|strong="H3588"\w* obra \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w*. Estos, \w a|strong="H3068"\w* \w su|strong="H3588"\w* vez, les pagaban \w a|strong="H3068"\w* \w los|strong="H1961"\w* carpinteros \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* maestros \w de|strong="H3588"\w* obra \w que|strong="H3588"\w* trabajaban \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé,  
\v 12 así \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w albañiles|strong="H2796"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* canteros. \w También|strong="H3318"\w* compraban \w madera|strong="H6086"\w* \w y|strong="H5921"\w* piedra labrada \w para|strong="H5921"\w* reparar \w los|strong="H5921"\w* \w daños|strong="H5414"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*, \w y|strong="H5921"\w* cubrían cualquier otro gasto relacionado \w con|strong="H5921"\w* \w la|strong="H5921"\w* reconstrucción.  
\v 13 \w Con|strong="H5921"\w* ese dinero \w que|strong="H5921"\w* \w se|strong="H5921"\w* traía \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w no|strong="H5921"\w* \w se|strong="H5921"\w* hacían copas \w de|strong="H5921"\w* plata, ni despabiladeras, ni tazones, ni trompetas, ni \w ninguna|strong="H3605"\w* otra pieza \w de|strong="H5921"\w* oro \w o|strong="H3068"\w* \w de|strong="H5921"\w* plata;  
\v 14 \w pues|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w dinero|strong="H3701"\w* \w se|strong="H4480"\w* les entregaba \w a|strong="H3068"\w* \w los|strong="H3605"\w* trabajadores \w para|strong="H4480"\w* \w que|strong="H4480"\w* repararan \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé.  
\v 15 \w Además|strong="H3588"\w*, \w no|strong="H6213"\w* se les pedían cuentas \w a|strong="H3068"\w* \w los|strong="H3588"\w* hombres encargados \w de|strong="H3588"\w* pagarles \w a|strong="H3068"\w* \w los|strong="H3588"\w* trabajadores, \w porque|strong="H3588"\w* ellos actuaban \w con|strong="H3588"\w* total honradez.  
\v 16 \w El|strong="H5921"\w* \w dinero|strong="H3701"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* ofrendas \w por|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* ofrendas \w por|strong="H5921"\w* \w el|strong="H5921"\w* pecado \w no|strong="H3808"\w* \w se|strong="H5921"\w* usaba \w para|strong="H5921"\w* \w el|strong="H5921"\w* templo, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w les|strong="H1992"\w* correspondía \w a|strong="H3068"\w* \w los|strong="H1992"\w* sacerdotes.   
\p
\v 17 Por aquel tiempo, Hazael, rey de Siria, subió \w a|strong="H3068"\w* atacar la ciudad de Gat y la conquistó. Luego decidió marchar \w contra|strong="H1961"\w* Jerusalén.  
\v 18 Entonces Joás, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Judá, \w tomó|strong="H3920"\w* todos \w los|strong="H5921"\w* objetos sagrados \w que|strong="H5921"\w* habían dedicado sus antepasados Josafat, Joram \w y|strong="H5921"\w* Ocozías, \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* Judá, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus propias ofrendas \w y|strong="H5921"\w* todo \w el|strong="H5921"\w* oro \w que|strong="H5921"\w* había \w en|strong="H5921"\w* \w los|strong="H5921"\w* tesoros \w del|strong="H5921"\w* templo \w de|strong="H5921"\w* Yahvé \w y|strong="H5921"\w* \w del|strong="H5921"\w* palacio \w real|strong="H4428"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* envió \w a|strong="H3068"\w* \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria. \w Con|strong="H5921"\w* esto, \w Hazael|strong="H2371"\w* \w se|strong="H5921"\w* retiró \w de|strong="H5921"\w* Jerusalén.   
\p
\v 19 \w Los|strong="H5921"\w* demás hechos \w de|strong="H5921"\w* \w Joás|strong="H3060"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w hizo|strong="H5927"\w* están escritos \w en|strong="H5921"\w* \w el|strong="H5921"\w* libro \w de|strong="H5921"\w* \w las|strong="H5921"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 20 \w Sus|strong="H1992"\w* propios oficiales conspiraron \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w lo|strong="H1697"\w* asesinaron \w en|strong="H5921"\w* Bet-milo, \w en|strong="H5921"\w* \w el|strong="H5921"\w* camino \w que|strong="H3808"\w* baja \w hacia|strong="H6213"\w* Sila.  
\v 21 Los oficiales que lo \w mataron|strong="H5221"\w* fueron Jozacar hijo de Simeat y Jozabad hijo de Somer. \w Joás|strong="H3101"\w* murió y fue sepultado con sus antepasados \w en|strong="H5221"\w* la Ciudad de David. Su hijo Amasías reinó \w en|strong="H5221"\w* su lugar.   
\c 13  
\p
\v 1 Joacaz \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Jehú|strong="H3058"\w* comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w veintitrés|strong="H6242"\w* \w de|strong="H5921"\w* \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ocozías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. Joacaz \w reinó|strong="H4427"\w* \w diecisiete|strong="H7651"\w* \w años|strong="H8141"\w*.  
\v 2 Pero \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H4480"\w* ofende \w a|strong="H3068"\w* Yahvé, \w pues|strong="H4480"\w* \w cometió|strong="H2398"\w* \w los|strong="H1121"\w* mismos \w pecados|strong="H2403"\w* \w con|strong="H4480"\w* \w que|strong="H4480"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Nabat|strong="H5028"\w* \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, y \w no|strong="H3808"\w* \w se|strong="H4480"\w* apartó \w de|strong="H4480"\w* \w ellos|strong="H4480"\w*.  
\v 3 \w Por|strong="H3027"\w* eso \w la|strong="H3605"\w* ira \w de|strong="H1121"\w* Yahvé se encendió \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*, y \w los|strong="H1121"\w* \w entregó|strong="H5414"\w* en \w manos|strong="H3027"\w* \w de|strong="H1121"\w* \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Siria, y \w de|strong="H1121"\w* su \w hijo|strong="H1121"\w* Benhadad, \w por|strong="H3027"\w* mucho \w tiempo|strong="H3117"\w*.  
\v 4 \w Entonces|strong="H3588"\w* Joacaz buscó \w el|strong="H3588"\w* favor \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* Yahvé lo \w escuchó|strong="H8085"\w*, \w porque|strong="H3588"\w* \w vio|strong="H7200"\w* cuánta era \w la|strong="H3588"\w* \w opresión|strong="H3906"\w* \w con|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Siria afligía \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 5 (Yahvé le \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* un libertador \w para|strong="H5414"\w* \w que|strong="H1121"\w* pudieran escapar del dominio \w de|strong="H8478"\w* \w los|strong="H3427"\w* sirios, y así \w los|strong="H3427"\w* israelitas volvieron \w a|strong="H3068"\w* vivir \w en|strong="H3318"\w* sus casas \w como|strong="H8478"\w* \w antes|strong="H8543"\w*.  
\v 6 \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartaron de los \w pecados|strong="H2403"\w* \w con|strong="H1571"\w* \w que|strong="H3808"\w* \w la|strong="H1571"\w* \w familia|strong="H1004"\w* de \w Jeroboam|strong="H3379"\w* hizo \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* persistieron \w en|strong="H5493"\w* \w ellos|strong="H1571"\w*; incluso \w la|strong="H1571"\w* imagen de \w la|strong="H1571"\w* diosa Asera \w permaneció|strong="H5975"\w* \w en|strong="H5493"\w* \w Samaria|strong="H8111"\w*).  
\v 7 \w El|strong="H3588"\w* ejército \w de|strong="H3588"\w* Joacaz \w había|strong="H3588"\w* quedado reducido \w a|strong="H3068"\w* \w cincuenta|strong="H2572"\w* \w jinetes|strong="H6571"\w*, \w diez|strong="H6235"\w* \w carros|strong="H7393"\w* \w de|strong="H3588"\w* guerra \w y|strong="H3588"\w* \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* soldados \w de|strong="H3588"\w* infantería, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Siria \w los|strong="H3588"\w* \w había|strong="H3588"\w* destruido, dejándolos \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w polvo|strong="H6083"\w* \w al|strong="H4428"\w* ser trillado.  
\v 8 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Joacaz, \w y|strong="H5921"\w* \w todas|strong="H3605"\w* \w sus|strong="H1992"\w* hazañas, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 9 Cuando Joacaz murió, fue \w sepultado|strong="H6912"\w* \w en|strong="H5973"\w* \w Samaria|strong="H8111"\w* \w con|strong="H5973"\w* sus antepasados. Su \w hijo|strong="H1121"\w* \w Joás|strong="H3101"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 10 \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Joacaz comenzó \w a|strong="H3068"\w* reinar \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w siete|strong="H7651"\w* \w de|strong="H5921"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*. \w Joás|strong="H3101"\w* \w reinó|strong="H4427"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w*.  
\v 11 Pero \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w malo|strong="H7451"\w* ante \w los|strong="H1121"\w* \w ojos|strong="H5869"\w* \w de|strong="H1121"\w* Yahvé, pues \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartó \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* con \w que|strong="H3808"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w* \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w los|strong="H1121"\w* siguió cometiendo.  
\v 12 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Joás|strong="H3101"\w*, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w*, incluyendo \w su|strong="H1992"\w* \w guerra|strong="H3898"\w* \w contra|strong="H5921"\w* Amasías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 13 Cuando \w Joás|strong="H3101"\w* murió, fue \w sepultado|strong="H6912"\w* \w en|strong="H5921"\w* \w Samaria|strong="H8111"\w* \w con|strong="H5973"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w Jeroboam|strong="H3379"\w* ocupó su \w trono|strong="H3678"\w*.   
\p
\v 14 Eliseo \w se|strong="H5921"\w* \w enfermó|strong="H2470"\w* \w de|strong="H5921"\w* gravedad, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Joás|strong="H3101"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* fue \w a|strong="H3068"\w* visitarlo. \w Llorando|strong="H1058"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* exclamó: “¡Padre \w mío|strong="H5921"\w*, padre \w mío|strong="H5921"\w*! ¡\w Carros|strong="H7393"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* su caballería!”   
\p
\v 15 Eliseo le dijo: “Trae un \w arco|strong="H7198"\w* y unas flechas”. El rey así lo hizo.  
\v 16 Luego Eliseo \w le|strong="H5921"\w* \w ordenó|strong="H7760"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “Sostén \w el|strong="H5921"\w* \w arco|strong="H7198"\w* \w con|strong="H5921"\w* tu \w mano|strong="H3027"\w*”. Mientras \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w lo|strong="H5921"\w* sostenía, Eliseo \w puso|strong="H7760"\w* sus \w manos|strong="H3027"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 17 “\w Abre|strong="H6605"\w* la ventana \w que|strong="H5704"\w* da \w al|strong="H5704"\w* \w oriente|strong="H6924"\w*”, dijo Eliseo. El \w rey|strong="H5221"\w* la \w abrió|strong="H6605"\w*, \w y|strong="H5704"\w* Eliseo le ordenó: “¡Dispara!” \w En|strong="H5704"\w* cuanto el \w rey|strong="H5221"\w* disparó, Eliseo exclamó: “¡Esa es la flecha \w de|strong="H5704"\w* la victoria \w de|strong="H5704"\w* Yahvé! ¡La flecha \w de|strong="H5704"\w* la victoria sobre Siria! Tú vas \w a|strong="H3068"\w* derrotar \w a|strong="H3068"\w* los sirios \w en|strong="H5704"\w* Afec \w hasta|strong="H5704"\w* \w acabar|strong="H3615"\w* \w con|strong="H5704"\w* ellos”.   
\p
\v 18 Luego le dijo: “\w Toma|strong="H3947"\w* las otras flechas”. El \w rey|strong="H4428"\w* las \w tomó|strong="H3947"\w*, y Eliseo le \w ordenó|strong="H5975"\w*: “Golpea el suelo con ellas”. El \w rey|strong="H4428"\w* golpeó el suelo \w tres|strong="H7969"\w* \w veces|strong="H6471"\w* y se detuvo.  
\v 19 \w El|strong="H5921"\w* hombre \w de|strong="H5921"\w* Dios \w se|strong="H5921"\w* enojó \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo: “¡Debiste haber golpeado \w el|strong="H5921"\w* suelo \w cinco|strong="H2568"\w* \w o|strong="H3068"\w* \w seis|strong="H8337"\w* \w veces|strong="H6471"\w*! Entonces habrías derrotado \w a|strong="H3068"\w* Siria \w por|strong="H5921"\w* completo, pero \w ahora|strong="H6258"\w* solo \w la|strong="H5921"\w* vencerás \w tres|strong="H7969"\w* \w veces|strong="H6471"\w*”.   
\p
\v 20 Eliseo \w murió|strong="H4191"\w* y lo \w sepultaron|strong="H6912"\w*.  
\p Por aquel tiempo, \w cada|strong="H8141"\w* \w año|strong="H8141"\w*, bandas de guerrilleros moabitas invadían el país.  
\v 21 Un día, mientras \w unos|strong="H1992"\w* israelitas enterraban \w a|strong="H3068"\w* un muerto, \w vieron|strong="H7200"\w* \w a|strong="H3068"\w* una \w de|strong="H5921"\w* esas bandas \w y|strong="H5921"\w* arrojaron \w el|strong="H5921"\w* cadáver \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w sepulcro|strong="H6913"\w* \w de|strong="H5921"\w* Eliseo. \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w el|strong="H5921"\w* cuerpo \w tocó|strong="H5060"\w* \w los|strong="H1992"\w* \w huesos|strong="H6106"\w* \w de|strong="H5921"\w* Eliseo, ¡\w el|strong="H5921"\w* hombre volvió \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w vida|strong="H2421"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* puso \w de|strong="H5921"\w* \w pie|strong="H7272"\w*!   
\p
\v 22 Durante \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w reinado|strong="H4428"\w* de Joacaz, \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* de Siria, oprimió \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 23 Pero Yahvé tuvo \w misericordia|strong="H7355"\w* \w y|strong="H5921"\w* \w compasión|strong="H2603"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* israelitas; \w los|strong="H5921"\w* ayudó \w por|strong="H5921"\w* \w causa|strong="H6440"\w* \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w que|strong="H3808"\w* había hecho \w con|strong="H5921"\w* Abraham, \w Isaac|strong="H3327"\w* \w y|strong="H5921"\w* \w Jacob|strong="H3290"\w*. \w Hasta|strong="H5704"\w* \w el|strong="H5921"\w* día \w de|strong="H5921"\w* hoy, Yahvé \w no|strong="H3808"\w* \w ha|strong="H3808"\w* querido \w destruirlos|strong="H7843"\w* \w ni|strong="H3808"\w* arrojarlos lejos \w de|strong="H5921"\w* su \w presencia|strong="H6440"\w*.   
\p
\v 24 Cuando \w Hazael|strong="H2371"\w*, \w rey|strong="H4428"\w* \w de|strong="H8478"\w* Siria, \w murió|strong="H4191"\w*, su \w hijo|strong="H1121"\w* Benhadad \w reinó|strong="H4427"\w* \w en|strong="H8478"\w* su \w lugar|strong="H8478"\w*.  
\v 25 \w Entonces|strong="H7725"\w* \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joacaz logró recuperar \w de|strong="H1121"\w* \w manos|strong="H3027"\w* \w de|strong="H1121"\w* Benhadad \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hazael|strong="H2371"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H1121"\w* este le había quitado \w a|strong="H3068"\w* su padre Joacaz \w en|strong="H5221"\w* la \w guerra|strong="H4421"\w*. \w Joás|strong="H3101"\w* derrotó \w a|strong="H3068"\w* Benhadad \w tres|strong="H7969"\w* \w veces|strong="H6471"\w*, y así \w recuperó|strong="H7725"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.   
\c 14  
\p
\v 1 Amasías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joás|strong="H3101"\w* comenzó \w a|strong="H3068"\w* reinar en \w Judá|strong="H3063"\w* durante \w el|strong="H1121"\w* \w segundo|strong="H8147"\w* \w año|strong="H8141"\w* del \w reinado|strong="H4427"\w* \w de|strong="H1121"\w* \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joacaz en \w Israel|strong="H3478"\w*.  
\v 2 \w Tenía|strong="H1961"\w* \w veinticinco|strong="H6242"\w* \w años|strong="H8141"\w* \w cuando|strong="H1961"\w* comenzó \w a|strong="H3068"\w* reinar, y gobernó \w en|strong="H4480"\w* Jerusalén \w veintinueve|strong="H6242"\w* \w años|strong="H8141"\w*. Su madre \w era|strong="H1961"\w* Joadán, \w de|strong="H4480"\w* Jerusalén.  
\v 3 Amasías \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w le|strong="H5869"\w* agrada \w a|strong="H3068"\w* Yahvé, \w aunque|strong="H7535"\w* \w no|strong="H3808"\w* llegó \w a|strong="H3068"\w* ser como su antepasado \w David|strong="H1732"\w*. En \w todo|strong="H3605"\w* siguió \w el|strong="H3605"\w* ejemplo \w de|strong="H5869"\w* su padre \w Joás|strong="H3101"\w*.  
\v 4 \w Sin|strong="H3808"\w* embargo, \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w quitaron|strong="H5493"\w* los santuarios paganos, y el \w pueblo|strong="H5971"\w* seguía \w ofreciendo|strong="H2076"\w* \w sacrificios|strong="H2076"\w* y quemando incienso \w en|strong="H5493"\w* ellos.  
\v 5 \w En|strong="H5221"\w* cuanto Amasías \w se|strong="H1961"\w* afirmó \w en|strong="H5221"\w* el \w poder|strong="H3027"\w*, mandó matar \w a|strong="H3068"\w* \w los|strong="H1961"\w* oficiales \w que|strong="H1961"\w* \w habían|strong="H1961"\w* asesinado \w al|strong="H4428"\w* \w rey|strong="H4428"\w*, su padre.  
\v 6 \w Pero|strong="H3588"\w*, siguiendo \w lo|strong="H3808"\w* \w que|strong="H3588"\w* Yahvé \w ordenó|strong="H6680"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w no|strong="H3808"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* asesinos, \w pues|strong="H3588"\w* \w está|strong="H5921"\w* \w escrito|strong="H3789"\w*: “\w No|strong="H3808"\w* \w se|strong="H5921"\w* \w matará|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* padres \w por|strong="H5921"\w* \w culpa|strong="H2399"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w por|strong="H5921"\w* \w culpa|strong="H2399"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* padres; cada uno \w morirá|strong="H4191"\w* \w por|strong="H5921"\w* \w su|strong="H3588"\w* propio \w pecado|strong="H2399"\w*”.   
\p
\v 7 Amasías \w también|strong="H2088"\w* derrotó \w a|strong="H3068"\w* \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* edomitas \w en|strong="H5704"\w* \w el|strong="H1931"\w* \w Valle|strong="H1516"\w* \w de|strong="H5704"\w* \w la|strong="H1931"\w* \w Sal|strong="H4417"\w*. \w En|strong="H5704"\w* \w esa|strong="H1931"\w* \w guerra|strong="H4421"\w* capturó \w la|strong="H1931"\w* ciudad \w de|strong="H5704"\w* Sela \w y|strong="H5704"\w* \w la|strong="H1931"\w* \w llamó|strong="H7121"\w* \w Jocteel|strong="H3371"\w*, \w nombre|strong="H8034"\w* \w que|strong="H1931"\w* conserva \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 8 Después Amasías le \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w Joás|strong="H3060"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Joacaz y \w nieto|strong="H1121"\w* \w de|strong="H6440"\w* \w Jehú|strong="H3058"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, con este desafío: “Venga, enfrentémonos \w cara|strong="H6440"\w* \w a|strong="H3068"\w* \w cara|strong="H6440"\w*”.   
\p
\v 9 Pero \w Joás|strong="H3060"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, le \w mandó|strong="H7971"\w* esta respuesta \w a|strong="H3068"\w* Amasías, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*: “Una vez, \w el|strong="H1121"\w* cardo del \w Líbano|strong="H3844"\w* le \w mandó|strong="H7971"\w* este mensaje \w al|strong="H4428"\w* cedro: ‘Dale tu \w hija|strong="H1323"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* como esposa’. Pero una fiera del \w Líbano|strong="H3844"\w* \w pasó|strong="H5674"\w* y pisoteó \w el|strong="H1121"\w* cardo.  
\v 10 Es verdad \w que|strong="H4100"\w* has derrotado \w a|strong="H3068"\w* Edom y ahora \w te|strong="H5973"\w* sientes muy orgulloso. Disfruta \w de|strong="H5973"\w* tu triunfo, pero \w quédate|strong="H3427"\w* \w en|strong="H5973"\w* tu \w casa|strong="H1004"\w*. ¿\w Para|strong="H5973"\w* \w qué|strong="H4100"\w* buscas problemas \w que|strong="H4100"\w* \w te|strong="H5973"\w* causarán la ruina \w a|strong="H3068"\w* \w ti|strong="H5973"\w* y \w a|strong="H3068"\w* todo \w Judá|strong="H3063"\w*?”   
\p
\v 11 Pero Amasías \w no|strong="H3808"\w* quiso hacer caso. Entonces \w Joás|strong="H3060"\w*, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, marchó \w a|strong="H3068"\w* \w la|strong="H1931"\w* batalla, y \w él|strong="H1931"\w* y Amasías, \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*, \w se|strong="H1931"\w* enfrentaron \w cara|strong="H6440"\w* \w a|strong="H3068"\w* \w cara|strong="H6440"\w* en Bet Semes, en territorio \w de|strong="H6440"\w* \w Judá|strong="H3063"\w*.  
\v 12 El ejército \w de|strong="H6440"\w* \w Judá|strong="H3063"\w* \w fue|strong="H3063"\w* derrotado \w por|strong="H6440"\w* el \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, y cada uno \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* su casa.  
\v 13 \w En|strong="H5704"\w* Bet Semes, \w Joás|strong="H3060"\w*, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, capturó \w a|strong="H3068"\w* Amasías, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w Joás|strong="H3060"\w* \w y|strong="H5704"\w* \w nieto|strong="H1121"\w* \w de|strong="H5704"\w* Ocozías. \w Luego|strong="H5704"\w* \w Joás|strong="H3060"\w* \w fue|strong="H3063"\w* \w a|strong="H3068"\w* Jerusalén \w y|strong="H5704"\w* derribó \w el|strong="H1121"\w* \w muro|strong="H2346"\w* \w de|strong="H5704"\w* la ciudad \w desde|strong="H5704"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5704"\w* Efraín \w hasta|strong="H5704"\w* la \w puerta|strong="H8179"\w* \w de|strong="H5704"\w* la Esquina, un tramo \w de|strong="H5704"\w* unos \w ciento|strong="H3967"\w* ochenta metros.  
\v 14 Se \w llevó|strong="H3947"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w oro|strong="H2091"\w*, \w la|strong="H3605"\w* \w plata|strong="H3701"\w* y \w todos|strong="H3605"\w* \w los|strong="H1121"\w* utensilios \w que|strong="H1121"\w* \w había|strong="H4672"\w* en \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé y en \w los|strong="H1121"\w* tesoros del palacio \w real|strong="H4428"\w*. También \w tomó|strong="H3947"\w* rehenes y regresó \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w*.   
\p
\v 15 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* \w Joás|strong="H3060"\w*, \w sus|strong="H1992"\w* hazañas \w y|strong="H5921"\w* \w su|strong="H1992"\w* \w guerra|strong="H3898"\w* \w contra|strong="H5921"\w* Amasías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 16 Cuando \w Joás|strong="H3060"\w* murió, fue \w sepultado|strong="H6912"\w* \w en|strong="H5973"\w* \w Samaria|strong="H8111"\w* \w con|strong="H5973"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*. Su \w hijo|strong="H1121"\w* \w Jeroboam|strong="H3379"\w* \w reinó|strong="H4427"\w* \w en|strong="H5973"\w* su \w lugar|strong="H8478"\w*.   
\p
\v 17 Amasías \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Judá|strong="H3063"\w*, \w vivió|strong="H2421"\w* \w quince|strong="H2568"\w* \w años|strong="H8141"\w* \w más|strong="H2421"\w* después \w de|strong="H2568"\w* la \w muerte|strong="H4194"\w* \w de|strong="H2568"\w* \w Joás|strong="H3101"\w* \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* Joacaz, \w rey|strong="H4428"\w* \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*.  
\v 18 \w Los|strong="H1992"\w* demás \w hechos|strong="H1697"\w* \w de|strong="H5921"\w* Amasías están \w escritos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* crónicas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 19 Hubo una conspiración \w contra|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén, \w por|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* Laquis. Pero \w lo|strong="H5921"\w* persiguieron \w hasta|strong="H5921"\w* \w allá|strong="H8033"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w mataron|strong="H4191"\w*.  
\v 20 Su cuerpo fue traído \w a|strong="H3068"\w* \w caballo|strong="H5483"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w sepultaron|strong="H6912"\w* \w en|strong="H5921"\w* Jerusalén \w con|strong="H5973"\w* sus antepasados, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*.   
\p
\v 21 Entonces \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w de|strong="H8478"\w* \w Judá|strong="H3063"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* \w Azarías|strong="H5838"\w*, \w que|strong="H1931"\w* \w tenía|strong="H1931"\w* \w dieciséis|strong="H8337"\w* \w años|strong="H8141"\w*, y \w lo|strong="H1931"\w* nombró \w rey|strong="H4427"\w* \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w su|strong="H1931"\w* padre Amasías.  
\v 22 \w Fue|strong="H1931"\w* Azarías \w quien|strong="H1931"\w* reconstruyó \w la|strong="H1931"\w* ciudad \w de|strong="H5973"\w* Elat y \w la|strong="H1931"\w* \w recuperó|strong="H7725"\w* \w para|strong="H5973"\w* \w Judá|strong="H3063"\w*, después \w de|strong="H5973"\w* \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* Amasías murió y \w fue|strong="H1931"\w* sepultado \w con|strong="H5973"\w* \w sus|strong="H1931"\w* antepasados.   
\p
\v 23 \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Joás|strong="H3101"\w* comenzó \w a|strong="H3068"\w* reinar sobre \w Israel|strong="H3478"\w* en \w Samaria|strong="H8111"\w* durante \w el|strong="H1121"\w* \w año|strong="H8141"\w* \w quince|strong="H2568"\w* del \w reinado|strong="H4427"\w* \w de|strong="H2568"\w* Amasías \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Joás|strong="H3101"\w* en \w Judá|strong="H3063"\w*. \w Jeroboam|strong="H3379"\w* \w reinó|strong="H4427"\w* cuarenta y un \w años|strong="H8141"\w*.  
\v 24 Pero \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* ofende \w a|strong="H3068"\w* Yahvé, pues \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartó \w de|strong="H1121"\w* \w ninguno|strong="H3808"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* con \w que|strong="H3808"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nabat|strong="H5028"\w* \w hizo|strong="H6213"\w* \w pecar|strong="H2398"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 25 \w Él|strong="H1931"\w* \w fue|strong="H1931"\w* \w quien|strong="H1931"\w* \w recuperó|strong="H7725"\w* las fronteras \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w desde|strong="H5704"\w* \w la|strong="H1931"\w* entrada \w de|strong="H5704"\w* Hamat \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w mar|strong="H3220"\w* del Arabá, \w tal|strong="H1697"\w* \w como|strong="H5704"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w lo|strong="H1931"\w* había anunciado \w por|strong="H1697"\w* \w medio|strong="H3027"\w* \w de|strong="H5704"\w* \w su|strong="H1931"\w* \w siervo|strong="H5650"\w* \w Jonás|strong="H3124"\w* \w hijo|strong="H1121"\w* \w de|strong="H5704"\w* Amitai, \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w de|strong="H5704"\w* Gat Hefer.  
\v 26 \w Porque|strong="H3588"\w* Yahvé \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* amargura \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* era mucha; \w no|strong="H3588"\w* \w había|strong="H3588"\w* quien ayudara \w a|strong="H3068"\w* \w los|strong="H3588"\w* israelitas, fueran esclavos \w o|strong="H3068"\w* libres.  
\v 27 Pero \w como|strong="H8478"\w* Yahvé \w no|strong="H3808"\w* había \w dicho|strong="H1696"\w* \w que|strong="H3808"\w* borraría \w el|strong="H1121"\w* \w nombre|strong="H8034"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w* \w de|strong="H8478"\w* la tierra, \w los|strong="H1121"\w* \w salvó|strong="H3467"\w* \w por|strong="H8478"\w* \w medio|strong="H3027"\w* \w de|strong="H8478"\w* \w Jeroboam|strong="H3379"\w* \w hijo|strong="H1121"\w* \w de|strong="H8478"\w* \w Joás|strong="H3101"\w*.  
