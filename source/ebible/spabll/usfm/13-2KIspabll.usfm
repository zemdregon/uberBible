\v 9 \w A|strong="H3068"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* siguiente, Jehú \w salió|strong="H3318"\w*, \w se|strong="H1961"\w* presentó ante \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w y|strong="H5921"\w* dijo: “Ustedes \w son|strong="H1961"\w* \w gente|strong="H5971"\w* \w justa|strong="H6662"\w*. \w Es|strong="H1961"\w* verdad \w que|strong="H4310"\w* \w yo|strong="H2009"\w* conspiré \w contra|strong="H5921"\w* \w mi|strong="H5921"\w* señor \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w maté|strong="H2026"\w*, pero ¿\w quién|strong="H4310"\w* \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w estos|strong="H3605"\w*?  
\v 10 \w Sepan|strong="H3045"\w* \w de|strong="H5921"\w* una vez \w que|strong="H3588"\w* \w no|strong="H3808"\w* dejará \w de|strong="H5921"\w* cumplirse \w ni|strong="H3808"\w* una sola \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H3588"\w* Yahvé \w pronunció|strong="H1696"\w* \w contra|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* Acab. Yahvé \w ha|strong="H3808"\w* \w hecho|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* anunció \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w siervo|strong="H5650"\w* Elías”.   
