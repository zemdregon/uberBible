\b  
\q1
\v 23 “\w Alégrense|strong="H8055"\w*, \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w*,  
\q2 \w y|strong="H3588"\w* hagan fiesta \w en|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*;  
\q2 \w porque|strong="H3588"\w* \w él|strong="H3588"\w* les \w da|strong="H5414"\w* las \w lluvias|strong="H1653"\w* \w de|strong="H3588"\w* otoño \w en|strong="H3588"\w* \w su|strong="H3588"\w* justa medida,  
\q2 \w y|strong="H3588"\w* hace caer sobre ustedes \w los|strong="H1121"\w* aguaceros:  
\q2 las \w lluvias|strong="H1653"\w* \w de|strong="H3588"\w* otoño \w y|strong="H3588"\w* las \w lluvias|strong="H1653"\w* \w de|strong="H3588"\w* primavera, \w como|strong="H3588"\w* \w en|strong="H3588"\w* tiempos \w pasados|strong="H7223"\w*.   
