\mt1 Joel  
\c 1  
\p
\v 1 \w Palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w que|strong="H1697"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Joel|strong="H3100"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Petuel.   
\q1
\v 2 ¡\w Escuchen|strong="H8085"\w* \w esto|strong="H2063"\w*, \w ancianos|strong="H2205"\w*!  
\q2 ¡Presten atención, \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* del país!  
\q1 ¿Ha sucedido algo \w así|strong="H2063"\w* en \w los|strong="H3427"\w* \w días|strong="H3117"\w* de ustedes,  
\q2 \w o|strong="H3068"\w* en \w los|strong="H3427"\w* \w días|strong="H3117"\w* de sus antepasados?   
\q1
\v 3 Cuéntenselo \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*,  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w cuenten|strong="H5608"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* suyos,  
\q2 \w y|strong="H5921"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* siguiente \w generación|strong="H1755"\w*.   
\q1
\v 4 Lo que dejó la oruga, se lo comió la langosta.  
\q2 Lo que dejó la langosta, se lo comió el pulgón.  
\q2 \w Y|strong="H3068"\w* lo que dejó el pulgón, se lo devoró el saltamontes.   
\q1
\v 5 ¡Despierten, \w borrachos|strong="H7910"\w*, \w y|strong="H3588"\w* \w lloren|strong="H1058"\w*!  
\q2 Laméntense, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* bebedores \w de|strong="H5921"\w* \w vino|strong="H3196"\w*, \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w vino|strong="H3196"\w* nuevo,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* han quitado \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w boca|strong="H6310"\w*.   
\q1
\v 6 \w Porque|strong="H3588"\w* una \w nación|strong="H1471"\w* ha invadido \w mi|strong="H5921"\w* país, una \w nación|strong="H1471"\w* poderosa \w e|strong="H3068"\w* innumerable.  
\q2 Sus \w dientes|strong="H8127"\w* \w son|strong="H3588"\w* \w como|strong="H3588"\w* \w dientes|strong="H8127"\w* \w de|strong="H5921"\w* león,  
\q2 \w y|strong="H3588"\w* tiene colmillos \w de|strong="H5921"\w* leona.   
\q1
\v 7 Ha dejado en ruinas mi \w vid|strong="H1612"\w*,  
\q2 y ha destrozado mi higuera.  
\q2 Le arrancó toda la corteza y la \w derribó|strong="H7993"\w*;  
\q2 sus ramas quedaron blancas.   
\q1
\v 8 Lloren \w como|strong="H5921"\w* una joven \w vestida|strong="H2296"\w* \w de|strong="H5921"\w* luto  
\q2 ¡\w por|strong="H5921"\w* \w el|strong="H5921"\w* esposo \w de|strong="H5921"\w* su \w juventud|strong="H5271"\w*!   
\q1
\v 9 Las ofrendas de cereales y las \w libaciones|strong="H5262"\w* han sido suspendidas en la \w casa|strong="H1004"\w* de Yahvé.  
\q2 Los \w sacerdotes|strong="H3548"\w*, servidores de Yahvé, están de luto.   
\q1
\v 10 \w El|strong="H3588"\w* \w campo|strong="H7704"\w* está \w en|strong="H3588"\w* ruinas.  
\q2 \w La|strong="H3588"\w* tierra está \w de|strong="H3588"\w* luto, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w grano|strong="H1715"\w* ha sido \w destruido|strong="H7703"\w*;  
\q2 \w el|strong="H3588"\w* \w vino|strong="H8492"\w* nuevo se ha secado,  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w aceite|strong="H3323"\w* se agota.   
\q1
\v 11 ¡Desespérense, campesinos!  
\q2 ¡Laméntense, viñadores!  
\q2 Lloren \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w trigo|strong="H2406"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* \w cebada|strong="H8184"\w*,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H5921"\w* ha perdido \w la|strong="H5921"\w* cosecha \w del|strong="H5921"\w* \w campo|strong="H7704"\w*.   
\q1
\v 12 \w La|strong="H1571"\w* \w vid|strong="H1612"\w* \w se|strong="H4480"\w* ha secado \w y|strong="H1571"\w* \w la|strong="H1571"\w* higuera \w se|strong="H4480"\w* marchitó.  
\q2 \w También|strong="H1571"\w* \w se|strong="H4480"\w* secaron \w el|strong="H3588"\w* granado, \w la|strong="H1571"\w* palmera \w y|strong="H1571"\w* \w el|strong="H3588"\w* manzano;  
\q2 ¡\w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w árboles|strong="H6086"\w* \w del|strong="H4480"\w* \w campo|strong="H7704"\w* \w se|strong="H4480"\w* han secado!  
\q2 \w Y|strong="H3068"\w* \w la|strong="H1571"\w* alegría \w se|strong="H4480"\w* ha marchitado \w entre|strong="H3588"\w* \w los|strong="H1121"\w* seres humanos.   
\q1
\v 13 ¡Pónganse ropa \w de|strong="H3588"\w* luto \w y|strong="H3588"\w* lloren, \w sacerdotes|strong="H3548"\w*!  
\q2 Laméntense, servidores \w del|strong="H4196"\w* \w altar|strong="H4196"\w*.  
\q1 Vengan \w y|strong="H3588"\w* pasen \w la|strong="H3588"\w* noche vestidos \w de|strong="H3588"\w* luto, servidores \w de|strong="H3588"\w* mi Dios,  
\q2 \w porque|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* Dios ya \w no|strong="H3588"\w* traen ofrendas \w de|strong="H3588"\w* cereales ni \w libaciones|strong="H5262"\w*.   
\q1
\v 14 Proclamen un tiempo de \w ayuno|strong="H6685"\w*.  
\q2 Convoquen \w a|strong="H3068"\w* una asamblea solemne.  
\q2 Reúnan \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* del país en \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de Yahvé su \w Dios|strong="H3068"\w*,  
\q2 y clamen \w a|strong="H3068"\w* Yahvé.   
\q1
\v 15 ¡Ay \w de|strong="H3588"\w* ese \w día|strong="H3117"\w*!  
\q2 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* Yahvé está \w cerca|strong="H7138"\w*,  
\q2 \w y|strong="H3588"\w* vendrá \w como|strong="H3588"\w* una \w destrucción|strong="H7701"\w* \w de|strong="H3588"\w* parte del \w Todopoderoso|strong="H7706"\w*.   
\q1
\v 16 ¿Acaso \w no|strong="H3808"\w* nos han quitado la comida en nuestra propia cara,  
\q2 y también la \w alegría|strong="H8057"\w* y el \w gozo|strong="H8057"\w* \w de|strong="H5048"\w* la \w casa|strong="H1004"\w* \w de|strong="H5048"\w* nuestro Dios?   
\q1
\v 17 Las semillas se pudren \w bajo|strong="H8478"\w* \w los|strong="H3588"\w* terrones.  
\q2 Las bodegas están vacías.  
\q2 \w Los|strong="H3588"\w* graneros han sido \w derribados|strong="H2040"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w grano|strong="H1715"\w* se marchitó.   
\q1
\v 18 ¡\w Cómo|strong="H4100"\w* gimen \w los|strong="H1992"\w* animales!  
\q2 \w El|strong="H3588"\w* \w ganado|strong="H6629"\w* anda \w de|strong="H3588"\w* un lado \w a|strong="H3068"\w* otro sin saber \w qué|strong="H3588"\w* hacer, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* tiene \w pastos|strong="H4829"\w*.  
\q2 Hasta \w los|strong="H1992"\w* \w rebaños|strong="H5739"\w* \w de|strong="H3588"\w* \w ovejas|strong="H6629"\w* sufren \w las|strong="H1992"\w* consecuencias.   
\q1
\v 19 \w A|strong="H3068"\w* ti \w clamo|strong="H7121"\w*, Yahvé,  
\q2 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* fuego ha devorado \w los|strong="H3605"\w* pastizales del \w desierto|strong="H4057"\w*,  
\q2 \w y|strong="H3588"\w* las \w llamas|strong="H3852"\w* han quemado \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* del \w campo|strong="H7704"\w*.   
\q1
\v 20 Hasta \w los|strong="H3588"\w* animales del \w campo|strong="H7704"\w* claman \w a|strong="H3068"\w* ti,  
\q2 \w porque|strong="H3588"\w* \w los|strong="H3588"\w* arroyos se han secado,  
\q2 \w y|strong="H1571"\w* \w el|strong="H3588"\w* fuego ha devorado \w los|strong="H3588"\w* pastizales del \w desierto|strong="H4057"\w*.   
\b  
\c 2  
\q1
\v 1 ¡Toquen \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w* \w en|strong="H3588"\w* \w Sión|strong="H6726"\w*,  
\q2 \w y|strong="H3588"\w* den \w la|strong="H3605"\w* alarma \w en|strong="H3588"\w* mi \w monte|strong="H2022"\w* \w santo|strong="H6944"\w*!  
\q1 \w Que|strong="H3588"\w* \w tiemblen|strong="H7264"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* del país,  
\q2 \w porque|strong="H3588"\w* ya viene \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* Yahvé;  
\q2 \w en|strong="H3588"\w* realidad, ya \w está|strong="H3427"\w* muy \w cerca|strong="H7138"\w*:   
\q1
\v 2 \w Será|strong="H1961"\w* un \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w oscuridad|strong="H6205"\w* \w y|strong="H5921"\w* penumbra,  
\q2 un \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w nubes|strong="H6051"\w* \w y|strong="H5921"\w* densa \w oscuridad|strong="H6205"\w*.  
\q1 \w Como|strong="H3644"\w* \w la|strong="H5921"\w* luz \w del|strong="H4480"\w* amanecer \w que|strong="H4480"\w* \w se|strong="H1961"\w* \w extiende|strong="H6566"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w*,  
\q2 así avanza un \w pueblo|strong="H5971"\w* \w grande|strong="H7227"\w* \w y|strong="H5921"\w* poderoso.  
\q2 \w Nunca|strong="H3808"\w* \w ha|strong="H3808"\w* habido algo parecido,  
\q2 \w ni|strong="H3808"\w* \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* haberlo \w jamás|strong="H5769"\w*,  
\q2 \w ni|strong="H3808"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w generaciones|strong="H1755"\w* futuras.   
\q1
\v 3 Un fuego devora todo \w a|strong="H3068"\w* su paso,  
\q2 \w y|strong="H1571"\w* detrás \w de|strong="H6440"\w* \w ellos|strong="H1571"\w* arde una \w llama|strong="H3852"\w*.  
\q1 \w Antes|strong="H6440"\w* \w de|strong="H6440"\w* \w que|strong="H3808"\w* lleguen, \w la|strong="H1571"\w* tierra \w es|strong="H1961"\w* \w como|strong="H1571"\w* \w el|strong="H1571"\w* jardín del Edén;  
\q2 pero \w después|strong="H1961"\w* \w de|strong="H6440"\w* \w que|strong="H3808"\w* pasan, queda \w como|strong="H1571"\w* un \w desierto|strong="H4057"\w* desolado.  
\q1 ¡\w Nada|strong="H3808"\w* \w se|strong="H1961"\w* escapa \w de|strong="H6440"\w* \w ellos|strong="H1571"\w*!   
\q1
\v 4 Tienen el \w aspecto|strong="H4758"\w* de los \w caballos|strong="H5483"\w*,  
\q2 y \w corren|strong="H7323"\w* \w como|strong="H3651"\w* \w jinetes|strong="H6571"\w* de caballería.   
\q1
\v 5 Saltan \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* cumbres \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w con|strong="H5921"\w* un \w ruido|strong="H6963"\w* parecido \w al|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w carros|strong="H4818"\w* \w de|strong="H5921"\w* \w guerra|strong="H4421"\w*;  
\q2 \w como|strong="H5921"\w* \w el|strong="H5921"\w* crepitar \w de|strong="H5921"\w* \w las|strong="H5921"\w* llamas \w que|strong="H5921"\w* devoran \w la|strong="H5921"\w* paja,  
\q2 \w como|strong="H5921"\w* un ejército poderoso \w en|strong="H5921"\w* formación \w de|strong="H5921"\w* \w batalla|strong="H4421"\w*.   
\q1
\v 6 \w Ante|strong="H6440"\w* \w ellos|strong="H3605"\w*, \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* \w se|strong="H5971"\w* angustian  
\q2 y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w rostros|strong="H6440"\w* palidecen.   
\q1
\v 7 Atacan como guerreros \w valientes|strong="H1368"\w*,  
\q2 y escalan la muralla como soldados.  
\q2 Cada uno avanza \w en|strong="H3212"\w* línea recta, \w sin|strong="H3808"\w* desviarse de su \w camino|strong="H1870"\w*.   
\q1
\v 8 \w No|strong="H3808"\w* \w se|strong="H3808"\w* empujan unos \w a|strong="H3068"\w* otros;  
\q2 cada uno marcha \w por|strong="H1157"\w* su propia senda.  
\q2 \w Se|strong="H3808"\w* abalanzan sobre las defensas  
\q2 \w sin|strong="H3808"\w* romper la formación.   
\q1
\v 9 Se precipitan sobre la \w ciudad|strong="H5892"\w*,  
\q2 \w corren|strong="H7323"\w* \w por|strong="H1157"\w* encima de las murallas,  
\q2 se trepan \w a|strong="H3068"\w* las \w casas|strong="H1004"\w*  
\q2 y entran \w por|strong="H1157"\w* las \w ventanas|strong="H2474"\w* como \w ladrones|strong="H1590"\w*.   
\q1
\v 10 La tierra \w tiembla|strong="H7493"\w* \w ante|strong="H6440"\w* ellos,  
\q2 y los \w cielos|strong="H8064"\w* se estremecen.  
\q2 El \w sol|strong="H8121"\w* y la \w luna|strong="H3394"\w* se oscurecen,  
\q2 y las \w estrellas|strong="H3556"\w* dejan \w de|strong="H6440"\w* brillar.   
\q1
\v 11 Yahvé \w hace|strong="H6213"\w* resonar \w su|strong="H3588"\w* \w voz|strong="H6963"\w* al frente \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w ejército|strong="H2426"\w*,  
\q2 \w porque|strong="H3588"\w* sus tropas \w son|strong="H3588"\w* inmensas;  
\q2 poderoso \w es|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* ejecuta \w su|strong="H3588"\w* orden.  
\q2 \w El|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* \w grande|strong="H1419"\w* \w y|strong="H3588"\w* \w terrible|strong="H3372"\w*.  
\q2 ¿\w Quién|strong="H4310"\w* podrá soportarlo?   
\q1
\v 12 “Sin embargo, \w ahora|strong="H6258"\w* \w mismo|strong="H1571"\w* —\w dice|strong="H5002"\w* Yahvé—, regresen \w a|strong="H3068"\w* mí \w de|strong="H5704"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*,  
\q2 \w con|strong="H1571"\w* \w ayuno|strong="H6685"\w*, lágrimas \w y|strong="H1571"\w* \w lamentos|strong="H1065"\w*”.   
\q1
\v 13 Rásguense \w el|strong="H1931"\w* \w corazón|strong="H3824"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w las|strong="H5921"\w* vestiduras.  
\q2 \w Vuelvan|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*,  
\q2 \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w clemente|strong="H2587"\w* \w y|strong="H3588"\w* compasivo,  
\q2 lento \w para|strong="H5921"\w* enojarse, lleno \w de|strong="H5921"\w* amor \w y|strong="H3588"\w* lealtad,  
\q2 \w y|strong="H3588"\w* \w está|strong="H1931"\w* dispuesto \w a|strong="H3068"\w* \w no|strong="H3588"\w* enviar \w la|strong="H1931"\w* calamidad.   
\q1
\v 14 ¿\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w*? Tal vez ceda y \w se|strong="H3045"\w* compadezca,  
\q2 y deje tras de sí una \w bendición|strong="H1293"\w*,  
\q2 para \w que|strong="H4310"\w* puedan \w presentar|strong="H7725"\w* ofrendas de cereales y \w libaciones|strong="H5262"\w* \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*.   
\q1
\v 15 ¡Toquen la \w trompeta|strong="H7782"\w* en \w Sión|strong="H6726"\w*!  
\q2 Proclamen un tiempo de \w ayuno|strong="H6685"\w*;  
\q2 convoquen \w a|strong="H3068"\w* una asamblea solemne.   
\q1
\v 16 Reúnan al \w pueblo|strong="H5971"\w*.  
\q2 Purifiquen \w a|strong="H3068"\w* la asamblea.  
\q2 Junten \w a|strong="H3068"\w* los \w ancianos|strong="H2205"\w*,  
\q2 y reúnan \w a|strong="H3068"\w* los \w niños|strong="H5768"\w*, ¡hasta \w a|strong="H3068"\w* los bebés \w de|strong="H5971"\w* pecho!  
\q1 \w Que|strong="H5971"\w* el novio \w salga|strong="H3318"\w* \w de|strong="H5971"\w* su cuarto,  
\q2 y la novia \w de|strong="H5971"\w* su habitación.   
\q1
\v 17 \w Que|strong="H4100"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H5921"\w* servidores \w de|strong="H5921"\w* Yahvé, \w lloren|strong="H1058"\w* \w entre|strong="H5921"\w* \w el|strong="H5921"\w* pórtico \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*,  
\q2 \w y|strong="H5921"\w* \w que|strong="H4100"\w* digan: “Perdona \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*, Yahvé.  
\q2 \w No|strong="H5921"\w* \w entregues|strong="H5414"\w* tu propiedad \w a|strong="H3068"\w* \w la|strong="H5921"\w* vergüenza,  
\q2 \w para|strong="H5921"\w* \w que|strong="H4100"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w no|strong="H5921"\w* \w se|strong="H5921"\w* burlen \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\q1 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* habrían \w de|strong="H5921"\w* decir \w entre|strong="H5921"\w* \w los|strong="H5921"\w* \w pueblos|strong="H5971"\w*:  
\q2 ‘\w Dónde|strong="H5921"\w* \w está|strong="H5921"\w* su \w Dios|strong="H3068"\w*’?”   
\q1
\v 18 Entonces Yahvé \w se|strong="H5921"\w* llenó \w de|strong="H5921"\w* amor \w por|strong="H5921"\w* su tierra,  
\q2 \w y|strong="H5921"\w* tuvo compasión \w de|strong="H5921"\w* su \w pueblo|strong="H5971"\w*.   
\q1
\v 19 \w Y|strong="H3068"\w* Yahvé le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w*:  
\q2 “Miren, les \w enviaré|strong="H7971"\w* \w grano|strong="H1715"\w*, \w vino|strong="H8492"\w* nuevo y \w aceite|strong="H3323"\w*,  
\q2 hasta \w que|strong="H3808"\w* queden satisfechos;  
\q2 y \w no|strong="H3808"\w* volveré \w a|strong="H3068"\w* permitir \w que|strong="H3808"\w* las \w naciones|strong="H1471"\w* los humillen.   
\q1
\v 20 Alejaré \w de|strong="H5921"\w* ustedes \w al|strong="H5921"\w* ejército \w del|strong="H5921"\w* norte,  
\q2 \w y|strong="H3588"\w* \w lo|strong="H5921"\w* empujaré \w hacia|strong="H6213"\w* una tierra \w seca|strong="H6723"\w* \w y|strong="H3588"\w* \w desolada|strong="H8077"\w*;  
\q2 \w su|strong="H3588"\w* vanguardia \w irá|strong="H5927"\w* \w hacia|strong="H6213"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* oriental,  
\q2 \w y|strong="H3588"\w* \w su|strong="H3588"\w* retaguardia \w hacia|strong="H6213"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w occidental|strong="H3220"\w*.  
\q2 \w Su|strong="H3588"\w* hedor \w subirá|strong="H5927"\w* \w al|strong="H5921"\w* cielo,  
\q2 \w y|strong="H3588"\w* \w su|strong="H3588"\w* olor \w a|strong="H3068"\w* podrido \w se|strong="H5921"\w* elevará”.  
\q1 ¡\w Ciertamente|strong="H3588"\w* \w el|strong="H5921"\w* Señor ha \w hecho|strong="H6213"\w* \w grandes|strong="H1431"\w* cosas!   
\q1
\v 21 \w No|strong="H6213"\w* tengas \w miedo|strong="H3372"\w*, tierra mía;  
\q2 \w alégrate|strong="H1523"\w* \w y|strong="H3588"\w* \w haz|strong="H6213"\w* fiesta, \w porque|strong="H3588"\w* Yahvé ha \w hecho|strong="H6213"\w* \w grandes|strong="H1431"\w* cosas.   
