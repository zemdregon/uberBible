\m
\v 14 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Bigvai: \w Utai|strong="H5793"\w* y Zabud, y \w con|strong="H5973"\w* ellos 70 \w hombres|strong="H1121"\w*.   
\p
\v 15 Reuní \w a|strong="H3068"\w* toda \w esta|strong="H8033"\w* \w gente|strong="H5971"\w* \w junto|strong="H6908"\w* al canal \w que|strong="H3808"\w* corre \w hacia|strong="H8033"\w* Ahava, y acampamos \w allí|strong="H8033"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*. Al revisar \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, me di cuenta \w de|strong="H1121"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w había|strong="H4672"\w* \w ni|strong="H3808"\w* un solo levita.  
\v 16 Entonces llamé \w a|strong="H3068"\w* los líderes Eliezer, Ariel, \w Semaías|strong="H8098"\w*, Elnatán, \w Jarib|strong="H3402"\w*, Elnatán, Natán, \w Zacarías|strong="H2148"\w* y Mesulam, y también \w a|strong="H3068"\w* los maestros \w Joiarib|strong="H3114"\w* y Elnatán.  
\v 17 \w Los|strong="H5921"\w* \w envié|strong="H7760"\w* \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H5921"\w* Iddo, \w que|strong="H5921"\w* era \w el|strong="H5921"\w* \w jefe|strong="H7218"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* localidad \w de|strong="H5921"\w* Casifia. \w Les|strong="H5921"\w* \w dije|strong="H1696"\w* exactamente \w lo|strong="H1697"\w* \w que|strong="H5921"\w* debían decirles \w a|strong="H3068"\w* Iddo \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus parientes, \w los|strong="H5921"\w* servidores \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w en|strong="H5921"\w* ese \w lugar|strong="H4725"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w nos|strong="H5921"\w* enviaran servidores \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* nuestro Dios.  
\v 18 \w Como|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* bondadosa \w de|strong="H5921"\w* nuestro Dios estaba \w con|strong="H5921"\w* \w nosotros|strong="H5921"\w*, \w nos|strong="H5921"\w* enviaron \w a|strong="H3068"\w* \w Serebías|strong="H8274"\w*, un \w hombre|strong="H1121"\w* muy capaz, descendiente \w de|strong="H5921"\w* Mahli, quien \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Leví|strong="H3878"\w* \w y|strong="H5921"\w* \w nieto|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Él|strong="H5921"\w* vino \w con|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* hermanos, 18 \w hombres|strong="H1121"\w* \w en|strong="H5921"\w* total.  
\v 19 También enviaron \w a|strong="H3068"\w* \w Hasabías|strong="H2811"\w* y \w a|strong="H3068"\w* \w Jesaías|strong="H3470"\w*, \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Merari|strong="H4847"\w*, junto con sus hermanos y sus \w hijos|strong="H1121"\w*, 20 \w hombres|strong="H1121"\w* más.  
\v 20 \w Además|strong="H4480"\w*, enviaron \w a|strong="H3068"\w* 220 servidores \w del|strong="H4480"\w* templo. \w Estos|strong="H3605"\w* eran trabajadores \w que|strong="H4480"\w* \w David|strong="H1732"\w* y sus oficiales habían asignado \w para|strong="H4480"\w* ayudar \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*. \w Todos|strong="H3605"\w* \w ellos|strong="H4480"\w* \w fueron|strong="H1732"\w* registrados \w por|strong="H4480"\w* \w nombre|strong="H8034"\w*.   
\p
\v 21 \w Allí|strong="H8033"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Ahava, ordené un \w ayuno|strong="H6685"\w* \w para|strong="H5921"\w* \w que|strong="H4480"\w* \w nos|strong="H5921"\w* humilláramos \w ante|strong="H6440"\w* nuestro Dios \w y|strong="H5921"\w* \w le|strong="H5921"\w* pidiéramos \w que|strong="H4480"\w* \w nos|strong="H5921"\w* guiara \w por|strong="H5921"\w* un buen \w camino|strong="H1870"\w* \w a|strong="H3068"\w* \w nosotros|strong="H3605"\w*, \w a|strong="H3068"\w* nuestros hijos \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* nuestras pertenencias.  
\v 22 \w Me|strong="H4480"\w* dio vergüenza pedirle \w al|strong="H5921"\w* \w rey|strong="H4428"\w* una escolta \w de|strong="H4480"\w* soldados \w y|strong="H3588"\w* caballería \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w nos|strong="H5921"\w* protegieran \w de|strong="H4480"\w* \w los|strong="H5921"\w* enemigos \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w*, \w porque|strong="H3588"\w* ya \w le|strong="H5921"\w* habíamos dicho \w al|strong="H5921"\w* \w rey|strong="H4428"\w*: “Nuestro Dios protege \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* confían \w en|strong="H5921"\w* \w él|strong="H5921"\w*, \w pero|strong="H3588"\w* \w su|strong="H3588"\w* \w poder|strong="H3027"\w* \w y|strong="H3588"\w* \w su|strong="H3588"\w* enojo \w se|strong="H5921"\w* descargan \w contra|strong="H5921"\w* quienes \w lo|strong="H5921"\w* \w abandonan|strong="H5800"\w*”.  
\v 23 \w Así|strong="H2063"\w* \w que|strong="H5921"\w* \w ayunamos|strong="H6684"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* rogamos \w a|strong="H3068"\w* nuestro Dios \w por|strong="H5921"\w* nuestra seguridad, \w y|strong="H5921"\w* \w él|strong="H5921"\w* escuchó nuestra oración.   
\p
\v 24 Seleccioné \w a|strong="H3068"\w* \w doce|strong="H8147"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w sacerdotes|strong="H3548"\w* \w principales|strong="H8269"\w*: \w a|strong="H3068"\w* \w Serebías|strong="H8274"\w*, \w a|strong="H3068"\w* \w Hasabías|strong="H2811"\w* y \w a|strong="H3068"\w* \w diez|strong="H6235"\w* \w de|strong="H5973"\w* sus parientes.  
\v 25 \w Pesé|strong="H8254"\w* delante \w de|strong="H8269"\w* \w ellos|strong="H1992"\w* \w la|strong="H3605"\w* \w plata|strong="H3701"\w*, \w el|strong="H3605"\w* \w oro|strong="H2091"\w* y \w los|strong="H1992"\w* utensilios \w que|strong="H1992"\w* \w el|strong="H3605"\w* \w rey|strong="H4428"\w*, \w sus|strong="H1992"\w* \w consejeros|strong="H3289"\w*, \w sus|strong="H1992"\w* oficiales y \w todos|strong="H3605"\w* \w los|strong="H1992"\w* israelitas habían dado como \w ofrenda|strong="H8641"\w* para \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w de|strong="H8269"\w* nuestro Dios.  
\v 26 \w Les|strong="H5921"\w* entregué bajo inventario: 22,000 kilos \w de|strong="H5921"\w* \w plata|strong="H3701"\w*, 3,400 kilos \w en|strong="H5921"\w* utensilios \w de|strong="H5921"\w* \w plata|strong="H3701"\w*, 3,400 kilos \w de|strong="H5921"\w* \w oro|strong="H2091"\w*,  
\v 27 20 copas de \w oro|strong="H2091"\w* que valían 1,000 monedas de \w oro|strong="H2091"\w* (dracmas), y \w dos|strong="H8147"\w* vasijas de bronce fino y brillante, tan valiosas como el \w oro|strong="H2091"\w*.  
\v 28 Luego les dije: “Ustedes están consagrados \w a|strong="H3068"\w* Yahvé, y estos utensilios también son \w sagrados|strong="H6944"\w*. La \w plata|strong="H3701"\w* y el \w oro|strong="H2091"\w* son una ofrenda \w voluntaria|strong="H5071"\w* para Yahvé, el \w Dios|strong="H3068"\w* de sus antepasados.  
\v 29 Vigilen estos tesoros \w y|strong="H5704"\w* cuídenlos \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* los pesen \w ante|strong="H6440"\w* los \w jefes|strong="H8269"\w* \w de|strong="H6440"\w* los \w sacerdotes|strong="H3548"\w*, los \w levitas|strong="H3881"\w* \w y|strong="H5704"\w* los líderes \w de|strong="H6440"\w* las \w familias|strong="H1004"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w en|strong="H5704"\w* Jerusalén, \w en|strong="H5704"\w* las habitaciones del \w templo|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé”.   
\p
\v 30 Así que los \w sacerdotes|strong="H3548"\w* y los \w levitas|strong="H3881"\w* se hicieron cargo de la \w plata|strong="H3701"\w*, el \w oro|strong="H2091"\w* y los utensilios que yo había pesado, \w para|strong="H4948"\w* llevarlos \w a|strong="H3068"\w* Jerusalén, al \w templo|strong="H1004"\w* de nuestro Dios.   
\p
\v 31 \w El|strong="H5921"\w* día \w doce|strong="H8147"\w* \w del|strong="H5921"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w* partimos \w del|strong="H5921"\w* \w río|strong="H5104"\w* Ahava \w hacia|strong="H1870"\w* Jerusalén. Nuestro Dios \w nos|strong="H5921"\w* protegió durante \w el|strong="H5921"\w* \w viaje|strong="H1870"\w* \w y|strong="H5921"\w* \w nos|strong="H5921"\w* \w libró|strong="H5337"\w* \w de|strong="H5921"\w* enemigos \w y|strong="H5921"\w* \w de|strong="H5921"\w* asaltantes \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w*.  
\v 32 \w Cuando|strong="H3117"\w* llegamos \w a|strong="H3068"\w* Jerusalén, descansamos \w tres|strong="H7969"\w* \w días|strong="H3117"\w*.  
\v 33 \w Al|strong="H5921"\w* \w cuarto|strong="H7243"\w* \w día|strong="H3117"\w*, pesamos \w la|strong="H5921"\w* \w plata|strong="H3701"\w*, \w el|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w los|strong="H1121"\w* utensilios \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* nuestro Dios \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w los|strong="H1121"\w* entregamos \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Meremot \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Urías. \w Con|strong="H5973"\w* \w él|strong="H5921"\w* estaban Eleazar \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Finehas, \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w Jozabad|strong="H3107"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Jesúa|strong="H3442"\w* \w y|strong="H5921"\w* Noadías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Binúi.  
\v 34 \w Se|strong="H1931"\w* contó y \w se|strong="H1931"\w* \w pesó|strong="H4948"\w* \w cada|strong="H3605"\w* objeto, y \w el|strong="H1931"\w* \w peso|strong="H4948"\w* total quedó registrado en \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* momento.   
\p
\v 35 Entonces \w los|strong="H1121"\w* \w que|strong="H5921"\w* habían regresado \w del|strong="H5921"\w* \w cautiverio|strong="H1473"\w* ofrecieron \w holocaustos|strong="H5930"\w* \w al|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: 12 \w toros|strong="H6499"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, 96 carneros, 77 \w corderos|strong="H3532"\w* \w y|strong="H5921"\w* 12 \w machos|strong="H6842"\w* cabríos \w como|strong="H5921"\w* sacrificio \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pecado|strong="H2403"\w*. \w Todo|strong="H3605"\w* esto fue un \w holocausto|strong="H5930"\w* \w para|strong="H5921"\w* Yahvé.  
\v 36 Después entregaron las órdenes del \w rey|strong="H4428"\w* \w a|strong="H3068"\w* los representantes \w reales|strong="H4428"\w* y \w a|strong="H3068"\w* los \w gobernadores|strong="H6346"\w* \w de|strong="H5971"\w* la provincia \w al|strong="H4428"\w* otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w*, quienes brindaron su apoyo \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w* y \w al|strong="H4428"\w* \w templo|strong="H1004"\w* \w de|strong="H5971"\w* Dios.   
\c 9  
\p
\v 1 Después \w de|strong="H5971"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* terminaron estos asuntos, los líderes \w se|strong="H3808"\w* acercaron \w a|strong="H3068"\w* decirme: “\w El|strong="H5066"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*, incluso los \w sacerdotes|strong="H3548"\w* y los \w levitas|strong="H3881"\w*, \w no|strong="H3808"\w* \w se|strong="H3808"\w* han mantenido separados \w de|strong="H5971"\w* los \w pueblos|strong="H5971"\w* \w de|strong="H5971"\w* la región. Al contrario, han adoptado las prácticas detestables \w de|strong="H5971"\w* los \w cananeos|strong="H3669"\w*, los hititas, los ferezeos, los \w jebuseos|strong="H2983"\w*, los amonitas, los moabitas, los \w egipcios|strong="H4713"\w* y los amorreos.  
\v 2 Han permitido \w que|strong="H3588"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* \w se|strong="H1961"\w* casen \w con|strong="H3588"\w* \w las|strong="H1992"\w* \w hijas|strong="H1323"\w* \w de|strong="H3588"\w* esos \w pueblos|strong="H5971"\w*. \w De|strong="H3588"\w* \w esta|strong="H2088"\w* manera, \w la|strong="H3588"\w* \w descendencia|strong="H2233"\w* \w santa|strong="H6944"\w* \w se|strong="H1961"\w* ha mezclado \w con|strong="H3588"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w* \w de|strong="H3588"\w* \w estas|strong="H2088"\w* tierras. ¡\w Y|strong="H3068"\w* \w los|strong="H1992"\w* líderes \w y|strong="H3588"\w* oficiales han \w sido|strong="H1961"\w* \w los|strong="H1992"\w* \w primeros|strong="H7223"\w* \w en|strong="H3588"\w* cometer \w esta|strong="H2088"\w* infidelidad!”.   
\p
\v 3 Cuando \w escuché|strong="H8085"\w* \w esto|strong="H2088"\w*, \w rasgué|strong="H7167"\w* mi ropa y mi túnica en señal \w de|strong="H1697"\w* dolor, me arranqué \w los|strong="H3427"\w* pelos \w de|strong="H1697"\w* la \w cabeza|strong="H7218"\w* y \w de|strong="H1697"\w* la \w barba|strong="H2206"\w*, y me senté angustiado.  
\v 4 \w Todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* temían \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w a|strong="H3068"\w* \w causa|strong="H1697"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* infidelidad \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* habían regresado \w del|strong="H5921"\w* exilio \w se|strong="H5921"\w* reunieron conmigo. \w Y|strong="H3068"\w* yo \w me|strong="H5921"\w* \w quedé|strong="H3427"\w* allí \w sentado|strong="H3427"\w*, \w en|strong="H5921"\w* estado \w de|strong="H5921"\w* shock, \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* hora \w del|strong="H5921"\w* sacrificio \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w*.   
\p
\v 5 \w Al|strong="H5921"\w* llegar \w el|strong="H5921"\w* sacrificio \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w*, salí \w de|strong="H5921"\w* \w mi|strong="H5921"\w* estado \w de|strong="H5921"\w* abatimiento. \w Con|strong="H5921"\w* \w mi|strong="H5921"\w* ropa \w y|strong="H5921"\w* \w mi|strong="H5921"\w* túnica todavía rasgadas, caí \w de|strong="H5921"\w* \w rodillas|strong="H1290"\w*, \w extendí|strong="H6566"\w* mis \w manos|strong="H3709"\w* \w hacia|strong="H5921"\w* Yahvé \w mi|strong="H5921"\w* \w Dios|strong="H3068"\w*  
\v 6 \w y|strong="H3588"\w* le dije: “Dios mío, \w me|strong="H3588"\w* siento tan \w avergonzado|strong="H3637"\w* \w y|strong="H3588"\w* humillado \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w me|strong="H3588"\w* atrevo \w a|strong="H3068"\w* levantar \w el|strong="H3588"\w* \w rostro|strong="H6440"\w* \w hacia|strong="H6440"\w* ti. Nuestras \w maldades|strong="H5771"\w* han \w crecido|strong="H1431"\w* \w tanto|strong="H7235"\w* \w que|strong="H3588"\w* nos cubren \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*, \w y|strong="H3588"\w* nuestra culpa llega \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w*.  
\v 7 \w Desde|strong="H5704"\w* el \w tiempo|strong="H3117"\w* \w de|strong="H6440"\w* nuestros antepasados \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, nuestra culpa ha sido enorme. \w Por|strong="H6440"\w* nuestros \w pecados|strong="H5771"\w*, nosotros, nuestros \w reyes|strong="H4428"\w* \w y|strong="H5704"\w* nuestros \w sacerdotes|strong="H3548"\w* hemos sido entregados \w a|strong="H3068"\w* los \w reyes|strong="H4428"\w* \w de|strong="H6440"\w* otros países; hemos sufrido la muerte, el \w cautiverio|strong="H7628"\w*, el saqueo \w y|strong="H5704"\w* la deshonra, \w tal|strong="H2088"\w* \w como|strong="H5704"\w* nos sucede \w hoy|strong="H3117"\w*.  
\v 8 “Pero \w ahora|strong="H6258"\w*, \w por|strong="H5414"\w* un breve \w momento|strong="H7281"\w*, Yahvé nuestro \w Dios|strong="H3068"\w* ha \w sido|strong="H1961"\w* bondadoso con nosotros al permitir \w que|strong="H6258"\w* un grupo regrese del cautiverio y al darnos un \w lugar|strong="H4725"\w* seguro en su \w santuario|strong="H6944"\w*. Nuestro \w Dios|strong="H3068"\w* ha \w dado|strong="H5414"\w* nueva luz \w a|strong="H3068"\w* nuestros \w ojos|strong="H5869"\w* y nos ha \w dado|strong="H5414"\w* un \w poco|strong="H4592"\w* \w de|strong="H5414"\w* alivio en medio \w de|strong="H5414"\w* nuestra esclavitud.  
\v 9 \w Aunque|strong="H3588"\w* somos esclavos, nuestro Dios \w no|strong="H3808"\w* \w nos|strong="H5921"\w* \w ha|strong="H3808"\w* abandonado. \w Él|strong="H5921"\w* \w hizo|strong="H5414"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w* \w nos|strong="H5921"\w* mostraran \w su|strong="H3588"\w* apoyo \w para|strong="H5921"\w* \w que|strong="H3588"\w* pudiéramos recuperar \w el|strong="H5921"\w* ánimo, reconstruir \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* nuestro Dios, restaurar sus ruinas \w y|strong="H3588"\w* tener protección \w en|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* Jerusalén.   
\p
\v 10 “\w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, Dios nuestro, ¿\w qué|strong="H3588"\w* podemos decir después \w de|strong="H3588"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* ha pasado? Una vez \w más|strong="H3588"\w* hemos desobedecido tus \w mandamientos|strong="H4687"\w*,  
\v 11 \w los|strong="H1931"\w* cuales nos diste \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H5971"\w* tus \w siervos|strong="H5650"\w* \w los|strong="H1931"\w* \w profetas|strong="H5030"\w* \w cuando|strong="H5650"\w* dijiste: “\w La|strong="H1931"\w* tierra \w que|strong="H1931"\w* ustedes van \w a|strong="H3068"\w* poseer \w es|strong="H1931"\w* una tierra impura, contaminada \w por|strong="H3027"\w* las prácticas detestables \w de|strong="H5971"\w* \w los|strong="H1931"\w* \w pueblos|strong="H5971"\w* \w que|strong="H1931"\w* viven allí; \w ellos|strong="H3027"\w* \w la|strong="H1931"\w* han llenado \w de|strong="H5971"\w* \w inmundicia|strong="H2932"\w* \w de|strong="H5971"\w* un extremo \w a|strong="H3068"\w* otro.  
\v 12 \w Por|strong="H4616"\w* \w lo|strong="H3808"\w* tanto, \w no|strong="H3808"\w* den sus \w hijas|strong="H1323"\w* \w en|strong="H5704"\w* matrimonio \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* ellos, \w ni|strong="H3808"\w* permitan \w que|strong="H3808"\w* sus \w hijos|strong="H1121"\w* \w se|strong="H3808"\w* casen \w con|strong="H5704"\w* las \w hijas|strong="H1323"\w* \w de|strong="H5704"\w* ellos. \w No|strong="H3808"\w* busquen \w jamás|strong="H5769"\w* la \w paz|strong="H7965"\w* \w ni|strong="H3808"\w* la prosperidad \w de|strong="H5704"\w* esos pueblos. \w Si|strong="H3808"\w* cumplen esto, serán \w fuertes|strong="H1121"\w*, disfrutarán \w de|strong="H5704"\w* \w lo|strong="H3808"\w* \w mejor|strong="H2896"\w* \w de|strong="H5704"\w* la tierra \w y|strong="H5704"\w* \w se|strong="H3808"\w* la dejarán \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w como|strong="H5704"\w* herencia \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*”.   
\p
\v 13 “\w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w nos|strong="H5921"\w* ha sucedido \w por|strong="H5921"\w* nuestras \w malas|strong="H7451"\w* acciones \w y|strong="H3588"\w* \w por|strong="H5921"\w* nuestra \w gran|strong="H1419"\w* culpa \w y|strong="H3588"\w* sabiendo \w que|strong="H3588"\w* tú, Dios nuestro, \w nos|strong="H5921"\w* \w has|strong="H5414"\w* castigado \w menos|strong="H3588"\w* \w de|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* merecemos \w y|strong="H3588"\w* \w nos|strong="H5921"\w* \w has|strong="H5414"\w* permitido sobrevivir \w como|strong="H3588"\w* \w este|strong="H2063"\w* grupo \w que|strong="H3588"\w* somos,  
\v 14 ¿\w cómo|strong="H5704"\w* \w es|strong="H8441"\w* posible \w que|strong="H3808"\w* \w volvamos|strong="H7725"\w* \w a|strong="H3068"\w* desobedecer tus \w mandamientos|strong="H4687"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* casarnos \w con|strong="H5704"\w* personas \w que|strong="H3808"\w* cometen estas cosas tan detestables? ¿\w No|strong="H3808"\w* te enojarías \w con|strong="H5704"\w* nosotros \w hasta|strong="H5704"\w* destruirnos \w por|strong="H5704"\w* completo, \w sin|strong="H3808"\w* dejar \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* sobreviva \w o|strong="H3068"\w* escape?  
\v 15 Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, tú eres \w justo|strong="H6662"\w*. \w Por|strong="H5921"\w* \w eso|strong="H2063"\w* \w hoy|strong="H3117"\w* todavía quedamos algunos sobrevivientes. \w Aquí|strong="H2088"\w* estamos \w ante|strong="H6440"\w* \w ti|strong="H5921"\w*, reconociendo nuestra culpa, \w aunque|strong="H3588"\w* \w por|strong="H5921"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* \w ella|strong="H5921"\w* nadie puede sostenerse \w en|strong="H5921"\w* tu \w presencia|strong="H6440"\w*”.   
\c 10  
\p
\v 1 \w Mientras|strong="H3588"\w* \w Esdras|strong="H5830"\w* oraba \w y|strong="H3588"\w* confesaba sus pecados, \w llorando|strong="H1058"\w* \w y|strong="H3588"\w* \w postrado|strong="H5307"\w* \w ante|strong="H6440"\w* \w el|strong="H3588"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Dios, una \w gran|strong="H3966"\w* \w multitud|strong="H6951"\w* \w de|strong="H3588"\w* hombres, mujeres \w y|strong="H3588"\w* \w niños|strong="H3206"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w se|strong="H5971"\w* reunió \w a|strong="H3068"\w* \w su|strong="H3588"\w* alrededor, \w pues|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w lloraba|strong="H1058"\w* \w amargamente|strong="H1058"\w*.  
\v 2 Entonces Secanías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Jehiel|strong="H3171"\w*, uno \w de|strong="H5921"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H5921"\w* \w Elam|strong="H5867"\w*, \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Esdras|strong="H5830"\w*: “Hemos sido infieles \w a|strong="H3068"\w* nuestro Dios \w al|strong="H5921"\w* casarnos \w con|strong="H5921"\w* mujeres \w extranjeras|strong="H5237"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w* \w vecinos|strong="H3427"\w*. Pero, \w a|strong="H3068"\w* pesar \w de|strong="H5921"\w* \w esto|strong="H2063"\w*, todavía \w hay|strong="H3426"\w* \w esperanza|strong="H4723"\w* \w para|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 3 \w Hagamos|strong="H6213"\w* \w ahora|strong="H6258"\w* un \w pacto|strong="H1285"\w* con nuestro Dios y comprometámonos \w a|strong="H3068"\w* despedir \w a|strong="H3068"\w* \w todas|strong="H3605"\w* esas mujeres y \w a|strong="H3068"\w* \w los|strong="H1992"\w* hijos nacidos de \w ellas|strong="H1992"\w*, siguiendo \w tu|strong="H6213"\w* \w consejo|strong="H6098"\w*, mi señor, y \w el|strong="H3605"\w* de \w los|strong="H1992"\w* \w que|strong="H6258"\w* respetan \w el|strong="H3605"\w* \w mandamiento|strong="H4687"\w* de nuestro Dios. ¡\w Que|strong="H6258"\w* \w se|strong="H1992"\w* cumpla \w lo|strong="H6213"\w* \w que|strong="H6258"\w* dice \w la|strong="H3605"\w* \w ley|strong="H8451"\w*!  
\v 4 \w Levántate|strong="H6965"\w*, \w pues|strong="H3588"\w* \w es|strong="H3588"\w* \w tu|strong="H6213"\w* responsabilidad guiar este \w asunto|strong="H1697"\w*, \w y|strong="H3588"\w* \w nosotros|strong="H5973"\w* \w te|strong="H5921"\w* apoyaremos. Ten valor \w y|strong="H3588"\w* pon manos \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w obra|strong="H6213"\w*”.   
\p
\v 5 Entonces \w Esdras|strong="H5830"\w* se \w levantó|strong="H6965"\w* \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* jurar \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H1697"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w*, \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w que|strong="H1697"\w* harían \w lo|strong="H1697"\w* \w que|strong="H1697"\w* se \w había|strong="H6213"\w* propuesto. \w Y|strong="H3068"\w* \w ellos|strong="H3605"\w* \w lo|strong="H1697"\w* \w juraron|strong="H7650"\w*.  
\v 6 Luego \w Esdras|strong="H5830"\w* \w se|strong="H5921"\w* retiró \w de|strong="H5921"\w* \w la|strong="H5921"\w* entrada \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios \w y|strong="H3588"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* habitación \w de|strong="H5921"\w* \w Johanán|strong="H3076"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Eliasib. \w Mientras|strong="H3588"\w* estuvo \w allí|strong="H8033"\w*, \w no|strong="H3808"\w* comió \w nada|strong="H3808"\w* \w ni|strong="H3808"\w* \w bebió|strong="H8354"\w* \w agua|strong="H4325"\w*, \w porque|strong="H3588"\w* \w estaba|strong="H1004"\w* muy triste \w por|strong="H5921"\w* \w la|strong="H5921"\w* infidelidad \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w que|strong="H3588"\w* habían regresado \w del|strong="H5921"\w* exilio.  
\v 7 Después se envió un anuncio por \w todo|strong="H3605"\w* \w Judá|strong="H3063"\w* y Jerusalén para \w que|strong="H1121"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* exiliados se reunieran en Jerusalén.  
\v 8 \w Se|strong="H1931"\w* advirtió \w que|strong="H1931"\w* \w aquel|strong="H1931"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* presentara en un plazo \w de|strong="H8269"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, según \w el|strong="H1931"\w* acuerdo \w de|strong="H8269"\w* \w los|strong="H3605"\w* líderes y \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w*, perdería \w todas|strong="H3605"\w* \w sus|strong="H1931"\w* propiedades y sería expulsado \w de|strong="H8269"\w* \w la|strong="H1931"\w* comunidad \w de|strong="H8269"\w* \w los|strong="H3605"\w* exiliados.   
\p
\v 9 \w Así|strong="H1931"\w* \w que|strong="H1931"\w*, \w en|strong="H5921"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w Benjamín|strong="H1144"\w* \w se|strong="H1931"\w* reunieron \w en|strong="H5921"\w* Jerusalén. \w Era|strong="H1931"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w veinte|strong="H6242"\w* \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w noveno|strong="H8671"\w*. \w Todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1931"\w* sentó \w en|strong="H5921"\w* \w la|strong="H1931"\w* plaza \w que|strong="H1931"\w* \w estaba|strong="H3427"\w* frente \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios, \w temblando|strong="H7460"\w* \w de|strong="H5921"\w* miedo \w por|strong="H5921"\w* \w la|strong="H1931"\w* gravedad \w del|strong="H5921"\w* \w asunto|strong="H1697"\w* \w y|strong="H5921"\w* \w porque|strong="H5921"\w* \w no|strong="H5921"\w* dejaba \w de|strong="H5921"\w* llover.   
\p
\v 10 \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Esdras|strong="H5830"\w* \w se|strong="H5921"\w* puso \w de|strong="H5921"\w* pie \w y|strong="H5921"\w* \w les|strong="H5921"\w* dijo: “Ustedes han pecado \w al|strong="H5921"\w* casarse \w con|strong="H5921"\w* mujeres \w extranjeras|strong="H5237"\w*, \w y|strong="H5921"\w* \w con|strong="H5921"\w* eso han aumentado \w la|strong="H5921"\w* culpa \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 11 \w Ahora|strong="H6258"\w*, confiesen su pecado ante Yahvé, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* sus antepasados, y cumplan su \w voluntad|strong="H7522"\w*. Sepárense \w de|strong="H4480"\w* la \w gente|strong="H5971"\w* \w de|strong="H4480"\w* \w esta|strong="H7522"\w* tierra y \w de|strong="H4480"\w* sus esposas \w extranjeras|strong="H5237"\w*”.   
\p
\v 12 \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* \w voz|strong="H6963"\w* \w en|strong="H5921"\w* cuello: “¡Tienes razón! Debemos \w hacer|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* \w nos|strong="H5921"\w* has \w dicho|strong="H1697"\w*.  
\v 13 \w Pero|strong="H3588"\w* somos \w mucha|strong="H7227"\w* \w gente|strong="H5971"\w* \w y|strong="H3588"\w* estamos \w en|strong="H3588"\w* plena temporada \w de|strong="H3588"\w* \w lluvias|strong="H1653"\w*; \w no|strong="H3808"\w* podemos quedarnos \w aquí|strong="H2088"\w* \w afuera|strong="H2351"\w*. \w Además|strong="H3588"\w*, \w este|strong="H2088"\w* \w no|strong="H3808"\w* \w es|strong="H2088"\w* un \w asunto|strong="H1697"\w* \w de|strong="H3588"\w* uno \w o|strong="H3068"\w* \w dos|strong="H8147"\w* \w días|strong="H3117"\w*, \w pues|strong="H3588"\w* somos \w muchos|strong="H7227"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* hemos cometido \w este|strong="H2088"\w* pecado.  
\v 14 Deja \w que|strong="H4480"\w* nuestros líderes representen \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad. \w Que|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w que|strong="H4480"\w* \w en|strong="H4480"\w* nuestras \w ciudades|strong="H5892"\w* \w se|strong="H4480"\w* hayan casado \w con|strong="H5973"\w* \w mujeres|strong="H5704"\w* \w extranjeras|strong="H5237"\w* vengan \w en|strong="H4480"\w* fechas programadas, acompañados \w por|strong="H4480"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w y|strong="H5704"\w* \w los|strong="H3427"\w* \w jueces|strong="H8199"\w* \w de|strong="H4480"\w* sus \w ciudades|strong="H5892"\w*, \w hasta|strong="H5704"\w* \w que|strong="H4480"\w* \w la|strong="H3605"\w* ardiente \w ira|strong="H2740"\w* \w de|strong="H4480"\w* nuestro Dios \w por|strong="H4480"\w* \w este|strong="H2088"\w* \w asunto|strong="H1697"\w* \w se|strong="H4480"\w* \w aparte|strong="H5973"\w* \w de|strong="H4480"\w* \w nosotros|strong="H3605"\w*”.   
\p
\v 15 Solo Jonatán \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Asahel \w y|strong="H5921"\w* Jazahías \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ticva \w se|strong="H5921"\w* opusieron \w a|strong="H3068"\w* \w esta|strong="H2063"\w* propuesta, apoyados \w por|strong="H5921"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* Mesulam \w y|strong="H5921"\w* Sabetai.   
\p
\v 16 \w Así|strong="H3651"\w* \w que|strong="H1697"\w* \w los|strong="H3427"\w* exiliados cumplieron con \w lo|strong="H1697"\w* acordado. \w El|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w Esdras|strong="H5830"\w* seleccionó \w a|strong="H3068"\w* varios \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* \w familia|strong="H1004"\w*, representando \w a|strong="H3068"\w* \w cada|strong="H3605"\w* linaje, y \w los|strong="H3427"\w* registró \w por|strong="H1697"\w* \w nombre|strong="H8034"\w*. \w El|strong="H3605"\w* \w primer|strong="H7218"\w* \w día|strong="H3117"\w* del \w mes|strong="H2320"\w* \w décimo|strong="H6224"\w* \w se|strong="H3651"\w* \w sentaron|strong="H3427"\w* para investigar \w cada|strong="H3605"\w* caso.  
\v 17 \w Para|strong="H5704"\w* \w el|strong="H3605"\w* \w primer|strong="H7223"\w* \w día|strong="H3117"\w* del \w mes|strong="H2320"\w* \w primero|strong="H7223"\w*, ya habían terminado \w de|strong="H5704"\w* revisar \w los|strong="H3427"\w* casos \w de|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hombres \w que|strong="H5704"\w* se habían casado \w con|strong="H5704"\w* \w mujeres|strong="H5704"\w* \w extranjeras|strong="H5237"\w*.   
\p
\v 18 \w Esta|strong="H3427"\w* es la lista \w de|strong="H1121"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H1121"\w* \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H1121"\w* se habían casado con mujeres \w extranjeras|strong="H5237"\w*:  
\m \w De|strong="H1121"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H1121"\w* \w Jesúa|strong="H3442"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Josadac y sus parientes: \w Maasías|strong="H4641"\w*, Eliezer, \w Jarib|strong="H3402"\w* y \w Gedalías|strong="H1436"\w*.  
\v 19 \w Ellos|strong="H3027"\w* \w se|strong="H5921"\w* comprometieron \w a|strong="H3068"\w* divorciarse \w de|strong="H5921"\w* sus mujeres, \w y|strong="H5921"\w* \w como|strong="H5921"\w* eran culpables, ofrecieron un carnero \w como|strong="H5921"\w* sacrificio \w por|strong="H5921"\w* su pecado.   
\m
