\v 30 \w Los|strong="H1121"\w* \w de|strong="H1121"\w* Magbis: 156.  
\v 31 \w Los|strong="H1121"\w* del otro \w Elam|strong="H5867"\w*: 1,254.  
\v 32 \w Los|strong="H1121"\w* \w de|strong="H1121"\w* \w Harim|strong="H2766"\w*: 320.  
\v 33 \w Los|strong="H1121"\w* \w de|strong="H2568"\w* \w Lod|strong="H3850"\w*, \w Hadid|strong="H2307"\w* y Ono: 725.  
\v 34 \w Los|strong="H1121"\w* \w de|strong="H2568"\w* \w Jericó|strong="H3405"\w*: 345.  
\v 35 \w Los|strong="H1121"\w* \w de|strong="H1121"\w* Senaa: 3,630.   
\p
\v 36 \w Los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*: \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Jedaías|strong="H3048"\w* (\w de|strong="H1121"\w* la \w familia|strong="H1004"\w* \w de|strong="H1121"\w* \w Jesúa|strong="H3442"\w*): 973.  
\v 37 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Imer: 1,052.  
\v 38 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Pasur: 1,247.  
\v 39 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Harim|strong="H2766"\w*: 1,017.   
\p
\v 40 \w Los|strong="H1121"\w* \w levitas|strong="H3881"\w*: \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Jesúa|strong="H3442"\w* y \w Cadmiel|strong="H6934"\w* (\w de|strong="H1121"\w* la línea \w de|strong="H1121"\w* Hodavías): 74.  
\v 41 \w Los|strong="H1121"\w* \w cantores|strong="H7891"\w*: \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Asaf: 128.  
\v 42 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w porteros|strong="H7778"\w*: \w los|strong="H1121"\w* \w de|strong="H1121"\w* Salum, Ater, \w Talmón|strong="H2929"\w*, Acub, Hatita y Sobai: 139 en total.   
\p
\v 43 \w Los|strong="H1121"\w* sirvientes del templo: \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Ziha, Hasufa, Tabaot,  
\v 44 Querós, Siaha, Padón,  
\v 45 Lebana, Hagaba, Acub,  
\v 46 Hagab, Samlai, \w Hanán|strong="H2605"\w*,  
\v 47 Gidel, Gahar, Reaía,  
\v 48 \w Rezín|strong="H7526"\w*, Necoda, Gazam,  
\v 49 Uza, Paseah, Besai,  
\v 50 Asena, Meunim, Nefisim,  
\v 51 Bacbuc, Hacufa, Harhur,  
\v 52 Bazlut, Mehída, Harsa,  
\v 53 Barcos, \w Sísara|strong="H5516"\w*, Tema,  
\v 54 Nezía y Hatifa.   
\p
\v 55 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w siervos|strong="H5650"\w* \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*: \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Sotai, Ha-soferet, Peruda,  
\v 56 Jaala, Darcón, Gidel,  
\v 57 Sefatías, Hatil, Poqueret Haze-bayim y Amí.  
\v 58 \w El|strong="H3605"\w* total \w de|strong="H1121"\w* \w los|strong="H1121"\w* sirvientes del templo y \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w siervos|strong="H5650"\w* \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w* fue \w de|strong="H1121"\w* 392.   
\p
\v 59 \w Los|strong="H1992"\w* siguientes regresaron de \w las|strong="H1992"\w* poblaciones de Tel Melá, Tel Harsa, Querub, Adán \w e|strong="H3068"\w* Imer, pero \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* demostrar \w su|strong="H1992"\w* ascendencia \w ni|strong="H3808"\w* \w su|strong="H1992"\w* \w linaje|strong="H2233"\w*\f + \fr 2:59 \ft es decir, su origen familiar.\f* para probar \w que|strong="H3808"\w* \w eran|strong="H3808"\w* israelitas:  
\v 60 \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Delaía, \w Tobías|strong="H2900"\w* y Necoda: 652.  
\v 61 \w Y|strong="H3068"\w* \w entre|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*: \w los|strong="H1121"\w* descendientes \w de|strong="H5921"\w* Habaía, Coz \w y|strong="H5921"\w* Barzilai (quien \w se|strong="H5921"\w* \w casó|strong="H3947"\w* \w con|strong="H5921"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* \w de|strong="H5921"\w* Barzilai \w el|strong="H5921"\w* \w galaadita|strong="H1569"\w* \w y|strong="H5921"\w* adoptó ese apellido).  
\v 62 \w Ellos|strong="H4480"\w* \w buscaron|strong="H1245"\w* sus nombres \w en|strong="H4480"\w* los registros genealógicos, pero como \w no|strong="H3808"\w* los encontraron, \w se|strong="H3808"\w* les consideró impuros y \w se|strong="H3808"\w* les excluyó \w del|strong="H4480"\w* \w sacerdocio|strong="H3550"\w*.  
\v 63 El gobernador les \w ordenó|strong="H5975"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* comieran \w de|strong="H5704"\w* los alimentos \w sagrados|strong="H6944"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* un \w sacerdote|strong="H3548"\w* consultara el Urim \w y|strong="H5704"\w* el Tumim.   
\p
\v 64 \w La|strong="H3605"\w* asamblea total era de 42,360 personas,  
\v 65 sin contar \w a|strong="H3068"\w* sus \w siervos|strong="H5650"\w* y siervas, \w que|strong="H7651"\w* eran 7,337; también tenían 200 \w cantores|strong="H7891"\w* y cantoras.  
\v 66 Tenían 736 \w caballos|strong="H5483"\w*, 245 mulas,  
\v 67 435 \w camellos|strong="H1581"\w* y 6,720 burros.   
\p
\v 68 \w Al|strong="H5921"\w* llegar \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w en|strong="H5921"\w* Jerusalén, algunos \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* \w familia|strong="H1004"\w* dieron ofrendas voluntarias \w para|strong="H5921"\w* reconstruir \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w en|strong="H5921"\w* su mismo sitio.  
\v 69 Según sus posibilidades, entregaron al tesoro \w para|strong="H5414"\w* la \w obra|strong="H4399"\w*: 61,000 \w monedas|strong="H3701"\w* \w de|strong="H2568"\w* \w oro|strong="H2091"\w* (dáricos),\f + \fr 2:69 \ft Un dárico era una moneda de oro persa que pesaba unos 8.4 gramos.\f* cerca \w de|strong="H2568"\w* 3,000 kilos \w de|strong="H2568"\w* \w plata|strong="H3701"\w* (5,000 minas)\f + \fr 2:69 \ft Una mina equivalía aproximadamente a medio kilo de plata.\f* y 100 \w túnicas|strong="H3801"\w* \w para|strong="H5414"\w* los \w sacerdotes|strong="H3548"\w*.   
\p
\v 70 Así, \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w levitas|strong="H3881"\w*, \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w*, \w los|strong="H3427"\w* \w cantores|strong="H7891"\w*, \w los|strong="H3427"\w* \w porteros|strong="H7778"\w* y \w los|strong="H3427"\w* sirvientes \w del|strong="H4480"\w* templo \w se|strong="H4480"\w* establecieron \w en|strong="H4480"\w* sus propias \w ciudades|strong="H5892"\w*, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* resto \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w se|strong="H4480"\w* instaló también \w en|strong="H4480"\w* sus \w poblaciones|strong="H5892"\w*.   
\c 3  
\p
\v 1 Cuando \w llegó|strong="H5060"\w* \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, y ya \w los|strong="H1121"\w* israelitas \w se|strong="H5971"\w* habían instalado en sus \w ciudades|strong="H5892"\w*, todo \w el|strong="H1121"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* reunió en Jerusalén \w con|strong="H5060"\w* un mismo propósito.  
\v 2 Entonces \w Jesúa|strong="H3442"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Josadac, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus parientes \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Salatiel \w con|strong="H5921"\w* sus familiares, \w se|strong="H5921"\w* dispusieron \w a|strong="H3068"\w* construir \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* ofrecer \w holocaustos|strong="H5930"\w*, tal \w como|strong="H5921"\w* \w se|strong="H5921"\w* ordena \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w*, \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* Dios.  
\v 3 \w A|strong="H3068"\w* pesar \w de|strong="H5921"\w* \w que|strong="H3588"\w* tenían miedo \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* alrededores, reconstruyeron \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w sobre|strong="H5921"\w* \w su|strong="H3588"\w* antigua base \w y|strong="H3588"\w* comenzaron \w a|strong="H3068"\w* ofrecer \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé todas \w las|strong="H5921"\w* mañanas \w y|strong="H3588"\w* todas \w las|strong="H5921"\w* tardes.  
\v 4 También celebraron la \w fiesta|strong="H2282"\w* \w de|strong="H1697"\w* las Enramadas, como \w está|strong="H3789"\w* \w escrito|strong="H3789"\w*, ofreciendo \w cada|strong="H3117"\w* \w día|strong="H3117"\w* \w el|strong="H6213"\w* \w número|strong="H4557"\w* \w de|strong="H1697"\w* \w holocaustos|strong="H5930"\w* exigido \w por|strong="H1697"\w* la ley para \w cada|strong="H3117"\w* jornada.  
\v 5 Después de eso, establecieron \w el|strong="H3605"\w* \w holocausto|strong="H5930"\w* diario y las ofrendas para las fiestas de luna nueva y para \w todas|strong="H3605"\w* las fiestas sagradas de Yahvé, además de las ofrendas \w que|strong="H5071"\w* \w el|strong="H3605"\w* pueblo presentaba \w voluntariamente|strong="H5068"\w* \w a|strong="H3068"\w* Yahvé.  
\v 6 Empezaron \w a|strong="H3068"\w* ofrecer \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé desde el primer \w día|strong="H3117"\w* del \w mes|strong="H2320"\w* \w séptimo|strong="H7637"\w*, \w aunque|strong="H3808"\w* todavía \w no|strong="H3808"\w* \w se|strong="H3808"\w* habían \w puesto|strong="H5927"\w* los \w cimientos|strong="H3245"\w* del \w templo|strong="H1964"\w* de Yahvé.  
\v 7 \w Para|strong="H5921"\w* esto, contrataron \w albañiles|strong="H2796"\w* \w y|strong="H5921"\w* \w carpinteros|strong="H2796"\w*, \w y|strong="H5921"\w* \w les|strong="H5921"\w* pagaron \w con|strong="H5921"\w* \w dinero|strong="H3701"\w*. También entregaron \w comida|strong="H3978"\w*, bebida \w y|strong="H5921"\w* \w aceite|strong="H8081"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* habitantes \w de|strong="H4480"\w* Sidón \w y|strong="H5921"\w* Tiro \w a|strong="H3068"\w* cambio \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w les|strong="H5921"\w* trajeran \w madera|strong="H6086"\w* \w de|strong="H4480"\w* cedro \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w Líbano|strong="H3844"\w* \w por|strong="H5921"\w* \w mar|strong="H3220"\w* \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* puerto \w de|strong="H4480"\w* Jope, \w pues|strong="H4480"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w Ciro|strong="H3566"\w* \w de|strong="H4480"\w* \w Persia|strong="H6539"\w* así \w lo|strong="H5921"\w* había autorizado.   
\p
\v 8 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w* \w del|strong="H5921"\w* \w segundo|strong="H8145"\w* \w año|strong="H8141"\w* \w después|strong="H5921"\w* \w de|strong="H5921"\w* haber llegado \w al|strong="H5921"\w* lugar \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w* \w en|strong="H5921"\w* Jerusalén, \w Zorobabel|strong="H2216"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Salatiel \w y|strong="H5921"\w* \w Jesúa|strong="H3442"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Josadac iniciaron \w los|strong="H1121"\w* trabajos \w con|strong="H5921"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* sus parientes: \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* habían regresado \w del|strong="H5921"\w* \w cautiverio|strong="H7628"\w*. Nombraron \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* mayores \w de|strong="H5921"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* \w para|strong="H5921"\w* supervisar \w la|strong="H5921"\w* construcción \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 9 Así \w que|strong="H5921"\w* \w Jesúa|strong="H3442"\w*, sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* sus hermanos, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w Cadmiel|strong="H6934"\w* \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* (descendientes \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*), \w se|strong="H5921"\w* unieron \w para|strong="H5921"\w* coordinar \w a|strong="H3068"\w* \w los|strong="H1121"\w* trabajadores \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Dios. \w A|strong="H3068"\w* \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* \w les|strong="H5921"\w* unieron \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Henadad \w con|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* sus hermanos \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*.   
\p
\v 10 Cuando \w los|strong="H1121"\w* constructores terminaron \w de|strong="H5921"\w* poner \w los|strong="H1121"\w* \w cimientos|strong="H3245"\w* \w del|strong="H5921"\w* \w templo|strong="H1964"\w* \w de|strong="H5921"\w* Yahvé, \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w vestidos|strong="H3847"\w* \w con|strong="H5921"\w* sus trajes especiales, ocuparon sus lugares \w con|strong="H5921"\w* \w trompetas|strong="H2689"\w*, \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* Asaf \w con|strong="H5921"\w* platillos, \w para|strong="H5921"\w* \w alabar|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé, siguiendo \w las|strong="H5921"\w* instrucciones \w que|strong="H5921"\w* \w había|strong="H5975"\w* dejado \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 11 Cantaban \w con|strong="H5921"\w* alabanzas \w y|strong="H3588"\w* acción \w de|strong="H5921"\w* gracias \w a|strong="H3068"\w* Yahvé: “\w Porque|strong="H3588"\w* \w él|strong="H5921"\w* \w es|strong="H3588"\w* \w bueno|strong="H2896"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* amor \w por|strong="H5921"\w* \w Israel|strong="H3478"\w* \w es|strong="H3588"\w* \w eterno|strong="H5769"\w*”. \w Y|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* lanzaba fuertes \w gritos|strong="H8643"\w* \w de|strong="H5921"\w* alegría \w y|strong="H3588"\w* \w alabanza|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* ya \w se|strong="H5921"\w* habían \w puesto|strong="H3588"\w* \w los|strong="H5921"\w* \w cimientos|strong="H3245"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w templo|strong="H1004"\w*.   
\p
\v 12 Sin embargo, \w muchos|strong="H7227"\w* \w de|strong="H5869"\w* los \w sacerdotes|strong="H3548"\w*, \w levitas|strong="H3881"\w* y \w jefes|strong="H7218"\w* \w de|strong="H5869"\w* \w familia|strong="H1004"\w* \w que|strong="H2088"\w* eran \w ya|strong="H2088"\w* \w ancianos|strong="H2205"\w* y \w que|strong="H2088"\w* habían \w visto|strong="H7200"\w* el \w primer|strong="H7218"\w* \w templo|strong="H1004"\w*, \w lloraban|strong="H1058"\w* \w a|strong="H3068"\w* \w gritos|strong="H8643"\w* al \w ver|strong="H7200"\w* los \w cimientos|strong="H3245"\w* \w de|strong="H5869"\w* \w este|strong="H2088"\w* nuevo \w templo|strong="H1004"\w*. Al mismo tiempo, \w muchos|strong="H7227"\w* otros gritaban \w de|strong="H5869"\w* \w alegría|strong="H8057"\w*.  
\v 13 \w No|strong="H3588"\w* \w se|strong="H5971"\w* podía distinguir \w entre|strong="H3588"\w* \w los|strong="H3588"\w* \w gritos|strong="H8643"\w* \w de|strong="H3588"\w* \w alegría|strong="H8057"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w llanto|strong="H1065"\w* del \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w ruido|strong="H6963"\w* era ensordecedor \w y|strong="H3588"\w* \w se|strong="H5971"\w* \w escuchaba|strong="H8085"\w* \w desde|strong="H5704"\w* muy \w lejos|strong="H7350"\w*.   
\c 4  
\p
\v 1 \w Cuando|strong="H3588"\w* \w los|strong="H1121"\w* \w enemigos|strong="H6862"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w Benjamín|strong="H1144"\w* se enteraron \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1121"\w* \w que|strong="H3588"\w* habían regresado del \w cautiverio|strong="H1473"\w* estaban reconstruyendo \w el|strong="H3588"\w* \w templo|strong="H1964"\w* \w de|strong="H3588"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*,  
\v 2 \w fueron|strong="H5927"\w* \w a|strong="H3068"\w* hablar \w con|strong="H5973"\w* \w Zorobabel|strong="H2216"\w* \w y|strong="H3588"\w* \w con|strong="H5973"\w* \w los|strong="H1992"\w* \w jefes|strong="H7218"\w* \w de|strong="H3588"\w* familia \w y|strong="H3588"\w* \w les|strong="H1992"\w* dijeron: “Permítannos construir \w con|strong="H5973"\w* ustedes, \w pues|strong="H3588"\w* \w nosotros|strong="H5973"\w* también buscamos \w al|strong="H4428"\w* Dios \w de|strong="H3588"\w* ustedes \w y|strong="H3588"\w* \w le|strong="H5973"\w* hemos ofrecido \w sacrificios|strong="H2076"\w* desde \w el|strong="H5973"\w* \w tiempo|strong="H3117"\w* \w en|strong="H5973"\w* \w que|strong="H3588"\w* Esar-hadón, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria, nos trajo \w a|strong="H3068"\w* vivir \w aquí|strong="H6311"\w*”.   
\p
\v 3 \w Pero|strong="H3588"\w* \w Zorobabel|strong="H2216"\w*, \w Jesúa|strong="H3442"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* demás \w jefes|strong="H7218"\w* \w de|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w les|strong="H6680"\w* respondieron: “Ustedes \w no|strong="H3808"\w* tienen \w nada|strong="H3808"\w* \w que|strong="H3588"\w* ver \w con|strong="H3588"\w* nosotros \w en|strong="H3588"\w* \w la|strong="H3588"\w* construcción del \w templo|strong="H1004"\w* \w a|strong="H3068"\w* nuestro \w Dios|strong="H3068"\w*. Nosotros \w solos|strong="H3162"\w* \w lo|strong="H3808"\w* construiremos \w para|strong="H3588"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, tal \w como|strong="H3588"\w* nos \w lo|strong="H3808"\w* \w ordenó|strong="H6680"\w* \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Persia|strong="H6539"\w*”.   
\p
\v 4 Entonces la \w gente|strong="H5971"\w* \w de|strong="H5971"\w* la región empezó \w a|strong="H3068"\w* desanimar al \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* \w Judá|strong="H3063"\w* y \w a|strong="H3068"\w* atemorizarlos \w para|strong="H1961"\w* \w que|strong="H5971"\w* dejaran \w de|strong="H5971"\w* construir.  
\v 5 Incluso sobornaron \w a|strong="H3068"\w* algunos \w consejeros|strong="H6098"\w* \w para|strong="H5704"\w* frustrar sus planes; esto duró \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H5921"\w* \w Ciro|strong="H3566"\w* fue \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w* \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* comenzó \w el|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* \w Darío|strong="H1867"\w*.  
\v 6 \w Más|strong="H5921"\w* tarde, \w al|strong="H5921"\w* comienzo \w del|strong="H5921"\w* \w reinado|strong="H4438"\w* \w de|strong="H5921"\w* Asuero, \w escribieron|strong="H3789"\w* una acusación formal \w contra|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Jerusalén.   
\p
\v 7 También \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Artajerjes, hombres llamados \w Bislam|strong="H1312"\w*, \w Mitrídates|strong="H4990"\w* \w y|strong="H5921"\w* \w Tabeel|strong="H2870"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus compañeros, \w le|strong="H5921"\w* \w escribieron|strong="H3789"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* Artajerjes \w de|strong="H5921"\w* \w Persia|strong="H6539"\w*. \w La|strong="H5921"\w* carta estaba \w escrita|strong="H3789"\w* \w en|strong="H5921"\w* caracteres arameos \w y|strong="H5921"\w* traducida \w al|strong="H5921"\w* idioma sirio.  
\v 8 \w Rehum|strong="H7348"\w*, el gobernador, y Simsai, el \w secretario|strong="H5613"\w*, \w escribieron|strong="H3790"\w* otra carta \w al|strong="H5922"\w* \w rey|strong="H4430"\w* Artajerjes \w contra|strong="H5922"\w* Jerusalén \w de|strong="H5922"\w* la siguiente manera:  
\v 9 “\w De|strong="H1768"\w* parte \w de|strong="H1768"\w* \w Rehum|strong="H7348"\w*, el gobernador, y Simsai, el \w secretario|strong="H5613"\w*, y sus demás compañeros: los jueces y oficiales \w de|strong="H1768"\w* Persia, \w de|strong="H1768"\w* Erech, \w de|strong="H1768"\w* Babilonia y \w de|strong="H1768"\w* Susa (es decir, los elamitas),  
\v 10 y \w de|strong="H1768"\w* las otras naciones \w que|strong="H1768"\w* el gran Osnapar deportó \w e|strong="H3068"\w* instaló en las ciudades \w de|strong="H1768"\w* Samaria y en el resto \w de|strong="H1768"\w* la provincia al otro lado del río...”.   
\p
\v 11 \w Esta|strong="H1836"\w* es la copia \w de|strong="H5922"\w* la carta \w que|strong="H1768"\w* le \w enviaron|strong="H7972"\w*:  
\b  
\mi “\w Al|strong="H5922"\w* \w rey|strong="H4430"\w* Artajerjes, \w de|strong="H5922"\w* parte \w de|strong="H5922"\w* sus servidores, los habitantes \w de|strong="H5922"\w* la provincia \w al|strong="H5922"\w* otro lado del río:   
\mi
\v 12 “Queremos informarle \w al|strong="H5922"\w* \w rey|strong="H4430"\w* \w que|strong="H1768"\w* los \w judíos|strong="H3062"\w* \w que|strong="H1768"\w* salieron \w de|strong="H4481"\w* \w su|strong="H1934"\w* reino y vinieron \w a|strong="H3068"\w* Jerusalén están reconstruyendo esa \w ciudad|strong="H7149"\w* \w rebelde|strong="H4779"\w* y malvada. \w Ya|strong="H3068"\w* están terminando las murallas y reparando los cimientos.  
\v 13 Debe \w saber|strong="H3046"\w* \w el|strong="H1934"\w* \w rey|strong="H4430"\w* \w que|strong="H1768"\w*, \w si|strong="H2006"\w* se reconstruye \w esta|strong="H1791"\w* \w ciudad|strong="H7149"\w* \w y|strong="H3809"\w* se terminan \w sus|strong="H1934"\w* murallas, ellos dejarán \w de|strong="H1768"\w* pagar tributos, impuestos \w y|strong="H3809"\w* peajes, lo cual terminará perjudicando los ingresos reales.  
\v 14 \w Como|strong="H6903"\w* nosotros estamos \w al|strong="H5922"\w* servicio del palacio \w y|strong="H3809"\w* \w no|strong="H3809"\w* queremos ver \w que|strong="H1768"\w* se deshonre \w al|strong="H5922"\w* \w rey|strong="H4430"\w*, le enviamos \w este|strong="H1836"\w* informe  
\v 15 \w para|strong="H5922"\w* \w que|strong="H1768"\w* se investigue \w en|strong="H5922"\w* los archivos \w de|strong="H4481"\w* sus antepasados. Allí encontrará \w que|strong="H1768"\w* \w esta|strong="H1836"\w* ha sido siempre \w una|strong="H5648"\w* \w ciudad|strong="H7149"\w* \w rebelde|strong="H4779"\w* y perjudicial \w para|strong="H5922"\w* los \w reyes|strong="H4430"\w* y las provincias, y \w que|strong="H1768"\w* desde tiempos antiguos ha provocado revueltas. \w Por|strong="H4481"\w* esa razón fue destruida.  
\v 16 Le advertimos al \w rey|strong="H4430"\w* \w que|strong="H1768"\w*, \w si|strong="H2006"\w* \w esta|strong="H1836"\w* \w ciudad|strong="H7149"\w* es reconstruida \w y|strong="H3809"\w* se terminan sus murallas, usted perderá todo control sobre la provincia al otro lado del río”.   
\b  
\p
\v 17 El \w rey|strong="H4430"\w* \w envió|strong="H7972"\w* entonces esta \w respuesta|strong="H6600"\w* \w a|strong="H3068"\w* \w Rehum|strong="H7348"\w*, el gobernador, \w a|strong="H3068"\w* Simsai, el \w secretario|strong="H5613"\w*, y \w al|strong="H5922"\w* resto \w de|strong="H5922"\w* sus compañeros \w que|strong="H1768"\w* vivían \w en|strong="H5922"\w* Samaria y \w en|strong="H5922"\w* la provincia \w al|strong="H5922"\w* otro lado del río:  
\b  
\mi “\w Paz|strong="H8001"\w* y bienestar.   
\b  
\mi
\v 18 “La carta \w que|strong="H1768"\w* nos \w enviaron|strong="H7972"\w* ha sido leída y traducida \w en|strong="H5922"\w* \w mi|strong="H6925"\w* presencia.  
\v 19 Ordené \w que|strong="H1768"\w* se investigara, y se confirmó \w que|strong="H1768"\w*, desde \w hace|strong="H5648"\w* mucho \w tiempo|strong="H3118"\w*, esa \w ciudad|strong="H7149"\w* se ha levantado \w contra|strong="H5922"\w* los \w reyes|strong="H4430"\w* y ha sido lugar \w de|strong="H4481"\w* rebeliones y revueltas.  
\v 20 Jerusalén tuvo \w reyes|strong="H4430"\w* poderosos \w que|strong="H5922"\w* dominaron \w toda|strong="H3606"\w* la región \w al|strong="H5922"\w* \w otro|strong="H3606"\w* lado del río, y \w a|strong="H3068"\w* quienes se les pagaban tributos, impuestos y peajes.  
\v 21 \w Por|strong="H4481"\w* tanto, den una \w orden|strong="H2942"\w* para \w que|strong="H5705"\w* esos \w hombres|strong="H1400"\w* detengan la obra. Esa \w ciudad|strong="H7149"\w* \w no|strong="H3809"\w* debe ser reconstruida \w hasta|strong="H5705"\w* \w que|strong="H5705"\w* yo lo ordene.  
\v 22 Asegúrense \w de|strong="H5922"\w* no ser negligentes \w en|strong="H5922"\w* \w este|strong="H1836"\w* asunto, \w para|strong="H5922"\w* \w que|strong="H4101"\w* no sigan aumentando los daños \w en|strong="H5922"\w* perjuicio \w de|strong="H5922"\w* la corona”.   
\b  
\p
\v 23 \w En|strong="H5922"\w* cuanto se leyó la copia \w de|strong="H4481"\w* la carta \w del|strong="H4481"\w* \w rey|strong="H4430"\w* Artajerjes ante \w Rehum|strong="H7348"\w*, el \w secretario|strong="H5613"\w* Simsai y sus compañeros, estos fueron \w de|strong="H4481"\w* prisa \w a|strong="H3068"\w* Jerusalén y obligaron \w a|strong="H3068"\w* \w los|strong="H1994"\w* \w judíos|strong="H3062"\w*, \w por|strong="H4481"\w* la fuerza \w de|strong="H4481"\w* las armas, \w a|strong="H3068"\w* detener la construcción.  
\v 24 Así se detuvo \w el|strong="H1934"\w* trabajo \w en|strong="H5705"\w* \w el|strong="H1934"\w* templo \w de|strong="H1768"\w* Dios \w en|strong="H5705"\w* Jerusalén, y la obra quedó suspendida \w hasta|strong="H5705"\w* \w el|strong="H1934"\w* \w segundo|strong="H8648"\w* \w año|strong="H8140"\w* del reinado \w de|strong="H1768"\w* \w Darío|strong="H1868"\w*, \w rey|strong="H4430"\w* \w de|strong="H1768"\w* Persia.   
\c 5  
\p
\v 1 \w En|strong="H5922"\w* aquel tiempo, los profetas Hageo y \w Zacarías|strong="H2148"\w* \w hijo|strong="H1247"\w* \w de|strong="H5922"\w* \w Iddo|strong="H5714"\w* hablaron \w en|strong="H5922"\w* \w nombre|strong="H8036"\w* del Dios \w de|strong="H5922"\w* \w Israel|strong="H3479"\w* \w a|strong="H3068"\w* los \w judíos|strong="H3062"\w* \w que|strong="H1768"\w* vivían \w en|strong="H5922"\w* \w Judá|strong="H3061"\w* y Jerusalén.  
\v 2 Al oír esto, \w Zorobabel|strong="H2217"\w* \w hijo|strong="H1247"\w* \w de|strong="H1768"\w* Salatiel y Jesúa \w hijo|strong="H1247"\w* \w de|strong="H1768"\w* Josadac se pusieron \w a|strong="H3068"\w* trabajar y comenzaron \w de|strong="H1768"\w* nuevo la reconstrucción del templo \w de|strong="H1768"\w* Dios en Jerusalén. Los \w profetas|strong="H5029"\w* \w de|strong="H1768"\w* Dios estaban \w con|strong="H5974"\w* ellos y los apoyaban.   
\p
\v 3 Pero pronto \w Tatnai|strong="H8674"\w*, el \w gobernador|strong="H6347"\w* \w de|strong="H5922"\w* la provincia \w al|strong="H5922"\w* otro lado del río, junto con Setar-boznai y sus compañeros, se presentaron ante ellos y les preguntaron: “¿\w Quién|strong="H4479"\w* les \w dio|strong="H7761"\w* permiso \w para|strong="H5922"\w* reconstruir \w este|strong="H1836"\w* templo y terminar estas murallas?”.  
\v 4 También les pidieron los nombres \w de|strong="H1768"\w* los \w hombres|strong="H1400"\w* \w que|strong="H1768"\w* estaban dirigiendo la obra.  
\v 5 \w Sin|strong="H3809"\w* embargo, Dios cuidaba \w de|strong="H5922"\w* \w los|strong="H1994"\w* ancianos \w de|strong="H5922"\w* \w los|strong="H1994"\w* \w judíos|strong="H3062"\w*, \w y|strong="H3809"\w* \w los|strong="H1994"\w* oficiales \w no|strong="H3809"\w* \w los|strong="H1994"\w* obligaron \w a|strong="H3068"\w* detenerse; prefirieron enviar un informe \w al|strong="H5922"\w* rey \w Darío|strong="H1868"\w* \w y|strong="H3809"\w* esperar \w su|strong="H1934"\w* respuesta oficial.   
\p
\v 6 Esta es la copia \w de|strong="H5922"\w* la carta \w que|strong="H1768"\w* \w Tatnai|strong="H8674"\w*, \w gobernador|strong="H6347"\w* \w de|strong="H5922"\w* la provincia \w al|strong="H5922"\w* otro lado del río, Setar-boznai y sus compañeros, los oficiales \w de|strong="H5922"\w* la región, \w enviaron|strong="H7972"\w* \w al|strong="H5922"\w* \w rey|strong="H4430"\w* \w Darío|strong="H1868"\w*.  
\v 7 El informe \w que|strong="H5922"\w* le \w enviaron|strong="H7972"\w* decía lo siguiente:  
\b  
\mi “\w Al|strong="H5922"\w* \w rey|strong="H4430"\w* \w Darío|strong="H1868"\w*, mucha \w paz|strong="H8001"\w*.   
\mi
\v 8 “Queremos informar al \w rey|strong="H4430"\w* \w que|strong="H1768"\w* fuimos \w a|strong="H3068"\w* la provincia \w de|strong="H1768"\w* \w Judá|strong="H3061"\w*, al templo del gran Dios. \w El|strong="H1934"\w* edificio se \w está|strong="H1791"\w* construyendo con piedras \w de|strong="H1768"\w* gran tamaño y se están colocando vigas \w de|strong="H1768"\w* madera en las paredes. \w El|strong="H1934"\w* trabajo se realiza con mucho cuidado y la obra avanza con rapidez.  
\v 9 “Les \w preguntamos|strong="H7593"\w* \w a|strong="H3068"\w* los ancianos que dirigían la obra: “¿\w Quién|strong="H4479"\w* les \w dio|strong="H7761"\w* autorización para reconstruir \w este|strong="H1836"\w* templo y terminar estas murallas?”.  
\v 10 También les pedimos sus nombres para informarle \w a|strong="H3068"\w* usted quiénes son sus dirigentes, y así poder ponerlos \w por|strong="H1768"\w* escrito.  
\v 11 “Ellos nos \w respondieron|strong="H8421"\w*: “Nosotros somos servidores del Dios del \w cielo|strong="H8065"\w* y \w de|strong="H1768"\w* la tierra. Estamos reconstruyendo \w el|strong="H1934"\w* templo \w que|strong="H1768"\w* fue edificado hace muchísimos \w años|strong="H8140"\w* \w por|strong="H1768"\w* un gran \w rey|strong="H4430"\w* \w de|strong="H1768"\w* \w Israel|strong="H3479"\w*, quien lo terminó \w por|strong="H1768"\w* completo.  
\v 12 Pero como nuestros antepasados hicieron enojar \w al|strong="H4481"\w* Dios \w del|strong="H4481"\w* \w cielo|strong="H8065"\w*, él permitió \w que|strong="H1768"\w* fueran derrotados \w por|strong="H4481"\w* \w Nabucodonosor|strong="H5020"\w*, \w rey|strong="H4430"\w* \w de|strong="H4481"\w* Babilonia, el \w caldeo|strong="H3679"\w*, quien destruyó \w este|strong="H1836"\w* templo y se llevó \w al|strong="H4481"\w* \w pueblo|strong="H5972"\w* cautivo \w a|strong="H3068"\w* Babilonia.  
\v 13 Sin embargo, en el primer \w año|strong="H8140"\w* \w de|strong="H1768"\w* \w Ciro|strong="H3567"\w* como \w rey|strong="H4430"\w* \w de|strong="H1768"\w* Babilonia, el propio \w rey|strong="H4430"\w* \w Ciro|strong="H3567"\w* emitió un decreto para \w que|strong="H1768"\w* \w este|strong="H1836"\w* templo \w de|strong="H1768"\w* Dios fuera reconstruido.  
\v 14 Incluso el \w rey|strong="H4430"\w* \w Ciro|strong="H3567"\w* \w sacó|strong="H5312"\w* \w del|strong="H4481"\w* \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Babilonia \w los|strong="H1994"\w* utensilios \w de|strong="H4481"\w* \w oro|strong="H1722"\w* y \w plata|strong="H3702"\w* \w que|strong="H1768"\w* \w Nabucodonosor|strong="H5020"\w* se había robado \w del|strong="H4481"\w* \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Jerusalén. \w Ciro|strong="H3567"\w* se \w los|strong="H1994"\w* \w entregó|strong="H3052"\w* \w a|strong="H3068"\w* un hombre llamado Sesbasar, \w a|strong="H3068"\w* quien había nombrado \w gobernador|strong="H6347"\w*,  
\v 15 y le ordenó: ‘\w Toma|strong="H5376"\w* estos objetos, ve y ponlos \w en|strong="H5922"\w* el \w templo|strong="H1965"\w* \w de|strong="H5922"\w* Jerusalén, y \w que|strong="H1768"\w* el \w templo|strong="H1965"\w* \w de|strong="H5922"\w* Dios sea reconstruido \w en|strong="H5922"\w* su antiguo sitio’.  
\v 16 Entonces Sesbasar vino \w y|strong="H3809"\w* puso los cimientos \w del|strong="H4481"\w* templo \w de|strong="H4481"\w* Dios \w en|strong="H5705"\w* Jerusalén. Desde entonces se ha estado trabajando \w en|strong="H5705"\w* él, pero todavía \w no|strong="H3809"\w* se termina”.   
\mi
\v 17 “\w Por|strong="H4481"\w* \w tanto|strong="H2869"\w*, \w si|strong="H2006"\w* \w al|strong="H5922"\w* \w rey|strong="H4430"\w* le parece \w bien|strong="H2869"\w*, ordene \w que|strong="H1768"\w* se investigue \w en|strong="H5922"\w* los archivos reales \w de|strong="H4481"\w* Babilonia \w para|strong="H5922"\w* ver \w si|strong="H2006"\w* existe tal decreto \w del|strong="H4481"\w* \w rey|strong="H4430"\w* \w Ciro|strong="H3567"\w* autorizando la reconstrucción \w del|strong="H4481"\w* templo \w de|strong="H4481"\w* Dios \w en|strong="H5922"\w* Jerusalén. \w Después|strong="H4481"\w*, \w por|strong="H4481"\w* favor, háganos saber su decisión \w sobre|strong="H5922"\w* \w este|strong="H1836"\w* asunto”.   
\c 6  
\p
\v 1 Entonces el \w rey|strong="H4430"\w* \w Darío|strong="H1868"\w* \w dio|strong="H7761"\w* una \w orden|strong="H2942"\w* y mandó investigar en los archivos \w de|strong="H1768"\w* Babilonia, \w donde|strong="H1768"\w* se \w guardaban|strong="H5182"\w* los tesoros.  
\v 2 \w Y|strong="H3068"\w* en el palacio \w de|strong="H1768"\w* Ecbatana, en la provincia \w de|strong="H1768"\w* Media, se encontró un pergamino \w que|strong="H1768"\w* decía lo siguiente: “Para constancia:   
\b  
\mi
\v 3 En su primer \w año|strong="H8140"\w* \w de|strong="H1768"\w* reinado, el \w rey|strong="H4430"\w* \w Ciro|strong="H3567"\w* emitió un decreto sobre el templo \w de|strong="H1768"\w* Dios en Jerusalén: “\w Que|strong="H1768"\w* el templo sea reconstruido como un lugar \w donde|strong="H1768"\w* se ofrezcan \w sacrificios|strong="H1685"\w*. \w Que|strong="H1768"\w* se pongan cimientos firmes; su \w altura|strong="H7314"\w* será \w de|strong="H1768"\w* veintisiete metros y su anchura \w de|strong="H1768"\w* veintisiete metros.  
\v 4 “Se construirán \w tres|strong="H8532"\w* hileras \w de|strong="H4481"\w* piedras grandes y una \w de|strong="H4481"\w* madera \w nueva|strong="H2323"\w*. Los gastos se pagarán con fondos \w del|strong="H4481"\w* tesoro \w real|strong="H4430"\w*.  
\v 5 “Además, los utensilios \w de|strong="H4481"\w* \w oro|strong="H1722"\w* y \w de|strong="H4481"\w* \w plata|strong="H3702"\w* \w del|strong="H4481"\w* \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Dios, \w que|strong="H1768"\w* \w Nabucodonosor|strong="H5020"\w* se llevó \w del|strong="H4481"\w* \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Jerusalén \w a|strong="H3068"\w* Babilonia, deberán ser devueltos \w a|strong="H3068"\w* su lugar original \w en|strong="H4481"\w* el \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Jerusalén. Deberán ser puestos otra vez \w en|strong="H4481"\w* el \w templo|strong="H1965"\w* \w de|strong="H4481"\w* Dios.   
\mi
\v 6 “\w Por|strong="H4481"\w* tanto, \w Tatnai|strong="H8674"\w*, \w gobernador|strong="H6347"\w* \w de|strong="H4481"\w* la provincia \w al|strong="H4481"\w* otro lado \w del|strong="H4481"\w* río, Setar-boznai y \w sus|strong="H1934"\w* compañeros, los oficiales \w de|strong="H4481"\w* esa provincia: manténganse alejados \w de|strong="H4481"\w* ese lugar.  
\v 7 Dejen \w que|strong="H5922"\w* la obra del templo \w de|strong="H5922"\w* Dios continúe. \w Que|strong="H5922"\w* el \w gobernador|strong="H6347"\w* \w de|strong="H5922"\w* los \w judíos|strong="H3062"\w* y sus ancianos reconstruyan el templo \w de|strong="H5922"\w* Dios \w en|strong="H5922"\w* su antiguo sitio.  
\v 8 “También ordeno lo \w que|strong="H1768"\w* ustedes deben hacer para ayudar \w a|strong="H3068"\w* esos ancianos \w de|strong="H4481"\w* los \w judíos|strong="H3062"\w* \w en|strong="H4481"\w* la reconstrucción: Los gastos \w de|strong="H4481"\w* estos \w hombres|strong="H1400"\w* deben ser pagados \w por|strong="H4481"\w* completo \w y|strong="H3809"\w* \w sin|strong="H3809"\w* demora \w con|strong="H5974"\w* los impuestos \w que|strong="H1768"\w* se recaudan \w en|strong="H4481"\w* la provincia \w al|strong="H4481"\w* otro lado \w del|strong="H4481"\w* río, para \w que|strong="H1768"\w* la obra \w no|strong="H3809"\w* se detenga.  
\v 9 “Todo lo \w que|strong="H1768"\w* necesiten para los sacrificios al Dios del \w cielo|strong="H8065"\w* \w ya|strong="H1768"\w* sean \w becerros|strong="H1123"\w*, \w carneros|strong="H1798"\w* \w o|strong="H3068"\w* corderos, así como \w el|strong="H1934"\w* \w trigo|strong="H2591"\w*, la \w sal|strong="H4416"\w*, \w el|strong="H1934"\w* \w vino|strong="H2562"\w* \w y|strong="H3809"\w* \w el|strong="H1934"\w* aceite \w que|strong="H1768"\w* soliciten los sacerdotes \w de|strong="H1768"\w* Jerusalén, se les debe entregar cada \w día|strong="H3118"\w* \w sin|strong="H3809"\w* falta,  
\v 10 “para \w que|strong="H1768"\w* puedan ofrecer sacrificios \w de|strong="H1768"\w* olor grato al Dios del \w cielo|strong="H8065"\w* y oren \w por|strong="H1768"\w* la vida del \w rey|strong="H4430"\w* y \w de|strong="H1768"\w* \w sus|strong="H1934"\w* \w hijos|strong="H1123"\w*.  
\v 11 “He ordenado también \w que|strong="H1768"\w*, si alguien altera \w este|strong="H1836"\w* \w decreto|strong="H6600"\w*, se le arranque \w una|strong="H5648"\w* viga \w de|strong="H4481"\w* su propia \w casa|strong="H1005"\w* y sea empalado \w en|strong="H5922"\w* ella; y \w que|strong="H1768"\w* su \w casa|strong="H1005"\w* sea convertida \w en|strong="H5922"\w* un basurero.  
\v 12 “\w Que|strong="H1768"\w* el Dios \w que|strong="H1768"\w* \w hizo|strong="H5648"\w* habitar \w allí|strong="H8536"\w* su \w nombre|strong="H8036"\w* \w destruya|strong="H4049"\w* \w a|strong="H3068"\w* cualquier \w rey|strong="H4430"\w* \w o|strong="H3068"\w* nación \w que|strong="H1768"\w* intente cambiar \w este|strong="H1791"\w* decreto \w o|strong="H3068"\w* destruir el templo \w de|strong="H1768"\w* Dios en Jerusalén. Yo, \w Darío|strong="H1868"\w*, he promulgado \w este|strong="H1791"\w* decreto. Cúmplase al pie \w de|strong="H1768"\w* la letra”.   
\b  
\p
\v 13 \w Tatnai|strong="H8674"\w*, el \w gobernador|strong="H6347"\w* \w de|strong="H1768"\w* la provincia al otro lado del río, Setar-boznai y sus compañeros cumplieron \w de|strong="H1768"\w* inmediato la orden, tal \w como|strong="H6903"\w* el \w rey|strong="H4430"\w* \w Darío|strong="H1868"\w* lo había mandado.   
\p
\v 14 Así, los ancianos \w de|strong="H4481"\w* los \w judíos|strong="H3062"\w* siguieron construyendo y progresando, animados \w por|strong="H4481"\w* el mensaje \w de|strong="H4481"\w* los \w profetas|strong="H5029"\w* Hageo y \w Zacarías|strong="H2148"\w* \w hijo|strong="H1247"\w* \w de|strong="H4481"\w* \w Iddo|strong="H5714"\w*. Terminaron la construcción conforme \w al|strong="H4481"\w* mandato \w del|strong="H4481"\w* Dios \w de|strong="H4481"\w* \w Israel|strong="H3479"\w* y \w a|strong="H3068"\w* los decretos \w de|strong="H4481"\w* \w Ciro|strong="H3567"\w*, \w Darío|strong="H1868"\w* y Artajerjes, \w reyes|strong="H4430"\w* \w de|strong="H4481"\w* Persia.  
\v 15 \w El|strong="H1932"\w* templo se terminó \w de|strong="H1768"\w* construir \w el|strong="H1932"\w* tercer \w día|strong="H3118"\w* del mes \w de|strong="H1768"\w* Adar, \w en|strong="H5705"\w* \w el|strong="H1932"\w* sexto \w año|strong="H8140"\w* del reinado del \w rey|strong="H4430"\w* \w Darío|strong="H1868"\w*.   
\p
\v 16 Entonces los israelitas sacerdotes, levitas y todos los que habían regresado del cautiverio celebraron con gran alegría la dedicación del templo de Dios.  
\v 17 \w Para|strong="H5922"\w* la dedicación ofrecieron \w cien|strong="H3969"\w* toros, \w doscientos|strong="H3969"\w* \w carneros|strong="H1798"\w* y cuatrocientos corderos. Como sacrificio \w por|strong="H5922"\w* el pecado \w de|strong="H5922"\w* \w todo|strong="H3606"\w* \w Israel|strong="H3479"\w*, ofrecieron doce machos cabríos, uno \w por|strong="H5922"\w* cada tribu \w de|strong="H5922"\w* \w Israel|strong="H3479"\w*.  
\v 18 Instalaron \w a|strong="H3068"\w* los sacerdotes y \w a|strong="H3068"\w* los levitas \w en|strong="H5922"\w* sus turnos y divisiones \w para|strong="H5922"\w* el servicio \w de|strong="H5922"\w* Dios \w en|strong="H5922"\w* Jerusalén, tal como está escrito \w en|strong="H5922"\w* el libro \w de|strong="H5922"\w* Moisés.   
\p
\v 19 \w Los|strong="H1121"\w* \w que|strong="H1121"\w* regresaron del \w cautiverio|strong="H1473"\w* celebraron la \w Pascua|strong="H6453"\w* \w el|strong="H1121"\w* \w día|strong="H1121"\w* catorce del \w mes|strong="H2320"\w* \w primero|strong="H7223"\w*.  
\v 20 \w Todos|strong="H3605"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w levitas|strong="H3881"\w* \w se|strong="H1992"\w* habían \w purificado|strong="H3588"\w* ceremonialmente \w y|strong="H3588"\w* estaban \w limpios|strong="H2889"\w*. \w Los|strong="H1992"\w* \w levitas|strong="H3881"\w* sacrificaron \w el|strong="H3588"\w* cordero \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w por|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* \w que|strong="H3588"\w* habían vuelto del \w cautiverio|strong="H1473"\w*, \w por|strong="H3588"\w* \w sus|strong="H1992"\w* parientes \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w*.  
\v 21 Así \w que|strong="H1121"\w* comieron \w la|strong="H3605"\w* Pascua tanto \w los|strong="H1121"\w* israelitas \w que|strong="H1121"\w* habían regresado como \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* se habían apartado \w de|strong="H1121"\w* las costumbres impuras \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w pueblos|strong="H1471"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* región para buscar \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 22 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* celebraron \w con|strong="H5921"\w* mucho \w gozo|strong="H8057"\w* \w la|strong="H5921"\w* \w fiesta|strong="H2282"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* panes sin levadura, \w porque|strong="H3588"\w* Yahvé \w los|strong="H5921"\w* \w había|strong="H3588"\w* llenado \w de|strong="H5921"\w* \w alegría|strong="H8057"\w* \w al|strong="H5921"\w* cambiar \w la|strong="H5921"\w* actitud \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria \w hacia|strong="H6213"\w* \w ellos|strong="H3027"\w*, dándoles fuerzas \w para|strong="H5921"\w* \w trabajar|strong="H6213"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* reconstrucción \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\c 7  
\p
\v 1 Tiempo después, durante \w el|strong="H1121"\w* \w reinado|strong="H4428"\w* \w de|strong="H1121"\w* Artajerjes, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Persia|strong="H6539"\w*, vivía un \w hombre|strong="H1121"\w* llamado \w Esdras|strong="H5830"\w*. \w Él|strong="H1121"\w* \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Seraías|strong="H8304"\w*, quien fue \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Azarías|strong="H5838"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hilcías|strong="H2518"\w*,  
\v 2 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Salum, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sadoc|strong="H6659"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajitub,  
\v 3 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amarías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Azarías|strong="H5838"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Meraiot,  
\v 4 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zerahías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Uzi, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Buqui,  
\v 5 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abisúa, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Finehas, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Eleazar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, \w el|strong="H1121"\w* \w sumo|strong="H7218"\w* \w sacerdote|strong="H3548"\w*.  
\v 6 \w Este|strong="H1931"\w* \w Esdras|strong="H5830"\w* regresó \w de|strong="H5921"\w* Babilonia. \w Era|strong="H1931"\w* un \w escriba|strong="H5608"\w* muy experto \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w ley|strong="H8451"\w* \w que|strong="H1931"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w le|strong="H1931"\w* había \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*. \w El|strong="H1931"\w* \w rey|strong="H4428"\w* \w le|strong="H1931"\w* concedió \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w pidió|strong="H1246"\w*, \w porque|strong="H5921"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w* estaba \w sobre|strong="H5921"\w* \w él|strong="H1931"\w*.  
\v 7 Junto \w con|strong="H4480"\w* Esdras, también regresaron \w a|strong="H3068"\w* Jerusalén algunos israelitas, \w sacerdotes|strong="H3548"\w*, \w levitas|strong="H3881"\w*, \w cantores|strong="H7891"\w*, \w porteros|strong="H7778"\w* y sirvientes \w del|strong="H4480"\w* templo. Esto sucedió \w en|strong="H4480"\w* \w el|strong="H1121"\w* \w séptimo|strong="H7651"\w* \w año|strong="H8141"\w* \w del|strong="H4480"\w* \w reinado|strong="H4428"\w* \w de|strong="H4480"\w* Artajerjes.  
\v 8 \w Esdras|strong="H1931"\w* llegó \w a|strong="H3068"\w* Jerusalén en \w el|strong="H1931"\w* \w mes|strong="H2320"\w* \w quinto|strong="H2549"\w* de \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w año|strong="H8141"\w*.  
\v 9 \w Había|strong="H3588"\w* salido \w de|strong="H5921"\w* Babilonia \w el|strong="H1931"\w* \w primer|strong="H7223"\w* día \w del|strong="H5921"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, \w y|strong="H3588"\w* llegó \w a|strong="H3068"\w* Jerusalén \w el|strong="H1931"\w* \w primer|strong="H7223"\w* día \w del|strong="H5921"\w* \w mes|strong="H2320"\w* \w quinto|strong="H2549"\w*, gracias \w a|strong="H3068"\w* \w que|strong="H3588"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* bondadosa \w de|strong="H5921"\w* \w su|strong="H1931"\w* Dios \w lo|strong="H1931"\w* protegía.  
\v 10 \w Esdras|strong="H5830"\w* se \w había|strong="H3588"\w* dedicado \w de|strong="H3588"\w* todo \w corazón|strong="H3824"\w* \w a|strong="H3068"\w* estudiar \w la|strong="H3588"\w* \w ley|strong="H8451"\w* \w de|strong="H3588"\w* Yahvé, \w a|strong="H3068"\w* ponerla \w en|strong="H3588"\w* práctica \w y|strong="H3588"\w* \w a|strong="H3068"\w* enseñar \w a|strong="H3068"\w* \w los|strong="H3588"\w* israelitas sus \w leyes|strong="H8451"\w* \w y|strong="H3588"\w* decretos.   
\p
\v 11 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* \w la|strong="H5921"\w* copia \w de|strong="H5921"\w* \w la|strong="H5921"\w* carta \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Artajerjes \w le|strong="H5921"\w* \w entregó|strong="H5414"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w y|strong="H5921"\w* \w escriba|strong="H5608"\w* \w Esdras|strong="H5830"\w*, autoridad \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w mandamientos|strong="H4687"\w* \w y|strong="H5921"\w* leyes \w que|strong="H5921"\w* Yahvé \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*:   
\b  
\mi
\v 12 “Artajerjes, \w rey|strong="H4430"\w* \w de|strong="H1768"\w* \w reyes|strong="H4430"\w*, al \w sacerdote|strong="H3549"\w* \w Esdras|strong="H5831"\w*, \w escriba|strong="H5613"\w* \w de|strong="H1768"\w* la ley del Dios del \w cielo|strong="H8065"\w*: Saludos.   
\mi
\v 13 “He decretado \w que|strong="H1768"\w* \w todos|strong="H3606"\w* los israelitas \w que|strong="H1768"\w* vivan \w en|strong="H4481"\w* mi \w reino|strong="H4437"\w*, incluyendo \w a|strong="H3068"\w* sus sacerdotes y levitas, \w que|strong="H1768"\w* deseen voluntariamente \w ir|strong="H1946"\w* \w contigo|strong="H5972"\w* \w a|strong="H3068"\w* Jerusalén, pueden hacerlo.  
\v 14 El \w rey|strong="H4430"\w* y sus siete consejeros te envían \w para|strong="H5922"\w* \w que|strong="H1768"\w* investigues \w cómo|strong="H6903"\w* se está cumpliendo \w en|strong="H5922"\w* \w Judá|strong="H3061"\w* y Jerusalén la ley \w de|strong="H4481"\w* tu Dios, la cual tienes \w en|strong="H5922"\w* tus manos.  
\v 15 Debes llevar contigo la \w plata|strong="H3702"\w* y el \w oro|strong="H1722"\w* \w que|strong="H1768"\w* el \w rey|strong="H4430"\w* y sus consejeros ofrecen voluntariamente al Dios \w de|strong="H1768"\w* \w Israel|strong="H3479"\w*, \w cuya|strong="H1768"\w* \w morada|strong="H4907"\w* está en Jerusalén.  
\v 16 También llevarás \w toda|strong="H3606"\w* la \w plata|strong="H3702"\w* y el \w oro|strong="H1722"\w* \w que|strong="H1768"\w* logres reunir en \w toda|strong="H3606"\w* la provincia \w de|strong="H1768"\w* Babilonia, junto \w con|strong="H5974"\w* las ofrendas voluntarias \w que|strong="H1768"\w* el \w pueblo|strong="H5972"\w* y los sacerdotes den para el templo \w de|strong="H1768"\w* su Dios en Jerusalén.  
\v 17 Con ese dinero \w comprarás|strong="H7066"\w* con mucho cuidado toros, \w carneros|strong="H1798"\w* y corderos, junto con sus respectivas ofrendas \w de|strong="H5922"\w* cereal y \w de|strong="H5922"\w* vino, \w para|strong="H5922"\w* ofrecerlos \w sobre|strong="H5922"\w* el altar del templo \w de|strong="H5922"\w* su Dios \w en|strong="H5922"\w* Jerusalén.  
\v 18 Tú \w y|strong="H5921"\w* tus hermanos podrán usar \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w plata|strong="H3702"\w* \w y|strong="H5921"\w* \w del|strong="H5921"\w* \w oro|strong="H1722"\w* \w como|strong="H5921"\w* mejor \w les|strong="H5921"\w* parezca, \w siempre|strong="H5921"\w* \w y|strong="H5921"\w* \w cuando|strong="H1768"\w* sea \w conforme|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* voluntad \w de|strong="H5921"\w* su Dios.  
\v 19 Los utensilios \w que|strong="H1768"\w* se te han entregado para el servicio del templo \w de|strong="H1768"\w* tu Dios, deberás depositarlos ante el Dios \w de|strong="H1768"\w* Jerusalén.  
\v 20 Cualquier otra cosa \w que|strong="H1768"\w* necesites para el templo \w de|strong="H4481"\w* tu Dios y \w que|strong="H1768"\w* debas pagar, puedes tomarla \w de|strong="H4481"\w* la tesorería \w real|strong="H4430"\w*.   
\mi
\v 21 “Yo, el \w rey|strong="H4430"\w* Artajerjes, ordeno \w a|strong="H3068"\w* \w todos|strong="H3606"\w* los tesoreros \w de|strong="H4481"\w* la provincia \w al|strong="H4481"\w* \w otro|strong="H3606"\w* lado \w del|strong="H4481"\w* río, \w que|strong="H1768"\w* entreguen \w de|strong="H4481"\w* inmediato \w todo|strong="H3606"\w* lo \w que|strong="H1768"\w* el \w sacerdote|strong="H3549"\w* \w Esdras|strong="H5831"\w*, \w escriba|strong="H5613"\w* \w de|strong="H4481"\w* la ley \w del|strong="H4481"\w* Dios \w del|strong="H4481"\w* \w cielo|strong="H8065"\w*, les solicite,  
\v 22 \w hasta|strong="H5705"\w* un máximo \w de|strong="H1768"\w* tres mil trescientos kilos \w de|strong="H1768"\w* \w plata|strong="H3702"\w*, \w cien|strong="H3969"\w* medidas \w de|strong="H1768"\w* \w trigo|strong="H2591"\w*, dos mil litros \w de|strong="H1768"\w* \w vino|strong="H2562"\w*, dos mil litros \w de|strong="H1768"\w* aceite \w y|strong="H3809"\w* toda la \w sal|strong="H4416"\w* \w que|strong="H1768"\w* sea necesaria.  
\v 23 \w Todo|strong="H3606"\w* lo \w que|strong="H1768"\w* \w el|strong="H1934"\w* Dios \w del|strong="H4481"\w* \w cielo|strong="H8065"\w* haya ordenado \w para|strong="H5922"\w* \w su|strong="H1934"\w* templo, debe hacerse con diligencia. No queremos \w que|strong="H1768"\w* Dios se enoje \w contra|strong="H5922"\w* nuestro \w reino|strong="H4437"\w* ni \w contra|strong="H5922"\w* nuestros \w hijos|strong="H1123"\w*.   
\mi
\v 24 “También les informamos \w que|strong="H1768"\w* \w no|strong="H3809"\w* \w está|strong="H1836"\w* permitido cobrar impuestos, tributos \w ni|strong="H3809"\w* peajes \w a|strong="H3068"\w* \w ninguno|strong="H3809"\w* \w de|strong="H5922"\w* los sacerdotes, levitas, \w cantores|strong="H2171"\w*, \w porteros|strong="H8652"\w*, sirvientes del templo \w o|strong="H3068"\w* trabajadores \w de|strong="H5922"\w* \w este|strong="H1836"\w* templo \w de|strong="H5922"\w* Dios.   
\mi
\v 25 “\w Y|strong="H3068"\w* tú, \w Esdras|strong="H5831"\w*, usa la \w sabiduría|strong="H2452"\w* \w que|strong="H1768"\w* Dios te ha dado para nombrar magistrados \w y|strong="H3809"\w* \w jueces|strong="H8200"\w* \w que|strong="H1768"\w* \w gobiernen|strong="H1934"\w* \w a|strong="H3068"\w* \w todo|strong="H3606"\w* \w el|strong="H1934"\w* \w pueblo|strong="H5972"\w* \w de|strong="H1768"\w* la provincia al \w otro|strong="H3606"\w* lado del río, es decir, \w a|strong="H3068"\w* \w todos|strong="H3606"\w* los \w que|strong="H1768"\w* conocen las leyes \w de|strong="H1768"\w* tu Dios; \w y|strong="H3809"\w* \w a|strong="H3068"\w* quienes \w no|strong="H3809"\w* las \w conozcan|strong="H3046"\w*, deberás enseñárselas.  
\v 26 \w A|strong="H3068"\w* \w todo|strong="H3606"\w* aquel \w que|strong="H1768"\w* \w no|strong="H3809"\w* cumpla la ley \w de|strong="H4481"\w* tu Dios \w y|strong="H3809"\w* la ley \w del|strong="H4481"\w* \w rey|strong="H4430"\w*, se le castigará \w de|strong="H4481"\w* inmediato, \w ya|strong="H1768"\w* \w sea|strong="H1934"\w* con la muerte, \w el|strong="H1934"\w* destierro, la confiscación \w de|strong="H4481"\w* \w sus|strong="H1934"\w* bienes \w o|strong="H3068"\w* la cárcel”.   
\b  
\p
\v 27 ¡\w Bendito|strong="H1288"\w* sea Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5414"\w* nuestros antepasados, que \w puso|strong="H5414"\w* en el \w corazón|strong="H3820"\w* del \w rey|strong="H4428"\w* el deseo \w de|strong="H5414"\w* embellecer el \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé en Jerusalén!  
\v 28 \w Dios|strong="H3068"\w* \w me|strong="H5921"\w* mostró su amor \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, sus \w consejeros|strong="H3289"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus oficiales \w poderosos|strong="H1368"\w*. \w Así|strong="H2388"\w* \w que|strong="H5921"\w* cobré \w ánimo|strong="H2388"\w*, \w porque|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w mi|strong="H5921"\w* \w Dios|strong="H3068"\w* estaba \w conmigo|strong="H5973"\w*, \w y|strong="H5921"\w* reuní \w a|strong="H3068"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* regresaran \w conmigo|strong="H5973"\w*.   
\c 8  
\p
\v 1 Estos son \w los|strong="H5973"\w* \w jefes|strong="H7218"\w* \w de|strong="H5973"\w* familia y \w los|strong="H5973"\w* antepasados \w de|strong="H5973"\w* quienes regresaron \w conmigo|strong="H5973"\w* \w de|strong="H5973"\w* Babilonia \w a|strong="H3068"\w* Jerusalén durante \w el|strong="H5973"\w* \w reinado|strong="H4428"\w* \w de|strong="H5973"\w* Artajerjes:   
\m
\v 2 \w De|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Finehas: Gersom.  
\m \w De|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Itamar: \w Daniel|strong="H1840"\w*.  
\m \w De|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w David|strong="H1732"\w*: Hatús.   
\m
\v 3 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Secanías (\w de|strong="H5973"\w* la línea \w de|strong="H5973"\w* Paros): \w Zacarías|strong="H2148"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* se registraron 150 \w hombres|strong="H1121"\w*.   
\m
\v 4 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Pahat Moab: Eliehoenai \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Zerahías, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 200 \w hombres|strong="H1121"\w*.   
\m
\v 5 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Secanías: \w el|strong="H5973"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Jahaziel|strong="H3166"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 300 \w hombres|strong="H1121"\w*.   
\m
\v 6 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* \w Adín|strong="H5720"\w*: \w Ebed|strong="H5651"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Jonatán, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 50 \w hombres|strong="H1121"\w*.   
\m
\v 7 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* \w Elam|strong="H5867"\w*: \w Jesaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Atalía|strong="H6271"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 70 \w hombres|strong="H1121"\w*.   
\m
\v 8 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Sefatías: \w Zebadías|strong="H2069"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Miguel|strong="H4317"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 80 \w hombres|strong="H1121"\w*.   
\m
\v 9 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* \w Joab|strong="H3097"\w*: \w Obadías|strong="H5662"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Jehiel|strong="H3171"\w*, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 218 \w hombres|strong="H1121"\w*.   
\m
\v 10 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Selomit: \w el|strong="H5973"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Josifías, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 160 \w hombres|strong="H1121"\w*.   
\m
\v 11 \w De|strong="H5973"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5973"\w* Bebai: \w Zacarías|strong="H2148"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Bebai, y \w con|strong="H5973"\w* \w él|strong="H5973"\w* 28 \w hombres|strong="H1121"\w*.   
\m
