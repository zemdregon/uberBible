\mt1 Esdras  
\c 1  
\p
\v 1 En \w el|strong="H3605"\w* primer \w año|strong="H8141"\w* \w de|strong="H1697"\w* \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Persia|strong="H6539"\w*, para \w que|strong="H1571"\w* se cumpliera \w la|strong="H1571"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé\f + \fr 1:1 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* \w por|strong="H1697"\w* \w boca|strong="H6310"\w* \w de|strong="H1697"\w* \w Jeremías|strong="H3414"\w*, Yahvé \w despertó|strong="H5782"\w* \w el|strong="H3605"\w* \w espíritu|strong="H7307"\w* \w de|strong="H1697"\w* \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Persia|strong="H6539"\w*, \w de|strong="H1697"\w* modo \w que|strong="H1571"\w* \w él|strong="H3605"\w* dio un anuncio \w por|strong="H1697"\w* \w todo|strong="H3605"\w* su \w reino|strong="H4438"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w lo|strong="H1697"\w* puso \w por|strong="H1697"\w* escrito, diciendo:   
\mi
\v 2 “\w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w*, dice: ‘Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w*\f + \fr 1:2 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w me|strong="H5921"\w* \w ha|strong="H3541"\w* \w dado|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* tierra; \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w ha|strong="H3541"\w* \w encargado|strong="H6485"\w* \w que|strong="H1931"\w* \w le|strong="H1931"\w* construya un \w templo|strong="H1004"\w* \w en|strong="H5921"\w* Jerusalén, \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w en|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 3 \w Cualquiera|strong="H3605"\w* \w de|strong="H5973"\w* ustedes \w que|strong="H4310"\w* pertenezca \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*, \w que|strong="H4310"\w* \w su|strong="H1931"\w* \w Dios|strong="H3068"\w* \w esté|strong="H1931"\w* \w con|strong="H5973"\w* \w él|strong="H1931"\w*, y \w suba|strong="H5927"\w* \w a|strong="H3068"\w* Jerusalén, \w en|strong="H5973"\w* \w Judá|strong="H3063"\w*, \w para|strong="H1961"\w* reconstruir \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Yahvé, \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w* (\w él|strong="H1931"\w* \w es|strong="H1931"\w* \w Dios|strong="H3068"\w*), \w que|strong="H4310"\w* \w está|strong="H1931"\w* \w en|strong="H5973"\w* Jerusalén.  
\v 4 \w A|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* sobrevivientes, \w en|strong="H5973"\w* \w cualquier|strong="H3605"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* vivan, \w que|strong="H1931"\w* \w la|strong="H1931"\w* gente \w de|strong="H5973"\w* \w su|strong="H1931"\w* localidad \w los|strong="H3605"\w* ayude \w con|strong="H5973"\w* \w plata|strong="H3701"\w*, \w oro|strong="H2091"\w*, bienes y ganado, además \w de|strong="H5973"\w* las ofrendas \w voluntarias|strong="H5071"\w* \w para|strong="H5973"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Dios \w en|strong="H5973"\w* Jerusalén’”.   
\p
\v 5 Entonces \w los|strong="H3605"\w* \w jefes|strong="H7218"\w* de \w familia|strong="H1004"\w* de \w Judá|strong="H3063"\w* y de \w Benjamín|strong="H1144"\w*, junto con \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w todos|strong="H3605"\w* \w aquellos|strong="H3605"\w* en quienes \w Dios|strong="H3068"\w* \w despertó|strong="H5782"\w* \w el|strong="H3605"\w* deseo de ir, se prepararon para \w subir|strong="H5927"\w* \w a|strong="H3068"\w* construir \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de Yahvé en Jerusalén.  
\v 6 \w Todos|strong="H3605"\w* sus vecinos \w los|strong="H5921"\w* apoyaron \w con|strong="H5921"\w* objetos \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w con|strong="H5921"\w* bienes, ganado \w y|strong="H5921"\w* cosas valiosas, \w además|strong="H5921"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* ofrendas voluntarias.  
\v 7 Incluso el \w rey|strong="H4428"\w* \w Ciro|strong="H3566"\w* \w sacó|strong="H3318"\w* los utensilios del \w templo|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé que \w Nabucodonosor|strong="H5019"\w* se había llevado \w de|strong="H5414"\w* Jerusalén \w para|strong="H5414"\w* ponerlos \w en|strong="H3318"\w* el \w templo|strong="H1004"\w* \w de|strong="H5414"\w* sus dioses;  
\v 8 \w Ciro|strong="H3566"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Persia|strong="H6539"\w*, \w los|strong="H5921"\w* entregó \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w del|strong="H5921"\w* \w tesorero|strong="H1489"\w* \w Mitrídates|strong="H4990"\w*, quien \w se|strong="H5921"\w* \w los|strong="H5921"\w* \w contó|strong="H5608"\w* \w a|strong="H3068"\w* Sesbasar, \w príncipe|strong="H5387"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 9 Este es el inventario: \w treinta|strong="H7970"\w* bandejas de \w oro|strong="H2091"\w*, mil bandejas de \w plata|strong="H3701"\w*, \w veintinueve|strong="H6242"\w* \w cuchillos|strong="H4252"\w*,  
\v 10 \w treinta|strong="H7970"\w* \w tazones|strong="H3713"\w* de \w oro|strong="H2091"\w*, cuatrocientos \w diez|strong="H6235"\w* \w tazones|strong="H3713"\w* de \w plata|strong="H3701"\w* de segunda calidad, y otros \w mil|strong="H3967"\w* recipientes.  
\v 11 \w En|strong="H5973"\w* total, \w los|strong="H3605"\w* objetos \w de|strong="H5973"\w* \w oro|strong="H2091"\w* y \w de|strong="H5973"\w* \w plata|strong="H3701"\w* eran \w cinco|strong="H2568"\w* \w mil|strong="H3967"\w* cuatrocientos. \w Todo|strong="H3605"\w* esto \w lo|strong="H3605"\w* trajo Sesbasar cuando \w los|strong="H3605"\w* desterrados regresaron \w de|strong="H5973"\w* Babilonia \w a|strong="H3068"\w* Jerusalén.   
\c 2  
\p
\v 1 Estos son \w los|strong="H1121"\w* habitantes \w de|strong="H1121"\w* la \w provincia|strong="H4082"\w* \w que|strong="H1121"\w* regresaron del \w cautiverio|strong="H1473"\w*, \w de|strong="H1121"\w* aquellos \w que|strong="H1121"\w* \w Nabucodonosor|strong="H5020"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Babilonia, se había llevado desterrados \w a|strong="H3068"\w* Babilonia. Ellos \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* Jerusalén y \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, cada uno \w a|strong="H3068"\w* su propia población;  
\v 2 llegaron \w con|strong="H5973"\w* \w Zorobabel|strong="H2216"\w*, \w Jesúa|strong="H3442"\w*, \w Nehemías|strong="H5166"\w*, \w Seraías|strong="H8304"\w*, \w Reelaías|strong="H7480"\w*, Mardoqueo, \w Bilsán|strong="H1114"\w*, \w Mispar|strong="H4558"\w*, Bigvai, \w Rehum|strong="H7348"\w* y \w Baana|strong="H1196"\w*.  
\p Esta es la lista \w de|strong="H5973"\w* \w los|strong="H5973"\w* hombres \w del|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*:  
