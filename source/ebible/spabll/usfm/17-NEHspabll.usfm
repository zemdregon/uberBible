\id NEH  
\h NEHEMÍAS 
\toc3 Nehemías 
\toc1 NEHEMÍAS 
\toc2 NEHEMÍAS 
\mt1 Nehemías  
\c 1  
\p
\v 1 Relato \w de|strong="H1121"\w* \w Nehemías|strong="H5166"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Hacalías.  
\p En \w el|strong="H1121"\w* \w mes|strong="H2320"\w* \w de|strong="H1121"\w* Quisleu del \w año|strong="H8141"\w* \w veinte|strong="H6242"\w* del reinado \w de|strong="H1121"\w* Artajerjes, mientras yo \w estaba|strong="H1961"\w* en la ciudad \w de|strong="H1121"\w* Susa,  
\v 2 llegó \w mi|strong="H5921"\w* hermano \w Hanani|strong="H2607"\w* \w con|strong="H5921"\w* algunos hombres \w que|strong="H4480"\w* venían \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*. Entonces \w les|strong="H5921"\w* \w pregunté|strong="H7592"\w* \w cómo|strong="H5921"\w* \w les|strong="H5921"\w* iba \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w judíos|strong="H3064"\w* \w que|strong="H4480"\w* habían regresado \w del|strong="H4480"\w* \w cautiverio|strong="H7628"\w* \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* estaba \w la|strong="H1931"\w* ciudad \w de|strong="H4480"\w* Jerusalén.  
\v 3 \w Ellos|strong="H4480"\w* \w me|strong="H4480"\w* respondieron: “Los \w que|strong="H4480"\w* sobrevivieron y \w se|strong="H4480"\w* \w quedaron|strong="H7604"\w* \w en|strong="H4480"\w* la \w provincia|strong="H4082"\w* están pasando \w por|strong="H4480"\w* \w grandes|strong="H1419"\w* dificultades y \w deshonra|strong="H2781"\w*. La muralla \w de|strong="H4480"\w* Jerusalén sigue \w derribada|strong="H6555"\w* y sus \w puertas|strong="H8179"\w* fueron destruidas \w por|strong="H4480"\w* el fuego”.   
\p
\v 4 Al \w escuchar|strong="H8085"\w* \w esto|strong="H1697"\w*, me senté \w a|strong="H3068"\w* llorar. Durante varios \w días|strong="H3117"\w* \w estuve|strong="H3427"\w* muy triste, ayunando y orando \w ante|strong="H6440"\w* \w el|strong="H3427"\w* Dios del \w cielo|strong="H8064"\w*.  
\v 5 Le dije: “Te ruego, Yahvé, \w Dios|strong="H3068"\w* del \w cielo|strong="H8064"\w*, \w Dios|strong="H3068"\w* \w grande|strong="H1419"\w* y temible, que cumples tu \w pacto|strong="H1285"\w* y muestras tu fiel amor \w a|strong="H3068"\w* los que te aman y obedecen tus \w mandamientos|strong="H4687"\w*.  
\v 6 \w Te|strong="H5869"\w* pido \w que|strong="H4994"\w* \w me|strong="H5921"\w* escuches \w y|strong="H5921"\w* \w te|strong="H5869"\w* fijes \w en|strong="H5921"\w* \w esta|strong="H1961"\w* \w oración|strong="H8605"\w* \w que|strong="H4994"\w* \w noche|strong="H3915"\w* \w y|strong="H5921"\w* \w día|strong="H3117"\w* \w te|strong="H5869"\w* presento \w por|strong="H5921"\w* tus \w siervos|strong="H5650"\w*, \w los|strong="H1121"\w* israelitas. Reconozco \w que|strong="H4994"\w* \w nosotros|strong="H5921"\w*, \w los|strong="H1121"\w* israelitas, hemos \w pecado|strong="H2403"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*; incluso \w yo|strong="H4994"\w* \w y|strong="H5921"\w* \w mi|strong="H5921"\w* \w familia|strong="H1004"\w* hemos \w pecado|strong="H2403"\w*.  
\v 7 Nos hemos portado muy mal contigo. \w No|strong="H3808"\w* hemos cumplido los \w mandamientos|strong="H4687"\w*, \w ni|strong="H3808"\w* las leyes \w ni|strong="H3808"\w* los decretos \w que|strong="H3808"\w* le diste \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*.   
\p
\v 8 “\w Por|strong="H1697"\w* favor, \w acuérdate|strong="H2142"\w* \w de|strong="H5971"\w* \w lo|strong="H1697"\w* \w que|strong="H4994"\w* le dijiste \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*: “\w Si|strong="H4994"\w* ustedes me son infieles, \w yo|strong="H6680"\w* los dispersaré \w por|strong="H1697"\w* todas las naciones;  
\v 9 pero \w si|strong="H1961"\w* \w vuelven|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y obedecen mis \w mandamientos|strong="H4687"\w* y \w los|strong="H1961"\w* ponen en práctica, \w yo|strong="H6213"\w* \w los|strong="H1961"\w* \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* reunir. \w Aunque|strong="H8033"\w* hayan \w sido|strong="H1961"\w* repartidos hasta \w el|strong="H6213"\w* \w último|strong="H7097"\w* rincón del mundo, \w los|strong="H1961"\w* traeré de regreso al \w lugar|strong="H4725"\w* \w que|strong="H1961"\w* elegí \w para|strong="H1961"\w* \w que|strong="H1961"\w* residiera \w mi|strong="H1961"\w* \w nombre|strong="H8034"\w*”.   
\p
\v 10 “\w Ellos|strong="H1992"\w* son tus \w siervos|strong="H5650"\w* y tu \w pueblo|strong="H5971"\w*, \w a|strong="H3068"\w* quienes rescataste con tu \w gran|strong="H1419"\w* \w poder|strong="H3581"\w* y tu \w fuerza|strong="H3581"\w*.  
\v 11 Señor, te pido \w que|strong="H4994"\w* escuches con atención \w mi|strong="H1961"\w* \w oración|strong="H8605"\w* y la \w de|strong="H6440"\w* todos tus \w siervos|strong="H5650"\w* \w que|strong="H4994"\w* \w desean|strong="H2655"\w* honrar tu \w nombre|strong="H8034"\w* con alegría. Te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* \w hoy|strong="H3117"\w* me permitas \w tener|strong="H1961"\w* éxito y \w que|strong="H4994"\w* el \w rey|strong="H4428"\w* me trate con bondad”.  
\p En \w aquel|strong="H2088"\w* \w tiempo|strong="H3117"\w*, \w yo|strong="H4994"\w* \w era|strong="H1961"\w* el copero del \w rey|strong="H4428"\w*.   
\c 2  
\p
\v 1 En el \w mes|strong="H2320"\w* \w de|strong="H6440"\w* nisán, durante el \w año|strong="H8141"\w* \w veinte|strong="H6242"\w* del \w rey|strong="H4428"\w* Artajerjes, me tocó servirle el \w vino|strong="H3196"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*. \w Como|strong="H1961"\w* yo \w nunca|strong="H3808"\w* \w había|strong="H1961"\w* \w estado|strong="H1961"\w* \w triste|strong="H7451"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* él,  
\v 2 \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w me|strong="H3588"\w* preguntó: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w te|strong="H3588"\w* ves \w tan|strong="H3966"\w* \w triste|strong="H7451"\w*? \w No|strong="H3588"\w* pareces estar \w enfermo|strong="H2470"\w*, \w así|strong="H2088"\w* \w que|strong="H3588"\w* debe ser una tristeza \w de|strong="H3588"\w* \w corazón|strong="H3820"\w*”.  
\p \w Yo|strong="H3588"\w* \w me|strong="H3588"\w* asusté muchísimo.  
\v 3 Pero le respondí \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “¡\w Que|strong="H3808"\w* \w viva|strong="H2421"\w* el \w rey|strong="H4428"\w* para \w siempre|strong="H5769"\w*! ¿\w Cómo|strong="H4069"\w* \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* estar triste, \w si|strong="H3808"\w* la \w ciudad|strong="H5892"\w* donde están las tumbas \w de|strong="H6440"\w* mis antepasados está en ruinas y sus \w puertas|strong="H8179"\w* han sido quemadas?”   
\p
\v 4 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w me|strong="H5921"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w es|strong="H2088"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* quieres pedirme?”  
\p Entonces hice una oración rápida \w al|strong="H5921"\w* Dios \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*,  
\v 5 \w y|strong="H5921"\w* \w le|strong="H5921"\w* contesté: “\w Si|strong="H6440"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H3190"\w*, \w y|strong="H5921"\w* \w si|strong="H6440"\w* este \w siervo|strong="H5650"\w* suyo cuenta \w con|strong="H5921"\w* su favor, \w le|strong="H5921"\w* ruego \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w envíe|strong="H7971"\w* \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w donde|strong="H5921"\w* están \w las|strong="H5921"\w* tumbas \w de|strong="H5921"\w* mis antepasados, \w para|strong="H5921"\w* \w que|strong="H5921"\w* yo pueda reconstruirla”.   
\p
\v 6 \w El|strong="H3427"\w* \w rey|strong="H4428"\w*, \w que|strong="H5704"\w* \w tenía|strong="H1961"\w* \w a|strong="H3068"\w* la \w reina|strong="H4428"\w* sentada \w a|strong="H3068"\w* su lado, me preguntó: “¿Cuánto \w tiempo|strong="H2165"\w* te tomará \w el|strong="H3427"\w* viaje? ¿\w Cuándo|strong="H4970"\w* \w estarás|strong="H1961"\w* \w de|strong="H6440"\w* regreso?”  
\p \w Al|strong="H5704"\w* \w rey|strong="H4428"\w* le pareció \w bien|strong="H3190"\w* dejarme \w ir|strong="H7971"\w*, una vez \w que|strong="H5704"\w* le \w di|strong="H5414"\w* una fecha aproximada.  
\v 7 \w Además|strong="H5921"\w* \w le|strong="H5921"\w* dije: “\w Si|strong="H5921"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w le|strong="H5921"\w* parece \w bien|strong="H2895"\w*, pido \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* entreguen cartas \w para|strong="H5704"\w* \w los|strong="H5921"\w* \w gobernadores|strong="H6346"\w* \w que|strong="H5921"\w* están \w al|strong="H5921"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5921"\w* \w río|strong="H5104"\w*, \w para|strong="H5704"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* den libre \w paso|strong="H5674"\w* \w hasta|strong="H5704"\w* llegar \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*.  
\v 8 También pido una carta \w para|strong="H5921"\w* Asaf, \w el|strong="H5921"\w* guardabosques \w del|strong="H5921"\w* \w rey|strong="H4428"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w dé|strong="H5921"\w* \w madera|strong="H6086"\w* \w para|strong="H5921"\w* \w las|strong="H5921"\w* vigas \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* fortaleza \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w templo|strong="H1004"\w*, \w para|strong="H5921"\w* \w la|strong="H5921"\w* muralla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w donde|strong="H5921"\w* voy \w a|strong="H3068"\w* vivir”.  
\p \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w me|strong="H5921"\w* concedió todo esto, \w porque|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* bondadosa \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios \w estaba|strong="H1004"\w* conmigo.  
\v 9 Cuando llegué \w con|strong="H5973"\w* \w los|strong="H5973"\w* \w gobernadores|strong="H6346"\w* \w de|strong="H5973"\w* la provincia \w al|strong="H4428"\w* otro \w lado|strong="H5676"\w* \w del|strong="H5973"\w* \w río|strong="H5104"\w*, \w les|strong="H5973"\w* \w entregué|strong="H5414"\w* las cartas \w del|strong="H5973"\w* \w rey|strong="H4428"\w*. \w El|strong="H5973"\w* \w rey|strong="H4428"\w* también había \w enviado|strong="H7971"\w* \w conmigo|strong="H5973"\w* oficiales \w del|strong="H5973"\w* \w ejército|strong="H2428"\w* y caballería.  
\v 10 Pero \w cuando|strong="H5650"\w* Sanbalat \w el|strong="H1121"\w* \w horonita|strong="H2772"\w* y \w Tobías|strong="H2900"\w* \w el|strong="H1121"\w* oficial amonita \w se|strong="H1992"\w* enteraron, \w se|strong="H1992"\w* disgustaron \w mucho|strong="H1419"\w* \w de|strong="H1121"\w* \w que|strong="H1121"\w* alguien hubiera venido \w a|strong="H3068"\w* ayudar \w a|strong="H3068"\w* \w los|strong="H1992"\w* israelitas.   
\p
\v 11 Llegué \w a|strong="H3068"\w* Jerusalén y, \w después|strong="H1961"\w* de estar \w allí|strong="H8033"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*,  
\v 12 salí \w de|strong="H3588"\w* \w noche|strong="H3915"\w* acompañado \w de|strong="H3588"\w* unos \w cuantos|strong="H4100"\w* hombres. \w No|strong="H3808"\w* \w le|strong="H5973"\w* \w había|strong="H3588"\w* contado \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w mi|strong="H3389"\w* Dios \w me|strong="H3588"\w* \w había|strong="H3588"\w* inspirado \w hacer|strong="H6213"\w* \w por|strong="H3588"\w* Jerusalén. \w El|strong="H5973"\w* único animal \w que|strong="H3588"\w* llevábamos era \w el|strong="H5973"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* montaba.  
\v 13 \w Salí|strong="H3318"\w* \w de|strong="H6440"\w* \w noche|strong="H3915"\w* \w por|strong="H6440"\w* la \w puerta|strong="H8179"\w* del \w Valle|strong="H1516"\w* \w hacia|strong="H6440"\w* la \w fuente|strong="H5869"\w* del \w Dragón|strong="H8577"\w* y la \w puerta|strong="H8179"\w* del Estiércol. Revisé las murallas \w de|strong="H6440"\w* Jerusalén \w que|strong="H1961"\w* \w estaban|strong="H1961"\w* derribadas y sus \w puertas|strong="H8179"\w* quemadas \w por|strong="H6440"\w* el fuego.  
\v 14 \w Luego|strong="H5674"\w* \w pasé|strong="H5674"\w* \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* \w de|strong="H8478"\w* la \w Fuente|strong="H5869"\w* y \w al|strong="H4428"\w* \w estanque|strong="H1295"\w* del \w Rey|strong="H4428"\w*, pero mi animal ya no podía \w pasar|strong="H5674"\w* \w por|strong="H8478"\w* \w entre|strong="H8478"\w* los escombros.  
\v 15 Así \w que|strong="H1961"\w* subí por el \w arroyo|strong="H5158"\w*, todavía de \w noche|strong="H3915"\w*, inspeccionando la muralla. Finalmente regresé y entré de nuevo por la \w puerta|strong="H8179"\w* del \w Valle|strong="H1516"\w*.  
\v 16 Los oficiales \w no|strong="H3808"\w* \w sabían|strong="H3045"\w* \w a|strong="H3068"\w* dónde \w había|strong="H6213"\w* ido \w ni|strong="H3808"\w* \w qué|strong="H4100"\w* estaba \w haciendo|strong="H6213"\w*, \w porque|strong="H3808"\w* \w yo|strong="H6213"\w* todavía \w no|strong="H3808"\w* les \w había|strong="H6213"\w* dicho \w nada|strong="H3808"\w* \w a|strong="H3068"\w* los \w judíos|strong="H3064"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los nobles, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los gobernantes, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* los \w que|strong="H4100"\w* trabajarían \w en|strong="H5704"\w* la \w obra|strong="H4399"\w*.   
\p
\v 17 Entonces les dije: “Ustedes \w ven|strong="H3212"\w* la \w mala|strong="H7451"\w* situación \w en|strong="H5750"\w* la \w que|strong="H3808"\w* estamos: Jerusalén \w está|strong="H1961"\w* \w en|strong="H5750"\w* ruinas y sus \w puertas|strong="H8179"\w* \w quemadas|strong="H3341"\w*. Vengan, reconstruyamos la muralla \w de|strong="H5750"\w* Jerusalén \w para|strong="H1961"\w* \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* \w seamos|strong="H1961"\w* la burla \w de|strong="H5750"\w* \w nadie|strong="H3808"\w*”.  
\v 18 También \w les|strong="H5921"\w* conté \w cómo|strong="H5921"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios \w me|strong="H5921"\w* había ayudado \w y|strong="H5921"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w me|strong="H5921"\w* había \w dicho|strong="H1697"\w*.  
\p \w Ellos|strong="H3027"\w* respondieron: “¡\w Manos|strong="H3027"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w obra|strong="H1931"\w*! ¡Comencemos \w la|strong="H1931"\w* reconstrucción!” \w Y|strong="H3068"\w* \w se|strong="H1931"\w* prepararon \w para|strong="H5921"\w* iniciar \w el|strong="H1931"\w* \w buen|strong="H2896"\w* trabajo.   
\p
\v 19 Pero \w cuando|strong="H4100"\w* Sanbalat \w el|strong="H5921"\w* \w horonita|strong="H2772"\w*, \w Tobías|strong="H2900"\w* \w el|strong="H5921"\w* oficial amonita \w y|strong="H5921"\w* Gesem \w el|strong="H5921"\w* árabe \w se|strong="H5921"\w* enteraron, \w se|strong="H5921"\w* burlaron \w de|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w y|strong="H5921"\w* \w nos|strong="H5921"\w* despreciaron diciendo: “¿\w Qué|strong="H4100"\w* \w se|strong="H5921"\w* traen \w entre|strong="H5921"\w* manos? ¿\w Se|strong="H5921"\w* van \w a|strong="H3068"\w* rebelar \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*?”   
\p
\v 20 Pero yo les respondí: “\w El|strong="H1931"\w* Dios del \w cielo|strong="H8064"\w* nos concederá \w el|strong="H1931"\w* éxito. \w Nosotros|strong="H1931"\w*, \w sus|strong="H1931"\w* \w siervos|strong="H5650"\w*, vamos \w a|strong="H3068"\w* comenzar \w la|strong="H1931"\w* reconstrucción; pero ustedes no tienen \w parte|strong="H2506"\w*, ni \w derecho|strong="H6666"\w*, ni lugar en \w la|strong="H1931"\w* historia \w de|strong="H1697"\w* Jerusalén”.   
\c 3  
\p
\v 1 Eliasib, \w el|strong="H1992"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w*, junto \w con|strong="H5704"\w* \w sus|strong="H1992"\w* compañeros \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w*, \w se|strong="H1992"\w* \w pusieron|strong="H5975"\w* \w a|strong="H3068"\w* trabajar \w y|strong="H5704"\w* reconstruyeron la \w puerta|strong="H1817"\w* \w de|strong="H5704"\w* \w las|strong="H1992"\w* \w Ovejas|strong="H6629"\w*. La consagraron \w y|strong="H5704"\w* colocaron \w sus|strong="H1992"\w* hojas; \w y|strong="H5704"\w* continuaron la reconstrucción \w hasta|strong="H5704"\w* la \w torre|strong="H4026"\w* \w de|strong="H5704"\w* \w los|strong="H1992"\w* Cien \w y|strong="H5704"\w* la \w torre|strong="H4026"\w* \w de|strong="H5704"\w* Hananel.  
\v 2 \w Los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* \w Jericó|strong="H3405"\w* construyeron \w el|strong="H5921"\w* tramo siguiente, \w y|strong="H5921"\w* \w el|strong="H5921"\w* tramo posterior \w lo|strong="H5921"\w* \w hizo|strong="H1129"\w* Zacur \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Imri.   
\p
