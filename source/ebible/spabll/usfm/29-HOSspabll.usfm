\q2 \w desde|strong="H5704"\w* \w que|strong="H5704"\w* amasa \w la|strong="H3605"\w* \w harina|strong="H1217"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w la|strong="H3605"\w* masa fermenta.   
\q1
\v 5 En el \w día|strong="H3117"\w* \w de|strong="H8269"\w* la fiesta \w de|strong="H8269"\w* nuestro \w rey|strong="H4428"\w*, los gobernantes se enfermaron \w por|strong="H3027"\w* el calor del \w vino|strong="H3196"\w*,  
\q2 y el \w rey|strong="H4428"\w* se unió \w a|strong="H3068"\w* los insolentes.   
\q1
\v 6 \w Se|strong="H1931"\w* acercan \w con|strong="H3588"\w* \w el|strong="H1931"\w* \w corazón|strong="H3820"\w* \w ardiendo|strong="H1197"\w* \w como|strong="H3588"\w* un \w horno|strong="H8574"\w* \w para|strong="H3588"\w* tender \w sus|strong="H1931"\w* trampas.  
\q2 \w Su|strong="H1931"\w* furia \w duerme|strong="H3463"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w noche|strong="H3915"\w*,  
\q2 \w pero|strong="H3588"\w* \w por|strong="H3588"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w* arde \w como|strong="H3588"\w* un fuego \w encendido|strong="H1197"\w*.   
\q1
\v 7 \w Todos|strong="H3605"\w* arden como un \w horno|strong="H8574"\w*,  
\q2 y devoran \w a|strong="H3068"\w* sus propios gobernantes.  
\q1 \w Todos|strong="H3605"\w* sus \w reyes|strong="H4428"\w* han \w caído|strong="H5307"\w*,  
\q2 y no hay \w nadie|strong="H3605"\w* entre \w ellos|strong="H3605"\w* \w que|strong="H3605"\w* me pida ayuda.   
\q1
\v 8 Efraín \w se|strong="H1961"\w* mezcla con las naciones;  
\q2 Efraín \w es|strong="H1931"\w* \w como|strong="H1961"\w* una \w torta|strong="H5692"\w* \w a|strong="H3068"\w* medio cocer.   
\q1
\v 9 \w Los|strong="H1931"\w* extranjeros \w le|strong="H1931"\w* han consumido las \w fuerzas|strong="H3581"\w*,  
\q2 \w y|strong="H1571"\w* \w él|strong="H1931"\w* \w ni|strong="H3808"\w* cuenta \w se|strong="H3045"\w* da.  
\q1 \w Ya|strong="H3068"\w* \w se|strong="H3045"\w* \w le|strong="H1931"\w* ven las canas \w por|strong="H3581"\w* todos lados,  
\q2 \w y|strong="H1571"\w* \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* da cuenta.   
\q1
\v 10 \w La|strong="H3605"\w* arrogancia \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* testifica en su \w contra|strong="H6440"\w*;  
\q2 \w a|strong="H3068"\w* pesar \w de|strong="H6440"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, \w no|strong="H3808"\w* han regresado \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*,  
\q2 \w ni|strong="H3808"\w* \w lo|strong="H3808"\w* han buscado.   
\b  
\q1
\v 11 “Efraín \w es|strong="H1961"\w* \w como|strong="H1961"\w* una \w paloma|strong="H3123"\w* tonta \w e|strong="H3068"\w* \w incauta|strong="H6601"\w*;  
\q2 piden ayuda \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*  
\q2 y luego corren \w a|strong="H3068"\w* Asiria.   
\q1
\v 12 Pero \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* levanten \w el|strong="H5921"\w* vuelo, lanzaré \w mi|strong="H5921"\w* \w red|strong="H7568"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\q2 \w Los|strong="H5921"\w* haré caer \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*.  
\q2 \w Los|strong="H5921"\w* \w castigaré|strong="H3256"\w*, tal \w como|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* advertí \w a|strong="H3068"\w* su congregación.   
\q1
\v 13 ¡Ay \w de|strong="H4480"\w* \w ellos|strong="H1992"\w*,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H5921"\w* han alejado \w de|strong="H4480"\w* \w mí|strong="H5921"\w*!  
\q1 ¡\w La|strong="H5921"\w* \w destrucción|strong="H7701"\w* \w les|strong="H1992"\w* espera,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H5921"\w* han rebelado \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*!  
\q1 \w Yo|strong="H4480"\w* quiero rescatarlos,  
\q2 \w pero|strong="H3588"\w* \w ellos|strong="H1992"\w* \w dicen|strong="H1696"\w* \w mentiras|strong="H3577"\w* \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*.   
\q1
\v 14 \w No|strong="H3808"\w* \w me|strong="H5921"\w* piden ayuda \w de|strong="H5921"\w* \w corazón|strong="H3820"\w*,  
\q2 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* lamentan \w en|strong="H5921"\w* sus \w camas|strong="H4904"\w*.  
\q1 \w Se|strong="H5921"\w* juntan \w para|strong="H5921"\w* pedir \w trigo|strong="H1715"\w* \w y|strong="H3588"\w* \w vino|strong="H8492"\w* nuevo,  
\q2 \w pero|strong="H3588"\w* \w se|strong="H5921"\w* alejan \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.   
\q1
\v 15 Aunque yo mismo los entrené y fortalecí sus \w brazos|strong="H2220"\w*,  
\q2 ellos hacen planes perversos en mi contra.   
\q1
\v 16 \w Se|strong="H1961"\w* \w vuelven|strong="H7725"\w*, pero \w no|strong="H3808"\w* al Altísimo.  
\q2 \w Son|strong="H1961"\w* \w como|strong="H1961"\w* un \w arco|strong="H7198"\w* defectuoso.  
\q2 Sus líderes morirán \w a|strong="H3068"\w* filo \w de|strong="H8269"\w* \w espada|strong="H2719"\w* por sus palabras insolentes,  
\q2 y esto \w será|strong="H1961"\w* motivo \w de|strong="H8269"\w* burla en la tierra \w de|strong="H8269"\w* \w Egipto|strong="H4714"\w*.   
\b  
\c 8  
\p
\v 1 “¡Ponte \w la|strong="H5921"\w* \w trompeta|strong="H7782"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* labios!  
\q2 Un enemigo \w como|strong="H5921"\w* águila \w se|strong="H5921"\w* abalanza \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé,  
\q2 \w porque|strong="H5921"\w* han roto \w mi|strong="H5921"\w* \w pacto|strong="H1285"\w*  
\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* han rebelado \w contra|strong="H5921"\w* \w mi|strong="H5921"\w* \w ley|strong="H8451"\w*.   
\q1
\v 2 Ellos me gritan: ‘¡Dios nuestro, nosotros en \w Israel|strong="H3478"\w* te conocemos!’   
\q2
\v 3 Pero \w Israel|strong="H3478"\w* ha rechazado lo \w bueno|strong="H2896"\w*,  
\q2 y el enemigo lo \w perseguirá|strong="H7291"\w*.   
\q1
\v 4 Nombraron reyes, pero \w sin|strong="H3808"\w* contar \w conmigo|strong="H6213"\w*.  
\q2 Escogieron líderes, pero \w sin|strong="H3808"\w* mi aprobación.  
\q2 \w Con|strong="H4480"\w* \w su|strong="H1992"\w* \w plata|strong="H3701"\w* y \w su|strong="H1992"\w* \w oro|strong="H2091"\w* \w se|strong="H3045"\w* \w hicieron|strong="H6213"\w* \w ídolos|strong="H6091"\w*  
\q2 \w para|strong="H4616"\w* \w su|strong="H1992"\w* propia destrucción.   
\q1
\v 5 ¡Arroja tu ídolo \w con|strong="H5704"\w* forma \w de|strong="H5704"\w* \w becerro|strong="H5695"\w*, oh \w Samaria|strong="H8111"\w*!  
\q2 Mi enojo arde contra ellos.  
\q2 ¿Cuánto tiempo pasará \w para|strong="H5704"\w* \w que|strong="H3808"\w* puedan ser puros?   
\q1
\v 6 ¡\w Pues|strong="H3588"\w* \w ese|strong="H1931"\w* ídolo \w es|strong="H1931"\w* un invento \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*!  
\q2 Un artesano \w lo|strong="H1931"\w* \w hizo|strong="H6213"\w*, \w así|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* Dios;  
\q2 \w en|strong="H3588"\w* verdad, \w el|strong="H1931"\w* \w becerro|strong="H5695"\w* \w de|strong="H3588"\w* \w Samaria|strong="H8111"\w* \w será|strong="H1961"\w* \w hecho|strong="H6213"\w* pedazos.   
\q1
\v 7 \w Porque|strong="H3588"\w* \w sembraron|strong="H2232"\w* \w vientos|strong="H7307"\w*,  
\q2 \w y|strong="H3588"\w* cosecharán tempestades.  
\q1 \w El|strong="H3588"\w* trigo \w no|strong="H1097"\w* tiene espigas,  
\q2 \w y|strong="H3588"\w* sus tallos \w no|strong="H1097"\w* \w darán|strong="H6213"\w* \w harina|strong="H7058"\w*.  
\q2 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* acaso llegan \w a|strong="H3068"\w* darla, \w los|strong="H3588"\w* extranjeros se \w la|strong="H3588"\w* tragarán.   
\q1
\v 8 \w Israel|strong="H3478"\w* ha \w sido|strong="H1961"\w* devorado.  
\q2 \w Ahora|strong="H6258"\w* \w están|strong="H1961"\w* entre las \w naciones|strong="H1471"\w* \w como|strong="H1961"\w* un objeto sin valor.   
\q1
\v 9 \w Pues|strong="H3588"\w* \w se|strong="H1992"\w* \w fueron|strong="H5927"\w* \w a|strong="H3068"\w* Asiria,  
\q2 \w como|strong="H3588"\w* un burro salvaje \w que|strong="H3588"\w* anda solo.  
\q2 Efraín \w se|strong="H1992"\w* ha comprado amantes.   
\q1
\v 10 \w Pero|strong="H3588"\w* \w aunque|strong="H3588"\w* se hayan vendido \w entre|strong="H3588"\w* las \w naciones|strong="H1471"\w*,  
\q2 \w ahora|strong="H6258"\w* \w yo|strong="H3588"\w* \w los|strong="H3588"\w* reuniré;  
\q2 \w y|strong="H1571"\w* comenzarán \w a|strong="H3068"\w* consumirse bajo \w la|strong="H1571"\w* opresión del \w rey|strong="H4428"\w* poderoso.   
\q1
\v 11 Efraín ha construido \w muchos|strong="H7235"\w* \w altares|strong="H4196"\w* \w para|strong="H3588"\w* \w pecar|strong="H2398"\w*,  
\q2 \w y|strong="H3588"\w* esos mismos \w altares|strong="H4196"\w* le han servido \w para|strong="H3588"\w* \w pecar|strong="H2398"\w*.   
\q1
\v 12 Aunque yo le escribiera todas las enseñanzas de mi \w ley|strong="H8451"\w*,  
\q2 las verían \w como|strong="H3644"\w* algo \w extraño|strong="H2114"\w*.   
\q1
\v 13 Me ofrecen \w carne|strong="H1320"\w* \w como|strong="H5771"\w* \w sacrificio|strong="H2077"\w*  
\q2 y \w se|strong="H3808"\w* la comen,  
\q2 pero Yahvé \w no|strong="H3808"\w* la acepta.  
\q1 \w Ahora|strong="H6258"\w* \w él|strong="H1992"\w* recordará \w su|strong="H1992"\w* \w maldad|strong="H5771"\w*  
\q2 y castigará \w sus|strong="H1992"\w* \w pecados|strong="H2403"\w*:  
\q2 ¡tendrán \w que|strong="H3808"\w* regresar \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*!   
\q1
\v 14 Porque \w Israel|strong="H3478"\w* se \w olvidó|strong="H7911"\w* \w de|strong="H7911"\w* su Creador y construyó palacios,  
\q2 y \w Judá|strong="H3063"\w* \w multiplicó|strong="H7235"\w* sus \w ciudades|strong="H5892"\w* amuralladas;  
\q2 pero \w yo|strong="H6213"\w* \w enviaré|strong="H7971"\w* un fuego sobre sus \w ciudades|strong="H5892"\w*,  
\q2 que devorará sus fortalezas”.   
\b  
\c 9  
\p
\v 1 \w No|strong="H3588"\w* \w te|strong="H5921"\w* alegres, \w Israel|strong="H3478"\w*, ni hagas fiesta \w como|strong="H3588"\w* \w las|strong="H5921"\w* otras naciones;  
\q2 \w porque|strong="H3588"\w* \w le|strong="H5921"\w* fuiste infiel \w a|strong="H3068"\w* tu Dios.  
\q2 Amas \w la|strong="H5921"\w* paga \w de|strong="H5921"\w* prostituta \w en|strong="H5921"\w* \w cada|strong="H3605"\w* era \w donde|strong="H5921"\w* \w se|strong="H5921"\w* trilla \w el|strong="H5921"\w* \w grano|strong="H1715"\w*.   
\q1
\v 2 Pero \w ni|strong="H3808"\w* la era \w ni|strong="H3808"\w* el \w lagar|strong="H3342"\w* los alimentarán,  
\q2 y el \w vino|strong="H8492"\w* nuevo \w se|strong="H3808"\w* les acabará.   
\q1
\v 3 \w No|strong="H3808"\w* podrán quedarse \w a|strong="H3068"\w* vivir en la tierra de Yahvé;  
\q2 Efraín tendrá \w que|strong="H3808"\w* regresar \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*,  
\q2 y comerán alimentos impuros en Asiria.   
\q1
\v 4 \w No|strong="H3808"\w* le ofrecerán \w vino|strong="H3196"\w* \w a|strong="H3068"\w* Yahvé,  
\q2 \w ni|strong="H3808"\w* sus \w sacrificios|strong="H2077"\w* le serán agradables.  
\q2 \w Su|strong="H3588"\w* \w comida|strong="H3899"\w* \w será|strong="H2930"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w pan|strong="H3899"\w* \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* están \w de|strong="H3588"\w* luto;  
\q2 \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w lo|strong="H3808"\w* coma quedará impuro.  
\q2 \w Su|strong="H3588"\w* \w pan|strong="H3899"\w* solo servirá \w para|strong="H3588"\w* calmar \w su|strong="H3588"\w* hambre,  
\q2 \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w podrá|strong="H3808"\w* entrar \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé.   
\q1
\v 5 ¿\w Qué|strong="H4100"\w* \w harán|strong="H6213"\w* ustedes en \w el|strong="H6213"\w* \w día|strong="H3117"\w* de la reunión solemne,  
\q2 y en \w el|strong="H6213"\w* \w día|strong="H3117"\w* de la \w fiesta|strong="H2282"\w* de Yahvé?   
\q1
\v 6 \w Porque|strong="H3588"\w* fíjense, \w aunque|strong="H3588"\w* escapen \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w destrucción|strong="H7701"\w*,  
\q2 \w Egipto|strong="H4714"\w* \w los|strong="H3588"\w* reunirá,  
\q2 \w y|strong="H3588"\w* Menfis \w los|strong="H3588"\w* enterrará.  
\q2 \w La|strong="H3588"\w* maleza se adueñará \w de|strong="H3588"\w* sus tesoros \w de|strong="H3588"\w* \w plata|strong="H3701"\w*,  
\q2 \w y|strong="H3588"\w* \w los|strong="H3588"\w* espinos crecerán dentro \w de|strong="H3588"\w* sus carpas.   
\q1
\v 7 Han llegado \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w del|strong="H5921"\w* castigo,  
\q2 han llegado \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* rendir cuentas,  
\q1 \w y|strong="H5921"\w* todo \w Israel|strong="H3478"\w* \w lo|strong="H5921"\w* \w sabrá|strong="H3045"\w*. \w El|strong="H5921"\w* \w profeta|strong="H5030"\w* es considerado un tonto,  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* hombre inspirado \w está|strong="H5921"\w* loco.  
\q2 Esto pasa \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w gran|strong="H7227"\w* cantidad \w de|strong="H5921"\w* tus \w pecados|strong="H5771"\w*,  
\q2 \w y|strong="H5921"\w* \w porque|strong="H5921"\w* tu \w odio|strong="H4895"\w* es inmenso.   
\q1
\v 8 \w El|strong="H5921"\w* \w profeta|strong="H5030"\w* es \w el|strong="H5921"\w* \w centinela|strong="H6822"\w* \w de|strong="H5921"\w* Efraín \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* \w mi|strong="H5921"\w* Dios;  
\q2 pero hay trampas \w de|strong="H5921"\w* cazador \w en|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w caminos|strong="H1870"\w*,  
\q2 \w y|strong="H5921"\w* hay hostilidad \w hasta|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* su Dios.   
\q1
\v 9 Se han \w corrompido|strong="H7843"\w* profundamente,  
\q2 igual \w que|strong="H3117"\w* en los \w días|strong="H3117"\w* de Guibeá.  
\q2 Dios recordará su \w maldad|strong="H5771"\w*  
\q2 y los castigará por sus \w pecados|strong="H2403"\w*.   
\q1
\v 10 Encontré \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w como|strong="H1961"\w* quien \w halla|strong="H4672"\w* \w uvas|strong="H6025"\w* en \w el|strong="H1992"\w* \w desierto|strong="H4057"\w*.  
\q2 \w Vi|strong="H7200"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* antepasados \w como|strong="H1961"\w* \w se|strong="H1961"\w* \w ven|strong="H7200"\w* \w los|strong="H1992"\w* primeros \w higos|strong="H8384"\w* de la temporada;  
\q2 pero \w ellos|strong="H1992"\w* \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* Baal-peor, \w se|strong="H1961"\w* entregaron \w a|strong="H3068"\w* esa deidad vergonzosa,  
\q2 y \w se|strong="H1961"\w* volvieron tan horribles \w como|strong="H1961"\w* \w las|strong="H1992"\w* \w cosas|strong="H1992"\w* \w que|strong="H1961"\w* amaban.   
\q1
\v 11 La \w gloria|strong="H3519"\w* de Efraín saldrá volando como un pájaro;  
\q2 no habrá \w más|strong="H3519"\w* nacimientos, ni embarazos, ni concepciones.   
\q1
\v 12 \w Y|strong="H3068"\w* \w aunque|strong="H3588"\w* logren criar \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*,  
\q2 \w se|strong="H1992"\w* \w los|strong="H1992"\w* arrebataré hasta \w que|strong="H3588"\w* \w no|strong="H3588"\w* quede \w ni|strong="H1571"\w* uno solo.  
\q2 ¡Ay \w de|strong="H3588"\w* \w ellos|strong="H1992"\w* \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* \w me|strong="H3588"\w* aleje \w de|strong="H3588"\w* \w su|strong="H1992"\w* lado!   
\q1
\v 13 \w A|strong="H3068"\w* Efraín lo \w vi|strong="H7200"\w* \w plantado|strong="H8362"\w* \w en|strong="H3318"\w* un lugar hermoso, igual \w que|strong="H1121"\w* \w Tiro|strong="H6865"\w*;  
\q2 pero Efraín \w sacará|strong="H3318"\w* \w a|strong="H3068"\w* sus propios \w hijos|strong="H1121"\w* para \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w maten|strong="H2026"\w*.   
\q1
\v 14 \w Dales|strong="H5414"\w*, Yahvé... ¿\w qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* les vas \w a|strong="H3068"\w* \w dar|strong="H5414"\w*?  
\q2 ¡\w Dales|strong="H5414"\w* un vientre \w que|strong="H4100"\w* aborte y \w pechos|strong="H7699"\w* secos!   
\b  
\q1
\v 15 “\w Toda|strong="H3605"\w* \w su|strong="H3588"\w* \w maldad|strong="H7451"\w* \w se|strong="H5921"\w* concentra \w en|strong="H5921"\w* \w Gilgal|strong="H1537"\w*;  
\q2 \w la|strong="H5921"\w* verdad \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w allí|strong="H8033"\w* comencé \w a|strong="H3068"\w* odiarlos.  
\q2 \w Por|strong="H5921"\w* sus \w malas|strong="H7451"\w* acciones \w los|strong="H5921"\w* expulsaré \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w casa|strong="H1004"\w*.  
\q2 \w No|strong="H3808"\w* \w los|strong="H5921"\w* amaré \w más|strong="H3588"\w*;  
\q2 \w todos|strong="H3605"\w* sus gobernantes \w son|strong="H3588"\w* unos rebeldes.   
\q1
\v 16 Efraín ha sido golpeado.  
\q2 \w Su|strong="H3588"\w* raíz se \w secó|strong="H3001"\w*,  
\q2 \w y|strong="H1571"\w* \w ya|strong="H1571"\w* \w no|strong="H1097"\w* \w darán|strong="H6213"\w* ningún \w fruto|strong="H6529"\w*.  
\q2 \w Aunque|strong="H3588"\w* tengan hijos, \w yo|strong="H3588"\w* \w mataré|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* seres queridos \w que|strong="H3588"\w* nazcan \w de|strong="H3588"\w* \w su|strong="H3588"\w* vientre”.   
\b  
\q1
\v 17 \w Mi|strong="H1961"\w* Dios \w los|strong="H3588"\w* rechazará, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* le hicieron caso;  
\q2 \w y|strong="H3588"\w* \w andarán|strong="H1961"\w* vagando \w entre|strong="H3808"\w* las \w naciones|strong="H1471"\w*.   
\c 10  
\p
\v 1 \w Israel|strong="H3478"\w* \w es|strong="H7235"\w* una \w vid|strong="H1612"\w* exuberante que da \w mucho|strong="H7235"\w* \w fruto|strong="H6529"\w*.  
\q2 Pero mientras \w más|strong="H7235"\w* \w frutos|strong="H6529"\w* daba, \w más|strong="H7235"\w* \w altares|strong="H4196"\w* construía;  
\q2 y mientras \w más|strong="H7235"\w* prosperaba su tierra, \w más|strong="H7235"\w* adornaba sus piedras sagradas.   
\q1
\v 2 \w Su|strong="H1931"\w* \w corazón|strong="H3820"\w* \w es|strong="H1931"\w* falso;  
\q2 \w ahora|strong="H6258"\w* tendrán \w que|strong="H1931"\w* pagar por \w su|strong="H1931"\w* culpa.  
\q2 Dios demolerá \w sus|strong="H1931"\w* \w altares|strong="H4196"\w*  
\q2 y \w destruirá|strong="H7703"\w* \w sus|strong="H1931"\w* piedras sagradas.   
\q1
\v 3 Seguramente \w ahora|strong="H6258"\w* dirán: “\w No|strong="H3808"\w* tenemos \w rey|strong="H4428"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* le tuvimos \w temor|strong="H3372"\w* \w a|strong="H3068"\w* Yahvé;  
\q2 \w pero|strong="H3588"\w* \w de|strong="H3588"\w* todos modos, ¿\w qué|strong="H3588"\w* podría \w hacer|strong="H6213"\w* un \w rey|strong="H4428"\w* \w por|strong="H3588"\w* nosotros?”   
\q1
\v 4 Hacen promesas vacías \w y|strong="H5921"\w* juran \w en|strong="H5921"\w* \w falso|strong="H7723"\w* \w al|strong="H5921"\w* \w hacer|strong="H3772"\w* sus pactos.  
\q2 \w Por|strong="H5921"\w* eso, \w los|strong="H5921"\w* \w juicios|strong="H4941"\w* \w en|strong="H5921"\w* su \w contra|strong="H5921"\w* \w brotan|strong="H6524"\w* \w como|strong="H5921"\w* hierba venenosa \w en|strong="H5921"\w* \w los|strong="H5921"\w* surcos \w del|strong="H5921"\w* \w campo|strong="H7704"\w*.   
\q1
\v 5 \w Los|strong="H5921"\w* habitantes \w de|strong="H4480"\w* \w Samaria|strong="H8111"\w* temblarán \w de|strong="H4480"\w* miedo \w por|strong="H5921"\w* \w los|strong="H5921"\w* becerros \w de|strong="H4480"\w* Bet-avén.  
\q2 \w El|strong="H5921"\w* \w pueblo|strong="H5971"\w* hará duelo \w por|strong="H5921"\w* \w su|strong="H3588"\w* ídolo,  
\q2 \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* sacerdotes \w que|strong="H3588"\w* \w antes|strong="H3588"\w* \w se|strong="H5921"\w* alegraban \w de|strong="H4480"\w* \w su|strong="H3588"\w* esplendor,  
\q2 \w porque|strong="H3588"\w* esa \w gloria|strong="H3519"\w* \w se|strong="H5921"\w* ha ido \w para|strong="H5921"\w* \w siempre|strong="H5921"\w*.   
\q1
\v 6 \w El|strong="H1571"\w* ídolo \w mismo|strong="H1571"\w* será \w llevado|strong="H2986"\w* \w a|strong="H3068"\w* Asiria \w como|strong="H1571"\w* regalo para \w el|strong="H1571"\w* gran \w rey|strong="H4428"\w*.  
\q2 Efraín quedará en vergüenza,  
\q2 \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* se avergonzará de sus propias decisiones.   
\q1
\v 7 \w Samaria|strong="H8111"\w* \w y|strong="H5921"\w* su \w rey|strong="H4428"\w* serán arrastrados  
\q2 \w como|strong="H5921"\w* una astilla \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* corriente \w del|strong="H5921"\w* \w agua|strong="H4325"\w*.   
\q1
\v 8 \w Los|strong="H5921"\w* santuarios paganos \w de|strong="H5921"\w* Avén, \w que|strong="H5921"\w* son \w el|strong="H5921"\w* \w pecado|strong="H2403"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, serán \w destruidos|strong="H8045"\w*.  
\q2 \w Espinos|strong="H6975"\w* \w y|strong="H5921"\w* cardos \w crecerán|strong="H5927"\w* \w sobre|strong="H5921"\w* sus \w altares|strong="H4196"\w*.  
\q2 Entonces \w le|strong="H5921"\w* dirán \w a|strong="H3068"\w* \w las|strong="H5921"\w* montañas: “¡Cúbrannos!”, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* colinas: “¡\w Caigan|strong="H5307"\w* \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w*!”   
\b  
\q1
\v 9 “\w Israel|strong="H3478"\w*, has \w estado|strong="H5975"\w* pecando \w desde|strong="H5921"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Guibeá,  
\q2 \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w te|strong="H5921"\w* has quedado estancado.  
\q2 ¿Acaso \w no|strong="H3808"\w* \w los|strong="H1121"\w* \w alcanzará|strong="H5381"\w* \w en|strong="H5921"\w* Guibeá \w la|strong="H5921"\w* \w guerra|strong="H4421"\w* \w contra|strong="H5921"\w* \w los|strong="H1121"\w* malvados?   
\q1
\v 10 Es \w mi|strong="H5921"\w* deseo castigarlos;  
\q2 \w las|strong="H5921"\w* naciones \w se|strong="H5921"\w* juntarán \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*  
\q2 \w para|strong="H5921"\w* castigarlos \w por|strong="H5921"\w* su doble maldad.   
\q1
\v 11 Efraín es una \w novilla|strong="H5697"\w* domesticada \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* gusta trillar \w el|strong="H5921"\w* grano,  
\q2 así \w que|strong="H5921"\w* \w le|strong="H5921"\w* pondré un \w yugo|strong="H5921"\w* \w en|strong="H5921"\w* su hermoso \w cuello|strong="H6676"\w*.  
\q2 Haré \w que|strong="H5921"\w* alguien monte \w a|strong="H3068"\w* Efraín;  
\q2 \w Judá|strong="H3063"\w* tendrá \w que|strong="H5921"\w* arar,  
\q2 \w y|strong="H5921"\w* \w Jacob|strong="H3290"\w* romperá \w los|strong="H5921"\w* terrones.   
\q1
\v 12 Siembren \w para|strong="H5704"\w* ustedes mismos \w con|strong="H5704"\w* \w justicia|strong="H6664"\w*,  
\q2 \w y|strong="H5704"\w* cosechen el fruto \w de|strong="H5704"\w* la lealtad.  
\q1 Aren su tierra \w que|strong="H5704"\w* no ha sido cultivada,  
\q2 porque ya es \w hora|strong="H6256"\w* \w de|strong="H5704"\w* buscar \w a|strong="H3068"\w* Yahvé,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* él venga \w y|strong="H5704"\w* haga llover \w justicia|strong="H6664"\w* sobre ustedes.   
\q1
\v 13 \w Pero|strong="H3588"\w* han arado \w la|strong="H3588"\w* \w maldad|strong="H5766"\w*,  
\q2 han cosechado \w la|strong="H3588"\w* injusticia,  
\q2 \w y|strong="H3588"\w* se han comido \w el|strong="H3588"\w* \w fruto|strong="H6529"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w mentira|strong="H3585"\w*.  
\q2 Todo esto \w por|strong="H3588"\w* confiar \w en|strong="H3588"\w* sus propios planes \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w multitud|strong="H7230"\w* \w de|strong="H3588"\w* sus guerreros.   
\q1
\v 14 \w Por|strong="H5921"\w* \w tanto|strong="H5921"\w*, \w se|strong="H5921"\w* \w levantará|strong="H6965"\w* un tumulto \w de|strong="H5921"\w* \w guerra|strong="H4421"\w* \w entre|strong="H5921"\w* tu \w pueblo|strong="H5971"\w*,  
\q2 \w y|strong="H5921"\w* \w todas|strong="H3605"\w* tus fortalezas serán destruidas,  
\q2 \w como|strong="H5921"\w* \w Salmán|strong="H8020"\w* destruyó \w a|strong="H3068"\w* Bet-arbel \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w*,  
\q2 \w cuando|strong="H3117"\w* \w la|strong="H5921"\w* madre fue despedazada \w junto|strong="H5921"\w* \w con|strong="H5921"\w* sus \w hijos|strong="H1121"\w*.   
\q1
\v 15 \w Así|strong="H3602"\w* os \w hará|strong="H6213"\w* Betel \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* vuestra gran \w maldad|strong="H7451"\w*.  
\q2 \w Al|strong="H4428"\w* despuntar \w el|strong="H1008"\w* alba, \w el|strong="H1008"\w* \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w será|strong="H6213"\w* destruido \w por|strong="H6440"\w* completo”.   
\b  
\c 11  
\p
\v 1 “\w Cuando|strong="H3588"\w* \w Israel|strong="H3478"\w* \w era|strong="H1121"\w* \w niño|strong="H5288"\w*, \w yo|strong="H3588"\w* lo amé,  
\q2 \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w llamé|strong="H7121"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w*.   
\q1
\v 2 Pero mientras más los \w llamaban|strong="H7121"\w*, más \w se|strong="H3651"\w* alejaban.  
\q2 Les ofrecían \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* los baales,  
\q2 y quemaban incienso \w a|strong="H3068"\w* las imágenes talladas.   
\q1
\v 3 \w Fui|strong="H3808"\w* \w yo|strong="H3588"\w* quien \w le|strong="H5921"\w* enseñó \w a|strong="H3068"\w* caminar \w a|strong="H3068"\w* Efraín;  
\q2 \w los|strong="H5921"\w* \w tomé|strong="H3947"\w* \w en|strong="H5921"\w* mis \w brazos|strong="H2220"\w*,  
\q2 \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* dieron cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w los|strong="H5921"\w* sanaba.   
\q1
\v 4 \w Los|strong="H5921"\w* atraje \w con|strong="H5921"\w* lazos humanos, \w con|strong="H5921"\w* \w cuerdas|strong="H5688"\w* \w de|strong="H5921"\w* amor.  
\q2 \w Fui|strong="H1961"\w* \w para|strong="H5921"\w* \w ellos|strong="H5921"\w* \w como|strong="H1961"\w* quien \w levanta|strong="H7311"\w* \w el|strong="H5921"\w* \w yugo|strong="H5923"\w* \w de|strong="H5921"\w* su cuello;  
\q2 \w me|strong="H5921"\w* \w incliné|strong="H5186"\w* \w y|strong="H5921"\w* \w les|strong="H5921"\w* di \w de|strong="H5921"\w* comer.   
\b  
\q1
\v 5 “\w No|strong="H3808"\w* regresarán \w a|strong="H3068"\w* \w la|strong="H1931"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*;  
\q2 \w más|strong="H3588"\w* \w bien|strong="H3588"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria gobernará sobre \w ellos|strong="H1931"\w*,  
\q2 \w porque|strong="H3588"\w* \w se|strong="H1931"\w* negaron \w a|strong="H3068"\w* arrepentirse.   
\q1
\v 6 La \w espada|strong="H2719"\w* caerá sobre sus \w ciudades|strong="H5892"\w*,  
\q2 destruirá los cerrojos de sus puertas,  
\q2 y pondrá fin \w a|strong="H3068"\w* todos sus planes.   
\q1
\v 7 Mi \w pueblo|strong="H5971"\w* está decidido \w a|strong="H3068"\w* alejarse \w de|strong="H5971"\w* mí.  
\q2 \w Aunque|strong="H3808"\w* \w claman|strong="H7121"\w* al Altísimo,  
\q2 él \w de|strong="H5971"\w* \w ninguna|strong="H3808"\w* manera los \w levantará|strong="H7311"\w*.   
\b  
\q1
\v 8 “¿\w Cómo|strong="H5921"\w* podría yo abandonarte, Efraín?  
\q2 ¿\w Cómo|strong="H5921"\w* podría entregarte, \w Israel|strong="H3478"\w*?  
\q2 ¿\w Cómo|strong="H5921"\w* podría destruirte \w como|strong="H5921"\w* \w a|strong="H3068"\w* Admá,  
\q2 \w o|strong="H3068"\w* tratarte \w como|strong="H5921"\w* \w a|strong="H3068"\w* Zeboím?  
\q1 \w Mi|strong="H5921"\w* \w corazón|strong="H3820"\w* \w se|strong="H5921"\w* conmueve \w dentro|strong="H5921"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*,  
\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* despierta \w toda|strong="H5921"\w* \w mi|strong="H5921"\w* compasión.   
\q1
\v 9 \w No|strong="H3808"\w* desataré \w el|strong="H3588"\w* ardor \w de|strong="H3588"\w* mi enojo.  
\q2 \w No|strong="H3808"\w* \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* Efraín,  
\q2 \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Dios \w y|strong="H3588"\w* \w no|strong="H3808"\w* un simple hombre; soy \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ustedes.  
\q2 \w No|strong="H3808"\w* vendré \w con|strong="H3588"\w* \w ira|strong="H2740"\w*.   
\q1
\v 10 \w Ellos|strong="H1931"\w* seguirán \w a|strong="H3068"\w* Yahvé,  
\q2 \w quien|strong="H1931"\w* \w rugirá|strong="H7580"\w* \w como|strong="H3588"\w* un león.  
\q2 \w Cuando|strong="H3588"\w* \w él|strong="H1931"\w* ruja, \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* vendrán temblando desde \w el|strong="H1931"\w* occidente.   
\q1
\v 11 Saldrán \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* temblando \w como|strong="H5921"\w* pájaros,  
\q2 \w y|strong="H5921"\w* \w de|strong="H5921"\w* Asiria \w como|strong="H5921"\w* palomas;  
\q1 \w y|strong="H5921"\w* yo \w los|strong="H3427"\w* haré vivir seguros \w en|strong="H5921"\w* sus propias \w casas|strong="H1004"\w*”, afirma Yahvé.   
\b  
\q1
\v 12 Efraín me tiene rodeado de mentiras,  
\q2 y la familia de Israel de engaños.  
\q2 Judá sigue alejándose de Dios,  
\q2 y le es infiel al Santo.   
\c 12  
\p
\v 1 Efraín se alimenta \w de|strong="H5973"\w* viento,  
\q2 y \w va|strong="H3068"\w* \w tras|strong="H5973"\w* \w el|strong="H5973"\w* viento \w del|strong="H5973"\w* este.  
\q2 Todo \w el|strong="H5973"\w* día multiplica la \w mentira|strong="H3585"\w* y la destrucción.  
\q2 Hacen un pacto \w con|strong="H5973"\w* Asiria,  
\q2 y \w le|strong="H5973"\w* mandan aceite \w a|strong="H3068"\w* Egipto.   
\q1
\v 2 Yahvé también tiene una acusación \w contra|strong="H5973"\w* Judá,  
\q2 y castigará \w a|strong="H3068"\w* Jacob por su mala conducta;  
\q2 \w le|strong="H5973"\w* dará su merecido según sus obras.   
\q1
\v 3 \w Ya|strong="H3068"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* vientre tomó \w a|strong="H3068"\w* su hermano \w por|strong="H5921"\w* \w el|strong="H5921"\w* talón,  
\q2 \w y|strong="H5921"\w* \w en|strong="H5921"\w* su madurez luchó \w contra|strong="H5921"\w* \w Dios|strong="H3068"\w*.   
\q1
\v 4 Luchó contra el ángel y lo \w venció|strong="H8280"\w*;  
\q2 lloró y le suplicó.  
\q2 Lo encontró en Betel, y allí habló con nosotros...   
\q2
\v 5 ¡Yahvé, \w el|strong="H5973"\w* Dios \w de|strong="H5973"\w* \w los|strong="H5973"\w* ejércitos!  
\q2 ¡Yahvé es su \w nombre|strong="H8033"\w* memorable!   
\q1
\v 6 Por lo tanto, regresa \w a|strong="H3068"\w* tu \w Dios|strong="H3068"\w*.  
\q2 Practica el amor y la justicia,  
\q2 y pon siempre tu esperanza en tu \w Dios|strong="H3068"\w*.   
\b  
\q1
\v 7 Es un comerciante con balanzas alteradas en \w la|strong="H8104"\w* mano;  
\q2 le encanta defraudar.   
\q1
\v 8 Efraín dijo: “¡\w Qué|strong="H3027"\w* rico me he hecho!  
\q2 He acumulado mucha riqueza.  
\q2 En todas mis ganancias, no me encontrarán ningún delito \w que|strong="H3027"\w* sea pecado”.   
\b  
\q1
\v 9 “Pero yo soy Yahvé tu Dios, desde \w que|strong="H3808"\w* estabas en \w la|strong="H3605"\w* tierra de Egipto.  
\q2 Yo haré \w que|strong="H3808"\w* vuelvan \w a|strong="H3068"\w* vivir en tiendas de campaña,  
\q2 \w como|strong="H5771"\w* en \w los|strong="H3605"\w* días de las fiestas solemnes.   
\q1
\v 10 \w También|strong="H5750"\w* les he hablado \w a|strong="H3068"\w* \w los|strong="H3427"\w* profetas,  
\q2 y les he dado muchas visiones;  
\q2 y \w por|strong="H5750"\w* medio \w de|strong="H5750"\w* \w los|strong="H3427"\w* profetas he usado parábolas.   
\q1
\v 11 \w Si|strong="H5921"\w* \w en|strong="H5921"\w* Galaad hay maldad,  
\q2 seguramente quedarán \w en|strong="H5921"\w* \w nada|strong="H1696"\w*.  
\q1 \w En|strong="H5921"\w* Gilgal sacrifican toros;  
\q2 pero sus altares quedarán \w como|strong="H5921"\w* montones \w de|strong="H5921"\w* piedras \w en|strong="H5921"\w* \w los|strong="H5921"\w* surcos \w del|strong="H5921"\w* campo.   
\q1
\v 12 Jacob huyó \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Aram.  
\q2 Allí Israel trabajó \w para|strong="H5921"\w* conseguir esposa;  
\q2 cuidó rebaños \w para|strong="H5921"\w* pagar \w por|strong="H5921"\w* \w ella|strong="H5921"\w*.   
\q1
\v 13 Por medio de un profeta, Yahvé sacó \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* de Egipto,  
\q2 y por medio de un profeta lo \w cuidó|strong="H8104"\w*.   
\q1
\v 14 Efraín ha provocado \w la|strong="H8104"\w* \w ira|strong="H5927"\w* amarga de su \w Señor|strong="H3068"\w*;  
\q2 por lo tanto, \w él|strong="H5030"\w* le \w hará|strong="H8104"\w* pagar por \w la|strong="H8104"\w* sangre derramada,  
\q2 y le devolverá sus ofensas”.   
\c 13  
\p
\v 1 Cuando Efraín \w hablaba|strong="H1696"\w*, infundía temor.  
\q2 Llegó \w a|strong="H3068"\w* ser muy importante en \w Israel|strong="H3478"\w*,  
\q2 pero \w se|strong="H1931"\w* hizo culpable al adorar \w a|strong="H3068"\w* \w Baal|strong="H1168"\w*, y \w murió|strong="H4191"\w*.   
\q1
\v 2 \w Ahora|strong="H6258"\w* pecan \w cada|strong="H3605"\w* vez \w más|strong="H3254"\w*,  
\q2 y con \w su|strong="H1992"\w* \w plata|strong="H3701"\w* \w se|strong="H1992"\w* han \w hecho|strong="H6213"\w* \w imágenes|strong="H4541"\w* fundidas,  
\q2 \w ídolos|strong="H6091"\w* diseñados según \w su|strong="H1992"\w* propio \w entendimiento|strong="H8394"\w*,  
\q2 \w todos|strong="H3605"\w* \w ellos|strong="H1992"\w* \w obra|strong="H4639"\w* de artesanos.  
\q2 ¡\w Y|strong="H3068"\w* hasta dicen: “\w Que|strong="H6258"\w* \w los|strong="H1992"\w* hombres \w que|strong="H6258"\w* ofrecen \w sacrificios|strong="H2076"\w* besen \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w becerros|strong="H5695"\w*”!   
\q1
\v 3 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w* \w serán|strong="H1961"\w* \w como|strong="H1961"\w* la niebla de la \w mañana|strong="H1242"\w*,  
\q2 \w como|strong="H1961"\w* el \w rocío|strong="H2919"\w* \w que|strong="H1961"\w* desaparece temprano,  
\q2 \w como|strong="H1961"\w* la paja \w que|strong="H1961"\w* el viento \w se|strong="H1961"\w* lleva de la \w era|strong="H1961"\w*,  
\q2 y \w como|strong="H1961"\w* el \w humo|strong="H6227"\w* \w que|strong="H1961"\w* sale \w por|strong="H3651"\w* la chimenea.   
\b  
\q1
\v 4 “\w Sin|strong="H3808"\w* embargo, yo soy Yahvé tu \w Dios|strong="H3068"\w* desde \w que|strong="H3808"\w* estabas en la tierra \w de|strong="H2108"\w* \w Egipto|strong="H4714"\w*.  
\q2 \w No|strong="H3808"\w* reconocerás \w a|strong="H3068"\w* \w ningún|strong="H3808"\w* otro \w dios|strong="H3068"\w* \w más|strong="H3808"\w* \w que|strong="H3808"\w* \w a|strong="H3068"\w* \w mí|strong="H1115"\w*,  
\q2 \w porque|strong="H3808"\w* \w fuera|strong="H2108"\w* \w de|strong="H2108"\w* \w mí|strong="H1115"\w* \w no|strong="H3808"\w* hay \w ningún|strong="H3808"\w* \w salvador|strong="H3467"\w*.   
\q1
\v 5 Yo te cuidé en el \w desierto|strong="H4057"\w*,  
\q2 en esa tierra de gran sequía.   
\q1
\v 6 Cuando tuvieron buenos pastos, \w se|strong="H5921"\w* llenaron;  
\q2 \w y|strong="H5921"\w* \w al|strong="H5921"\w* estar satisfechos, su \w corazón|strong="H3820"\w* \w se|strong="H5921"\w* llenó \w de|strong="H5921"\w* orgullo.  
\q2 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w se|strong="H5921"\w* \w olvidaron|strong="H7911"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.   
\q1
\v 7 \w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H3644"\w*, \w seré|strong="H1961"\w* \w para|strong="H5921"\w* \w ellos|strong="H5921"\w* \w como|strong="H3644"\w* un \w león|strong="H7826"\w*;  
\q2 \w como|strong="H3644"\w* un leopardo \w los|strong="H5921"\w* acecharé \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w*.   
\q1
\v 8 Los atacaré como una osa \w a|strong="H3068"\w* la que le han robado sus cachorros,  
\q2 y les desgarraré el \w corazón|strong="H3820"\w*.  
\q2 \w Allí|strong="H8033"\w* los devoraré como una leona;  
\q2 ¡los \w animales|strong="H2416"\w* salvajes los harán \w pedazos|strong="H7167"\w*!   
\q1
\v 9 Estás destruido, \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* \w te|strong="H3588"\w* pusiste \w en|strong="H3588"\w* \w contra|strong="H3478"\w* mía,  
\q2 \w en|strong="H3588"\w* \w contra|strong="H3478"\w* \w de|strong="H3588"\w* tu única \w ayuda|strong="H5828"\w*.   
\q1
\v 10 ¿Dónde está ahora \w tu|strong="H8199"\w* \w rey|strong="H4428"\w* \w para|strong="H5414"\w* \w que|strong="H3605"\w* te \w salve|strong="H3467"\w* en \w todas|strong="H3605"\w* tus \w ciudades|strong="H5892"\w*?  
\q2 ¿\w Y|strong="H3068"\w* dónde están tus gobernantes, \w de|strong="H8269"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* decías: ‘\w Dame|strong="H5414"\w* un \w rey|strong="H4428"\w* y líderes’?   
\q1
\v 11 En mi enojo te \w di|strong="H5414"\w* un \w rey|strong="H4428"\w*,  
\q2 y en mi furia te lo quité.   
\q1
\v 12 La culpa de Efraín está acumulada;  
\q2 su \w pecado|strong="H2403"\w* está guardado.   
\q1
\v 13 \w Le|strong="H1931"\w* llegarán \w dolores|strong="H2256"\w* \w de|strong="H3588"\w* mujer \w de|strong="H3588"\w* parto.  
\q2 \w Es|strong="H1931"\w* un \w hijo|strong="H1121"\w* necio,  
\q2 \w porque|strong="H3588"\w* \w cuando|strong="H3588"\w* llega \w el|strong="H1931"\w* momento \w de|strong="H3588"\w* nacer, \w no|strong="H3808"\w* \w se|strong="H1931"\w* acomoda \w en|strong="H3588"\w* \w la|strong="H1931"\w* matriz.   
\q1
\v 14 ¿Acaso los rescataré del \w poder|strong="H3027"\w* del Seol?  
\q2 ¡¿Los \w redimiré|strong="H1350"\w* \w de|strong="H5869"\w* la \w muerte|strong="H4194"\w*?!  
\q2 ¡\w Muerte|strong="H4194"\w*, ¿dónde están tus plagas?!  
\q2 ¡Seol, ¿dónde está tu destrucción?!  
\b  
\q1 “\w Ya|strong="H3068"\w* no tendré más compasión \w de|strong="H5869"\w* \w ellos|strong="H3027"\w*.   
\q2
\v 15 \w Aunque|strong="H3588"\w* Efraín prospere \w entre|strong="H3588"\w* \w sus|strong="H1931"\w* hermanos, \w vendrá|strong="H5927"\w* un \w viento|strong="H7307"\w* del \w este|strong="H1931"\w*;  
\q2 un \w viento|strong="H7307"\w* \w de|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* \w sube|strong="H5927"\w* desde \w el|strong="H1931"\w* \w desierto|strong="H4057"\w*.  
\q2 \w Su|strong="H1931"\w* \w manantial|strong="H4726"\w* \w se|strong="H1931"\w* secará,  
\q2 \w y|strong="H3588"\w* \w su|strong="H1931"\w* \w fuente|strong="H4599"\w* quedará agotada.  
\q2 \w Ese|strong="H1931"\w* \w viento|strong="H7307"\w* \w saqueará|strong="H8154"\w* \w el|strong="H1931"\w* tesoro \w de|strong="H3588"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* objetos valiosos.   
\q1
\v 16 Samaria cargará con su culpa,  
\q2 porque se ha rebelado contra su Dios.  
\q2 Caerán \w a|strong="H3068"\w* filo de espada;  
\q2 sus niños serán estrellados contra el suelo,  
\q2 y \w a|strong="H3068"\w* sus mujeres embarazadas les abrirán el vientre”.   
\b  
\c 14  
\q1
\v 1 Israel, regresa \w a|strong="H3068"\w* Yahvé tu Dios,  
\q2 \w porque|strong="H3588"\w* has \w caído|strong="H5307"\w* \w por|strong="H3588"\w* tu propio pecado.   
\q1
\v 2 Lleven \w con|strong="H3588"\w* ustedes palabras \w de|strong="H3588"\w* arrepentimiento \w y|strong="H3588"\w* regresen \w a|strong="H3068"\w* Yahvé.  
\q2 Díganle: “Perdona todos nuestros \w pecados|strong="H5771"\w*,  
\q2 \w y|strong="H3588"\w* acepta \w lo|strong="H5704"\w* bueno \w que|strong="H3588"\w* \w te|strong="H3588"\w* ofrecemos;  
\q2 \w te|strong="H3588"\w* presentamos \w el|strong="H3588"\w* fruto \w de|strong="H3588"\w* nuestros labios.   
\q1
\v 3 Asiria no podrá salvarnos.  
\q2 \w Ya|strong="H3068"\w* no montaremos \w en|strong="H5973"\w* caballos \w de|strong="H5973"\w* guerra;  
\q2 \w ni|strong="H5973"\w* \w volveremos|strong="H7725"\w* \w a|strong="H3068"\w* llamar ‘dioses nuestros’ \w a|strong="H3068"\w* \w la|strong="H3605"\w* obra \w de|strong="H5973"\w* nuestras manos,  
\q2 porque solo \w en|strong="H5973"\w* \w ti|strong="H5973"\w* \w el|strong="H5973"\w* huérfano encuentra compasión”.   
\b  
\q1
\v 4 “Yo sanaré su infidelidad.  
\q2 \w Los|strong="H5921"\w* amaré \w por|strong="H5921"\w* \w mi|strong="H5921"\w* propia voluntad;  
\q2 \w porque|strong="H5921"\w* \w mi|strong="H5921"\w* enojo \w se|strong="H5921"\w* \w ha|strong="H3808"\w* apartado \w de|strong="H5921"\w* \w ellos|strong="H3027"\w*.   
\q1
\v 5 Seré \w como|strong="H3588"\w* \w el|strong="H3588"\w* rocío \w para|strong="H3588"\w* Israel.  
\q2 Florecerá \w como|strong="H3588"\w* un lirio,  
\q2 \w y|strong="H3588"\w* echará raíces tan profundas \w como|strong="H3588"\w* \w los|strong="H3588"\w* árboles \w del|strong="H4480"\w* Líbano.   
\q1
\v 6 Sus ramas \w se|strong="H1961"\w* extenderán;  
\q2 su belleza \w será|strong="H1961"\w* \w como|strong="H1961"\w* la del olivo,  
\q2 y su fragancia \w como|strong="H1961"\w* la de \w los|strong="H1961"\w* cedros del \w Líbano|strong="H3844"\w*.   
\q1
\v 7 \w Los|strong="H1961"\w* \w que|strong="H1961"\w* vivan bajo su sombra volverán \w a|strong="H3068"\w* florecer  
\q2 \w como|strong="H1961"\w* el trigo y \w a|strong="H3068"\w* brotar \w como|strong="H1961"\w* la vid;  
\q2 su fama \w será|strong="H1961"\w* \w como|strong="H1961"\w* la del \w vino|strong="H3212"\w* del \w Líbano|strong="H3844"\w*.   
\q1
\v 8 Efraín dirá: ‘¿Qué tengo que ver yo con \w los|strong="H3427"\w* ídolos?’  
\q2 Yo le responderé y lo cuidaré.  
\q2 Soy como un pino siempre verde;  
\q2 tu fruto proviene de mí”.   
\b  
\q1
\v 9 El \w que|strong="H4100"\w* sea sabio, \w que|strong="H4100"\w* entienda estas cosas;  
\q2 el \w que|strong="H4100"\w* sea inteligente, \w que|strong="H4100"\w* las comprenda.  
\q2 \w Porque|strong="H4100"\w* los caminos \w de|strong="H4480"\w* Yahvé son rectos,  
\q2 y los justos caminan \w por|strong="H4480"\w* \w ellos|strong="H4480"\w*,  
\q2 pero los rebeldes tropiezan y caen.   