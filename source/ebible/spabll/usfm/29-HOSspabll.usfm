\id HOS  
\h OSEAS 
\toc3 Oseas 
\toc1 OSEAS 
\toc2 OSEAS 
\mt1 Oseas  
\c 1  
\p
\v 1 \w Palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé \w que|strong="H1697"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Oseas|strong="H1954"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Beeri, en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* Uzías, Jotam, Acaz y Ezequías, \w reyes|strong="H4428"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, y en \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* \w Jeroboam|strong="H3379"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joás|strong="H3101"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.   
\p
\v 2 \w Cuando|strong="H3588"\w* Yahvé comenzó \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w por|strong="H3588"\w* medio \w de|strong="H3588"\w* \w Oseas|strong="H1954"\w*, le \w dijo|strong="H1696"\w*: “\w Ve|strong="H3212"\w*, \w tómate|strong="H3947"\w* una mujer \w que|strong="H3588"\w* se prostituya \w y|strong="H3588"\w* ten \w hijos|strong="H3206"\w* \w de|strong="H3588"\w* prostitución; \w porque|strong="H3588"\w* \w el|strong="H3588"\w* país se ha prostituido \w por|strong="H3588"\w* completo al apartarse \w de|strong="H3588"\w* Yahvé”.   
\p
\v 3 Entonces \w él|strong="H1121"\w* \w fue|strong="H3212"\w* y \w tomó|strong="H3947"\w* por esposa \w a|strong="H3068"\w* \w Gomer|strong="H1586"\w*, \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Diblaim, la cual \w concibió|strong="H2029"\w* y le dio un \w hijo|strong="H1121"\w*.   
\p
\v 4 \w Y|strong="H3068"\w* Yahvé \w le|strong="H5921"\w* dijo: “Llámalo \w Jezreel|strong="H3157"\w*, \w porque|strong="H3588"\w* \w dentro|strong="H5750"\w* \w de|strong="H5921"\w* \w poco|strong="H4592"\w* tiempo castigaré \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Jehú|strong="H3058"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* derramada \w en|strong="H5921"\w* \w Jezreel|strong="H3157"\w*, \w y|strong="H3588"\w* pondré fin \w al|strong="H5921"\w* reino \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 5 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, romperé \w el|strong="H1931"\w* \w arco|strong="H7198"\w* de \w Israel|strong="H3478"\w* en \w el|strong="H1931"\w* \w valle|strong="H6010"\w* de \w Jezreel|strong="H3157"\w*”.   
\p
\v 6 Gomer \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w concebir|strong="H2029"\w* \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz una \w hija|strong="H1323"\w*.  
\p \w Entonces|strong="H3588"\w* Dios \w le|strong="H3254"\w* dijo: “\w Llámala|strong="H7121"\w* \w Lo-Ruhamá|strong="H3808"\w*, \w porque|strong="H3588"\w* \w ya|strong="H3254"\w* \w no|strong="H3808"\w* tendré compasión \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w ni|strong="H3808"\w* \w los|strong="H3588"\w* \w perdonaré|strong="H5375"\w*.  
\v 7 Pero \w sí|strong="H3808"\w* tendré compasión de la \w familia|strong="H1004"\w* de \w Judá|strong="H3063"\w*, y los \w salvaré|strong="H3467"\w* por medio de Yahvé su \w Dios|strong="H3068"\w*. \w No|strong="H3808"\w* los \w salvaré|strong="H3467"\w* con \w arco|strong="H7198"\w*, \w ni|strong="H3808"\w* con \w espada|strong="H2719"\w*, \w ni|strong="H3808"\w* en \w batalla|strong="H4421"\w*, \w ni|strong="H3808"\w* con \w caballos|strong="H5483"\w* \w ni|strong="H3808"\w* \w jinetes|strong="H6571"\w*”.   
\p
\v 8 Después \w de|strong="H1121"\w* \w que|strong="H1121"\w* destetó \w a|strong="H3068"\w* Lo-Ruhamá, Gomer \w concibió|strong="H2029"\w* y dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*.   
\p
\v 9 \w Entonces|strong="H3588"\w* Dios dijo: “Llámalo \w Lo-Ammí|strong="H3808"\w*, \w porque|strong="H3588"\w* ustedes \w no|strong="H3808"\w* \w son|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*, \w ni|strong="H3808"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H3588"\w* Dios.  
\v 10 Sin embargo, el número de los israelitas será como la arena del mar, que no se puede medir ni contar; y sucederá que, en el mismo lugar donde se les dijo: ‘Ustedes no son mi pueblo’, se les llamará: ‘Hijos del Dios viviente’.  
\v 11 El pueblo de Judá y el pueblo de Israel se reunirán, nombrarán para sí mismos un solo líder, y resurgirán en la tierra; porque el día de Jezreel será grandioso”.   
\c 2  
\p
\v 1 “Díganles \w a|strong="H3068"\w* \w sus|strong="H1992"\w* hermanos: “¡\w Pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*!”  
\q2 y \w a|strong="H3068"\w* \w sus|strong="H1992"\w* hermanas: “¡Amada mía!”   
\q1
\v 2 ¡Reclámenle \w a|strong="H3068"\w* \w su|strong="H3588"\w* madre!  
\q2 Reclámenle, \w porque|strong="H3588"\w* \w ella|strong="H4480"\w* ya \w no|strong="H3588"\w* \w es|strong="H3588"\w* mi esposa,  
\q2 ni \w yo|strong="H4480"\w* soy \w su|strong="H3588"\w* esposo.  
\q1 \w Que|strong="H3588"\w* quite \w la|strong="H3588"\w* prostitución \w de|strong="H4480"\w* \w su|strong="H3588"\w* rostro,  
\q2 \w y|strong="H3588"\w* sus adulterios \w de|strong="H4480"\w* \w entre|strong="H3588"\w* sus pechos;   
\q1
\v 3 \w para|strong="H5971"\w* \w que|strong="H5971"\w* yo no la desnude por completo,  
\q2 y la deje como en el día en \w que|strong="H5971"\w* nació;  
\q1 la convierta en un desierto,  
\q2 la vuelva una tierra reseca,  
\q2 y la mate \w de|strong="H5971"\w* sed.   
\q1
\v 4 \w No|strong="H3808"\w* tendré compasión \w de|strong="H3588"\w* \w sus|strong="H1931"\w* hijos,  
\q2 \w porque|strong="H3588"\w* \w son|strong="H3588"\w* hijos \w de|strong="H3588"\w* prostitución.   
\q1
\v 5 \w Porque|strong="H6435"\w* su madre \w se|strong="H6435"\w* ha prostituido;  
\q2 la \w que|strong="H6435"\w* los concibió actuó sinvergüenzamente,  
\q1 pues dijo: “Iré tras mis amantes,  
\q2 los \w que|strong="H6435"\w* me dan mi pan y mi agua,  
\q2 mi lana y mi lino,  
\q2 mi aceite y mis bebidas”.   
\q1
\v 6 \w Por|strong="H3588"\w* \w lo|strong="H3808"\w* tanto, voy \w a|strong="H3068"\w* cercar \w su|strong="H1992"\w* camino \w con|strong="H3588"\w* espinos,  
\q2 \w y|strong="H3588"\w* construiré un muro \w a|strong="H3068"\w* \w su|strong="H1992"\w* alrededor,  
\q2 \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* pueda encontrar \w sus|strong="H1992"\w* senderos.   
\q1
\v 7 Ella perseguirá \w a|strong="H3068"\w* sus amantes,  
\q2 \w pero|strong="H3588"\w* \w no|strong="H3588"\w* \w los|strong="H3588"\w* alcanzará;  
\q1 \w los|strong="H3588"\w* buscará,  
\q2 \w pero|strong="H3588"\w* \w no|strong="H3588"\w* \w los|strong="H3588"\w* encontrará.  
\q1 \w Entonces|strong="H3588"\w* dirá: ‘Regresaré \w con|strong="H3588"\w* mi primer esposo,  
\q2 \w porque|strong="H3588"\w* \w me|strong="H3588"\w* \w iba|strong="H3212"\w* mejor \w entonces|strong="H3588"\w* \w que|strong="H3588"\w* ahora’.   
\q1
\v 8 Ella \w no|strong="H3808"\w* reconoció \w que|strong="H3808"\w* era yo quien le daba el trigo, el \w vino|strong="H1870"\w* nuevo y el aceite;  
\q2 quien le multiplicó la plata y el oro, los cuales usaron para adorar \w a|strong="H3068"\w* Baal.   
\q1
\v 9 \w Por|strong="H3588"\w* \w lo|strong="H3808"\w* tanto, \w volveré|strong="H7725"\w* \w y|strong="H3588"\w* le quitaré \w mi|strong="H1245"\w* trigo \w en|strong="H3588"\w* \w su|strong="H3588"\w* tiempo \w de|strong="H3588"\w* cosecha,  
\q2 \w y|strong="H3588"\w* \w mi|strong="H1245"\w* \w vino|strong="H3212"\w* nuevo \w en|strong="H3588"\w* \w su|strong="H3588"\w* temporada.  
\q2 Le arrebataré \w mi|strong="H1245"\w* lana \w y|strong="H3588"\w* \w mi|strong="H1245"\w* lino, \w con|strong="H3588"\w* \w los|strong="H7291"\w* \w que|strong="H3588"\w* debía cubrir \w su|strong="H3588"\w* desnudez.   
\q1
\v 10 Ahora descubriré \w su|strong="H1931"\w* vergüenza \w a|strong="H3068"\w* \w la|strong="H1931"\w* vista \w de|strong="H3588"\w* \w sus|strong="H1931"\w* amantes,  
\q2 \w y|strong="H3588"\w* \w nadie|strong="H3808"\w* \w la|strong="H1931"\w* librará \w de|strong="H3588"\w* mi \w mano|strong="H1931"\w*.   
\q1
\v 11 \w También|strong="H3651"\w* pondré fin \w a|strong="H3068"\w* todas sus celebraciones:  
\q2 \w a|strong="H3068"\w* sus fiestas, sus lunas nuevas, sus días \w de|strong="H6256"\w* descanso y todas sus reuniones solemnes.   
\q1
\v 12 Arruinaré sus viñas y sus higueras,  
\q2 \w de|strong="H5869"\w* las cuales \w ha|strong="H3808"\w* dicho: “Esta \w es|strong="H3027"\w* la paga \w que|strong="H3808"\w* me han dado mis amantes”.  
\q2 Haré \w de|strong="H5869"\w* ellas un matorral,  
\q2 y los animales del campo \w se|strong="H3808"\w* las comerán.   
\q1
\v 13 \w La|strong="H3605"\w* castigaré por \w los|strong="H3605"\w* días en \w que|strong="H3605"\w* quemaba incienso \w a|strong="H3068"\w* \w los|strong="H3605"\w* baales,  
\q2 cuando se adornaba con sus aretes y sus joyas,  
\q2 y se iba tras sus amantes  
\q2 olvidándose de mí”, dice Yahvé.   
\q1
\v 14 “\w Por|strong="H5414"\w* \w lo|strong="H1992"\w* tanto, voy \w a|strong="H3068"\w* seducirla;  
\q2 la llevaré al desierto  
\q2 y le hablaré con ternura.   
\q1
\v 15 \w Desde|strong="H5921"\w* allí \w le|strong="H5921"\w* devolveré \w sus|strong="H1992"\w* viñas,  
\q2 \w y|strong="H5921"\w* convertiré \w el|strong="H5921"\w* valle \w de|strong="H5921"\w* Acor \w en|strong="H5921"\w* una puerta \w de|strong="H5921"\w* esperanza.  
\q1 \w Y|strong="H3068"\w* allí \w ella|strong="H5921"\w* \w me|strong="H5921"\w* responderá  
\q2 \w como|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H1992"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w su|strong="H1992"\w* juventud,  
\q2 \w como|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* \w salió|strong="H3212"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Egipto.   
\q1
\v 16 \w En|strong="H5921"\w* aquel día”, \w dice|strong="H1696"\w* Yahvé,  
\q2 “\w me|strong="H5921"\w* llamarás ‘\w mi|strong="H5921"\w* esposo’,  
\q2 \w y|strong="H5921"\w* ya \w no|strong="H5921"\w* \w me|strong="H5921"\w* llamarás ‘\w mi|strong="H5921"\w* amo’.   
\q1
\v 17 \w Porque|strong="H8033"\w* quitaré \w de|strong="H5414"\w* su boca los nombres \w de|strong="H5414"\w* los baales,  
\q2 y nunca \w más|strong="H6030"\w* volverá \w a|strong="H3068"\w* mencionarlos \w por|strong="H5414"\w* su \w nombre|strong="H8033"\w*.   
\q1
\v 18 \w En|strong="H5750"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* haré un pacto \w a|strong="H3068"\w* favor \w de|strong="H5750"\w* \w ellos|strong="H1931"\w* con \w los|strong="H1931"\w* animales del campo,  
\q2 con las aves del cielo  
\q2 y con \w los|strong="H1931"\w* reptiles \w de|strong="H5750"\w* \w la|strong="H1931"\w* tierra.  
\q1 Eliminaré \w de|strong="H5750"\w* \w la|strong="H1931"\w* tierra \w el|strong="H1931"\w* arco, \w la|strong="H1931"\w* espada y \w la|strong="H1931"\w* guerra,  
\q2 y haré \w que|strong="H1931"\w* duerman seguros.   
\q1
\v 19 Me casaré contigo \w para|strong="H5493"\w* siempre;  
\q2 me casaré contigo \w en|strong="H5493"\w* justicia y derecho, con amor y compasión.   
\q1
\v 20 \w Me|strong="H4480"\w* casaré \w contigo|strong="H5973"\w* \w en|strong="H4480"\w* fidelidad,  
\q2 y conocerás \w a|strong="H3068"\w* Yahvé.   
\q1
\v 21 En aquel día yo responderé”, dice Yahvé.  
\q2 “Yo le responderé \w a|strong="H3068"\w* los cielos,  
\q2 y ellos le responderán \w a|strong="H3068"\w* la tierra;   
\q2
\v 22 y la tierra le responderá al trigo, al vino nuevo y al aceite;  
\q2 y ellos le responderán \w a|strong="H3068"\w* Jezreel.   
\q1
\v 23 Yo \w la|strong="H1931"\w* sembraré \w para|strong="H1961"\w* \w mí|strong="H1961"\w* en \w la|strong="H1931"\w* tierra;  
\q2 \w tendré|strong="H1961"\w* compasión de \w la|strong="H1931"\w* \w que|strong="H1931"\w* \w no|strong="H1961"\w* \w había|strong="H1961"\w* recibido compasión,  
\q2 y \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w que|strong="H1931"\w* \w no|strong="H1961"\w* \w eran|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H1992"\w* \w les|strong="H1992"\w* diré: “Ustedes \w son|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H1992"\w*”,  
\q2 y \w ellos|strong="H1992"\w* me dirán: “Tú \w eres|strong="H1961"\w* \w mi|strong="H1961"\w* \w Dios|strong="H3068"\w*””.   
\c 3  
\p
\v 1 Yahvé me dijo: “\w Ve|strong="H3212"\w* \w otra|strong="H5750"\w* vez y ama \w a|strong="H3068"\w* una mujer \w que|strong="H1121"\w* es amada \w por|strong="H5750"\w* \w otro|strong="H5750"\w* y comete adulterio, \w así|strong="H1992"\w* \w como|strong="H5750"\w* Yahvé ama \w a|strong="H3068"\w* \w los|strong="H1992"\w* israelitas, \w a|strong="H3068"\w* pesar \w de|strong="H5750"\w* \w que|strong="H1121"\w* \w ellos|strong="H1992"\w* \w se|strong="H1992"\w* vuelven \w a|strong="H3068"\w* \w otros|strong="H5750"\w* dioses y \w les|strong="H1992"\w* encantan \w las|strong="H1992"\w* tortas \w de|strong="H5750"\w* pasas”.   
\p
\v 2 Así que la compré para mí por \w quince|strong="H2568"\w* \w monedas|strong="H3701"\w* \w de|strong="H2568"\w* \w plata|strong="H3701"\w* y un homer y medio \w de|strong="H2568"\w* \w cebada|strong="H8184"\w*.  
\v 3 \w Y|strong="H3068"\w* le dije: “Te quedarás conmigo \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*. \w No|strong="H3808"\w* te prostituirás, \w ni|strong="H3808"\w* te irás \w con|strong="H1571"\w* \w ningún|strong="H3808"\w* otro hombre, \w y|strong="H1571"\w* yo me comportaré igual contigo”.   
\p
\v 4 \w Porque|strong="H3588"\w* \w los|strong="H3427"\w* israelitas vivirán \w muchos|strong="H7227"\w* \w días|strong="H3117"\w* sin \w rey|strong="H4428"\w* \w y|strong="H3588"\w* sin líder, sin \w sacrificios|strong="H2077"\w* \w y|strong="H3588"\w* sin piedras sagradas, sin efod \w y|strong="H3588"\w* sin ídolos familiares.  
\v 5 Después \w de|strong="H1121"\w* esto, \w los|strong="H1121"\w* israelitas \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w* y \w a|strong="H3068"\w* \w David|strong="H1732"\w* su \w rey|strong="H4428"\w*. En \w los|strong="H1121"\w* últimos \w días|strong="H3117"\w*, acudirán con temor reverente \w a|strong="H3068"\w* Yahvé y \w a|strong="H3068"\w* sus bendiciones.   
\c 4  
\p
\v 1 \w Escuchen|strong="H8085"\w* \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé, israelitas,  
\q2 \w porque|strong="H3588"\w* Yahvé tiene una acusación \w contra|strong="H5973"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w del|strong="H5973"\w* país:  
\q1 “\w Pues|strong="H3588"\w* \w no|strong="H3588"\w* hay verdad, \w ni|strong="H5973"\w* lealtad,  
\q2 \w ni|strong="H5973"\w* \w conocimiento|strong="H1847"\w* \w de|strong="H3588"\w* \w Dios|strong="H3068"\w* \w en|strong="H5973"\w* \w la|strong="H3588"\w* tierra.   
\q1
\v 2 Abundan las maldiciones, las mentiras, los asesinatos, los robos y los adulterios;  
\q2 rompen todos los límites, y un asesinato sigue \w a|strong="H3068"\w* otro.   
\q1
\v 3 \w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w la|strong="H5921"\w* tierra \w estará|strong="H3427"\w* \w de|strong="H5921"\w* luto,  
\q2 \w y|strong="H1571"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* habite \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w se|strong="H5921"\w* consumirá,  
\q1 \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w los|strong="H3427"\w* \w animales|strong="H2416"\w* \w del|strong="H5921"\w* \w campo|strong="H7704"\w* \w y|strong="H1571"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*;  
\q2 ¡\w hasta|strong="H5921"\w* \w los|strong="H3427"\w* peces \w del|strong="H5921"\w* \w mar|strong="H3220"\w* morirán!   
\b  
\q1
\v 4 “Pero \w que|strong="H5971"\w* nadie presente acusaciones, ni \w que|strong="H5971"\w* nadie \w reprenda|strong="H3198"\w* \w a|strong="H3068"\w* otro;  
\q2 \w porque|strong="H3198"\w* tu \w pueblo|strong="H5971"\w* es como los \w que|strong="H5971"\w* \w se|strong="H5971"\w* pelean con el \w sacerdote|strong="H3548"\w*.   
\q1
\v 5 \w Tropezarás|strong="H3782"\w* \w en|strong="H5973"\w* pleno \w día|strong="H3117"\w*,  
\q2 \w y|strong="H1571"\w* \w el|strong="H5973"\w* \w profeta|strong="H5030"\w* \w también|strong="H1571"\w* \w tropezará|strong="H3782"\w* \w contigo|strong="H5973"\w* \w de|strong="H5973"\w* \w noche|strong="H3915"\w*;  
\q2 \w y|strong="H1571"\w* destruiré \w a|strong="H3068"\w* tu madre.   
\q1
\v 6 Mi \w pueblo|strong="H5971"\w* \w es|strong="H3588"\w* destruido \w por|strong="H3588"\w* falta \w de|strong="H3588"\w* \w conocimiento|strong="H1847"\w*.  
\q2 \w Como|strong="H3588"\w* has rechazado \w el|strong="H3588"\w* \w conocimiento|strong="H1847"\w*, \w yo|strong="H3588"\w* \w también|strong="H1571"\w* \w te|strong="H3588"\w* rechazaré \w a|strong="H3068"\w* ti,  
\q2 \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H1097"\w* seas mi sacerdote.  
\q1 \w Y|strong="H3068"\w* \w como|strong="H3588"\w* has olvidado \w la|strong="H1571"\w* \w ley|strong="H8451"\w* \w de|strong="H3588"\w* tu Dios,  
\q2 \w yo|strong="H3588"\w* \w también|strong="H1571"\w* \w me|strong="H3588"\w* \w olvidaré|strong="H7911"\w* \w de|strong="H3588"\w* tus \w hijos|strong="H1121"\w*.   
\q1
\v 7 Mientras \w más|strong="H7235"\w* \w se|strong="H3651"\w* \w multiplicaron|strong="H7235"\w*, \w más|strong="H7235"\w* \w pecaron|strong="H2398"\w* contra mí;  
\q2 cambiaré su \w gloria|strong="H3519"\w* en vergüenza.   
\q1
\v 8 \w Se|strong="H5971"\w* alimentan \w de|strong="H5971"\w* los \w pecados|strong="H2403"\w* \w de|strong="H5971"\w* \w mi|strong="H5375"\w* \w pueblo|strong="H5971"\w*,  
\q2 y ponen su \w corazón|strong="H5315"\w* en su \w maldad|strong="H5771"\w*.   
\q1
\v 9 \w Y|strong="H3068"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w le|strong="H5921"\w* irá igual \w que|strong="H5921"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w*;  
\q2 \w los|strong="H5921"\w* castigaré \w por|strong="H5921"\w* su mala conducta,  
\q2 \w y|strong="H5921"\w* \w les|strong="H5921"\w* daré su merecido \w por|strong="H5921"\w* sus acciones.   
\q1
\v 10 Comerán, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* quedarán satisfechos;  
\q2 \w se|strong="H3808"\w* prostituirán, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* multiplicarán,  
\q2 \w porque|strong="H3588"\w* han dejado \w de|strong="H3588"\w* obedecer \w a|strong="H3068"\w* Yahvé.   
\q1
\v 11 La prostitución, el \w vino|strong="H3196"\w* y el \w vino|strong="H3196"\w* nuevo les \w quitan|strong="H3947"\w* el buen juicio.   
\q2
\v 12 Mi \w pueblo|strong="H5971"\w* le consulta \w a|strong="H3068"\w* \w su|strong="H3588"\w* ídolo \w de|strong="H3588"\w* \w madera|strong="H6086"\w*,  
\q2 \w y|strong="H3588"\w* un pedazo \w de|strong="H3588"\w* \w palo|strong="H6086"\w* le responde.  
\q1 \w Pues|strong="H3588"\w* un \w espíritu|strong="H7307"\w* \w de|strong="H3588"\w* prostitución \w los|strong="H3588"\w* ha descarriado,  
\q2 \w y|strong="H3588"\w* \w se|strong="H5971"\w* han prostituido alejándose \w de|strong="H3588"\w* \w su|strong="H3588"\w* Dios.   
\q1
\v 13 Ofrecen \w sacrificios|strong="H2076"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* cumbres \w de|strong="H5921"\w* \w las|strong="H5921"\w* montañas,  
\q2 \w y|strong="H3588"\w* queman incienso \w en|strong="H5921"\w* \w las|strong="H5921"\w* colinas, \w bajo|strong="H8478"\w* \w las|strong="H5921"\w* encinas, \w los|strong="H5921"\w* álamos \w y|strong="H3588"\w* \w los|strong="H5921"\w* terebintos,  
\q2 \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w sombra|strong="H6738"\w* \w es|strong="H3588"\w* agradable.  
\q1 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* sus \w hijas|strong="H1323"\w* \w se|strong="H5921"\w* prostituyen,  
\q2 \w y|strong="H3588"\w* sus \w nueras|strong="H3618"\w* cometen adulterio.   
\q1
\v 14 \w No|strong="H3808"\w* castigaré \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijas|strong="H1323"\w* \w cuando|strong="H3588"\w* \w se|strong="H5921"\w* prostituyan,  
\q2 \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w nueras|strong="H3618"\w* \w cuando|strong="H3588"\w* cometan adulterio;  
\q1 \w porque|strong="H3588"\w* \w los|strong="H1992"\w* hombres \w mismos|strong="H1992"\w* \w se|strong="H5921"\w* van \w con|strong="H5973"\w* prostitutas,  
\q2 \w y|strong="H3588"\w* ofrecen \w sacrificios|strong="H2076"\w* \w con|strong="H5973"\w* \w las|strong="H1992"\w* prostitutas \w del|strong="H5921"\w* templo;  
\q2 ¡\w así|strong="H3588"\w* \w es|strong="H3588"\w* \w como|strong="H3588"\w* un \w pueblo|strong="H5971"\w* \w sin|strong="H3808"\w* entendimiento \w se|strong="H5921"\w* encamina \w a|strong="H3068"\w* \w la|strong="H5921"\w* ruina!   
\b  
\q1
\v 15 “Aunque tú, \w Israel|strong="H3478"\w*, te prostituyas,  
\q2 ¡que \w Judá|strong="H3063"\w* no se haga culpable!  
\q2 No vayan \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w*,  
\q2 ni suban \w a|strong="H3068"\w* Bet-avén,  
\q2 ni juren diciendo: ‘\w Vive|strong="H2416"\w* Yahvé’.   
\q1
\v 16 \w Porque|strong="H3588"\w* \w Israel|strong="H3478"\w* se ha vuelto tan terco \w como|strong="H3588"\w* una novilla terca.  
\q2 ¿\w Cómo|strong="H3588"\w* podrá Yahvé pastorearlos \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w corderos|strong="H3532"\w* \w en|strong="H3588"\w* un prado abierto?   
\q1
\v 17 Efraín se ha unido \w a|strong="H3068"\w* los \w ídolos|strong="H6091"\w*.  
\q2 ¡Déjenlo en paz!   
\q1
\v 18 Cuando se les acaba la bebida,  
\q2 se entregan por completo \w a|strong="H3068"\w* la prostitución;  
\q2 \w a|strong="H3068"\w* sus gobernantes les encanta la deshonra.   
\q1
\v 19 El \w viento|strong="H7307"\w* los envolverá en sus \w alas|strong="H3671"\w*,  
\q2 y se avergonzarán de sus \w sacrificios|strong="H2077"\w*.   
\b  
\c 5  
\p
\v 1 “¡\w Escuchen|strong="H8085"\w* \w esto|strong="H2063"\w*, \w sacerdotes|strong="H3548"\w*!  
\q2 ¡Presta atención, pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*!  
\q2 ¡\w Y|strong="H3068"\w* \w escuchen|strong="H8085"\w*, miembros \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*!  
\q1 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* \w juicio|strong="H4941"\w* \w es|strong="H1961"\w* \w contra|strong="H5921"\w* ustedes.  
\q2 Han \w sido|strong="H1961"\w* una trampa \w en|strong="H5921"\w* \w Mizpa|strong="H4709"\w*,  
\q2 \w y|strong="H3588"\w* una \w red|strong="H7568"\w* extendida \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* monte \w Tabor|strong="H8396"\w*.   
\q1
\v 2 \w Los|strong="H3605"\w* rebeldes se han hundido en \w la|strong="H3605"\w* matanza,  
\q2 pero yo \w los|strong="H3605"\w* castigaré \w a|strong="H3068"\w* \w todos|strong="H3605"\w*.   
\q1
\v 3 \w Yo|strong="H4480"\w* \w conozco|strong="H3045"\w* \w bien|strong="H3588"\w* \w a|strong="H3068"\w* Efraín,  
\q2 \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* \w me|strong="H4480"\w* oculta;  
\q1 \w porque|strong="H3588"\w* \w ahora|strong="H6258"\w*, Efraín, \w te|strong="H4480"\w* has prostituido,  
\q2 \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* \w se|strong="H3045"\w* \w ha|strong="H3808"\w* \w contaminado|strong="H2930"\w*.   
\q1
\v 4 Sus malas acciones \w no|strong="H3808"\w* les permiten \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*,  
\q2 \w porque|strong="H3588"\w* un \w espíritu|strong="H7307"\w* \w de|strong="H3588"\w* prostitución \w los|strong="H3588"\w* domina,  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w conocen|strong="H3045"\w* \w a|strong="H3068"\w* Yahvé.   
\q1
\v 5 \w La|strong="H1571"\w* arrogancia \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* testifica \w en|strong="H5973"\w* su \w contra|strong="H5973"\w*.  
\q2 \w Por|strong="H6440"\w* eso \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* Efraín \w tropezarán|strong="H3782"\w* \w por|strong="H6440"\w* su \w maldad|strong="H5771"\w*,  
\q2 \w y|strong="H1571"\w* \w Judá|strong="H3063"\w* \w también|strong="H1571"\w* \w tropezará|strong="H3782"\w* \w con|strong="H5973"\w* \w ellos|strong="H1571"\w*.   
\q1
\v 6 \w Irán|strong="H3212"\w* con \w sus|strong="H1992"\w* \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w su|strong="H1992"\w* \w ganado|strong="H6629"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Yahvé,  
\q2 pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontrarán,  
\q2 \w porque|strong="H3808"\w* \w él|strong="H1992"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* alejado de \w ellos|strong="H1992"\w*.   
\q1
\v 7 Han sido infieles \w a|strong="H3068"\w* Yahvé,  
\q2 \w porque|strong="H3588"\w* han engendrado \w hijos|strong="H1121"\w* ilegítimos.  
\q2 \w Ahora|strong="H6258"\w* \w la|strong="H3588"\w* luna nueva \w los|strong="H1121"\w* devorará junto \w con|strong="H3588"\w* sus campos.   
\b  
\q1
\v 8 “¡Toquen el cuerno en Guibeá,  
\q2 y la \w trompeta|strong="H7782"\w* en \w Ramá|strong="H7414"\w*!  
\q2 ¡Den el grito de guerra en Bet-avén! ¡El enemigo está \w a|strong="H3068"\w* tus espaldas, \w Benjamín|strong="H1144"\w*!   
\q1
\v 9 Efraín \w quedará|strong="H1961"\w* en ruinas en el \w día|strong="H3117"\w* del castigo.  
\q2 Entre las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w* he dado \w a|strong="H3068"\w* conocer lo \w que|strong="H3045"\w* sin duda \w sucederá|strong="H1961"\w*.   
\q1
\v 10 \w Los|strong="H5921"\w* gobernantes \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w son|strong="H1961"\w* \w como|strong="H1961"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* mueven \w los|strong="H5921"\w* límites \w de|strong="H5921"\w* propiedad.  
\q2 \w Por|strong="H5921"\w* eso \w derramaré|strong="H8210"\w* \w mi|strong="H5921"\w* enojo \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w como|strong="H1961"\w* una inundación.   
\q1
\v 11 Efraín está \w oprimido|strong="H6231"\w*,  
\q2 \w y|strong="H3588"\w* aplastado \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w juicio|strong="H4941"\w*,  
\q2 \w porque|strong="H3588"\w* se empeñó \w en|strong="H3588"\w* \w ir|strong="H1980"\w* tras \w los|strong="H3588"\w* ídolos.   
\q1
\v 12 Por eso yo soy como una \w polilla|strong="H6211"\w* para Efraín,  
\q2 y como podredumbre para la \w familia|strong="H1004"\w* de \w Judá|strong="H3063"\w*.   
\b  
\q1
\v 13 “Cuando Efraín \w se|strong="H1931"\w* dio cuenta \w de|strong="H4480"\w* \w su|strong="H1931"\w* \w enfermedad|strong="H2483"\w*,  
\q2 y \w Judá|strong="H3063"\w* \w de|strong="H4480"\w* \w su|strong="H1931"\w* herida,  
\q2 Efraín acudió \w a|strong="H3068"\w* Asiria,  
\q2 y \w le|strong="H1931"\w* pidió ayuda \w al|strong="H4480"\w* gran \w rey|strong="H4428"\w* \w Jareb|strong="H3377"\w*.  
\q1 Pero \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w puede|strong="H3201"\w* sanarlos,  
\q2 \w ni|strong="H3808"\w* curarles \w la|strong="H1931"\w* herida.   
\q1
\v 14 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* seré \w como|strong="H3588"\w* un \w león|strong="H7826"\w* \w para|strong="H3588"\w* Efraín,  
\q2 \w y|strong="H3588"\w* \w como|strong="H3588"\w* un \w león|strong="H7826"\w* feroz \w para|strong="H3588"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w*.  
\q1 \w Yo|strong="H3588"\w* mismo \w los|strong="H3588"\w* despedazaré \w y|strong="H3588"\w* \w me|strong="H3588"\w* \w iré|strong="H3212"\w*;  
\q2 \w me|strong="H3588"\w* \w llevaré|strong="H5375"\w* \w la|strong="H3588"\w* presa, \w y|strong="H3588"\w* nadie podrá rescatarlos.   
\q1
\v 15 \w Luego|strong="H7725"\w* regresaré \w a|strong="H3068"\w* \w mi|strong="H1245"\w* \w lugar|strong="H4725"\w*,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* reconozcan \w su|strong="H1992"\w* culpa  
\q2 \w y|strong="H5704"\w* \w busquen|strong="H1245"\w* \w mi|strong="H1245"\w* \w rostro|strong="H6440"\w*.  
\q2 Pues \w en|strong="H5704"\w* \w su|strong="H1992"\w* \w angustia|strong="H6862"\w* me \w buscarán|strong="H1245"\w* desesperadamente”.   
\b  
\c 6  
\p
\v 1 “¡Vengan! \w Volvamos|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé.  
\q2 \w Él|strong="H1931"\w* nos ha despedazado,  
\q2 \w pero|strong="H3588"\w* nos sanará;  
\q1 nos ha herido,  
\q2 \w pero|strong="H3588"\w* \w vendará|strong="H2280"\w* nuestras heridas.   
\q1
\v 2 Después \w de|strong="H6440"\w* \w dos|strong="H3117"\w* \w días|strong="H3117"\w* nos dará \w vida|strong="H2421"\w*;  
\q2 al tercer \w día|strong="H3117"\w* nos \w levantará|strong="H6965"\w*,  
\q2 y \w viviremos|strong="H2421"\w* en su \w presencia|strong="H6440"\w*.   
\q1
\v 3 \w Conozcamos|strong="H3045"\w* \w a|strong="H3068"\w* Yahvé;  
\q2 esforcémonos por conocerlo.  
\q1 Tan \w cierto|strong="H3559"\w* como \w que|strong="H3045"\w* \w sale|strong="H4161"\w* el sol,  
\q2 Yahvé aparecerá.  
\q1 Vendrá \w a|strong="H3068"\w* nosotros como la \w lluvia|strong="H1653"\w*,  
\q2 como la \w lluvia|strong="H1653"\w* de primavera \w que|strong="H3045"\w* riega la tierra”.   
\b  
\q1
\v 4 “¿\w Qué|strong="H4100"\w* \w voy|strong="H1980"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* contigo, Efraín?  
\q2 ¿\w Qué|strong="H4100"\w* \w voy|strong="H1980"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* contigo, \w Judá|strong="H3063"\w*?  
\q2 \w Porque|strong="H4100"\w* \w el|strong="H6213"\w* amor de ustedes es \w como|strong="H4100"\w* una \w nube|strong="H6051"\w* matutina,  
\q2 y \w como|strong="H4100"\w* \w el|strong="H6213"\w* \w rocío|strong="H2919"\w* \w que|strong="H4100"\w* desaparece temprano.   
\q1
\v 5 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w los|strong="H5921"\w* hice pedazos \w por|strong="H5921"\w* medio \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w*;  
\q2 \w los|strong="H5921"\w* \w maté|strong="H2026"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w palabras|strong="H6310"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w boca|strong="H6310"\w*.  
\q2 Mis \w juicios|strong="H4941"\w* \w sobre|strong="H5921"\w* ustedes brillan \w como|strong="H5921"\w* un relámpago.   
\q1
\v 6 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w quiero|strong="H2654"\w* lealtad \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w sacrificios|strong="H2077"\w*;  
\q2 \w y|strong="H3588"\w* \w conocimiento|strong="H1847"\w* \w de|strong="H3588"\w* Dios \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w holocaustos|strong="H5930"\w*.   
\q1
\v 7 Pero \w ellos|strong="H1992"\w*, igual \w que|strong="H1992"\w* Adán, rompieron \w el|strong="H5674"\w* \w pacto|strong="H1285"\w*.  
\q2 \w Allí|strong="H8033"\w* me fueron infieles.   
\q1
\v 8 \w Galaad|strong="H1568"\w* es una \w ciudad|strong="H7151"\w* \w de|strong="H1818"\w* malhechores;  
\q2 está manchada \w de|strong="H1818"\w* \w sangre|strong="H1818"\w*.   
\q1
\v 9 \w Como|strong="H3588"\w* una banda \w de|strong="H3588"\w* ladrones \w que|strong="H3588"\w* acecha \w a|strong="H3068"\w* un hombre,  
\q2 \w así|strong="H3588"\w* una pandilla \w de|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* asesina \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w a|strong="H3068"\w* Siquem,  
\q2 cometiendo crímenes vergonzosos.   
\q1
\v 10 En la \w familia|strong="H1004"\w* de \w Israel|strong="H3478"\w* he \w visto|strong="H7200"\w* una cosa horrible.  
\q2 \w Allí|strong="H8033"\w* Efraín se prostituye;  
\q2 \w Israel|strong="H3478"\w* \w está|strong="H8033"\w* \w contaminado|strong="H2930"\w*.   
\b  
\q1
\v 11 “\w También|strong="H1571"\w* \w para|strong="H5971"\w* ti, \w Judá|strong="H3063"\w*, hay una cosecha señalada,  
\q2 \w cuando|strong="H1571"\w* yo restaure \w la|strong="H1571"\w* fortuna \w de|strong="H5971"\w* mi \w pueblo|strong="H5971"\w*.   
\c 7  
\p
\v 1 “\w Cuando|strong="H3588"\w* \w yo|strong="H3588"\w* estaba \w a|strong="H3068"\w* punto \w de|strong="H3588"\w* sanar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*,  
\q2 quedó al descubierto \w la|strong="H3588"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* Efraín  
\q2 \w y|strong="H3588"\w* \w los|strong="H3588"\w* crímenes \w de|strong="H3588"\w* \w Samaria|strong="H8111"\w*.  
\q2 \w Pues|strong="H3588"\w* practican \w el|strong="H3588"\w* \w engaño|strong="H8267"\w*;  
\q2 \w los|strong="H3588"\w* \w ladrones|strong="H1590"\w* se meten \w en|strong="H3588"\w* las casas,  
\q2 \w y|strong="H3588"\w* las pandillas asaltan \w en|strong="H3588"\w* las \w calles|strong="H2351"\w*.   
\q1
\v 2 \w No|strong="H1077"\w* \w se|strong="H1961"\w* dan cuenta en su \w corazón|strong="H3824"\w* \w de|strong="H6440"\w* \w que|strong="H6258"\w* yo recuerdo \w toda|strong="H3605"\w* su \w maldad|strong="H7451"\w*.  
\q2 \w Ahora|strong="H6258"\w* sus propias \w malas|strong="H7451"\w* acciones \w los|strong="H3605"\w* \w tienen|strong="H1961"\w* acorralados;  
\q2 las tengo \w siempre|strong="H3605"\w* \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*.   
\q1
\v 3 Con su \w maldad|strong="H7451"\w* \w alegran|strong="H8055"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*,  
\q2 y con sus mentiras \w a|strong="H3068"\w* los gobernantes.   
