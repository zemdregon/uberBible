\id EXO  
\h ÉXODO 
\toc3 Éxodo 
\toc1 LIBRO SEGUNDO DE MOISÉS, COMÚNMENTE LLAMADO ÉXODO 
\toc2 ÉXODO 
\mt2 Libro segundo de Moisés,  
\mt3 comúnmente llamado  
\mt1 Éxodo  
\c 1  
\p
\v 1 Estos son \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1121"\w* llegaron \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* (cada \w hombre|strong="H1121"\w* y su \w familia|strong="H1004"\w* llegaron con \w Jacob|strong="H3290"\w*):  
\v 2 \w Rubén|strong="H7205"\w*, \w Simeón|strong="H8095"\w*, \w Leví|strong="H3878"\w* y \w Judá|strong="H3063"\w*,  
\v 3 Isacar, \w Zabulón|strong="H2074"\w* y \w Benjamín|strong="H1144"\w*,  
\v 4 \w Dan|strong="H1835"\w* y Neftalí, \w Gad|strong="H1410"\w* y Aser.  
\v 5 \w Todas|strong="H3605"\w* las \w personas|strong="H5315"\w* \w que|strong="H1961"\w* descendieron de \w Jacob|strong="H3290"\w* \w fueron|strong="H1961"\w* \w setenta|strong="H7657"\w* \w en|strong="H3318"\w* total, y \w José|strong="H3130"\w* ya \w estaba|strong="H1961"\w* \w en|strong="H3318"\w* \w Egipto|strong="H4714"\w*.  
\v 6 \w José|strong="H3130"\w* \w murió|strong="H4191"\w*, al igual \w que|strong="H1931"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* hermanos y \w toda|strong="H3605"\w* \w aquella|strong="H1931"\w* \w generación|strong="H1755"\w*.  
\v 7 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* fructificaron, se \w multiplicaron|strong="H7235"\w* y se hicieron \w muy|strong="H3966"\w* poderosos, y la tierra se \w llenó|strong="H4390"\w* \w de|strong="H1121"\w* ellos.   
\p
\v 8 \w Se|strong="H3045"\w* \w levantó|strong="H6965"\w* un \w nuevo|strong="H2319"\w* \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w conocía|strong="H3045"\w* \w a|strong="H3068"\w* \w José|strong="H3130"\w*.  
\v 9 Le dijo \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w*: “Miren,\f + \fr 1:9 \ft “Miren”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* \w el|strong="H1121"\w* \w pueblo|strong="H5971"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* es cada vez \w más|strong="H4480"\w* poderoso \w que|strong="H4480"\w* nosotros.  
\v 10 \w Vengan|strong="H5927"\w*, \w seamos|strong="H1961"\w* astutos \w con|strong="H5921"\w* \w ellos|strong="H1931"\w*, \w no|strong="H6435"\w* \w sea|strong="H1961"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* multipliquen, \w y|strong="H1571"\w* suceda \w que|strong="H3588"\w* \w cuando|strong="H3588"\w* estalle alguna \w guerra|strong="H4421"\w*, \w ellos|strong="H1931"\w* \w también|strong="H1571"\w* \w se|strong="H1961"\w* unan \w a|strong="H3068"\w* nuestros \w enemigos|strong="H8130"\w*, luchen \w contra|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w y|strong="H1571"\w* escapen \w del|strong="H4480"\w* país.”  
\v 11 \w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H5921"\w*, \w les|strong="H5921"\w* \w pusieron|strong="H7760"\w* capataces \w para|strong="H4616"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* oprimieran \w con|strong="H5921"\w* trabajos pesados. Construyeron \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* almacenamiento \w para|strong="H4616"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w*: Pitón \w y|strong="H5921"\w* Ramsés.  
\v 12 Pero \w cuanto|strong="H3651"\w* \w más|strong="H7235"\w* \w los|strong="H1121"\w* oprimían, \w más|strong="H7235"\w* \w se|strong="H3651"\w* multiplicaban y \w más|strong="H7235"\w* \w se|strong="H3651"\w* extendían. \w Los|strong="H1121"\w* egipcios comenzaron \w a|strong="H3068"\w* temer \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*,  
\v 13 y \w los|strong="H1121"\w* hicieron trabajar sin piedad.  
\v 14 Les amargaron \w la|strong="H3605"\w* \w vida|strong="H2416"\w* con un \w duro|strong="H7186"\w* servicio haciendo \w barro|strong="H2563"\w* y \w ladrillos|strong="H3843"\w*, y con \w todo|strong="H3605"\w* tipo de trabajo en \w el|strong="H3605"\w* \w campo|strong="H7704"\w*; en \w todos|strong="H3605"\w* sus trabajos \w los|strong="H3605"\w* hacían \w servir|strong="H5647"\w* con crueldad.   
\p
\v 15 El \w rey|strong="H4428"\w* de \w Egipto|strong="H4714"\w* habló con las parteras \w hebreas|strong="H5680"\w*, de las cuales una se \w llamaba|strong="H8034"\w* Sifra y la \w otra|strong="H8145"\w* Fúa,  
\v 16 \w y|strong="H5921"\w* \w les|strong="H5921"\w* dijo: “Cuando atiendan \w los|strong="H1121"\w* partos \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w mujeres|strong="H1323"\w* \w hebreas|strong="H5680"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w vean|strong="H7200"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* silla \w de|strong="H5921"\w* dar \w a|strong="H3068"\w* luz, \w si|strong="H1931"\w* \w es|strong="H1931"\w* un niño, \w lo|strong="H1931"\w* \w matarán|strong="H4191"\w*; pero \w si|strong="H1931"\w* \w es|strong="H1931"\w* una niña, \w la|strong="H1931"\w* dejarán vivir.”  
\v 17 Pero las parteras \w temían|strong="H3372"\w* \w a|strong="H3068"\w* Dios,\f + \fr 1:17 \ft El temor a Dios las llevó a desobedecer la orden del rey.\f* y \w no|strong="H3808"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w el|strong="H6213"\w* \w rey|strong="H4428"\w* \w de|strong="H3372"\w* \w Egipto|strong="H4714"\w* les ordenó, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* dejaron \w vivir|strong="H2421"\w* \w a|strong="H3068"\w* los \w niños|strong="H3206"\w*.  
\v 18 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* \w de|strong="H1697"\w* \w Egipto|strong="H4714"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* las parteras y les dijo: “¿\w Por|strong="H4069"\w* \w qué|strong="H1697"\w* han \w hecho|strong="H6213"\w* \w esto|strong="H2088"\w* y han dejado \w vivir|strong="H2421"\w* \w a|strong="H3068"\w* los \w niños|strong="H3206"\w*?”   
\p
\v 19 Las parteras le dijeron al \w faraón|strong="H6547"\w*: “\w Porque|strong="H3588"\w* las mujeres \w hebreas|strong="H5680"\w* \w no|strong="H3808"\w* \w son|strong="H3588"\w* \w como|strong="H3588"\w* las egipcias; \w son|strong="H3588"\w* vigorosas \w y|strong="H3588"\w* dan \w a|strong="H3068"\w* luz \w antes|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* partera llegue \w a|strong="H3068"\w* atenderlas.”   
\p
\v 20 Dios trató \w bien|strong="H3190"\w* \w a|strong="H3068"\w* las parteras, y el \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* \w multiplicó|strong="H7235"\w* y \w se|strong="H5971"\w* hizo \w muy|strong="H3966"\w* fuerte.  
\v 21 \w Como|strong="H3588"\w* las parteras \w temieron|strong="H3372"\w* \w a|strong="H3068"\w* Dios, \w él|strong="H3588"\w* les concedió \w tener|strong="H1961"\w* sus propias \w familias|strong="H1004"\w*.  
\v 22 Entonces \w el|strong="H3605"\w* \w faraón|strong="H6547"\w* le \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su \w pueblo|strong="H5971"\w*: “\w Echarán|strong="H7993"\w* al \w río|strong="H2975"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* niño hebreo \w que|strong="H5971"\w* nazca, pero \w a|strong="H3068"\w* \w toda|strong="H3605"\w* niña \w la|strong="H3605"\w* dejarán \w vivir|strong="H2421"\w*.”   
\c 2  
\p
\v 1 Un hombre de la tribu de \w Leví|strong="H3878"\w* \w fue|strong="H3212"\w* y se \w casó|strong="H3947"\w* con una mujer de su misma tribu.  
\v 2 \w La|strong="H1931"\w* mujer quedó \w embarazada|strong="H2029"\w* \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*. Al \w ver|strong="H7200"\w* \w que|strong="H3588"\w* \w era|strong="H1121"\w* un niño \w hermoso|strong="H2896"\w*, \w lo|strong="H1931"\w* escondió durante \w tres|strong="H7969"\w* \w meses|strong="H3391"\w*.  
\v 3 Cuando ya \w no|strong="H3808"\w* \w pudo|strong="H3201"\w* esconderlo \w más|strong="H5750"\w*, \w tomó|strong="H3947"\w* una canasta \w de|strong="H5921"\w* papiro \w para|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* recubrió \w con|strong="H5921"\w* asfalto \w y|strong="H5921"\w* brea. \w Puso|strong="H7760"\w* \w al|strong="H5921"\w* niño adentro \w y|strong="H5921"\w* dejó \w la|strong="H5921"\w* canasta \w entre|strong="H5921"\w* \w los|strong="H5921"\w* juncos \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w río|strong="H2975"\w*.  
\v 4 La hermana del niño \w se|strong="H3045"\w* quedó \w a|strong="H3068"\w* \w lo|strong="H4100"\w* \w lejos|strong="H7350"\w* \w para|strong="H3320"\w* ver \w qué|strong="H4100"\w* pasaba con \w él|strong="H6213"\w*.  
\v 5 \w La|strong="H5921"\w* \w hija|strong="H1323"\w* \w del|strong="H5921"\w* \w faraón|strong="H6547"\w* bajó \w a|strong="H3068"\w* bañarse \w al|strong="H5921"\w* \w río|strong="H2975"\w*, mientras sus \w doncellas|strong="H5291"\w* caminaban \w por|strong="H5921"\w* \w la|strong="H5921"\w* orilla. \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* \w la|strong="H5921"\w* canasta \w entre|strong="H8432"\w* \w los|strong="H5921"\w* juncos, \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* su sirvienta \w a|strong="H3068"\w* buscarla.  
\v 6 \w La|strong="H5921"\w* \w abrió|strong="H6605"\w* \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w al|strong="H5921"\w* \w niño|strong="H5288"\w*, \w y|strong="H5921"\w* resulta \w que|strong="H5921"\w* \w el|strong="H5921"\w* pequeño \w estaba|strong="H2009"\w* \w llorando|strong="H1058"\w*. \w Se|strong="H5921"\w* compadeció \w de|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* dijo: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* uno \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w niños|strong="H5288"\w* \w hebreos|strong="H5680"\w*”.   
\p
\v 7 Entonces la hermana \w del|strong="H4480"\w* niño le dijo \w a|strong="H3068"\w* la \w hija|strong="H1323"\w* \w del|strong="H4480"\w* \w faraón|strong="H6547"\w*: “¿Quiere \w que|strong="H4480"\w* \w vaya|strong="H3212"\w* \w a|strong="H3068"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* una nodriza \w hebrea|strong="H5680"\w* \w para|strong="H4480"\w* \w que|strong="H4480"\w* le amamante \w al|strong="H4480"\w* niño?”   
\p
\v 8 La \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w* le contestó: “\w Ve|strong="H3212"\w*”.  
\p La joven \w fue|strong="H3212"\w* y \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* la madre del niño.  
\v 9 La \w hija|strong="H1323"\w* del \w faraón|strong="H6547"\w* le dijo: “Llévate \w a|strong="H3068"\w* \w este|strong="H2088"\w* niño y críalo \w por|strong="H2088"\w* mí, y yo te \w pagaré|strong="H5414"\w* \w por|strong="H2088"\w* tu trabajo”.  
\p La mujer \w tomó|strong="H3947"\w* al niño y \w lo|strong="H2088"\w* amamantó.  
\v 10 \w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* niño \w creció|strong="H1431"\w*, \w se|strong="H1961"\w* lo llevó \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w hija|strong="H1323"\w* \w del|strong="H4480"\w* \w faraón|strong="H6547"\w*, \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w se|strong="H1961"\w* convirtió \w en|strong="H4480"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*. \w Ella|strong="H4480"\w* le puso \w por|strong="H3588"\w* \w nombre|strong="H8034"\w* \w Moisés|strong="H4872"\w*, \w y|strong="H3588"\w* dijo: “\w Porque|strong="H3588"\w* lo saqué \w del|strong="H4480"\w* \w agua|strong="H4325"\w*”.   
\p
\v 11 \w En|strong="H3318"\w* \w aquellos|strong="H1992"\w* \w días|strong="H3117"\w*, \w cuando|strong="H3117"\w* \w Moisés|strong="H4872"\w* ya \w era|strong="H1961"\w* adulto, \w salió|strong="H3318"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w su|strong="H1992"\w* propia gente y \w vio|strong="H7200"\w* \w sus|strong="H1992"\w* duros trabajos. \w Vio|strong="H7200"\w* \w que|strong="H3117"\w* un \w egipcio|strong="H4713"\w* \w estaba|strong="H1961"\w* golpeando \w a|strong="H3068"\w* un \w hebreo|strong="H5680"\w*, uno de \w los|strong="H1992"\w* suyos.  
\v 12 \w Miró|strong="H7200"\w* \w a|strong="H3068"\w* un lado \w y|strong="H3588"\w* \w a|strong="H3068"\w* otro, \w y|strong="H3588"\w* al \w ver|strong="H7200"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w había|strong="H3588"\w* nadie, \w mató|strong="H5221"\w* al \w egipcio|strong="H4713"\w* \w y|strong="H3588"\w* lo \w escondió|strong="H2934"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* arena.   
\p
\v 13 Al \w día|strong="H3117"\w* \w siguiente|strong="H8145"\w* \w salió|strong="H3318"\w* de nuevo, y \w vio|strong="H2009"\w* \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w hebreos|strong="H5680"\w* \w que|strong="H4100"\w* estaban peleando. Le dijo al \w que|strong="H4100"\w* tenía la culpa: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* golpeas \w a|strong="H3068"\w* tu \w compañero|strong="H7453"\w*?”.   
\p
\v 14 \w El|strong="H5921"\w* hombre \w le|strong="H5921"\w* respondió: “¿\w Quién|strong="H4310"\w* \w te|strong="H5921"\w* \w puso|strong="H7760"\w* \w como|strong="H5921"\w* \w jefe|strong="H8269"\w* \w y|strong="H5921"\w* \w juez|strong="H8199"\w* \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w*? ¿Acaso piensas \w matarme|strong="H2026"\w*, \w como|strong="H5921"\w* \w mataste|strong="H2026"\w* \w al|strong="H5921"\w* \w egipcio|strong="H4713"\w*?”  
\p \w Moisés|strong="H4872"\w* \w tuvo|strong="H3372"\w* \w miedo|strong="H3372"\w* \w y|strong="H5921"\w* pensó: “Seguramente ya \w se|strong="H3045"\w* \w sabe|strong="H3045"\w* \w lo|strong="H1697"\w* \w que|strong="H4310"\w* hice”.  
\v 15 Cuando \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w se|strong="H5921"\w* enteró \w de|strong="H5921"\w* \w esto|strong="H2088"\w*, intentó matar \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*. Pero \w Moisés|strong="H4872"\w* \w huyó|strong="H1272"\w* \w del|strong="H5921"\w* \w faraón|strong="H6547"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* fue \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* \w Madián|strong="H4080"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* sentó \w junto|strong="H5921"\w* \w a|strong="H3068"\w* un pozo.   
\p
\v 16 El \w sacerdote|strong="H3548"\w* de \w Madián|strong="H4080"\w* tenía \w siete|strong="H7651"\w* \w hijas|strong="H1323"\w*. Ellas fueron \w a|strong="H3068"\w* sacar agua y \w llenaron|strong="H4390"\w* los bebederos para darle agua al \w rebaño|strong="H6629"\w* de su padre.  
\v 17 En eso llegaron unos \w pastores|strong="H7462"\w* y las echaron de allí; pero \w Moisés|strong="H4872"\w* se \w levantó|strong="H6965"\w*, las defendió y le dio agua \w a|strong="H3068"\w* su \w rebaño|strong="H6629"\w*.  
\v 18 \w Cuando|strong="H3117"\w* ellas regresaron \w a|strong="H3068"\w* donde estaba \w Reuel|strong="H7467"\w*, su padre, él les preguntó: “¿\w Cómo|strong="H4069"\w* es \w que|strong="H3117"\w* \w hoy|strong="H3117"\w* regresaron tan temprano?”   
\p
\v 19 Ellas respondieron: “Un \w egipcio|strong="H4713"\w* nos \w defendió|strong="H5337"\w* de los \w pastores|strong="H7462"\w*; \w además|strong="H1571"\w*, nos \w sacó|strong="H1802"\w* agua \w y|strong="H1571"\w* le dio de \w beber|strong="H8248"\w* al \w rebaño|strong="H6629"\w*.”   
\p
\v 20 Él les dijo \w a|strong="H3068"\w* sus \w hijas|strong="H1323"\w*: “¿\w Y|strong="H3068"\w* dónde \w está|strong="H2088"\w*? ¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* \w dejaron|strong="H5800"\w* \w a|strong="H3068"\w* \w ese|strong="H2088"\w* hombre allá? Llámenlo para \w que|strong="H4100"\w* venga \w a|strong="H3068"\w* comer con nosotros”.   
\p
\v 21 \w Moisés|strong="H4872"\w* aceptó quedarse \w a|strong="H3068"\w* vivir con aquel hombre, y \w él|strong="H3427"\w* le \w dio|strong="H5414"\w* \w por|strong="H5414"\w* esposa \w a|strong="H3068"\w* su \w hija|strong="H1323"\w* Séfora.  
\v 22 Ella dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, \w y|strong="H3588"\w* Moisés le \w puso|strong="H3205"\w* \w por|strong="H3588"\w* \w nombre|strong="H8034"\w* Gersón, \w porque|strong="H3588"\w* dijo: “He \w sido|strong="H1961"\w* un \w extranjero|strong="H1616"\w* \w en|strong="H3588"\w* tierra \w extraña|strong="H5237"\w*”.   
\p
\v 23 Pasó \w mucho|strong="H7227"\w* \w tiempo|strong="H3117"\w* y \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w murió|strong="H4191"\w*. \w Los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* gemían \w a|strong="H3068"\w* causa \w de|strong="H4480"\w* \w su|strong="H1992"\w* esclavitud y clamaban pidiendo ayuda, y \w sus|strong="H1992"\w* gritos llegaron \w hasta|strong="H3117"\w* Dios.  
\v 24 Dios \w escuchó|strong="H8085"\w* sus gemidos y se acordó de su \w pacto|strong="H1285"\w* con Abraham, con \w Isaac|strong="H3327"\w* y con \w Jacob|strong="H3290"\w*.  
\v 25 Dios \w miró|strong="H7200"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y comprendió su situación.   
\c 3  
\p
\v 1 \w Moisés|strong="H4872"\w* cuidaba las \w ovejas|strong="H6629"\w* de su \w suegro|strong="H2859"\w* Jetro, el \w sacerdote|strong="H3548"\w* de \w Madián|strong="H4080"\w*. Un día \w llevó|strong="H5090"\w* el \w rebaño|strong="H6629"\w* más allá del \w desierto|strong="H4057"\w* y llegó \w a|strong="H3068"\w* \w Horeb|strong="H2722"\w*, el \w monte|strong="H2022"\w* de Dios.  
\v 2 Allí se le \w apareció|strong="H7200"\w* el \w ángel|strong="H4397"\w* de Yahvé \w en|strong="H8432"\w* una llama de fuego \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de una zarza. Moisés \w miró|strong="H7200"\w* \w y|strong="H1197"\w* \w vio|strong="H7200"\w* que \w la|strong="H1197"\w* zarza \w ardía|strong="H1197"\w* \w en|strong="H8432"\w* llamas, pero no se consumía.  
\v 3 \w Entonces|strong="H5493"\w* \w Moisés|strong="H4872"\w* pensó: “Voy \w a|strong="H3068"\w* acercarme \w para|strong="H5493"\w* \w ver|strong="H7200"\w* \w esta|strong="H2088"\w* maravilla \w y|strong="H1197"\w* descubrir \w por|strong="H4069"\w* \w qué|strong="H3808"\w* \w la|strong="H1197"\w* zarza \w no|strong="H3808"\w* \w se|strong="H3808"\w* quema”.   
\p
\v 4 \w Cuando|strong="H3588"\w* Yahvé \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w Moisés|strong="H4872"\w* se acercaba \w para|strong="H3588"\w* \w mirar|strong="H7200"\w*, \w Dios|strong="H3068"\w* lo \w llamó|strong="H7121"\w* desde \w la|strong="H3588"\w* zarza: “¡\w Moisés|strong="H4872"\w*! ¡\w Moisés|strong="H4872"\w*!”  
\p \w Y|strong="H3068"\w* \w él|strong="H3588"\w* respondió: “\w Aquí|strong="H2009"\w* estoy”.   
\p
\v 5 Dios \w le|strong="H1931"\w* dijo: “\w No|strong="H3588"\w* \w te|strong="H5921"\w* acerques \w más|strong="H3588"\w*. Quítate \w las|strong="H5921"\w* sandalias, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* \w estás|strong="H5975"\w* parado \w es|strong="H1931"\w* tierra \w santa|strong="H6944"\w*”.  
\v 6 \w Y|strong="H3068"\w* añadió: “\w Yo|strong="H3588"\w* soy \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* tu padre, \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* Abraham, \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* \w Isaac|strong="H3327"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* Dios \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w*”.  
\p \w Moisés|strong="H4872"\w* se \w cubrió|strong="H5641"\w* \w el|strong="H3588"\w* \w rostro|strong="H6440"\w* \w porque|strong="H3588"\w* \w tuvo|strong="H3372"\w* \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* mirar \w a|strong="H3068"\w* Dios.   
\p
\v 7 Yahvé le dijo: “He \w visto|strong="H7200"\w* \w el|strong="H3588"\w* sufrimiento \w de|strong="H3588"\w* mi \w pueblo|strong="H5971"\w* \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*. He escuchado sus gritos \w de|strong="H3588"\w* angustia \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* sus capataces, \w y|strong="H3588"\w* \w conozco|strong="H3045"\w* muy \w bien|strong="H3588"\w* sus \w dolores|strong="H4341"\w*.  
\v 8 He bajado \w para|strong="H4480"\w* rescatarlos \w del|strong="H4480"\w* \w poder|strong="H3027"\w* \w de|strong="H4480"\w* \w los|strong="H1931"\w* \w egipcios|strong="H4713"\w* y \w para|strong="H4480"\w* sacarlos \w de|strong="H4480"\w* \w ese|strong="H1931"\w* país, \w a|strong="H3068"\w* fin \w de|strong="H4480"\w* llevarlos \w a|strong="H3068"\w* una tierra \w buena|strong="H2896"\w* y \w espaciosa|strong="H7342"\w*, una tierra \w donde|strong="H4725"\w* abundan \w la|strong="H1931"\w* \w leche|strong="H2461"\w* y \w la|strong="H1931"\w* \w miel|strong="H1706"\w*; \w es|strong="H1931"\w* \w la|strong="H1931"\w* tierra \w donde|strong="H4725"\w* viven \w los|strong="H1931"\w* \w cananeos|strong="H3669"\w*, \w los|strong="H1931"\w* hititas, \w los|strong="H1931"\w* amorreos, \w los|strong="H1931"\w* ferezeos, \w los|strong="H1931"\w* \w heveos|strong="H2340"\w* y \w los|strong="H1931"\w* \w jebuseos|strong="H2983"\w*.  
\v 9 \w El|strong="H1121"\w* \w clamor|strong="H6818"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* ha llegado hasta \w mí|strong="H2009"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* he \w visto|strong="H7200"\w* \w cómo|strong="H1571"\w* \w los|strong="H1121"\w* oprimen \w los|strong="H1121"\w* \w egipcios|strong="H4713"\w*.  
\v 10 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* prepárate, porque te voy \w a|strong="H3068"\w* enviar al \w faraón|strong="H6547"\w* \w para|strong="H6258"\w* \w que|strong="H6258"\w* saques \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 11 \w Pero|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w le|strong="H4310"\w* dijo \w a|strong="H3068"\w* Dios: “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* soy \w yo|strong="H3588"\w* \w para|strong="H3588"\w* presentarme ante \w el|strong="H3588"\w* \w faraón|strong="H6547"\w* \w y|strong="H3588"\w* sacar \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*?”   
\p
\v 12 Dios \w le|strong="H5921"\w* contestó: “\w Yo|strong="H3588"\w* estaré \w contigo|strong="H5973"\w*. \w Y|strong="H3068"\w* \w esta|strong="H2088"\w* \w será|strong="H1961"\w* \w la|strong="H5921"\w* señal \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H5921"\w* he \w enviado|strong="H7971"\w*: \w cuando|strong="H3588"\w* hayas \w sacado|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*, ustedes adorarán \w a|strong="H3068"\w* Dios \w en|strong="H5921"\w* \w este|strong="H2088"\w* mismo \w monte|strong="H2022"\w*.”   
\p
\v 13 \w Moisés|strong="H4872"\w* le dijo \w a|strong="H3068"\w* Dios: “Supongamos \w que|strong="H4100"\w* me presento ante \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y les digo: \w El|strong="H1121"\w* Dios \w de|strong="H1121"\w* sus antepasados me ha \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* ustedes. \w Si|strong="H2009"\w* ellos me preguntan: ¿\w Cuál|strong="H4100"\w* es su \w nombre|strong="H8034"\w*?, ¿\w qué|strong="H4100"\w* les voy \w a|strong="H3068"\w* responder?”   
\p
\v 14 Dios le contestó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “YO \w SOY|strong="H1961"\w* \w EL|strong="H1121"\w* \w QUE|strong="H1121"\w* \w SOY|strong="H1961"\w*”. \w Y|strong="H3068"\w* agregó: “\w A|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* les dirás \w esto|strong="H3541"\w*: YO \w SOY|strong="H1961"\w* \w me|strong="H3541"\w* \w ha|strong="H3541"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* ustedes”.  
\v 15 \w Dios|strong="H3068"\w* \w también|strong="H5750"\w* le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Diles \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*: Yahvé, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H5750"\w* sus antepasados, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H5750"\w* Abraham, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H5750"\w* \w Isaac|strong="H3327"\w* \w y|strong="H3541"\w* \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H5750"\w* \w Jacob|strong="H3290"\w*, \w me|strong="H3541"\w* \w ha|strong="H3541"\w* \w enviado|strong="H7971"\w* \w a|strong="H3068"\w* ustedes. \w Este|strong="H2088"\w* \w es|strong="H2088"\w* mi \w nombre|strong="H8034"\w* para \w siempre|strong="H5769"\w*; con \w este|strong="H2088"\w* \w nombre|strong="H8034"\w* seré recordado \w por|strong="H2088"\w* \w todas|strong="H1755"\w* las \w generaciones|strong="H1755"\w*.  
\v 16 \w Ve|strong="H3212"\w* y reúne \w a|strong="H3068"\w* los líderes de \w Israel|strong="H3478"\w*, y diles: Yahvé, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* de sus antepasados, \w el|strong="H6213"\w* \w Dios|strong="H3068"\w* de Abraham, de \w Isaac|strong="H3327"\w* y de \w Jacob|strong="H3290"\w*, se me ha aparecido y me ha dicho: \w Ciertamente|strong="H6485"\w* he venido \w a|strong="H3068"\w* verlos y he \w visto|strong="H7200"\w* \w lo|strong="H6213"\w* que les están \w haciendo|strong="H6213"\w* \w en|strong="H3212"\w* \w Egipto|strong="H4714"\w*.  
\v 17 \w Y|strong="H3068"\w* he decidido sacarlos de la opresión de \w Egipto|strong="H4714"\w* para llevarlos \w a|strong="H3068"\w* la tierra de los \w cananeos|strong="H3669"\w*, de los hititas, de los amorreos, de los ferezeos, de los \w heveos|strong="H2340"\w* y de los \w jebuseos|strong="H2983"\w*, \w a|strong="H3068"\w* una tierra donde abundan la \w leche|strong="H2461"\w* y la \w miel|strong="H1706"\w*.  
\v 18 \w Los|strong="H5921"\w* líderes escucharán tu \w voz|strong="H6963"\w*. \w Luego|strong="H4994"\w* tú \w y|strong="H5921"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w se|strong="H5921"\w* presentarán ante \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* dirán: Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w hebreos|strong="H5680"\w*, ha venido \w a|strong="H3068"\w* nuestro encuentro. \w Ahora|strong="H6258"\w*, \w por|strong="H5921"\w* favor, déjanos hacer un \w viaje|strong="H1870"\w* \w de|strong="H5921"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w hacia|strong="H1870"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w para|strong="H5921"\w* ofrecerle \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*.  
\v 19 \w Yo|strong="H3588"\w* \w sé|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w no|strong="H3808"\w* \w los|strong="H3588"\w* \w dejará|strong="H5414"\w* \w ir|strong="H1980"\w*, \w a|strong="H3068"\w* \w menos|strong="H3588"\w* \w que|strong="H3588"\w* una \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* \w lo|strong="H3808"\w* obligue.  
\v 20 \w Por|strong="H3027"\w* \w eso|strong="H3651"\w*, extenderé mi \w mano|strong="H3027"\w* y castigaré \w a|strong="H3068"\w* Egipto con \w todas|strong="H3605"\w* las \w maravillas|strong="H6381"\w* \w que|strong="H3605"\w* \w haré|strong="H6213"\w* \w en|strong="H5221"\w* ese país, y después de \w eso|strong="H3651"\w* \w el|strong="H3605"\w* \w rey|strong="H5221"\w* \w los|strong="H3605"\w* dejará \w ir|strong="H7971"\w*.  
\v 21 \w Yo|strong="H3588"\w* \w haré|strong="H5414"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w egipcios|strong="H4713"\w* vean \w con|strong="H3588"\w* buenos \w ojos|strong="H5869"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, \w de|strong="H3588"\w* modo \w que|strong="H3588"\w* \w cuando|strong="H3588"\w* ustedes \w se|strong="H1961"\w* \w vayan|strong="H3212"\w*, \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w irán|strong="H3212"\w* \w con|strong="H3588"\w* las manos \w vacías|strong="H7387"\w*.  
\v 22 Cada mujer \w les|strong="H5921"\w* \w pedirá|strong="H7592"\w* \w a|strong="H3068"\w* sus vecinas \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w mujeres|strong="H1323"\w* \w que|strong="H5921"\w* vivan \w en|strong="H5921"\w* su \w casa|strong="H1004"\w*, objetos \w de|strong="H5921"\w* \w plata|strong="H3701"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w y|strong="H5921"\w* \w ropa|strong="H8071"\w*. Todo eso \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w pondrán|strong="H7760"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w hijas|strong="H1323"\w*. Así despojarán \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w egipcios|strong="H4713"\w*”.   
\c 4  
\p
\v 1 \w Moisés|strong="H4872"\w* \w respondió|strong="H6030"\w*: “¿\w Y|strong="H3068"\w* \w qué|strong="H3588"\w* pasa \w si|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* creen \w ni|strong="H3808"\w* \w me|strong="H3588"\w* hacen caso, \w y|strong="H3588"\w* \w me|strong="H3588"\w* dicen: Yahvé \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w te|strong="H3588"\w* \w ha|strong="H3808"\w* aparecido?”   
\p
\v 2 Yahvé le preguntó: “¿\w Qué|strong="H2088"\w* tienes en la \w mano|strong="H3027"\w*?”  
\p Él respondió: “Una \w vara|strong="H4294"\w*”.   
\p
\v 3 Dios le dijo: “Tírala al suelo”.  
\p \w Moisés|strong="H4872"\w* la tiró al suelo, y la vara \w se|strong="H1961"\w* convirtió en una \w serpiente|strong="H5175"\w*; y \w Moisés|strong="H4872"\w* \w se|strong="H1961"\w* alejó \w de|strong="H6440"\w* ella huyendo.   
\p
\v 4 Pero Yahvé le dijo: “\w Extiende|strong="H7971"\w* la \w mano|strong="H3027"\w* y agárrala \w por|strong="H3027"\w* la \w cola|strong="H2180"\w*”.  
\p \w Moisés|strong="H4872"\w* \w extendió|strong="H7971"\w* la \w mano|strong="H3027"\w*, la agarró, y la serpiente volvió \w a|strong="H3068"\w* ser una \w vara|strong="H4294"\w* en su \w mano|strong="H3027"\w*.   
\p
\v 5 “Esto \w es|strong="H3588"\w* \w para|strong="H4616"\w* \w que|strong="H3588"\w* crean \w que|strong="H3588"\w* se \w te|strong="H3588"\w* ha aparecido Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* sus antepasados, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* Abraham, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Isaac|strong="H3327"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w*”.  
\v 6 \w Luego|strong="H4994"\w* Yahvé le dijo: “Mete la \w mano|strong="H3027"\w* \w dentro|strong="H5750"\w* \w de|strong="H5750"\w* tu ropa”.  
\p Moisés metió la \w mano|strong="H3027"\w* \w dentro|strong="H5750"\w* \w de|strong="H5750"\w* su ropa, y cuando la \w sacó|strong="H3318"\w*, su \w mano|strong="H3027"\w* \w estaba|strong="H2009"\w* cubierta \w de|strong="H5750"\w* lepra, blanca \w como|strong="H5750"\w* la nieve.   
\p
\v 7 Dios le ordenó: “\w Vuelve|strong="H7725"\w* \w a|strong="H3068"\w* meter la \w mano|strong="H3027"\w* \w dentro|strong="H2436"\w* de tu ropa”.  
\p Él la \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* meter, y cuando la \w sacó|strong="H3318"\w*, \w vio|strong="H2009"\w* \w que|strong="H3027"\w* \w estaba|strong="H2009"\w* sana de nuevo, como el resto de su piel.   
\p
\v 8 “\w Si|strong="H3808"\w* \w no|strong="H3808"\w* te creen \w ni|strong="H3808"\w* te hacen caso con la \w primera|strong="H7223"\w* señal, te creerán con la segunda.  
\v 9 \w Y|strong="H3068"\w* \w si|strong="H1571"\w* \w a|strong="H3068"\w* pesar \w de|strong="H4480"\w* estas \w dos|strong="H8147"\w* señales \w no|strong="H3808"\w* \w te|strong="H4480"\w* creen \w ni|strong="H3808"\w* \w te|strong="H4480"\w* hacen \w caso|strong="H3947"\w*, sacarás \w agua|strong="H4325"\w* \w del|strong="H4480"\w* \w río|strong="H2975"\w* \w y|strong="H1571"\w* \w la|strong="H1571"\w* derramarás \w sobre|strong="H4480"\w* \w la|strong="H1571"\w* \w tierra|strong="H3004"\w* seca. Esa \w agua|strong="H4325"\w* \w del|strong="H4480"\w* \w río|strong="H2975"\w* \w se|strong="H1961"\w* convertirá \w en|strong="H4480"\w* \w sangre|strong="H1818"\w* \w al|strong="H4480"\w* tocar \w el|strong="H2975"\w* suelo”.   
\p
\v 10 \w Moisés|strong="H4872"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Yahvé: “Ay, \w Señor|strong="H3068"\w*, \w yo|strong="H3588"\w* \w nunca|strong="H3808"\w* he tenido facilidad \w de|strong="H3588"\w* \w palabra|strong="H1697"\w*, \w ni|strong="H3808"\w* \w antes|strong="H3588"\w* \w ni|strong="H3808"\w* ahora \w que|strong="H3588"\w* le hablas \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w*. Soy muy lento \w para|strong="H3588"\w* \w hablar|strong="H1696"\w* \w y|strong="H1571"\w* \w me|strong="H3588"\w* cuesta expresarme”.   
\p
\v 11 Yahvé \w le|strong="H4310"\w* respondió: “¿\w Quién|strong="H4310"\w* \w le|strong="H4310"\w* \w dio|strong="H7760"\w* la \w boca|strong="H6310"\w* al ser humano? ¿Acaso \w no|strong="H3808"\w* soy yo, Yahvé, \w quien|strong="H4310"\w* \w lo|strong="H3808"\w* hace mudo \w o|strong="H3068"\w* \w sordo|strong="H2795"\w*, \w o|strong="H3068"\w* \w quien|strong="H4310"\w* \w le|strong="H4310"\w* \w da|strong="H7760"\w* la vista \w o|strong="H3068"\w* \w lo|strong="H3808"\w* hace \w ciego|strong="H5787"\w*?  
\v 12 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w ve|strong="H3212"\w*, \w que|strong="H6258"\w* yo estaré \w en|strong="H5973"\w* tu \w boca|strong="H6310"\w* y \w te|strong="H5973"\w* enseñaré lo \w que|strong="H6258"\w* tienes \w que|strong="H6258"\w* decir”.   
\p
\v 13 Pero Moisés insistió: “Ay, Señor, te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* envíes \w a|strong="H3068"\w* otra persona”.   
\p
\v 14 \w Entonces|strong="H3588"\w* Yahvé \w se|strong="H3045"\w* enojó \w con|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w y|strong="H1571"\w* \w le|strong="H1931"\w* \w dijo|strong="H1696"\w*: “¿\w Qué|strong="H3588"\w* hay \w de|strong="H3588"\w* tu hermano Aarón, \w el|strong="H1931"\w* \w levita|strong="H3881"\w*? \w Yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w él|strong="H1931"\w* \w habla|strong="H1696"\w* muy \w bien|strong="H3588"\w*. \w Además|strong="H1571"\w*, \w ya|strong="H1571"\w* viene \w en|strong="H3588"\w* camino \w a|strong="H3068"\w* buscarte, \w y|strong="H1571"\w* \w se|strong="H3045"\w* alegrará mucho al verte.  
\v 15 \w Tú|strong="H6213"\w* \w le|strong="H5973"\w* \w hablarás|strong="H1696"\w* y \w le|strong="H5973"\w* \w pondrás|strong="H7760"\w* las \w palabras|strong="H1697"\w* \w en|strong="H5973"\w* la \w boca|strong="H6310"\w*. \w Yo|strong="H6213"\w* estaré \w con|strong="H5973"\w* ustedes \w cuando|strong="H1961"\w* \w hablen|strong="H1696"\w*, y \w les|strong="H5973"\w* enseñaré \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w tienen|strong="H1961"\w* \w que|strong="H1697"\w* \w hacer|strong="H6213"\w*.  
\v 16 \w Él|strong="H1931"\w* \w hablará|strong="H1696"\w* por ti ante \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w*. \w Él|strong="H1931"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* tu \w boca|strong="H6310"\w*, y tú \w serás|strong="H1961"\w* \w para|strong="H1961"\w* \w él|strong="H1931"\w* \w como|strong="H1961"\w* Dios.  
\v 17 Lleva en \w tu|strong="H6213"\w* \w mano|strong="H3027"\w* \w esta|strong="H2088"\w* \w vara|strong="H4294"\w*, porque con ella \w harás|strong="H6213"\w* las señales”.   
\p
\v 18 \w Moisés|strong="H4872"\w* se \w fue|strong="H3212"\w* y regresó \w a|strong="H3068"\w* donde \w estaba|strong="H2416"\w* su \w suegro|strong="H2859"\w* Jetro, y le dijo: “\w Por|strong="H5750"\w* favor, déjame \w volver|strong="H7725"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* para \w ver|strong="H7200"\w* \w si|strong="H4994"\w* mis hermanos \w todavía|strong="H5750"\w* están \w vivos|strong="H2416"\w*.”  
\p Jetro le \w respondió|strong="H7725"\w*: “\w Vete|strong="H3212"\w* \w en|strong="H5750"\w* \w paz|strong="H7965"\w*”.   
\p
\v 19 Yahvé le \w había|strong="H3588"\w* dicho \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w en|strong="H3588"\w* \w Madián|strong="H4080"\w*: “Regresa \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, \w porque|strong="H3588"\w* ya \w han|strong="H4191"\w* \w muerto|strong="H4191"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* querían quitarte \w la|strong="H3588"\w* \w vida|strong="H5315"\w*”.   
\p
\v 20 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su esposa \w y|strong="H5921"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, \w los|strong="H1121"\w* montó \w en|strong="H5921"\w* un burro \w y|strong="H5921"\w* emprendió \w el|strong="H5921"\w* regreso \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*. \w Moisés|strong="H4872"\w* llevaba \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w la|strong="H5921"\w* \w vara|strong="H4294"\w* \w de|strong="H5921"\w* Dios.  
\v 21 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Cuando regreses \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, asegúrate \w de|strong="H6440"\w* \w hacer|strong="H6213"\w* \w ante|strong="H6440"\w* \w el|strong="H3605"\w* \w faraón|strong="H6547"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* milagros \w que|strong="H3808"\w* te he dado \w el|strong="H3605"\w* \w poder|strong="H3027"\w* \w de|strong="H6440"\w* realizar. Pero \w yo|strong="H6213"\w* \w haré|strong="H6213"\w* \w que|strong="H3808"\w* \w él|strong="H3605"\w* \w se|strong="H3808"\w* \w ponga|strong="H7760"\w* terco, y \w no|strong="H3808"\w* dejará \w ir|strong="H3212"\w* al \w pueblo|strong="H5971"\w*.  
\v 22 Entonces le dirás al \w faraón|strong="H6547"\w*: \w Así|strong="H3541"\w* dice Yahvé: \w Israel|strong="H3478"\w* \w es|strong="H3541"\w* mi \w hijo|strong="H1121"\w*, mi \w primogénito|strong="H1060"\w*,  
\v 23 y \w yo|strong="H2009"\w* te he ordenado \w que|strong="H1121"\w* dejes \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w hijo|strong="H1121"\w* para \w que|strong="H1121"\w* me adore. Pero como te \w has|strong="H2026"\w* negado \w a|strong="H3068"\w* dejarlo \w ir|strong="H7971"\w*, voy \w a|strong="H3068"\w* quitarle la vida \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w* \w primogénito|strong="H1060"\w*”.   
\p
\v 24 En el \w camino|strong="H1870"\w*, en el lugar donde pasaban la noche, Yahvé salió al encuentro de Moisés y quiso \w matarlo|strong="H4191"\w*.  
\v 25 \w Entonces|strong="H3588"\w* Séfora agarró un cuchillo \w de|strong="H3588"\w* pedernal, le \w cortó|strong="H3772"\w* \w el|strong="H3588"\w* \w prepucio|strong="H6190"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* \w y|strong="H3588"\w* lo arrojó \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w pies|strong="H7272"\w* \w de|strong="H3588"\w* Moisés, diciendo: “Eres \w para|strong="H3588"\w* mí un \w esposo|strong="H2860"\w* \w de|strong="H3588"\w* \w sangre|strong="H1818"\w*”.   
\p
\v 26 Así \w que|strong="H4480"\w* Dios lo \w dejó|strong="H7503"\w* vivir. \w Ella|strong="H4480"\w* le dijo “\w esposo|strong="H2860"\w* \w de|strong="H4480"\w* \w sangre|strong="H1818"\w*” \w por|strong="H4480"\w* causa \w de|strong="H4480"\w* la circuncisión.   
\p
\v 27 Yahvé le dijo \w a|strong="H3068"\w* Aarón: “\w Ve|strong="H3212"\w* al \w desierto|strong="H4057"\w* \w a|strong="H3068"\w* encontrarte con \w Moisés|strong="H4872"\w*”.  
\p Aarón \w fue|strong="H3212"\w*, se encontró con él \w en|strong="H3212"\w* el \w monte|strong="H2022"\w* de \w Dios|strong="H3068"\w* y lo \w besó|strong="H5401"\w*.  
\v 28 \w Moisés|strong="H4872"\w* le \w contó|strong="H5046"\w* \w a|strong="H3068"\w* Aarón \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé le había encargado decir, y le \w habló|strong="H1697"\w* \w de|strong="H1697"\w* \w todas|strong="H3605"\w* las señales milagrosas \w que|strong="H1697"\w* le había \w mandado|strong="H6680"\w* hacer.  
\v 29 \w Moisés|strong="H4872"\w* y Aarón se \w fueron|strong="H3212"\w* y reunieron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* líderes \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 30 Aarón repitió \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé \w le|strong="H5869"\w* \w había|strong="H6213"\w* \w dicho|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, y realizó las señales \w delante|strong="H5869"\w* del \w pueblo|strong="H5971"\w*.  
\v 31 \w El|strong="H3588"\w* \w pueblo|strong="H5971"\w* creyó, \w y|strong="H3588"\w* al \w escuchar|strong="H8085"\w* \w que|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* venido \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* \w visto|strong="H7200"\w* \w su|strong="H3588"\w* sufrimiento, \w se|strong="H5971"\w* inclinaron \w y|strong="H3588"\w* \w adoraron|strong="H7812"\w*.   
\c 5  
\p
\v 1 Después vinieron \w Moisés|strong="H4872"\w* \w y|strong="H3541"\w* Aarón \w y|strong="H3541"\w* le dijeron al \w faraón|strong="H6547"\w*: “\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* lo \w que|strong="H5971"\w* dice Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*: ‘\w Deja|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w me|strong="H3541"\w* celebre una fiesta en el \w desierto|strong="H4057"\w*’”.   
\p
\v 2 \w El|strong="H4310"\w* \w faraón|strong="H6547"\w* respondió: “¿\w Quién|strong="H4310"\w* es Yahvé, para \w que|strong="H4310"\w* yo \w escuche|strong="H8085"\w* su \w voz|strong="H6963"\w* \w y|strong="H1571"\w* \w deje|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*? Yo \w no|strong="H3808"\w* \w conozco|strong="H3045"\w* \w a|strong="H3068"\w* Yahvé, \w y|strong="H1571"\w* \w tampoco|strong="H1571"\w* voy \w a|strong="H3068"\w* dejar \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 3 \w Ellos|strong="H5921"\w* \w le|strong="H5921"\w* dijeron: “\w El|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w hebreos|strong="H5680"\w* ha venido \w a|strong="H3068"\w* nuestro encuentro. \w Por|strong="H5921"\w* favor, déjanos \w ir|strong="H3212"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w camino|strong="H1870"\w* \w al|strong="H5921"\w* \w desierto|strong="H4057"\w* \w para|strong="H5921"\w* ofrecerle \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*, \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H4994"\w* \w nos|strong="H5921"\w* castigue \w con|strong="H5921"\w* enfermedades \w o|strong="H3068"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*.”   
\p
\v 4 El \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w* les reclamó: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* ustedes, \w Moisés|strong="H4872"\w* y Aarón, distraen \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w* \w de|strong="H5971"\w* su trabajo? ¡Vuelvan \w a|strong="H3068"\w* sus obligaciones!”  
\v 5 \w Y|strong="H3068"\w* el \w faraón|strong="H6547"\w* añadió: “Miren, \w ahora|strong="H6258"\w* el \w pueblo|strong="H5971"\w* es muy \w numeroso|strong="H7227"\w* en la tierra, y ustedes hacen \w que|strong="H6258"\w* dejen \w de|strong="H5971"\w* trabajar”.  
\v 6 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w* \w el|strong="H1931"\w* \w faraón|strong="H6547"\w* \w les|strong="H6680"\w* dio \w esta|strong="H1931"\w* \w orden|strong="H6680"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* capataces del \w pueblo|strong="H5971"\w* y \w a|strong="H3068"\w* \w sus|strong="H1931"\w* supervisores:  
\v 7 “\w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w le|strong="H3254"\w* \w darán|strong="H5414"\w* al \w pueblo|strong="H5971"\w* \w paja|strong="H8401"\w* \w para|strong="H5414"\w* hacer \w ladrillos|strong="H3843"\w*, como hacían \w antes|strong="H8543"\w*. ¡\w Que|strong="H3808"\w* \w vayan|strong="H3212"\w* \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* \w a|strong="H3068"\w* juntar la \w paja|strong="H8401"\w*!  
\v 8 \w Pero|strong="H3588"\w* \w les|strong="H1992"\w* exigirán \w la|strong="H5921"\w* misma cantidad \w de|strong="H4480"\w* \w ladrillos|strong="H3843"\w* \w que|strong="H3588"\w* \w hacían|strong="H6213"\w* \w antes|strong="H3588"\w*. \w No|strong="H3808"\w* \w les|strong="H1992"\w* rebajarán \w nada|strong="H3808"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w unos|strong="H1992"\w* flojos. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* andan gritando: ‘\w Vamos|strong="H3212"\w* \w a|strong="H3068"\w* ofrecerle \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* nuestro Dios’.  
\v 9 Auméntenles \w el|strong="H5921"\w* trabajo pesado \w a|strong="H3068"\w* estos hombres, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* mantengan ocupados \w y|strong="H5921"\w* \w no|strong="H6213"\w* anden creyendo \w en|strong="H5921"\w* \w mentiras|strong="H8267"\w*”.   
\p
\v 10 Los capataces \w y|strong="H3541"\w* los supervisores \w salieron|strong="H3318"\w* \w y|strong="H3541"\w* le dijeron al \w pueblo|strong="H5971"\w*: “\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* lo \w que|strong="H5971"\w* dice \w el|strong="H5065"\w* \w faraón|strong="H6547"\w*: ‘\w Ya|strong="H3068"\w* no les voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w paja|strong="H8401"\w*.  
\v 11 \w Vayan|strong="H3212"\w* ustedes mismos \w y|strong="H3588"\w* consigan \w paja|strong="H8401"\w* donde puedan encontrarla, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* se les \w va|strong="H3068"\w* \w a|strong="H3068"\w* rebajar \w nada|strong="H1697"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* trabajo’”.  
\v 12 Así \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* dispersó por \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5971"\w* recoger rastrojos en lugar \w de|strong="H5971"\w* \w paja|strong="H8401"\w*.  
\v 13 \w Los|strong="H1961"\w* capataces \w los|strong="H1961"\w* presionaban diciendo: “¡\w Tienen|strong="H1961"\w* \w que|strong="H1697"\w* terminar su cuota \w de|strong="H1697"\w* trabajo \w diaria|strong="H3117"\w*, igual \w que|strong="H1697"\w* \w cuando|strong="H3117"\w* \w se|strong="H1961"\w* les daba \w paja|strong="H8401"\w*!”  
\v 14 \w Además|strong="H5921"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* supervisores israelitas \w que|strong="H3808"\w* \w los|strong="H1121"\w* capataces \w del|strong="H5921"\w* \w faraón|strong="H6547"\w* habían puesto \w a|strong="H3068"\w* cargo, \w los|strong="H1121"\w* golpeaban \w y|strong="H1571"\w* \w les|strong="H5921"\w* reclamaban: “¿\w Por|strong="H5921"\w* \w qué|strong="H3808"\w* \w no|strong="H3808"\w* cumplieron \w con|strong="H5921"\w* su cuota \w de|strong="H5921"\w* ladrillos \w ni|strong="H3808"\w* \w ayer|strong="H8543"\w* \w ni|strong="H3808"\w* \w hoy|strong="H3117"\w*, \w como|strong="H1571"\w* \w lo|strong="H3808"\w* hacían \w antes|strong="H8543"\w*?”   
\p
\v 15 Entonces \w los|strong="H1121"\w* supervisores israelitas fueron \w a|strong="H3068"\w* quejarse con \w el|strong="H1121"\w* \w faraón|strong="H6547"\w*: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* tratas \w así|strong="H3541"\w* \w a|strong="H3068"\w* tus \w siervos|strong="H5650"\w*?  
\v 16 \w No|strong="H6213"\w* nos \w dan|strong="H5414"\w* \w paja|strong="H8401"\w*, y encima nos exigen: ‘¡\w Hagan|strong="H6213"\w* \w ladrillos|strong="H3843"\w*!’ \w Y|strong="H3068"\w* \w mira|strong="H2009"\w*, \w a|strong="H3068"\w* tus \w siervos|strong="H5650"\w* nos agarran \w a|strong="H3068"\w* golpes, \w cuando|strong="H5650"\w* la culpa es \w de|strong="H5971"\w* \w tu|strong="H6213"\w* propia \w gente|strong="H5971"\w*.”   
\p
\v 17 Pero \w el|strong="H5921"\w* faraón \w les|strong="H5921"\w* contestó: “¡Son unos flojos! ¡\w Eso|strong="H3651"\w* es \w lo|strong="H5921"\w* \w que|strong="H5921"\w* son! \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* andan diciendo: ‘Queremos \w ir|strong="H3212"\w* \w a|strong="H3068"\w* ofrecerle \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé’.  
\v 18 ¡\w Así|strong="H6258"\w* \w que|strong="H3808"\w* \w vayan|strong="H3212"\w* \w a|strong="H3068"\w* trabajar \w ahora|strong="H6258"\w* mismo! \w No|strong="H3808"\w* \w se|strong="H3808"\w* les \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w paja|strong="H8401"\w*, pero tendrán \w que|strong="H3808"\w* entregar la misma cantidad \w de|strong="H5414"\w* \w ladrillos|strong="H3843"\w*.”   
\p
\v 19 \w Los|strong="H1121"\w* supervisores israelitas \w se|strong="H3808"\w* dieron \w cuenta|strong="H1697"\w* \w de|strong="H1121"\w* \w que|strong="H3808"\w* estaban en graves problemas \w cuando|strong="H3117"\w* \w se|strong="H3808"\w* les dijo: “¡\w No|strong="H3808"\w* \w se|strong="H3808"\w* les rebajará \w ni|strong="H3808"\w* un solo \w ladrillo|strong="H3843"\w* \w de|strong="H1121"\w* su cuota \w diaria|strong="H3117"\w*!”   
\p
\v 20 Al \w salir|strong="H3318"\w* de hablar con el \w faraón|strong="H6547"\w*, se encontraron con \w Moisés|strong="H4872"\w* y Aarón, que los \w estaban|strong="H5324"\w* esperando \w en|strong="H3318"\w* el camino.  
\v 21 \w Y|strong="H3068"\w* \w les|strong="H5921"\w* dijeron: “¡\w Que|strong="H5921"\w* Yahvé \w los|strong="H5921"\w* \w vea|strong="H7200"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w juzgue|strong="H8199"\w*! Ustedes \w nos|strong="H5921"\w* han hecho quedar muy mal ante \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w y|strong="H5921"\w* sus funcionarios; ¡prácticamente \w les|strong="H5921"\w* \w pusieron|strong="H5414"\w* una \w espada|strong="H2719"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w nos|strong="H5921"\w* \w maten|strong="H2026"\w*!”   
\p
\v 22 \w Moisés|strong="H4872"\w* regresó \w a|strong="H3068"\w* donde estaba Yahvé y le dijo: “\w Señor|strong="H3068"\w*, ¿\w por|strong="H2088"\w* \w qué|strong="H4100"\w* le has traído tantos problemas \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*? ¿\w Para|strong="H5971"\w* \w qué|strong="H4100"\w* me \w enviaste|strong="H7971"\w*?  
\v 23 \w Porque|strong="H3808"\w* desde \w que|strong="H3808"\w* \w fui|strong="H3808"\w* \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* con el \w faraón|strong="H6547"\w* en tu \w nombre|strong="H8034"\w*, él \w no|strong="H3808"\w* \w ha|strong="H3808"\w* hecho \w más|strong="H3808"\w* \w que|strong="H3808"\w* maltratar \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, y tú \w no|strong="H3808"\w* has hecho \w nada|strong="H3808"\w* \w para|strong="H5971"\w* rescatarlos”.   
\c 6  
\p
\v 1 Yahvé le respondió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Ahora|strong="H6258"\w* vas \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* le \w haré|strong="H6213"\w* al \w faraón|strong="H6547"\w*. Una \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* \w lo|strong="H6213"\w* obligará \w a|strong="H3068"\w* dejarlos \w ir|strong="H7971"\w*; \w es|strong="H3027"\w* \w más|strong="H3588"\w*, ¡esa misma \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* \w hará|strong="H6213"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w eche|strong="H7971"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* país!”   
\p
\v 2 \w Dios|strong="H3068"\w* \w habló|strong="H1696"\w* con \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*: “Yo soy Yahvé.  
\v 3 Me aparecí \w a|strong="H3068"\w* Abraham, \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* y \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* como \w Dios|strong="H3068"\w* \w Todopoderoso|strong="H7706"\w*, pero \w no|strong="H3808"\w* me di \w a|strong="H3068"\w* conocer \w a|strong="H3068"\w* ellos por mi \w nombre|strong="H8034"\w*: Yahvé.  
\v 4 \w También|strong="H1571"\w* \w establecí|strong="H6965"\w* mi \w pacto|strong="H1285"\w* \w con|strong="H1571"\w* \w ellos|strong="H1571"\w*, prometiendo darles \w la|strong="H1571"\w* tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w*, \w la|strong="H1571"\w* tierra donde vivieron \w como|strong="H1571"\w* extranjeros.  
\v 5 \w Además|strong="H1571"\w*, he escuchado \w los|strong="H1121"\w* gemidos \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* quienes \w los|strong="H1121"\w* \w egipcios|strong="H4714"\w* tienen esclavizados, \w y|strong="H1571"\w* me he acordado \w de|strong="H1121"\w* mi \w pacto|strong="H1285"\w*.  
\v 6 \w Por|strong="H8478"\w* lo \w tanto|strong="H3651"\w*, diles \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*: ‘Yo soy Yahvé. \w Los|strong="H1121"\w* sacaré \w de|strong="H8478"\w* \w los|strong="H1121"\w* duros trabajos \w de|strong="H8478"\w* \w Egipto|strong="H4714"\w*, \w los|strong="H1121"\w* liberaré \w de|strong="H8478"\w* su esclavitud y \w los|strong="H1121"\w* rescataré con \w gran|strong="H1419"\w* poder y con \w fuertes|strong="H1121"\w* castigos.  
\v 7 \w Los|strong="H1961"\w* \w tomaré|strong="H3947"\w* \w como|strong="H3588"\w* \w mi|strong="H1961"\w* propio \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w saca|strong="H3318"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* duros trabajos \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*.  
\v 8 Los \w llevaré|strong="H5375"\w* \w a|strong="H3068"\w* la tierra \w que|strong="H3027"\w* juré darles \w a|strong="H3068"\w* Abraham, \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w* y \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w*, y se la \w daré|strong="H5414"\w* como herencia. Yo soy Yahvé’”.   
\p
\v 9 \w Moisés|strong="H4872"\w* les comunicó todo \w esto|strong="H3651"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, pero ellos \w no|strong="H3808"\w* le hicieron caso, \w porque|strong="H3808"\w* estaban muy desanimados \w por|strong="H3651"\w* culpa \w de|strong="H1121"\w* la cruel esclavitud.   
\p
\v 10 Entonces Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*:  
\v 11 “Ve y dile \w al|strong="H4428"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, \w que|strong="H1121"\w* \w deje|strong="H7971"\w* salir \w de|strong="H1121"\w* su país \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.”   
\p
\v 12 Pero \w Moisés|strong="H4872"\w* le contestó \w a|strong="H3068"\w* Yahvé: “\w Si|strong="H2005"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* me hacen caso, ¿cómo me \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w escuchar|strong="H8085"\w* \w el|strong="H1121"\w* \w faraón|strong="H6547"\w*, \w si|strong="H2005"\w* soy tan torpe para \w hablar|strong="H1696"\w*?”  
\v 13 Sin embargo, Yahvé \w les|strong="H6680"\w* \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y \w les|strong="H6680"\w* dio órdenes estrictas para \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y para \w el|strong="H1121"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, con \w el|strong="H1121"\w* fin \w de|strong="H1121"\w* sacar \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas del país.   
\p
\v 14 Estos son \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w familias|strong="H4940"\w* patriarcales. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*, \w el|strong="H1121"\w* \w primogénito|strong="H1060"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, fueron: Hanoc, Falú, \w Hezrón|strong="H2696"\w* y \w Carmí|strong="H3756"\w*. Estas son las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*.  
\v 15 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Simeón|strong="H8095"\w* fueron: \w Jemuel|strong="H3223"\w*, \w Jamín|strong="H3226"\w*, Ohad, Jaquín, Zóhar y \w Saúl|strong="H7586"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* una mujer \w cananea|strong="H3669"\w*. Estas son las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w Simeón|strong="H8095"\w*.  
\v 16 Estos son \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*, según sus descendientes: \w Gersón|strong="H1648"\w*, Coat y \w Merari|strong="H4847"\w*. \w Leví|strong="H3878"\w* vivió \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* y \w siete|strong="H7651"\w* \w años|strong="H8141"\w*.  
\v 17 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1648"\w* fueron: \w Libní|strong="H3845"\w* y Simeí, con sus respectivas \w familias|strong="H4940"\w*.  
\v 18 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat fueron: \w Amram|strong="H6019"\w*, Izhar, \w Hebrón|strong="H2275"\w* y Uziel. Coat vivió \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* y \w tres|strong="H7969"\w* \w años|strong="H8141"\w*.  
\v 19 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w* fueron: Mahlí y Musí. Estas son las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* levitas, según sus descendientes.  
\v 20 \w Amram|strong="H6019"\w* se \w casó|strong="H3947"\w* con su tía Jocabed, y ella dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*. \w Amram|strong="H6019"\w* vivió \w ciento|strong="H3967"\w* \w treinta|strong="H7970"\w* y \w siete|strong="H7651"\w* \w años|strong="H8141"\w*.  
\v 21 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Izhar fueron: \w Coré|strong="H7141"\w*, Néfeg y Zicrí.  
\v 22 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Uziel fueron: \w Misael|strong="H4332"\w*, Elzafán y Sitrí.  
\v 23 Aarón se \w casó|strong="H3947"\w* con Eliseba, \w hija|strong="H1323"\w* de \w Aminadab|strong="H5992"\w* y hermana de \w Naasón|strong="H5177"\w*, y ella dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w Nadab|strong="H5070"\w*, \w a|strong="H3068"\w* Abiú, \w a|strong="H3068"\w* Eleazar y \w a|strong="H3068"\w* Itamar.  
\v 24 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Coré|strong="H7141"\w* fueron: Asir, Elcaná y Abiasaf. Estas son las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* coreítas.  
\v 25 Eleazar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, se \w casó|strong="H3947"\w* con una \w de|strong="H1121"\w* las \w hijas|strong="H1323"\w* \w de|strong="H1121"\w* Putiel, y ella dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Finees. Estos son \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w familias|strong="H4940"\w* patriarcales \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*.  
\v 26 \w Estos|strong="H1931"\w* son \w los|strong="H1121"\w* mismos Aarón \w y|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w a|strong="H3068"\w* quienes Yahvé \w les|strong="H5921"\w* ordenó: “Saquen \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, ordenados \w por|strong="H5921"\w* escuadrones.”  
\v 27 \w Ellos|strong="H1992"\w* fueron \w los|strong="H1992"\w* \w que|strong="H1931"\w* \w hablaron|strong="H1696"\w* con \w el|strong="H1931"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, para sacar \w de|strong="H1121"\w* allí \w a|strong="H3068"\w* \w los|strong="H1992"\w* israelitas. Fueron \w Moisés|strong="H4872"\w* y Aarón.   
\p
\v 28 El \w día|strong="H3117"\w* \w que|strong="H3117"\w* Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* en \w Egipto|strong="H4714"\w*,  
\v 29 le \w dijo|strong="H1696"\w*: “Yo soy Yahvé. Dile \w al|strong="H4428"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* de \w Egipto|strong="H4714"\w*, \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* yo te \w diga|strong="H1696"\w*”.   
\p
\v 30 Pero \w Moisés|strong="H4872"\w* le respondió \w a|strong="H3068"\w* Yahvé: “\w Mira|strong="H2005"\w*, \w a|strong="H3068"\w* mí me cuesta mucho expresarme, ¿cómo me \w va|strong="H3068"\w* \w a|strong="H3068"\w* hacer caso el \w faraón|strong="H6547"\w*?”   
\c 7  
\p
\v 1 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Mira|strong="H7200"\w*, te voy \w a|strong="H3068"\w* hacer \w como|strong="H1961"\w* un \w Dios|strong="H3068"\w* ante \w el|strong="H5030"\w* \w faraón|strong="H6547"\w*, y tu hermano Aarón \w será|strong="H1961"\w* tu \w profeta|strong="H5030"\w*.  
\v 2 Tú le \w dirás|strong="H1696"\w* \w a|strong="H3068"\w* Aarón \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1121"\w* \w yo|strong="H6680"\w* te \w ordene|strong="H6680"\w*, y \w él|strong="H3605"\w* le \w hablará|strong="H1696"\w* al \w faraón|strong="H6547"\w* para \w que|strong="H1121"\w* \w deje|strong="H7971"\w* salir \w de|strong="H1121"\w* su país \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 3 Pero yo voy \w a|strong="H3068"\w* hacer que el \w faraón|strong="H6547"\w* se ponga terco, para multiplicar mis señales y \w maravillas|strong="H4159"\w* en \w Egipto|strong="H4714"\w*.  
\v 4 \w El|strong="H1121"\w* \w faraón|strong="H6547"\w* \w no|strong="H3808"\w* les \w va|strong="H3068"\w* \w a|strong="H3068"\w* hacer caso; entonces descargaré mi \w poder|strong="H3027"\w* sobre \w Egipto|strong="H4714"\w* y, mediante \w grandes|strong="H1419"\w* castigos, sacaré \w de|strong="H1121"\w* allí \w a|strong="H3068"\w* \w mis|strong="H5414"\w* escuadrones, \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 5 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* extienda \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w y|strong="H3588"\w* \w saque|strong="H3318"\w* \w de|strong="H5921"\w* allí \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, \w los|strong="H1121"\w* \w egipcios|strong="H4713"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.”   
\p
\v 6 \w Moisés|strong="H4872"\w* y Aarón \w hicieron|strong="H6213"\w* todo exactamente \w como|strong="H3651"\w* Yahvé \w se|strong="H3651"\w* \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w*.  
\v 7 \w Moisés|strong="H4872"\w* tenía \w ochenta|strong="H8084"\w* \w años|strong="H8141"\w* y Aarón \w ochenta|strong="H8084"\w* y \w tres|strong="H7969"\w* cuando \w hablaron|strong="H1696"\w* con \w el|strong="H1121"\w* \w faraón|strong="H6547"\w*.   
\p
\v 8 Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón:  
\v 9 “\w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w faraón|strong="H6547"\w* les pida \w que|strong="H3588"\w* hagan un \w milagro|strong="H4159"\w*, tú le \w dirás|strong="H1696"\w* \w a|strong="H3068"\w* Aarón: ‘\w Toma|strong="H3947"\w* tu \w vara|strong="H4294"\w* \w y|strong="H3588"\w* tírala al piso \w delante|strong="H6440"\w* del \w faraón|strong="H6547"\w*’, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w vara|strong="H4294"\w* \w se|strong="H1961"\w* convertirá \w en|strong="H3588"\w* una serpiente”.   
\p
\v 10 \w Moisés|strong="H4872"\w* y Aarón \w se|strong="H1961"\w* presentaron \w ante|strong="H6440"\w* \w el|strong="H6213"\w* \w faraón|strong="H6547"\w* \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H1961"\w* Yahvé \w les|strong="H6680"\w* \w había|strong="H1961"\w* \w ordenado|strong="H6680"\w*. Aarón tiró su \w vara|strong="H4294"\w* \w delante|strong="H6440"\w* del \w faraón|strong="H6547"\w* y \w de|strong="H6440"\w* sus funcionarios, y la \w vara|strong="H4294"\w* \w se|strong="H1961"\w* convirtió en una serpiente.  
\v 11 Pero \w el|strong="H6213"\w* \w faraón|strong="H6547"\w* mandó \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w sabios|strong="H2450"\w* \w y|strong="H1571"\w* hechiceros; \w y|strong="H1571"\w* \w los|strong="H1992"\w* \w magos|strong="H2748"\w* de \w Egipto|strong="H4714"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* \w mismo|strong="H1571"\w* \w con|strong="H1571"\w* \w sus|strong="H1992"\w* trucos de magia.  
\v 12 Cada uno de ellos tiró su \w vara|strong="H4294"\w*, y estas \w se|strong="H1961"\w* convirtieron en serpientes; pero la \w vara|strong="H4294"\w* de Aarón \w se|strong="H1961"\w* tragó \w a|strong="H3068"\w* las de ellos.  
\v 13 \w A|strong="H3068"\w* pesar de esto, el \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* puso terco y \w no|strong="H3808"\w* les hizo \w caso|strong="H3820"\w*, tal como Yahvé \w lo|strong="H3808"\w* había advertido.   
\p
\v 14 Entonces Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “El \w faraón|strong="H6547"\w* está terco \w de|strong="H5971"\w* \w corazón|strong="H3820"\w* y \w se|strong="H5971"\w* niega \w a|strong="H3068"\w* dejar \w ir|strong="H7971"\w* al \w pueblo|strong="H5971"\w*.  
\v 15 Búscalo \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w*, cuando \w él|strong="H5921"\w* baje \w al|strong="H5921"\w* \w río|strong="H2975"\w*. Espéralo \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w y|strong="H5921"\w* \w lleva|strong="H3212"\w* \w contigo|strong="H5921"\w* \w la|strong="H5921"\w* \w vara|strong="H4294"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* convirtió \w en|strong="H5921"\w* \w serpiente|strong="H5175"\w*.  
\v 16 \w Y|strong="H3068"\w* dile: ‘Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5704"\w* los \w hebreos|strong="H5680"\w*, \w me|strong="H3541"\w* \w ha|strong="H3541"\w* \w enviado|strong="H7971"\w* \w para|strong="H5704"\w* decirte: \w Deja|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w pueblo|strong="H5971"\w* \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w me|strong="H3541"\w* adore \w en|strong="H5704"\w* el \w desierto|strong="H4057"\w*. Pero \w como|strong="H5704"\w* \w hasta|strong="H5704"\w* \w ahora|strong="H3541"\w* \w no|strong="H3808"\w* has querido \w obedecer|strong="H8085"\w*,  
\v 17 Yahvé dice: \w Con|strong="H5921"\w* \w esto|strong="H2063"\w* \w sabrás|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé. \w Mira|strong="H2009"\w*, voy \w a|strong="H3068"\w* golpear \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w del|strong="H5921"\w* \w río|strong="H2975"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w vara|strong="H4294"\w* \w que|strong="H3588"\w* \w tengo|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w se|strong="H3045"\w* convertirá \w en|strong="H5921"\w* \w sangre|strong="H1818"\w*.  
\v 18 Los \w peces|strong="H1710"\w* \w del|strong="H4480"\w* \w río|strong="H2975"\w* \w morirán|strong="H4191"\w*, \w el|strong="H2975"\w* \w río|strong="H2975"\w* apestará, y \w a|strong="H3068"\w* los \w egipcios|strong="H4713"\w* les dará asco \w beber|strong="H8354"\w* \w de|strong="H4480"\w* su \w agua|strong="H4325"\w*’”.  
\v 19 Yahvé también \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Dile \w a|strong="H3068"\w* Aarón: ‘\w Toma|strong="H3947"\w* tu \w vara|strong="H4294"\w* \w y|strong="H5921"\w* \w extiende|strong="H5186"\w* tu \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w sobre|strong="H5921"\w* sus \w ríos|strong="H2975"\w*, canales, lagunas \w y|strong="H5921"\w* \w todos|strong="H3605"\w* sus depósitos \w de|strong="H5921"\w* \w agua|strong="H4325"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* conviertan \w en|strong="H5921"\w* \w sangre|strong="H1818"\w*. \w Habrá|strong="H1961"\w* \w sangre|strong="H1818"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, ¡incluso \w en|strong="H5921"\w* \w los|strong="H5921"\w* recipientes \w de|strong="H5921"\w* \w madera|strong="H6086"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* piedra!’”   
\p
\v 20 \w Moisés|strong="H4872"\w* y Aarón \w hicieron|strong="H6213"\w* exactamente \w lo|strong="H6213"\w* \w que|strong="H4325"\w* Yahvé \w les|strong="H6680"\w* \w mandó|strong="H6680"\w*. \w A|strong="H3068"\w* \w la|strong="H3605"\w* vista del \w faraón|strong="H6547"\w* y \w de|strong="H1818"\w* sus funcionarios, Aarón levantó \w la|strong="H3605"\w* \w vara|strong="H4294"\w*, golpeó \w el|strong="H3605"\w* \w agua|strong="H4325"\w* del \w río|strong="H2975"\w*, ¡y \w toda|strong="H3605"\w* \w el|strong="H3605"\w* \w agua|strong="H4325"\w* \w se|strong="H3651"\w* convirtió \w en|strong="H5221"\w* \w sangre|strong="H1818"\w*!  
\v 21 \w Los|strong="H3605"\w* \w peces|strong="H1710"\w* \w del|strong="H4480"\w* \w río|strong="H2975"\w* \w murieron|strong="H4191"\w* y \w el|strong="H3605"\w* \w río|strong="H2975"\w* apestaba tanto \w que|strong="H4480"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4713"\w* \w no|strong="H3808"\w* \w podían|strong="H3201"\w* \w beber|strong="H8354"\w* \w de|strong="H4480"\w* \w él|strong="H3605"\w*. \w Había|strong="H1961"\w* \w sangre|strong="H1818"\w* \w por|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w*.  
\v 22 Pero los \w magos|strong="H2748"\w* \w egipcios|strong="H4714"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H3808"\w* mismo con sus trucos de magia. \w Así|strong="H3651"\w* \w que|strong="H3808"\w* \w el|strong="H6213"\w* \w faraón|strong="H6547"\w* siguió terco y \w no|strong="H3808"\w* les \w hizo|strong="H6213"\w* \w caso|strong="H3820"\w* \w a|strong="H3068"\w* Moisés y Aarón, \w tal|strong="H3651"\w* \w como|strong="H3651"\w* Yahvé \w había|strong="H6213"\w* \w dicho|strong="H1696"\w*.  
\v 23 \w El|strong="H1571"\w* \w faraón|strong="H6547"\w* dio media vuelta, regresó \w a|strong="H3068"\w* su palacio \w y|strong="H1571"\w* \w no|strong="H3808"\w* le dio \w ninguna|strong="H3808"\w* importancia al asunto.  
\v 24 \w Mientras|strong="H3605"\w* tanto, \w como|strong="H3588"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4713"\w* \w no|strong="H3808"\w* \w podían|strong="H3201"\w* \w beber|strong="H8354"\w* \w agua|strong="H4325"\w* \w del|strong="H8354"\w* \w río|strong="H2975"\w*, tuvieron \w que|strong="H3588"\w* cavar pozos \w a|strong="H3068"\w* las orillas \w para|strong="H3588"\w* conseguir \w agua|strong="H4325"\w*.  
\v 25 Pasaron \w siete|strong="H7651"\w* \w días|strong="H3117"\w* completos desde \w que|strong="H3117"\w* Yahvé golpeó \w el|strong="H2975"\w* \w río|strong="H2975"\w*.   
\c 8  
\p
\v 1 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Ve|strong="H5927"\w* \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* faraón \w y|strong="H5921"\w* dile: ‘Así dice Yahvé: Deja ir \w a|strong="H3068"\w* \w mi|strong="H5921"\w* pueblo \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* adore.  
\v 2 \w Si|strong="H5921"\w* \w te|strong="H5921"\w* niegas \w a|strong="H3068"\w* dejarlos ir, voy \w a|strong="H3068"\w* plagar \w de|strong="H5921"\w* \w ranas|strong="H6854"\w* todo tu territorio.  
\v 3 \w El|strong="H5921"\w* río \w se|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* llenar \w de|strong="H5921"\w* \w ranas|strong="H6854"\w*; saldrán \w del|strong="H5921"\w* agua \w y|strong="H5921"\w* \w se|strong="H5921"\w* meterán \w a|strong="H3068"\w* \w tu|strong="H6213"\w* palacio, \w a|strong="H3068"\w* \w tu|strong="H6213"\w* recámara, \w a|strong="H3068"\w* \w tu|strong="H6213"\w* cama, \w a|strong="H3068"\w* \w las|strong="H5921"\w* casas \w de|strong="H5921"\w* tus funcionarios \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w de|strong="H5921"\w* \w tu|strong="H6213"\w* pueblo. ¡\w Se|strong="H5921"\w* meterán \w hasta|strong="H5921"\w* \w en|strong="H5921"\w* tus hornos \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w donde|strong="H5921"\w* amasas \w el|strong="H5921"\w* pan!  
\v 4 Las \w ranas|strong="H6854"\w* \w se|strong="H4480"\w* treparán \w sobre|strong="H4480"\w* \w ti|strong="H4480"\w*, \w sobre|strong="H4480"\w* tu \w pueblo|strong="H5971"\w* y \w sobre|strong="H4480"\w* todos tus funcionarios’”.  
\v 5 Yahvé \w le|strong="H5921"\w* añadió \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Dile \w a|strong="H3068"\w* Aarón: ‘Extiende \w la|strong="H5921"\w* mano \w con|strong="H5921"\w* tu vara \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w ríos|strong="H2975"\w*, canales \w y|strong="H5921"\w* lagunas, \w y|strong="H5921"\w* \w haz|strong="H3772"\w* \w que|strong="H4480"\w* salgan \w ranas|strong="H6854"\w* \w por|strong="H5921"\w* todo Egipto’”.  
\v 6 Aarón extendió \w su|strong="H3588"\w* mano sobre las aguas \w de|strong="H3588"\w* Egipto, \w y|strong="H3588"\w* las ranas salieron \w y|strong="H3588"\w* cubrieron todo \w el|strong="H3588"\w* país.  
\v 7 Pero los magos hicieron lo mismo \w con|strong="H4480"\w* sus trucos \w de|strong="H4480"\w* magia, y también hicieron \w que|strong="H4480"\w* salieran \w ranas|strong="H6854"\w* \w sobre|strong="H4480"\w* Egipto.   
\p
\v 8 Entonces \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* mandó llamar \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* Aarón, \w y|strong="H5921"\w* \w les|strong="H5973"\w* dijo: “Rueguen \w a|strong="H3068"\w* Yahvé \w que|strong="H5921"\w* \w nos|strong="H5921"\w* quite \w las|strong="H5921"\w* \w ranas|strong="H6854"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5973"\w*, \w y|strong="H5921"\w* dejaré ir \w al|strong="H5921"\w* \w pueblo|strong="H5973"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w le|strong="H5921"\w* ofrezca sacrificios \w a|strong="H3068"\w* Yahvé.”   
\p
\v 9 \w Moisés|strong="H4872"\w* le contestó \w al|strong="H4480"\w* faraón: “\w Te|strong="H4480"\w* doy \w el|strong="H6213"\w* honor \w de|strong="H4480"\w* elegir cuándo quieres \w que|strong="H4480"\w* ore \w por|strong="H4480"\w* \w ti|strong="H4480"\w*, \w por|strong="H4480"\w* tus funcionarios y \w por|strong="H4480"\w* \w tu|strong="H6213"\w* pueblo, \w para|strong="H4480"\w* \w que|strong="H4480"\w* las \w ranas|strong="H6854"\w* desaparezcan \w de|strong="H4480"\w* sus \w casas|strong="H1004"\w* y solo queden \w en|strong="H4480"\w* \w el|strong="H6213"\w* río.”   
\p
\v 10 “Mañana mismo”, respondió el faraón.  
\p Moisés le dijo: “Se hará como tú dices, para que sepas que no hay nadie como Yahvé, nuestro Dios.  
\v 11 Las ranas \w se|strong="H1961"\w* irán \w de|strong="H3588"\w* tu presencia, \w de|strong="H3588"\w* tus casas, \w de|strong="H3588"\w* tus funcionarios \w y|strong="H3588"\w* \w de|strong="H3588"\w* tu pueblo. \w Solamente|strong="H3588"\w* quedarán \w en|strong="H3588"\w* \w el|strong="H3588"\w* río”.   
\p
\v 12 \w Moisés|strong="H4872"\w* y Aarón salieron de \w la|strong="H3605"\w* presencia del faraón, y \w Moisés|strong="H4872"\w* le rogó \w a|strong="H3068"\w* Yahvé \w que|strong="H1961"\w* quitara las ranas \w que|strong="H1961"\w* \w había|strong="H1961"\w* mandado \w contra|strong="H1961"\w* \w el|strong="H3605"\w* faraón.  
\v 13 Yahvé \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H1961"\w* Moisés le pidió, y las ranas \w se|strong="H1961"\w* murieron \w en|strong="H5221"\w* las casas, \w en|strong="H5221"\w* \w los|strong="H3605"\w* patios y \w en|strong="H5221"\w* \w los|strong="H3605"\w* campos.  
\v 14 Las juntaron \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* grandes montones con ellas, y todo \w el|strong="H6213"\w* país apestaba.  
\v 15 Pero cuando \w el|strong="H1931"\w* \w faraón|strong="H6547"\w* vio \w que|strong="H1931"\w* \w la|strong="H1931"\w* situación había mejorado, volvió \w a|strong="H3068"\w* ponerse terco y \w no|strong="H3808"\w* les hizo \w caso|strong="H3820"\w*, tal \w como|strong="H1931"\w* Yahvé \w lo|strong="H1931"\w* había advertido.   
\p
\v 16 Yahvé \w le|strong="H1242"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Dile \w a|strong="H3068"\w* Aarón: ‘\w Extiende|strong="H7971"\w* tu vara \w y|strong="H3541"\w* golpea el polvo del piso, \w para|strong="H3320"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* convierta \w en|strong="H3318"\w* piojos \w por|strong="H6440"\w* todo Egipto’”.  
\v 17 \w Así|strong="H1571"\w* \w lo|strong="H5921"\w* hicieron. Aarón \w extendió|strong="H7971"\w* \w la|strong="H5921"\w* mano, golpeó \w el|strong="H5921"\w* polvo \w del|strong="H5921"\w* piso \w con|strong="H5921"\w* \w su|strong="H1992"\w* vara, ¡\w y|strong="H1571"\w* todo \w el|strong="H5921"\w* polvo \w de|strong="H5921"\w* Egipto \w se|strong="H5921"\w* convirtió \w en|strong="H5921"\w* piojos \w que|strong="H3588"\w* atacaron \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* animales!  
\v 18 \w Los|strong="H5921"\w* magos intentaron producir piojos \w con|strong="H5921"\w* \w sus|strong="H1931"\w* trucos \w de|strong="H5921"\w* magia, \w pero|strong="H3588"\w* \w esta|strong="H1931"\w* vez \w no|strong="H3588"\w* pudieron. \w Y|strong="H3068"\w* \w los|strong="H5921"\w* piojos \w seguían|strong="H1961"\w* atacando \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* animales.  
\v 19 Entonces \w los|strong="H1961"\w* magos le dijeron al faraón: “¡\w Este|strong="H2088"\w* \w es|strong="H1961"\w* el dedo \w de|strong="H5971"\w* Dios!” Pero el faraón siguió terco y \w no|strong="H1961"\w* \w los|strong="H1961"\w* escuchó, \w tal|strong="H2088"\w* \w como|strong="H1961"\w* Yahvé \w lo|strong="H2088"\w* \w había|strong="H1961"\w* dicho.   
\p
\v 20 Yahvé le dijo \w a|strong="H3068"\w* Moisés: “Levántate muy temprano y espéralo. \w Cuando|strong="H5650"\w* \w el|strong="H3605"\w* \w faraón|strong="H6547"\w* baje al agua, dile: ‘\w Así|strong="H3651"\w* dice Yahvé: Deja ir \w a|strong="H3068"\w* mi pueblo para \w que|strong="H3605"\w* me adore.  
\v 21 Porque si no los dejas \w ir|strong="H3212"\w*, voy \w a|strong="H3068"\w* mandar enjambres de moscas sobre ti, sobre tus funcionarios, sobre tu pueblo y sobre tus casas. Las casas de los egipcios se van \w a|strong="H3068"\w* llenar de moscas, y hasta el suelo donde pisan estará cubierto de ellas.  
\v 22 \w Pero|strong="H3588"\w* ese día \w haré|strong="H6213"\w* una excepción \w con|strong="H3588"\w* \w la|strong="H3588"\w* región \w de|strong="H3588"\w* Gosén, donde vive mi pueblo; allí \w no|strong="H3808"\w* habrá \w ninguna|strong="H3808"\w* mosca, \w para|strong="H3588"\w* \w que|strong="H3588"\w* sepas \w que|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, estoy presente \w en|strong="H3588"\w* \w esta|strong="H3651"\w* tierra.  
\v 23 Haré una clara diferencia entre mi pueblo y el tuyo. Esta señal ocurrirá mañana’”.  
\v 24 \w Y|strong="H3068"\w* así \w lo|strong="H3808"\w* hizo Yahvé. Llegaron densos enjambres de moscas \w al|strong="H1157"\w* palacio del \w faraón|strong="H6547"\w* y \w a|strong="H3068"\w* las casas de sus funcionarios. ¡Todo el país de Egipto quedó arruinado \w por|strong="H1157"\w* culpa de las moscas!   
\p
\v 25 \w Entonces|strong="H5493"\w* \w el|strong="H5973"\w* \w faraón|strong="H6547"\w* \w mandó|strong="H7971"\w* llamar \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y \w les|strong="H5973"\w* dijo: “Vayan \w a|strong="H3068"\w* ofrecerle \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* su \w Dios|strong="H3068"\w*, ¡pero \w aquí|strong="H2009"\w* mismo \w en|strong="H5973"\w* \w el|strong="H5973"\w* país!”   
\p
\v 26 \w Moisés|strong="H4872"\w* \w le|strong="H5973"\w* respondió: “Eso no está bien, porque \w los|strong="H5973"\w* sacrificios que \w le|strong="H5973"\w* ofrecemos \w a|strong="H3068"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*, resultan ofensivos \w para|strong="H5973"\w* \w los|strong="H5973"\w* egipcios. Si hacemos esos sacrificios \w delante|strong="H5973"\w* \w de|strong="H5973"\w* ellos, ¿acaso no nos agarrarán \w a|strong="H3068"\w* pedradas?  
\v 27 Tenemos \w que|strong="H3808"\w* ir \w a|strong="H3068"\w* tres días \w de|strong="H5971"\w* camino \w por|strong="H1697"\w* \w el|strong="H6213"\w* desierto \w para|strong="H5493"\w* ofrecerle sacrificios \w a|strong="H3068"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*, \w tal|strong="H1697"\w* como \w él|strong="H6213"\w* nos \w lo|strong="H1697"\w* ordene.”   
\p
\v 28 \w El|strong="H1571"\w* \w faraón|strong="H6547"\w* cedió: “Los \w dejaré|strong="H7971"\w* \w ir|strong="H7971"\w* \w para|strong="H5971"\w* \w que|strong="H3808"\w* le ofrezcan sacrificios \w a|strong="H3068"\w* Yahvé, su Dios, en \w el|strong="H1571"\w* desierto, siempre \w y|strong="H1571"\w* \w cuando|strong="H1571"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* vayan muy lejos. \w Y|strong="H3068"\w* rueguen por mí”.   
\p
\v 29 Moisés le dijo: “En cuanto salga de aquí, voy \w a|strong="H3068"\w* orar \w a|strong="H3068"\w* Yahvé para que mañana mismo las moscas se alejen del faraón, de sus funcionarios y de su pueblo. Pero no vuelvas \w a|strong="H3068"\w* engañarnos negándote \w a|strong="H3068"\w* dejar ir al pueblo \w a|strong="H3068"\w* ofrecerle sacrificios \w a|strong="H3068"\w* Yahvé.”  
\v 30 Moisés salió de la presencia del faraón y oró \w a|strong="H3068"\w* Yahvé.  
\v 31 Yahvé hizo lo que Moisés le pidió, y apartó los enjambres de moscas del faraón, de sus funcionarios y de su pueblo. ¡No quedó ni una sola mosca!  
\v 32 Pero una vez más, el faraón se puso terco y tampoco esta vez dejó ir al pueblo.   
\c 9  
\p
\v 1 Entonces Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Ve \w a|strong="H3068"\w* ver al \w faraón|strong="H6547"\w* \w y|strong="H3541"\w* dile: ‘\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* lo \w que|strong="H5971"\w* \w dice|strong="H1696"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* los \w hebreos|strong="H5680"\w*: \w Deja|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w para|strong="H5971"\w* \w que|strong="H5971"\w* \w me|strong="H3541"\w* adore.  
\v 2 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* \w te|strong="H3588"\w* niegas \w a|strong="H3068"\w* dejarlos \w ir|strong="H7971"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* sigues reteniendo,  
\v 3 ten \w por|strong="H3027"\w* seguro \w que|strong="H1961"\w* la \w mano|strong="H3027"\w* de Yahvé caerá \w sobre|strong="H3515"\w* tu \w ganado|strong="H4735"\w* \w que|strong="H1961"\w* \w está|strong="H1961"\w* en el \w campo|strong="H7704"\w*, \w sobre|strong="H3515"\w* \w los|strong="H1961"\w* \w caballos|strong="H5483"\w*, \w sobre|strong="H3515"\w* \w los|strong="H1961"\w* burros, \w sobre|strong="H3515"\w* \w los|strong="H1961"\w* \w camellos|strong="H1581"\w*, \w sobre|strong="H3515"\w* las \w vacas|strong="H1241"\w* \w y|strong="H1241"\w* \w sobre|strong="H3515"\w* las \w ovejas|strong="H6629"\w*, con una plaga \w muy|strong="H3966"\w* \w grave|strong="H3515"\w*.  
\v 4 Pero Yahvé hará una distinción \w entre|strong="H3808"\w* \w el|strong="H3605"\w* \w ganado|strong="H4735"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w el|strong="H3605"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H1121"\w* modo \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w morirá|strong="H4191"\w* \w ningún|strong="H3605"\w* animal \w que|strong="H3808"\w* pertenezca \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*’”.  
\v 5 Yahvé fijó la fecha, diciendo: “\w Mañana|strong="H4279"\w* mismo Yahvé \w hará|strong="H6213"\w* \w esto|strong="H2088"\w* en \w el|strong="H6213"\w* país”.  
\v 6 \w Y|strong="H3068"\w* Yahvé \w lo|strong="H1697"\w* cumplió al \w día|strong="H1121"\w* \w siguiente|strong="H4283"\w*; \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w ganado|strong="H4735"\w* \w de|strong="H1121"\w* Egipto \w murió|strong="H4191"\w*, pero del \w ganado|strong="H4735"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w murió|strong="H4191"\w* \w ni|strong="H3808"\w* un solo animal.  
\v 7 El \w faraón|strong="H6547"\w* \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* investigar, \w y|strong="H5704"\w* resultó \w que|strong="H3808"\w* \w no|strong="H3808"\w* había \w muerto|strong="H4191"\w* \w ni|strong="H3808"\w* un solo animal \w de|strong="H5704"\w* los israelitas. \w A|strong="H3068"\w* pesar \w de|strong="H5704"\w* esto, el \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* \w puso|strong="H7971"\w* terco \w y|strong="H5704"\w* \w no|strong="H3808"\w* \w dejó|strong="H7971"\w* \w ir|strong="H7971"\w* \w al|strong="H5704"\w* \w pueblo|strong="H5971"\w*.   
\p
\v 8 Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón: “\w Tomen|strong="H3947"\w* \w puñados|strong="H2651"\w* \w de|strong="H5869"\w* ceniza \w de|strong="H5869"\w* un horno y que \w Moisés|strong="H4872"\w* la arroje al aire \w delante|strong="H5869"\w* del \w faraón|strong="H6547"\w*.  
\v 9 Esa ceniza \w se|strong="H1961"\w* convertirá \w en|strong="H5921"\w* un polvo fino \w que|strong="H5921"\w* cubrirá \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5921"\w* producirá llagas \w y|strong="H5921"\w* úlceras \w en|strong="H5921"\w* \w la|strong="H5921"\w* piel \w de|strong="H5921"\w* \w la|strong="H5921"\w* gente \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* animales \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país.”   
\p
\v 10 Ellos \w tomaron|strong="H3947"\w* ceniza del horno y \w se|strong="H1961"\w* pararon frente al \w faraón|strong="H6547"\w*; \w Moisés|strong="H4872"\w* la arrojó al aire, y salieron llagas y úlceras \w en|strong="H5975"\w* la piel tanto \w de|strong="H6440"\w* las personas \w como|strong="H1961"\w* \w de|strong="H6440"\w* \w los|strong="H1961"\w* animales.  
\v 11 \w Los|strong="H3605"\w* \w magos|strong="H2748"\w* \w ni|strong="H3808"\w* siquiera \w pudieron|strong="H3201"\w* presentarse \w delante|strong="H6440"\w* \w de|strong="H3588"\w* \w Moisés|strong="H4872"\w* debido \w a|strong="H3068"\w* las úlceras, \w porque|strong="H3588"\w* las úlceras afectaron \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w magos|strong="H2748"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4713"\w*.  
\v 12 Pero Yahvé hizo \w que|strong="H3808"\w* el \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* pusiera terco y \w no|strong="H3808"\w* les hizo \w caso|strong="H3820"\w*, tal como Yahvé \w se|strong="H3808"\w* \w lo|strong="H3808"\w* había advertido \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.   
\p
\v 13 Yahvé \w le|strong="H1242"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Levántate|strong="H7925"\w* muy temprano, preséntate \w ante|strong="H6440"\w* el \w faraón|strong="H6547"\w* \w y|strong="H3541"\w* dile: ‘\w Así|strong="H3541"\w* dice Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* los \w hebreos|strong="H5680"\w*: \w Deja|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w para|strong="H3320"\w* \w que|strong="H5971"\w* \w me|strong="H3541"\w* adore.  
\v 14 \w Porque|strong="H3588"\w* \w esta|strong="H2063"\w* \w vez|strong="H6471"\w* voy \w a|strong="H3068"\w* enviar \w todas|strong="H3605"\w* mis \w plagas|strong="H4046"\w* contra ti \w mismo|strong="H3605"\w*, contra tus funcionarios \w y|strong="H3588"\w* contra tu \w pueblo|strong="H5971"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w sepas|strong="H3045"\w* \w que|strong="H3588"\w* \w en|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra \w no|strong="H3588"\w* hay \w nadie|strong="H3605"\w* \w como|strong="H3588"\w* \w yo|strong="H3588"\w*.  
\v 15 \w Si|strong="H3588"\w* \w yo|strong="H4480"\w* hubiera extendido mi \w mano|strong="H3027"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* hubiera castigado \w con|strong="H4480"\w* enfermedades \w a|strong="H3068"\w* \w ti|strong="H4480"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*, \w ya|strong="H6258"\w* habrías desaparecido \w del|strong="H4480"\w* mapa;  
\v 16 pero \w en|strong="H5975"\w* realidad, te he dejado con vida \w para|strong="H4616"\w* mostrarte mi \w poder|strong="H3581"\w* y \w para|strong="H4616"\w* \w que|strong="H3581"\w* mi \w nombre|strong="H8034"\w* sea famoso \w en|strong="H5975"\w* \w toda|strong="H3605"\w* \w la|strong="H2063"\w* tierra,  
\v 17 ya \w que|strong="H5971"\w* \w todavía|strong="H5750"\w* te crees superior \w a|strong="H3068"\w* \w mi|strong="H1115"\w* \w pueblo|strong="H5971"\w* y \w no|strong="H1115"\w* lo dejas \w ir|strong="H7971"\w*.  
\v 18 \w Por|strong="H4480"\w* eso, \w mañana|strong="H4279"\w* \w a|strong="H3068"\w* \w esta|strong="H1961"\w* \w hora|strong="H6258"\w* voy \w a|strong="H3068"\w* mandar la peor tormenta \w de|strong="H4480"\w* \w granizo|strong="H1259"\w* \w que|strong="H4480"\w* \w haya|strong="H1961"\w* caído \w en|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w desde|strong="H4480"\w* \w que|strong="H4480"\w* el país \w fue|strong="H1961"\w* fundado.  
\v 19 \w Así|strong="H6258"\w* \w que|strong="H3808"\w* manda \w a|strong="H3068"\w* refugiar tu \w ganado|strong="H4735"\w* \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* tengas \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w*. \w El|strong="H5921"\w* \w granizo|strong="H1259"\w* \w caerá|strong="H3381"\w* \w sobre|strong="H5921"\w* \w cualquier|strong="H3605"\w* persona \w o|strong="H3068"\w* animal \w que|strong="H3808"\w* \w se|strong="H5921"\w* quede afuera \w y|strong="H5921"\w* \w no|strong="H3808"\w* sea llevado \w a|strong="H3068"\w* un lugar seguro, \w y|strong="H5921"\w* \w morirán|strong="H4191"\w*’”.   
\p
\v 20 Los funcionarios del \w faraón|strong="H6547"\w* \w que|strong="H1697"\w* le tuvieron \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* la advertencia \w de|strong="H1697"\w* Yahvé metieron \w de|strong="H1697"\w* prisa \w a|strong="H3068"\w* sus esclavos y \w a|strong="H3068"\w* sus animales en las \w casas|strong="H1004"\w*.  
\v 21 Pero los \w que|strong="H3808"\w* \w no|strong="H3808"\w* le dieron importancia \w a|strong="H3068"\w* la advertencia \w de|strong="H1697"\w* Yahvé, \w dejaron|strong="H5800"\w* \w a|strong="H3068"\w* sus esclavos y \w a|strong="H3068"\w* sus animales en el \w campo|strong="H7704"\w*.   
\p
\v 22 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Levanta \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* caiga \w granizo|strong="H1259"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* gente, \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* animales \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* plantas \w del|strong="H5921"\w* \w campo|strong="H7704"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país.”   
\p
\v 23 \w Moisés|strong="H4872"\w* levantó su \w vara|strong="H4294"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w y|strong="H5921"\w* Yahvé mandó \w truenos|strong="H6963"\w* \w y|strong="H5921"\w* \w granizo|strong="H1259"\w*, \w y|strong="H5921"\w* cayeron rayos \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra. Yahvé \w hizo|strong="H5414"\w* \w que|strong="H5921"\w* lloviera \w granizo|strong="H1259"\w* \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\v 24 \w Fue|strong="H1961"\w* una tormenta de \w granizo|strong="H1259"\w* terrible, con rayos \w que|strong="H3808"\w* caían \w sin|strong="H3808"\w* parar, algo \w que|strong="H3808"\w* \w jamás|strong="H3808"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* visto \w en|strong="H8432"\w* \w Egipto|strong="H4714"\w* desde \w que|strong="H3808"\w* \w se|strong="H1961"\w* formó \w como|strong="H3644"\w* \w nación|strong="H1471"\w*.  
\v 25 \w En|strong="H5704"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, \w el|strong="H3605"\w* \w granizo|strong="H1259"\w* destruyó \w todo|strong="H3605"\w* \w lo|strong="H5704"\w* \w que|strong="H5704"\w* estaba \w a|strong="H3068"\w* \w la|strong="H3605"\w* intemperie, tanto personas \w como|strong="H5704"\w* animales. \w El|strong="H3605"\w* \w granizo|strong="H1259"\w* también hizo pedazos \w todas|strong="H3605"\w* las plantas \w y|strong="H5704"\w* destrozó \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* del \w campo|strong="H7704"\w*.  
\v 26 \w El|strong="H1121"\w* único lugar \w donde|strong="H8033"\w* \w no|strong="H3808"\w* cayó \w granizo|strong="H1259"\w* \w fue|strong="H1961"\w* en la región \w de|strong="H1121"\w* Gosén, \w donde|strong="H8033"\w* vivían \w los|strong="H1121"\w* israelitas.   
\p
\v 27 Entonces el \w faraón|strong="H6547"\w* \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les dijo: “Esta \w vez|strong="H6471"\w* reconozco \w que|strong="H5971"\w* he \w pecado|strong="H2398"\w*. Yahvé tiene la razón, y mi \w pueblo|strong="H5971"\w* y yo somos los culpables.  
\v 28 Ruéguenle \w a|strong="H3068"\w* Yahvé por nosotros, \w porque|strong="H3808"\w* \w ya|strong="H3254"\w* \w no|strong="H3808"\w* aguantamos \w más|strong="H3254"\w* estos \w truenos|strong="H6963"\w* y \w este|strong="H1961"\w* \w granizo|strong="H1259"\w*. \w Los|strong="H1961"\w* \w dejaré|strong="H7971"\w* \w ir|strong="H7971"\w*, \w ya|strong="H3254"\w* \w no|strong="H3808"\w* \w tendrán|strong="H1961"\w* \w que|strong="H3808"\w* quedarse \w más|strong="H3254"\w* tiempo”.   
\p
\v 29 \w Moisés|strong="H4872"\w* le respondió: “\w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w yo|strong="H3588"\w* \w salga|strong="H3318"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*, levantaré mis \w manos|strong="H3709"\w* \w para|strong="H4616"\w* orarle \w a|strong="H3068"\w* Yahvé. \w Los|strong="H1961"\w* \w truenos|strong="H6963"\w* \w se|strong="H3045"\w* detendrán \w y|strong="H3588"\w* ya \w no|strong="H3808"\w* caerá \w más|strong="H5750"\w* \w granizo|strong="H1259"\w*, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w sepas|strong="H3045"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* tierra le pertenece \w a|strong="H3068"\w* Yahvé.  
\v 30 \w Pero|strong="H3588"\w* \w sé|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* tú \w y|strong="H3588"\w* tus funcionarios \w todavía|strong="H2962"\w* \w no|strong="H3588"\w* le tienen respeto \w a|strong="H3068"\w* Yahvé \w Dios|strong="H3068"\w*”.   
\p
\v 31 \w Los|strong="H3588"\w* cultivos \w de|strong="H3588"\w* lino \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w cebada|strong="H8184"\w* quedaron arruinados, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w cebada|strong="H8184"\w* ya \w había|strong="H3588"\w* espigado \w y|strong="H3588"\w* \w el|strong="H3588"\w* lino estaba floreciendo.  
\v 32 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* \w trigo|strong="H2406"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* centeno \w no|strong="H3808"\w* sufrieron daños \w porque|strong="H3588"\w* maduran \w más|strong="H3588"\w* tarde.  
\v 33 \w Moisés|strong="H4872"\w* \w salió|strong="H3318"\w* \w de|strong="H5973"\w* \w la|strong="H5413"\w* \w ciudad|strong="H5892"\w*, \w se|strong="H3808"\w* alejó \w del|strong="H5973"\w* \w faraón|strong="H6547"\w* y levantó sus \w manos|strong="H3709"\w* hacia Yahvé. Al instante \w se|strong="H3808"\w* calmaron \w los|strong="H5973"\w* \w truenos|strong="H6963"\w* y \w el|strong="H5973"\w* \w granizo|strong="H1259"\w*, y \w dejó|strong="H2308"\w* \w de|strong="H5973"\w* llover.  
\v 34 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w el|strong="H1931"\w* \w faraón|strong="H6547"\w* \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w la|strong="H1931"\w* \w lluvia|strong="H4306"\w*, \w el|strong="H1931"\w* \w granizo|strong="H1259"\w* \w y|strong="H3588"\w* \w los|strong="H1931"\w* \w truenos|strong="H6963"\w* \w se|strong="H1931"\w* habían detenido, \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w pecar|strong="H2398"\w*; \w él|strong="H1931"\w* \w y|strong="H3588"\w* \w sus|strong="H1931"\w* funcionarios \w se|strong="H1931"\w* pusieron tercos otra vez.  
\v 35 \w Y|strong="H3068"\w* con \w el|strong="H1121"\w* \w corazón|strong="H3820"\w* endurecido, \w el|strong="H1121"\w* \w faraón|strong="H6547"\w* \w no|strong="H3808"\w* \w dejó|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, tal como Yahvé \w lo|strong="H3808"\w* había advertido \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*.   
\c 10  
\p
\v 1 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Ve \w a|strong="H3068"\w* ver \w al|strong="H7130"\w* \w faraón|strong="H6547"\w*. \w Yo|strong="H3588"\w* he hecho \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w y|strong="H3588"\w* sus funcionarios se pongan tercos, \w para|strong="H4616"\w* poder mostrar mis señales milagrosas \w entre|strong="H7130"\w* ellos,  
\v 2 \w y|strong="H3588"\w* \w para|strong="H4616"\w* \w que|strong="H3588"\w* les cuentes \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* tus \w nietos|strong="H1121"\w* lo \w que|strong="H3588"\w* le hice \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w y|strong="H3588"\w* las señales \w que|strong="H3588"\w* realicé \w entre|strong="H3588"\w* ellos. \w Así|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.”   
\p
\v 3 \w Moisés|strong="H4872"\w* \w y|strong="H5704"\w* Aarón \w se|strong="H5971"\w* presentaron \w ante|strong="H6440"\w* el \w faraón|strong="H6547"\w* \w y|strong="H5704"\w* le dijeron: “\w Así|strong="H3541"\w* dice Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* los \w hebreos|strong="H5680"\w*: ‘¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* te vas \w a|strong="H3068"\w* negar \w a|strong="H3068"\w* someterte \w a|strong="H3068"\w* mí? \w Deja|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w para|strong="H5704"\w* \w que|strong="H5704"\w* \w me|strong="H3541"\w* adore.  
\v 4 \w Porque|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3588"\w* \w los|strong="H3588"\w* dejas \w ir|strong="H7971"\w*, \w mañana|strong="H4279"\w* voy \w a|strong="H3068"\w* mandar langostas sobre tu país.  
\v 5 Van \w a|strong="H3068"\w* \w cubrir|strong="H3680"\w* \w la|strong="H3605"\w* superficie \w de|strong="H4480"\w* \w la|strong="H3605"\w* tierra \w de|strong="H4480"\w* tal modo \w que|strong="H4480"\w* \w ni|strong="H3808"\w* siquiera \w se|strong="H4480"\w* \w podrá|strong="H3201"\w* \w ver|strong="H7200"\w* \w el|strong="H3605"\w* piso. \w Se|strong="H4480"\w* van \w a|strong="H3068"\w* comer \w lo|strong="H3808"\w* poquito \w que|strong="H4480"\w* \w se|strong="H4480"\w* salvó \w del|strong="H4480"\w* \w granizo|strong="H1259"\w* y acabarán \w con|strong="H4480"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* \w que|strong="H4480"\w* crecen \w en|strong="H4480"\w* \w el|strong="H3605"\w* \w campo|strong="H7704"\w*.  
\v 6 Llenarán tus palacios, \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* tus funcionarios \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4713"\w*. \w Será|strong="H1961"\w* algo \w que|strong="H3808"\w* \w jamás|strong="H3808"\w* \w vieron|strong="H7200"\w* tus padres \w ni|strong="H3808"\w* tus abuelos \w desde|strong="H5704"\w* \w que|strong="H3808"\w* vivieron \w en|strong="H5921"\w* \w esta|strong="H2088"\w* tierra \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*’”. \w Luego|strong="H3318"\w* Moisés dio media vuelta \w y|strong="H5921"\w* \w salió|strong="H3318"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* presencia \w del|strong="H5921"\w* \w faraón|strong="H6547"\w*.   
\p
\v 7 \w Los|strong="H1961"\w* funcionarios le dijeron \w al|strong="H5704"\w* \w faraón|strong="H6547"\w*: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H3588"\w* nos \w va|strong="H3068"\w* \w a|strong="H3068"\w* traer problemas \w este|strong="H2088"\w* hombre? \w Deja|strong="H7971"\w* \w que|strong="H3588"\w* esa gente \w se|strong="H3045"\w* vaya \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*. ¿Acaso \w no|strong="H3588"\w* \w te|strong="H3588"\w* das cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w está|strong="H2088"\w* \w en|strong="H5704"\w* \w la|strong="H3588"\w* ruina?”   
\p
\v 8 \w Entonces|strong="H7725"\w* mandaron llamar de nuevo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y \w el|strong="H4310"\w* \w faraón|strong="H6547"\w* les dijo: “\w Vayan|strong="H3212"\w* y adoren \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*. Pero díganme, ¿\w quiénes|strong="H4310"\w* son los \w que|strong="H4310"\w* se \w van|strong="H1980"\w*?”   
\p
\v 9 \w Moisés|strong="H4872"\w* le contestó: “Nos \w vamos|strong="H3212"\w* todos: nuestros jóvenes \w y|strong="H3588"\w* nuestros \w ancianos|strong="H2205"\w*, nuestros \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* nuestras \w hijas|strong="H1323"\w*, \w y|strong="H3588"\w* también nos llevaremos nuestras \w ovejas|strong="H6629"\w* \w y|strong="H3588"\w* nuestras \w vacas|strong="H1241"\w*, \w porque|strong="H3588"\w* tenemos \w que|strong="H3588"\w* celebrarle una \w fiesta|strong="H2282"\w* \w a|strong="H3068"\w* Yahvé”.   
\p
\v 10 \w El|strong="H5973"\w* faraón \w les|strong="H5973"\w* respondió: “¡\w Que|strong="H3588"\w* Yahvé \w los|strong="H5973"\w* ayude \w si|strong="H3588"\w* creen \w que|strong="H3588"\w* voy \w a|strong="H3068"\w* dejar \w que|strong="H3588"\w* \w se|strong="H1961"\w* lleven \w a|strong="H3068"\w* sus familias! \w Se|strong="H1961"\w* \w ve|strong="H7200"\w* \w que|strong="H3588"\w* \w tienen|strong="H1961"\w* \w malas|strong="H7451"\w* intenciones.  
\v 11 ¡\w De|strong="H3588"\w* \w ninguna|strong="H3808"\w* manera! \w Vayan|strong="H3212"\w* solo \w los|strong="H3588"\w* \w hombres|strong="H1397"\w* \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* Yahvé, \w ya|strong="H4994"\w* \w que|strong="H3588"\w* \w eso|strong="H3651"\w* era \w lo|strong="H3808"\w* \w que|strong="H3588"\w* querían”. \w Y|strong="H3068"\w* \w los|strong="H3588"\w* echaron \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w presencia|strong="H6440"\w* del \w faraón|strong="H6547"\w*.   
\p
\v 12 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Levanta tu \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w vengan|strong="H5927"\w* \w las|strong="H5921"\w* langostas. \w Ellas|strong="H5921"\w* devorarán \w todas|strong="H3605"\w* \w las|strong="H5921"\w* plantas \w del|strong="H5921"\w* país, \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w dejó|strong="H7604"\w* \w el|strong="H5921"\w* \w granizo|strong="H1259"\w*.”  
\v 13 \w Moisés|strong="H4872"\w* \w levantó|strong="H5375"\w* \w su|strong="H1931"\w* \w vara|strong="H4294"\w* \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5921"\w* Yahvé mandó un \w viento|strong="H7307"\w* \w del|strong="H5921"\w* \w este|strong="H1931"\w* \w que|strong="H1931"\w* \w sopló|strong="H7307"\w* \w sobre|strong="H5921"\w* \w el|strong="H1931"\w* país \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w noche|strong="H3915"\w*. \w A|strong="H3068"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w* siguiente, \w el|strong="H1931"\w* \w viento|strong="H7307"\w* \w del|strong="H5921"\w* \w este|strong="H1931"\w* \w había|strong="H1961"\w* traído \w las|strong="H5921"\w* langostas.  
\v 14 \w Las|strong="H5921"\w* langostas invadieron \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* asentaron \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* territorio. \w Fue|strong="H1961"\w* una plaga espantosa. \w Nunca|strong="H3808"\w* \w antes|strong="H6440"\w* \w se|strong="H1961"\w* \w habían|strong="H1961"\w* visto tantas langostas, \w ni|strong="H3808"\w* \w se|strong="H1961"\w* volverán \w a|strong="H3068"\w* ver.  
\v 15 \w Cubrieron|strong="H3680"\w* por completo \w la|strong="H3605"\w* superficie \w de|strong="H5869"\w* \w la|strong="H3605"\w* tierra y \w la|strong="H3605"\w* oscurecieron. \w Se|strong="H3808"\w* comieron \w todas|strong="H3605"\w* las plantas y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w frutos|strong="H6529"\w* \w de|strong="H5869"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* habían salvado del \w granizo|strong="H1259"\w*. \w No|strong="H3808"\w* \w quedó|strong="H3498"\w* \w ni|strong="H3808"\w* una sola hoja \w verde|strong="H3418"\w* en \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* \w ni|strong="H3808"\w* en las plantas \w de|strong="H5869"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*.   
\p
\v 16 El \w faraón|strong="H6547"\w* mandó \w llamar|strong="H7121"\w* de urgencia \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y les dijo: “He \w pecado|strong="H2398"\w* contra Yahvé su \w Dios|strong="H3068"\w*, y contra ustedes.  
\v 17 \w Les|strong="H5921"\w* \w ruego|strong="H4994"\w* \w que|strong="H6258"\w* \w me|strong="H5921"\w* perdonen \w esta|strong="H2088"\w* \w vez|strong="H6471"\w*. Pídanle \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w* \w que|strong="H6258"\w*, \w por|strong="H5921"\w* favor, \w me|strong="H5921"\w* \w quite|strong="H5493"\w* \w esta|strong="H2088"\w* plaga mortal.”   
\p
\v 18 Moisés \w salió|strong="H3318"\w* \w del|strong="H5973"\w* palacio \w del|strong="H5973"\w* \w faraón|strong="H6547"\w* y oró \w a|strong="H3068"\w* Yahvé.  
\v 19 Entonces Yahvé cambió \w la|strong="H3605"\w* dirección del \w viento|strong="H7307"\w* y mandó un \w viento|strong="H7307"\w* \w muy|strong="H3966"\w* \w fuerte|strong="H2389"\w* del oeste \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w llevó|strong="H5375"\w* \w a|strong="H3068"\w* las langostas y las arrojó al \w Mar|strong="H3220"\w* Rojo. \w No|strong="H3808"\w* \w quedó|strong="H7604"\w* \w ni|strong="H3808"\w* una sola langosta en \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de \w Egipto|strong="H4714"\w*.  
\v 20 Pero Yahvé hizo \w que|strong="H3808"\w* \w el|strong="H1121"\w* \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* pusiera terco, y \w no|strong="H3808"\w* \w dejó|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas.   
\p
\v 21 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Levanta \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* todo \w Egipto|strong="H4714"\w* \w se|strong="H1961"\w* cubra \w de|strong="H5921"\w* \w oscuridad|strong="H2822"\w*, una \w oscuridad|strong="H2822"\w* tan densa \w que|strong="H5921"\w* \w hasta|strong="H5921"\w* \w se|strong="H1961"\w* pueda sentir.”  
\v 22 \w Moisés|strong="H4872"\w* levantó \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w y|strong="H5921"\w* una densa \w oscuridad|strong="H2822"\w* cubrió \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w* durante \w tres|strong="H7969"\w* \w días|strong="H3117"\w*.  
\v 23 Las personas \w no|strong="H3808"\w* podían \w verse|strong="H7200"\w* unas \w a|strong="H3068"\w* otras, y \w nadie|strong="H3808"\w* salió \w de|strong="H8478"\w* su casa \w en|strong="H8478"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*. \w En|strong="H8478"\w* cambio, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w tenían|strong="H1961"\w* luz \w en|strong="H8478"\w* \w los|strong="H1121"\w* lugares \w donde|strong="H8478"\w* vivían.   
\p
\v 24 \w El|strong="H5973"\w* \w faraón|strong="H6547"\w* mandó \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H1571"\w* \w le|strong="H5973"\w* dijo: “\w Vayan|strong="H3212"\w* \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* Yahvé. \w Solo|strong="H7535"\w* dejen aquí sus \w ovejas|strong="H6629"\w* \w y|strong="H1571"\w* sus \w vacas|strong="H1241"\w*. Sus \w niños|strong="H2945"\w* \w también|strong="H1571"\w* pueden \w ir|strong="H3212"\w* \w con|strong="H5973"\w* ustedes.”   
\p
\v 25 Pero \w Moisés|strong="H4872"\w* le contestó: “\w Tú|strong="H6213"\w* \w también|strong="H1571"\w* tienes \w que|strong="H1571"\w* darnos animales \w para|strong="H5414"\w* ofrecerle \w sacrificios|strong="H2077"\w* \w y|strong="H1571"\w* \w holocaustos|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w*.  
\v 26 \w Así|strong="H1571"\w* \w que|strong="H3588"\w* nuestro \w ganado|strong="H4735"\w* \w se|strong="H3045"\w* \w irá|strong="H3212"\w* \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*. \w No|strong="H3808"\w* \w dejaremos|strong="H7604"\w* \w ni|strong="H3808"\w* una sola pezuña \w aquí|strong="H8033"\w*, \w porque|strong="H3588"\w* tenemos \w que|strong="H3588"\w* \w tomar|strong="H3947"\w* \w de|strong="H4480"\w* esos animales \w para|strong="H5704"\w* adorar \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, \w y|strong="H1571"\w* \w no|strong="H3808"\w* sabremos cuáles \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* sacrificar \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* lleguemos \w allá|strong="H8033"\w*.”   
\p
\v 27 Pero Yahvé hizo \w que|strong="H3808"\w* el \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* pusiera terco, y \w no|strong="H3808"\w* quiso dejarlos \w ir|strong="H7971"\w*.  
\v 28 \w El|strong="H5921"\w* \w faraón|strong="H6547"\w* \w le|strong="H5921"\w* gritó: “¡Lárgate \w de|strong="H5921"\w* aquí! \w Y|strong="H3068"\w* ten cuidado \w de|strong="H5921"\w* \w no|strong="H3588"\w* volver \w a|strong="H3068"\w* presentarte \w ante|strong="H6440"\w* \w mí|strong="H5921"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* vuelvas \w a|strong="H3068"\w* verme \w la|strong="H5921"\w* \w cara|strong="H6440"\w*, \w te|strong="H5921"\w* mueres”.   
\p
\v 29 \w Moisés|strong="H4872"\w* \w le|strong="H3254"\w* respondió: “\w Tienes|strong="H5750"\w* toda la razón. \w No|strong="H3808"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* verte la \w cara|strong="H6440"\w*”.   
\c 11  
\p
\v 1 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Voy \w a|strong="H3068"\w* mandar una \w plaga|strong="H5061"\w* \w más|strong="H5750"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w*. \w Después|strong="H5921"\w* \w de|strong="H5921"\w* \w eso|strong="H3651"\w*, \w los|strong="H5921"\w* dejará \w ir|strong="H7971"\w*. \w Y|strong="H3068"\w* cuando \w los|strong="H5921"\w* \w deje|strong="H7971"\w* \w ir|strong="H7971"\w*, definitivamente \w los|strong="H5921"\w* \w echará|strong="H7971"\w* \w a|strong="H3068"\w* todos \w de|strong="H5921"\w* \w aquí|strong="H2088"\w*.  
\v 2 \w Habla|strong="H1696"\w* \w ahora|strong="H4994"\w* con el \w pueblo|strong="H5971"\w*, y \w diles|strong="H1696"\w* \w que|strong="H4994"\w* cada hombre le pida \w a|strong="H3068"\w* su vecino, y cada mujer \w a|strong="H3068"\w* su vecina, objetos \w de|strong="H5971"\w* \w plata|strong="H3701"\w* y \w de|strong="H5971"\w* \w oro|strong="H2091"\w*.”  
\v 3 Yahvé \w hizo|strong="H5414"\w* \w que|strong="H1571"\w* los \w egipcios|strong="H4713"\w* vieran \w con|strong="H1571"\w* buenos \w ojos|strong="H5869"\w* al \w pueblo|strong="H5971"\w*. \w Además|strong="H1571"\w*, en todo \w Egipto|strong="H4714"\w* \w se|strong="H5971"\w* \w le|strong="H5869"\w* tenía un \w gran|strong="H1419"\w* respeto \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w tanto|strong="H3966"\w* los funcionarios del \w faraón|strong="H6547"\w* \w como|strong="H1571"\w* \w el|strong="H1571"\w* \w pueblo|strong="H5971"\w* en general.   
\p
\v 4 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* dijo: “\w Así|strong="H3541"\w* dice Yahvé: ‘Alrededor de la medianoche pasaré por todo \w Egipto|strong="H4714"\w*,  
\v 5 \w y|strong="H5921"\w* \w morirán|strong="H4191"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hijos mayores \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w desde|strong="H5704"\w* \w el|strong="H5921"\w* \w primogénito|strong="H1060"\w* \w del|strong="H5921"\w* \w faraón|strong="H6547"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* sienta \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w*, \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w primogénito|strong="H1060"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* esclava \w que|strong="H5921"\w* muele \w en|strong="H5921"\w* \w el|strong="H5921"\w* molino, \w y|strong="H5921"\w* también \w todas|strong="H3605"\w* \w las|strong="H5921"\w* primeras crías \w de|strong="H5921"\w* \w los|strong="H3427"\w* animales.  
\v 6 \w Habrá|strong="H1961"\w* gritos de dolor en \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, \w como|strong="H3644"\w* \w nunca|strong="H3808"\w* antes \w se|strong="H1961"\w* han escuchado \w ni|strong="H3808"\w* \w se|strong="H1961"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* escuchar.  
\v 7 Pero \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w ni|strong="H3808"\w* siquiera les gruñirá un \w perro|strong="H3611"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w ellos|strong="H3605"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* sus \w animales|strong="H1121"\w*. Así \w sabrán|strong="H3045"\w* \w que|strong="H3808"\w* Yahvé hace una clara diferencia \w entre|strong="H3808"\w* \w Egipto|strong="H4714"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w*’.  
\v 8 \w Entonces|strong="H3651"\w* \w todos|strong="H3605"\w* \w estos|strong="H3605"\w* funcionarios tuyos vendrán \w a|strong="H3068"\w* buscarme, \w se|strong="H3651"\w* arrodillarán ante mí y \w me|strong="H5973"\w* suplicarán: ‘¡Váyanse tú y \w todo|strong="H3605"\w* tu \w pueblo|strong="H5971"\w*!’ \w Y|strong="H3068"\w* después \w de|strong="H5973"\w* \w eso|strong="H3651"\w*, \w me|strong="H5973"\w* iré”. \w Y|strong="H3068"\w* Moisés \w salió|strong="H3318"\w* \w muy|strong="H2750"\w* enojado \w de|strong="H5973"\w* \w la|strong="H3605"\w* presencia \w del|strong="H5973"\w* \w faraón|strong="H6547"\w*.   
\p
\v 9 Yahvé le había dicho \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “El \w faraón|strong="H6547"\w* \w no|strong="H3808"\w* les \w va|strong="H3068"\w* \w a|strong="H3068"\w* hacer caso, \w para|strong="H4616"\w* \w que|strong="H3808"\w* yo pueda multiplicar mis milagros en \w Egipto|strong="H4714"\w*”.  
\v 10 \w Moisés|strong="H4872"\w* y Aarón \w hicieron|strong="H6213"\w* \w todos|strong="H3605"\w* \w estos|strong="H3605"\w* milagros \w delante|strong="H6440"\w* del \w faraón|strong="H6547"\w*, pero Yahvé \w hizo|strong="H6213"\w* \w que|strong="H3808"\w* \w el|strong="H3605"\w* \w faraón|strong="H6547"\w* \w se|strong="H3808"\w* pusiera terco y \w no|strong="H3808"\w* dejara salir \w de|strong="H6440"\w* su país \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas.   
\c 12  
\p
\v 1 Yahvé les habló \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón en \w Egipto|strong="H4714"\w*, y les dijo:  
\v 2 “\w Este|strong="H2088"\w* \w mes|strong="H2320"\w* \w será|strong="H1931"\w* para ustedes \w el|strong="H1931"\w* \w primer|strong="H7218"\w* \w mes|strong="H2320"\w*, \w el|strong="H1931"\w* \w mes|strong="H2320"\w* más importante del \w año|strong="H8141"\w*.  
\v 3 Háblenle \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad de \w Israel|strong="H3478"\w* y díganles: ‘\w El|strong="H3605"\w* día diez de \w este|strong="H2088"\w* \w mes|strong="H2320"\w*, \w cada|strong="H3605"\w* jefe de \w familia|strong="H1004"\w* deberá escoger un \w cordero|strong="H7716"\w* para su \w familia|strong="H1004"\w*, un \w cordero|strong="H7716"\w* \w por|strong="H2088"\w* \w casa|strong="H1004"\w*.  
\v 4 \w Si|strong="H1931"\w* \w la|strong="H1931"\w* \w familia|strong="H1004"\w* \w es|strong="H1931"\w* muy \w pequeña|strong="H4591"\w* \w para|strong="H5921"\w* comerse un \w cordero|strong="H7716"\w* entero, entonces \w se|strong="H1961"\w* juntará \w con|strong="H5921"\w* \w el|strong="H1931"\w* \w vecino|strong="H7934"\w* \w que|strong="H1931"\w* viva \w más|strong="H5921"\w* \w cerca|strong="H7138"\w*, \w de|strong="H5921"\w* acuerdo \w al|strong="H5921"\w* número \w de|strong="H5921"\w* \w personas|strong="H5315"\w*. Calcularán \w la|strong="H1931"\w* cantidad \w de|strong="H5921"\w* \w cordero|strong="H7716"\w* \w según|strong="H5921"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* cada \w persona|strong="H5315"\w* pueda \w comer|strong="H5315"\w*.  
\v 5 \w El|strong="H1121"\w* animal deberá ser un \w macho|strong="H2145"\w* \w de|strong="H4480"\w* un \w año|strong="H8141"\w* y sin ningún defecto; puede ser un \w cordero|strong="H3532"\w* \w o|strong="H3068"\w* un cabrito.  
\v 6 \w Lo|strong="H2088"\w* guardarán \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* catorce \w de|strong="H5704"\w* \w este|strong="H2088"\w* \w mismo|strong="H3605"\w* \w mes|strong="H2320"\w*, \w y|strong="H5704"\w* \w al|strong="H5704"\w* atardecer, \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w lo|strong="H2088"\w* sacrificará.  
\v 7 \w Tomarán|strong="H3947"\w* un poco \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* untarán \w en|strong="H5921"\w* \w los|strong="H5921"\w* marcos \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w de|strong="H4480"\w* \w la|strong="H5921"\w* puerta \w de|strong="H4480"\w* \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w donde|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* vayan \w a|strong="H3068"\w* comer.  
\v 8 Esa misma \w noche|strong="H3915"\w* comerán \w la|strong="H5921"\w* \w carne|strong="H1320"\w* \w asada|strong="H6748"\w* \w al|strong="H5921"\w* fuego, acompañada \w de|strong="H5921"\w* pan sin levadura \w y|strong="H5921"\w* hierbas amargas.  
\v 9 \w No|strong="H3588"\w* coman nada \w de|strong="H4480"\w* \w la|strong="H5921"\w* carne cruda ni hervida \w en|strong="H5921"\w* \w agua|strong="H4325"\w*; tiene \w que|strong="H3588"\w* estar \w asada|strong="H6748"\w* \w al|strong="H5921"\w* fuego, entera, \w con|strong="H5921"\w* \w su|strong="H3588"\w* \w cabeza|strong="H7218"\w*, sus patas \w y|strong="H3588"\w* sus entrañas.  
\v 10 \w No|strong="H3808"\w* dejen \w que|strong="H4480"\w* \w sobre|strong="H4480"\w* \w nada|strong="H3808"\w* \w para|strong="H5704"\w* la \w mañana|strong="H1242"\w* siguiente; \w si|strong="H3808"\w* sobra algo, deberán quemarlo.  
\v 11 Cuando coman \w el|strong="H1931"\w* cordero, deberán estar listos para viajar: con \w el|strong="H1931"\w* cinturón abrochado, las sandalias puestas y \w el|strong="H1931"\w* bastón en \w la|strong="H1931"\w* \w mano|strong="H3027"\w*. \w Y|strong="H3068"\w* tendrán \w que|strong="H1931"\w* comerlo de prisa. \w Es|strong="H1931"\w* \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w* de Yahvé.  
\v 12 Porque esa misma \w noche|strong="H3915"\w* \w yo|strong="H6213"\w* \w pasaré|strong="H5674"\w* \w por|strong="H2088"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w* \w y|strong="H5704"\w* les quitaré \w la|strong="H3605"\w* vida \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w primogénitos|strong="H1060"\w*, tanto personas \w como|strong="H5704"\w* animales. \w Ejecutaré|strong="H6213"\w* mi juicio contra \w todos|strong="H3605"\w* \w los|strong="H3605"\w* dioses \w de|strong="H5704"\w* \w Egipto|strong="H4714"\w*. \w Yo|strong="H6213"\w* soy Yahvé.  
\v 13 \w La|strong="H5921"\w* \w sangre|strong="H1818"\w* \w en|strong="H5921"\w* sus \w casas|strong="H1004"\w* \w les|strong="H5921"\w* \w servirá|strong="H1961"\w* \w de|strong="H5921"\w* señal. \w Cuando|strong="H1961"\w* yo \w vea|strong="H7200"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w*, pasaré \w de|strong="H5921"\w* largo, \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* \w entre|strong="H5921"\w* ustedes \w ninguna|strong="H3808"\w* \w plaga|strong="H5063"\w* mortal \w cuando|strong="H1961"\w* yo castigue \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*.  
\v 14 \w Este|strong="H2088"\w* \w será|strong="H1961"\w* un \w día|strong="H3117"\w* \w para|strong="H1961"\w* recordar, y deberán celebrarlo \w como|strong="H1961"\w* una \w fiesta|strong="H2282"\w* en honor \w a|strong="H3068"\w* Yahvé. \w Lo|strong="H2088"\w* celebrarán \w generación|strong="H1755"\w* tras \w generación|strong="H1755"\w* \w como|strong="H1961"\w* una ley permanente.   
\p
\v 15 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* comerán pan sin \w levadura|strong="H7603"\w*. \w El|strong="H1931"\w* \w primer|strong="H7223"\w* \w día|strong="H3117"\w* sacarán \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w levadura|strong="H7603"\w* \w de|strong="H3588"\w* \w sus|strong="H1931"\w* \w casas|strong="H1004"\w*, \w porque|strong="H3588"\w* \w si|strong="H3588"\w* alguien come pan \w con|strong="H3588"\w* \w levadura|strong="H7603"\w* \w entre|strong="H3588"\w* \w el|strong="H1931"\w* \w primer|strong="H7223"\w* \w y|strong="H3588"\w* \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, \w será|strong="H1931"\w* expulsado del pueblo \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.  
\v 16 \w El|strong="H1931"\w* \w primer|strong="H7223"\w* \w día|strong="H3117"\w* celebrarán una reunión sagrada, y también \w el|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*. En esos \w días|strong="H3117"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w hará|strong="H6213"\w* \w ningún|strong="H3605"\w* trabajo, \w solo|strong="H1931"\w* podrán preparar \w la|strong="H1931"\w* comida \w que|strong="H1931"\w* \w cada|strong="H3605"\w* uno vaya \w a|strong="H3068"\w* consumir.  
\v 17 Celebrarán \w la|strong="H3588"\w* fiesta del pan sin levadura \w porque|strong="H3588"\w* \w ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w* \w saqué|strong="H3318"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* escuadrones \w de|strong="H3588"\w* ustedes \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w Por|strong="H3588"\w* eso, deberán celebrar \w este|strong="H2088"\w* \w día|strong="H3117"\w* \w generación|strong="H1755"\w* tras \w generación|strong="H1755"\w* \w como|strong="H3588"\w* una ley permanente.  
\v 18 Comerán pan sin levadura \w desde|strong="H5704"\w* el atardecer del \w día|strong="H3117"\w* catorce del \w primer|strong="H7223"\w* \w mes|strong="H2320"\w* \w hasta|strong="H5704"\w* el atardecer del \w día|strong="H3117"\w* \w veintiuno|strong="H6242"\w* del mismo \w mes|strong="H2320"\w*.  
\v 19 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w no|strong="H3808"\w* debe \w haber|strong="H3808"\w* \w levadura|strong="H7603"\w* \w en|strong="H3588"\w* \w sus|strong="H1931"\w* \w casas|strong="H1004"\w*. \w Todo|strong="H3605"\w* \w el|strong="H1931"\w* \w que|strong="H3588"\w* coma algo \w que|strong="H3588"\w* tenga \w levadura|strong="H7603"\w* \w será|strong="H1931"\w* expulsado \w de|strong="H3588"\w* \w la|strong="H1931"\w* comunidad \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, ya sea \w extranjero|strong="H1616"\w* \w o|strong="H3068"\w* nacido \w en|strong="H3588"\w* \w el|strong="H1931"\w* país.  
\v 20 \w Así|strong="H2557"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* coman \w nada|strong="H3808"\w* \w que|strong="H3808"\w* tenga levadura. Dondequiera \w que|strong="H3808"\w* vivan, comerán pan \w sin|strong="H3808"\w* levadura’”.   
\p
\v 21 Entonces \w Moisés|strong="H4872"\w* mandó \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes de \w Israel|strong="H3478"\w* y les dijo: “Vayan y escojan \w los|strong="H3605"\w* \w corderos|strong="H6629"\w* para sus \w familias|strong="H4940"\w*, y sacrifiquen \w el|strong="H3605"\w* animal para \w la|strong="H3605"\w* \w Pascua|strong="H6453"\w*.  
\v 22 \w Tomen|strong="H3947"\w* un manojo \w de|strong="H4480"\w* hisopo, mójenlo \w en|strong="H4480"\w* la \w sangre|strong="H1818"\w* \w que|strong="H4480"\w* está \w en|strong="H4480"\w* el recipiente \w y|strong="H5704"\w* unten \w con|strong="H4480"\w* \w ella|strong="H4480"\w* la parte superior \w y|strong="H5704"\w* los lados \w de|strong="H4480"\w* la \w puerta|strong="H6607"\w*. \w Nadie|strong="H3808"\w* debe \w salir|strong="H3318"\w* \w de|strong="H4480"\w* su \w casa|strong="H1004"\w* \w hasta|strong="H5704"\w* la \w mañana|strong="H1242"\w* siguiente.  
\v 23 \w Porque|strong="H5921"\w* Yahvé \w pasará|strong="H5674"\w* castigando \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w*; \w y|strong="H5921"\w* cuando \w él|strong="H5921"\w* \w vea|strong="H7200"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte superior \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* lados \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w*, \w pasará|strong="H5674"\w* \w de|strong="H5921"\w* largo \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w dejará|strong="H5414"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* destructor \w entre|strong="H5921"\w* \w a|strong="H3068"\w* sus \w casas|strong="H1004"\w* \w a|strong="H3068"\w* quitarles \w la|strong="H5921"\w* vida.  
\v 24 Ustedes \w y|strong="H5704"\w* sus descendientes deberán cumplir \w con|strong="H5704"\w* \w esta|strong="H2088"\w* ordenanza \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 25 \w Cuando|strong="H3588"\w* entren \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* Yahvé les prometió \w dar|strong="H5414"\w*, deberán seguir celebrando \w esta|strong="H2063"\w* ceremonia.  
\v 26 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* sus \w hijos|strong="H1121"\w* les pregunten: ‘¿\w Qué|strong="H3588"\w* significa \w esta|strong="H2063"\w* ceremonia \w para|strong="H3588"\w* ustedes?’  
\v 27 \w Le|strong="H1931"\w* responderán: ‘\w Es|strong="H1931"\w* \w el|strong="H1931"\w* \w sacrificio|strong="H2077"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w Pascua|strong="H6453"\w* \w en|strong="H5921"\w* honor \w a|strong="H3068"\w* Yahvé, \w quien|strong="H1931"\w* \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w pasó|strong="H6452"\w* \w de|strong="H5921"\w* largo \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas; castigó \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w egipcios|strong="H4714"\w* pero salvó \w a|strong="H3068"\w* nuestras \w familias|strong="H1004"\w*’”.  
\p \w Al|strong="H5921"\w* escuchar \w esto|strong="H1931"\w*, \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1931"\w* \w inclinó|strong="H6915"\w* \w y|strong="H5921"\w* \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*.  
\v 28 \w Los|strong="H1121"\w* israelitas \w fueron|strong="H3212"\w* \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* todo \w tal|strong="H3651"\w* \w como|strong="H3651"\w* Yahvé \w se|strong="H3651"\w* \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón.   
\p
\v 29 \w A|strong="H3068"\w* \w la|strong="H5921"\w* medianoche, Yahvé \w les|strong="H5921"\w* quitó \w la|strong="H5921"\w* vida \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* hijos mayores \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w desde|strong="H5704"\w* \w el|strong="H5921"\w* \w primogénito|strong="H1060"\w* \w del|strong="H5921"\w* \w faraón|strong="H6547"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* sentaba \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w*, \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w primogénito|strong="H1060"\w* \w del|strong="H5921"\w* preso \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* calabozo, \w y|strong="H5921"\w* también \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* primeras crías \w de|strong="H5921"\w* \w los|strong="H3427"\w* animales.  
\v 30 \w El|strong="H1931"\w* \w faraón|strong="H6547"\w* \w se|strong="H1961"\w* despertó \w en|strong="H3588"\w* \w la|strong="H1931"\w* madrugada, junto \w con|strong="H3588"\w* \w sus|strong="H1931"\w* funcionarios \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4714"\w*. \w Había|strong="H1961"\w* un llanto desgarrador \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w Egipto|strong="H4714"\w*, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* \w había|strong="H1961"\w* una sola \w casa|strong="H1004"\w* \w donde|strong="H8033"\w* \w no|strong="H3588"\w* hubiera un \w muerto|strong="H4191"\w*.  
\v 31 Esa misma \w noche|strong="H3915"\w* \w el|strong="H1121"\w* faraón \w mandó|strong="H1696"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* Aarón, \w y|strong="H1571"\w* les \w dijo|strong="H1696"\w*: “¡\w Levántense|strong="H6965"\w* \w y|strong="H1571"\w* lárguense \w de|strong="H1121"\w* mi país, ustedes \w y|strong="H1571"\w* \w los|strong="H1121"\w* israelitas! \w Vayan|strong="H3212"\w* \w a|strong="H3068"\w* adorar \w a|strong="H3068"\w* Yahvé, tal \w como|strong="H1571"\w* lo pidieron.  
\v 32 Llévense \w también|strong="H1571"\w* sus \w ovejas|strong="H6629"\w* \w y|strong="H1571"\w* sus \w vacas|strong="H1241"\w*, \w como|strong="H1571"\w* querían, pero ¡váyanse \w ya|strong="H1571"\w*! \w Y|strong="H3068"\w* pidan \w que|strong="H1571"\w* me \w vaya|strong="H3212"\w* bien”.   
\p
\v 33 \w Los|strong="H5921"\w* \w egipcios|strong="H4713"\w* apuraban \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* fueran rápido \w del|strong="H4480"\w* país, \w pues|strong="H3588"\w* decían: “\w Si|strong="H3588"\w* \w no|strong="H3588"\w* \w se|strong="H5921"\w* van, ¡\w todos|strong="H3605"\w* \w nos|strong="H5921"\w* vamos \w a|strong="H3068"\w* \w morir|strong="H4191"\w*!”  
\v 34 Así \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* \w llevó|strong="H5375"\w* \w la|strong="H5921"\w* masa \w antes|strong="H2962"\w* \w de|strong="H5921"\w* ponerle \w la|strong="H5921"\w* levadura, \w y|strong="H5921"\w* cargaron \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w hombros|strong="H7926"\w* \w los|strong="H5921"\w* recipientes \w de|strong="H5921"\w* amasar envueltos \w en|strong="H5921"\w* sus mantos.  
\v 35 \w Los|strong="H1121"\w* israelitas \w hicieron|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w Moisés|strong="H4872"\w* les \w había|strong="H6213"\w* \w dicho|strong="H1697"\w*, y les \w pidieron|strong="H7592"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w egipcios|strong="H4714"\w* objetos \w de|strong="H1121"\w* \w plata|strong="H3701"\w*, objetos \w de|strong="H1121"\w* \w oro|strong="H2091"\w* y \w ropa|strong="H8071"\w*.  
\v 36 Yahvé \w hizo|strong="H5414"\w* \w que|strong="H5971"\w* los \w egipcios|strong="H4714"\w* vieran con buenos \w ojos|strong="H5869"\w* al \w pueblo|strong="H5971"\w*, y les \w dieron|strong="H5414"\w* lo \w que|strong="H5971"\w* les \w pidieron|strong="H7592"\w*. \w De|strong="H5971"\w* esta manera, despojaron \w a|strong="H3068"\w* los \w egipcios|strong="H4714"\w* \w de|strong="H5971"\w* sus riquezas.   
\p
\v 37 \w Los|strong="H1121"\w* israelitas \w salieron|strong="H5265"\w* \w de|strong="H1121"\w* Ramesés rumbo \w a|strong="H3068"\w* Sucot. Eran unos \w seiscientos|strong="H8337"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1121"\w* \w a|strong="H3068"\w* pie, sin contar \w a|strong="H3068"\w* las mujeres y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w niños|strong="H2945"\w*.  
\v 38 \w Con|strong="H1571"\w* \w ellos|strong="H1571"\w* \w también|strong="H1571"\w* \w salió|strong="H5927"\w* una \w gran|strong="H3966"\w* \w multitud|strong="H7227"\w* de gente de toda clase, \w y|strong="H1571"\w* muchísimas \w ovejas|strong="H6629"\w*, \w vacas|strong="H1241"\w* \w y|strong="H1571"\w* \w ganado|strong="H4735"\w*.  
\v 39 \w Como|strong="H3588"\w* \w los|strong="H3588"\w* echaron \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w y|strong="H1571"\w* \w no|strong="H3808"\w* tuvieron tiempo \w de|strong="H3588"\w* prepararse \w comida|strong="H6720"\w*, cocieron \w la|strong="H1571"\w* masa \w que|strong="H3588"\w* llevaban \w y|strong="H1571"\w* comieron \w pan|strong="H5692"\w* \w sin|strong="H3808"\w* levadura.  
\v 40 \w Los|strong="H3427"\w* israelitas habían vivido en \w Egipto|strong="H4714"\w* durante cuatrocientos \w treinta|strong="H7970"\w* \w años|strong="H8141"\w*.  
\v 41 \w El|strong="H3605"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w* \w en|strong="H3318"\w* \w que|strong="H3117"\w* \w se|strong="H1961"\w* cumplieron \w los|strong="H3605"\w* cuatrocientos \w treinta|strong="H7970"\w* \w años|strong="H8141"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* escuadrones de Yahvé \w salieron|strong="H3318"\w* de \w Egipto|strong="H4714"\w*.  
\v 42 \w Esa|strong="H1931"\w* \w fue|strong="H1931"\w* una \w noche|strong="H3915"\w* \w en|strong="H3318"\w* \w la|strong="H1931"\w* \w que|strong="H1931"\w* Yahvé estuvo cuidándolos para sacarlos \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*; \w por|strong="H2088"\w* \w eso|strong="H1931"\w*, \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas, \w de|strong="H1121"\w* \w generación|strong="H1755"\w* \w en|strong="H3318"\w* \w generación|strong="H1755"\w*, deben celebrar \w esa|strong="H1931"\w* \w noche|strong="H3915"\w* \w en|strong="H3318"\w* honor \w a|strong="H3068"\w* Yahvé.   
\p
\v 43 Yahvé les dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón: “\w Estas|strong="H2063"\w* \w son|strong="H3808"\w* las reglas para \w la|strong="H2063"\w* \w Pascua|strong="H6453"\w*: \w Ningún|strong="H3605"\w* \w extranjero|strong="H5236"\w* \w podrá|strong="H3808"\w* comer \w de|strong="H1121"\w* \w ella|strong="H3605"\w*.  
\v 44 \w Todo|strong="H3605"\w* esclavo \w que|strong="H3605"\w* hayas \w comprado|strong="H4736"\w* podrá participar, pero solo después de \w que|strong="H3605"\w* \w lo|strong="H3605"\w* hayas \w circuncidado|strong="H4135"\w*.  
\v 45 Los visitantes y los empleados \w no|strong="H3808"\w* podrán comer de ella.  
\v 46 \w Se|strong="H4480"\w* deberá comer dentro \w de|strong="H4480"\w* una sola \w casa|strong="H1004"\w*; \w no|strong="H3808"\w* \w se|strong="H4480"\w* puede sacar \w nada|strong="H3808"\w* \w de|strong="H4480"\w* \w carne|strong="H1320"\w* \w de|strong="H4480"\w* la \w casa|strong="H1004"\w*, y \w no|strong="H3808"\w* le \w quebrarán|strong="H7665"\w* \w ningún|strong="H3808"\w* \w hueso|strong="H6106"\w* \w al|strong="H4480"\w* animal.  
\v 47 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad de \w Israel|strong="H3478"\w* debe \w celebrar|strong="H6213"\w* esta fiesta.  
\v 48 \w Si|strong="H3588"\w* un \w extranjero|strong="H1616"\w* \w que|strong="H3588"\w* viva \w entre|strong="H3808"\w* ustedes quiere \w celebrar|strong="H6213"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w* \w en|strong="H3588"\w* honor \w a|strong="H3068"\w* Yahvé, primero deberán circuncidarse \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres \w de|strong="H3588"\w* \w su|strong="H3588"\w* familia. Solo \w entonces|strong="H3588"\w* \w podrá|strong="H3808"\w* participar, \w y|strong="H3588"\w* \w será|strong="H1961"\w* considerado \w como|strong="H3588"\w* alguien nacido \w en|strong="H3588"\w* \w el|strong="H3588"\w* país. \w Ningún|strong="H3605"\w* hombre \w sin|strong="H3808"\w* circuncidar \w podrá|strong="H3808"\w* comer \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Pascua|strong="H6453"\w*.  
\v 49 \w Esta|strong="H1961"\w* misma regla \w se|strong="H1961"\w* aplicará tanto \w para|strong="H1961"\w* el \w que|strong="H1616"\w* \w haya|strong="H1961"\w* nacido \w en|strong="H8432"\w* el país \w como|strong="H1961"\w* \w para|strong="H1961"\w* el \w extranjero|strong="H1616"\w* \w que|strong="H1616"\w* viva \w entre|strong="H8432"\w* ustedes.”  
\v 50 \w Todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w así|strong="H3651"\w*, cumpliendo exactamente con \w lo|strong="H6213"\w* \w que|strong="H1121"\w* Yahvé \w les|strong="H6680"\w* \w había|strong="H6213"\w* \w ordenado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón.  
\v 51 \w Ese|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w*, Yahvé \w sacó|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, ordenados \w por|strong="H5921"\w* escuadrones.   
\c 13  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “Conságrame \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* mayores. \w El|strong="H1931"\w* primer \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w cada|strong="H3605"\w* familia \w israelita|strong="H3478"\w* \w es|strong="H1931"\w* mío, y también \w la|strong="H1931"\w* primera cría \w de|strong="H1121"\w* \w cada|strong="H3605"\w* animal”.   
\p
\v 3 \w Moisés|strong="H4872"\w* le dijo al \w pueblo|strong="H5971"\w*: “Acuérdense \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w día|strong="H3117"\w* \w en|strong="H3588"\w* \w que|strong="H3588"\w* \w salieron|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, donde \w eran|strong="H3808"\w* esclavos, \w porque|strong="H3588"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* gran \w poder|strong="H3027"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w* Yahvé \w los|strong="H3588"\w* \w sacó|strong="H3318"\w* \w de|strong="H3588"\w* allí. \w Así|strong="H2088"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* coman \w nada|strong="H3808"\w* \w que|strong="H3588"\w* tenga levadura.  
\v 4 Ustedes \w salen|strong="H3318"\w* \w hoy|strong="H3117"\w*, \w en|strong="H3318"\w* el \w mes|strong="H2320"\w* de Abib.  
\v 5 \w Cuando|strong="H3588"\w* Yahvé \w los|strong="H1961"\w* lleve \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w cananeos|strong="H3669"\w*, \w de|strong="H3588"\w* \w los|strong="H1961"\w* hititas, \w de|strong="H3588"\w* \w los|strong="H1961"\w* amorreos, \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w heveos|strong="H2340"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w jebuseos|strong="H2983"\w*, esa tierra \w que|strong="H3588"\w* promete abundancia \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w juró|strong="H7650"\w* darles \w a|strong="H3068"\w* sus antepasados, deberán celebrar \w esta|strong="H2063"\w* ceremonia \w en|strong="H3588"\w* \w este|strong="H2088"\w* mismo \w mes|strong="H2320"\w*.  
\v 6 Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* comerán pan sin levadura, y el \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* harán una \w fiesta|strong="H2282"\w* en honor \w a|strong="H3068"\w* Yahvé.  
\v 7 En esos \w siete|strong="H7651"\w* \w días|strong="H3117"\w* solo \w se|strong="H3808"\w* comerá pan \w sin|strong="H3808"\w* \w levadura|strong="H7603"\w*. \w No|strong="H3808"\w* debe \w haber|strong="H3808"\w* pan con \w levadura|strong="H7603"\w*, \w ni|strong="H3808"\w* \w levadura|strong="H7603"\w* \w alguna|strong="H3605"\w*, en \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de ustedes.  
\v 8 \w En|strong="H3318"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w le|strong="H1931"\w* explicarás \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w hijo|strong="H1121"\w*: ‘\w Hacemos|strong="H6213"\w* \w esto|strong="H2088"\w* para recordar \w lo|strong="H1931"\w* \w que|strong="H1931"\w* Yahvé \w hizo|strong="H6213"\w* \w por|strong="H2088"\w* mí \w cuando|strong="H3117"\w* \w salí|strong="H3318"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*’.  
\v 9 \w Esta|strong="H1961"\w* ceremonia \w les|strong="H5921"\w* \w servirá|strong="H1961"\w* \w como|strong="H3588"\w* una marca \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w y|strong="H3588"\w* \w como|strong="H3588"\w* un recordatorio \w en|strong="H5921"\w* \w la|strong="H5921"\w* frente, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w siempre|strong="H5921"\w* hablen \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* Yahvé. \w Porque|strong="H3588"\w* \w con|strong="H5921"\w* \w mano|strong="H3027"\w* \w poderosa|strong="H2389"\w* Yahvé \w los|strong="H5921"\w* \w sacó|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\v 10 Por lo tanto, deberán cumplir con \w esta|strong="H2063"\w* ley en \w la|strong="H8104"\w* fecha señalada, año tras año.   
\p
\v 11 \w Cuando|strong="H3588"\w* Yahvé \w los|strong="H1961"\w* introduzca \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w cananeos|strong="H3669"\w*, tal \w como|strong="H3588"\w* \w se|strong="H1961"\w* lo \w juró|strong="H7650"\w* \w a|strong="H3068"\w* ustedes \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus antepasados, \w y|strong="H3588"\w* \w se|strong="H1961"\w* \w la|strong="H3588"\w* \w entregue|strong="H5414"\w*,  
\v 12 le dedicarán \w a|strong="H3068"\w* Yahvé \w el|strong="H3605"\w* primer \w hijo|strong="H2145"\w* de \w cada|strong="H3605"\w* familia, y también las primeras crías de sus animales. \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* machos primerizos le pertenecerán \w a|strong="H3068"\w* Yahvé.  
\v 13 Para rescatar \w a|strong="H3068"\w* \w la|strong="H3605"\w* primera cría \w de|strong="H1121"\w* un burro, deberán sacrificar un \w cordero|strong="H7716"\w* \w a|strong="H3068"\w* cambio; \w si|strong="H3808"\w* \w no|strong="H3808"\w* quieren rescatarlo, tendrán \w que|strong="H3808"\w* romperle \w el|strong="H3605"\w* cuello al burrito. También deberán rescatar al primer \w hijo|strong="H1121"\w* varón \w de|strong="H1121"\w* \w cada|strong="H3605"\w* familia.  
\v 14 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* futuro sus \w hijos|strong="H1121"\w* les preguntan: ‘¿\w Qué|strong="H3588"\w* significa todo \w esto|strong="H2063"\w*?’, ustedes les responderán: ‘\w Con|strong="H3588"\w* \w mano|strong="H3027"\w* poderosa Yahvé \w nos|strong="H4100"\w* \w sacó|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H3588"\w* ese lugar \w de|strong="H3588"\w* esclavitud.  
\v 15 \w Como|strong="H3588"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* \w se|strong="H1961"\w* \w puso|strong="H7971"\w* terco \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w nos|strong="H5921"\w* dejaba \w ir|strong="H7971"\w*, Yahvé \w les|strong="H5921"\w* quitó \w la|strong="H5921"\w* vida \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w primogénitos|strong="H1060"\w* \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w tanto|strong="H3651"\w* \w de|strong="H5921"\w* personas \w como|strong="H3588"\w* \w de|strong="H5921"\w* \w animales|strong="H1121"\w*. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w le|strong="H5921"\w* sacrificamos \w a|strong="H3068"\w* Yahvé \w todos|strong="H3605"\w* \w los|strong="H1121"\w* machos primerizos \w de|strong="H5921"\w* nuestros \w animales|strong="H1121"\w*, \w pero|strong="H3588"\w* rescatamos \w a|strong="H3068"\w* \w todos|strong="H3605"\w* nuestros \w hijos|strong="H1121"\w* mayores’.  
\v 16 Esto \w les|strong="H5921"\w* \w servirá|strong="H1961"\w* \w como|strong="H3588"\w* una marca \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w y|strong="H3588"\w* \w como|strong="H3588"\w* un recordatorio \w en|strong="H5921"\w* \w la|strong="H5921"\w* frente, \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w con|strong="H5921"\w* \w mano|strong="H3027"\w* poderosa Yahvé \w nos|strong="H5921"\w* \w sacó|strong="H3318"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*.”   
\p
\v 17 \w Cuando|strong="H3588"\w* \w el|strong="H1931"\w* \w faraón|strong="H6547"\w* \w dejó|strong="H7971"\w* \w ir|strong="H7971"\w* al \w pueblo|strong="H5971"\w*, Dios \w no|strong="H3808"\w* \w los|strong="H1931"\w* llevó \w por|strong="H3588"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* tierra \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w*, \w aunque|strong="H3588"\w* \w era|strong="H1961"\w* \w el|strong="H1931"\w* \w más|strong="H3588"\w* corto, \w porque|strong="H3588"\w* Dios pensó: “\w Si|strong="H3588"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1961"\w* enfrenta \w a|strong="H3068"\w* una \w guerra|strong="H4421"\w*, podrían arrepentirse \w y|strong="H3588"\w* regresarse \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*”.  
\v 18 En lugar \w de|strong="H1121"\w* eso, Dios \w hizo|strong="H5927"\w* \w que|strong="H5971"\w* \w el|strong="H1121"\w* \w pueblo|strong="H5971"\w* diera un \w rodeo|strong="H5437"\w* \w por|strong="H1870"\w* \w el|strong="H1121"\w* \w camino|strong="H1870"\w* del \w desierto|strong="H4057"\w*, rumbo al \w Mar|strong="H3220"\w* Rojo. \w Y|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w salieron|strong="H5927"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w* \w armados|strong="H2571"\w* y organizados como un ejército.  
\v 19 \w Moisés|strong="H4872"\w* se \w llevó|strong="H3947"\w* \w los|strong="H1121"\w* \w huesos|strong="H6106"\w* \w de|strong="H3588"\w* \w José|strong="H3130"\w*, \w porque|strong="H3588"\w* \w José|strong="H3130"\w* \w les|strong="H5973"\w* \w había|strong="H3588"\w* hecho jurar \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas diciéndoles: “Dios \w ciertamente|strong="H3588"\w* \w vendrá|strong="H5927"\w* \w a|strong="H3068"\w* ayudarlos; \w cuando|strong="H3588"\w* eso pase, llévense mis \w huesos|strong="H6106"\w* \w con|strong="H5973"\w* ustedes”.  
\v 20 \w Partieron|strong="H5265"\w* de Sucot y acamparon en Etam, justo donde empieza el \w desierto|strong="H4057"\w*.  
\v 21 Yahvé \w iba|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos: \w de|strong="H6440"\w* \w día|strong="H3119"\w* \w iba|strong="H1980"\w* \w en|strong="H3212"\w* una \w columna|strong="H5982"\w* \w de|strong="H6440"\w* \w nube|strong="H6051"\w* para guiarlos \w por|strong="H1870"\w* el \w camino|strong="H1870"\w*, y \w de|strong="H6440"\w* \w noche|strong="H3915"\w* \w en|strong="H3212"\w* una \w columna|strong="H5982"\w* \w de|strong="H6440"\w* fuego para alumbrarlos, y así podían viajar \w de|strong="H6440"\w* \w día|strong="H3119"\w* \w o|strong="H3068"\w* \w de|strong="H6440"\w* \w noche|strong="H3915"\w*.  
\v 22 La \w columna|strong="H5982"\w* \w de|strong="H6440"\w* \w nube|strong="H6051"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* apartaba \w de|strong="H6440"\w* ellos durante el \w día|strong="H3119"\w*, \w ni|strong="H3808"\w* la \w columna|strong="H5982"\w* \w de|strong="H6440"\w* fuego durante la \w noche|strong="H3915"\w*.   
\c 14  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H5921"\w* den \w la|strong="H5921"\w* vuelta \w y|strong="H5921"\w* acampen frente \w a|strong="H3068"\w* Pi-hahirot, \w entre|strong="H5921"\w* \w Migdol|strong="H4024"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, frente \w a|strong="H3068"\w* Baal-zefón. \w Acamparán|strong="H2583"\w* allí, \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 3 \w Así|strong="H1992"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w* pensará: ‘\w Los|strong="H1992"\w* israelitas andan perdidos \w en|strong="H5921"\w* \w el|strong="H5921"\w* país; \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w los|strong="H1992"\w* tiene acorralados’.  
\v 4 \w Yo|strong="H3588"\w* \w haré|strong="H6213"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w faraón|strong="H6547"\w* \w se|strong="H3045"\w* ponga terco \w y|strong="H3588"\w* \w los|strong="H3605"\w* \w persiga|strong="H7291"\w*. \w Entonces|strong="H3588"\w* mostraré mi \w gloria|strong="H3605"\w* al derrotar al \w faraón|strong="H6547"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w su|strong="H3588"\w* \w ejército|strong="H2428"\w*, \w y|strong="H3588"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4713"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.” \w Y|strong="H3068"\w* \w los|strong="H3605"\w* israelitas \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w Dios|strong="H3068"\w* ordenó.   
\p
\v 5 \w Cuando|strong="H3588"\w* le avisaron \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w había|strong="H3588"\w* huido, \w el|strong="H3588"\w* \w faraón|strong="H6547"\w* \w y|strong="H3588"\w* sus funcionarios cambiaron \w de|strong="H3588"\w* parecer \w y|strong="H3588"\w* dijeron: “¿\w Qué|strong="H3588"\w* hemos \w hecho|strong="H6213"\w*? ¡Dejamos \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* israelitas \w y|strong="H3588"\w* perdimos \w a|strong="H3068"\w* nuestros esclavos!”  
\v 6 Entonces \w el|strong="H5973"\w* faraón mandó preparar su \w carro|strong="H7393"\w* \w de|strong="H5973"\w* guerra y \w se|strong="H5971"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* su ejército \w con|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 7 \w Se|strong="H5921"\w* \w llevó|strong="H3947"\w* \w seiscientos|strong="H8337"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* mejores \w carros|strong="H7393"\w*, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* demás \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w todos|strong="H3605"\w* \w al|strong="H5921"\w* mando \w de|strong="H5921"\w* sus capitanes.  
\v 8 Yahvé hizo \w que|strong="H1121"\w* \w el|strong="H1121"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, se pusiera terco y persiguiera \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas, \w a|strong="H3068"\w* pesar \w de|strong="H1121"\w* \w que|strong="H1121"\w* \w ellos|strong="H3027"\w* habían \w salido|strong="H3318"\w* libres y con la frente \w en|strong="H3318"\w* \w alto|strong="H7311"\w*.  
\v 9 \w Los|strong="H5921"\w* \w egipcios|strong="H4713"\w*, \w con|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w caballos|strong="H5483"\w*, \w los|strong="H5921"\w* \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w la|strong="H5921"\w* caballería \w del|strong="H5921"\w* \w faraón|strong="H6547"\w*, \w persiguieron|strong="H7291"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* israelitas \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w alcanzaron|strong="H5381"\w* \w mientras|strong="H3605"\w* acampaban \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w mar|strong="H3220"\w*, \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* Pi-hahirot, frente \w a|strong="H3068"\w* Baal-zefón.   
\p
\v 10 Al ver \w que|strong="H1121"\w* \w el|strong="H1121"\w* \w faraón|strong="H6547"\w* y \w los|strong="H1121"\w* \w egipcios|strong="H4713"\w* se acercaban, \w los|strong="H1121"\w* israelitas se murieron \w de|strong="H1121"\w* \w miedo|strong="H3372"\w* y empezaron \w a|strong="H3068"\w* pedirle ayuda \w a|strong="H3068"\w* Yahvé \w a|strong="H3068"\w* gritos.  
\v 11 \w Y|strong="H3068"\w* le reclamaron \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¿Acaso \w no|strong="H1097"\w* \w había|strong="H6213"\w* tumbas \w en|strong="H3318"\w* \w Egipto|strong="H4714"\w*, \w que|strong="H4100"\w* \w nos|strong="H4100"\w* trajiste \w a|strong="H3068"\w* \w morir|strong="H4191"\w* al \w desierto|strong="H4057"\w*? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* \w hiciste|strong="H6213"\w* \w esto|strong="H2063"\w*? ¿Para \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* \w sacaste|strong="H3318"\w* de \w Egipto|strong="H4714"\w*?  
\v 12 ¿\w No|strong="H3808"\w* \w te|strong="H4480"\w* decíamos \w cuando|strong="H3588"\w* estábamos allá: ‘\w Déjanos|strong="H2308"\w* \w en|strong="H4480"\w* paz, preferimos ser esclavos \w de|strong="H4480"\w* \w los|strong="H3588"\w* \w egipcios|strong="H4713"\w*’? ¡Hubiera sido \w mejor|strong="H2896"\w* seguir \w de|strong="H4480"\w* esclavos \w que|strong="H3588"\w* \w morir|strong="H4191"\w* \w aquí|strong="H2088"\w* \w en|strong="H4480"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*!”   
\p
\v 13 \w Moisés|strong="H4872"\w* \w le|strong="H3254"\w* respondió \w al|strong="H5704"\w* \w pueblo|strong="H5971"\w*: “¡\w No|strong="H3808"\w* tengan \w miedo|strong="H3372"\w*! Quédense quietos \w y|strong="H3588"\w* \w vean|strong="H7200"\w* \w cómo|strong="H3588"\w* Yahvé \w los|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* salvar \w hoy|strong="H3117"\w*. \w A|strong="H3068"\w* estos \w egipcios|strong="H4713"\w* \w que|strong="H3588"\w* \w ven|strong="H7200"\w* \w ahora|strong="H3117"\w*, \w no|strong="H3808"\w* \w los|strong="H3588"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w*.  
\v 14 Yahvé \w peleará|strong="H3898"\w* por ustedes, y ustedes solo tienen que quedarse tranquilos”.   
\p
\v 15 Entonces Yahvé le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* me pides ayuda \w a|strong="H3068"\w* gritos? ¡\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H4100"\w* sigan avanzando!  
\v 16 \w Y|strong="H3068"\w* tú, \w levanta|strong="H7311"\w* tu \w vara|strong="H4294"\w*, \w extiende|strong="H5186"\w* tu \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w y|strong="H5921"\w* ábrelo \w en|strong="H5921"\w* dos, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H1121"\w* israelitas crucen \w por|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w* \w sobre|strong="H5921"\w* \w tierra|strong="H3004"\w* seca.  
\v 17 Yo haré \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4713"\w* se pongan tercos y entren al mar persiguiéndolos. Entonces mostraré mi \w gloria|strong="H3605"\w* al derrotar al \w faraón|strong="H6547"\w*, \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H2428"\w*, \w a|strong="H3068"\w* sus \w carros|strong="H7393"\w* y \w a|strong="H3068"\w* su caballería.  
\v 18 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* haya mostrado mi gloria contra \w el|strong="H3588"\w* \w faraón|strong="H6547"\w* \w y|strong="H3588"\w* sus tropas, \w los|strong="H3588"\w* \w egipcios|strong="H4713"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.”  
\v 19 \w El|strong="H4264"\w* \w ángel|strong="H4397"\w* \w de|strong="H6440"\w* Dios, que \w iba|strong="H1980"\w* guiando \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, cambió \w de|strong="H6440"\w* lugar y se \w puso|strong="H5975"\w* detrás \w de|strong="H6440"\w* ellos. La \w columna|strong="H5982"\w* \w de|strong="H6440"\w* \w nube|strong="H6051"\w* también se \w movió|strong="H5265"\w* y se \w puso|strong="H5975"\w* \w a|strong="H3068"\w* sus espaldas,  
\v 20 quedando exactamente \w entre|strong="H3808"\w* \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* de \w los|strong="H3605"\w* \w egipcios|strong="H4714"\w* y \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* de \w Israel|strong="H3478"\w*. Del lado de \w los|strong="H3605"\w* \w egipcios|strong="H4714"\w*, \w la|strong="H3605"\w* \w nube|strong="H6051"\w* trajo \w oscuridad|strong="H2822"\w*, pero del lado de \w los|strong="H3605"\w* israelitas alumbraba \w la|strong="H3605"\w* \w noche|strong="H3915"\w*. \w Así|strong="H2088"\w* \w que|strong="H3808"\w* en \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w noche|strong="H3915"\w* \w los|strong="H3605"\w* \w egipcios|strong="H4714"\w* \w no|strong="H3808"\w* pudieron acercarse \w a|strong="H3068"\w* \w los|strong="H3605"\w* israelitas.   
\p
\v 21 \w Moisés|strong="H4872"\w* \w extendió|strong="H5186"\w* su \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w y|strong="H5921"\w* Yahvé mandó un \w fuerte|strong="H5794"\w* \w viento|strong="H7307"\w* \w del|strong="H5921"\w* este \w que|strong="H5921"\w* \w sopló|strong="H7307"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w* \w y|strong="H5921"\w* \w partió|strong="H3212"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w en|strong="H5921"\w* dos. \w Las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H5921"\w* dividieron \w y|strong="H5921"\w* \w el|strong="H5921"\w* fondo \w del|strong="H5921"\w* \w mar|strong="H3220"\w* quedó seco.  
\v 22 \w Los|strong="H1121"\w* israelitas cruzaron por \w en|strong="H8432"\w* \w medio|strong="H8432"\w* del \w mar|strong="H3220"\w* caminando sobre \w tierra|strong="H3004"\w* seca, mientras las \w aguas|strong="H4325"\w* formaban dos grandes \w muros|strong="H2346"\w*, uno \w a|strong="H3068"\w* la \w derecha|strong="H3225"\w* y otro \w a|strong="H3068"\w* la \w izquierda|strong="H8040"\w*.  
\v 23 \w Los|strong="H3605"\w* \w egipcios|strong="H4713"\w* se lanzaron \w a|strong="H3068"\w* perseguirlos, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w caballos|strong="H5483"\w* del \w faraón|strong="H6547"\w*, junto con sus \w carros|strong="H7393"\w* y su caballería, entraron tras \w ellos|strong="H3605"\w* hasta \w la|strong="H3605"\w* \w mitad|strong="H8432"\w* del \w mar|strong="H3220"\w*.  
\v 24 En la madrugada, Yahvé \w miró|strong="H8259"\w* al \w ejército|strong="H4264"\w* \w egipcio|strong="H4713"\w* desde la \w columna|strong="H5982"\w* de fuego y \w nube|strong="H6051"\w*, y \w los|strong="H1961"\w* llenó de confusión y pánico.  
\v 25 \w Hizo|strong="H3898"\w* \w que|strong="H3588"\w* se les trabaran las ruedas \w a|strong="H3068"\w* sus \w carros|strong="H4818"\w* \w de|strong="H3588"\w* \w guerra|strong="H3898"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* pudieran avanzar. \w Entonces|strong="H5493"\w* \w los|strong="H3588"\w* \w egipcios|strong="H4714"\w* gritaron: “¡Huyamos \w de|strong="H3588"\w* \w los|strong="H3588"\w* israelitas, \w porque|strong="H3588"\w* Yahvé está \w peleando|strong="H3898"\w* \w a|strong="H3068"\w* favor \w de|strong="H3588"\w* ellos \w y|strong="H3588"\w* \w contra|strong="H6440"\w* nosotros!”   
\p
\v 26 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Extiende|strong="H5186"\w* tu \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H5921"\w* regresen \w y|strong="H5921"\w* cubran \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w*, \w a|strong="H3068"\w* sus \w carros|strong="H7393"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su caballería.”  
\v 27 \w Moisés|strong="H4872"\w* \w extendió|strong="H5186"\w* su \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w y|strong="H5921"\w* \w al|strong="H5921"\w* amanecer \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* su lugar normal. \w Los|strong="H5921"\w* \w egipcios|strong="H4714"\w* intentaron huir, pero \w se|strong="H5921"\w* toparon \w de|strong="H5921"\w* \w frente|strong="H7125"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* aguas, \w y|strong="H5921"\w* Yahvé \w los|strong="H5921"\w* hundió \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 28 Las \w aguas|strong="H4325"\w* regresaron \w y|strong="H5704"\w* \w cubrieron|strong="H3680"\w* \w los|strong="H3605"\w* \w carros|strong="H7393"\w*, \w la|strong="H3605"\w* caballería \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w ejército|strong="H2428"\w* del \w faraón|strong="H6547"\w* \w que|strong="H3808"\w* había entrado \w al|strong="H5704"\w* \w mar|strong="H3220"\w* \w para|strong="H5704"\w* perseguir \w a|strong="H3068"\w* \w los|strong="H3605"\w* israelitas. ¡\w No|strong="H3808"\w* \w quedó|strong="H7604"\w* \w ni|strong="H3808"\w* uno solo \w de|strong="H5704"\w* \w ellos|strong="H3605"\w* \w con|strong="H5704"\w* vida!  
\v 29 \w En|strong="H8432"\w* cambio, \w los|strong="H1121"\w* israelitas cruzaron \w el|strong="H1121"\w* \w mar|strong="H3220"\w* \w caminando|strong="H1980"\w* sobre \w tierra|strong="H3004"\w* seca, con las \w aguas|strong="H4325"\w* formando un \w muro|strong="H2346"\w* \w a|strong="H3068"\w* su \w derecha|strong="H3225"\w* y otro \w a|strong="H3068"\w* su \w izquierda|strong="H8040"\w*.  
\v 30 \w Así|strong="H1931"\w* \w fue|strong="H1931"\w* \w como|strong="H5921"\w* Yahvé \w salvó|strong="H3467"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w del|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w* \w en|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*; \w y|strong="H5921"\w* \w los|strong="H5921"\w* israelitas \w vieron|strong="H7200"\w* \w los|strong="H5921"\w* cadáveres \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w* tirados \w a|strong="H3068"\w* \w la|strong="H1931"\w* orilla \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 31 Al \w ver|strong="H7200"\w* \w el|strong="H6213"\w* tremendo \w poder|strong="H3027"\w* \w que|strong="H5971"\w* Yahvé \w había|strong="H6213"\w* usado \w contra|strong="H3478"\w* los \w egipcios|strong="H4714"\w*, \w el|strong="H6213"\w* \w pueblo|strong="H5971"\w* le \w tuvo|strong="H3372"\w* un profundo respeto \w a|strong="H3068"\w* Yahvé, y creyeron en \w él|strong="H6213"\w* y en su \w siervo|strong="H5650"\w* \w Moisés|strong="H4872"\w*.   
\c 15  
\p
\v 1 \w Entonces|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* \w los|strong="H1121"\w* israelitas le cantaron \w esta|strong="H2063"\w* \w canción|strong="H7892"\w* \w a|strong="H3068"\w* Yahvé:  
\q1 “Le \w cantaré|strong="H7891"\w* \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* ha tenido una victoria gloriosa.  
\q2 Ha arrojado al \w mar|strong="H3220"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w caballos|strong="H5483"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus jinetes.  
\v 2 Yahvé \w es|strong="H1961"\w* \w mi|strong="H1961"\w* fuerza \w y|strong="H5797"\w* \w mi|strong="H1961"\w* canción,  
\q2 él ha \w sido|strong="H1961"\w* \w mi|strong="H1961"\w* salvación.  
\q1 Él \w es|strong="H1961"\w* \w mi|strong="H1961"\w* Dios, \w y|strong="H5797"\w* yo \w lo|strong="H2088"\w* alabaré;  
\q2 \w es|strong="H1961"\w* el Dios de \w mi|strong="H1961"\w* padre, \w y|strong="H5797"\w* yo \w lo|strong="H2088"\w* exaltaré.  
\v 3 Yahvé es un guerrero invencible.  
\q2 ¡Yahvé es su \w nombre|strong="H8034"\w*!  
\v 4 Hundió en el \w mar|strong="H3220"\w* los \w carros|strong="H4818"\w* del \w faraón|strong="H6547"\w* y \w a|strong="H3068"\w* su \w ejército|strong="H2428"\w*.  
\q2 Sus mejores capitanes se ahogaron en el \w Mar|strong="H3220"\w* Rojo.  
\v 5 Las aguas profundas los \w cubrieron|strong="H3680"\w*;  
\q2 cayeron hasta el fondo \w como|strong="H3644"\w* si fueran piedras.  
\v 6 Tu mano \w derecha|strong="H3225"\w*, Yahvé, es grandiosa en \w poder|strong="H3581"\w*.  
\q2 Tu mano \w derecha|strong="H3225"\w*, Yahvé, hace pedazos al enemigo.  
\v 7 Con tu inmensa grandeza derribas \w a|strong="H3068"\w* los que te atacan.  
\q2 Desatas tu furia y los consumes como \w a|strong="H3068"\w* paja seca.  
\v 8 Con el \w soplo|strong="H7307"\w* \w de|strong="H4325"\w* tu aliento, se amontonaron las \w aguas|strong="H4325"\w*;  
\q2 las \w corrientes|strong="H5140"\w* se levantaron y formaron un muro;  
\q2 el fondo del \w mar|strong="H3220"\w* quedó al descubierto.  
\v 9 El enemigo pensó: ‘\w Los|strong="H7291"\w* \w perseguiré|strong="H7291"\w* y \w los|strong="H7291"\w* alcanzaré; les quitaré todo lo \w que|strong="H3027"\w* tienen.  
\q2 Cumpliré mis deseos con \w ellos|strong="H3027"\w*.  
\q2 \w Sacaré|strong="H7324"\w* \w mi|strong="H5315"\w* \w espada|strong="H2719"\w* y \w los|strong="H7291"\w* mataré con mis propias \w manos|strong="H3027"\w*’.  
\v 10 Pero \w soplaste|strong="H5398"\w* con tu \w viento|strong="H7307"\w* y el \w mar|strong="H3220"\w* los \w cubrió|strong="H3680"\w* por completo.  
\q2 Se hundieron como plomo en las \w aguas|strong="H4325"\w* violentas.  
\v 11 ¿\w Qué|strong="H4310"\w* \w dios|strong="H3068"\w* se compara \w a|strong="H3068"\w* ti, Yahvé?  
\q2 ¿\w Quién|strong="H4310"\w* \w como|strong="H3644"\w* \w tú|strong="H6213"\w*, grandioso y \w santo|strong="H6944"\w*,  
\q2 digno \w de|strong="H3372"\w* profundo respeto, \w hacedor|strong="H6213"\w* \w de|strong="H3372"\w* milagros?  
\v 12 \w Extendiste|strong="H5186"\w* tu mano \w derecha|strong="H3225"\w*,  
\q2 y la tierra se los tragó.  
\v 13 Con tu amor fiel has guiado \w a|strong="H3068"\w* \w este|strong="H2098"\w* \w pueblo|strong="H5971"\w* \w que|strong="H2098"\w* rescataste;  
\q2 con tu poder los llevas hacia tu \w santa|strong="H6944"\w* \w morada|strong="H5116"\w*.  
\v 14 Las naciones \w escucharon|strong="H8085"\w* y \w temblaron|strong="H7264"\w* \w de|strong="H5971"\w* miedo;  
\q2 \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5971"\w* \w Filistea|strong="H6429"\w* \w se|strong="H5971"\w* llenaron \w de|strong="H5971"\w* angustia.  
\v 15 \w Los|strong="H3427"\w* líderes de Edom se asustaron;  
\q2 \w los|strong="H3427"\w* hombres fuertes de \w Moab|strong="H4124"\w* se pusieron \w a|strong="H3068"\w* temblar.  
\q2 \w Todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de \w Canaán|strong="H3667"\w* perdieron \w el|strong="H3605"\w* valor.  
\v 16 \w El|strong="H5921"\w* \w terror|strong="H6343"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* pánico \w cayeron|strong="H5307"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*;  
\q2 \w por|strong="H5921"\w* \w el|strong="H5921"\w* poder \w de|strong="H5921"\w* tu \w brazo|strong="H2220"\w*, \w se|strong="H5921"\w* quedaron paralizados \w como|strong="H5921"\w* piedras,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H2098"\w* \w pasó|strong="H5674"\w* tu \w pueblo|strong="H5971"\w*, Yahvé,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H2098"\w* terminó \w de|strong="H5921"\w* \w pasar|strong="H5674"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w que|strong="H2098"\w* tú \w compraste|strong="H7069"\w*.  
\v 17 Tú \w los|strong="H3427"\w* traerás y \w los|strong="H3427"\w* \w plantarás|strong="H5193"\w* en \w el|strong="H3427"\w* \w monte|strong="H2022"\w* \w que|strong="H3027"\w* te pertenece,  
\q2 en \w el|strong="H3427"\w* lugar \w que|strong="H3027"\w* preparaste para vivir, Yahvé,  
\q2 en \w el|strong="H3427"\w* \w santuario|strong="H4720"\w*, \w Señor|strong="H3068"\w*, \w que|strong="H3027"\w* tus propias \w manos|strong="H3027"\w* construyeron.  
\v 18 ¡Yahvé \w reinará|strong="H4427"\w* \w por|strong="H5769"\w* \w siempre|strong="H5769"\w* y \w para|strong="H5703"\w* \w siempre|strong="H5769"\w*!”   
\p
\v 19 \w Cuando|strong="H3588"\w* \w los|strong="H1121"\w* \w caballos|strong="H5483"\w* \w del|strong="H5921"\w* \w faraón|strong="H6547"\w*, \w con|strong="H5921"\w* sus \w carros|strong="H7393"\w* \w de|strong="H5921"\w* guerra \w y|strong="H3588"\w* \w su|strong="H3588"\w* caballería, entraron \w al|strong="H5921"\w* \w mar|strong="H3220"\w*, Yahvé hizo \w que|strong="H3588"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w se|strong="H5921"\w* \w les|strong="H5921"\w* vinieran \w encima|strong="H5921"\w*; \w pero|strong="H3588"\w* \w los|strong="H1121"\w* israelitas cruzaron \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w caminando|strong="H1980"\w* \w sobre|strong="H5921"\w* \w tierra|strong="H3004"\w* seca.  
\v 20 Entonces \w la|strong="H3605"\w* \w profetisa|strong="H5031"\w* Miriam, \w que|strong="H3605"\w* era hermana de Aarón, \w tomó|strong="H3947"\w* una pandereta, y \w todas|strong="H3605"\w* las mujeres \w la|strong="H3605"\w* siguieron tocando panderetas y bailando.  
\v 21 \w Y|strong="H3068"\w* Miriam les cantaba:  
\q1 “Cántenle \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* ha tenido una victoria gloriosa.  
\q1 Ha arrojado al \w mar|strong="H3220"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w caballos|strong="H5483"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus jinetes”.   
\p
\v 22 \w Moisés|strong="H4872"\w* \w guio|strong="H3212"\w* \w a|strong="H3068"\w* los israelitas desde el \w Mar|strong="H3220"\w* Rojo hacia el \w desierto|strong="H4057"\w* \w de|strong="H4325"\w* \w Shur|strong="H7793"\w*. \w Caminaron|strong="H3212"\w* por el \w desierto|strong="H4057"\w* durante \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w sin|strong="H3808"\w* encontrar \w agua|strong="H4325"\w*.  
\v 23 \w Cuando|strong="H3588"\w* llegaron \w a|strong="H3068"\w* un lugar \w llamado|strong="H8034"\w* Mara, \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* tomar \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* ahí \w porque|strong="H3588"\w* era muy \w amarga|strong="H4751"\w*. (\w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w el|strong="H5921"\w* lugar \w se|strong="H5921"\w* \w llama|strong="H7121"\w* Mara, \w que|strong="H3588"\w* significa “\w amargo|strong="H4751"\w*”).  
\v 24 Entonces \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* empezó \w a|strong="H3068"\w* quejar \w con|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijeron: “¿\w Pues|strong="H4100"\w* \w qué|strong="H4100"\w* vamos \w a|strong="H3068"\w* tomar?”  
\v 25 Moisés le pidió ayuda \w a|strong="H3068"\w* Yahvé, y Yahvé le mostró un pedazo \w de|strong="H4325"\w* \w madera|strong="H6086"\w*; Moisés lo \w echó|strong="H7993"\w* al \w agua|strong="H4325"\w*, y el \w agua|strong="H4325"\w* se volvió dulce. \w Allí|strong="H8033"\w* en Mara, Yahvé les \w dio|strong="H7760"\w* leyes y normas, y \w allí|strong="H8033"\w* los \w puso|strong="H7760"\w* \w a|strong="H3068"\w* \w prueba|strong="H5254"\w*.  
\v 26 \w Les|strong="H5921"\w* dijo: “\w Si|strong="H3588"\w* ustedes \w escuchan|strong="H8085"\w* \w con|strong="H5921"\w* atención \w mi|strong="H5921"\w* \w voz|strong="H6963"\w*, \w y|strong="H3588"\w* \w hacen|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w me|strong="H5921"\w* agrada, \w y|strong="H3588"\w* \w si|strong="H3588"\w* \w obedecen|strong="H8085"\w* mis \w mandamientos|strong="H4687"\w* \w y|strong="H3588"\w* cumplen \w todas|strong="H3605"\w* mis leyes, \w no|strong="H3808"\w* \w les|strong="H5921"\w* mandaré \w ninguna|strong="H3605"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* enfermedades \w que|strong="H3588"\w* \w les|strong="H5921"\w* mandé \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w*; \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w sana|strong="H7495"\w*.”   
\p
\v 27 \w Después|strong="H5921"\w* llegaron \w a|strong="H3068"\w* Elim, un lugar \w donde|strong="H8033"\w* había \w doce|strong="H8147"\w* manantiales \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w y|strong="H5921"\w* \w setenta|strong="H7657"\w* \w palmeras|strong="H8558"\w*, \w y|strong="H5921"\w* acamparon \w allí|strong="H8033"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w agua|strong="H4325"\w*.   
\c 16  
\p
\v 1 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H2568"\w* \w los|strong="H1121"\w* israelitas \w salió|strong="H3318"\w* \w de|strong="H2568"\w* Elim y llegó al \w desierto|strong="H4057"\w* \w de|strong="H2568"\w* \w Sin|strong="H5512"\w*, \w que|strong="H3117"\w* está entre Elim y \w el|strong="H3605"\w* \w Sinaí|strong="H5514"\w*. Llegaron allí \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w quince|strong="H2568"\w* del \w segundo|strong="H8145"\w* \w mes|strong="H2320"\w*, \w después|strong="H8145"\w* \w de|strong="H2568"\w* haber \w salido|strong="H3318"\w* \w de|strong="H2568"\w* \w Egipto|strong="H4714"\w*.  
\v 2 Allí \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas empezó \w a|strong="H3068"\w* quejarse \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Aarón;  
\v 3 \w y|strong="H3588"\w* \w les|strong="H5921"\w* decían: “¡\w Ojalá|strong="H4310"\w* Yahvé \w nos|strong="H5921"\w* hubiera quitado \w la|strong="H5921"\w* vida \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*! Allá \w nos|strong="H5921"\w* \w sentábamos|strong="H3427"\w* \w a|strong="H3068"\w* comer \w carne|strong="H1320"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* ollas \w y|strong="H3588"\w* comíamos \w pan|strong="H3899"\w* \w hasta|strong="H5921"\w* llenarnos. ¡\w Pero|strong="H3588"\w* ustedes \w nos|strong="H5921"\w* trajeron \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w desierto|strong="H4057"\w* \w para|strong="H5921"\w* matarnos \w de|strong="H5921"\w* \w hambre|strong="H7458"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w*!”   
\p
\v 4 \w Entonces|strong="H3117"\w* Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Mira|strong="H2005"\w*, voy \w a|strong="H3068"\w* hacer \w que|strong="H4480"\w* les llueva \w pan|strong="H3899"\w* \w del|strong="H4480"\w* \w cielo|strong="H8064"\w*. La \w gente|strong="H5971"\w* \w saldrá|strong="H3318"\w* todos los \w días|strong="H3117"\w* \w a|strong="H3068"\w* recoger solo \w lo|strong="H1697"\w* necesario \w para|strong="H4616"\w* ese \w día|strong="H3117"\w*. \w De|strong="H4480"\w* esta \w manera|strong="H1697"\w* los pondré \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w para|strong="H4616"\w* ver \w si|strong="H2005"\w* obedecen mis instrucciones \w o|strong="H3068"\w* \w no|strong="H3808"\w*.  
\v 5 \w El|strong="H5921"\w* \w sexto|strong="H8345"\w* \w día|strong="H3117"\w*, \w cuando|strong="H3117"\w* preparen \w lo|strong="H5921"\w* \w que|strong="H5921"\w* lleven, recogerán \w el|strong="H5921"\w* doble \w de|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w recogen|strong="H3950"\w* \w los|strong="H5921"\w* demás \w días|strong="H3117"\w*.”   
\p
\v 6 \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* Aarón les dijeron \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas: “Hoy \w en|strong="H3588"\w* \w la|strong="H3605"\w* \w tarde|strong="H6153"\w* \w se|strong="H3045"\w* darán cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* fue Yahvé \w quien|strong="H3605"\w* \w los|strong="H1121"\w* \w sacó|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*.  
\v 7 \w Y|strong="H3068"\w* \w mañana|strong="H1242"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* \w verán|strong="H7200"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé, \w porque|strong="H3588"\w* \w él|strong="H5921"\w* ya \w escuchó|strong="H8085"\w* \w cómo|strong="H4100"\w* \w se|strong="H5921"\w* andan quejando \w de|strong="H5921"\w* \w él|strong="H5921"\w*. \w Al|strong="H5921"\w* fin \w y|strong="H3588"\w* \w al|strong="H5921"\w* cabo, ¿quiénes somos \w nosotros|strong="H5168"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* anden quejando \w de|strong="H5921"\w* \w nosotros|strong="H5168"\w*?”  
\v 8 \w Moisés|strong="H4872"\w* también \w les|strong="H5921"\w* dijo: “Yahvé \w les|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w carne|strong="H1320"\w* \w para|strong="H5921"\w* comer \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w*, \w y|strong="H3588"\w* \w pan|strong="H3899"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* llenen, \w porque|strong="H3588"\w* ya \w escuchó|strong="H8085"\w* \w las|strong="H5921"\w* quejas \w que|strong="H3588"\w* tienen \w contra|strong="H5921"\w* \w él|strong="H5921"\w*. ¿Acaso \w nosotros|strong="H5168"\w* somos alguien? ¡Sus quejas \w no|strong="H3808"\w* \w son|strong="H3588"\w* \w contra|strong="H5921"\w* \w nosotros|strong="H5168"\w*, \w son|strong="H3588"\w* \w contra|strong="H5921"\w* Yahvé!”  
\v 9 Luego \w Moisés|strong="H4872"\w* le dijo \w a|strong="H3068"\w* Aarón: “Diles \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H3588"\w* se acerquen \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w presencia|strong="H6440"\w* \w de|strong="H3588"\w* Yahvé, \w porque|strong="H3588"\w* \w él|strong="H3588"\w* ya \w escuchó|strong="H8085"\w* sus quejas”.  
\v 10 \w Y|strong="H3068"\w* \w mientras|strong="H3605"\w* Aarón le \w hablaba|strong="H1696"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* comunidad \w de|strong="H1121"\w* \w los|strong="H1121"\w* israelitas, \w ellos|strong="H3605"\w* voltearon hacia \w el|strong="H3605"\w* \w desierto|strong="H4057"\w*, ¡\w y|strong="H3519"\w* \w vieron|strong="H7200"\w* \w que|strong="H1121"\w* \w la|strong="H3605"\w* \w gloria|strong="H3519"\w* \w de|strong="H1121"\w* Yahvé \w apareció|strong="H7200"\w* en \w la|strong="H3605"\w* \w nube|strong="H6051"\w*!  
\v 11 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 12 “He escuchado las quejas \w de|strong="H3588"\w* \w los|strong="H1121"\w* israelitas. \w Diles|strong="H1696"\w* esto: ‘Al atardecer comerán \w carne|strong="H1320"\w*, \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w mañana|strong="H1242"\w* \w se|strong="H3045"\w* llenarán \w de|strong="H3588"\w* \w pan|strong="H3899"\w*. \w Así|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*’”.   
\p
\v 13 Esa misma \w tarde|strong="H6153"\w* llegaron muchísimas \w codornices|strong="H7958"\w* \w que|strong="H1961"\w* \w cubrieron|strong="H3680"\w* \w todo|strong="H5439"\w* \w el|strong="H4264"\w* \w campamento|strong="H4264"\w*, y \w a|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente \w había|strong="H1961"\w* una capa de \w rocío|strong="H2919"\w* \w alrededor|strong="H5439"\w* de las carpas.  
\v 14 Cuando \w el|strong="H5921"\w* \w rocío|strong="H2919"\w* \w se|strong="H5921"\w* evaporó, vieron \w que|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* superficie \w del|strong="H5921"\w* \w desierto|strong="H4057"\w* había quedado algo fino \w y|strong="H5921"\w* \w con|strong="H5921"\w* forma \w de|strong="H5921"\w* escamas, tan fino \w como|strong="H5921"\w* \w la|strong="H5921"\w* escarcha \w en|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 15 Al verlo, \w los|strong="H1121"\w* israelitas \w se|strong="H3045"\w* preguntaban unos \w a|strong="H3068"\w* otros: “¿\w Y|strong="H3068"\w* \w esto|strong="H1931"\w* \w qué|strong="H3588"\w* \w es|strong="H1931"\w*?” \w Porque|strong="H3588"\w* \w no|strong="H3808"\w* \w sabían|strong="H3045"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w era|strong="H1931"\w*. \w Moisés|strong="H4872"\w* les explicó: “\w Es|strong="H1931"\w* \w el|strong="H1931"\w* \w pan|strong="H3899"\w* \w que|strong="H3588"\w* Yahvé les \w ha|strong="H3808"\w* \w dado|strong="H5414"\w* \w para|strong="H3588"\w* comer.  
\v 16 \w Y|strong="H3068"\w* \w esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w orden|strong="H6680"\w* \w de|strong="H4480"\w* Yahvé: ‘\w Cada|strong="H1697"\w* uno debe recoger \w lo|strong="H1697"\w* \w que|strong="H4480"\w* necesite \w para|strong="H4480"\w* \w comer|strong="H5315"\w*. Recojan unos dos kilos \w por|strong="H4480"\w* \w persona|strong="H5315"\w*, \w según|strong="H6310"\w* la cantidad \w de|strong="H4480"\w* gente \w que|strong="H4480"\w* viva \w en|strong="H4480"\w* \w cada|strong="H1697"\w* carpa’”.  
\v 17 \w Los|strong="H1121"\w* israelitas \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w así|strong="H3651"\w*. Unos \w recogieron|strong="H3950"\w* \w más|strong="H7235"\w* y otros menos.  
\v 18 Pero al medirlo, \w ni|strong="H3808"\w* le sobró al \w que|strong="H3808"\w* \w recogió|strong="H3950"\w* \w mucho|strong="H7235"\w*, \w ni|strong="H3808"\w* le faltó al \w que|strong="H3808"\w* \w recogió|strong="H3950"\w* \w poco|strong="H4591"\w*. Cada uno había recogido exactamente \w lo|strong="H3808"\w* \w que|strong="H3808"\w* necesitaba para comer.  
\v 19 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* les advirtió: “Nadie debe guardar nada \w para|strong="H5704"\w* el día siguiente”.  
\v 20 Pero \w algunos|strong="H3498"\w* \w no|strong="H3808"\w* \w le|strong="H5921"\w* hicieron caso \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* guardaron un poco \w para|strong="H5704"\w* \w el|strong="H5921"\w* otro día; pero \w la|strong="H5921"\w* comida \w se|strong="H5921"\w* llenó \w de|strong="H4480"\w* \w gusanos|strong="H8438"\w* \w y|strong="H5921"\w* empezó \w a|strong="H3068"\w* apestar. \w Moisés|strong="H4872"\w* \w se|strong="H5921"\w* enojó mucho \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 21 Así \w que|strong="H6310"\w* todas las mañanas cada uno recogía lo \w que|strong="H6310"\w* iba \w a|strong="H3068"\w* comer, porque en cuanto el \w sol|strong="H8121"\w* \w calentaba|strong="H2552"\w*, aquello se derretía.  
\v 22 \w El|strong="H3605"\w* \w sexto|strong="H8345"\w* \w día|strong="H3117"\w* \w recogieron|strong="H3950"\w* \w el|strong="H3605"\w* doble de \w comida|strong="H3899"\w*, \w o|strong="H3068"\w* \w sea|strong="H1961"\w*, unos cuatro kilos \w para|strong="H1961"\w* \w cada|strong="H3605"\w* persona. \w Entonces|strong="H3117"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes de \w la|strong="H3605"\w* comunidad \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* avisarle \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*.  
\v 23 Moisés les \w dijo|strong="H1696"\w*: “\w Esto|strong="H1931"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* Yahvé ordenó: ‘\w Mañana|strong="H4279"\w* \w es|strong="H1931"\w* un día \w de|strong="H5704"\w* descanso, un \w sábado|strong="H7676"\w* \w consagrado|strong="H6944"\w* \w a|strong="H3068"\w* Yahvé. \w Así|strong="H1931"\w* \w que|strong="H1931"\w* cocinen hoy \w lo|strong="H1931"\w* \w que|strong="H1931"\w* tengan \w que|strong="H1931"\w* cocinar, \w y|strong="H5704"\w* hiervan \w lo|strong="H1931"\w* \w que|strong="H1931"\w* tengan \w que|strong="H1931"\w* hervir. \w Todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* sobre guárdenlo \w para|strong="H5704"\w* \w mañana|strong="H4279"\w*’”.  
\v 24 Ellos guardaron las sobras \w para|strong="H5704"\w* el día siguiente, tal \w como|strong="H1961"\w* \w Moisés|strong="H4872"\w* \w les|strong="H6680"\w* dijo, \w y|strong="H5704"\w* la comida \w no|strong="H3808"\w* \w se|strong="H1961"\w* echó \w a|strong="H3068"\w* perder \w ni|strong="H3808"\w* \w se|strong="H1961"\w* agusanó.  
\v 25 \w Moisés|strong="H4872"\w* les dijo: “Cómanse eso \w hoy|strong="H3117"\w*, \w porque|strong="H3588"\w* \w hoy|strong="H3117"\w* \w es|strong="H3588"\w* \w sábado|strong="H7676"\w*, \w día|strong="H3117"\w* \w de|strong="H3588"\w* descanso \w en|strong="H3588"\w* honor \w a|strong="H3068"\w* Yahvé. \w Hoy|strong="H3117"\w* \w no|strong="H3808"\w* van \w a|strong="H3068"\w* encontrar \w nada|strong="H3808"\w* allá afuera.  
\v 26 \w Tienen|strong="H1961"\w* \w seis|strong="H8337"\w* \w días|strong="H3117"\w* \w a|strong="H3068"\w* la semana \w para|strong="H1961"\w* recogerlo, pero el \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w es|strong="H1961"\w* de descanso; ese \w día|strong="H3117"\w* \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* \w nada|strong="H3808"\w*”.  
\v 27 \w Aun|strong="H3808"\w* así, el \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* algunos \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* recoger, pero \w no|strong="H3808"\w* encontraron \w nada|strong="H3808"\w*.  
\v 28 Entonces Yahvé le reclamó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* se van \w a|strong="H3068"\w* negar \w a|strong="H3068"\w* obedecer mis \w mandamientos|strong="H4687"\w* \w y|strong="H5704"\w* mis instrucciones?  
\v 29 Entiendan \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w les|strong="H5921"\w* \w di|strong="H5414"\w* \w el|strong="H1931"\w* \w sábado|strong="H7676"\w* \w como|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* descanso; \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w el|strong="H1931"\w* \w sexto|strong="H8345"\w* \w día|strong="H3117"\w* \w les|strong="H5921"\w* \w doy|strong="H5414"\w* \w comida|strong="H3899"\w* suficiente \w para|strong="H5921"\w* \w dos|strong="H3117"\w* \w días|strong="H3117"\w*. \w El|strong="H1931"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* todos deben quedarse \w donde|strong="H5921"\w* \w están|strong="H3427"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w salir|strong="H3318"\w* \w a|strong="H3068"\w* buscar nada”.  
\v 30 Así \w que|strong="H5971"\w* el \w pueblo|strong="H5971"\w* descansó el \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*.   
\p
\v 31 \w Los|strong="H1931"\w* israelitas \w llamaron|strong="H7121"\w* “\w maná|strong="H4478"\w*” \w a|strong="H3068"\w* \w ese|strong="H1931"\w* alimento. \w Era|strong="H1931"\w* \w blanco|strong="H3836"\w* \w como|strong="H1931"\w* \w la|strong="H1931"\w* semilla de cilantro y sabía \w a|strong="H3068"\w* galletas con \w miel|strong="H1706"\w*.  
\v 32 \w Luego|strong="H3318"\w* \w Moisés|strong="H4872"\w* dijo: “\w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H4480"\w* Yahvé ha \w ordenado|strong="H6680"\w*: ‘Guarden unos dos kilos \w de|strong="H4480"\w* maná \w para|strong="H4616"\w* las futuras \w generaciones|strong="H1755"\w*, \w para|strong="H4616"\w* \w que|strong="H4480"\w* \w vean|strong="H7200"\w* el \w pan|strong="H3899"\w* \w con|strong="H4480"\w* el \w que|strong="H4480"\w* los alimenté \w en|strong="H4480"\w* el \w desierto|strong="H4057"\w* cuando los \w saqué|strong="H3318"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w*’”.  
\v 33 \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* le dijo \w a|strong="H3068"\w* Aarón: “Consigue un frasco, \w pon|strong="H5414"\w* adentro unos \w dos|strong="H6440"\w* kilos \w de|strong="H6440"\w* \w maná|strong="H4478"\w* y ponlo en la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w para|strong="H5414"\w* \w que|strong="H4478"\w* se conserve \w para|strong="H5414"\w* las futuras \w generaciones|strong="H1755"\w*.”  
\v 34 Aarón hizo lo que Yahvé le \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, y \w puso|strong="H3240"\w* el frasco con el maná frente al arca del pacto para que se conservara allí.  
\v 35 \w Los|strong="H3427"\w* israelitas comieron \w maná|strong="H4478"\w* durante cuarenta \w años|strong="H8141"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* llegaron \w a|strong="H3068"\w* una tierra donde había gente; comieron \w maná|strong="H4478"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* llegaron \w a|strong="H3068"\w* la frontera \w de|strong="H5704"\w* \w Canaán|strong="H3667"\w*.  
\v 36 (\w La|strong="H1931"\w* medida \w que|strong="H1931"\w* usaban para recoger \w el|strong="H1931"\w* maná \w era|strong="H1931"\w* de unos dos litros). \f + \fr 16:36 \ft Literalmente: Un gomer es la décima parte de un efa.\f*   
\c 17  
\p
\v 1 \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* comunidad \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas \w partió|strong="H5265"\w* \w del|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* \w Sin|strong="H5512"\w*, viajando \w por|strong="H5921"\w* etapas \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w mandato|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* acamparon \w en|strong="H5921"\w* Refidim; pero \w no|strong="H5921"\w* había \w agua|strong="H4325"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* bebiera.  
\v 2 \w Por|strong="H4100"\w* eso \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w le|strong="H5973"\w* reclamó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w le|strong="H5973"\w* exigió: “\w Danos|strong="H5414"\w* \w agua|strong="H4325"\w* \w para|strong="H5414"\w* \w beber|strong="H8354"\w*”.  
\p \w Moisés|strong="H4872"\w* \w les|strong="H5973"\w* contestó: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* pelean \w conmigo|strong="H5973"\w*? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* ponen \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w a|strong="H3068"\w* Yahvé?”   
\p
\v 3 Pero \w la|strong="H5921"\w* \w gente|strong="H5971"\w* estaba \w muerta|strong="H4191"\w* \w de|strong="H5921"\w* \w sed|strong="H6772"\w*; \w por|strong="H5921"\w* eso murmuraron \w contra|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w y|strong="H5921"\w* dijeron: “¿\w Para|strong="H5921"\w* \w qué|strong="H4100"\w* \w nos|strong="H5921"\w* \w sacaste|strong="H5927"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*? ¿Solo \w para|strong="H5921"\w* matarnos \w de|strong="H5921"\w* \w sed|strong="H6772"\w* \w a|strong="H3068"\w* \w nosotros|strong="H5921"\w*, \w a|strong="H3068"\w* nuestros \w hijos|strong="H1121"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* nuestro \w ganado|strong="H4735"\w*?”   
\p
\v 4 \w Moisés|strong="H4872"\w* le suplicó \w a|strong="H3068"\w* Yahvé: “¿\w Qué|strong="H4100"\w* \w hago|strong="H6213"\w* con \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*? ¡Falta \w poco|strong="H4592"\w* \w para|strong="H5971"\w* \w que|strong="H4100"\w* me agarren \w a|strong="H3068"\w* pedradas!”   
\p
\v 5 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Pasa|strong="H5674"\w* al frente del \w pueblo|strong="H5971"\w*, lleva \w contigo|strong="H5971"\w* \w a|strong="H3068"\w* algunos \w de|strong="H6440"\w* los líderes \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w toma|strong="H3947"\w* la \w vara|strong="H4294"\w* con la \w que|strong="H5971"\w* golpeaste \w el|strong="H2975"\w* \w río|strong="H2975"\w* Nilo, y vete \w para|strong="H5971"\w* \w allá|strong="H6440"\w*.  
\v 6 \w Yo|strong="H4480"\w* \w estaré|strong="H5975"\w* esperándote \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w roca|strong="H6697"\w* \w que|strong="H4480"\w* \w está|strong="H5975"\w* \w en|strong="H5921"\w* \w Horeb|strong="H2722"\w*. Golpearás \w la|strong="H5921"\w* \w roca|strong="H6697"\w*, \w y|strong="H5921"\w* \w saldrá|strong="H3318"\w* \w agua|strong="H4325"\w* \w de|strong="H4480"\w* \w ella|strong="H8033"\w* \w para|strong="H5921"\w* \w que|strong="H4480"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* beba”. \w Moisés|strong="H4872"\w* \w lo|strong="H5921"\w* \w hizo|strong="H6213"\w* \w así|strong="H3651"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* vista \w de|strong="H4480"\w* \w los|strong="H5921"\w* líderes \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*.  
\v 7 \w Y|strong="H3068"\w* Moisés \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* aquel \w lugar|strong="H4725"\w* Masah,\f + \fr 17:7 \ft “Masah” significa poner a prueba.\f* \w y|strong="H5921"\w* también Meribá,\f + \fr 17:7 \ft “Meribá” significa discusión o pleito.\f* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w pleito|strong="H7379"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas, \w y|strong="H5921"\w* \w porque|strong="H5921"\w* pusieron \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w a|strong="H3068"\w* Yahvé \w al|strong="H5921"\w* \w decir|strong="H7121"\w*: “¿\w Está|strong="H3426"\w* Yahvé \w entre|strong="H5921"\w* \w nosotros|strong="H5921"\w*, \w o|strong="H3068"\w* \w no|strong="H5921"\w*?”   
\p
\v 8 \w En|strong="H5973"\w* ese tiempo, \w los|strong="H5973"\w* amalecitas vinieron y atacaron \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w en|strong="H5973"\w* Refidim.  
\v 9 \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “Escoge \w a|strong="H3068"\w* algunos hombres \w y|strong="H5921"\w* \w sal|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* \w los|strong="H5921"\w* amalecitas. \w Mañana|strong="H4279"\w* yo \w estaré|strong="H5324"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* cima \w del|strong="H5921"\w* cerro \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w vara|strong="H4294"\w* \w de|strong="H5921"\w* Dios \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w*”.  
\v 10 \w Josué|strong="H3091"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que \w Moisés|strong="H4872"\w* le ordenó y \w salió|strong="H5927"\w* \w a|strong="H3068"\w* pelear contra los amalecitas, mientras que \w Moisés|strong="H4872"\w*, Aarón y \w Hur|strong="H2354"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* la cima del cerro.  
\v 11 \w Y|strong="H3068"\w* resulta \w que|strong="H1961"\w*, mientras \w Moisés|strong="H4872"\w* mantenía \w los|strong="H1961"\w* brazos en \w alto|strong="H7311"\w*, \w los|strong="H1961"\w* israelitas ganaban la batalla; pero \w cuando|strong="H1961"\w* \w los|strong="H1961"\w* bajaba, ganaban \w los|strong="H1961"\w* amalecitas.  
\v 12 \w Como|strong="H1961"\w* \w los|strong="H3427"\w* brazos \w de|strong="H5921"\w* \w Moisés|strong="H4872"\w* \w se|strong="H1961"\w* cansaron, Aarón \w y|strong="H5921"\w* \w Hur|strong="H2354"\w* \w le|strong="H5921"\w* consiguieron una piedra \w para|strong="H5704"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* sentara. \w Luego|strong="H2088"\w*, uno \w de|strong="H5921"\w* cada \w lado|strong="H3027"\w*, \w le|strong="H5921"\w* sostuvieron \w los|strong="H3427"\w* brazos \w en|strong="H5921"\w* alto, \w y|strong="H5921"\w* \w así|strong="H2088"\w* \w se|strong="H1961"\w* mantuvieron firmes \w hasta|strong="H5704"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* \w puso|strong="H7760"\w* \w el|strong="H5921"\w* \w sol|strong="H8121"\w*.  
\v 13 \w De|strong="H5971"\w* esta manera, \w Josué|strong="H3091"\w* derrotó \w a|strong="H3068"\w* los amalecitas \w a|strong="H3068"\w* filo \w de|strong="H5971"\w* \w espada|strong="H2719"\w*.  
\v 14 \w Entonces|strong="H3588"\w* Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Escribe|strong="H3789"\w* \w esto|strong="H2063"\w* \w en|strong="H3588"\w* un \w libro|strong="H5612"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* quede \w como|strong="H3588"\w* un \w recuerdo|strong="H2146"\w*, \w y|strong="H3588"\w* léeselo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: Voy \w a|strong="H3068"\w* borrar \w por|strong="H3588"\w* completo \w el|strong="H3588"\w* \w recuerdo|strong="H2146"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* amalecitas \w de|strong="H3588"\w* \w la|strong="H3588"\w* faz \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra.”  
\v 15 \w Moisés|strong="H4872"\w* construyó un \w altar|strong="H4196"\w* y lo \w llamó|strong="H7121"\w* “Yahvé es mi bandera”.\f + \fr 17:15 \ft En hebreo, Yahvé Nissi.\f*  
\v 16 \w Y|strong="H3068"\w* exclamó: “¡Levantemos \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* trono \w de|strong="H5921"\w* Yahvé! Yahvé estará \w en|strong="H5921"\w* \w guerra|strong="H4421"\w* \w contra|strong="H5921"\w* \w los|strong="H5921"\w* amalecitas \w de|strong="H5921"\w* \w generación|strong="H1755"\w* \w en|strong="H5921"\w* \w generación|strong="H1755"\w*.”   
\c 18  
\p
\v 1 Jetro, \w el|strong="H3588"\w* \w sacerdote|strong="H3548"\w* \w de|strong="H3588"\w* \w Madián|strong="H4080"\w* \w y|strong="H3588"\w* \w suegro|strong="H2859"\w* \w de|strong="H3588"\w* \w Moisés|strong="H4872"\w*, \w se|strong="H5971"\w* enteró \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w Dios|strong="H3068"\w* \w había|strong="H3588"\w* \w hecho|strong="H6213"\w* \w por|strong="H3588"\w* \w Moisés|strong="H4872"\w* \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w cómo|strong="H3588"\w* Yahvé \w los|strong="H3605"\w* \w había|strong="H3588"\w* \w sacado|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*.  
\v 2 Entonces Jetro \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* Séfora, la esposa de \w Moisés|strong="H4872"\w* (\w a|strong="H3068"\w* quien \w Moisés|strong="H4872"\w* había enviado de regreso \w a|strong="H3068"\w* casa de su padre),  
\v 3 junto \w con|strong="H3588"\w* sus \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w*. Uno \w de|strong="H3588"\w* ellos \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Gersón,\f + \fr 18:3 \ft “Gersón” (Gershom) suena como la frase hebrea que significa “fui un extranjero allí”.\f* \w porque|strong="H3588"\w* Moisés \w había|strong="H1961"\w* dicho: “\w Fui|strong="H1961"\w* un \w extranjero|strong="H1616"\w* \w en|strong="H3588"\w* tierra \w extraña|strong="H5237"\w*”.  
\v 4 \w El|strong="H3588"\w* otro hijo se \w llamaba|strong="H8034"\w* Eliezer,\f + \fr 18:4 \ft “Eliezer” significa “Dios es mi ayudador”.\f* \w porque|strong="H3588"\w* Moisés \w había|strong="H3588"\w* dicho: “\w El|strong="H3588"\w* Dios \w de|strong="H3588"\w* mi padre \w me|strong="H3588"\w* ayudó \w y|strong="H3588"\w* \w me|strong="H3588"\w* salvó \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w* del \w faraón|strong="H6547"\w*”.  
\v 5 Jetro, \w el|strong="H1931"\w* \w suegro|strong="H2859"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*, llegó al \w desierto|strong="H4057"\w* con \w la|strong="H1931"\w* esposa y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*, al lugar \w donde|strong="H8033"\w* estaban acampando junto al \w monte|strong="H2022"\w* \w de|strong="H1121"\w* Dios.  
\v 6 \w Y|strong="H3068"\w* \w le|strong="H5973"\w* mandó avisar: “Yo, tu \w suegro|strong="H2859"\w* Jetro, voy \w a|strong="H3068"\w* visitarte; vengo \w con|strong="H5973"\w* tu esposa y \w con|strong="H5973"\w* tus \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w*”.   
\p
\v 7 \w Moisés|strong="H4872"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibir \w a|strong="H3068"\w* su \w suegro|strong="H2859"\w*, se inclinó ante él y lo \w besó|strong="H5401"\w*. Se \w preguntaron|strong="H7592"\w* cómo estaban de salud y entraron \w en|strong="H3318"\w* la carpa.  
\v 8 \w Moisés|strong="H4872"\w* \w le|strong="H5921"\w* \w contó|strong="H5608"\w* \w a|strong="H3068"\w* su \w suegro|strong="H2859"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* Yahvé \w les|strong="H5921"\w* \w había|strong="H4672"\w* \w hecho|strong="H6213"\w* \w al|strong="H5921"\w* \w faraón|strong="H6547"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w* \w a|strong="H3068"\w* favor \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w todas|strong="H3605"\w* \w las|strong="H5921"\w* dificultades \w que|strong="H5921"\w* habían pasado \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w*, \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* Yahvé \w los|strong="H5921"\w* \w había|strong="H4672"\w* salvado.  
\v 9 Jetro \w se|strong="H5921"\w* alegró mucho \w por|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* cosas \w buenas|strong="H2896"\w* \w que|strong="H5921"\w* Yahvé \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w por|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w al|strong="H5921"\w* rescatarlos \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w*.  
\v 10 \w Y|strong="H3068"\w* exclamó Jetro: “¡Alabado sea Yahvé, \w que|strong="H5971"\w* los rescató \w a|strong="H3068"\w* ustedes del \w poder|strong="H3027"\w* \w de|strong="H8478"\w* los \w egipcios|strong="H4714"\w* y del \w faraón|strong="H6547"\w*! ¡Él liberó \w al|strong="H8478"\w* \w pueblo|strong="H5971"\w* del control \w de|strong="H8478"\w* \w Egipto|strong="H4714"\w*!  
\v 11 \w Ahora|strong="H6258"\w* estoy seguro \w de|strong="H5921"\w* \w que|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* \w más|strong="H3588"\w* \w grande|strong="H1419"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* demás dioses, \w porque|strong="H3588"\w* \w él|strong="H5921"\w* aplastó \w a|strong="H3068"\w* \w los|strong="H5921"\w* egipcios \w cuando|strong="H3588"\w* \w estos|strong="H3605"\w* trataron \w a|strong="H3068"\w* Israel \w con|strong="H5921"\w* tanta arrogancia.”  
\v 12 Luego Jetro ofreció un \w holocausto|strong="H5930"\w* y otros \w sacrificios|strong="H2077"\w* \w a|strong="H3068"\w* Dios. Aarón y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* fueron \w a|strong="H3068"\w* compartir una \w comida|strong="H3899"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w suegro|strong="H2859"\w* \w de|strong="H6440"\w* \w Moisés|strong="H4872"\w* \w en|strong="H5973"\w* \w la|strong="H3605"\w* \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Dios.   
\p
\v 13 \w Al|strong="H5921"\w* día \w siguiente|strong="H4283"\w*, \w Moisés|strong="H4872"\w* \w se|strong="H1961"\w* sentó \w a|strong="H3068"\w* resolver \w los|strong="H3427"\w* problemas \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w estuvo|strong="H1961"\w* \w de|strong="H4480"\w* \w pie|strong="H5975"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5921"\w* \w desde|strong="H4480"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* noche.  
\v 14 \w Cuando|strong="H4100"\w* \w su|strong="H1931"\w* \w suegro|strong="H2859"\w* \w vio|strong="H7200"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* trabajo \w que|strong="H4100"\w* \w Moisés|strong="H4872"\w* \w tenía|strong="H1931"\w* \w con|strong="H5921"\w* \w la|strong="H1931"\w* \w gente|strong="H5971"\w*, \w le|strong="H1931"\w* preguntó: “¿\w Qué|strong="H4100"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H4100"\w* \w estás|strong="H2088"\w* \w haciendo|strong="H6213"\w* \w con|strong="H5921"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w te|strong="H5921"\w* sientas \w tú|strong="H6213"\w* \w solo|strong="H1931"\w* \w a|strong="H3068"\w* atenderlos, \w mientras|strong="H3605"\w* \w todos|strong="H3605"\w* \w se|strong="H1931"\w* quedan \w de|strong="H4480"\w* pie esperando \w desde|strong="H4480"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w* \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* noche?”   
\p
\v 15 \w Moisés|strong="H4872"\w* le contestó: “\w Es|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w* viene \w a|strong="H3068"\w* mí \w para|strong="H3588"\w* conocer \w la|strong="H3588"\w* voluntad \w de|strong="H3588"\w* Dios.  
\v 16 \w Cuando|strong="H3588"\w* \w tienen|strong="H1961"\w* algún pleito, \w me|strong="H3588"\w* \w lo|strong="H1697"\w* traen \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* decida quién \w tiene|strong="H1961"\w* \w la|strong="H3588"\w* razón, \w y|strong="H3588"\w* \w de|strong="H3588"\w* paso les enseño \w los|strong="H1961"\w* \w mandamientos|strong="H2706"\w* \w y|strong="H3588"\w* las \w leyes|strong="H8451"\w* \w de|strong="H3588"\w* Dios.”  
\v 17 \w El|strong="H6213"\w* \w suegro|strong="H2859"\w* le dijo: “\w Lo|strong="H1697"\w* \w que|strong="H3808"\w* \w estás|strong="H6213"\w* \w haciendo|strong="H6213"\w* \w no|strong="H3808"\w* está \w bien|strong="H2896"\w*.  
\v 18 \w Te|strong="H4480"\w* vas \w a|strong="H3068"\w* agotar \w tú|strong="H6213"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w se|strong="H4480"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* agotar \w la|strong="H1571"\w* \w gente|strong="H5971"\w*. \w Este|strong="H2088"\w* trabajo \w es|strong="H2088"\w* demasiado \w pesado|strong="H3515"\w* \w para|strong="H3588"\w* \w ti|strong="H5973"\w*; \w no|strong="H3808"\w* \w puedes|strong="H3201"\w* \w hacerlo|strong="H3201"\w* \w tú|strong="H6213"\w* solo.  
\v 19 Hazme caso, \w te|strong="H5973"\w* voy \w a|strong="H3068"\w* dar un buen \w consejo|strong="H3289"\w*, y \w que|strong="H6258"\w* Dios \w te|strong="H5973"\w* ayude. Tú debes ser \w el|strong="H5973"\w* representante \w del|strong="H5973"\w* \w pueblo|strong="H5971"\w* ante Dios y presentarle \w a|strong="H3068"\w* \w él|strong="H5973"\w* \w los|strong="H5973"\w* problemas.  
\v 20 Enséñales \w a|strong="H3068"\w* ellos los \w mandamientos|strong="H2706"\w* y las \w leyes|strong="H8451"\w*, \w e|strong="H3068"\w* indícales cómo deben portarse y \w qué|strong="H3045"\w* es \w lo|strong="H6213"\w* \w que|strong="H3045"\w* deben \w hacer|strong="H6213"\w*.  
\v 21 Pero \w al|strong="H5921"\w* \w mismo|strong="H3605"\w* tiempo, escoge \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w a|strong="H3068"\w* hombres capaces \w y|strong="H5921"\w* \w que|strong="H5921"\w* respeten \w a|strong="H3068"\w* Dios, hombres honestos \w que|strong="H5921"\w* \w no|strong="H5921"\w* \w se|strong="H5921"\w* dejen sobornar. Nómbralos líderes \w de|strong="H5921"\w* grupos \w de|strong="H5921"\w* \w mil|strong="H3967"\w*, \w de|strong="H5921"\w* \w cien|strong="H3967"\w*, \w de|strong="H5921"\w* \w cincuenta|strong="H2572"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w diez|strong="H6235"\w* personas.  
\v 22 Deja \w que|strong="H5921"\w* \w ellos|strong="H1992"\w* \w se|strong="H1961"\w* encarguen \w de|strong="H5921"\w* resolver \w los|strong="H1992"\w* problemas diarios \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*. \w Los|strong="H1992"\w* casos \w más|strong="H5921"\w* difíciles \w te|strong="H5921"\w* \w los|strong="H1992"\w* pasarán \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, pero \w ellos|strong="H1992"\w* resolverán \w los|strong="H1992"\w* problemas \w menores|strong="H6996"\w*. \w Así|strong="H1992"\w* \w te|strong="H5921"\w* quitarás un peso \w de|strong="H5921"\w* \w encima|strong="H5921"\w* \w y|strong="H5921"\w* \w ellos|strong="H1992"\w* compartirán \w la|strong="H5921"\w* carga \w contigo|strong="H5921"\w*.  
\v 23 \w Si|strong="H1571"\w* \w haces|strong="H6213"\w* \w esto|strong="H2088"\w*, \w y|strong="H1571"\w* \w si|strong="H1571"\w* Dios \w así|strong="H1571"\w* \w te|strong="H5921"\w* \w lo|strong="H1697"\w* \w ordena|strong="H6680"\w*, vas \w a|strong="H3068"\w* poder aguantar \w el|strong="H5921"\w* ritmo \w de|strong="H5921"\w* trabajo, \w y|strong="H1571"\w* \w toda|strong="H3605"\w* \w esta|strong="H2088"\w* \w gente|strong="H5971"\w* \w se|strong="H5921"\w* irá \w a|strong="H3068"\w* su casa tranquila.”   
\p
\v 24 \w Moisés|strong="H4872"\w* siguió \w el|strong="H3605"\w* consejo de su \w suegro|strong="H2859"\w* \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* le dijo.  
\v 25 Escogió hombres capaces \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* nombró líderes \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*: \w los|strong="H5921"\w* \w hizo|strong="H5414"\w* \w jefes|strong="H8269"\w* \w de|strong="H5921"\w* \w mil|strong="H3967"\w*, \w de|strong="H5921"\w* \w cien|strong="H3967"\w*, \w de|strong="H5921"\w* \w cincuenta|strong="H2572"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w diez|strong="H6235"\w* personas.  
\v 26 \w A|strong="H3068"\w* partir \w de|strong="H5971"\w* \w entonces|strong="H6256"\w*, \w ellos|strong="H1992"\w* \w se|strong="H1992"\w* encargaban \w de|strong="H5971"\w* resolver \w los|strong="H1992"\w* problemas diarios \w de|strong="H5971"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w*. \w Los|strong="H1992"\w* casos más complicados \w se|strong="H1992"\w* \w los|strong="H1992"\w* llevaban \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, pero \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* decidían en \w los|strong="H1992"\w* asuntos \w de|strong="H5971"\w* \w menor|strong="H6996"\w* importancia.  
\v 27 Después, \w Moisés|strong="H4872"\w* se \w despidió|strong="H7971"\w* de su \w suegro|strong="H2859"\w*, y Jetro regresó \w a|strong="H3068"\w* su país.   
\c 19  
\p
\v 1 Exactamente al cumplirse tres \w meses|strong="H2320"\w* desde \w que|strong="H3117"\w* \w los|strong="H1121"\w* israelitas \w salieron|strong="H3318"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, llegaron al \w desierto|strong="H4057"\w* del \w Sinaí|strong="H5514"\w*.  
\v 2 Después \w de|strong="H5048"\w* salir \w de|strong="H5048"\w* Refidim, llegaron al \w desierto|strong="H4057"\w* del \w Sinaí|strong="H5514"\w* y acamparon \w allí|strong="H8033"\w*, justo \w frente|strong="H5048"\w* al \w monte|strong="H2022"\w*.  
\v 3 \w Moisés|strong="H4872"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* encontrarse \w con|strong="H4480"\w* \w Dios|strong="H3068"\w*, \w y|strong="H3541"\w* Yahvé lo \w llamó|strong="H7121"\w* \w desde|strong="H4480"\w* \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w y|strong="H3541"\w* le \w dijo|strong="H5046"\w*: “\w Esto|strong="H3541"\w* \w es|strong="H3541"\w* lo \w que|strong="H4480"\w* le vas \w a|strong="H3068"\w* \w decir|strong="H7121"\w* \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H4480"\w* \w Jacob|strong="H3290"\w*; anúnciales \w esto|strong="H3541"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas:  
\v 4 ‘Ustedes mismos \w vieron|strong="H7200"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* \w hice|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w*, \w y|strong="H5921"\w* \w cómo|strong="H5921"\w* \w los|strong="H5921"\w* \w llevé|strong="H5375"\w* \w a|strong="H3068"\w* ustedes \w sobre|strong="H5921"\w* \w alas|strong="H3671"\w* \w de|strong="H5921"\w* águila \w y|strong="H5921"\w* \w los|strong="H5921"\w* traje \w hacia|strong="H6213"\w* \w mí|strong="H5921"\w*.  
\v 5 \w Ahora|strong="H6258"\w* \w bien|strong="H3588"\w*, \w si|strong="H3588"\w* \w de|strong="H3588"\w* verdad \w me|strong="H3588"\w* \w obedecen|strong="H8085"\w* \w y|strong="H3588"\w* cumplen \w mi|strong="H1961"\w* \w pacto|strong="H1285"\w*, ustedes \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* tesoro \w más|strong="H3588"\w* preciado \w entre|strong="H3588"\w* \w todas|strong="H3605"\w* las naciones \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra; \w porque|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra \w es|strong="H1961"\w* mía.  
\v 6 \w Serán|strong="H1961"\w* \w para|strong="H1961"\w* \w mí|strong="H1961"\w* un \w reino|strong="H4467"\w* \w de|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* y una \w nación|strong="H1471"\w* \w santa|strong="H6918"\w*’. Estas \w son|strong="H1961"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* debes comunicarles \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas”.   
\p
\v 7 \w Moisés|strong="H4872"\w* regresó, \w mandó|strong="H6680"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* líderes del \w pueblo|strong="H5971"\w* y \w les|strong="H6680"\w* explicó \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé le había \w ordenado|strong="H6680"\w*.  
\v 8 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w respondió|strong="H6030"\w* al \w mismo|strong="H3605"\w* tiempo: “\w Haremos|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé ha \w dicho|strong="H1696"\w*”. \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* le llevó \w la|strong="H3605"\w* \w respuesta|strong="H1697"\w* del \w pueblo|strong="H5971"\w* \w a|strong="H3068"\w* Yahvé.  
\v 9 Yahvé \w le|strong="H5973"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Voy \w a|strong="H3068"\w* acercarme \w a|strong="H3068"\w* \w ti|strong="H5973"\w* \w en|strong="H5973"\w* medio \w de|strong="H5973"\w* una \w nube|strong="H6051"\w* muy \w espesa|strong="H5645"\w*, \w para|strong="H5973"\w* \w que|strong="H1571"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w escuche|strong="H8085"\w* \w cuando|strong="H1571"\w* \w yo|strong="H2009"\w* \w hable|strong="H1696"\w* \w contigo|strong="H5973"\w* \w y|strong="H1571"\w* \w así|strong="H1571"\w* confíen \w en|strong="H5973"\w* \w ti|strong="H5973"\w* \w para|strong="H5973"\w* \w siempre|strong="H5769"\w*”. \w Moisés|strong="H4872"\w* \w le|strong="H5973"\w* transmitió \w a|strong="H3068"\w* Yahvé \w lo|strong="H1697"\w* \w que|strong="H1571"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* había \w dicho|strong="H1697"\w*.  
\v 10 Yahvé le ordenó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Ve|strong="H3212"\w* con el \w pueblo|strong="H5971"\w* y diles \w que|strong="H5971"\w* \w se|strong="H5971"\w* purifiquen \w hoy|strong="H3117"\w* y \w mañana|strong="H4279"\w*, y \w que|strong="H5971"\w* laven su \w ropa|strong="H8071"\w*.  
\v 11 Deben estar listos \w para|strong="H5921"\w* \w el|strong="H5921"\w* tercer \w día|strong="H3117"\w*, \w porque|strong="H3588"\w* ese \w día|strong="H3117"\w* \w yo|strong="H3588"\w*, Yahvé, bajaré \w al|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* vista \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*.  
\v 12 Ponle límites al \w pueblo|strong="H5971"\w* \w alrededor|strong="H5439"\w* del \w monte|strong="H2022"\w*, y adviérteles: ‘Tengan mucho cuidado \w de|strong="H5971"\w* no \w subir|strong="H5927"\w* al \w monte|strong="H2022"\w* ni \w de|strong="H5971"\w* \w tocar|strong="H5060"\w* sus faldas. \w Cualquiera|strong="H3605"\w* \w que|strong="H5971"\w* toque \w el|strong="H3605"\w* \w monte|strong="H2022"\w* será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.  
\v 13 \w Nadie|strong="H3808"\w* debe \w tocar|strong="H5060"\w* \w a|strong="H3068"\w* esa persona; al \w que|strong="H3588"\w* \w lo|strong="H3808"\w* haga \w lo|strong="H3808"\w* matarán \w a|strong="H3068"\w* pedradas \w o|strong="H3068"\w* \w a|strong="H3068"\w* flechazos. \w Ya|strong="H3068"\w* sea un animal \w o|strong="H3068"\w* una persona, \w no|strong="H3808"\w* quedará \w con|strong="H3588"\w* \w vida|strong="H2421"\w*’. Solo \w cuando|strong="H3588"\w* \w la|strong="H3588"\w* trompeta \w dé|strong="H3588"\w* un toque largo, podrán acercarse al \w monte|strong="H2022"\w*”.   
\p
\v 14 \w Moisés|strong="H4872"\w* bajó \w del|strong="H4480"\w* \w monte|strong="H2022"\w* \w a|strong="H3068"\w* donde estaba el \w pueblo|strong="H5971"\w*, y les ordenó purificarse; y \w ellos|strong="H4480"\w* lavaron su \w ropa|strong="H8071"\w*.  
\v 15 Luego le dijo \w a|strong="H3068"\w* la \w gente|strong="H5971"\w*: “Prepárense \w para|strong="H1961"\w* \w el|strong="H5066"\w* tercer \w día|strong="H3117"\w*. \w No|strong="H1961"\w* tengan relaciones sexuales con sus mujeres”.   
\p
\v 16 \w La|strong="H5921"\w* \w mañana|strong="H1242"\w* \w del|strong="H5921"\w* tercer \w día|strong="H3117"\w*, \w hubo|strong="H1961"\w* \w truenos|strong="H6963"\w* \w y|strong="H5921"\w* \w relámpagos|strong="H1300"\w*, una \w nube|strong="H6051"\w* \w muy|strong="H3966"\w* espesa cubrió \w el|strong="H5921"\w* \w monte|strong="H2022"\w*, \w y|strong="H5921"\w* \w se|strong="H1961"\w* escuchó un toque \w de|strong="H5921"\w* \w trompeta|strong="H7782"\w* fuertísimo. \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campamento|strong="H4264"\w* \w se|strong="H1961"\w* puso \w a|strong="H3068"\w* temblar \w de|strong="H5921"\w* miedo.  
\v 17 Entonces \w Moisés|strong="H4872"\w* \w sacó|strong="H3318"\w* \w al|strong="H4480"\w* \w pueblo|strong="H5971"\w* \w del|strong="H4480"\w* \w campamento|strong="H4264"\w* \w para|strong="H4480"\w* encontrarse \w con|strong="H4480"\w* Dios, y \w se|strong="H4480"\w* detuvieron \w al|strong="H4480"\w* pie \w del|strong="H4480"\w* \w monte|strong="H2022"\w*.  
\v 18 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* estaba cubierto \w de|strong="H5921"\w* \w humo|strong="H6227"\w*, \w porque|strong="H5921"\w* Yahvé había bajado \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* medio \w de|strong="H5921"\w* fuego. \w El|strong="H5921"\w* \w humo|strong="H6227"\w* \w subía|strong="H5927"\w* \w como|strong="H5921"\w* \w si|strong="H6440"\w* fuera \w el|strong="H5921"\w* \w de|strong="H5921"\w* un horno, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* temblaba violentamente.  
\v 19 El \w sonido|strong="H6963"\w* de la \w trompeta|strong="H7782"\w* \w se|strong="H1961"\w* \w iba|strong="H1980"\w* haciendo cada vez \w más|strong="H6030"\w* fuerte; \w Moisés|strong="H4872"\w* \w hablaba|strong="H1696"\w*, y Dios le contestaba con \w voz|strong="H6963"\w* de trueno.  
\v 20 Yahvé bajó \w a|strong="H3068"\w* \w la|strong="H5921"\w* parte \w más|strong="H5921"\w* alta \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w* \w y|strong="H5921"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* subiera. \w Y|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w subió|strong="H5927"\w*.   
\p
\v 21 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Baja|strong="H3381"\w* y adviértele \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* \w que|strong="H4480"\w* \w no|strong="H6435"\w* traspase los límites tratando \w de|strong="H4480"\w* verme, \w porque|strong="H6435"\w* \w si|strong="H6435"\w* lo hacen, \w muchos|strong="H7227"\w* morirán.  
\v 22 Incluso los \w sacerdotes|strong="H3548"\w* \w que|strong="H6435"\w* \w se|strong="H6435"\w* acercan \w a|strong="H3068"\w* mí, tienen \w que|strong="H6435"\w* purificarse para \w que|strong="H6435"\w* yo \w no|strong="H6435"\w* los destruya.”   
\p
\v 23 \w Moisés|strong="H4872"\w* le contestó \w a|strong="H3068"\w* Yahvé: “\w El|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* poder \w subir|strong="H5927"\w* al \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w*, \w porque|strong="H3588"\w* tú ya nos advertiste: ‘Ponle límites al \w monte|strong="H2022"\w* \w y|strong="H3588"\w* decláralo sagrado’”.   
\p
\v 24 Pero Yahvé \w le|strong="H5973"\w* respondió: “¡\w Baja|strong="H3381"\w* \w de|strong="H5973"\w* una vez! \w Luego|strong="H5927"\w* vuelves \w a|strong="H3068"\w* \w subir|strong="H5927"\w* tú, y trae \w a|strong="H3068"\w* Aarón \w contigo|strong="H5973"\w*. Pero \w no|strong="H6435"\w* dejes \w que|strong="H6435"\w* \w los|strong="H5973"\w* \w sacerdotes|strong="H3548"\w* \w ni|strong="H6435"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w traspasen|strong="H2040"\w* \w los|strong="H5973"\w* límites \w para|strong="H5973"\w* \w subir|strong="H5927"\w* \w a|strong="H3068"\w* donde estoy yo, \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H6435"\w* \w los|strong="H5973"\w* destruya.”   
\p
\v 25 Entonces \w Moisés|strong="H4872"\w* bajó \w a|strong="H3068"\w* donde estaba el \w pueblo|strong="H5971"\w* y \w se|strong="H5971"\w* lo comunicó.   
\c 20  
\p
\v 1 Dios\f + \fr 20:1 \ft Después de “Dios”, en hebreo aparecen las letras “Alef” y “Tav” (la primera y la última letra de su alfabeto) como un marcador gramatical.\f* \w pronunció|strong="H1696"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*:  
\v 2 “Yo soy Yahvé, tu \w Dios|strong="H3068"\w*, que te \w saqué|strong="H3318"\w* de la tierra de \w Egipto|strong="H4714"\w*, donde eras esclavo.   
\p
\v 3 \w No|strong="H3808"\w* \w tendrás|strong="H1961"\w* otros dioses \w además|strong="H5921"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.   
\p
\v 4 \w No|strong="H3808"\w* te \w harás|strong="H6213"\w* \w ningún|strong="H3605"\w* ídolo, \w ni|strong="H3808"\w* \w ninguna|strong="H3605"\w* \w imagen|strong="H6459"\w* \w de|strong="H8478"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* hay \w arriba|strong="H4605"\w* \w en|strong="H8478"\w* \w el|strong="H3605"\w* \w cielo|strong="H8064"\w*, \w ni|strong="H3808"\w* \w abajo|strong="H8478"\w* \w en|strong="H8478"\w* \w la|strong="H3605"\w* tierra, \w ni|strong="H3808"\w* \w en|strong="H8478"\w* las \w aguas|strong="H4325"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w la|strong="H3605"\w* tierra.  
\v 5 \w No|strong="H3808"\w* \w te|strong="H5921"\w* inclinarás ante \w ellos|strong="H5921"\w* \w ni|strong="H3808"\w* \w los|strong="H1121"\w* adorarás, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, tu \w Dios|strong="H3068"\w*, soy un \w Dios|strong="H3068"\w* \w celoso|strong="H7067"\w*. \w Yo|strong="H3588"\w* castigo \w la|strong="H5921"\w* \w maldad|strong="H5771"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* padres \w en|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w*, \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* tercera \w y|strong="H3588"\w* cuarta generación \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* odian;  
\v 6 pero muestro amor inagotable por mil generaciones \w a|strong="H3068"\w* los que me aman y obedecen mis \w mandamientos|strong="H4687"\w*.   
\p
\v 7 \w No|strong="H3808"\w* uses \w el|strong="H3588"\w* \w nombre|strong="H8034"\w* \w de|strong="H3588"\w* Yahvé, tu \w Dios|strong="H3068"\w*, \w a|strong="H3068"\w* \w la|strong="H3588"\w* ligera,\f + \fr 20:7 \ft O “No tomarás el nombre de Yahvé, tu Dios, en vano”.\f* \w porque|strong="H3588"\w* Yahvé \w no|strong="H3808"\w* dejará \w sin|strong="H3808"\w* \w castigo|strong="H5352"\w* \w al|strong="H5352"\w* \w que|strong="H3588"\w* use mal \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*.   
\p
\v 8 \w Acuérdate|strong="H2142"\w* de santificar el \w sábado|strong="H7676"\w*, \w que|strong="H3117"\w* es el \w día|strong="H3117"\w* de descanso.  
\v 9 Tienes \w seis|strong="H8337"\w* \w días|strong="H3117"\w* en \w la|strong="H3605"\w* semana para \w trabajar|strong="H6213"\w* y \w hacer|strong="H6213"\w* \w todas|strong="H3605"\w* tus tareas,  
\v 10 pero \w el|strong="H3605"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* es \w de|strong="H1121"\w* descanso, dedicado \w a|strong="H3068"\w* Yahvé, \w tu|strong="H6213"\w* \w Dios|strong="H3068"\w*. Ese \w día|strong="H3117"\w* \w no|strong="H3808"\w* \w harás|strong="H6213"\w* \w ningún|strong="H3605"\w* tipo \w de|strong="H1121"\w* trabajo, \w ni|strong="H3808"\w* \w tú|strong="H6213"\w*, \w ni|strong="H3808"\w* \w tu|strong="H6213"\w* \w hijo|strong="H1121"\w*, \w ni|strong="H3808"\w* \w tu|strong="H6213"\w* \w hija|strong="H1323"\w*, \w ni|strong="H3808"\w* \w tu|strong="H6213"\w* esclavo, \w ni|strong="H3808"\w* \w tu|strong="H6213"\w* esclava, \w ni|strong="H3808"\w* tus \w animales|strong="H1121"\w*, \w ni|strong="H3808"\w* \w el|strong="H3605"\w* \w extranjero|strong="H1616"\w* \w que|strong="H3808"\w* viva en tus \w ciudades|strong="H8179"\w*.  
\v 11 \w Porque|strong="H3588"\w* \w en|strong="H5921"\w* \w seis|strong="H8337"\w* \w días|strong="H3117"\w* Yahvé \w hizo|strong="H6213"\w* \w los|strong="H5921"\w* \w cielos|strong="H8064"\w*, \w la|strong="H5921"\w* tierra, \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* hay \w en|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w pero|strong="H3588"\w* descansó \w el|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, Yahvé \w bendijo|strong="H1288"\w* \w el|strong="H5921"\w* \w sábado|strong="H7676"\w* \w y|strong="H3588"\w* \w lo|strong="H5921"\w* declaró \w día|strong="H3117"\w* sagrado.   
\p
\v 12 \w Honra|strong="H3513"\w* \w a|strong="H3068"\w* tu padre \w y|strong="H5921"\w* \w a|strong="H3068"\w* tu madre, \w para|strong="H4616"\w* \w que|strong="H5921"\w* vivas una larga \w vida|strong="H3117"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w que|strong="H5921"\w* Yahvé, tu \w Dios|strong="H3068"\w*, \w te|strong="H5921"\w* \w da|strong="H5414"\w*.   
\p
\v 13 \w No|strong="H3808"\w* \w matarás|strong="H7523"\w*.   
\p
\v 14 \w No|strong="H3808"\w* cometerás adulterio.   
\p
\v 15 \w No|strong="H3808"\w* robarás.   
\p
\v 16 \w No|strong="H3808"\w* darás \w falso|strong="H8267"\w* \w testimonio|strong="H5707"\w* contra tu \w prójimo|strong="H7453"\w*.   
\p
\v 17 \w No|strong="H3808"\w* \w codiciarás|strong="H2530"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de tu \w prójimo|strong="H7453"\w*; \w tampoco|strong="H3808"\w* \w codiciarás|strong="H2530"\w* \w la|strong="H3605"\w* esposa de tu \w prójimo|strong="H7453"\w*, \w ni|strong="H3808"\w* su esclavo, \w ni|strong="H3808"\w* su esclava, \w ni|strong="H3808"\w* su \w buey|strong="H7794"\w*, \w ni|strong="H3808"\w* su burro, \w ni|strong="H3808"\w* \w ninguna|strong="H3605"\w* otra \w cosa|strong="H3605"\w* \w que|strong="H3808"\w* le pertenezca”.   
\p
\v 18 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w veía|strong="H7200"\w* \w los|strong="H3605"\w* relámpagos y \w el|strong="H3605"\w* humo del \w monte|strong="H2022"\w*, y escuchaba \w los|strong="H3605"\w* \w truenos|strong="H6963"\w* y \w el|strong="H3605"\w* \w sonido|strong="H6963"\w* \w de|strong="H5971"\w* \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*. \w Estaban|strong="H5975"\w* tan asustados \w que|strong="H5971"\w* \w se|strong="H5971"\w* quedaron temblando \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w distancia|strong="H7350"\w*.  
\v 19 \w Y|strong="H3068"\w* \w le|strong="H5973"\w* \w dijeron|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “Mejor háblanos tú, y \w nosotros|strong="H5973"\w* \w te|strong="H5973"\w* escucharemos; pero \w que|strong="H6435"\w* Dios \w no|strong="H6435"\w* nos \w hable|strong="H1696"\w* directamente, \w porque|strong="H6435"\w* nos vamos \w a|strong="H3068"\w* \w morir|strong="H4191"\w*.”   
\p
\v 20 \w Moisés|strong="H4872"\w* \w los|strong="H5921"\w* tranquilizó: “\w No|strong="H3588"\w* tengan \w miedo|strong="H3372"\w*. Dios ha venido \w a|strong="H3068"\w* ponerlos \w a|strong="H3068"\w* \w prueba|strong="H5254"\w*; quiere \w que|strong="H3588"\w* \w le|strong="H5921"\w* tengan un profundo respeto \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* pequen”.  
\v 21 Sin embargo, la \w gente|strong="H5971"\w* \w se|strong="H5971"\w* \w quedó|strong="H5975"\w* \w a|strong="H3068"\w* la \w distancia|strong="H7350"\w* mientras \w Moisés|strong="H4872"\w* \w se|strong="H5971"\w* acercaba \w a|strong="H3068"\w* la nube oscura \w donde|strong="H8033"\w* \w estaba|strong="H5975"\w* Dios.   
\p
\v 22 Yahvé \w le|strong="H5973"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Diles|strong="H1696"\w* \w esto|strong="H3541"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: ‘Ustedes mismos han \w visto|strong="H7200"\w* \w que|strong="H3588"\w* \w les|strong="H5973"\w* he \w hablado|strong="H1696"\w* \w desde|strong="H4480"\w* \w el|strong="H5973"\w* \w cielo|strong="H8064"\w*.  
\v 23 \w No|strong="H3808"\w* \w se|strong="H3808"\w* \w hagan|strong="H6213"\w* dioses de \w plata|strong="H3701"\w* \w ni|strong="H3808"\w* de \w oro|strong="H2091"\w* para ponerlos \w a|strong="H3068"\w* mi nivel.  
\v 24 Háganme un \w altar|strong="H4196"\w* \w de|strong="H5921"\w* tierra, \w y|strong="H5921"\w* ofrezcan \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* sus \w holocaustos|strong="H5930"\w* \w y|strong="H5921"\w* sus \w sacrificios|strong="H2076"\w* \w de|strong="H5921"\w* paz, sus \w ovejas|strong="H6629"\w* \w y|strong="H5921"\w* sus \w vacas|strong="H1241"\w*. \w En|strong="H5921"\w* \w cualquier|strong="H3605"\w* \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* \w yo|strong="H6213"\w* decida \w que|strong="H5921"\w* \w se|strong="H5921"\w* honre \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, allí vendré \w a|strong="H3068"\w* ustedes \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w bendeciré|strong="H1288"\w*.  
\v 25 \w Si|strong="H3588"\w* \w me|strong="H5921"\w* construyen un \w altar|strong="H4196"\w* \w de|strong="H5921"\w* piedra, \w no|strong="H3808"\w* usen piedras \w labradas|strong="H1496"\w*; \w porque|strong="H3588"\w* \w al|strong="H5921"\w* usar herramientas \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* piedra, \w la|strong="H5921"\w* profanan.  
\v 26 \w Tampoco|strong="H3808"\w* \w le|strong="H5921"\w* pongan escaleras \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w altar|strong="H4196"\w*, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w al|strong="H5921"\w* \w subir|strong="H5927"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w les|strong="H5921"\w* vea \w la|strong="H5921"\w* ropa interior’”.   
\c 21  
\p
\v 1 “Estas son las leyes que les presentarás:   
\p
\v 2 “\w Si|strong="H3588"\w* compras un esclavo \w hebreo|strong="H5680"\w*, \w te|strong="H3588"\w* \w servirá|strong="H5647"\w* durante \w seis|strong="H8337"\w* \w años|strong="H8141"\w*, \w pero|strong="H3588"\w* al \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w* quedará \w libre|strong="H2670"\w* sin tener \w que|strong="H3588"\w* pagar nada.  
\v 3 \w Si|strong="H1931"\w* llegó \w solo|strong="H1931"\w*, \w se|strong="H1931"\w* \w irá|strong="H3318"\w* \w solo|strong="H1931"\w*. \w Si|strong="H1931"\w* estaba casado al llegar, \w su|strong="H1931"\w* esposa \w se|strong="H1931"\w* \w irá|strong="H3318"\w* \w con|strong="H5973"\w* \w él|strong="H1931"\w*.  
\v 4 \w Si|strong="H1931"\w* \w su|strong="H1931"\w* amo \w le|strong="H1931"\w* \w da|strong="H5414"\w* una esposa y \w ella|strong="H1931"\w* \w le|strong="H1931"\w* \w da|strong="H5414"\w* \w hijos|strong="H1121"\w* \w o|strong="H3068"\w* \w hijas|strong="H1323"\w*, \w la|strong="H1931"\w* esposa y \w los|strong="H1121"\w* \w niños|strong="H3206"\w* \w serán|strong="H1961"\w* \w de|strong="H1121"\w* \w su|strong="H1931"\w* amo, y \w el|strong="H1931"\w* esclavo \w se|strong="H1961"\w* \w irá|strong="H3318"\w* \w solo|strong="H1931"\w*.  
\v 5 Pero \w si|strong="H3808"\w* \w el|strong="H1121"\w* esclavo dice claramente: ‘Amo \w a|strong="H3068"\w* mi señor, \w a|strong="H3068"\w* mi esposa y \w a|strong="H3068"\w* mis \w hijos|strong="H1121"\w*; \w no|strong="H3808"\w* quiero \w salir|strong="H3318"\w* \w libre|strong="H2670"\w*’,  
\v 6 entonces su amo lo llevará ante Dios. Lo acercará \w a|strong="H3068"\w* la \w puerta|strong="H1817"\w* \w o|strong="H3068"\w* al marco de la \w puerta|strong="H1817"\w* de su casa, le perforará la oreja con un punzón, y \w el|strong="H5066"\w* esclavo le \w servirá|strong="H5647"\w* para toda la vida.   
\p
\v 7 “\w Si|strong="H3588"\w* un hombre \w vende|strong="H4376"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hija|strong="H1323"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* sea esclava, ella \w no|strong="H3808"\w* quedará libre \w como|strong="H3588"\w* \w los|strong="H3588"\w* esclavos \w varones|strong="H3588"\w*.  
\v 8 \w Si|strong="H3808"\w* la joven \w no|strong="H3808"\w* \w le|strong="H5869"\w* agrada \w a|strong="H3068"\w* su amo, el cual la había comprado \w para|strong="H5971"\w* hacerla su esposa, él deberá permitir \w que|strong="H3808"\w* alguien pague por su rescate. \w No|strong="H3808"\w* tendrá derecho \w a|strong="H3068"\w* venderla \w a|strong="H3068"\w* \w gente|strong="H5971"\w* \w de|strong="H5971"\w* otro país, pues la \w ha|strong="H3808"\w* tratado con engaño.  
\v 9 Si \w el|strong="H1121"\w* amo la casa con su \w hijo|strong="H1121"\w*, deberá tratarla con \w los|strong="H1121"\w* mismos \w derechos|strong="H4941"\w* \w que|strong="H1121"\w* \w a|strong="H3068"\w* una \w hija|strong="H1323"\w*.  
\v 10 \w Si|strong="H3808"\w* el amo \w se|strong="H3808"\w* casa con otra mujer, \w no|strong="H3808"\w* le \w quitará|strong="H3947"\w* \w a|strong="H3068"\w* la primera su comida, \w ni|strong="H3808"\w* su ropa, \w ni|strong="H3808"\w* sus derechos conyugales.  
\v 11 \w Si|strong="H3808"\w* \w no|strong="H3808"\w* cumple con \w estas|strong="H6213"\w* \w tres|strong="H7969"\w* cosas, la mujer \w podrá|strong="H3808"\w* irse libre, \w sin|strong="H3808"\w* tener \w que|strong="H3808"\w* pagar \w nada|strong="H3808"\w*.   
\p
\v 12 “El que golpee \w a|strong="H3068"\w* una persona hasta matarla, será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*;  
\v 13 pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w fue|strong="H3808"\w* un asesinato intencional, \w sino|strong="H3808"\w* un accidente \w que|strong="H3808"\w* Dios permitió \w que|strong="H3808"\w* ocurriera, yo te indicaré un \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* el responsable \w podrá|strong="H3808"\w* huir.  
\v 14 \w Si|strong="H3588"\w* un hombre hace planes \w para|strong="H5921"\w* matar \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w prójimo|strong="H7453"\w* \w a|strong="H3068"\w* traición, \w lo|strong="H5921"\w* sacarás incluso \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w altar|strong="H4196"\w* \w para|strong="H5921"\w* \w matarlo|strong="H4191"\w*.   
\p
\v 15 “El que golpee \w a|strong="H3068"\w* su padre \w o|strong="H3068"\w* \w a|strong="H3068"\w* su madre será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.   
\p
\v 16 “El \w que|strong="H3027"\w* secuestre \w a|strong="H3068"\w* \w una|strong="H4672"\w* persona, ya sea \w que|strong="H3027"\w* la venda \w o|strong="H3068"\w* \w que|strong="H3027"\w* todavía la tenga en su \w poder|strong="H3027"\w*, será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.   
\p
\v 17 “El que maldiga \w a|strong="H3068"\w* su padre \w o|strong="H3068"\w* \w a|strong="H3068"\w* su madre será condenado \w a|strong="H3068"\w* \w muerte|strong="H4191"\w*.   
\p
\v 18 “\w Si|strong="H3588"\w* dos hombres \w se|strong="H3808"\w* pelean \w y|strong="H3588"\w* uno golpea al \w otro|strong="H7453"\w* \w con|strong="H3588"\w* una piedra \w o|strong="H3068"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* puño, \w y|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w no|strong="H3808"\w* muere \w pero|strong="H3588"\w* tiene \w que|strong="H3588"\w* guardar \w cama|strong="H4904"\w*;  
\v 19 \w si|strong="H5921"\w* luego puede \w levantarse|strong="H6965"\w* \w y|strong="H5921"\w* caminar apoyado \w en|strong="H5921"\w* un bastón, \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* golpeó \w quedará|strong="H6965"\w* \w libre|strong="H5352"\w* \w de|strong="H5921"\w* \w castigo|strong="H5352"\w*. \w Solamente|strong="H7535"\w* \w tendrá|strong="H5352"\w* \w que|strong="H5921"\w* pagarle \w por|strong="H5921"\w* \w el|strong="H5921"\w* tiempo \w que|strong="H5921"\w* \w no|strong="H5921"\w* pudo trabajar \w y|strong="H5921"\w* hacerse cargo \w de|strong="H5921"\w* sus gastos \w médicos|strong="H7495"\w* \w hasta|strong="H5921"\w* \w que|strong="H5921"\w* sane \w por|strong="H5921"\w* completo.   
\p
\v 20 “\w Si|strong="H3588"\w* un amo golpea \w a|strong="H3068"\w* \w su|strong="H3588"\w* esclavo \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* esclava \w con|strong="H3588"\w* un palo, \w y|strong="H3588"\w* \w el|strong="H3588"\w* esclavo muere \w por|strong="H3588"\w* \w los|strong="H3588"\w* golpes, \w el|strong="H3588"\w* amo será castigado.  
\v 21 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w el|strong="H1931"\w* esclavo sobrevive uno \w o|strong="H3068"\w* \w dos|strong="H3117"\w* \w días|strong="H3117"\w* \w más|strong="H3588"\w*, \w el|strong="H1931"\w* amo \w no|strong="H3808"\w* \w será|strong="H1931"\w* castigado, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* esclavo \w es|strong="H1931"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* propiedad.   
\p
\v 22 “\w Si|strong="H3588"\w* unos hombres \w se|strong="H1961"\w* \w están|strong="H1961"\w* peleando \w y|strong="H3588"\w* golpean \w a|strong="H3068"\w* una mujer embarazada haciendo \w que|strong="H3588"\w* \w dé|strong="H5921"\w* \w a|strong="H3068"\w* luz \w antes|strong="H3588"\w* \w de|strong="H5921"\w* tiempo, \w pero|strong="H3588"\w* \w la|strong="H5921"\w* mujer \w no|strong="H3808"\w* sufre \w ningún|strong="H3808"\w* otro daño, \w el|strong="H5921"\w* culpable \w pagará|strong="H5414"\w* \w la|strong="H5921"\w* multa \w que|strong="H3588"\w* \w le|strong="H5921"\w* exija \w el|strong="H5921"\w* \w marido|strong="H1167"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w jueces|strong="H6414"\w* aprueben.  
\v 23 Pero \w si|strong="H1961"\w* la mujer sufre algún daño grave, entonces \w se|strong="H1961"\w* cobrará \w vida|strong="H5315"\w* \w por|strong="H8478"\w* \w vida|strong="H5315"\w*,  
\v 24 \w ojo|strong="H5869"\w* \w por|strong="H8478"\w* \w ojo|strong="H5869"\w*, \w diente|strong="H8127"\w* \w por|strong="H8478"\w* \w diente|strong="H8127"\w*, \w mano|strong="H3027"\w* \w por|strong="H8478"\w* \w mano|strong="H3027"\w*, \w pie|strong="H7272"\w* \w por|strong="H8478"\w* \w pie|strong="H7272"\w*,  
\v 25 \w quemadura|strong="H3555"\w* \w por|strong="H8478"\w* \w quemadura|strong="H3555"\w*, \w herida|strong="H6482"\w* \w por|strong="H8478"\w* \w herida|strong="H6482"\w*, \w golpe|strong="H2250"\w* \w por|strong="H8478"\w* \w golpe|strong="H2250"\w*.   
\p
\v 26 “\w Si|strong="H3588"\w* un amo \w le|strong="H5869"\w* pega \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w ojo|strong="H5869"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* esclavo \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* esclava \w y|strong="H3588"\w* lo \w deja|strong="H7971"\w* ciego \w de|strong="H3588"\w* ese \w ojo|strong="H5869"\w*, \w le|strong="H5869"\w* dará \w la|strong="H3588"\w* \w libertad|strong="H2670"\w* \w en|strong="H3588"\w* compensación \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w ojo|strong="H5869"\w*.  
\v 27 \w Y|strong="H3068"\w* si le rompe un \w diente|strong="H8127"\w* \w a|strong="H3068"\w* su esclavo \w o|strong="H3068"\w* \w a|strong="H3068"\w* su esclava, lo dejará \w libre|strong="H2670"\w* \w en|strong="H8478"\w* compensación \w por|strong="H8478"\w* su \w diente|strong="H8127"\w*.   
\p
\v 28 “\w Si|strong="H3588"\w* un toro \w mata|strong="H4191"\w* \w a|strong="H3068"\w* cornadas \w a|strong="H3068"\w* un hombre \w o|strong="H3068"\w* \w a|strong="H3068"\w* una mujer, \w el|strong="H3588"\w* toro \w morirá|strong="H4191"\w* \w a|strong="H3068"\w* pedradas \w y|strong="H3588"\w* \w nadie|strong="H3808"\w* \w se|strong="H3808"\w* comerá \w su|strong="H3588"\w* \w carne|strong="H1320"\w*; \w pero|strong="H3588"\w* \w el|strong="H3588"\w* \w dueño|strong="H1167"\w* del toro quedará \w libre|strong="H5355"\w* \w de|strong="H3588"\w* culpa.  
\v 29 Pero \w si|strong="H1571"\w* \w el|strong="H1931"\w* toro \w ya|strong="H1571"\w* \w tenía|strong="H1931"\w* \w la|strong="H1931"\w* costumbre de atacar, \w y|strong="H1571"\w* \w el|strong="H1931"\w* \w dueño|strong="H1167"\w* estaba advertido pero \w no|strong="H3808"\w* \w lo|strong="H1931"\w* encerró, \w si|strong="H1571"\w* \w ese|strong="H1931"\w* toro \w mata|strong="H4191"\w* \w a|strong="H3068"\w* un hombre \w o|strong="H3068"\w* \w a|strong="H3068"\w* una mujer, \w matarán|strong="H4191"\w* \w a|strong="H3068"\w* pedradas al toro \w y|strong="H1571"\w* \w también|strong="H1571"\w* condenarán \w a|strong="H3068"\w* \w muerte|strong="H4191"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w dueño|strong="H1167"\w*.  
\v 30 \w Si|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* permite \w al|strong="H5921"\w* dueño pagar un \w rescate|strong="H3724"\w* \w por|strong="H5921"\w* su \w vida|strong="H5315"\w*, deberá pagar \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w le|strong="H5921"\w* exija.  
\v 31 \w Esta|strong="H2088"\w* misma regla se aplicará si \w el|strong="H1121"\w* toro mata \w a|strong="H3068"\w* un niño \w o|strong="H3068"\w* \w a|strong="H3068"\w* una niña.  
\v 32 Si el toro mata \w a|strong="H3068"\w* un esclavo \w o|strong="H3068"\w* \w a|strong="H3068"\w* una esclava, el dueño del toro le \w pagará|strong="H5414"\w* \w treinta|strong="H7970"\w* \w siclos|strong="H8255"\w*\f + \fr 21:32 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 30 siclos son unos 300 gramos o unas 10,6 onzas.\f* \w de|strong="H5414"\w* \w plata|strong="H3701"\w* al amo del esclavo, \w y|strong="H7794"\w* el toro morirá \w a|strong="H3068"\w* pedradas.   
\p
\v 33 “\w Si|strong="H3588"\w* alguien destapa un pozo \w o|strong="H3068"\w* \w cava|strong="H3738"\w* un hoyo \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* tapa, \w y|strong="H3588"\w* un toro \w o|strong="H3068"\w* un burro \w se|strong="H3808"\w* \w cae|strong="H5307"\w* adentro,  
\v 34 el \w dueño|strong="H1167"\w* del hoyo \w tendrá|strong="H1961"\w* \w que|strong="H1961"\w* \w pagar|strong="H7999"\w* \w los|strong="H1167"\w* daños. Le \w dará|strong="H7999"\w* el \w dinero|strong="H3701"\w* al \w dueño|strong="H1167"\w* del animal, y podrá quedarse con el animal \w muerto|strong="H4191"\w*.   
\p
\v 35 “\w Si|strong="H3588"\w* \w el|strong="H3588"\w* toro \w de|strong="H3588"\w* un hombre \w mata|strong="H4191"\w* al toro \w de|strong="H3588"\w* \w su|strong="H3588"\w* vecino, \w venderán|strong="H4376"\w* \w el|strong="H3588"\w* toro \w vivo|strong="H2416"\w* \w y|strong="H1571"\w* se repartirán \w el|strong="H3588"\w* \w dinero|strong="H3701"\w*; \w también|strong="H1571"\w* se repartirán \w la|strong="H1571"\w* carne del toro \w muerto|strong="H4191"\w*.  
\v 36 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* todos \w sabían|strong="H3045"\w* \w que|strong="H3588"\w* \w ese|strong="H1931"\w* toro ya \w tenía|strong="H1961"\w* \w la|strong="H1931"\w* costumbre \w de|strong="H3588"\w* atacar \w y|strong="H3588"\w* \w su|strong="H1931"\w* \w dueño|strong="H1167"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* mantenía encerrado, \w el|strong="H1931"\w* \w dueño|strong="H1167"\w* \w tendrá|strong="H1961"\w* \w que|strong="H3588"\w* pagarle un toro vivo \w a|strong="H3068"\w* \w su|strong="H1931"\w* vecino \w y|strong="H3588"\w* \w se|strong="H3045"\w* \w quedará|strong="H1961"\w* \w con|strong="H3588"\w* \w el|strong="H1931"\w* toro \w muerto|strong="H4191"\w*.   
\c 22  
\p
\v 1 “Si alguien se roba un toro \w o|strong="H3068"\w* \w una|strong="H4672"\w* oveja, y luego lo \w mata|strong="H4191"\w* \w o|strong="H3068"\w* lo vende, tendrá que pagar cinco toros por el toro robado, \w o|strong="H3068"\w* cuatro ovejas por la oveja robada.  
\v 2 \w Si|strong="H5921"\w* sorprenden \w a|strong="H3068"\w* un ladrón metiéndose \w en|strong="H5921"\w* una casa \w a|strong="H3068"\w* \w la|strong="H5921"\w* fuerza, \w y|strong="H5921"\w* \w al|strong="H5921"\w* golpearlo muere, \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* mató \w no|strong="H5921"\w* será culpable \w de|strong="H5921"\w* asesinato.  
\v 3 Pero si esto ocurre \w a|strong="H3068"\w* plena luz del día, sí será culpable \w de|strong="H5704"\w* asesinato. El ladrón está obligado \w a|strong="H3068"\w* \w pagar|strong="H7999"\w* todo \w lo|strong="H5704"\w* \w que|strong="H5704"\w* robó. Si no tiene \w con|strong="H5704"\w* \w qué|strong="H5704"\w* \w pagar|strong="H7999"\w*, será vendido \w como|strong="H5704"\w* esclavo \w para|strong="H5704"\w* \w pagar|strong="H7999"\w* el robo.  
\v 4 \w Si|strong="H3588"\w* le encuentran vivo \w el|strong="H3588"\w* animal robado, ya sea un toro, un burro \w o|strong="H3068"\w* una oveja, tendrá \w que|strong="H3588"\w* \w pagar|strong="H7999"\w* \w el|strong="H3588"\w* doble.   
\p
\v 5 “\w Si|strong="H3588"\w* alguien deja sueltos \w a|strong="H3068"\w* sus animales \w y|strong="H3588"\w* estos se meten \w a|strong="H3068"\w* pastar \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w campo|strong="H7704"\w* \w o|strong="H3068"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* viñedo \w de|strong="H3588"\w* otra persona, \w el|strong="H3588"\w* dueño \w de|strong="H3588"\w* \w los|strong="H3588"\w* animales tendrá \w que|strong="H3588"\w* \w pagar|strong="H7999"\w* \w el|strong="H3588"\w* daño \w con|strong="H3588"\w* lo mejor \w de|strong="H3588"\w* \w su|strong="H3588"\w* propio \w campo|strong="H7704"\w* \w o|strong="H3068"\w* viñedo.   
\p
\v 6 “\w Si|strong="H3588"\w* alguien prende \w una|strong="H4672"\w* fogata \w y|strong="H3588"\w* \w el|strong="H3588"\w* fuego se extiende \w a|strong="H3068"\w* \w los|strong="H3588"\w* matorrales, quemando \w los|strong="H3588"\w* manojos \w de|strong="H3588"\w* trigo, las plantas \w o|strong="H3068"\w* todo un campo, \w el|strong="H3588"\w* \w que|strong="H3588"\w* prendió \w el|strong="H3588"\w* fuego tendrá \w que|strong="H3588"\w* \w pagar|strong="H7999"\w* \w los|strong="H3588"\w* \w daños|strong="H5414"\w*.   
\p
\v 7 “\w Si|strong="H3808"\w* alguien le da \w a|strong="H3068"\w* cuidar dinero \w o|strong="H3068"\w* cosas de valor \w a|strong="H3068"\w* su vecino, y \w se|strong="H3808"\w* las roban de la \w casa|strong="H1004"\w* del vecino, el \w ladrón|strong="H1590"\w* tendrá \w que|strong="H3808"\w* pagar el doble \w si|strong="H3808"\w* \w lo|strong="H3808"\w* atrapan.  
\v 8 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3588"\w* atrapan \w al|strong="H5921"\w* ladrón, \w el|strong="H1931"\w* dueño \w de|strong="H5921"\w* \w la|strong="H1931"\w* casa tendrá \w que|strong="H3588"\w* presentarse ante Dios \w para|strong="H5704"\w* \w que|strong="H3588"\w* \w se|strong="H1931"\w* investigue \w si|strong="H3588"\w* \w él|strong="H1931"\w* \w mismo|strong="H1931"\w* \w se|strong="H1931"\w* robó \w las|strong="H5921"\w* \w cosas|strong="H1697"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* vecino.  
\v 9 \w En|strong="H3588"\w* \w cualquier|strong="H3605"\w* caso \w de|strong="H3588"\w* fraude, ya sea \w que|strong="H3588"\w* se trate \w de|strong="H3588"\w* un toro, un burro, una \w oveja|strong="H7716"\w*, ropa \w o|strong="H3068"\w* \w cualquier|strong="H3605"\w* \w cosa|strong="H3605"\w* perdida, \w si|strong="H3588"\w* alguien dice: ‘Esto \w es|strong="H3588"\w* mío’, \w el|strong="H3588"\w* caso se llevará ante Dios. \w La|strong="H3588"\w* persona \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w que|strong="H3588"\w* Dios declare culpable, tendrá \w que|strong="H3588"\w* pagarle \w el|strong="H3588"\w* doble \w a|strong="H3068"\w* \w su|strong="H3588"\w* vecino.   
\p
\v 10 “\w Si|strong="H3808"\w* alguien le da \w a|strong="H3068"\w* cuidar \w a|strong="H3068"\w* su vecino un burro, un toro, una oveja \w o|strong="H3068"\w* cualquier \w otro|strong="H7453"\w* animal, y el animal \w se|strong="H1961"\w* muere, \w se|strong="H1961"\w* lastima \w o|strong="H3068"\w* \w se|strong="H1961"\w* \w lo|strong="H3808"\w* roban \w sin|strong="H3808"\w* \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* \w se|strong="H1961"\w* dé cuenta,  
\v 11 \w el|strong="H5973"\w* vecino tendrá que jurar por Yahvé que \w él|strong="H5973"\w* no se robó \w el|strong="H5973"\w* animal. \w El|strong="H5973"\w* \w dueño|strong="H1167"\w* aceptará \w el|strong="H5973"\w* juramento y \w el|strong="H5973"\w* vecino no tendrá que \w pagar|strong="H7999"\w* nada.  
\v 12 Pero \w si|strong="H3808"\w* el animal le \w fue|strong="H3808"\w* robado, el vecino tendrá \w que|strong="H3808"\w* pagarle al dueño.  
\v 13 \w Si|strong="H3588"\w* un animal salvaje despedazó al animal \w que|strong="H3588"\w* cuidaba, \w deberá|strong="H7999"\w* traer \w los|strong="H1167"\w* restos \w como|strong="H3588"\w* prueba \w y|strong="H3588"\w* \w no|strong="H3588"\w* tendrá \w que|strong="H3588"\w* \w pagar|strong="H7999"\w* nada.   
\p
\v 14 “\w Si|strong="H3808"\w* alguien \w le|strong="H1931"\w* pide prestado un animal \w a|strong="H3068"\w* \w su|strong="H1931"\w* vecino, y \w el|strong="H1931"\w* animal \w se|strong="H1931"\w* lastima \w o|strong="H3068"\w* \w se|strong="H1931"\w* muere cuando \w el|strong="H1931"\w* \w dueño|strong="H1167"\w* \w no|strong="H3808"\w* \w está|strong="H1931"\w* presente, \w la|strong="H1931"\w* persona \w que|strong="H1931"\w* \w lo|strong="H1931"\w* pidió prestado tendrá \w que|strong="H1931"\w* pagarlo.  
\v 15 \w Si|strong="H3588"\w* \w el|strong="H5973"\w* dueño \w estaba|strong="H7901"\w* presente, \w no|strong="H3808"\w* tendrá \w que|strong="H3588"\w* pagar \w nada|strong="H3808"\w*. \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w el|strong="H5973"\w* animal era alquilado, \w el|strong="H5973"\w* costo \w del|strong="H5973"\w* alquiler cubrirá \w la|strong="H3588"\w* pérdida.   
\p
\v 16 “Si un hombre seduce \w a|strong="H3068"\w* una joven \w virgen|strong="H1330"\w* que \w no|strong="H3985"\w* está comprometida y se acuesta con ella, tendrá que pagar la dote \w para|strong="H5414"\w* casarse con ella.  
\v 17 \w Si|strong="H3808"\w* el papá de la muchacha \w no|strong="H3808"\w* quiere dársela en matrimonio, de todos modos el hombre tendrá \w que|strong="H3808"\w* pagarle la cantidad de dinero \w que|strong="H3808"\w* \w se|strong="H3808"\w* acostumbra dar por una virgen.   
\p
\v 18 “No dejarás \w con|strong="H5973"\w* vida \w a|strong="H3068"\w* \w ninguna|strong="H3605"\w* bruja \w ni|strong="H5973"\w* hechicera.   
\p
\v 19 “El \w que|strong="H1115"\w* tenga relaciones sexuales con un animal será condenado \w a|strong="H3068"\w* muerte.   
\p
\v 20 “\w El|strong="H3588"\w* \w que|strong="H3588"\w* le ofrezca sacrificios \w a|strong="H3068"\w* cualquier otro dios \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w sea|strong="H1961"\w* solo Yahvé, \w será|strong="H1961"\w* destruido \w por|strong="H3588"\w* completo.   
\p
\v 21 “\w No|strong="H3808"\w* maltrates \w ni|strong="H3808"\w* oprimas \w a|strong="H3068"\w* \w los|strong="H3605"\w* extranjeros, \w porque|strong="H3808"\w* ustedes mismos fueron extranjeros en Egipto.   
\p
\v 22 “\w No|strong="H3588"\w* se aprovechen \w de|strong="H3588"\w* las viudas ni \w de|strong="H3588"\w* \w los|strong="H3588"\w* huérfanos.  
\v 23 \w Si|strong="H1961"\w* ustedes \w se|strong="H1961"\w* aprovechan \w de|strong="H1121"\w* ellos, y ellos me piden ayuda, yo les aseguro \w que|strong="H1121"\w* escucharé sus gritos;  
\v 24 \w mi|strong="H5921"\w* enojo \w se|strong="H1961"\w* encenderá \w y|strong="H5921"\w* \w los|strong="H5921"\w* mataré \w a|strong="H3068"\w* ustedes \w a|strong="H3068"\w* filo \w de|strong="H5921"\w* espada. Entonces \w serán|strong="H1961"\w* sus esposas \w las|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* quedarán viudas, \w y|strong="H5921"\w* sus hijos \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* quedarán huérfanos.   
\p
\v 25 “Si le prestas dinero \w a|strong="H3068"\w* algún pobre \w de|strong="H5704"\w* mi pueblo \w que|strong="H5704"\w* viva entre ustedes, no te portes \w con|strong="H5704"\w* él \w como|strong="H5704"\w* un usurero, \w ni|strong="H5704"\w* le cobres intereses.  
\v 26 \w Si|strong="H3588"\w* tomas \w el|strong="H1931"\w* manto \w de|strong="H3588"\w* tu prójimo \w como|strong="H4100"\w* garantía \w de|strong="H3588"\w* un préstamo, devuélveselo \w antes|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w se|strong="H1961"\w* ponga \w el|strong="H1931"\w* sol,  
\v 27 \w porque|strong="H3808"\w* ese manto es \w lo|strong="H3808"\w* único \w que|strong="H3808"\w* tiene \w para|strong="H5971"\w* taparse. ¿Con \w qué|strong="H3808"\w* otra cosa \w se|strong="H3808"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* abrigar \w para|strong="H5971"\w* dormir? \w Si|strong="H3808"\w* él me pide ayuda \w a|strong="H3068"\w* gritos, yo \w lo|strong="H3808"\w* escucharé, \w porque|strong="H3808"\w* soy compasivo.   
\p
\v 28 “\w No|strong="H3808"\w* maldigas \w a|strong="H3068"\w* Dios, \w ni|strong="H3808"\w* hables mal \w de|strong="H1121"\w* \w los|strong="H1121"\w* líderes \w de|strong="H1121"\w* tu pueblo.   
\p
\v 29 “\w No|strong="H6213"\w* \w te|strong="H5973"\w* demores \w en|strong="H5973"\w* presentarme las ofrendas \w de|strong="H5973"\w* tus cosechas \w y|strong="H7794"\w* \w de|strong="H5973"\w* tus lagares.  
\p “\w Me|strong="H5973"\w* entregarás al primer hijo varón \w que|strong="H3117"\w* \w tengas|strong="H5414"\w*.  
\v 30 \w Lo|strong="H3808"\w* mismo harás con la primera cría de tus vacas y tus ovejas. La cría \w se|strong="H1961"\w* \w quedará|strong="H1961"\w* con su madre \w los|strong="H1961"\w* primeros siete días, pero al octavo día me la entregarás.   
\p
\v 31 “Ustedes serán un pueblo santo para mí. Por eso, no coman la carne de ningún animal que haya sido despedazado por las fieras en el campo; échensela \w a|strong="H3068"\w* los perros.   
\c 23  
\p
\v 1 “\w No|strong="H3808"\w* andes esparciendo chismes \w ni|strong="H3808"\w* noticias falsas. \w No|strong="H3808"\w* \w te|strong="H5973"\w* juntes \w con|strong="H5973"\w* gente malvada \w para|strong="H1961"\w* dar \w falsos|strong="H2555"\w* testimonios \w en|strong="H5973"\w* \w el|strong="H5973"\w* tribunal.   
\p
\v 2 “\w No|strong="H3808"\w* \w te|strong="H5921"\w* dejes llevar \w por|strong="H5921"\w* \w la|strong="H5921"\w* mayoría \w para|strong="H5921"\w* hacer \w el|strong="H5921"\w* \w mal|strong="H7451"\w*. \w Cuando|strong="H1961"\w* declares \w en|strong="H5921"\w* un \w juicio|strong="H7379"\w*, \w no|strong="H3808"\w* \w te|strong="H5921"\w* pongas \w del|strong="H5921"\w* lado \w de|strong="H5921"\w* \w la|strong="H5921"\w* mayoría \w para|strong="H5921"\w* torcer \w la|strong="H5921"\w* justicia.  
\v 3 Pero \w tampoco|strong="H3808"\w* favorezcas \w a|strong="H3068"\w* un \w pobre|strong="H1800"\w* en su \w pleito|strong="H7379"\w* solo por ser \w pobre|strong="H1800"\w*.   
\p
\v 4 “\w Si|strong="H3588"\w* \w te|strong="H3588"\w* encuentras \w el|strong="H3588"\w* toro \w o|strong="H3068"\w* \w el|strong="H3588"\w* burro \w de|strong="H3588"\w* tu enemigo andando perdido, asegúrate \w de|strong="H3588"\w* devolvérselo.  
\v 5 \w Si|strong="H3588"\w* \w ves|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H5973"\w* burro \w de|strong="H3588"\w* alguien \w que|strong="H3588"\w* \w te|strong="H3588"\w* cae mal se ha \w caído|strong="H7257"\w* \w bajo|strong="H8478"\w* \w el|strong="H5973"\w* peso \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w carga|strong="H4853"\w*, \w no|strong="H3588"\w* lo \w dejes|strong="H5800"\w* ahí tirado. ¡Ayúdalo \w a|strong="H3068"\w* levantarlo!   
\p
\v 6 “\w No|strong="H3808"\w* le niegues la \w justicia|strong="H4941"\w* al pobre en sus demandas legales.   
\p
\v 7 “Aléjate \w por|strong="H3588"\w* completo \w de|strong="H3588"\w* las acusaciones falsas. \w No|strong="H3808"\w* condenes \w a|strong="H3068"\w* muerte \w a|strong="H3068"\w* una persona \w inocente|strong="H5355"\w* \w o|strong="H3068"\w* \w justa|strong="H6662"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w no|strong="H3808"\w* perdonaré al malvado.   
\p
\v 8 “\w No|strong="H3808"\w* aceptes sobornos, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w soborno|strong="H7810"\w* \w ciega|strong="H5786"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* gente \w y|strong="H3588"\w* hace \w que|strong="H3588"\w* las personas honestas tuerzan \w la|strong="H3588"\w* verdad.   
\p
\v 9 “\w No|strong="H3808"\w* oprimas al \w extranjero|strong="H1616"\w*. Ustedes \w saben|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* siente \w ser|strong="H5315"\w* \w extranjero|strong="H1616"\w*, \w porque|strong="H3588"\w* ustedes mismos \w fueron|strong="H1961"\w* \w extranjeros|strong="H1616"\w* \w en|strong="H3588"\w* \w Egipto|strong="H4714"\w*.   
\p
\v 10 “Durante \w seis|strong="H8337"\w* \w años|strong="H8141"\w* \w sembrarás|strong="H2232"\w* tus campos y recogerás las cosechas,  
\v 11 pero \w el|strong="H6213"\w* \w séptimo|strong="H7637"\w* año dejarás descansar la tierra y \w no|strong="H6213"\w* la cultivarás. \w De|strong="H5971"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* crezca \w por|strong="H3651"\w* sí solo, podrán comer los pobres \w de|strong="H5971"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w*, y \w lo|strong="H6213"\w* \w que|strong="H5971"\w* ellos dejen \w se|strong="H3651"\w* \w lo|strong="H6213"\w* comerán los \w animales|strong="H2416"\w* del \w campo|strong="H7704"\w*. \w Harás|strong="H6213"\w* \w lo|strong="H6213"\w* mismo con tus viñedos y tus olivos.   
\p
\v 12 “Tienes \w seis|strong="H8337"\w* \w días|strong="H3117"\w* \w a|strong="H3068"\w* la semana \w para|strong="H4616"\w* \w hacer|strong="H6213"\w* \w tu|strong="H6213"\w* trabajo, pero \w el|strong="H1121"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* debes descansar. Así podrán descansar también \w tu|strong="H6213"\w* toro \w y|strong="H7794"\w* \w tu|strong="H6213"\w* burro, \w y|strong="H7794"\w* podrán reponer fuerzas \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w tu|strong="H6213"\w* esclava \w y|strong="H7794"\w* \w el|strong="H1121"\w* \w extranjero|strong="H1616"\w*.   
\p
\v 13 “Asegúrense \w de|strong="H5921"\w* cumplir \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w les|strong="H5921"\w* he mandado. \w Ni|strong="H3808"\w* siquiera mencionen \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* otros dioses; ¡\w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* \w escuche|strong="H8085"\w* salir \w de|strong="H5921"\w* su \w boca|strong="H6310"\w*!   
\p
\v 14 “Celebrarás una fiesta en mi honor \w tres|strong="H7969"\w* \w veces|strong="H7272"\w* al \w año|strong="H8141"\w*.  
\v 15 Celebrarás \w la|strong="H3588"\w* \w fiesta|strong="H2282"\w* del pan \w sin|strong="H3808"\w* levadura. Durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* comerán pan \w sin|strong="H3808"\w* levadura \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w mes|strong="H2320"\w* \w de|strong="H3588"\w* Abib, tal \w como|strong="H3588"\w* \w te|strong="H3588"\w* \w lo|strong="H3808"\w* \w ordené|strong="H6680"\w*, \w porque|strong="H3588"\w* \w en|strong="H3588"\w* ese \w mes|strong="H2320"\w* \w salieron|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w Nadie|strong="H3808"\w* debe presentarse \w ante|strong="H6440"\w* mí \w con|strong="H3588"\w* las manos \w vacías|strong="H7387"\w*.  
\v 16 \w También|strong="H3318"\w* celebrarás la \w fiesta|strong="H2282"\w* \w de|strong="H4480"\w* la cosecha, \w en|strong="H4480"\w* la \w que|strong="H4480"\w* \w me|strong="H4480"\w* ofrecerás los primeros frutos \w de|strong="H4480"\w* lo \w que|strong="H4480"\w* hayas \w sembrado|strong="H2232"\w* \w en|strong="H4480"\w* el \w campo|strong="H7704"\w*. \w Y|strong="H3068"\w* \w al|strong="H4480"\w* final \w del|strong="H4480"\w* \w año|strong="H8141"\w* celebrarás la \w fiesta|strong="H2282"\w* \w de|strong="H4480"\w* la recolección, cuando recojas \w todos|strong="H8141"\w* los frutos \w de|strong="H4480"\w* tu trabajo.  
\v 17 \w Tres|strong="H7969"\w* \w veces|strong="H6471"\w* al \w año|strong="H8141"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres se presentarán \w ante|strong="H6440"\w* Yahvé \w el|strong="H3605"\w* \w Señor|strong="H3068"\w*.   
\p
\v 18 “\w No|strong="H3808"\w* ofrezcas \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* mis \w sacrificios|strong="H2077"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* pan \w que|strong="H3808"\w* tenga levadura. \w Tampoco|strong="H3808"\w* dejes \w que|strong="H3808"\w* \w la|strong="H5921"\w* grasa \w de|strong="H5921"\w* mis ofrendas \w se|strong="H5921"\w* quede guardada \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* siguiente.   
\p
\v 19 “Llevarás \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de Yahvé tu \w Dios|strong="H3068"\w* \w lo|strong="H3808"\w* mejor de los primeros frutos de tus cosechas.  
\p “\w No|strong="H3808"\w* cocines \w a|strong="H3068"\w* un \w cabrito|strong="H1423"\w* en la \w leche|strong="H2461"\w* de su propia madre.   
\p
\v 20 “\w Mira|strong="H2009"\w*, voy \w a|strong="H3068"\w* enviar un \w ángel|strong="H4397"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti para que te proteja en el \w camino|strong="H1870"\w* y te lleve al \w lugar|strong="H4725"\w* que te he preparado.  
\v 21 Préstale mucha atención \w y|strong="H3588"\w* \w obedece|strong="H8085"\w* todo \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* diga. \w No|strong="H3808"\w* \w te|strong="H3588"\w* rebeles \w contra|strong="H6440"\w* \w él|strong="H3588"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w perdonará|strong="H5375"\w* \w los|strong="H3588"\w* \w pecados|strong="H6588"\w* \w de|strong="H3588"\w* ustedes, ya \w que|strong="H3588"\w* \w él|strong="H3588"\w* actúa \w en|strong="H3588"\w* \w mi|strong="H5375"\w* \w nombre|strong="H8034"\w*.  
\v 22 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w tú|strong="H6213"\w* \w lo|strong="H6213"\w* obedeces \w y|strong="H3588"\w* \w haces|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* digo, \w entonces|strong="H3588"\w* seré \w enemigo|strong="H6887"\w* \w de|strong="H3588"\w* tus enemigos \w y|strong="H3588"\w* \w me|strong="H3588"\w* opondré \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* se \w te|strong="H3588"\w* opongan.  
\v 23 Mi \w ángel|strong="H4397"\w* \w irá|strong="H3212"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ti \w y|strong="H3588"\w* \w te|strong="H3588"\w* \w llevará|strong="H3212"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w los|strong="H3588"\w* amorreos, \w los|strong="H3588"\w* hititas, \w los|strong="H3588"\w* ferezeos, \w los|strong="H3588"\w* \w cananeos|strong="H3669"\w*, \w los|strong="H3588"\w* \w heveos|strong="H2340"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w jebuseos|strong="H2983"\w*, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w los|strong="H3588"\w* destruiré \w por|strong="H3588"\w* completo.  
\v 24 \w No|strong="H3808"\w* \w te|strong="H3588"\w* inclines ante sus dioses \w ni|strong="H3808"\w* \w los|strong="H3588"\w* adores, \w y|strong="H3588"\w* \w no|strong="H3808"\w* imites \w lo|strong="H3808"\w* \w que|strong="H3588"\w* ellos \w hacen|strong="H6213"\w*. Al contrario, destruye \w por|strong="H3588"\w* completo sus ídolos \w y|strong="H3588"\w* \w haz|strong="H6213"\w* pedazos sus monumentos sagrados.  
\v 25 Adoren \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*, y él \w bendecirá|strong="H1288"\w* su \w comida|strong="H3899"\w* y su \w agua|strong="H4325"\w*. Yo alejaré \w de|strong="H4325"\w* ustedes las enfermedades.  
\v 26 En tu país \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* mujeres \w que|strong="H3808"\w* pierdan \w a|strong="H3068"\w* sus bebés, \w ni|strong="H3808"\w* mujeres \w que|strong="H3808"\w* \w no|strong="H3808"\w* puedan \w tener|strong="H1961"\w* hijos. Yo te daré una \w vida|strong="H3117"\w* larga y plena.  
\v 27 \w Enviaré|strong="H7971"\w* mi terror \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti; \w causaré|strong="H5414"\w* pánico en las naciones \w a|strong="H3068"\w* las \w que|strong="H5971"\w* llegues, y \w haré|strong="H5414"\w* \w que|strong="H5971"\w* \w todos|strong="H3605"\w* tus enemigos huyan corriendo \w de|strong="H6440"\w* ti.  
\v 28 \w Enviaré|strong="H7971"\w* avispas \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti para ahuyentar \w a|strong="H3068"\w* los \w heveos|strong="H2340"\w*, \w a|strong="H3068"\w* los \w cananeos|strong="H3669"\w* y \w a|strong="H3068"\w* los hititas.  
\v 29 \w No|strong="H3808"\w* \w los|strong="H5921"\w* expulsaré \w a|strong="H3068"\w* \w todos|strong="H8141"\w* \w en|strong="H5921"\w* un solo \w año|strong="H8141"\w*, \w no|strong="H3808"\w* \w sea|strong="H1961"\w* \w que|strong="H3808"\w* \w la|strong="H5921"\w* tierra \w se|strong="H1961"\w* \w quede|strong="H1961"\w* vacía \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w animales|strong="H2416"\w* salvajes \w se|strong="H1961"\w* multipliquen \w y|strong="H5921"\w* \w te|strong="H5921"\w* ataquen.  
\v 30 Los iré expulsando \w poco|strong="H4592"\w* \w a|strong="H3068"\w* \w poco|strong="H4592"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* ustedes sean \w lo|strong="H5704"\w* suficientemente numerosos \w para|strong="H5704"\w* ocupar toda la tierra.  
\v 31 Estableceré tus fronteras \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w Mar|strong="H3220"\w* Rojo \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w mar|strong="H3220"\w* \w de|strong="H3588"\w* \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w*, \w y|strong="H3588"\w* \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w río|strong="H5104"\w* Éufrates. \w Yo|strong="H3588"\w* \w entregaré|strong="H5414"\w* \w en|strong="H5704"\w* sus \w manos|strong="H3027"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* esa tierra, \w y|strong="H3588"\w* tú \w los|strong="H3427"\w* echarás \w de|strong="H3588"\w* allí.  
\v 32 \w No|strong="H3808"\w* hagas \w ningún|strong="H3808"\w* trato con ellos \w ni|strong="H3808"\w* con sus dioses.  
\v 33 \w No|strong="H3808"\w* les permitas vivir \w en|strong="H3588"\w* tu país, \w porque|strong="H3588"\w* \w si|strong="H3588"\w* adoran \w a|strong="H3068"\w* sus dioses, ellos \w te|strong="H3588"\w* \w harán|strong="H5647"\w* \w pecar|strong="H2398"\w* \w contra|strong="H1961"\w* \w mí|strong="H1961"\w*, \w y|strong="H3588"\w* eso \w será|strong="H1961"\w* una trampa mortal \w para|strong="H3588"\w* ti.”   
\c 24  
\p
\v 1 Entonces \w Dios|strong="H3068"\w* le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Sube|strong="H5927"\w* \w a|strong="H3068"\w* presentarte ante Yahvé, y trae contigo \w a|strong="H3068"\w* Aarón, \w a|strong="H3068"\w* \w Nadab|strong="H5070"\w*, \w a|strong="H3068"\w* Abiú y \w a|strong="H3068"\w* \w setenta|strong="H7657"\w* de los líderes de \w Israel|strong="H3478"\w*. Ellos me adorarán desde \w lejos|strong="H7350"\w*.  
\v 2 Solo \w Moisés|strong="H4872"\w* \w se|strong="H1992"\w* acercará \w a|strong="H3068"\w* Yahvé; \w los|strong="H1992"\w* demás \w no|strong="H3808"\w* deberán acercarse, \w ni|strong="H3808"\w* \w tampoco|strong="H3808"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w subirá|strong="H5927"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*”.   
\p
\v 3 \w Moisés|strong="H4872"\w* bajó y le \w contó|strong="H5608"\w* al \w pueblo|strong="H5971"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé \w había|strong="H6213"\w* \w dicho|strong="H1697"\w* y \w todas|strong="H3605"\w* sus leyes. \w Y|strong="H3068"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* entero contestó \w a|strong="H3068"\w* una sola \w voz|strong="H6963"\w*: “\w Cumpliremos|strong="H6213"\w* con \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé ha \w dicho|strong="H1697"\w*”.   
\p
\v 4 Luego \w Moisés|strong="H4872"\w* \w escribió|strong="H3789"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* \w de|strong="H8478"\w* Yahvé. \w A|strong="H3068"\w* \w la|strong="H3605"\w* \w mañana|strong="H1242"\w* siguiente se levantó temprano y construyó un \w altar|strong="H4196"\w* \w al|strong="H8478"\w* \w pie|strong="H8478"\w* \w del|strong="H4196"\w* \w monte|strong="H2022"\w*, y levantó \w doce|strong="H8147"\w* monumentos \w de|strong="H8478"\w* piedra, uno \w por|strong="H8478"\w* \w cada|strong="H3605"\w* \w tribu|strong="H7626"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*.  
\v 5 \w Mandó|strong="H7971"\w* \w a|strong="H3068"\w* unos jóvenes israelitas \w a|strong="H3068"\w* \w que|strong="H1121"\w* ofrecieran \w holocaustos|strong="H5930"\w* y \w sacrificaran|strong="H2077"\w* \w toros|strong="H6499"\w* jóvenes como ofrenda \w de|strong="H1121"\w* paz para Yahvé.  
\v 6 \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* mitad \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* animales \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w puso|strong="H7760"\w* \w en|strong="H5921"\w* unos tazones, \w y|strong="H5921"\w* \w la|strong="H5921"\w* otra mitad \w la|strong="H5921"\w* roció \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 7 Después \w tomó|strong="H3947"\w* \w el|strong="H3605"\w* \w libro|strong="H5612"\w* del \w pacto|strong="H1285"\w* y \w se|strong="H5971"\w* \w lo|strong="H5612"\w* \w leyó|strong="H7121"\w* en voz alta al \w pueblo|strong="H5971"\w*. \w Ellos|strong="H3605"\w* \w respondieron|strong="H1696"\w*: “\w Haremos|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H5612"\w* \w que|strong="H5971"\w* Yahvé nos ha ordenado y seremos \w obedientes|strong="H8085"\w*”.   
\p
\v 8 Entonces \w Moisés|strong="H4872"\w* \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* tazones, \w la|strong="H5921"\w* roció \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w y|strong="H5921"\w* \w les|strong="H5973"\w* dijo: “Miren, \w esta|strong="H5921"\w* \w es|strong="H1697"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w que|strong="H5921"\w* confirma \w el|strong="H5921"\w* \w pacto|strong="H1285"\w* \w que|strong="H5921"\w* Yahvé ha \w hecho|strong="H3772"\w* \w con|strong="H5973"\w* ustedes, basado \w en|strong="H5921"\w* \w todas|strong="H3605"\w* estas \w palabras|strong="H1697"\w*.”   
\p
\v 9 Después de esto, \w Moisés|strong="H4872"\w*, Aarón, \w Nadab|strong="H5070"\w*, Abiú y los \w setenta|strong="H7657"\w* líderes de \w Israel|strong="H3478"\w* \w subieron|strong="H5927"\w* al monte.  
\v 10 Allí \w vieron|strong="H7200"\w* \w al|strong="H8478"\w* Dios \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*. \w Debajo|strong="H8478"\w* \w de|strong="H8478"\w* sus \w pies|strong="H7272"\w* había algo parecido \w a|strong="H3068"\w* un piso \w de|strong="H8478"\w* piedra \w de|strong="H8478"\w* zafiro,\f + \fr 24:10 \ft O lapislázuli.\f* brillante y claro \w como|strong="H7272"\w* el \w cielo|strong="H8064"\w* \w mismo|strong="H6106"\w*.  
\v 11 \w Y|strong="H3068"\w* \w aunque|strong="H3808"\w* estos líderes \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w vieron|strong="H2372"\w* \w a|strong="H3068"\w* Dios, \w él|strong="H1121"\w* \w no|strong="H3808"\w* \w los|strong="H1121"\w* destruyó; \w es|strong="H3027"\w* \w más|strong="H3808"\w*, ¡comieron y \w bebieron|strong="H8354"\w* allí mismo en su presencia!   
\p
\v 12 Yahvé le dijo \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*: “\w Sube|strong="H5927"\w* \w a|strong="H3068"\w* la montaña, hasta \w donde|strong="H8033"\w* yo \w estoy|strong="H1961"\w*, y espérame \w ahí|strong="H8033"\w*. Te voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w* unas \w tablas|strong="H3871"\w* \w de|strong="H5414"\w* piedra \w donde|strong="H8033"\w* he \w escrito|strong="H3789"\w* la \w ley|strong="H8451"\w* y \w los|strong="H1961"\w* \w mandamientos|strong="H4687"\w* \w para|strong="H5414"\w* \w que|strong="H1961"\w* le enseñes al pueblo.”   
\p
\v 13 \w Moisés|strong="H4872"\w* se preparó para \w subir|strong="H5927"\w* junto con su ayudante \w Josué|strong="H3091"\w*, y comenzaron \w a|strong="H3068"\w* \w subir|strong="H5927"\w* \w a|strong="H3068"\w* la montaña de Dios.  
\v 14 \w Antes|strong="H5704"\w* \w de|strong="H5973"\w* irse, Moisés \w les|strong="H5973"\w* dijo \w a|strong="H3068"\w* \w los|strong="H3427"\w* líderes: “Espérennos \w aquí|strong="H2009"\w* \w hasta|strong="H5704"\w* \w que|strong="H4310"\w* regresemos. Aarón \w y|strong="H5704"\w* \w Hur|strong="H2354"\w* se \w quedarán|strong="H3427"\w* \w con|strong="H5973"\w* ustedes. \w Si|strong="H2009"\w* alguien tiene algún problema legal, \w que|strong="H4310"\w* vaya \w con|strong="H5973"\w* ellos”.   
\p
\v 15 Cuando \w Moisés|strong="H4872"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* la montaña, una \w nube|strong="H6051"\w* la \w cubrió|strong="H3680"\w* por completo.  
\v 16 \w La|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé descansó \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sinaí|strong="H5514"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w* \w lo|strong="H5921"\w* \w cubrió|strong="H3680"\w* durante \w seis|strong="H8337"\w* \w días|strong="H3117"\w*. \w Al|strong="H5921"\w* \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w*, Yahvé \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w desde|strong="H5921"\w* adentro \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w*.  
\v 17 Para \w los|strong="H1121"\w* israelitas \w que|strong="H1121"\w* observaban desde abajo, la \w gloria|strong="H3519"\w* \w de|strong="H1121"\w* Yahvé \w parecía|strong="H5869"\w* un fuego \w que|strong="H1121"\w* consumía la cima \w de|strong="H1121"\w* la montaña.  
\v 18 \w Moisés|strong="H4872"\w* \w se|strong="H1961"\w* metió \w en|strong="H8432"\w* la \w nube|strong="H6051"\w* y \w subió|strong="H5927"\w* \w a|strong="H3068"\w* lo más alto de la montaña. \w Y|strong="H3068"\w* allí \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w Moisés|strong="H4872"\w* durante cuarenta \w días|strong="H3117"\w* y cuarenta \w noches|strong="H3915"\w*.   
\c 25  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y le \w dijo|strong="H1696"\w*:  
\v 2 “\w Diles|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H1121"\w* me \w traigan|strong="H3947"\w* una \w ofrenda|strong="H8641"\w*. Recibirán mi \w ofrenda|strong="H8641"\w* \w de|strong="H1121"\w* \w cualquier|strong="H3605"\w* persona \w que|strong="H1121"\w* \w la|strong="H3605"\w* \w dé|strong="H1121"\w* \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*.  
\v 3 \w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w ofrenda|strong="H8641"\w* que recibirán de ellos: \w oro|strong="H2091"\w*, \w plata|strong="H3701"\w*, bronce,  
\v 4 hilo azul, púrpura, escarlata, lino fino, pelo de \w cabra|strong="H5795"\w*,  
\v 5 pieles de carnero teñidas de rojo, cueros finos,\f + \fr 25:5 \ft Un codo es la distancia desde el codo hasta la punta del dedo medio de un hombre, es decir, unos 46 centímetros.\f* \w madera|strong="H6086"\w* de acacia,  
\v 6 \w aceite|strong="H8081"\w* para las lámparas, \w especias|strong="H1314"\w* para el \w aceite|strong="H8081"\w* de la \w unción|strong="H4888"\w* y para el incienso \w aromático|strong="H5561"\w*,  
\v 7 y piedras de ónice y otras piedras preciosas para engastarlas en el efod y en el pectoral.  
\v 8 Que me construyan un \w santuario|strong="H4720"\w*, para que \w yo|strong="H6213"\w* viva \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de ellos.  
\v 9 Deberán construir \w el|strong="H3605"\w* santuario y \w todos|strong="H3605"\w* sus muebles exactamente igual al modelo \w que|strong="H3605"\w* te voy \w a|strong="H3068"\w* mostrar.   
\p
\v 10 “\w Harán|strong="H6213"\w* un arca de \w madera|strong="H6086"\w* de acacia. Su largo \w será|strong="H6213"\w* de un metro con quince centímetros, y su ancho y su alto serán de casi setenta centímetros.  
\v 11 \w La|strong="H5921"\w* recubrirás \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* \w por|strong="H5921"\w* \w dentro|strong="H5921"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w fuera|strong="H2351"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* pondrás una moldura \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w alrededor|strong="H5439"\w*.  
\v 12 Harás cuatro argollas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* cuatro patas: \w dos|strong="H8147"\w* argollas \w en|strong="H5921"\w* un \w lado|strong="H6763"\w* \w y|strong="H5921"\w* \w dos|strong="H8147"\w* argollas \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w otro|strong="H8145"\w* \w lado|strong="H6763"\w*.  
\v 13 \w Harás|strong="H6213"\w* unas varas de \w madera|strong="H6086"\w* de acacia y las recubrirás de \w oro|strong="H2091"\w*.  
\v 14 Meterás \w las|strong="H5921"\w* varas \w por|strong="H5921"\w* \w las|strong="H5921"\w* argollas \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w lados|strong="H6763"\w* \w del|strong="H5921"\w* arca, \w para|strong="H5921"\w* \w que|strong="H5921"\w* puedan cargarla.  
\v 15 Las varas \w se|strong="H1961"\w* dejarán puestas \w en|strong="H4480"\w* las argollas \w del|strong="H4480"\w* arca; \w no|strong="H3808"\w* \w se|strong="H1961"\w* las quitarán.  
\v 16 Adentro del arca \w pondrás|strong="H5414"\w* las tablas del pacto que yo te \w daré|strong="H5414"\w*.  
\v 17 \w Harás|strong="H6213"\w* una tapa de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* que servirá de propiciatorio. Su largo \w será|strong="H6213"\w* de un metro con quince centímetros y su ancho de casi setenta centímetros.  
\v 18 \w Harás|strong="H6213"\w* \w dos|strong="H8147"\w* \w querubines|strong="H3742"\w* de \w oro|strong="H2091"\w* trabajado \w a|strong="H3068"\w* martillo y los pondrás en los \w dos|strong="H8147"\w* extremos del propiciatorio.  
\v 19 \w Haz|strong="H6213"\w* un \w querubín|strong="H3742"\w* \w en|strong="H5921"\w* un extremo \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w otro|strong="H2088"\w* \w querubín|strong="H3742"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w otro|strong="H2088"\w* extremo. \w Los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* propiciatorio formarán una sola pieza.  
\v 20 \w Los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w tendrán|strong="H1961"\w* \w las|strong="H5921"\w* \w alas|strong="H3671"\w* \w extendidas|strong="H6566"\w* \w hacia|strong="H5921"\w* \w arriba|strong="H4605"\w*, \w cubriendo|strong="H5526"\w* \w el|strong="H5921"\w* propiciatorio \w con|strong="H5921"\w* \w ellas|strong="H5921"\w*. \w Estarán|strong="H1961"\w* uno frente \w al|strong="H5921"\w* otro, mirando \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* propiciatorio.  
\v 21 \w Pondrás|strong="H5414"\w* \w el|strong="H5921"\w* propiciatorio \w como|strong="H5921"\w* tapa \w encima|strong="H4605"\w* \w del|strong="H5921"\w* arca, \w y|strong="H5921"\w* adentro \w del|strong="H5921"\w* arca \w pondrás|strong="H5414"\w* \w las|strong="H5921"\w* tablas \w del|strong="H5921"\w* pacto \w que|strong="H5921"\w* yo \w te|strong="H5921"\w* \w daré|strong="H5414"\w*.  
\v 22 \w Allí|strong="H8033"\w* \w me|strong="H5921"\w* reuniré \w contigo|strong="H5921"\w*, \w y|strong="H5921"\w* \w desde|strong="H5921"\w* \w encima|strong="H5921"\w* \w del|strong="H5921"\w* propiciatorio, \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w querubines|strong="H3742"\w* \w que|strong="H5921"\w* están \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* pacto, \w te|strong="H5921"\w* daré \w todas|strong="H3605"\w* mis órdenes \w para|strong="H5921"\w* \w los|strong="H1121"\w* israelitas.   
\p
\v 23 “\w Harás|strong="H6213"\w* \w también|strong="H7979"\w* una \w mesa|strong="H7979"\w* de \w madera|strong="H6086"\w* de acacia. Su largo \w será|strong="H6213"\w* de casi un metro, su ancho de cuarenta y cinco centímetros, y su alto de casi setenta centímetros.  
\v 24 La recubrirás de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* y le pondrás una moldura de \w oro|strong="H2091"\w* \w alrededor|strong="H5439"\w*.  
\v 25 Le \w harás|strong="H6213"\w* un borde \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w* del ancho de una mano, y le pondrás una moldura de \w oro|strong="H2091"\w* \w a|strong="H3068"\w* \w todo|strong="H5439"\w* \w el|strong="H6213"\w* borde.  
\v 26 \w Le|strong="H5921"\w* \w harás|strong="H6213"\w* cuatro argollas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* cuatro \w esquinas|strong="H6285"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* cuatro patas.  
\v 27 Las argollas deberán estar cerca del borde, \w para|strong="H1961"\w* pasar por ellas las varas y así poder cargar la \w mesa|strong="H7979"\w*.  
\v 28 \w Harás|strong="H6213"\w* las varas de \w madera|strong="H6086"\w* de acacia y las recubrirás de \w oro|strong="H2091"\w*, para que la \w mesa|strong="H7979"\w* pueda ser transportada.  
\v 29 También \w harás|strong="H6213"\w* de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* sus \w platos|strong="H7086"\w*, sus \w cucharas|strong="H3709"\w*, sus jarras y sus tazones para derramar las \w ofrendas|strong="H5258"\w* de vino.  
\v 30 \w Y|strong="H3068"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w pondrás|strong="H5414"\w* \w siempre|strong="H8548"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w el|strong="H5921"\w* \w pan|strong="H3899"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w presencia|strong="H6440"\w*.   
\p
\v 31 “\w Harás|strong="H6213"\w* un candelabro \w de|strong="H4480"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*. \w El|strong="H6213"\w* candelabro y su base deberán ser trabajados \w a|strong="H3068"\w* martillo. Su tronco, sus \w brazos|strong="H7070"\w*, sus \w copas|strong="H1375"\w*, sus botones y sus \w flores|strong="H6525"\w* formarán una sola pieza.  
\v 32 De los \w lados|strong="H6654"\w* del candelabro \w saldrán|strong="H3318"\w* \w seis|strong="H8337"\w* \w brazos|strong="H7070"\w*: \w tres|strong="H7969"\w* \w brazos|strong="H7070"\w* de un \w lado|strong="H6654"\w* y \w tres|strong="H7969"\w* \w brazos|strong="H7070"\w* del \w otro|strong="H8145"\w* \w lado|strong="H6654"\w*.  
\v 33 Cada uno \w de|strong="H4480"\w* los \w seis|strong="H8337"\w* \w brazos|strong="H7070"\w* \w que|strong="H4480"\w* \w salen|strong="H3318"\w* \w del|strong="H4480"\w* candelabro tendrá \w tres|strong="H7969"\w* \w copas|strong="H1375"\w* \w en|strong="H4480"\w* forma \w de|strong="H4480"\w* \w flor|strong="H6525"\w* \w de|strong="H4480"\w* almendro, \w con|strong="H4480"\w* su botón y su \w flor|strong="H6525"\w*.  
\v 34 El tronco del candelabro tendrá cuatro \w copas|strong="H1375"\w* en forma de \w flor|strong="H6525"\w* de almendro, con sus botones y sus \w flores|strong="H6525"\w*:  
\v 35 un botón \w debajo|strong="H8478"\w* \w del|strong="H4480"\w* primer par \w de|strong="H4480"\w* \w brazos|strong="H7070"\w*, un botón \w debajo|strong="H8478"\w* \w del|strong="H4480"\w* \w segundo|strong="H8147"\w* par \w de|strong="H4480"\w* \w brazos|strong="H7070"\w*, y un botón \w debajo|strong="H8478"\w* \w del|strong="H4480"\w* tercer par \w de|strong="H4480"\w* \w brazos|strong="H7070"\w*; todos formando una sola pieza \w con|strong="H4480"\w* el candelabro.  
\v 36 \w Los|strong="H3605"\w* botones y \w los|strong="H3605"\w* \w brazos|strong="H7070"\w* formarán una sola pieza \w con|strong="H4480"\w* \w el|strong="H3605"\w* candelabro, y \w todo|strong="H3605"\w* \w será|strong="H1961"\w* \w hecho|strong="H1961"\w* \w de|strong="H4480"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*, trabajado \w a|strong="H3068"\w* martillo.  
\v 37 \w Harás|strong="H6213"\w* \w siete|strong="H7651"\w* \w lámparas|strong="H5216"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* candelabro \w y|strong="H5921"\w* \w las|strong="H5921"\w* acomodarás \w de|strong="H5921"\w* tal manera \w que|strong="H5921"\w* alumbren \w hacia|strong="H6213"\w* \w el|strong="H5921"\w* frente.  
\v 38 Sus tijeras para las mechas y sus platillos también serán de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*.  
\v 39 Para \w hacer|strong="H6213"\w* \w el|strong="H3605"\w* candelabro y \w todos|strong="H3605"\w* sus accesorios se usarán unos treinta y cuatro kilos de \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*.  
\v 40 Asegúrate de hacerlo todo exactamente como se te \w mostró|strong="H7200"\w* en la montaña.   
\c 26  
\p
\v 1 “Construirás \w el|strong="H6213"\w* santuario con \w diez|strong="H6235"\w* \w cortinas|strong="H3407"\w* \w de|strong="H3407"\w* lino fino \w torcido|strong="H7806"\w*, \w de|strong="H3407"\w* color azul, púrpura y escarlata. Un artesano experto deberá bordarles figuras \w de|strong="H3407"\w* \w querubines|strong="H3742"\w*.  
\v 2 \w Todas|strong="H3605"\w* las \w cortinas|strong="H3407"\w* medirán \w lo|strong="H3605"\w* \w mismo|strong="H3605"\w*: trece metros \w de|strong="H3407"\w* largo por casi dos metros \w de|strong="H3407"\w* ancho.  
\v 3 Vas \w a|strong="H3068"\w* coser \w cinco|strong="H2568"\w* \w de|strong="H3407"\w* estas \w cortinas|strong="H3407"\w* \w juntas|strong="H2266"\w*, y harás lo mismo con las otras \w cinco|strong="H2568"\w*.  
\v 4 \w Harás|strong="H6213"\w* unos ojales \w de|strong="H5921"\w* hilo azul \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w que|strong="H5921"\w* queda \w al|strong="H5921"\w* extremo \w del|strong="H5921"\w* primer conjunto, \w y|strong="H5921"\w* \w harás|strong="H6213"\w* \w lo|strong="H5921"\w* mismo \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w que|strong="H5921"\w* queda \w al|strong="H5921"\w* extremo \w del|strong="H5921"\w* \w segundo|strong="H8145"\w* conjunto.  
\v 5 \w Harás|strong="H6213"\w* \w cincuenta|strong="H2572"\w* ojales en la primera \w cortina|strong="H3407"\w*, y \w cincuenta|strong="H2572"\w* ojales en la orilla \w de|strong="H3407"\w* la \w otra|strong="H8145"\w* \w cortina|strong="H3407"\w*, \w de|strong="H3407"\w* modo que los ojales queden frente \w a|strong="H3068"\w* frente.  
\v 6 Luego \w harás|strong="H6213"\w* \w cincuenta|strong="H2572"\w* ganchos \w de|strong="H3407"\w* \w oro|strong="H2091"\w* \w para|strong="H1961"\w* unir las dos \w cortinas|strong="H3407"\w* y \w que|strong="H1961"\w* \w el|strong="H6213"\w* santuario forme una sola pieza.   
\p
\v 7 “\w Harás|strong="H6213"\w* \w once|strong="H6249"\w* \w cortinas|strong="H3407"\w* \w de|strong="H5921"\w* pelo \w de|strong="H5921"\w* \w cabra|strong="H5795"\w* \w para|strong="H5921"\w* formar una carpa \w que|strong="H5921"\w* cubra \w el|strong="H5921"\w* santuario.  
\v 8 Todas las \w once|strong="H6249"\w* \w cortinas|strong="H3407"\w* medirán lo mismo: catorce metros \w de|strong="H3407"\w* largo por casi dos metros \w de|strong="H3407"\w* ancho.  
\v 9 Vas \w a|strong="H3068"\w* unir \w cinco|strong="H2568"\w* \w de|strong="H6440"\w* estas \w cortinas|strong="H3407"\w* \w por|strong="H6440"\w* un lado, y las otras \w seis|strong="H8337"\w* \w por|strong="H6440"\w* el otro, doblando la sexta \w cortina|strong="H3407"\w* \w hacia|strong="H6440"\w* el frente \w de|strong="H6440"\w* la carpa.  
\v 10 \w Harás|strong="H6213"\w* \w cincuenta|strong="H2572"\w* ojales \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w que|strong="H5921"\w* cierra \w el|strong="H5921"\w* primer conjunto, \w y|strong="H5921"\w* otros \w cincuenta|strong="H2572"\w* ojales \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w que|strong="H5921"\w* cierra \w el|strong="H5921"\w* \w segundo|strong="H8145"\w* conjunto.  
\v 11 Luego \w harás|strong="H6213"\w* \w cincuenta|strong="H2572"\w* ganchos de bronce y \w los|strong="H1961"\w* meterás en \w los|strong="H1961"\w* ojales \w para|strong="H1961"\w* unir la carpa y \w que|strong="H1961"\w* forme una sola pieza.  
\v 12 \w La|strong="H5921"\w* \w parte|strong="H2677"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cortina|strong="H3407"\w* \w que|strong="H5921"\w* \w sobre|strong="H5921"\w*, es decir, \w la|strong="H5921"\w* mitad \w que|strong="H5921"\w* cuelga, caerá \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w parte|strong="H2677"\w* \w de|strong="H5921"\w* atrás \w del|strong="H5921"\w* santuario.  
\v 13 \w Y|strong="H3068"\w* \w los|strong="H5921"\w* cuarenta \w y|strong="H5921"\w* cinco centímetros \w que|strong="H5921"\w* sobren \w de|strong="H5921"\w* largo \w a|strong="H3068"\w* cada \w lado|strong="H6654"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w cortinas|strong="H3407"\w* colgarán \w para|strong="H5921"\w* proteger \w los|strong="H5921"\w* \w costados|strong="H6654"\w* \w del|strong="H5921"\w* santuario.  
\v 14 \w Harás|strong="H6213"\w* una cubierta para la carpa de pieles de carnero teñidas de rojo, y \w otra|strong="H6213"\w* cubierta de cueros finos para ponerla por \w encima|strong="H4605"\w*.   
\p
\v 15 “\w Harás|strong="H6213"\w* \w tablas|strong="H7175"\w* de \w madera|strong="H6086"\w* de acacia para formar las paredes del santuario.  
\v 16 \w Cada|strong="H6235"\w* \w tabla|strong="H7175"\w* medirá cuatro metros y \w medio|strong="H2677"\w* de largo, por setenta centímetros de ancho.  
\v 17 \w Cada|strong="H3605"\w* \w tabla|strong="H7175"\w* tendrá \w dos|strong="H8147"\w* espigas paralelas para \w que|strong="H3605"\w* encajen unas con otras. \w Así|strong="H3651"\w* \w harás|strong="H6213"\w* \w todas|strong="H3605"\w* las \w tablas|strong="H7175"\w* del santuario.  
\v 18 \w Harás|strong="H6213"\w* \w veinte|strong="H6242"\w* \w tablas|strong="H7175"\w* para \w el|strong="H6213"\w* \w lado|strong="H6285"\w* sur del santuario,  
\v 19 y \w harás|strong="H6213"\w* cuarenta bases \w de|strong="H8478"\w* \w plata|strong="H3701"\w* para ponerlas \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* las \w veinte|strong="H6242"\w* \w tablas|strong="H7175"\w*: \w dos|strong="H8147"\w* bases \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* cada \w tabla|strong="H7175"\w* para \w que|strong="H3027"\w* encajen sus \w dos|strong="H8147"\w* espigas.  
\v 20 Para el \w lado|strong="H6763"\w* \w norte|strong="H6828"\w* del santuario harás otras \w veinte|strong="H6242"\w* \w tablas|strong="H7175"\w*,  
\v 21 con sus cuarenta bases \w de|strong="H8478"\w* \w plata|strong="H3701"\w*: \w dos|strong="H8147"\w* bases \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* cada \w tabla|strong="H7175"\w*.  
\v 22 Para la parte de atrás del santuario, que da al oeste, \w harás|strong="H6213"\w* \w seis|strong="H8337"\w* \w tablas|strong="H7175"\w*.  
\v 23 Además, \w harás|strong="H6213"\w* \w dos|strong="H8147"\w* \w tablas|strong="H7175"\w* para las esquinas traseras del santuario.  
\v 24 Estas tablas \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w esquinas|strong="H4740"\w* \w estarán|strong="H1961"\w* unidas \w por|strong="H5921"\w* \w abajo|strong="H4295"\w* \w y|strong="H5921"\w* \w también|strong="H3162"\w* \w por|strong="H5921"\w* \w arriba|strong="H7218"\w*, \w hasta|strong="H5921"\w* \w la|strong="H5921"\w* primera argolla. \w Así|strong="H3651"\w* \w se|strong="H1961"\w* harán \w las|strong="H5921"\w* tablas \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w esquinas|strong="H4740"\w*.  
\v 25 \w En|strong="H8478"\w* total \w serán|strong="H1961"\w* \w ocho|strong="H8083"\w* \w tablas|strong="H7175"\w* con sus \w dieciséis|strong="H8337"\w* bases \w de|strong="H8478"\w* \w plata|strong="H3701"\w*: \w dos|strong="H8147"\w* bases \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* cada \w tabla|strong="H7175"\w*.   
\p
\v 26 “\w Harás|strong="H6213"\w* unos travesaños \w de|strong="H2568"\w* \w madera|strong="H6086"\w* \w de|strong="H2568"\w* acacia: \w cinco|strong="H2568"\w* para las \w tablas|strong="H7175"\w* \w de|strong="H2568"\w* un \w lado|strong="H6763"\w* del santuario,  
\v 27 \w cinco|strong="H2568"\w* para las \w tablas|strong="H7175"\w* del \w otro|strong="H8145"\w* \w lado|strong="H6763"\w*, y \w cinco|strong="H2568"\w* para las \w tablas|strong="H7175"\w* \w de|strong="H2568"\w* la parte trasera, del \w lado|strong="H6763"\w* oeste.  
\v 28 El travesaño \w del|strong="H4480"\w* \w medio|strong="H8432"\w* \w pasará|strong="H1272"\w* \w por|strong="H4480"\w* el centro \w de|strong="H4480"\w* las \w tablas|strong="H7175"\w*, \w de|strong="H4480"\w* un \w extremo|strong="H7097"\w* \w al|strong="H4480"\w* \w otro|strong="H7097"\w*.  
\v 29 Recubrirás de \w oro|strong="H2091"\w* las \w tablas|strong="H7175"\w*, y \w harás|strong="H6213"\w* argollas de \w oro|strong="H2091"\w* por donde pasarán los travesaños. También recubrirás de \w oro|strong="H2091"\w* los travesaños.  
\v 30 Armarás el santuario exactamente como se te \w mostró|strong="H7200"\w* en la montaña.   
\p
\v 31 “\w Harás|strong="H6213"\w* un velo de lino fino \w torcido|strong="H7806"\w*, de color azul, púrpura y escarlata, y un artesano experto le bordará \w querubines|strong="H3742"\w*.  
\v 32 \w Lo|strong="H5921"\w* colgarás \w de|strong="H5921"\w* unos ganchos \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w sobre|strong="H5921"\w* cuatro postes \w de|strong="H5921"\w* madera \w de|strong="H5921"\w* acacia recubiertos \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w que|strong="H5921"\w* estarán apoyados \w sobre|strong="H5921"\w* cuatro bases \w de|strong="H5921"\w* \w plata|strong="H3701"\w*.  
\v 33 Colgarás el velo \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* los ganchos, y \w allí|strong="H8033"\w*, detrás del velo, \w pondrás|strong="H5414"\w* el arca del pacto. Este velo servirá \w para|strong="H5414"\w* separar el \w Lugar|strong="H8478"\w* \w Santo|strong="H6944"\w* del \w Lugar|strong="H8478"\w* \w Santísimo|strong="H6944"\w*.  
\v 34 \w Pondrás|strong="H5414"\w* \w el|strong="H5921"\w* propiciatorio \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* pacto \w en|strong="H5921"\w* \w el|strong="H5921"\w* Lugar \w Santísimo|strong="H6944"\w*.  
\v 35 \w Afuera|strong="H2351"\w* \w del|strong="H5921"\w* velo \w pondrás|strong="H5414"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* candelabro \w lo|strong="H5921"\w* \w pondrás|strong="H5414"\w* frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w*. \w El|strong="H5921"\w* candelabro irá \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w lado|strong="H6763"\w* sur \w del|strong="H5921"\w* santuario, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w mesa|strong="H7979"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w lado|strong="H6763"\w* \w norte|strong="H6828"\w*.   
\p
\v 36 “\w Harás|strong="H6213"\w* una cortina para la entrada de la carpa. \w Será|strong="H6213"\w* de lino fino \w torcido|strong="H7806"\w*, de color azul, púrpura y escarlata, y estará finamente bordada.  
\v 37 Para colgar esta cortina \w harás|strong="H6213"\w* \w cinco|strong="H2568"\w* postes \w de|strong="H2568"\w* acacia recubiertos \w de|strong="H2568"\w* \w oro|strong="H2091"\w*. Sus ganchos serán \w de|strong="H2568"\w* \w oro|strong="H2091"\w*, y fundirás para ellos \w cinco|strong="H2568"\w* bases \w de|strong="H2568"\w* bronce.   
\c 27  
\p
\v 1 “\w Harás|strong="H6213"\w* un \w altar|strong="H4196"\w* \w de|strong="H2568"\w* \w madera|strong="H6086"\w* \w de|strong="H2568"\w* acacia, \w que|strong="H1961"\w* \w sea|strong="H1961"\w* \w cuadrado|strong="H7251"\w*. Medirá dos metros y medio \w de|strong="H2568"\w* largo por dos metros y medio \w de|strong="H2568"\w* ancho, y \w tendrá|strong="H1961"\w* un metro y medio \w de|strong="H2568"\w* alto. \f + \fr 27:1 \ft Literalmente: cinco codos de largo, cinco de ancho y tres de alto.\f*  
\v 2 \w Le|strong="H5921"\w* \w harás|strong="H6213"\w* un \w cuerno|strong="H7161"\w* \w en|strong="H5921"\w* cada una \w de|strong="H4480"\w* sus cuatro \w esquinas|strong="H6438"\w*, \w de|strong="H4480"\w* manera \w que|strong="H4480"\w* \w los|strong="H5921"\w* \w cuernos|strong="H7161"\w* formen una sola pieza \w con|strong="H5921"\w* \w el|strong="H5921"\w* altar, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* recubrirás todo \w de|strong="H4480"\w* bronce.  
\v 3 \w Harás|strong="H6213"\w* de bronce \w todos|strong="H3605"\w* sus utensilios: \w los|strong="H3605"\w* recipientes para las cenizas, las palas, \w los|strong="H3605"\w* \w tazones|strong="H4219"\w*, \w los|strong="H3605"\w* tenedores y \w los|strong="H3605"\w* braseros.  
\v 4 \w Le|strong="H5921"\w* \w harás|strong="H6213"\w* una rejilla \w de|strong="H5921"\w* bronce \w en|strong="H5921"\w* forma \w de|strong="H5921"\w* \w red|strong="H7568"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* pondrás cuatro argollas \w de|strong="H5921"\w* bronce \w en|strong="H5921"\w* \w las|strong="H5921"\w* cuatro \w esquinas|strong="H7098"\w*.  
\v 5 Colocarás la rejilla \w por|strong="H8478"\w* \w debajo|strong="H8478"\w* \w del|strong="H4196"\w* borde \w del|strong="H4196"\w* \w altar|strong="H4196"\w*, \w de|strong="H8478"\w* manera \w que|strong="H5704"\w* llegue \w hasta|strong="H5704"\w* la mitad \w del|strong="H4196"\w* \w altar|strong="H4196"\w*.  
\v 6 \w Harás|strong="H6213"\w* unas varas de \w madera|strong="H6086"\w* de acacia y las recubrirás de bronce.  
\v 7 Estas varas \w se|strong="H1961"\w* meterán \w por|strong="H5921"\w* \w las|strong="H5921"\w* argollas \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w lados|strong="H6763"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w* \w para|strong="H5921"\w* poder transportarlo.  
\v 8 \w El|strong="H6213"\w* altar \w será|strong="H6213"\w* \w hueco|strong="H5014"\w* y estará \w hecho|strong="H6213"\w* de \w tablas|strong="H3871"\w*, \w tal|strong="H3651"\w* \w como|strong="H3651"\w* \w se|strong="H3651"\w* te \w mostró|strong="H7200"\w* en la montaña.   
\p
\v 9 “\w Harás|strong="H6213"\w* un \w patio|strong="H2691"\w* alrededor del santuario. \w El|strong="H6213"\w* \w lado|strong="H6285"\w* sur del \w patio|strong="H2691"\w* medirá cuarenta y cinco metros de largo, y tendrá \w cortinas|strong="H7050"\w* de lino fino \w torcido|strong="H7806"\w*.  
\v 10 Tendrá \w veinte|strong="H6242"\w* postes apoyados sobre \w veinte|strong="H6242"\w* bases de bronce; pero los ganchos y las uniones de los postes serán de \w plata|strong="H3701"\w*.  
\v 11 El \w lado|strong="H6285"\w* \w norte|strong="H6828"\w* \w también|strong="H3651"\w* medirá cuarenta y cinco metros de largo, con \w cortinas|strong="H7050"\w* colgadas de \w veinte|strong="H6242"\w* postes sobre \w veinte|strong="H6242"\w* bases de bronce. Los ganchos y las uniones de los postes serán de \w plata|strong="H3701"\w*.  
\v 12 El \w lado|strong="H6285"\w* oeste del \w patio|strong="H2691"\w* medirá veintidós metros y medio de ancho, y tendrá \w cortinas|strong="H7050"\w* colgadas de \w diez|strong="H6235"\w* postes sobre \w diez|strong="H6235"\w* bases.  
\v 13 El \w lado|strong="H6285"\w* \w este|strong="H4217"\w* del \w patio|strong="H2691"\w*, por donde sale el sol, también medirá veintidós metros y medio de ancho.  
\v 14 \w A|strong="H3068"\w* un \w lado|strong="H3802"\w* \w de|strong="H2568"\w* la entrada habrá \w cortinas|strong="H7050"\w* \w a|strong="H3068"\w* lo largo \w de|strong="H2568"\w* casi siete metros, colgadas \w de|strong="H2568"\w* \w tres|strong="H7969"\w* postes sobre \w tres|strong="H7969"\w* bases.  
\v 15 Al \w otro|strong="H8145"\w* \w lado|strong="H3802"\w* también habrá \w cortinas|strong="H7050"\w* \w a|strong="H3068"\w* lo largo \w de|strong="H2568"\w* casi siete metros, colgadas \w de|strong="H2568"\w* \w tres|strong="H7969"\w* postes sobre \w tres|strong="H7969"\w* bases.  
\v 16 La entrada del \w patio|strong="H2691"\w* tendrá una cortina de nueve metros de largo, hecha de lino fino \w torcido|strong="H7806"\w*, de color azul, púrpura y escarlata, finamente bordada. Estará colgada de cuatro postes sobre cuatro bases.  
\v 17 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* postes \w alrededor|strong="H5439"\w* del \w patio|strong="H2691"\w* estarán unidos con barras de \w plata|strong="H3701"\w*; sus ganchos serán de \w plata|strong="H3701"\w* y sus bases de bronce.  
\v 18 El \w patio|strong="H2691"\w* medirá cuarenta y \w cinco|strong="H2568"\w* metros \w de|strong="H2568"\w* largo por veintidós y medio \w de|strong="H2568"\w* ancho. Las cortinas \w de|strong="H2568"\w* lino fino medirán poco más \w de|strong="H2568"\w* dos metros \w de|strong="H2568"\w* alto, y las bases serán \w de|strong="H2568"\w* bronce.  
\v 19 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* utensilios para \w el|strong="H3605"\w* servicio del santuario, así como las estacas del santuario y las estacas del \w patio|strong="H2691"\w*, serán de bronce.   
\p
\v 20 “Mándales \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas \w que|strong="H1121"\w* te \w traigan|strong="H3947"\w* \w el|strong="H1121"\w* mejor \w aceite|strong="H8081"\w* \w de|strong="H1121"\w* oliva para las \w lámparas|strong="H5216"\w*, para \w que|strong="H1121"\w* \w siempre|strong="H8548"\w* haya una \w lámpara|strong="H5216"\w* encendida.  
\v 21 Aarón \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* deberán mantener \w las|strong="H5921"\w* lámparas encendidas \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé \w desde|strong="H5704"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w* \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w*. Esto \w se|strong="H5921"\w* hará \w en|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w de|strong="H5921"\w* Reunión, \w afuera|strong="H2351"\w* \w del|strong="H5921"\w* velo \w que|strong="H5921"\w* protege \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* pacto. \w Los|strong="H1121"\w* israelitas \w y|strong="H5921"\w* sus descendientes deberán cumplir \w con|strong="H5921"\w* \w esta|strong="H5921"\w* ley \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.   
\c 28  
\p
\v 1 “\w De|strong="H1121"\w* \w entre|strong="H8432"\w* todos \w los|strong="H1121"\w* israelitas, llama \w a|strong="H3068"\w* tu hermano Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w Nadab|strong="H5070"\w*, Abiú, Eleazar \w e|strong="H3068"\w* Itamar, para \w que|strong="H1121"\w* me sirvan como sacerdotes.  
\v 2 Manda \w a|strong="H3068"\w* \w hacerle|strong="H6213"\w* \w a|strong="H3068"\w* \w tu|strong="H6213"\w* hermano Aarón ropas \w sagradas|strong="H6944"\w*, que le den \w honra|strong="H3519"\w* \w y|strong="H3519"\w* belleza.  
\v 3 \w Habla|strong="H1696"\w* con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* artesanos expertos, \w a|strong="H3068"\w* quienes les he dado \w la|strong="H3605"\w* habilidad para \w hacer|strong="H6213"\w* \w estos|strong="H3605"\w* trabajos, y pídeles \w que|strong="H3605"\w* le \w hagan|strong="H6213"\w* las ropas \w a|strong="H3068"\w* Aarón. \w Así|strong="H1696"\w* \w será|strong="H6213"\w* consagrado para \w que|strong="H3605"\w* me sirva como sacerdote.  
\v 4 \w Estas|strong="H6213"\w* son las ropas \w que|strong="H1121"\w* deberán \w hacerle|strong="H6213"\w*: un pectoral, un efod, un \w manto|strong="H4598"\w*, una túnica bordada, un turbante y un cinturón. \w Harán|strong="H6213"\w* \w estas|strong="H6213"\w* ropas \w sagradas|strong="H6944"\w* para \w tu|strong="H6213"\w* hermano Aarón y para sus \w hijos|strong="H1121"\w*, para \w que|strong="H1121"\w* me sirvan como sacerdotes.  
\v 5 Deberán usar hilo de \w oro|strong="H2091"\w*, y lino fino de color azul, púrpura y escarlata.   
\p
\v 6 “\w El|strong="H6213"\w* efod \w lo|strong="H6213"\w* \w harán|strong="H6213"\w* de hilo de \w oro|strong="H2091"\w*, de lino fino de color azul, púrpura y escarlata, \w obra|strong="H4639"\w* de un artesano experto.  
\v 7 \w Tendrá|strong="H1961"\w* \w dos|strong="H8147"\w* tirantes unidos \w a|strong="H3068"\w* sus \w esquinas|strong="H7098"\w* \w para|strong="H1961"\w* poder sujetarlo.  
\v 8 \w El|strong="H5921"\w* cinturón \w que|strong="H4480"\w* \w va|strong="H3068"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* efod formará una sola pieza \w con|strong="H5921"\w* \w él|strong="H5921"\w*, \w y|strong="H5921"\w* \w estará|strong="H1961"\w* \w hecho|strong="H4639"\w* \w del|strong="H4480"\w* mismo material: hilo \w de|strong="H4480"\w* \w oro|strong="H2091"\w*, \w y|strong="H5921"\w* lino fino \w de|strong="H4480"\w* color azul, púrpura \w y|strong="H5921"\w* escarlata.  
\v 9 \w Tomarás|strong="H3947"\w* \w dos|strong="H8147"\w* piedras \w de|strong="H5921"\w* ónice \w y|strong="H5921"\w* grabarás \w en|strong="H5921"\w* \w ellas|strong="H5921"\w* \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tribus \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 10 Grabarás \w seis|strong="H8337"\w* \w nombres|strong="H8034"\w* \w en|strong="H5921"\w* una piedra, \w y|strong="H5921"\w* \w los|strong="H5921"\w* otros \w seis|strong="H8337"\w* \w nombres|strong="H8034"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w otra|strong="H8145"\w* piedra, \w en|strong="H5921"\w* \w el|strong="H5921"\w* orden \w en|strong="H5921"\w* \w que|strong="H5921"\w* nacieron.  
\v 11 \w Las|strong="H5921"\w* grabarás \w con|strong="H5921"\w* \w el|strong="H5921"\w* mismo cuidado \w que|strong="H5921"\w* un joyero graba un sello, \w y|strong="H5921"\w* luego \w las|strong="H5921"\w* montarás \w en|strong="H5921"\w* \w engastes|strong="H4865"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.  
\v 12 Sujetarás estas \w dos|strong="H8147"\w* piedras \w en|strong="H5921"\w* \w los|strong="H1121"\w* tirantes \w del|strong="H5921"\w* efod, \w para|strong="H5921"\w* \w que|strong="H5921"\w* sirvan \w de|strong="H5921"\w* \w recuerdo|strong="H2146"\w* \w para|strong="H5921"\w* \w los|strong="H1121"\w* israelitas. Así Aarón \w llevará|strong="H5375"\w* \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w sobre|strong="H5921"\w* sus \w hombros|strong="H3802"\w* \w ante|strong="H6440"\w* Yahvé, \w para|strong="H5921"\w* recordarlos continuamente.  
\v 13 \w Harás|strong="H6213"\w* los \w engastes|strong="H4865"\w* de \w oro|strong="H2091"\w*,  
\v 14 \w y|strong="H5921"\w* \w dos|strong="H8147"\w* cadenas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* tejidas \w en|strong="H5921"\w* forma \w de|strong="H5921"\w* cordón, \w y|strong="H5921"\w* sujetarás \w estas|strong="H6213"\w* cadenas \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w engastes|strong="H4865"\w*.   
\p
\v 15 “\w También|strong="H2803"\w* \w harás|strong="H6213"\w* \w el|strong="H6213"\w* pectoral para dictar \w justicia|strong="H4941"\w*. \w Será|strong="H6213"\w* \w hecho|strong="H6213"\w* por un artesano experto, usando los mismos materiales que \w el|strong="H6213"\w* efod: hilo de \w oro|strong="H2091"\w*, y lino fino \w torcido|strong="H7806"\w* de color azul, púrpura y escarlata.  
\v 16 \w Será|strong="H1961"\w* \w cuadrado|strong="H7251"\w* y \w doble|strong="H3717"\w*; medirá una cuarta\f + \fr 28:16 \ft Una cuarta es la distancia que hay desde el pulgar hasta el meñique con la mano abierta, o sea unos 23 centímetros.\f* de largo por una cuarta de ancho.  
\v 17 Le pondrás cuatro hileras de piedras preciosas. En la primera hilera habrá un rubí, un \w topacio|strong="H6357"\w* y un berilo;  
\v 18 en la \w segunda|strong="H8145"\w* hilera, una turquesa, un zafiro y una esmeralda;  
\v 19 en la \w tercera|strong="H7992"\w* hilera, un jacinto, una ágata y una amatista;  
\v 20 y en la cuarta hilera, un \w crisólito|strong="H8658"\w*, un ónice y un jaspe. Todas estas piedras deberán estar montadas en \w oro|strong="H2091"\w*.  
\v 21 \w Serán|strong="H1961"\w* \w doce|strong="H8147"\w* piedras \w en|strong="H5921"\w* total, una \w por|strong="H5921"\w* cada \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* cada piedra \w tendrá|strong="H1961"\w* grabado \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* una \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w doce|strong="H8147"\w* \w tribus|strong="H7626"\w*, \w como|strong="H1961"\w* \w si|strong="H1961"\w* \w fuera|strong="H1961"\w* un sello.  
\v 22 \w Para|strong="H5921"\w* \w el|strong="H5921"\w* pectoral, \w harás|strong="H6213"\w* unas cadenas trenzadas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*, \w en|strong="H5921"\w* forma \w de|strong="H5921"\w* cordón.  
\v 23 \w Harás|strong="H6213"\w* también \w dos|strong="H8147"\w* argollas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w esquinas|strong="H7098"\w* superiores \w del|strong="H5921"\w* pectoral.  
\v 24 Luego engancharás \w las|strong="H5921"\w* \w dos|strong="H8147"\w* cadenas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* argollas \w que|strong="H5921"\w* están \w en|strong="H5921"\w* \w el|strong="H5921"\w* pectoral.  
\v 25 \w Los|strong="H5921"\w* otros \w dos|strong="H8147"\w* extremos \w de|strong="H5921"\w* \w las|strong="H5921"\w* cadenas \w los|strong="H5921"\w* sujetarás \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w engastes|strong="H4865"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* fijarás \w a|strong="H3068"\w* \w la|strong="H5921"\w* parte delantera \w de|strong="H5921"\w* \w los|strong="H5921"\w* tirantes \w del|strong="H5921"\w* efod.  
\v 26 \w Harás|strong="H6213"\w* otras \w dos|strong="H8147"\w* argollas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrás|strong="H7760"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w esquinas|strong="H7098"\w* inferiores \w del|strong="H5921"\w* pectoral, \w por|strong="H5921"\w* \w la|strong="H5921"\w* parte \w de|strong="H5921"\w* \w adentro|strong="H1004"\w* \w que|strong="H5921"\w* queda \w junto|strong="H5921"\w* \w al|strong="H5921"\w* efod.  
\v 27 \w Además|strong="H5921"\w*, \w harás|strong="H6213"\w* otras \w dos|strong="H8147"\w* argollas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* parte baja \w de|strong="H5921"\w* \w los|strong="H5921"\w* tirantes \w del|strong="H5921"\w* efod, \w por|strong="H5921"\w* \w el|strong="H5921"\w* frente, \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* costura \w y|strong="H5921"\w* un poco \w más|strong="H5921"\w* \w arriba|strong="H4605"\w* \w del|strong="H5921"\w* cinturón \w del|strong="H5921"\w* efod.  
\v 28 Amarrarán \w las|strong="H5921"\w* argollas \w del|strong="H5921"\w* pectoral \w a|strong="H3068"\w* \w las|strong="H5921"\w* argollas \w del|strong="H5921"\w* efod \w con|strong="H5921"\w* un cordón azul, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* pectoral \w quede|strong="H1961"\w* ajustado \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w del|strong="H5921"\w* cinturón \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* separe \w del|strong="H5921"\w* efod.  
\v 29 Así, cuando Aarón \w entre|strong="H5921"\w* \w al|strong="H5921"\w* Lugar \w Santo|strong="H6944"\w*, \w llevará|strong="H5375"\w* \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* tribus \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w sobre|strong="H5921"\w* su \w corazón|strong="H3820"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* pectoral \w de|strong="H5921"\w* \w justicia|strong="H4941"\w*, \w para|strong="H5921"\w* recordarlos \w siempre|strong="H8548"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé.  
\v 30 Adentro \w del|strong="H5921"\w* pectoral \w de|strong="H5921"\w* \w justicia|strong="H4941"\w* \w pondrás|strong="H5414"\w* \w el|strong="H5921"\w* Urim \w y|strong="H5921"\w* \w el|strong="H5921"\w* Tumim, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w estén|strong="H1961"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w corazón|strong="H3820"\w* \w de|strong="H5921"\w* Aarón cada vez \w que|strong="H5921"\w* \w se|strong="H1961"\w* presente \w ante|strong="H6440"\w* Yahvé. Así Aarón \w llevará|strong="H5375"\w* \w siempre|strong="H8548"\w* \w sobre|strong="H5921"\w* su \w corazón|strong="H3820"\w* \w la|strong="H5921"\w* responsabilidad \w de|strong="H5921"\w* \w las|strong="H5921"\w* decisiones \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas \w ante|strong="H6440"\w* Yahvé.   
\p
\v 31 “\w El|strong="H6213"\w* \w manto|strong="H4598"\w* que se usa con \w el|strong="H6213"\w* efod \w lo|strong="H6213"\w* \w harás|strong="H6213"\w* \w todo|strong="H3632"\w* de tela azul.  
\v 32 \w Tendrá|strong="H1961"\w* una abertura \w en|strong="H8432"\w* el centro \w para|strong="H1961"\w* meter la \w cabeza|strong="H7218"\w*. El borde de \w esta|strong="H1961"\w* abertura \w estará|strong="H1961"\w* reforzado con un tejido especial, \w como|strong="H1961"\w* el cuello de una armadura, \w para|strong="H1961"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* rompa.  
\v 33 \w En|strong="H5921"\w* \w todo|strong="H5439"\w* \w el|strong="H5921"\w* borde inferior \w del|strong="H5921"\w* manto bordarás \w granadas|strong="H7416"\w* \w de|strong="H5921"\w* hilo azul, púrpura \w y|strong="H5921"\w* escarlata, \w e|strong="H3068"\w* intercalarás campanitas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w entre|strong="H8432"\w* \w ellas|strong="H5921"\w*.  
\v 34 \w O|strong="H3068"\w* sea \w que|strong="H5921"\w* \w todo|strong="H5439"\w* \w el|strong="H5921"\w* borde \w del|strong="H5921"\w* \w manto|strong="H4598"\w* llevará una campanita \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* luego una granada, otra campanita \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w y|strong="H5921"\w* otra granada, \w y|strong="H5921"\w* así sucesivamente.  
\v 35 Aarón deberá ponerse \w este|strong="H1961"\w* manto \w siempre|strong="H5921"\w* \w que|strong="H3808"\w* oficie \w como|strong="H1961"\w* sacerdote. Así, \w cuando|strong="H1961"\w* \w él|strong="H5921"\w* \w entre|strong="H5921"\w* \w y|strong="H5921"\w* \w salga|strong="H3318"\w* \w del|strong="H5921"\w* Lugar \w Santo|strong="H6944"\w* \w ante|strong="H6440"\w* Yahvé, \w se|strong="H1961"\w* escucharán \w las|strong="H5921"\w* campanitas, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w no|strong="H3808"\w* \w morirá|strong="H4191"\w*.   
\p
\v 36 “\w Harás|strong="H6213"\w* una placa \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w puro|strong="H2889"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* grabarás \w como|strong="H5921"\w* \w si|strong="H5921"\w* fuera un sello, \w con|strong="H5921"\w* \w las|strong="H5921"\w* palabras: ‘\w CONSAGRADO|strong="H6944"\w* \w A|strong="H3068"\w* YAHVÉ’.  
\v 37 Amarrarás \w la|strong="H5921"\w* placa \w con|strong="H5921"\w* un cordón azul \w a|strong="H3068"\w* \w la|strong="H5921"\w* parte delantera \w del|strong="H5921"\w* turbante.  
\v 38 Así \w la|strong="H5921"\w* placa \w quedará|strong="H1961"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w frente|strong="H4696"\w* \w de|strong="H5921"\w* Aarón, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w se|strong="H1961"\w* \w hará|strong="H1961"\w* responsable \w de|strong="H5921"\w* \w cualquier|strong="H3605"\w* error \w que|strong="H5921"\w* cometan \w los|strong="H1121"\w* israelitas \w al|strong="H5921"\w* presentar sus \w ofrendas|strong="H4979"\w* \w sagradas|strong="H6944"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*. \w La|strong="H5921"\w* placa \w estará|strong="H1961"\w* \w siempre|strong="H8548"\w* \w en|strong="H5921"\w* su \w frente|strong="H4696"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* Yahvé acepte \w las|strong="H5921"\w* \w ofrendas|strong="H4979"\w* \w del|strong="H5921"\w* pueblo.   
\p
\v 39 “La túnica y \w el|strong="H6213"\w* turbante los \w harás|strong="H6213"\w* de lino fino, y \w el|strong="H6213"\w* cinturón deberá estar finamente bordado.   
\p
\v 40 “\w A|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón también les \w harás|strong="H6213"\w* \w túnicas|strong="H3801"\w*, cinturones \w y|strong="H3519"\w* gorros, para \w que|strong="H1121"\w* se vean honrosos \w y|strong="H3519"\w* hermosos.  
\v 41 Viste \w a|strong="H3068"\w* tu hermano Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* con estas ropas sagradas; y úngelos con aceite, conságralos y santifícalos para \w que|strong="H1121"\w* me sirvan como sacerdotes.  
\v 42 \w Hazles|strong="H6213"\w* ropa interior \w de|strong="H5704"\w* lino \w que|strong="H5704"\w* les cubra \w desde|strong="H5704"\w* la cintura \w hasta|strong="H5704"\w* \w los|strong="H1961"\w* muslos, \w para|strong="H5704"\w* \w que|strong="H5704"\w* \w no|strong="H6213"\w* \w se|strong="H1961"\w* les vea \w el|strong="H6213"\w* cuerpo desnudo.  
\v 43 Aarón \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* deberán ponérsela \w siempre|strong="H5769"\w* \w que|strong="H3808"\w* entren \w en|strong="H5921"\w* \w la|strong="H5921"\w* Tienda \w de|strong="H5921"\w* Reunión \w o|strong="H3068"\w* \w cuando|strong="H1961"\w* \w se|strong="H1961"\w* acerquen \w al|strong="H5921"\w* \w altar|strong="H4196"\w* \w para|strong="H5921"\w* oficiar \w en|strong="H5921"\w* \w el|strong="H5921"\w* Lugar \w Santo|strong="H6944"\w*. Así \w no|strong="H3808"\w* cometerán \w ningún|strong="H3808"\w* \w pecado|strong="H5771"\w* \w ni|strong="H3808"\w* \w morirán|strong="H4191"\w*. \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* una ley \w que|strong="H3808"\w* Aarón \w y|strong="H5921"\w* sus descendientes deberán cumplir \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*.”   
\c 29  
\p
\v 1 “\w Esto|strong="H2088"\w* \w es|strong="H2088"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w harás|strong="H6213"\w* con ellos para consagrarlos, \w a|strong="H3068"\w* fin \w de|strong="H1121"\w* \w que|strong="H1697"\w* me sirvan como sacerdotes: \w toma|strong="H3947"\w* un \w toro|strong="H6499"\w* joven \w y|strong="H1241"\w* \w dos|strong="H8147"\w* carneros sin ningún defecto;  
\v 2 \w panes|strong="H3899"\w* sin levadura, \w tortas|strong="H2471"\w* sin levadura \w amasadas|strong="H1101"\w* con \w aceite|strong="H8081"\w*, y hojaldres sin levadura untados con \w aceite|strong="H8081"\w*. Los \w harás|strong="H6213"\w* con la mejor harina de \w trigo|strong="H2406"\w*.  
\v 3 \w Los|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w en|strong="H5921"\w* una canasta \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w los|strong="H5921"\w* presentarás \w en|strong="H5921"\w* \w ella|strong="H5921"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w toro|strong="H6499"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w dos|strong="H8147"\w* carneros.  
\v 4 Llevarás \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la Carpa \w de|strong="H1121"\w* Reunión, y allí \w los|strong="H1121"\w* lavarás con \w agua|strong="H4325"\w*.  
\v 5 \w Tomarás|strong="H3947"\w* las ropas sagradas y vestirás \w a|strong="H3068"\w* Aarón con la túnica, el \w manto|strong="H4598"\w* del efod, el efod y el pectoral, y le amarrarás el cinturón finamente bordado del efod.  
\v 6 \w Le|strong="H5921"\w* \w pondrás|strong="H5414"\w* \w el|strong="H5921"\w* turbante \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*, \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* turbante colocarás \w la|strong="H5921"\w* placa sagrada.  
\v 7 Luego \w tomarás|strong="H3947"\w* \w el|strong="H5921"\w* \w aceite|strong="H8081"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w unción|strong="H4888"\w*, \w lo|strong="H5921"\w* derramarás \w sobre|strong="H5921"\w* su \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w ungirás|strong="H4886"\w*.  
\v 8 Harás \w que|strong="H1121"\w* se acerquen sus \w hijos|strong="H1121"\w* y les pondrás las \w túnicas|strong="H3801"\w*.  
\v 9 \w Les|strong="H1992"\w* pondrás \w los|strong="H1992"\w* cinturones \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*, y \w les|strong="H1992"\w* atarás \w los|strong="H1992"\w* gorros. \w Ellos|strong="H1992"\w* y \w sus|strong="H1992"\w* descendientes \w serán|strong="H1961"\w* sacerdotes \w para|strong="H1961"\w* \w siempre|strong="H5769"\w*, \w como|strong="H1961"\w* una ley permanente. \w De|strong="H1121"\w* \w esta|strong="H1961"\w* manera consagrarás \w a|strong="H3068"\w* Aarón y \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*.   
\p
\v 10 “Llevarás \w el|strong="H5921"\w* \w toro|strong="H6499"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H5921"\w* \w la|strong="H5921"\w* Carpa \w de|strong="H5921"\w* Reunión, \w y|strong="H5921"\w* Aarón \w y|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w pondrán|strong="H5564"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w del|strong="H5921"\w* \w toro|strong="H6499"\w*.  
\v 11 Matarás el \w toro|strong="H6499"\w* en la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Carpa \w de|strong="H6440"\w* Reunión.  
\v 12 \w Tomarás|strong="H3947"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* dedo un poco \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w del|strong="H5921"\w* \w toro|strong="H6499"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* untarás \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w cuernos|strong="H7161"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w lo|strong="H5921"\w* derramarás \w al|strong="H5921"\w* \w pie|strong="H3247"\w* \w del|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 13 \w Tomarás|strong="H3947"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* grasa \w que|strong="H5921"\w* \w cubre|strong="H3680"\w* \w los|strong="H5921"\w* intestinos, \w la|strong="H5921"\w* mejor parte \w del|strong="H5921"\w* \w hígado|strong="H3516"\w*, \w los|strong="H5921"\w* \w dos|strong="H8147"\w* \w riñones|strong="H3629"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* grasa \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w cubre|strong="H3680"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* quemarás \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w*.  
\v 14 Pero \w la|strong="H1931"\w* \w carne|strong="H1320"\w* del \w toro|strong="H6499"\w*, \w su|strong="H1931"\w* \w piel|strong="H5785"\w* y \w su|strong="H1931"\w* excremento \w los|strong="H1931"\w* \w quemarás|strong="H8313"\w* en \w el|strong="H1931"\w* fuego, \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w*. \w Es|strong="H1931"\w* un sacrificio por \w el|strong="H1931"\w* \w pecado|strong="H2403"\w*.   
\p
