\q2 y un \w tiempo|strong="H6256"\w* para la \w paz|strong="H7965"\w*.   
\p
\v 9 ¿\w Qué|strong="H4100"\w* \w provecho|strong="H3504"\w* saca \w el|strong="H1931"\w* trabajador de tanto esfuerzo?  
\v 10 Me he fijado en la carga \w que|strong="H1121"\w* Dios ha \w puesto|strong="H5414"\w* sobre \w los|strong="H1121"\w* seres humanos \w para|strong="H5414"\w* agobiarlos con ella.  
\v 11 Dios \w lo|strong="H3808"\w* \w hizo|strong="H6213"\w* \w todo|strong="H3605"\w* \w hermoso|strong="H3303"\w* \w a|strong="H3068"\w* su \w tiempo|strong="H6256"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w ha|strong="H3808"\w* \w puesto|strong="H5414"\w* \w el|strong="H3605"\w* sentido \w de|strong="H5704"\w* \w la|strong="H1571"\w* \w eternidad|strong="H5769"\w* \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w corazón|strong="H3820"\w* \w de|strong="H5704"\w* \w ellos|strong="H1571"\w*, \w aunque|strong="H5704"\w* \w el|strong="H3605"\w* hombre \w no|strong="H3808"\w* alcanza \w a|strong="H3068"\w* comprender \w la|strong="H1571"\w* \w obra|strong="H4639"\w* \w que|strong="H3808"\w* Dios realiza \w de|strong="H5704"\w* \w principio|strong="H5414"\w* \w a|strong="H3068"\w* fin.  
\v 12 \w Por|strong="H3588"\w* eso concluí \w que|strong="H3588"\w* \w no|strong="H6213"\w* hay nada \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w que|strong="H3588"\w* \w alegrarse|strong="H8055"\w* \w y|strong="H3588"\w* disfrutar \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w vida|strong="H2416"\w* \w mientras|strong="H3588"\w* pueda.  
\v 13 \w También|strong="H1571"\w* \w es|strong="H1931"\w* un regalo de Dios \w que|strong="H1931"\w* \w todo|strong="H3605"\w* hombre coma \w y|strong="H1571"\w* beba, \w y|strong="H1571"\w* disfrute de \w los|strong="H3605"\w* frutos de \w su|strong="H1931"\w* duro \w trabajo|strong="H5999"\w*.  
\v 14 \w Sé|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* Dios \w hace|strong="H6213"\w* dura \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*; \w no|strong="H6213"\w* \w hay|strong="H1961"\w* \w nada|strong="H3605"\w* \w que|strong="H3588"\w* añadirle ni \w nada|strong="H3605"\w* \w que|strong="H3588"\w* quitarle. Dios \w lo|strong="H1931"\w* \w hace|strong="H6213"\w* \w así|strong="H3588"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* hombres \w le|strong="H1931"\w* tengan reverencia.  
\v 15 \w Lo|strong="H1931"\w* \w que|strong="H4100"\w* ahora existe, \w ya|strong="H3528"\w* existió; y \w lo|strong="H1931"\w* \w que|strong="H4100"\w* \w ha|strong="H3528"\w* de existir, \w ya|strong="H3528"\w* existió también. Dios hace \w que|strong="H4100"\w* \w el|strong="H1931"\w* pasado \w se|strong="H1961"\w* repita.   
\p
\v 16 \w También|strong="H5750"\w* \w vi|strong="H7200"\w* \w bajo|strong="H8478"\w* el \w sol|strong="H8121"\w* que \w en|strong="H5750"\w* \w lugar|strong="H4725"\w* \w de|strong="H8478"\w* la \w justicia|strong="H6664"\w* había maldad, y \w en|strong="H5750"\w* \w lugar|strong="H4725"\w* \w de|strong="H8478"\w* la rectitud, ¡\w más|strong="H5750"\w* maldad!  
\v 17 \w Entonces|strong="H3588"\w* pensé: “Dios \w juzgará|strong="H8199"\w* \w tanto|strong="H5921"\w* \w al|strong="H5921"\w* \w justo|strong="H6662"\w* \w como|strong="H3588"\w* \w al|strong="H5921"\w* malvado, \w porque|strong="H3588"\w* hay un \w tiempo|strong="H6256"\w* \w para|strong="H5921"\w* \w cada|strong="H3605"\w* asunto \w y|strong="H3588"\w* \w para|strong="H5921"\w* \w cada|strong="H3605"\w* \w obra|strong="H4639"\w*”.  
\v 18 Respecto \w a|strong="H3068"\w* \w los|strong="H1992"\w* seres humanos, pensé \w que|strong="H5921"\w* Dios \w los|strong="H1992"\w* pone \w a|strong="H3068"\w* prueba \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* den cuenta \w de|strong="H5921"\w* \w que|strong="H5921"\w* \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* son \w como|strong="H5921"\w* \w los|strong="H1992"\w* \w animales|strong="H1121"\w*.  
\v 19 \w Al|strong="H4480"\w* fin \w y|strong="H3588"\w* \w al|strong="H4480"\w* cabo, \w el|strong="H3588"\w* destino \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w animales|strong="H1121"\w* \w es|strong="H2088"\w* \w el|strong="H3588"\w* \w mismo|strong="H3605"\w*: \w como|strong="H3588"\w* mueren unos, mueren \w los|strong="H1121"\w* otros. \w Todos|strong="H3605"\w* tienen \w el|strong="H3588"\w* \w mismo|strong="H3605"\w* aliento \w de|strong="H4480"\w* vida; \w el|strong="H3588"\w* \w hombre|strong="H1121"\w* \w no|strong="H3588"\w* \w es|strong="H2088"\w* superior \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w animales|strong="H1121"\w*, \w porque|strong="H3588"\w* \w todo|strong="H3605"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w*.  
\v 20 \w Todos|strong="H3605"\w* \w van|strong="H1980"\w* \w al|strong="H4480"\w* \w mismo|strong="H3605"\w* \w lugar|strong="H4725"\w*; \w todos|strong="H3605"\w* vienen \w del|strong="H4480"\w* \w polvo|strong="H6083"\w* y \w al|strong="H4480"\w* \w polvo|strong="H6083"\w* \w todos|strong="H3605"\w* \w vuelven|strong="H7725"\w*.  
\v 21 ¿\w Quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w si|strong="H1931"\w* \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* del \w hombre|strong="H1121"\w* \w sube|strong="H5927"\w* \w a|strong="H3068"\w* las alturas, y \w si|strong="H1931"\w* \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* del animal \w baja|strong="H3381"\w* \w a|strong="H3068"\w* \w lo|strong="H1931"\w* profundo \w de|strong="H1121"\w* \w la|strong="H1931"\w* tierra?   
\p
\v 22 \w Así|strong="H3588"\w* \w que|strong="H3588"\w* he \w visto|strong="H7200"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w hay|strong="H1961"\w* nada \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w el|strong="H1931"\w* hombre \w que|strong="H3588"\w* disfrutar \w de|strong="H3588"\w* \w su|strong="H1931"\w* trabajo, \w pues|strong="H3588"\w* \w esa|strong="H1931"\w* \w es|strong="H1931"\w* \w su|strong="H1931"\w* recompensa. ¿\w Quién|strong="H4310"\w* podrá traerlo \w de|strong="H3588"\w* vuelta \w para|strong="H3588"\w* \w ver|strong="H7200"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* pasará \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w él|strong="H1931"\w*?   
\c 4  
\p
\v 1 \w Volví|strong="H7725"\w* \w a|strong="H3068"\w* fijarme \w en|strong="H8478"\w* \w todas|strong="H3605"\w* las injusticias \w que|strong="H3581"\w* se cometen \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*. \w Vi|strong="H7200"\w* llorar \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w oprimidos|strong="H6231"\w*, y \w no|strong="H6213"\w* \w había|strong="H6213"\w* \w quien|strong="H3605"\w* \w los|strong="H3605"\w* \w consolara|strong="H5162"\w*; \w el|strong="H3605"\w* \w poder|strong="H3027"\w* \w estaba|strong="H2009"\w* del \w lado|strong="H3027"\w* \w de|strong="H8478"\w* sus opresores, ¡\w nadie|strong="H3605"\w* venía \w a|strong="H3068"\w* darles \w consuelo|strong="H5162"\w*!  
\v 2 \w Por|strong="H4480"\w* eso llegué \w a|strong="H3068"\w* la conclusión \w de|strong="H4480"\w* \w que|strong="H4480"\w* \w los|strong="H1992"\w* \w muertos|strong="H4191"\w* son \w más|strong="H4480"\w* felices \w que|strong="H4480"\w* \w los|strong="H1992"\w* \w que|strong="H4480"\w* todavía estamos \w vivos|strong="H2416"\w*.  
\v 3 Pero todavía \w mejor|strong="H2896"\w* le \w va|strong="H3068"\w* \w al|strong="H8478"\w* \w que|strong="H3808"\w* \w aún|strong="H5728"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* nacido, \w pues|strong="H7200"\w* \w no|strong="H3808"\w* le \w ha|strong="H3808"\w* tocado \w ver|strong="H7200"\w* todas las \w maldades|strong="H7451"\w* \w que|strong="H3808"\w* \w se|strong="H1961"\w* \w hacen|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H6213"\w* \w sol|strong="H8121"\w*.  
\v 4 \w También|strong="H1571"\w* \w vi|strong="H7200"\w* \w que|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* esfuerzo \w y|strong="H1571"\w* \w los|strong="H3605"\w* logros \w de|strong="H3588"\w* \w la|strong="H1931"\w* gente nacen \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w envidia|strong="H7068"\w* \w que|strong="H3588"\w* uno siente \w por|strong="H3588"\w* \w el|strong="H1931"\w* éxito del \w otro|strong="H2088"\w*. \w Esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H1931"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* un querer atrapar \w el|strong="H1931"\w* \w viento|strong="H7307"\w*.   
\p
\v 5 El \w necio|strong="H3684"\w* se cruza de brazos y se destruye \w a|strong="H3068"\w* sí mismo.  
\v 6 Pero es \w mejor|strong="H2896"\w* un poco de descanso que mucho \w trabajo|strong="H5999"\w* y querer atrapar el \w viento|strong="H7307"\w*.   
\p
\v 7 Me puse \w a|strong="H3068"\w* observar otra forma \w de|strong="H8478"\w* \w vanidad|strong="H1892"\w* \w bajo|strong="H8478"\w* el \w sol|strong="H8121"\w*:  
\v 8 Vi \w a|strong="H3068"\w* un \w hombre|strong="H1121"\w* \w que|strong="H4310"\w* estaba completamente \w solo|strong="H1931"\w*; \w no|strong="H3808"\w* \w tenía|strong="H3426"\w* \w hijos|strong="H1121"\w* \w ni|strong="H3808"\w* hermanos. Trabajaba \w sin|strong="H3808"\w* descanso \w y|strong="H1571"\w* \w nunca|strong="H3808"\w* estaba satisfecho \w con|strong="H1571"\w* \w sus|strong="H1931"\w* \w riquezas|strong="H6239"\w*. \w Jamás|strong="H3808"\w* \w se|strong="H1931"\w* preguntó: “¿Para \w quién|strong="H4310"\w* \w me|strong="H4310"\w* estoy esforzando tanto \w y|strong="H1571"\w* privándome \w de|strong="H1121"\w* disfrutar?”. ¡\w Esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H1931"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* un asunto \w tan|strong="H1931"\w* \w triste|strong="H7451"\w*!   
\p
\v 9 \w Más|strong="H4480"\w* valen \w dos|strong="H8147"\w* \w que|strong="H4480"\w* uno, porque rinden \w más|strong="H4480"\w* \w en|strong="H4480"\w* \w su|strong="H1992"\w* esfuerzo.  
\v 10 \w Si|strong="H3588"\w* uno \w de|strong="H3588"\w* ellos \w cae|strong="H5307"\w*, \w el|strong="H3588"\w* \w otro|strong="H8145"\w* lo levanta. \w Pero|strong="H3588"\w* ¡pobre del \w que|strong="H3588"\w* \w está|strong="H6965"\w* solo \w cuando|strong="H3588"\w* \w cae|strong="H5307"\w*!, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* tiene \w a|strong="H3068"\w* nadie \w que|strong="H3588"\w* lo ayude \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*.  
\v 11 \w Además|strong="H1571"\w*, \w si|strong="H1571"\w* \w dos|strong="H8147"\w* se acuestan juntos, se dan calor; pero uno solo, ¿\w cómo|strong="H1571"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* calentarse?  
\v 12 Uno solo puede ser vencido, pero \w dos|strong="H8147"\w* pueden resistir. ¡La cuerda \w de|strong="H5048"\w* tres hilos \w no|strong="H3808"\w* \w se|strong="H3808"\w* rompe fácilmente!   
\p
\v 13 \w Más|strong="H5750"\w* \w vale|strong="H2896"\w* un joven \w pobre|strong="H4542"\w* pero \w sabio|strong="H2450"\w*, \w que|strong="H3808"\w* un \w rey|strong="H4428"\w* \w viejo|strong="H2205"\w* y tonto \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* acepta advertencias.  
\v 14 Ese joven \w salió|strong="H3318"\w* \w de|strong="H3588"\w* \w la|strong="H1571"\w* cárcel \w para|strong="H3588"\w* llegar al trono, \w aunque|strong="H3588"\w* \w nació|strong="H3205"\w* \w pobre|strong="H7326"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w reino|strong="H4427"\w* \w que|strong="H3588"\w* después gobernó.  
\v 15 \w Vi|strong="H7200"\w* \w que|strong="H3605"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* gente \w que|strong="H3605"\w* \w vive|strong="H2416"\w* \w bajo|strong="H8478"\w* \w el|strong="H5973"\w* \w sol|strong="H8121"\w* seguía \w al|strong="H8478"\w* joven \w que|strong="H3605"\w* reemplazó \w al|strong="H8478"\w* rey.  
\v 16 \w Era|strong="H1961"\w* una multitud incontable \w la|strong="H1571"\w* \w que|strong="H3588"\w* \w lo|strong="H2088"\w* \w seguía|strong="H1961"\w*; \w pero|strong="H3588"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* vendrán \w después|strong="H1961"\w* \w tampoco|strong="H1571"\w* \w estarán|strong="H1961"\w* \w contentos|strong="H8055"\w* \w con|strong="H3588"\w* \w él|strong="H3588"\w*. ¡\w Ciertamente|strong="H3588"\w*, \w esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H1961"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* un querer atrapar \w el|strong="H3588"\w* \w viento|strong="H7307"\w*!   
\c 5  
\p
\v 1 Cuida tus pasos \w cuando|strong="H3588"\w* vayas \w a|strong="H3068"\w* \w la|strong="H5921"\w* casa \w de|strong="H5921"\w* Dios. \w Es|strong="H1961"\w* mejor acercarse \w a|strong="H3068"\w* escuchar \w que|strong="H3588"\w* ofrecer sacrificios \w como|strong="H3588"\w* \w los|strong="H5921"\w* necios, \w que|strong="H3588"\w* ni siquiera \w se|strong="H1961"\w* dan \w cuenta|strong="H1697"\w* \w de|strong="H5921"\w* \w que|strong="H3588"\w* hacen mal.  
\v 2 \w No|strong="H3588"\w* \w te|strong="H3588"\w* precipites \w a|strong="H3068"\w* \w hablar|strong="H1697"\w*, ni dejes \w que|strong="H3588"\w* tu corazón se apresure \w a|strong="H3068"\w* prometer \w nada|strong="H1697"\w* delante \w de|strong="H3588"\w* Dios. Recuerda \w que|strong="H3588"\w* Dios está \w en|strong="H3588"\w* \w el|strong="H3588"\w* cielo \w y|strong="H3588"\w* tú estás \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra; \w por|strong="H3588"\w* \w lo|strong="H1697"\w* tanto, \w habla|strong="H1697"\w* poco.  
\v 3 \w Así|strong="H3588"\w* \w como|strong="H3588"\w* \w los|strong="H3588"\w* sueños nacen \w de|strong="H3588"\w* muchas preocupaciones, las tonterías del \w necio|strong="H3684"\w* nacen \w de|strong="H3588"\w* hablar demasiado.  
\v 4 Cuando le hagas una \w promesa|strong="H5087"\w* \w a|strong="H3068"\w* Dios, \w no|strong="H3808"\w* tardes en cumplirla, \w porque|strong="H3808"\w* \w a|strong="H3068"\w* él \w no|strong="H3808"\w* le agradan los necios. ¡\w Cumple|strong="H7999"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* prometes!  
\v 5 \w Es|strong="H1931"\w* mejor \w no|strong="H3588"\w* prometer nada, \w que|strong="H3588"\w* prometer \w y|strong="H3588"\w* \w no|strong="H3588"\w* cumplir.  
\v 6 \w No|strong="H3588"\w* permitas \w que|strong="H3588"\w* tu boca \w te|strong="H3588"\w* haga pecar, ni luego le digas al enviado del templo \w que|strong="H3588"\w* fue un error. ¿\w Para|strong="H3588"\w* \w qué|strong="H3588"\w* hacer \w que|strong="H3588"\w* Dios se enoje \w por|strong="H3588"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w dices|strong="H1697"\w* \w y|strong="H3588"\w* destruya \w lo|strong="H1697"\w* \w que|strong="H3588"\w* has logrado \w con|strong="H3588"\w* \w tanto|strong="H7235"\w* esfuerzo?  
\v 7 \w Entre|strong="H5921"\w* tantos sueños \w y|strong="H3588"\w* tantas palabras, \w no|strong="H3588"\w* falta \w la|strong="H5921"\w* vanidad; \w pero|strong="H3588"\w* tú, muestra reverencia \w a|strong="H3068"\w* Dios.   
\p
\v 8 \w Si|strong="H1931"\w* en \w alguna|strong="H3605"\w* región ves \w que|strong="H1931"\w* \w se|strong="H1931"\w* oprime \w al|strong="H4428"\w* pobre y \w que|strong="H1931"\w* \w se|strong="H1931"\w* violan \w el|strong="H1931"\w* derecho y \w la|strong="H1931"\w* justicia, no \w se|strong="H1931"\w* sorprendan \w por|strong="H4428"\w* \w ello|strong="H1931"\w*. \w Pues|strong="H1931"\w* \w a|strong="H3068"\w* un alto oficial \w lo|strong="H1931"\w* vigila otro más alto, y \w por|strong="H4428"\w* encima de \w ellos|strong="H1931"\w* hay otros más altos todavía.  
\v 9 \w Con|strong="H1571"\w* todo, \w lo|strong="H2088"\w* mejor para un país \w es|strong="H2088"\w* \w que|strong="H4310"\w* \w el|strong="H4310"\w* rey \w se|strong="H3808"\w* preocupe \w por|strong="H2088"\w* cultivar los campos.   
\p
\v 10 \w El|strong="H3588"\w* \w que|strong="H3588"\w* ama \w el|strong="H3588"\w* dinero, \w nunca|strong="H3588"\w* tiene suficiente; \w el|strong="H3588"\w* \w que|strong="H3588"\w* ama las riquezas, \w nunca|strong="H3588"\w* está satisfecho \w con|strong="H3588"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* gana. ¡También esto \w es|strong="H3588"\w* vanidad!  
\v 11 Mientras \w más|strong="H7235"\w* bienes hay, \w más|strong="H7235"\w* gente hay para gastarlos. ¿\w Y|strong="H3068"\w* qué gana el dueño con tenerlos, aparte de quedarse mirándolos?   
\p
\v 12 El que trabaja duerme tranquilo, coma mucho \w o|strong="H3068"\w* coma poco; pero \w al|strong="H8478"\w* rico sus \w riquezas|strong="H6239"\w* no lo dejan dormir.   
\p
\v 13 Hay \w algo|strong="H3972"\w* muy \w triste|strong="H7451"\w* \w que|strong="H1931"\w* he visto bajo \w el|strong="H1931"\w* sol: gente \w que|strong="H1931"\w* acumula \w riquezas|strong="H6239"\w* para \w su|strong="H1931"\w* propio \w mal|strong="H7451"\w*.  
\v 14 Esas riquezas \w se|strong="H3808"\w* pierden \w en|strong="H3318"\w* un mal negocio, y \w si|strong="H3808"\w* el dueño tiene un hijo, ya \w no|strong="H3808"\w* le queda \w nada|strong="H3808"\w* \w que|strong="H3808"\w* dejarle.  
\v 15 \w Tal|strong="H3651"\w* \w como|strong="H4100"\w* nació del vientre \w de|strong="H7451"\w* su madre, \w así|strong="H3651"\w* \w se|strong="H3651"\w* \w va|strong="H3068"\w*: desnudo \w y|strong="H1571"\w* sin \w nada|strong="H3605"\w*, \w tal|strong="H3651"\w* \w como|strong="H4100"\w* \w vino|strong="H3212"\w* al mundo. \w De|strong="H7451"\w* \w tanto|strong="H3651"\w* \w trabajar|strong="H5998"\w*, \w no|strong="H4100"\w* \w se|strong="H3651"\w* \w lleva|strong="H3212"\w* \w nada|strong="H3605"\w* \w que|strong="H4100"\w* pueda sostener \w en|strong="H3212"\w* sus manos.  
\v 16 Esto \w es|strong="H7235"\w* realmente lamentable: \w que|strong="H1571"\w* \w el|strong="H3605"\w* hombre se vaya tal \w como|strong="H1571"\w* vino. ¿\w Y|strong="H3068"\w* \w qué|strong="H1571"\w* provecho saca de \w tanto|strong="H7235"\w* trabajar para \w el|strong="H3605"\w* viento?  
\v 17 \w Toda|strong="H3605"\w* \w su|strong="H1931"\w* \w vida|strong="H2416"\w* \w se|strong="H1931"\w* \w la|strong="H1931"\w* pasa comiendo \w en|strong="H3588"\w* \w la|strong="H1931"\w* oscuridad, lleno \w de|strong="H3588"\w* frustración, \w de|strong="H3588"\w* enfermedades \w y|strong="H3588"\w* \w de|strong="H3588"\w* enojo.   
\p
\v 18 He visto \w que|strong="H4480"\w* \w lo|strong="H1931"\w* mejor \w y|strong="H1571"\w* \w lo|strong="H1931"\w* \w más|strong="H4480"\w* agradable \w para|strong="H4480"\w* \w el|strong="H1931"\w* hombre \w es|strong="H1931"\w* comer \w y|strong="H1571"\w* beber, \w y|strong="H1571"\w* disfrutar \w de|strong="H4480"\w* \w los|strong="H3605"\w* resultados \w de|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* esfuerzo \w que|strong="H4480"\w* hace bajo \w el|strong="H1931"\w* sol, durante \w los|strong="H3605"\w* contados días \w de|strong="H4480"\w* vida \w que|strong="H4480"\w* Dios \w le|strong="H1931"\w* \w da|strong="H5414"\w*; porque \w eso|strong="H1931"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H4480"\w* \w le|strong="H1931"\w* corresponde.  
\v 19 \w Además|strong="H3588"\w*, \w si|strong="H3588"\w* Dios le da \w a|strong="H3068"\w* alguien \w abundancia|strong="H7235"\w* \w y|strong="H3588"\w* riquezas, \w y|strong="H3588"\w* también le permite disfrutar \w de|strong="H3588"\w* ellas, aceptar \w su|strong="H3588"\w* realidad \w y|strong="H3588"\w* alegrarse \w en|strong="H3588"\w* \w su|strong="H3588"\w* trabajo, esto \w es|strong="H3588"\w* un regalo \w de|strong="H3588"\w* Dios.  
\v 20 Así no se detiene \w a|strong="H3068"\w* pensar tanto en los años de su vida, porque Dios lo mantiene ocupado con la alegría de su corazón.   
\c 6  
\p
\v 1 \w Hay|strong="H3426"\w* un \w mal|strong="H7451"\w* \w que|strong="H1931"\w* he \w visto|strong="H7200"\w* \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w*, \w y|strong="H5921"\w* \w que|strong="H1931"\w* afecta \w mucho|strong="H7227"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* seres humanos:  
\v 2 \w a|strong="H3068"\w* algunos Dios les \w da|strong="H5414"\w* \w riquezas|strong="H6239"\w*, posesiones \w y|strong="H3588"\w* honores, \w al|strong="H4480"\w* grado \w de|strong="H4480"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* les \w falta|strong="H2638"\w* \w nada|strong="H3808"\w* \w de|strong="H4480"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* desean; \w pero|strong="H3588"\w* Dios \w no|strong="H3808"\w* les permite disfrutar \w de|strong="H4480"\w* \w ello|strong="H1931"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* otros extraños terminan disfrutándolo. ¡\w Esto|strong="H2088"\w* \w es|strong="H1931"\w* \w vanidad|strong="H1892"\w* \w y|strong="H3588"\w* una \w enfermedad|strong="H2483"\w* terrible!   
\p
\v 3 Un hombre puede \w tener|strong="H1961"\w* \w cien|strong="H3967"\w* hijos \w y|strong="H1571"\w* \w vivir|strong="H2421"\w* \w muchos|strong="H7227"\w* \w años|strong="H8141"\w*; pero \w por|strong="H4480"\w* \w más|strong="H4480"\w* \w que|strong="H4480"\w* \w viva|strong="H2421"\w*, \w si|strong="H1571"\w* \w no|strong="H3808"\w* disfruta \w de|strong="H4480"\w* las \w cosas|strong="H7227"\w* \w buenas|strong="H2896"\w* \w y|strong="H1571"\w* \w ni|strong="H3808"\w* siquiera recibe una \w sepultura|strong="H6900"\w* digna, \w yo|strong="H4480"\w* digo \w que|strong="H4480"\w* un bebé \w que|strong="H4480"\w* \w nace|strong="H3205"\w* muerto \w es|strong="H1961"\w* \w mejor|strong="H2896"\w* \w que|strong="H4480"\w* \w él|strong="H1571"\w*.  
\v 4 \w Porque|strong="H3588"\w* ese bebé viene sin sentido \w y|strong="H3588"\w* se \w va|strong="H3068"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w oscuridad|strong="H2822"\w*, \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w oscuridad|strong="H2822"\w* queda olvidado \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*.  
\v 5 \w Nunca|strong="H3808"\w* llegó \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w el|strong="H1571"\w* \w sol|strong="H8121"\w* \w ni|strong="H3808"\w* \w supo|strong="H3045"\w* \w nada|strong="H3808"\w*, pero al menos descansa \w más|strong="H1571"\w* \w que|strong="H3808"\w* \w aquel|strong="H2088"\w* hombre.  
\v 6 \w Aunque|strong="H3808"\w* \w el|strong="H3605"\w* hombre \w viva|strong="H2421"\w* \w dos|strong="H6471"\w* mil \w años|strong="H8141"\w*, \w si|strong="H3808"\w* \w no|strong="H3808"\w* disfruta de \w la|strong="H3605"\w* \w vida|strong="H2421"\w*, ¿acaso \w no|strong="H3808"\w* \w van|strong="H1980"\w* \w todos|strong="H3605"\w* al \w mismo|strong="H3605"\w* \w lugar|strong="H4725"\w*?  
\v 7 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* esfuerzo del hombre es para llenar su \w boca|strong="H6310"\w*, pero su apetito \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* queda satisfecho.  
\v 8 ¿\w Qué|strong="H3588"\w* ventaja tiene \w entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w sabio|strong="H2450"\w* \w sobre|strong="H4480"\w* \w el|strong="H3588"\w* \w necio|strong="H3684"\w*? ¿\w Qué|strong="H3588"\w* gana \w el|strong="H3588"\w* \w pobre|strong="H6041"\w* \w con|strong="H4480"\w* \w saber|strong="H3045"\w* \w cómo|strong="H4100"\w* enfrentarse \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w vida|strong="H2416"\w*?  
\v 9 \w Vale|strong="H2896"\w* \w más|strong="H1571"\w* \w lo|strong="H2088"\w* \w que|strong="H1571"\w* se \w ve|strong="H1980"\w* \w con|strong="H1571"\w* los \w ojos|strong="H5869"\w* \w que|strong="H1571"\w* \w lo|strong="H2088"\w* \w que|strong="H1571"\w* se imagina \w con|strong="H1571"\w* \w el|strong="H1571"\w* deseo. \w También|strong="H1571"\w* \w esto|strong="H2088"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* un querer atrapar \w el|strong="H1571"\w* \w viento|strong="H7307"\w*.  
\v 10 Todo \w lo|strong="H1931"\w* \w que|strong="H4100"\w* existe \w ya|strong="H3528"\w* \w tiene|strong="H1961"\w* \w nombre|strong="H8034"\w* \w desde|strong="H4480"\w* hace tiempo, y \w se|strong="H3045"\w* \w sabe|strong="H3045"\w* bien \w lo|strong="H1931"\w* \w que|strong="H4100"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* ser humano: \w no|strong="H3808"\w* \w puede|strong="H3201"\w* enfrentarse \w a|strong="H3068"\w* alguien \w más|strong="H4480"\w* poderoso \w que|strong="H4100"\w* \w él|strong="H1931"\w*.  
\v 11 \w Entre|strong="H3588"\w* \w más|strong="H3588"\w* \w palabras|strong="H1697"\w* \w se|strong="H4100"\w* dicen, \w más|strong="H3588"\w* \w vanidad|strong="H1892"\w* \w se|strong="H4100"\w* produce; ¿\w y|strong="H3588"\w* \w qué|strong="H3588"\w* gana \w el|strong="H3588"\w* hombre \w con|strong="H3588"\w* eso?  
\v 12 \w Pues|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w qué|strong="H3588"\w* \w es|strong="H1961"\w* \w lo|strong="H4100"\w* \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* hombre durante \w los|strong="H1961"\w* \w contados|strong="H4557"\w* \w días|strong="H3117"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* vana \w vida|strong="H2416"\w*, \w que|strong="H3588"\w* pasa \w como|strong="H4100"\w* una \w sombra|strong="H6738"\w*? ¿\w Quién|strong="H4310"\w* puede decirle \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w sucederá|strong="H1961"\w* \w bajo|strong="H8478"\w* \w el|strong="H3588"\w* \w sol|strong="H8121"\w* \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* muerte?   
\c 7  
\p
\v 1 \w Vale|strong="H2896"\w* más el \w buen|strong="H2896"\w* \w nombre|strong="H8034"\w* \w que|strong="H3117"\w* el \w mejor|strong="H2896"\w* perfume, y el \w día|strong="H3117"\w* \w que|strong="H3117"\w* morimos \w que|strong="H3117"\w* el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* nacemos.  
\v 2 \w Es|strong="H1931"\w* \w mejor|strong="H2896"\w* \w ir|strong="H3212"\w* \w a|strong="H3068"\w* un funeral \w que|strong="H1931"\w* \w ir|strong="H3212"\w* \w a|strong="H3068"\w* una fiesta, porque \w la|strong="H1931"\w* muerte \w es|strong="H1931"\w* \w el|strong="H1931"\w* fin \w de|strong="H5414"\w* \w todo|strong="H3605"\w* hombre, y \w los|strong="H3605"\w* \w que|strong="H1931"\w* \w viven|strong="H2416"\w* debieran reflexionar sobre \w esto|strong="H1931"\w*.  
\v 3 \w Es|strong="H3588"\w* \w mejor|strong="H2896"\w* estar triste \w que|strong="H3588"\w* reír, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* tristeza nos ayuda \w a|strong="H3068"\w* mejorar \w el|strong="H3588"\w* \w corazón|strong="H3820"\w*.  
\v 4 El \w sabio|strong="H2450"\w* piensa en la muerte, pero el \w necio|strong="H3684"\w* solo piensa en divertirse.  
\v 5 Es \w mejor|strong="H2896"\w* recibir el regaño de un \w sabio|strong="H2450"\w* que \w escuchar|strong="H8085"\w* las \w canciones|strong="H7892"\w* de \w los|strong="H2450"\w* necios.  
\v 6 \w La|strong="H1571"\w* risa \w de|strong="H3588"\w* \w los|strong="H3588"\w* necios \w es|strong="H2088"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w ruido|strong="H6963"\w* \w que|strong="H3588"\w* hacen las \w espinas|strong="H5518"\w* \w al|strong="H8478"\w* quemarse \w bajo|strong="H8478"\w* \w la|strong="H1571"\w* \w olla|strong="H5518"\w*; ¡\w no|strong="H3588"\w* tiene sentido!  
\v 7 \w La|strong="H3588"\w* opresión vuelve loco al \w sabio|strong="H2450"\w*, \w y|strong="H3588"\w* \w el|strong="H3588"\w* soborno corrompe \w su|strong="H3588"\w* integridad.  
\v 8 \w Vale|strong="H2896"\w* más terminar \w algo|strong="H1697"\w* \w que|strong="H1697"\w* comenzarlo;  
\p \w vale|strong="H2896"\w* más la paciencia \w que|strong="H1697"\w* el orgullo.  
\v 9 \w No|strong="H3588"\w* \w te|strong="H3588"\w* dejes llevar \w por|strong="H3588"\w* \w el|strong="H3588"\w* enojo, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* enojo solo anida \w en|strong="H3588"\w* \w el|strong="H3588"\w* pecho \w de|strong="H3588"\w* \w los|strong="H3588"\w* tontos.  
\v 10 \w No|strong="H3808"\w* preguntes: “¿\w Por|strong="H5921"\w* \w qué|strong="H3588"\w* \w eran|strong="H1961"\w* \w mejores|strong="H2896"\w* \w los|strong="H5921"\w* \w tiempos|strong="H3117"\w* \w pasados|strong="H7223"\w*?”, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1961"\w* \w de|strong="H5921"\w* sabios hacerse esa \w pregunta|strong="H7592"\w*.   
\p
\v 11 Tan \w buena|strong="H2896"\w* es \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* \w como|strong="H5973"\w* una \w herencia|strong="H5159"\w*; ¡\w les|strong="H5973"\w* viene muy \w bien|strong="H2896"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* que viven bajo \w el|strong="H5973"\w* \w sol|strong="H8121"\w*!  
\v 12 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w sabiduría|strong="H2451"\w* protege tanto \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w dinero|strong="H3701"\w*, \w pero|strong="H3588"\w* \w la|strong="H3588"\w* ventaja del \w conocimiento|strong="H1847"\w* \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w sabiduría|strong="H2451"\w* le da \w vida|strong="H2421"\w* \w a|strong="H3068"\w* quien \w la|strong="H3588"\w* posee.   
\p
\v 13 Fíjate \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w obra|strong="H4639"\w* \w de|strong="H3588"\w* Dios: ¿\w quién|strong="H4310"\w* \w puede|strong="H3201"\w* enderezar lo \w que|strong="H3588"\w* \w él|strong="H3588"\w* ha torcido?  
\v 14 \w Cuando|strong="H3117"\w* \w te|strong="H5921"\w* vaya \w bien|strong="H2896"\w*, disfruta; \w y|strong="H1571"\w* \w cuando|strong="H3117"\w* \w te|strong="H5921"\w* vaya \w mal|strong="H7451"\w*, ponte \w a|strong="H3068"\w* pensar: Dios \w nos|strong="H5921"\w* envía \w tanto|strong="H5921"\w* \w lo|strong="H2088"\w* uno \w como|strong="H1571"\w* \w lo|strong="H2088"\w* \w otro|strong="H2088"\w*, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* sepa \w qué|strong="H3808"\w* \w es|strong="H1961"\w* \w lo|strong="H2088"\w* \w que|strong="H3808"\w* \w vendrá|strong="H1961"\w* \w después|strong="H5921"\w*.   
\p
\v 15 En \w esta|strong="H3426"\w* mi vana \w vida|strong="H3117"\w* \w de|strong="H6662"\w* \w todo|strong="H3605"\w* he \w visto|strong="H7200"\w*: gente \w justa|strong="H6662"\w* \w que|strong="H3117"\w* muere \w a|strong="H3068"\w* pesar \w de|strong="H6662"\w* su \w justicia|strong="H6664"\w*, y gente malvada \w que|strong="H3117"\w* vive muchos \w años|strong="H3117"\w* \w a|strong="H3068"\w* pesar \w de|strong="H6662"\w* su \w maldad|strong="H7451"\w*.  
\v 16 \w No|strong="H1961"\w* trates \w de|strong="H6662"\w* ser \w demasiado|strong="H7235"\w* \w justo|strong="H6662"\w* ni te las des \w de|strong="H6662"\w* muy \w sabio|strong="H2449"\w*. ¿\w Para|strong="H1961"\w* \w qué|strong="H4100"\w* acabar contigo mismo?  
\v 17 \w Tampoco|strong="H3808"\w* te entregues \w a|strong="H3068"\w* la maldad \w ni|strong="H3808"\w* te portes \w como|strong="H4100"\w* un \w necio|strong="H5530"\w*. ¿\w Para|strong="H1961"\w* \w qué|strong="H4100"\w* \w morir|strong="H4191"\w* antes \w de|strong="H6256"\w* \w tiempo|strong="H6256"\w*?  
\v 18 \w Lo|strong="H2088"\w* \w mejor|strong="H2896"\w* \w es|strong="H2088"\w* agarrar \w bien|strong="H2896"\w* \w esto|strong="H2088"\w* sin soltar aquello; \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* honra \w a|strong="H3068"\w* Dios \w saldrá|strong="H3318"\w* \w bien|strong="H2896"\w* \w de|strong="H3588"\w* \w todo|strong="H3605"\w*.  
\v 19 \w La|strong="H2451"\w* \w sabiduría|strong="H2451"\w* le da \w más|strong="H2451"\w* fuerza al \w sabio|strong="H2450"\w* \w que|strong="H1961"\w* \w diez|strong="H6235"\w* gobernantes \w a|strong="H3068"\w* una \w ciudad|strong="H5892"\w*.  
\v 20 \w Lo|strong="H3808"\w* \w cierto|strong="H3588"\w* \w es|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* hay \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w nadie|strong="H3808"\w* tan \w justo|strong="H6662"\w* \w que|strong="H3588"\w* siempre \w haga|strong="H6213"\w* \w el|strong="H3588"\w* \w bien|strong="H2896"\w* \w y|strong="H3588"\w* \w nunca|strong="H3808"\w* \w peque|strong="H2398"\w*.  
\v 21 \w No|strong="H3808"\w* \w pongas|strong="H5414"\w* atención \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w dice|strong="H1696"\w* \w la|strong="H1571"\w* gente, \w para|strong="H5414"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w oigas|strong="H8085"\w* \w a|strong="H3068"\w* tu servidor \w hablando|strong="H1696"\w* mal \w de|strong="H1697"\w* ti;  
\v 22 \w pues|strong="H3588"\w* tú \w bien|strong="H3588"\w* \w sabes|strong="H3045"\w* \w que|strong="H3588"\w* \w muchas|strong="H7227"\w* \w veces|strong="H6471"\w* \w también|strong="H1571"\w* tú has hablado mal \w de|strong="H3588"\w* otros.  
\v 23 \w Todo|strong="H3605"\w* \w esto|strong="H1931"\w* \w lo|strong="H1931"\w* puse \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w con|strong="H4480"\w* \w sabiduría|strong="H2451"\w*. \w Yo|strong="H4480"\w* dije: “Voy \w a|strong="H3068"\w* ser \w sabio|strong="H2449"\w*”, pero \w la|strong="H1931"\w* \w sabiduría|strong="H2451"\w* \w se|strong="H1931"\w* \w me|strong="H4480"\w* escapaba.  
\v 24 \w Lo|strong="H4100"\w* \w que|strong="H4100"\w* existe \w es|strong="H1961"\w* muy \w profundo|strong="H6013"\w* y \w está|strong="H1961"\w* \w lejos|strong="H7350"\w* de nuestro alcance. ¿\w Quién|strong="H4310"\w* podrá descubrirlo?  
\v 25 Me dediqué de lleno \w a|strong="H3068"\w* investigar y \w a|strong="H3068"\w* buscar \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* y \w la|strong="H2451"\w* lógica de lo \w que|strong="H3045"\w* sucede, para entender \w que|strong="H3045"\w* \w la|strong="H2451"\w* maldad es una estupidez y \w la|strong="H2451"\w* necedad una \w locura|strong="H5531"\w*.   
\p
\v 26 He encontrado \w algo|strong="H3920"\w* \w más|strong="H4480"\w* \w amargo|strong="H4751"\w* \w que|strong="H4480"\w* \w la|strong="H1931"\w* \w muerte|strong="H4194"\w*: \w a|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w que|strong="H4480"\w* \w es|strong="H1931"\w* \w como|strong="H1931"\w* \w una|strong="H4672"\w* trampa, \w cuyo|strong="H1931"\w* \w corazón|strong="H3820"\w* \w es|strong="H1931"\w* \w una|strong="H4672"\w* red y \w sus|strong="H1931"\w* \w manos|strong="H3027"\w* son cadenas. \w El|strong="H1931"\w* \w que|strong="H4480"\w* \w agrada|strong="H2896"\w* \w a|strong="H3068"\w* Dios \w escapará|strong="H4422"\w* \w de|strong="H4480"\w* \w ella|strong="H1931"\w*, pero \w el|strong="H1931"\w* \w pecador|strong="H2398"\w* caerá \w en|strong="H4480"\w* \w sus|strong="H1931"\w* redes.   
\p
\v 27 “Miren \w lo|strong="H2088"\w* \w que|strong="H2088"\w* he \w hallado|strong="H4672"\w*”, dice el Predicador, “después de analizar las cosas \w una|strong="H4672"\w* \w por|strong="H2088"\w* \w una|strong="H4672"\w* para encontrarles explicación.  
\v 28 He buscado algo \w más|strong="H5750"\w*, pero \w todavía|strong="H5750"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encuentro: he \w hallado|strong="H4672"\w* un hombre cabal \w entre|strong="H3808"\w* mil, pero \w entre|strong="H3808"\w* las mujeres \w ni|strong="H3808"\w* \w una|strong="H4672"\w* sola.  
\v 29 Solo he llegado \w a|strong="H3068"\w* \w esta|strong="H2088"\w* conclusión: Dios \w hizo|strong="H6213"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* seres humanos sencillos y \w rectos|strong="H3477"\w*, pero \w ellos|strong="H1992"\w* \w se|strong="H1992"\w* han buscado demasiadas artimañas.”   
\c 8  
\p
\v 1 ¿\w Quién|strong="H4310"\w* \w se|strong="H3045"\w* compara al \w sabio|strong="H2450"\w*? ¿\w Quién|strong="H4310"\w* \w más|strong="H2451"\w* \w conoce|strong="H3045"\w* \w la|strong="H2451"\w* explicación \w de|strong="H6440"\w* las \w cosas|strong="H1697"\w*? \w La|strong="H2451"\w* \w sabiduría|strong="H2451"\w* del hombre ilumina su \w rostro|strong="H6440"\w* \w y|strong="H5797"\w* suaviza su gesto endurecido.   
\p
\v 2 \w Mi|strong="H5921"\w* consejo es este: “Obedece \w las|strong="H5921"\w* órdenes \w del|strong="H5921"\w* \w rey|strong="H4428"\w*”, pues hiciste un \w juramento|strong="H7621"\w* ante Dios.  
\v 3 \w No|strong="H6213"\w* \w te|strong="H3588"\w* apresures \w a|strong="H3068"\w* salir \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w presencia|strong="H6440"\w*, ni \w te|strong="H3588"\w* metas \w en|strong="H3588"\w* problemas, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H6213"\w* \w hace|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* le place.  
\v 4 \w Ya|strong="H3068"\w* \w que|strong="H4100"\w* la \w palabra|strong="H1697"\w* del \w rey|strong="H4428"\w* tiene autoridad, ¿\w quién|strong="H4310"\w* puede pedirle cuentas \w de|strong="H1697"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w hace|strong="H6213"\w*?  
\v 5 El \w que|strong="H3808"\w* obedece sus órdenes \w no|strong="H3808"\w* sufrirá daño alguno; el \w corazón|strong="H3820"\w* del \w sabio|strong="H2450"\w* \w sabe|strong="H3045"\w* \w cuándo|strong="H6256"\w* y cómo debe actuar.  
\v 6 \w Porque|strong="H3588"\w* \w para|strong="H5921"\w* \w todo|strong="H3605"\w* asunto \w hay|strong="H3426"\w* un momento \w y|strong="H3588"\w* una manera \w de|strong="H5921"\w* actuar, \w aunque|strong="H3588"\w* \w el|strong="H5921"\w* hombre esté cargado \w de|strong="H5921"\w* problemas.  
\v 7 Nadie \w sabe|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* suceder; ¿\w quién|strong="H4310"\w* puede decirle \w qué|strong="H3588"\w* pasará \w después|strong="H1961"\w*?  
\v 8 \w Nadie|strong="H3808"\w* tiene poder sobre el \w viento|strong="H7307"\w* para retenerlo, \w ni|strong="H3808"\w* \w nadie|strong="H3808"\w* tiene poder sobre el \w día|strong="H3117"\w* de su \w muerte|strong="H4194"\w*. \w Nadie|strong="H3808"\w* queda libre de la \w batalla|strong="H4421"\w* \w en|strong="H4917"\w* \w tiempo|strong="H3117"\w* de \w guerra|strong="H4421"\w*, \w ni|strong="H3808"\w* la maldad \w salvará|strong="H4422"\w* \w a|strong="H3068"\w* \w los|strong="H1167"\w* \w que|strong="H3808"\w* la practican.   
\p
\v 9 \w Todo|strong="H3605"\w* \w esto|strong="H2088"\w* he \w visto|strong="H7200"\w* \w al|strong="H6256"\w* reflexionar \w en|strong="H8478"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H2088"\w* se \w hace|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*. Hay momentos \w en|strong="H8478"\w* \w que|strong="H2088"\w* un hombre tiene poder sobre \w otro|strong="H2088"\w* \w para|strong="H5414"\w* perjudicarlo.  
\v 10 \w También|strong="H1571"\w* \w vi|strong="H7200"\w* \w que|strong="H1571"\w* los malvados eran \w enterrados|strong="H6912"\w* \w con|strong="H1571"\w* honra; \w en|strong="H6912"\w* cambio, \w a|strong="H3068"\w* los \w que|strong="H1571"\w* frecuentaban \w el|strong="H6213"\w* \w lugar|strong="H4725"\w* \w santo|strong="H6918"\w* los \w olvidaron|strong="H7911"\w* \w en|strong="H6912"\w* \w la|strong="H1571"\w* misma \w ciudad|strong="H5892"\w* \w donde|strong="H4725"\w* \w hicieron|strong="H6213"\w* \w el|strong="H6213"\w* \w bien|strong="H3651"\w*. ¡\w Esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w*!  
\v 11 Cuando \w no|strong="H6213"\w* \w se|strong="H5921"\w* castiga \w de|strong="H5921"\w* inmediato una \w mala|strong="H7451"\w* acción, \w los|strong="H1121"\w* seres humanos \w se|strong="H5921"\w* sienten plenamente dispuestos \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w el|strong="H5921"\w* \w mal|strong="H7451"\w*.  
\v 12 \w Aunque|strong="H3588"\w* un \w pecador|strong="H2398"\w* cometa \w cien|strong="H3967"\w* delitos \w y|strong="H1571"\w* siga viviendo mucho tiempo, \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* muy \w bien|strong="H2896"\w* \w que|strong="H3588"\w* les irá \w mejor|strong="H2896"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w que|strong="H3588"\w* honran \w a|strong="H3068"\w* Dios \w y|strong="H1571"\w* le muestran reverencia.  
\v 13 Al malvado, en cambio, \w no|strong="H3808"\w* le irá \w bien|strong="H2896"\w* \w ni|strong="H3808"\w* \w se|strong="H1961"\w* alargará su \w vida|strong="H3117"\w*; sus \w días|strong="H3117"\w* \w serán|strong="H1961"\w* \w como|strong="H1961"\w* una \w sombra|strong="H6738"\w* \w porque|strong="H3808"\w* \w no|strong="H3808"\w* \w tiene|strong="H1961"\w* temor \w de|strong="H6440"\w* Dios.   
\p
\v 14 \w Hay|strong="H3426"\w* algo \w más|strong="H1571"\w* \w que|strong="H5921"\w* \w no|strong="H6213"\w* \w tiene|strong="H3426"\w* sentido \w en|strong="H5921"\w* \w este|strong="H2088"\w* mundo: \w a|strong="H3068"\w* veces \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w justos|strong="H6662"\w* \w les|strong="H5921"\w* \w sucede|strong="H5060"\w* \w lo|strong="H2088"\w* \w que|strong="H5921"\w* merecen \w los|strong="H5921"\w* malvados, \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* malvados \w les|strong="H5921"\w* \w sucede|strong="H5060"\w* \w lo|strong="H2088"\w* \w que|strong="H5921"\w* merecen \w los|strong="H5921"\w* \w justos|strong="H6662"\w*. \w Y|strong="H3068"\w* digo \w que|strong="H5921"\w* \w esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w*.  
\v 15 \w Por|strong="H3588"\w* \w eso|strong="H1931"\w* \w yo|strong="H3588"\w* recomiendo disfrutar \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w vida|strong="H2416"\w*, \w porque|strong="H3588"\w* \w no|strong="H3588"\w* hay nada \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w el|strong="H1931"\w* hombre \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w* \w que|strong="H3588"\w* comer, \w beber|strong="H8354"\w* \w y|strong="H3588"\w* divertirse. \w Eso|strong="H1931"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* único \w que|strong="H3588"\w* \w le|strong="H1931"\w* queda \w de|strong="H3588"\w* \w su|strong="H1931"\w* esfuerzo durante \w los|strong="H1931"\w* \w días|strong="H3117"\w* \w de|strong="H3588"\w* \w vida|strong="H2416"\w* \w que|strong="H3588"\w* Dios \w le|strong="H1931"\w* \w da|strong="H5414"\w* \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w*.   
\p
\v 16 \w Me|strong="H5921"\w* dediqué \w de|strong="H5921"\w* \w corazón|strong="H3820"\w* \w a|strong="H3068"\w* buscar \w la|strong="H5921"\w* \w sabiduría|strong="H2451"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* observar todo \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* \w hace|strong="H6213"\w* \w en|strong="H5921"\w* este mundo (¡hay quienes \w no|strong="H6213"\w* cierran \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w ni|strong="H1571"\w* \w de|strong="H5921"\w* \w día|strong="H3117"\w* \w ni|strong="H1571"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w*!).  
\v 17 \w Entonces|strong="H3588"\w* comprendí \w toda|strong="H3605"\w* \w la|strong="H1571"\w* \w obra|strong="H4639"\w* \w de|strong="H3588"\w* Dios: \w el|strong="H3588"\w* ser humano \w no|strong="H3808"\w* \w es|strong="H3588"\w* capaz \w de|strong="H3588"\w* entender \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* \w hace|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H3588"\w* \w sol|strong="H8121"\w*. \w Por|strong="H3588"\w* mucho \w que|strong="H3588"\w* \w se|strong="H3045"\w* esfuerce \w en|strong="H3588"\w* buscar \w una|strong="H4672"\w* explicación, \w no|strong="H3808"\w* \w la|strong="H1571"\w* encontrará; \w aunque|strong="H3588"\w* \w el|strong="H3588"\w* \w sabio|strong="H2450"\w* diga \w que|strong="H3588"\w* \w la|strong="H1571"\w* \w conoce|strong="H3045"\w*, \w en|strong="H3588"\w* realidad \w no|strong="H3808"\w* \w puede|strong="H3201"\w* comprenderla.   
\c 9  
\p
\v 1 \w Todo|strong="H3605"\w* \w esto|strong="H2088"\w* \w lo|strong="H2088"\w* he meditado \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w* \w y|strong="H1571"\w* he llegado \w a|strong="H3068"\w* \w esta|strong="H2088"\w* conclusión: \w que|strong="H3588"\w* \w los|strong="H3605"\w* \w justos|strong="H6662"\w* \w y|strong="H1571"\w* \w los|strong="H3605"\w* \w sabios|strong="H2450"\w*, \w junto|strong="H3027"\w* \w con|strong="H3588"\w* sus obras, \w están|strong="H2088"\w* \w en|strong="H3588"\w* las \w manos|strong="H3027"\w* \w de|strong="H3588"\w* Dios. \w Nadie|strong="H3605"\w* \w sabe|strong="H3045"\w* \w si|strong="H3588"\w* le espera \w el|strong="H3588"\w* amor \w o|strong="H3068"\w* \w el|strong="H3588"\w* \w odio|strong="H8135"\w*; \w nadie|strong="H3605"\w* \w sabe|strong="H3045"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* tiene \w por|strong="H3588"\w* \w delante|strong="H6440"\w*.  
\v 2 \w A|strong="H3068"\w* \w todos|strong="H3605"\w* nos espera \w el|strong="H3605"\w* \w mismo|strong="H3605"\w* destino: al \w justo|strong="H6662"\w* y al malvado, al \w bueno|strong="H2896"\w* y al malo, al \w puro|strong="H2889"\w* y al impuro, al \w que|strong="H3605"\w* ofrece \w sacrificios|strong="H2076"\w* y al \w que|strong="H3605"\w* \w no|strong="H7563"\w* \w los|strong="H3605"\w* ofrece. Al \w bueno|strong="H2896"\w* le \w va|strong="H3068"\w* como al \w pecador|strong="H2398"\w*, y al \w que|strong="H3605"\w* hace juramentos como al \w que|strong="H3605"\w* \w teme|strong="H3372"\w* hacerlos.  
