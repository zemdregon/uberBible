\q2 y el \w que|strong="H3808"\w* \w se|strong="H3808"\w* queda mirando las \w nubes|strong="H5645"\w*, \w nunca|strong="H3808"\w* cosecha.   
\q1
\v 5 \w Así|strong="H3602"\w* \w como|strong="H4100"\w* \w no|strong="H3808"\w* \w sabes|strong="H3045"\w* \w por|strong="H1870"\w* dónde \w va|strong="H3068"\w* \w el|strong="H3605"\w* \w viento|strong="H7307"\w*,  
\q2 \w ni|strong="H3808"\w* \w cómo|strong="H4100"\w* \w se|strong="H3045"\w* forma \w el|strong="H3605"\w* cuerpo en \w el|strong="H3605"\w* vientre de una mujer embarazada,  
\q2 \w tampoco|strong="H3808"\w* puedes comprender \w la|strong="H3605"\w* \w obra|strong="H4639"\w* de Dios, creador de \w todas|strong="H3605"\w* las \w cosas|strong="H3045"\w*.   
\q1
\v 6 \w Siembra|strong="H2233"\w* tu semilla \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w mañana|strong="H1242"\w*,  
\q2 \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w tarde|strong="H6153"\w* \w no|strong="H3588"\w* dejes \w de|strong="H3588"\w* trabajar;  
\q2 \w porque|strong="H3588"\w* \w no|strong="H3588"\w* \w sabes|strong="H3045"\w* \w qué|strong="H3588"\w* dará \w mejor|strong="H2896"\w* resultado, \w si|strong="H3588"\w* \w esto|strong="H2088"\w* \w o|strong="H3068"\w* aquello,  
\q2 \w o|strong="H3068"\w* \w si|strong="H3588"\w* \w ambas|strong="H8147"\w* \w cosas|strong="H3045"\w* resultarán igual \w de|strong="H3588"\w* \w buenas|strong="H2896"\w*.   
\q1
\v 7 ¡Qué \w hermosa|strong="H2896"\w* es la luz!,  
\q2 ¡qué agradable es para los \w ojos|strong="H5869"\w* \w ver|strong="H7200"\w* el \w sol|strong="H8121"\w*!   
\q1
\v 8 \w Si|strong="H3588"\w* un hombre \w vive|strong="H2421"\w* \w muchos|strong="H7235"\w* \w años|strong="H8141"\w*, \w que|strong="H3588"\w* disfrute \w de|strong="H3588"\w* \w cada|strong="H3605"\w* uno \w de|strong="H3588"\w* \w ellos|strong="H3605"\w*;  
\q2 \w pero|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* olvide \w que|strong="H3588"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H3588"\w* \w oscuridad|strong="H2822"\w* \w serán|strong="H1961"\w* \w muchos|strong="H7235"\w*.  
\q2 \w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3588"\w* \w está|strong="H1961"\w* \w por|strong="H3588"\w* venir \w es|strong="H1961"\w* \w vanidad|strong="H1892"\w*.   
\q1
\v 9 ¡\w Alégrate|strong="H8055"\w*, joven, \w ahora|strong="H3117"\w* \w que|strong="H3588"\w* eres joven!  
\q2 Deja \w que|strong="H3588"\w* tu \w corazón|strong="H3820"\w* disfrute \w de|strong="H5921"\w* \w la|strong="H5921"\w* adolescencia.  
\q2 Sigue \w los|strong="H5921"\w* impulsos \w de|strong="H5921"\w* tu \w corazón|strong="H3820"\w* \w y|strong="H3588"\w* \w los|strong="H5921"\w* deseos \w de|strong="H5921"\w* tus \w ojos|strong="H5869"\w*;  
\q2 \w pero|strong="H3588"\w* recuerda \w que|strong="H3588"\w* \w por|strong="H5921"\w* \w todo|strong="H3605"\w* esto Dios \w te|strong="H5869"\w* llamará \w a|strong="H3068"\w* \w juicio|strong="H4941"\w*.   
\q1
\v 10 Aleja \w de|strong="H3588"\w* tu \w corazón|strong="H3820"\w* \w la|strong="H3588"\w* angustia  
\q2 \w y|strong="H3588"\w* \w aparta|strong="H5493"\w* \w el|strong="H3588"\w* sufrimiento \w de|strong="H3588"\w* tu cuerpo,  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3588"\w* juventud \w y|strong="H3588"\w* \w el|strong="H3588"\w* vigor \w de|strong="H3588"\w* \w la|strong="H3588"\w* vida \w son|strong="H3588"\w* \w vanidad|strong="H1892"\w*.   
\c 12  
\p
\v 1 \w Acuérdate|strong="H2142"\w* \w de|strong="H5704"\w* tu Creador \w ahora|strong="H3117"\w* \w que|strong="H3808"\w* eres joven,  
\q2 \w antes|strong="H5704"\w* \w de|strong="H5704"\w* \w que|strong="H3808"\w* vengan los \w días|strong="H3117"\w* \w malos|strong="H7451"\w* \w y|strong="H5704"\w* lleguen los \w años|strong="H8141"\w*  
\q2 \w en|strong="H5704"\w* los \w que|strong="H3808"\w* digas: “\w No|strong="H3808"\w* encuentro \w en|strong="H5704"\w* ellos \w ningún|strong="H3808"\w* placer;”   
\q1
\v 2 \w antes|strong="H5704"\w* \w de|strong="H5704"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* oscurezca la luz del \w sol|strong="H8121"\w*, la \w luna|strong="H3394"\w* \w y|strong="H5704"\w* las \w estrellas|strong="H3556"\w*,  
\q2 \w y|strong="H5704"\w* las \w nubes|strong="H5645"\w* \w vuelvan|strong="H7725"\w* \w a|strong="H3068"\w* aparecer \w después|strong="H5704"\w* \w de|strong="H5704"\w* la \w lluvia|strong="H1653"\w*.   
\q1
\v 3 Llegará \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w en|strong="H3588"\w* \w que|strong="H3588"\w* tiemblen \w los|strong="H3588"\w* guardianes \w de|strong="H3588"\w* \w la|strong="H8104"\w* \w casa|strong="H1004"\w*,  
\q2 \w y|strong="H3588"\w* se encorven \w los|strong="H3588"\w* hombres \w valientes|strong="H2428"\w*;  
\q2 \w cuando|strong="H3588"\w* las molineras dejen \w de|strong="H3588"\w* trabajar \w por|strong="H3588"\w* ser ya \w pocas|strong="H4592"\w*,  
\q2 \w y|strong="H3588"\w* se nuble \w la|strong="H8104"\w* vista \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w miran|strong="H8104"\w* \w por|strong="H3588"\w* las ventanas.   
\q1
\v 4 Entonces se cerrarán las \w puertas|strong="H1817"\w* \w que|strong="H1323"\w* dan \w a|strong="H3068"\w* \w la|strong="H3605"\w* calle,  
\q2 y \w el|strong="H3605"\w* \w ruido|strong="H6963"\w* del molino se irá apagando;  
\q2 \w el|strong="H3605"\w* hombre se \w levantará|strong="H6965"\w* al canto de \w los|strong="H3605"\w* pájaros,  
\q2 pero \w todas|strong="H3605"\w* las \w canciones|strong="H7892"\w* se escucharán distantes.   
\q1
\v 5 Se tendrá \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* las alturas  
\q2 \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* peligros del \w camino|strong="H1870"\w*.  
\q2 \w El|strong="H3588"\w* almendro florecerá,  
\q2 \w el|strong="H3588"\w* saltamontes será una carga  
\q2 \w y|strong="H1571"\w* \w el|strong="H3588"\w* deseo \w ya|strong="H1571"\w* \w no|strong="H3588"\w* despertará.  
\q2 \w Pues|strong="H3588"\w* \w el|strong="H3588"\w* hombre \w va|strong="H3068"\w* \w camino|strong="H1870"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* hogar \w eterno|strong="H5769"\w*,  
\q2 \w y|strong="H1571"\w* \w por|strong="H3588"\w* las calles \w ya|strong="H1571"\w* rondan \w los|strong="H3588"\w* \w que|strong="H3588"\w* lloran \w su|strong="H3588"\w* muerte.   
\q1
\v 6 Acuérdate \w de|strong="H5921"\w* \w él|strong="H5921"\w* \w antes|strong="H5704"\w* \w de|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* reviente \w el|strong="H5921"\w* cordón \w de|strong="H5921"\w* \w plata|strong="H3701"\w*,  
\q2 \w o|strong="H3068"\w* \w se|strong="H5921"\w* rompa \w la|strong="H5921"\w* copa \w de|strong="H5921"\w* \w oro|strong="H2091"\w*,  
\q2 \w o|strong="H3068"\w* \w se|strong="H5921"\w* quiebre \w el|strong="H5921"\w* \w cántaro|strong="H3537"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* manantial,  
\q2 \w o|strong="H3068"\w* \w se|strong="H5921"\w* despedace \w la|strong="H5921"\w* polea \w del|strong="H5921"\w* pozo.   
\q1
\v 7 \w Entonces|strong="H7725"\w* \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w tierra|strong="H6083"\w*, \w de|strong="H5921"\w* \w donde|strong="H5921"\w* \w vino|strong="H1961"\w*,  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* Dios, \w que|strong="H5921"\w* \w fue|strong="H1961"\w* quien \w lo|strong="H5921"\w* \w dio|strong="H5414"\w*.   
\q2
\v 8 “¡Vana ilusión!”, dice \w el|strong="H3605"\w* Predicador.  
\q2 “¡\w Todo|strong="H3605"\w* es pura \w vanidad|strong="H1892"\w*!”   
\p
\v 9 \w Además|strong="H5750"\w* \w de|strong="H5750"\w* ser \w sabio|strong="H2450"\w*, el Predicador \w enseñó|strong="H3925"\w* sus conocimientos al \w pueblo|strong="H5971"\w*; meditó, investigó y redactó muchísimos \w proverbios|strong="H4912"\w*.  
\v 10 El Predicador se esforzó \w por|strong="H1697"\w* encontrar las \w palabras|strong="H1697"\w* \w más|strong="H1245"\w* adecuadas para \w escribir|strong="H3789"\w* la verdad con mucha claridad.  
\v 11 Las \w palabras|strong="H1697"\w* \w de|strong="H1697"\w* \w los|strong="H1167"\w* \w sabios|strong="H2450"\w* son como aguijones; las colecciones \w de|strong="H1697"\w* sus dichos son como clavos bien puestos, entregados \w por|strong="H1697"\w* un solo \w Pastor|strong="H7462"\w*.  
\v 12 Pero además \w de|strong="H1121"\w* \w esto|strong="H6213"\w*, \w hijo|strong="H1121"\w* mío, ten cuidado: \w el|strong="H1121"\w* escribir \w muchos|strong="H7235"\w* \w libros|strong="H5612"\w* \w es|strong="H7235"\w* algo \w que|strong="H1121"\w* \w no|strong="H6213"\w* tiene \w fin|strong="H7093"\w*, y \w el|strong="H1121"\w* estudiar \w demasiado|strong="H7235"\w* solo agota \w el|strong="H1121"\w* cuerpo.   
\p
\v 13 \w Este|strong="H2088"\w* \w es|strong="H2088"\w* \w el|strong="H3588"\w* final \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* has \w oído|strong="H8085"\w*: \w Teman|strong="H3372"\w* \w a|strong="H3068"\w* Dios \w y|strong="H3588"\w* cumplan sus \w mandamientos|strong="H4687"\w*, \w porque|strong="H3588"\w* eso \w es|strong="H2088"\w* \w todo|strong="H3605"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* ser humano.  
\v 14 \w Pues|strong="H3588"\w* Dios juzgará \w cada|strong="H3605"\w* una \w de|strong="H5921"\w* nuestras acciones, incluyendo \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* oculto, sea \w bueno|strong="H2896"\w* \w o|strong="H3068"\w* sea \w malo|strong="H7451"\w*.   