\id ECC  
\h ECLESIASTÉS 
\toc3 Eclesiastés 
\toc1 ECLESIASTÉS O EL PREDICADOR 
\toc2 ECLESIASTÉS 
\mt1 Eclesiastés  
\mt2 o, El predicador  
\c 1  
\p
\v 1 Estas son las \w palabras|strong="H1697"\w* del Predicador, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* en Jerusalén:   
\p
\v 2 “¡Vana ilusión!”, dice \w el|strong="H3605"\w* Predicador; “¡Vana ilusión, \w todo|strong="H3605"\w* es pura \w vanidad|strong="H1892"\w*!”.  
\v 3 ¿\w Qué|strong="H4100"\w* \w provecho|strong="H3504"\w* obtiene \w el|strong="H3605"\w* hombre \w de|strong="H8478"\w* tanto \w trabajar|strong="H5998"\w* \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*?  
\v 4 Una \w generación|strong="H1755"\w* se \w va|strong="H3068"\w* y otra \w viene|strong="H1980"\w*, pero la tierra \w siempre|strong="H5769"\w* \w permanece|strong="H5975"\w* igual.  
\v 5 \w El|strong="H1931"\w* \w sol|strong="H8121"\w* \w sale|strong="H2224"\w*, \w el|strong="H1931"\w* \w sol|strong="H8121"\w* \w se|strong="H1931"\w* pone, y corre ansioso por volver \w a|strong="H3068"\w* salir.  
\v 6 \w El|strong="H5921"\w* \w viento|strong="H7307"\w* sopla \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* sur \w y|strong="H5921"\w* \w luego|strong="H7725"\w* gira \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w norte|strong="H6828"\w*; \w da|strong="H7725"\w* vueltas \w y|strong="H5921"\w* vueltas, \w y|strong="H5921"\w* \w en|strong="H5921"\w* sus giros \w vuelve|strong="H7725"\w* \w siempre|strong="H1980"\w* \w a|strong="H3068"\w* empezar.  
\v 7 \w Los|strong="H1992"\w* ríos corren \w todos|strong="H3605"\w* \w hacia|strong="H8033"\w* \w el|strong="H3605"\w* \w mar|strong="H3220"\w*, pero \w el|strong="H3605"\w* \w mar|strong="H3220"\w* nunca \w se|strong="H1992"\w* \w llena|strong="H4392"\w*; \w los|strong="H1992"\w* ríos \w vuelven|strong="H7725"\w* al \w lugar|strong="H4725"\w* de \w donde|strong="H8033"\w* salieron, para comenzar de nuevo \w su|strong="H1992"\w* curso.  
\v 8 \w Todo|strong="H3605"\w* \w es|strong="H1697"\w* tan cansado \w que|strong="H3808"\w* \w no|strong="H3808"\w* hay \w palabras|strong="H1697"\w* para expresarlo. \w Los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w nunca|strong="H3808"\w* \w ven|strong="H7200"\w* \w lo|strong="H1697"\w* suficiente y \w los|strong="H3605"\w* \w oídos|strong="H8085"\w* \w nunca|strong="H3808"\w* \w oyen|strong="H8085"\w* \w lo|strong="H1697"\w* bastante.  
\v 9 \w Lo|strong="H1931"\w* \w que|strong="H4100"\w* ya \w fue|strong="H1961"\w*, \w eso|strong="H1931"\w* volverá \w a|strong="H3068"\w* ser; \w lo|strong="H1931"\w* \w que|strong="H4100"\w* ya \w se|strong="H1961"\w* \w hizo|strong="H6213"\w*, \w eso|strong="H1931"\w* volverá \w a|strong="H3068"\w* hacerse. ¡\w No|strong="H6213"\w* \w hay|strong="H1961"\w* \w nada|strong="H3605"\w* \w nuevo|strong="H2319"\w* \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w*!  
\v 10 ¿\w Hay|strong="H3426"\w* \w algo|strong="H1697"\w* \w de|strong="H6440"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* pueda decir: “¡Miren, \w esto|strong="H2088"\w* \w es|strong="H1931"\w* \w algo|strong="H1697"\w* \w nuevo|strong="H2319"\w*!”? \w No|strong="H1961"\w*, \w eso|strong="H1931"\w* \w ya|strong="H3528"\w* \w existía|strong="H1961"\w* mucho \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w nosotros|strong="H1931"\w*.  
\v 11 \w Nadie|strong="H3808"\w* recuerda \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w sucedió|strong="H1961"\w* \w antes|strong="H7223"\w*, \w y|strong="H1571"\w* \w tampoco|strong="H1571"\w* \w nadie|strong="H3808"\w* recordará \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w está|strong="H1961"\w* por suceder \w entre|strong="H5973"\w* \w los|strong="H1992"\w* \w que|strong="H3808"\w* vendrán \w después|strong="H1961"\w*.   
\p
\v 12 Yo, \w el|strong="H5921"\w* Predicador, \w fui|strong="H1961"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* Jerusalén.  
\v 13 \w Me|strong="H5921"\w* dediqué \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w* \w a|strong="H3068"\w* investigar \w y|strong="H5921"\w* \w a|strong="H3068"\w* explorar \w con|strong="H5921"\w* \w sabiduría|strong="H2451"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* \w hace|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w cielo|strong="H8064"\w*. ¡\w Qué|strong="H1931"\w* carga \w tan|strong="H1931"\w* pesada ha \w puesto|strong="H5414"\w* Dios\f + \fr 1:13 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* \w sobre|strong="H5921"\w* \w los|strong="H1121"\w* seres humanos \w para|strong="H5921"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* agobien \w con|strong="H5921"\w* \w ella|strong="H1931"\w*!  
\v 14 He observado \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* se \w hace|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*, y \w la|strong="H3605"\w* verdad es \w que|strong="H3605"\w* \w todo|strong="H3605"\w* es \w vanidad|strong="H1892"\w*; ¡es \w como|strong="H8478"\w* querer atrapar \w el|strong="H3605"\w* \w viento|strong="H7307"\w*!  
\v 15 \w Lo|strong="H3808"\w* \w que|strong="H3808"\w* está torcido \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w puede|strong="H3201"\w* enderezar, y \w lo|strong="H3808"\w* \w que|strong="H3808"\w* falta \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w puede|strong="H3201"\w* contar.  
\v 16 \w Me|strong="H5921"\w* puse \w a|strong="H3068"\w* pensar: “He llegado \w a|strong="H3068"\w* ser un \w gran|strong="H7235"\w* sabio, \w más|strong="H3254"\w* \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* reinaron \w antes|strong="H6440"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w en|strong="H5921"\w* Jerusalén; he acumulado muchísima \w sabiduría|strong="H2451"\w* \w y|strong="H5921"\w* \w conocimiento|strong="H1847"\w*”.  
\v 17 \w Entonces|strong="H1571"\w* me dediqué \w a|strong="H3068"\w* entender \w qué|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w sabiduría|strong="H2451"\w*, \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w qué|strong="H1931"\w* son \w la|strong="H1931"\w* \w locura|strong="H5531"\w* \w y|strong="H1571"\w* \w la|strong="H1931"\w* necedad. Pero me \w di|strong="H5414"\w* cuenta \w de|strong="H5414"\w* \w que|strong="H1931"\w* \w también|strong="H1571"\w* \w esto|strong="H2088"\w* \w es|strong="H1931"\w* \w como|strong="H1571"\w* querer atrapar \w el|strong="H1931"\w* \w viento|strong="H7307"\w*.  
\v 18 \w Porque|strong="H3588"\w* \w a|strong="H3068"\w* \w mayor|strong="H7227"\w* \w sabiduría|strong="H2451"\w*, \w mayor|strong="H7227"\w* sufrimiento; \w y|strong="H3588"\w* \w entre|strong="H3588"\w* \w más|strong="H3588"\w* se \w sabe|strong="H2451"\w*, \w más|strong="H3588"\w* se sufre.   
\c 2  
\p
\v 1 Me dije \w entonces|strong="H1571"\w*: “¡\w Vamos|strong="H3212"\w*!, te voy \w a|strong="H3068"\w* poner \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w con|strong="H1571"\w* \w el|strong="H1931"\w* placer; ¡disfruta de \w lo|strong="H1931"\w* \w bueno|strong="H2896"\w*!”. Pero resultó \w que|strong="H1931"\w* \w también|strong="H1571"\w* \w esto|strong="H1931"\w* \w era|strong="H1931"\w* \w vanidad|strong="H1892"\w*.  
\v 2 De la risa dije: “Es una locura”, y del placer: “¿Para \w qué|strong="H4100"\w* \w sirve|strong="H6213"\w* \w esto|strong="H2090"\w*?”.   
\p
\v 3 Se me ocurrió estimular mi cuerpo \w con|strong="H5704"\w* \w vino|strong="H3196"\w* —\w aunque|strong="H5704"\w* mi mente seguía guiada \w por|strong="H8478"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*— \w y|strong="H5704"\w* entregarme \w a|strong="H3068"\w* \w la|strong="H2451"\w* necedad, \w para|strong="H5704"\w* \w ver|strong="H7200"\w* \w qué|strong="H5704"\w* \w era|strong="H1121"\w* \w lo|strong="H2088"\w* \w mejor|strong="H2896"\w* \w que|strong="H5704"\w* \w los|strong="H1121"\w* seres humanos podían \w hacer|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H1121"\w* \w cielo|strong="H8064"\w* durante \w los|strong="H1121"\w* \w contados|strong="H4557"\w* \w días|strong="H3117"\w* \w de|strong="H8478"\w* su \w vida|strong="H2416"\w*.  
\v 4 Realicé \w grandes|strong="H1431"\w* \w obras|strong="H4639"\w*: me construí \w casas|strong="H1004"\w* y \w planté|strong="H5193"\w* mis propios viñedos.  
\v 5 Diseñé jardines y parques, y \w planté|strong="H5193"\w* en \w ellos|strong="H3605"\w* \w toda|strong="H3605"\w* clase de \w árboles|strong="H6086"\w* frutales.  
\v 6 Construí estanques \w de|strong="H4325"\w* \w agua|strong="H4325"\w* para regar \w los|strong="H1992"\w* bosques donde \w crecían|strong="H6779"\w* \w los|strong="H1992"\w* \w árboles|strong="H6086"\w*.  
\v 7 Compré esclavos \w y|strong="H1571"\w* esclavas, \w y|strong="H1571"\w* \w tuve|strong="H1961"\w* otros \w que|strong="H1571"\w* nacieron en \w mi|strong="H3389"\w* \w casa|strong="H1004"\w*. \w También|strong="H1571"\w* llegué \w a|strong="H3068"\w* \w tener|strong="H1961"\w* \w mucho|strong="H7235"\w* \w ganado|strong="H4735"\w*, \w vacas|strong="H1241"\w* \w y|strong="H1571"\w* \w ovejas|strong="H6629"\w*, \w más|strong="H1571"\w* \w que|strong="H1571"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1571"\w* vivieron \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H3389"\w* en Jerusalén.  
\v 8 Amontoné \w oro|strong="H2091"\w* \w y|strong="H1571"\w* \w plata|strong="H3701"\w*, \w y|strong="H1571"\w* tesoros \w que|strong="H1571"\w* antes pertenecieron \w a|strong="H3068"\w* \w reyes|strong="H4428"\w* \w y|strong="H1571"\w* \w provincias|strong="H4082"\w*. Tuve cantantes, \w hombres|strong="H1121"\w* \w y|strong="H1571"\w* mujeres, \w y|strong="H1571"\w* \w lo|strong="H6213"\w* \w que|strong="H1571"\w* \w más|strong="H1571"\w* deleita \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w*: ¡toda clase \w de|strong="H1121"\w* \w instrumentos|strong="H7705"\w* musicales!  
\v 9 Así llegué \w a|strong="H3068"\w* ser muy \w poderoso|strong="H1431"\w*, mucho \w más|strong="H3254"\w* \w que|strong="H1961"\w* \w cualquiera|strong="H3605"\w* \w de|strong="H6440"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* \w estuvieron|strong="H1961"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H1431"\w* \w en|strong="H5975"\w* Jerusalén; y \w en|strong="H5975"\w* \w todo|strong="H3605"\w* esto, \w no|strong="H1961"\w* perdí \w mi|strong="H1431"\w* \w sabiduría|strong="H2451"\w*.  
\v 10 \w No|strong="H3808"\w* \w les|strong="H1992"\w* negué \w a|strong="H3068"\w* mis \w ojos|strong="H5869"\w* \w nada|strong="H3808"\w* \w de|strong="H3588"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* deseaban, \w ni|strong="H3808"\w* \w me|strong="H3588"\w* privé \w de|strong="H3588"\w* \w ningún|strong="H3605"\w* placer. Al contrario, \w me|strong="H3588"\w* sentí orgulloso \w de|strong="H3588"\w* \w todo|strong="H3605"\w* \w mi|strong="H1961"\w* \w trabajo|strong="H5999"\w*; ¡\w ese|strong="H2088"\w* \w fue|strong="H1961"\w* \w el|strong="H3588"\w* premio \w por|strong="H3588"\w* \w todos|strong="H3605"\w* mis esfuerzos!  
\v 11 Pero cuando me puse \w a|strong="H3068"\w* pensar \w en|strong="H8478"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* mis \w manos|strong="H3027"\w* habían \w hecho|strong="H6213"\w* y \w en|strong="H8478"\w* \w lo|strong="H6213"\w* mucho \w que|strong="H3605"\w* me \w había|strong="H6213"\w* esforzado, me di cuenta \w de|strong="H8478"\w* \w que|strong="H3605"\w* \w todo|strong="H3605"\w* era \w vanidad|strong="H1892"\w* y un querer atrapar \w el|strong="H3605"\w* \w viento|strong="H7307"\w*. ¡\w No|strong="H6213"\w* se saca \w ningún|strong="H3605"\w* \w provecho|strong="H3504"\w* \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*!   
\p
\v 12 \w Entonces|strong="H3588"\w* \w me|strong="H3588"\w* puse \w a|strong="H3068"\w* reflexionar sobre \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*, \w la|strong="H2451"\w* \w locura|strong="H5531"\w* \w y|strong="H3588"\w* \w la|strong="H2451"\w* necedad. \w Porque|strong="H3588"\w*, ¿\w qué|strong="H3588"\w* \w más|strong="H3588"\w* puede \w hacer|strong="H6213"\w* \w el|strong="H3588"\w* sucesor del \w rey|strong="H4428"\w*, aparte \w de|strong="H3588"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w ya|strong="H3528"\w* \w se|strong="H4100"\w* \w ha|strong="H3528"\w* \w hecho|strong="H6213"\w*?  
\v 13 \w Y|strong="H3068"\w* \w vi|strong="H7200"\w* \w que|strong="H4480"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* \w es|strong="H3426"\w* superior \w a|strong="H3068"\w* \w la|strong="H2451"\w* necedad, así como \w la|strong="H2451"\w* luz \w es|strong="H3426"\w* superior \w a|strong="H3068"\w* \w la|strong="H2451"\w* \w oscuridad|strong="H2822"\w*.  
\v 14 \w El|strong="H3605"\w* \w sabio|strong="H2450"\w* \w ve|strong="H1980"\w* por dónde \w camina|strong="H1980"\w*, pero \w el|strong="H3605"\w* \w necio|strong="H3684"\w* \w anda|strong="H1980"\w* \w a|strong="H3068"\w* tientas en \w la|strong="H1571"\w* \w oscuridad|strong="H2822"\w*. Sin embargo, me di cuenta \w de|strong="H5869"\w* \w que|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* dos les espera \w el|strong="H3605"\w* \w mismo|strong="H1571"\w* final.  
\v 15 \w Entonces|strong="H1571"\w* pensé: “\w Si|strong="H1571"\w* me \w va|strong="H3068"\w* \w a|strong="H3068"\w* pasar \w lo|strong="H4100"\w* \w mismo|strong="H1571"\w* \w que|strong="H4100"\w* al \w necio|strong="H3684"\w*, ¿de \w qué|strong="H4100"\w* me sirve haber sido tan \w sabio|strong="H2449"\w*?”. \w Y|strong="H3068"\w* concluí \w que|strong="H4100"\w* \w también|strong="H1571"\w* \w esto|strong="H2088"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w*.  
\v 16 \w Porque|strong="H3588"\w* \w nadie|strong="H3605"\w* se acordará \w para|strong="H3588"\w* \w siempre|strong="H5769"\w* \w ni|strong="H5973"\w* \w del|strong="H5973"\w* \w sabio|strong="H2450"\w* \w ni|strong="H5973"\w* \w del|strong="H5973"\w* \w necio|strong="H3684"\w*; \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w tiempo|strong="H3117"\w*, \w todo|strong="H3605"\w* caerá \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w olvido|strong="H7911"\w*. ¡Tanto \w el|strong="H5973"\w* \w sabio|strong="H2450"\w* \w como|strong="H3588"\w* \w el|strong="H5973"\w* \w necio|strong="H3684"\w* tienen \w que|strong="H3588"\w* \w morir|strong="H4191"\w*!   
\p
\v 17 \w Por|strong="H5921"\w* eso llegué \w a|strong="H3068"\w* odiar \w la|strong="H5921"\w* \w vida|strong="H2416"\w*, \w pues|strong="H3588"\w* \w me|strong="H5921"\w* causaba angustia \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* \w hace|strong="H6213"\w* \w bajo|strong="H8478"\w* \w el|strong="H5921"\w* \w sol|strong="H8121"\w*. \w Todo|strong="H3605"\w* \w es|strong="H3588"\w* \w vanidad|strong="H1892"\w*; ¡\w es|strong="H3588"\w* \w como|strong="H3588"\w* querer atrapar \w el|strong="H5921"\w* \w viento|strong="H7307"\w*!  
\v 18 También llegué \w a|strong="H3068"\w* detestar \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w trabajo|strong="H5999"\w* \w por|strong="H8478"\w* \w el|strong="H3605"\w* \w que|strong="H1961"\w* tanto me \w había|strong="H1961"\w* esforzado \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*, \w pues|strong="H1961"\w* \w tendré|strong="H1961"\w* \w que|strong="H1961"\w* dejárselo \w a|strong="H3068"\w* \w quien|strong="H3605"\w* \w venga|strong="H1961"\w* \w después|strong="H1961"\w* \w de|strong="H8478"\w* \w mí|strong="H1961"\w*.  
\v 19 ¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w si|strong="H1571"\w* \w será|strong="H1961"\w* \w sabio|strong="H2450"\w* \w o|strong="H3068"\w* tonto? \w Lo|strong="H2088"\w* \w cierto|strong="H1571"\w* \w es|strong="H1961"\w* \w que|strong="H4310"\w* \w se|strong="H3045"\w* \w hará|strong="H1961"\w* dueño \w de|strong="H8478"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H4310"\w* yo logré \w con|strong="H1571"\w* tanto esfuerzo \w y|strong="H1571"\w* \w sabiduría|strong="H3045"\w* \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w sol|strong="H8121"\w*. ¡\w Esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H1961"\w* \w vanidad|strong="H1892"\w*!   
\p
\v 20 \w Por|strong="H5921"\w* eso caí \w en|strong="H5921"\w* \w la|strong="H5921"\w* desesperación \w al|strong="H5921"\w* pensar \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w mi|strong="H5921"\w* \w trabajo|strong="H5999"\w* \w bajo|strong="H8478"\w* \w el|strong="H5921"\w* \w sol|strong="H8121"\w*.  
\v 21 \w Pues|strong="H3588"\w* \w hay|strong="H3426"\w* quienes \w trabajan|strong="H5998"\w* \w con|strong="H3588"\w* \w sabiduría|strong="H2451"\w*, \w conocimiento|strong="H1847"\w* \w y|strong="H1571"\w* rectitud, \w para|strong="H3588"\w* \w luego|strong="H2088"\w* dejarle todo \w a|strong="H3068"\w* alguien \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w hizo|strong="H5414"\w* \w ningún|strong="H3808"\w* esfuerzo. ¡\w Esto|strong="H2088"\w* \w también|strong="H1571"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* una \w gran|strong="H7227"\w* injusticia!  
\v 22 ¿\w Qué|strong="H3588"\w* gana \w el|strong="H1931"\w* hombre \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w su|strong="H1931"\w* \w trabajo|strong="H5999"\w* \w y|strong="H3588"\w* \w con|strong="H3588"\w* \w la|strong="H1931"\w* fatiga \w que|strong="H3588"\w* soporta \w bajo|strong="H8478"\w* \w el|strong="H1931"\w* \w sol|strong="H8121"\w*?  
\v 23 \w Todos|strong="H3605"\w* \w sus|strong="H1931"\w* \w días|strong="H3117"\w* \w son|strong="H3588"\w* \w de|strong="H3588"\w* \w dolor|strong="H4341"\w* \w y|strong="H1571"\w* \w sus|strong="H1931"\w* tareas \w son|strong="H3588"\w* una carga; \w ni|strong="H3808"\w* siquiera \w de|strong="H3588"\w* \w noche|strong="H3915"\w* \w descansa|strong="H7901"\w* \w su|strong="H1931"\w* mente. ¡\w También|strong="H1571"\w* \w esto|strong="H2088"\w* \w es|strong="H1931"\w* \w vanidad|strong="H1892"\w*!  
\v 24 \w No|strong="H3588"\w* hay nada \w mejor|strong="H2896"\w* \w para|strong="H3588"\w* \w el|strong="H1931"\w* hombre \w que|strong="H3588"\w* \w comer|strong="H5315"\w*, \w beber|strong="H8354"\w* \w y|strong="H1571"\w* disfrutar \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w trabajo|strong="H5999"\w*. He \w visto|strong="H7200"\w* \w que|strong="H3588"\w* \w esto|strong="H1931"\w* \w también|strong="H1571"\w* viene \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w de|strong="H3588"\w* Dios.  
\v 25 \w Porque|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* puede comer \w o|strong="H3068"\w* disfrutar \w de|strong="H4480"\w* \w la|strong="H3588"\w* vida \w si|strong="H3588"\w* \w no|strong="H3588"\w* \w es|strong="H3588"\w* \w por|strong="H3588"\w* \w él|strong="H3588"\w*?  
\v 26 \w Porque|strong="H3588"\w* al \w que|strong="H3588"\w* le \w agrada|strong="H2896"\w*, Dios le \w da|strong="H5414"\w* \w sabiduría|strong="H2451"\w*, \w conocimiento|strong="H1847"\w* \w y|strong="H1571"\w* \w alegría|strong="H8057"\w*; \w pero|strong="H3588"\w* al \w que|strong="H3588"\w* \w peca|strong="H2398"\w*, le \w da|strong="H5414"\w* \w la|strong="H1571"\w* carga \w de|strong="H3588"\w* acumular \w y|strong="H1571"\w* amontonar riquezas \w para|strong="H3588"\w* dárselas \w a|strong="H3068"\w* quien \w a|strong="H3068"\w* Dios le \w agrada|strong="H2896"\w*. \w También|strong="H1571"\w* \w esto|strong="H2088"\w* \w es|strong="H2088"\w* \w vanidad|strong="H1892"\w* \w y|strong="H1571"\w* un querer atrapar \w el|strong="H3588"\w* \w viento|strong="H7307"\w*.   
\c 3  
\p
\v 1 \w Todo|strong="H3605"\w* tiene su momento oportuno; hay un \w tiempo|strong="H6256"\w* para \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H6256"\w* se hace \w bajo|strong="H8478"\w* \w el|strong="H3605"\w* \w cielo|strong="H8064"\w*:   
\q1
\v 2 un \w tiempo|strong="H6256"\w* para nacer,  
\q2 y un \w tiempo|strong="H6256"\w* para \w morir|strong="H4191"\w*;  
\q1 un \w tiempo|strong="H6256"\w* para plantar,  
\q2 y un \w tiempo|strong="H6256"\w* para cosechar;   
\q1
\v 3 un \w tiempo|strong="H6256"\w* para matar,  
\q2 y un \w tiempo|strong="H6256"\w* para sanar;  
\q1 un \w tiempo|strong="H6256"\w* para destruir,  
\q2 y un \w tiempo|strong="H6256"\w* para construir;   
\q1
\v 4 un \w tiempo|strong="H6256"\w* para llorar,  
\q2 y un \w tiempo|strong="H6256"\w* para reír;  
\q1 un \w tiempo|strong="H6256"\w* para estar \w de|strong="H6256"\w* luto,  
\q2 y un \w tiempo|strong="H6256"\w* para saltar \w de|strong="H6256"\w* gusto;   
\q1
\v 5 un \w tiempo|strong="H6256"\w* para esparcir piedras,  
\q2 y un \w tiempo|strong="H6256"\w* para amontonarlas;  
\q1 un \w tiempo|strong="H6256"\w* para abrazarse,  
\q2 y un \w tiempo|strong="H6256"\w* para despedirse;   
\q1
\v 6 un \w tiempo|strong="H6256"\w* para buscar,  
\q2 y un \w tiempo|strong="H6256"\w* para dar por perdido;  
\q1 un \w tiempo|strong="H6256"\w* para \w guardar|strong="H8104"\w*,  
\q2 y un \w tiempo|strong="H6256"\w* para tirar;   
\q1
\v 7 un \w tiempo|strong="H6256"\w* para rasgar,  
\q2 y un \w tiempo|strong="H6256"\w* para coser;  
