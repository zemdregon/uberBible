\v 8 \w Por|strong="G1722"\w* \w lo|strong="G3588"\w* \w demás|strong="G3063"\w*, \w me|strong="G1473"\w* espera \w la|strong="G3588"\w* \w corona|strong="G4735"\w* \w de|strong="G1722"\w* \w justicia|strong="G1343"\w* \w que|strong="G3588"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w*, \w el|strong="G3588"\w* \w juez|strong="G2923"\w* \w justo|strong="G1342"\w*, \w me|strong="G1473"\w* entregará \w en|strong="G1722"\w* \w aquel|strong="G3588"\w* \w día|strong="G2250"\w*; \w y|strong="G2532"\w* \w no|strong="G3756"\w* \w solo|strong="G3441"\w* \w a|strong="G1722"\w* \w mí|strong="G3588"\w*, \w sino|strong="G1161"\w* \w también|strong="G2532"\w* \w a|strong="G1722"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* esperan \w con|strong="G1722"\w* amor \w su|strong="G3588"\w* \w venida|strong="G2015"\w*.   
\p
\v 9 Haz todo lo posible \w por|strong="G4314"\w* \w venir|strong="G2064"\w* \w a|strong="G4314"\w* verme \w pronto|strong="G5030"\w*,  
