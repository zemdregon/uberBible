\v 17 \w a|strong="G4314"\w* fin \w de|strong="G4314"\w* \w que|strong="G3588"\w* \w el|strong="G3588"\w* siervo \w de|strong="G4314"\w* \w Dios|strong="G2316"\w* \w esté|strong="G3588"\w* completamente capacitado \w para|strong="G2443"\w* \w toda|strong="G3956"\w* buena \w obra|strong="G2041"\w*.   
\c 4  
\p
\v 1 Te ordeno solemnemente \w en|strong="G3588"\w* \w la|strong="G3588"\w* \w presencia|strong="G1799"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w de|strong="G3588"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*, \w quien|strong="G3588"\w* \w ha|strong="G3195"\w* \w de|strong="G3588"\w* \w juzgar|strong="G2919"\w* \w a|strong="G1799"\w* \w los|strong="G3588"\w* \w vivos|strong="G2198"\w* \w y|strong="G2532"\w* \w a|strong="G1799"\w* \w los|strong="G3588"\w* \w muertos|strong="G3498"\w* \w en|strong="G3588"\w* \w su|strong="G3588"\w* \w venida|strong="G2015"\w* \w y|strong="G2532"\w* \w en|strong="G3588"\w* \w su|strong="G3588"\w* Reino:  
\v 2 \w Predica|strong="G2784"\w* \w la|strong="G3588"\w* \w palabra|strong="G3056"\w*; insiste \w a|strong="G1722"\w* tiempo \w y|strong="G2532"\w* \w a|strong="G1722"\w* destiempo; corrige, \w reprende|strong="G2008"\w* \w y|strong="G2532"\w* anima \w con|strong="G1722"\w* mucha \w paciencia|strong="G3115"\w*, \w sin|strong="G2532"\w* dejar \w de|strong="G1722"\w* enseñar.  
