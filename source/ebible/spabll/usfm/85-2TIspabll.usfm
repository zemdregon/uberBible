\v 20 \w En|strong="G1722"\w* \w una|strong="G1519"\w* \w casa|strong="G3614"\w* \w grande|strong="G3173"\w* \w no|strong="G3756"\w* \w solo|strong="G3441"\w* hay \w vasos|strong="G4632"\w* \w de|strong="G1722"\w* \w oro|strong="G5552"\w* \w y|strong="G2532"\w* \w de|strong="G1722"\w* plata, \w sino|strong="G1161"\w* \w también|strong="G2532"\w* \w de|strong="G1722"\w* madera \w y|strong="G2532"\w* \w de|strong="G1722"\w* barro. \w Unos|strong="G3303"\w* \w son|strong="G1510"\w* \w para|strong="G1519"\w* usos especiales \w y|strong="G2532"\w* \w otros|strong="G3739"\w* \w para|strong="G1519"\w* usos comunes.  
\v 21 \w Si|strong="G1437"\w* \w alguien|strong="G5100"\w* \w se|strong="G1438"\w* mantiene limpio \w de|strong="G1519"\w* \w todo|strong="G3956"\w* mal, será \w un|strong="G5100"\w* \w vaso|strong="G4632"\w* \w para|strong="G1519"\w* uso honroso, santificado, \w útil|strong="G2173"\w* \w para|strong="G1519"\w* \w el|strong="G3588"\w* \w Señor|strong="G1203"\w* \w y|strong="G3767"\w* \w preparado|strong="G2090"\w* \w para|strong="G1519"\w* \w toda|strong="G3956"\w* buena \w obra|strong="G2041"\w*.   
