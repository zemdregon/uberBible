\v 18 (¡\w Que|strong="G3588"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w le|strong="G1722"\w* conceda \w hallar|strong="G2147"\w* \w misericordia|strong="G1656"\w* \w de|strong="G3844"\w* parte \w del|strong="G3588"\w* \w Señor|strong="G2962"\w* \w en|strong="G1722"\w* \w aquel|strong="G3588"\w* \w día|strong="G2250"\w*!). \w Tú|strong="G4771"\w* \w conoces|strong="G1097"\w* muy bien \w todo|strong="G3745"\w* \w lo|strong="G3588"\w* \w que|strong="G3588"\w* \w me|strong="G1722"\w* \w ayudó|strong="G1247"\w* \w en|strong="G1722"\w* Éfeso.   
\c 2  
\p
\v 1 \w Tú|strong="G4771"\w*, \w pues|strong="G3767"\w*, \w hijo|strong="G5043"\w* mío, fortalécete \w en|strong="G1722"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w que|strong="G3588"\w* tenemos \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*.  
