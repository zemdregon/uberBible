\v 5 \w Pero|strong="G1161"\w* \w tú|strong="G4771"\w*, mantén \w la|strong="G3588"\w* calma \w en|strong="G1722"\w* \w toda|strong="G3956"\w* situación, \w soporta|strong="G2553"\w* \w los|strong="G3588"\w* sufrimientos, \w haz|strong="G4160"\w* \w la|strong="G3588"\w* \w obra|strong="G2041"\w* \w de|strong="G1722"\w* \w un|strong="G3588"\w* \w evangelista|strong="G2099"\w* \w y|strong="G1161"\w* \w cumple|strong="G4135"\w* \w bien|strong="G1161"\w* \w tu|strong="G4771"\w* \w ministerio|strong="G1248"\w*.   
\p
\v 6 \w Porque|strong="G1063"\w* \w mi|strong="G3588"\w* vida \w ya|strong="G2235"\w* \w está|strong="G3588"\w* siendo derramada \w como|strong="G2532"\w* \w una|strong="G3588"\w* ofrenda, \w y|strong="G2532"\w* \w se|strong="G2532"\w* acerca \w el|strong="G3588"\w* momento \w de|strong="G3588"\w* \w mi|strong="G3588"\w* partida.  
