\v 19 A pesar \w de|strong="G3588"\w* \w todo|strong="G3956"\w*, \w el|strong="G3588"\w* \w firme|strong="G4731"\w* \w fundamento|strong="G2310"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* \w se|strong="G2532"\w* mantiene intacto, sellado \w con|strong="G2532"\w* \w esta|strong="G3778"\w* inscripción: “\w El|strong="G3588"\w* \w Señor|strong="G2962"\w* \w conoce|strong="G1097"\w* a \w los|strong="G3588"\w* suyos”, \w y|strong="G2532"\w*: “\w Que|strong="G3588"\w* \w se|strong="G2532"\w* aparte \w de|strong="G3588"\w* \w la|strong="G3588"\w* maldad \w todo|strong="G3956"\w* \w el|strong="G3588"\w* \w que|strong="G3588"\w* invoca \w el|strong="G3588"\w* \w nombre|strong="G3686"\w* \w del|strong="G3588"\w* \w Señor|strong="G2962"\w*”.   
