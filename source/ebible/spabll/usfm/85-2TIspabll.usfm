\v 17 \w Pero|strong="G1161"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w sí|strong="G2532"\w* estuvo \w a|strong="G1537"\w* \w mi|strong="G3588"\w* lado \w y|strong="G2532"\w* \w me|strong="G1473"\w* dio fuerzas, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1537"\w* \w mí|strong="G3588"\w* \w el|strong="G3588"\w* mensaje \w fuera|strong="G1537"\w* proclamado \w con|strong="G1223"\w* claridad \w y|strong="G2532"\w* \w lo|strong="G3588"\w* escucharan \w todos|strong="G3956"\w* \w los|strong="G3588"\w* gentiles. \w Así|strong="G2532"\w* fui librado \w de|strong="G1537"\w* \w la|strong="G3588"\w* \w boca|strong="G4750"\w* \w del|strong="G3588"\w* \w león|strong="G3023"\w*.  
\v 18 \w El|strong="G3588"\w* \w Señor|strong="G2962"\w* \w me|strong="G1473"\w* \w librará|strong="G4506"\w* \w de|strong="G1519"\w* \w todo|strong="G3956"\w* \w mal|strong="G4190"\w* \w y|strong="G2532"\w* \w me|strong="G1473"\w* \w salvará|strong="G4982"\w* \w para|strong="G1519"\w* \w su|strong="G3588"\w* Reino \w celestial|strong="G2032"\w*. ¡\w A|strong="G1519"\w* \w él|strong="G3588"\w* \w sea|strong="G3588"\w* \w la|strong="G3588"\w* \w gloria|strong="G1391"\w* \w por|strong="G1519"\w* \w los|strong="G3588"\w* siglos \w de|strong="G1519"\w* \w los|strong="G3588"\w* siglos! Amén.   
