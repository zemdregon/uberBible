\c 3  
\p
\v 1 \w También|strong="G1161"\w* debes \w saber|strong="G1097"\w* \w que|strong="G3754"\w* \w en|strong="G1722"\w* \w los|strong="G3748"\w* últimos \w días|strong="G2250"\w* \w vendrán|strong="G1764"\w* \w tiempos|strong="G2540"\w* muy difíciles.  
\v 2 \w Porque|strong="G1063"\w* \w la|strong="G3588"\w* gente será egoísta, amante \w del|strong="G3588"\w* dinero, presumida, orgullosa, blasfema, desobediente a \w sus|strong="G3588"\w* \w padres|strong="G1118"\w*, malagradecida, no tendrá respeto \w por|strong="G1063"\w* \w la|strong="G3588"\w* religión,  
\v 3 no tendrá amor ni compasión, serán \w calumniadores|strong="G1228"\w*, no tendrán dominio propio, serán crueles, enemigos de todo lo bueno,  
\v 4 \w traidores|strong="G4273"\w*, impulsivos \w y|strong="G2228"\w* llenos de soberbia. Amarán \w más|strong="G3123"\w* el placer \w que|strong="G2228"\w* a Dios;  
\v 5 \w tendrán|strong="G2192"\w* \w apariencia|strong="G3446"\w* \w de|strong="G3588"\w* \w piedad|strong="G2150"\w*, \w pero|strong="G1161"\w* negarán \w su|strong="G3588"\w* \w eficacia|strong="G1411"\w*. Aléjate \w de|strong="G3588"\w* esa clase \w de|strong="G3588"\w* gente.  
\v 6 \w De|strong="G1537"\w* \w ellos|strong="G3588"\w* \w son|strong="G1510"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* meten \w en|strong="G1519"\w* \w las|strong="G3588"\w* \w casas|strong="G3614"\w* \w y|strong="G2532"\w* engañan \w a|strong="G1519"\w* mujeres débiles, \w cargadas|strong="G4987"\w* \w de|strong="G1537"\w* pecados \w y|strong="G2532"\w* arrastradas \w por|strong="G1537"\w* toda clase \w de|strong="G1537"\w* malos \w deseos|strong="G1939"\w*,  
\v 7 mujeres \w que|strong="G1519"\w* \w siempre|strong="G3842"\w* están aprendiendo, \w pero|strong="G2532"\w* \w que|strong="G1519"\w* \w nunca|strong="G3368"\w* logran comprender la verdad.  
\v 8 \w Así|strong="G3779"\w* \w como|strong="G2532"\w* Janes \w y|strong="G2532"\w* \w Jambres|strong="G2387"\w* \w se|strong="G3779"\w* opusieron \w a|strong="G1161"\w* \w Moisés|strong="G3475"\w*, \w de|strong="G4012"\w* \w la|strong="G3588"\w* misma \w manera|strong="G5158"\w* \w estos|strong="G3778"\w* hombres \w se|strong="G3779"\w* oponen \w a|strong="G1161"\w* \w la|strong="G3588"\w* \w verdad|strong="G4102"\w*. Son hombres \w de|strong="G4012"\w* \w mente|strong="G3563"\w* corrompida \w y|strong="G2532"\w* fracasados \w en|strong="G4012"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w*.  
\v 9 \w Pero|strong="G2532"\w* \w no|strong="G3756"\w* llegarán \w muy|strong="G4183"\w* lejos, \w porque|strong="G1063"\w* \w su|strong="G3588"\w* estupidez \w será|strong="G1096"\w* evidente \w para|strong="G1909"\w* \w todos|strong="G3956"\w*, \w como|strong="G5613"\w* \w les|strong="G1565"\w* pasó \w a|strong="G1909"\w* \w aquellos|strong="G1565"\w* dos.   
\p
\v 10 \w Pero|strong="G1161"\w* \w tú|strong="G4771"\w* has seguido \w de|strong="G3588"\w* cerca mis enseñanzas, \w mi|strong="G3588"\w* conducta, mis propósitos, \w mi|strong="G3588"\w* \w fe|strong="G4102"\w*, \w mi|strong="G3588"\w* \w paciencia|strong="G5281"\w*, \w mi|strong="G3588"\w* amor, \w mi|strong="G3588"\w* constancia,  
\v 11 mis \w persecuciones|strong="G1375"\w* \w y|strong="G2532"\w* mis sufrimientos. Sabes muy bien \w lo|strong="G3588"\w* \w que|strong="G3588"\w* \w me|strong="G1473"\w* pasó \w en|strong="G1722"\w* Antioquía, \w en|strong="G1722"\w* \w Iconio|strong="G2430"\w* \w y|strong="G2532"\w* \w en|strong="G1722"\w* \w Listra|strong="G3082"\w*. ¡\w Qué|strong="G3588"\w* \w persecuciones|strong="G1375"\w* soporté! \w Y|strong="G2532"\w* \w de|strong="G1537"\w* \w todas|strong="G3956"\w* \w ellas|strong="G3588"\w* \w me|strong="G1473"\w* \w libró|strong="G4506"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w*.  
