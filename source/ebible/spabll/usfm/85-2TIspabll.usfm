\v 22 \w Huye|strong="G5343"\w* \w de|strong="G1537"\w* \w las|strong="G3588"\w* pasiones \w de|strong="G1537"\w* \w la|strong="G3588"\w* juventud \w y|strong="G1161"\w* busca \w la|strong="G3588"\w* \w justicia|strong="G1343"\w*, \w la|strong="G3588"\w* \w fe|strong="G4102"\w*, \w el|strong="G3588"\w* amor \w y|strong="G1161"\w* \w la|strong="G3588"\w* \w paz|strong="G1515"\w*, junto \w con|strong="G3326"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w invocan|strong="G1941"\w* \w al|strong="G3588"\w* \w Señor|strong="G2962"\w* \w con|strong="G3326"\w* \w un|strong="G3588"\w* \w corazón|strong="G2588"\w* \w limpio|strong="G2513"\w*.  
