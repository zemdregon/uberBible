\mt2 La carta del Apóstol San Pablo a los  
\mt1 Efesios  
\c 1  
\p
\v 1 \w Pablo|strong="G3972"\w*, apóstol \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w por|strong="G1223"\w* \w la|strong="G3588"\w* \w voluntad|strong="G2307"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*, \w a|strong="G1722"\w* \w los|strong="G3588"\w* santos \w y|strong="G2532"\w* \w fieles|strong="G4103"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w que|strong="G3588"\w* están \w en|strong="G1722"\w* Éfeso:  
\v 2 \w Que|strong="G2532"\w* la \w gracia|strong="G5485"\w* \w y|strong="G2532"\w* la \w paz|strong="G1515"\w* de \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Padre|strong="G3962"\w* \w y|strong="G2532"\w* del \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w* estén \w con|strong="G2532"\w* ustedes.   
\p
\v 3 Alabado \w sea|strong="G3588"\w* \w el|strong="G3588"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w Padre|strong="G3962"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*, \w que|strong="G3588"\w* \w nos|strong="G2316"\w* ha bendecido \w en|strong="G1722"\w* \w los|strong="G3588"\w* lugares \w celestiales|strong="G2032"\w* \w con|strong="G1722"\w* \w toda|strong="G3956"\w* clase \w de|strong="G1722"\w* \w bendiciones|strong="G2129"\w* \w espirituales|strong="G4152"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w*.  
\v 4 \w Pues|strong="G2532"\w* Dios nos eligió \w en|strong="G1722"\w* \w él|strong="G1722"\w* \w antes|strong="G4253"\w* \w de|strong="G1722"\w* la creación del \w mundo|strong="G2889"\w*, \w para|strong="G1722"\w* \w que|strong="G2532"\w* seamos santos \w y|strong="G2532"\w* \w sin|strong="G2532"\w* mancha \w delante|strong="G4253"\w* \w de|strong="G1722"\w* \w él|strong="G1722"\w*. \w En|strong="G1722"\w* amor,  
\v 5 nos \w predestinó|strong="G4309"\w* \w para|strong="G1519"\w* ser adoptados \w como|strong="G2596"\w* hijos suyos \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1519"\w* \w Jesucristo|strong="G2424"\w*, \w según|strong="G2596"\w* \w el|strong="G3588"\w* buen propósito \w de|strong="G1519"\w* \w su|strong="G3588"\w* \w voluntad|strong="G2307"\w*,  
\v 6 \w para|strong="G1519"\w* \w alabanza|strong="G1868"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w gloriosa|strong="G1391"\w* \w gracia|strong="G5485"\w*, \w la|strong="G3588"\w* \w cual|strong="G3739"\w* nos concedió gratuitamente \w en|strong="G1722"\w* \w su|strong="G3588"\w* \w Hijo|strong="G3588"\w* amado.  
\v 7 \w En|strong="G1722"\w* \w él|strong="G3588"\w* \w tenemos|strong="G2192"\w* \w la|strong="G3588"\w* redención \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* sangre, \w el|strong="G3588"\w* perdón \w de|strong="G1722"\w* nuestros \w pecados|strong="G3900"\w*, \w según|strong="G2596"\w* \w las|strong="G3588"\w* \w riquezas|strong="G4149"\w* \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w de|strong="G1722"\w* Dios  
\v 8 \w que|strong="G3739"\w* derramó \w sobre|strong="G1519"\w* \w nosotros|strong="G2249"\w* \w con|strong="G1722"\w* \w toda|strong="G3956"\w* \w sabiduría|strong="G4678"\w* \w y|strong="G2532"\w* entendimiento.  
\v 9 \w Él|strong="G3588"\w* nos dio \w a|strong="G1722"\w* conocer \w el|strong="G3588"\w* \w misterio|strong="G3466"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w voluntad|strong="G2307"\w*, \w según|strong="G2596"\w* \w el|strong="G3588"\w* buen propósito \w que|strong="G3588"\w* \w de|strong="G1722"\w* antemano estableció \w en|strong="G1722"\w* Cristo,  
\v 10 \w para|strong="G1519"\w* llevarlo \w a|strong="G1519"\w* cabo \w cuando|strong="G1722"\w* \w se|strong="G2532"\w* cumpliera \w el|strong="G3588"\w* \w tiempo|strong="G2540"\w*: reunir \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w todas|strong="G3956"\w* \w las|strong="G3588"\w* cosas, tanto \w las|strong="G3588"\w* \w del|strong="G3588"\w* \w cielo|strong="G3772"\w* \w como|strong="G2532"\w* \w las|strong="G3588"\w* \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w tierra|strong="G1093"\w*.  
\v 11 \w En|strong="G1722"\w* \w él|strong="G3588"\w* \w también|strong="G2532"\w* fuimos elegidos herederos, habiendo sido predestinados \w según|strong="G2596"\w* \w el|strong="G3588"\w* plan \w de|strong="G1722"\w* \w aquel|strong="G3588"\w* \w que|strong="G3588"\w* hace \w todas|strong="G3956"\w* \w las|strong="G3588"\w* \w cosas|strong="G3739"\w* \w conforme|strong="G2596"\w* \w al|strong="G3588"\w* \w consejo|strong="G1012"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w voluntad|strong="G2307"\w*,  
\v 12 \w con|strong="G1722"\w* \w el|strong="G3588"\w* fin \w de|strong="G1722"\w* \w que|strong="G3588"\w* \w nosotros|strong="G2249"\w*, \w que|strong="G3588"\w* fuimos \w los|strong="G3588"\w* primeros \w en|strong="G1722"\w* esperar \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w*, seamos \w para|strong="G1519"\w* \w alabanza|strong="G1868"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w gloria|strong="G1391"\w*.  
\v 13 \w En|strong="G1722"\w* \w él|strong="G3588"\w* \w también|strong="G2532"\w* ustedes, \w cuando|strong="G1722"\w* oyeron \w el|strong="G3588"\w* mensaje \w de|strong="G1722"\w* \w la|strong="G3588"\w* verdad, \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w que|strong="G3588"\w* les trajo \w la|strong="G3588"\w* \w salvación|strong="G4991"\w*, \w y|strong="G2532"\w* \w creyeron|strong="G4100"\w* \w en|strong="G1722"\w* \w él|strong="G3588"\w*, fueron sellados \w con|strong="G1722"\w* \w el|strong="G3588"\w* \w Espíritu|strong="G4151"\w* Santo prometido.  
\v 14 \w Este|strong="G3588"\w* Espíritu \w es|strong="G3739"\w* \w la|strong="G3588"\w* garantía \w de|strong="G1519"\w* \w nuestra|strong="G3588"\w* \w herencia|strong="G2817"\w* \w hasta|strong="G1519"\w* \w que|strong="G3588"\w* llegue \w la|strong="G3588"\w* redención final \w de|strong="G1519"\w* \w la|strong="G3588"\w* \w posesión|strong="G4047"\w* adquirida \w por|strong="G1519"\w* Dios, \w para|strong="G1519"\w* \w alabanza|strong="G1868"\w* \w de|strong="G1519"\w* \w su|strong="G3588"\w* \w gloria|strong="G1391"\w*.   
\p
\v 15 \w Por|strong="G1223"\w* \w esta|strong="G3778"\w* \w razón|strong="G2596"\w*, desde \w que|strong="G3588"\w* \w me|strong="G1519"\w* enteré \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w* \w que|strong="G3588"\w* tienen \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w* \w y|strong="G2532"\w* \w del|strong="G3588"\w* amor \w que|strong="G3588"\w* demuestran \w hacia|strong="G1519"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* santos,  
\v 16 \w no|strong="G3756"\w* he dejado \w de|strong="G1909"\w* dar \w gracias|strong="G2168"\w* \w a|strong="G1909"\w* Dios \w por|strong="G5228"\w* ustedes. \w Los|strong="G3588"\w* recuerdo constantemente \w en|strong="G1909"\w* mis \w oraciones|strong="G4335"\w*,  
\v 17 \w y|strong="G2532"\w* \w le|strong="G1722"\w* pido \w al|strong="G3588"\w* \w Dios|strong="G2316"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*, \w el|strong="G3588"\w* \w Padre|strong="G3962"\w* \w glorioso|strong="G1391"\w*, \w que|strong="G3588"\w* les \w dé|strong="G1722"\w* \w el|strong="G3588"\w* \w Espíritu|strong="G4151"\w* \w de|strong="G1722"\w* \w sabiduría|strong="G4678"\w* \w y|strong="G2532"\w* \w de|strong="G1722"\w* revelación, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w lo|strong="G3588"\w* conozcan mejor.  
\v 18 Pido \w también|strong="G5210"\w* \w que|strong="G3588"\w* \w les|strong="G1519"\w* sean iluminados \w los|strong="G3588"\w* \w ojos|strong="G3788"\w* \w del|strong="G3588"\w* entendimiento, \w para|strong="G1519"\w* \w que|strong="G3588"\w* sepan \w cuál|strong="G5101"\w* es \w la|strong="G3588"\w* \w esperanza|strong="G1680"\w* \w a|strong="G1519"\w* \w la|strong="G3588"\w* \w que|strong="G3588"\w* \w él|strong="G3588"\w* \w los|strong="G3588"\w* ha llamado, \w cuáles|strong="G5101"\w* \w son|strong="G1510"\w* \w las|strong="G3588"\w* \w riquezas|strong="G4149"\w* \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w gloriosa|strong="G1391"\w* \w herencia|strong="G2817"\w* \w entre|strong="G1722"\w* \w los|strong="G3588"\w* santos,  
\v 19 \w y|strong="G2532"\w* cuán incomparable es \w la|strong="G3588"\w* \w grandeza|strong="G3174"\w* \w de|strong="G1519"\w* \w su|strong="G3588"\w* \w poder|strong="G1411"\w* \w a|strong="G1519"\w* favor \w de|strong="G1519"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w creemos|strong="G4100"\w*. Ese \w poder|strong="G1411"\w* es \w la|strong="G3588"\w* \w fuerza|strong="G1411"\w* grandiosa \w y|strong="G2532"\w* eficaz  
\v 20 \w que|strong="G3588"\w* Dios ejerció \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w cuando|strong="G1722"\w* \w lo|strong="G3588"\w* \w resucitó|strong="G1453"\w* \w de|strong="G1537"\w* \w entre|strong="G1722"\w* \w los|strong="G3588"\w* \w muertos|strong="G3498"\w* \w y|strong="G2532"\w* \w lo|strong="G3588"\w* sentó \w a|strong="G1722"\w* \w su|strong="G3588"\w* \w derecha|strong="G1188"\w* \w en|strong="G1722"\w* \w las|strong="G3588"\w* regiones \w celestiales|strong="G2032"\w*,  
\v 21 muy \w por|strong="G1722"\w* encima \w de|strong="G1722"\w* \w todo|strong="G3956"\w* gobierno \w y|strong="G2532"\w* \w autoridad|strong="G1849"\w*, \w poder|strong="G1411"\w* \w y|strong="G2532"\w* dominio, \w y|strong="G2532"\w* \w de|strong="G1722"\w* \w cualquier|strong="G3956"\w* \w otro|strong="G3588"\w* \w nombre|strong="G3686"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* invoque, \w no|strong="G3756"\w* \w solo|strong="G3441"\w* \w en|strong="G1722"\w* \w este|strong="G3778"\w* mundo sino \w también|strong="G2532"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w venidero|strong="G3195"\w*.  
\v 22 \w Dios|strong="G5259"\w* \w sometió|strong="G5293"\w* \w todas|strong="G3956"\w* \w las|strong="G3588"\w* cosas \w al|strong="G3588"\w* dominio \w de|strong="G5259"\w* Cristo, \w y|strong="G2532"\w* \w lo|strong="G3588"\w* \w dio|strong="G1325"\w* \w como|strong="G2532"\w* \w cabeza|strong="G2776"\w* \w de|strong="G5259"\w* \w todo|strong="G3956"\w* a \w la|strong="G3588"\w* \w iglesia|strong="G1577"\w*.  
\v 23 \w Esta|strong="G3588"\w*, \w que|strong="G3588"\w* es \w su|strong="G3588"\w* \w cuerpo|strong="G4983"\w*, es \w la|strong="G3588"\w* \w plenitud|strong="G4138"\w* \w de|strong="G1722"\w* \w aquel|strong="G3588"\w* \w que|strong="G3588"\w* \w lo|strong="G3588"\w* llena \w todo|strong="G3956"\w* \w por|strong="G1722"\w* completo.   
\c 2  
\p
\v 1 \w Él|strong="G3588"\w* les dio vida a ustedes, cuando estaban \w muertos|strong="G3498"\w* \w en|strong="G3588"\w* \w sus|strong="G3588"\w* transgresiones \w y|strong="G2532"\w* \w pecados|strong="G3900"\w*,  
\v 2 \w en|strong="G1722"\w* \w los|strong="G3588"\w* \w cuales|strong="G3739"\w* anduvieron \w en|strong="G1722"\w* \w otro|strong="G3739"\w* \w tiempo|strong="G3568"\w*, siguiendo \w la|strong="G3588"\w* corriente \w de|strong="G1722"\w* \w este|strong="G3778"\w* \w mundo|strong="G2889"\w* y \w al|strong="G3588"\w* príncipe \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w potestad|strong="G1849"\w* \w del|strong="G3588"\w* aire, \w el|strong="G3588"\w* \w espíritu|strong="G4151"\w* \w que|strong="G3588"\w* \w ahora|strong="G3568"\w* actúa \w en|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* son desobedientes.  
\v 3 \w En|strong="G1722"\w* ese tiempo \w también|strong="G2532"\w* \w todos|strong="G3956"\w* \w nosotros|strong="G2249"\w* vivíamos \w como|strong="G5613"\w* \w ellos|strong="G3588"\w*, impulsados \w por|strong="G1722"\w* nuestros \w deseos|strong="G1939"\w* pecaminosos, siguiendo \w nuestra|strong="G3588"\w* propia \w voluntad|strong="G2307"\w* \w y|strong="G2532"\w* nuestros propósitos. \w Como|strong="G5613"\w* \w los|strong="G3588"\w* \w demás|strong="G3062"\w*, \w éramos|strong="G1510"\w* \w por|strong="G1722"\w* \w naturaleza|strong="G5449"\w* merecedores \w del|strong="G3588"\w* \w castigo|strong="G3709"\w* \w de|strong="G1722"\w* Dios.  
\v 4 \w Pero|strong="G1161"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* \w es|strong="G3739"\w* \w rico|strong="G4145"\w* \w en|strong="G1722"\w* \w misericordia|strong="G1656"\w*, \w por|strong="G1223"\w* \w su|strong="G3588"\w* \w gran|strong="G4183"\w* amor \w con|strong="G1722"\w* \w que|strong="G3588"\w* \w nos|strong="G2316"\w* amó,  
\v 5 nos dio vida juntamente \w con|strong="G2532"\w* \w Cristo|strong="G5547"\w*, \w aun|strong="G2532"\w* cuando \w estábamos|strong="G1510"\w* \w muertos|strong="G3498"\w* \w en|strong="G3588"\w* nuestros \w pecados|strong="G3900"\w* (\w porque|strong="G2532"\w* \w por|strong="G3588"\w* \w gracia|strong="G5485"\w* han sido salvados),  
\v 6 \w y|strong="G2532"\w* nos resucitó \w con|strong="G1722"\w* \w él|strong="G3588"\w*, \w y|strong="G2532"\w* nos sentó \w con|strong="G1722"\w* \w él|strong="G3588"\w* \w en|strong="G1722"\w* \w los|strong="G3588"\w* lugares \w celestiales|strong="G2032"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*.  
\v 7 \w Lo|strong="G3588"\w* hizo \w para|strong="G2443"\w* demostrar \w en|strong="G1722"\w* \w los|strong="G3588"\w* tiempos \w venideros|strong="G1904"\w* \w la|strong="G3588"\w* incomparable riqueza \w de|strong="G1722"\w* \w su|strong="G3588"\w* \w gracia|strong="G5485"\w*, mediante \w su|strong="G3588"\w* \w bondad|strong="G5544"\w* \w hacia|strong="G1909"\w* \w nosotros|strong="G2249"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*.  
\v 8 \w Porque|strong="G1063"\w* \w por|strong="G1223"\w* \w gracia|strong="G5485"\w* ustedes han sido salvados mediante \w la|strong="G3588"\w* \w fe|strong="G4102"\w*; \w y|strong="G2532"\w* \w esto|strong="G3778"\w* \w no|strong="G3756"\w* procede \w de|strong="G1537"\w* ustedes, sino \w que|strong="G3588"\w* \w es|strong="G3756"\w* \w el|strong="G3588"\w* regalo \w de|strong="G1537"\w* \w Dios|strong="G2316"\w*,  
\v 9 \w no|strong="G3756"\w* \w por|strong="G1537"\w* \w obras|strong="G2041"\w*, \w para|strong="G2443"\w* \w que|strong="G2443"\w* \w nadie|strong="G3361"\w* se enorgullezca.  
\v 10 \w Porque|strong="G1063"\w* somos \w hechura|strong="G4161"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w*, creados \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w para|strong="G2443"\w* \w hacer|strong="G2041"\w* \w las|strong="G3588"\w* buenas \w obras|strong="G2041"\w* \w que|strong="G3588"\w* \w Dios|strong="G2316"\w* \w preparó|strong="G4282"\w* \w de|strong="G1722"\w* antemano \w para|strong="G2443"\w* \w que|strong="G3588"\w* anduviéramos \w en|strong="G1722"\w* \w ellas|strong="G3588"\w*.   
\p
\v 11 \w Por|strong="G1722"\w* \w lo|strong="G3588"\w* tanto, recuerden \w que|strong="G3754"\w* \w en|strong="G1722"\w* \w otro|strong="G4218"\w* tiempo ustedes, \w los|strong="G3588"\w* gentiles \w por|strong="G1722"\w* nacimiento, eran llamados “incircuncisos” \w por|strong="G1722"\w* \w aquellos|strong="G3588"\w* \w que|strong="G3754"\w* se \w llaman|strong="G3004"\w* \w a|strong="G1722"\w* sí mismos “circuncisos” (\w una|strong="G3588"\w* marca física hecha \w por|strong="G1722"\w* manos humanas).  
\v 12 Recuerden \w que|strong="G3754"\w* \w en|strong="G1722"\w* \w aquel|strong="G3588"\w* \w entonces|strong="G2532"\w* estaban separados \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*, excluidos \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w ciudadanía|strong="G4174"\w* \w de|strong="G1722"\w* \w Israel|strong="G2474"\w* \w y|strong="G2532"\w* ajenos \w a|strong="G1722"\w* \w los|strong="G3588"\w* \w pactos|strong="G1242"\w* \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w promesa|strong="G1860"\w*, \w sin|strong="G5565"\w* \w esperanza|strong="G1680"\w* \w y|strong="G2532"\w* \w sin|strong="G5565"\w* Dios \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w mundo|strong="G2889"\w*.  
\v 13 \w Pero|strong="G1161"\w* \w ahora|strong="G3570"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*, ustedes, \w que|strong="G3588"\w* \w antes|strong="G1161"\w* estaban \w lejos|strong="G3112"\w*, han \w sido|strong="G1096"\w* acercados mediante \w la|strong="G3588"\w* sangre \w de|strong="G1722"\w* \w Cristo|strong="G5547"\w*.  
