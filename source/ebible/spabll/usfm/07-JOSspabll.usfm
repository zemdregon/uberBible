\p
\v 6 “\w Esfuércense|strong="H2388"\w*, \w pues|strong="H4480"\w*, \w mucho|strong="H3966"\w* \w en|strong="H4480"\w* \w guardar|strong="H8104"\w* y \w hacer|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H5612"\w* \w que|strong="H4480"\w* \w está|strong="H3789"\w* \w escrito|strong="H3789"\w* \w en|strong="H4480"\w* \w el|strong="H3605"\w* \w libro|strong="H5612"\w* \w de|strong="H4480"\w* \w la|strong="H8104"\w* \w ley|strong="H8451"\w* \w de|strong="H4480"\w* \w Moisés|strong="H4872"\w*, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w no|strong="H6213"\w* \w se|strong="H4480"\w* aparten \w de|strong="H4480"\w* \w él|strong="H3605"\w* \w ni|strong="H1115"\w* \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w derecha|strong="H3225"\w* \w ni|strong="H1115"\w* \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w izquierda|strong="H8040"\w*;  
\v 7 para \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* mezclen con estas \w naciones|strong="H1471"\w* \w que|strong="H3808"\w* han quedado \w entre|strong="H3808"\w* ustedes, \w ni|strong="H3808"\w* mencionen el \w nombre|strong="H8034"\w* de sus dioses, \w ni|strong="H3808"\w* juren por ellos, \w ni|strong="H3808"\w* les sirvan, \w ni|strong="H3808"\w* \w se|strong="H3808"\w* inclinen ante ellos;  
\v 8 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* se aferren \w a|strong="H3068"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*, \w como|strong="H3588"\w* \w lo|strong="H2088"\w* han \w hecho|strong="H6213"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w*.   
\p
\v 9 “\w Pues|strong="H2088"\w* Yahvé \w ha|strong="H3423"\w* expulsado \w de|strong="H6440"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes \w a|strong="H3068"\w* \w naciones|strong="H1471"\w* \w grandes|strong="H1419"\w* \w y|strong="H5704"\w* \w fuertes|strong="H6099"\w*; \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w* \w nadie|strong="H3808"\w* les \w ha|strong="H3423"\w* podido resistir.  
\v 10 Un \w solo|strong="H1931"\w* hombre \w de|strong="H4480"\w* ustedes \w perseguirá|strong="H7291"\w* \w a|strong="H3068"\w* mil; \w porque|strong="H3588"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w* \w es|strong="H1931"\w* \w quien|strong="H1931"\w* \w pelea|strong="H3898"\w* \w por|strong="H3588"\w* ustedes, \w como|strong="H3588"\w* \w él|strong="H1931"\w* \w se|strong="H1931"\w* \w lo|strong="H1931"\w* prometió.  
\v 11 \w Guarden|strong="H8104"\w*, pues, con diligencia sus \w almas|strong="H5315"\w*, para que amen \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*.   
\p
\v 12 “\w Porque|strong="H3588"\w* \w si|strong="H3588"\w* ustedes \w se|strong="H1992"\w* \w apartan|strong="H7725"\w*, \w y|strong="H3588"\w* \w se|strong="H1992"\w* unen \w a|strong="H3068"\w* \w lo|strong="H1992"\w* \w que|strong="H3588"\w* \w queda|strong="H7604"\w* \w de|strong="H3588"\w* \w estas|strong="H1992"\w* \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* han sobrevivido \w entre|strong="H3588"\w* ustedes, \w y|strong="H3588"\w* \w si|strong="H3588"\w* hacen \w matrimonios|strong="H2859"\w* \w con|strong="H3588"\w* \w ellas|strong="H1992"\w*, mezclándose \w con|strong="H3588"\w* \w ellas|strong="H1992"\w* \w y|strong="H3588"\w* \w ellas|strong="H1992"\w* \w con|strong="H3588"\w* ustedes,  
\v 13 \w sepan|strong="H3045"\w* \w por|strong="H5921"\w* seguro \w que|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w no|strong="H3808"\w* expulsará \w más|strong="H3588"\w* \w a|strong="H3068"\w* \w estas|strong="H2063"\w* \w naciones|strong="H1471"\w* \w de|strong="H5921"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w presencia|strong="H6440"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w les|strong="H5921"\w* \w serán|strong="H1961"\w* \w por|strong="H5921"\w* \w lazo|strong="H6341"\w*, \w por|strong="H5921"\w* trampa, \w por|strong="H5921"\w* azote \w para|strong="H5704"\w* sus \w costados|strong="H6654"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* espinas \w para|strong="H5704"\w* sus \w ojos|strong="H5869"\w*, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* perezcan \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w buena|strong="H2896"\w* tierra \w que|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w les|strong="H5921"\w* \w ha|strong="H3423"\w* \w dado|strong="H5414"\w*.   
\p
\v 14 “\w Y|strong="H3068"\w* miren \w que|strong="H3588"\w* \w yo|strong="H4480"\w* \w voy|strong="H1980"\w* \w hoy|strong="H3117"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w de|strong="H4480"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra; \w reconozcan|strong="H3045"\w*, \w pues|strong="H3588"\w*, \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w su|strong="H3588"\w* \w corazón|strong="H3824"\w* \w y|strong="H3588"\w* \w con|strong="H5921"\w* \w toda|strong="H3605"\w* \w su|strong="H3588"\w* \w alma|strong="H5315"\w*, \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* faltado \w ni|strong="H3808"\w* una sola \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w buenas|strong="H2896"\w* promesas \w que|strong="H3588"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w había|strong="H3588"\w* \w dicho|strong="H1697"\w* \w sobre|strong="H5921"\w* ustedes; \w todas|strong="H3605"\w* \w se|strong="H3045"\w* \w les|strong="H5921"\w* han cumplido, \w no|strong="H3808"\w* \w ha|strong="H3808"\w* faltado \w ninguna|strong="H3605"\w* \w de|strong="H4480"\w* \w ellas|strong="H5921"\w*.  
\v 15 Pero \w así|strong="H3651"\w* \w como|strong="H1961"\w* ha venido \w sobre|strong="H5921"\w* ustedes \w toda|strong="H3605"\w* \w buena|strong="H2896"\w* promesa \w que|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w* \w les|strong="H5921"\w* \w había|strong="H1961"\w* \w dicho|strong="H1697"\w*, \w también|strong="H3651"\w* traerá Yahvé \w sobre|strong="H5921"\w* ustedes \w toda|strong="H3605"\w* calamidad, \w hasta|strong="H5704"\w* exterminarlos \w de|strong="H5921"\w* \w esta|strong="H2063"\w* \w buena|strong="H2896"\w* tierra \w que|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w* \w les|strong="H5921"\w* ha \w dado|strong="H5414"\w*,  
\v 16 \w si|strong="H5921"\w* quebrantan \w el|strong="H5921"\w* \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé \w su|strong="H1992"\w* \w Dios|strong="H3068"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w les|strong="H1992"\w* ha \w mandado|strong="H6680"\w*, \w yendo|strong="H1980"\w* \w a|strong="H3068"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* dioses ajenos \w e|strong="H3068"\w* \w inclinándose|strong="H7812"\w* ante \w ellos|strong="H1992"\w*. Entonces \w la|strong="H5921"\w* \w ira|strong="H1980"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* encenderá \w contra|strong="H5921"\w* ustedes, \w y|strong="H5921"\w* perecerán \w pronto|strong="H4120"\w* \w de|strong="H5921"\w* \w esta|strong="H1992"\w* \w buena|strong="H2896"\w* tierra \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w les|strong="H1992"\w* ha \w dado|strong="H5414"\w*”.   
\c 24  
\p
\v 1 \w Josué|strong="H3091"\w* reunió \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* en Siquem, y \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* sus \w jefes|strong="H7218"\w*, \w a|strong="H3068"\w* sus \w jueces|strong="H8199"\w* y \w a|strong="H3068"\w* sus \w oficiales|strong="H7860"\w*; y se presentaron \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Dios.  
\v 2 \w Y|strong="H3068"\w* le dijo \w Josué|strong="H3091"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*: ‘Sus antepasados \w habitaron|strong="H3427"\w* \w antiguamente|strong="H5769"\w* al otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w*, \w es|strong="H3541"\w* decir, Taré, padre \w de|strong="H5971"\w* Abraham \w y|strong="H3541"\w* \w de|strong="H5971"\w* Nacor; \w y|strong="H3541"\w* servían \w a|strong="H3068"\w* otros dioses.  
\v 3 Pero yo \w tomé|strong="H3947"\w* \w a|strong="H3068"\w* su padre Abraham del otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w*, y \w lo|strong="H3605"\w* conduje \w por|strong="H5414"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w*, y multipliqué su \w descendencia|strong="H2233"\w*\f + \fr 24:3 \ft o, descendencia\f* y le \w di|strong="H5414"\w* \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w*.  
\v 4 \w A|strong="H3068"\w* \w Isaac|strong="H3327"\w* le \w di|strong="H5414"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* y \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w*. \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w Esaú|strong="H6215"\w* le \w di|strong="H5414"\w* \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w de|strong="H1121"\w* \w Seir|strong="H8165"\w* \w para|strong="H5414"\w* \w que|strong="H1121"\w* lo poseyera; pero \w Jacob|strong="H3290"\w* y sus \w hijos|strong="H1121"\w* \w bajaron|strong="H3381"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*.   
\p
\v 5 ‘\w Y|strong="H3068"\w* \w yo|strong="H6213"\w* \w envié|strong="H7971"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y castigué \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* con las plagas que \w hice|strong="H6213"\w* \w en|strong="H3318"\w* \w medio|strong="H7130"\w* de ellos, y después los \w saqué|strong="H3318"\w* \w a|strong="H3068"\w* ustedes.  
\v 6 \w Saqué|strong="H3318"\w* \w a|strong="H3068"\w* sus padres de \w Egipto|strong="H4714"\w*, y llegaron al \w mar|strong="H3220"\w*; y \w los|strong="H7291"\w* \w egipcios|strong="H4713"\w* \w persiguieron|strong="H7291"\w* \w a|strong="H3068"\w* sus padres hasta el \w mar|strong="H3220"\w* Rojo con \w carros|strong="H7393"\w* y caballería.  
\v 7 \w Cuando|strong="H3117"\w* \w ellos|strong="H5921"\w* \w clamaron|strong="H6817"\w* \w a|strong="H3068"\w* Yahvé, \w él|strong="H5921"\w* \w puso|strong="H7760"\w* \w oscuridad|strong="H3990"\w* \w entre|strong="H5921"\w* ustedes \w y|strong="H5921"\w* \w los|strong="H3427"\w* \w egipcios|strong="H4713"\w*, \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* venir \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w el|strong="H5921"\w* cual \w los|strong="H3427"\w* \w cubrió|strong="H3680"\w*; \w y|strong="H5921"\w* sus \w ojos|strong="H5869"\w* \w vieron|strong="H7200"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w hice|strong="H6213"\w* \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*. \w Después|strong="H5921"\w* ustedes vivieron \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*.   
\p
\v 8 ‘Yo \w los|strong="H3427"\w* introduje en la tierra \w de|strong="H6440"\w* \w los|strong="H3427"\w* amorreos, \w que|strong="H3027"\w* \w habitaban|strong="H3427"\w* al otro \w lado|strong="H5676"\w* del \w Jordán|strong="H3383"\w*; \w ellos|strong="H3027"\w* \w pelearon|strong="H3898"\w* \w contra|strong="H6440"\w* ustedes, pero yo \w los|strong="H3427"\w* \w entregué|strong="H5414"\w* en sus \w manos|strong="H3027"\w*, y tomaron posesión \w de|strong="H6440"\w* su tierra, y yo \w los|strong="H3427"\w* \w destruí|strong="H8045"\w* \w de|strong="H6440"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes.  
\v 9 Después se \w levantó|strong="H6965"\w* \w Balac|strong="H1111"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zipor, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Moab|strong="H4124"\w*, y \w peleó|strong="H3898"\w* \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*; y \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Beor, para \w que|strong="H1121"\w* \w los|strong="H1121"\w* maldijera.  
\v 10 Pero yo \w no|strong="H3808"\w* quise \w escuchar|strong="H8085"\w* \w a|strong="H3068"\w* \w Balaam|strong="H1109"\w*, \w por|strong="H3027"\w* \w lo|strong="H3808"\w* cual los \w bendijo|strong="H1288"\w* repetidamente, y los \w libré|strong="H5337"\w* de su \w mano|strong="H3027"\w*.   
\p
\v 11 ‘Cruzaron \w el|strong="H5674"\w* \w Jordán|strong="H3383"\w* y llegaron \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*; y \w los|strong="H1167"\w* habitantes \w de|strong="H5414"\w* \w Jericó|strong="H3405"\w* \w pelearon|strong="H3898"\w* contra ustedes: \w los|strong="H1167"\w* amorreos, \w los|strong="H1167"\w* ferezeos, \w los|strong="H1167"\w* \w cananeos|strong="H3669"\w*, \w los|strong="H1167"\w* hititas, \w los|strong="H1167"\w* \w gergeseos|strong="H1622"\w*, \w los|strong="H1167"\w* \w heveos|strong="H2340"\w* y \w los|strong="H1167"\w* \w jebuseos|strong="H2983"\w*, y yo \w los|strong="H1167"\w* \w entregué|strong="H5414"\w* en sus \w manos|strong="H3027"\w*.  
\v 12 \w Y|strong="H3068"\w* \w envié|strong="H7971"\w* avispas \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes, las cuales los expulsaron \w de|strong="H6440"\w* su \w presencia|strong="H6440"\w*, \w a|strong="H3068"\w* saber, \w a|strong="H3068"\w* los \w dos|strong="H8147"\w* \w reyes|strong="H4428"\w* \w de|strong="H6440"\w* los amorreos; \w no|strong="H3808"\w* con tu \w espada|strong="H2719"\w* \w ni|strong="H3808"\w* con tu \w arco|strong="H7198"\w*.  
\v 13 \w Y|strong="H3068"\w* les \w di|strong="H5414"\w* tierra \w por|strong="H5414"\w* la cual \w no|strong="H3808"\w* trabajaron, y \w ciudades|strong="H5892"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w edificaron|strong="H1129"\w*, en las cuales ahora viven; y comen \w de|strong="H5414"\w* viñedos y \w olivares|strong="H2132"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* plantaron’.   
\p
\v 14 “\w Ahora|strong="H6258"\w*, \w pues|strong="H6258"\w*, \w teman|strong="H3372"\w* \w a|strong="H3068"\w* Yahvé, y sírvanle con integridad y \w en|strong="H8549"\w* verdad; quiten \w de|strong="H3372"\w* \w en|strong="H8549"\w* medio \w de|strong="H3372"\w* ustedes los dioses \w a|strong="H3068"\w* los cuales \w sirvieron|strong="H5647"\w* sus padres al otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w* y \w en|strong="H8549"\w* \w Egipto|strong="H4714"\w*, y sirvan \w a|strong="H3068"\w* Yahvé.  
\v 15 \w Y|strong="H3068"\w* si les parece \w mal|strong="H7451"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* Yahvé, elijan \w hoy|strong="H3117"\w* \w a|strong="H3068"\w* \w quién|strong="H4310"\w* \w servir|strong="H5647"\w*; si \w a|strong="H3068"\w* \w los|strong="H3427"\w* dioses \w a|strong="H3068"\w* \w quienes|strong="H4310"\w* \w sirvieron|strong="H5647"\w* sus padres \w cuando|strong="H3117"\w* \w estuvieron|strong="H3427"\w* al otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w*, \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* dioses \w de|strong="H5869"\w* \w los|strong="H3427"\w* amorreos en \w cuya|strong="H4310"\w* tierra \w habitan|strong="H3427"\w*; pero yo y mi \w casa|strong="H1004"\w* \w serviremos|strong="H5647"\w* \w a|strong="H3068"\w* Yahvé”.   
\p
\v 16 Entonces el \w pueblo|strong="H5971"\w* \w respondió|strong="H6030"\w* y dijo: “¡\w Nunca|strong="H2486"\w* suceda tal cosa, \w que|strong="H5971"\w* dejemos \w a|strong="H3068"\w* Yahvé \w para|strong="H5971"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* otros dioses!;  
\v 17 \w porque|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w que|strong="H3588"\w* nos \w sacó|strong="H5927"\w* \w a|strong="H3068"\w* \w nosotros|strong="H3605"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* nuestros padres \w de|strong="H3588"\w* \w la|strong="H1931"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* esclavitud; \w el|strong="H1931"\w* \w que|strong="H3588"\w* ha \w hecho|strong="H6213"\w* \w estas|strong="H6213"\w* \w grandes|strong="H1419"\w* señales \w delante|strong="H5869"\w* \w de|strong="H3588"\w* nuestros \w ojos|strong="H5869"\w*, \w y|strong="H3588"\w* nos ha cuidado \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w* \w por|strong="H3588"\w* \w donde|strong="H1931"\w* hemos \w andado|strong="H1980"\w*, \w y|strong="H3588"\w* \w entre|strong="H7130"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* \w por|strong="H3588"\w* \w los|strong="H3605"\w* cuales \w pasamos|strong="H5674"\w*.  
\v 18 \w Y|strong="H3068"\w* Yahvé expulsó \w de|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* \w nosotros|strong="H3605"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w*, \w y|strong="H1571"\w* al amorreo \w que|strong="H3588"\w* \w habitaba|strong="H3427"\w* \w en|strong="H3588"\w* \w la|strong="H1931"\w* tierra; \w nosotros|strong="H3605"\w*, \w pues|strong="H3588"\w*, \w también|strong="H1571"\w* \w serviremos|strong="H5647"\w* \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* nuestro \w Dios|strong="H3068"\w*”.   
\p
