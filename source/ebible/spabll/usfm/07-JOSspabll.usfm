\p
\v 20 Entonces \w el|strong="H5307"\w* \w pueblo|strong="H5971"\w* gritó, y \w los|strong="H1961"\w* sacerdotes \w tocaron|strong="H8628"\w* las \w trompetas|strong="H7782"\w*; y \w aconteció|strong="H1961"\w* \w que|strong="H5971"\w* \w cuando|strong="H1961"\w* \w el|strong="H5307"\w* \w pueblo|strong="H5971"\w* \w oyó|strong="H8085"\w* \w el|strong="H5307"\w* \w sonido|strong="H6963"\w* \w de|strong="H8478"\w* la \w trompeta|strong="H7782"\w*, gritó con \w gran|strong="H1419"\w* \w estruendo|strong="H6963"\w*, y la muralla \w se|strong="H1961"\w* derrumbó. \w El|strong="H5307"\w* \w pueblo|strong="H5971"\w* \w subió|strong="H5927"\w* \w luego|strong="H5927"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w*, cada uno directo hacia adelante, y la \w tomaron|strong="H3920"\w*.  
\v 21 \w Y|strong="H3068"\w* \w destruyeron|strong="H2763"\w* \w a|strong="H3068"\w* filo \w de|strong="H5704"\w* \w espada|strong="H2719"\w* \w todo|strong="H3605"\w* \w lo|strong="H5704"\w* \w que|strong="H5704"\w* había \w en|strong="H5704"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w*; hombres \w y|strong="H5704"\w* \w mujeres|strong="H5704"\w*, jóvenes \w y|strong="H5704"\w* \w ancianos|strong="H2205"\w*, \w hasta|strong="H5704"\w* \w los|strong="H3605"\w* \w bueyes|strong="H7794"\w*, las ovejas \w y|strong="H5704"\w* \w los|strong="H3605"\w* burros.  
\v 22 Pero \w Josué|strong="H3091"\w* les dijo \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w dos|strong="H8147"\w* \w hombres|strong="H8147"\w* \w que|strong="H3605"\w* habían explorado \w la|strong="H3605"\w* tierra: “Entren \w en|strong="H3318"\w* \w casa|strong="H1004"\w* de \w la|strong="H3605"\w* prostituta, y saquen de \w allí|strong="H8033"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* mujer y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* sea de \w ella|strong="H8033"\w*, como se \w lo|strong="H3605"\w* \w juraron|strong="H7650"\w*”.  
\v 23 \w Y|strong="H3068"\w* \w los|strong="H3605"\w* jóvenes \w espías|strong="H7270"\w* entraron y \w sacaron|strong="H3318"\w* \w a|strong="H3068"\w* \w Rahab|strong="H7343"\w*, \w a|strong="H3068"\w* su padre, \w a|strong="H3068"\w* su madre, \w a|strong="H3068"\w* sus hermanos y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* era suyo; y \w también|strong="H3318"\w* \w sacaron|strong="H3318"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* su \w familia|strong="H4940"\w*, y \w los|strong="H3605"\w* \w pusieron|strong="H3240"\w* \w fuera|strong="H2351"\w* del \w campamento|strong="H4264"\w* de \w Israel|strong="H3478"\w*.  
\v 24 \w Y|strong="H3068"\w* quemaron \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* había en \w ella|strong="H3605"\w*; \w solamente|strong="H7535"\w* \w pusieron|strong="H5414"\w* en \w el|strong="H3605"\w* tesoro \w de|strong="H5414"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H5414"\w* Yahvé \w la|strong="H3605"\w* \w plata|strong="H3701"\w* y \w el|strong="H3605"\w* \w oro|strong="H2091"\w*, y \w los|strong="H3605"\w* utensilios \w de|strong="H5414"\w* bronce y \w de|strong="H5414"\w* \w hierro|strong="H1270"\w*.  
\v 25 \w Pero|strong="H3588"\w* \w Josué|strong="H3091"\w* le \w salvó|strong="H2421"\w* \w la|strong="H3588"\w* \w vida|strong="H3117"\w* \w a|strong="H3068"\w* \w Rahab|strong="H7343"\w* \w la|strong="H3588"\w* prostituta, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w familia|strong="H1004"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* padre, \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H3588"\w* \w ella|strong="H3605"\w* tenía; \w y|strong="H3588"\w* \w ella|strong="H3605"\w* \w habitó|strong="H3427"\w* \w entre|strong="H7130"\w* \w los|strong="H3427"\w* israelitas \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w por|strong="H3588"\w* \w cuanto|strong="H3588"\w* escondió \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w mensajeros|strong="H4397"\w* \w que|strong="H3588"\w* \w Josué|strong="H3091"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* explorar \w Jericó|strong="H3405"\w*.   
\p
\v 26 En \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w Josué|strong="H3091"\w* les \w hizo|strong="H1129"\w* jurar, diciendo: “Maldito sea \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w el|strong="H1931"\w* hombre \w que|strong="H1931"\w* \w se|strong="H1931"\w* levante y reconstruya \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w de|strong="H6440"\w* \w Jericó|strong="H3405"\w*. \w Que|strong="H1931"\w* \w a|strong="H3068"\w* costa \w de|strong="H6440"\w* \w su|strong="H1931"\w* hijo mayor eche \w los|strong="H1931"\w* \w cimientos|strong="H3245"\w* \w de|strong="H6440"\w* \w ella|strong="H1931"\w*, y \w a|strong="H3068"\w* costa \w de|strong="H6440"\w* \w su|strong="H1931"\w* hijo \w menor|strong="H6810"\w* \w asiente|strong="H5324"\w* \w sus|strong="H1931"\w* \w puertas|strong="H1817"\w*”.  
\v 27 \w Estaba|strong="H1961"\w*, \w pues|strong="H1961"\w*, Yahvé con \w Josué|strong="H3091"\w*, y su fama \w se|strong="H1961"\w* divulgó por \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra.   
\c 7  
\p
\v 1 Pero \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w cometieron|strong="H4604"\w* una gran \w falta|strong="H4603"\w* \w con|strong="H4480"\w* las cosas consagradas \w a|strong="H3068"\w* la destrucción; porque Acán \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Carmi|strong="H3756"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Zabdi|strong="H2067"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Zera|strong="H2226"\w*, \w de|strong="H4480"\w* la \w tribu|strong="H4294"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w tomó|strong="H3947"\w* \w de|strong="H4480"\w* esas cosas; y la ira \w de|strong="H4480"\w* Yahvé \w se|strong="H4480"\w* encendió \w contra|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*.  
\v 2 \w Josué|strong="H3091"\w* \w envió|strong="H7971"\w* hombres desde \w Jericó|strong="H3405"\w* \w a|strong="H3068"\w* \w Hai|strong="H5857"\w*, que está \w junto|strong="H5973"\w* \w a|strong="H3068"\w* Bet-aven, al \w oriente|strong="H6924"\w* \w de|strong="H5973"\w* Bet-el; y \w les|strong="H5973"\w* habló diciendo: “Suban y exploren la tierra”. \w Y|strong="H3068"\w* ellos \w subieron|strong="H5927"\w* y exploraron \w Hai|strong="H5857"\w*.   
\p
\v 3 \w Y|strong="H3068"\w* \w volviendo|strong="H7725"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, le dijeron: “\w Que|strong="H3588"\w* \w no|strong="H3588"\w* \w suba|strong="H5927"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* suban \w unos|strong="H1992"\w* dos \w o|strong="H3068"\w* \w tres|strong="H7969"\w* mil hombres, \w y|strong="H3588"\w* tomarán \w Hai|strong="H5857"\w*; \w no|strong="H3588"\w* canses \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* haciéndolo ir \w allá|strong="H8033"\w*, \w porque|strong="H3588"\w* \w ellos|strong="H1992"\w* \w son|strong="H3588"\w* \w pocos|strong="H4592"\w*”.  
\v 4 Así \w que|strong="H4480"\w* \w subieron|strong="H5927"\w* \w allá|strong="H8033"\w* \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w* unos \w tres|strong="H7969"\w* mil hombres, los cuales \w huyeron|strong="H5127"\w* \w delante|strong="H6440"\w* \w de|strong="H4480"\w* los \w de|strong="H4480"\w* \w Hai|strong="H5857"\w*.  
\v 5 \w Y|strong="H3068"\w* \w los|strong="H1992"\w* \w de|strong="H6440"\w* \w Hai|strong="H5857"\w* \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w unos|strong="H1992"\w* \w treinta|strong="H7970"\w* \w y|strong="H5704"\w* \w seis|strong="H8337"\w* hombres \w de|strong="H6440"\w* \w ellos|strong="H1992"\w*, \w y|strong="H5704"\w* \w los|strong="H1992"\w* \w persiguieron|strong="H7291"\w* \w desde|strong="H5704"\w* la \w puerta|strong="H8179"\w* \w hasta|strong="H5704"\w* \w Sebarim|strong="H7671"\w*, \w y|strong="H5704"\w* \w los|strong="H1992"\w* derrotaron \w en|strong="H5704"\w* la bajada; \w por|strong="H6440"\w* \w lo|strong="H5704"\w* \w que|strong="H5704"\w* \w el|strong="H1992"\w* \w corazón|strong="H3824"\w* del \w pueblo|strong="H5971"\w* \w se|strong="H1961"\w* acobardó \w y|strong="H5704"\w* \w se|strong="H1961"\w* hizo \w como|strong="H1961"\w* \w agua|strong="H4325"\w*.  
\v 6 Entonces \w Josué|strong="H3091"\w* \w se|strong="H1931"\w* \w rasgó|strong="H7167"\w* \w la|strong="H1931"\w* \w ropa|strong="H8071"\w*, \w y|strong="H5921"\w* \w se|strong="H1931"\w* postró \w en|strong="H5921"\w* \w tierra|strong="H6083"\w* \w sobre|strong="H5921"\w* \w su|strong="H1931"\w* \w rostro|strong="H6440"\w* \w delante|strong="H6440"\w* \w del|strong="H5921"\w* arca \w de|strong="H5921"\w* Yahvé \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w caer|strong="H5307"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w tarde|strong="H6153"\w*, \w él|strong="H1931"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*; \w y|strong="H5921"\w* \w se|strong="H1931"\w* \w echaron|strong="H5307"\w* \w polvo|strong="H6083"\w* \w sobre|strong="H5921"\w* \w sus|strong="H1931"\w* \w cabezas|strong="H7218"\w*.  
\v 7 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* dijo: “¡Ah, Señor Yahvé! ¿\w Por|strong="H2088"\w* \w qué|strong="H4100"\w* le hiciste cruzar \w el|strong="H5674"\w* \w Jordán|strong="H3383"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, \w para|strong="H5414"\w* entregarnos en \w manos|strong="H3027"\w* \w de|strong="H5971"\w* \w los|strong="H3427"\w* amorreos, \w para|strong="H5414"\w* \w que|strong="H4100"\w* \w nos|strong="H4100"\w* destruyan? ¡\w Ojalá|strong="H3863"\w* \w nos|strong="H4100"\w* hubiéramos contentado con quedarnos al \w otro|strong="H2088"\w* \w lado|strong="H5676"\w* del \w Jordán|strong="H3383"\w*!  
\v 8 ¡Ay, Señor! ¿\w Qué|strong="H4100"\w* diré, ya \w que|strong="H4100"\w* \w Israel|strong="H3478"\w* le ha dado la espalda \w a|strong="H3068"\w* sus enemigos?  
\v 9 \w Porque|strong="H5921"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* tierra \w se|strong="H5921"\w* enterarán, \w y|strong="H5921"\w* \w nos|strong="H5921"\w* rodearán, \w y|strong="H5921"\w* borrarán nuestro \w nombre|strong="H8034"\w* \w de|strong="H4480"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra; \w y|strong="H5921"\w* entonces, ¿\w qué|strong="H4100"\w* \w harás|strong="H6213"\w* \w tú|strong="H6213"\w* \w por|strong="H5921"\w* \w tu|strong="H6213"\w* \w gran|strong="H1419"\w* \w nombre|strong="H8034"\w*?”.   
\p
\v 10 \w Y|strong="H3068"\w* Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “¡\w Levántate|strong="H6965"\w*! ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w te|strong="H5921"\w* \w postras|strong="H5307"\w* \w así|strong="H2088"\w* \w sobre|strong="H5921"\w* tu \w rostro|strong="H6440"\w*?  
\v 11 \w Israel|strong="H3478"\w* ha \w pecado|strong="H2398"\w*, \w y|strong="H1571"\w* han quebrantado \w el|strong="H5674"\w* \w pacto|strong="H1285"\w* \w que|strong="H4480"\w* \w yo|strong="H4480"\w* \w les|strong="H6680"\w* \w mandé|strong="H6680"\w*; \w y|strong="H1571"\w* \w también|strong="H1571"\w* han \w tomado|strong="H3947"\w* \w de|strong="H4480"\w* las cosas consagradas \w a|strong="H3068"\w* \w la|strong="H1571"\w* destrucción, \w y|strong="H1571"\w* hasta han robado, han mentido, \w y|strong="H1571"\w* las han escondido \w entre|strong="H4480"\w* sus propias pertenencias.  
\v 12 \w Por|strong="H3588"\w* esto \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w podrán|strong="H3201"\w* hacerles frente \w a|strong="H3068"\w* sus enemigos, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* sus enemigos darán \w la|strong="H3588"\w* espalda, \w por|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w se|strong="H1961"\w* han convertido \w en|strong="H5973"\w* algo digno \w de|strong="H3588"\w* destrucción; \w no|strong="H3808"\w* estaré \w más|strong="H3588"\w* \w con|strong="H5973"\w* ustedes, \w si|strong="H3588"\w* \w no|strong="H3808"\w* eliminan esas cosas consagradas \w a|strong="H3068"\w* \w la|strong="H3588"\w* destrucción \w de|strong="H3588"\w* \w en|strong="H5973"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ustedes.  
