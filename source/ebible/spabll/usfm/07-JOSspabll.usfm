\v 4 \w Porque|strong="H3588"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w José|strong="H3130"\w* \w fueron|strong="H1961"\w* \w dos|strong="H8147"\w* \w tribus|strong="H4294"\w*, \w Manasés|strong="H4519"\w* \w y|strong="H3588"\w* Efraín; \w y|strong="H3588"\w* \w no|strong="H3808"\w* les \w dieron|strong="H5414"\w* \w parte|strong="H2506"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w levitas|strong="H3881"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra, \w sino|strong="H3588"\w* \w ciudades|strong="H5892"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* vivieran, \w con|strong="H3588"\w* sus pastizales \w para|strong="H3588"\w* sus \w ganados|strong="H4735"\w* \w y|strong="H3588"\w* rebaños.  
\v 5 \w De|strong="H1121"\w* la manera \w que|strong="H1121"\w* Yahvé \w se|strong="H3651"\w* \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w mandado|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w así|strong="H3651"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* al repartir la tierra.   
\p
\v 6 Entonces \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w vinieron|strong="H5066"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w en|strong="H5921"\w* \w Gilgal|strong="H1537"\w*; \w y|strong="H5921"\w* \w Caleb|strong="H3612"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jefone, \w el|strong="H5921"\w* \w cenezeo|strong="H7074"\w*, \w le|strong="H5921"\w* \w dijo|strong="H1696"\w*: “Tú \w sabes|strong="H3045"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*, \w en|strong="H5921"\w* \w Cades-barnea|strong="H6947"\w*, respecto \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w*.  
