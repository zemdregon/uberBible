\v 49 \w Y|strong="H3068"\w* después \w de|strong="H1121"\w* \w que|strong="H1121"\w* terminaron \w de|strong="H1121"\w* repartir la tierra como \w herencia|strong="H5159"\w* según sus fronteras, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* le \w dieron|strong="H5414"\w* una \w herencia|strong="H5159"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* ellos.  
\v 50 \w Conforme|strong="H6310"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w palabra|strong="H6310"\w* \w de|strong="H5921"\w* Yahvé, \w le|strong="H5921"\w* \w dieron|strong="H5414"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* \w pidió|strong="H7592"\w*, Timnat-sera, \w en|strong="H5921"\w* \w la|strong="H5921"\w* montaña \w de|strong="H5921"\w* Efraín; \w y|strong="H5921"\w* \w él|strong="H5921"\w* reconstruyó \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* vivió \w en|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 51 Estas son las herencias \w que|strong="H1121"\w* \w el|strong="H1121"\w* \w sacerdote|strong="H3548"\w* Eleazar, \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Nun|strong="H5126"\w* y \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H6440"\w* familia \w de|strong="H6440"\w* las \w tribus|strong="H4294"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* repartieron \w por|strong="H6440"\w* sorteo en \w Silo|strong="H7887"\w*, \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w a|strong="H3068"\w* la entrada \w de|strong="H6440"\w* la Tienda \w de|strong="H6440"\w* reunión. \w Y|strong="H3068"\w* así terminaron \w de|strong="H6440"\w* repartir la tierra.   
\c 20  
\p
\v 1 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, \w diciendo|strong="H1696"\w*:  
\v 2 “\w Háblales|strong="H1696"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w diles|strong="H1696"\w*: ‘Señalen las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* refugio \w de|strong="H1121"\w* las cuales les \w hablé|strong="H1696"\w* \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*,  
\v 3 \w para|strong="H1961"\w* \w que|strong="H1961"\w* \w allí|strong="H8033"\w* \w se|strong="H1961"\w* refugie el \w homicida|strong="H7523"\w* \w que|strong="H1961"\w* mate \w a|strong="H3068"\w* alguna \w persona|strong="H5315"\w* \w por|strong="H5127"\w* accidente \w o|strong="H3068"\w* \w sin|strong="H1097"\w* intención; y les \w servirán|strong="H1961"\w* \w de|strong="H1818"\w* refugio \w contra|strong="H1961"\w* el vengador \w de|strong="H1818"\w* la \w sangre|strong="H1818"\w*.  
\v 4 \w El|strong="H1931"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* refugie \w en|strong="H5973"\w* alguna \w de|strong="H5973"\w* aquellas \w ciudades|strong="H5892"\w* \w se|strong="H1931"\w* \w presentará|strong="H5975"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w puerta|strong="H6607"\w* \w de|strong="H5973"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*, y expondrá \w su|strong="H1931"\w* caso \w a|strong="H3068"\w* oídos \w de|strong="H5973"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5973"\w* \w aquella|strong="H1931"\w* \w ciudad|strong="H5892"\w*; \w ellos|strong="H1931"\w* \w lo|strong="H1931"\w* recibirán \w con|strong="H5973"\w* \w ellos|strong="H1931"\w* dentro \w de|strong="H5973"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* y \w le|strong="H1931"\w* \w darán|strong="H5414"\w* un \w lugar|strong="H4725"\w* \w para|strong="H5414"\w* \w que|strong="H1931"\w* viva \w entre|strong="H5973"\w* \w ellos|strong="H1931"\w*.  
\v 5 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w el|strong="H1931"\w* vengador \w de|strong="H3588"\w* \w la|strong="H1931"\w* \w sangre|strong="H1818"\w* \w lo|strong="H1931"\w* \w persigue|strong="H7291"\w*, \w no|strong="H3808"\w* \w entregarán|strong="H5462"\w* \w en|strong="H3588"\w* \w sus|strong="H1931"\w* \w manos|strong="H3027"\w* al \w homicida|strong="H7523"\w*, \w porque|strong="H3588"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w prójimo|strong="H7453"\w* \w sin|strong="H3808"\w* intención \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w tenía|strong="H1931"\w* odio desde \w antes|strong="H3588"\w*.  
\v 6 \w Y|strong="H3068"\w* vivirá \w en|strong="H5704"\w* \w aquella|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w hasta|strong="H5704"\w* \w que|strong="H1931"\w* comparezca \w en|strong="H5704"\w* \w juicio|strong="H4941"\w* \w ante|strong="H6440"\w* \w la|strong="H1931"\w* congregación, \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* \w muerte|strong="H4194"\w* del \w que|strong="H1931"\w* \w sea|strong="H1961"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w* \w en|strong="H5704"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H3117"\w*; \w entonces|strong="H3117"\w* \w el|strong="H1931"\w* \w homicida|strong="H7523"\w* podrá regresar \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w*, \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w de|strong="H6440"\w* \w donde|strong="H8033"\w* \w huyó|strong="H5127"\w*’”.   
\p
\v 7 Entonces apartaron \w a|strong="H3068"\w* Cedes en Galilea, en \w la|strong="H1931"\w* montaña de Neftalí; \w a|strong="H3068"\w* Siquem, en \w la|strong="H1931"\w* montaña de Efraín; y \w a|strong="H3068"\w* Quiriat-arba (\w que|strong="H1931"\w* \w es|strong="H1931"\w* \w Hebrón|strong="H2275"\w*), en \w la|strong="H1931"\w* montaña de \w Judá|strong="H3063"\w*.  
\v 8 \w Y|strong="H3068"\w* al otro \w lado|strong="H5676"\w* del \w Jordán|strong="H3383"\w*, al \w oriente|strong="H4217"\w* \w de|strong="H5414"\w* \w Jericó|strong="H3405"\w*, \w señalaron|strong="H5414"\w* \w a|strong="H3068"\w* \w Beser|strong="H1221"\w* en el \w desierto|strong="H4057"\w*, en la llanura \w de|strong="H5414"\w* la \w tribu|strong="H4294"\w* \w de|strong="H5414"\w* \w Rubén|strong="H7205"\w*; \w a|strong="H3068"\w* Ramot en \w Galaad|strong="H1568"\w*, \w de|strong="H5414"\w* la \w tribu|strong="H4294"\w* \w de|strong="H5414"\w* \w Gad|strong="H1410"\w*; y \w a|strong="H3068"\w* Golán en \w Basán|strong="H1316"\w*, \w de|strong="H5414"\w* la \w tribu|strong="H4294"\w* \w de|strong="H5414"\w* \w Manasés|strong="H4519"\w*.  
\v 9 \w Estas|strong="H5975"\w* \w fueron|strong="H1961"\w* las \w ciudades|strong="H5892"\w* designadas \w para|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5704"\w* \w para|strong="H5704"\w* \w el|strong="H3605"\w* \w extranjero|strong="H1616"\w* \w que|strong="H3808"\w* viviera \w entre|strong="H8432"\w* \w ellos|strong="H3027"\w*, \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w cualquiera|strong="H3605"\w* \w que|strong="H3808"\w* \w matara|strong="H4191"\w* \w a|strong="H3068"\w* alguien \w por|strong="H6440"\w* accidente pudiera huir \w allí|strong="H8033"\w*, \w y|strong="H5704"\w* \w no|strong="H3808"\w* muriera \w a|strong="H3068"\w* \w manos|strong="H3027"\w* del vengador \w de|strong="H6440"\w* \w la|strong="H3605"\w* \w sangre|strong="H1818"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* compareciera \w ante|strong="H6440"\w* \w la|strong="H3605"\w* congregación.   
\c 21  
\p
\v 1 \w Los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* familia \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* se acercaron al \w sacerdote|strong="H3548"\w* Eleazar, \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w* y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las casas paternas \w de|strong="H1121"\w* las \w tribus|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*,  
\v 2 y \w les|strong="H6680"\w* \w hablaron|strong="H1696"\w* en \w Silo|strong="H7887"\w*, en la tierra \w de|strong="H5414"\w* \w Canaán|strong="H3667"\w*, \w diciendo|strong="H1696"\w*: “Yahvé \w mandó|strong="H6680"\w* \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H5414"\w* \w Moisés|strong="H4872"\w* \w que|strong="H3027"\w* se nos dieran \w ciudades|strong="H5892"\w* donde vivir, con sus pastizales \w para|strong="H5414"\w* nuestros ganados”.   
\p
\v 3 Entonces \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* les \w dieron|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w de|strong="H1121"\w* su propia \w herencia|strong="H5159"\w*, \w conforme|strong="H6310"\w* al \w mandato|strong="H6310"\w* \w de|strong="H1121"\w* Yahvé, estas \w ciudades|strong="H5892"\w* con sus pastizales.  
\v 4 \w Y|strong="H3068"\w* le tocó \w por|strong="H4480"\w* sorteo \w a|strong="H3068"\w* las \w familias|strong="H4940"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* coatitas; y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w del|strong="H4480"\w* \w sacerdote|strong="H3548"\w* Aarón, \w que|strong="H4480"\w* \w eran|strong="H1961"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*, obtuvieron \w por|strong="H4480"\w* sorteo \w trece|strong="H7969"\w* \w ciudades|strong="H5892"\w* \w de|strong="H4480"\w* la \w tribu|strong="H4294"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w de|strong="H4480"\w* la \w tribu|strong="H4294"\w* \w de|strong="H4480"\w* \w Simeón|strong="H8099"\w* y \w de|strong="H4480"\w* la \w tribu|strong="H4294"\w* \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*.  
\v 5 \w Y|strong="H3068"\w* \w los|strong="H1121"\w* demás \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat obtuvieron por sorteo \w diez|strong="H6235"\w* \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Efraín, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Dan|strong="H1835"\w* y \w de|strong="H1121"\w* la media \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*.  
\v 6 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gersón|strong="H1648"\w* obtuvieron por sorteo \w trece|strong="H7969"\w* \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Isacar, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Aser, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Neftalí y \w de|strong="H1121"\w* la media \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* en \w Basán|strong="H1316"\w*.  
\v 7 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w*, según sus \w familias|strong="H4940"\w*, obtuvieron \w doce|strong="H8147"\w* \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Gad|strong="H1410"\w* y \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w Zabulón|strong="H2074"\w*.  
\v 8 Así \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w les|strong="H6680"\w* \w dieron|strong="H5414"\w* \w por|strong="H3027"\w* sorteo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* estas \w ciudades|strong="H5892"\w* con sus pastizales, como Yahvé lo había \w mandado|strong="H6680"\w* \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w*.  
\v 9 \w De|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Simeón|strong="H8095"\w*, \w dieron|strong="H5414"\w* estas \w ciudades|strong="H5892"\w* \w que|strong="H1121"\w* fueron nombradas,  
\v 10 \w las|strong="H1992"\w* cuales obtuvieron \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* Aarón, \w de|strong="H3588"\w* \w las|strong="H1992"\w* \w familias|strong="H4940"\w* \w de|strong="H3588"\w* \w los|strong="H1992"\w* coatitas, \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Leví|strong="H3878"\w*; \w pues|strong="H3588"\w* \w la|strong="H3588"\w* \w primera|strong="H7223"\w* porción \w fue|strong="H1961"\w* \w de|strong="H3588"\w* \w ellos|strong="H1992"\w*.  
\v 11 \w Les|strong="H1992"\w* \w dieron|strong="H5414"\w* Quiriat-arba (padre \w de|strong="H5414"\w* Anac, \w la|strong="H1931"\w* \w cual|strong="H1931"\w* \w es|strong="H1931"\w* \w Hebrón|strong="H2275"\w*), en \w la|strong="H1931"\w* montaña \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*, con \w sus|strong="H1931"\w* pastizales \w alrededor|strong="H5439"\w*.  
\v 12 Pero \w el|strong="H1121"\w* \w campo|strong="H7704"\w* \w de|strong="H1121"\w* la \w ciudad|strong="H5892"\w* y sus \w aldeas|strong="H2691"\w* se \w los|strong="H1121"\w* \w dieron|strong="H5414"\w* \w a|strong="H3068"\w* \w Caleb|strong="H3612"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jefone como posesión suya.  
\v 13 Así les \w dieron|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* del \w sacerdote|strong="H3548"\w* Aarón la \w ciudad|strong="H5892"\w* \w de|strong="H1121"\w* refugio \w para|strong="H5414"\w* \w el|strong="H1121"\w* \w homicida|strong="H7523"\w*, \w Hebrón|strong="H2275"\w* con sus pastizales; \w Libna|strong="H3841"\w* con sus pastizales,  
\v 14 Jatir con sus pastizales, Estemoa con sus pastizales,  
\v 15 Holón con sus pastizales, \w Debir|strong="H1688"\w* con sus pastizales,  
\v 16 \w Ain|strong="H5871"\w* con sus pastizales, Juta con sus pastizales y Bet-semes con sus pastizales; \w nueve|strong="H8672"\w* \w ciudades|strong="H5892"\w* de estas \w dos|strong="H8147"\w* \w tribus|strong="H7626"\w*.  
\v 17 \w Y|strong="H3068"\w* de la \w tribu|strong="H4294"\w* de \w Benjamín|strong="H1144"\w*, \w Gabaón|strong="H1391"\w* con sus pastizales, Geba con sus pastizales,  
\v 18 Anatot con sus pastizales y Almón con sus pastizales; cuatro \w ciudades|strong="H5892"\w*.  
\v 19 \w Todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, fueron \w trece|strong="H7969"\w* \w ciudades|strong="H5892"\w* con sus pastizales.   
\p
\v 20 Pero las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat, \w levitas|strong="H3881"\w*, \w los|strong="H1121"\w* \w que|strong="H1121"\w* \w quedaron|strong="H3498"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat, obtuvieron \w por|strong="H3881"\w* sorteo \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Efraín.  
\v 21 Les \w dieron|strong="H5414"\w* Siquem con sus pastizales, la \w ciudad|strong="H5892"\w* \w de|strong="H5414"\w* refugio \w para|strong="H5414"\w* el \w homicida|strong="H7523"\w*, en la montaña \w de|strong="H5414"\w* Efraín; \w Gezer|strong="H1507"\w* con sus pastizales,  
\v 22 Kibsaim con sus pastizales y Bet-horón con sus pastizales; cuatro \w ciudades|strong="H5892"\w*.  
\v 23 De la \w tribu|strong="H4294"\w* de \w Dan|strong="H1835"\w*, Elteque con sus pastizales, Gibetón con sus pastizales,  
\v 24 Ajalón con sus pastizales y Gat-rimón con sus pastizales; cuatro \w ciudades|strong="H5892"\w*.  
\v 25 \w Y|strong="H3068"\w* de la media \w tribu|strong="H4294"\w* de \w Manasés|strong="H4519"\w*, Taanac con sus pastizales y Gat-rimón con sus pastizales; \w dos|strong="H8147"\w* \w ciudades|strong="H5892"\w*.  
\v 26 \w Todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* para las \w familias|strong="H4940"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* demás \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat fueron \w diez|strong="H6235"\w* con sus pastizales.   
\p
