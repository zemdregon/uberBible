\v 11 \w Y|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w oyeron|strong="H8085"\w* \w decir|strong="H8085"\w*: “Resulta \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Gad|strong="H1410"\w* y la media \w tribu|strong="H7626"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* han \w edificado|strong="H1129"\w* un \w altar|strong="H4196"\w* frente \w a|strong="H3068"\w* la tierra \w de|strong="H1121"\w* \w Canaán|strong="H3667"\w*, en \w los|strong="H1121"\w* límites \w del|strong="H4196"\w* \w Jordán|strong="H3383"\w*, en la ribera \w que|strong="H1121"\w* le pertenece \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*”.  
