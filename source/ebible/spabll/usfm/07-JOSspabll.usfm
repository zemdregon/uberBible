\v 12 \w La|strong="H1366"\w* frontera \w occidental|strong="H3220"\w* \w es|strong="H2088"\w* \w el|strong="H1121"\w* \w gran|strong="H1419"\w* \w mar|strong="H3220"\w* y su costa. \w Estas|strong="H2088"\w* son las fronteras \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* \w por|strong="H2088"\w* sus \w contornos|strong="H5439"\w*, conforme \w a|strong="H3068"\w* sus \w familias|strong="H4940"\w*.   
\p
\v 13 Pero \w a|strong="H3068"\w* \w Caleb|strong="H3612"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jefone, \w Josué|strong="H3091"\w* \w le|strong="H1931"\w* \w dio|strong="H5414"\w* una \w parte|strong="H2506"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, \w conforme|strong="H6310"\w* al \w mandato|strong="H6310"\w* \w de|strong="H1121"\w* Yahvé, \w a|strong="H3068"\w* saber, Quiriat-arba, padre \w de|strong="H1121"\w* Anac, \w la|strong="H1931"\w* \w cual|strong="H1931"\w* \w es|strong="H1931"\w* \w Hebrón|strong="H2275"\w*.  
