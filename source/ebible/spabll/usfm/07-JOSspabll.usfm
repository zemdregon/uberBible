\p
\v 25 \w Entonces|strong="H3117"\w* \w Josué|strong="H3091"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* con \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w aquel|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, y les \w dio|strong="H7760"\w* \w estatutos|strong="H2706"\w* y decretos en Siquem.  
\v 26 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w escribió|strong="H3789"\w* estas \w palabras|strong="H1697"\w* \w en|strong="H8478"\w* el \w libro|strong="H5612"\w* \w de|strong="H8478"\w* la \w ley|strong="H8451"\w* \w de|strong="H8478"\w* \w Dios|strong="H3068"\w*; y \w tomando|strong="H3947"\w* una \w gran|strong="H1419"\w* piedra, la \w levantó|strong="H6965"\w* \w allí|strong="H8033"\w* \w debajo|strong="H8478"\w* del encino \w que|strong="H1697"\w* estaba junto \w al|strong="H8478"\w* \w santuario|strong="H4720"\w* \w de|strong="H8478"\w* Yahvé.  
\v 27 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w le|strong="H1931"\w* \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w*: “Miren, \w esta|strong="H2063"\w* piedra \w servirá|strong="H1961"\w* \w de|strong="H3588"\w* \w testigo|strong="H5713"\w* \w contra|strong="H5973"\w* \w nosotros|strong="H3605"\w*, \w porque|strong="H3588"\w* \w ella|strong="H1931"\w* ha \w oído|strong="H8085"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1696"\w* \w que|strong="H3588"\w* Yahvé nos ha \w hablado|strong="H1696"\w*; \w será|strong="H1961"\w*, \w pues|strong="H3588"\w*, \w testigo|strong="H5713"\w* \w contra|strong="H5973"\w* ustedes, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H6435"\w* \w le|strong="H1931"\w* fallen \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*”.  
\v 28 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w despidió|strong="H7971"\w* al \w pueblo|strong="H5971"\w*, cada uno \w a|strong="H3068"\w* su \w herencia|strong="H5159"\w*.   
\p
\v 29 \w Después|strong="H1961"\w* \w de|strong="H1121"\w* estas \w cosas|strong="H1697"\w* \w murió|strong="H4191"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Nun|strong="H5126"\w*, \w siervo|strong="H5650"\w* \w de|strong="H1121"\w* Yahvé, \w a|strong="H3068"\w* la \w edad|strong="H8141"\w* \w de|strong="H1121"\w* \w ciento|strong="H3967"\w* \w diez|strong="H6235"\w* \w años|strong="H8141"\w*.  
\v 30 \w Y|strong="H3068"\w* lo \w sepultaron|strong="H6912"\w* \w en|strong="H6912"\w* su \w herencia|strong="H5159"\w*, \w en|strong="H6912"\w* Timnat-sera, que está \w en|strong="H6912"\w* \w la|strong="H1366"\w* montaña de Efraín, al \w norte|strong="H6828"\w* del \w monte|strong="H2022"\w* \w Gaas|strong="H1608"\w*.  
\v 31 \w Y|strong="H3068"\w* \w sirvió|strong="H5647"\w* \w Israel|strong="H3478"\w* \w a|strong="H3068"\w* Yahvé \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* de \w Josué|strong="H3091"\w*, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w tiempo|strong="H3117"\w* de \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* \w que|strong="H3045"\w* sobrevivieron \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* y \w que|strong="H3045"\w* \w sabían|strong="H3045"\w* \w todas|strong="H3605"\w* las \w obras|strong="H4639"\w* \w que|strong="H3045"\w* Yahvé \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* por \w Israel|strong="H3478"\w*.  
\v 32 \w Y|strong="H3068"\w* enterraron \w en|strong="H6912"\w* Siquem \w los|strong="H1121"\w* \w huesos|strong="H6106"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*, \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w habían|strong="H1961"\w* \w subido|strong="H5927"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*, \w en|strong="H6912"\w* la \w parte|strong="H2513"\w* del \w campo|strong="H7704"\w* \w que|strong="H1121"\w* \w Jacob|strong="H3290"\w* \w compró|strong="H7069"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Hamor|strong="H2544"\w* padre \w de|strong="H1121"\w* Siquem, \w por|strong="H7069"\w* \w cien|strong="H3967"\w* quesitás;\f + \fr 24:32 \ft El término hebreo es “quesitás”. Una quesitá era una cierta moneda de plata.\f* y \w fue|strong="H1961"\w* \w posesión|strong="H5159"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*.  
\v 33 También \w murió|strong="H4191"\w* Eleazar \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Aarón, y lo enterraron \w en|strong="H6912"\w* \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w de|strong="H1121"\w* su \w hijo|strong="H1121"\w* Finees, \w que|strong="H1121"\w* le fue \w dado|strong="H5414"\w* \w en|strong="H6912"\w* la montaña \w de|strong="H1121"\w* Efraín.   