\v 15 Pero \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* \w de|strong="H6440"\w* \w Hebrón|strong="H2275"\w* \w antes|strong="H6440"\w* \w era|strong="H1931"\w* Quiriat-arba; \w porque|strong="H6440"\w* Arba \w fue|strong="H1931"\w* \w el|strong="H1931"\w* hombre más \w grande|strong="H1419"\w* entre \w los|strong="H1931"\w* anaceos. \w Y|strong="H3068"\w* \w la|strong="H1931"\w* tierra descansó \w de|strong="H6440"\w* \w la|strong="H1931"\w* \w guerra|strong="H4421"\w*.   
\c 15  
\p
\v 1 \w El|strong="H1121"\w* territorio \w que|strong="H1121"\w* le tocó por sorteo \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*, conforme \w a|strong="H3068"\w* sus \w familias|strong="H4940"\w*, llegó hasta \w la|strong="H1366"\w* frontera \w de|strong="H1121"\w* Edom, hasta \w el|strong="H1121"\w* \w desierto|strong="H4057"\w* \w de|strong="H1121"\w* Zin \w hacia|strong="H5045"\w* \w el|strong="H1121"\w* sur, en \w el|strong="H1121"\w* \w extremo|strong="H7097"\w* sur.  
