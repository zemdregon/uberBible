\v 15 \w Entonces|strong="H3588"\w* \w ella|strong="H1931"\w* \w los|strong="H3427"\w* hizo bajar \w con|strong="H3588"\w* una cuerda \w por|strong="H3588"\w* \w la|strong="H1931"\w* ventana; \w porque|strong="H3588"\w* \w su|strong="H1931"\w* \w casa|strong="H1004"\w* \w estaba|strong="H3427"\w* \w en|strong="H3588"\w* \w la|strong="H1931"\w* muralla \w de|strong="H3588"\w* \w la|strong="H1931"\w* ciudad, \w y|strong="H3588"\w* \w ella|strong="H1931"\w* \w vivía|strong="H3427"\w* \w en|strong="H3588"\w* \w la|strong="H1931"\w* muralla.  
\v 16 \w Y|strong="H3068"\w* les dijo: “\w Vayan|strong="H3212"\w* \w a|strong="H3068"\w* la montaña, \w para|strong="H5704"\w* \w que|strong="H5704"\w* \w los|strong="H7291"\w* \w perseguidores|strong="H7291"\w* \w no|strong="H6435"\w* \w los|strong="H7291"\w* encuentren; \w y|strong="H5704"\w* quédense escondidos \w allí|strong="H8033"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w los|strong="H7291"\w* \w perseguidores|strong="H7291"\w* hayan regresado; \w y|strong="H5704"\w* \w después|strong="H5704"\w* \w se|strong="H6435"\w* \w irán|strong="H3212"\w* \w por|strong="H1870"\w* su \w camino|strong="H1870"\w*”.   
