\v 9 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* les dijo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: “Acérquense y \w escuchen|strong="H8085"\w* las \w palabras|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé su \w Dios|strong="H3068"\w*”.  
\v 10 \w Y|strong="H3068"\w* añadió \w Josué|strong="H3091"\w*: “\w En|strong="H3588"\w* \w esto|strong="H2063"\w* \w conocerán|strong="H3045"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* Dios \w vivo|strong="H2416"\w* \w está|strong="H2063"\w* \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ustedes, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* echará \w de|strong="H3588"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ustedes \w al|strong="H7130"\w* \w cananeo|strong="H3669"\w*, \w al|strong="H7130"\w* hitita, \w al|strong="H7130"\w* \w heveo|strong="H2340"\w*, \w al|strong="H7130"\w* ferezeo, \w al|strong="H7130"\w* gergeseo, \w al|strong="H7130"\w* amorreo \w y|strong="H3588"\w* \w al|strong="H7130"\w* \w jebuseo|strong="H2983"\w*.  
\v 11 He \w aquí|strong="H2009"\w*, \w el|strong="H3605"\w* arca del \w pacto|strong="H1285"\w* del Señor\f + \fr 3:11 \ft El término traducido como “Señor” es “Adonai”.\f* \w de|strong="H6440"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w va|strong="H3068"\w* \w a|strong="H3068"\w* cruzar \w el|strong="H3605"\w* \w Jordán|strong="H3383"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes.  
\v 12 \w Tomen|strong="H3947"\w*, \w pues|strong="H6258"\w*, \w ahora|strong="H6258"\w* \w doce|strong="H8147"\w* \w hombres|strong="H8147"\w* de las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w*, uno de cada \w tribu|strong="H7626"\w*.  
\v 13 \w Y|strong="H3068"\w* \w cuando|strong="H1961"\w* las plantas \w de|strong="H4325"\w* \w los|strong="H3605"\w* \w pies|strong="H7272"\w* \w de|strong="H4325"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H4325"\w* \w llevan|strong="H5375"\w* \w el|strong="H3605"\w* arca \w de|strong="H4325"\w* Yahvé, \w Señor|strong="H3068"\w* \w de|strong="H4325"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra, \w se|strong="H1961"\w* asienten \w en|strong="H5975"\w* las \w aguas|strong="H4325"\w* del \w Jordán|strong="H3383"\w*, las \w aguas|strong="H4325"\w* del \w Jordán|strong="H3383"\w* \w se|strong="H1961"\w* dividirán; porque las \w aguas|strong="H4325"\w* \w que|strong="H4325"\w* vienen \w de|strong="H4325"\w* \w arriba|strong="H4605"\w* \w se|strong="H1961"\w* detendrán formando un muro”.   
\p
\v 14 \w Y|strong="H3068"\w* \w aconteció|strong="H1961"\w* \w que|strong="H5971"\w* \w cuando|strong="H1961"\w* \w partió|strong="H5265"\w* \w el|strong="H5674"\w* \w pueblo|strong="H5971"\w* \w de|strong="H6440"\w* sus tiendas \w para|strong="H1961"\w* cruzar \w el|strong="H5674"\w* \w Jordán|strong="H3383"\w*, con \w los|strong="H1961"\w* \w sacerdotes|strong="H3548"\w* \w delante|strong="H6440"\w* del \w pueblo|strong="H5971"\w* \w llevando|strong="H5375"\w* \w el|strong="H5674"\w* arca del \w pacto|strong="H1285"\w*,  
\v 15 \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w llevaban|strong="H5375"\w* \w el|strong="H5921"\w* arca entraron \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w Jordán|strong="H3383"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w pies|strong="H7272"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5921"\w* \w llevaban|strong="H5375"\w* \w el|strong="H5921"\w* arca \w se|strong="H5921"\w* mojaron \w a|strong="H3068"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w agua|strong="H4325"\w* (\w porque|strong="H5921"\w* \w el|strong="H5921"\w* \w Jordán|strong="H3383"\w* suele desbordarse \w por|strong="H5921"\w* \w todas|strong="H3605"\w* sus riberas \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* cosecha),  
\v 16 \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w que|strong="H5921"\w* venían \w de|strong="H5921"\w* \w arriba|strong="H4605"\w* \w se|strong="H5921"\w* detuvieron \w y|strong="H5921"\w* \w se|strong="H5921"\w* alejaron formando un muro \w a|strong="H3068"\w* \w gran|strong="H3966"\w* distancia, \w desde|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w de|strong="H5921"\w* Adam, \w que|strong="H5921"\w* \w está|strong="H5975"\w* \w al|strong="H5921"\w* \w lado|strong="H6654"\w* \w de|strong="H5921"\w* Zaretán; \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* \w descendían|strong="H3381"\w* \w al|strong="H5921"\w* \w mar|strong="H3220"\w* \w del|strong="H5921"\w* Arabá, \w al|strong="H5921"\w* \w Mar|strong="H3220"\w* \w Salado|strong="H4417"\w*, \w se|strong="H5921"\w* \w cortaron|strong="H3772"\w* \w por|strong="H5921"\w* completo; \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* cruzó \w frente|strong="H5048"\w* \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w*.  
\v 17 Pero \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5704"\w* \w llevaban|strong="H5375"\w* \w el|strong="H3605"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H5704"\w* Yahvé se quedaron \w firmes|strong="H3559"\w* \w en|strong="H5704"\w* seco, \w en|strong="H5704"\w* \w medio|strong="H8432"\w* del \w Jordán|strong="H3383"\w*, instalados \w en|strong="H5704"\w* tierra \w firme|strong="H3559"\w*, \w mientras|strong="H3605"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w pasaba|strong="H5674"\w* \w por|strong="H5704"\w* \w lo|strong="H5704"\w* seco, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w nación|strong="H1471"\w* terminó \w de|strong="H5704"\w* cruzar \w el|strong="H3605"\w* \w Jordán|strong="H3383"\w*.   
\c 4  
\p
\v 1 \w Cuando|strong="H1961"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w nación|strong="H1471"\w* terminó de cruzar \w el|strong="H3605"\w* \w Jordán|strong="H3383"\w*, Yahvé le habló \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, diciendo:  
\v 2 “\w Tomen|strong="H3947"\w* \w doce|strong="H8147"\w* \w hombres|strong="H8147"\w* \w del|strong="H4480"\w* \w pueblo|strong="H5971"\w*, un hombre \w de|strong="H4480"\w* cada \w tribu|strong="H7626"\w*,  
\v 3 y mándenles \w lo|strong="H2088"\w* siguiente: ‘\w Tomen|strong="H5375"\w* \w de|strong="H5973"\w* \w aquí|strong="H2088"\w*, \w de|strong="H5973"\w* \w en|strong="H5973"\w* \w medio|strong="H8432"\w* \w del|strong="H5973"\w* \w Jordán|strong="H3383"\w*, \w del|strong="H5973"\w* lugar donde \w los|strong="H5973"\w* \w pies|strong="H7272"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w sacerdotes|strong="H3548"\w* estuvieron \w firmes|strong="H3559"\w*, \w doce|strong="H8147"\w* piedras; llévenlas \w con|strong="H5973"\w* ustedes y acampen \w con|strong="H5973"\w* ellas \w en|strong="H5973"\w* \w el|strong="H5973"\w* lugar donde \w pasarán|strong="H5674"\w* \w esta|strong="H2088"\w* \w noche|strong="H3915"\w*’”.   
\p
\v 4 Entonces \w Josué|strong="H3091"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w doce|strong="H8147"\w* \w hombres|strong="H8147"\w* \w que|strong="H1121"\w* \w él|strong="H1121"\w* había preparado \w de|strong="H1121"\w* entre \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, un \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* cada \w tribu|strong="H7626"\w*,  
\v 5 \w y|strong="H5921"\w* \w les|strong="H5921"\w* dijo \w Josué|strong="H3091"\w*: “Pasen \w delante|strong="H6440"\w* \w del|strong="H5921"\w* arca \w de|strong="H5921"\w* Yahvé su \w Dios|strong="H3068"\w* \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* \w medio|strong="H8432"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*, \w y|strong="H5921"\w* cada uno \w de|strong="H5921"\w* ustedes tome una piedra \w sobre|strong="H5921"\w* su \w hombro|strong="H7926"\w*, \w conforme|strong="H5921"\w* \w al|strong="H5921"\w* \w número|strong="H4557"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w tribus|strong="H7626"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*;  
\v 6 \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w esto|strong="H2063"\w* \w sea|strong="H1961"\w* una señal \w entre|strong="H7130"\w* ustedes. \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* sus \w hijos|strong="H1121"\w* pregunten \w a|strong="H3068"\w* sus padres \w en|strong="H3588"\w* \w el|strong="H3588"\w* futuro: ‘¿\w Qué|strong="H3588"\w* significan \w estas|strong="H2063"\w* piedras?’,  
\v 7 les responderán: ‘\w Que|strong="H5704"\w* las \w aguas|strong="H4325"\w* del \w Jordán|strong="H3383"\w* \w fueron|strong="H1961"\w* divididas \w delante|strong="H6440"\w* del arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Yahvé; \w cuando|strong="H5704"\w* \w el|strong="H1121"\w* arca cruzó \w el|strong="H1121"\w* \w Jordán|strong="H3383"\w*, las \w aguas|strong="H4325"\w* del río \w se|strong="H1961"\w* partieron. Estas piedras \w servirán|strong="H1961"\w* \w de|strong="H6440"\w* recordatorio \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*’”.   
\p
\v 8 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* \w así|strong="H3651"\w*, \w como|strong="H5973"\w* \w Josué|strong="H3091"\w* \w les|strong="H5973"\w* \w mandó|strong="H6680"\w*: \w tomaron|strong="H5375"\w* \w doce|strong="H8147"\w* piedras \w de|strong="H5973"\w* \w en|strong="H5973"\w* \w medio|strong="H8432"\w* \w del|strong="H5973"\w* \w Jordán|strong="H3383"\w*, \w como|strong="H5973"\w* Yahvé \w le|strong="H5973"\w* \w había|strong="H6213"\w* \w dicho|strong="H1696"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, conforme al \w número|strong="H4557"\w* \w de|strong="H5973"\w* las \w tribus|strong="H7626"\w* \w de|strong="H5973"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*; las \w llevaron|strong="H5375"\w* \w consigo|strong="H5973"\w* al lugar \w donde|strong="H8033"\w* acamparon y las depositaron \w allí|strong="H8033"\w*.  
\v 9 \w Josué|strong="H3091"\w* \w también|strong="H2088"\w* \w levantó|strong="H5375"\w* \w doce|strong="H8147"\w* piedras \w en|strong="H5704"\w* \w medio|strong="H8432"\w* del \w Jordán|strong="H3383"\w*, \w en|strong="H5704"\w* el \w lugar|strong="H8478"\w* \w donde|strong="H8033"\w* \w estuvieron|strong="H1961"\w* \w los|strong="H1961"\w* \w pies|strong="H7272"\w* \w de|strong="H8478"\w* \w los|strong="H1961"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5704"\w* \w llevaban|strong="H5375"\w* el arca del \w pacto|strong="H1285"\w*; \w y|strong="H5704"\w* \w allí|strong="H8033"\w* han \w estado|strong="H1961"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 10 \w Y|strong="H3068"\w* \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5704"\w* \w llevaban|strong="H5375"\w* \w el|strong="H3605"\w* arca permanecieron parados \w en|strong="H5704"\w* \w medio|strong="H8432"\w* del \w Jordán|strong="H3383"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w se|strong="H5971"\w* cumplió \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5704"\w* Yahvé le \w había|strong="H5975"\w* \w mandado|strong="H6680"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w que|strong="H5704"\w* dijera \w al|strong="H5704"\w* \w pueblo|strong="H5971"\w*, \w conforme|strong="H5704"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5704"\w* \w Moisés|strong="H4872"\w* le \w había|strong="H5975"\w* \w mandado|strong="H6680"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*; \w y|strong="H5704"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* apresuró \w y|strong="H5704"\w* cruzó.  
\v 11 \w Cuando|strong="H1961"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* terminó \w de|strong="H6440"\w* cruzar, \w pasó|strong="H5674"\w* también \w el|strong="H3605"\w* arca \w de|strong="H6440"\w* Yahvé y \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* en \w presencia|strong="H6440"\w* del \w pueblo|strong="H5971"\w*.   
\p
\v 12 También \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Rubén|strong="H7205"\w*, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Gad|strong="H1410"\w* y la media \w tribu|strong="H7626"\w* \w de|strong="H6440"\w* \w Manasés|strong="H4519"\w* \w pasaron|strong="H5674"\w* \w armados|strong="H2571"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, según \w Moisés|strong="H4872"\w* les había \w dicho|strong="H1696"\w*.  
\v 13 Unos cuarenta mil hombres, listos para la \w guerra|strong="H4421"\w*, \w pasaron|strong="H5674"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w a|strong="H3068"\w* la \w batalla|strong="H4421"\w*, \w a|strong="H3068"\w* las llanuras \w de|strong="H6440"\w* \w Jericó|strong="H3405"\w*.  
\v 14 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* Yahvé \w engrandeció|strong="H1431"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* ante \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H3372"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*; y \w le|strong="H1931"\w* \w temieron|strong="H3372"\w*, \w como|strong="H1931"\w* habían \w temido|strong="H3372"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H3372"\w* \w su|strong="H1931"\w* \w vida|strong="H2416"\w*.   
\p
\v 15 Luego Yahvé le habló \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, diciendo:  
\v 16 “Mándales \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w* \w que|strong="H4480"\w* \w llevan|strong="H5375"\w* el arca \w del|strong="H4480"\w* \w testimonio|strong="H5715"\w* \w que|strong="H4480"\w* suban \w del|strong="H4480"\w* \w Jordán|strong="H3383"\w*”.   
\p
\v 17 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w les|strong="H6680"\w* \w mandó|strong="H6680"\w* \w a|strong="H3068"\w* los \w sacerdotes|strong="H3548"\w*, diciendo: “¡Suban \w del|strong="H4480"\w* \w Jordán|strong="H3383"\w*!”.  
\v 18 \w Y|strong="H3068"\w* \w aconteció|strong="H1961"\w* \w que|strong="H5921"\w* \w cuando|strong="H1961"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5921"\w* \w llevaban|strong="H5375"\w* \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé \w subieron|strong="H5927"\w* \w de|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* plantas \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pies|strong="H7272"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* pisaron tierra seca, \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w* \w volvieron|strong="H7725"\w* \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w* \w y|strong="H5921"\w* corrieron \w como|strong="H1961"\w* \w antes|strong="H8543"\w* \w sobre|strong="H5921"\w* \w todas|strong="H3605"\w* sus riberas.   
\p
\v 19 El \w pueblo|strong="H5971"\w* \w subió|strong="H5927"\w* \w del|strong="H4480"\w* \w Jordán|strong="H3383"\w* el día diez \w del|strong="H4480"\w* \w primer|strong="H7223"\w* \w mes|strong="H2320"\w*, y acamparon \w en|strong="H4480"\w* \w Gilgal|strong="H1537"\w*, \w al|strong="H4480"\w* \w oriente|strong="H4217"\w* \w de|strong="H4480"\w* \w Jericó|strong="H3405"\w*.  
\v 20 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w levantó|strong="H6965"\w* \w en|strong="H4480"\w* \w Gilgal|strong="H1537"\w* las \w doce|strong="H8147"\w* piedras \w que|strong="H4480"\w* habían traído \w del|strong="H4480"\w* \w Jordán|strong="H3383"\w*.  
\v 21 \w Y|strong="H3068"\w* les habló \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, diciendo: “\w Cuando|strong="H4100"\w* sus \w hijos|strong="H1121"\w* les pregunten \w el|strong="H1121"\w* \w día|strong="H1121"\w* \w de|strong="H1121"\w* \w mañana|strong="H4279"\w* \w a|strong="H3068"\w* sus padres: ‘¿\w Qué|strong="H4100"\w* significan estas piedras?’,  
\v 22 les declararán \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*: ‘\w Israel|strong="H3478"\w* cruzó \w este|strong="H2088"\w* \w Jordán|strong="H3383"\w* en seco’.  
\v 23 \w Porque|strong="H6440"\w* Yahvé su \w Dios|strong="H3068"\w* \w secó|strong="H3001"\w* las \w aguas|strong="H4325"\w* del \w Jordán|strong="H3383"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes, \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* hubieron \w pasado|strong="H5674"\w*, \w de|strong="H6440"\w* la misma manera \w que|strong="H5704"\w* Yahvé su \w Dios|strong="H3068"\w* \w lo|strong="H6213"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* \w en|strong="H5704"\w* \w el|strong="H6213"\w* \w mar|strong="H3220"\w* Rojo, \w el|strong="H6213"\w* cual \w secó|strong="H3001"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* nosotros \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* cruzamos;  
\v 24 \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* \w de|strong="H3588"\w* \w la|strong="H1931"\w* tierra \w conozcan|strong="H3045"\w* \w que|strong="H3588"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w de|strong="H3588"\w* Yahvé \w es|strong="H1931"\w* \w poderosa|strong="H2389"\w*; \w a|strong="H3068"\w* fin \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w teman|strong="H3372"\w* \w a|strong="H3068"\w* Yahvé \w su|strong="H1931"\w* \w Dios|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w*”.   
\c 5  
\p
\v 1 \w Cuando|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* amorreos \w que|strong="H3808"\w* \w estaban|strong="H1961"\w* \w al|strong="H5921"\w* \w otro|strong="H5750"\w* \w lado|strong="H5676"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w*, \w al|strong="H5921"\w* occidente, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w cananeos|strong="H3669"\w* \w que|strong="H3808"\w* \w estaban|strong="H1961"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w mar|strong="H3220"\w*, \w oyeron|strong="H8085"\w* \w cómo|strong="H1961"\w* Yahvé \w había|strong="H1961"\w* secado \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* \w Jordán|strong="H3383"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* terminamos \w de|strong="H5921"\w* cruzar, su \w corazón|strong="H3824"\w* \w se|strong="H1961"\w* acobardó \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w hubo|strong="H1961"\w* \w más|strong="H5750"\w* aliento \w en|strong="H5921"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 2 En \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* Yahvé \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “\w Hazte|strong="H6213"\w* \w cuchillos|strong="H2719"\w* \w de|strong="H1121"\w* \w pedernal|strong="H6697"\w* y \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* circuncidar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* por \w segunda|strong="H8145"\w* \w vez|strong="H6256"\w*”.  
\v 3 \w Josué|strong="H3091"\w* se \w hizo|strong="H6213"\w* \w cuchillos|strong="H2719"\w* \w de|strong="H1121"\w* \w pedernal|strong="H6697"\w* y circuncidó \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* en la colina \w de|strong="H1121"\w* Aralot.  
\v 4 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* \w la|strong="H3605"\w* \w causa|strong="H1697"\w* \w por|strong="H1870"\w* \w la|strong="H3605"\w* cual \w Josué|strong="H3091"\w* \w los|strong="H3605"\w* circuncidó: \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* había \w salido|strong="H3318"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*, \w los|strong="H3605"\w* \w varones|strong="H2145"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres \w de|strong="H5971"\w* \w guerra|strong="H4421"\w*, habían \w muerto|strong="H4191"\w* \w en|strong="H3318"\w* \w el|strong="H3605"\w* \w desierto|strong="H4057"\w*, \w por|strong="H1870"\w* \w el|strong="H3605"\w* \w camino|strong="H1870"\w*, después \w de|strong="H5971"\w* \w que|strong="H5971"\w* \w salieron|strong="H3318"\w* \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*.  
\v 5 \w Pues|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* del \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w salieron|strong="H3318"\w* \w estaban|strong="H1961"\w* circuncidados; \w pero|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* \w habían|strong="H1961"\w* nacido \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*, \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w*, \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w salir|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w no|strong="H3808"\w* \w habían|strong="H1961"\w* \w sido|strong="H1961"\w* circuncidados.  
\v 6 \w Porque|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w anduvieron|strong="H1980"\w* cuarenta \w años|strong="H8141"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*, \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* pereció \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w nación|strong="H1471"\w*, \w es|strong="H3588"\w* \w decir|strong="H8085"\w*, \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H3588"\w* \w guerra|strong="H4421"\w* \w que|strong="H3588"\w* habían \w salido|strong="H3318"\w* \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*, \w por|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w no|strong="H3808"\w* \w obedecieron|strong="H8085"\w* \w la|strong="H3588"\w* \w voz|strong="H6963"\w* \w de|strong="H3588"\w* Yahvé; \w por|strong="H3588"\w* \w lo|strong="H3808"\w* \w cual|strong="H3588"\w* Yahvé les \w juró|strong="H7650"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* les dejaría \w ver|strong="H7200"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* \w jurado|strong="H7650"\w* \w a|strong="H3068"\w* sus antepasados \w que|strong="H3588"\w* nos \w daría|strong="H5414"\w*, una tierra \w que|strong="H3588"\w* \w fluye|strong="H2100"\w* \w leche|strong="H2461"\w* \w y|strong="H3588"\w* \w miel|strong="H1706"\w*.  
\v 7 \w A|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* ellos, \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w había|strong="H1961"\w* levantado \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w lugar|strong="H8478"\w*, \w Josué|strong="H3091"\w* \w los|strong="H1121"\w* circuncidó; \w pues|strong="H3588"\w* \w eran|strong="H1961"\w* \w incircuncisos|strong="H6189"\w*, \w por|strong="H3588"\w* \w no|strong="H3808"\w* haberlos \w circuncidado|strong="H4135"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w*.  
\v 8 \w Y|strong="H3068"\w* \w cuando|strong="H5704"\w* terminaron \w de|strong="H8478"\w* circuncidar \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w nación|strong="H1471"\w*, \w se|strong="H1961"\w* \w quedaron|strong="H1961"\w* \w en|strong="H5704"\w* sus mismos lugares \w en|strong="H5704"\w* \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* sanaron.   
\p
\v 9 \w Entonces|strong="H3117"\w* Yahvé \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “\w Hoy|strong="H3117"\w* he quitado \w de|strong="H5921"\w* ustedes \w la|strong="H1931"\w* vergüenza \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*”; \w por|strong="H5921"\w* \w lo|strong="H1931"\w* \w cual|strong="H1931"\w* \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* \w aquel|strong="H1931"\w* \w lugar|strong="H4725"\w* \w fue|strong="H1931"\w* \w llamado|strong="H8034"\w* \w Gilgal|strong="H1537"\w*\f + \fr 5:9 \ft “Gilgal” suena como el término hebreo para “rodar” o “círculo”.\f* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*.  
\v 10 \w Y|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* acamparon en \w Gilgal|strong="H1537"\w*, y celebraron la \w Pascua|strong="H6453"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* catorce \w días|strong="H3117"\w* del \w mes|strong="H2320"\w*, al atardecer, en las llanuras \w de|strong="H1121"\w* \w Jericó|strong="H3405"\w*.  
\v 11 Al \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w* de la \w Pascua|strong="H6453"\w* comieron de los frutos de la tierra, panes sin levadura y \w espigas|strong="H2088"\w* tostadas en \w aquel|strong="H2088"\w* \w mismo|strong="H6106"\w* \w día|strong="H3117"\w*.  
\v 12 \w Y|strong="H3068"\w* \w el|strong="H1931"\w* \w maná|strong="H4478"\w* \w cesó|strong="H7673"\w* al \w día|strong="H1121"\w* \w siguiente|strong="H4283"\w*, desde \w que|strong="H1931"\w* comenzaron \w a|strong="H3068"\w* comer del \w fruto|strong="H8393"\w* \w de|strong="H5750"\w* \w la|strong="H1931"\w* tierra; y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w tuvieron|strong="H1961"\w* \w maná|strong="H4478"\w*, \w sino|strong="H3808"\w* \w que|strong="H1931"\w* comieron \w de|strong="H5750"\w* \w los|strong="H1121"\w* productos \w de|strong="H5750"\w* \w la|strong="H1931"\w* tierra \w de|strong="H5750"\w* \w Canaán|strong="H3667"\w* \w aquel|strong="H1931"\w* \w año|strong="H8141"\w*.   
\p
\v 13 \w Estando|strong="H1961"\w* \w Josué|strong="H3091"\w* cerca \w de|strong="H5048"\w* \w Jericó|strong="H3405"\w*, \w levantó|strong="H5375"\w* la vista y \w vio|strong="H7200"\w* \w a|strong="H3068"\w* un hombre \w que|strong="H1961"\w* \w estaba|strong="H1961"\w* \w delante|strong="H5048"\w* \w de|strong="H5048"\w* él, el cual \w tenía|strong="H1961"\w* una \w espada|strong="H2719"\w* desenvainada \w en|strong="H5975"\w* su \w mano|strong="H3027"\w*. \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w*, acercándose \w a|strong="H3068"\w* él, \w le|strong="H5869"\w* dijo: “¿\w Eres|strong="H1961"\w* \w de|strong="H5048"\w* \w los|strong="H1961"\w* nuestros \w o|strong="H3068"\w* \w de|strong="H5048"\w* nuestros \w enemigos|strong="H6862"\w*?”.   
\p
\v 14 \w Él|strong="H3588"\w* respondió: “\w No|strong="H3808"\w*; \w más|strong="H3588"\w* \w bien|strong="H3588"\w*, \w yo|strong="H3588"\w* soy \w el|strong="H3588"\w* \w Príncipe|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* acabo \w de|strong="H3588"\w* llegar”. \w Entonces|strong="H3588"\w* \w Josué|strong="H3091"\w*, \w postrándose|strong="H5307"\w* sobre \w su|strong="H3588"\w* \w rostro|strong="H6440"\w* \w en|strong="H3588"\w* tierra, \w lo|strong="H4100"\w* \w adoró|strong="H7812"\w* \w y|strong="H3588"\w* le \w dijo|strong="H1696"\w*: “¿\w Qué|strong="H3588"\w* le \w dice|strong="H1696"\w* mi \w Señor|strong="H3068"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w siervo|strong="H5650"\w*?”.   
\p
\v 15 \w Y|strong="H3068"\w* \w el|strong="H1931"\w* \w Príncipe|strong="H8269"\w* \w del|strong="H5921"\w* \w ejército|strong="H6635"\w* \w de|strong="H5921"\w* Yahvé \w le|strong="H1931"\w* respondió \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “Quítate \w las|strong="H5921"\w* sandalias \w de|strong="H5921"\w* tus \w pies|strong="H7272"\w*, \w porque|strong="H3588"\w* \w el|strong="H1931"\w* \w lugar|strong="H4725"\w* \w donde|strong="H5921"\w* \w estás|strong="H5975"\w* \w es|strong="H1931"\w* \w santo|strong="H6944"\w*”. \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w lo|strong="H1931"\w* \w hizo|strong="H6213"\w* \w así|strong="H3651"\w*.   
\c 6  
\p
\v 1 \w Jericó|strong="H3405"\w* estaba bien \w cerrada|strong="H5462"\w* \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*; nadie \w salía|strong="H3318"\w* ni entraba.  
\v 2 Pero Yahvé le dijo \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*: “\w Mira|strong="H7200"\w*, yo he \w entregado|strong="H5414"\w* en tus \w manos|strong="H3027"\w* \w a|strong="H3068"\w* \w Jericó|strong="H3405"\w* y \w a|strong="H3068"\w* su \w rey|strong="H4428"\w*, con sus guerreros.  
\v 3 \w Rodearán|strong="H5362"\w*, pues, \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* hombres de \w guerra|strong="H4421"\w*, marchando \w alrededor|strong="H5437"\w* de \w ella|strong="H3605"\w* \w una|strong="H6471"\w* \w vez|strong="H6471"\w*; \w y|strong="H3541"\w* \w esto|strong="H3541"\w* \w lo|strong="H6213"\w* \w harán|strong="H6213"\w* durante \w seis|strong="H8337"\w* \w días|strong="H3117"\w*.  
\v 4 \w Siete|strong="H7651"\w* \w sacerdotes|strong="H3548"\w* \w llevarán|strong="H5375"\w* \w siete|strong="H7651"\w* \w trompetas|strong="H7782"\w* \w de|strong="H6440"\w* cuerno \w de|strong="H6440"\w* carnero \w delante|strong="H6440"\w* del arca; y al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* le darán \w siete|strong="H7651"\w* \w vueltas|strong="H6471"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w*, y los \w sacerdotes|strong="H3548"\w* \w tocarán|strong="H8628"\w* las \w trompetas|strong="H7782"\w*.  
\v 5 \w Y|strong="H3068"\w* \w cuando|strong="H1961"\w* toquen un \w sonido|strong="H6963"\w* prolongado con \w el|strong="H3605"\w* \w cuerno|strong="H7161"\w* \w de|strong="H8478"\w* carnero, \w en|strong="H8478"\w* \w cuanto|strong="H8478"\w* \w oigan|strong="H8085"\w* \w el|strong="H3605"\w* \w sonido|strong="H6963"\w* \w de|strong="H8478"\w* \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w gritará|strong="H7321"\w* \w a|strong="H3068"\w* \w gran|strong="H1419"\w* \w voz|strong="H6963"\w*, y \w la|strong="H3605"\w* muralla \w de|strong="H8478"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* \w se|strong="H1961"\w* derrumbará \w por|strong="H8478"\w* completo; entonces \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w subirá|strong="H5927"\w*, \w cada|strong="H3605"\w* uno directo hacia adelante”.   
\p
\v 6 \w Llamando|strong="H7121"\w*, pues, \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Nun|strong="H5126"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, les dijo: “\w Tomen|strong="H5375"\w* \w el|strong="H1121"\w* arca del \w pacto|strong="H1285"\w*, y \w que|strong="H1121"\w* \w siete|strong="H7651"\w* \w sacerdotes|strong="H3548"\w* \w lleven|strong="H5375"\w* \w siete|strong="H7651"\w* \w trompetas|strong="H7782"\w* \w de|strong="H6440"\w* cuerno \w de|strong="H6440"\w* carnero \w delante|strong="H6440"\w* del arca \w de|strong="H6440"\w* Yahvé”.   
\p
\v 7 \w Y|strong="H3068"\w* le dijo al \w pueblo|strong="H5971"\w*: “Pasen, y rodeen la \w ciudad|strong="H5892"\w*; y los \w que|strong="H5971"\w* están \w armados|strong="H2502"\w* \w pasarán|strong="H5674"\w* \w delante|strong="H6440"\w* del arca \w de|strong="H6440"\w* Yahvé”.   
\p
\v 8 \w Y|strong="H3068"\w* \w aconteció|strong="H1961"\w* \w que|strong="H5971"\w* \w cuando|strong="H1961"\w* \w Josué|strong="H3091"\w* terminó \w de|strong="H6440"\w* hablarle al \w pueblo|strong="H5971"\w*, \w los|strong="H1961"\w* \w siete|strong="H7651"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H5971"\w* \w llevaban|strong="H5375"\w* las \w siete|strong="H7651"\w* \w trompetas|strong="H7782"\w* \w de|strong="H6440"\w* cuerno \w de|strong="H6440"\w* carnero \w pasaron|strong="H5674"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé y \w tocaron|strong="H8628"\w* las \w trompetas|strong="H7782"\w*; y \w el|strong="H5674"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Yahvé \w los|strong="H1961"\w* \w seguía|strong="H1961"\w*.  
\v 9 \w Y|strong="H3068"\w* los hombres \w armados|strong="H2502"\w* \w iban|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* los \w sacerdotes|strong="H3548"\w* que \w tocaban|strong="H8628"\w* las \w trompetas|strong="H7782"\w*, y la retaguardia \w iba|strong="H1980"\w* tras el arca, mientras las \w trompetas|strong="H7782"\w* sonaban continuamente.   
\p
\v 10 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* le dio esta \w orden|strong="H6680"\w* \w al|strong="H5704"\w* \w pueblo|strong="H5971"\w*, diciendo: “Ustedes \w no|strong="H3808"\w* gritarán, \w ni|strong="H3808"\w* \w se|strong="H3808"\w* \w oirá|strong="H8085"\w* su \w voz|strong="H6963"\w*, \w ni|strong="H3808"\w* \w saldrá|strong="H3318"\w* \w palabra|strong="H1697"\w* \w de|strong="H5704"\w* su \w boca|strong="H6310"\w*, \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3808"\w* \w yo|strong="H6680"\w* \w les|strong="H6680"\w* diga: ‘¡Griten!’; \w entonces|strong="H3117"\w* gritarán”.  
\v 11 Así hizo que \w el|strong="H3885"\w* arca de Yahvé diera \w una|strong="H6471"\w* \w vuelta|strong="H5437"\w* \w alrededor|strong="H5437"\w* de la \w ciudad|strong="H5892"\w*; y volvieron al \w campamento|strong="H4264"\w*, y allí pasaron la noche.  
\v 12 \w Josué|strong="H3091"\w* se \w levantó|strong="H5375"\w* muy de \w mañana|strong="H1242"\w*, y los \w sacerdotes|strong="H3548"\w* \w tomaron|strong="H5375"\w* el arca de Yahvé.  
\v 13 \w Y|strong="H3068"\w* los \w siete|strong="H7651"\w* \w sacerdotes|strong="H3548"\w* \w que|strong="H7651"\w* \w llevaban|strong="H5375"\w* las \w siete|strong="H7651"\w* \w trompetas|strong="H7782"\w* \w de|strong="H6440"\w* cuerno \w de|strong="H6440"\w* carnero \w fueron|strong="H1980"\w* \w caminando|strong="H1980"\w* \w delante|strong="H6440"\w* del arca \w de|strong="H6440"\w* Yahvé, tocando continuamente las \w trompetas|strong="H7782"\w*; y los hombres \w armados|strong="H2502"\w* \w iban|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos, y la retaguardia \w iba|strong="H1980"\w* tras el arca \w de|strong="H6440"\w* Yahvé, mientras las \w trompetas|strong="H7782"\w* sonaban sin cesar.  
\v 14 \w Así|strong="H3541"\w* dieron \w otra|strong="H8145"\w* \w vuelta|strong="H5437"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* \w el|strong="H6213"\w* \w segundo|strong="H8145"\w* \w día|strong="H3117"\w*, \w y|strong="H3541"\w* \w volvieron|strong="H7725"\w* al \w campamento|strong="H4264"\w*; de esta manera \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w* durante \w seis|strong="H8337"\w* \w días|strong="H3117"\w*.   
\p
\v 15 Al \w séptimo|strong="H7637"\w* \w día|strong="H3117"\w* \w se|strong="H1961"\w* levantaron al despuntar \w el|strong="H1931"\w* alba, y \w le|strong="H1931"\w* dieron \w vuelta|strong="H5437"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* de \w la|strong="H1931"\w* \w misma|strong="H1931"\w* manera \w siete|strong="H7651"\w* \w veces|strong="H6471"\w*; \w solamente|strong="H7535"\w* \w este|strong="H2088"\w* \w día|strong="H3117"\w* \w le|strong="H1931"\w* dieron \w siete|strong="H7651"\w* \w vueltas|strong="H6471"\w* \w alrededor|strong="H5437"\w* de \w ella|strong="H1931"\w*.  
