\c 16  
\p
\v 1 \w El|strong="H1008"\w* territorio \w que|strong="H4325"\w* les tocó por sorteo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w* empezaba desde \w el|strong="H1008"\w* \w Jordán|strong="H3383"\w* \w a|strong="H3068"\w* la altura \w de|strong="H1121"\w* \w Jericó|strong="H3405"\w*, \w hasta|strong="H3405"\w* las \w aguas|strong="H4325"\w* \w de|strong="H1121"\w* \w Jericó|strong="H3405"\w* al \w oriente|strong="H4217"\w*, hacia \w el|strong="H1008"\w* \w desierto|strong="H4057"\w* \w que|strong="H4325"\w* \w sube|strong="H5927"\w* \w de|strong="H1121"\w* \w Jericó|strong="H3405"\w* por las montañas \w a|strong="H3068"\w* Bet-el.  
\v 2 \w Y|strong="H3068"\w* de Bet-el \w sale|strong="H3318"\w* \w a|strong="H3068"\w* \w Luz|strong="H3870"\w*, y \w pasa|strong="H5674"\w* \w a|strong="H3068"\w* lo largo del territorio de los arquitas hasta Atarot;  
\v 3 \w y|strong="H5704"\w* \w baja|strong="H3381"\w* \w hacia|strong="H1366"\w* el occidente \w al|strong="H5704"\w* territorio \w de|strong="H5704"\w* \w los|strong="H1961"\w* jafletitas, \w hasta|strong="H5704"\w* \w la|strong="H1366"\w* frontera \w de|strong="H5704"\w* Bet-horón \w de|strong="H5704"\w* abajo \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w Gezer|strong="H1507"\w*, \w para|strong="H5704"\w* terminar \w en|strong="H5704"\w* el \w mar|strong="H3220"\w*.   
\p
\v 4 Tomaron, pues, su herencia \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*, \w Manasés|strong="H4519"\w* y Efraín.  
\v 5 \w Y|strong="H3068"\w* \w este|strong="H1961"\w* \w fue|strong="H1961"\w* \w el|strong="H1121"\w* territorio \w de|strong="H5704"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* Efraín \w por|strong="H5704"\w* sus \w familias|strong="H4940"\w*; \w la|strong="H1366"\w* frontera \w de|strong="H5704"\w* su \w herencia|strong="H5159"\w* \w al|strong="H5704"\w* \w oriente|strong="H4217"\w* \w fue|strong="H1961"\w* Atarot-adar \w hasta|strong="H5704"\w* Bet-horón \w de|strong="H5704"\w* arriba.  
\v 6 \w Y|strong="H3068"\w* \w sale|strong="H3318"\w* \w la|strong="H1366"\w* frontera al \w mar|strong="H3220"\w*, al \w norte|strong="H6828"\w* de Micmetat, y rodea \w la|strong="H1366"\w* frontera \w hacia|strong="H1366"\w* \w el|strong="H5674"\w* \w oriente|strong="H4217"\w* hasta Taanat-silo, y de aquí \w pasa|strong="H5674"\w* al \w oriente|strong="H4217"\w* \w a|strong="H3068"\w* Janoa.  
\v 7 De Janoa \w desciende|strong="H3381"\w* \w a|strong="H3068"\w* Atarot y \w a|strong="H3068"\w* Naara, y toca \w en|strong="H3318"\w* \w Jericó|strong="H3405"\w* y \w sale|strong="H3318"\w* al \w Jordán|strong="H3383"\w*.  
\v 8 \w Y|strong="H3068"\w* \w de|strong="H1121"\w* Tapúa \w va|strong="H3068"\w* \w la|strong="H1366"\w* frontera \w hacia|strong="H1366"\w* \w el|strong="H1121"\w* occidente al \w arroyo|strong="H5158"\w* \w de|strong="H1121"\w* Caná, \w para|strong="H1961"\w* terminar \w en|strong="H3212"\w* \w el|strong="H1121"\w* \w mar|strong="H3220"\w*. \w Esta|strong="H2063"\w* \w es|strong="H1961"\w* \w la|strong="H1366"\w* \w herencia|strong="H5159"\w* \w de|strong="H1121"\w* \w la|strong="H1366"\w* \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Efraín por sus \w familias|strong="H4940"\w*,  
\v 9 con las \w ciudades|strong="H5892"\w* \w que|strong="H1121"\w* se apartaron para \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Efraín \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w herencia|strong="H5159"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*, \w todas|strong="H3605"\w* las \w ciudades|strong="H5892"\w* con sus \w aldeas|strong="H2691"\w*.  
\v 10 Pero \w no|strong="H3808"\w* expulsaron \w al|strong="H5704"\w* \w cananeo|strong="H3669"\w* \w que|strong="H3808"\w* \w habitaba|strong="H3427"\w* \w en|strong="H5704"\w* \w Gezer|strong="H1507"\w*; \w por|strong="H2088"\w* \w lo|strong="H2088"\w* cual \w el|strong="H3427"\w* \w cananeo|strong="H3669"\w* \w habitó|strong="H3427"\w* \w en|strong="H5704"\w* \w medio|strong="H7130"\w* \w de|strong="H5704"\w* Efraín \w hasta|strong="H5704"\w* \w el|strong="H3427"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w y|strong="H5704"\w* \w fue|strong="H1961"\w* puesto bajo trabajos forzados.   
\c 17  
\p
\v 1 \w Esta|strong="H1931"\w* \w fue|strong="H1961"\w* \w la|strong="H1931"\w* parte \w que|strong="H3588"\w* \w le|strong="H1931"\w* tocó \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w tribu|strong="H4294"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w*, ya \w que|strong="H3588"\w* \w era|strong="H1961"\w* \w el|strong="H1931"\w* hijo \w mayor|strong="H3588"\w* \w de|strong="H3588"\w* \w José|strong="H3130"\w*. \w A|strong="H3068"\w* Maquir, hijo \w mayor|strong="H3588"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w* \w y|strong="H3588"\w* padre \w de|strong="H3588"\w* \w Galaad|strong="H1568"\w*, \w se|strong="H1961"\w* \w le|strong="H1931"\w* dio \w Galaad|strong="H1568"\w* \w y|strong="H3588"\w* \w Basán|strong="H1316"\w*, \w por|strong="H3588"\w* ser hombre \w de|strong="H3588"\w* \w guerra|strong="H4421"\w*.  
\v 2 También \w se|strong="H1961"\w* les dio su parte al resto \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* conforme \w a|strong="H3068"\w* sus \w familias|strong="H4940"\w*: \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Abiezer, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Helec, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Asriel, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Siquem, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Hefer y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Semida; estos \w fueron|strong="H1961"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w varones|strong="H2145"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*, por sus \w familias|strong="H4940"\w*.  
\v 3 \w Pero|strong="H3588"\w* Zelofehad \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Hefer, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Galaad|strong="H1568"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Maquir, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w*, \w no|strong="H3808"\w* \w tuvo|strong="H1961"\w* \w hijos|strong="H1121"\w*, \w sino|strong="H3588"\w* \w hijas|strong="H1323"\w*, \w y|strong="H3588"\w* estos \w son|strong="H1961"\w* \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H3588"\w* ellas: \w Maalá|strong="H4244"\w*, \w Noa|strong="H5270"\w*, \w Hoglá|strong="H2295"\w*, \w Milca|strong="H4435"\w* \w y|strong="H3588"\w* Tirsa.  
\v 4 Ellas se \w presentaron|strong="H5414"\w* \w ante|strong="H6440"\w* \w el|strong="H1121"\w* \w sacerdote|strong="H3548"\w* Eleazar, \w ante|strong="H6440"\w* \w Josué|strong="H3091"\w* \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Nun|strong="H5126"\w*, y \w ante|strong="H6440"\w* \w los|strong="H1121"\w* líderes, y dijeron: “Yahvé le \w mandó|strong="H6680"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w que|strong="H1121"\w* nos \w diera|strong="H5414"\w* una \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* nuestros hermanos”. Así \w que|strong="H1121"\w* \w él|strong="H1121"\w* \w les|strong="H6680"\w* \w dio|strong="H5414"\w* una \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* hermanos \w de|strong="H6440"\w* su padre, \w conforme|strong="H6310"\w* al \w mandato|strong="H6310"\w* \w de|strong="H6440"\w* Yahvé.  
\v 5 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w Manasés|strong="H4519"\w* le tocaron \w diez|strong="H6235"\w* porciones, además de la tierra de \w Galaad|strong="H1568"\w* y de \w Basán|strong="H1316"\w* que está al otro \w lado|strong="H5676"\w* del \w Jordán|strong="H3383"\w*;  
\v 6 \w porque|strong="H3588"\w* las \w hijas|strong="H1323"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w* \w tuvieron|strong="H1961"\w* \w herencia|strong="H5159"\w* \w entre|strong="H8432"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w él|strong="H3588"\w*; \w y|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Galaad|strong="H1568"\w* \w fue|strong="H1961"\w* \w para|strong="H3588"\w* \w los|strong="H1121"\w* otros \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w*.  
\v 7 \w Y|strong="H3068"\w* \w la|strong="H5921"\w* frontera \w de|strong="H5921"\w* \w Manasés|strong="H4519"\w* \w iba|strong="H1980"\w* \w desde|strong="H5921"\w* Aser \w hasta|strong="H5921"\w* Micmetat, \w que|strong="H5921"\w* \w está|strong="H1961"\w* frente \w a|strong="H3068"\w* Siquem; \w y|strong="H5921"\w* \w la|strong="H5921"\w* frontera sigue \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* sur, \w hacia|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* En-tapúa.  
\v 8 \w La|strong="H1366"\w* tierra \w de|strong="H1121"\w* Tapúa \w fue|strong="H1961"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*; pero \w la|strong="H1366"\w* ciudad \w de|strong="H1121"\w* Tapúa, \w que|strong="H1121"\w* \w está|strong="H1961"\w* en \w la|strong="H1366"\w* frontera \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*, le pertenece \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Efraín.  
\v 9 \w Y|strong="H3068"\w* \w esta|strong="H1961"\w* frontera \w baja|strong="H3381"\w* al \w arroyo|strong="H5158"\w* de Caná, por el sur del \w arroyo|strong="H5158"\w*. Estas \w ciudades|strong="H5892"\w* de Efraín \w están|strong="H1961"\w* \w entre|strong="H8432"\w* las \w ciudades|strong="H5892"\w* de \w Manasés|strong="H4519"\w*; y \w la|strong="H1366"\w* frontera de \w Manasés|strong="H4519"\w* \w está|strong="H1961"\w* al \w norte|strong="H6828"\w* del \w arroyo|strong="H5158"\w*, y termina \w en|strong="H8432"\w* el \w mar|strong="H3220"\w*.  
\v 10 El sur \w es|strong="H1961"\w* de Efraín, y el \w norte|strong="H6828"\w* de \w Manasés|strong="H4519"\w*, y el \w mar|strong="H3220"\w* \w es|strong="H1961"\w* su límite; y \w se|strong="H1961"\w* encuentran con Aser al \w norte|strong="H6828"\w*, y con Isacar al \w oriente|strong="H4217"\w*.  
\v 11 \w Manasés|strong="H4519"\w* también \w tuvo|strong="H1961"\w* en Isacar y en Aser \w a|strong="H3068"\w* Bet-seán y sus \w aldeas|strong="H1323"\w*, \w a|strong="H3068"\w* Ibleam y sus \w aldeas|strong="H1323"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de \w Dor|strong="H1756"\w* y sus \w aldeas|strong="H1323"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de En-dor y sus \w aldeas|strong="H1323"\w*, \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Taanac y sus \w aldeas|strong="H1323"\w*, y \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Meguido y sus \w aldeas|strong="H1323"\w*; \w tres|strong="H7969"\w* regiones.  
\v 12 Pero \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w* \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* expulsar \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H1121"\w* aquellas \w ciudades|strong="H5892"\w*; y \w el|strong="H1121"\w* \w cananeo|strong="H3669"\w* persistió en vivir en \w aquella|strong="H2063"\w* tierra.   
\p
\v 13 \w Sin|strong="H3808"\w* embargo, \w cuando|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w se|strong="H1961"\w* \w hicieron|strong="H5414"\w* \w más|strong="H3588"\w* \w fuertes|strong="H1121"\w*, sometieron al \w cananeo|strong="H3669"\w* \w a|strong="H3068"\w* trabajos forzados, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H1121"\w* expulsaron \w por|strong="H3588"\w* completo.  
\v 14 \w Y|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* \w José|strong="H3130"\w* le \w hablaron|strong="H1696"\w* \w a|strong="H3068"\w* \w Josué|strong="H3091"\w*, \w diciendo|strong="H1696"\w*: “¿\w Por|strong="H4069"\w* \w qué|strong="H5704"\w* nos \w has|strong="H5414"\w* \w dado|strong="H5414"\w* \w como|strong="H4069"\w* \w herencia|strong="H5159"\w* una sola porción \w y|strong="H5704"\w* una sola parte, siendo nosotros un \w pueblo|strong="H5971"\w* tan \w numeroso|strong="H7227"\w*, ya \w que|strong="H5704"\w* Yahvé nos \w ha|strong="H3541"\w* bendecido \w hasta|strong="H5704"\w* \w ahora|strong="H3541"\w*?”.   
\p
\v 15 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* les respondió: “\w Si|strong="H3588"\w* \w son|strong="H3588"\w* un \w pueblo|strong="H5971"\w* tan \w numeroso|strong="H7227"\w*, suban \w a|strong="H3068"\w* \w la|strong="H3588"\w* montaña, \w y|strong="H3588"\w* desmonten tierras \w para|strong="H3588"\w* ustedes \w allí|strong="H8033"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w los|strong="H3588"\w* ferezeos \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* refaítas, ya \w que|strong="H3588"\w* \w la|strong="H3588"\w* montaña \w de|strong="H3588"\w* Efraín les queda muy estrecha”.   
\p
\v 16 \w Y|strong="H3068"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w* dijeron: “\w Esta|strong="H3427"\w* montaña \w no|strong="H3808"\w* nos alcanza; y \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w cananeos|strong="H3669"\w* \w que|strong="H3808"\w* \w habitan|strong="H3427"\w* \w la|strong="H3605"\w* tierra \w de|strong="H1121"\w* \w la|strong="H3605"\w* llanura tienen \w carros|strong="H7393"\w* \w de|strong="H1121"\w* \w hierro|strong="H1270"\w*, tanto \w los|strong="H3427"\w* \w que|strong="H3808"\w* \w están|strong="H3427"\w* en Bet-seán y en sus \w aldeas|strong="H1323"\w*, como \w los|strong="H3427"\w* \w que|strong="H3808"\w* \w están|strong="H3427"\w* en \w el|strong="H3605"\w* \w valle|strong="H6010"\w* \w de|strong="H1121"\w* \w Jezreel|strong="H3157"\w*”.   
\p
\v 17 Entonces \w Josué|strong="H3091"\w* le respondió \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H5971"\w* \w José|strong="H3130"\w*, \w a|strong="H3068"\w* Efraín y \w a|strong="H3068"\w* \w Manasés|strong="H4519"\w*, diciendo: “Ustedes \w son|strong="H1961"\w* un \w pueblo|strong="H5971"\w* \w numeroso|strong="H7227"\w* y \w tienen|strong="H1961"\w* \w gran|strong="H1419"\w* \w poder|strong="H3581"\w*; \w no|strong="H3808"\w* \w tendrán|strong="H1961"\w* una sola porción,  
\v 18 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w aquella|strong="H1931"\w* montaña \w será|strong="H1961"\w* \w de|strong="H3588"\w* ustedes; \w y|strong="H3588"\w* \w aunque|strong="H3588"\w* \w sea|strong="H1961"\w* un \w bosque|strong="H3293"\w*, ustedes \w lo|strong="H1931"\w* talarán \w y|strong="H3588"\w* \w sus|strong="H1931"\w* límites \w serán|strong="H1961"\w* \w suyos|strong="H1931"\w*; \w porque|strong="H3588"\w* ustedes expulsarán al \w cananeo|strong="H3669"\w*, \w aunque|strong="H3588"\w* \w tenga|strong="H1961"\w* \w carros|strong="H7393"\w* \w de|strong="H3588"\w* \w hierro|strong="H1270"\w* \w y|strong="H3588"\w* \w aunque|strong="H3588"\w* \w sea|strong="H1961"\w* \w fuerte|strong="H2389"\w*”.   
\c 18  
\p
\v 1 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* congregación \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* se reunió en \w Silo|strong="H7887"\w*, y levantaron \w allí|strong="H8033"\w* \w la|strong="H3605"\w* Tienda \w de|strong="H6440"\w* reunión, después \w de|strong="H6440"\w* \w que|strong="H1121"\w* \w la|strong="H3605"\w* tierra les fue sometida.  
\v 2 Pero \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* habían quedado \w siete|strong="H7651"\w* \w tribus|strong="H7626"\w* \w a|strong="H3068"\w* las cuales \w aún|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* les había repartido su \w herencia|strong="H5159"\w*.  
\v 3 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* les dijo \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* serán perezosos \w para|strong="H5704"\w* ir \w a|strong="H3068"\w* tomar posesión \w de|strong="H5704"\w* la tierra \w que|strong="H5704"\w* les \w ha|strong="H3423"\w* \w dado|strong="H5414"\w* Yahvé \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H5704"\w* sus antepasados?  
\v 4 Elijan de entre ustedes \w a|strong="H3068"\w* \w tres|strong="H7969"\w* hombres de cada \w tribu|strong="H7626"\w*, para \w que|strong="H6310"\w* yo los \w envíe|strong="H7971"\w*, y \w que|strong="H6310"\w* ellos vayan, recorran la tierra, hagan un mapa de ella \w conforme|strong="H6310"\w* \w a|strong="H3068"\w* su \w herencia|strong="H5159"\w*, y regresen \w a|strong="H3068"\w* mí.  
\v 5 \w Y|strong="H3068"\w* \w la|strong="H5921"\w* dividirán \w en|strong="H5921"\w* \w siete|strong="H7651"\w* \w partes|strong="H2505"\w*; \w Judá|strong="H3063"\w* \w se|strong="H5921"\w* quedará \w en|strong="H5921"\w* su territorio \w al|strong="H5921"\w* sur, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w José|strong="H3130"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* suyo \w al|strong="H5921"\w* \w norte|strong="H6828"\w*.  
\v 6 Ustedes, pues, dividirán la tierra en \w siete|strong="H7651"\w* partes y me traerán el mapa \w aquí|strong="H6311"\w*, y yo echaré \w suertes|strong="H1486"\w* \w por|strong="H6440"\w* ustedes \w aquí|strong="H6311"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé nuestro \w Dios|strong="H3068"\w*.  
\v 7 \w Porque|strong="H3588"\w* \w los|strong="H3588"\w* \w levitas|strong="H3881"\w* \w no|strong="H3588"\w* tienen ninguna \w parte|strong="H2677"\w* \w entre|strong="H7130"\w* ustedes, ya \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w sacerdocio|strong="H3550"\w* \w de|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* \w su|strong="H3588"\w* \w herencia|strong="H5159"\w*; \w y|strong="H3588"\w* \w Gad|strong="H1410"\w*, \w Rubén|strong="H7205"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* media \w tribu|strong="H7626"\w* \w de|strong="H3588"\w* \w Manasés|strong="H4519"\w* ya \w recibieron|strong="H3947"\w* \w su|strong="H3588"\w* \w herencia|strong="H5159"\w* \w al|strong="H7130"\w* otro \w lado|strong="H5676"\w* \w del|strong="H2677"\w* \w Jordán|strong="H3383"\w*, \w al|strong="H7130"\w* \w oriente|strong="H4217"\w*, \w la|strong="H3588"\w* \w cual|strong="H3588"\w* les \w dio|strong="H5414"\w* \w Moisés|strong="H4872"\w* \w siervo|strong="H5650"\w* \w de|strong="H3588"\w* Yahvé”.   
\p
\v 8 Aquellos hombres se \w levantaron|strong="H6965"\w* y se \w fueron|strong="H3212"\w*; y \w Josué|strong="H3091"\w* \w les|strong="H6680"\w* \w mandó|strong="H6680"\w* \w a|strong="H3068"\w* los que \w iban|strong="H1980"\w* \w a|strong="H3068"\w* hacer el mapa \w de|strong="H6440"\w* la tierra, diciéndoles: “\w Vayan|strong="H3212"\w*, recorran la tierra, hagan un mapa \w de|strong="H6440"\w* ella, y regresen \w a|strong="H3068"\w* mí, para que \w yo|strong="H6680"\w* \w eche|strong="H7993"\w* \w suertes|strong="H1486"\w* \w por|strong="H6440"\w* ustedes \w aquí|strong="H6311"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w en|strong="H3212"\w* \w Silo|strong="H7887"\w*”.   
\p
\v 9 Así \w que|strong="H5921"\w* aquellos hombres \w fueron|strong="H3212"\w* \w y|strong="H5921"\w* recorrieron \w la|strong="H5921"\w* tierra, \w y|strong="H5921"\w* \w la|strong="H5921"\w* anotaron \w en|strong="H5921"\w* un \w libro|strong="H5612"\w*, dividiéndola \w por|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w en|strong="H5921"\w* \w siete|strong="H7651"\w* partes, \w y|strong="H5921"\w* regresaron \w a|strong="H3068"\w* \w Josué|strong="H3091"\w* \w al|strong="H5921"\w* \w campamento|strong="H4264"\w* \w en|strong="H5921"\w* \w Silo|strong="H7887"\w*.  
\v 10 \w Y|strong="H3068"\w* \w Josué|strong="H3091"\w* \w echó|strong="H7993"\w* \w suertes|strong="H1486"\w* \w por|strong="H6440"\w* ellos en \w Silo|strong="H7887"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé; y \w allí|strong="H8033"\w* \w Josué|strong="H3091"\w* \w repartió|strong="H2505"\w* la tierra \w entre|strong="H8033"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* según sus porciones.   
\p
\v 11 \w Y|strong="H3068"\w* le tocó \w en|strong="H3318"\w* \w suerte|strong="H1486"\w* \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* por sus \w familias|strong="H4940"\w*; y \w el|strong="H1121"\w* territorio \w que|strong="H1121"\w* les tocó quedó entre \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w* y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w José|strong="H3130"\w*.  
\v 12 Su frontera \w por|strong="H4480"\w* el \w lado|strong="H3802"\w* \w del|strong="H4480"\w* \w norte|strong="H6828"\w* comenzaba \w desde|strong="H4480"\w* el \w Jordán|strong="H3383"\w*; y \w la|strong="H1366"\w* frontera \w sube|strong="H5927"\w* \w por|strong="H4480"\w* el \w lado|strong="H3802"\w* \w de|strong="H4480"\w* \w Jericó|strong="H3405"\w* \w al|strong="H4480"\w* \w norte|strong="H6828"\w*; \w luego|strong="H5927"\w* \w sube|strong="H5927"\w* \w por|strong="H4480"\w* \w la|strong="H1366"\w* montaña \w hacia|strong="H4480"\w* el occidente, y \w viene|strong="H5927"\w* \w a|strong="H3068"\w* \w salir|strong="H8444"\w* \w al|strong="H4480"\w* \w desierto|strong="H4057"\w* \w de|strong="H4480"\w* Bet-aven.  
\v 13 \w De|strong="H5921"\w* \w allí|strong="H8033"\w* \w la|strong="H1931"\w* frontera \w pasa|strong="H5674"\w* \w a|strong="H3068"\w* \w Luz|strong="H3870"\w*, \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w lado|strong="H3802"\w* sur \w de|strong="H5921"\w* \w Luz|strong="H3870"\w* (\w que|strong="H1931"\w* \w es|strong="H1931"\w* Bet-el), \w y|strong="H5921"\w* \w baja|strong="H3381"\w* \w de|strong="H5921"\w* Atarot-adar \w al|strong="H5921"\w* \w monte|strong="H2022"\w* \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w al|strong="H5921"\w* sur \w de|strong="H5921"\w* Bet-horón \w de|strong="H5921"\w* abajo.  
\v 14 \w Y|strong="H3068"\w* \w la|strong="H1931"\w* frontera da \w la|strong="H1931"\w* \w vuelta|strong="H5437"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w lado|strong="H6285"\w* \w occidental|strong="H3220"\w* \w hacia|strong="H5921"\w* \w el|strong="H1931"\w* sur, \w desde|strong="H4480"\w* \w el|strong="H1931"\w* \w monte|strong="H2022"\w* \w que|strong="H4480"\w* \w está|strong="H2063"\w* frente \w a|strong="H3068"\w* Bet-horón \w al|strong="H5921"\w* sur; \w y|strong="H5921"\w* viene \w a|strong="H3068"\w* \w salir|strong="H8444"\w* \w a|strong="H3068"\w* Quiriat-baal (\w que|strong="H4480"\w* \w es|strong="H1931"\w* Quiriat-jearim), \w ciudad|strong="H5892"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*. \w Este|strong="H1931"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w lado|strong="H6285"\w* \w occidental|strong="H3220"\w*.  
\v 15 El \w lado|strong="H6285"\w* sur comienza desde el \w extremo|strong="H7097"\w* \w de|strong="H4325"\w* Quiriat-jearim, y \w la|strong="H1366"\w* frontera \w sale|strong="H3318"\w* \w hacia|strong="H5045"\w* el occidente hasta el manantial \w de|strong="H4325"\w* las \w aguas|strong="H4325"\w* \w de|strong="H4325"\w* Neftoa;  
\v 16 \w y|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w baja|strong="H3381"\w* \w al|strong="H5921"\w* \w extremo|strong="H7097"\w* \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* frente \w al|strong="H5921"\w* \w valle|strong="H1516"\w* \w del|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Hinom, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w al|strong="H5921"\w* \w norte|strong="H6828"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w valle|strong="H1516"\w* \w de|strong="H5921"\w* Refaim; luego \w baja|strong="H3381"\w* \w al|strong="H5921"\w* \w valle|strong="H1516"\w* \w de|strong="H5921"\w* Hinom, \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w lado|strong="H3802"\w* sur \w del|strong="H5921"\w* \w jebuseo|strong="H2983"\w*, \w y|strong="H5921"\w* \w de|strong="H5921"\w* allí \w baja|strong="H3381"\w* \w a|strong="H3068"\w* En-rogel.  
\v 17 \w Luego|strong="H3318"\w* gira hacia \w el|strong="H1121"\w* \w norte|strong="H6828"\w* y \w sale|strong="H3318"\w* \w a|strong="H3068"\w* En-semes, y \w de|strong="H1121"\w* allí \w sale|strong="H3318"\w* \w a|strong="H3068"\w* Gelilot, \w que|strong="H1121"\w* está frente \w a|strong="H3068"\w* la subida \w de|strong="H1121"\w* Adumín, y \w baja|strong="H3381"\w* \w a|strong="H3068"\w* la piedra \w de|strong="H1121"\w* Bohán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Rubén|strong="H7205"\w*;  
\v 18 y \w pasa|strong="H5674"\w* por un \w lado|strong="H3802"\w* de la llanura frente al Arabá, y \w baja|strong="H3381"\w* al Arabá.  
\v 19 \w Y|strong="H3068"\w* \w la|strong="H1366"\w* frontera \w pasa|strong="H5674"\w* al \w norte|strong="H6828"\w* \w por|strong="H2088"\w* un \w lado|strong="H3802"\w* de Bet-hogla, y termina en \w la|strong="H1366"\w* bahía \w norte|strong="H6828"\w* del \w Mar|strong="H3220"\w* \w Salado|strong="H4417"\w*, en \w el|strong="H5674"\w* \w extremo|strong="H7097"\w* sur del \w Jordán|strong="H3383"\w*. \w Esta|strong="H2088"\w* \w es|strong="H1961"\w* \w la|strong="H1366"\w* frontera sur.  
\v 20 \w Y|strong="H3068"\w* \w el|strong="H1121"\w* \w Jordán|strong="H3383"\w* \w era|strong="H1121"\w* su límite por \w el|strong="H1121"\w* \w lado|strong="H6285"\w* del \w oriente|strong="H6924"\w*. \w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H2063"\w* \w herencia|strong="H5159"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* con sus fronteras \w alrededor|strong="H5439"\w*, conforme \w a|strong="H3068"\w* sus \w familias|strong="H4940"\w*.  
