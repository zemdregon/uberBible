\v 17 \w Y|strong="H3068"\w* los hombres le dijeron: “Nosotros quedaremos \w libres|strong="H5355"\w* de \w este|strong="H2088"\w* \w juramento|strong="H7621"\w* \w que|strong="H2088"\w* nos has hecho hacer,  
\v 18 \w si|strong="H2009"\w* cuando entremos en \w la|strong="H3605"\w* tierra no amarras \w este|strong="H2088"\w* cordón rojo \w a|strong="H3068"\w* \w la|strong="H3605"\w* ventana \w por|strong="H2088"\w* \w la|strong="H3605"\w* cual nos hiciste bajar; y no reúnes en tu \w casa|strong="H1004"\w* \w a|strong="H3068"\w* tu padre y \w a|strong="H3068"\w* tu madre, \w a|strong="H3068"\w* tus hermanos y \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* de tu padre.  
\v 19 \w Cualquiera|strong="H3605"\w* \w que|strong="H1961"\w* \w salga|strong="H3318"\w* \w fuera|strong="H2351"\w* \w de|strong="H1818"\w* las \w puertas|strong="H1817"\w* \w de|strong="H1818"\w* tu \w casa|strong="H1004"\w*, su \w sangre|strong="H1818"\w* caerá \w sobre|strong="H1961"\w* su propia \w cabeza|strong="H7218"\w*, \w y|strong="H5355"\w* \w nosotros|strong="H3605"\w* \w seremos|strong="H1961"\w* sin culpa. Pero \w cualquiera|strong="H3605"\w* \w que|strong="H1961"\w* \w esté|strong="H1961"\w* \w en|strong="H3318"\w* \w casa|strong="H1004"\w* contigo, su \w sangre|strong="H1818"\w* caerá \w sobre|strong="H1961"\w* nuestra \w cabeza|strong="H7218"\w*, \w si|strong="H1961"\w* alguien le pone \w la|strong="H3605"\w* \w mano|strong="H3027"\w* \w encima|strong="H7218"\w*.  
