\v 20 \w Si|strong="H3588"\w* dejan \w a|strong="H3068"\w* Yahvé \w y|strong="H3588"\w* \w sirven|strong="H5647"\w* \w a|strong="H3068"\w* dioses \w ajenos|strong="H5236"\w*, \w él|strong="H3588"\w* se \w volverá|strong="H7725"\w* \w y|strong="H3588"\w* les \w hará|strong="H3190"\w* \w mal|strong="H7489"\w*, \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w consumirá|strong="H3615"\w*, después \w de|strong="H3588"\w* \w que|strong="H3588"\w* les ha hecho \w bien|strong="H3190"\w*”.   
\p
