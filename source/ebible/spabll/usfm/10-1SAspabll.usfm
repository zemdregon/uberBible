\v 23 Mientras \w hablaba|strong="H1696"\w* \w con|strong="H5973"\w* \w ellos|strong="H1931"\w*, \w aquel|strong="H1931"\w* guerrero \w filisteo|strong="H6430"\w* \w llamado|strong="H8034"\w* Goliat \w salió|strong="H5927"\w* \w de|strong="H5973"\w* \w entre|strong="H5973"\w* \w sus|strong="H1931"\w* filas y lanzó \w el|strong="H1931"\w* \w mismo|strong="H1931"\w* desafío \w de|strong="H5973"\w* siempre, y \w David|strong="H1732"\w* \w lo|strong="H1931"\w* \w oyó|strong="H8085"\w*.  
\v 24 En cuanto \w los|strong="H3605"\w* israelitas \w vieron|strong="H7200"\w* \w a|strong="H3068"\w* \w aquel|strong="H3605"\w* hombre, \w huyeron|strong="H5127"\w* \w de|strong="H6440"\w* \w él|strong="H3605"\w* llenos \w de|strong="H6440"\w* terror.  
\v 25 Algunos decían: “¿\w Ya|strong="H3068"\w* \w vieron|strong="H7200"\w* \w a|strong="H3068"\w* \w ese|strong="H2088"\w* hombre? \w Viene|strong="H5927"\w* \w a|strong="H3068"\w* desafiar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*. \w A|strong="H3068"\w* \w quien|strong="H6213"\w* \w lo|strong="H2088"\w* mate, \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w lo|strong="H2088"\w* \w hará|strong="H6213"\w* muy \w rico|strong="H1419"\w*, le \w dará|strong="H5414"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hija|strong="H1323"\w* \w como|strong="H3588"\w* esposa \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w familia|strong="H1004"\w* \w no|strong="H6213"\w* \w tendrá|strong="H1961"\w* \w que|strong="H3588"\w* pagar impuestos \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*”.   
