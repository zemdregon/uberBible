\mt2 Primer libro de  
\mt1 Samuel  
\c 1  
\p
\v 1 \w Había|strong="H1961"\w* un \w hombre|strong="H1121"\w* \w llamado|strong="H8034"\w* Elcana, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Jerojam, descendiente \w de|strong="H4480"\w* Eliú, Tohu y Zuf. \w Era|strong="H1961"\w* un efrateo \w que|strong="H4480"\w* vivía \w en|strong="H4480"\w* Ramataim \w de|strong="H4480"\w* Zofim, \w en|strong="H4480"\w* la región montañosa \w de|strong="H4480"\w* Efraín.  
\v 2 Elcana \w tenía|strong="H1961"\w* \w dos|strong="H8147"\w* esposas: una \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Ana y la \w otra|strong="H8145"\w* Penina. Penina \w tenía|strong="H1961"\w* \w hijos|strong="H3206"\w*, pero Ana \w no|strong="H1961"\w* podía tenerlos.  
\v 3 \w Cada|strong="H3117"\w* \w año|strong="H8147"\w*, \w este|strong="H1931"\w* \w hombre|strong="H1121"\w* \w subía|strong="H5927"\w* desde \w su|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w a|strong="H3068"\w* \w Silo|strong="H7887"\w* para adorar y ofrecer \w sacrificios|strong="H2076"\w* \w a|strong="H3068"\w* Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*. \w Allí|strong="H8033"\w*, \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Elí|strong="H5941"\w*, Ofni y Finees, servían \w como|strong="H1931"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H1121"\w* Yahvé.  
\v 4 \w El|strong="H3605"\w* \w día|strong="H3117"\w* \w que|strong="H3117"\w* Elcana \w ofrecía|strong="H2076"\w* su sacrificio, solía \w dar|strong="H5414"\w* \w porciones|strong="H4490"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* carne \w a|strong="H3068"\w* su esposa Penina y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 5 \w Pero|strong="H3588"\w* \w a|strong="H3068"\w* Ana le \w daba|strong="H5414"\w* una \w porción|strong="H4490"\w* doble \w porque|strong="H3588"\w* \w la|strong="H3588"\w* amaba mucho, \w a|strong="H3068"\w* pesar \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w no|strong="H3588"\w* le \w había|strong="H3588"\w* permitido tener hijos.  
\v 6 \w Su|strong="H3588"\w* rival, Penina, \w la|strong="H1571"\w* molestaba constantemente \w para|strong="H3588"\w* irritarla \w y|strong="H1571"\w* humillarla, \w porque|strong="H3588"\w* Yahvé \w la|strong="H1571"\w* \w había|strong="H3588"\w* hecho estéril.  
\v 7 \w Esto|strong="H3651"\w* sucedía \w año|strong="H8141"\w* tras \w año|strong="H8141"\w*; \w cada|strong="H8141"\w* vez \w que|strong="H3808"\w* \w subían|strong="H5927"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de Yahvé, Penina la provocaba \w tanto|strong="H3651"\w* \w que|strong="H3808"\w* Ana \w se|strong="H3808"\w* ponía \w a|strong="H3068"\w* llorar y \w no|strong="H3808"\w* quería comer.  
\v 8 Su esposo Elcana le decía: “Ana, ¿\w por|strong="H4100"\w* \w qué|strong="H4100"\w* \w lloras|strong="H1058"\w*? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* comes? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* estás tan triste? ¿Acaso \w no|strong="H3808"\w* valgo yo para ti \w más|strong="H1058"\w* \w que|strong="H4100"\w* \w diez|strong="H6235"\w* \w hijos|strong="H1121"\w*?   
\p
\v 9 \w En|strong="H5921"\w* una ocasión \w en|strong="H5921"\w* \w Silo|strong="H7887"\w*, \w después|strong="H5921"\w* \w de|strong="H5921"\w* comer \w y|strong="H5921"\w* \w beber|strong="H8354"\w*, Ana \w se|strong="H5921"\w* \w levantó|strong="H6965"\w*. \w El|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Elí|strong="H5941"\w* \w estaba|strong="H3427"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* su silla, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* puerta \w del|strong="H5921"\w* \w templo|strong="H1964"\w* \w de|strong="H5921"\w* Yahvé.  
\v 10 Ana, \w con|strong="H5921"\w* mucha \w amargura|strong="H4751"\w* \w en|strong="H5921"\w* \w su|strong="H1931"\w* \w alma|strong="H5315"\w*, \w lloraba|strong="H1058"\w* desconsoladamente mientras oraba \w a|strong="H3068"\w* Yahvé.  
\v 11 \w Entonces|strong="H3117"\w* \w hizo|strong="H5088"\w* una \w promesa|strong="H5087"\w* diciendo: “Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w si|strong="H3808"\w* \w te|strong="H5921"\w* fijas \w en|strong="H5921"\w* \w la|strong="H5921"\w* angustia \w de|strong="H5921"\w* \w esta|strong="H5921"\w* sierva tuya \w y|strong="H5921"\w* \w te|strong="H5921"\w* acuerdas \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* olvidas \w de|strong="H5921"\w* tu sierva \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w das|strong="H5414"\w* un hijo varón, yo \w lo|strong="H3808"\w* \w entregaré|strong="H5414"\w* \w a|strong="H3068"\w* Yahvé \w por|strong="H5921"\w* \w el|strong="H5921"\w* resto \w de|strong="H5921"\w* su \w vida|strong="H2416"\w*, \w y|strong="H5921"\w* \w nunca|strong="H3808"\w* \w se|strong="H5921"\w* cortará \w el|strong="H5921"\w* cabello   
\p
\v 12 \w Mientras|strong="H3588"\w* ella \w seguía|strong="H1961"\w* orando \w ante|strong="H6440"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w*, \w Elí|strong="H5941"\w* \w se|strong="H1961"\w* fijó \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w boca|strong="H6310"\w*.  
\v 13 \w Como|strong="H5921"\w* Ana oraba \w en|strong="H5921"\w* silencio, \w solo|strong="H1931"\w* \w se|strong="H1931"\w* movían \w sus|strong="H1931"\w* \w labios|strong="H8193"\w*; \w no|strong="H3808"\w* \w se|strong="H1931"\w* \w escuchaba|strong="H8085"\w* \w su|strong="H1931"\w* \w voz|strong="H6963"\w*. \w Por|strong="H5921"\w* \w eso|strong="H1931"\w* \w Elí|strong="H5941"\w* pensó \w que|strong="H1931"\w* estaba borracha.  
\v 14 \w Y|strong="H3068"\w* \w le|strong="H5921"\w* dijo: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* \w te|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* durar \w la|strong="H5921"\w* borrachera? ¡\w Ya|strong="H3068"\w* deja \w el|strong="H5921"\w* \w vino|strong="H3196"\w*!   
\p
\v 15 Ana le \w respondió|strong="H6030"\w*: “\w No|strong="H3808"\w*, \w señor|strong="H3068"\w* mío; \w no|strong="H3808"\w* estoy borracha. Soy una mujer \w que|strong="H3808"\w* está sufriendo mucho. \w No|strong="H3808"\w* he \w bebido|strong="H8354"\w* \w vino|strong="H3196"\w* \w ni|strong="H3808"\w* licor, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* estaba desahogando \w mi|strong="H6030"\w* \w alma|strong="H5315"\w* \w ante|strong="H6440"\w* Yahvé.  
\v 16 \w No|strong="H3588"\w* \w me|strong="H3588"\w* confunda \w con|strong="H3588"\w* una mujer mala; he estado orando \w así|strong="H3588"\w* \w por|strong="H3588"\w* mi gran angustia \w y|strong="H3588"\w* dolor   
\p
\v 17 Entonces \w Elí|strong="H5941"\w* \w le|strong="H5973"\w* contestó: “\w Vete|strong="H3212"\w* \w en|strong="H5973"\w* \w paz|strong="H7965"\w*, y que \w el|strong="H5973"\w* Dios \w de|strong="H5973"\w* \w Israel|strong="H3478"\w* \w te|strong="H5973"\w* conceda lo que \w le|strong="H5973"\w* \w has|strong="H5414"\w* pedido”.   
\p
\v 18 Ella respondió: “Espero contar siempre con su favor”. Luego Ana \w se|strong="H1961"\w* \w fue|strong="H1961"\w*, comió algo y su \w rostro|strong="H6440"\w* ya \w no|strong="H3808"\w* \w estaba|strong="H1961"\w* triste.   
\p
\v 19 Al día siguiente, \w se|strong="H3045"\w* levantaron temprano para adorar \w a|strong="H3068"\w* Yahvé y \w luego|strong="H7725"\w* regresaron \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* en \w Ramá|strong="H7414"\w*. Elcana \w se|strong="H3045"\w* unió \w a|strong="H3068"\w* su esposa Ana, y el \w Señor|strong="H3068"\w* \w se|strong="H3045"\w* acordó \w de|strong="H6440"\w* su petición.   
\p
\v 20 Pasado \w el|strong="H3588"\w* \w tiempo|strong="H3117"\w*, Ana \w concibió|strong="H2029"\w* \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, \w y|strong="H3588"\w* le \w puso|strong="H3205"\w* \w por|strong="H3588"\w* \w nombre|strong="H8034"\w* \w Samuel|strong="H8050"\w*, \w porque|strong="H3588"\w* dijo: “\w Se|strong="H1961"\w* lo \w pedí|strong="H7592"\w* \w a|strong="H3068"\w* Yahvé”.   
\p
\v 21 \w Cuando|strong="H3117"\w* Elcana \w subió|strong="H5927"\w* de nuevo con \w toda|strong="H3605"\w* su \w familia|strong="H1004"\w* para ofrecer \w a|strong="H3068"\w* Yahvé \w el|strong="H3605"\w* \w sacrificio|strong="H2077"\w* anual y cumplir su promesa,  
\v 22 Ana decidió \w no|strong="H3808"\w* ir. Le dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposo: “\w No|strong="H3808"\w* \w iré|strong="H5927"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w niño|strong="H5288"\w* deje \w de|strong="H3588"\w* amamantar. \w Entonces|strong="H3588"\w* \w lo|strong="H3808"\w* llevaré \w para|strong="H5704"\w* presentarlo \w ante|strong="H6440"\w* Yahvé, \w y|strong="H3588"\w* \w se|strong="H3808"\w* quedará \w allá|strong="H8033"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*”.   
\p
\v 23 Elcana \w le|strong="H5869"\w* respondió: “\w Haz|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H5704"\w* \w te|strong="H5869"\w* parezca \w mejor|strong="H2896"\w*. \w Quédate|strong="H3427"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w lo|strong="H1697"\w* destetes; \w y|strong="H5704"\w* \w que|strong="H5704"\w* Yahvé \w cumpla|strong="H6965"\w* su \w palabra|strong="H1697"\w*”. Así \w que|strong="H5704"\w* ella se \w quedó|strong="H3427"\w* \w en|strong="H5704"\w* casa \w y|strong="H5704"\w* crió \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w lo|strong="H1697"\w* destetó.   
\p
\v 24 \w En|strong="H5973"\w* cuanto lo destetó, lo llevó \w con|strong="H5973"\w* ella \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H5973"\w* Yahvé \w en|strong="H5973"\w* \w Silo|strong="H7887"\w*, \w a|strong="H3068"\w* pesar \w de|strong="H5973"\w* que \w el|strong="H5973"\w* \w niño|strong="H5288"\w* era muy pequeño. Llevó también \w tres|strong="H7969"\w* \w toros|strong="H6499"\w*, veinte kilos \w de|strong="H5973"\w* \w harina|strong="H7058"\w* y un frasco \w de|strong="H5973"\w* \w vino|strong="H3196"\w*.  
\v 25 Después de sacrificar el \w toro|strong="H6499"\w*, llevaron al \w niño|strong="H5288"\w* ante \w Elí|strong="H5941"\w*.  
\v 26 Ella \w le|strong="H5973"\w* dijo: “¡Perdone, \w señor|strong="H3068"\w* mío! Tan cierto \w como|strong="H5973"\w* \w que|strong="H2088"\w* usted \w vive|strong="H2416"\w*, \w yo|strong="H5315"\w* soy la mujer \w que|strong="H2088"\w* estuvo \w aquí|strong="H2088"\w* \w a|strong="H3068"\w* su lado orando \w a|strong="H3068"\w* Yahvé.  
\v 27 \w Le|strong="H5973"\w* \w pedí|strong="H7592"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w* \w este|strong="H2088"\w* \w niño|strong="H5288"\w*, y \w él|strong="H5973"\w* \w me|strong="H5973"\w* concedió \w lo|strong="H2088"\w* \w que|strong="H2088"\w* \w le|strong="H5973"\w* \w pedí|strong="H7592"\w*.  
\v 28 Por \w eso|strong="H1931"\w*, \w ahora|strong="H3117"\w* yo \w lo|strong="H1931"\w* entrego \w a|strong="H3068"\w* Yahvé. \w Mientras|strong="H3605"\w* viva, \w él|strong="H1931"\w* pertenecerá \w a|strong="H3068"\w* Yahvé”. \w Y|strong="H3068"\w* \w allí|strong="H8033"\w* \w adoraron|strong="H7812"\w* \w a|strong="H3068"\w* Yahvé.   
\c 2  
\p
\v 1 Ana elevó \w esta|strong="H5921"\w* oración:  
\q1 “¡\w Mi|strong="H5921"\w* \w corazón|strong="H3820"\w* \w se|strong="H5921"\w* \w alegra|strong="H8055"\w* \w en|strong="H5921"\w* Yahvé!  
\q2 \w Mi|strong="H5921"\w* poder \w se|strong="H5921"\w* exalta \w en|strong="H5921"\w* Yahvé.  
\q1 Ahora puedo burlarme \w de|strong="H5921"\w* mis enemigos,  
\q2 \w porque|strong="H3588"\w* \w me|strong="H5921"\w* regocijo \w en|strong="H5921"\w* tu salvación.   
\q1
\v 2 \w No|strong="H3588"\w* hay nadie tan \w santo|strong="H6918"\w* \w como|strong="H3588"\w* Yahvé;  
\q2 \w no|strong="H3588"\w* hay nadie fuera \w de|strong="H3588"\w* ti,  
\q2 \w ni|strong="H1115"\w* hay \w roca|strong="H6697"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* nuestro.   
\b  
\q1
\v 3 \w No|strong="H3808"\w* sigan \w hablando|strong="H1696"\w* \w con|strong="H3588"\w* \w tanto|strong="H7235"\w* orgullo;  
\q2 \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w salga|strong="H3318"\w* \w la|strong="H3588"\w* arrogancia \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w boca|strong="H6310"\w*;  
\q2 \w porque|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* un \w Dios|strong="H3068"\w* \w que|strong="H3588"\w* todo \w lo|strong="H3808"\w* sabe,  
\q2 \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w es|strong="H3588"\w* quien juzga las acciones.   
\b  
\q1
\v 4 Los \w arcos|strong="H7198"\w* de los \w poderosos|strong="H1368"\w* se quebraron,  
\q2 y los que tropezaban recobraron sus fuerzas.   
\q1
\v 5 \w Los|strong="H1121"\w* \w que|strong="H5704"\w* estaban saciados ahora trabajan \w por|strong="H5704"\w* \w pan|strong="H3899"\w*,  
\q2 \w y|strong="H5704"\w* \w los|strong="H1121"\w* \w que|strong="H5704"\w* tenían hambre ya \w no|strong="H2308"\w* la sufren.  
\q1 \w Hasta|strong="H5704"\w* la mujer estéril ha dado \w a|strong="H3068"\w* luz \w siete|strong="H7651"\w* \w veces|strong="H7651"\w*,  
\q2 \w y|strong="H5704"\w* la \w que|strong="H5704"\w* tenía \w muchos|strong="H7227"\w* \w hijos|strong="H1121"\w* se ha quedado marchita.   
\b  
\q1
\v 6 Yahvé quita la \w vida|strong="H2421"\w* y la da;  
\q2 él nos hace bajar al lugar de los \w muertos|strong="H4191"\w* y nos hace \w subir|strong="H5927"\w*.   
\q1
\v 7 Yahvé nos \w empobrece|strong="H3423"\w* y nos \w enriquece|strong="H6238"\w*;  
\q2 él nos \w humilla|strong="H8213"\w* y también nos enaltece.   
\q1
\v 8 \w Él|strong="H5921"\w* \w levanta|strong="H7311"\w* \w del|strong="H5921"\w* \w polvo|strong="H6083"\w* \w al|strong="H5921"\w* \w pobre|strong="H1800"\w*,  
\q2 \w y|strong="H3588"\w* \w del|strong="H5921"\w* basurero \w alza|strong="H7311"\w* \w al|strong="H5921"\w* necesitado,  
\q2 \w para|strong="H5921"\w* sentarlos \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* gobernantes  
\q2 \w y|strong="H3588"\w* darles un \w trono|strong="H3678"\w* \w de|strong="H5921"\w* honor.  
\q1 \w Porque|strong="H3588"\w* \w de|strong="H5921"\w* Yahvé \w son|strong="H3588"\w* \w las|strong="H5921"\w* columnas \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tierra|strong="H6083"\w*,  
\q2 \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w ellas|strong="H5921"\w* asentó \w el|strong="H5921"\w* \w mundo|strong="H8398"\w*.   
\q1
\v 9 \w Él|strong="H3588"\w* cuidará \w los|strong="H3588"\w* pasos \w de|strong="H3588"\w* sus fieles,  
\q2 \w pero|strong="H3588"\w* \w los|strong="H3588"\w* malvados perecerán \w en|strong="H3588"\w* las \w tinieblas|strong="H2822"\w*;  
\q2 \w porque|strong="H3588"\w* \w nadie|strong="H3808"\w* triunfa \w por|strong="H3588"\w* \w su|strong="H3588"\w* propia \w fuerza|strong="H3581"\w*.   
\q1
\v 10 \w Los|strong="H5921"\w* \w que|strong="H5921"\w* luchan \w contra|strong="H5921"\w* Yahvé \w serán|strong="H5181"\w* destrozados;  
\q2 \w desde|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w él|strong="H5921"\w* \w tronará|strong="H7481"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\b  
\q1 Yahvé \w juzgará|strong="H1777"\w* \w los|strong="H5921"\w* confines \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra,  
\q2 \w dará|strong="H5414"\w* poder \w a|strong="H3068"\w* su \w Rey|strong="H4428"\w*  
\q2 \w y|strong="H5921"\w* exaltará \w la|strong="H5921"\w* fuerza \w de|strong="H5921"\w* su \w Ungido|strong="H4899"\w*”.   
\p
\v 11 Elcana regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* \w en|strong="H5921"\w* \w Ramá|strong="H7414"\w*, pero \w el|strong="H5921"\w* \w niño|strong="H5288"\w* Samuel \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* \w para|strong="H5921"\w* servir \w a|strong="H3068"\w* Yahvé bajo \w la|strong="H5921"\w* dirección \w del|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Elí|strong="H5941"\w*.   
\p
\v 12 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Elí|strong="H5941"\w* \w eran|strong="H3808"\w* unos \w hombres|strong="H1121"\w* \w perversos|strong="H1121"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* tenían respeto por Yahvé.  
\v 13 \w La|strong="H3605"\w* \w costumbre|strong="H4941"\w* \w de|strong="H5971"\w* \w estos|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* era \w que|strong="H5971"\w*, cuando alguien \w ofrecía|strong="H2076"\w* un \w sacrificio|strong="H2077"\w*, \w mientras|strong="H3605"\w* \w se|strong="H5971"\w* cocía \w la|strong="H3605"\w* \w carne|strong="H1320"\w*, venía \w el|strong="H3605"\w* \w criado|strong="H5288"\w* del \w sacerdote|strong="H3548"\w* con un tenedor \w de|strong="H5971"\w* \w tres|strong="H7969"\w* puntas en \w la|strong="H3605"\w* \w mano|strong="H3027"\w*,  
\v 14 y \w lo|strong="H6213"\w* clavaba \w en|strong="H5221"\w* \w la|strong="H3605"\w* olla, \w en|strong="H5221"\w* \w el|strong="H3605"\w* caldero \w o|strong="H3068"\w* \w en|strong="H5221"\w* \w la|strong="H3605"\w* marmita; y \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w sacaba|strong="H5927"\w* \w el|strong="H3605"\w* tenedor, \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* \w lo|strong="H6213"\w* \w tomaba|strong="H3947"\w* para sí. \w Así|strong="H3602"\w* \w hacían|strong="H6213"\w* con \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas \w que|strong="H3605"\w* iban \w a|strong="H3068"\w* \w Silo|strong="H7887"\w*.  
\v 15 Incluso \w antes|strong="H3588"\w* \w de|strong="H4480"\w* quemar \w la|strong="H1571"\w* grasa, llegaba \w el|strong="H3588"\w* \w criado|strong="H5288"\w* \w del|strong="H4480"\w* \w sacerdote|strong="H3548"\w* \w y|strong="H1571"\w* le decía \w al|strong="H4480"\w* \w que|strong="H3588"\w* \w estaba|strong="H2416"\w* \w sacrificando|strong="H2076"\w*: “\w Dame|strong="H5414"\w* \w carne|strong="H1320"\w* \w para|strong="H3588"\w* asársela \w al|strong="H4480"\w* \w sacerdote|strong="H3548"\w*; \w él|strong="H3588"\w* \w no|strong="H3808"\w* quiere \w carne|strong="H1320"\w* \w cocida|strong="H1310"\w*, \w sino|strong="H3588"\w* cruda”.   
\p
\v 16 \w Si|strong="H3588"\w* \w el|strong="H3588"\w* hombre le decía: “Deja primero \w que|strong="H3588"\w* \w se|strong="H3808"\w* queme \w la|strong="H3588"\w* grasa, \w y|strong="H3588"\w* \w luego|strong="H6258"\w* \w toma|strong="H3947"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* quieras”, \w el|strong="H3588"\w* criado respondía: “\w No|strong="H3808"\w*, \w dámela|strong="H5414"\w* \w ahora|strong="H6258"\w* mismo; \w si|strong="H3588"\w* \w no|strong="H3808"\w*, \w me|strong="H3588"\w* \w la|strong="H3588"\w* llevaré \w por|strong="H3588"\w* \w la|strong="H3588"\w* fuerza”.  
\v 17 \w El|strong="H3588"\w* \w pecado|strong="H2403"\w* \w de|strong="H3588"\w* estos jóvenes \w era|strong="H1961"\w* \w muy|strong="H3966"\w* \w grave|strong="H1419"\w* \w ante|strong="H6440"\w* \w los|strong="H1961"\w* ojos \w de|strong="H3588"\w* Yahvé, \w porque|strong="H3588"\w* trataban \w con|strong="H3588"\w* desprecio las ofrendas \w que|strong="H3588"\w* \w se|strong="H1961"\w* le presentaban.  
\v 18 Mientras tanto, el joven \w Samuel|strong="H8050"\w* \w servía|strong="H8334"\w* \w ante|strong="H6440"\w* Yahvé, \w vestido|strong="H2296"\w* con un efod \w de|strong="H6440"\w* lino.  
\v 19 \w Cada|strong="H3117"\w* año su madre le \w hacía|strong="H6213"\w* una túnica \w pequeña|strong="H6996"\w* y se la llevaba \w cuando|strong="H3117"\w* \w subía|strong="H5927"\w* con su esposo para ofrecer \w el|strong="H6213"\w* \w sacrificio|strong="H2077"\w* anual.  
\v 20 \w Elí|strong="H5941"\w* bendecía \w a|strong="H3068"\w* Elcana y \w a|strong="H3068"\w* su esposa, diciendo: “\w Que|strong="H4480"\w* Yahvé \w te|strong="H4480"\w* \w dé|strong="H4480"\w* \w hijos|strong="H2233"\w* \w de|strong="H4480"\w* \w esta|strong="H2063"\w* mujer \w en|strong="H4480"\w* \w lugar|strong="H4725"\w* \w del|strong="H4480"\w* \w que|strong="H4480"\w* \w ella|strong="H4480"\w* dedicó \w a|strong="H3068"\w* Yahvé”. Después \w de|strong="H4480"\w* \w esto|strong="H2063"\w*, \w ellos|strong="H4480"\w* regresaban \w a|strong="H3068"\w* su casa.  
\v 21 Yahvé bendijo \w a|strong="H3068"\w* Ana, \w y|strong="H3588"\w* ella \w concibió|strong="H2029"\w* \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w*. \w Mientras|strong="H3588"\w* tanto, \w el|strong="H5973"\w* joven \w Samuel|strong="H8050"\w* \w crecía|strong="H1431"\w* \w en|strong="H5973"\w* \w la|strong="H3588"\w* presencia \w de|strong="H3588"\w* Yahvé.   
\p
\v 22 \w Elí|strong="H5941"\w* ya \w era|strong="H1121"\w* \w muy|strong="H3966"\w* anciano, y se enteraba \w de|strong="H1121"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H1121"\w* sus \w hijos|strong="H1121"\w* le \w hacían|strong="H6213"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, y \w de|strong="H1121"\w* cómo se acostaban con las mujeres \w que|strong="H1121"\w* servían \w a|strong="H3068"\w* \w la|strong="H3605"\w* entrada \w de|strong="H1121"\w* \w la|strong="H3605"\w* Tienda \w de|strong="H1121"\w* Reunión.  
\v 23 \w Por|strong="H1697"\w* eso les dijo: “¿\w Por|strong="H1697"\w* \w qué|strong="H4100"\w* \w hacen|strong="H6213"\w* \w estas|strong="H6213"\w* \w cosas|strong="H1697"\w*? \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* me \w habla|strong="H1697"\w* \w de|strong="H5971"\w* su \w mal|strong="H7451"\w* comportamiento.  
\v 24 \w No|strong="H3808"\w*, \w hijos|strong="H1121"\w* míos; \w no|strong="H3808"\w* \w es|strong="H3588"\w* \w bueno|strong="H2896"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w escucho|strong="H8085"\w* \w decir|strong="H8085"\w* al \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* Yahvé.  
\v 25 \w Si|strong="H3588"\w* alguien \w peca|strong="H2398"\w* contra otra persona, \w Dios|strong="H3068"\w* puede interceder \w por|strong="H3588"\w* \w él|strong="H3588"\w*; \w pero|strong="H3588"\w* \w si|strong="H3588"\w* alguien \w peca|strong="H2398"\w* contra Yahvé, ¿\w quién|strong="H4310"\w* \w podrá|strong="H3808"\w* defenderlo?”. \w Pero|strong="H3588"\w* ellos \w no|strong="H3808"\w* \w escucharon|strong="H8085"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre, \w porque|strong="H3588"\w* Yahvé ya \w había|strong="H3588"\w* decidido quitarles \w la|strong="H3588"\w* vida.   
\p
\v 26 Por su parte, \w el|strong="H5973"\w* joven \w Samuel|strong="H8050"\w* seguía \w creciendo|strong="H1980"\w* \w y|strong="H1571"\w* ganándose \w el|strong="H5973"\w* aprecio \w de|strong="H5973"\w* Yahvé \w y|strong="H1571"\w* \w de|strong="H5973"\w* \w la|strong="H1571"\w* gente.   
\p
\v 27 Un hombre de \w Dios|strong="H3068"\w* \w se|strong="H1961"\w* presentó ante \w Elí|strong="H5941"\w* \w y|strong="H3541"\w* le dijo: “\w Así|strong="H3541"\w* dice Yahvé: “¿Acaso \w no|strong="H1961"\w* \w me|strong="H3541"\w* manifesté claramente \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* de tu antepasado, \w cuando|strong="H1961"\w* \w estaban|strong="H1961"\w* en \w Egipto|strong="H4714"\w* \w como|strong="H1961"\w* esclavos del \w faraón|strong="H6547"\w*?  
\v 28 Yo \w lo|strong="H5921"\w* elegí \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w tribus|strong="H7626"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* fuera \w mi|strong="H5921"\w* \w sacerdote|strong="H3548"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* subiera \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w altar|strong="H4196"\w* \w a|strong="H3068"\w* quemar incienso \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* vistiera \w el|strong="H5921"\w* efod \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w presencia|strong="H6440"\w*. \w Además|strong="H5921"\w*, \w les|strong="H5921"\w* \w di|strong="H5414"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5921"\w* tu antepasado \w todas|strong="H3605"\w* \w las|strong="H5921"\w* ofrendas quemadas \w de|strong="H5921"\w* \w los|strong="H1121"\w* israelitas.  
\v 29 ¿\w Por|strong="H4480"\w* \w qué|strong="H4100"\w* entonces pisotean ustedes mis \w sacrificios|strong="H2077"\w* y las ofrendas \w que|strong="H4100"\w* \w ordené|strong="H6680"\w* \w para|strong="H4480"\w* mi santuario? ¿\w Por|strong="H4480"\w* \w qué|strong="H4100"\w* honras \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* \w más|strong="H4480"\w* \w que|strong="H4100"\w* \w a|strong="H3068"\w* mí, engordándolos \w con|strong="H4480"\w* \w lo|strong="H4100"\w* mejor \w de|strong="H4480"\w* \w todas|strong="H3605"\w* las ofrendas \w de|strong="H4480"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*?”.  
\v 30 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, declara: “\w Es|strong="H3588"\w* \w cierto|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* prometí \w que|strong="H3588"\w* tu \w familia|strong="H1004"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w de|strong="H3588"\w* tu antepasado \w me|strong="H3588"\w* servirían \w siempre|strong="H5769"\w*”. \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w* Yahvé \w dice|strong="H5002"\w*: “¡\w Lejos|strong="H2486"\w* \w de|strong="H3588"\w* mí \w tal|strong="H3651"\w* cosa! \w Yo|strong="H3588"\w* honro \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* honran, \w pero|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* desprecian serán humillados.  
\v 31 Vienen \w días|strong="H3117"\w* en \w que|strong="H3117"\w* les quitaré el poder \w a|strong="H3068"\w* ti y \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* de tu antepasado, \w para|strong="H1961"\w* \w que|strong="H3117"\w* nadie en tu \w familia|strong="H1004"\w* llegue \w a|strong="H3068"\w* \w viejo|strong="H2205"\w*.  
\v 32 Verás \w la|strong="H3605"\w* \w angustia|strong="H6862"\w* en \w mi|strong="H1961"\w* santuario, \w mientras|strong="H3605"\w* \w que|strong="H3808"\w* \w Israel|strong="H3478"\w* gozará de prosperidad; pero en tu \w familia|strong="H1004"\w* \w nunca|strong="H3808"\w* \w habrá|strong="H1961"\w* \w nadie|strong="H3808"\w* \w que|strong="H3808"\w* llegue \w a|strong="H3068"\w* \w la|strong="H3605"\w* vejez.  
\v 33 \w A|strong="H3068"\w* \w cualquiera|strong="H3605"\w* \w de|strong="H5973"\w* \w los|strong="H3605"\w* \w tuyos|strong="H1004"\w* \w que|strong="H3808"\w* \w yo|strong="H5315"\w* \w no|strong="H3808"\w* quite \w de|strong="H5973"\w* \w mi|strong="H5315"\w* \w altar|strong="H4196"\w*, \w será|strong="H3808"\w* solo \w para|strong="H5973"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w le|strong="H5973"\w* cansen \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5973"\w* tanto llorar y \w se|strong="H3808"\w* llene \w de|strong="H5973"\w* dolor su \w corazón|strong="H5315"\w*; y \w todos|strong="H3605"\w* tus descendientes \w morirán|strong="H4191"\w* \w en|strong="H5973"\w* \w la|strong="H3605"\w* flor \w de|strong="H5973"\w* \w la|strong="H3605"\w* juventud.  
\v 34 \w Y|strong="H3068"\w* te daré \w esta|strong="H2088"\w* señal \w de|strong="H1121"\w* \w lo|strong="H2088"\w* \w que|strong="H3117"\w* les pasará \w a|strong="H3068"\w* tus \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w*, Ofni y Finees: \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w morirán|strong="H4191"\w* \w el|strong="H1121"\w* mismo \w día|strong="H3117"\w*.  
\v 35 \w Yo|strong="H5315"\w* \w levantaré|strong="H6965"\w* para \w mí|strong="H5315"\w* un \w sacerdote|strong="H3548"\w* fiel, \w que|strong="H3117"\w* \w haga|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3117"\w* \w yo|strong="H5315"\w* deseo y tengo en mente. Le daré una \w familia|strong="H1004"\w* estable, y \w él|strong="H3605"\w* servirá \w siempre|strong="H3605"\w* \w ante|strong="H6440"\w* \w mi|strong="H5315"\w* \w ungido|strong="H4899"\w*.  
\v 36 Entonces, \w los|strong="H3605"\w* \w que|strong="H4994"\w* queden de tu \w familia|strong="H1004"\w* vendrán \w a|strong="H3068"\w* humillarse ante \w él|strong="H3605"\w* por una moneda de \w plata|strong="H3701"\w* y un pedazo de \w pan|strong="H3899"\w*, y le rogarán: Por favor, dame algún trabajo entre \w los|strong="H3605"\w* sacerdotes \w para|strong="H1961"\w* \w que|strong="H4994"\w* \w tenga|strong="H1961"\w* algo \w que|strong="H4994"\w* comer””.   
\c 3  
\p
\v 1 \w El|strong="H1992"\w* joven \w Samuel|strong="H8050"\w* \w servía|strong="H8334"\w* \w a|strong="H3068"\w* Yahvé bajo la guía \w de|strong="H6440"\w* \w Elí|strong="H5941"\w*. En \w aquellos|strong="H1992"\w* \w tiempos|strong="H3117"\w* \w era|strong="H1961"\w* poco común escuchar la \w palabra|strong="H1697"\w* \w de|strong="H6440"\w* Yahvé, y \w las|strong="H1992"\w* visiones \w no|strong="H1961"\w* \w eran|strong="H1961"\w* frecuentes.  
\v 2 Una noche, \w Elí|strong="H5941"\w* \w estaba|strong="H1961"\w* \w acostado|strong="H7901"\w* en \w su|strong="H1931"\w* habitación. \w Sus|strong="H1931"\w* \w ojos|strong="H5869"\w* \w se|strong="H1961"\w* \w habían|strong="H1961"\w* debilitado tanto \w que|strong="H1931"\w* ya casi \w no|strong="H3808"\w* \w podía|strong="H3201"\w* \w ver|strong="H7200"\w*.  
\v 3 \w Samuel|strong="H8050"\w* también \w estaba|strong="H7901"\w* \w durmiendo|strong="H7901"\w* en el \w templo|strong="H1964"\w* de Yahvé, \w donde|strong="H8033"\w* se encontraba el arca de \w Dios|strong="H3068"\w*. La \w lámpara|strong="H5216"\w* de \w Dios|strong="H3068"\w* \w todavía|strong="H2962"\w* \w estaba|strong="H7901"\w* encendida.  
\v 4 Entonces Yahvé \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, y él respondió: “\w Aquí|strong="H2005"\w* estoy”.   
\p
\v 5 \w En|strong="H3588"\w* seguida \w corrió|strong="H7323"\w* \w a|strong="H3068"\w* donde \w estaba|strong="H7901"\w* \w Elí|strong="H5941"\w* \w y|strong="H3588"\w* le dijo: “\w Aquí|strong="H2005"\w* estoy; ¿\w para|strong="H3588"\w* \w qué|strong="H3588"\w* \w me|strong="H3588"\w* \w llamó|strong="H7121"\w*?”. \w Pero|strong="H3588"\w* \w Elí|strong="H5941"\w* le \w respondió|strong="H7725"\w*: “\w Yo|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* he \w llamado|strong="H7121"\w*; regresa \w a|strong="H3068"\w* acostarte”. \w Y|strong="H3068"\w* Samuel \w fue|strong="H3212"\w* \w y|strong="H3588"\w* \w se|strong="H3808"\w* acostó.   
\p
\v 6 Yahvé \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* \w llamar|strong="H7121"\w*: “¡\w Samuel|strong="H8050"\w*!”. \w El|strong="H3588"\w* joven \w se|strong="H3808"\w* \w levantó|strong="H6965"\w*, \w fue|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Elí|strong="H5941"\w* \w y|strong="H3588"\w* \w le|strong="H3254"\w* dijo: “\w Aquí|strong="H2005"\w* estoy; ¿\w para|strong="H3588"\w* \w qué|strong="H3588"\w* \w me|strong="H3588"\w* \w llamó|strong="H7121"\w*?”. \w Elí|strong="H5941"\w* \w le|strong="H3254"\w* \w respondió|strong="H7725"\w*: “\w Hijo|strong="H1121"\w* mío, \w yo|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* he \w llamado|strong="H7121"\w*; \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* dormir”.  
\v 7 \w Samuel|strong="H8050"\w* \w todavía|strong="H2962"\w* no \w conocía|strong="H3045"\w* \w a|strong="H3068"\w* Yahvé personalmente, \w ni|strong="H2962"\w* \w se|strong="H3045"\w* le había revelado su \w palabra|strong="H1697"\w*.  
\v 8 Yahvé \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w* \w por|strong="H3588"\w* \w tercera|strong="H7992"\w* vez. \w Él|strong="H3588"\w* se \w levantó|strong="H6965"\w*, \w fue|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w Elí|strong="H5941"\w* \w y|strong="H3588"\w* \w le|strong="H3254"\w* dijo: “\w Aquí|strong="H2005"\w* estoy; ¿\w para|strong="H3588"\w* \w qué|strong="H3588"\w* \w me|strong="H3588"\w* \w llamó|strong="H7121"\w*?”. \w Entonces|strong="H3588"\w* \w Elí|strong="H5941"\w* se dio cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* era Yahvé quien \w llamaba|strong="H7121"\w* al \w muchacho|strong="H5288"\w*.   
\p
\v 9 \w Por|strong="H3588"\w* eso \w Elí|strong="H5941"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “\w Ve|strong="H3212"\w* \w y|strong="H3588"\w* \w acuéstate|strong="H7901"\w* \w de|strong="H3588"\w* nuevo. \w Si|strong="H3588"\w* \w te|strong="H3588"\w* vuelve \w a|strong="H3068"\w* \w llamar|strong="H7121"\w*, dile: “\w Habla|strong="H1696"\w*, Yahvé, \w que|strong="H3588"\w* tu \w siervo|strong="H5650"\w* \w escucha|strong="H8085"\w*””. \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w Samuel|strong="H8050"\w* \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w y|strong="H3588"\w* \w se|strong="H1961"\w* acostó \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w lugar|strong="H4725"\w*.  
\v 10 \w Entonces|strong="H3588"\w* Yahvé se presentó \w y|strong="H3588"\w* lo \w llamó|strong="H7121"\w* \w como|strong="H3588"\w* las \w veces|strong="H6471"\w* anteriores: “¡\w Samuel|strong="H8050"\w*! ¡\w Samuel|strong="H8050"\w*!”. \w Y|strong="H3068"\w* \w Samuel|strong="H8050"\w* respondió: “\w Habla|strong="H1696"\w*, \w que|strong="H3588"\w* tu \w siervo|strong="H5650"\w* \w escucha|strong="H8085"\w*”.   
\p
\v 11 Yahvé le dijo \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “\w Mira|strong="H2009"\w*, voy \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w algo|strong="H1697"\w* en \w Israel|strong="H3478"\w* \w que|strong="H1697"\w* dejará atónitos \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1697"\w* \w lo|strong="H1697"\w* \w oigan|strong="H8085"\w*.  
\v 12 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w cumpliré|strong="H3615"\w* contra \w Elí|strong="H5941"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* anuncié sobre \w su|strong="H1931"\w* \w familia|strong="H1004"\w*, de principio \w a|strong="H3068"\w* fin.  
\v 13 \w Ya|strong="H3068"\w* le advertí \w que|strong="H3588"\w* \w juzgaré|strong="H8199"\w* \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w familia|strong="H1004"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H5771"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w conoce|strong="H3045"\w*; \w porque|strong="H3588"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* \w se|strong="H3045"\w* han burlado \w de|strong="H3588"\w* Dios \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H1992"\w* corrigió.  
\v 14 \w Por|strong="H5704"\w* \w eso|strong="H3651"\w*, he \w jurado|strong="H7650"\w* \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H5704"\w* \w Elí|strong="H5941"\w* \w que|strong="H5704"\w* su \w pecado|strong="H5771"\w* \w nunca|strong="H5769"\w* podrá ser perdonado, \w ni|strong="H5704"\w* \w con|strong="H5704"\w* \w sacrificios|strong="H2077"\w* \w ni|strong="H5704"\w* \w con|strong="H5704"\w* ofrendas”.   
\p
\v 15 \w Samuel|strong="H8050"\w* se quedó \w acostado|strong="H7901"\w* \w hasta|strong="H5704"\w* la \w mañana|strong="H1242"\w*, \w y|strong="H5704"\w* \w luego|strong="H5704"\w* \w abrió|strong="H6605"\w* las \w puertas|strong="H1817"\w* \w de|strong="H5704"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* Yahvé. Tenía \w miedo|strong="H3372"\w* \w de|strong="H5704"\w* contarle \w a|strong="H3068"\w* \w Elí|strong="H5941"\w* la \w visión|strong="H4759"\w* \w que|strong="H5704"\w* había tenido.  
\v 16 Pero \w Elí|strong="H5941"\w* lo \w llamó|strong="H7121"\w* y le dijo: “¡\w Samuel|strong="H8050"\w*, \w hijo|strong="H1121"\w* mío!”. \w Él|strong="H1121"\w* respondió: “\w Aquí|strong="H2005"\w* estoy”.   
\p
\v 17 Elí \w le|strong="H3254"\w* preguntó: “¿\w Qué|strong="H4100"\w* fue \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w te|strong="H4480"\w* \w dijo|strong="H1696"\w* Yahvé? \w Por|strong="H4480"\w* favor, \w no|strong="H6213"\w* \w me|strong="H4480"\w* ocultes \w nada|strong="H1697"\w*. \w Que|strong="H4100"\w* Dios \w te|strong="H4480"\w* castigue duramente \w si|strong="H4994"\w* \w me|strong="H4480"\w* escondes una sola \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w él|strong="H3605"\w* \w te|strong="H4480"\w* \w habló|strong="H1696"\w*”.   
\p
\v 18 \w Samuel|strong="H8050"\w* \w se|strong="H1931"\w* \w lo|strong="H1931"\w* \w contó|strong="H5046"\w* \w todo|strong="H3605"\w*, \w sin|strong="H3808"\w* ocultarle \w nada|strong="H3808"\w*. Entonces Elí comentó: “\w Él|strong="H1931"\w* \w es|strong="H1931"\w* Yahvé; \w que|strong="H4480"\w* \w haga|strong="H6213"\w* \w lo|strong="H1931"\w* \w que|strong="H4480"\w* \w mejor|strong="H2896"\w* \w le|strong="H1931"\w* parezca”.   
\p
\v 19 \w Samuel|strong="H8050"\w* siguió creciendo, y Yahvé \w estaba|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* y cumplía \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w Samuel|strong="H8050"\w* decía.  
\v 20 \w Todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w desde|strong="H5704"\w* \w Dan|strong="H1835"\w* \w hasta|strong="H5704"\w* Berseba, \w reconoció|strong="H3045"\w* \w que|strong="H3588"\w* \w Samuel|strong="H8050"\w* estaba confirmado \w como|strong="H3588"\w* \w profeta|strong="H5030"\w* \w de|strong="H3588"\w* Yahvé.  
\v 21 Yahvé continuó manifestándose \w en|strong="H3588"\w* \w Silo|strong="H7887"\w*, \w pues|strong="H3588"\w* allí se revelaba \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w* \w por|strong="H3588"\w* medio \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w palabra|strong="H1697"\w*.   
\c 4  
\p
\v 1 \w La|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* \w Samuel|strong="H8050"\w* \w se|strong="H1961"\w* daba \w a|strong="H3068"\w* conocer \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*. \w Por|strong="H5921"\w* \w aquel|strong="H3605"\w* tiempo, \w los|strong="H5921"\w* israelitas \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w y|strong="H5921"\w* acamparon \w junto|strong="H5921"\w* \w a|strong="H3068"\w* Ebenezer, \w mientras|strong="H3605"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* acamparon \w en|strong="H5921"\w* Afec.  
\v 2 Los \w filisteos|strong="H6430"\w* se alinearon para la \w batalla|strong="H4421"\w* \w contra|strong="H6440"\w* \w Israel|strong="H3478"\w*; y cuando comenzó el \w combate|strong="H4634"\w*, los \w filisteos|strong="H6430"\w* derrotaron \w a|strong="H3068"\w* los israelitas, matando \w a|strong="H3068"\w* unos cuatro mil hombres \w en|strong="H5221"\w* el \w campo|strong="H7704"\w* \w de|strong="H6440"\w* \w batalla|strong="H4421"\w*.  
\v 3 \w Cuando|strong="H3117"\w* los soldados regresaron \w al|strong="H7130"\w* \w campamento|strong="H4264"\w*, los \w ancianos|strong="H2205"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* preguntaron: “¿\w Por|strong="H6440"\w* \w qué|strong="H4100"\w* permitió \w el|strong="H4264"\w* \w Señor|strong="H3068"\w* \w que|strong="H4100"\w* los \w filisteos|strong="H6430"\w* \w nos|strong="H4100"\w* derrotaran \w hoy|strong="H3117"\w*? Vayamos \w a|strong="H3068"\w* \w Silo|strong="H7887"\w* \w por|strong="H6440"\w* \w el|strong="H4264"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Yahvé; traigámosla \w para|strong="H5971"\w* \w que|strong="H4100"\w* esté con nosotros y \w nos|strong="H4100"\w* \w salve|strong="H3467"\w* del poder \w de|strong="H6440"\w* nuestros enemigos”.   
\p
\v 4 \w El|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w envió|strong="H7971"\w* mensajeros \w a|strong="H3068"\w* \w Silo|strong="H7887"\w* y \w trajeron|strong="H5375"\w* \w de|strong="H5973"\w* \w allá|strong="H8033"\w* \w el|strong="H5973"\w* arca \w del|strong="H5973"\w* \w pacto|strong="H1285"\w* \w de|strong="H5973"\w* Yahvé \w de|strong="H5973"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w que|strong="H5971"\w* tiene su trono sobre \w los|strong="H3427"\w* \w querubines|strong="H3742"\w*. \w Los|strong="H3427"\w* \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w Elí|strong="H5941"\w*, Ofni y Finees, \w estaban|strong="H3427"\w* \w allí|strong="H8033"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* arca \w del|strong="H5973"\w* \w pacto|strong="H1285"\w* \w de|strong="H5973"\w* \w Dios|strong="H3068"\w*.  
\v 5 En cuanto \w el|strong="H3605"\w* arca del \w pacto|strong="H1285"\w* de Yahvé entró al \w campamento|strong="H4264"\w*, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas lanzaron un grito tan fuerte \w que|strong="H1961"\w* hicieron retumbar \w la|strong="H3605"\w* tierra.  
\v 6 Al \w oír|strong="H8085"\w* \w el|strong="H3588"\w* \w estruendo|strong="H6963"\w*, \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w* preguntaron: “¿\w A|strong="H3068"\w* \w qué|strong="H3588"\w* \w se|strong="H3045"\w* debe ese grito tan fuerte \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w campamento|strong="H4264"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w hebreos|strong="H5680"\w*?”. \w Cuando|strong="H3588"\w* \w supieron|strong="H3045"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* llegado al \w campamento|strong="H4264"\w*,  
\v 7 \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* \w se|strong="H1961"\w* aterraron \w y|strong="H3588"\w* decían: “¡Un dios \w ha|strong="H3808"\w* entrado \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w campamento|strong="H4264"\w*! ¡Pobres \w de|strong="H3588"\w* nosotros!, \w porque|strong="H3588"\w* \w nunca|strong="H3808"\w* \w antes|strong="H3588"\w* nos \w había|strong="H1961"\w* pasado algo \w así|strong="H2063"\w*.  
\v 8 ¡Ay de \w nosotros|strong="H3605"\w*! ¿\w Quién|strong="H4310"\w* podrá salvarnos del \w poder|strong="H3027"\w* de \w estos|strong="H1992"\w* dioses tan fuertes? \w Ellos|strong="H1992"\w* son \w los|strong="H1992"\w* \w mismos|strong="H1992"\w* dioses \w que|strong="H4310"\w* castigaron \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w egipcios|strong="H4714"\w* con \w toda|strong="H3605"\w* clase de \w plagas|strong="H4347"\w* \w en|strong="H5221"\w* \w el|strong="H3605"\w* \w desierto|strong="H4057"\w*.  
\v 9 ¡Fortalécense, \w filisteos|strong="H6430"\w*, y \w sean|strong="H1961"\w* hombres! \w Si|strong="H6435"\w* \w no|strong="H6435"\w*, terminarán siendo esclavos \w de|strong="H3898"\w* \w los|strong="H1961"\w* \w hebreos|strong="H5680"\w*, \w como|strong="H1961"\w* ellos lo han \w sido|strong="H1961"\w* \w de|strong="H3898"\w* ustedes. ¡\w Sean|strong="H1961"\w* valientes y peleen!”.  
\v 10 \w Los|strong="H1961"\w* \w filisteos|strong="H6430"\w* \w pelearon|strong="H3898"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* \w fue|strong="H1961"\w* derrotado; cada cual \w huyó|strong="H5127"\w* \w a|strong="H3068"\w* su casa. La matanza \w fue|strong="H1961"\w* terrible, \w pues|strong="H1961"\w* \w cayeron|strong="H5307"\w* \w treinta|strong="H7970"\w* mil soldados \w de|strong="H3898"\w* infantería \w de|strong="H3898"\w* \w Israel|strong="H3478"\w*.  
\v 11 \w El|strong="H1121"\w* arca \w de|strong="H1121"\w* Dios fue capturada y \w los|strong="H1121"\w* \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Elí|strong="H5941"\w*, Ofni y Finees, \w murieron|strong="H4191"\w* en la batalla.   
\p
\v 12 Un hombre \w de|strong="H5921"\w* \w la|strong="H1931"\w* tribu \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w* salió \w corriendo|strong="H7323"\w* \w del|strong="H5921"\w* campo \w de|strong="H5921"\w* batalla \w y|strong="H5921"\w* llegó \w a|strong="H3068"\w* \w Silo|strong="H7887"\w* \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*. Llevaba \w la|strong="H1931"\w* ropa rota \w y|strong="H5921"\w* \w tenía|strong="H1931"\w* tierra \w sobre|strong="H5921"\w* \w su|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor.  
\v 13 \w Cuando|strong="H3588"\w* llegó, \w Elí|strong="H5941"\w* \w estaba|strong="H1961"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w su|strong="H3588"\w* silla \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w camino|strong="H1870"\w*, vigilando \w con|strong="H5921"\w* ansiedad, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w corazón|strong="H3820"\w* temblaba \w por|strong="H5921"\w* \w el|strong="H5921"\w* arca \w de|strong="H5921"\w* Dios. \w El|strong="H5921"\w* hombre entró \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* dio \w la|strong="H5921"\w* noticia, \w y|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w se|strong="H1961"\w* puso \w a|strong="H3068"\w* gritar \w de|strong="H5921"\w* espanto.  
\v 14 Al \w oír|strong="H8085"\w* el \w clamor|strong="H6818"\w*, \w Elí|strong="H5941"\w* preguntó: “¿\w Qué|strong="H4100"\w* significa todo \w ese|strong="H2088"\w* \w alboroto|strong="H1995"\w*?”.  
\p El hombre corrió de inmediato \w a|strong="H3068"\w* informarle \w a|strong="H3068"\w* \w Elí|strong="H5941"\w*.  
\v 15 \w Elí|strong="H5941"\w* ya tenía \w noventa|strong="H8673"\w* y \w ocho|strong="H8083"\w* \w años|strong="H8141"\w*; sus \w ojos|strong="H5869"\w* estaban apagados y ya \w no|strong="H3808"\w* \w podía|strong="H3201"\w* \w ver|strong="H7200"\w*.  
\v 16 \w El|strong="H1121"\w* \w hombre|strong="H1121"\w* le dijo \w a|strong="H3068"\w* \w Elí|strong="H5941"\w*: “Vengo \w del|strong="H4480"\w* campo \w de|strong="H4480"\w* batalla; \w hoy|strong="H3117"\w* mismo logré escapar \w de|strong="H4480"\w* la pelea”.  
\p \w Elí|strong="H5941"\w* le preguntó: “¿\w Qué|strong="H4100"\w* pasó, \w hijo|strong="H1121"\w* mío?”.   
\p
\v 17 \w El|strong="H1121"\w* mensajero \w respondió|strong="H6030"\w*: “\w Israel|strong="H3478"\w* \w huyó|strong="H5127"\w* \w ante|strong="H6440"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*; \w hubo|strong="H1961"\w* una \w gran|strong="H1419"\w* \w matanza|strong="H4046"\w* entre \w el|strong="H1121"\w* \w pueblo|strong="H5971"\w*. \w Además|strong="H1571"\w*, tus \w dos|strong="H8147"\w* \w hijos|strong="H1121"\w*, Ofni \w y|strong="H1571"\w* Finees, \w han|strong="H4191"\w* \w muerto|strong="H4191"\w*, \w y|strong="H1571"\w* \w el|strong="H1121"\w* arca \w de|strong="H6440"\w* Dios \w fue|strong="H1961"\w* capturada”.   
\p
\v 18 \w En|strong="H5921"\w* \w cuanto|strong="H3588"\w* \w el|strong="H1931"\w* hombre mencionó \w el|strong="H1931"\w* arca \w de|strong="H5921"\w* Dios, Elí \w se|strong="H1961"\w* \w cayó|strong="H5307"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* silla \w hacia|strong="H5921"\w* atrás, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w puerta|strong="H8179"\w*; \w se|strong="H1961"\w* desnucó \w y|strong="H3588"\w* \w murió|strong="H4191"\w*, \w pues|strong="H3588"\w* ya \w era|strong="H1961"\w* muy \w viejo|strong="H2204"\w* \w y|strong="H3588"\w* \w pesado|strong="H3515"\w*. Elí \w había|strong="H1961"\w* \w sido|strong="H1961"\w* \w juez|strong="H8199"\w* \w en|strong="H5921"\w* \w Israel|strong="H3478"\w* durante cuarenta \w años|strong="H8141"\w*.   
\p
\v 19 \w Su|strong="H3588"\w* \w nuera|strong="H3618"\w*, \w la|strong="H5921"\w* \w esposa|strong="H3618"\w* \w de|strong="H5921"\w* Finees, estaba embarazada \w y|strong="H3588"\w* próxima \w al|strong="H5921"\w* parto. \w Al|strong="H5921"\w* \w oír|strong="H8085"\w* \w la|strong="H5921"\w* noticia \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* arca \w de|strong="H5921"\w* Dios \w había|strong="H3588"\w* sido capturada \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w suegro|strong="H2524"\w* \w y|strong="H3588"\w* \w su|strong="H3588"\w* esposo habían \w muerto|strong="H4191"\w*, \w le|strong="H5921"\w* vinieron \w los|strong="H5921"\w* dolores \w de|strong="H5921"\w* parto \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz.  
\v 20 \w Mientras|strong="H3588"\w* \w ella|strong="H5921"\w* moría, \w las|strong="H5921"\w* mujeres \w que|strong="H3588"\w* \w la|strong="H5921"\w* atendían \w le|strong="H5921"\w* \w dijeron|strong="H1696"\w*: “\w No|strong="H3808"\w* tengas \w miedo|strong="H3372"\w*, \w has|strong="H4191"\w* tenido un \w hijo|strong="H1121"\w*”. \w Pero|strong="H3588"\w* \w ella|strong="H5921"\w* \w no|strong="H3808"\w* \w respondió|strong="H6030"\w* \w ni|strong="H3808"\w* \w les|strong="H5921"\w* hizo \w caso|strong="H3820"\w*.  
\v 21 Al \w niño|strong="H5288"\w* le puso por \w nombre|strong="H7121"\w* Icabod, \w porque|strong="H1540"\w* dijo: “La \w gloria|strong="H3519"\w* se ha ido de \w Israel|strong="H3478"\w*”. Lo dijo \w porque|strong="H1540"\w* el arca de Dios había sido capturada \w y|strong="H3519"\w* por la muerte de su \w suegro|strong="H2524"\w* \w y|strong="H3519"\w* de su esposo.  
\v 22 Ella repitió: “\w La|strong="H3588"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* se ha ido, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* Dios \w fue|strong="H1540"\w* capturada”.   
\c 5  
\p
\v 1 Después de capturar el arca de Dios, los \w filisteos|strong="H6430"\w* la \w llevaron|strong="H3947"\w* de Ebenezer \w a|strong="H3068"\w* la ciudad de Asdod.  
\v 2 \w Tomaron|strong="H3947"\w* el arca de Dios, la metieron en el \w templo|strong="H1004"\w* de \w Dagón|strong="H1712"\w* y la pusieron \w a|strong="H3068"\w* un lado de su estatua.  
\v 3 Cuando los habitantes \w de|strong="H6440"\w* Asdod se levantaron temprano al día \w siguiente|strong="H4283"\w*, ¡vieron que \w Dagón|strong="H1712"\w* se había \w caído|strong="H5307"\w* \w de|strong="H6440"\w* \w cara|strong="H6440"\w* al suelo frente al arca \w de|strong="H6440"\w* Yahvé! Así que levantaron \w a|strong="H3068"\w* \w Dagón|strong="H1712"\w* y lo pusieron otra vez en su \w lugar|strong="H4725"\w*.  
\v 4 Pero \w al|strong="H5921"\w* día \w siguiente|strong="H4283"\w*, cuando \w se|strong="H5921"\w* levantaron \w de|strong="H5921"\w* madrugada, \w Dagón|strong="H1712"\w* \w estaba|strong="H2009"\w* otra vez \w caído|strong="H5307"\w* \w de|strong="H5921"\w* \w cara|strong="H6440"\w* \w al|strong="H5921"\w* suelo frente \w al|strong="H5921"\w* arca \w de|strong="H5921"\w* Yahvé. \w Esta|strong="H5921"\w* vez, \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* \w dos|strong="H8147"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* \w Dagón|strong="H1712"\w* \w estaban|strong="H7218"\w* \w cortadas|strong="H3772"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w umbral|strong="H4670"\w*; \w solo|strong="H7535"\w* \w el|strong="H5921"\w* torso \w de|strong="H5921"\w* \w la|strong="H5921"\w* estatua \w quedó|strong="H7604"\w* entero.  
\v 5 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w hoy|strong="H3117"\w*, \w ni|strong="H3808"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* \w Dagón|strong="H1712"\w* \w ni|strong="H3808"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* entran \w en|strong="H5921"\w* su \w templo|strong="H1004"\w* \w en|strong="H5921"\w* Asdod \w pisan|strong="H1869"\w* \w el|strong="H5921"\w* \w umbral|strong="H4670"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* entrada.  
\v 6 Entonces \w la|strong="H1366"\w* \w mano|strong="H3027"\w* de Yahvé castigó duramente \w a|strong="H3068"\w* los de Asdod. Los llenó de terror y los \w hirió|strong="H5221"\w* con una plaga de tumores, tanto \w en|strong="H5221"\w* \w la|strong="H1366"\w* ciudad como \w en|strong="H5221"\w* sus alrededores.   
\p
\v 7 \w Cuando|strong="H3588"\w* \w los|strong="H3427"\w* hombres \w de|strong="H5921"\w* Asdod \w vieron|strong="H7200"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* pasaba, dijeron: “\w El|strong="H5921"\w* arca \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* puede quedarse aquí \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w* \w nos|strong="H5921"\w* \w está|strong="H3651"\w* castigando \w con|strong="H5973"\w* rigor, \w tanto|strong="H3651"\w* \w a|strong="H3068"\w* \w nosotros|strong="H5973"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* nuestro dios \w Dagón|strong="H1712"\w*”.  
\v 8 Así \w que|strong="H4100"\w* mandaron llamar \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* jefes de \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* y les preguntaron: “¿\w Qué|strong="H4100"\w* vamos \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* con \w el|strong="H3605"\w* arca del Dios de \w Israel|strong="H3478"\w*?”. \w Ellos|strong="H3605"\w* respondieron: “Llévenla \w a|strong="H3068"\w* \w la|strong="H3605"\w* ciudad de Gat”. \w Y|strong="H3068"\w* trasladaron allá \w el|strong="H3605"\w* arca del Dios de \w Israel|strong="H3478"\w*.  
\v 9 Pero \w en|strong="H5704"\w* cuanto la llevaron \w a|strong="H3068"\w* Gat, la \w mano|strong="H3027"\w* \w de|strong="H5704"\w* Yahvé castigó \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* \w y|strong="H5704"\w* causó un pánico terrible. \w Hirió|strong="H5221"\w* \w a|strong="H3068"\w* todos \w los|strong="H1961"\w* hombres \w de|strong="H5704"\w* la \w ciudad|strong="H5892"\w*, \w desde|strong="H5704"\w* el \w más|strong="H5704"\w* chico \w hasta|strong="H5704"\w* el \w más|strong="H5704"\w* \w grande|strong="H1419"\w*, \w y|strong="H5704"\w* les salieron tumores.  
\v 10 Entonces mandaron el arca \w de|strong="H5971"\w* Dios \w a|strong="H3068"\w* la ciudad \w de|strong="H5971"\w* \w Ecrón|strong="H6138"\w*.  
\p Pero \w cuando|strong="H1961"\w* el arca llegó allá, \w los|strong="H1961"\w* \w de|strong="H5971"\w* \w Ecrón|strong="H6138"\w* gritaron: “¡Nos \w han|strong="H4191"\w* traído el arca del Dios \w de|strong="H5971"\w* \w Israel|strong="H3478"\w* \w para|strong="H1961"\w* matarnos \w a|strong="H3068"\w* nosotros y \w a|strong="H3068"\w* nuestras familias!”.  
\v 11 \w Por|strong="H3588"\w* eso mandaron llamar \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w y|strong="H3588"\w* les dijeron: “¡Devuelvan \w el|strong="H3588"\w* arca del Dios \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*! \w Que|strong="H3588"\w* regrese \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w lugar|strong="H4725"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* acabe \w con|strong="H3588"\w* \w nosotros|strong="H3605"\w* \w y|strong="H3588"\w* \w con|strong="H3588"\w* nuestro \w pueblo|strong="H5971"\w*”. \w Y|strong="H3068"\w* \w es|strong="H1961"\w* \w que|strong="H3588"\w* \w había|strong="H1961"\w* un pánico mortal \w en|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*, \w pues|strong="H3588"\w* \w la|strong="H3588"\w* \w mano|strong="H3027"\w* \w de|strong="H3588"\w* Dios \w los|strong="H3605"\w* \w estaba|strong="H1961"\w* castigando \w con|strong="H3588"\w* mucha dureza.  
\v 12 Los \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w morían|strong="H4191"\w* \w eran|strong="H3808"\w* \w heridos|strong="H5221"\w* con tumores, y el \w clamor|strong="H7775"\w* de la \w ciudad|strong="H5892"\w* llegaba hasta el \w cielo|strong="H8064"\w*.   
\c 6  
\p
\v 1 El arca de Yahvé \w estuvo|strong="H1961"\w* en el territorio de \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* durante \w siete|strong="H7651"\w* \w meses|strong="H2320"\w*.  
\v 2 Entonces los \w filisteos|strong="H6430"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* sus \w sacerdotes|strong="H3548"\w* y \w adivinos|strong="H7080"\w*, y les preguntaron: “¿\w Qué|strong="H4100"\w* vamos \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* con \w el|strong="H6213"\w* arca de Yahvé? Dígannos \w cómo|strong="H4100"\w* debemos enviarla de regreso \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w*”.   
\p
\v 3 \w Ellos|strong="H3027"\w* \w respondieron|strong="H7725"\w*: “\w Si|strong="H3588"\w* van \w a|strong="H3068"\w* devolver \w el|strong="H3588"\w* arca \w del|strong="H4480"\w* Dios \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w no|strong="H3808"\w* \w la|strong="H3588"\w* envíen \w vacía|strong="H7387"\w*. Tienen \w que|strong="H3588"\w* enviarle una ofrenda \w de|strong="H4480"\w* reparación \w por|strong="H3588"\w* \w su|strong="H3588"\w* culpa. Solo \w así|strong="H3588"\w* serán sanados \w y|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w por|strong="H3588"\w* \w qué|strong="H3588"\w* Dios \w no|strong="H3808"\w* \w ha|strong="H3808"\w* dejado \w de|strong="H4480"\w* castigarlos”.   
\p
\v 4 \w Los|strong="H3605"\w* \w filisteos|strong="H6430"\w* preguntaron: “¿\w Y|strong="H3068"\w* \w qué|strong="H3588"\w* ofrenda \w de|strong="H3588"\w* reparación debemos enviarle?”.  
\p \w Ellos|strong="H3605"\w* contestaron: “\w Cinco|strong="H2568"\w* tumores \w de|strong="H3588"\w* \w oro|strong="H2091"\w* \w y|strong="H3588"\w* \w cinco|strong="H2568"\w* \w ratones|strong="H5909"\w* \w de|strong="H3588"\w* \w oro|strong="H2091"\w*, \w de|strong="H3588"\w* acuerdo al \w número|strong="H4557"\w* \w de|strong="H3588"\w* \w los|strong="H3605"\w* jefes \w filisteos|strong="H6430"\w*, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* misma \w plaga|strong="H4046"\w* \w los|strong="H3605"\w* ha azotado \w a|strong="H3068"\w* \w todos|strong="H3605"\w* ustedes \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus jefes.  
\v 5 Manden \w hacer|strong="H6213"\w* figuras \w de|strong="H5921"\w* sus tumores \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w ratones|strong="H5909"\w* \w que|strong="H5921"\w* están destruyendo \w el|strong="H5921"\w* país, \w y|strong="H5921"\w* denle \w gloria|strong="H3519"\w* \w al|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. Tal vez \w así|strong="H7043"\w* \w él|strong="H5921"\w* deje \w de|strong="H5921"\w* castigarlos \w a|strong="H3068"\w* ustedes, \w a|strong="H3068"\w* sus dioses \w y|strong="H5921"\w* \w a|strong="H3068"\w* su tierra.  
\v 6 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w se|strong="H3808"\w* ponen tercos, \w como|strong="H4100"\w* \w se|strong="H3808"\w* pusieron el \w Faraón|strong="H6547"\w* y los \w egipcios|strong="H4713"\w*? Recuerden \w que|strong="H4100"\w* solo después de \w que|strong="H4100"\w* Dios los castigó con dureza, dejaron \w ir|strong="H3212"\w* \w a|strong="H3068"\w* los israelitas.   
\p
\v 7 “Preparen \w ahora|strong="H6258"\w* una carreta \w nueva|strong="H2319"\w* \w y|strong="H5921"\w* consigan \w dos|strong="H8147"\w* \w vacas|strong="H6510"\w* \w que|strong="H3808"\w* estén criando \w y|strong="H5921"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* hayan llevado \w yugo|strong="H5923"\w*. Aten \w las|strong="H5921"\w* \w vacas|strong="H6510"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* carreta \w y|strong="H5921"\w* lleven \w a|strong="H3068"\w* sus becerros \w de|strong="H5921"\w* regreso \w al|strong="H5921"\w* establo.  
\v 8 \w Luego|strong="H7725"\w* \w tomen|strong="H3947"\w* el arca \w de|strong="H5414"\w* Yahvé y pónganla en la carreta. \w Pongan|strong="H7760"\w* en una caja, al \w lado|strong="H6654"\w* del arca, las figuras \w de|strong="H5414"\w* \w oro|strong="H2091"\w* que le \w enviarán|strong="H7971"\w* como ofrenda \w de|strong="H5414"\w* reparación, y dejen que la carreta siga su \w camino|strong="H1980"\w*.  
\v 9 \w Pero|strong="H3588"\w* fíjense \w bien|strong="H3588"\w*: \w si|strong="H3588"\w* \w el|strong="H1931"\w* arca \w sube|strong="H5927"\w* \w por|strong="H3588"\w* \w el|strong="H1931"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* propio territorio \w hacia|strong="H1870"\w* Bet Semes, \w entonces|strong="H3588"\w* sabremos \w que|strong="H3588"\w* \w fue|strong="H1961"\w* \w el|strong="H1931"\w* Dios \w de|strong="H3588"\w* Israel \w quien|strong="H6213"\w* nos mandó \w este|strong="H1931"\w* \w gran|strong="H1419"\w* \w mal|strong="H7451"\w*; \w pero|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w así|strong="H2063"\w*, sabremos \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w fue|strong="H1961"\w* \w su|strong="H1931"\w* \w mano|strong="H3027"\w* \w la|strong="H1931"\w* \w que|strong="H3588"\w* nos \w hirió|strong="H5060"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* todo \w fue|strong="H1961"\w* una casualidad”.   
\p
\v 10 \w Así|strong="H3651"\w* \w lo|strong="H6213"\w* \w hicieron|strong="H6213"\w*: \w tomaron|strong="H3947"\w* \w dos|strong="H8147"\w* \w vacas|strong="H6510"\w* \w que|strong="H1121"\w* estaban criando, las ataron \w a|strong="H3068"\w* la carreta y encerraron \w a|strong="H3068"\w* sus becerros en \w el|strong="H1121"\w* establo.  
\v 11 \w Pusieron|strong="H7760"\w* el arca de Yahvé en la carreta, junto con la caja que contenía los \w ratones|strong="H5909"\w* de \w oro|strong="H2091"\w* y las figuras de los tumores.  
\v 12 \w Las|strong="H5921"\w* \w vacas|strong="H6510"\w* \w se|strong="H5921"\w* \w fueron|strong="H1980"\w* \w derecho|strong="H3225"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w a|strong="H3068"\w* Bet Semes. \w Iban|strong="H1980"\w* mugiendo \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w sin|strong="H3808"\w* desviarse \w para|strong="H5704"\w* \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w izquierda|strong="H8040"\w*, \w mientras|strong="H5704"\w* \w los|strong="H5921"\w* jefes \w filisteos|strong="H6430"\w* \w las|strong="H5921"\w* \w seguían|strong="H5921"\w* \w hasta|strong="H5704"\w* \w los|strong="H5921"\w* límites \w de|strong="H5921"\w* Bet Semes.  
\v 13 La gente \w de|strong="H5869"\w* Bet Semes estaba cosechando el \w trigo|strong="H2406"\w* en el \w valle|strong="H6010"\w*. Cuando \w alzaron|strong="H5375"\w* la vista y \w vieron|strong="H7200"\w* el arca, se llenaron \w de|strong="H5869"\w* alegría.  
\v 14 La carreta \w llegó|strong="H5927"\w* \w al|strong="H5930"\w* \w campo|strong="H7704"\w* de \w Josué|strong="H3091"\w* de Bet Semes y se detuvo junto \w a|strong="H3068"\w* una \w gran|strong="H1419"\w* piedra. Entonces la gente \w cortó|strong="H1234"\w* la \w madera|strong="H6086"\w* de la carreta y \w ofreció|strong="H5927"\w* las \w vacas|strong="H6510"\w* como un sacrificio quemado \w a|strong="H3068"\w* Yahvé.  
\v 15 \w Los|strong="H1931"\w* \w levitas|strong="H3881"\w* \w bajaron|strong="H3381"\w* \w el|strong="H1931"\w* arca de Yahvé y \w la|strong="H1931"\w* caja \w que|strong="H1931"\w* contenía las figuras de \w oro|strong="H2091"\w*, y las \w pusieron|strong="H7760"\w* sobre \w la|strong="H1931"\w* \w gran|strong="H1419"\w* piedra. \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, \w la|strong="H1931"\w* gente de Bet Semes \w ofreció|strong="H2076"\w* \w sacrificios|strong="H2077"\w* y presentes \w a|strong="H3068"\w* Yahvé.  
\v 16 \w Cuando|strong="H3117"\w* \w los|strong="H1931"\w* \w cinco|strong="H2568"\w* jefes \w filisteos|strong="H6430"\w* \w vieron|strong="H7200"\w* \w esto|strong="H1931"\w*, regresaron \w a|strong="H3068"\w* \w Ecrón|strong="H6138"\w* \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*.  
\v 17 Los tumores de \w oro|strong="H2091"\w* que los \w filisteos|strong="H6430"\w* enviaron \w a|strong="H3068"\w* Yahvé como ofrenda de reparación fueron cinco: uno por Asdod, uno por \w Gaza|strong="H5804"\w*, uno por Ascalón, uno por Gat y uno por \w Ecrón|strong="H6138"\w*.  
\v 18 \w También|strong="H2088"\w* enviaron \w ratones|strong="H5909"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w según|strong="H5921"\w* \w el|strong="H5921"\w* \w número|strong="H4557"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* filisteas \w que|strong="H5921"\w* pertenecían \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w cinco|strong="H2568"\w* jefes, \w tanto|strong="H5921"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* amuralladas \w como|strong="H5921"\w* \w las|strong="H5921"\w* aldeas sin muros. \w La|strong="H5921"\w* \w gran|strong="H1419"\w* piedra \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w pusieron|strong="H3240"\w* \w el|strong="H5921"\w* arca \w de|strong="H5921"\w* Yahvé todavía \w está|strong="H2088"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* \w de|strong="H5921"\w* \w Josué|strong="H3091"\w* \w de|strong="H5921"\w* Bet Semes \w como|strong="H5921"\w* testimonio.  
\v 19 Sin embargo, Yahvé castigó \w a|strong="H3068"\w* \w los|strong="H3588"\w* hombres \w de|strong="H3588"\w* Bet Semes \w porque|strong="H3588"\w* \w miraron|strong="H7200"\w* dentro del arca; murieron \w cincuenta|strong="H2572"\w* mil \w setenta|strong="H7657"\w* hombres. \w El|strong="H3588"\w* \w pueblo|strong="H5971"\w* lloró \w mucho|strong="H1419"\w* \w porque|strong="H3588"\w* Yahvé les \w había|strong="H3588"\w* dado un golpe tan terrible.  
\v 20 \w Los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Bet Semes \w se|strong="H5921"\w* preguntaban: “¿\w Quién|strong="H4310"\w* \w puede|strong="H3201"\w* estar \w en|strong="H5921"\w* \w presencia|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, \w este|strong="H2088"\w* \w Dios|strong="H3068"\w* tan \w santo|strong="H6918"\w*? ¿\w A|strong="H3068"\w* \w dónde|strong="H5921"\w* \w podemos|strong="H3201"\w* enviar \w el|strong="H5921"\w* arca \w para|strong="H5921"\w* \w que|strong="H4310"\w* \w se|strong="H5921"\w* \w vaya|strong="H5927"\w* \w de|strong="H5921"\w* \w aquí|strong="H2088"\w*?”.   
\p
\v 21 \w Entonces|strong="H7725"\w* \w enviaron|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Quiriat Jearim para decirles: “\w Los|strong="H3427"\w* \w filisteos|strong="H6430"\w* han devuelto \w el|strong="H3427"\w* arca de Yahvé. Bajen por ella y llévensela con ustedes”.   
\c 7  
\p
\v 1 \w Los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* Quiriat Jearim \w vinieron|strong="H5927"\w* y se llevaron \w el|strong="H1121"\w* arca \w de|strong="H1121"\w* Yahvé. \w La|strong="H8104"\w* llevaron \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Abinadab, \w que|strong="H1121"\w* \w estaba|strong="H1004"\w* en \w la|strong="H8104"\w* colina, y consagraron \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Eleazar para \w que|strong="H1121"\w* cuidara \w el|strong="H1121"\w* arca \w de|strong="H1121"\w* Yahvé.  
\v 2 \w El|strong="H3605"\w* arca \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* en Quiriat Jearim \w mucho|strong="H7235"\w* \w tiempo|strong="H3117"\w*; \w pasaron|strong="H3427"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w*, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* pueblo de \w Israel|strong="H3478"\w* buscaba con arrepentimiento \w a|strong="H3068"\w* Yahvé.  
\v 3 \w Entonces|strong="H5493"\w* \w Samuel|strong="H8050"\w* le dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* pueblo de \w Israel|strong="H3478"\w*: “Si ustedes \w van|strong="H3559"\w* \w a|strong="H3068"\w* \w volver|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé de \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*, quiten de \w entre|strong="H8432"\w* ustedes \w a|strong="H3068"\w* \w los|strong="H3605"\w* dioses extranjeros y \w a|strong="H3068"\w* las imágenes de Astarot. Dediquen su \w corazón|strong="H3824"\w* \w a|strong="H3068"\w* Yahvé y sírvanle solo \w a|strong="H3068"\w* \w él|strong="H3605"\w*; \w entonces|strong="H5493"\w* \w él|strong="H3605"\w* \w los|strong="H3605"\w* \w librará|strong="H5337"\w* del \w poder|strong="H3027"\w* de \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w*”.  
\v 4 Así \w que|strong="H1121"\w* \w los|strong="H1121"\w* israelitas \w quitaron|strong="H5493"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* baales y \w a|strong="H3068"\w* las imágenes \w de|strong="H1121"\w* Astarot, y \w sirvieron|strong="H5647"\w* solo \w a|strong="H3068"\w* Yahvé.  
\v 5 Luego \w Samuel|strong="H8050"\w* les dijo: “Reúnan \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* en \w Mizpa|strong="H4709"\w*, y yo oraré \w a|strong="H3068"\w* Yahvé \w por|strong="H1157"\w* ustedes”.  
\v 6 \w Los|strong="H1121"\w* israelitas \w se|strong="H1931"\w* reunieron en \w Mizpa|strong="H4709"\w*, \w sacaron|strong="H7579"\w* \w agua|strong="H4325"\w* y \w la|strong="H1931"\w* \w derramaron|strong="H8210"\w* \w ante|strong="H6440"\w* Yahvé \w como|strong="H1931"\w* un acto \w de|strong="H6440"\w* humildad. \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* ayunaron y confesaron: “Hemos \w pecado|strong="H2398"\w* \w contra|strong="H6440"\w* Yahvé”. \w Fue|strong="H1931"\w* en \w Mizpa|strong="H4709"\w* \w donde|strong="H8033"\w* \w Samuel|strong="H8050"\w* comenzó \w a|strong="H3068"\w* actuar \w como|strong="H1931"\w* \w juez|strong="H8199"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* israelitas.   
\p
\v 7 \w Cuando|strong="H3588"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* supieron \w que|strong="H3588"\w* \w los|strong="H1121"\w* israelitas se habían reunido \w en|strong="H3588"\w* \w Mizpa|strong="H4709"\w*, \w los|strong="H1121"\w* jefes \w filisteos|strong="H6430"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* atacarlos. Al enterarse \w los|strong="H1121"\w* israelitas, tuvieron mucho \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*.  
\v 8 Entonces le rogaron \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “No dejes \w de|strong="H4480"\w* \w clamar|strong="H2199"\w* \w a|strong="H3068"\w* Yahvé nuestro \w Dios|strong="H3068"\w* \w por|strong="H4480"\w* nosotros, \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w nos|strong="H4480"\w* \w salve|strong="H3467"\w* \w del|strong="H4480"\w* \w poder|strong="H3027"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*”.  
\v 9 \w Samuel|strong="H8050"\w* \w tomó|strong="H3947"\w* un \w cordero|strong="H2924"\w* lechal y lo \w ofreció|strong="H5927"\w* completo como sacrificio quemado \w a|strong="H3068"\w* Yahvé. \w Clamó|strong="H2199"\w* \w a|strong="H3068"\w* Yahvé en favor de \w Israel|strong="H3478"\w*, y Yahvé \w le|strong="H1157"\w* \w respondió|strong="H6030"\w*.  
\v 10 Mientras \w Samuel|strong="H8050"\w* ofrecía \w el|strong="H1931"\w* sacrificio, \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w se|strong="H1961"\w* acercaron \w para|strong="H5921"\w* atacar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*. Pero \w en|strong="H5921"\w* \w ese|strong="H1931"\w* momento Yahvé lanzó un \w gran|strong="H1419"\w* trueno \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*; \w esto|strong="H1931"\w* \w les|strong="H5921"\w* causó tanta confusión \w que|strong="H1931"\w* \w fueron|strong="H1961"\w* derrotados \w ante|strong="H6440"\w* \w los|strong="H5921"\w* israelitas.  
\v 11 \w Los|strong="H7291"\w* hombres \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w salieron|strong="H3318"\w* \w de|strong="H4480"\w* \w Mizpa|strong="H4709"\w* \w y|strong="H5704"\w* \w persiguieron|strong="H7291"\w* \w a|strong="H3068"\w* \w los|strong="H7291"\w* \w filisteos|strong="H6430"\w*, \w hiriéndolos|strong="H5221"\w* \w hasta|strong="H5704"\w* llegar \w más|strong="H4480"\w* \w abajo|strong="H8478"\w* \w de|strong="H4480"\w* Bet Car.   
\p
\v 12 Entonces \w Samuel|strong="H8050"\w* \w tomó|strong="H3947"\w* una piedra \w y|strong="H5704"\w* la colocó entre \w Mizpa|strong="H4709"\w* \w y|strong="H5704"\w* Sen, \w y|strong="H5704"\w* le \w puso|strong="H7760"\w* \w por|strong="H5704"\w* \w nombre|strong="H8034"\w* Ebenezer, pues dijo: “\w Hasta|strong="H5704"\w* \w aquí|strong="H2008"\w* nos ha ayudado el \w Señor|strong="H3068"\w*”.  
\v 13 \w De|strong="H5750"\w* \w esta|strong="H1961"\w* manera \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w fueron|strong="H1961"\w* derrotados y \w no|strong="H3808"\w* volvieron \w a|strong="H3068"\w* invadir \w el|strong="H3605"\w* territorio \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*. \w Mientras|strong="H5750"\w* \w Samuel|strong="H8050"\w* \w vivió|strong="H3117"\w*, \w la|strong="H1366"\w* \w mano|strong="H3027"\w* \w de|strong="H5750"\w* Yahvé \w estuvo|strong="H1961"\w* \w contra|strong="H3478"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w*.   
\p
\v 14 \w Israel|strong="H3478"\w* \w recuperó|strong="H7725"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H5704"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* le \w habían|strong="H1961"\w* quitado, \w desde|strong="H5704"\w* \w Ecrón|strong="H6138"\w* \w hasta|strong="H5704"\w* Gat, \w y|strong="H5704"\w* liberó su territorio del control \w filisteo|strong="H6430"\w*. También \w hubo|strong="H1961"\w* \w paz|strong="H7965"\w* entre \w Israel|strong="H3478"\w* \w y|strong="H5704"\w* \w los|strong="H1961"\w* amorreos.   
\p
\v 15 \w Samuel|strong="H8050"\w* fue \w juez|strong="H8199"\w* de \w Israel|strong="H3478"\w* durante \w toda|strong="H3605"\w* su \w vida|strong="H2416"\w*.  
\v 16 \w Cada|strong="H3605"\w* \w año|strong="H8141"\w* recorría \w los|strong="H3605"\w* pueblos de Betel, \w Gilgal|strong="H1537"\w* y \w Mizpa|strong="H4709"\w*, y en \w todos|strong="H3605"\w* esos \w lugares|strong="H4725"\w* impartía justicia \w a|strong="H3068"\w* \w los|strong="H3605"\w* israelitas.  
\v 17 Después regresaba \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w*, \w donde|strong="H8033"\w* tenía \w su|strong="H3588"\w* \w casa|strong="H1004"\w* \w y|strong="H3588"\w* \w donde|strong="H8033"\w* también \w juzgaba|strong="H8199"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*. \w Allí|strong="H8033"\w* construyó un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé.   
\c 8  
\p
\v 1 \w Cuando|strong="H1961"\w* \w Samuel|strong="H8050"\w* \w envejeció|strong="H2204"\w*, nombró \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w como|strong="H1961"\w* \w jueces|strong="H8199"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 2 Su \w hijo|strong="H1121"\w* \w primogénito|strong="H1060"\w* \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* \w Joel|strong="H3100"\w*, y \w el|strong="H1121"\w* \w segundo|strong="H4932"\w*, Abías; ambos \w eran|strong="H1961"\w* \w jueces|strong="H8199"\w* en Berseba.  
\v 3 Pero sus \w hijos|strong="H1121"\w* \w no|strong="H3808"\w* \w siguieron|strong="H1980"\w* su buen ejemplo, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* dejaron llevar \w por|strong="H1870"\w* la ambición, aceptaron sobornos y pervirtieron la \w justicia|strong="H4941"\w*.   
\p
\v 4 Por eso, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ancianos|strong="H2205"\w* de \w Israel|strong="H3478"\w* se reunieron y fueron \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w* para hablar con \w Samuel|strong="H8050"\w*.  
\v 5 Le dijeron: “\w Mira|strong="H2009"\w*, \w tú|strong="H8199"\w* \w ya|strong="H6258"\w* eres \w viejo|strong="H2204"\w* y tus \w hijos|strong="H1121"\w* \w no|strong="H3808"\w* \w siguen|strong="H1980"\w* tus pasos. \w Por|strong="H1870"\w* \w lo|strong="H3808"\w* tanto, danos un \w rey|strong="H4428"\w* \w que|strong="H3808"\w* nos gobierne, como \w lo|strong="H3808"\w* tienen \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w*”.  
\v 6 \w A|strong="H3068"\w* \w Samuel|strong="H8050"\w* no \w le|strong="H5869"\w* gustó \w que|strong="H1697"\w* \w le|strong="H5869"\w* pidieran un \w rey|strong="H4428"\w* \w para|strong="H5414"\w* \w que|strong="H1697"\w* los \w gobernara|strong="H8199"\w*.  
\p Entonces \w Samuel|strong="H8050"\w* \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé.  
\v 7 \w Y|strong="H3068"\w* Yahvé \w le|strong="H5921"\w* respondió: “Hazle caso \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* pidan. \w No|strong="H3808"\w* \w es|strong="H3588"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w a|strong="H3068"\w* \w quien|strong="H3605"\w* han rechazado, \w sino|strong="H3588"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w*, \w pues|strong="H3588"\w* \w no|strong="H3808"\w* quieren \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w reine|strong="H4427"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 8 \w Están|strong="H2088"\w* \w haciendo|strong="H6213"\w* contigo \w lo|strong="H2088"\w* \w mismo|strong="H3605"\w* \w que|strong="H5704"\w* han \w hecho|strong="H6213"\w* \w desde|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H5704"\w* \w los|strong="H1992"\w* \w saqué|strong="H5927"\w* \w de|strong="H5704"\w* \w Egipto|strong="H4714"\w*: me han abandonado \w para|strong="H5704"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* otros dioses.  
\v 9 Hazles caso, \w pero|strong="H3588"\w* adviérteles seriamente \w y|strong="H3588"\w* diles cuáles \w serán|strong="H4941"\w* \w los|strong="H5921"\w* \w derechos|strong="H4941"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* gobernar”.   
\p
\v 10 \w Samuel|strong="H8050"\w* les comunicó \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* Yahvé había \w dicho|strong="H1697"\w* \w al|strong="H4428"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* le pedía un \w rey|strong="H4428"\w*.  
\v 11 \w Les|strong="H5921"\w* dijo: “\w Estos|strong="H2088"\w* \w serán|strong="H1961"\w* \w los|strong="H1121"\w* \w derechos|strong="H4941"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H5921"\w* \w los|strong="H1121"\w* gobernará: \w Él|strong="H5921"\w* \w tomará|strong="H3947"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* ustedes \w para|strong="H5921"\w* \w que|strong="H5921"\w* sirvan \w en|strong="H5921"\w* sus \w carros|strong="H4818"\w* \w de|strong="H5921"\w* guerra \w y|strong="H5921"\w* \w en|strong="H5921"\w* su caballería, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w corran|strong="H7323"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* su \w carro|strong="H4818"\w* \w real|strong="H4428"\w*.  
\v 12 \w A|strong="H3068"\w* unos los nombrará \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* mil soldados y \w a|strong="H3068"\w* otros \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* \w cincuenta|strong="H2572"\w*. \w A|strong="H3068"\w* otros los \w pondrá|strong="H7760"\w* \w a|strong="H3068"\w* labrar sus campos y \w a|strong="H3068"\w* levantar sus cosechas, \w o|strong="H3068"\w* \w a|strong="H3068"\w* fabricar sus \w armas|strong="H3627"\w* \w de|strong="H8269"\w* \w guerra|strong="H4421"\w* y los repuestos para sus \w carros|strong="H7393"\w*.  
\v 13 También \w tomará|strong="H3947"\w* \w a|strong="H3068"\w* sus \w hijas|strong="H1323"\w* de ustedes para \w que|strong="H1323"\w* sean perfumistas, \w cocineras|strong="H2879"\w* y panaderas.  
\v 14 Se apoderará \w de|strong="H5414"\w* los \w mejores|strong="H2896"\w* \w campos|strong="H7704"\w*, viñedos y \w olivares|strong="H2132"\w* \w de|strong="H5414"\w* ustedes, y se los \w dará|strong="H5414"\w* \w a|strong="H3068"\w* sus funcionarios.  
\v 15 Les exigirá la décima parte \w de|strong="H5414"\w* sus granos y \w de|strong="H5414"\w* sus cosechas \w para|strong="H5414"\w* \w dársela|strong="H5414"\w* \w a|strong="H3068"\w* sus oficiales y servidores.  
\v 16 También les \w quitará|strong="H3947"\w* \w a|strong="H3068"\w* sus servidores y servidoras, \w a|strong="H3068"\w* sus \w mejores|strong="H2896"\w* jóvenes y \w a|strong="H3068"\w* sus burros para \w el|strong="H6213"\w* beneficio de sus propios trabajos.  
\v 17 \w Se|strong="H1961"\w* \w quedará|strong="H1961"\w* con la décima parte de sus rebaños, y ustedes mismos terminarán siendo sus esclavos.  
\v 18 \w Cuando|strong="H3117"\w* llegue \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w gritarán|strong="H6030"\w* \w de|strong="H6440"\w* angustia \w por|strong="H6440"\w* \w causa|strong="H6440"\w* del \w rey|strong="H4428"\w* \w que|strong="H1931"\w* ustedes mismos hayan elegido, pero \w ese|strong="H1931"\w* \w día|strong="H3117"\w* Yahvé \w no|strong="H3808"\w* les \w responderá|strong="H6030"\w*”.   
\p
\v 19 \w Sin|strong="H3808"\w* embargo, \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* quiso \w escuchar|strong="H8085"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* insistió: “¡\w No|strong="H3808"\w* importa! Queremos \w tener|strong="H1961"\w* un \w rey|strong="H4428"\w*.  
\v 20 \w Así|strong="H1571"\w* \w seremos|strong="H1961"\w* \w como|strong="H1571"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w*; nuestro \w rey|strong="H4428"\w* nos \w gobernará|strong="H8199"\w*, \w irá|strong="H3318"\w* \w al|strong="H4428"\w* frente \w de|strong="H6440"\w* \w nosotros|strong="H3605"\w* \w y|strong="H1571"\w* \w peleará|strong="H3898"\w* nuestras \w batallas|strong="H4421"\w*”.   
\p
\v 21 \w Samuel|strong="H8050"\w* \w escuchó|strong="H8085"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H5971"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* decía y \w se|strong="H5971"\w* \w lo|strong="H1697"\w* repitió \w a|strong="H3068"\w* Yahvé.  
\v 22 \w Y|strong="H3068"\w* Yahvé le dijo: “Hazles caso y dales un \w rey|strong="H4428"\w*”.  
\p Entonces \w Samuel|strong="H8050"\w* les dijo \w a|strong="H3068"\w* los israelitas: “Regrese cada uno \w a|strong="H3068"\w* su \w ciudad|strong="H5892"\w*”.   
\c 9  
\p
\v 1 \w Había|strong="H1961"\w* un \w hombre|strong="H1121"\w* \w de|strong="H1121"\w* la tribu \w de|strong="H1121"\w* Benjamín \w llamado|strong="H8034"\w* \w Cis|strong="H7027"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abiel y descendiente \w de|strong="H1121"\w* Zeror, Becorat y Afía. \w Era|strong="H1961"\w* un \w hombre|strong="H1121"\w* muy importante y \w valiente|strong="H1368"\w*.  
\v 2 \w Tenía|strong="H1961"\w* un \w hijo|strong="H1121"\w* \w llamado|strong="H8034"\w* \w Saúl|strong="H7586"\w*, un joven \w muy|strong="H4605"\w* apuesto. \w No|strong="H1961"\w* \w había|strong="H1961"\w* \w entre|strong="H4480"\w* \w los|strong="H1121"\w* israelitas \w nadie|strong="H3605"\w* \w más|strong="H4480"\w* \w bien|strong="H2896"\w* parecido \w que|strong="H4480"\w* \w él|strong="H3605"\w*; \w era|strong="H1961"\w* tan \w alto|strong="H1364"\w* \w que|strong="H4480"\w* le sacaba una cabeza \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* demás.   
\p
\v 3 Un \w día|strong="H1121"\w* se le perdieron \w los|strong="H1121"\w* burros \w a|strong="H3068"\w* \w Cis|strong="H7027"\w*, \w el|strong="H1121"\w* padre \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*. Entonces \w Cis|strong="H7027"\w* le dijo \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Saúl|strong="H7586"\w*: “\w Toma|strong="H3947"\w* \w a|strong="H3068"\w* uno \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w criados|strong="H5288"\w* y \w vete|strong="H3212"\w* \w a|strong="H3068"\w* buscar \w los|strong="H1121"\w* burros”.  
\v 4 Saúl recorrió la región montañosa de Efraín y la tierra de Salisá, pero \w no|strong="H3808"\w* los encontraron. \w Pasaron|strong="H5674"\w* por la tierra de Saalim y por \w el|strong="H5674"\w* territorio de Benjamín, pero \w tampoco|strong="H3808"\w* \w hallaron|strong="H4672"\w* \w nada|strong="H3808"\w*.   
\p
\v 5 Cuando llegaron \w a|strong="H3068"\w* la región \w de|strong="H4480"\w* Zuf, \w Saúl|strong="H7586"\w* \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w criado|strong="H5288"\w*: “Regresemos, \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H4480"\w* mi padre empiece \w a|strong="H3068"\w* preocuparse \w más|strong="H4480"\w* \w por|strong="H4480"\w* \w nosotros|strong="H5973"\w* \w que|strong="H4480"\w* \w por|strong="H4480"\w* \w los|strong="H1992"\w* burros”.   
\p
\v 6 Pero \w el|strong="H5921"\w* criado \w le|strong="H5921"\w* respondió: “Mire, \w en|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* vive un hombre \w de|strong="H5921"\w* Dios muy respetado. \w Todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H6258"\w* \w él|strong="H5921"\w* \w dice|strong="H1696"\w* \w se|strong="H5921"\w* cumple sin falta. \w Vamos|strong="H3212"\w* \w allá|strong="H8033"\w*; \w tal|strong="H2063"\w* vez \w él|strong="H5921"\w* pueda decirnos \w por|strong="H5921"\w* \w dónde|strong="H8033"\w* \w ir|strong="H3212"\w*”.   
\p
\v 7 \w Saúl|strong="H7586"\w* le dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w criado|strong="H5288"\w*: “Está \w bien|strong="H3588"\w*, \w vamos|strong="H3212"\w*. \w Pero|strong="H3588"\w* ¿\w qué|strong="H3588"\w* le podemos llevar? \w Ya|strong="H3068"\w* \w no|strong="H3588"\w* tenemos \w pan|strong="H3899"\w* \w en|strong="H3588"\w* nuestras \w alforjas|strong="H3627"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* tenemos ningún regalo \w que|strong="H3588"\w* ofrecerle al hombre \w de|strong="H3588"\w* Dios. ¿\w Qué|strong="H3588"\w* \w nos|strong="H4100"\w* queda?”.   
\p
\v 8 El \w criado|strong="H5288"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* decirle: “Mire, \w aquí|strong="H2009"\w* tengo \w una|strong="H4672"\w* pequeña moneda \w de|strong="H5414"\w* \w plata|strong="H3701"\w*. Se la \w daré|strong="H5414"\w* al hombre \w de|strong="H5414"\w* Dios \w para|strong="H5414"\w* \w que|strong="H3027"\w* nos indique el \w camino|strong="H1870"\w*”.  
\v 9 (\w Antiguamente|strong="H6440"\w* \w en|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w cuando|strong="H3588"\w* alguien \w iba|strong="H3212"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Dios, decía: “\w Vamos|strong="H3212"\w* \w a|strong="H3068"\w* ver \w al|strong="H5704"\w* vidente”; \w porque|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* \w hoy|strong="H3117"\w* llamamos \w profetas|strong="H5030"\w*, \w antes|strong="H6440"\w* se les \w llamaba|strong="H7121"\w* videntes).   
\p
\v 10 “Muy \w bien|strong="H2896"\w*”, dijo \w Saúl|strong="H7586"\w*, “\w vamos|strong="H3212"\w*”. \w Y|strong="H3068"\w* se dirigieron \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* \w donde|strong="H8033"\w* estaba el hombre \w de|strong="H1697"\w* Dios.  
\v 11 Mientras \w subían|strong="H5927"\w* la cuesta hacia la \w ciudad|strong="H5892"\w*, \w se|strong="H1992"\w* encontraron con unas jóvenes \w que|strong="H4325"\w* \w salían|strong="H3318"\w* \w a|strong="H3068"\w* sacar \w agua|strong="H4325"\w* y \w les|strong="H1992"\w* preguntaron: “¿\w Está|strong="H2088"\w* \w por|strong="H2088"\w* \w aquí|strong="H2088"\w* \w el|strong="H1992"\w* vidente?”.   
\p
\v 12 \w Ellas|strong="H2009"\w* les \w respondieron|strong="H6030"\w*: “\w Sí|strong="H3588"\w*, \w allá|strong="H6440"\w* \w va|strong="H3068"\w*, adelante \w de|strong="H3588"\w* ustedes. Apúrense, \w porque|strong="H3588"\w* acaba \w de|strong="H3588"\w* llegar \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w para|strong="H3588"\w* presidir \w el|strong="H3588"\w* \w sacrificio|strong="H2077"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* ofrece \w hoy|strong="H3117"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* lugar \w de|strong="H3588"\w* adoración.  
\v 13 \w En|strong="H5704"\w* \w cuanto|strong="H3588"\w* entren \w en|strong="H5704"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*, \w lo|strong="H1931"\w* encontrarán \w antes|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w suba|strong="H5927"\w* \w a|strong="H3068"\w* comer \w al|strong="H5704"\w* lugar \w de|strong="H3588"\w* \w los|strong="H1931"\w* \w sacrificios|strong="H2077"\w*. \w El|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* comerá \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w él|strong="H1931"\w* llegue, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w tiene|strong="H1931"\w* \w que|strong="H3588"\w* bendecir \w el|strong="H1931"\w* \w sacrificio|strong="H2077"\w*; \w después|strong="H5704"\w* \w de|strong="H3588"\w* \w eso|strong="H3651"\w* comerán \w los|strong="H1931"\w* invitados. Vayan \w ahora|strong="H6258"\w* \w mismo|strong="H1931"\w* \w y|strong="H3588"\w* \w lo|strong="H1931"\w* encontrarán”.   
\p
\v 14 \w Ellos|strong="H1992"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* y, al entrar, \w se|strong="H1992"\w* encontraron con \w Samuel|strong="H8050"\w*, \w que|strong="H1992"\w* \w venía|strong="H5927"\w* hacia \w ellos|strong="H1992"\w* para \w subir|strong="H5927"\w* al lugar de adoración.   
\p
\v 15 Un \w día|strong="H3117"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w que|strong="H3117"\w* \w Saúl|strong="H7586"\w* llegara, Yahvé le había revelado \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w* lo siguiente:  
\v 16 “\w Mañana|strong="H4279"\w*, \w a|strong="H3068"\w* \w esta|strong="H5921"\w* misma \w hora|strong="H6256"\w*, \w te|strong="H5921"\w* \w enviaré|strong="H7971"\w* \w a|strong="H3068"\w* un hombre \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Benjamín|strong="H1144"\w*. Ungirlo \w como|strong="H3588"\w* jefe \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. \w Él|strong="H5921"\w* \w salvará|strong="H3467"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w del|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*, \w porque|strong="H3588"\w* he \w visto|strong="H7200"\w* \w el|strong="H5921"\w* sufrimiento \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w y|strong="H3588"\w* sus gritos han llegado \w hasta|strong="H5921"\w* \w mí|strong="H5921"\w*”.   
\p
\v 17 Cuando \w Samuel|strong="H8050"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, Yahvé le dijo: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* el hombre del \w que|strong="H5971"\w* te \w hablé|strong="H6030"\w*; él gobernará \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w pueblo|strong="H5971"\w*”.   
\p
\v 18 \w Saúl|strong="H7586"\w* se \w acercó|strong="H5066"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w* \w en|strong="H8432"\w* la \w puerta|strong="H8179"\w* de la ciudad y le preguntó: “¿Podría decirme dónde \w está|strong="H2088"\w* la \w casa|strong="H1004"\w* del vidente?”.   
\p
\v 19 \w Samuel|strong="H8050"\w* \w le|strong="H5973"\w* \w respondió|strong="H6030"\w*: “Yo soy \w el|strong="H5973"\w* vidente. \w Sube|strong="H5927"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* \w mí|strong="H6030"\w* al lugar \w de|strong="H6440"\w* adoración y quédate \w a|strong="H3068"\w* comer \w conmigo|strong="H5973"\w* \w hoy|strong="H3117"\w*. \w Mañana|strong="H1242"\w* temprano \w te|strong="H5973"\w* diré \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3117"\w* quieres \w saber|strong="H5046"\w* y \w te|strong="H5973"\w* \w dejaré|strong="H7971"\w* \w ir|strong="H7971"\w*.  
\v 20 \w En|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* burros \w que|strong="H3588"\w* \w se|strong="H3808"\w* \w te|strong="H3588"\w* perdieron hace \w tres|strong="H7969"\w* \w días|strong="H3117"\w*, \w no|strong="H3808"\w* \w te|strong="H3588"\w* preocupes, ya \w los|strong="H3605"\w* encontraron. \w Además|strong="H3588"\w*, ¿\w a|strong="H3068"\w* \w quién|strong="H4310"\w* pertenece \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* mejor \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w sino|strong="H3588"\w* \w a|strong="H3068"\w* ti \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* tu \w familia|strong="H1004"\w*?”.   
\p
\v 21 \w Saúl|strong="H7586"\w* \w respondió|strong="H6030"\w*: “¿Acaso \w no|strong="H3808"\w* soy yo \w de|strong="H1697"\w* \w la|strong="H3605"\w* \w tribu|strong="H7626"\w* \w de|strong="H1697"\w* \w Benjamín|strong="H1144"\w*, \w la|strong="H3605"\w* \w más|strong="H6030"\w* \w pequeña|strong="H6996"\w* \w de|strong="H1697"\w* \w Israel|strong="H3478"\w*? ¿\w Y|strong="H3068"\w* \w no|strong="H3808"\w* \w es|strong="H2088"\w* \w mi|strong="H6030"\w* \w familia|strong="H4940"\w* \w la|strong="H3605"\w* \w más|strong="H6030"\w* humilde \w de|strong="H1697"\w* \w todas|strong="H3605"\w* las \w familias|strong="H4940"\w* \w de|strong="H1697"\w* \w mi|strong="H6030"\w* \w tribu|strong="H7626"\w*? ¿\w Por|strong="H1697"\w* \w qué|strong="H4100"\w* me \w habla|strong="H1696"\w* usted \w de|strong="H1697"\w* esa \w manera|strong="H1697"\w*?”.   
\p
\v 22 Entonces \w Samuel|strong="H8050"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w criado|strong="H5288"\w* al salón \w de|strong="H5414"\w* banquetes y \w los|strong="H1992"\w* sentó en \w el|strong="H1992"\w* \w lugar|strong="H4725"\w* \w de|strong="H5414"\w* honor entre \w los|strong="H1992"\w* invitados, \w que|strong="H1992"\w* eran \w unos|strong="H1992"\w* \w treinta|strong="H7970"\w* hombres.  
\v 23 Luego \w Samuel|strong="H8050"\w* \w le|strong="H5973"\w* dijo al cocinero: “\w Trae|strong="H5414"\w* la \w porción|strong="H4490"\w* \w de|strong="H5973"\w* carne que \w te|strong="H5973"\w* \w di|strong="H5414"\w* y que \w te|strong="H5973"\w* pedí que reservaras”.  
\v 24 \w El|strong="H1931"\w* cocinero tomó \w el|strong="H1931"\w* muslo \w de|strong="H5921"\w* \w la|strong="H1931"\w* pieza \w y|strong="H3588"\w* \w lo|strong="H1931"\w* \w puso|strong="H7760"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*. \w Samuel|strong="H8050"\w* dijo: “\w Aquí|strong="H2009"\w* tienes \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w se|strong="H1931"\w* reservó \w para|strong="H5921"\w* \w ti|strong="H5921"\w*. Come, \w porque|strong="H3588"\w* \w se|strong="H1931"\w* \w guardó|strong="H8104"\w* especialmente \w para|strong="H5921"\w* \w esta|strong="H1931"\w* ocasión, \w desde|strong="H5921"\w* \w que|strong="H3588"\w* dije \w que|strong="H3588"\w* invité \w al|strong="H5921"\w* \w pueblo|strong="H5971"\w*”. \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* comió \w con|strong="H5973"\w* \w Samuel|strong="H8050"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*.   
\p
\v 25 Cuando \w bajaron|strong="H3381"\w* \w del|strong="H5921"\w* lugar \w de|strong="H5921"\w* adoración \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, Samuel estuvo platicando \w con|strong="H5973"\w* \w Saúl|strong="H7586"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* azotea \w de|strong="H5921"\w* \w la|strong="H5921"\w* casa.  
\v 26 Al día siguiente \w se|strong="H1961"\w* \w levantaron|strong="H6965"\w* al amanecer. \w Samuel|strong="H8050"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, \w que|strong="H1931"\w* \w estaba|strong="H1961"\w* \w en|strong="H3318"\w* \w la|strong="H1931"\w* azotea, y \w le|strong="H1931"\w* dijo: “¡\w Levántate|strong="H6965"\w*, \w que|strong="H1931"\w* ya \w es|strong="H1931"\w* hora de \w que|strong="H1931"\w* te vayas!”. \w Saúl|strong="H7586"\w* \w se|strong="H1961"\w* \w levantó|strong="H6965"\w*, y \w los|strong="H1931"\w* \w dos|strong="H8147"\w* \w salieron|strong="H3318"\w* juntos \w a|strong="H3068"\w* \w la|strong="H1931"\w* calle.  
\v 27 \w Cuando|strong="H3117"\w* ya \w iban|strong="H5674"\w* llegando \w a|strong="H3068"\w* la salida \w de|strong="H6440"\w* la \w ciudad|strong="H5892"\w*, \w Samuel|strong="H8050"\w* le dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “Dile al \w criado|strong="H5288"\w* \w que|strong="H1697"\w* \w se|strong="H1992"\w* adelante un poco”. \w El|strong="H5674"\w* \w criado|strong="H5288"\w* \w se|strong="H1992"\w* adelantó, y \w Samuel|strong="H8050"\w* añadió: “Tú quédate aquí un momento, \w porque|strong="H6440"\w* tengo un mensaje \w de|strong="H6440"\w* Dios para ti”.   
\c 10  
\p
\v 1 \w Entonces|strong="H3588"\w* \w Samuel|strong="H8050"\w* \w tomó|strong="H3947"\w* una vasija \w de|strong="H5921"\w* \w aceite|strong="H8081"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* \w derramó|strong="H3332"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* Saúl. Luego \w lo|strong="H3808"\w* \w besó|strong="H5401"\w* \w y|strong="H3588"\w* \w le|strong="H5921"\w* dijo: “Yahvé \w te|strong="H5921"\w* \w ha|strong="H3808"\w* \w ungido|strong="H4886"\w* hoy \w como|strong="H3588"\w* \w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* pueblo.  
\v 2 \w Cuando|strong="H3117"\w* \w te|strong="H5973"\w* apartes \w de|strong="H5973"\w* \w mí|strong="H2009"\w* \w el|strong="H5973"\w* \w día|strong="H3117"\w* \w de|strong="H5973"\w* \w hoy|strong="H3117"\w*, encontrarás \w a|strong="H3068"\w* \w dos|strong="H8147"\w* \w hombres|strong="H1121"\w* \w cerca|strong="H5973"\w* \w de|strong="H5973"\w* \w la|strong="H1366"\w* tumba \w de|strong="H5973"\w* Raquel, \w en|strong="H5973"\w* Zelza, \w en|strong="H5973"\w* \w el|strong="H5973"\w* territorio \w de|strong="H5973"\w* \w Benjamín|strong="H1144"\w*. Ellos \w te|strong="H5973"\w* dirán: “\w Ya|strong="H3068"\w* encontramos \w los|strong="H1121"\w* asnos \w que|strong="H4100"\w* \w fuiste|strong="H1980"\w* \w a|strong="H3068"\w* buscar; \w ahora|strong="H3117"\w* \w tu|strong="H6213"\w* padre ya \w no|strong="H6213"\w* está preocupado \w por|strong="H1697"\w* \w los|strong="H1121"\w* \w animales|strong="H1121"\w*, sino \w que|strong="H4100"\w* está angustiado \w por|strong="H1697"\w* ustedes y \w se|strong="H4100"\w* pregunta: ¿\w Qué|strong="H4100"\w* \w haré|strong="H6213"\w* \w para|strong="H5973"\w* encontrar \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w hijo|strong="H1121"\w*?””.   
\p
\v 3 “\w De|strong="H5704"\w* \w allí|strong="H8033"\w* seguirás \w adelante|strong="H5704"\w* \w hasta|strong="H5704"\w* llegar \w a|strong="H3068"\w* la encina \w de|strong="H5704"\w* \w Tabor|strong="H8396"\w*. \w Allí|strong="H8033"\w* te encontrarás \w con|strong="H5704"\w* \w tres|strong="H7969"\w* hombres \w que|strong="H5704"\w* \w van|strong="H5927"\w* \w a|strong="H3068"\w* Betel \w para|strong="H5704"\w* adorar \w a|strong="H3068"\w* Dios. Uno \w llevará|strong="H5375"\w* \w tres|strong="H7969"\w* \w cabritos|strong="H1423"\w*, otro \w tres|strong="H7969"\w* \w panes|strong="H3899"\w* \w y|strong="H5704"\w* \w el|strong="H1008"\w* \w tercero|strong="H7969"\w* un frasco \w de|strong="H5704"\w* \w vino|strong="H3196"\w*.  
\v 4 \w Ellos|strong="H3027"\w* te saludarán y te \w darán|strong="H5414"\w* \w dos|strong="H8147"\w* \w de|strong="H5414"\w* los \w panes|strong="H3899"\w*, los cuales deberás aceptar.   
\p
\v 5 “\w Después|strong="H1961"\w* llegarás \w a|strong="H3068"\w* la colina \w de|strong="H6440"\w* Dios, \w donde|strong="H8033"\w* \w hay|strong="H1961"\w* un destacamento \w de|strong="H6440"\w* \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w*. Al entrar en la \w ciudad|strong="H5892"\w*, te toparás con un grupo \w de|strong="H6440"\w* \w profetas|strong="H5030"\w* \w que|strong="H1961"\w* bajan del lugar \w de|strong="H6440"\w* adoración precedidos \w por|strong="H6440"\w* músicos \w que|strong="H1961"\w* tocan liras, panderos, \w flautas|strong="H2485"\w* y \w arpas|strong="H3658"\w*, mientras \w ellos|strong="H1992"\w* van \w profetizando|strong="H5012"\w*.  
\v 6 \w En|strong="H5921"\w* ese momento \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Yahvé vendrá \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w con|strong="H5973"\w* poder; \w profetizarás|strong="H5012"\w* \w con|strong="H5973"\w* \w ellos|strong="H5921"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* convertirás \w en|strong="H5921"\w* un hombre diferente.  
\v 7 \w Cuando|strong="H3588"\w* \w se|strong="H1961"\w* cumplan \w estas|strong="H6213"\w* señales \w en|strong="H5973"\w* \w ti|strong="H5973"\w*, \w haz|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* creas \w que|strong="H3588"\w* debes \w hacer|strong="H6213"\w*, \w porque|strong="H3588"\w* Dios \w está|strong="H1961"\w* \w contigo|strong="H5973"\w*.   
\p
\v 8 “\w Baja|strong="H3381"\w* \w antes|strong="H6440"\w* \w que|strong="H5704"\w* \w yo|strong="H2009"\w* \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w*; allí me reuniré \w contigo|strong="H6440"\w* \w para|strong="H5704"\w* ofrecer \w sacrificios|strong="H2077"\w* quemados \w y|strong="H5704"\w* ofrendas \w de|strong="H6440"\w* paz. Pero debes \w esperar|strong="H3176"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w yo|strong="H2009"\w* llegue \w y|strong="H5704"\w* te diga \w lo|strong="H6213"\w* \w que|strong="H5704"\w* \w tienes|strong="H3045"\w* \w que|strong="H5704"\w* \w hacer|strong="H6213"\w*”.  
\v 9 \w Sucedió|strong="H1961"\w* \w que|strong="H1931"\w*, \w en|strong="H5973"\w* cuanto Saúl \w se|strong="H1961"\w* dio \w la|strong="H1931"\w* \w vuelta|strong="H2015"\w* \w para|strong="H1961"\w* dejar \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, Dios cambió \w su|strong="H1931"\w* \w corazón|strong="H3820"\w*, y \w todas|strong="H3605"\w* aquellas señales \w se|strong="H1961"\w* cumplieron \w ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*.  
\v 10 Cuando llegaron \w a|strong="H3068"\w* \w la|strong="H5921"\w* colina, un grupo \w de|strong="H5921"\w* \w profetas|strong="H5030"\w* salió \w a|strong="H3068"\w* su encuentro. Entonces \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios vino \w sobre|strong="H5921"\w* Saúl \w con|strong="H5921"\w* poder, \w y|strong="H5921"\w* \w él|strong="H5921"\w* comenzó \w a|strong="H3068"\w* profetizar \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 11 \w Todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H4100"\w* \w lo|strong="H4100"\w* \w conocían|strong="H3045"\w* \w de|strong="H5973"\w* \w antes|strong="H2088"\w*, al verlo profetizar \w con|strong="H5973"\w* \w los|strong="H1121"\w* \w profetas|strong="H5030"\w*, \w se|strong="H3045"\w* preguntaban unos \w a|strong="H3068"\w* otros: “¿\w Qué|strong="H4100"\w* \w le|strong="H5973"\w* ha pasado al \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* \w Cis|strong="H7027"\w*? ¿\w A|strong="H3068"\w* poco \w también|strong="H1571"\w* \w Saúl|strong="H7586"\w* \w es|strong="H1961"\w* \w profeta|strong="H5030"\w*?”.   
\p
\v 12 Alguien \w de|strong="H5921"\w* ese lugar \w respondió|strong="H6030"\w*: “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* \w es|strong="H1961"\w* \w el|strong="H5921"\w* padre \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*?”. \w De|strong="H5921"\w* \w ahí|strong="H8033"\w* viene \w el|strong="H5921"\w* dicho: “¿\w También|strong="H1571"\w* \w Saúl|strong="H7586"\w* \w es|strong="H1961"\w* \w profeta|strong="H5030"\w*?”.  
\v 13 Cuando Saúl terminó de profetizar, subió al lugar de adoración.   
\p
\v 14 \w El|strong="H3588"\w* \w tío|strong="H1730"\w* \w de|strong="H3588"\w* \w Saúl|strong="H7586"\w* les preguntó \w a|strong="H3068"\w* \w él|strong="H3588"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w criado|strong="H5288"\w*: “¿\w A|strong="H3068"\w* dónde \w fueron|strong="H1980"\w* ustedes?”. \w Saúl|strong="H7586"\w* respondió: “Fuimos \w a|strong="H3068"\w* buscar \w los|strong="H3588"\w* burros, \w pero|strong="H3588"\w* \w como|strong="H3588"\w* \w no|strong="H3588"\w* \w los|strong="H3588"\w* encontrábamos, fuimos \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*”.   
\p
\v 15 El \w tío|strong="H1730"\w* de \w Saúl|strong="H7586"\w* le \w dijo|strong="H5046"\w*: “\w Por|strong="H4100"\w* favor, cuéntame \w qué|strong="H4100"\w* les \w dijo|strong="H5046"\w* \w Samuel|strong="H8050"\w*”.   
\p
\v 16 \w Saúl|strong="H7586"\w* le contestó: “Nos aseguró \w que|strong="H3588"\w* ya habían encontrado \w los|strong="H3588"\w* asnos”. \w Pero|strong="H3588"\w* \w no|strong="H3808"\w* le \w contó|strong="H5046"\w* \w nada|strong="H3808"\w* \w de|strong="H3588"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w Samuel|strong="H8050"\w* le \w había|strong="H4672"\w* \w dicho|strong="H1697"\w* sobre \w el|strong="H3588"\w* \w reino|strong="H4410"\w*.   
\p
\v 17 Después \w Samuel|strong="H8050"\w* \w convocó|strong="H6817"\w* al \w pueblo|strong="H5971"\w* ante Yahvé en \w Mizpa|strong="H4709"\w*,  
\v 18 \w y|strong="H3541"\w* les dijo \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas: “\w Así|strong="H3541"\w* dice Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: “Yo \w saqué|strong="H5927"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w de|strong="H1121"\w* \w Egipto|strong="H4714"\w*; \w los|strong="H1121"\w* \w libré|strong="H5337"\w* del \w poder|strong="H3027"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w egipcios|strong="H4714"\w* \w y|strong="H3541"\w* \w de|strong="H1121"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w reinos|strong="H4467"\w* \w que|strong="H1121"\w* \w los|strong="H1121"\w* oprimían”.  
\v 19 \w Pero|strong="H3588"\w* \w hoy|strong="H3117"\w* ustedes han rechazado \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w Dios|strong="H3068"\w*, \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w salva|strong="H3467"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w sus|strong="H1931"\w* \w aflicciones|strong="H7451"\w* \w y|strong="H3588"\w* \w angustias|strong="H6869"\w*, \w y|strong="H3588"\w* \w le|strong="H1931"\w* han dicho: “\w No|strong="H3588"\w*, mejor danos un \w rey|strong="H4428"\w*”. \w Por|strong="H5921"\w* \w lo|strong="H1931"\w* \w tanto|strong="H5921"\w*, preséntense \w ahora|strong="H6258"\w* \w ante|strong="H6440"\w* Yahvé \w por|strong="H5921"\w* \w tribus|strong="H7626"\w* \w y|strong="H3588"\w* \w por|strong="H5921"\w* familias”.   
\p
\v 20 \w Samuel|strong="H8050"\w* hizo \w que|strong="H3605"\w* se acercaran \w todas|strong="H3605"\w* las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w*, y \w la|strong="H3605"\w* suerte cayó sobre \w la|strong="H3605"\w* \w tribu|strong="H7626"\w* de \w Benjamín|strong="H1144"\w*.  
\v 21 Luego hizo \w que|strong="H3808"\w* \w se|strong="H3808"\w* acercara la \w tribu|strong="H7626"\w* \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w* por \w familias|strong="H4940"\w*, y cayó la suerte sobre la \w familia|strong="H4940"\w* \w de|strong="H1121"\w* Matri. Finalmente, la suerte cayó sobre \w Saúl|strong="H7586"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Cis|strong="H7027"\w*. Pero cuando \w lo|strong="H3808"\w* \w buscaron|strong="H1245"\w*, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* pudieron encontrar.  
\v 22 \w Así|strong="H1931"\w* \w que|strong="H1931"\w* volvieron \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé: “¿Ha venido ya \w ese|strong="H1931"\w* hombre \w aquí|strong="H2009"\w*?”. Yahvé respondió: “\w Sí|strong="H1931"\w*, \w está|strong="H1931"\w* \w escondido|strong="H2244"\w* entre \w el|strong="H1931"\w* equipaje”.   
\p
\v 23 \w Corrieron|strong="H7323"\w* y \w lo|strong="H3605"\w* sacaron \w de|strong="H5971"\w* \w allí|strong="H8033"\w*. Cuando Saúl \w se|strong="H5971"\w* puso \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5971"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w*, \w se|strong="H5971"\w* dieron cuenta \w de|strong="H5971"\w* \w que|strong="H5971"\w* era tan \w alto|strong="H1361"\w* \w que|strong="H5971"\w* les sacaba una cabeza \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* demás.  
\v 24 \w Samuel|strong="H8050"\w* le dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*: “¿\w Ya|strong="H3068"\w* \w vieron|strong="H7200"\w* \w al|strong="H4428"\w* hombre \w que|strong="H3588"\w* Yahvé ha elegido? ¡\w No|strong="H3588"\w* hay \w nadie|strong="H3605"\w* \w como|strong="H3588"\w* \w él|strong="H3588"\w* \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*!”. \w Entonces|strong="H3588"\w* \w todos|strong="H3605"\w* gritaron: “¡\w Viva|strong="H2421"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w*!”.   
\p
\v 25 Luego \w Samuel|strong="H8050"\w* le explicó al \w pueblo|strong="H5971"\w* \w los|strong="H3605"\w* \w derechos|strong="H4941"\w* y deberes del \w reino|strong="H4410"\w*, \w los|strong="H3605"\w* \w escribió|strong="H3789"\w* en un \w libro|strong="H5612"\w* y \w lo|strong="H5612"\w* \w puso|strong="H3240"\w* \w ante|strong="H6440"\w* Yahvé. Después \w de|strong="H6440"\w* esto, \w Samuel|strong="H8050"\w* \w mandó|strong="H1696"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w de|strong="H6440"\w* regreso \w a|strong="H3068"\w* sus \w casas|strong="H1004"\w*.  
\v 26 \w También|strong="H1571"\w* \w Saúl|strong="H7586"\w* regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* \w en|strong="H5973"\w* \w Gabaa|strong="H1390"\w*, acompañado por un grupo \w de|strong="H5973"\w* guerreros \w a|strong="H3068"\w* quienes Dios \w les|strong="H5973"\w* había tocado \w el|strong="H5973"\w* \w corazón|strong="H3820"\w*.  
\v 27 Pero algunos \w hombres|strong="H1121"\w* \w perversos|strong="H1121"\w* dijeron: “¿\w Y|strong="H3068"\w* \w este|strong="H2088"\w* \w es|strong="H1961"\w* \w el|strong="H1121"\w* \w que|strong="H4100"\w* \w nos|strong="H4100"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w salvar|strong="H3467"\w*?”. \w Lo|strong="H4100"\w* despreciaron y \w no|strong="H3808"\w* le llevaron \w ningún|strong="H3808"\w* regalo, pero Saúl \w no|strong="H3808"\w* les hizo caso.   
\c 11  
\p
\v 1 \w Por|strong="H5921"\w* \w aquel|strong="H3605"\w* tiempo, Nahas \w el|strong="H5921"\w* amonita \w subió|strong="H5927"\w* \w con|strong="H5921"\w* su ejército \w y|strong="H5921"\w* sitió \w a|strong="H3068"\w* \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* \w Jabes|strong="H3003"\w* \w de|strong="H5921"\w* \w Galaad|strong="H1568"\w*. \w Todos|strong="H3605"\w* \w los|strong="H5921"\w* hombres \w de|strong="H5921"\w* \w Jabes|strong="H3003"\w* \w le|strong="H5921"\w* dijeron \w a|strong="H3068"\w* Nahas: “\w Haz|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w serviremos|strong="H5647"\w*”.   
\p
\v 2 Pero Nahas \w el|strong="H5921"\w* amonita \w les|strong="H5921"\w* respondió: “Aceptaré \w el|strong="H5921"\w* pacto \w con|strong="H5921"\w* ustedes solo bajo \w esta|strong="H2063"\w* condición: \w que|strong="H5921"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* uno \w le|strong="H5921"\w* saquen \w el|strong="H5921"\w* \w ojo|strong="H5869"\w* \w derecho|strong="H3225"\w*. \w Así|strong="H2063"\w* humillaré \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 3 \w Los|strong="H3605"\w* \w ancianos|strong="H2205"\w* de \w Jabes|strong="H3003"\w* le dijeron: “\w Danos|strong="H7503"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* de tregua para enviar \w mensajeros|strong="H4397"\w* por \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio de \w Israel|strong="H3478"\w*. Si después de ese \w tiempo|strong="H3117"\w* no hay \w nadie|strong="H3605"\w* \w que|strong="H3117"\w* nos \w salve|strong="H3467"\w*, nos entregaremos \w a|strong="H3068"\w* ti”.  
\v 4 Cuando \w los|strong="H3605"\w* \w mensajeros|strong="H4397"\w* llegaron \w a|strong="H3068"\w* \w Gabaa|strong="H1390"\w*, \w la|strong="H3605"\w* ciudad \w de|strong="H5971"\w* \w Saúl|strong="H7586"\w*, y dieron \w la|strong="H3605"\w* noticia, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* \w puso|strong="H5375"\w* \w a|strong="H3068"\w* llorar \w a|strong="H3068"\w* gritos.   
\p
\v 5 \w En|strong="H4480"\w* ese momento venía \w Saúl|strong="H7586"\w* \w del|strong="H4480"\w* \w campo|strong="H7704"\w*, caminando detrás \w de|strong="H4480"\w* sus \w bueyes|strong="H1241"\w*, \w y|strong="H3588"\w* preguntó: “¿\w Qué|strong="H3588"\w* le pasa \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w*? ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w están|strong="H2009"\w* \w llorando|strong="H1058"\w*?”. \w Entonces|strong="H3588"\w* le \w contaron|strong="H1697"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* habían \w dicho|strong="H1697"\w* \w los|strong="H3588"\w* hombres \w de|strong="H4480"\w* \w Jabes|strong="H3003"\w*.  
\v 6 \w Al|strong="H5921"\w* \w oír|strong="H8085"\w* \w esto|strong="H1697"\w*, \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios vino \w sobre|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w con|strong="H5921"\w* poder, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w se|strong="H5921"\w* enfureció muchísimo.  
\v 7 \w Tomó|strong="H3947"\w* una pareja \w de|strong="H5921"\w* \w bueyes|strong="H1241"\w*, \w los|strong="H5921"\w* descuartizó \w y|strong="H5921"\w* \w envió|strong="H7971"\w* \w los|strong="H5921"\w* pedazos \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* territorio \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w con|strong="H5921"\w* este mensaje: “\w Así|strong="H3541"\w* \w le|strong="H5921"\w* \w pasará|strong="H3318"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w bueyes|strong="H1241"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w aquel|strong="H3605"\w* \w que|strong="H5921"\w* \w no|strong="H6213"\w* \w salga|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w y|strong="H5921"\w* \w Samuel|strong="H8050"\w*”. \w El|strong="H5921"\w* \w temor|strong="H6343"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* apoderó \w del|strong="H5921"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* guerra \w como|strong="H5921"\w* un solo hombre.  
\v 8 Saúl \w los|strong="H1121"\w* reunió en Bezec \w para|strong="H1961"\w* contarlos: \w había|strong="H1961"\w* \w trescientos|strong="H7969"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w treinta|strong="H7970"\w* \w mil|strong="H3967"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 9 Luego les dijeron \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w mensajeros|strong="H4397"\w* \w que|strong="H1961"\w* \w habían|strong="H1961"\w* venido de \w Jabes|strong="H3003"\w*: “Digan \w a|strong="H3068"\w* \w los|strong="H1961"\w* habitantes de \w Jabes|strong="H3003"\w* de \w Galaad|strong="H1568"\w* \w que|strong="H1961"\w* \w mañana|strong="H4279"\w*, \w cuando|strong="H1961"\w* el \w sol|strong="H8121"\w* \w esté|strong="H1961"\w* en lo más alto, \w serán|strong="H1961"\w* rescatados”. \w Los|strong="H1961"\w* \w mensajeros|strong="H4397"\w* regresaron \w y|strong="H3541"\w* dieron la noticia, \w y|strong="H3541"\w* todos en \w Jabes|strong="H3003"\w* \w se|strong="H1961"\w* alegraron.  
\v 10 Entonces \w los|strong="H3605"\w* \w de|strong="H5869"\w* \w Jabes|strong="H3003"\w* \w le|strong="H5869"\w* dijeron \w a|strong="H3068"\w* Nahas: “\w Mañana|strong="H4279"\w* nos entregaremos \w a|strong="H3068"\w* ustedes, y podrán \w hacer|strong="H6213"\w* con \w nosotros|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w mejor|strong="H2896"\w* les parezca”.  
\v 11 \w Al|strong="H5704"\w* \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*, \w Saúl|strong="H7586"\w* dividió \w al|strong="H5704"\w* \w ejército|strong="H4264"\w* \w en|strong="H5704"\w* \w tres|strong="H7969"\w* grupos \w y|strong="H5704"\w* entraron \w al|strong="H5704"\w* \w campamento|strong="H4264"\w* \w de|strong="H5704"\w* \w los|strong="H1961"\w* amonitas \w de|strong="H5704"\w* madrugada. \w Los|strong="H1961"\w* atacaron \w y|strong="H5704"\w* \w los|strong="H1961"\w* \w estuvieron|strong="H1961"\w* matando \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w el|strong="H4264"\w* sol calentó \w con|strong="H5704"\w* fuerza. \w Los|strong="H1961"\w* \w que|strong="H3808"\w* sobrevivieron \w se|strong="H1961"\w* dispersaron tanto \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w quedaron|strong="H7604"\w* \w ni|strong="H3808"\w* \w dos|strong="H8147"\w* \w hombres|strong="H8147"\w* \w juntos|strong="H3162"\w*.   
\p
\v 12 Entonces \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “¿\w Dónde|strong="H5921"\w* están esos \w que|strong="H4310"\w* preguntaban \w si|strong="H5921"\w* \w Saúl|strong="H7586"\w* debía reinar \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w*? ¡Tráiganlos \w para|strong="H5921"\w* \w que|strong="H4310"\w* \w los|strong="H5921"\w* matemos!”.   
\p
\v 13 \w Pero|strong="H3588"\w* \w Saúl|strong="H7586"\w* respondió: “\w Hoy|strong="H3117"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w matará|strong="H4191"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*, \w porque|strong="H3588"\w* \w hoy|strong="H3117"\w* Yahvé \w ha|strong="H3808"\w* salvado \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 14 Después \w Samuel|strong="H8050"\w* le dijo al \w pueblo|strong="H5971"\w*: “¡Vengan! \w Vamos|strong="H3212"\w* \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w* \w para|strong="H5971"\w* confirmar \w allí|strong="H8033"\w* el \w reino|strong="H4410"\w* \w de|strong="H5971"\w* Saúl”.  
\v 15 \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w* \w y|strong="H5704"\w* \w allí|strong="H8033"\w*, \w en|strong="H5704"\w* \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, confirmaron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w como|strong="H5704"\w* \w rey|strong="H4427"\w*. Ofrecieron \w sacrificios|strong="H2077"\w* \w de|strong="H6440"\w* paz \w ante|strong="H6440"\w* Yahvé, \w y|strong="H5704"\w* hubo una \w gran|strong="H3966"\w* fiesta \w entre|strong="H8033"\w* \w Saúl|strong="H7586"\w* \w y|strong="H5704"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas.   
\c 12  
\p
\v 1 \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*: “He escuchado \w la|strong="H5921"\w* \w voz|strong="H6963"\w* \w de|strong="H5921"\w* ustedes \w en|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* han dicho, \w y|strong="H5921"\w* he puesto un \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* ustedes.  
\v 2 \w Ahora|strong="H6258"\w*, \w el|strong="H1121"\w* \w rey|strong="H4428"\w* \w camina|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes. \w Yo|strong="H2009"\w* soy \w viejo|strong="H2204"\w* \w y|strong="H5704"\w* canoso; mis \w hijos|strong="H1121"\w* \w están|strong="H2088"\w* entre ustedes. He caminado \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ustedes \w desde|strong="H5704"\w* \w mi|strong="H2009"\w* \w juventud|strong="H5271"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 3 \w Aquí|strong="H2005"\w* estoy. Atestigüen \w contra|strong="H5048"\w* \w mí|strong="H6030"\w* ante \w el|strong="H4310"\w* \w Señor|strong="H3068"\w* \w y|strong="H7794"\w* ante su \w ungido|strong="H4899"\w*. ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w le|strong="H4310"\w* he quitado su \w buey|strong="H7794"\w*? ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w le|strong="H4310"\w* he quitado su burro? ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* he defraudado? ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* he \w oprimido|strong="H6231"\w*? ¿\w De|strong="H5048"\w* \w quién|strong="H4310"\w* he aceptado soborno para hacerme \w de|strong="H5048"\w* la vista gorda? Se los devolveré”.  
\v 4 Respondieron: “\w No|strong="H3808"\w* nos has defraudado, \w ni|strong="H3808"\w* nos has \w oprimido|strong="H6231"\w*, \w ni|strong="H3808"\w* has \w tomado|strong="H3947"\w* \w nada|strong="H3808"\w* de \w nadie|strong="H3808"\w*”.  
\v 5 \w Él|strong="H3588"\w* \w les|strong="H3972"\w* dijo: “\w El|strong="H3588"\w* \w Señor|strong="H3068"\w* \w es|strong="H2088"\w* \w testigo|strong="H5707"\w* contra ustedes, \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w ungido|strong="H4899"\w* \w es|strong="H2088"\w* \w testigo|strong="H5707"\w* \w hoy|strong="H3117"\w*, \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* han encontrado \w nada|strong="H3808"\w* \w en|strong="H3588"\w* mi \w mano|strong="H3027"\w*”. \w Ellos|strong="H3027"\w* respondieron: “\w Él|strong="H3588"\w* \w es|strong="H2088"\w* \w testigo|strong="H5707"\w*”.  
\v 6 \w Samuel|strong="H8050"\w* le dijo al \w pueblo|strong="H5971"\w*: “Es \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* \w quien|strong="H6213"\w* designó \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, y \w quien|strong="H6213"\w* \w sacó|strong="H5927"\w* \w a|strong="H3068"\w* sus antepasados \w de|strong="H5971"\w* la tierra \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*.  
\v 7 \w Ahora|strong="H6258"\w*, \w pues|strong="H6258"\w*, quédense quietos, \w para|strong="H3320"\w* \w que|strong="H6258"\w* \w yo|strong="H6213"\w* pueda presentar \w ante|strong="H6440"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* \w todas|strong="H3605"\w* las obras \w de|strong="H6440"\w* \w justicia|strong="H6666"\w* \w que|strong="H6258"\w* \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* \w hizo|strong="H6213"\w* con ustedes y con sus antepasados.  
\v 8 Cuando \w Jacob|strong="H3290"\w* entró \w en|strong="H3318"\w* \w Egipto|strong="H4714"\w* y sus antepasados \w clamaron|strong="H2199"\w* al \w Señor|strong="H3068"\w*, \w él|strong="H3427"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* y \w a|strong="H3068"\w* Aarón, quienes \w los|strong="H3427"\w* \w sacaron|strong="H3318"\w* de \w Egipto|strong="H4714"\w* y \w los|strong="H3427"\w* hicieron vivir \w en|strong="H3318"\w* \w este|strong="H2088"\w* \w lugar|strong="H4725"\w*.  
\v 9 Pero se \w olvidaron|strong="H7911"\w* del \w Señor|strong="H3068"\w* su \w Dios|strong="H3068"\w*, y él los entregó en \w manos|strong="H3027"\w* \w de|strong="H8269"\w* \w Sísara|strong="H5516"\w*, \w capitán|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H8269"\w* Jasor, en \w manos|strong="H3027"\w* \w de|strong="H8269"\w* los \w filisteos|strong="H6430"\w* y del \w rey|strong="H4428"\w* \w de|strong="H8269"\w* \w Moab|strong="H4124"\w*; y \w ellos|strong="H3027"\w* \w pelearon|strong="H3898"\w* contra Israel.  
\v 10 \w Clamaron|strong="H2199"\w* al \w Señor|strong="H3068"\w*: “Hemos \w pecado|strong="H2398"\w*, \w porque|strong="H3588"\w* hemos abandonado al \w Señor|strong="H3068"\w* \w y|strong="H3588"\w* servido \w a|strong="H3068"\w* \w los|strong="H3588"\w* baales \w y|strong="H3588"\w* \w a|strong="H3068"\w* Astarté; \w líbranos|strong="H5337"\w* \w ahora|strong="H6258"\w* \w de|strong="H3588"\w* nuestros enemigos \w y|strong="H3588"\w* \w te|strong="H3588"\w* \w serviremos|strong="H5647"\w*”.  
\v 11 \w El|strong="H3427"\w* \w Señor|strong="H3068"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Jerobaal|strong="H3378"\w*, \w a|strong="H3068"\w* Bedán, \w a|strong="H3068"\w* Jefté y \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, y \w los|strong="H3427"\w* \w libró|strong="H5337"\w* de sus enemigos, y vivieron seguros.  
\v 12 \w Al|strong="H5921"\w* \w ver|strong="H7200"\w* \w que|strong="H3588"\w* Nahas, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Amón, venía \w contra|strong="H5921"\w* ustedes, \w me|strong="H5921"\w* dijeron: “\w No|strong="H3808"\w*, un \w rey|strong="H4428"\w* \w reinará|strong="H4427"\w* \w sobre|strong="H5921"\w* \w nosotros|strong="H5921"\w*”, siendo \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w su|strong="H3588"\w* \w Dios|strong="H3068"\w* \w su|strong="H3588"\w* verdadero \w rey|strong="H4428"\w*.  
\v 13 \w Aquí|strong="H2009"\w* tienen \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w que|strong="H6258"\w* han elegido \w y|strong="H5921"\w* pedido. \w El|strong="H5921"\w* \w Señor|strong="H3068"\w* ha \w puesto|strong="H5414"\w* un \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* ustedes.  
\v 14 \w Si|strong="H1571"\w* \w temen|strong="H3372"\w* \w al|strong="H5921"\w* \w Señor|strong="H3068"\w*, \w le|strong="H5921"\w* \w sirven|strong="H5647"\w* \w y|strong="H1571"\w* \w escuchan|strong="H8085"\w* su \w voz|strong="H6963"\w*, \w tanto|strong="H5921"\w* ustedes \w como|strong="H1571"\w* su \w rey|strong="H4428"\w* seguirán \w al|strong="H5921"\w* \w Señor|strong="H3068"\w* su \w Dios|strong="H3068"\w*.  
\v 15 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w escuchan|strong="H8085"\w* al \w Señor|strong="H3068"\w* y \w se|strong="H1961"\w* rebelan, la \w mano|strong="H3027"\w* del \w Señor|strong="H3068"\w* \w estará|strong="H1961"\w* \w contra|strong="H1961"\w* ustedes, \w como|strong="H1961"\w* \w lo|strong="H3808"\w* \w estuvo|strong="H1961"\w* \w contra|strong="H1961"\w* sus antepasados.  
\v 16 \w Ahora|strong="H6258"\w*, quédense quietos \w y|strong="H1571"\w* \w vean|strong="H7200"\w* \w esta|strong="H2088"\w* \w gran|strong="H1419"\w* señal \w que|strong="H6258"\w* \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* ante sus \w ojos|strong="H5869"\w*.  
\v 17 ¿\w No|strong="H3808"\w* \w es|strong="H3588"\w* \w hoy|strong="H3117"\w* \w la|strong="H3588"\w* cosecha del \w trigo|strong="H2406"\w*? \w Invocaré|strong="H7121"\w* \w al|strong="H4428"\w* \w Señor|strong="H3068"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* envíe \w truenos|strong="H6963"\w* \w y|strong="H3588"\w* \w lluvia|strong="H4306"\w*; \w y|strong="H3588"\w* \w así|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w grande|strong="H7227"\w* \w la|strong="H3588"\w* \w maldad|strong="H7451"\w* \w que|strong="H3588"\w* han \w hecho|strong="H6213"\w* \w al|strong="H4428"\w* pedir un \w rey|strong="H4428"\w*”.  
\v 18 \w Samuel|strong="H8050"\w* invocó al \w Señor|strong="H3068"\w*, y \w el|strong="H1931"\w* \w Señor|strong="H3068"\w* envió \w truenos|strong="H6963"\w* y \w lluvia|strong="H4306"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*. \w Todo|strong="H3605"\w* \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w tuvo|strong="H3372"\w* \w mucho|strong="H3966"\w* \w miedo|strong="H3372"\w* del \w Señor|strong="H3068"\w* y \w de|strong="H5971"\w* \w Samuel|strong="H8050"\w*.  
\v 19 \w Le|strong="H5921"\w* dijeron \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “\w Ruega|strong="H6419"\w* \w por|strong="H5921"\w* tus \w siervos|strong="H5650"\w* \w al|strong="H5921"\w* \w Señor|strong="H3068"\w* tu \w Dios|strong="H3068"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w muramos|strong="H4191"\w*, \w pues|strong="H3588"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* nuestros \w pecados|strong="H2403"\w* hemos añadido este \w de|strong="H5921"\w* pedir un \w rey|strong="H4428"\w*”.  
\v 20 \w Samuel|strong="H8050"\w* dijo: “\w No|strong="H6213"\w* \w teman|strong="H3372"\w*. Han \w hecho|strong="H6213"\w* \w este|strong="H2063"\w* \w mal|strong="H7451"\w*, pero \w no|strong="H6213"\w* \w se|strong="H5971"\w* aparten del \w Señor|strong="H3068"\w*; sírvanle \w de|strong="H5971"\w* \w todo|strong="H3605"\w* \w corazón|strong="H3824"\w*.  
\v 21 \w No|strong="H3808"\w* \w se|strong="H3808"\w* vayan tras \w cosas|strong="H1992"\w* vanas \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w aprovechan|strong="H3276"\w* \w ni|strong="H3808"\w* liberan.  
\v 22 \w Pues|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* \w no|strong="H3808"\w* abandonará \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w por|strong="H3588"\w* causa \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w gran|strong="H1419"\w* \w nombre|strong="H8034"\w*, \w porque|strong="H3588"\w* le \w ha|strong="H3808"\w* agradado \w hacer|strong="H6213"\w* \w de|strong="H3588"\w* ustedes \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 23 En cuanto \w a|strong="H3068"\w* mí, \w lejos|strong="H2486"\w* de mí \w pecar|strong="H2398"\w* contra \w el|strong="H1571"\w* \w Señor|strong="H3068"\w* dejando de orar \w por|strong="H1157"\w* ustedes; les enseñaré \w el|strong="H1571"\w* \w camino|strong="H1870"\w* \w bueno|strong="H2896"\w* \w y|strong="H1571"\w* \w recto|strong="H3477"\w*.  
\v 24 \w Teman|strong="H3372"\w* al \w Señor|strong="H3068"\w* \w y|strong="H3588"\w* sírvanle \w de|strong="H3588"\w* verdad \w con|strong="H5973"\w* \w todo|strong="H3605"\w* \w su|strong="H3588"\w* \w corazón|strong="H3824"\w*; consideren las \w grandes|strong="H1431"\w* cosas \w que|strong="H3588"\w* ha hecho \w por|strong="H3588"\w* ustedes.  
\v 25 Pero \w si|strong="H1571"\w* siguen haciendo \w el|strong="H1571"\w* \w mal|strong="H7489"\w*, perecerán ustedes \w y|strong="H1571"\w* su \w rey|strong="H4428"\w*”.   
\c 13  
\p
\v 1 \w Saúl|strong="H7586"\w* tenía treinta \w años|strong="H8141"\w* cuando comenzó \w a|strong="H3068"\w* reinar, \w y|strong="H5921"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* cuarenta \w y|strong="H5921"\w* \w dos|strong="H8147"\w* \w años|strong="H8141"\w*.   
\p
\v 2 \w Saúl|strong="H7586"\w* escogió \w a|strong="H3068"\w* \w tres|strong="H7969"\w* mil hombres \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*; dos mil \w estaban|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w* \w en|strong="H5973"\w* Micmas y \w en|strong="H5973"\w* la región montañosa \w de|strong="H5973"\w* Betel, y mil \w estaban|strong="H1961"\w* \w con|strong="H5973"\w* Jonatán \w en|strong="H5973"\w* \w Gabaa|strong="H1390"\w* \w de|strong="H5973"\w* \w Benjamín|strong="H1144"\w*. Al \w resto|strong="H3499"\w* \w de|strong="H5973"\w* la \w gente|strong="H5971"\w* la \w mandó|strong="H7971"\w* \w de|strong="H5973"\w* regreso \w a|strong="H3068"\w* sus casas.  
\v 3 Jonatán atacó \w el|strong="H3605"\w* destacamento de \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w que|strong="H3605"\w* estaba \w en|strong="H5221"\w* Geba, y \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* se enteraron. Entonces \w Saúl|strong="H7586"\w* mandó \w tocar|strong="H8628"\w* \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w* por \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país, diciendo: “¡\w Que|strong="H3605"\w* \w lo|strong="H3605"\w* sepan \w los|strong="H3605"\w* \w hebreos|strong="H5680"\w*!”.  
\v 4 \w Todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w escuchó|strong="H8085"\w* \w la|strong="H1571"\w* noticia: “\w Saúl|strong="H7586"\w* ha atacado al destacamento \w filisteo|strong="H6430"\w*, \w y|strong="H1571"\w* ahora \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* detestan \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*”. \w Entonces|strong="H1571"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5971"\w* reunió \w con|strong="H1571"\w* \w Saúl|strong="H7586"\w* \w en|strong="H5221"\w* \w Gilgal|strong="H1537"\w*.  
\v 5 \w Los|strong="H5921"\w* \w filisteos|strong="H6430"\w* también \w se|strong="H5921"\w* juntaron \w para|strong="H5921"\w* pelear \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w*: tenían \w treinta|strong="H7970"\w* mil \w carros|strong="H7393"\w* \w de|strong="H5921"\w* \w guerra|strong="H3898"\w*, \w seis|strong="H8337"\w* mil \w jinetes|strong="H6571"\w* \w y|strong="H5921"\w* tantos soldados \w como|strong="H5973"\w* \w la|strong="H5921"\w* arena \w del|strong="H5921"\w* \w mar|strong="H3220"\w*. \w Subieron|strong="H5927"\w* \w y|strong="H5921"\w* acamparon \w en|strong="H5921"\w* Micmas, \w al|strong="H5921"\w* oriente \w de|strong="H5921"\w* Bet Avén.  
\v 6 \w Cuando|strong="H3588"\w* \w los|strong="H3588"\w* hombres \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w se|strong="H5971"\w* \w vieron|strong="H7200"\w* \w en|strong="H3588"\w* peligro \w y|strong="H3588"\w* \w se|strong="H5971"\w* dieron cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w estaban|strong="H5971"\w* \w en|strong="H3588"\w* aprietos, \w se|strong="H5971"\w* escondieron \w en|strong="H3588"\w* \w cuevas|strong="H4631"\w*, matorrales, peñascos, hoyos \w y|strong="H3588"\w* cisternas.  
\v 7 Algunos \w hebreos|strong="H5680"\w* incluso cruzaron \w el|strong="H3605"\w* \w Jordán|strong="H3383"\w* hacia \w la|strong="H3605"\w* tierra \w de|strong="H5750"\w* \w Gad|strong="H1410"\w* y \w de|strong="H5750"\w* \w Galaad|strong="H1568"\w*. Pero \w Saúl|strong="H7586"\w* seguía \w en|strong="H5750"\w* \w Gilgal|strong="H1537"\w*, y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w lo|strong="H3605"\w* seguía estaba temblando \w de|strong="H5750"\w* miedo.  
\v 8 Saúl \w esperó|strong="H3176"\w* allí \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, \w que|strong="H3808"\w* era \w el|strong="H5921"\w* plazo \w que|strong="H3808"\w* \w Samuel|strong="H8050"\w* había fijado; pero \w como|strong="H5921"\w* \w Samuel|strong="H8050"\w* \w no|strong="H3808"\w* llegaba \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w*, \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* empezó \w a|strong="H3068"\w* desbandarse.  
\v 9 Entonces \w Saúl|strong="H7586"\w* dijo: “Tráiganme \w el|strong="H5066"\w* sacrificio para quemar y las ofrendas de paz”. \w Y|strong="H3068"\w* \w él|strong="H5066"\w* mismo \w ofreció|strong="H5927"\w* \w el|strong="H5066"\w* sacrificio.   
\p
\v 10 \w En|strong="H3318"\w* cuanto terminó de ofrecer el sacrificio, \w llegó|strong="H5927"\w* \w Samuel|strong="H8050"\w*. \w Saúl|strong="H7586"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* recibirlo y \w a|strong="H3068"\w* saludarlo.  
\v 11 \w Pero|strong="H3588"\w* \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* preguntó: “¿\w Qué|strong="H3588"\w* \w fue|strong="H3808"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w hiciste|strong="H6213"\w*?”. \w Saúl|strong="H7586"\w* respondió: “\w Vi|strong="H7200"\w* \w que|strong="H3588"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w se|strong="H5921"\w* estaba yendo \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w tú|strong="H6213"\w* \w no|strong="H3808"\w* llegabas \w en|strong="H5921"\w* \w el|strong="H5921"\w* plazo acordado. \w Además|strong="H5921"\w*, \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* ya \w se|strong="H5921"\w* \w estaban|strong="H5971"\w* reuniendo \w en|strong="H5921"\w* Micmas.  
\v 12 Pensé: “Los \w filisteos|strong="H6430"\w* \w van|strong="H5927"\w* \w a|strong="H3068"\w* bajar \w ahora|strong="H6258"\w* mismo \w a|strong="H3068"\w* \w Gilgal|strong="H1537"\w* \w para|strong="H6258"\w* atacarme, y yo \w ni|strong="H3808"\w* siquiera he buscado el favor \w de|strong="H6440"\w* Yahvé”. \w Así|strong="H6258"\w* \w que|strong="H3808"\w* me sentí obligado y ofrecí el sacrificio”.   
\p
\v 13 \w Samuel|strong="H8050"\w* le dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¡Cometiste una tontería! \w No|strong="H3808"\w* cumpliste \w el|strong="H3588"\w* \w mandamiento|strong="H4687"\w* \w que|strong="H3588"\w* Yahvé tu \w Dios|strong="H3068"\w* \w te|strong="H3588"\w* dio. \w Si|strong="H3588"\w* hubieras obedecido, Yahvé habría \w confirmado|strong="H3559"\w* tu \w reino|strong="H4467"\w* sobre \w Israel|strong="H3478"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 14 \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w* tu \w reino|strong="H4467"\w* \w no|strong="H3808"\w* \w durará|strong="H6965"\w*. Yahvé \w ya|strong="H6258"\w* \w se|strong="H5921"\w* \w ha|strong="H3808"\w* buscado \w a|strong="H3068"\w* un hombre \w según|strong="H5921"\w* \w su|strong="H3588"\w* propio \w corazón|strong="H3824"\w*, \w y|strong="H3588"\w* \w lo|strong="H3808"\w* \w ha|strong="H3808"\w* nombrado jefe \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* tú \w no|strong="H3808"\w* cumpliste \w lo|strong="H3808"\w* \w que|strong="H3588"\w* Yahvé \w te|strong="H5921"\w* \w mandó|strong="H6680"\w*”.   
\p
\v 15 \w Samuel|strong="H8050"\w* \w se|strong="H4480"\w* fue \w de|strong="H4480"\w* \w Gilgal|strong="H1537"\w* y \w subió|strong="H5927"\w* \w a|strong="H3068"\w* \w Gabaa|strong="H1390"\w* \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*. \w Saúl|strong="H7586"\w* \w contó|strong="H6485"\w* \w a|strong="H3068"\w* la \w gente|strong="H5971"\w* \w que|strong="H4480"\w* \w se|strong="H4480"\w* \w había|strong="H4672"\w* quedado \w con|strong="H5973"\w* \w él|strong="H5973"\w*, y eran unos \w seiscientos|strong="H8337"\w* hombres.  
\v 16 \w Saúl|strong="H7586"\w*, su \w hijo|strong="H1121"\w* Jonatán y \w los|strong="H3427"\w* \w hombres|strong="H1121"\w* \w que|strong="H5971"\w* \w los|strong="H3427"\w* acompañaban \w se|strong="H5971"\w* quedaron \w en|strong="H5973"\w* \w Gabaa|strong="H1387"\w* \w de|strong="H5973"\w* \w Benjamín|strong="H1144"\w*, mientras \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w* acampaban \w en|strong="H5973"\w* Micmas.  
\v 17 Del \w campamento|strong="H4264"\w* \w filisteo|strong="H6430"\w* \w salieron|strong="H3318"\w* \w tres|strong="H7969"\w* grupos de asalto: uno se fue \w por|strong="H1870"\w* \w el|strong="H4264"\w* \w camino|strong="H1870"\w* de Ofra, \w hacia|strong="H1870"\w* la tierra de \w Sual|strong="H7777"\w*;  
\v 18 otro \w se|strong="H5921"\w* fue \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w de|strong="H5921"\w* Bet Horón, \w y|strong="H5921"\w* \w el|strong="H5921"\w* tercero \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w camino|strong="H1870"\w* \w del|strong="H5921"\w* límite \w que|strong="H5921"\w* \w mira|strong="H6437"\w* \w hacia|strong="H1870"\w* \w el|strong="H5921"\w* \w valle|strong="H1516"\w* \w de|strong="H5921"\w* \w Seboim|strong="H6650"\w*, \w en|strong="H5921"\w* dirección \w al|strong="H5921"\w* \w desierto|strong="H4057"\w*.  
\v 19 \w En|strong="H3588"\w* \w aquel|strong="H3605"\w* tiempo \w no|strong="H3808"\w* \w se|strong="H3808"\w* encontraba \w ningún|strong="H3605"\w* \w herrero|strong="H2796"\w* \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w porque|strong="H3588"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* decían: “\w No|strong="H3808"\w* dejen \w que|strong="H3588"\w* \w los|strong="H3605"\w* \w hebreos|strong="H5680"\w* fabriquen \w espadas|strong="H2719"\w* \w ni|strong="H3808"\w* lanzas”.  
\v 20 Así \w que|strong="H3605"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas tenían \w que|strong="H3605"\w* bajar \w a|strong="H3068"\w* donde estaban \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* para afilar sus arados, azadones, hachas y hoces.  
\v 21 El precio por afilar \w los|strong="H1961"\w* azadones y \w los|strong="H1961"\w* arados \w era|strong="H1961"\w* de un payim, y de un tercio de siclo por afilar las hachas y las aguijadas.  
\v 22 \w Por|strong="H3027"\w* eso, \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*, \w ninguno|strong="H3808"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* soldados \w que|strong="H3808"\w* \w estaban|strong="H1961"\w* con \w Saúl|strong="H7586"\w* y Jonatán \w tenía|strong="H1961"\w* \w espada|strong="H2719"\w* \w ni|strong="H3808"\w* \w lanza|strong="H2595"\w*; solo \w Saúl|strong="H7586"\w* y su \w hijo|strong="H1121"\w* Jonatán \w tenían|strong="H1961"\w* armas.   
\p
\v 23 Mientras tanto, un destacamento de los \w filisteos|strong="H6430"\w* \w avanzó|strong="H3318"\w* hasta el \w paso|strong="H4569"\w* de Micmas.   
\c 14  
\p
\v 1 Un \w día|strong="H3117"\w*, Jonatán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* le \w dijo|strong="H5046"\w* \w a|strong="H3068"\w* su ayudante \w de|strong="H1121"\w* \w armas|strong="H3627"\w*: “\w Ven|strong="H3212"\w*, \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* cruzar \w hasta|strong="H3117"\w* \w el|strong="H1121"\w* destacamento \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w que|strong="H3808"\w* \w está|strong="H1961"\w* al otro \w lado|strong="H5676"\w*”. Pero \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w lo|strong="H3808"\w* \w contó|strong="H5046"\w* \w a|strong="H3068"\w* su padre.  
\v 2 \w Saúl|strong="H7586"\w* \w estaba|strong="H3427"\w* \w en|strong="H5973"\w* las afueras \w de|strong="H8478"\w* \w Gabaa|strong="H1390"\w*, \w sentado|strong="H3427"\w* \w bajo|strong="H8478"\w* un granado \w en|strong="H5973"\w* \w Migrón|strong="H4051"\w*. Lo acompañaban unos \w seiscientos|strong="H8337"\w* hombres.  
\v 3 \w Entre|strong="H3808"\w* ellos estaba Ahías \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Ahitub, hermano \w de|strong="H3588"\w* Icabod \w e|strong="H3068"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Finees, \w el|strong="H3588"\w* \w nieto|strong="H1121"\w* \w de|strong="H3588"\w* \w Elí|strong="H5941"\w*, quien \w había|strong="H3588"\w* sido \w sacerdote|strong="H3548"\w* \w de|strong="H3588"\w* Yahvé \w en|strong="H3588"\w* \w Silo|strong="H7887"\w*. Ahías \w llevaba|strong="H5375"\w* \w puesto|strong="H3588"\w* \w el|strong="H3588"\w* efod. \w Nadie|strong="H3808"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* campamento \w sabía|strong="H3045"\w* \w que|strong="H3588"\w* Jonatán \w se|strong="H3045"\w* \w había|strong="H3588"\w* ido.   
\p
\v 4 \w Para|strong="H5921"\w* llegar \w al|strong="H5921"\w* destacamento \w filisteo|strong="H6430"\w*, Jonatán tenía \w que|strong="H5921"\w* \w pasar|strong="H5674"\w* \w por|strong="H5921"\w* un desfiladero \w entre|strong="H5921"\w* dos grandes rocas; una \w se|strong="H5921"\w* \w llamaba|strong="H8034"\w* Bozez \w y|strong="H5921"\w* \w la|strong="H5921"\w* otra Sene.  
\v 5 Una de las rocas estaba al \w norte|strong="H6828"\w*, frente \w a|strong="H3068"\w* Micmas, y la otra al sur, frente \w a|strong="H3068"\w* Geba.  
\v 6 Jonatán le dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* ayudante: “\w Ven|strong="H3212"\w*, \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* atacar \w a|strong="H3068"\w* esos paganos. Tal vez Yahvé nos ayude, \w porque|strong="H3588"\w* \w para|strong="H3588"\w* \w él|strong="H3588"\w* \w no|strong="H6213"\w* \w es|strong="H3588"\w* difícil darnos \w la|strong="H3588"\w* victoria, ya sea \w con|strong="H3588"\w* \w muchos|strong="H7227"\w* soldados \w o|strong="H3068"\w* \w con|strong="H3588"\w* \w pocos|strong="H4592"\w*”.   
\p
\v 7 Su ayudante \w le|strong="H5973"\w* respondió: “\w Haz|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* tengas pensado; adelante, \w que|strong="H3605"\w* \w yo|strong="H6213"\w* \w te|strong="H5973"\w* apoyaré \w en|strong="H5973"\w* \w todo|strong="H3605"\w*”.   
\p
\v 8 “Muy bien”, dijo Jonatán, “vamos \w a|strong="H3068"\w* cruzar para que ellos nos vean.  
\v 9 \w Si|strong="H3808"\w* nos dicen: “¡Quietos ahí! Esperen \w a|strong="H3068"\w* \w que|strong="H3808"\w* lleguemos \w a|strong="H3068"\w* \w donde|strong="H8478"\w* están ustedes”, nos quedaremos \w donde|strong="H8478"\w* estemos \w y|strong="H5704"\w* \w no|strong="H3808"\w* \w subiremos|strong="H5927"\w*.  
\v 10 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w nos|strong="H5921"\w* dicen: “¡Suban \w a|strong="H3068"\w* pelear \w con|strong="H5921"\w* \w nosotros|strong="H5921"\w*!”, \w entonces|strong="H3588"\w* \w subiremos|strong="H5927"\w*, \w porque|strong="H3588"\w* esa \w será|strong="H5414"\w* \w la|strong="H5921"\w* señal \w de|strong="H5921"\w* \w que|strong="H3588"\w* Yahvé \w nos|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w la|strong="H5921"\w* victoria \w sobre|strong="H5921"\w* \w ellos|strong="H3027"\w*”.   
\p
\v 11 Cuando los \w filisteos|strong="H6430"\w* los vieron, exclamaron: “¡Miren! ¡Los \w hebreos|strong="H5680"\w* \w están|strong="H2009"\w* \w saliendo|strong="H3318"\w* \w de|strong="H4480"\w* las cuevas \w donde|strong="H8033"\w* \w se|strong="H4480"\w* habían \w escondido|strong="H2244"\w*!”.  
\v 12 \w Los|strong="H3588"\w* soldados del destacamento les gritaron \w a|strong="H3068"\w* Jonatán \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* ayudante: “¡Suban \w acá|strong="H5927"\w*, \w que|strong="H3588"\w* les \w vamos|strong="H5927"\w* \w a|strong="H3068"\w* enseñar \w algo|strong="H1697"\w*!”.  
\p Jonatán le dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* ayudante: “¡\w Sube|strong="H5927"\w* detrás \w de|strong="H3588"\w* \w mí|strong="H6030"\w*! Yahvé le ha \w dado|strong="H5414"\w* \w la|strong="H3588"\w* victoria \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*”.  
\v 13 Jonatán \w subió|strong="H5927"\w* trepando \w con|strong="H5921"\w* \w pies|strong="H7272"\w* \w y|strong="H5921"\w* \w manos|strong="H3027"\w*, \w y|strong="H5921"\w* su ayudante iba detrás \w de|strong="H5921"\w* \w él|strong="H5921"\w*. Jonatán atacaba \w a|strong="H3068"\w* \w los|strong="H5921"\w* filisteos \w y|strong="H5921"\w* \w los|strong="H5921"\w* derribaba, \w y|strong="H5921"\w* su ayudante \w los|strong="H5921"\w* remataba.  
\v 14 \w En|strong="H5221"\w* ese \w primer|strong="H7223"\w* ataque, Jonatán y su ayudante \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* unos \w veinte|strong="H6242"\w* hombres \w en|strong="H5221"\w* un espacio de tierra muy pequeño.   
\p
\v 15 \w Entonces|strong="H1571"\w* cundió \w el|strong="H3605"\w* pánico en \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* filisteo \w y|strong="H1571"\w* por \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w campo|strong="H4264"\w*. Tanto \w los|strong="H1992"\w* soldados del destacamento \w como|strong="H1571"\w* \w los|strong="H1992"\w* grupos \w de|strong="H5971"\w* asalto \w temblaron|strong="H2729"\w* \w de|strong="H5971"\w* miedo. \w Hubo|strong="H1961"\w* un terremoto \w y|strong="H1571"\w* \w el|strong="H3605"\w* terror enviado por Dios \w fue|strong="H1961"\w* inmenso.  
\v 16 Los centinelas de \w Saúl|strong="H7586"\w* \w en|strong="H3212"\w* \w Gabaa|strong="H1390"\w* de \w Benjamín|strong="H1144"\w* \w vieron|strong="H7200"\w* que el \w ejército|strong="H1995"\w* filisteo se dispersaba y corría de un lado \w a|strong="H3068"\w* otro.  
\v 17 Entonces \w Saúl|strong="H7586"\w* \w le|strong="H5973"\w* ordenó \w a|strong="H3068"\w* su \w gente|strong="H5971"\w*: “\w Pasen|strong="H1980"\w* lista \w para|strong="H5973"\w* \w ver|strong="H7200"\w* \w quién|strong="H4310"\w* falta”. Pasaron lista y \w se|strong="H5971"\w* dieron \w cuenta|strong="H6485"\w* \w de|strong="H5973"\w* \w que|strong="H4310"\w* no \w estaban|strong="H5971"\w* \w ni|strong="H5973"\w* Jonatán \w ni|strong="H5973"\w* su ayudante \w de|strong="H5973"\w* \w armas|strong="H3627"\w*.   
\p
\v 18 \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* Ahías: “\w Trae|strong="H5066"\w* \w el|strong="H1931"\w* arca \w de|strong="H3588"\w* Dios”. (\w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H3117"\w*, \w el|strong="H1931"\w* arca \w estaba|strong="H1961"\w* \w con|strong="H3588"\w* \w los|strong="H1121"\w* israelitas).  
\v 19 Pero \w mientras|strong="H5704"\w* \w Saúl|strong="H7586"\w* \w hablaba|strong="H1696"\w* \w con|strong="H5704"\w* \w el|strong="H4264"\w* \w sacerdote|strong="H3548"\w*, \w el|strong="H4264"\w* \w alboroto|strong="H1995"\w* \w en|strong="H5704"\w* \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w filisteo|strong="H6430"\w* aumentaba cada vez \w más|strong="H7227"\w*. Entonces \w Saúl|strong="H7586"\w* le \w dijo|strong="H1696"\w* \w al|strong="H5704"\w* \w sacerdote|strong="H3548"\w*: “¡\w Ya|strong="H3068"\w* deja eso! \w No|strong="H1961"\w* consultes \w más|strong="H7227"\w*”.   
\p
\v 20 \w Saúl|strong="H7586"\w* \w y|strong="H5704"\w* \w todos|strong="H3605"\w* sus hombres \w se|strong="H1961"\w* reunieron \w y|strong="H5704"\w* \w se|strong="H1961"\w* lanzaron \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*. Encontraron \w a|strong="H3068"\w* \w los|strong="H3605"\w* filisteos \w en|strong="H5704"\w* una confusión total, matándose unos \w a|strong="H3068"\w* otros \w con|strong="H5704"\w* sus propias \w espadas|strong="H2719"\w*.  
\v 21 Incluso \w los|strong="H1992"\w* \w hebreos|strong="H5680"\w* \w que|strong="H1571"\w* antes servían \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w* \w y|strong="H1571"\w* \w estaban|strong="H1961"\w* \w con|strong="H5973"\w* \w ellos|strong="H1992"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w campamento|strong="H4264"\w*, \w se|strong="H1961"\w* rebelaron \w y|strong="H1571"\w* \w se|strong="H1961"\w* unieron \w a|strong="H3068"\w* \w los|strong="H1992"\w* israelitas \w que|strong="H1571"\w* \w estaban|strong="H1961"\w* \w con|strong="H5973"\w* \w Saúl|strong="H7586"\w* \w y|strong="H1571"\w* Jonatán.  
\v 22 \w También|strong="H1571"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* israelitas \w que|strong="H3588"\w* \w se|strong="H1992"\w* habían \w escondido|strong="H2244"\w* \w en|strong="H3588"\w* \w la|strong="H1571"\w* región montañosa \w de|strong="H3588"\w* Efraín, al \w oír|strong="H8085"\w* \w que|strong="H3588"\w* \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w* huían, \w se|strong="H1992"\w* lanzaron \w a|strong="H3068"\w* perseguirlos.  
\v 23 \w Así|strong="H1931"\w* \w fue|strong="H1931"\w* \w como|strong="H1931"\w* Yahvé \w salvó|strong="H3467"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*. \w La|strong="H1931"\w* \w batalla|strong="H4421"\w* \w se|strong="H1931"\w* extendió \w hasta|strong="H3117"\w* más allá de Bet Avén.   
\p
\v 24 Pero \w los|strong="H3605"\w* hombres \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w estaban|strong="H5971"\w* agotados \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w porque|strong="H3808"\w* \w Saúl|strong="H7586"\w* \w los|strong="H3605"\w* había obligado \w a|strong="H3068"\w* hacer \w este|strong="H1931"\w* juramento: “¡Maldito sea \w el|strong="H1931"\w* \w que|strong="H1931"\w* coma algo \w antes|strong="H5704"\w* \w de|strong="H5704"\w* \w que|strong="H1931"\w* anochezca \w y|strong="H5704"\w* yo me haya vengado \w de|strong="H5704"\w* mis enemigos!”. \w Por|strong="H5704"\w* \w eso|strong="H1931"\w*, \w nadie|strong="H3808"\w* probó bocado.   
\p
\v 25 \w Todo|strong="H3605"\w* \w el|strong="H5921"\w* ejército entró \w en|strong="H5921"\w* un \w bosque|strong="H3293"\w* \w donde|strong="H5921"\w* \w había|strong="H1961"\w* panales \w de|strong="H5921"\w* \w miel|strong="H1706"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* suelo.  
\v 26 Al entrar al \w bosque|strong="H3293"\w*, vieron \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w miel|strong="H1706"\w* chorreaba, \w pero|strong="H3588"\w* nadie \w se|strong="H5971"\w* atrevió \w a|strong="H3068"\w* probarla \w por|strong="H3588"\w* \w miedo|strong="H3372"\w* al \w juramento|strong="H7621"\w* \w que|strong="H3588"\w* habían hecho.  
\v 27 Pero Jonatán \w no|strong="H3808"\w* sabía \w que|strong="H3808"\w* su padre había obligado al \w pueblo|strong="H5971"\w* \w a|strong="H3068"\w* jurar, así \w que|strong="H3808"\w* \w extendió|strong="H7971"\w* la punta \w de|strong="H5971"\w* la \w vara|strong="H4294"\w* \w que|strong="H3808"\w* llevaba y la mojó en un panal. En cuanto probó la \w miel|strong="H1706"\w*, recobró sus fuerzas y sus \w ojos|strong="H5869"\w* brillaron.  
\v 28 Uno \w de|strong="H5971"\w* los soldados le dijo: “Tu padre obligó \w a|strong="H3068"\w* todos \w a|strong="H3068"\w* jurar diciendo: “¡Maldito el \w que|strong="H5971"\w* coma algo \w hoy|strong="H3117"\w*!”. \w Por|strong="H5774"\w* eso la \w gente|strong="H5971"\w* está tan débil”.   
\p
\v 29 Jonatán respondió: “\w Mi|strong="H4994"\w* padre \w le|strong="H5869"\w* ha hecho un gran daño al país. Miren \w cómo|strong="H3588"\w* he recobrado mis fuerzas \w por|strong="H3588"\w* haber probado un \w poco|strong="H4592"\w* \w de|strong="H3588"\w* \w esta|strong="H2088"\w* \w miel|strong="H1706"\w*.  
\v 30 ¡\w Cuánto|strong="H3588"\w* mejor habría sido \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w* comiera \w hoy|strong="H3117"\w* \w de|strong="H3588"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* les quitó \w a|strong="H3068"\w* sus enemigos! ¡\w La|strong="H3588"\w* matanza \w de|strong="H3588"\w* \w filisteos|strong="H6430"\w* habría sido \w mucho|strong="H7235"\w* \w mayor|strong="H3588"\w*!”.  
\v 31 \w Aquel|strong="H1931"\w* \w día|strong="H3117"\w* derrotaron \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w* desde Micmas \w hasta|strong="H3117"\w* Ajalón, pero \w el|strong="H1931"\w* \w pueblo|strong="H5971"\w* terminó agotado.  
\v 32 \w Por|strong="H5921"\w* eso \w se|strong="H5921"\w* lanzaron \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* botín; \w tomaron|strong="H3947"\w* \w ovejas|strong="H6629"\w*, \w vacas|strong="H1241"\w* \w y|strong="H5921"\w* becerros, \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w mataron|strong="H7819"\w* allí mismo \w en|strong="H5921"\w* \w el|strong="H5921"\w* suelo, \w y|strong="H5921"\w* \w se|strong="H5921"\w* comieron \w la|strong="H5921"\w* carne \w con|strong="H5921"\w* todo \w y|strong="H5921"\w* \w sangre|strong="H1818"\w*.  
\v 33 \w Cuando|strong="H3117"\w* \w le|strong="H5921"\w* avisaron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w estaba|strong="H2009"\w* pecando \w contra|strong="H5921"\w* Yahvé \w al|strong="H5921"\w* comer carne \w con|strong="H5921"\w* \w sangre|strong="H1818"\w*,  
\p \w él|strong="H5921"\w* exclamó: “¡Ustedes han sido infieles! Roden \w ahora|strong="H3117"\w* mismo una piedra \w grande|strong="H1419"\w* \w hacia|strong="H5921"\w* \w donde|strong="H5921"\w* \w yo|strong="H2009"\w* estoy”.  
\v 34 \w Luego|strong="H2088"\w* ordenó: “Vayan \w por|strong="H2088"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* campamento \w y|strong="H7794"\w* díganle \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w*: “\w Cada|strong="H3605"\w* uno tráigame su \w buey|strong="H7794"\w* \w o|strong="H3068"\w* su \w oveja|strong="H7716"\w*, \w y|strong="H7794"\w* mátenlos \w aquí|strong="H2088"\w* \w para|strong="H5971"\w* comer. \w No|strong="H3808"\w* pequen contra Yahvé comiendo carne con \w sangre|strong="H1818"\w*””. \w Así|strong="H2088"\w* \w que|strong="H3808"\w* esa \w noche|strong="H3915"\w* \w cada|strong="H3605"\w* uno llevó su \w buey|strong="H7794"\w* \w y|strong="H7794"\w* \w lo|strong="H2088"\w* mató \w allí|strong="H8033"\w*.   
\p
\v 35 \w Saúl|strong="H7586"\w* construyó entonces un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé; este fue el primer \w altar|strong="H4196"\w* que él levantó.  
\v 36 \w Después|strong="H5704"\w* \w Saúl|strong="H7586"\w* dijo: “Bajemos esta misma \w noche|strong="H3915"\w* \w a|strong="H3068"\w* perseguir \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w*. \w Los|strong="H3605"\w* saquearemos \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* amanecer \w y|strong="H5704"\w* \w no|strong="H3808"\w* \w dejaremos|strong="H7604"\w* \w a|strong="H3068"\w* \w ninguno|strong="H3808"\w* \w con|strong="H5704"\w* vida”.  
\p \w Los|strong="H3605"\w* hombres respondieron: “\w Haz|strong="H6213"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w te|strong="H5869"\w* parezca \w mejor|strong="H2896"\w*”.  
\p Pero \w el|strong="H3605"\w* \w sacerdote|strong="H3548"\w* sugirió: “Consultemos primero \w a|strong="H3068"\w* Dios”.   
\p
\v 37 \w Así|strong="H1931"\w* \w que|strong="H1931"\w* \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* \w preguntó|strong="H7592"\w* \w a|strong="H3068"\w* Dios: “¿Debo bajar \w a|strong="H3068"\w* perseguir \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w*? ¿Nos \w darás|strong="H5414"\w* \w la|strong="H1931"\w* victoria sobre \w ellos|strong="H3027"\w*?”. Pero Dios \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w respondió|strong="H6030"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w*.  
\v 38 \w Entonces|strong="H3117"\w* \w Saúl|strong="H7586"\w* ordenó: “Vengan \w aquí|strong="H1988"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* jefes del \w pueblo|strong="H5971"\w*. Investiguen \w quién|strong="H4100"\w* ha cometido \w hoy|strong="H3117"\w* \w este|strong="H2063"\w* \w pecado|strong="H2403"\w*.  
\v 39 Juro \w por|strong="H3588"\w* Yahvé, \w el|strong="H3588"\w* \w salvador|strong="H3467"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w que|strong="H3588"\w* \w aun|strong="H3588"\w* \w si|strong="H3588"\w* \w el|strong="H3588"\w* culpable fuera \w mi|strong="H6030"\w* \w hijo|strong="H1121"\w* Jonatán, tendrá \w que|strong="H3588"\w* \w morir|strong="H4191"\w*”. \w Pero|strong="H3588"\w* \w nadie|strong="H3605"\w* \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* ejército \w respondió|strong="H6030"\w* \w nada|strong="H3605"\w*.  
\v 40 Entonces \w Saúl|strong="H7586"\w* les dijo \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* israelitas: “Ustedes pónganse \w de|strong="H1121"\w* un \w lado|strong="H5676"\w*, y \w mi|strong="H1961"\w* \w hijo|strong="H1121"\w* Jonatán y \w yo|strong="H6213"\w* nos pondremos del otro”.  
\p \w El|strong="H3605"\w* \w pueblo|strong="H5971"\w* respondió: “\w Haz|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w te|strong="H5869"\w* parezca \w mejor|strong="H2896"\w*”.   
\p
\v 41 \w Saúl|strong="H7586"\w* oró \w a|strong="H3068"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*: “\w Danos|strong="H3051"\w* la respuesta verdadera”.  
\p El sorteo señaló \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* Jonatán, y el \w pueblo|strong="H5971"\w* quedó libre \w de|strong="H5971"\w* culpa.   
\p
\v 42 \w Saúl|strong="H7586"\w* ordenó: “Hagan \w el|strong="H5307"\w* sorteo entre mi \w hijo|strong="H1121"\w* Jonatán y yo”.  
\p \w Y|strong="H3068"\w* \w el|strong="H5307"\w* sorteo señaló \w a|strong="H3068"\w* Jonatán.   
\p
\v 43 \w Saúl|strong="H7586"\w* le preguntó \w a|strong="H3068"\w* Jonatán: “Dime \w qué|strong="H4100"\w* fue \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w hiciste|strong="H6213"\w*”.  
\p Jonatán le confesó: “Probé un \w poco|strong="H4592"\w* de \w miel|strong="H1706"\w* con la punta de mi \w vara|strong="H4294"\w*. \w Aquí|strong="H2005"\w* estoy, listo para \w morir|strong="H4191"\w*”.  
\v 44 \w Saúl|strong="H7586"\w* sentenció: “¡\w Que|strong="H3588"\w* Dios \w me|strong="H3588"\w* castigue duramente \w si|strong="H3588"\w* \w no|strong="H6213"\w* mueres hoy mismo, Jonatán!”.   
\p
\v 45 \w Pero|strong="H3588"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* \w le|strong="H5973"\w* reclamó \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¿\w Cómo|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w morir|strong="H4191"\w* Jonatán, \w si|strong="H3588"\w* \w él|strong="H5973"\w* \w es|strong="H2088"\w* \w quien|strong="H6213"\w* \w ha|strong="H3808"\w* dado \w esta|strong="H2063"\w* \w gran|strong="H1419"\w* victoria \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*? ¡\w De|strong="H3588"\w* \w ninguna|strong="H3808"\w* manera! Juramos \w por|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w le|strong="H5973"\w* tocará \w ni|strong="H3808"\w* un solo cabello \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*, \w porque|strong="H3588"\w* \w hoy|strong="H3117"\w* \w Dios|strong="H3068"\w* \w ha|strong="H3808"\w* actuado \w por|strong="H3588"\w* medio \w de|strong="H3588"\w* \w él|strong="H5973"\w*”. \w Así|strong="H2063"\w* \w fue|strong="H3808"\w* \w como|strong="H3588"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* salvó \w a|strong="H3068"\w* Jonatán \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w muerte|strong="H4191"\w*.  
\v 46 Después de eso, \w Saúl|strong="H7586"\w* \w dejó|strong="H5927"\w* de perseguir \w a|strong="H3068"\w* los \w filisteos|strong="H6430"\w*, y ellos regresaron \w a|strong="H3068"\w* su propio territorio.   
\p
\v 47 Una vez \w que|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w se|strong="H5921"\w* consolidó \w en|strong="H5921"\w* \w el|strong="H5921"\w* trono \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w peleó|strong="H3898"\w* \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* sus enemigos: \w los|strong="H1121"\w* \w de|strong="H5921"\w* \w Moab|strong="H4124"\w*, Amón, Edom, \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* Soba \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*. \w A|strong="H3068"\w* dondequiera \w que|strong="H5921"\w* iba, salía victorioso.  
\v 48 Mostró gran valor y derrotó \w a|strong="H3068"\w* los amalecitas, \w librando|strong="H5337"\w* así \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* de los \w que|strong="H3027"\w* le robaban sus pertenencias.  
\v 49 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* \w fueron|strong="H1961"\w* Jonatán, Isvi y Malquisúa. Sus \w dos|strong="H8147"\w* \w hijas|strong="H1323"\w* \w se|strong="H1961"\w* llamaban \w Merab|strong="H4764"\w*, \w la|strong="H4324"\w* mayor, y Mical, \w la|strong="H4324"\w* \w menor|strong="H6996"\w*.  
\v 50 La esposa \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* se \w llamaba|strong="H8034"\w* Ahinoam \w hija|strong="H1323"\w* \w de|strong="H1121"\w* Ahimaas. \w El|strong="H1121"\w* \w general|strong="H8269"\w* \w de|strong="H1121"\w* su \w ejército|strong="H6635"\w* se \w llamaba|strong="H8034"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w*, \w tío|strong="H1730"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*.  
\v 51 \w El|strong="H1121"\w* padre \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* \w era|strong="H1121"\w* \w Cis|strong="H7027"\w*, y \w el|strong="H1121"\w* padre \w de|strong="H1121"\w* Abner \w era|strong="H1121"\w* \w Ner|strong="H5369"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abiel.   
\p
\v 52 \w Mientras|strong="H3605"\w* \w Saúl|strong="H7586"\w* \w vivió|strong="H3117"\w*, \w hubo|strong="H1961"\w* una \w guerra|strong="H4421"\w* terrible \w contra|strong="H5921"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*. \w Por|strong="H5921"\w* eso, \w cada|strong="H3605"\w* vez \w que|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w veía|strong="H7200"\w* \w a|strong="H3068"\w* un \w hombre|strong="H1368"\w* \w fuerte|strong="H2389"\w* \w o|strong="H3068"\w* \w valiente|strong="H1368"\w*, \w lo|strong="H5921"\w* reclutaba \w para|strong="H5921"\w* su \w ejército|strong="H2428"\w*.   
\c 15  
\p
\v 1 \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “Yahvé \w me|strong="H5921"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* ungirte \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. \w Por|strong="H5921"\w* \w lo|strong="H1697"\w* \w tanto|strong="H5921"\w*, \w escucha|strong="H8085"\w* \w ahora|strong="H6258"\w* \w el|strong="H5921"\w* mensaje \w de|strong="H5921"\w* Yahvé.  
\v 2 \w Así|strong="H3541"\w* dice Yahvé de los \w Ejércitos|strong="H6635"\w*: “He decidido castigar \w a|strong="H3068"\w* los amalecitas \w por|strong="H1870"\w* \w lo|strong="H6213"\w* \w que|strong="H3541"\w* le \w hicieron|strong="H6213"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, pues se le opusieron en \w el|strong="H6213"\w* \w camino|strong="H1870"\w* cuando \w subía|strong="H5927"\w* de \w Egipto|strong="H4714"\w*.  
\v 3 \w Ve|strong="H3212"\w* \w ahora|strong="H6258"\w* \w y|strong="H5921"\w* ataca \w a|strong="H3068"\w* \w Amalec|strong="H6002"\w*. Destruye \w por|strong="H5921"\w* completo \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* tienen \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* tengas compasión. \w Mata|strong="H4191"\w* \w a|strong="H3068"\w* hombres \w y|strong="H5921"\w* \w mujeres|strong="H5704"\w*, \w a|strong="H3068"\w* \w niños|strong="H5768"\w* \w y|strong="H5921"\w* recién nacidos, \w y|strong="H5921"\w* también \w a|strong="H3068"\w* sus \w bueyes|strong="H7794"\w*, ovejas, \w camellos|strong="H1581"\w* \w y|strong="H5921"\w* burros””.   
\p
\v 4 \w Saúl|strong="H7586"\w* reunió al ejército y les pasó revista en Telaim: eran \w doscientos|strong="H3967"\w* \w mil|strong="H3967"\w* soldados \w de|strong="H5971"\w* infantería y \w diez|strong="H6235"\w* \w mil|strong="H3967"\w* hombres \w de|strong="H5971"\w* \w Judá|strong="H3063"\w*.  
\v 5 \w Saúl|strong="H7586"\w* \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* \w de|strong="H5704"\w* \w Amalec|strong="H6002"\w* \w y|strong="H5704"\w* preparó una emboscada \w en|strong="H5704"\w* el valle.  
\v 6 \w Luego|strong="H5927"\w* \w les|strong="H5973"\w* avisó \w a|strong="H3068"\w* \w los|strong="H1121"\w* ceneos: “Váyanse \w de|strong="H5973"\w* aquí, apártense \w de|strong="H5973"\w* \w los|strong="H1121"\w* amalecitas \w para|strong="H5973"\w* \w que|strong="H6435"\w* \w no|strong="H6435"\w* \w los|strong="H1121"\w* destruya \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w ellos|strong="H3605"\w*; \w porque|strong="H6435"\w* ustedes \w trataron|strong="H6213"\w* \w con|strong="H5973"\w* bondad \w a|strong="H3068"\w* \w los|strong="H1121"\w* israelitas cuando \w salieron|strong="H5927"\w* \w de|strong="H5973"\w* \w Egipto|strong="H4714"\w*”. \w Entonces|strong="H5493"\w* \w los|strong="H1121"\w* ceneos \w se|strong="H6435"\w* alejaron \w de|strong="H5973"\w* \w los|strong="H1121"\w* amalecitas.   
\p
\v 7 \w Saúl|strong="H7586"\w* derrotó \w a|strong="H3068"\w* \w los|strong="H5921"\w* amalecitas \w desde|strong="H5921"\w* Javila \w hasta|strong="H5921"\w* llegar \w a|strong="H3068"\w* \w Shur|strong="H7793"\w*, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w con|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\v 8 Capturó \w vivo|strong="H2416"\w* \w a|strong="H3068"\w* Agag, \w rey|strong="H4428"\w* \w de|strong="H5971"\w* \w Amalec|strong="H6002"\w*, pero \w mató|strong="H2763"\w* \w a|strong="H3068"\w* filo \w de|strong="H5971"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w*.  
\v 9 \w Sin|strong="H3808"\w* embargo, \w Saúl|strong="H7586"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* ejército \w le|strong="H5921"\w* \w perdonaron|strong="H2550"\w* \w la|strong="H5921"\w* vida \w a|strong="H3068"\w* Agag \w y|strong="H5921"\w* \w se|strong="H5921"\w* quedaron \w con|strong="H5921"\w* \w lo|strong="H3808"\w* \w mejor|strong="H2896"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*, \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w vacas|strong="H1241"\w*, \w de|strong="H5921"\w* \w los|strong="H5921"\w* becerros gordos, \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w corderos|strong="H6629"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era valioso. \w No|strong="H3808"\w* quisieron destruirlos \w por|strong="H5921"\w* completo, pero \w sí|strong="H3808"\w* \w destruyeron|strong="H2763"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era \w sin|strong="H3808"\w* valor \w y|strong="H5921"\w* despreciable.   
\p
\v 10 Entonces Yahvé le \w habló|strong="H1697"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*:  
\v 11 “\w Me|strong="H3588"\w* arrepiento \w de|strong="H3588"\w* \w haber|strong="H3808"\w* \w puesto|strong="H3588"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w como|strong="H3588"\w* \w rey|strong="H4428"\w*, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* \w ha|strong="H3808"\w* abandonado \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* cumplido mis órdenes”. \w Samuel|strong="H8050"\w* \w se|strong="H3808"\w* angustió mucho \w y|strong="H3588"\w* pasó \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w noche|strong="H3915"\w* \w clamando|strong="H2199"\w* \w a|strong="H3068"\w* Yahvé.   
\p
\v 12 Muy temprano, \w Samuel|strong="H8050"\w* se levantó para \w ir|strong="H3381"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, pero \w le|strong="H1242"\w* informaron: “\w Saúl|strong="H7586"\w* fue al Carmelo y allí levantó un monumento en su honor; \w luego|strong="H5674"\w* regresó y siguió hacia \w Gilgal|strong="H1537"\w*”.   
\p
\v 13 Cuando \w Samuel|strong="H8050"\w* llegó, \w Saúl|strong="H7586"\w* le dijo: “¡\w Que|strong="H1697"\w* Yahvé te \w bendiga|strong="H1288"\w*! \w Ya|strong="H3068"\w* he cumplido la orden \w de|strong="H1697"\w* Yahvé”.   
\p
\v 14 Pero \w Samuel|strong="H8050"\w* le preguntó: “¿\w Y|strong="H3068"\w* entonces \w qué|strong="H4100"\w* significan esos balidos de \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* esos mugidos de \w vacas|strong="H1241"\w* \w que|strong="H4100"\w* estoy \w escuchando|strong="H8085"\w*?”.   
\p
\v 15 \w Saúl|strong="H7586"\w* respondió: “Son \w los|strong="H5921"\w* animales \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* trajo \w de|strong="H5921"\w* Amalec. \w Dejaron|strong="H3498"\w* vivas \w a|strong="H3068"\w* \w las|strong="H5921"\w* mejores \w ovejas|strong="H6629"\w* \w y|strong="H5921"\w* \w vacas|strong="H1241"\w* \w para|strong="H4616"\w* sacrificarlas \w a|strong="H3068"\w* Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* usted, pero todo \w lo|strong="H5921"\w* demás \w lo|strong="H5921"\w* destruimos \w por|strong="H5921"\w* completo”.   
\p
\v 16 “¡Basta!”, le \w dijo|strong="H1696"\w* \w Samuel|strong="H8050"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*. “Deja que te cuente lo que Yahvé me \w dijo|strong="H1696"\w* anoche”. \w Saúl|strong="H7586"\w* respondió: “Te escucho”.   
\p
\v 17 \w Samuel|strong="H8050"\w* prosiguió: “\w Aunque|strong="H3808"\w* tú \w te|strong="H5869"\w* creías poca cosa, ¿acaso \w no|strong="H3808"\w* llegaste \w a|strong="H3068"\w* ser \w el|strong="H5921"\w* \w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w tribus|strong="H7626"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*? Yahvé \w te|strong="H5869"\w* \w ungió|strong="H4886"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*,  
\v 18 \w y|strong="H5704"\w* te \w envió|strong="H7971"\w* \w a|strong="H3068"\w* una misión \w con|strong="H5704"\w* esta orden: “\w Ve|strong="H3212"\w* \w y|strong="H5704"\w* destruye \w por|strong="H1870"\w* completo \w a|strong="H3068"\w* esos \w pecadores|strong="H2400"\w* amalecitas; dales \w guerra|strong="H3898"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* los acabes”.  
\v 19 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* \w obedeciste|strong="H8085"\w* \w a|strong="H3068"\w* Yahvé? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w te|strong="H5869"\w* lanzaste sobre \w el|strong="H6213"\w* botín \w e|strong="H3068"\w* \w hiciste|strong="H6213"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w a|strong="H3068"\w* \w él|strong="H6213"\w* \w le|strong="H5869"\w* desagrada?”.   
\p
\v 20 \w Saúl|strong="H7586"\w* insistió: “¡Pero yo sí obedecí \w a|strong="H3068"\w* Yahvé! \w Fui|strong="H3212"\w* \w a|strong="H3068"\w* la misión que él me encargó, traje prisionero \w a|strong="H3068"\w* Agag, \w rey|strong="H4428"\w* de \w Amalec|strong="H6002"\w*, y destruí \w por|strong="H1870"\w* completo \w a|strong="H3068"\w* los amalecitas.  
\v 21 Fue el \w pueblo|strong="H5971"\w* el \w que|strong="H5971"\w* \w tomó|strong="H3947"\w* del botín las mejores \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* \w vacas|strong="H1241"\w* \w que|strong="H5971"\w* debían haber sido destruidas, \w para|strong="H5971"\w* sacrificarlas \w a|strong="H3068"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* usted, en \w Gilgal|strong="H1537"\w*”.   
\p
\v 22 Entonces \w Samuel|strong="H8050"\w* sentenció: “¿Qué le \w agrada|strong="H2896"\w* más \w a|strong="H3068"\w* Yahvé: los \w sacrificios|strong="H2077"\w* y las ofrendas, \w o|strong="H3068"\w* la obediencia \w a|strong="H3068"\w* su palabra? El \w obedecer|strong="H8085"\w* es \w mejor|strong="H2896"\w* que los \w sacrificios|strong="H2077"\w*, y el prestar atención es \w mejor|strong="H2896"\w* que la grasa de los carneros.  
\v 23 \w La|strong="H3588"\w* rebeldía \w es|strong="H3588"\w* tan grave \w como|strong="H3588"\w* \w la|strong="H3588"\w* brujería, \w y|strong="H3588"\w* \w la|strong="H3588"\w* arrogancia \w es|strong="H3588"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w pecado|strong="H2403"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* idolatría.\f + \fr 15:23 \ft Los terafines eran ídolos familiares que representaban protección o derechos de herencia.\f* \w Como|strong="H3588"\w* tú rechazaste \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé, \w él|strong="H3588"\w* también \w te|strong="H3588"\w* ha rechazado \w como|strong="H3588"\w* \w rey|strong="H4428"\w*”.   
\p
\v 24 \w Saúl|strong="H7586"\w* le confesó \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “He \w pecado|strong="H2398"\w*. He desobedecido \w la|strong="H3588"\w* orden \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* tus instrucciones. Tuve \w miedo|strong="H3372"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w* \w y|strong="H3588"\w* les hice caso.  
\v 25 Por favor, \w perdona|strong="H5375"\w* \w mi|strong="H5375"\w* \w pecado|strong="H2403"\w* y regresa \w conmigo|strong="H5973"\w* \w para|strong="H5973"\w* \w que|strong="H6258"\w* \w yo|strong="H4994"\w* pueda adorar \w a|strong="H3068"\w* Yahvé”.   
\p
\v 26 \w Pero|strong="H3588"\w* \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* \w respondió|strong="H7725"\w*: “\w No|strong="H3808"\w* regresaré \w contigo|strong="H5973"\w*. Tú rechazaste \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H3588"\w* ahora \w él|strong="H5921"\w* \w te|strong="H5921"\w* \w ha|strong="H3808"\w* rechazado \w como|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.  
\v 27 Cuando \w Samuel|strong="H8050"\w* se dio \w vuelta|strong="H5437"\w* para irse, Saúl lo agarró por el borde del \w manto|strong="H4598"\w*, y este se \w rasgó|strong="H7167"\w*.  
\v 28 \w Entonces|strong="H3117"\w* \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* dijo: “\w Hoy|strong="H3117"\w* mismo Yahvé ha arrancado \w de|strong="H4480"\w* \w ti|strong="H5921"\w* \w el|strong="H5921"\w* reino \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* ha \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w otro|strong="H7453"\w* \w mejor|strong="H2896"\w* \w que|strong="H4480"\w* tú.  
\v 29 \w Además|strong="H1571"\w*, \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* Gloria \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* miente \w ni|strong="H3808"\w* cambia \w de|strong="H3588"\w* parecer, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w es|strong="H1931"\w* un hombre \w para|strong="H3588"\w* arrepentirse”.   
\p
\v 30 Saúl suplicó: “He \w pecado|strong="H2398"\w*, pero \w te|strong="H5973"\w* pido \w que|strong="H6258"\w* por favor \w me|strong="H5973"\w* honres \w delante|strong="H5048"\w* \w de|strong="H5048"\w* \w los|strong="H5973"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5048"\w* \w mi|strong="H4994"\w* \w pueblo|strong="H5971"\w* y \w de|strong="H5048"\w* todo \w Israel|strong="H3478"\w*. Regresa \w conmigo|strong="H5973"\w* \w para|strong="H5973"\w* adorar \w a|strong="H3068"\w* Yahvé, \w el|strong="H5973"\w* \w Dios|strong="H3068"\w* \w de|strong="H5048"\w* usted”.   
\p
\v 31 \w Samuel|strong="H8050"\w* aceptó y regresó con \w Saúl|strong="H7586"\w*, y \w Saúl|strong="H7586"\w* \w adoró|strong="H7812"\w* \w a|strong="H3068"\w* Yahvé.  
\v 32 Luego \w Samuel|strong="H8050"\w* ordenó: “Tráiganme \w a|strong="H3068"\w* Agag, \w rey|strong="H4428"\w* de \w Amalec|strong="H6002"\w*”. Agag se \w acercó|strong="H5066"\w* muy confiado, pensando: “Seguramente ya pasaron los horrores de la \w muerte|strong="H4194"\w*”.   
\p
\v 33 Pero \w Samuel|strong="H8050"\w* le dijo: “\w Así|strong="H3651"\w* \w como|strong="H3651"\w* tu \w espada|strong="H2719"\w* dejó \w a|strong="H3068"\w* muchas mujeres sin hijos, \w también|strong="H3651"\w* tu madre \w se|strong="H3651"\w* quedará hoy sin su hijo”. \w Y|strong="H3068"\w* allí mismo, en \w Gilgal|strong="H1537"\w*, \w Samuel|strong="H8050"\w* descuartizó \w a|strong="H3068"\w* Agag \w ante|strong="H6440"\w* Yahvé.   
\p
\v 34 Después \w Samuel|strong="H8050"\w* se \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w*, y \w Saúl|strong="H7586"\w* regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* \w en|strong="H3212"\w* \w Gabaa|strong="H1390"\w*.  
\v 35 \w Samuel|strong="H8050"\w* \w nunca|strong="H3808"\w* \w más|strong="H3588"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w en|strong="H5921"\w* \w toda|strong="H5921"\w* \w su|strong="H3588"\w* \w vida|strong="H3117"\w*, \w pero|strong="H3588"\w* sufría mucho \w por|strong="H5921"\w* \w él|strong="H5921"\w*. \w Y|strong="H3068"\w* Yahvé \w se|strong="H5921"\w* sentía muy triste \w por|strong="H5921"\w* \w haber|strong="H3808"\w* \w puesto|strong="H3588"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w como|strong="H3588"\w* \w rey|strong="H4427"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\c 16  
\p
\v 1 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H3588"\w* \w vas|strong="H3212"\w* \w a|strong="H3068"\w* seguir llorando \w por|strong="H5921"\w* \w Saúl|strong="H7586"\w*, \w si|strong="H3588"\w* ya \w lo|strong="H5921"\w* he rechazado \w como|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*? \w Llena|strong="H4390"\w* un frasco \w con|strong="H5921"\w* \w aceite|strong="H8081"\w* \w y|strong="H3588"\w* ponte \w en|strong="H5921"\w* camino. \w Te|strong="H5921"\w* voy \w a|strong="H3068"\w* enviar \w a|strong="H3068"\w* casa \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w*, \w el|strong="H5921"\w* \w de|strong="H5921"\w* Belén, \w porque|strong="H3588"\w* he elegido \w a|strong="H3068"\w* uno \w de|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w para|strong="H5704"\w* \w que|strong="H3588"\w* sea \w el|strong="H5921"\w* nuevo \w rey|strong="H4428"\w*”.   
\p
\v 2 \w Samuel|strong="H8050"\w* respondió: “¿\w Y|strong="H3068"\w* cómo voy \w a|strong="H3068"\w* \w ir|strong="H3212"\w*? Si \w Saúl|strong="H7586"\w* se entera, me \w matará|strong="H2026"\w*”. Yahvé le dijo: “\w Lleva|strong="H3212"\w* contigo una ternera \w y|strong="H1241"\w* di \w que|strong="H3027"\w* \w vas|strong="H3212"\w* \w a|strong="H3068"\w* ofrecerle un sacrificio \w a|strong="H3068"\w* Yahvé.  
\v 3 Invita \w a|strong="H3068"\w* \w Isaí|strong="H3448"\w* al \w sacrificio|strong="H2077"\w*, y \w yo|strong="H6213"\w* te diré \w lo|strong="H6213"\w* \w que|strong="H3045"\w* debes \w hacer|strong="H6213"\w*. \w Ungirás|strong="H4886"\w* para mí al \w que|strong="H3045"\w* \w yo|strong="H6213"\w* te indique”.   
\p
\v 4 \w Samuel|strong="H8050"\w* \w hizo|strong="H6213"\w* \w lo|strong="H6213"\w* que Yahvé le ordenó y llegó \w a|strong="H3068"\w* Belén. Los \w ancianos|strong="H2205"\w* de la \w ciudad|strong="H5892"\w* salieron \w a|strong="H3068"\w* recibirlo temblando de miedo y le preguntaron: “¿Viene usted en son de \w paz|strong="H7965"\w*?”.   
\p
\v 5 “Sí”, respondió Samuel, “vengo en son \w de|strong="H1121"\w* \w paz|strong="H7965"\w* \w a|strong="H3068"\w* ofrecer un \w sacrificio|strong="H2077"\w* \w a|strong="H3068"\w* Yahvé. Purifíquense y vengan conmigo al \w sacrificio|strong="H2077"\w*”. Luego \w él|strong="H1121"\w* mismo purificó \w a|strong="H3068"\w* \w Isaí|strong="H3448"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, y \w los|strong="H1121"\w* invitó al \w sacrificio|strong="H2077"\w*.  
\v 6 \w Cuando|strong="H1961"\w* ellos llegaron, Samuel \w vio|strong="H7200"\w* \w a|strong="H3068"\w* Eliab y pensó: “Seguramente \w este|strong="H1961"\w* \w es|strong="H1961"\w* el \w ungido|strong="H4899"\w* \w de|strong="H5048"\w* Yahvé”.   
\p
\v 7 \w Pero|strong="H3588"\w* Yahvé \w le|strong="H5869"\w* dijo \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*: “\w No|strong="H3808"\w* \w te|strong="H5869"\w* dejes impresionar \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w apariencia|strong="H4758"\w* \w ni|strong="H3808"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* gran \w estatura|strong="H4758"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w lo|strong="H3808"\w* he rechazado. \w Yo|strong="H3588"\w* \w no|strong="H3808"\w* \w veo|strong="H7200"\w* las cosas \w como|strong="H3588"\w* las \w ve|strong="H7200"\w* \w el|strong="H3588"\w* hombre. \w El|strong="H3588"\w* hombre \w se|strong="H3808"\w* fija \w en|strong="H3588"\w* las apariencias, \w pero|strong="H3588"\w* Yahvé \w se|strong="H3808"\w* fija \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w corazón|strong="H3824"\w*”.   
\p
\v 8 \w Entonces|strong="H1571"\w* \w Isaí|strong="H3448"\w* \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* Abinadab \w y|strong="H1571"\w* \w lo|strong="H2088"\w* hizo \w pasar|strong="H5674"\w* frente \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, pero \w Samuel|strong="H8050"\w* dijo: “\w A|strong="H3068"\w* \w este|strong="H2088"\w* \w tampoco|strong="H1571"\w* \w lo|strong="H2088"\w* \w ha|strong="H3808"\w* elegido Yahvé”.  
\v 9 \w Luego|strong="H5674"\w* \w Isaí|strong="H3448"\w* hizo \w pasar|strong="H5674"\w* \w a|strong="H3068"\w* Samá, \w y|strong="H1571"\w* Samuel dijo: “\w Tampoco|strong="H1571"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w*”.  
\v 10 \w Isaí|strong="H3448"\w* hizo \w pasar|strong="H5674"\w* \w a|strong="H3068"\w* \w siete|strong="H7651"\w* \w de|strong="H6440"\w* sus \w hijos|strong="H1121"\w* \w ante|strong="H6440"\w* \w Samuel|strong="H8050"\w*, pero \w Samuel|strong="H8050"\w* le dijo: “Yahvé \w no|strong="H3808"\w* \w ha|strong="H3808"\w* elegido \w a|strong="H3068"\w* \w ninguno|strong="H3808"\w* \w de|strong="H6440"\w* ellos”.  
\v 11 \w Entonces|strong="H3588"\w* le preguntó \w a|strong="H3068"\w* \w Isaí|strong="H3448"\w*: “¿\w Son|strong="H3588"\w* estos todos tus hijos?”.  
\p \w Isaí|strong="H3448"\w* respondió: “\w Todavía|strong="H5750"\w* \w queda|strong="H7604"\w* \w el|strong="H3588"\w* \w más|strong="H5750"\w* chico, \w pero|strong="H3588"\w* está cuidando \w el|strong="H3588"\w* \w rebaño|strong="H6629"\w*”.  
\p \w Samuel|strong="H8050"\w* le dijo: “Manda \w a|strong="H3068"\w* buscarlo, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* empezaremos \w la|strong="H3588"\w* comida \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* llegue”.   
\p
\v 12 Isaí \w mandó|strong="H7971"\w* \w a|strong="H3068"\w* buscarlo, \w y|strong="H3588"\w* \w cuando|strong="H3588"\w* llegó, resultó ser un joven \w de|strong="H3588"\w* piel sonrosada, \w ojos|strong="H5869"\w* \w hermosos|strong="H3303"\w* \w y|strong="H3588"\w* muy \w bien|strong="H2896"\w* parecido. \w Entonces|strong="H3588"\w* Yahvé dijo: “¡\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* úngelo, \w porque|strong="H3588"\w* \w este|strong="H2088"\w* \w es|strong="H1931"\w*!”.   
\p
\v 13 \w Samuel|strong="H8050"\w* \w tomó|strong="H3947"\w* \w el|strong="H1931"\w* frasco de \w aceite|strong="H8081"\w* y \w lo|strong="H1931"\w* \w ungió|strong="H4886"\w* \w en|strong="H3212"\w* presencia de \w sus|strong="H1931"\w* hermanos. Desde \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* \w Espíritu|strong="H7307"\w* de Yahvé \w vino|strong="H3212"\w* con poder \w sobre|strong="H4605"\w* \w David|strong="H1732"\w*. Después de \w esto|strong="H1931"\w*, \w Samuel|strong="H8050"\w* regresó \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w*.  
\v 14 \w El|strong="H5973"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5973"\w* Yahvé se apartó \w de|strong="H5973"\w* \w Saúl|strong="H7586"\w*, y \w en|strong="H5973"\w* su lugar, un \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* enviado por Yahvé comenzó \w a|strong="H3068"\w* atormentarlo.  
\v 15 Los servidores \w de|strong="H7451"\w* \w Saúl|strong="H7586"\w* le dijeron: “Usted se da cuenta \w de|strong="H7451"\w* \w que|strong="H4994"\w* un \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* \w de|strong="H7451"\w* parte \w de|strong="H7451"\w* Dios lo está atormentando.  
\v 16 Ordene usted \w a|strong="H3068"\w* sus servidores \w que|strong="H4994"\w* \w busquen|strong="H1245"\w* \w a|strong="H3068"\w* alguien \w que|strong="H4994"\w* \w sepa|strong="H3045"\w* \w tocar|strong="H5059"\w* \w el|strong="H5921"\w* \w arpa|strong="H3658"\w*. Así, \w cuando|strong="H1961"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* Dios \w lo|strong="H5921"\w* ataque, \w él|strong="H5921"\w* tocará \w el|strong="H5921"\w* \w arpa|strong="H3658"\w* \w y|strong="H5921"\w* usted \w se|strong="H3045"\w* sentirá \w mejor|strong="H2895"\w*”.   
\p
\v 17 \w Saúl|strong="H7586"\w* les respondió: “Está \w bien|strong="H3190"\w*, búsquenme \w a|strong="H3068"\w* alguien \w que|strong="H4994"\w* toque \w bien|strong="H3190"\w* y tráiganmelo”.   
\p
\v 18 Uno \w de|strong="H5973"\w* \w los|strong="H1121"\w* jóvenes servidores dijo: “\w Yo|strong="H2009"\w* he \w visto|strong="H7200"\w* \w a|strong="H3068"\w* uno \w de|strong="H5973"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* \w Isaí|strong="H3448"\w*, \w el|strong="H5973"\w* \w de|strong="H5973"\w* Belén. \w Sabe|strong="H3045"\w* \w tocar|strong="H5059"\w* muy \w bien|strong="H7200"\w*, \w es|strong="H1697"\w* un guerrero \w valiente|strong="H1368"\w*, \w habla|strong="H1697"\w* \w con|strong="H5973"\w* prudencia, \w es|strong="H1697"\w* \w bien|strong="H7200"\w* parecido y Yahvé está \w con|strong="H5973"\w* \w él|strong="H5973"\w*”.   
\p
\v 19 Entonces \w Saúl|strong="H7586"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w Isaí|strong="H3448"\w* para decirle: “Mándame \w a|strong="H3068"\w* tu \w hijo|strong="H1121"\w* \w David|strong="H1732"\w*, \w el|strong="H1121"\w* \w que|strong="H1121"\w* cuida las \w ovejas|strong="H6629"\w*”.   
\p
\v 20 \w Isaí|strong="H3448"\w* \w tomó|strong="H3947"\w* un burro y lo \w cargó|strong="H3027"\w* con \w pan|strong="H3899"\w*, un frasco \w de|strong="H1121"\w* \w vino|strong="H3196"\w* y un \w cabrito|strong="H1423"\w*, y se \w los|strong="H1121"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* con su \w hijo|strong="H1121"\w* \w David|strong="H1732"\w*.  
\v 21 \w Cuando|strong="H1961"\w* \w David|strong="H1732"\w* llegó \w ante|strong="H6440"\w* \w Saúl|strong="H7586"\w*, \w se|strong="H1961"\w* \w puso|strong="H5975"\w* \w a|strong="H3068"\w* su servicio. \w Saúl|strong="H7586"\w* llegó \w a|strong="H3068"\w* quererlo \w mucho|strong="H3966"\w* y lo nombró su ayudante \w de|strong="H6440"\w* \w armas|strong="H3627"\w*.  
\v 22 \w Saúl|strong="H7586"\w* \w le|strong="H5869"\w* \w mandó|strong="H7971"\w* decir \w a|strong="H3068"\w* \w Isaí|strong="H3448"\w*: “\w Deja|strong="H7971"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* se quede \w a|strong="H3068"\w* \w mi|strong="H4994"\w* servicio, \w pues|strong="H3588"\w* \w me|strong="H3588"\w* ha caído muy \w bien|strong="H3588"\w*”.  
\v 23 Cada vez \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* Dios atacaba \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, \w David|strong="H1732"\w* \w tomaba|strong="H3947"\w* \w el|strong="H5921"\w* \w arpa|strong="H3658"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* ponía \w a|strong="H3068"\w* \w tocar|strong="H5059"\w*. \w Entonces|strong="H5493"\w* \w Saúl|strong="H7586"\w* \w se|strong="H1961"\w* calmaba \w y|strong="H5921"\w* \w se|strong="H1961"\w* sentía \w mejor|strong="H2895"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* \w se|strong="H1961"\w* apartaba \w de|strong="H5921"\w* \w él|strong="H5921"\w*.   
\c 17  
\p
\v 1 Los \w filisteos|strong="H6430"\w* reunieron sus \w ejércitos|strong="H4264"\w* para la \w guerra|strong="H4421"\w* en Soco, una ciudad de \w Judá|strong="H3063"\w*. Acamparon en Efes-damim, entre Soco y \w Azeca|strong="H5825"\w*.  
\v 2 Por su parte, \w Saúl|strong="H7586"\w* y los israelitas se reunieron y acamparon en el \w valle|strong="H6010"\w* de Ela, y se prepararon para pelear \w contra|strong="H3478"\w* los \w filisteos|strong="H6430"\w*.  
\v 3 Los \w filisteos|strong="H6430"\w* \w estaban|strong="H5975"\w* \w en|strong="H5975"\w* un \w monte|strong="H2022"\w* \w a|strong="H3068"\w* un lado del \w valle|strong="H1516"\w*, y los israelitas \w en|strong="H5975"\w* \w otro|strong="H2088"\w* \w monte|strong="H2022"\w* al lado opuesto, con el \w valle|strong="H1516"\w* de \w por|strong="H2088"\w* medio.  
\v 4 De pronto, un guerrero famoso \w llamado|strong="H8034"\w* Goliat, que era de la ciudad de Gat, \w salió|strong="H3318"\w* del \w campamento|strong="H4264"\w* \w filisteo|strong="H6430"\w*. Medía \w seis|strong="H8337"\w* codos y un \w palmo|strong="H2239"\w* de estatura.\f + \fr 17:4 \ft Un codo es la longitud desde la punta del dedo corazón hasta el codo del brazo de un hombre, es decir, unas 18 pulgadas o 46 centímetros. Un palmo es la longitud desde la punta del pulgar de un hombre hasta la punta de su dedo meñique cuando su mano está extendida (aproximadamente medio codo, o 9 pulgadas, o 22,8 cm.) Por lo tanto, Goliat medía aproximadamente 9 pies y 9 pulgadas o 2,97 metros de altura.\f*  
\v 5 Llevaba \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* un casco \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* vestía una armadura \w de|strong="H5921"\w* escamas, también \w de|strong="H5921"\w* bronce, \w que|strong="H1931"\w* pesaba \w cinco|strong="H2568"\w* mil \w siclos|strong="H8255"\w*\f + \fr 17:5 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 5000 siclos equivalen a unos 50 kilogramos o 110 libras.\f*.  
\v 6 También protegía sus piernas \w con|strong="H5921"\w* grebas \w de|strong="H5921"\w* bronce \w y|strong="H5921"\w* llevaba una jabalina \w de|strong="H5921"\w* bronce \w a|strong="H3068"\w* \w la|strong="H5921"\w* espalda.  
\v 7 El asta \w de|strong="H6440"\w* su \w lanza|strong="H2595"\w* era gruesa como el rodillo \w de|strong="H6440"\w* un telar, y la punta era \w de|strong="H6440"\w* \w hierro|strong="H1270"\w* y pesaba \w seiscientos|strong="H8337"\w* \w siclos|strong="H8255"\w*\f + \fr 17:7 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 600 siclos son unos 6 kilogramos o unas 13 libras.\f*. Su ayudante \w de|strong="H6440"\w* armas \w iba|strong="H1980"\w* \w siempre|strong="H1980"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* él.  
\v 8 Goliat \w se|strong="H3808"\w* detuvo y les \w gritó|strong="H7121"\w* \w a|strong="H3068"\w* los soldados de \w Israel|strong="H3478"\w*: “¿Para \w qué|strong="H4100"\w* \w salen|strong="H3318"\w* \w a|strong="H3068"\w* pelear? Yo soy \w filisteo|strong="H6430"\w*, y ustedes \w son|strong="H3808"\w* servidores de \w Saúl|strong="H7586"\w*. Elijan \w a|strong="H3068"\w* uno de ustedes y \w que|strong="H4100"\w* baje \w a|strong="H3068"\w* pelear conmigo.  
\v 9 \w Si|strong="H1961"\w* él \w puede|strong="H3201"\w* \w pelear|strong="H3201"\w* conmigo y me mata, nosotros \w seremos|strong="H1961"\w* esclavos \w de|strong="H3898"\w* ustedes; pero \w si|strong="H1961"\w* yo le gano y lo \w mato|strong="H5221"\w*, ustedes \w serán|strong="H1961"\w* nuestros esclavos y nos \w servirán|strong="H5647"\w*”.  
\v 10 El \w filisteo|strong="H6430"\w* añadió: “¡Yo desafío \w hoy|strong="H3117"\w* al ejército \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*! ¡Denme \w a|strong="H3068"\w* \w un|strong="H3162"\w* hombre \w para|strong="H5414"\w* \w que|strong="H3117"\w* peleemos los \w dos|strong="H3117"\w*!”.   
\p
\v 11 Al \w oír|strong="H8085"\w* \w el|strong="H3605"\w* desafío del \w filisteo|strong="H6430"\w*, \w Saúl|strong="H7586"\w* y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas se desanimaron y se llenaron \w de|strong="H1697"\w* \w miedo|strong="H3372"\w*.  
\v 12 \w David|strong="H1732"\w* \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* un \w hombre|strong="H1121"\w* \w llamado|strong="H8034"\w* \w Isaí|strong="H3448"\w*, \w que|strong="H3117"\w* \w era|strong="H1121"\w* un efrateo \w de|strong="H1121"\w* Belén \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*. \w Isaí|strong="H3448"\w* tenía \w ocho|strong="H8083"\w* \w hijos|strong="H1121"\w* y \w ya|strong="H2088"\w* \w era|strong="H1121"\w* muy anciano en \w los|strong="H1121"\w* \w tiempos|strong="H3117"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*.  
\v 13 Sus \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* \w mayores|strong="H1419"\w*, Eliab \w el|strong="H1121"\w* \w primogénito|strong="H1060"\w*, Abinadab y Samá, se habían \w ido|strong="H3212"\w* \w a|strong="H3068"\w* la \w guerra|strong="H4421"\w* con \w Saúl|strong="H7586"\w*.  
\v 14 \w David|strong="H1732"\w* \w era|strong="H1931"\w* \w el|strong="H1931"\w* más joven de todos. Mientras \w los|strong="H1931"\w* \w tres|strong="H7969"\w* \w mayores|strong="H1419"\w* seguían \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*,  
\v 15 \w David|strong="H1732"\w* \w iba|strong="H1980"\w* \w al|strong="H5921"\w* campamento \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w y|strong="H5921"\w* regresaba \w a|strong="H3068"\w* Belén \w para|strong="H5921"\w* cuidar \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w de|strong="H5921"\w* su padre.   
\p
\v 16 \w El|strong="H5066"\w* \w filisteo|strong="H6430"\w* salía \w a|strong="H3068"\w* lanzar su desafío mañana y tarde, y así lo hizo durante cuarenta \w días|strong="H3117"\w*.   
\p
\v 17 Un \w día|strong="H1121"\w*, \w Isaí|strong="H3448"\w* le dijo \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w David|strong="H1732"\w*: “\w Toma|strong="H3947"\w* \w estos|strong="H2088"\w* veinte kilos\f + \fr 17:17 \ft 1 efa equivale a unos 22 litros o a 2/3 de una fanega\f* \w de|strong="H1121"\w* trigo \w tostado|strong="H7039"\w* y \w estos|strong="H2088"\w* \w diez|strong="H6235"\w* \w panes|strong="H3899"\w*, y llévaselos rápido \w a|strong="H3068"\w* tus hermanos al \w campamento|strong="H4264"\w*.  
\v 18 Lleva también estos \w diez|strong="H6235"\w* \w quesos|strong="H2757"\w* para el \w comandante|strong="H8269"\w* del batallón. Mira cómo están tus hermanos y tráeme alguna señal \w de|strong="H8269"\w* que están \w bien|strong="H7965"\w*”.  
\v 19 \w Saúl|strong="H7586"\w*, \w los|strong="H1992"\w* hermanos \w de|strong="H5973"\w* David y \w todos|strong="H3605"\w* \w los|strong="H1992"\w* israelitas estaban \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w valle|strong="H6010"\w* \w de|strong="H5973"\w* Ela, \w peleando|strong="H3898"\w* \w contra|strong="H5973"\w* \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w*.   
\p
\v 20 \w David|strong="H1732"\w* \w se|strong="H5921"\w* \w levantó|strong="H5375"\w* muy temprano, \w dejó|strong="H5203"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w al|strong="H5921"\w* cuidado \w de|strong="H5921"\w* un pastor, \w tomó|strong="H5375"\w* \w las|strong="H5921"\w* provisiones \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w fue|strong="H3212"\w*, tal \w como|strong="H5921"\w* \w Isaí|strong="H3448"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* había \w ordenado|strong="H6680"\w*. \w Llegó|strong="H3212"\w* \w al|strong="H5921"\w* campamento justo cuando \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* \w salía|strong="H3318"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w* lanzando gritos \w de|strong="H5921"\w* \w guerra|strong="H4421"\w*.  
\v 21 Los israelitas y los \w filisteos|strong="H6430"\w* se alinearon frente \w a|strong="H3068"\w* frente para el \w combate|strong="H4634"\w*.  
