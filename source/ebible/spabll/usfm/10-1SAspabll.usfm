\v 26 \w Entonces|strong="H5493"\w* \w David|strong="H1732"\w* \w les|strong="H5973"\w* preguntó \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w estaban|strong="H5975"\w* \w con|strong="H5973"\w* \w él|strong="H5921"\w*: “¿\w Qué|strong="H3588"\w* \w le|strong="H5921"\w* \w darán|strong="H6213"\w* \w a|strong="H3068"\w* \w quien|strong="H4310"\w* mate \w a|strong="H3068"\w* \w ese|strong="H2088"\w* \w filisteo|strong="H6430"\w* \w y|strong="H3588"\w* \w le|strong="H5921"\w* \w quite|strong="H5493"\w* \w esta|strong="H2088"\w* vergüenza \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*? ¿\w Quién|strong="H4310"\w* \w se|strong="H5921"\w* cree \w este|strong="H2088"\w* \w filisteo|strong="H6430"\w* pagano \w para|strong="H5921"\w* desafiar \w al|strong="H5921"\w* ejército \w del|strong="H5921"\w* Dios \w viviente|strong="H2416"\w*?”.   
\p
