\v 45 \w David|strong="H1732"\w* le respondió al \w filisteo|strong="H6430"\w*: “Tú vienes \w contra|strong="H3478"\w* mí con \w espada|strong="H2719"\w*, \w lanza|strong="H2595"\w* y jabalina, pero yo vengo \w contra|strong="H3478"\w* ti en el \w nombre|strong="H8034"\w* de Yahvé de los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* de los \w escuadrones|strong="H4634"\w* de \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* quien tú has desafiado.  
\v 46 \w Hoy|strong="H3117"\w* \w mismo|strong="H3605"\w* Yahvé \w te|strong="H5921"\w* \w entregará|strong="H5414"\w* \w en|strong="H5921"\w* \w mis|strong="H5414"\w* \w manos|strong="H3027"\w*. \w Te|strong="H5921"\w* mataré \w y|strong="H3588"\w* \w te|strong="H5921"\w* cortaré \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*. \w Hoy|strong="H3117"\w* \w mismo|strong="H3605"\w* echaré \w los|strong="H5921"\w* cadáveres \w del|strong="H5921"\w* \w ejército|strong="H4264"\w* \w filisteo|strong="H6430"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w aves|strong="H5775"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* fieras \w del|strong="H5921"\w* \w campo|strong="H4264"\w*, \w y|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* mundo \w sabrá|strong="H3045"\w* \w que|strong="H3588"\w* \w hay|strong="H3426"\w* un \w Dios|strong="H3068"\w* \w en|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 47 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w aquí|strong="H2088"\w* reunidos \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* Yahvé \w no|strong="H3808"\w* \w salva|strong="H3467"\w* \w por|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w* \w ni|strong="H3808"\w* \w de|strong="H3588"\w* \w la|strong="H3605"\w* \w lanza|strong="H2595"\w*, \w porque|strong="H3588"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w* \w es|strong="H2088"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w los|strong="H3605"\w* \w entregará|strong="H5414"\w* \w a|strong="H3068"\w* ustedes \w en|strong="H3588"\w* nuestras \w manos|strong="H3027"\w*”.   
\p
\v 48 \w Cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w filisteo|strong="H6430"\w* comenzó \w a|strong="H3068"\w* avanzar hacia \w David|strong="H1732"\w* \w para|strong="H3588"\w* atacarlo, \w David|strong="H1732"\w* \w corrió|strong="H7323"\w* rápidamente hacia \w la|strong="H3588"\w* línea \w de|strong="H3588"\w* batalla.  
\v 49 \w Metió|strong="H7971"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w en|strong="H5921"\w* su morral, sacó una piedra \w y|strong="H5921"\w* \w la|strong="H5921"\w* lanzó \w con|strong="H5921"\w* \w la|strong="H5921"\w* honda. \w La|strong="H5921"\w* piedra \w se|strong="H5921"\w* \w le|strong="H5921"\w* hundió \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w frente|strong="H4696"\w* \w al|strong="H5921"\w* \w filisteo|strong="H6430"\w*, \w y|strong="H5921"\w* este \w cayó|strong="H5307"\w* \w de|strong="H5921"\w* \w cara|strong="H6440"\w* \w al|strong="H5921"\w* suelo.  
\v 50 \w Así|strong="H2388"\w* fue como \w David|strong="H1732"\w* \w venció|strong="H5221"\w* \w al|strong="H4480"\w* \w filisteo|strong="H6430"\w* \w con|strong="H4480"\w* una honda y una piedra. Lo \w hirió|strong="H5221"\w* \w de|strong="H4480"\w* \w muerte|strong="H4191"\w* sin tener una \w espada|strong="H2719"\w* \w en|strong="H4480"\w* la \w mano|strong="H3027"\w*.  
\v 51 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* \w corrió|strong="H7323"\w*, se paró sobre \w el|strong="H3588"\w* \w filisteo|strong="H6430"\w*, le \w quitó|strong="H3947"\w* \w su|strong="H3588"\w* propia \w espada|strong="H2719"\w* \w y|strong="H3588"\w*, \w sacándola|strong="H8025"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* vaina, lo \w mató|strong="H4191"\w* \w y|strong="H3588"\w* le \w cortó|strong="H3772"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*.  
\p \w Cuando|strong="H3588"\w* \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* héroe \w había|strong="H5975"\w* \w muerto|strong="H4191"\w*, salieron huyendo.  
\v 52 Entonces \w los|strong="H7291"\w* soldados \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* lanzaron un grito \w de|strong="H5704"\w* guerra \w y|strong="H5704"\w* \w persiguieron|strong="H7291"\w* \w a|strong="H3068"\w* \w los|strong="H7291"\w* \w filisteos|strong="H6430"\w* \w hasta|strong="H5704"\w* la entrada \w de|strong="H5704"\w* Gat \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* las \w puertas|strong="H8179"\w* \w de|strong="H5704"\w* \w Ecrón|strong="H6138"\w*. \w El|strong="H5307"\w* \w camino|strong="H1870"\w* \w de|strong="H5704"\w* Saaraim quedó lleno \w de|strong="H5704"\w* cadáveres \w filisteos|strong="H6430"\w* \w hasta|strong="H5704"\w* Gat \w y|strong="H5704"\w* \w Ecrón|strong="H6138"\w*.  
\v 53 Cuando \w los|strong="H1121"\w* israelitas regresaron \w de|strong="H1121"\w* perseguir \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*, saquearon su \w campamento|strong="H4264"\w*.  
\v 54 \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* la \w cabeza|strong="H7218"\w* del \w filisteo|strong="H6430"\w* y la \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* Jerusalén, pero guardó las \w armas|strong="H3627"\w* de Goliat en su propia tienda.  
\v 55 Cuando \w Saúl|strong="H7586"\w* \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w salir|strong="H3318"\w* \w a|strong="H3068"\w* pelear contra \w el|strong="H4310"\w* \w filisteo|strong="H6430"\w*, \w le|strong="H4310"\w* preguntó \w a|strong="H3068"\w* Abner, \w el|strong="H4310"\w* \w general|strong="H8269"\w* del \w ejército|strong="H6635"\w*: “Abner, ¿\w de|strong="H1121"\w* \w quién|strong="H4310"\w* \w es|strong="H2088"\w* \w hijo|strong="H1121"\w* \w ese|strong="H2088"\w* joven?”. Abner respondió: “\w Le|strong="H4310"\w* juro \w por|strong="H2088"\w* \w mi|strong="H5315"\w* \w vida|strong="H5315"\w*, Majestad, \w que|strong="H4310"\w* no \w lo|strong="H2088"\w* \w sé|strong="H3045"\w*”.   
\p
\v 56 “Averigua \w de|strong="H1121"\w* \w quién|strong="H4310"\w* \w es|strong="H2088"\w* \w hijo|strong="H1121"\w* \w ese|strong="H2088"\w* muchacho”, ordenó \w el|strong="H4310"\w* \w rey|strong="H4428"\w*.   
\p
\v 57 \w En|strong="H5221"\w* cuanto \w David|strong="H1732"\w* regresó \w de|strong="H6440"\w* matar \w a|strong="H3068"\w* Goliat, Abner lo \w llevó|strong="H3947"\w* \w ante|strong="H6440"\w* \w Saúl|strong="H7586"\w*. \w David|strong="H1732"\w* todavía llevaba la \w cabeza|strong="H7218"\w* del \w filisteo|strong="H6430"\w* \w en|strong="H5221"\w* la \w mano|strong="H3027"\w*.  
\v 58 \w Saúl|strong="H7586"\w* \w le|strong="H4310"\w* preguntó: “Joven, ¿\w de|strong="H1121"\w* \w quién|strong="H4310"\w* eres \w hijo|strong="H1121"\w*?”. \w Y|strong="H3068"\w* \w David|strong="H1732"\w* respondió: “Soy \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* su servidor \w Isaí|strong="H3448"\w*, \w el|strong="H4310"\w* \w de|strong="H1121"\w* Belén”.   
\c 18  
\p
\v 1 Tan pronto \w como|strong="H1961"\w* \w David|strong="H1732"\w* terminó de \w hablar|strong="H1696"\w* con \w Saúl|strong="H7586"\w*, \w nació|strong="H1961"\w* una amistad muy profunda entre Jonatán y \w David|strong="H1732"\w*; Jonatán llegó \w a|strong="H3068"\w* amarlo \w como|strong="H1961"\w* \w a|strong="H3068"\w* \w sí|strong="H1961"\w* mismo.  
\v 2 Desde \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w Saúl|strong="H7586"\w* \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* David \w a|strong="H3068"\w* \w su|strong="H1931"\w* servicio y \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w dejó|strong="H5414"\w* regresar \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H5414"\w* \w su|strong="H1931"\w* padre.  
\v 3 Jonatán y \w David|strong="H1732"\w* \w hicieron|strong="H3772"\w* un \w pacto|strong="H1285"\w* de amistad, \w porque|strong="H1732"\w* Jonatán lo amaba como \w a|strong="H3068"\w* su propia \w vida|strong="H5315"\w*.  
\v 4 Jonatán \w se|strong="H5921"\w* quitó \w el|strong="H5921"\w* \w manto|strong="H4598"\w* \w que|strong="H5921"\w* llevaba \w puesto|strong="H5414"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w lo|strong="H5921"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w junto|strong="H5921"\w* \w con|strong="H5921"\w* su ropa militar, su \w espada|strong="H2719"\w*, su \w arco|strong="H7198"\w* \w y|strong="H5921"\w* su cinturón.   
\p
\v 5 \w David|strong="H1732"\w* tenía éxito \w en|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* misiones \w que|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w le|strong="H5921"\w* encargaba, \w así|strong="H1571"\w* \w que|strong="H5921"\w* \w Saúl|strong="H7586"\w* \w lo|strong="H5921"\w* \w puso|strong="H7760"\w* \w al|strong="H5921"\w* \w mando|strong="H7971"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* su ejército. Esto \w le|strong="H5921"\w* \w pareció|strong="H5869"\w* \w bien|strong="H3190"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* oficiales \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*.   
\p
\v 6 \w Cuando|strong="H1961"\w* \w David|strong="H1732"\w* y \w el|strong="H3605"\w* ejército regresaban \w después|strong="H1961"\w* de \w haber|strong="H1961"\w* derrotado \w al|strong="H4428"\w* \w filisteo|strong="H6430"\w*, las mujeres de \w todos|strong="H3605"\w* \w los|strong="H3605"\w* pueblos de \w Israel|strong="H3478"\w* \w salían|strong="H3318"\w* \w a|strong="H3068"\w* recibir \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Saúl|strong="H7586"\w*. Iban \w cantando|strong="H7891"\w* y bailando con panderetas, gritos de \w alegría|strong="H8057"\w* y otros instrumentos musicales.  
\v 7 Mientras danzaban, las mujeres cantaban:  
\q1 “\w Saúl|strong="H7586"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* miles,  
\q2 ¡pero \w David|strong="H1732"\w* \w a|strong="H3068"\w* diez miles!”.   
\p
\v 8 \w Esto|strong="H2088"\w* \w le|strong="H5869"\w* molestó \w mucho|strong="H3966"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, y \w muy|strong="H3966"\w* \w enojado|strong="H2734"\w* dijo: “\w A|strong="H3068"\w* \w David|strong="H1732"\w* \w le|strong="H5869"\w* \w dan|strong="H5414"\w* el crédito \w por|strong="H1697"\w* diez miles, y \w a|strong="H3068"\w* mí solo \w por|strong="H1697"\w* miles. ¡\w Ya|strong="H3068"\w* solo falta \w que|strong="H1697"\w* \w le|strong="H5869"\w* den el \w reino|strong="H4410"\w*!”.  
\v 9 Desde \w ese|strong="H1931"\w* momento, \w Saúl|strong="H7586"\w* empezó \w a|strong="H3068"\w* mirar \w a|strong="H3068"\w* \w David|strong="H1732"\w* con envidia y desconfianza.  
\v 10 Al \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*, un \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* enviado \w por|strong="H3027"\w* Dios \w se|strong="H1961"\w* apoderó \w de|strong="H7451"\w* \w Saúl|strong="H7586"\w*, y él empezó \w a|strong="H3068"\w* desvariar \w dentro|strong="H8432"\w* \w de|strong="H7451"\w* su \w casa|strong="H1004"\w*. \w David|strong="H1732"\w* \w estaba|strong="H1961"\w* tocando el arpa \w como|strong="H1961"\w* lo hacía todos \w los|strong="H1961"\w* \w días|strong="H3117"\w*, y \w Saúl|strong="H7586"\w* \w tenía|strong="H1961"\w* su \w lanza|strong="H2595"\w* \w en|strong="H8432"\w* la \w mano|strong="H3027"\w*.  
\v 11 \w De|strong="H6440"\w* repente, \w Saúl|strong="H7586"\w* \w arrojó|strong="H2904"\w* la \w lanza|strong="H2595"\w* pensando: “¡Voy \w a|strong="H3068"\w* clavar \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w en|strong="H5221"\w* la \w pared|strong="H7023"\w*!”. Pero \w David|strong="H1732"\w* esquivó el \w golpe|strong="H6471"\w* \w dos|strong="H6471"\w* \w veces|strong="H6471"\w*.  
\v 12 \w Saúl|strong="H7586"\w* \w le|strong="H5973"\w* \w tenía|strong="H1961"\w* \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w porque|strong="H3588"\w* \w se|strong="H1961"\w* daba cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w estaba|strong="H1961"\w* \w con|strong="H5973"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* lo \w había|strong="H1961"\w* abandonado \w a|strong="H3068"\w* \w él|strong="H5973"\w*.  
\v 13 \w Por|strong="H6440"\w* eso \w Saúl|strong="H7586"\w* alejó \w a|strong="H3068"\w* David \w de|strong="H6440"\w* su \w presencia|strong="H6440"\w* y lo nombró \w comandante|strong="H8269"\w* \w de|strong="H6440"\w* mil soldados; y David dirigía al \w pueblo|strong="H5971"\w* \w en|strong="H5973"\w* la batalla.   
\p
\v 14 \w David|strong="H1732"\w* \w tenía|strong="H1961"\w* mucho éxito \w en|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w hacía|strong="H1870"\w*, \w porque|strong="H1732"\w* Yahvé \w estaba|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*.  
\v 15 Al \w ver|strong="H7200"\w* \w Saúl|strong="H7586"\w* \w que|strong="H1931"\w* David \w tenía|strong="H1931"\w* \w tanto|strong="H3966"\w* éxito, \w le|strong="H1931"\w* tuvo más miedo todavía.  
\v 16 \w Pero|strong="H3588"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w Judá|strong="H3063"\w* querían \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* \w era|strong="H1931"\w* \w quien|strong="H3605"\w* \w los|strong="H3605"\w* guiaba \w en|strong="H3588"\w* \w sus|strong="H1931"\w* campañas militares.  
\v 17 Un \w día|strong="H1121"\w*, \w Saúl|strong="H7586"\w* le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Aquí|strong="H2009"\w* tienes \w a|strong="H3068"\w* \w Merab|strong="H4764"\w*, \w mi|strong="H2009"\w* \w hija|strong="H1323"\w* \w mayor|strong="H1419"\w*. Te la \w daré|strong="H5414"\w* \w por|strong="H3027"\w* esposa, con la condición \w de|strong="H1121"\w* \w que|strong="H1121"\w* me sirvas con valentía y pelees las \w batallas|strong="H4421"\w* \w de|strong="H1121"\w* Yahvé”. Lo \w que|strong="H1121"\w* \w Saúl|strong="H7586"\w* pensaba \w era|strong="H1961"\w*: “\w No|strong="H1961"\w* lo voy \w a|strong="H3068"\w* matar \w yo|strong="H2009"\w* mismo; \w que|strong="H1121"\w* lo maten \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*”.   
\p
\v 18 \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* \w le|strong="H4310"\w* respondió: “¿\w Quién|strong="H4310"\w* \w soy|strong="H1961"\w* \w yo|strong="H3588"\w*, \w y|strong="H3588"\w* \w qué|strong="H3588"\w* \w es|strong="H1961"\w* \w mi|strong="H1961"\w* \w familia|strong="H4940"\w* \w o|strong="H3068"\w* \w el|strong="H3588"\w* clan \w de|strong="H3588"\w* \w mi|strong="H1961"\w* padre \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w sea|strong="H1961"\w* \w yerno|strong="H2860"\w* del \w rey|strong="H4428"\w*?”.   
\p
\v 19 Sin embargo, \w cuando|strong="H1961"\w* llegó \w el|strong="H1931"\w* \w tiempo|strong="H6256"\w* \w de|strong="H5414"\w* entregar \w a|strong="H3068"\w* \w Merab|strong="H4764"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w Saúl|strong="H7586"\w* \w se|strong="H1961"\w* \w la|strong="H1931"\w* \w dio|strong="H5414"\w* \w por|strong="H5414"\w* esposa \w a|strong="H3068"\w* Adriel, \w el|strong="H1931"\w* \w de|strong="H5414"\w* Meholá.   
\p
\v 20 Mientras tanto, Mical, \w la|strong="H4324"\w* otra \w hija|strong="H1323"\w* \w de|strong="H1697"\w* \w Saúl|strong="H7586"\w*, se enamoró \w de|strong="H1697"\w* \w David|strong="H1732"\w*. Cuando se \w lo|strong="H1697"\w* \w contaron|strong="H5046"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, el \w asunto|strong="H1697"\w* \w le|strong="H5869"\w* \w pareció|strong="H3474"\w* \w bien|strong="H5869"\w*.  
\v 21 \w Saúl|strong="H7586"\w* pensó: “\w Se|strong="H1961"\w* la voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w para|strong="H5414"\w* \w que|strong="H3117"\w* ella le sirva \w de|strong="H5414"\w* trampa y \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* lo maten”. Así \w que|strong="H3117"\w* \w Saúl|strong="H7586"\w* le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w por|strong="H3027"\w* segunda vez: “\w Hoy|strong="H3117"\w* \w serás|strong="H1961"\w* \w mi|strong="H1961"\w* yerno”.   
\p
\v 22 \w Saúl|strong="H7586"\w* \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* sus servidores: “\w Hablen|strong="H1696"\w* con \w David|strong="H1732"\w* en secreto y díganle: “\w El|strong="H3605"\w* \w rey|strong="H4428"\w* te aprecia mucho y \w todos|strong="H3605"\w* sus oficiales te quieren. Acepta ser \w el|strong="H3605"\w* yerno del \w rey|strong="H4428"\w*””.   
\p
\v 23 Los servidores \w de|strong="H1697"\w* \w Saúl|strong="H7586"\w* \w le|strong="H5869"\w* repitieron \w esto|strong="H1697"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, pero él respondió: “¿\w A|strong="H3068"\w* ustedes les parece \w que|strong="H1697"\w* \w es|strong="H1697"\w* cualquier \w cosa|strong="H1697"\w* ser yerno del \w rey|strong="H4428"\w*? Yo soy un hombre \w pobre|strong="H7326"\w* y \w de|strong="H1697"\w* familia humilde”.   
\p
\v 24 \w Cuando|strong="H5650"\w* los servidores le \w contaron|strong="H5046"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w David|strong="H1732"\w* había \w dicho|strong="H1697"\w*,   
\p
\v 25 \w Saúl|strong="H7586"\w* les ordenó: “Digan \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w no|strong="H3588"\w* quiere ningún dinero \w por|strong="H3588"\w* \w la|strong="H3588"\w* dote; lo único \w que|strong="H3588"\w* pide \w son|strong="H3588"\w* \w cien|strong="H3967"\w* \w prepucios|strong="H6190"\w* \w de|strong="H3588"\w* \w filisteos|strong="H6430"\w*, \w como|strong="H3588"\w* \w venganza|strong="H5358"\w* contra sus enemigos””. Lo \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* quería era \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w* mataran \w a|strong="H3068"\w* \w David|strong="H1732"\w*.  
\v 26 \w Cuando|strong="H3117"\w* los servidores \w le|strong="H5869"\w* dieron el mensaje, \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w le|strong="H5869"\w* \w pareció|strong="H3474"\w* \w bien|strong="H5869"\w* el trato para convertirse en yerno del \w rey|strong="H4428"\w*. Antes \w de|strong="H1697"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* cumpliera el plazo,  
\v 27 \w David|strong="H1732"\w* y \w sus|strong="H1931"\w* hombres salieron y \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w doscientos|strong="H3967"\w* \w filisteos|strong="H6430"\w*. \w David|strong="H1732"\w* llevó \w los|strong="H1931"\w* \w prepucios|strong="H6190"\w* y \w se|strong="H1931"\w* \w los|strong="H1931"\w* \w entregó|strong="H5414"\w* todos \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w para|strong="H5414"\w* poder ser \w su|strong="H1931"\w* yerno. Entonces \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* \w dio|strong="H5414"\w* \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w hija|strong="H1323"\w* Mical \w por|strong="H5414"\w* esposa.  
\v 28 \w Saúl|strong="H7586"\w* \w se|strong="H3045"\w* dio cuenta claramente \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé estaba \w con|strong="H5973"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w hija|strong="H1323"\w* Mical lo amaba.  
\v 29 \w Por|strong="H6440"\w* eso \w Saúl|strong="H7586"\w* \w le|strong="H3254"\w* \w tuvo|strong="H1961"\w* \w más|strong="H5750"\w* \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w fue|strong="H1961"\w* su enemigo \w por|strong="H6440"\w* \w el|strong="H3605"\w* resto \w de|strong="H6440"\w* su \w vida|strong="H3117"\w*.   
\p
\v 30 \w Cada|strong="H3605"\w* vez \w que|strong="H1961"\w* \w los|strong="H3605"\w* \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w salían|strong="H3318"\w* \w a|strong="H3068"\w* pelear, \w David|strong="H1732"\w* \w tenía|strong="H1961"\w* más éxito \w que|strong="H1961"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* oficiales \w de|strong="H8269"\w* \w Saúl|strong="H7586"\w*, por \w lo|strong="H3605"\w* \w que|strong="H1961"\w* llegó \w a|strong="H3068"\w* ser \w muy|strong="H3966"\w* famoso y respetado.   
\c 19  
\p
\v 1 \w Saúl|strong="H7586"\w* les ordenó \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Jonatán y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus servidores \w que|strong="H1121"\w* \w mataran|strong="H4191"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*. Pero como Jonatán quería \w mucho|strong="H3966"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*,  
\v 2 \w le|strong="H1242"\w* dio \w aviso|strong="H5046"\w* diciendo: “\w Mi|strong="H4994"\w* padre \w Saúl|strong="H7586"\w* te quiere matar. Por favor, ten mucho cuidado \w mañana|strong="H1242"\w* temprano; \w busca|strong="H1245"\w* un lugar secreto y escóndete allí.  
\v 3 Yo \w saldré|strong="H3318"\w* con mi padre al \w campo|strong="H7704"\w* \w donde|strong="H8033"\w* tú \w estés|strong="H5975"\w* y \w hablaré|strong="H1696"\w* con él \w acerca|strong="H1696"\w* de ti. Si me entero de algo, te \w lo|strong="H4100"\w* haré \w saber|strong="H5046"\w*”.   
\p
\v 4 Jonatán le \w habló|strong="H1696"\w* \w bien|strong="H2896"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* padre \w Saúl|strong="H7586"\w*, diciéndole: “\w No|strong="H3808"\w* cometa \w el|strong="H3588"\w* \w rey|strong="H4428"\w* un \w pecado|strong="H2398"\w* contra \w su|strong="H3588"\w* servidor \w David|strong="H1732"\w*, \w pues|strong="H3588"\w* \w él|strong="H3588"\w* \w no|strong="H3808"\w* le \w ha|strong="H3808"\w* \w hecho|strong="H4639"\w* \w nada|strong="H3808"\w* malo; \w al|strong="H4428"\w* contrario, todo \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w él|strong="H3588"\w* \w ha|strong="H3808"\w* \w hecho|strong="H4639"\w* \w ha|strong="H3808"\w* sido \w para|strong="H3588"\w* beneficio \w de|strong="H3588"\w* usted.  
\v 5 \w Él|strong="H3605"\w* arriesgó su \w vida|strong="H5315"\w* \w cuando|strong="H4100"\w* \w mató|strong="H5221"\w* al \w filisteo|strong="H6430"\w*, \w y|strong="H5355"\w* gracias \w a|strong="H3068"\w* eso Yahvé les \w dio|strong="H7760"\w* una \w gran|strong="H1419"\w* victoria \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* israelitas. Usted \w mismo|strong="H3605"\w* \w lo|strong="H4100"\w* \w vio|strong="H7200"\w* \w y|strong="H5355"\w* \w se|strong="H4100"\w* alegró. ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w*, entonces, quiere \w pecar|strong="H2398"\w* \w matando|strong="H4191"\w* \w a|strong="H3068"\w* un hombre \w inocente|strong="H5355"\w* \w como|strong="H4100"\w* \w David|strong="H1732"\w* sin \w ninguna|strong="H3605"\w* razón?”.   
\p
\v 6 \w Saúl|strong="H7586"\w* le hizo caso \w a|strong="H3068"\w* Jonatán y \w juró|strong="H7650"\w*: “\w Juro|strong="H7650"\w* por Yahvé que David no \w morirá|strong="H4191"\w*”.   
\p
\v 7 Entonces Jonatán \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* y le \w contó|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* \w había|strong="H1961"\w* pasado. Luego \w lo|strong="H1697"\w* llevó \w ante|strong="H6440"\w* \w Saúl|strong="H7586"\w*, y \w David|strong="H1732"\w* volvió \w a|strong="H3068"\w* servirle \w como|strong="H1961"\w* \w antes|strong="H6440"\w*.   
\p
\v 8 \w Cuando|strong="H1961"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* estallar la \w guerra|strong="H4421"\w*, \w David|strong="H1732"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H6440"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* y les causó una \w gran|strong="H1419"\w* matanza, obligándolos \w a|strong="H3068"\w* huir.   
\p
\v 9 Pero un \w espíritu|strong="H7307"\w* \w malo|strong="H7451"\w* enviado \w por|strong="H3027"\w* Yahvé \w se|strong="H1961"\w* apoderó \w de|strong="H7451"\w* \w Saúl|strong="H7586"\w* mientras \w estaba|strong="H1961"\w* \w sentado|strong="H3427"\w* en \w su|strong="H1931"\w* \w casa|strong="H1004"\w* con \w su|strong="H1931"\w* \w lanza|strong="H2595"\w* en \w la|strong="H1931"\w* \w mano|strong="H3027"\w*. \w David|strong="H1732"\w* \w estaba|strong="H1961"\w* tocando \w el|strong="H1931"\w* arpa,  
\v 10 y \w de|strong="H6440"\w* pronto \w Saúl|strong="H7586"\w* intentó clavar \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w en|strong="H5221"\w* \w la|strong="H1931"\w* \w pared|strong="H7023"\w* con \w su|strong="H1931"\w* \w lanza|strong="H2595"\w*. \w David|strong="H1732"\w* esquivó \w el|strong="H1931"\w* golpe y \w la|strong="H1931"\w* \w lanza|strong="H2595"\w* \w se|strong="H1931"\w* clavó \w en|strong="H5221"\w* \w la|strong="H1931"\w* \w pared|strong="H7023"\w*. \w Esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* \w David|strong="H1732"\w* \w huyó|strong="H5127"\w* y logró \w escapar|strong="H4422"\w*.  
\v 11 \w Saúl|strong="H7586"\w* \w mandó|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w la|strong="H8104"\w* \w casa|strong="H1004"\w* de \w David|strong="H1732"\w* para que lo vigilaran y lo \w mataran|strong="H4191"\w* por \w la|strong="H8104"\w* \w mañana|strong="H4279"\w*. Pero Mical, \w la|strong="H8104"\w* esposa de \w David|strong="H1732"\w*, \w le|strong="H1242"\w* advirtió: “\w Si|strong="H5315"\w* no escapas esta misma \w noche|strong="H3915"\w*, \w mañana|strong="H4279"\w* estarás \w muerto|strong="H4191"\w*”.  
\v 12 Mical ayudó \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* bajar \w por|strong="H1157"\w* una ventana, y así él pudo huir y ponerse \w a|strong="H3068"\w* salvo.  
\v 13 Luego Mical \w tomó|strong="H3947"\w* un ídolo doméstico\f + \fr 19:13 \ft Los terafines eran ídolos familiares que representaban protección o derechos de herencia.\f*, lo \w puso|strong="H7760"\w* en \w la|strong="H4324"\w* \w cama|strong="H4296"\w*, le colocó una almohada de pelo de \w cabra|strong="H5795"\w* en \w la|strong="H4324"\w* \w cabecera|strong="H4763"\w* y lo \w cubrió|strong="H3680"\w* con las sábanas.  
\v 14 Cuando \w Saúl|strong="H7586"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w mensajeros|strong="H4397"\w* para arrestar \w a|strong="H3068"\w* \w David|strong="H1732"\w*, Mical les dijo: “\w Está|strong="H1931"\w* \w enfermo|strong="H2470"\w*”.   
\p
\v 15 \w Saúl|strong="H7586"\w* \w mandó|strong="H7971"\w* de nuevo \w a|strong="H3068"\w* los \w mensajeros|strong="H4397"\w* para que vieran \w a|strong="H3068"\w* \w David|strong="H1732"\w* por sí mismos, y les ordenó: “¡Tráiganmelo con todo y \w cama|strong="H4296"\w* para que lo \w mate|strong="H4191"\w*!”.  
\v 16 Pero cuando los \w mensajeros|strong="H4397"\w* entraron, lo que encontraron en la \w cama|strong="H4296"\w* fue el ídolo con la almohada de pelo de \w cabra|strong="H5795"\w*.   
\p
\v 17 Entonces \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* reclamó \w a|strong="H3068"\w* Mical: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* me engañaste de \w esta|strong="H1931"\w* manera? ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* dejaste \w escapar|strong="H4422"\w* \w a|strong="H3068"\w* mi enemigo?”. Mical \w le|strong="H1931"\w* respondió: “\w Es|strong="H1931"\w* \w que|strong="H4100"\w* \w él|strong="H1931"\w* me amenazó y me dijo: “¡\w Déjame|strong="H7971"\w* \w ir|strong="H7971"\w*, \w o|strong="H3068"\w* te \w mato|strong="H4191"\w*!””.   
\p
\v 18 \w Mientras|strong="H3605"\w* tanto, \w David|strong="H1732"\w* \w huyó|strong="H1272"\w* y \w se|strong="H1931"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w* para ver \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, y \w le|strong="H1931"\w* \w contó|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w*. \w Después|strong="H3427"\w*, \w los|strong="H3427"\w* dos \w se|strong="H1931"\w* \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* vivir \w a|strong="H3068"\w* Naiot.  
\v 19 Cuando \w Saúl|strong="H7586"\w* se enteró de que \w David|strong="H1732"\w* \w estaba|strong="H2009"\w* en Naiot de \w Ramá|strong="H7414"\w*,   
\p
\v 20 \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w para|strong="H5921"\w* capturarlo. Pero \w cuando|strong="H1571"\w* \w los|strong="H1992"\w* \w mensajeros|strong="H4397"\w* \w vieron|strong="H7200"\w* \w a|strong="H3068"\w* un grupo \w de|strong="H5921"\w* \w profetas|strong="H5030"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* \w profetizando|strong="H5012"\w* bajo \w la|strong="H5921"\w* dirección \w de|strong="H5921"\w* \w Samuel|strong="H8050"\w*, \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H1992"\w* \w y|strong="H1571"\w* \w también|strong="H1571"\w* \w se|strong="H1961"\w* \w pusieron|strong="H5975"\w* \w a|strong="H3068"\w* profetizar.  
\v 21 \w Cuando|strong="H1571"\w* \w se|strong="H1992"\w* \w lo|strong="H1992"\w* \w contaron|strong="H5046"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* otros \w mensajeros|strong="H4397"\w*, pero \w ellos|strong="H1992"\w* \w también|strong="H1571"\w* \w se|strong="H1992"\w* pusieron \w a|strong="H3068"\w* profetizar. \w Saúl|strong="H7586"\w* \w envió|strong="H7971"\w* un tercer grupo de \w mensajeros|strong="H4397"\w*, \w y|strong="H1571"\w* \w les|strong="H1992"\w* pasó \w lo|strong="H1992"\w* \w mismo|strong="H1571"\w*.  
\v 22 \w Entonces|strong="H1571"\w* Saúl \w mismo|strong="H1931"\w* decidió \w ir|strong="H3212"\w* \w a|strong="H3068"\w* \w Ramá|strong="H7414"\w*. \w Al|strong="H5704"\w* llegar \w al|strong="H5704"\w* \w gran|strong="H1419"\w* pozo \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w en|strong="H5704"\w* Secú, \w preguntó|strong="H7592"\w*: “¿\w Dónde|strong="H1931"\w* \w están|strong="H2009"\w* \w Samuel|strong="H8050"\w* \w y|strong="H1571"\w* \w David|strong="H1732"\w*?”. Alguien \w le|strong="H1931"\w* respondió: “\w Están|strong="H2009"\w* \w en|strong="H5704"\w* Naiot \w de|strong="H5704"\w* \w Ramá|strong="H7414"\w*”.   
\p
\v 23 Saúl \w se|strong="H1961"\w* dirigió \w hacia|strong="H5921"\w* \w allá|strong="H8033"\w*, pero \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w camino|strong="H1980"\w* \w el|strong="H1931"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios \w también|strong="H1571"\w* \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* \w él|strong="H1931"\w*, \w y|strong="H1571"\w* Saúl \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w profetizando|strong="H5012"\w* \w hasta|strong="H5704"\w* \w que|strong="H1931"\w* \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* Naiot.  
\v 24 Allí \w se|strong="H1931"\w* quitó \w la|strong="H1931"\w* ropa \w y|strong="H1571"\w* siguió \w profetizando|strong="H5012"\w* \w ante|strong="H6440"\w* \w Samuel|strong="H8050"\w*; \w luego|strong="H1931"\w* \w se|strong="H1931"\w* quedó tirado \w en|strong="H5921"\w* \w el|strong="H1931"\w* suelo, \w desnudo|strong="H6174"\w*, \w todo|strong="H3605"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w y|strong="H1571"\w* \w toda|strong="H3605"\w* \w esa|strong="H1931"\w* \w noche|strong="H3915"\w*. \w De|strong="H5921"\w* ahí viene \w el|strong="H1931"\w* dicho: “¿\w A|strong="H3068"\w* poco \w también|strong="H1571"\w* \w Saúl|strong="H7586"\w* \w es|strong="H1931"\w* \w profeta|strong="H5030"\w*?”.   
\c 20  
\p
\v 1 \w David|strong="H1732"\w* \w huyó|strong="H1272"\w* \w de|strong="H3588"\w* Naiot \w en|strong="H3588"\w* \w Ramá|strong="H7414"\w* \w y|strong="H3588"\w* fue \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Jonatán \w para|strong="H3588"\w* preguntarle: “¿\w Qué|strong="H3588"\w* \w hice|strong="H6213"\w*? ¿\w Cuál|strong="H4100"\w* \w es|strong="H3588"\w* \w mi|strong="H5315"\w* \w pecado|strong="H2403"\w* \w o|strong="H3068"\w* \w mi|strong="H5315"\w* \w maldad|strong="H5771"\w* \w contra|strong="H6440"\w* \w tu|strong="H6213"\w* padre, \w para|strong="H3588"\w* \w que|strong="H3588"\w* quiera quitarme \w la|strong="H3588"\w* \w vida|strong="H5315"\w*?”.  
\v 2 Jonatán le respondió: “¡Claro \w que|strong="H4480"\w* \w no|strong="H3808"\w*! \w No|strong="H3808"\w* vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*. \w Mi|strong="H2009"\w* padre \w no|strong="H3808"\w* \w hace|strong="H6213"\w* \w nada|strong="H3808"\w*, sea importante \w o|strong="H3068"\w* \w no|strong="H3808"\w*, \w sin|strong="H3808"\w* \w antes|strong="H2088"\w* decírmelo. ¿\w Por|strong="H4480"\w* \w qué|strong="H4480"\w* \w me|strong="H4480"\w* habría \w de|strong="H4480"\w* \w ocultar|strong="H5641"\w* \w esto|strong="H2063"\w*? \w No|strong="H3808"\w* puede ser \w cierto|strong="H3808"\w*”.  
\v 3 \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* \w le|strong="H5869"\w* \w juró|strong="H7650"\w*: “Tu padre \w sabe|strong="H3045"\w* muy \w bien|strong="H3588"\w* \w que|strong="H3588"\w* tú \w me|strong="H3588"\w* quieres mucho, \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w eso|strong="H2063"\w* habrá pensado: “\w Que|strong="H3588"\w* Jonatán \w no|strong="H6435"\w* \w se|strong="H3045"\w* entere \w de|strong="H3588"\w* \w esto|strong="H2063"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H6435"\w* sufra”. \w Pero|strong="H3588"\w* \w te|strong="H5869"\w* \w juro|strong="H7650"\w* \w por|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* \w por|strong="H3588"\w* tu propia \w vida|strong="H5315"\w*, \w que|strong="H3588"\w* estoy \w a|strong="H3068"\w* un paso \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*”.  
\v 4 Jonatán le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “Dime \w qué|strong="H4100"\w* quieres \w que|strong="H4100"\w* \w haga|strong="H6213"\w*, y \w lo|strong="H4100"\w* \w haré|strong="H6213"\w* \w por|strong="H4100"\w* ti”.  
\v 5 \w David|strong="H1732"\w* \w le|strong="H5973"\w* propuso: “\w Mira|strong="H2009"\w*, \w mañana|strong="H4279"\w* es la fiesta \w de|strong="H5973"\w* luna nueva, \w y|strong="H5704"\w* \w yo|strong="H2009"\w* debería \w sentarme|strong="H3427"\w* \w a|strong="H3068"\w* la mesa \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w rey|strong="H4428"\w*. Pero \w deja|strong="H7971"\w* \w que|strong="H5704"\w* \w me|strong="H5973"\w* esconda \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w campo|strong="H7704"\w* \w hasta|strong="H5704"\w* la \w tarde|strong="H6153"\w* \w del|strong="H5973"\w* tercer día.  
\v 6 \w Si|strong="H3588"\w* tu padre \w pregunta|strong="H7592"\w* \w por|strong="H3588"\w* mí, dile: “\w David|strong="H1732"\w* \w me|strong="H4480"\w* \w pidió|strong="H7592"\w* permiso \w para|strong="H3588"\w* ir \w corriendo|strong="H7323"\w* \w a|strong="H3068"\w* Belén, \w su|strong="H3588"\w* \w ciudad|strong="H5892"\w*, \w porque|strong="H3588"\w* \w allá|strong="H8033"\w* \w toda|strong="H3605"\w* \w su|strong="H3588"\w* \w familia|strong="H4940"\w* celebra \w el|strong="H3588"\w* \w sacrificio|strong="H2077"\w* anual”.  
\v 7 \w Si|strong="H3588"\w* \w él|strong="H5973"\w* dice \w que|strong="H3588"\w* está \w bien|strong="H2896"\w*, \w entonces|strong="H3588"\w* tu servidor tendrá \w paz|strong="H7965"\w*; \w pero|strong="H3588"\w* \w si|strong="H3588"\w* \w se|strong="H3045"\w* enoja, \w sabrás|strong="H3045"\w* \w que|strong="H3588"\w* está decidido \w a|strong="H3068"\w* hacerme \w mal|strong="H7451"\w*.  
\v 8 \w Sé|strong="H5921"\w* bueno \w con|strong="H5973"\w* \w este|strong="H2088"\w* servidor tuyo, \w ya|strong="H2088"\w* \w que|strong="H3588"\w* \w tú|strong="H6213"\w* \w me|strong="H5921"\w* \w hiciste|strong="H6213"\w* \w hacer|strong="H6213"\w* un \w pacto|strong="H1285"\w* \w contigo|strong="H5973"\w* \w delante|strong="H5921"\w* \w de|strong="H5921"\w* Yahvé. \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* soy culpable, mátame \w tú|strong="H6213"\w* mismo; ¿\w para|strong="H5704"\w* \w qué|strong="H3588"\w* entregarme \w a|strong="H3068"\w* \w tu|strong="H6213"\w* padre?”.   
\p
\v 9 “¡\w Ni|strong="H3808"\w* \w lo|strong="H3808"\w* pienses!”, respondió Jonatán. “\w Si|strong="H3588"\w* \w yo|strong="H3588"\w* llegara \w a|strong="H3068"\w* \w saber|strong="H5046"\w* \w que|strong="H3588"\w* \w mi|strong="H5921"\w* padre \w ha|strong="H3808"\w* decidido hacerte daño, ¿acaso \w no|strong="H3808"\w* \w te|strong="H5921"\w* \w lo|strong="H3808"\w* avisaría?”.  
\v 10 \w David|strong="H1732"\w* preguntó: “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* \w me|strong="H4310"\w* avisará si tu padre te \w responde|strong="H6030"\w* de mala manera?”.  
\v 11 Jonatán le dijo: “\w Ven|strong="H3212"\w*, \w salgamos|strong="H3318"\w* al \w campo|strong="H7704"\w*”. \w Y|strong="H3068"\w* los \w dos|strong="H8147"\w* se \w fueron|strong="H3212"\w* al \w campo|strong="H7704"\w*.  
\v 12 Allí Jonatán le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “Pongo \w a|strong="H3068"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w por|strong="H3588"\w* testigo: \w Mañana|strong="H4279"\w* \w o|strong="H3068"\w* pasado \w mañana|strong="H4279"\w*, \w a|strong="H3068"\w* esta misma \w hora|strong="H6256"\w*, hablaré \w con|strong="H3588"\w* \w mi|strong="H2009"\w* padre. \w Si|strong="H3588"\w* veo \w que|strong="H3588"\w* todo \w va|strong="H3068"\w* \w bien|strong="H2896"\w* \w para|strong="H3588"\w* ti \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* aviso,  
\v 13 \w que|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* castigue duramente. \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w mi|strong="H5921"\w* padre \w ha|strong="H3541"\w* decidido hacerte \w mal|strong="H7451"\w*, \w te|strong="H5921"\w* \w lo|strong="H5921"\w* avisaré \w y|strong="H3588"\w* \w te|strong="H5921"\w* \w dejaré|strong="H7971"\w* \w ir|strong="H7971"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w te|strong="H5921"\w* \w vayas|strong="H1980"\w* \w en|strong="H5921"\w* \w paz|strong="H7965"\w*. ¡\w Que|strong="H3588"\w* Yahvé \w esté|strong="H1961"\w* \w contigo|strong="H5973"\w* \w como|strong="H3588"\w* \w estuvo|strong="H1961"\w* \w con|strong="H5973"\w* \w mi|strong="H5921"\w* padre!  
\v 14 \w Y|strong="H3068"\w* \w mientras|strong="H5750"\w* \w yo|strong="H6213"\w* \w viva|strong="H2416"\w*, trátame \w con|strong="H5978"\w* la misma bondad \w de|strong="H5750"\w* Yahvé para \w que|strong="H3808"\w* \w no|strong="H3808"\w* me maten.  
\v 15 \w Nunca|strong="H3808"\w* dejes \w de|strong="H5921"\w* ser bondadoso \w con|strong="H5973"\w* \w mi|strong="H5921"\w* \w familia|strong="H1004"\w*, \w ni|strong="H3808"\w* siquiera \w cuando|strong="H5704"\w* Yahvé haya borrado \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w a|strong="H3068"\w* todos tus enemigos”.  
\v 16 \w Así|strong="H5973"\w* \w hizo|strong="H3772"\w* Jonatán un pacto \w con|strong="H5973"\w* la \w familia|strong="H1004"\w* \w de|strong="H5973"\w* \w David|strong="H1732"\w*, diciendo: “\w Que|strong="H3027"\w* Yahvé \w les|strong="H5973"\w* pida cuentas \w a|strong="H3068"\w* \w los|strong="H5973"\w* enemigos \w de|strong="H5973"\w* \w David|strong="H1732"\w*”.   
\p
\v 17 Jonatán hizo \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w le|strong="H3254"\w* jurara \w de|strong="H3588"\w* nuevo \w su|strong="H3588"\w* amistad, \w porque|strong="H3588"\w* lo amaba \w con|strong="H3588"\w* toda \w su|strong="H3588"\w* \w alma|strong="H5315"\w*.  
\v 18 Luego Jonatán le dijo: “\w Mañana|strong="H4279"\w* \w es|strong="H3588"\w* \w la|strong="H3588"\w* fiesta \w de|strong="H3588"\w* luna nueva, \w y|strong="H3588"\w* se van \w a|strong="H3068"\w* dar \w cuenta|strong="H6485"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* estás, \w porque|strong="H3588"\w* tu asiento \w estará|strong="H4186"\w* \w vacío|strong="H6485"\w*.  
\v 19 Pasados tres \w días|strong="H3117"\w*, \w baja|strong="H3381"\w* rápido al \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* te \w escondiste|strong="H5641"\w* la otra vez y \w quédate|strong="H3427"\w* junto \w a|strong="H3068"\w* la piedra de Ezel.  
\v 20 Yo lanzaré \w tres|strong="H7969"\w* flechas hacia ese \w lado|strong="H6654"\w*, como si estuviera tirando al blanco.  
\v 21 Luego mandaré \w al|strong="H4480"\w* \w muchacho|strong="H5288"\w* \w a|strong="H3068"\w* buscarlas. \w Si|strong="H3588"\w* le digo: “\w Mira|strong="H2009"\w*, las flechas quedaron \w más|strong="H3588"\w* \w acá|strong="H2008"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w*, júntalas”, \w entonces|strong="H3588"\w* podrás \w venir|strong="H3212"\w*, \w porque|strong="H3588"\w* \w te|strong="H4480"\w* juro \w por|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* habrá \w paz|strong="H7965"\w* \w para|strong="H3588"\w* \w ti|strong="H4480"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* habrá peligro.  
\v 22 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* le digo \w al|strong="H4480"\w* joven: “Las flechas quedaron \w más|strong="H3588"\w* \w allá|strong="H1973"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w*”, \w entonces|strong="H3588"\w* \w vete|strong="H3212"\w*, \w porque|strong="H3588"\w* Yahvé quiere \w que|strong="H3588"\w* \w te|strong="H4480"\w* \w vayas|strong="H3212"\w*.  
\v 23 \w En|strong="H5704"\w* cuanto \w a|strong="H3068"\w* la promesa \w que|strong="H5704"\w* nos hicimos, Yahvé será testigo entre tú \w y|strong="H5704"\w* \w yo|strong="H2009"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*”.   
\p
\v 24 \w David|strong="H1732"\w* \w se|strong="H1961"\w* \w escondió|strong="H5641"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w*. \w Cuando|strong="H1961"\w* llegó \w la|strong="H5921"\w* fiesta \w de|strong="H5921"\w* luna nueva, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H1961"\w* sentó \w a|strong="H3068"\w* comer.  
\v 25 \w Se|strong="H5921"\w* sentó \w en|strong="H5921"\w* su \w lugar|strong="H4725"\w* \w de|strong="H5921"\w* \w siempre|strong="H5921"\w*, \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w pared|strong="H7023"\w*. Jonatán \w se|strong="H5921"\w* \w puso|strong="H6485"\w* \w de|strong="H5921"\w* pie \w y|strong="H5921"\w* Abner \w se|strong="H5921"\w* sentó \w al|strong="H5921"\w* \w lado|strong="H6654"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*, pero \w el|strong="H5921"\w* asiento \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* \w quedó|strong="H3427"\w* \w vacío|strong="H6485"\w*.  
\v 26 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w Saúl|strong="H7586"\w* \w no|strong="H3808"\w* \w dijo|strong="H1696"\w* \w nada|strong="H3808"\w*, \w pues|strong="H3588"\w* pensó: “\w Algo|strong="H3972"\w* \w le|strong="H1931"\w* pasó; seguramente quedó impuro \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* podido purificarse”.   
\p
\v 27 Pero al \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*, \w que|strong="H3808"\w* \w era|strong="H1961"\w* \w el|strong="H1121"\w* \w segundo|strong="H8145"\w* \w día|strong="H3117"\w* \w de|strong="H1121"\w* \w la|strong="H1571"\w* fiesta, \w el|strong="H1121"\w* asiento \w de|strong="H1121"\w* \w David|strong="H1732"\w* \w seguía|strong="H1961"\w* \w vacío|strong="H6485"\w*. \w Entonces|strong="H3117"\w* \w Saúl|strong="H7586"\w* le preguntó \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* Jonatán: “¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w el|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Isaí|strong="H3448"\w* \w no|strong="H3808"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* comer \w ni|strong="H3808"\w* \w ayer|strong="H8543"\w* \w ni|strong="H3808"\w* \w hoy|strong="H3117"\w*?”.  
\v 28 Jonatán le \w respondió|strong="H6030"\w*: “\w David|strong="H1732"\w* me \w pidió|strong="H7592"\w* permiso \w para|strong="H5704"\w* ir \w a|strong="H3068"\w* Belén.  
\v 29 \w Me|strong="H5921"\w* dijo: “\w Por|strong="H5921"\w* favor, \w déjame|strong="H7971"\w* \w ir|strong="H7971"\w*, \w porque|strong="H3588"\w* \w mi|strong="H5921"\w* \w familia|strong="H4940"\w* celebra un \w sacrificio|strong="H2077"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w mi|strong="H5921"\w* hermano \w me|strong="H5921"\w* \w ordenó|strong="H6680"\w* \w que|strong="H3588"\w* fuera. \w Si|strong="H3588"\w* \w me|strong="H5921"\w* aprecias, \w déjame|strong="H7971"\w* \w ir|strong="H7971"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* mis hermanos”. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w no|strong="H3808"\w* \w está|strong="H1931"\w* sentado \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w mesa|strong="H7979"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w*”.   
\p
\v 30 \w Saúl|strong="H7586"\w* \w se|strong="H3045"\w* enfureció contra Jonatán \w y|strong="H3588"\w* le gritó: “¡\w Hijo|strong="H1121"\w* \w de|strong="H3588"\w* una mujer perversa \w y|strong="H3588"\w* rebelde! ¿Crees \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* tú \w te|strong="H3588"\w* has \w puesto|strong="H3588"\w* \w de|strong="H3588"\w* parte del \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w Isaí|strong="H3448"\w*, \w para|strong="H3588"\w* \w vergüenza|strong="H6172"\w* \w tuya|strong="H6172"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* tu madre?  
\v 31 \w Mientras|strong="H3588"\w* \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w* viva \w en|strong="H5921"\w* \w este|strong="H1931"\w* mundo, \w ni|strong="H3808"\w* tú \w ni|strong="H3808"\w* tu \w reino|strong="H4438"\w* estarán seguros. ¡Manda \w a|strong="H3068"\w* buscarlo \w ahora|strong="H6258"\w* \w mismo|strong="H1931"\w* \w y|strong="H3588"\w* tráemelo, \w porque|strong="H3588"\w* \w tiene|strong="H1931"\w* \w que|strong="H3588"\w* morir!”.  
\v 32 Jonatán le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* su padre: “¿\w Y|strong="H3068"\w* \w por|strong="H4100"\w* \w qué|strong="H4100"\w* tiene \w que|strong="H4100"\w* \w morir|strong="H4191"\w*? ¿\w Qué|strong="H4100"\w* es \w lo|strong="H4100"\w* \w que|strong="H4100"\w* ha \w hecho|strong="H6213"\w*?”.  
\v 33 \w Entonces|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w le|strong="H1931"\w* lanzó \w su|strong="H1931"\w* \w lanza|strong="H2595"\w* \w para|strong="H5921"\w* herirlo, \w y|strong="H3588"\w* \w con|strong="H5973"\w* \w eso|strong="H1931"\w* Jonatán comprendió \w que|strong="H3588"\w* \w su|strong="H1931"\w* padre estaba decidido \w a|strong="H3068"\w* matar \w a|strong="H3068"\w* \w David|strong="H1732"\w*.  
\v 34 Jonatán \w se|strong="H3808"\w* \w levantó|strong="H6965"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w mesa|strong="H7979"\w* \w muy|strong="H2750"\w* enojado \w y|strong="H3588"\w* \w no|strong="H3808"\w* comió \w nada|strong="H3808"\w* ese \w segundo|strong="H8145"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* fiesta; estaba \w muy|strong="H2750"\w* triste \w por|strong="H3588"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w porque|strong="H3588"\w* \w su|strong="H3588"\w* padre \w lo|strong="H3808"\w* \w había|strong="H3588"\w* insultado.   
\p
\v 35 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, Jonatán \w salió|strong="H3318"\w* al \w campo|strong="H7704"\w* \w a|strong="H3068"\w* la hora acordada \w con|strong="H5973"\w* \w David|strong="H1732"\w*, acompañado \w de|strong="H5973"\w* un \w muchacho|strong="H5288"\w*.  
\v 36 \w Le|strong="H1931"\w* dijo al joven: “\w Corre|strong="H7323"\w* y \w busca|strong="H4672"\w* las flechas \w que|strong="H1931"\w* voy \w a|strong="H3068"\w* tirar”. Mientras \w el|strong="H1931"\w* joven corría, Jonatán tiró \w una|strong="H4672"\w* flecha \w que|strong="H1931"\w* \w pasó|strong="H5674"\w* más allá de \w él|strong="H1931"\w*.  
\v 37 \w Cuando|strong="H5704"\w* el \w muchacho|strong="H5288"\w* \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* \w donde|strong="H4725"\w* había caído la flecha, Jonatán le \w gritó|strong="H7121"\w*: “¿\w No|strong="H3808"\w* está la flecha \w más|strong="H4480"\w* \w allá|strong="H1973"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w*?”.  
\v 38 \w Y|strong="H3068"\w* volvió \w a|strong="H3068"\w* gritarle: “¡Rápido, apúrate, no te detengas!”. El \w muchacho|strong="H5288"\w* \w recogió|strong="H3950"\w* las flechas y regresó \w a|strong="H3068"\w* donde su amo.  
\v 39 El joven \w no|strong="H3808"\w* sospechaba \w nada|strong="H3808"\w*; solo Jonatán y \w David|strong="H1732"\w* \w sabían|strong="H3045"\w* \w de|strong="H1697"\w* \w qué|strong="H3808"\w* \w se|strong="H3045"\w* trataba.  
\v 40 Luego Jonatán le \w dio|strong="H5414"\w* sus \w armas|strong="H3627"\w* al \w muchacho|strong="H5288"\w* y le dijo: “\w Anda|strong="H3212"\w*, llévalas \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w*”.   
\p
\v 41 \w En|strong="H5704"\w* cuanto \w el|strong="H5307"\w* joven se fue, \w David|strong="H1732"\w* salió \w de|strong="H5704"\w* su escondite \w por|strong="H5704"\w* \w el|strong="H5307"\w* lado sur \w y|strong="H5704"\w* se inclinó \w tres|strong="H7969"\w* \w veces|strong="H6471"\w* \w hasta|strong="H5704"\w* tocar \w el|strong="H5307"\w* suelo \w con|strong="H5704"\w* la frente. \w Luego|strong="H5704"\w* se besaron \w y|strong="H5704"\w* \w lloraron|strong="H1058"\w* juntos, \w aunque|strong="H5704"\w* \w David|strong="H1732"\w* \w lloraba|strong="H1058"\w* \w más|strong="H5704"\w*.  
\v 42 Jonatán le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “Vete \w en|strong="H5704"\w* \w paz|strong="H7965"\w*, \w porque|strong="H1732"\w* \w los|strong="H1961"\w* \w dos|strong="H8147"\w* hemos \w jurado|strong="H7650"\w* \w en|strong="H5704"\w* el \w nombre|strong="H8034"\w* \w de|strong="H5704"\w* Yahvé \w que|strong="H5704"\w* él \w será|strong="H1961"\w* testigo entre tú \w y|strong="H5704"\w* yo, \w y|strong="H5704"\w* entre tus descendientes \w y|strong="H5704"\w* \w los|strong="H1961"\w* míos \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*”. \w David|strong="H1732"\w* \w se|strong="H1961"\w* marchó \w y|strong="H5704"\w* Jonatán regresó \w a|strong="H3068"\w* la ciudad.   
\c 21  
\p
\v 1 David \w fue|strong="H3212"\w* \w a|strong="H3068"\w* la \w ciudad|strong="H5892"\w* de Nob para ver al sacerdote Ajimelec. Este \w salió|strong="H3212"\w* \w a|strong="H3068"\w* recibirlo temblando de miedo y le preguntó: “¿Por qué \w vienes|strong="H3212"\w* solo? ¿Por qué no te acompaña nadie?”.  
\v 2 \w David|strong="H1732"\w* le respondió al \w sacerdote|strong="H3548"\w* Ajimelec: “El rey me encargó un asunto secreto y me dijo: “Que nadie sepa \w a|strong="H3068"\w* qué te envío ni qué órdenes te he dado”. En cuanto \w a|strong="H3068"\w* mis hombres, los cité en un lugar determinado.  
\v 3 Ahora, dígame \w qué|strong="H3045"\w* tiene \w de|strong="H1697"\w* comer. Deme unos cinco panes \w o|strong="H3068"\w* \w lo|strong="H1697"\w* \w que|strong="H3045"\w* tenga \w a|strong="H3068"\w* la mano”.   
\p
\v 4 El sacerdote le contestó: “\w No|strong="H4100"\w* \w tengo|strong="H3426"\w* \w pan|strong="H3899"\w* común, solo \w tengo|strong="H3426"\w* \w pan|strong="H3899"\w* sagrado. Te \w lo|strong="H4100"\w* puedo \w dar|strong="H5414"\w*, \w siempre|strong="H3899"\w* y \w cuando|strong="H4100"\w* tus hombres \w no|strong="H4100"\w* hayan tenido relaciones sexuales con mujeres recientemente”.   
\p
\v 5 \w David|strong="H1732"\w* le aseguró: “Le garantizo \w que|strong="H3588"\w* \w no|strong="H3588"\w* hemos estado \w con|strong="H3588"\w* mujeres \w en|strong="H3588"\w* estos últimos tres días. Mis hombres se mantienen puros cada vez \w que|strong="H3588"\w* salen \w a|strong="H3068"\w* una misión, \w aun|strong="H3588"\w* \w cuando|strong="H3588"\w* sea una misión ordinaria. ¡\w Con|strong="H3588"\w* \w más|strong="H3588"\w* razón estarán puros hoy!”.  
\v 6 \w Como|strong="H3588"\w* \w no|strong="H3588"\w* \w había|strong="H1961"\w* otro pan, \w el|strong="H1931"\w* \w sacerdote|strong="H3548"\w* \w le|strong="H1931"\w* dio \w el|strong="H1931"\w* pan \w sagrado|strong="H6944"\w*, \w es|strong="H1931"\w* decir, \w el|strong="H1931"\w* pan \w de|strong="H3588"\w* \w la|strong="H1931"\w* presencia \w que|strong="H3588"\w* \w se|strong="H1961"\w* consagra ante Yahvé. \w Ese|strong="H1931"\w* pan acababa \w de|strong="H3588"\w* ser retirado \w de|strong="H3588"\w* \w la|strong="H1931"\w* mesa \w para|strong="H3588"\w* ser reemplazado \w por|strong="H3588"\w* pan caliente.   
\p
\v 7 Ese mismo \w día|strong="H3117"\w* \w se|strong="H1961"\w* encontraba \w allí|strong="H8033"\w* un servidor \w de|strong="H3588"\w* Saúl llamado Doeg \w el|strong="H3588"\w* edomita, \w que|strong="H3588"\w* \w era|strong="H1961"\w* \w el|strong="H3588"\w* jefe \w de|strong="H3588"\w* \w los|strong="H1961"\w* pastores \w de|strong="H3588"\w* Saúl; \w estaba|strong="H1961"\w* cumpliendo un rito \w ante|strong="H6440"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w*.   
\p
\v 8 David \w le|strong="H1931"\w* preguntó \w a|strong="H3068"\w* Ajimelec: “¿\w No|strong="H6440"\w* tendrá \w por|strong="H6440"\w* \w aquí|strong="H8033"\w* una lanza \w o|strong="H3068"\w* una espada? \w Es|strong="H1931"\w* \w que|strong="H1931"\w* salí con tanta urgencia \w por|strong="H6440"\w* \w el|strong="H1931"\w* encargo del rey \w que|strong="H1931"\w* \w no|strong="H6440"\w* tuve \w tiempo|strong="H3117"\w* \w de|strong="H6440"\w* tomar mi espada ni mis otras armas”.   
\p
\v 9 \w El|strong="H3588"\w* sacerdote respondió: “\w Aquí|strong="H6311"\w* \w tengo|strong="H3426"\w* \w la|strong="H1571"\w* \w espada|strong="H2719"\w* del filisteo Goliat, \w al|strong="H4428"\w* \w que|strong="H3588"\w* \w tú|strong="H3426"\w* mataste \w en|strong="H3588"\w* \w el|strong="H3588"\w* valle \w de|strong="H3588"\w* Ela. \w Está|strong="H1961"\w* envuelta \w en|strong="H3588"\w* un paño, detrás del efod. \w Si|strong="H3588"\w* \w la|strong="H1571"\w* quieres, \w tómala|strong="H3947"\w*, \w porque|strong="H3588"\w* \w es|strong="H1961"\w* \w la|strong="H1571"\w* única arma \w que|strong="H3588"\w* \w hay|strong="H3426"\w* \w aquí|strong="H6311"\w*”. \w David|strong="H1732"\w* contestó: “\w No|strong="H3808"\w* \w hay|strong="H3426"\w* otra \w espada|strong="H2719"\w* \w como|strong="H3588"\w* esa; démela”.   
\p
\v 10 \w Ese|strong="H1931"\w* día \w David|strong="H1732"\w* siguió huyendo \w de|strong="H3588"\w* Saúl \w y|strong="H3588"\w* \w se|strong="H1931"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* Gat, \w donde|strong="H1931"\w* reinaba Aquis.  
\v 11 Pero \w los|strong="H1931"\w* servidores \w de|strong="H6440"\w* Aquis \w le|strong="H1931"\w* dijeron \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “¿\w No|strong="H6440"\w* \w es|strong="H1931"\w* \w este|strong="H1931"\w* \w David|strong="H1732"\w*, \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w su|strong="H1931"\w* tierra? ¿Acaso \w no|strong="H6440"\w* \w es|strong="H1931"\w* \w él|strong="H1931"\w* \w de|strong="H6440"\w* \w quien|strong="H1931"\w* cantaban en las danzas:  
\q1 “\w Saúl|strong="H7586"\w* mató \w a|strong="H3068"\w* miles,  
\q2 ¡pero \w David|strong="H1732"\w* \w a|strong="H3068"\w* diez miles!”?”.   
\p
\v 12 \w Al|strong="H4428"\w* oír \w esto|strong="H2088"\w*, \w David|strong="H1732"\w* \w se|strong="H3808"\w* preocupó mucho y tuvo miedo de \w lo|strong="H2088"\w* \w que|strong="H3808"\w* Aquis, el \w rey|strong="H4428"\w* de Gat, pudiera hacerle.  
\v 13 Así \w que|strong="H1697"\w*, \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos, empezó \w a|strong="H3068"\w* actuar como un loco; \w hacía|strong="H6440"\w* garabatos en las puertas y dejaba \w que|strong="H1697"\w* la saliva le corriera \w por|strong="H1697"\w* la barba.  
\v 14 Entonces Aquis \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* sus servidores: “¡Miren \w a|strong="H3068"\w* ese hombre! ¡\w Está|strong="H5921"\w* loco! ¿\w Para|strong="H5921"\w* \w qué|strong="H5921"\w* \w me|strong="H5921"\w* \w lo|strong="H5921"\w* trajeron?  
\v 15 ¿Acaso me faltan locos en este palacio para \w que|strong="H4100"\w* me traigan \w a|strong="H3068"\w* este \w a|strong="H3068"\w* hacer sus locuras frente \w a|strong="H3068"\w* \w mí|strong="H2009"\w*? ¡\w No|strong="H4100"\w* quiero \w a|strong="H3068"\w* este tipo en \w mi|strong="H2009"\w* casa!”.   
\c 22  
\p
\v 1 \w David|strong="H1732"\w* se \w fue|strong="H3212"\w* de Gat y huyó \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w cueva|strong="H4631"\w* de Adulam. Cuando sus hermanos y \w el|strong="H3605"\w* resto de su \w familia|strong="H1004"\w* se enteraron, \w fueron|strong="H3212"\w* \w allá|strong="H8033"\w* para reunirse con \w él|strong="H3605"\w*.  
\v 2 También \w se|strong="H1961"\w* \w le|strong="H5921"\w* unieron \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* \w en|strong="H5921"\w* aprietos, \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w tenían|strong="H1961"\w* deudas \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w estaban|strong="H1961"\w* descontentos; \w así|strong="H5973"\w* David llegó \w a|strong="H3068"\w* \w ser|strong="H5315"\w* \w el|strong="H5921"\w* \w jefe|strong="H8269"\w* \w de|strong="H5921"\w* unos cuatrocientos hombres.  
\v 3 \w De|strong="H5704"\w* \w allí|strong="H8033"\w* \w David|strong="H1732"\w* \w se|strong="H3045"\w* dirigió \w a|strong="H3068"\w* Mizpa \w de|strong="H5704"\w* \w Moab|strong="H4124"\w*, \w y|strong="H5704"\w* le pidió \w al|strong="H5704"\w* \w rey|strong="H4428"\w* \w de|strong="H5704"\w* ese lugar: “\w Por|strong="H4100"\w* favor, deja \w que|strong="H4100"\w* \w mi|strong="H4994"\w* padre \w y|strong="H5704"\w* \w mi|strong="H4994"\w* madre \w se|strong="H3045"\w* queden \w con|strong="H5704"\w* ustedes \w hasta|strong="H5704"\w* \w que|strong="H4100"\w* \w yo|strong="H4994"\w* \w sepa|strong="H3045"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* Dios quiere \w hacer|strong="H6213"\w* \w conmigo|strong="H6213"\w*”.  
\v 4 \w Así|strong="H5973"\w* \w que|strong="H3117"\w* dejó \w a|strong="H3068"\w* sus padres bajo \w el|strong="H5973"\w* cuidado \w del|strong="H5973"\w* \w rey|strong="H4428"\w* \w de|strong="H6440"\w* \w Moab|strong="H4124"\w*, y \w ellos|strong="H3605"\w* vivieron allí \w todo|strong="H3605"\w* \w el|strong="H5973"\w* \w tiempo|strong="H3117"\w* \w que|strong="H3117"\w* \w David|strong="H1732"\w* \w estuvo|strong="H1961"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* refugio.  
\v 5 Pero \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Gad|strong="H1410"\w* le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w No|strong="H3808"\w* te quedes \w más|strong="H3808"\w* \w en|strong="H3212"\w* este refugio. \w Vete|strong="H3212"\w* de aquí y regresa \w a|strong="H3068"\w* la tierra de \w Judá|strong="H3063"\w*”.  
\p Entonces \w David|strong="H1732"\w* \w se|strong="H3808"\w* \w fue|strong="H3212"\w* y \w se|strong="H3808"\w* escondió \w en|strong="H3212"\w* \w el|strong="H5030"\w* \w bosque|strong="H3293"\w* de Heret.   
\p
\v 6 Pronto \w Saúl|strong="H7586"\w* \w se|strong="H3045"\w* enteró \w de|strong="H5921"\w* \w que|strong="H3588"\w* habían localizado \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* sus hombres. \w Saúl|strong="H7586"\w* \w estaba|strong="H3427"\w* \w en|strong="H5921"\w* \w Gabaa|strong="H1390"\w*, \w sentado|strong="H3427"\w* \w bajo|strong="H8478"\w* un árbol \w de|strong="H5921"\w* tamarisco \w que|strong="H3588"\w* \w está|strong="H5324"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* colina; tenía \w su|strong="H3588"\w* \w lanza|strong="H2595"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w y|strong="H3588"\w* \w todos|strong="H3605"\w* sus \w oficiales|strong="H5324"\w* \w lo|strong="H5921"\w* rodeaban.  
\v 7 \w Saúl|strong="H7586"\w* \w les|strong="H5921"\w* dijo \w a|strong="H3068"\w* sus \w oficiales|strong="H5324"\w*: “¡\w Escuchen|strong="H8085"\w* bien, \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* Benjamín! ¿Acaso creen \w que|strong="H4994"\w* \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w* \w les|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* ustedes \w campos|strong="H7704"\w* \w y|strong="H1571"\w* viñedos? ¿Creen \w que|strong="H4994"\w* \w los|strong="H1121"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* nombrar \w jefes|strong="H8269"\w* \w de|strong="H5921"\w* \w mil|strong="H3967"\w* \w o|strong="H3068"\w* \w de|strong="H5921"\w* \w cien|strong="H3967"\w* soldados?  
\v 8 ¿\w Es|strong="H2088"\w* \w por|strong="H5921"\w* eso \w que|strong="H3588"\w* \w todos|strong="H3605"\w* ustedes han conspirado \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*? \w Nadie|strong="H3605"\w* \w me|strong="H4480"\w* avisó \w cuando|strong="H3588"\w* \w mi|strong="H5921"\w* propio \w hijo|strong="H1121"\w* \w hizo|strong="H3772"\w* un pacto \w con|strong="H5973"\w* \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Isaí|strong="H3448"\w*. \w A|strong="H3068"\w* \w ninguno|strong="H3605"\w* \w de|strong="H4480"\w* ustedes \w le|strong="H5921"\w* dolió \w mi|strong="H5921"\w* situación \w ni|strong="H5973"\w* \w me|strong="H4480"\w* avisó \w que|strong="H3588"\w* \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* instigó \w a|strong="H3068"\w* uno \w de|strong="H4480"\w* mis servidores \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* pusiera \w al|strong="H5921"\w* acecho \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*, \w como|strong="H3588"\w* \w lo|strong="H2088"\w* \w está|strong="H2088"\w* haciendo \w hoy|strong="H3117"\w*”.   
\p
\v 9 Entonces \w Doeg|strong="H1673"\w* \w el|strong="H1931"\w* edomita, \w que|strong="H1931"\w* \w estaba|strong="H5324"\w* allí \w con|strong="H5921"\w* \w los|strong="H1121"\w* \w oficiales|strong="H5324"\w* \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*, dijo: “Yo \w vi|strong="H7200"\w* \w cuando|strong="H5650"\w* \w el|strong="H1931"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* \w Nob|strong="H5011"\w* \w para|strong="H5921"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* Ajimelec \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ajitub.  
\v 10 Vi que Ajimelec \w consultó|strong="H7592"\w* \w a|strong="H3068"\w* Yahvé \w por|strong="H5414"\w* él, le \w dio|strong="H5414"\w* \w comida|strong="H6720"\w* y también le \w entregó|strong="H5414"\w* la \w espada|strong="H2719"\w* \w de|strong="H5414"\w* Goliat el \w filisteo|strong="H6430"\w*”.   
\p
\v 11 \w De|strong="H1121"\w* inmediato \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w mandó|strong="H7971"\w* \w llamar|strong="H7121"\w* \w al|strong="H4428"\w* \w sacerdote|strong="H3548"\w* Ajimelec \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajitub y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus parientes, \w que|strong="H1121"\w* eran \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* en \w Nob|strong="H5011"\w*. \w Todos|strong="H3605"\w* \w ellos|strong="H3605"\w* se presentaron ante \w el|strong="H3605"\w* \w rey|strong="H4428"\w*.  
\v 12 \w Saúl|strong="H7586"\w* le dijo: “¡\w Escúchame|strong="H8085"\w* bien, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajitub!”.  
\p \w Él|strong="H1121"\w* respondió: “Dígame, señor mío”.   
\p
\v 13 \w Saúl|strong="H7586"\w* \w le|strong="H5921"\w* \w preguntó|strong="H7592"\w*: “¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* conspiraste \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w*? \w Le|strong="H5921"\w* \w diste|strong="H5414"\w* \w pan|strong="H3899"\w* \w y|strong="H5921"\w* una \w espada|strong="H2719"\w*, \w y|strong="H5921"\w* consultaste \w a|strong="H3068"\w* Dios \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H4100"\w* \w se|strong="H5921"\w* rebelara \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w pusiera|strong="H5414"\w* \w al|strong="H5921"\w* acecho, \w como|strong="H4100"\w* \w lo|strong="H4100"\w* \w está|strong="H2088"\w* haciendo \w hoy|strong="H3117"\w*”.   
\p
\v 14 Ajimelec \w le|strong="H4310"\w* \w respondió|strong="H6030"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w*: “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* entre \w todos|strong="H3605"\w* sus servidores es tan fiel como \w David|strong="H1732"\w*? \w Él|strong="H3605"\w* es su \w yerno|strong="H2860"\w*, \w el|strong="H3605"\w* jefe de su guardia personal y un hombre muy respetado \w en|strong="H5493"\w* su \w casa|strong="H1004"\w*.  
\v 15 ¿Acaso \w es|strong="H3588"\w* \w esta|strong="H2063"\w* \w la|strong="H3588"\w* primera vez \w que|strong="H3588"\w* \w consulto|strong="H7592"\w* \w a|strong="H3068"\w* Dios \w por|strong="H3588"\w* \w él|strong="H3588"\w*? ¡Claro \w que|strong="H3588"\w* \w no|strong="H3808"\w*! \w Que|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* culpe \w de|strong="H3588"\w* \w nada|strong="H3808"\w*, \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w mí|strong="H2490"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w mi|strong="H2490"\w* \w familia|strong="H1004"\w*, \w porque|strong="H3588"\w* \w de|strong="H3588"\w* \w este|strong="H2063"\w* \w asunto|strong="H1697"\w* \w su|strong="H3588"\w* servidor \w no|strong="H3808"\w* \w sabía|strong="H3045"\w* absolutamente \w nada|strong="H3808"\w*”.   
\p
\v 16 Pero \w el|strong="H3605"\w* \w rey|strong="H4428"\w* sentenció: “¡Vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*, Ajimelec, junto con \w toda|strong="H3605"\w* tu \w familia|strong="H1004"\w*!”.  
\v 17 \w Luego|strong="H1931"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w les|strong="H5973"\w* ordenó \w a|strong="H3068"\w* \w los|strong="H5921"\w* guardias \w que|strong="H3588"\w* \w lo|strong="H1931"\w* rodeaban: “¡Mátenlos! Maten \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* Yahvé, \w porque|strong="H3588"\w* \w ellos|strong="H3027"\w* \w también|strong="H1571"\w* están \w de|strong="H5921"\w* parte \w de|strong="H5921"\w* \w David|strong="H1732"\w*. \w Sabían|strong="H3045"\w* \w que|strong="H3588"\w* \w él|strong="H1931"\w* \w estaba|strong="H5324"\w* \w huyendo|strong="H1272"\w* \w y|strong="H1571"\w* \w no|strong="H3808"\w* \w me|strong="H5921"\w* avisaron”. \w Pero|strong="H3588"\w* \w los|strong="H5921"\w* \w oficiales|strong="H5324"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w no|strong="H3808"\w* quisieron levantar \w la|strong="H1931"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H5921"\w* Yahvé.   
\p
\v 18 \w Entonces|strong="H3117"\w* \w el|strong="H1931"\w* \w rey|strong="H4428"\w* \w le|strong="H1931"\w* ordenó \w a|strong="H3068"\w* \w Doeg|strong="H1673"\w*: “¡Hazlo tú! ¡\w Mata|strong="H4191"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w sacerdotes|strong="H3548"\w*!”.  
\p \w Doeg|strong="H1673"\w* \w el|strong="H1931"\w* edomita \w fue|strong="H1931"\w* y atacó \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w sacerdotes|strong="H3548"\w*; \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w mató|strong="H4191"\w* \w a|strong="H3068"\w* \w ochenta|strong="H8084"\w* y \w cinco|strong="H2568"\w* hombres \w que|strong="H1931"\w* vestían \w el|strong="H1931"\w* efod \w de|strong="H2568"\w* lino.  
\v 19 También pasó \w a|strong="H3068"\w* \w cuchillo|strong="H2719"\w* \w a|strong="H3068"\w* todos los habitantes \w de|strong="H5704"\w* \w Nob|strong="H5011"\w*, la \w ciudad|strong="H5892"\w* \w de|strong="H5704"\w* los \w sacerdotes|strong="H3548"\w*. \w Mató|strong="H5221"\w* \w a|strong="H3068"\w* hombres \w y|strong="H5704"\w* \w mujeres|strong="H5704"\w*, \w a|strong="H3068"\w* \w niños|strong="H5768"\w* \w y|strong="H5704"\w* recién nacidos, \w y|strong="H5704"\w* \w hasta|strong="H5704"\w* \w a|strong="H3068"\w* los \w bueyes|strong="H7794"\w*, burros \w y|strong="H5704"\w* ovejas.  
\v 20 Solo Abiatar, uno \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Ajimelec \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajitub, logró \w escapar|strong="H4422"\w* y \w huyó|strong="H1272"\w* para unirse \w a|strong="H3068"\w* \w David|strong="H1732"\w*.  
\v 21 Abiatar le \w contó|strong="H5046"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w había|strong="H3588"\w* masacrado \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w sacerdotes|strong="H3548"\w* \w de|strong="H3588"\w* Yahvé.   
\p
\v 22 \w David|strong="H1732"\w* \w le|strong="H1931"\w* respondió: “\w Ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w cuando|strong="H3588"\w* vi \w allí|strong="H8033"\w* \w a|strong="H3068"\w* \w Doeg|strong="H1673"\w* \w el|strong="H1931"\w* edomita, \w supe|strong="H3045"\w* \w que|strong="H3588"\w* sin falta \w le|strong="H1931"\w* avisaría \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*. \w Yo|strong="H3588"\w* \w soy|strong="H1931"\w* \w el|strong="H1931"\w* responsable \w de|strong="H3588"\w* \w la|strong="H1931"\w* muerte \w de|strong="H3588"\w* \w toda|strong="H3605"\w* tu \w familia|strong="H1004"\w*.  
\v 23 \w Quédate|strong="H3427"\w* \w conmigo|strong="H5978"\w* \w y|strong="H3588"\w* \w no|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*. \w El|strong="H3588"\w* \w que|strong="H3588"\w* \w busca|strong="H1245"\w* matarme \w a|strong="H3068"\w* \w mí|strong="H5315"\w*, también \w busca|strong="H1245"\w* \w matarte|strong="H5315"\w* \w a|strong="H3068"\w* ti; \w pero|strong="H3588"\w* \w conmigo|strong="H5978"\w* estarás \w a|strong="H3068"\w* salvo”.   
\c 23  
\p
\v 1 Le avisaron \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Mira|strong="H2009"\w*, \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w* \w están|strong="H2009"\w* atacando \w a|strong="H3068"\w* \w Keila|strong="H7084"\w* y \w se|strong="H1992"\w* \w están|strong="H2009"\w* robando \w el|strong="H1992"\w* trigo \w de|strong="H3898"\w* \w los|strong="H1992"\w* lugares donde \w se|strong="H1992"\w* trilla”.   
\p
\v 2 Entonces \w David|strong="H1732"\w* le \w consultó|strong="H7592"\w* \w a|strong="H3068"\w* Yahvé: “¿Debo \w ir|strong="H3212"\w* \w a|strong="H3068"\w* atacar \w a|strong="H3068"\w* estos \w filisteos|strong="H6430"\w*?”. Yahvé le respondió: “\w Ve|strong="H3212"\w*, atácalos y \w salva|strong="H3467"\w* \w a|strong="H3068"\w* \w Keila|strong="H7084"\w*”.   
\p
\v 3 \w Pero|strong="H3588"\w* \w los|strong="H3588"\w* hombres \w de|strong="H3588"\w* \w David|strong="H1732"\w* le dijeron: “\w Si|strong="H3588"\w* \w aquí|strong="H6311"\w* \w en|strong="H3588"\w* \w Judá|strong="H3063"\w* tenemos \w miedo|strong="H3372"\w*, ¡imagínate \w si|strong="H3588"\w* \w vamos|strong="H3212"\w* \w a|strong="H3068"\w* \w Keila|strong="H7084"\w* \w para|strong="H3588"\w* enfrentarnos \w a|strong="H3068"\w* \w los|strong="H3588"\w* ejércitos \w filisteos|strong="H6430"\w*!”.   
\p
\v 4 \w David|strong="H1732"\w* \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé, \w y|strong="H3588"\w* \w él|strong="H3588"\w* \w le|strong="H3254"\w* \w respondió|strong="H6030"\w*: “\w Levántate|strong="H6965"\w* \w y|strong="H3588"\w* \w baja|strong="H3381"\w* \w a|strong="H3068"\w* \w Keila|strong="H7084"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* voy \w a|strong="H3068"\w* entregar \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w* \w en|strong="H3588"\w* tus \w manos|strong="H3027"\w*”.   
\p
\v 5 \w David|strong="H1732"\w* \w fue|strong="H3212"\w* con sus hombres \w a|strong="H3068"\w* \w Keila|strong="H7084"\w* y \w peleó|strong="H3898"\w* contra \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w*. Se \w llevó|strong="H5090"\w* \w el|strong="H3427"\w* \w ganado|strong="H4735"\w* \w de|strong="H3898"\w* ellos y les causó una \w gran|strong="H1419"\w* matanza. Así \w fue|strong="H3212"\w* como \w David|strong="H1732"\w* \w salvó|strong="H3467"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3898"\w* \w Keila|strong="H7084"\w*.   
\p
\v 6 \w Cuando|strong="H1961"\w* Abiatar \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajimelec \w huyó|strong="H1272"\w* \w para|strong="H1961"\w* unirse \w a|strong="H3068"\w* \w David|strong="H1732"\w* en \w Keila|strong="H7084"\w*, \w llevaba|strong="H1961"\w* consigo \w el|strong="H1121"\w* efod.   
\p
\v 7 \w Cuando|strong="H3588"\w* \w Saúl|strong="H7586"\w* se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* estaba \w en|strong="H3588"\w* \w Keila|strong="H7084"\w*, \w dijo|strong="H5046"\w*: “Dios lo ha \w puesto|strong="H3588"\w* \w en|strong="H3588"\w* mis \w manos|strong="H3027"\w*. \w Él|strong="H3588"\w* mismo se encerró al meterse \w en|strong="H3588"\w* una \w ciudad|strong="H5892"\w* \w con|strong="H3588"\w* \w puertas|strong="H1817"\w* \w y|strong="H3588"\w* \w barras|strong="H1280"\w*”.  
\v 8 \w Saúl|strong="H7586"\w* llamó \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* ejército \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w guerra|strong="H4421"\w* \w para|strong="H5971"\w* bajar \w a|strong="H3068"\w* \w Keila|strong="H7084"\w* y sitiar \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w a|strong="H3068"\w* sus hombres.  
\v 9 \w David|strong="H1732"\w*, \w al|strong="H5921"\w* \w saber|strong="H3045"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* planeaba hacerle daño, \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* Abiatar: “\w Trae|strong="H5066"\w* acá \w el|strong="H5921"\w* efod”.  
\v 10 Luego \w David|strong="H1732"\w* oró: “Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, este servidor tuyo sabe \w con|strong="H3588"\w* certeza \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* planea venir \w a|strong="H3068"\w* \w Keila|strong="H7084"\w* \w para|strong="H3588"\w* \w destruir|strong="H1245"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w por|strong="H3588"\w* \w mi|strong="H1245"\w* culpa.  
\v 11 ¿Me \w entregarán|strong="H5462"\w* \w los|strong="H1167"\w* jefes de \w Keila|strong="H7084"\w* en sus \w manos|strong="H3027"\w*? ¿Vendrá \w Saúl|strong="H7586"\w*, tal como he \w oído|strong="H8085"\w*? Yahvé, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, te \w ruego|strong="H4994"\w* \w que|strong="H4994"\w* se lo digas \w a|strong="H3068"\w* este servidor tuyo”. Yahvé respondió: “\w Sí|strong="H4994"\w*, \w Saúl|strong="H7586"\w* vendrá”.   
\p
\v 12 \w David|strong="H1732"\w* volvió \w a|strong="H3068"\w* preguntar: “¿Nos \w entregarán|strong="H5462"\w* \w los|strong="H1167"\w* jefes de \w Keila|strong="H7084"\w*, \w a|strong="H3068"\w* mí y \w a|strong="H3068"\w* mis hombres, en \w manos|strong="H3027"\w* de \w Saúl|strong="H7586"\w*?”. \w Y|strong="H3068"\w* Yahvé respondió: “Sí, \w los|strong="H1167"\w* \w entregarán|strong="H5462"\w*”.   
\p
\v 13 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* sus hombres, \w que|strong="H3588"\w* eran unos \w seiscientos|strong="H8337"\w*, \w salieron|strong="H3318"\w* \w de|strong="H3588"\w* \w Keila|strong="H7084"\w* \w y|strong="H3588"\w* \w anduvieron|strong="H1980"\w* \w de|strong="H3588"\w* un lado \w a|strong="H3068"\w* otro. \w Cuando|strong="H3588"\w* le avisaron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* se \w había|strong="H3588"\w* escapado \w de|strong="H3588"\w* \w Keila|strong="H7084"\w*, decidió \w no|strong="H3588"\w* \w ir|strong="H1980"\w* allá.  
\v 14 \w David|strong="H1732"\w* \w se|strong="H3808"\w* \w quedó|strong="H3427"\w* en \w los|strong="H3427"\w* refugios del \w desierto|strong="H4057"\w* y en \w los|strong="H3427"\w* cerros del \w desierto|strong="H4057"\w* \w de|strong="H5414"\w* Zif. \w Saúl|strong="H7586"\w* \w lo|strong="H3808"\w* \w buscaba|strong="H1245"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w días|strong="H3117"\w*, pero Dios \w no|strong="H3808"\w* \w permitió|strong="H5414"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* atrapara.  
\v 15 \w David|strong="H1732"\w* sabía \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w había|strong="H3588"\w* \w salido|strong="H3318"\w* \w con|strong="H3588"\w* \w la|strong="H3588"\w* intención \w de|strong="H3588"\w* matarlo. \w Por|strong="H3588"\w* eso se mantuvo escondido \w en|strong="H3588"\w* \w el|strong="H3588"\w* bosque, \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w* \w de|strong="H3588"\w* Zif.   
\p
\v 16 Jonatán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w David|strong="H1732"\w* al bosque para animarlo y fortalecer su confianza \w en|strong="H3212"\w* Dios.  
\v 17 \w Le|strong="H5921"\w* dijo: “\w No|strong="H3808"\w* tengas \w miedo|strong="H3372"\w*, \w que|strong="H3588"\w* \w mi|strong="H5921"\w* padre \w no|strong="H3808"\w* \w te|strong="H5921"\w* encontrará. Tú vas \w a|strong="H3068"\w* ser \w el|strong="H5921"\w* \w rey|strong="H4427"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* tu \w segundo|strong="H4932"\w* \w al|strong="H5921"\w* mando. \w Hasta|strong="H5921"\w* \w mi|strong="H5921"\w* padre \w Saúl|strong="H7586"\w* \w sabe|strong="H3045"\w* \w que|strong="H3588"\w* \w esto|strong="H3651"\w* \w es|strong="H1961"\w* \w verdad|strong="H3651"\w*”.  
\v 18 \w Los|strong="H3427"\w* \w dos|strong="H8147"\w* \w hicieron|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w ante|strong="H6440"\w* \w el|strong="H3427"\w* \w Señor|strong="H3068"\w*. \w David|strong="H1732"\w* se \w quedó|strong="H3427"\w* en \w el|strong="H3427"\w* bosque y Jonatán regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*.   
\p
\v 19 Pero \w los|strong="H5973"\w* \w de|strong="H5973"\w* Zif \w fueron|strong="H5927"\w* \w a|strong="H3068"\w* \w Gabaa|strong="H1390"\w* \w para|strong="H5973"\w* decirle \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “\w David|strong="H1732"\w* está \w escondido|strong="H5641"\w* \w en|strong="H5973"\w* nuestro territorio, \w en|strong="H5973"\w* \w los|strong="H5973"\w* refugios \w del|strong="H5973"\w* bosque, \w en|strong="H5973"\w* \w el|strong="H5973"\w* cerro \w de|strong="H5973"\w* Haquila, al sur \w del|strong="H5973"\w* desierto.  
\v 20 \w Por|strong="H3027"\w* eso, Majestad, \w venga|strong="H3381"\w* usted cuando quiera, y \w nosotros|strong="H3605"\w* nos encargaremos de entregarlo en sus \w manos|strong="H3027"\w*”.   
\p
\v 21 \w Saúl|strong="H7586"\w* respondió: “¡\w Que|strong="H3588"\w* Yahvé \w los|strong="H5921"\w* \w bendiga|strong="H1288"\w* \w por|strong="H5921"\w* haberme tenido lástima!  
\v 22 \w Vayan|strong="H3212"\w* \w ahora|strong="H4994"\w* \w y|strong="H3588"\w* asegúrense \w bien|strong="H3588"\w*; fíjense \w por|strong="H3588"\w* \w dónde|strong="H8033"\w* \w anda|strong="H3212"\w* \w y|strong="H3588"\w* \w quién|strong="H4310"\w* \w lo|strong="H1931"\w* ha \w visto|strong="H7200"\w*, \w porque|strong="H3588"\w* \w me|strong="H3588"\w* han dicho \w que|strong="H3588"\w* \w es|strong="H1931"\w* muy astuto.  
\v 23 Observen \w bien|strong="H7200"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* escondites \w donde|strong="H8033"\w* \w se|strong="H3045"\w* refugia y regresen \w a|strong="H3068"\w* verme con información segura. \w Entonces|strong="H7725"\w* yo \w iré|strong="H1980"\w* con ustedes, y \w si|strong="H1961"\w* \w él|strong="H3605"\w* \w está|strong="H1961"\w* todavía en esa región, \w lo|strong="H3605"\w* buscaré \w entre|strong="H8033"\w* \w todas|strong="H3605"\w* las familias de \w Judá|strong="H3063"\w*”.   
\p
\v 24 Ellos se adelantaron y se \w fueron|strong="H3212"\w* \w a|strong="H3068"\w* Zif. Mientras tanto, \w David|strong="H1732"\w* y sus hombres estaban \w en|strong="H3212"\w* el \w desierto|strong="H4057"\w* \w de|strong="H6440"\w* \w Maón|strong="H4584"\w*, \w en|strong="H3212"\w* la llanura al sur del \w desierto|strong="H4057"\w*.  
\v 25 \w Saúl|strong="H7586"\w* y sus soldados salieron \w a|strong="H3068"\w* buscarlo. Al saberlo, \w David|strong="H1732"\w* bajó \w a|strong="H3068"\w* un lugar rocoso \w en|strong="H3212"\w* \w el|strong="H3427"\w* \w desierto|strong="H4057"\w* de \w Maón|strong="H4584"\w*. \w Saúl|strong="H7586"\w* se enteró y \w fue|strong="H3212"\w* tras \w él|strong="H3427"\w* \w a|strong="H3068"\w* ese \w desierto|strong="H4057"\w*.  
\v 26 \w Saúl|strong="H7586"\w* \w iba|strong="H3212"\w* \w por|strong="H6440"\w* un \w lado|strong="H6654"\w* del \w monte|strong="H2022"\w*, y \w David|strong="H1732"\w* y sus hombres \w por|strong="H6440"\w* el \w otro|strong="H2088"\w*. \w David|strong="H1732"\w* \w se|strong="H1961"\w* apuraba \w para|strong="H1961"\w* escapar \w de|strong="H6440"\w* \w Saúl|strong="H7586"\w*, pero \w Saúl|strong="H7586"\w* y sus hombres \w ya|strong="H2088"\w* \w estaban|strong="H1961"\w* rodeándolos \w para|strong="H1961"\w* atraparlos.  
\v 27 \w En|strong="H5921"\w* ese momento \w llegó|strong="H3212"\w* un \w mensajero|strong="H4397"\w* \w y|strong="H3588"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¡Venga \w pronto|strong="H4116"\w*, \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* están invadiendo \w el|strong="H5921"\w* país!”.  
\v 28 \w Saúl|strong="H7586"\w* dejó \w de|strong="H5921"\w* perseguir \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w y|strong="H5921"\w* \w se|strong="H1931"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* pelear \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w aquel|strong="H1931"\w* \w lugar|strong="H4725"\w*: “Roca \w de|strong="H5921"\w* \w la|strong="H1931"\w* Separación”. \f + \fr 23:28 \ft “Sela Hammahlekoth” significa “roca de separación”.\f*   
\p
\v 29 De allí David subió \w a|strong="H3068"\w* los refugios de En Gadi y se quedó \w a|strong="H3068"\w* vivir en ese lugar.   
\c 24  
\p
\v 1 Cuando Saúl regresó de perseguir \w a|strong="H3068"\w* \w los|strong="H3427"\w* filisteos, le avisaron: “\w David|strong="H1732"\w* \w está|strong="H3427"\w* en \w el|strong="H3427"\w* desierto de En Gedi”.  
\v 2 \w Entonces|strong="H7725"\w* \w Saúl|strong="H7586"\w* tomó \w a|strong="H3068"\w* tres mil de \w los|strong="H1961"\w* mejores soldados de todo Israel y \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* \w David|strong="H1732"\w* y \w a|strong="H3068"\w* sus hombres por las rocas de las cabras monteses.  
\v 3 \w En|strong="H5921"\w* \w el|strong="H5921"\w* camino \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* unos rediles \w de|strong="H5921"\w* ovejas \w donde|strong="H5921"\w* había una cueva. \w Saúl|strong="H7586"\w* entró allí \w para|strong="H5921"\w* hacer sus necesidades, sin saber \w que|strong="H5921"\w* \w David|strong="H1732"\w* \w y|strong="H5921"\w* sus hombres estaban escondidos \w en|strong="H5921"\w* \w el|strong="H5921"\w* fondo \w de|strong="H5921"\w* esa misma cueva.  
\v 4 \w Los|strong="H3427"\w* hombres \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w le|strong="H5921"\w* susurraron: “¡Este es \w el|strong="H5921"\w* día \w que|strong="H5921"\w* Yahvé \w te|strong="H5921"\w* anunció cuando dijo: “\w Pondré|strong="H3427"\w* \w a|strong="H3068"\w* tu enemigo \w en|strong="H5921"\w* tus manos \w para|strong="H5921"\w* \w que|strong="H5921"\w* hagas \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* quieras”!”. Entonces \w David|strong="H1732"\w* \w se|strong="H5921"\w* levantó \w y|strong="H5921"\w*, sin hacer ruido, cortó una esquina \w del|strong="H5921"\w* manto \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*.  
\v 5 Pero después \w de|strong="H5414"\w* hacerlo, \w David|strong="H1732"\w* se sintió \w muy|strong="H3190"\w* mal y \w le|strong="H5869"\w* remordió la conciencia \w por|strong="H3027"\w* haber \w cortado|strong="H3772"\w* \w el|strong="H6213"\w* \w manto|strong="H4598"\w* \w de|strong="H5414"\w* \w Saúl|strong="H7586"\w*.  
\v 6 \w Les|strong="H5921"\w* dijo \w a|strong="H3068"\w* sus hombres: “¡\w Que|strong="H5921"\w* Yahvé \w me|strong="H5921"\w* libre \w de|strong="H5921"\w* hacerle daño \w a|strong="H3068"\w* \w mi|strong="H5921"\w* señor! \w Él|strong="H5921"\w* \w es|strong="H1961"\w* \w el|strong="H5921"\w* ungido \w de|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* \w no|strong="H1961"\w* debo levantar \w mi|strong="H5921"\w* mano \w contra|strong="H5921"\w* \w él|strong="H5921"\w*”.  
\v 7 \w Con|strong="H3588"\w* \w estas|strong="H2088"\w* \w palabras|strong="H1697"\w* David detuvo \w a|strong="H3068"\w* \w sus|strong="H1931"\w* hombres \w y|strong="H3588"\w* \w no|strong="H6213"\w* \w dejó|strong="H7971"\w* \w que|strong="H3588"\w* atacaran \w a|strong="H3068"\w* Saúl. Saúl salió \w de|strong="H3588"\w* \w la|strong="H1931"\w* cueva \w y|strong="H3588"\w* siguió \w su|strong="H1931"\w* camino.  
\v 8 Poco después, \w David|strong="H1732"\w* también \w salió|strong="H3212"\w* \w de|strong="H1697"\w* la \w cueva|strong="H4631"\w* y le gritó \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¡Majestad, mi señor el rey!”.  
\p Cuando \w Saúl|strong="H7586"\w* volteó, \w David|strong="H1732"\w* \w se|strong="H3808"\w* inclinó hasta tocar el suelo con la frente \w en|strong="H3212"\w* señal \w de|strong="H1697"\w* respeto.  
\v 9 \w Entonces|strong="H3651"\w* \w David|strong="H1732"\w* le dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¿\w Por|strong="H4480"\w* \w qué|strong="H4480"\w* le hace caso \w a|strong="H3068"\w* la gente \w que|strong="H4480"\w* dice \w que|strong="H4480"\w* \w yo|strong="H4480"\w* quiero hacerle daño?  
\v 10 Hoy mismo usted ha visto con sus propios ojos \w cómo|strong="H4100"\w* Yahvé \w lo|strong="H1697"\w* puso en mis manos dentro \w de|strong="H1697"\w* la cueva. Algunos me decían \w que|strong="H4100"\w* \w lo|strong="H1697"\w* matara, pero \w yo|strong="H2009"\w* le perdoné la vida. Dije: “\w No|strong="H4100"\w* le haré daño \w a|strong="H3068"\w* \w mi|strong="H2009"\w* señor, \w porque|strong="H4100"\w* él \w es|strong="H1697"\w* el ungido \w de|strong="H1697"\w* Yahvé”.  
\v 11 \w Mire|strong="H7200"\w* usted, padre \w mío|strong="H5921"\w*, \w mire|strong="H7200"\w* \w la|strong="H1931"\w* punta \w de|strong="H5921"\w* \w su|strong="H1931"\w* manto \w que|strong="H3588"\w* \w tengo|strong="H5921"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w*. \w El|strong="H1931"\w* hecho \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* cortara \w el|strong="H1931"\w* manto \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w matara|strong="H2026"\w* \w a|strong="H3068"\w* usted \w es|strong="H1931"\w* una prueba \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w tengo|strong="H5921"\w* malas intenciones \w ni|strong="H3808"\w* \w soy|strong="H1931"\w* un rebelde. \w Yo|strong="H3588"\w* \w no|strong="H3808"\w* he pecado \w contra|strong="H5921"\w* usted, \w aunque|strong="H3588"\w* usted \w me|strong="H5921"\w* persigue \w para|strong="H5921"\w* quitarme \w la|strong="H1931"\w* \w vida|strong="H3117"\w*.  
\v 12 ¡\w Que|strong="H3588"\w* Yahvé juzgue \w entre|strong="H3808"\w* nosotros dos! ¡\w Que|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* vengue \w de|strong="H3588"\w* usted, \w pero|strong="H3588"\w* \w yo|strong="H3588"\w* \w no|strong="H3808"\w* levantaré \w mi|strong="H5315"\w* \w mano|strong="H3027"\w* \w para|strong="H3588"\w* dañarlo!  
\v 13 \w Como|strong="H1961"\w* dice el antiguo refrán: “La maldad viene \w de|strong="H4480"\w* \w los|strong="H1961"\w* malvados”, \w por|strong="H4480"\w* eso \w mi|strong="H1961"\w* \w mano|strong="H3027"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* tocará.  
\v 14 ¿\w A|strong="H3068"\w* quién \w ha|strong="H3808"\w* \w salido|strong="H3318"\w* \w a|strong="H3068"\w* perseguir el rey de Israel? ¿\w A|strong="H3068"\w* quién anda buscando? ¿\w A|strong="H3068"\w* un perro muerto? ¿\w A|strong="H3068"\w* una pulga?  
\v 15 ¡\w Que|strong="H4310"\w* Yahvé sea \w el|strong="H4310"\w* juez y decida \w quién|strong="H4310"\w* tiene la razón! \w Que|strong="H4310"\w* \w él|strong="H4310"\w* examine mi caso, \w me|strong="H4310"\w* defienda y \w me|strong="H4310"\w* libre de su mano”.   
\p
\v 16 \w Cuando|strong="H1961"\w* David terminó de hablar, \w Saúl|strong="H7200"\w* le preguntó: “¿De verdad \w eres|strong="H1961"\w* \w tú|strong="H8199"\w*, David, hijo mío?”. \w Y|strong="H3068"\w* \w Saúl|strong="H7200"\w* \w se|strong="H1961"\w* puso \w a|strong="H3068"\w* llorar \w a|strong="H3068"\w* gritos.  
\v 17 \w Luego|strong="H2088"\w* le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “Tú \w eres|strong="H1961"\w* \w más|strong="H1058"\w* justo \w que|strong="H1697"\w* yo, \w porque|strong="H1732"\w* me has devuelto bien \w por|strong="H1697"\w* mal.  
\v 18 Hoy has demostrado tu bondad conmigo, \w pues|strong="H3588"\w* Yahvé \w me|strong="H4480"\w* puso \w en|strong="H4480"\w* tus manos \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w me|strong="H4480"\w* mataste.  
\v 19 \w Si|strong="H3808"\w* alguien encuentra \w a|strong="H3068"\w* su enemigo, ¿acaso \w lo|strong="H3808"\w* deja ir sano y salvo? ¡\w Que|strong="H3808"\w* \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* te recompense \w por|strong="H3027"\w* \w lo|strong="H3808"\w* \w bueno|strong="H2896"\w* \w que|strong="H3808"\w* \w has|strong="H2026"\w* \w hecho|strong="H6213"\w* \w hoy|strong="H3117"\w* \w conmigo|strong="H6213"\w*!  
\v 20 \w Ahora|strong="H3117"\w* estoy seguro \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w tú|strong="H6213"\w* serás \w el|strong="H3588"\w* \w rey|strong="H6213"\w*, \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* reino \w de|strong="H3588"\w* Israel se consolidará \w bajo|strong="H8478"\w* \w tu|strong="H6213"\w* \w mando|strong="H7971"\w*.  
\v 21 Júrame \w ahora|strong="H6258"\w* \w por|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* \w no|strong="H3588"\w* exterminarás \w a|strong="H3068"\w* mis descendientes \w ni|strong="H6258"\w* borrarás \w mi|strong="H2009"\w* nombre \w de|strong="H3588"\w* \w la|strong="H3588"\w* familia \w de|strong="H3588"\w* \w mi|strong="H2009"\w* padre”.   
\p
\v 22 David se lo \w juró|strong="H7650"\w*. Después Saúl regresó \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*, y David y sus hombres volvieron \w a|strong="H3068"\w* su refugio.   
\c 25  
\p
\v 1 \w Samuel|strong="H8050"\w* \w murió|strong="H4191"\w*, y \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* se reunió para llorar su \w muerte|strong="H4191"\w*. \w Lo|strong="H6908"\w* enterraron \w en|strong="H6912"\w* \w Ramá|strong="H7414"\w*, donde \w él|strong="H3605"\w* vivía.  
\p Después \w David|strong="H1732"\w* se fue al \w desierto|strong="H4057"\w* de \w Parán|strong="H6290"\w*.  
\v 2 En \w Maón|strong="H4584"\w* vivía un hombre \w muy|strong="H3966"\w* \w rico|strong="H1419"\w* \w que|strong="H1961"\w* \w tenía|strong="H1961"\w* sus negocios en el Carmelo. \w Tenía|strong="H1961"\w* \w tres|strong="H7969"\w* mil \w ovejas|strong="H6629"\w* y mil \w cabras|strong="H5795"\w*, y en ese tiempo \w estaba|strong="H1961"\w* en el Carmelo trasquilando \w a|strong="H3068"\w* sus \w ovejas|strong="H6629"\w*.  
\v 3 \w Este|strong="H1931"\w* hombre \w se|strong="H1931"\w* \w llamaba|strong="H8034"\w* \w Nabal|strong="H5037"\w* y \w su|strong="H1931"\w* esposa \w se|strong="H1931"\w* \w llamaba|strong="H8034"\w* Abigail. \w Ella|strong="H1931"\w* \w era|strong="H1931"\w* una mujer inteligente y muy \w hermosa|strong="H3303"\w*, pero \w su|strong="H1931"\w* esposo \w era|strong="H1931"\w* un hombre grosero y \w de|strong="H7451"\w* \w mala|strong="H7451"\w* conducta; \w era|strong="H1931"\w* descendiente \w de|strong="H7451"\w* Caleb.  
\v 4 Estando \w David|strong="H1732"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*, \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w Nabal|strong="H5037"\w* estaba trasquilando sus \w ovejas|strong="H6629"\w*.  
\v 5 Entonces \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w diez|strong="H6235"\w* de sus jóvenes con este mensaje: “Vayan al Carmelo, busquen \w a|strong="H3068"\w* \w Nabal|strong="H5037"\w* y salúdenlo de mi parte.  
\v 6 Díganle: “¡Deseo \w que|strong="H3605"\w* tengas salud \w y|strong="H3541"\w* \w paz|strong="H7965"\w*, tú \w y|strong="H3541"\w* tu \w familia|strong="H1004"\w*, \w y|strong="H3541"\w* \w que|strong="H3605"\w* prospere \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* tienes!  
\v 7 He sabido \w que|strong="H3588"\w* estás trasquilando tus ovejas. Tus \w pastores|strong="H7462"\w* han \w estado|strong="H1961"\w* \w con|strong="H5973"\w* \w nosotros|strong="H3605"\w* \w y|strong="H3588"\w* \w nunca|strong="H3808"\w* \w los|strong="H3605"\w* maltratamos; \w mientras|strong="H3588"\w* \w estuvieron|strong="H1961"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* Carmelo \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w les|strong="H5973"\w* perdió \w nada|strong="H3808"\w*.  
\v 8 Pregúntales \w a|strong="H3068"\w* tus propios trabajadores \w y|strong="H3588"\w* \w ellos|strong="H3027"\w* \w te|strong="H5869"\w* \w lo|strong="H5921"\w* confirmarán. \w Por|strong="H5921"\w* eso, \w te|strong="H5869"\w* \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* recibas \w bien|strong="H2896"\w* \w a|strong="H3068"\w* \w mis|strong="H5414"\w* \w muchachos|strong="H1121"\w*, \w ya|strong="H4994"\w* \w que|strong="H3588"\w* venimos \w en|strong="H5921"\w* un \w día|strong="H3117"\w* \w de|strong="H5921"\w* fiesta. \w Por|strong="H5921"\w* favor, \w danos|strong="H5414"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* puedas \w para|strong="H5921"\w* tus servidores \w y|strong="H3588"\w* \w para|strong="H5921"\w* tu amigo \w David|strong="H1732"\w*””.   
\p
\v 9 Cuando \w los|strong="H3605"\w* jóvenes llegaron, le dieron \w el|strong="H3605"\w* mensaje \w de|strong="H1697"\w* parte \w de|strong="H1697"\w* \w David|strong="H1732"\w* y se quedaron esperando \w la|strong="H3605"\w* \w respuesta|strong="H1697"\w*.   
\p
\v 10 Pero \w Nabal|strong="H5037"\w* les contestó \w a|strong="H3068"\w* \w los|strong="H1121"\w* servidores \w de|strong="H6440"\w* \w David|strong="H1732"\w*: “¿\w Y|strong="H3068"\w* \w quién|strong="H4310"\w* \w es|strong="H7235"\w* ese \w David|strong="H1732"\w*? ¿\w Quién|strong="H4310"\w* se cree \w que|strong="H4310"\w* \w es|strong="H7235"\w* ese \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Isaí|strong="H3448"\w*? ¡\w Hoy|strong="H3117"\w* en \w día|strong="H3117"\w* \w hay|strong="H4310"\w* \w muchos|strong="H7235"\w* esclavos \w que|strong="H4310"\w* huyen \w de|strong="H6440"\w* sus dueños!  
\v 11 ¿Acaso voy \w a|strong="H3068"\w* \w tomar|strong="H3947"\w* mi \w pan|strong="H3899"\w*, mi \w agua|strong="H4325"\w* y la carne \w que|strong="H3808"\w* preparé \w para|strong="H5414"\w* \w mis|strong="H5414"\w* \w trasquiladores|strong="H1494"\w*, y \w se|strong="H3045"\w* la voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w a|strong="H3068"\w* gente \w que|strong="H3808"\w* \w ni|strong="H3808"\w* \w sé|strong="H3045"\w* \w de|strong="H5414"\w* dónde viene?”.   
\p
\v 12 \w Los|strong="H3605"\w* jóvenes regresaron \w a|strong="H3068"\w* donde estaba \w David|strong="H1732"\w* y le \w contaron|strong="H5046"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Nabal había \w dicho|strong="H1697"\w*.   
\p
\v 13 \w Entonces|strong="H1571"\w* \w David|strong="H1732"\w* \w les|strong="H5921"\w* ordenó: “¡Pónganse todos su \w espada|strong="H2719"\w*!”.  
\p Todos \w se|strong="H5921"\w* pusieron su \w espada|strong="H2719"\w*, incluyendo \w David|strong="H1732"\w*. Unos cuatrocientos hombres \w se|strong="H5921"\w* \w fueron|strong="H5927"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w*, mientras \w que|strong="H5921"\w* \w doscientos|strong="H3967"\w* \w se|strong="H5921"\w* quedaron cuidando \w el|strong="H5921"\w* equipaje.   
\p
\v 14 Mientras tanto, uno de los \w criados|strong="H5288"\w* le \w avisó|strong="H5046"\w* \w a|strong="H3068"\w* Abigail: “\w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* desde el \w desierto|strong="H4057"\w* para saludar \w a|strong="H3068"\w* nuestro amo, pero él los insultó.  
\v 15 \w Sin|strong="H3808"\w* embargo, esos hombres \w se|strong="H1961"\w* portaron \w muy|strong="H3966"\w* \w bien|strong="H2896"\w* con \w nosotros|strong="H3605"\w*. \w Nunca|strong="H3808"\w* nos molestaron \w ni|strong="H3808"\w* \w se|strong="H1961"\w* nos perdió \w nada|strong="H3808"\w* \w mientras|strong="H3605"\w* \w anduvimos|strong="H1980"\w* con \w ellos|strong="H3605"\w* en \w el|strong="H3605"\w* \w campo|strong="H7704"\w*.  
\v 16 \w Al|strong="H5921"\w* contrario, \w nos|strong="H5921"\w* protegieron \w día|strong="H3117"\w* \w y|strong="H1571"\w* \w noche|strong="H3915"\w* \w como|strong="H1571"\w* una muralla, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H5921"\w* estuvimos cuidando \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w* \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 17 Piense usted \w bien|strong="H3588"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w hacer|strong="H6213"\w*, \w porque|strong="H3588"\w* \w de|strong="H5921"\w* seguro \w le|strong="H1931"\w* espera algo \w malo|strong="H7451"\w* \w a|strong="H3068"\w* nuestro amo \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w su|strong="H1931"\w* \w familia|strong="H1004"\w*. ¡\w Él|strong="H1931"\w* \w es|strong="H1931"\w* \w tan|strong="H1931"\w* malhumorado \w que|strong="H3588"\w* \w nadie|strong="H3605"\w* puede \w hablarle|strong="H1696"\w*!”.   
\p
\v 18 Abigail \w se|strong="H5921"\w* apresuró \w a|strong="H3068"\w* preparar \w doscientos|strong="H3967"\w* \w panes|strong="H3899"\w*, \w dos|strong="H8147"\w* \w cueros|strong="H5035"\w* \w de|strong="H5921"\w* \w vino|strong="H3196"\w*, \w cinco|strong="H2568"\w* \w ovejas|strong="H6629"\w* ya \w guisadas|strong="H6213"\w*, \w cinco|strong="H2568"\w* \w medidas|strong="H5429"\w*\f + \fr 25:18 \ft Una medida (seah) es equivalente a unos 7 litros.\f* \w de|strong="H5921"\w* grano \w tostado|strong="H7039"\w*, \w cien|strong="H3967"\w* racimos \w de|strong="H5921"\w* pasas \w y|strong="H5921"\w* \w doscientos|strong="H3967"\w* \w panes|strong="H3899"\w* \w de|strong="H5921"\w* higos secos. \w Lo|strong="H5921"\w* cargó todo \w en|strong="H5921"\w* burros  
\v 19 y les \w dijo|strong="H5046"\w* \w a|strong="H3068"\w* sus \w criados|strong="H5288"\w*: “Vayan adelante, \w que|strong="H3808"\w* yo los sigo”. Pero \w no|strong="H3808"\w* le \w dijo|strong="H5046"\w* \w nada|strong="H3808"\w* \w a|strong="H3068"\w* su esposo \w Nabal|strong="H5037"\w*.  
\v 20 \w Ella|strong="H1931"\w* \w iba|strong="H7392"\w* montada \w en|strong="H5921"\w* \w su|strong="H1931"\w* burro \w y|strong="H5921"\w*, \w al|strong="H5921"\w* dar \w la|strong="H1931"\w* vuelta \w en|strong="H5921"\w* un recodo \w del|strong="H5921"\w* \w monte|strong="H2022"\w*, \w se|strong="H1961"\w* encontró \w de|strong="H5921"\w* frente \w con|strong="H5921"\w* \w David|strong="H1732"\w* \w y|strong="H5921"\w* \w sus|strong="H1931"\w* hombres \w que|strong="H1931"\w* venían bajando \w hacia|strong="H5921"\w* \w ella|strong="H1931"\w*.   
\p
\v 21 \w David|strong="H1732"\w* venía diciendo: “¡\w De|strong="H8478"\w* \w nada|strong="H3808"\w* sirvió \w que|strong="H3808"\w* yo cuidara las propiedades \w de|strong="H8478"\w* \w ese|strong="H2088"\w* hombre \w en|strong="H8478"\w* \w el|strong="H3605"\w* \w desierto|strong="H4057"\w*! Me aseguré \w de|strong="H8478"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* le perdiera \w nada|strong="H3808"\w*, y ahora \w él|strong="H3605"\w* me paga \w mal|strong="H7451"\w* \w por|strong="H8478"\w* \w bien|strong="H2896"\w*.  
\v 22 ¡\w Que|strong="H5704"\w* Dios \w me|strong="H3541"\w* castigue duramente si \w para|strong="H5704"\w* \w mañana|strong="H1242"\w* \w dejo|strong="H7604"\w* vivo \w a|strong="H3068"\w* uno solo \w de|strong="H5704"\w* sus hombres!”. \f + \fr 25:22 \ft El texto usa una expresión antigua para referirse a los varones.\f*   
\p
\v 23 \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* Abigail \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w se|strong="H5921"\w* bajó \w del|strong="H5921"\w* burro \w y|strong="H5921"\w* \w se|strong="H5921"\w* inclinó \w ante|strong="H6440"\w* \w él|strong="H5921"\w* \w hasta|strong="H5921"\w* tocar \w el|strong="H5921"\w* suelo \w con|strong="H5921"\w* \w la|strong="H5921"\w* frente.  
\v 24 \w Se|strong="H5921"\w* \w echó|strong="H5307"\w* \w a|strong="H3068"\w* sus \w pies|strong="H7272"\w* \w y|strong="H5921"\w* \w le|strong="H5921"\w* suplicó: “¡Señor \w mío|strong="H5921"\w*, \w la|strong="H5921"\w* culpa \w es|strong="H1697"\w* solo mía! \w Por|strong="H5921"\w* favor, deje \w que|strong="H4994"\w* \w esta|strong="H5921"\w* servidora suya \w le|strong="H5921"\w* \w hable|strong="H1696"\w*; \w escuche|strong="H8085"\w* \w lo|strong="H1697"\w* \w que|strong="H4994"\w* \w tengo|strong="H5921"\w* \w que|strong="H4994"\w* decirle.  
\v 25 \w No|strong="H3808"\w* \w le|strong="H1931"\w* haga \w caso|strong="H3820"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* necio \w de|strong="H5921"\w* \w Nabal|strong="H5037"\w*. \w Él|strong="H1931"\w* hace honor \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w nombre|strong="H8034"\w*, \w porque|strong="H3588"\w* \w es|strong="H1931"\w* un tonto \w de|strong="H5921"\w* \w verdad|strong="H3651"\w*. \w Yo|strong="H3588"\w* \w no|strong="H3808"\w* \w vi|strong="H7200"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* jóvenes \w que|strong="H3588"\w* usted \w envió|strong="H7971"\w*.  
\v 26 \w Ahora|strong="H6258"\w*, \w señor|strong="H3068"\w* mío, juro \w por|strong="H3027"\w* Yahvé y \w por|strong="H3027"\w* su propia \w vida|strong="H5315"\w*, \w que|strong="H6258"\w* \w es|strong="H1961"\w* Yahvé quien ha impedido \w que|strong="H6258"\w* usted \w se|strong="H1961"\w* vengue \w por|strong="H3027"\w* su propia \w mano|strong="H3027"\w* y derrame \w sangre|strong="H1818"\w*. ¡\w Que|strong="H6258"\w* sus enemigos y \w los|strong="H1961"\w* \w que|strong="H6258"\w* quieran hacerle daño acaben \w como|strong="H1961"\w* \w Nabal|strong="H5037"\w*!  
\v 27 \w Por|strong="H5414"\w* favor, acepte \w este|strong="H2063"\w* regalo \w que|strong="H6258"\w* le traigo y déselo \w a|strong="H3068"\w* los hombres \w que|strong="H6258"\w* lo acompañan.  
\v 28 \w Perdone|strong="H4994"\w* usted \w a|strong="H3068"\w* esta servidora suya. \w Yo|strong="H3588"\w* \w sé|strong="H3808"\w* \w que|strong="H3588"\w* Yahvé le dará \w a|strong="H3068"\w* usted un reino duradero, \w porque|strong="H3588"\w* usted \w pelea|strong="H3898"\w* las \w batallas|strong="H4421"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* \w en|strong="H3588"\w* toda \w su|strong="H3588"\w* \w vida|strong="H3117"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* \w hallado|strong="H4672"\w* \w maldad|strong="H7451"\w* \w en|strong="H3588"\w* usted.  
\v 29 \w Si|strong="H1961"\w* alguien intenta perseguirlo \w para|strong="H1961"\w* matarlo, Yahvé su \w Dios|strong="H3068"\w* lo protegerá y lo mantendrá \w a|strong="H3068"\w* salvo; pero \w a|strong="H3068"\w* sus enemigos, él \w los|strong="H7291"\w* lanzará lejos, \w como|strong="H1961"\w* quien lanza una piedra con una honda.  
\v 30 \w Cuando|strong="H3588"\w* Yahvé cumpla \w todas|strong="H3605"\w* \w las|strong="H5921"\w* promesas \w de|strong="H5921"\w* \w bien|strong="H2896"\w* \w que|strong="H3588"\w* \w le|strong="H5921"\w* ha \w hecho|strong="H6213"\w* \w y|strong="H3588"\w* \w lo|strong="H5921"\w* nombre jefe \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*,  
\v 31 usted \w no|strong="H3808"\w* \w tendrá|strong="H1961"\w* \w que|strong="H3808"\w* cargar con el remordimiento \w de|strong="H1818"\w* \w haber|strong="H1961"\w* \w derramado|strong="H8210"\w* \w sangre|strong="H1818"\w* \w inocente|strong="H1818"\w* \w o|strong="H3068"\w* \w de|strong="H1818"\w* haberse vengado por su cuenta. \w Y|strong="H3068"\w* \w cuando|strong="H1961"\w* Yahvé \w lo|strong="H3808"\w* \w haya|strong="H1961"\w* prosperado, acuérdese \w de|strong="H1818"\w* \w esta|strong="H2063"\w* servidora suya”.   
\p
\v 32 \w David|strong="H1732"\w* le respondió \w a|strong="H3068"\w* Abigail: “¡\w Bendito|strong="H1288"\w* sea Yahvé, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, \w que|strong="H3117"\w* te \w envió|strong="H7971"\w* \w hoy|strong="H3117"\w* \w a|strong="H3068"\w* mi encuentro!  
\v 33 \w Bendito|strong="H1288"\w* sea tu buen juicio, y \w bendita|strong="H1288"\w* seas tú, \w que|strong="H3117"\w* me has impedido derramar \w sangre|strong="H1818"\w* y vengarme \w por|strong="H2088"\w* mi propia \w mano|strong="H3027"\w*.  
\v 34 \w Te|strong="H3588"\w* juro \w por|strong="H3588"\w* Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w que|strong="H3588"\w* \w si|strong="H3588"\w* \w no|strong="H3884"\w* hubieras venido \w pronto|strong="H4116"\w* \w a|strong="H3068"\w* mi encuentro, \w para|strong="H5704"\w* \w mañana|strong="H1242"\w* \w no|strong="H3884"\w* \w le|strong="H1242"\w* habría quedado \w vivo|strong="H2416"\w* \w a|strong="H3068"\w* \w Nabal|strong="H5037"\w* \w ni|strong="H5704"\w* uno solo \w de|strong="H3588"\w* sus hombres”.   
\p
\v 35 \w David|strong="H1732"\w* aceptó todo lo \w que|strong="H3027"\w* ella le había traído y le dijo: “Vete tranquila \w a|strong="H3068"\w* tu \w casa|strong="H1004"\w*. \w Ya|strong="H3068"\w* \w escuché|strong="H8085"\w* tu petición y te la he concedido”.   
\p
\v 36 \w Cuando|strong="H5704"\w* Abigail regresó, \w Nabal|strong="H5037"\w* \w estaba|strong="H2009"\w* celebrando un \w banquete|strong="H4960"\w* digno \w de|strong="H5921"\w* un \w rey|strong="H4428"\w*. \w Estaba|strong="H2009"\w* \w muy|strong="H3966"\w* \w alegre|strong="H2896"\w* \w y|strong="H5921"\w* completamente borracho, \w así|strong="H1931"\w* \w que|strong="H1931"\w* \w ella|strong="H1931"\w* \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w dijo|strong="H5046"\w* \w nada|strong="H3808"\w* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* día siguiente.  
\v 37 \w Por|strong="H1697"\w* \w la|strong="H1931"\w* \w mañana|strong="H1242"\w*, \w cuando|strong="H1961"\w* \w a|strong="H3068"\w* \w Nabal|strong="H5037"\w* \w se|strong="H1961"\w* \w le|strong="H1931"\w* pasó \w la|strong="H1931"\w* borrachera, \w su|strong="H1931"\w* esposa \w le|strong="H1931"\w* \w contó|strong="H5046"\w* todo \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w había|strong="H1961"\w* pasado. Entonces \w Nabal|strong="H5037"\w* sufrió un ataque \w al|strong="H7130"\w* \w corazón|strong="H3820"\w* y \w se|strong="H1961"\w* \w quedó|strong="H1961"\w* paralizado \w como|strong="H1961"\w* una piedra.  
\v 38 Unos \w diez|strong="H6235"\w* \w días|strong="H3117"\w* \w después|strong="H1961"\w*, Yahvé \w hirió|strong="H5062"\w* \w a|strong="H3068"\w* \w Nabal|strong="H5037"\w* y \w murió|strong="H4191"\w*.  
\v 39 Al saber \w David|strong="H1732"\w* \w que|strong="H3588"\w* \w Nabal|strong="H5037"\w* \w había|strong="H3588"\w* \w muerto|strong="H4191"\w*, exclamó: “¡\w Bendito|strong="H1288"\w* sea Yahvé! \w Él|strong="H3588"\w* \w me|strong="H3588"\w* defendió \w de|strong="H3588"\w* \w la|strong="H3588"\w* humillación \w que|strong="H3588"\w* \w me|strong="H3588"\w* hizo \w Nabal|strong="H5037"\w*, \w y|strong="H3588"\w* \w me|strong="H3588"\w* libró \w de|strong="H3588"\w* cometer una \w maldad|strong="H7451"\w*. Yahvé hizo \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w maldad|strong="H7451"\w* \w de|strong="H3588"\w* \w Nabal|strong="H5037"\w* cayera sobre \w su|strong="H3588"\w* propia \w cabeza|strong="H7218"\w*”.  
\p Después, \w David|strong="H1732"\w* \w mandó|strong="H1696"\w* \w a|strong="H3068"\w* proponerle matrimonio \w a|strong="H3068"\w* Abigail.  
\v 40 Los servidores de \w David|strong="H1732"\w* llegaron al Carmelo y le \w dijeron|strong="H1696"\w* \w a|strong="H3068"\w* Abigail: “\w David|strong="H1732"\w* nos \w envió|strong="H7971"\w* para pedirle que sea su esposa”.   
\p
\v 41 Ella se inclinó hasta el suelo y respondió: “\w Aquí|strong="H2009"\w* tienen \w a|strong="H3068"\w* su servidora, dispuesta incluso \w a|strong="H3068"\w* lavarles los \w pies|strong="H7272"\w* \w a|strong="H3068"\w* los esclavos de \w mi|strong="H2009"\w* señor”.  
\v 42 \w De|strong="H5921"\w* inmediato, Abigail \w se|strong="H1961"\w* preparó \w y|strong="H5921"\w*, acompañada \w de|strong="H5921"\w* sus \w cinco|strong="H2568"\w* criadas, montó \w en|strong="H5921"\w* un burro \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w fue|strong="H1961"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w mensajeros|strong="H4397"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*. Así \w llegó|strong="H3212"\w* \w a|strong="H3068"\w* ser su esposa.  
\v 43 \w David|strong="H1732"\w* \w también|strong="H1571"\w* \w se|strong="H1961"\w* \w casó|strong="H3947"\w* \w con|strong="H1571"\w* Ahinoam de \w Jezreel|strong="H3157"\w*, \w y|strong="H1571"\w* las \w dos|strong="H8147"\w* \w fueron|strong="H1961"\w* sus esposas.   
\p
\v 44 Mientras tanto, \w Saúl|strong="H7586"\w* le había \w entregado|strong="H5414"\w* su \w hija|strong="H1323"\w* Mical, \w la|strong="H4324"\w* esposa \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w a|strong="H3068"\w* un \w hombre|strong="H1121"\w* llamado \w Palti|strong="H6406"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Lais|strong="H3919"\w*, \w que|strong="H1121"\w* \w era|strong="H1121"\w* \w de|strong="H1121"\w* Galim.   
\c 26  
\p
\v 1 \w Los|strong="H5921"\w* hombres \w de|strong="H5921"\w* Zif \w fueron|strong="H1732"\w* \w a|strong="H3068"\w* \w Gabaa|strong="H1390"\w* \w para|strong="H5921"\w* decirle \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¿\w No|strong="H3808"\w* \w sabe|strong="H5641"\w* usted \w que|strong="H3808"\w* \w David|strong="H1732"\w* \w está|strong="H5921"\w* \w escondido|strong="H5641"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* cerro \w de|strong="H5921"\w* Haquila, frente \w al|strong="H5921"\w* desierto?”.  
\v 2 \w Saúl|strong="H7586"\w* se puso en marcha de inmediato y bajó al \w desierto|strong="H4057"\w* de Zif con \w tres|strong="H7969"\w* mil de los mejores soldados de \w Israel|strong="H3478"\w*, para buscar \w a|strong="H3068"\w* \w David|strong="H1732"\w*.  
\v 3 \w Saúl|strong="H7586"\w* acampó \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w camino|strong="H1870"\w*, \w en|strong="H5921"\w* \w el|strong="H5921"\w* cerro \w de|strong="H5921"\w* Haquila, frente \w al|strong="H5921"\w* \w desierto|strong="H4057"\w*. \w David|strong="H1732"\w*, \w que|strong="H3588"\w* \w estaba|strong="H3427"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w*, \w se|strong="H5921"\w* dio cuenta \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w lo|strong="H5921"\w* venía persiguiendo.  
\v 4 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w espías|strong="H7270"\w* \w y|strong="H3588"\w* confirmó \w que|strong="H3588"\w*, \w en|strong="H3588"\w* efecto, \w Saúl|strong="H7586"\w* ya \w había|strong="H3588"\w* llegado.  
\v 5 \w David|strong="H1732"\w* \w se|strong="H5971"\w* \w levantó|strong="H6965"\w* y \w fue|strong="H6635"\w* al \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w Saúl|strong="H7586"\w* había acampado. \w Allí|strong="H8033"\w* \w vio|strong="H7200"\w* \w dónde|strong="H8033"\w* dormían \w Saúl|strong="H7586"\w* y Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w*, \w el|strong="H1121"\w* \w general|strong="H8269"\w* \w de|strong="H1121"\w* su \w ejército|strong="H6635"\w*. \w Saúl|strong="H7586"\w* dormía en medio del campamento, rodeado por sus soldados.   
\p
\v 6 \w David|strong="H1732"\w* \w les|strong="H5973"\w* preguntó \w a|strong="H3068"\w* Ahimelec \w el|strong="H5973"\w* hitita y \w a|strong="H3068"\w* Abisai \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Sarvia, hermano \w de|strong="H5973"\w* \w Joab|strong="H3097"\w*: “¿\w Quién|strong="H4310"\w* se atreve \w a|strong="H3068"\w* bajar \w conmigo|strong="H5973"\w* al \w campamento|strong="H4264"\w* \w de|strong="H5973"\w* \w Saúl|strong="H7586"\w*?”. Abisai \w respondió|strong="H6030"\w*: “Yo voy \w con|strong="H5973"\w* usted”.  
\v 7 \w David|strong="H1732"\w* y Abisai entraron al campamento \w de|strong="H5971"\w* \w noche|strong="H3915"\w*. \w Saúl|strong="H7586"\w* \w estaba|strong="H2009"\w* profundamente dormido en medio del campamento, con su \w lanza|strong="H2595"\w* clavada en tierra, cerca \w de|strong="H5971"\w* su cabeza. Abner y los soldados también dormían \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*.  
\v 8 Abisai le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Hoy|strong="H3117"\w* Dios \w ha|strong="H3808"\w* \w puesto|strong="H5462"\w* \w a|strong="H3068"\w* su enemigo \w en|strong="H5221"\w* sus \w manos|strong="H3027"\w*. Déjeme clavarlo \w en|strong="H5221"\w* el suelo con su propia \w lanza|strong="H2595"\w* \w de|strong="H8138"\w* un solo \w golpe|strong="H6471"\w*; \w no|strong="H3808"\w* tendré \w que|strong="H3808"\w* darle un segundo”.   
\p
\v 9 \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* \w le|strong="H4310"\w* respondió: “¡\w No|strong="H3588"\w* lo mates! Nadie puede levantar \w la|strong="H3588"\w* \w mano|strong="H3027"\w* contra \w el|strong="H3588"\w* \w ungido|strong="H4899"\w* \w de|strong="H3588"\w* Yahvé \w y|strong="H3588"\w* quedar sin \w castigo|strong="H5352"\w*”.  
\v 10 \w Y|strong="H3068"\w* añadió: “Tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w vive|strong="H2416"\w*, \w que|strong="H3588"\w* \w él|strong="H3588"\w* mismo lo \w herirá|strong="H5062"\w*, \w o|strong="H3068"\w* llegará \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w muerte|strong="H4191"\w*, \w o|strong="H3068"\w* \w morirá|strong="H4191"\w* \w en|strong="H3588"\w* \w batalla|strong="H4421"\w*.  
\v 11 ¡\w Que|strong="H6258"\w* Yahvé me libre \w de|strong="H4325"\w* levantar \w mi|strong="H4994"\w* \w mano|strong="H3027"\w* contra su \w ungido|strong="H4899"\w*! Pero \w toma|strong="H3947"\w* \w ahora|strong="H6258"\w* la \w lanza|strong="H2595"\w* \w que|strong="H6258"\w* está \w a|strong="H3068"\w* su \w cabecera|strong="H4763"\w* y la jarra \w de|strong="H4325"\w* \w agua|strong="H4325"\w*, y vámonos \w de|strong="H4325"\w* aquí”.   
\p
\v 12 \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* \w la|strong="H5921"\w* \w lanza|strong="H2595"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* jarra \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* cabecera \w de|strong="H5921"\w* \w Saúl|strong="H7586"\w*, \w y|strong="H3588"\w* \w se|strong="H3045"\w* \w fueron|strong="H3212"\w*. \w Nadie|strong="H3605"\w* \w los|strong="H5921"\w* \w vio|strong="H7200"\w* ni \w se|strong="H3045"\w* dio cuenta \w de|strong="H5921"\w* \w nada|strong="H3605"\w*, ni \w nadie|strong="H3605"\w* \w se|strong="H3045"\w* despertó; \w todos|strong="H3605"\w* \w seguían|strong="H5921"\w* dormidos \w porque|strong="H3588"\w* Yahvé \w los|strong="H5921"\w* \w había|strong="H3588"\w* hundido \w en|strong="H5921"\w* un sueño profundo.  
\v 13 \w Luego|strong="H5674"\w* \w David|strong="H1732"\w* cruzó \w al|strong="H5921"\w* otro \w lado|strong="H5676"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* paró \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cumbre|strong="H7218"\w* \w de|strong="H5921"\w* un cerro, \w a|strong="H3068"\w* una \w distancia|strong="H7350"\w* segura \w de|strong="H5921"\w* Saúl.  
\v 14 Desde allí \w gritó|strong="H7121"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* soldados y \w a|strong="H3068"\w* Abner \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Ner|strong="H5369"\w*: “¿\w No|strong="H3808"\w* vas \w a|strong="H3068"\w* \w responder|strong="H6030"\w*, Abner?”.  
\p Abner \w gritó|strong="H7121"\w*: “¿\w Quién|strong="H4310"\w* eres tú, \w que|strong="H4310"\w* \w le|strong="H4310"\w* gritas \w al|strong="H4428"\w* \w rey|strong="H4428"\w*?”.   
\p
\v 15 \w David|strong="H1732"\w* \w le|strong="H4310"\w* respondió: “¿Acaso \w no|strong="H3808"\w* eres tú todo un hombre? ¿\w Quién|strong="H4310"\w* \w como|strong="H4100"\w* tú \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*? ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w no|strong="H3808"\w* cuidaste \w a|strong="H3068"\w* tu señor \w el|strong="H3588"\w* \w rey|strong="H4428"\w*? ¡Un soldado entró \w para|strong="H3588"\w* matarlo!  
\v 16 \w Lo|strong="H1697"\w* \w que|strong="H3588"\w* has \w hecho|strong="H6213"\w* \w está|strong="H2088"\w* muy mal. Juro \w por|strong="H5921"\w* Yahvé \w que|strong="H3588"\w* todos ustedes merecen \w la|strong="H5921"\w* \w muerte|strong="H4194"\w* \w por|strong="H5921"\w* \w no|strong="H3808"\w* \w haber|strong="H3808"\w* cuidado \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w señor|strong="H3068"\w*, \w el|strong="H5921"\w* \w ungido|strong="H4899"\w* \w de|strong="H5921"\w* Yahvé. ¡\w Mira|strong="H7200"\w* \w ahora|strong="H6258"\w*! ¿\w Dónde|strong="H5921"\w* \w están|strong="H2088"\w* \w la|strong="H5921"\w* \w lanza|strong="H2595"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w la|strong="H5921"\w* jarra \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w que|strong="H3588"\w* tenía \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w cabecera|strong="H4763"\w*?”.   
\p
\v 17 \w Saúl|strong="H7586"\w* reconoció la \w voz|strong="H6963"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w* y preguntó: “¿Eres tú, \w David|strong="H1732"\w*, \w hijo|strong="H1121"\w* mío?”.  
\p \w David|strong="H1732"\w* respondió: “Sí, Majestad, soy yo”.  
\v 18 \w Y|strong="H3068"\w* añadió: “¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w persigue|strong="H7291"\w* usted \w a|strong="H3068"\w* \w este|strong="H2088"\w* servidor suyo? ¿\w Qué|strong="H3588"\w* he \w hecho|strong="H6213"\w* \w de|strong="H3588"\w* \w malo|strong="H7451"\w*? ¿\w De|strong="H3588"\w* \w qué|strong="H3588"\w* delito \w se|strong="H4100"\w* \w me|strong="H3588"\w* acusa?  
\v 19 Le \w ruego|strong="H4994"\w* \w a|strong="H3068"\w* usted, Majestad, \w que|strong="H3588"\w* \w escuche|strong="H8085"\w* \w a|strong="H3068"\w* este servidor suyo. \w Si|strong="H3588"\w* \w es|strong="H3588"\w* Yahvé quien \w lo|strong="H1697"\w* ha incitado \w contra|strong="H6440"\w* \w mí|strong="H4994"\w*, \w que|strong="H3588"\w* \w acepte|strong="H7306"\w* \w él|strong="H3588"\w* una \w ofrenda|strong="H4503"\w*; \w pero|strong="H3588"\w* \w si|strong="H3588"\w* \w son|strong="H3588"\w* \w hombres|strong="H1121"\w* \w los|strong="H1992"\w* \w que|strong="H3588"\w* \w lo|strong="H1697"\w* han hecho, ¡\w que|strong="H3588"\w* Yahvé \w los|strong="H1992"\w* maldiga! \w Ellos|strong="H1992"\w* \w me|strong="H3588"\w* han \w echado|strong="H1644"\w* \w hoy|strong="H3117"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w que|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* dio, \w y|strong="H3588"\w* \w me|strong="H3588"\w* han \w dicho|strong="H1697"\w*: “\w Vete|strong="H3212"\w* \w a|strong="H3068"\w* \w servir|strong="H5647"\w* \w a|strong="H3068"\w* otros dioses”.  
\v 20 \w No|strong="H3588"\w* permita \w que|strong="H3588"\w* \w mi|strong="H1245"\w* \w sangre|strong="H1818"\w* sea derramada lejos \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w presencia|strong="H6440"\w* \w de|strong="H3588"\w* Yahvé. ¡\w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* ha \w salido|strong="H3318"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* una \w pulga|strong="H6550"\w*, \w como|strong="H3588"\w* quien \w persigue|strong="H7291"\w* \w a|strong="H3068"\w* una \w perdiz|strong="H7124"\w* \w por|strong="H3588"\w* \w los|strong="H7291"\w* cerros!”.   
\p
\v 21 \w Entonces|strong="H3117"\w* \w Saúl|strong="H7586"\w* confesó: “He \w pecado|strong="H2398"\w*. Regresa, \w David|strong="H1732"\w*, \w hijo|strong="H1121"\w* mío. \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w volveré|strong="H7725"\w* \w a|strong="H3068"\w* hacerte daño, \w porque|strong="H3588"\w* \w hoy|strong="H3117"\w* has respetado \w mi|strong="H2009"\w* \w vida|strong="H5315"\w*. \w Me|strong="H3588"\w* he portado \w como|strong="H3588"\w* un tonto \w y|strong="H3588"\w* he cometido un grave error”.   
\p
\v 22 \w David|strong="H1732"\w* \w respondió|strong="H6030"\w*: “\w Aquí|strong="H2009"\w* está la \w lanza|strong="H2595"\w*, Majestad. Mande \w a|strong="H3068"\w* uno de sus \w criados|strong="H5288"\w* \w a|strong="H3068"\w* recogerla.  
\v 23 Yahvé recompensará \w a|strong="H3068"\w* \w cada|strong="H3117"\w* uno según su \w justicia|strong="H6666"\w* y su lealtad. \w Hoy|strong="H3117"\w* Yahvé \w lo|strong="H3808"\w* \w puso|strong="H5414"\w* \w a|strong="H3068"\w* usted en \w mis|strong="H5414"\w* \w manos|strong="H3027"\w*, pero yo \w no|strong="H3808"\w* quise levantar mi \w mano|strong="H3027"\w* contra el \w ungido|strong="H4899"\w* \w de|strong="H5414"\w* Yahvé.  
\v 24 \w Así|strong="H3651"\w* \w como|strong="H3651"\w* \w yo|strong="H5315"\w* respeté \w hoy|strong="H3117"\w* \w la|strong="H3605"\w* \w vida|strong="H5315"\w* \w de|strong="H5869"\w* usted, \w que|strong="H3117"\w* Yahvé respete \w la|strong="H3605"\w* mía y me \w libre|strong="H5337"\w* \w de|strong="H5869"\w* \w toda|strong="H3605"\w* \w angustia|strong="H6869"\w*”.   
\p
\v 25 \w Saúl|strong="H7586"\w* le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “¡\w Que|strong="H1571"\w* seas \w bendito|strong="H1288"\w*, \w David|strong="H1732"\w*, \w hijo|strong="H1121"\w* mío! Todo \w lo|strong="H6213"\w* \w que|strong="H1571"\w* emprendas te \w saldrá|strong="H3212"\w* bien”.  
\p \w Entonces|strong="H7725"\w* \w David|strong="H1732"\w* \w siguió|strong="H3212"\w* su \w camino|strong="H1870"\w* \w y|strong="H1571"\w* \w Saúl|strong="H7586"\w* regresó \w a|strong="H3068"\w* su casa.   
\c 27  
\p
\v 1 \w David|strong="H1732"\w* pensó \w para|strong="H3588"\w* \w sí|strong="H3588"\w* \w mismo|strong="H3605"\w*: “Tarde \w o|strong="H3068"\w* temprano \w Saúl|strong="H7586"\w* \w me|strong="H4480"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* matar. \w Lo|strong="H3605"\w* \w mejor|strong="H2896"\w* \w que|strong="H3588"\w* puedo hacer \w es|strong="H3027"\w* escaparme \w al|strong="H4480"\w* territorio \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w*. \w Así|strong="H3588"\w* \w Saúl|strong="H7586"\w* dejará \w de|strong="H4480"\w* buscarme \w por|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* límites \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* podré \w escapar|strong="H4422"\w* \w de|strong="H4480"\w* sus \w manos|strong="H3027"\w*”.  
\v 2 \w Así|strong="H1931"\w* \w que|strong="H1931"\w* \w David|strong="H1732"\w* \w se|strong="H1931"\w* puso \w en|strong="H5973"\w* marcha y, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w sus|strong="H1931"\w* \w seiscientos|strong="H8337"\w* \w hombres|strong="H1121"\w*, \w se|strong="H1931"\w* \w fue|strong="H1931"\w* \w a|strong="H3068"\w* Gat \w para|strong="H5973"\w* servir \w a|strong="H3068"\w* Aquis \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Maoc, \w rey|strong="H4428"\w* \w de|strong="H5973"\w* \w esa|strong="H1931"\w* ciudad.  
\v 3 \w David|strong="H1732"\w* y \w sus|strong="H1931"\w* \w hombres|strong="H8147"\w* \w se|strong="H1931"\w* establecieron \w en|strong="H5973"\w* Gat \w con|strong="H5973"\w* Aquis. Cada uno llevó \w a|strong="H3068"\w* \w su|strong="H1931"\w* \w familia|strong="H1004"\w*, y \w David|strong="H1732"\w* llevó \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w dos|strong="H8147"\w* esposas: Ahinoam, \w la|strong="H1931"\w* \w de|strong="H5973"\w* Jezreel, y Abigail, \w la|strong="H1931"\w* viuda \w de|strong="H5973"\w* \w Nabal|strong="H5037"\w*, \w la|strong="H1931"\w* \w del|strong="H5973"\w* Carmelo.  
\v 4 \w Cuando|strong="H3588"\w* \w Saúl|strong="H7586"\w* supo \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* huido \w a|strong="H3068"\w* Gat, dejó \w de|strong="H3588"\w* perseguirlo.   
\p
\v 5 Un día, \w David|strong="H1732"\w* \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* Aquis: “\w Si|strong="H4994"\w* usted \w me|strong="H5973"\w* tiene aprecio, \w le|strong="H5973"\w* \w ruego|strong="H4994"\w* \w que|strong="H4100"\w* \w me|strong="H5973"\w* \w dé|strong="H5973"\w* un \w lugar|strong="H4725"\w* \w en|strong="H5973"\w* alguno \w de|strong="H5973"\w* \w los|strong="H3427"\w* pueblos \w del|strong="H5973"\w* \w campo|strong="H7704"\w* \w para|strong="H5414"\w* vivir \w allí|strong="H8033"\w*. \w No|strong="H4100"\w* es justo \w que|strong="H4100"\w* este servidor suyo viva \w con|strong="H5973"\w* usted \w en|strong="H5973"\w* la \w ciudad|strong="H5892"\w* \w real|strong="H4467"\w*”.  
\v 6 \w Ese|strong="H1931"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*, Aquis \w le|strong="H1931"\w* \w entregó|strong="H5414"\w* \w la|strong="H1931"\w* ciudad \w de|strong="H5704"\w* Ziclag. \w Por|strong="H2088"\w* \w eso|strong="H3651"\w*, Ziclag ha pertenecido \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w reyes|strong="H4428"\w* \w de|strong="H5704"\w* \w Judá|strong="H3063"\w* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 7 \w David|strong="H1732"\w* \w vivió|strong="H3117"\w* en territorio \w filisteo|strong="H6430"\w* un año y cuatro \w meses|strong="H2320"\w*.   
\p
\v 8 \w David|strong="H1732"\w* \w y|strong="H3588"\w* sus hombres solían salir \w para|strong="H5704"\w* atacar \w a|strong="H3068"\w* \w los|strong="H3427"\w* gesuritas, \w a|strong="H3068"\w* \w los|strong="H3427"\w* girzitas \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* amalecitas, \w que|strong="H3588"\w* eran \w los|strong="H3427"\w* pueblos \w que|strong="H3588"\w* \w habitaban|strong="H3427"\w* esa región \w desde|strong="H5704"\w* hace mucho tiempo, \w en|strong="H5704"\w* \w el|strong="H3588"\w* camino \w que|strong="H3588"\w* \w va|strong="H3068"\w* hacia \w Shur|strong="H7793"\w*, \w hasta|strong="H5704"\w* \w la|strong="H3588"\w* frontera \w con|strong="H3588"\w* \w Egipto|strong="H4714"\w*.  
\v 9 Cuando \w David|strong="H1732"\w* atacaba una región, \w no|strong="H3808"\w* dejaba \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* con \w vida|strong="H2421"\w*, \w ni|strong="H3808"\w* hombre \w ni|strong="H3808"\w* mujer. \w Se|strong="H3808"\w* llevaba las \w ovejas|strong="H6629"\w*, las \w vacas|strong="H1241"\w*, los burros, los \w camellos|strong="H1581"\w* \w y|strong="H1241"\w* la ropa, \w y|strong="H1241"\w* \w luego|strong="H7725"\w* regresaba \w a|strong="H3068"\w* donde estaba Aquis.   
\p
\v 10 \w Cuando|strong="H3117"\w* Aquis \w le|strong="H5921"\w* preguntaba: “¿\w A|strong="H3068"\w* quién atacaron \w hoy|strong="H3117"\w*?”, \w David|strong="H1732"\w* \w le|strong="H5921"\w* respondía: “Atacamos \w el|strong="H5921"\w* sur \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*”, \w o|strong="H3068"\w* “\w el|strong="H5921"\w* sur \w de|strong="H5921"\w* Jerameel”, \w o|strong="H3068"\w* “\w el|strong="H5921"\w* territorio \w de|strong="H5921"\w* \w los|strong="H5921"\w* ceneos”.  
\v 11 \w David|strong="H1732"\w* mataba \w a|strong="H3068"\w* \w todos|strong="H3605"\w*, hombres \w y|strong="H5921"\w* mujeres, \w para|strong="H5921"\w* \w no|strong="H3808"\w* tener \w que|strong="H3808"\w* llevar prisioneros \w a|strong="H3068"\w* Gat, pues pensaba: “\w No|strong="H3808"\w* vaya \w a|strong="H3068"\w* ser \w que|strong="H3808"\w* hablen \w contra|strong="H5921"\w* \w nosotros|strong="H3605"\w* \w y|strong="H5921"\w* digan \w lo|strong="H3808"\w* \w que|strong="H3808"\w* realmente \w estamos|strong="H3427"\w* \w haciendo|strong="H6213"\w*”. \w Así|strong="H3541"\w* \w se|strong="H5921"\w* comportó \w David|strong="H1732"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H3808"\w* \w vivió|strong="H2421"\w* \w en|strong="H5921"\w* territorio \w filisteo|strong="H6430"\w*.   
\p
\v 12 Aquis confiaba plenamente en \w David|strong="H1732"\w* y pensaba: “Él \w se|strong="H1961"\w* ha \w hecho|strong="H1961"\w* odiar tanto \w por|strong="H5769"\w* su \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w que|strong="H5971"\w* ahora \w tendrá|strong="H1961"\w* \w que|strong="H5971"\w* ser \w mi|strong="H1961"\w* servidor \w para|strong="H1961"\w* \w siempre|strong="H5769"\w*”.   
\c 28  
\p
\v 1 \w Por|strong="H3588"\w* aquel \w tiempo|strong="H3117"\w*, \w los|strong="H1992"\w* \w filisteos|strong="H6430"\w* reunieron \w sus|strong="H1992"\w* \w ejércitos|strong="H6635"\w* \w para|strong="H3588"\w* atacar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*. Aquis le dijo \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Ten|strong="H3045"\w* \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* tú \w y|strong="H3588"\w* tus hombres \w saldrán|strong="H3318"\w* conmigo \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w guerra|strong="H3898"\w*”.   
\p
\v 2 \w David|strong="H1732"\w* le respondió \w a|strong="H3068"\w* Aquis: “\w Ahora|strong="H3117"\w* \w sabrá|strong="H3045"\w* usted de \w lo|strong="H6213"\w* \w que|strong="H3045"\w* es capaz este servidor suyo”. Aquis le dijo: “Muy \w bien|strong="H3651"\w*, te nombro mi guardaespaldas personal para \w siempre|strong="H3605"\w*”.   
\p
\v 3 \w Samuel|strong="H8050"\w* ya había \w muerto|strong="H4191"\w*, y \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* había llorado su \w muerte|strong="H4191"\w* y \w lo|strong="H3605"\w* habían \w enterrado|strong="H6912"\w* \w en|strong="H5493"\w* \w Ramá|strong="H7414"\w*, su \w ciudad|strong="H5892"\w*. \w Saúl|strong="H7586"\w*, por su parte, había expulsado del país \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w adivinos|strong="H3049"\w* y \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* invocaban \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w muertos|strong="H4191"\w*.   
\p
\v 4 \w Los|strong="H3605"\w* \w filisteos|strong="H6430"\w* se reunieron y acamparon en \w Sunem|strong="H7766"\w*. \w Saúl|strong="H7586"\w* también reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* y acamparon en Gilboa.  
\v 5 Cuando \w Saúl|strong="H7586"\w* \w vio|strong="H7200"\w* \w el|strong="H4264"\w* \w ejército|strong="H4264"\w* \w filisteo|strong="H6430"\w*, \w tuvo|strong="H3372"\w* \w mucho|strong="H3966"\w* \w miedo|strong="H3372"\w* y se aterrorizó.  
\v 6 \w Consultó|strong="H7592"\w* \w a|strong="H3068"\w* Yahvé, pero Yahvé \w no|strong="H3808"\w* le \w respondió|strong="H6030"\w* \w ni|strong="H3808"\w* por \w sueños|strong="H2472"\w*, \w ni|strong="H3808"\w* por \w el|strong="H5030"\w* Urim, \w ni|strong="H3808"\w* por medio de los \w profetas|strong="H5030"\w*.  
\v 7 Entonces \w Saúl|strong="H7586"\w* les ordenó \w a|strong="H3068"\w* sus servidores: “Búsquenme \w a|strong="H3068"\w* una mujer que invoque \w a|strong="H3068"\w* los muertos, para que \w yo|strong="H2009"\w* \w vaya|strong="H3212"\w* \w a|strong="H3068"\w* consultarla”.  
\p Sus servidores le respondieron: “Hay una mujer \w en|strong="H3212"\w* Endor que invoca \w a|strong="H3068"\w* los muertos”.   
\p
\v 8 \w Saúl|strong="H7586"\w* \w se|strong="H1931"\w* disfrazó \w con|strong="H5973"\w* otra ropa y, acompañado \w de|strong="H5973"\w* \w dos|strong="H8147"\w* \w hombres|strong="H8147"\w*, \w fue|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w de|strong="H5973"\w* \w noche|strong="H3915"\w*. \w Le|strong="H1931"\w* dijo: “\w Te|strong="H5973"\w* ruego \w que|strong="H1931"\w* invoques \w a|strong="H3068"\w* un espíritu por mí, y \w que|strong="H1931"\w* \w me|strong="H5973"\w* hagas aparecer \w a|strong="H3068"\w* \w quien|strong="H1931"\w* yo \w te|strong="H5973"\w* nombre”.   
\p
\v 9 Pero la mujer le contestó: “\w Tú|strong="H6213"\w* \w sabes|strong="H3045"\w* bien \w lo|strong="H4100"\w* \w que|strong="H4100"\w* ha \w hecho|strong="H6213"\w* \w Saúl|strong="H7586"\w*; \w él|strong="H6213"\w* ha exterminado \w de|strong="H4480"\w* este país \w a|strong="H3068"\w* los \w adivinos|strong="H3049"\w* y \w a|strong="H3068"\w* los \w que|strong="H4100"\w* invocan \w a|strong="H3068"\w* los \w muertos|strong="H4191"\w*. ¿\w Por|strong="H4480"\w* \w qué|strong="H4100"\w* \w me|strong="H4480"\w* tiendes una trampa \w para|strong="H4480"\w* matarme?”.   
\p
\v 10 \w Saúl|strong="H7586"\w* le \w juró|strong="H7650"\w* \w por|strong="H1697"\w* Yahvé: “Te \w juro|strong="H7650"\w* \w por|strong="H1697"\w* Yahvé \w que|strong="H1697"\w* no te pasará \w nada|strong="H1697"\w* \w malo|strong="H5771"\w* \w por|strong="H1697"\w* \w esto|strong="H2088"\w*”.   
\p
\v 11 Entonces la mujer preguntó: “¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* quieres \w que|strong="H4310"\w* haga aparecer?”. \w Y|strong="H3068"\w* \w él|strong="H4310"\w* respondió: “Haz \w que|strong="H4310"\w* aparezca \w Samuel|strong="H8050"\w*”.   
\p
\v 12 En \w cuanto|strong="H4100"\w* la mujer \w vio|strong="H7200"\w* \w a|strong="H3068"\w* \w Samuel|strong="H8050"\w*, lanzó un \w grito|strong="H2199"\w* y le reclamó \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* me has \w engañado|strong="H7411"\w*? ¡Tú eres \w Saúl|strong="H7586"\w*!”.   
\p
\v 13 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* le dijo: “\w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*. ¿\w Qué|strong="H3588"\w* \w es|strong="H3588"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w ves|strong="H7200"\w*?”. \w La|strong="H3588"\w* mujer respondió: “\w Veo|strong="H7200"\w* un ser divino \w que|strong="H3588"\w* \w sube|strong="H5927"\w* \w de|strong="H4480"\w* \w la|strong="H3588"\w* tierra”.   
\p
\v 14 “¿\w Qué|strong="H3588"\w* aspecto \w tiene|strong="H1931"\w*?”, preguntó \w Saúl|strong="H7586"\w*. \w Ella|strong="H1931"\w* respondió: “\w Es|strong="H1931"\w* un \w anciano|strong="H2205"\w* \w que|strong="H3588"\w* \w viene|strong="H5927"\w* envuelto \w en|strong="H3588"\w* una túnica”. \w Saúl|strong="H7586"\w* comprendió \w que|strong="H3588"\w* \w era|strong="H1931"\w* \w Samuel|strong="H8050"\w* \w y|strong="H3588"\w*, postrándose rostro \w en|strong="H3588"\w* tierra, \w le|strong="H1931"\w* mostró mucho respeto.   
\p
\v 15 \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*: “¿\w Para|strong="H5921"\w* \w qué|strong="H4100"\w* \w me|strong="H5921"\w* molestas haciéndome aparecer?”. \w Saúl|strong="H7586"\w* \w respondió|strong="H6030"\w*: “Estoy \w muy|strong="H3966"\w* angustiado. \w Los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w me|strong="H5921"\w* están atacando \w y|strong="H1571"\w* Dios \w se|strong="H3045"\w* \w ha|strong="H3808"\w* apartado \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w lado|strong="H3027"\w*. \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w me|strong="H5921"\w* \w responde|strong="H6030"\w* \w ni|strong="H3808"\w* \w por|strong="H5921"\w* \w profetas|strong="H5030"\w* \w ni|strong="H3808"\w* \w por|strong="H5921"\w* \w sueños|strong="H2472"\w*. \w Por|strong="H5921"\w* eso \w te|strong="H5921"\w* \w llamé|strong="H7121"\w*, \w para|strong="H5921"\w* \w que|strong="H4100"\w* \w me|strong="H5921"\w* digas \w qué|strong="H4100"\w* debo \w hacer|strong="H6213"\w*”.   
\p
\v 16 \w Samuel|strong="H8050"\w* \w le|strong="H5921"\w* dijo: “¿\w Para|strong="H5921"\w* \w qué|strong="H4100"\w* \w me|strong="H5921"\w* consultas \w a|strong="H3068"\w* \w mí|strong="H5921"\w*, \w si|strong="H1961"\w* Yahvé \w se|strong="H1961"\w* ha apartado \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* ha vuelto tu enemigo?  
\v 17 Yahvé ha \w cumplido|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3027"\w* anunció \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H5414"\w* mí: ha arrancado \w el|strong="H6213"\w* \w reino|strong="H4467"\w* \w de|strong="H5414"\w* tus \w manos|strong="H3027"\w* y se \w lo|strong="H6213"\w* ha \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w tu|strong="H6213"\w* \w prójimo|strong="H7453"\w*.  
\v 18 \w Como|strong="H5921"\w* \w no|strong="H3808"\w* \w obedeciste|strong="H8085"\w* \w a|strong="H3068"\w* Yahvé \w ni|strong="H3808"\w* castigaste \w con|strong="H5921"\w* \w furor|strong="H2740"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* amalecitas, \w hoy|strong="H3117"\w* \w él|strong="H5921"\w* \w te|strong="H5921"\w* trata \w de|strong="H5921"\w* \w esta|strong="H2088"\w* \w manera|strong="H1697"\w*.  
\v 19 \w Además|strong="H1571"\w*, Yahvé \w entregará|strong="H5414"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w y|strong="H1571"\w* \w a|strong="H3068"\w* \w ti|strong="H5973"\w* \w en|strong="H5973"\w* \w manos|strong="H3027"\w* \w de|strong="H5973"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*. \w Mañana|strong="H4279"\w*, tú \w y|strong="H1571"\w* tus \w hijos|strong="H1121"\w* estarán \w conmigo|strong="H5973"\w*, \w y|strong="H1571"\w* Yahvé \w entregará|strong="H5414"\w* \w el|strong="H5973"\w* \w ejército|strong="H4264"\w* \w de|strong="H5973"\w* \w Israel|strong="H3478"\w* \w en|strong="H5973"\w* \w manos|strong="H3027"\w* \w de|strong="H5973"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*”.   
\p
\v 20 Al oír las \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* \w Samuel|strong="H8050"\w*, \w Saúl|strong="H7586"\w* \w se|strong="H1961"\w* desplomó \w en|strong="H3588"\w* \w el|strong="H3588"\w* suelo, \w lleno|strong="H4393"\w* \w de|strong="H3588"\w* terror. \w Estaba|strong="H1961"\w* \w sin|strong="H3808"\w* \w fuerzas|strong="H3581"\w*, \w pues|strong="H3588"\w* \w no|strong="H3808"\w* \w había|strong="H1961"\w* comido \w nada|strong="H3808"\w* \w en|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w ni|strong="H3808"\w* \w en|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H1571"\w* \w noche|strong="H3915"\w*.   
\p
\v 21 \w La|strong="H3588"\w* mujer se acercó \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* \w y|strong="H3588"\w*, al verlo \w tan|strong="H3966"\w* aterrorizado, le \w dijo|strong="H1696"\w*: “\w Mire|strong="H7200"\w*, esta servidora suya le hizo caso. Arriesgué \w mi|strong="H2009"\w* \w vida|strong="H5315"\w* \w y|strong="H3588"\w* obedecí sus órdenes.  
\v 22 \w Ahora|strong="H6258"\w* le \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* usted \w también|strong="H1571"\w* \w escuche|strong="H8085"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* servidora. Permítame traerle un poco \w de|strong="H3588"\w* \w pan|strong="H3899"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* coma \w y|strong="H1571"\w* recupere sus \w fuerzas|strong="H3581"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* seguir \w su|strong="H3588"\w* \w camino|strong="H1870"\w*”.   
\p
\v 23 Saúl \w se|strong="H3808"\w* negó \w y|strong="H1571"\w* dijo: “\w No|strong="H3808"\w* voy \w a|strong="H3068"\w* comer”. Pero sus servidores \w y|strong="H1571"\w* \w la|strong="H1571"\w* mujer insistieron tanto \w que|strong="H3808"\w* al fin les hizo caso. \w Se|strong="H3808"\w* \w levantó|strong="H6965"\w* del suelo \w y|strong="H1571"\w* \w se|strong="H3808"\w* sentó en \w la|strong="H1571"\w* \w cama|strong="H4296"\w*.  
\v 24 La mujer tenía en su \w casa|strong="H1004"\w* un ternero engordado y lo \w mató|strong="H2076"\w* en seguida. \w Tomó|strong="H3947"\w* \w harina|strong="H7058"\w*, la amasó y horneó panes sin levadura.  
\v 25 \w Se|strong="H1931"\w* \w los|strong="H1931"\w* sirvió \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* \w sus|strong="H1931"\w* servidores, y \w ellos|strong="H1931"\w* comieron. \w Luego|strong="H1931"\w* \w se|strong="H1931"\w* \w levantaron|strong="H6965"\w* y \w se|strong="H1931"\w* \w fueron|strong="H3212"\w* \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w*.   
\c 29  
\p
\v 1 \w Los|strong="H3605"\w* \w filisteos|strong="H6430"\w* reunieron \w a|strong="H3068"\w* \w todo|strong="H3605"\w* su \w ejército|strong="H4264"\w* en Afec, \w mientras|strong="H3605"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* israelitas acamparon \w junto|strong="H6908"\w* al manantial \w que|strong="H3605"\w* está en \w Jezreel|strong="H3157"\w*.  
\v 2 Mientras \w los|strong="H5973"\w* jefes \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w* desfilaban \w con|strong="H5973"\w* sus grupos \w de|strong="H5973"\w* \w cien|strong="H3967"\w* y \w de|strong="H5973"\w* \w mil|strong="H3967"\w* soldados, \w David|strong="H1732"\w* y sus hombres marchaban \w en|strong="H5973"\w* la retaguardia \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* rey Aquis.   
\p
\v 3 \w Entonces|strong="H3117"\w* \w los|strong="H1961"\w* comandantes \w filisteos|strong="H6430"\w* preguntaron: “¿\w Qué|strong="H4100"\w* hacen \w aquí|strong="H2088"\w* \w estos|strong="H2088"\w* \w hebreos|strong="H5680"\w*?”. Aquis \w les|strong="H3972"\w* respondió: “\w Este|strong="H2088"\w* \w es|strong="H1961"\w* \w David|strong="H1732"\w*, \w que|strong="H4100"\w* \w fue|strong="H1961"\w* servidor \w de|strong="H5704"\w* \w Saúl|strong="H7586"\w*, \w el|strong="H5307"\w* \w rey|strong="H4428"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*. \w Ha|strong="H3808"\w* \w estado|strong="H1961"\w* conmigo mucho \w tiempo|strong="H3117"\w*, incluso \w años|strong="H8141"\w*, \w y|strong="H5704"\w* \w desde|strong="H5704"\w* \w el|strong="H5307"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H4100"\w* \w se|strong="H1961"\w* unió \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w no|strong="H3808"\w* he encontrado \w nada|strong="H3808"\w* malo \w en|strong="H5704"\w* \w él|strong="H5307"\w*”.   
\p
\v 4 Pero \w los|strong="H1992"\w* \w jefes|strong="H8269"\w* \w filisteos|strong="H6430"\w* \w se|strong="H1961"\w* enojaron \w con|strong="H5973"\w* Aquis \w y|strong="H5921"\w* \w le|strong="H5921"\w* exigieron: “Manda \w a|strong="H3068"\w* \w ese|strong="H2088"\w* hombre \w de|strong="H5921"\w* regreso \w al|strong="H5921"\w* \w lugar|strong="H4725"\w* \w que|strong="H4100"\w* \w le|strong="H5921"\w* diste. \w Que|strong="H4100"\w* \w no|strong="H3808"\w* vaya \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w*, \w no|strong="H3808"\w* \w sea|strong="H1961"\w* \w que|strong="H4100"\w* \w en|strong="H5921"\w* pleno combate \w se|strong="H1961"\w* \w vuelva|strong="H7725"\w* \w contra|strong="H5921"\w* \w nosotros|strong="H5973"\w*. ¿\w Qué|strong="H4100"\w* mejor manera tendría \w él|strong="H5921"\w* \w de|strong="H5921"\w* reconciliarse \w con|strong="H5973"\w* \w su|strong="H1992"\w* antiguo amo \w que|strong="H4100"\w* entregándole \w las|strong="H1992"\w* \w cabezas|strong="H7218"\w* \w de|strong="H5921"\w* nuestros soldados?  
\v 5 ¿Acaso \w no|strong="H3808"\w* \w es|strong="H2088"\w* \w este|strong="H2088"\w* el mismo \w David|strong="H1732"\w* de quien cantaban \w en|strong="H5221"\w* las danzas:  
\q1 “\w Saúl|strong="H7586"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* miles,  
\q2 ¡pero \w David|strong="H1732"\w* \w a|strong="H3068"\w* diez miles!”?”.   
\p
\v 6 \w Entonces|strong="H3117"\w* Aquis \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w le|strong="H5869"\w* dijo: “\w Te|strong="H5869"\w* juro \w por|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* tú has sido un hombre íntegro. \w Me|strong="H3588"\w* \w ha|strong="H3808"\w* gustado mucho \w cómo|strong="H3588"\w* \w te|strong="H5869"\w* has portado conmigo \w en|strong="H5704"\w* \w el|strong="H3588"\w* \w ejército|strong="H4264"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* he visto \w nada|strong="H3808"\w* \w malo|strong="H7451"\w* \w en|strong="H5704"\w* ti \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3588"\w* llegaste \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*. \w Pero|strong="H3588"\w* \w los|strong="H3588"\w* otros jefes \w no|strong="H3808"\w* confían \w en|strong="H5704"\w* ti.  
\v 7 Por eso, regresa \w ahora|strong="H6258"\w* y \w vete|strong="H3212"\w* \w en|strong="H3212"\w* \w paz|strong="H7965"\w*; \w no|strong="H3808"\w* \w hagas|strong="H6213"\w* \w nada|strong="H3808"\w* \w que|strong="H3808"\w* moleste \w a|strong="H3068"\w* los jefes \w de|strong="H5869"\w* los \w filisteos|strong="H6430"\w*”.   
\p
\v 8 \w David|strong="H1732"\w* le preguntó \w a|strong="H3068"\w* Aquis: “¿\w Pero|strong="H3588"\w* \w qué|strong="H3588"\w* \w es|strong="H1961"\w* \w lo|strong="H4100"\w* \w que|strong="H3588"\w* he \w hecho|strong="H6213"\w*? ¿\w Qué|strong="H3588"\w* \w ha|strong="H3808"\w* encontrado usted \w de|strong="H3588"\w* malo \w en|strong="H5704"\w* \w este|strong="H2088"\w* servidor suyo \w desde|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3588"\w* \w entré|strong="H3808"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w servicio|strong="H5650"\w*, \w para|strong="H5704"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* deje ir \w a|strong="H3068"\w* pelear \w contra|strong="H6440"\w* \w los|strong="H1961"\w* enemigos \w de|strong="H3588"\w* \w mi|strong="H1961"\w* señor \w el|strong="H3588"\w* \w rey|strong="H4428"\w*?”.  
\v 9 Aquis \w le|strong="H5973"\w* \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w para|strong="H3588"\w* \w mí|strong="H6030"\w* eres tan fiel \w como|strong="H3588"\w* un \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* Dios. \w Pero|strong="H3588"\w* \w los|strong="H5973"\w* \w jefes|strong="H8269"\w* \w de|strong="H3588"\w* \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w* han decidido \w que|strong="H3588"\w* \w no|strong="H3808"\w* vayas \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w batalla|strong="H4421"\w*.  
\v 10 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w levántate|strong="H7925"\w* temprano \w mañana|strong="H1242"\w*, junto con los servidores de tu señor \w que|strong="H6258"\w* vinieron contigo, y \w en|strong="H3212"\w* cuanto raye el alba, váyanse de aquí”.   
\p
\v 11 \w David|strong="H1732"\w* y \w sus|strong="H1931"\w* hombres \w se|strong="H1931"\w* levantaron muy temprano para regresar al territorio de \w los|strong="H1931"\w* \w filisteos|strong="H6430"\w*, mientras \w que|strong="H1931"\w* \w el|strong="H1931"\w* ejército \w filisteo|strong="H6430"\w* \w se|strong="H1931"\w* dirigió hacia \w Jezreel|strong="H3157"\w*.   
\c 30  
\p
\v 1 Tres \w días|strong="H3117"\w* \w después|strong="H1961"\w*, \w cuando|strong="H3117"\w* \w David|strong="H1732"\w* y sus hombres llegaron \w a|strong="H3068"\w* Ziclag, \w se|strong="H1961"\w* encontraron con \w que|strong="H3117"\w* \w los|strong="H1961"\w* amalecitas \w habían|strong="H1961"\w* invadido el sur y atacado \w a|strong="H3068"\w* Ziclag. \w Habían|strong="H1961"\w* destruido la ciudad y le \w habían|strong="H1961"\w* prendido fuego.  
\v 2 \w Se|strong="H3808"\w* habían llevado cautivas \w a|strong="H3068"\w* las \w mujeres|strong="H5704"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* todos los \w que|strong="H3808"\w* estaban allí, \w desde|strong="H5704"\w* los \w más|strong="H4191"\w* chicos \w hasta|strong="H5704"\w* los \w más|strong="H4191"\w* \w grandes|strong="H1419"\w*. \w No|strong="H3808"\w* \w mataron|strong="H4191"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*, pero \w se|strong="H3808"\w* los llevaron \w a|strong="H3068"\w* todos \w cuando|strong="H5704"\w* \w se|strong="H3808"\w* retiraron.  
\v 3 Cuando \w David|strong="H1732"\w* y sus \w hombres|strong="H1121"\w* entraron en la \w ciudad|strong="H5892"\w*, vieron \w que|strong="H1121"\w* \w estaba|strong="H2009"\w* \w quemada|strong="H8313"\w* y \w que|strong="H1121"\w* sus esposas, \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w* habían sido llevados cautivos.  
\v 4 Entonces \w David|strong="H1732"\w* \w y|strong="H5704"\w* los \w que|strong="H5704"\w* \w estaban|strong="H5971"\w* \w con|strong="H5704"\w* él \w lloraron|strong="H1058"\w* \w a|strong="H3068"\w* gritos \w hasta|strong="H5704"\w* quedarse sin \w fuerzas|strong="H3581"\w*.  
\v 5 También se habían llevado \w a|strong="H3068"\w* las \w dos|strong="H8147"\w* esposas de \w David|strong="H1732"\w*: Ahinoam, la de Jezreel, y Abigail, la viuda de \w Nabal|strong="H5037"\w*, la del Carmelo.  
\v 6 \w David|strong="H1732"\w* \w se|strong="H5921"\w* sintió \w muy|strong="H3966"\w* \w angustiado|strong="H3334"\w* \w porque|strong="H3588"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* hablaban \w de|strong="H5921"\w* apedrearlo. \w Todos|strong="H3605"\w* \w estaban|strong="H5971"\w* \w muy|strong="H3966"\w* amargados \w por|strong="H5921"\w* \w la|strong="H5921"\w* pérdida \w de|strong="H5921"\w* sus \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*, \w pero|strong="H3588"\w* \w David|strong="H1732"\w* cobró ánimos fortaleciéndose \w en|strong="H5921"\w* Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*.  
\v 7 Entonces \w David|strong="H1732"\w* le dijo al \w sacerdote|strong="H3548"\w* Abiatar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ajimelec: “Por favor, \w tráeme|strong="H5066"\w* \w el|strong="H1121"\w* efod”. \w Y|strong="H3068"\w* Abiatar se lo llevó.   
\p
\v 8 \w David|strong="H1732"\w* \w consultó|strong="H7592"\w* \w a|strong="H3068"\w* Yahvé: “¿Debo perseguir \w a|strong="H3068"\w* esa banda \w de|strong="H3588"\w* ladrones? ¿\w Los|strong="H7291"\w* podré alcanzar?”. Yahvé le respondió: “\w Persíguelos|strong="H7291"\w*, \w porque|strong="H3588"\w* vas \w a|strong="H3068"\w* alcanzarlos \w y|strong="H3588"\w* rescatarás \w a|strong="H3068"\w* todos”.   
\p
\v 9 \w David|strong="H1732"\w* \w salió|strong="H3212"\w* \w con|strong="H5704"\w* \w sus|strong="H1931"\w* \w seiscientos|strong="H8337"\w* hombres \w y|strong="H5704"\w* llegaron \w al|strong="H5704"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5704"\w* Besor, \w donde|strong="H1931"\w* \w se|strong="H1931"\w* \w quedaron|strong="H3498"\w* \w algunos|strong="H3498"\w* \w de|strong="H5704"\w* \w ellos|strong="H1931"\w*.  
\v 10 \w David|strong="H1732"\w* continuó \w la|strong="H1931"\w* persecución con cuatrocientos hombres; \w los|strong="H7291"\w* otros \w doscientos|strong="H3967"\w* \w estaban|strong="H5975"\w* \w tan|strong="H1931"\w* agotados \w que|strong="H1931"\w* no pudieron cruzar \w el|strong="H1931"\w* \w arroyo|strong="H5158"\w* de Besor.  
\v 11 En el \w campo|strong="H7704"\w* encontraron \w a|strong="H3068"\w* un \w egipcio|strong="H4713"\w* y lo \w llevaron|strong="H3947"\w* ante \w David|strong="H1732"\w*. Le \w dieron|strong="H5414"\w* \w pan|strong="H3899"\w* y \w agua|strong="H4325"\w*,  
\v 12 \w y|strong="H3588"\w* también un pedazo \w de|strong="H3588"\w* torta \w de|strong="H3588"\w* higos \w y|strong="H3588"\w* \w dos|strong="H8147"\w* racimos \w de|strong="H3588"\w* pasas. Después \w de|strong="H3588"\w* comer, \w el|strong="H3588"\w* hombre \w recuperó|strong="H7725"\w* sus fuerzas, \w pues|strong="H3588"\w* \w no|strong="H3808"\w* \w había|strong="H3588"\w* comido \w ni|strong="H3808"\w* \w bebido|strong="H8354"\w* \w nada|strong="H3808"\w* \w en|strong="H3588"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w y|strong="H3588"\w* \w tres|strong="H7969"\w* \w noches|strong="H3915"\w*.  
\v 13 \w David|strong="H1732"\w* \w le|strong="H4310"\w* preguntó: “¿\w De|strong="H3588"\w* \w quién|strong="H4310"\w* eres esclavo \w y|strong="H3588"\w* \w de|strong="H3588"\w* dónde vienes?”. \w Él|strong="H3588"\w* respondió: “Soy \w egipcio|strong="H4713"\w*, esclavo \w de|strong="H3588"\w* un amalecita. Mi amo \w me|strong="H3588"\w* abandonó hace \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w porque|strong="H3588"\w* \w me|strong="H3588"\w* enfermé.  
\v 14 \w Nosotros|strong="H5921"\w* atacamos \w el|strong="H5921"\w* sur \w de|strong="H5921"\w* \w los|strong="H5921"\w* queretanos, \w el|strong="H5921"\w* territorio \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* sur \w de|strong="H5921"\w* \w Caleb|strong="H3612"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* prendimos fuego \w a|strong="H3068"\w* Ziclag”.   
\p
\v 15 \w David|strong="H1732"\w* le preguntó: “¿Podrías llevarme \w a|strong="H3068"\w* donde \w está|strong="H2088"\w* esa banda de ladrones?”. Él contestó: “\w Júreme|strong="H7650"\w* usted \w por|strong="H2088"\w* Dios \w que|strong="H2088"\w* no me \w matará|strong="H4191"\w* ni me entregará \w a|strong="H3068"\w* mi amo, y yo \w lo|strong="H2088"\w* llevaré \w hasta|strong="H2088"\w* \w ellos|strong="H3027"\w*”.   
\p
\v 16 \w El|strong="H5921"\w* egipcio guio \w a|strong="H3068"\w* David, \w y|strong="H5921"\w* encontraron \w a|strong="H3068"\w* \w los|strong="H5921"\w* amalecitas desparramados \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* campo. Estaban comiendo, \w bebiendo|strong="H8354"\w* \w y|strong="H5921"\w* bailando, celebrando \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w gran|strong="H1419"\w* botín \w que|strong="H5921"\w* habían robado \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.  
\v 17 \w David|strong="H1732"\w* \w los|strong="H1992"\w* atacó \w al|strong="H5921"\w* amanecer \w y|strong="H3588"\w* peleó \w contra|strong="H5921"\w* \w ellos|strong="H1992"\w* \w hasta|strong="H5704"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w* \w del|strong="H5921"\w* día \w siguiente|strong="H4283"\w*. \w No|strong="H3808"\w* \w escapó|strong="H4422"\w* \w ninguno|strong="H3808"\w*, excepto cuatrocientos jóvenes \w que|strong="H3588"\w* montaron \w en|strong="H5921"\w* \w camellos|strong="H1581"\w* \w y|strong="H3588"\w* \w huyeron|strong="H5127"\w*.  
\v 18 \w David|strong="H1732"\w* recuperó \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* amalecitas se habían llevado, y también rescató \w a|strong="H3068"\w* sus \w dos|strong="H8147"\w* esposas.  
\v 19 \w No|strong="H3808"\w* \w faltó|strong="H5737"\w* \w nada|strong="H3808"\w*, \w desde|strong="H4480"\w* \w lo|strong="H3808"\w* \w más|strong="H4480"\w* \w pequeño|strong="H6996"\w* \w hasta|strong="H5704"\w* \w lo|strong="H3808"\w* \w más|strong="H4480"\w* \w grande|strong="H1419"\w*; rescataron \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w* \w y|strong="H5704"\w* recuperaron \w todo|strong="H3605"\w* \w el|strong="H3605"\w* botín. \w David|strong="H1732"\w* \w lo|strong="H3808"\w* recobró \w todo|strong="H3605"\w*.  
\v 20 \w También|strong="H2088"\w* capturó \w todas|strong="H3605"\w* las \w ovejas|strong="H6629"\w* \w y|strong="H1241"\w* las \w vacas|strong="H1241"\w*. \w Sus|strong="H1931"\w* hombres las arreaban \w delante|strong="H6440"\w* del \w otro|strong="H2088"\w* \w ganado|strong="H4735"\w* \w y|strong="H1241"\w* decían: “¡\w Este|strong="H2088"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* botín \w de|strong="H6440"\w* \w David|strong="H1732"\w*!”.   
\p
\v 21 Cuando \w David|strong="H1732"\w* regresó \w a|strong="H3068"\w* donde \w estaban|strong="H3427"\w* \w los|strong="H3427"\w* \w doscientos|strong="H3967"\w* hombres \w que|strong="H5971"\w* \w se|strong="H5971"\w* habían quedado \w en|strong="H3318"\w* \w el|strong="H3427"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5971"\w* Besor por estar demasiado \w cansados|strong="H6296"\w* \w para|strong="H5971"\w* seguirlo, ellos \w salieron|strong="H3318"\w* \w a|strong="H3068"\w* recibirlo \w a|strong="H3068"\w* \w él|strong="H3427"\w* y \w a|strong="H3068"\w* su \w gente|strong="H5971"\w*. \w David|strong="H1732"\w* \w se|strong="H5971"\w* \w acercó|strong="H5066"\w* \w a|strong="H3068"\w* ellos y \w los|strong="H3427"\w* saludó cordialmente.  
\v 22 \w Pero|strong="H3588"\w* \w entre|strong="H5973"\w* \w los|strong="H1121"\w* \w que|strong="H3588"\w* habían acompañado \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* algunos \w hombres|strong="H1121"\w* \w malos|strong="H7451"\w* \w y|strong="H3588"\w* canallas \w que|strong="H3588"\w* dijeron: “\w Como|strong="H3588"\w* \w ellos|strong="H3605"\w* \w no|strong="H3808"\w* \w fueron|strong="H3212"\w* \w con|strong="H5973"\w* \w nosotros|strong="H3605"\w*, \w no|strong="H3808"\w* \w les|strong="H5973"\w* \w daremos|strong="H5414"\w* \w nada|strong="H3808"\w* \w de|strong="H3588"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* recuperamos. \w Que|strong="H3588"\w* \w cada|strong="H3605"\w* uno tome \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposa \w e|strong="H3068"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w se|strong="H3808"\w* \w vaya|strong="H3212"\w*”.   
\p
\v 23 Pero \w David|strong="H1732"\w* \w les|strong="H5921"\w* dijo: “\w No|strong="H3808"\w* \w hagan|strong="H6213"\w* \w eso|strong="H3651"\w*, hermanos míos, \w con|strong="H5921"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* Yahvé \w nos|strong="H5921"\w* \w ha|strong="H3808"\w* \w dado|strong="H5414"\w*. \w Él|strong="H5921"\w* \w nos|strong="H5921"\w* protegió \w y|strong="H5921"\w* \w entregó|strong="H5414"\w* \w en|strong="H5921"\w* nuestras \w manos|strong="H3027"\w* \w a|strong="H3068"\w* \w esa|strong="H3651"\w* banda \w que|strong="H3808"\w* \w nos|strong="H5921"\w* atacó.  
\v 24 ¿\w Quién|strong="H4310"\w* \w les|strong="H5921"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* hacer caso \w en|strong="H5921"\w* \w esto|strong="H2088"\w*? \w La|strong="H5921"\w* \w parte|strong="H2506"\w* \w del|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* queda cuidando \w el|strong="H5921"\w* equipaje debe ser \w igual|strong="H2505"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w del|strong="H5921"\w* \w que|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w*; \w todos|strong="H3162"\w* deben recibir \w lo|strong="H1697"\w* mismo”.  
\v 25 \w Desde|strong="H5704"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* David estableció \w esto|strong="H2088"\w* \w como|strong="H1961"\w* una norma \w y|strong="H5704"\w* una \w ley|strong="H2706"\w* \w en|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w la|strong="H1931"\w* \w cual|strong="H1931"\w* \w se|strong="H1961"\w* cumple \w hasta|strong="H5704"\w* \w hoy|strong="H3117"\w*.   
\p
\v 26 Cuando \w David|strong="H1732"\w* llegó \w a|strong="H3068"\w* Ziclag, \w envió|strong="H7971"\w* parte del botín \w a|strong="H3068"\w* sus \w amigos|strong="H7453"\w*, los \w ancianos|strong="H2205"\w* de \w Judá|strong="H3063"\w*, con este mensaje: “\w Aquí|strong="H2009"\w* tienen un regalo para ustedes, de lo que les quitamos \w a|strong="H3068"\w* los enemigos de Yahvé”.  
\v 27 Envió regalos \w a|strong="H3068"\w* los de Betel, Ramot del Sur, Jatir,  
\v 28 \w Aroer|strong="H6177"\w*, Sifmot, Estemoa,  
\v 29 Racal, \w a|strong="H3068"\w* los de las \w ciudades|strong="H5892"\w* de Jerameel y de los ceneos,  
\v 30 \w a|strong="H3068"\w* los de \w Horma|strong="H2767"\w*, Borasán, Atac,  
\v 31 \w Hebrón|strong="H2275"\w* y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* por \w donde|strong="H8033"\w* \w David|strong="H1732"\w* y \w sus|strong="H1931"\w* hombres habían \w andado|strong="H1980"\w*.   
\c 31  
\p
\v 1 Los \w filisteos|strong="H6430"\w* \w pelearon|strong="H3898"\w* \w contra|strong="H6440"\w* \w Israel|strong="H3478"\w*, y los israelitas \w huyeron|strong="H5127"\w* \w ante|strong="H6440"\w* ellos y \w cayeron|strong="H5307"\w* \w muertos|strong="H2491"\w* en \w el|strong="H5307"\w* \w monte|strong="H2022"\w* Gilboa.  
\v 2 \w Los|strong="H1121"\w* \w filisteos|strong="H6430"\w* alcanzaron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, y \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* Jonatán, \w a|strong="H3068"\w* Abinadab y \w a|strong="H3068"\w* Malquisúa, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*.  
\v 3 La \w batalla|strong="H4421"\w* se volvió \w muy|strong="H3966"\w* dura contra \w Saúl|strong="H7586"\w*; los arqueros lo alcanzaron y lo hirieron de gravedad.  
\v 4 \w Entonces|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* ayudante \w de|strong="H5921"\w* \w armas|strong="H3627"\w*: “\w Saca|strong="H8025"\w* tu \w espada|strong="H2719"\w* \w y|strong="H3588"\w* atraviésame \w con|strong="H5921"\w* \w ella|strong="H5921"\w*, \w no|strong="H3808"\w* \w sea|strong="H6435"\w* \w que|strong="H3588"\w* vengan estos paganos \w y|strong="H3588"\w* \w se|strong="H5921"\w* burlen \w de|strong="H5921"\w* \w mí|strong="H5921"\w*”. \w Pero|strong="H3588"\w* \w su|strong="H3588"\w* ayudante \w tuvo|strong="H3372"\w* \w mucho|strong="H3966"\w* \w miedo|strong="H3372"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* quiso hacerlo. \w Entonces|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w tomó|strong="H3947"\w* \w su|strong="H3588"\w* propia \w espada|strong="H2719"\w* \w y|strong="H3588"\w* \w se|strong="H5921"\w* dejó \w caer|strong="H5307"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 5 \w Cuando|strong="H3588"\w* \w el|strong="H1931"\w* ayudante \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w había|strong="H3588"\w* \w muerto|strong="H4191"\w*, \w él|strong="H1931"\w* \w también|strong="H1571"\w* \w se|strong="H1931"\w* \w echó|strong="H5307"\w* \w sobre|strong="H5921"\w* \w su|strong="H1931"\w* \w espada|strong="H2719"\w* \w y|strong="H1571"\w* \w murió|strong="H4191"\w* \w con|strong="H5973"\w* \w él|strong="H1931"\w*.  
\v 6 \w Así|strong="H1571"\w* \w murieron|strong="H4191"\w* \w Saúl|strong="H7586"\w*, \w sus|strong="H1931"\w* \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w*, \w su|strong="H1931"\w* ayudante \w de|strong="H1121"\w* \w armas|strong="H3627"\w* \w y|strong="H1571"\w* \w todos|strong="H3605"\w* \w sus|strong="H1931"\w* \w hombres|strong="H1121"\w* en \w un|strong="H3162"\w* \w mismo|strong="H1931"\w* \w día|strong="H3117"\w*.   
\p
\v 7 \w Cuando|strong="H3588"\w* \w los|strong="H3427"\w* israelitas \w que|strong="H3588"\w* \w vivían|strong="H3427"\w* al otro \w lado|strong="H5676"\w* del \w valle|strong="H6010"\w* \w y|strong="H3588"\w* al otro \w lado|strong="H5676"\w* del \w Jordán|strong="H3383"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* ejército \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w había|strong="H3588"\w* huido \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w y|strong="H3588"\w* sus \w hijos|strong="H1121"\w* habían \w muerto|strong="H4191"\w*, abandonaron sus \w ciudades|strong="H5892"\w* \w y|strong="H3588"\w* \w huyeron|strong="H5127"\w*. \w Entonces|strong="H3588"\w* \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w* llegaron \w y|strong="H3588"\w* se quedaron \w a|strong="H3068"\w* vivir \w en|strong="H3588"\w* ellas.  
\v 8 Al \w día|strong="H1121"\w* \w siguiente|strong="H4283"\w*, \w cuando|strong="H1961"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* despojar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w muertos|strong="H2491"\w*, encontraron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* sus \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w* \w caídos|strong="H5307"\w* en \w el|strong="H5307"\w* \w monte|strong="H2022"\w* Gilboa.  
\v 9 Le \w cortaron|strong="H3772"\w* la \w cabeza|strong="H7218"\w* \w a|strong="H3068"\w* Saúl, le quitaron su armadura y \w enviaron|strong="H7971"\w* mensajeros por \w todo|strong="H5439"\w* el territorio \w filisteo|strong="H6430"\w* \w para|strong="H5971"\w* dar la noticia en el \w templo|strong="H1004"\w* \w de|strong="H5971"\w* sus \w ídolos|strong="H6091"\w* y \w a|strong="H3068"\w* \w todo|strong="H5439"\w* el \w pueblo|strong="H5971"\w*.  
\v 10 \w Pusieron|strong="H7760"\w* su armadura en el \w templo|strong="H1004"\w* de Astarot y colgaron su cadáver en la muralla de Bet-shán.  
\v 11 Pero cuando \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de \w Jabes|strong="H3003"\w* de \w Galaad|strong="H1568"\w* se enteraron de \w lo|strong="H6213"\w* que \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w* le habían \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*,  
\v 12 \w todos|strong="H3605"\w* sus \w hombres|strong="H1121"\w* \w valientes|strong="H2428"\w* se \w levantaron|strong="H6965"\w* y \w caminaron|strong="H3212"\w* durante \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w noche|strong="H3915"\w*. Retiraron \w el|strong="H3605"\w* cuerpo \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w* y \w los|strong="H1121"\w* \w cuerpos|strong="H1472"\w* \w de|strong="H1121"\w* sus \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* muralla \w de|strong="H1121"\w* Bet-shán, \w los|strong="H1121"\w* \w llevaron|strong="H3947"\w* \w a|strong="H3068"\w* \w Jabes|strong="H3003"\w* y \w allí|strong="H8033"\w* \w los|strong="H1121"\w* quemaron.  
\v 13 Luego \w tomaron|strong="H3947"\w* sus \w huesos|strong="H6106"\w* y los enterraron \w bajo|strong="H8478"\w* el árbol \w de|strong="H8478"\w* tamarisco \w que|strong="H3117"\w* está \w en|strong="H6912"\w* \w Jabes|strong="H3003"\w*, y ayunaron durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.   