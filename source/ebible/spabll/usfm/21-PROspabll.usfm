\id PRO  
\h PROVERBIOS 
\toc3 Proverbios 
\toc1 PROVERBIOS 
\toc2 PROVERBIOS 
\mt1 Proverbios  
\c 1  
\p
\v 1 \w Los|strong="H1121"\w* \w proverbios|strong="H4912"\w* \w de|strong="H1121"\w* \w Salomón|strong="H8010"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w*, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*:   
\q1
\v 2 para adquirir \w sabiduría|strong="H2451"\w* y disciplina;  
\q2 para entender palabras de inteligencia;   
\q1
\v 3 para \w recibir|strong="H3947"\w* instrucción y portarse sabiamente,  
\q2 con rectitud, \w justicia|strong="H6664"\w* y equidad;   
\q1
\v 4 \w para|strong="H5414"\w* \w dar|strong="H5414"\w* prudencia \w a|strong="H3068"\w* los inexpertos,  
\q2 y \w conocimiento|strong="H1847"\w* y discreción \w a|strong="H3068"\w* los jóvenes.   
\q1
\v 5 El \w sabio|strong="H2450"\w* \w escuchará|strong="H8085"\w* y \w aumentará|strong="H3254"\w* su saber,  
\q2 y el inteligente logrará adquirir dirección;   
\q1
\v 6 para entender \w proverbios|strong="H4912"\w* y parábolas,  
\q2 \w los|strong="H2450"\w* dichos y enigmas \w de|strong="H1697"\w* \w los|strong="H2450"\w* \w sabios|strong="H2450"\w*.   
\b  
\q1
\v 7 El \w temor|strong="H3374"\w* de Yahvé\f + \fr 1:7 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* es el \w principio|strong="H7225"\w* del \w conocimiento|strong="H1847"\w*,  
\q2 pero los necios desprecian \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* y \w la|strong="H2451"\w* \w corrección|strong="H4148"\w*.   
\q1
\v 8 \w Hijo|strong="H1121"\w* mío, \w escucha|strong="H8085"\w* la \w corrección|strong="H4148"\w* \w de|strong="H1121"\w* tu padre,  
\q2 y no abandones la \w enseñanza|strong="H4148"\w* \w de|strong="H1121"\w* tu madre;   
\q1
\v 9 \w porque|strong="H3588"\w* \w serán|strong="H1992"\w* un hermoso \w adorno|strong="H3880"\w* \w en|strong="H3588"\w* tu \w cabeza|strong="H7218"\w*,  
\q2 \w y|strong="H3588"\w* collares \w que|strong="H3588"\w* adornen tu cuello.   
\q1
\v 10 \w Hijo|strong="H1121"\w* mío, si \w los|strong="H1121"\w* \w pecadores|strong="H2400"\w* intentan engañarte,  
\q2 no les hagas caso.   
\q1
\v 11 Si te dicen: “\w Ven|strong="H3212"\w* con nosotros,  
\q2 pongamos una trampa para matar \w a|strong="H3068"\w* alguien;  
\q2 \w acechemos|strong="H6845"\w* sin motivo \w a|strong="H3068"\w* los inocentes.   
\q1
\v 12 Traguémoslos \w vivos|strong="H2416"\w* como el Seol, \f + \fr 1:12 \ft El Seol es el lugar de los muertos.\f*  
\q2 y enteros, como \w a|strong="H3068"\w* los que caen \w en|strong="H8549"\w* la fosa.   
\q1
\v 13 \w Hallaremos|strong="H4672"\w* \w toda|strong="H3605"\w* clase de tesoros;  
\q2 llenaremos nuestras \w casas|strong="H1004"\w* con \w el|strong="H3605"\w* botín.   
\q1
\v 14 Comparte tu \w suerte|strong="H1486"\w* con \w nosotros|strong="H3605"\w*;  
\q2 \w todos|strong="H3605"\w* tendremos una sola \w bolsa|strong="H3599"\w*”.   
\q1
\v 15 ¡\w Hijo|strong="H1121"\w* mío, \w no|strong="H1870"\w* \w vayas|strong="H3212"\w* \w por|strong="H1870"\w* \w el|strong="H1121"\w* \w camino|strong="H1870"\w* con ellos!  
\q2 Aleja tus pasos \w de|strong="H1121"\w* sus senderos,   
\q1
\v 16 \w porque|strong="H3588"\w* sus \w pies|strong="H7272"\w* \w corren|strong="H7323"\w* hacia \w el|strong="H3588"\w* \w mal|strong="H7451"\w*,  
\q2 \w y|strong="H3588"\w* se apresuran \w a|strong="H3068"\w* derramar \w sangre|strong="H1818"\w*.   
\q1
\v 17 \w De|strong="H3588"\w* \w nada|strong="H3605"\w* sirve tender \w la|strong="H3588"\w* \w red|strong="H7568"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* vista \w de|strong="H3588"\w* \w cualquier|strong="H3605"\w* \w ave|strong="H1167"\w*;   
\q1
\v 18 pero \w ellos|strong="H1992"\w* acechan \w su|strong="H1992"\w* propia \w sangre|strong="H1818"\w*,  
\q2 y \w se|strong="H1992"\w* ponen trampas \w a|strong="H3068"\w* \w sí|strong="H5315"\w* \w mismos|strong="H1992"\w*.   
\q1
\v 19 \w Así|strong="H3651"\w* terminan \w los|strong="H3605"\w* \w que|strong="H3605"\w* buscan ganancias mal habidas;  
\q2 \w la|strong="H3605"\w* codicia les \w quita|strong="H3947"\w* \w la|strong="H3605"\w* \w vida|strong="H5315"\w* \w a|strong="H3068"\w* sus dueños.   
\b  
\q1
\v 20 La \w sabiduría|strong="H2454"\w* llama con fuerza en las \w calles|strong="H2351"\w*;  
\q2 levanta su \w voz|strong="H6963"\w* en las \w plazas|strong="H7339"\w*.   
\q1
\v 21 Grita en las esquinas más ruidosas;  
\q2 \w a|strong="H3068"\w* la entrada de las \w puertas|strong="H8179"\w* de la \w ciudad|strong="H5892"\w* dice sus palabras:   
\q1
\v 22 “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w*, jóvenes inexpertos, amarán \w su|strong="H1992"\w* ignorancia?  
\q2 ¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w* \w los|strong="H1992"\w* burlones disfrutarán \w de|strong="H5704"\w* \w sus|strong="H1992"\w* burlas,  
\q2 \w y|strong="H5704"\w* \w los|strong="H1992"\w* necios odiarán \w el|strong="H1992"\w* \w conocimiento|strong="H1847"\w*?   
\q1
\v 23 Presten atención \w a|strong="H3068"\w* \w mi|strong="H2009"\w* corrección.  
\q2 Miren,\f + \fr 1:23 \ft “He aquí”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* \w yo|strong="H2009"\w* derramaré \w mi|strong="H2009"\w* \w espíritu|strong="H7307"\w* sobre ustedes;  
\q2 les daré \w a|strong="H3068"\w* conocer mis pensamientos.   
\q1
\v 24 Pero como los \w llamé|strong="H7121"\w* y \w no|strong="H3985"\w* \w quisieron|strong="H3985"\w* escuchar,  
\q2 y \w extendí|strong="H5186"\w* mi \w mano|strong="H3027"\w* y nadie me hizo caso,   
\q1
\v 25 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* rechazaron \w todos|strong="H3605"\w* mis \w consejos|strong="H6098"\w*  
\q2 y \w no|strong="H3808"\w* quisieron mi corrección,   
\q1
\v 26 yo \w también|strong="H1571"\w* me reiré de su desgracia;  
\q2 me burlaré \w cuando|strong="H1571"\w* les llegue lo \w que|strong="H1571"\w* tanto temen,   
\q1
\v 27 cuando \w el|strong="H5921"\w* \w terror|strong="H6343"\w* \w los|strong="H5921"\w* asalte \w como|strong="H5921"\w* una tormenta,  
\q2 cuando su desastre llegue \w como|strong="H5921"\w* un \w torbellino|strong="H5492"\w*,  
\q2 cuando \w la|strong="H5921"\w* \w angustia|strong="H6869"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* desesperación \w les|strong="H5921"\w* pasen factura.   
\q1
\v 28 Entonces me \w llamarán|strong="H7121"\w*, pero \w no|strong="H3808"\w* \w responderé|strong="H6030"\w*;  
\q2 me buscarán con ansia, pero \w no|strong="H3808"\w* me encontrarán.   
\q1
\v 29 \w Por|strong="H3588"\w* \w cuanto|strong="H3588"\w* odiaron \w el|strong="H3588"\w* \w conocimiento|strong="H1847"\w*  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* eligieron \w el|strong="H3588"\w* \w temor|strong="H3374"\w* \w de|strong="H3588"\w* Yahvé,   
\q1
\v 30 \w ni|strong="H3808"\w* quisieron seguir mis \w consejos|strong="H6098"\w*,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* despreciaron mi corrección,   
\q1
\v 31 comerán del \w fruto|strong="H6529"\w* \w de|strong="H7646"\w* su conducta,  
\q2 y se hartarán \w de|strong="H7646"\w* sus propios planes.   
\q1
\v 32 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* descuido \w de|strong="H3588"\w* \w los|strong="H3588"\w* ingenuos \w los|strong="H3588"\w* \w matará|strong="H2026"\w*,  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* falsa seguridad \w de|strong="H3588"\w* \w los|strong="H3588"\w* necios \w los|strong="H3588"\w* destruirá.   
\q1
\v 33 Pero el \w que|strong="H6343"\w* me \w escuche|strong="H8085"\w* vivirá seguro,  
\q2 y estará tranquilo, sin \w miedo|strong="H6343"\w* al \w mal|strong="H7451"\w*”.   
\c 2  
\q1
\v 1 \w Hijo|strong="H1121"\w* mío, si aceptas mis palabras  
\q2 y guardas mis mandatos en tu memoria,   
\q1
\v 2 prestando oído \w a|strong="H3068"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*  
\q2 y abriendo tu \w corazón|strong="H3820"\w* \w a|strong="H3068"\w* \w la|strong="H2451"\w* \w inteligencia|strong="H8394"\w*;   
\q1
\v 3 \w si|strong="H3588"\w* llamas al discernimiento  
\q2 \w y|strong="H3588"\w* pides \w a|strong="H3068"\w* gritos \w entendimiento|strong="H8394"\w*;   
\q1
\v 4 si los \w buscas|strong="H1245"\w* como si fueran \w plata|strong="H3701"\w*,  
\q2 como si \w buscaras|strong="H1245"\w* \w tesoros|strong="H4301"\w* ocultos,   
\q1
\v 5 entonces entenderás lo que es temer \w a|strong="H3068"\w* Yahvé  
\q2 y \w hallarás|strong="H4672"\w* el \w conocimiento|strong="H1847"\w* de \w Dios|strong="H3068"\w*. \f + \fr 2:5 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f*   
\q1
\v 6 \w Porque|strong="H3588"\w* Yahvé \w es|strong="H3588"\w* quien \w da|strong="H5414"\w* \w la|strong="H3588"\w* \w sabiduría|strong="H2451"\w*;  
\q2 \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w boca|strong="H6310"\w* brotan \w el|strong="H3588"\w* \w conocimiento|strong="H1847"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w inteligencia|strong="H8394"\w*.   
\q1
\v 7 Él concede \w sabiduría|strong="H8454"\w* \w a|strong="H3068"\w* los que son \w rectos|strong="H3477"\w*  
\q2 y es un \w escudo|strong="H4043"\w* para los que viven con \w integridad|strong="H8537"\w*.   
\q1
\v 8 Él \w cuida|strong="H8104"\w* el \w camino|strong="H1870"\w* de los justos  
\q2 y protege el andar de sus fieles.   
\q1
\v 9 Entonces entenderás \w lo|strong="H3605"\w* \w que|strong="H3605"\w* es \w justicia|strong="H6664"\w*, rectitud  
\q2 y equidad: \w todo|strong="H3605"\w* \w buen|strong="H2896"\w* \w camino|strong="H4570"\w*.   
\q1
\v 10 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w sabiduría|strong="H2451"\w* entrará \w en|strong="H3588"\w* tu \w corazón|strong="H3820"\w*  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w conocimiento|strong="H1847"\w* \w te|strong="H3588"\w* llenará \w de|strong="H3588"\w* alegría.   
\q1
\v 11 \w La|strong="H5921"\w* discreción \w te|strong="H5921"\w* cuidará  
\q2 \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w inteligencia|strong="H8394"\w* \w te|strong="H5921"\w* protegerá,   
\q1
\v 12 para librarte del \w mal|strong="H7451"\w* \w camino|strong="H1870"\w*,  
\q2 \w de|strong="H7451"\w* los hombres que \w dicen|strong="H1696"\w* \w cosas|strong="H7451"\w* perversas,   
\q1
\v 13 de los que \w abandonan|strong="H5800"\w* el \w camino|strong="H1870"\w* recto  
\q2 para \w andar|strong="H3212"\w* \w por|strong="H1870"\w* senderos oscuros;   
\q1
\v 14 \w de|strong="H7451"\w* los que gozan \w haciendo|strong="H6213"\w* \w el|strong="H6213"\w* \w mal|strong="H7451"\w*  
\q2 y celebran la perversidad del \w malvado|strong="H7451"\w*;   
\q1
\v 15 de aquellos cuyos \w caminos|strong="H4570"\w* son torcidos  
\q2 y cuya conducta es de desconfiar.   
\q1
\v 16 También te \w librará|strong="H5337"\w* de la mujer seductora,  
\q2 de la \w extraña|strong="H5237"\w* que te halaga con sus palabras,   
\q1
\v 17 \w de|strong="H7911"\w* la que abandona al esposo \w de|strong="H7911"\w* su \w juventud|strong="H5271"\w*  
\q2 y se olvida \w de|strong="H7911"\w* su compromiso con Dios.   
\q1
\v 18 \w El|strong="H3588"\w* \w camino|strong="H4570"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w* \w baja|strong="H1004"\w* hasta \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*;  
\q2 sus pasos llevan al mundo \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w muertos|strong="H7496"\w*.   
\q1
\v 19 \w Nadie|strong="H3808"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* acerque \w a|strong="H3068"\w* \w ella|strong="H3605"\w* \w vuelve|strong="H7725"\w* \w jamás|strong="H3808"\w*,  
\q2 \w ni|strong="H3808"\w* logra recuperar \w el|strong="H3605"\w* camino de \w la|strong="H3605"\w* \w vida|strong="H2416"\w*.   
\q1
\v 20 \w Por|strong="H1870"\w* eso, sigue el \w camino|strong="H1870"\w* \w de|strong="H6662"\w* \w la|strong="H8104"\w* gente \w buena|strong="H2896"\w*  
\q2 y mantente \w en|strong="H3212"\w* \w la|strong="H8104"\w* senda \w de|strong="H6662"\w* los \w justos|strong="H6662"\w*.   
\q1
\v 21 \w Porque|strong="H3588"\w* \w los|strong="H3588"\w* \w rectos|strong="H3477"\w* vivirán \w en|strong="H8549"\w* \w la|strong="H3588"\w* tierra  
\q2 \w y|strong="H3588"\w* las personas íntegras \w permanecerán|strong="H3498"\w* \w en|strong="H8549"\w* ella.   
\q1
\v 22 Pero \w a|strong="H3068"\w* los malvados los borrarán \w de|strong="H4480"\w* la tierra  
\q2 y \w a|strong="H3068"\w* los traidores los arrancarán \w de|strong="H4480"\w* \w ella|strong="H4480"\w*.   
\c 3  
\q1
\v 1 \w Hijo|strong="H1121"\w* mío, no \w olvides|strong="H7911"\w* mis enseñanzas;  
\q2 más bien, \w guarda|strong="H5341"\w* en tu \w corazón|strong="H3820"\w* mis \w mandamientos|strong="H4687"\w*,   
\q1
\v 2 \w porque|strong="H3588"\w* \w te|strong="H3588"\w* darán muchos \w años|strong="H8141"\w* \w de|strong="H3588"\w* \w vida|strong="H2416"\w*  
\q2 \w y|strong="H3588"\w* \w te|strong="H3588"\w* traerán prosperidad \w y|strong="H3588"\w* \w paz|strong="H7965"\w*.   
\q1
\v 3 \w Que|strong="H5921"\w* nunca \w te|strong="H5921"\w* abandonen \w el|strong="H5921"\w* amor \w y|strong="H5921"\w* \w la|strong="H5921"\w* verdad;  
\q2 \w átalos|strong="H7194"\w* \w a|strong="H3068"\w* tu cuello \w y|strong="H5921"\w* \w escríbelos|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* libro \w de|strong="H5921"\w* tu \w corazón|strong="H3820"\w*.   
\q1
\v 4 “Así contarás con el favor \w de|strong="H5869"\w* Dios y \w de|strong="H5869"\w* la gente,  
\q2 y tendrás \w buena|strong="H2896"\w* \w fama|strong="H2580"\w* como persona inteligente”.   
\q1
\v 5 Confía en Yahvé de \w todo|strong="H3605"\w* \w corazón|strong="H3820"\w*,  
\q2 y no te apoyes en tu propia inteligencia.   
\q1
\v 6 \w Reconócelo|strong="H3045"\w* en \w todos|strong="H3605"\w* tus \w caminos|strong="H1870"\w*,  
\q2 y \w él|strong="H1931"\w* \w enderezará|strong="H3474"\w* tus senderos.   
\q1
\v 7 \w No|strong="H1961"\w* \w te|strong="H5869"\w* creas demasiado \w sabio|strong="H2450"\w*;  
\q2 \w teme|strong="H3372"\w* \w a|strong="H3068"\w* Yahvé y \w apártate|strong="H5493"\w* del \w mal|strong="H7451"\w*.   
\q1
\v 8 Esto \w será|strong="H1961"\w* \w medicina|strong="H7500"\w* \w para|strong="H1961"\w* tu cuerpo  
\q2 y salud \w para|strong="H1961"\w* tus \w huesos|strong="H6106"\w*.   
\q1
\v 9 \w Honra|strong="H3513"\w* \w a|strong="H3068"\w* Yahvé con tus \w riquezas|strong="H1952"\w*  
\q2 y con \w lo|strong="H3605"\w* mejor de tus cosechas;   
\q1
\v 10 así tus graneros se llenarán \w a|strong="H3068"\w* reventar  
\q2 y tus depósitos de \w vino|strong="H8492"\w* desbordarán.   
\q1
\v 11 \w Hijo|strong="H1121"\w* mío, no rechaces la disciplina \w de|strong="H1121"\w* Yahvé  
\q2 ni te sientas mal por su \w corrección|strong="H4148"\w*;   
\q1
\v 12 \w porque|strong="H3588"\w* Yahvé \w corrige|strong="H3198"\w* \w a|strong="H3068"\w* quien ama,  
\q2 \w como|strong="H3588"\w* un padre al \w hijo|strong="H1121"\w* \w en|strong="H3588"\w* quien se complace.   
\b  
\q1
\v 13 ¡Dichoso el que \w halla|strong="H4672"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*!  
\q2 ¡Dichoso el que adquiere \w inteligencia|strong="H8394"\w*!   
\q1
\v 14 Ella rinde \w más|strong="H3588"\w* provecho \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w plata|strong="H3701"\w*  
\q2 \w y|strong="H3588"\w* deja \w más|strong="H3588"\w* ganancias \w que|strong="H3588"\w* \w el|strong="H3588"\w* oro fino.   
\q1
\v 15 \w La|strong="H1931"\w* sabiduría vale \w más|strong="H3808"\w* \w que|strong="H1931"\w* las piedras \w preciosas|strong="H3368"\w*;  
\q2 ¡\w nada|strong="H3808"\w* de \w lo|strong="H1931"\w* \w que|strong="H1931"\w* desees \w se|strong="H1931"\w* \w le|strong="H1931"\w* puede comparar!   
\q1
\v 16 Con la mano \w derecha|strong="H3225"\w* ofrece larga \w vida|strong="H3117"\w*,  
\q2 \w y|strong="H3519"\w* con la \w izquierda|strong="H8040"\w*, \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* honor.   
\q1
\v 17 Sus \w caminos|strong="H1870"\w* son placenteros  
\q2 y \w todas|strong="H3605"\w* sus sendas conducen \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w paz|strong="H7965"\w*.   
\q1
\v 18 \w La|strong="H1931"\w* sabiduría \w es|strong="H1931"\w* \w árbol|strong="H6086"\w* de \w vida|strong="H2416"\w* para quienes \w la|strong="H1931"\w* aceptan;  
\q2 ¡dichosos \w los|strong="H1931"\w* \w que|strong="H1931"\w* no \w la|strong="H1931"\w* sueltan!   
\q1
\v 19 Yahvé \w fundó|strong="H3245"\w* \w la|strong="H2451"\w* tierra con \w sabiduría|strong="H2451"\w*;  
\q2 con \w inteligencia|strong="H8394"\w* estableció los \w cielos|strong="H8064"\w*.   
\q1
\v 20 Por su \w conocimiento|strong="H1847"\w* brotaron las aguas profundas  
\q2 y las nubes derraman su \w rocío|strong="H2919"\w*.   
\q1
\v 21 \w Hijo|strong="H1121"\w* mío, no pierdas esto \w de|strong="H1121"\w* vista;  
\q2 conserva la prudencia y la discreción.   
\q1
