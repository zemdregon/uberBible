\q1
\v 12 \w Si|strong="H3588"\w* dices: “\w La|strong="H1931"\w* verdad, \w no|strong="H3808"\w* sabíamos \w nada|strong="H3808"\w*”,  
\q2 ¿acaso \w no|strong="H3808"\w* \w se|strong="H3045"\w* \w da|strong="H7725"\w* cuenta \w el|strong="H1931"\w* \w que|strong="H3588"\w* juzga las intenciones?  
\q1 \w El|strong="H1931"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* cuida, ¿acaso \w no|strong="H3808"\w* \w lo|strong="H1931"\w* \w sabe|strong="H3045"\w*?  
\q2 ¡\w Él|strong="H1931"\w* \w le|strong="H1931"\w* pagará \w a|strong="H3068"\w* cada uno según \w lo|strong="H1931"\w* \w que|strong="H3588"\w* haya \w hecho|strong="H5315"\w*!   
\q1
\v 13 Come \w miel|strong="H1706"\w*, \w hijo|strong="H1121"\w* \w mío|strong="H5921"\w*, \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w buena|strong="H2896"\w*;  
\q2 \w la|strong="H5921"\w* \w miel|strong="H1706"\w* \w que|strong="H3588"\w* gotea \w del|strong="H5921"\w* \w panal|strong="H5317"\w* \w es|strong="H3588"\w* \w dulce|strong="H4966"\w* \w al|strong="H5921"\w* paladar.   
\q1
\v 14 \w Así|strong="H3651"\w* de dulce \w será|strong="H3808"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w* para \w tu|strong="H3426"\w* \w alma|strong="H5315"\w*;  
\q2 \w si|strong="H3808"\w* \w la|strong="H2451"\w* encuentras, tendrás un buen futuro  
\q2 y \w tu|strong="H3426"\w* \w esperanza|strong="H8615"\w* \w no|strong="H3808"\w* \w se|strong="H3045"\w* marchará.   
\q1
\v 15 \w No|strong="H7563"\w* aceches como malvado la casa del \w justo|strong="H6662"\w*,  
\q2 ni destruyas el lugar donde descansa;   
\q1
\v 16 \w porque|strong="H3588"\w* \w aunque|strong="H3588"\w* \w el|strong="H3588"\w* \w justo|strong="H6662"\w* \w caiga|strong="H5307"\w* \w siete|strong="H7651"\w* \w veces|strong="H7651"\w*, volverá \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*,  
\q2 \w pero|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* malvados \w los|strong="H3588"\w* hundirá \w la|strong="H3588"\w* desgracia.   
\q1
\v 17 No te alegres cuando \w caiga|strong="H5307"\w* tu enemigo,  
\q2 ni festejes cuando \w él|strong="H5307"\w* tropiece;   
\q1
\v 18 \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H5921"\w* Yahvé \w lo|strong="H5921"\w* \w vea|strong="H7200"\w* \w y|strong="H5921"\w* \w no|strong="H6435"\w* \w le|strong="H5921"\w* guste,  
\q2 \w y|strong="H5921"\w* decida quitarle su enojo.   
\q1
\v 19 \w No|strong="H7563"\w* \w te|strong="H7489"\w* angusties por los malvados,  
\q2 ni sientas \w envidia|strong="H7065"\w* de los que hacen el \w mal|strong="H7489"\w*;   
\q1
\v 20 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w malvado|strong="H7451"\w* \w no|strong="H3808"\w* \w tendrá|strong="H1961"\w* un buen final,  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* vida \w de|strong="H3588"\w* \w los|strong="H3588"\w* malvados \w se|strong="H1961"\w* apagará \w como|strong="H3588"\w* una \w lámpara|strong="H5216"\w*.   
\q1
\v 21 \w Hijo|strong="H1121"\w* mío, \w teme|strong="H3372"\w* \w a|strong="H3068"\w* Yahvé y \w al|strong="H4428"\w* \w rey|strong="H4428"\w*,  
\q2 y no \w te|strong="H5973"\w* juntes \w con|strong="H5973"\w* \w los|strong="H1121"\w* rebeldes;   
\q1
\v 22 \w porque|strong="H3588"\w* \w de|strong="H3588"\w* repente les llegará \w la|strong="H3588"\w* ruina,  
\q2 \w y|strong="H3588"\w* ¿\w quién|strong="H4310"\w* \w sabe|strong="H3045"\w* \w el|strong="H3588"\w* desastre \w que|strong="H3588"\w* Dios \w y|strong="H3588"\w* \w el|strong="H3588"\w* rey pueden enviar?   
\b  
\p
\v 23 \w Estos|strong="H1571"\w* \w también|strong="H1571"\w* son dichos \w de|strong="H6440"\w* \w los|strong="H2450"\w* \w sabios|strong="H2450"\w*:  
\b  
\q1 \w No|strong="H1077"\w* está \w bien|strong="H2896"\w* ser parcial en \w el|strong="H1571"\w* \w juicio|strong="H4941"\w*.   
\q1
\v 24 Al \w que|strong="H5971"\w* le dice al culpable: “Tú eres inocente”,  
\q2 los \w pueblos|strong="H5971"\w* lo maldecirán y las naciones lo odiarán.   
\q1
\v 25 Pero \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* condenan \w al|strong="H5921"\w* malo \w les|strong="H5921"\w* irá \w bien|strong="H2896"\w*,  
\q2 \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* vendrán ricas \w bendiciones|strong="H1293"\w*.   
\q1
\v 26 Una \w respuesta|strong="H1697"\w* sincera  
\q2 \w es|strong="H1697"\w* como un \w beso|strong="H5401"\w* en los \w labios|strong="H8193"\w*.   
\q1
\v 27 Arregla tus negocios \w fuera|strong="H2351"\w* de \w casa|strong="H1004"\w*  
\q2 y deja listos tus \w campos|strong="H7704"\w*;  
\q2 después de eso, construye tu \w casa|strong="H1004"\w*.   
\q1
\v 28 \w No|strong="H1961"\w* atestigües \w contra|strong="H1961"\w* tu \w prójimo|strong="H7453"\w* sin motivo,  
\q2 ni uses tus \w labios|strong="H8193"\w* \w para|strong="H1961"\w* engañar.   
\q1
\v 29 \w No|strong="H6213"\w* digas: “Le voy \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* \w lo|strong="H6213"\w* mismo que me \w hizo|strong="H6213"\w*;  
\q2 le voy \w a|strong="H3068"\w* pagar con la misma moneda”.   
\q1
\v 30 \w Pasé|strong="H5674"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w campo|strong="H7704"\w* \w del|strong="H5921"\w* \w perezoso|strong="H6102"\w*,  
\q2 \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w viña|strong="H3754"\w* \w del|strong="H5921"\w* \w que|strong="H5921"\w* \w no|strong="H5921"\w* tiene juicio;   
\q1
\v 31 y vi \w que|strong="H3605"\w* \w todo|strong="H3605"\w* \w estaba|strong="H2009"\w* lleno \w de|strong="H6440"\w* espinos,  
\q2 \w la|strong="H3605"\w* maleza cubría \w el|strong="H3605"\w* terreno  
\q2 y \w la|strong="H3605"\w* cerca \w de|strong="H6440"\w* piedra \w estaba|strong="H2009"\w* caída.   
\q1
\v 32 Al \w ver|strong="H7200"\w* esto, me puse \w a|strong="H3068"\w* pensar;  
\q2 observé y aprendí esta lección:   
\q1
\v 33 Un \w poco|strong="H4592"\w* de \w sueño|strong="H8142"\w*, otro \w poco|strong="H4592"\w* de dormitar,  
\q2 y un ratito de cruzar las \w manos|strong="H3027"\w* para descansar;   
\q1
\v 34 así te llegará la \w pobreza|strong="H7389"\w* como un asaltante,  
\q2 y la necesidad como un hombre armado.   
\c 25  
\p
\v 1 \w Estos|strong="H1571"\w* \w también|strong="H1571"\w* son \w proverbios|strong="H4912"\w* de \w Salomón|strong="H8010"\w*, \w que|strong="H1571"\w* fueron copiados \w por|strong="H4428"\w* los hombres de Ezequías, \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w*.   
\q1
\v 2 \w Es|strong="H1697"\w* un honor para Dios \w ocultar|strong="H5641"\w* un \w asunto|strong="H1697"\w*,  
\q2 pero \w es|strong="H1697"\w* un honor para los \w reyes|strong="H4428"\w* investigar los \w hechos|strong="H1697"\w*.   
\q1
\v 3 Tan altos son los \w cielos|strong="H8064"\w* y tan profunda es la tierra,  
\q2 que nadie puede entender lo que piensan los \w reyes|strong="H4428"\w*.   
\q1
\v 4 \w Quita|strong="H1898"\w* las impurezas de la \w plata|strong="H3701"\w*,  
\q2 y el platero podrá fabricar una joya.   
\q1
\v 5 \w Quita|strong="H1898"\w* \w a|strong="H3068"\w* los malvados \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* del \w rey|strong="H4428"\w*,  
\q2 y su \w trono|strong="H3678"\w* se mantendrá \w firme|strong="H3559"\w* gracias \w a|strong="H3068"\w* la \w justicia|strong="H6664"\w*.   
\q1
\v 6 \w No|strong="H6440"\w* te des importancia \w delante|strong="H6440"\w* del \w rey|strong="H4428"\w*,  
\q2 ni busques un \w lugar|strong="H4725"\w* entre la gente importante;   
\q1
\v 7 \w porque|strong="H3588"\w* \w es|strong="H3588"\w* \w mejor|strong="H2896"\w* \w que|strong="H3588"\w* \w te|strong="H5869"\w* digan: “\w Ven|strong="H7200"\w*, \w sube|strong="H5927"\w* \w aquí|strong="H2008"\w*”,  
\q2 \w que|strong="H3588"\w* ser humillado \w ante|strong="H6440"\w* \w el|strong="H3588"\w* noble,  
\q2 después \w de|strong="H3588"\w* haberlo \w visto|strong="H7200"\w* \w con|strong="H3588"\w* tus propios \w ojos|strong="H5869"\w*.   
\q1
\v 8 \w No|strong="H6435"\w* te lances \w a|strong="H3068"\w* presentar pleitos \w en|strong="H3318"\w* la corte.  
\q2 ¿\w Qué|strong="H4100"\w* \w harás|strong="H6213"\w* al final, \w cuando|strong="H4100"\w* \w tu|strong="H6213"\w* vecino te deje \w en|strong="H3318"\w* \w vergüenza|strong="H3637"\w*?   
\q1
\v 9 Arregla el problema con tu vecino cara \w a|strong="H3068"\w* cara,  
\q2 y no cuentes los secretos de otros;   
\q2
\v 10 \w no|strong="H3808"\w* \w sea|strong="H6435"\w* \w que|strong="H3808"\w* alguien te \w oiga|strong="H8085"\w* y te avergüence,  
\q2 y te ganes una mala \w fama|strong="H1681"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* te quite.   
\b  
\q1
\v 11 Una \w palabra|strong="H1697"\w* \w dicha|strong="H1696"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* momento oportuno  
\q2 \w es|strong="H1697"\w* \w como|strong="H5921"\w* manzanas \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w en|strong="H5921"\w* bandejas \w de|strong="H5921"\w* \w plata|strong="H3701"\w*.   
\q1
\v 12 \w Como|strong="H5921"\w* un arete \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w o|strong="H3068"\w* una joya \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w fino|strong="H3800"\w*,  
\q2 es \w la|strong="H5921"\w* corrección \w del|strong="H5921"\w* \w sabio|strong="H2450"\w* \w para|strong="H5921"\w* quien sabe \w escuchar|strong="H8085"\w*.   
\q1
\v 13 Como el frescor de la nieve en plena cosecha,  
\q2 así es el \w mensajero|strong="H6735"\w* \w fiel|strong="H6735"\w* para quienes lo envían;  
\q2 ¡les devuelve la \w vida|strong="H5315"\w* \w a|strong="H3068"\w* sus patrones!   
\q1
\v 14 Como \w nubes|strong="H5387"\w* y \w viento|strong="H7307"\w* que no traen \w lluvia|strong="H1653"\w*,  
\q2 así es el que presume de dar regalos y nunca da nada.   
\q1
\v 15 Con mucha paciencia se convence al gobernante;  
\q2 una palabra amable puede convencer hasta al más terco.   
\q1
\v 16 ¿Encontraste \w miel|strong="H1706"\w*?  
\q2 Come solo lo \w que|strong="H6435"\w* necesites,  
\q2 \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H6435"\w* comas \w de|strong="H7646"\w* más y termines vomitándola.   
\q1
\v 17 \w No|strong="H6435"\w* visites \w a|strong="H3068"\w* tu vecino con demasiada frecuencia,  
\q2 \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H6435"\w* \w se|strong="H6435"\w* canse \w de|strong="H7646"\w* ti y termine odiándote.   
\q1
\v 18 Como un mazo, una \w espada|strong="H2719"\w* \w o|strong="H3068"\w* una flecha afilada,  
\q2 \w así|strong="H5707"\w* es el que miente contra su \w prójimo|strong="H7453"\w*.   
\q1
\v 19 Confiar en un traidor en \w tiempos|strong="H3117"\w* de \w angustia|strong="H6869"\w*  
\q2 es \w como|strong="H7272"\w* querer morder con un \w diente|strong="H8127"\w* picado \w o|strong="H3068"\w* caminar con un \w pie|strong="H7272"\w* torcido.   
\q1
\v 20 Quitarse \w la|strong="H5921"\w* ropa \w cuando|strong="H3117"\w* hace frío \w o|strong="H3068"\w* echar \w vinagre|strong="H2558"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* bicarbonato,  
\q2 es \w como|strong="H5921"\w* cantarle \w canciones|strong="H7892"\w* alegres \w a|strong="H3068"\w* un \w corazón|strong="H3820"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w triste|strong="H7451"\w*.   
\q1
\v 21 Si tu enemigo tiene hambre, dale \w de|strong="H4325"\w* comer;  
\q2 si tiene sed, dale \w de|strong="H4325"\w* \w beber|strong="H8248"\w* \w agua|strong="H4325"\w*;   
\q1
\v 22 \w así|strong="H3588"\w* harás \w que|strong="H3588"\w* \w se|strong="H5921"\w* avergüence \w de|strong="H5921"\w* \w su|strong="H3588"\w* conducta,  
\q2 \w y|strong="H3588"\w* Yahvé \w te|strong="H5921"\w* \w lo|strong="H5921"\w* recompensará.   
\q1
\v 23 El \w viento|strong="H7307"\w* del \w norte|strong="H6828"\w* trae la \w lluvia|strong="H1653"\w*,  
\q2 y los chismes traen caras enojadas.   
\q1
\v 24 Es \w mejor|strong="H2896"\w* vivir \w en|strong="H5921"\w* un rincón \w de|strong="H5921"\w* \w la|strong="H5921"\w* azotea,  
\q2 \w que|strong="H5921"\w* compartir \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w con|strong="H5921"\w* una mujer peleonera.   
\q1
\v 25 \w Como|strong="H5921"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w fría|strong="H7119"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* muerto \w de|strong="H5921"\w* sed,  
\q2 así son \w las|strong="H5921"\w* \w buenas|strong="H2896"\w* noticias \w que|strong="H5921"\w* vienen \w de|strong="H5921"\w* lejos.   
\q1
\v 26 Como un \w manantial|strong="H4726"\w* sucio \w o|strong="H3068"\w* un pozo contaminado,  
\q2 así es el \w justo|strong="H6662"\w* que se rinde \w ante|strong="H6440"\w* el malvado.   
\q1
\v 27 \w No|strong="H3808"\w* \w es|strong="H7235"\w* \w bueno|strong="H2896"\w* comer demasiada \w miel|strong="H1706"\w*,  
\q2 \w ni|strong="H3808"\w* andar buscando \w que|strong="H3808"\w* todo el mundo te admire.   
\q1
\v 28 Como una \w ciudad|strong="H5892"\w* \w derribada|strong="H6555"\w* y sin murallas,  
\q2 así es el hombre que no sabe controlarse.   
\c 26  
\q1
\v 1 \w Como|strong="H3651"\w* la nieve en \w verano|strong="H7019"\w* \w y|strong="H3519"\w* la \w lluvia|strong="H4306"\w* en plena cosecha,  
\q2 \w así|strong="H3651"\w* de mal \w se|strong="H3808"\w* ve \w que|strong="H3808"\w* \w se|strong="H3808"\w* honre \w a|strong="H3068"\w* un \w necio|strong="H3684"\w*.   
\q1
\v 2 \w Como|strong="H3651"\w* gorrión \w que|strong="H3808"\w* vuela y golondrina \w que|strong="H3808"\w* revolotea,  
\q2 la \w maldición|strong="H7045"\w* \w sin|strong="H3808"\w* motivo \w nunca|strong="H3808"\w* llega \w a|strong="H3068"\w* su destino.   
\q1
\v 3 El látigo es para el \w caballo|strong="H5483"\w*, el freno para el burro,  
\q2 ¡y la \w vara|strong="H7626"\w* para la espalda de los necios!   
\q1
\v 4 \w No|strong="H6435"\w* \w respondas|strong="H6030"\w* al \w necio|strong="H3684"\w* según su propia necedad,  
\q2 para \w que|strong="H6435"\w* \w no|strong="H6435"\w* te rebajes tú \w también|strong="H1571"\w* \w a|strong="H3068"\w* su nivel.   
\q1
\v 5 Respóndele al \w necio|strong="H3684"\w* \w como|strong="H1961"\w* \w se|strong="H1961"\w* merece su necedad,  
\q2 \w para|strong="H1961"\w* \w que|strong="H6435"\w* \w no|strong="H6435"\w* \w se|strong="H1961"\w* crea \w que|strong="H6435"\w* \w es|strong="H1961"\w* muy \w sabio|strong="H2450"\w*.   
\q1
\v 6 Mandar un mensaje con un \w necio|strong="H3684"\w*  
\q2 \w es|strong="H3027"\w* \w como|strong="H7272"\w* cortarse los \w pies|strong="H7272"\w* \w o|strong="H3068"\w* buscarse problemas.   
\q1
\v 7 Como las piernas de un \w cojo|strong="H6455"\w* \w que|strong="H6310"\w* cuelgan sin fuerza,  
\q2 \w así|strong="H7785"\w* es un proverbio en la \w boca|strong="H6310"\w* de los tontos.   
\q1
\v 8 \w Como|strong="H3651"\w* amarrar una piedra \w a|strong="H3068"\w* la honda,  
\q2 \w así|strong="H3651"\w* \w de|strong="H5414"\w* tonto es rendirle honores \w a|strong="H3068"\w* un \w necio|strong="H3684"\w*.   
\q1
\v 9 Como una rama espinosa en \w manos|strong="H3027"\w* de un borracho,  
\q2 así \w es|strong="H3027"\w* un proverbio en la \w boca|strong="H6310"\w* de los necios.   
\q1
\v 10 Como un arquero \w que|strong="H3605"\w* dispara \w a|strong="H3068"\w* \w todos|strong="H3605"\w* lados,  
\q2 así es \w el|strong="H3605"\w* \w que|strong="H3605"\w* contrata \w a|strong="H3068"\w* un \w necio|strong="H3684"\w* \w o|strong="H3068"\w* al primero \w que|strong="H3605"\w* \w pasa|strong="H5674"\w*.   
\q1
\v 11 \w Como|strong="H5921"\w* \w perro|strong="H3611"\w* \w que|strong="H5921"\w* \w vuelve|strong="H7725"\w* \w a|strong="H3068"\w* su \w vómito|strong="H6892"\w*,  
\q2 así es \w el|strong="H5921"\w* \w necio|strong="H3684"\w* \w que|strong="H5921"\w* repite su propia tontada.   
\q1
\v 12 ¿Has \w visto|strong="H7200"\w* \w a|strong="H3068"\w* alguien \w que|strong="H4480"\w* \w se|strong="H4480"\w* cree muy \w sabio|strong="H2450"\w*?  
\q2 ¡Hay \w más|strong="H4480"\w* \w esperanza|strong="H8615"\w* \w para|strong="H4480"\w* un \w necio|strong="H3684"\w* \w que|strong="H4480"\w* \w para|strong="H4480"\w* él!   
\q1
\v 13 Dice el \w perezoso|strong="H6102"\w*: “¡Hay un \w león|strong="H7826"\w* en el \w camino|strong="H1870"\w*!  
\q2 ¡Un \w león|strong="H7826"\w* feroz anda \w por|strong="H1870"\w* las \w calles|strong="H7339"\w*!”.   
\q1
\v 14 Así \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H1817"\w* gira \w en|strong="H5921"\w* sus bisagras,  
\q2 así \w el|strong="H5921"\w* \w perezoso|strong="H6102"\w* da vueltas \w en|strong="H5921"\w* su \w cama|strong="H4296"\w*.   
\q1
\v 15 El \w perezoso|strong="H6102"\w* mete la \w mano|strong="H3027"\w* en el plato,  
\q2 pero le \w da|strong="H7725"\w* flojera hasta llevársela \w a|strong="H3068"\w* la \w boca|strong="H6310"\w*.   
\q1
\v 16 El \w perezoso|strong="H6102"\w* se cree más \w sabio|strong="H2450"\w*  
