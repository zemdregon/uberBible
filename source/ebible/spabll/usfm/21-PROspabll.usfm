\b  
\q1
\v 12 “Yo, \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*, convivo con \w la|strong="H2451"\w* prudencia;  
\q2 yo sé dónde \w hallar|strong="H4672"\w* el \w conocimiento|strong="H1847"\w* y \w la|strong="H2451"\w* discreción.   
