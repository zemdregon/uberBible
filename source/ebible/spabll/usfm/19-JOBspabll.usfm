\b  
\c 10  
\b  
\q1
\v 1 “Estoy cansado \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w*;  
\q2 voy \w a|strong="H3068"\w* desahogarme \w con|strong="H5921"\w* mis quejas,  
\q2 \w hablaré|strong="H1696"\w* \w con|strong="H5921"\w* \w toda|strong="H5921"\w* \w la|strong="H5921"\w* \w amargura|strong="H4751"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w alma|strong="H5315"\w*.   
\q1
\v 2 \w Le|strong="H5921"\w* diré \w a|strong="H3068"\w* Dios: \w No|strong="H5921"\w* \w me|strong="H5921"\w* condenes;  
\q2 dime \w qué|strong="H4100"\w* \w tienes|strong="H3045"\w* \w en|strong="H5921"\w* \w contra|strong="H5921"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.   
\q1
\v 3 ¿\w Te|strong="H5921"\w* parece \w bien|strong="H2896"\w* oprimirme,  
\q2 despreciar \w la|strong="H5921"\w* obra \w de|strong="H5921"\w* tus propias \w manos|strong="H3709"\w*  
