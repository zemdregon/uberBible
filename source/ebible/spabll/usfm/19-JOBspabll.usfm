\b  
\c 30  
\b  
\q1
\v 1 “Pero \w ahora|strong="H6258"\w* \w se|strong="H5921"\w* burlan \w de|strong="H4480"\w* \w mí|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H4480"\w* son \w más|strong="H4480"\w* jóvenes,  
\q2 esos \w cuyos|strong="H5921"\w* padres \w no|strong="H5921"\w* eran dignos \w ni|strong="H5973"\w* \w de|strong="H4480"\w* cuidar \w a|strong="H3068"\w* mis \w perros|strong="H3611"\w*.   
\q1
\v 2 ¿\w De|strong="H5921"\w* \w qué|strong="H4100"\w* \w me|strong="H5921"\w* servía \w la|strong="H5921"\w* \w fuerza|strong="H3581"\w* \w de|strong="H5921"\w* sus \w manos|strong="H3027"\w*,  
\q2 \w si|strong="H1571"\w* \w ya|strong="H1571"\w* \w se|strong="H5921"\w* \w les|strong="H5921"\w* había acabado \w el|strong="H5921"\w* \w vigor|strong="H3581"\w*?   
\q1
\v 3 Consumidos por la necesidad y el hambre,  
\q2 andaban rumiando en la tierra \w seca|strong="H6723"\w* de un desierto desolado.   
\q1
\v 4 Arrancaban hierbas amargas \w entre|strong="H5921"\w* \w los|strong="H5921"\w* matorrales  
\q2 \w y|strong="H5921"\w* comían \w raíces|strong="H8328"\w* \w de|strong="H5921"\w* arbustos \w para|strong="H5921"\w* sobrevivir.   
\q1
\v 5 \w Los|strong="H5921"\w* echaban \w de|strong="H4480"\w* \w la|strong="H5921"\w* comunidad,  
\q2 \w y|strong="H5921"\w* \w la|strong="H5921"\w* gente \w les|strong="H5921"\w* gritaba \w como|strong="H5921"\w* \w si|strong="H5921"\w* fueran \w ladrones|strong="H1590"\w*.   
