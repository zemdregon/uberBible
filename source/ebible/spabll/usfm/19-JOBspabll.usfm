\v 6 Tenían que vivir en barrancos espantosos,  
\q2 en cuevas y entre las rocas.   
\q1
\v 7 Rebusnaban \w entre|strong="H8478"\w* los arbustos  
\q2 y se amontonaban \w bajo|strong="H8478"\w* las malezas.   
\q1
\v 8 Gente \w sin|strong="H1097"\w* \w nombre|strong="H8034"\w*, \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* gente vil,  
\q2 expulsados \w a|strong="H3068"\w* latigazos \w de|strong="H4480"\w* \w la|strong="H1571"\w* tierra.   
\b  
\q1
\v 9 “¡\w Y|strong="H3068"\w* \w ahora|strong="H6258"\w* resulta \w que|strong="H6258"\w* \w soy|strong="H1961"\w* \w el|strong="H1992"\w* tema de \w sus|strong="H1992"\w* canciones!  
\q2 ¡\w Se|strong="H1961"\w* burlan de \w mí|strong="H1961"\w* en \w mi|strong="H1961"\w* propia cara!   
\q1
\v 10 \w Me|strong="H4480"\w* odian, \w se|strong="H4480"\w* alejan \w de|strong="H4480"\w* mí,  
\q2 y \w no|strong="H3808"\w* dudan \w en|strong="H4480"\w* escupirme \w al|strong="H4480"\w* pasar.   
\q1
\v 11 \w Porque|strong="H3588"\w* Dios \w me|strong="H3588"\w* ha quitado las fuerzas \w y|strong="H3588"\w* \w me|strong="H3588"\w* ha \w humillado|strong="H6031"\w*,  
\q2 ellos han perdido todo respeto \w por|strong="H3588"\w* mí.   
\q1
\v 12 Esa chusma \w me|strong="H5921"\w* ataca \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w derecha|strong="H3225"\w*,  
\q2 \w me|strong="H5921"\w* hacen tropezar  
\q2 \w y|strong="H5921"\w* preparan \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* sus caminos \w de|strong="H5921"\w* destrucción.   
\q1
\v 13 Me cierran el paso para acabar conmigo,  
\q2 y \w lo|strong="H3808"\w* logran \w sin|strong="H3808"\w* \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* los detenga.   
\q1
\v 14 Avanzan \w como|strong="H8478"\w* \w por|strong="H8478"\w* una brecha enorme;  
\q2 se lanzan sobre mí \w entre|strong="H8478"\w* las ruinas.   
\q1
\v 15 \w Los|strong="H5921"\w* \w terrores|strong="H1091"\w* \w se|strong="H5921"\w* han vuelto \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*;  
