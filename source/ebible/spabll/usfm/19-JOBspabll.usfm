\q1
\v 20 \w De|strong="H1121"\w* sus narices sale humo,  
\q2 como \w de|strong="H1121"\w* una olla hirviendo al fuego.   
\q1
\v 21 Su aliento enciende los carbones,  
\q2 y de su boca brotan llamaradas.   
\q1
\v 22 \w En|strong="H5921"\w* su cuello reside su gran fuerza;  
\q2 \w el|strong="H5921"\w* terror \w se|strong="H5921"\w* esparce \w a|strong="H3068"\w* \w donde|strong="H8478"\w* quiera \w que|strong="H5921"\w* \w va|strong="H3068"\w*.   
\q1
\v 23 Los pliegues de su piel son firmes;  
\q2 están pegados \w a|strong="H3068"\w* él y no se mueven.   
\q1
\v 24 Su corazón es duro como la piedra;  
\q2 ¡duro como piedra de moler!   
\q1
\v 25 Cuando \w se|strong="H5921"\w* levanta, \w hasta|strong="H5921"\w* \w los|strong="H5921"\w* \w más|strong="H5921"\w* fuertes \w se|strong="H5921"\w* asustan;  
\q2 cuando sacude \w la|strong="H5921"\w* cola, huyen espantados.   
\q1
\v 26 \w No|strong="H5921"\w* hay espada \w que|strong="H1931"\w* pueda \w contra|strong="H5921"\w* \w él|strong="H1931"\w*,  
\q2 ni lanza, ni dardo, ni flecha.   
\q1
\v 27 Para él, el hierro es como paja,  
\q2 y el bronce como madera podrida.   
\q1
\v 28 Ninguna flecha lo hace huir;  
\q2 las piedras de la honda le parecen basura.   
\q1
\v 29 Los garrotes le parecen ramitas secas,  
\q2 y se ríe cuando le lanzan jabalinas.   
\q1
\v 30 Su vientre tiene puntas afiladas como cerámica;  
\q2 deja su rastro en el lodo como si fuera un trillo.   
\q1
\v 31 Hace que las profundidades hiervan como una olla;  
\q2 agita el mar como si fuera un frasco de perfume.   
\q1
\v 32 Deja tras de sí una estela de espuma blanca;  
\q2 ¡parece que el océano tuviera canas!   
\q1
\v 33 No hay nada en la tierra que se le compare;  
\q2 es una criatura que no conoce el miedo.   
\q1
\v 34 Mira con desprecio \w a|strong="H3068"\w* los poderosos;  
\q2 ¡es el rey de todos los orgullosos!”.   
\c 42  
\p
\v 1 Entonces Job le \w respondió|strong="H6030"\w* al \w Señor|strong="H3068"\w*:   
\q1
\v 2 “\w Yo|strong="H4480"\w* \w sé|strong="H3045"\w* \w bien|strong="H3588"\w* \w que|strong="H3588"\w* tú \w lo|strong="H3808"\w* \w puedes|strong="H3201"\w* \w todo|strong="H3605"\w*,  
\q2 \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* hay plan tuyo \w que|strong="H3588"\w* \w pueda|strong="H3201"\w* ser detenido.   
\q1
\v 3 Tú preguntaste: ‘¿\w Quién|strong="H4310"\w* \w es|strong="H2088"\w* \w este|strong="H2088"\w* \w que|strong="H4480"\w* oscurece mi \w consejo|strong="H6098"\w* \w con|strong="H4480"\w* su ignorancia?’.  
\q2 \w Es|strong="H2088"\w* \w verdad|strong="H3651"\w*, \w yo|strong="H4480"\w* hablaba \w de|strong="H4480"\w* \w cosas|strong="H3045"\w* \w que|strong="H4480"\w* \w no|strong="H3808"\w* \w entendía|strong="H3045"\w*,  
\q2 \w de|strong="H4480"\w* \w maravillas|strong="H6381"\w* \w que|strong="H4480"\w* superan mi comprensión.   
\q1
\v 4 Tú \w dijiste|strong="H1696"\w*: ‘\w Escúchame|strong="H8085"\w*, \w que|strong="H4994"\w* \w yo|strong="H4994"\w* voy \w a|strong="H3068"\w* \w hablar|strong="H1696"\w*;  
\q2 \w yo|strong="H4994"\w* te cuestionaré, y tú me responderás’.   
\q1
\v 5 Yo solo había \w oído|strong="H8085"\w* hablar \w de|strong="H5869"\w* ti,  
\q2 pero \w ahora|strong="H6258"\w* mis \w ojos|strong="H5869"\w* \w te|strong="H5869"\w* han \w visto|strong="H7200"\w*.   
\q1
\v 6 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w me|strong="H5921"\w* arrepiento \w de|strong="H5921"\w* todo \w lo|strong="H5921"\w* \w que|strong="H5921"\w* dije,  
\q2 \w y|strong="H5921"\w* \w me|strong="H5921"\w* humillo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w polvo|strong="H6083"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* ceniza”.   
\b  
\p
\v 7 \w Después|strong="H1961"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* terminó \w de|strong="H3588"\w* \w hablar|strong="H1696"\w* \w con|strong="H3588"\w* Job, le \w dijo|strong="H1696"\w* \w a|strong="H3068"\w* Elifaz \w de|strong="H3588"\w* Temán: “\w Estoy|strong="H1961"\w* muy \w enojado|strong="H2734"\w* contigo \w y|strong="H3588"\w* \w con|strong="H3588"\w* tus \w dos|strong="H8147"\w* \w amigos|strong="H7453"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* \w dijeron|strong="H1697"\w* \w la|strong="H3588"\w* verdad \w acerca|strong="H1696"\w* \w de|strong="H3588"\w* \w mí|strong="H1961"\w*, \w como|strong="H3588"\w* \w sí|strong="H3588"\w* \w lo|strong="H1697"\w* hizo \w mi|strong="H1961"\w* \w siervo|strong="H5650"\w* Job.  
\v 8 \w Por|strong="H5921"\w* eso, consigan \w siete|strong="H7651"\w* \w toros|strong="H6499"\w* \w y|strong="H3588"\w* \w siete|strong="H7651"\w* carneros, \w vayan|strong="H3212"\w* \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* Job \w y|strong="H3588"\w* ofrézcanlos \w como|strong="H3588"\w* un sacrificio \w por|strong="H5921"\w* ustedes mismos. \w Mi|strong="H5921"\w* \w siervo|strong="H5650"\w* Job \w orará|strong="H6419"\w* \w por|strong="H5921"\w* ustedes, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* aceptaré \w su|strong="H3588"\w* oración \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w los|strong="H5921"\w* castigaré \w por|strong="H5921"\w* \w su|strong="H3588"\w* necedad, \w aunque|strong="H3588"\w* \w no|strong="H3808"\w* \w hablaron|strong="H1696"\w* \w con|strong="H5973"\w* \w la|strong="H5921"\w* verdad \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, \w como|strong="H3588"\w* \w lo|strong="H3808"\w* \w hizo|strong="H6213"\w* Job”.   
\p
\v 9 Elifaz \w de|strong="H6440"\w* Temán, \w Bildad|strong="H1085"\w* \w de|strong="H6440"\w* Súaj y Zofar \w de|strong="H6440"\w* Naamat \w fueron|strong="H3212"\w* \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* \w lo|strong="H6213"\w* que \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* les \w había|strong="H6213"\w* ordenado, y \w el|strong="H6213"\w* \w Señor|strong="H3068"\w* aceptó la oración \w de|strong="H6440"\w* Job.   
\p
\v 10 Después de \w que|strong="H1157"\w* Job \w oró|strong="H6419"\w* \w por|strong="H1157"\w* sus \w amigos|strong="H7453"\w*, \w el|strong="H3605"\w* \w Señor|strong="H3068"\w* \w lo|strong="H3605"\w* sanó y \w le|strong="H3254"\w* devolvió su prosperidad; ¡incluso \w le|strong="H3254"\w* \w dio|strong="H7725"\w* \w el|strong="H3605"\w* doble de \w lo|strong="H3605"\w* \w que|strong="H1157"\w* antes tenía!  
\v 11 Entonces \w todos|strong="H3605"\w* sus hermanos, sus hermanas \w y|strong="H5921"\w* sus antiguos conocidos fueron \w a|strong="H3068"\w* su \w casa|strong="H1004"\w* \w a|strong="H3068"\w* comer \w con|strong="H5973"\w* \w él|strong="H5921"\w*. \w Lo|strong="H5921"\w* consolaron \w y|strong="H5921"\w* \w le|strong="H5921"\w* mostraron su simpatía \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w males|strong="H7451"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w le|strong="H5921"\w* había enviado. \w Cada|strong="H3605"\w* uno \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w le|strong="H5921"\w* regaló una moneda \w de|strong="H5921"\w* plata \w y|strong="H5921"\w* un anillo \w de|strong="H5921"\w* \w oro|strong="H2091"\w*.   
\p
\v 12 El \w Señor|strong="H3068"\w* \w bendijo|strong="H1288"\w* \w los|strong="H1961"\w* últimos años de Job más \w que|strong="H1961"\w* \w los|strong="H1961"\w* primeros, \w pues|strong="H1961"\w* llegó \w a|strong="H3068"\w* \w tener|strong="H1961"\w* catorce mil \w ovejas|strong="H6629"\w*, \w seis|strong="H8337"\w* mil \w camellos|strong="H1581"\w*, mil \w yuntas|strong="H6776"\w* de \w bueyes|strong="H1241"\w* \w y|strong="H1241"\w* mil asnas.  
\v 13 También \w tuvo|strong="H1961"\w* otros siete \w hijos|strong="H1121"\w* y \w tres|strong="H7969"\w* \w hijas|strong="H1323"\w*.  
\v 14 \w A|strong="H3068"\w* la primera hija la \w llamó|strong="H7121"\w* Jemima, \w a|strong="H3068"\w* la \w segunda|strong="H8145"\w* la \w llamó|strong="H7121"\w* Cesia, y \w a|strong="H3068"\w* la \w tercera|strong="H7992"\w*, Queren-hapuc.  
\v 15 \w En|strong="H8432"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país \w no|strong="H3808"\w* \w había|strong="H4672"\w* \w mujeres|strong="H1323"\w* tan \w hermosas|strong="H3303"\w* como \w las|strong="H1992"\w* \w hijas|strong="H1323"\w* \w de|strong="H5414"\w* Job. Además, \w su|strong="H1992"\w* padre \w les|strong="H1992"\w* \w dio|strong="H5414"\w* \w una|strong="H4672"\w* \w herencia|strong="H5159"\w* igual \w que|strong="H3808"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* hermanos.  
\v 16 Job \w vivió|strong="H2421"\w* todavía \w ciento|strong="H3967"\w* cuarenta \w años|strong="H8141"\w*, y llegó \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, \w nietos|strong="H1121"\w*, bisnietos y tataranietos.  
\v 17 Finalmente, Job \w murió|strong="H4191"\w* \w a|strong="H3068"\w* una \w edad|strong="H3117"\w* muy avanzada, habiendo disfrutado de una \w vida|strong="H3117"\w* plena.   