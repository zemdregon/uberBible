\id JOB  
\h JOB 
\toc3 Job 
\toc1 JOB 
\toc2 JOB 
\mt1 Job  
\c 1  
\p
\v 1 \w En|strong="H5493"\w* \w la|strong="H1931"\w* región \w de|strong="H7451"\w* \w Uz|strong="H5780"\w* vivía un hombre \w llamado|strong="H8034"\w* Job. \w Era|strong="H1961"\w* un hombre \w íntegro|strong="H8535"\w* y \w recto|strong="H3477"\w*, \w que|strong="H1931"\w* respetaba \w a|strong="H3068"\w* Dios y \w se|strong="H1961"\w* apartaba del \w mal|strong="H7451"\w*.  
\v 2 Tuvo \w siete|strong="H7651"\w* \w hijos|strong="H1121"\w* y \w tres|strong="H7969"\w* \w hijas|strong="H1323"\w*.  
\v 3 \w Sus|strong="H1931"\w* posesiones \w eran|strong="H1961"\w* \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*, \w tres|strong="H7969"\w* \w mil|strong="H3967"\w* \w camellos|strong="H1581"\w*, \w quinientas|strong="H2568"\w* \w yuntas|strong="H6776"\w* \w de|strong="H2568"\w* \w bueyes|strong="H1241"\w* \w y|strong="H1241"\w* \w quinientas|strong="H2568"\w* burras, además \w de|strong="H2568"\w* muchísimos sirvientes. Job \w era|strong="H1961"\w* \w el|strong="H1931"\w* \w hombre|strong="H1121"\w* \w más|strong="H7227"\w* importante \w de|strong="H2568"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w pueblos|strong="H2568"\w* del \w oriente|strong="H6924"\w*.  
\v 4 Sus \w hijos|strong="H1121"\w* acostumbraban \w celebrar|strong="H6213"\w* \w banquetes|strong="H4960"\w* \w en|strong="H5973"\w* sus \w casas|strong="H1004"\w*, \w cada|strong="H3117"\w* uno \w en|strong="H5973"\w* su propio cumpleaños, \w e|strong="H3068"\w* invitaban \w a|strong="H3068"\w* sus \w tres|strong="H7969"\w* hermanas \w a|strong="H3068"\w* comer y \w beber|strong="H8354"\w* \w con|strong="H5973"\w* ellos.  
\v 5 \w Cuando|strong="H3588"\w* terminaba \w el|strong="H3588"\w* ciclo \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w banquetes|strong="H4960"\w*, Job \w los|strong="H1121"\w* mandaba llamar \w para|strong="H3588"\w* purificarlos. \w Se|strong="H1961"\w* levantaba muy temprano \w y|strong="H3588"\w* ofrecía sacrificios \w por|strong="H3588"\w* \w cada|strong="H3605"\w* uno \w de|strong="H3588"\w* \w ellos|strong="H3605"\w*, \w pues|strong="H3588"\w* pensaba: “Tal vez mis \w hijos|strong="H1121"\w* \w pecaron|strong="H2398"\w* \w y|strong="H3588"\w* renunciaron \w a|strong="H3068"\w* Dios \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w corazón|strong="H3824"\w*”. Job \w hacía|strong="H6213"\w* \w esto|strong="H3602"\w* \w siempre|strong="H3605"\w*.   
\p
\v 6 Un \w día|strong="H3117"\w*, \w los|strong="H1121"\w* ángeles \w se|strong="H1961"\w* presentaron ante Yahvé, \w y|strong="H1571"\w* \w entre|strong="H8432"\w* \w ellos|strong="H5921"\w* llegó \w también|strong="H1571"\w* Satanás.  
\v 7 Yahvé le preguntó \w a|strong="H3068"\w* Satanás: “¿De dónde vienes?”  
\p Satanás le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* Yahvé: “Vengo de rondar la tierra y de recorrerla de un extremo \w a|strong="H3068"\w* otro”.   
\p
\v 8 Yahvé \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Satanás: “¿\w Te|strong="H5921"\w* has fijado \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* Job? \w No|strong="H3588"\w* hay nadie \w como|strong="H3588"\w* \w él|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra; \w es|strong="H3588"\w* un hombre \w íntegro|strong="H8535"\w* \w y|strong="H3588"\w* \w recto|strong="H3477"\w*, \w que|strong="H3588"\w* \w me|strong="H5921"\w* respeta \w y|strong="H3588"\w* \w se|strong="H5921"\w* \w aparta|strong="H5493"\w* \w del|strong="H5921"\w* \w mal|strong="H7451"\w*”.   
\p
\v 9 Satanás le \w respondió|strong="H6030"\w* \w a|strong="H3068"\w* Yahvé: “¿\w Y|strong="H3068"\w* acaso Job te respeta por nada?  
\v 10 ¿Acaso \w no|strong="H3808"\w* \w lo|strong="H3808"\w* has protegido \w a|strong="H3068"\w* \w él|strong="H3605"\w*, \w a|strong="H3068"\w* su \w familia|strong="H1004"\w* y \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* tiene? Has bendecido \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* hace, y sus riquezas han aumentado \w por|strong="H1157"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* país.  
\v 11 Pero trata \w de|strong="H5921"\w* quitarle \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* posee, \w y|strong="H5921"\w* verás \w cómo|strong="H5921"\w* \w te|strong="H5921"\w* maldice \w en|strong="H5921"\w* tu propia \w cara|strong="H6440"\w*”.   
\p
\v 12 Yahvé \w le|strong="H5973"\w* contestó \w a|strong="H3068"\w* Satanás: “Muy bien, \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* tiene está \w en|strong="H5973"\w* tus \w manos|strong="H3027"\w*. Pero \w a|strong="H3068"\w* \w él|strong="H5973"\w* \w no|strong="H6440"\w* \w lo|strong="H3605"\w* toques”.  
\p Entonces Satanás \w salió|strong="H3318"\w* \w de|strong="H6440"\w* \w la|strong="H3605"\w* \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé.  
\v 13 Un \w día|strong="H3117"\w*, mientras sus \w hijos|strong="H1121"\w* y sus \w hijas|strong="H1323"\w* comían y \w bebían|strong="H8354"\w* \w vino|strong="H3196"\w* en \w casa|strong="H1004"\w* \w del|strong="H8354"\w* hermano mayor,  
\v 14 un \w mensajero|strong="H4397"\w* llegó \w a|strong="H3068"\w* \w donde|strong="H5921"\w* \w estaba|strong="H1961"\w* Job \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo: “Mientras \w los|strong="H5921"\w* \w bueyes|strong="H1241"\w* \w estaban|strong="H1961"\w* arando \w y|strong="H5921"\w* \w las|strong="H5921"\w* burras pastaban \w cerca|strong="H5921"\w* \w de|strong="H5921"\w* \w ellos|strong="H3027"\w*,  
\v 15 los sabeos nos atacaron y se los \w llevaron|strong="H3947"\w*. \w Mataron|strong="H5221"\w* \w a|strong="H3068"\w* los \w criados|strong="H5288"\w* \w a|strong="H3068"\w* filo de \w espada|strong="H2719"\w*, ¡y \w solo|strong="H7535"\w* yo pude \w escapar|strong="H4422"\w* \w para|strong="H7535"\w* contárselo!”.   
\p
\v 16 No había terminado \w de|strong="H4480"\w* \w hablar|strong="H1696"\w* cuando llegó \w otro|strong="H2088"\w* \w y|strong="H1197"\w* \w dijo|strong="H1696"\w*: “\w Cayó|strong="H5307"\w* \w del|strong="H4480"\w* \w cielo|strong="H8064"\w* un rayo \w de|strong="H4480"\w* Dios \w que|strong="H4480"\w* quemó \w a|strong="H3068"\w* las \w ovejas|strong="H6629"\w* \w y|strong="H1197"\w* \w a|strong="H3068"\w* los pastores \w por|strong="H4480"\w* igual, \w y|strong="H1197"\w* los consumió. ¡\w Solo|strong="H7535"\w* \w yo|strong="H4480"\w* pude \w escapar|strong="H4422"\w* \w para|strong="H4480"\w* contarlo!”.   
\p
\v 17 \w Todavía|strong="H5750"\w* \w estaba|strong="H7760"\w* \w este|strong="H2088"\w* \w hablando|strong="H1696"\w* cuando llegó \w otro|strong="H2088"\w* \w y|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w Los|strong="H5921"\w* \w caldeos|strong="H3778"\w*, divididos \w en|strong="H5921"\w* \w tres|strong="H7969"\w* grupos, \w se|strong="H5921"\w* lanzaron \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w los|strong="H5921"\w* \w llevaron|strong="H3947"\w*. \w Mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w criados|strong="H5288"\w* \w a|strong="H3068"\w* filo \w de|strong="H5921"\w* \w espada|strong="H2719"\w*, ¡\w y|strong="H5921"\w* \w solo|strong="H7535"\w* yo pude \w escapar|strong="H4422"\w* \w para|strong="H5921"\w* contárselo!”.   
\p
\v 18 \w Mientras|strong="H5704"\w* \w este|strong="H2088"\w* seguía \w hablando|strong="H1696"\w*, \w llegó|strong="H5704"\w* uno \w más|strong="H5704"\w* \w y|strong="H5704"\w* \w dijo|strong="H1696"\w*: “Tus \w hijos|strong="H1121"\w* \w y|strong="H5704"\w* tus \w hijas|strong="H1323"\w* estaban comiendo \w y|strong="H5704"\w* \w bebiendo|strong="H8354"\w* \w vino|strong="H3196"\w* \w en|strong="H5704"\w* \w casa|strong="H1004"\w* \w de|strong="H5704"\w* su hermano mayor,  
\v 19 cuando \w de|strong="H5921"\w* pronto un \w viento|strong="H7307"\w* fuertísimo \w vino|strong="H5307"\w* \w del|strong="H5921"\w* \w desierto|strong="H4057"\w* \w y|strong="H5921"\w* golpeó \w las|strong="H5921"\w* cuatro \w esquinas|strong="H6438"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w*. \w La|strong="H5921"\w* \w casa|strong="H1004"\w* \w se|strong="H5921"\w* derrumbó \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* jóvenes \w y|strong="H5921"\w* todos \w murieron|strong="H4191"\w*. ¡\w Solo|strong="H7535"\w* \w yo|strong="H2009"\w* pude \w escapar|strong="H4422"\w* \w para|strong="H5921"\w* contarlo!”.   
\p
\v 20 Entonces Job se \w levantó|strong="H6965"\w*, se \w rasgó|strong="H7167"\w* la ropa, se rapó la \w cabeza|strong="H7218"\w*, se inclinó hasta \w el|strong="H5307"\w* suelo y \w adoró|strong="H7812"\w*.  
\v 21 \w Y|strong="H3068"\w* dijo: “\w Desnudo|strong="H6174"\w* \w salí|strong="H3318"\w* del vientre \w de|strong="H5414"\w* \w mi|strong="H1961"\w* madre y \w desnudo|strong="H6174"\w* \w volveré|strong="H7725"\w* \w allá|strong="H8033"\w*. Yahvé me lo \w dio|strong="H5414"\w*, y Yahvé me lo \w quitó|strong="H3947"\w*. ¡\w Bendito|strong="H1288"\w* \w sea|strong="H1961"\w* el \w nombre|strong="H8034"\w* \w de|strong="H5414"\w* Yahvé!”.  
\v 22 \w A|strong="H3068"\w* pesar \w de|strong="H5414"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, Job \w no|strong="H3808"\w* \w pecó|strong="H2398"\w* \w ni|strong="H3808"\w* acusó \w a|strong="H3068"\w* Dios \w de|strong="H5414"\w* \w haber|strong="H3808"\w* actuado mal.   
\c 2  
\p
\v 1 Otro \w día|strong="H3117"\w*, \w los|strong="H1121"\w* ángeles volvieron \w a|strong="H3068"\w* presentarse ante Yahvé, \w y|strong="H1571"\w* Satanás \w también|strong="H1571"\w* \w fue|strong="H1961"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w* \w para|strong="H5921"\w* presentarse ante \w él|strong="H5921"\w*.  
\v 2 Yahvé le preguntó \w a|strong="H3068"\w* Satanás: “¿De dónde vienes?”  
\p Satanás le \w respondió|strong="H6030"\w*: “Vengo de rondar la tierra y de recorrerla de un extremo \w a|strong="H3068"\w* \w otro|strong="H2088"\w*”.   
\p
\v 3 \w Entonces|strong="H5493"\w* Yahvé le dijo: “¿\w Te|strong="H3588"\w* has fijado \w en|strong="H3588"\w* mi \w siervo|strong="H5650"\w* Job? \w No|strong="H3588"\w* \w hay|strong="H5750"\w* nadie \w como|strong="H3588"\w* \w él|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra. \w Es|strong="H3588"\w* un hombre \w íntegro|strong="H8535"\w* \w y|strong="H3588"\w* \w recto|strong="H3477"\w*, \w que|strong="H3588"\w* \w me|strong="H3588"\w* respeta \w y|strong="H3588"\w* evita \w el|strong="H3588"\w* \w mal|strong="H7451"\w*. \w Todavía|strong="H5750"\w* mantiene \w su|strong="H3588"\w* integridad, \w a|strong="H3068"\w* pesar \w de|strong="H3588"\w* \w que|strong="H3588"\w* tú \w me|strong="H3588"\w* provocaste \w para|strong="H3588"\w* \w que|strong="H3588"\w* lo destruyera sin ningún motivo”.   
\p
\v 4 Satanás \w respondió|strong="H6030"\w*: “¡\w Piel|strong="H5785"\w* \w por|strong="H1157"\w* \w piel|strong="H5785"\w*! \w El|strong="H3605"\w* hombre está dispuesto \w a|strong="H3068"\w* \w dar|strong="H5414"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1157"\w* tiene \w a|strong="H3068"\w* cambio \w de|strong="H5414"\w* su \w vida|strong="H5315"\w*.  
\v 5 Pero trata \w de|strong="H6440"\w* herirlo en su propio cuerpo, y verás \w cómo|strong="H5060"\w* te maldice en tu propia \w cara|strong="H6440"\w*”.   
\p
\v 6 Yahvé le contestó \w a|strong="H3068"\w* Satanás: “Está bien, Job está en tus \w manos|strong="H3027"\w*; pero respétale \w la|strong="H8104"\w* \w vida|strong="H5315"\w*”.   
\p
\v 7 Satanás \w salió|strong="H3318"\w* \w de|strong="H6440"\w* la \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w y|strong="H5704"\w* le \w salieron|strong="H3318"\w* llagas terribles \w a|strong="H3068"\w* Job, \w desde|strong="H5704"\w* la planta del \w pie|strong="H7272"\w* \w hasta|strong="H5704"\w* la cabeza.  
\v 8 Job agarró un pedazo de barro para rascarse, y \w se|strong="H1931"\w* sentó \w entre|strong="H8432"\w* las cenizas.  
\v 9 Su mujer le dijo: “¿\w Todavía|strong="H5750"\w* insistes \w en|strong="H5750"\w* serle fiel \w a|strong="H3068"\w* Dios? ¡Renuncia \w a|strong="H3068"\w* Dios y muérete \w de|strong="H5750"\w* una vez!”   
\p
\v 10 Pero Job le respondió: “\w Estás|strong="H2063"\w* \w hablando|strong="H1696"\w* \w como|strong="H1571"\w* una mujer tonta. \w Si|strong="H1571"\w* aceptamos las \w cosas|strong="H7451"\w* \w buenas|strong="H2896"\w* \w que|strong="H3808"\w* Dios nos da, ¿por \w qué|strong="H3808"\w* \w no|strong="H3808"\w* vamos \w a|strong="H3068"\w* aceptar \w también|strong="H1571"\w* las \w malas|strong="H7451"\w*?”  
\p \w A|strong="H3068"\w* pesar \w de|strong="H7451"\w* \w todo|strong="H3605"\w*, Job \w no|strong="H3808"\w* \w pecó|strong="H2398"\w* al decir \w estas|strong="H2063"\w* \w cosas|strong="H7451"\w*.  
\v 11 \w Tres|strong="H7969"\w* \w amigos|strong="H7453"\w* \w de|strong="H5921"\w* Job \w se|strong="H5921"\w* enteraron \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* desgracia \w que|strong="H5921"\w* \w le|strong="H5921"\w* había pasado \w y|strong="H5921"\w* fueron \w a|strong="H3068"\w* verlo \w desde|strong="H5921"\w* sus propios países. Eran Elifaz \w de|strong="H5921"\w* Temán, \w Bildad|strong="H1085"\w* \w de|strong="H5921"\w* Súaj \w y|strong="H5921"\w* Zofar \w de|strong="H5921"\w* Naamat. \w Los|strong="H5921"\w* \w tres|strong="H7969"\w* \w se|strong="H5921"\w* pusieron \w de|strong="H5921"\w* acuerdo \w para|strong="H5921"\w* ir \w juntos|strong="H3162"\w* \w a|strong="H3068"\w* acompañarlo \w en|strong="H5921"\w* su dolor \w y|strong="H5921"\w* consolarlo.  
\v 12 Cuando \w lo|strong="H3808"\w* vieron \w desde|strong="H5921"\w* \w lejos|strong="H7350"\w*, casi \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w reconocieron|strong="H5234"\w*. Empezaron \w a|strong="H3068"\w* llorar \w a|strong="H3068"\w* gritos, \w se|strong="H5921"\w* \w rasgaron|strong="H7167"\w* \w la|strong="H5921"\w* ropa \w y|strong="H5921"\w* lanzaron \w polvo|strong="H6083"\w* \w al|strong="H5921"\w* aire \w sobre|strong="H5921"\w* sus \w cabezas|strong="H7218"\w* \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* duelo.  
\v 13 Luego se \w sentaron|strong="H3427"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* suelo \w con|strong="H3588"\w* \w él|strong="H3588"\w* durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w y|strong="H3588"\w* \w siete|strong="H7651"\w* \w noches|strong="H3915"\w*. Nadie le decía \w nada|strong="H1697"\w*, \w porque|strong="H3588"\w* \w veían|strong="H7200"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* sufrimiento era demasiado \w grande|strong="H3966"\w*.   
\c 3  
\p
\v 1 Después de \w esto|strong="H3651"\w*, Job rompió el silencio y \w maldijo|strong="H7043"\w* el \w día|strong="H3117"\w* de su nacimiento.  
\v 2 Así comenzó \w a|strong="H3068"\w* hablar:   
\q1
\v 3 “\w Que|strong="H3117"\w* desaparezca el \w día|strong="H3117"\w* en \w que|strong="H3117"\w* \w nací|strong="H3205"\w*,  
\q2 y la \w noche|strong="H3915"\w* en \w que|strong="H3117"\w* se dijo: ‘Un niño ha sido concebido’.   
\q1
\v 4 \w Que|strong="H1931"\w* \w ese|strong="H1931"\w* \w día|strong="H3117"\w* \w se|strong="H1961"\w* vuelva \w oscuridad|strong="H2822"\w*;  
\q2 \w que|strong="H1931"\w* Dios \w desde|strong="H5921"\w* \w lo|strong="H1931"\w* \w alto|strong="H4605"\w* \w no|strong="H1961"\w* \w lo|strong="H1931"\w* tome \w en|strong="H5921"\w* cuenta,  
\q2 ni \w que|strong="H1931"\w* \w la|strong="H1931"\w* luz brille \w sobre|strong="H5921"\w* \w él|strong="H1931"\w*.   
\q1
\v 5 \w Que|strong="H5921"\w* \w lo|strong="H5921"\w* reclamen \w las|strong="H5921"\w* \w tinieblas|strong="H2822"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* sombra \w de|strong="H5921"\w* \w muerte|strong="H6757"\w*;  
\q2 \w que|strong="H5921"\w* una nube \w lo|strong="H5921"\w* cubra \w por|strong="H5921"\w* completo,  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* aterre todo \w lo|strong="H5921"\w* \w que|strong="H5921"\w* oscurece \w el|strong="H5921"\w* \w día|strong="H3117"\w*.   
\q1
\v 6 \w Que|strong="H1931"\w* una oscuridad profunda \w se|strong="H1931"\w* apodere de \w esa|strong="H1931"\w* \w noche|strong="H3915"\w*;  
\q2 \w que|strong="H1931"\w* no \w la|strong="H1931"\w* cuenten entre \w los|strong="H1931"\w* \w días|strong="H3117"\w* del \w año|strong="H8141"\w*,  
\q2 ni \w la|strong="H1931"\w* incluyan en \w el|strong="H1931"\w* \w número|strong="H4557"\w* de \w los|strong="H1931"\w* \w meses|strong="H3391"\w*.   
\q1
\v 7 ¡\w Que|strong="H1931"\w* \w esa|strong="H1931"\w* \w noche|strong="H3915"\w* \w sea|strong="H1961"\w* estéril!  
\q2 ¡\w Que|strong="H1931"\w* \w no|strong="H1961"\w* \w se|strong="H1961"\w* oigan en \w ella|strong="H1931"\w* gritos de alegría!   
\q1
\v 8 \w Que|strong="H3117"\w* la maldigan los \w que|strong="H3117"\w* maldicen el \w día|strong="H3117"\w*,  
\q2 esos \w que|strong="H3117"\w* son expertos en despertar al Leviatán.   
\q1
\v 9 Que se apaguen las \w estrellas|strong="H3556"\w* de su amanecer;  
\q2 que esa noche \w espere|strong="H6960"\w* la luz y nunca llegue,  
\q2 que no \w vea|strong="H7200"\w* las primeras luces de la aurora.   
\q1
\v 10 \w Pues|strong="H3588"\w* \w no|strong="H3808"\w* \w cerró|strong="H5462"\w* las \w puertas|strong="H1817"\w* del vientre \w de|strong="H3588"\w* mi madre,  
\q2 \w ni|strong="H3808"\w* \w me|strong="H3588"\w* evitó ver tanto sufrimiento.   
\b  
\q1
\v 11 “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* \w morí|strong="H4191"\w* al nacer?  
\q2 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* perdí la vida al \w salir|strong="H3318"\w* del vientre?   
\q1
\v 12 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* hubo \w rodillas|strong="H1290"\w* \w para|strong="H3588"\w* recibirme  
\q2 \w y|strong="H3588"\w* \w pechos|strong="H7699"\w* \w para|strong="H3588"\w* amamantarme?   
\q1
\v 13 \w Ahora|strong="H6258"\w* estaría \w yo|strong="H3588"\w* \w acostado|strong="H7901"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* paz;  
\q2 dormiría \w y|strong="H3588"\w* tendría descanso   
\q1
\v 14 \w junto|strong="H5973"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* \w reyes|strong="H4428"\w* y \w consejeros|strong="H3289"\w* \w de|strong="H5973"\w* la tierra,  
\q2 que \w para|strong="H5973"\w* sí mismos construyeron monumentos ahora \w en|strong="H5973"\w* ruinas;   
\q1
\v 15 \w o|strong="H3068"\w* \w con|strong="H5973"\w* \w los|strong="H1992"\w* \w príncipes|strong="H8269"\w* \w que|strong="H1992"\w* acumulaban \w oro|strong="H2091"\w*  
\q2 y llenaban \w sus|strong="H1992"\w* palacios \w de|strong="H5973"\w* \w plata|strong="H3701"\w*.   
\q1
\v 16 ¿Por \w qué|strong="H3808"\w* \w no|strong="H3808"\w* me enterraron \w como|strong="H1961"\w* \w a|strong="H3068"\w* un aborto,  
\q2 \w como|strong="H1961"\w* \w a|strong="H3068"\w* esos \w niños|strong="H5768"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w vieron|strong="H7200"\w* la luz?   
\q1
\v 17 \w Allí|strong="H8033"\w* los malvados \w dejan|strong="H2308"\w* de causar problemas,  
\q2 y \w allí|strong="H8033"\w* \w descansan|strong="H5117"\w* los \w que|strong="H3581"\w* ya \w no|strong="H2308"\w* tienen \w fuerzas|strong="H3581"\w*.   
\q1
\v 18 Allí los prisioneros por fin viven tranquilos,  
\q2 ya \w no|strong="H3808"\w* tienen \w que|strong="H3808"\w* \w oír|strong="H8085"\w* los gritos del capataz.   
\q1
\v 19 \w Allí|strong="H8033"\w* están tanto \w el|strong="H1931"\w* \w pequeño|strong="H6996"\w* \w como|strong="H1931"\w* \w el|strong="H1931"\w* \w grande|strong="H1419"\w*,  
\q2 y \w el|strong="H1931"\w* esclavo \w se|strong="H1931"\w* libra de \w su|strong="H1931"\w* amo.   
\b  
\q1
\v 20 “¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w se|strong="H4100"\w* le \w da|strong="H5414"\w* luz al \w que|strong="H4100"\w* sufre,  
\q2 y \w vida|strong="H5315"\w* \w a|strong="H3068"\w* los \w que|strong="H4100"\w* están amargados?   
\q1
\v 21 Anhelan la \w muerte|strong="H4194"\w* y no llega,  
\q2 aunque la buscan más que \w a|strong="H3068"\w* \w tesoros|strong="H4301"\w* escondidos.   
\q1
\v 22 Se llenan \w de|strong="H3588"\w* muchísima alegría  
\q2 \w y|strong="H3588"\w* se ponen felices \w cuando|strong="H3588"\w* encuentran \w la|strong="H3588"\w* tumba.   
\q1
\v 23 ¿\w Por|strong="H1157"\w* \w qué|strong="H1157"\w* darle luz \w al|strong="H1157"\w* \w hombre|strong="H1397"\w* \w que|strong="H1157"\w* \w no|strong="H1870"\w* \w sabe|strong="H5641"\w* \w a|strong="H3068"\w* dónde \w va|strong="H3068"\w*,  
\q2 \w al|strong="H1157"\w* \w que|strong="H1157"\w* Dios ha dejado encerrado?   
\q1
\v 24 Mis suspiros \w son|strong="H3588"\w* mi \w pan|strong="H3899"\w* \w de|strong="H3588"\w* cada día,  
\q2 \w y|strong="H3588"\w* mis lamentos se derraman \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w agua|strong="H4325"\w*.   
\q1
\v 25 Lo \w que|strong="H3588"\w* \w más|strong="H3588"\w* \w temía|strong="H3025"\w*, \w me|strong="H3588"\w* sucedió;  
\q2 lo \w que|strong="H3588"\w* \w me|strong="H3588"\w* causaba \w miedo|strong="H6343"\w*, \w me|strong="H3588"\w* alcanzó.   
\q1
\v 26 \w No|strong="H3808"\w* tengo paz \w ni|strong="H3808"\w* calma;  
\q2 \w no|strong="H3808"\w* tengo descanso, solo me vienen problemas”.   
\c 4  
\p
\v 1 Entonces Elifaz de Temán \w respondió|strong="H6030"\w*:   
\q1
\v 2 “Si alguien intentara hablarte, ¿te molestaría?  
\q2 Pero, ¿\w quién|strong="H4310"\w* podría quedarse callado?   
\q1
\v 3 Tú mismo has instruido \w a|strong="H3068"\w* \w mucha|strong="H7227"\w* gente  
\q2 y has fortalecido \w a|strong="H3068"\w* los \w que|strong="H3027"\w* estaban débiles.   
\q1
\v 4 Tus \w palabras|strong="H4405"\w* animaban al que tropezaba  
\q2 y dabas firmeza \w a|strong="H3068"\w* las \w rodillas|strong="H1290"\w* que flaqueaban.   
\q1
\v 5 \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w toca|strong="H5060"\w* \w a|strong="H3068"\w* ti, \w te|strong="H3588"\w* desanimas;  
\q2 \w el|strong="H3588"\w* mal \w te|strong="H3588"\w* alcanza, \w y|strong="H3588"\w* \w te|strong="H3588"\w* llenas \w de|strong="H3588"\w* miedo.   
\q1
\v 6 ¿\w No|strong="H3808"\w* debería tu respeto \w a|strong="H3068"\w* Dios darte confianza?  
\q2 ¿\w No|strong="H3808"\w* debería tu vida íntegra darte \w esperanza|strong="H8615"\w*?   
\b  
\q1
\v 7 “Ponte \w a|strong="H3068"\w* pensar: ¿cuándo ha muerto un \w inocente|strong="H5355"\w*?  
\q2 ¿\w Dónde|strong="H1931"\w* \w se|strong="H1931"\w* ha visto \w que|strong="H4310"\w* destruyan \w a|strong="H3068"\w* \w la|strong="H1931"\w* gente honrada?   
\q1
\v 8 Según mi experiencia, los que cultivan la maldad  
\q2 y siembran problemas, eso mismo cosechan.   
\q1
\v 9 Dios sopla sobre ellos y los destruye;  
\q2 el \w soplo|strong="H5397"\w* \w de|strong="H5397"\w* su enojo los consume.   
\q1
\v 10 Aunque el \w león|strong="H7826"\w* ruja y el cachorro gruña,  
\q2 \w a|strong="H3068"\w* los leones más fuertes les rompen los \w dientes|strong="H8127"\w*.   
\q1
\v 11 \w El|strong="H1121"\w* león viejo muere por falta \w de|strong="H1121"\w* \w comida|strong="H2964"\w*  
\q2 y \w los|strong="H1121"\w* cachorros \w de|strong="H1121"\w* la leona se dispersan por \w el|strong="H1121"\w* mundo.   
\b  
\q1
\v 12 “Recibí un mensaje \w en|strong="H4480"\w* secreto;  
\q2 mis oídos apenas percibieron un susurro.   
\q1
\v 13 \w Entre|strong="H5921"\w* pesadillas \w y|strong="H5921"\w* \w visiones|strong="H2384"\w* \w nocturnas|strong="H3915"\w*,  
\q2 cuando \w el|strong="H5921"\w* sueño profundo \w cae|strong="H5307"\w* \w sobre|strong="H5921"\w* todos,   
\q1
\v 14 me invadió un \w miedo|strong="H6343"\w* terrible;  
\q2 ¡\w todos|strong="H7230"\w* mis \w huesos|strong="H6106"\w* se pusieron \w a|strong="H3068"\w* temblar!   
\q1
\v 15 Un \w espíritu|strong="H7307"\w* pasó frente \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w cara|strong="H6440"\w*,  
\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* erizó todo \w el|strong="H5921"\w* vello \w del|strong="H5921"\w* cuerpo.   
\q1
\v 16 El espíritu \w se|strong="H3808"\w* detuvo, pero \w no|strong="H3808"\w* pude ver cómo era;  
\q2 una sombra \w estaba|strong="H5975"\w* \w frente|strong="H5048"\w* \w a|strong="H3068"\w* mis \w ojos|strong="H5869"\w*.  
\q2 \w En|strong="H5975"\w* medio del silencio, \w oí|strong="H8085"\w* una \w voz|strong="H6963"\w* \w que|strong="H3808"\w* decía:   
\q1
\v 17 ‘¿Puede un simple mortal ser más justo que Dios?  
\q2 ¿Puede un \w hombre|strong="H1397"\w* ser más puro que su Creador?’.   
\q1
\v 18 \w Si|strong="H2005"\w* Dios \w no|strong="H3808"\w* confía \w ni|strong="H3808"\w* en sus propios \w ángeles|strong="H4397"\w*,  
\q2 y hasta en ellos encuentra errores,   
\q1
\v 19 ¡cuánto menos confiará en los hombres!  
\q2 Ellos viven en cuerpos \w de|strong="H6440"\w* \w barro|strong="H2563"\w* que nacen del \w polvo|strong="H6083"\w*  
\q2 y son aplastados más fácil que una \w polilla|strong="H6211"\w*.   
\q1
\v 20 Se mueren \w entre|strong="H1097"\w* la \w mañana|strong="H1242"\w* y la \w tarde|strong="H6153"\w*;  
\q2 desaparecen para siempre y \w a|strong="H3068"\w* nadie \w le|strong="H1242"\w* importa.   
\q1
\v 21 \w Se|strong="H3808"\w* les arrancan las cuerdas de su tienda,  
\q2 y \w mueren|strong="H4191"\w* \w sin|strong="H3808"\w* \w haber|strong="H3808"\w* alcanzado \w sabiduría|strong="H2451"\w*”.   
\c 5  
\b  
\q1
\v 1 “¡Anda, \w llama|strong="H7121"\w* \w ahora|strong="H4994"\w*! ¿Crees \w que|strong="H4310"\w* alguien te \w responderá|strong="H6030"\w*?  
\q2 ¿\w A|strong="H3068"\w* \w cuál|strong="H4310"\w* de los ángeles te vas \w a|strong="H3068"\w* dirigir?   
\q1
\v 2 \w Es|strong="H3588"\w* \w el|strong="H3588"\w* enojo lo \w que|strong="H3588"\w* \w mata|strong="H4191"\w* al necio,  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* resentimiento lo \w que|strong="H3588"\w* destruye al tonto.   
\q1
\v 3 \w Yo|strong="H5344"\w* mismo he \w visto|strong="H7200"\w* al insensato echar raíces,  
\q2 pero de repente declaré maldito su hogar.   
\q1
\v 4 Sus \w hijos|strong="H1121"\w* nunca están seguros;  
\q2 en \w el|strong="H1121"\w* tribunal son maltratados  
\q2 y no hay nadie \w que|strong="H1121"\w* \w los|strong="H1121"\w* defienda.   
\q1
\v 5 Los hambrientos se comen su cosecha,  
\q2 sacándola incluso de entre los espinos,  
\q2 y los sedientos se quedan con sus bienes.   
\q1
\v 6 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* sufrimiento \w no|strong="H3808"\w* \w brota|strong="H6779"\w* del \w polvo|strong="H6083"\w*,  
\q2 \w ni|strong="H3808"\w* \w los|strong="H3588"\w* problemas nacen \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w tierra|strong="H6083"\w*;   
\q1
\v 7 \w más|strong="H3588"\w* \w bien|strong="H3588"\w*, \w el|strong="H3588"\w* \w hombre|strong="H1121"\w* \w nace|strong="H3205"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* sufrimiento,  
\q2 \w así|strong="H3588"\w* \w como|strong="H3588"\w* las chispas vuelan hacia \w arriba|strong="H1361"\w*.   
\b  
\q1
\v 8 “Si yo fuera tú, \w buscaría|strong="H1875"\w* \w a|strong="H3068"\w* Dios  
\q2 y ante él presentaría mi caso.   
\q1
\v 9 \w Él|strong="H6213"\w* \w hace|strong="H6213"\w* cosas \w grandes|strong="H1419"\w* \w e|strong="H3068"\w* incomprensibles,  
\q2 \w maravillas|strong="H6381"\w* \w que|strong="H5704"\w* \w no|strong="H6213"\w* se pueden contar.   
\q1
\v 10 \w Él|strong="H5921"\w* manda \w la|strong="H5921"\w* \w lluvia|strong="H4306"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* tierra  
\q2 \w y|strong="H5921"\w* \w envía|strong="H7971"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* campos.   
\q1
\v 11 Él enaltece \w a|strong="H3068"\w* los humildes  
\q2 y pone \w a|strong="H3068"\w* salvo \w a|strong="H3068"\w* los que lloran.   
\q1
\v 12 \w Él|strong="H6213"\w* frustra los planes de los astutos,  
\q2 para \w que|strong="H3808"\w* \w no|strong="H3808"\w* tengan éxito en sus empresas.   
\q1
\v 13 Él atrapa \w a|strong="H3068"\w* \w los|strong="H2450"\w* \w sabios|strong="H2450"\w* en su propia astucia  
\q2 y arruina \w los|strong="H2450"\w* planes de \w los|strong="H2450"\w* tramposos.   
\q1
\v 14 En pleno \w día|strong="H3119"\w* ellos se encuentran con \w tinieblas|strong="H2822"\w*;  
\q2 al mediodía andan \w a|strong="H3068"\w* tientas como si fuera de \w noche|strong="H3915"\w*.   
\q1
\v 15 Pero Dios \w salva|strong="H3467"\w* al pobre de la \w espada|strong="H2719"\w* de su \w boca|strong="H6310"\w*  
\q2 y de las \w manos|strong="H3027"\w* de los poderosos.   
\q1
\v 16 Por eso el necesitado \w tiene|strong="H1961"\w* \w esperanza|strong="H8615"\w*  
\q2 y \w a|strong="H3068"\w* la injusticia \w se|strong="H1961"\w* le tapa la \w boca|strong="H6310"\w*.   
\b  
\q1
\v 17 “¡Qué feliz es el hombre \w a|strong="H3068"\w* quien Dios \w corrige|strong="H3198"\w*!  
\q2 Por eso, no desprecies la disciplina del \w Todopoderoso|strong="H7706"\w*.   
\q1
\v 18 \w Porque|strong="H3588"\w* \w él|strong="H1931"\w* \w hiere|strong="H4272"\w*, \w pero|strong="H3588"\w* también venda \w la|strong="H1931"\w* herida;  
\q2 \w él|strong="H1931"\w* golpea, \w pero|strong="H3588"\w* \w sus|strong="H1931"\w* \w manos|strong="H3027"\w* traen salud.   
\q1
\v 19 \w De|strong="H7451"\w* \w seis|strong="H8337"\w* problemas te \w librará|strong="H5337"\w*,  
\q2 y en el \w séptimo|strong="H7651"\w* el \w mal|strong="H7451"\w* \w no|strong="H3808"\w* te alcanzará.   
\q1
\v 20 En tiempos de \w hambre|strong="H7458"\w* te salvará de la \w muerte|strong="H4194"\w*,  
\q2 y en la \w guerra|strong="H4421"\w* te librará de la \w espada|strong="H2719"\w*.   
\q1
\v 21 Estarás protegido \w de|strong="H3588"\w* las malas lenguas  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* tendrás \w miedo|strong="H3372"\w* \w cuando|strong="H3588"\w* llegue \w la|strong="H3588"\w* \w destrucción|strong="H7701"\w*.   
\q1
\v 22 Te reirás \w de|strong="H3372"\w* la \w destrucción|strong="H7701"\w* y del hambre,  
\q2 y no les \w temerás|strong="H3372"\w* \w a|strong="H3068"\w* los \w animales|strong="H2416"\w* salvajes.   
\q1
\v 23 \w Pues|strong="H3588"\w* hasta \w con|strong="H5973"\w* las piedras \w del|strong="H5973"\w* \w campo|strong="H7704"\w* harás un \w pacto|strong="H1285"\w*,  
\q2 \w y|strong="H3588"\w* las fieras \w del|strong="H5973"\w* \w campo|strong="H7704"\w* vivirán \w en|strong="H5973"\w* \w paz|strong="H7999"\w* \w contigo|strong="H5973"\w*.   
\q1
\v 24 \w Sabrás|strong="H3045"\w* \w que|strong="H3588"\w* \w en|strong="H3588"\w* tu casa hay \w paz|strong="H7965"\w*;  
\q2 revisarás tu corral \w y|strong="H3588"\w* \w no|strong="H3808"\w* faltará \w nada|strong="H3808"\w*.   
\q1
\v 25 Verás \w que|strong="H3588"\w* tu \w descendencia|strong="H2233"\w* será numerosa;  
\q2 tus \w hijos|strong="H2233"\w* serán \w como|strong="H3588"\w* \w la|strong="H3588"\w* \w hierba|strong="H6212"\w* del campo.   
\q1
\v 26 Llegarás \w a|strong="H3068"\w* la tumba en una buena vejez,  
\q2 como se recogen las espigas \w de|strong="H6256"\w* trigo en su temporada.   
\q1
\v 27 \w Esto|strong="H2063"\w* \w es|strong="H1931"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* hemos investigado, y \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w verdad|strong="H3651"\w*.  
\q2 \w Así|strong="H3651"\w* \w que|strong="H1931"\w* escúchalo y compruébalo \w por|strong="H3651"\w* ti \w mismo|strong="H1931"\w*”.   
\b  
\c 6  
\p
\v 1 Entonces Job \w respondió|strong="H6030"\w*:   
\q1
\v 2 “¡Cómo quisiera \w que|strong="H3863"\w* \w mi|strong="H5375"\w* angustia fuera pesada  
\q2 y \w que|strong="H3863"\w* pusieran toda \w mi|strong="H5375"\w* desgracia en la balanza!   
\q1
\v 3 ¡Resultaría \w más|strong="H3588"\w* pesada \w que|strong="H3588"\w* \w la|strong="H5921"\w* arena \w del|strong="H5921"\w* \w mar|strong="H3220"\w*!  
\q2 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* mis \w palabras|strong="H1697"\w* han sido tan amargas.   
\q1
\v 4 \w Porque|strong="H3588"\w* tengo clavadas las flechas \w del|strong="H8354"\w* \w Todopoderoso|strong="H7706"\w*,  
\q2 \w y|strong="H3588"\w* mi \w espíritu|strong="H7307"\w* \w bebe|strong="H8354"\w* \w su|strong="H3588"\w* \w veneno|strong="H2534"\w*;  
\q1 \w los|strong="H3588"\w* terrores \w de|strong="H3588"\w* Dios \w me|strong="H3588"\w* atacan sin descanso.   
\q2
\v 5 ¿Acaso rebuzna \w el|strong="H5921"\w* burro salvaje \w si|strong="H5921"\w* tiene pasto?  
\q1 ¿\w O|strong="H3068"\w* \w muge|strong="H1600"\w* \w el|strong="H5921"\w* \w buey|strong="H7794"\w* \w si|strong="H5921"\w* tiene forraje?   
\q2
\v 6 ¿Se puede comer \w sin|strong="H1097"\w* \w sal|strong="H4417"\w* lo que \w no|strong="H1097"\w* \w tiene|strong="H3426"\w* \w sabor|strong="H2940"\w*?  
\q1 ¿Qué \w gusto|strong="H2940"\w* se le halla \w a|strong="H3068"\w* la clara de huevo?   
\q2
\v 7 Me niego siquiera \w a|strong="H3068"\w* tocarlos;  
\q1 esa \w comida|strong="H3899"\w* me resulta asquerosa.   
\b  
\q1
\v 8 “¡\w Ojalá|strong="H4310"\w* se cumpliera mi \w petición|strong="H7596"\w*,  
\q2 \w que|strong="H4310"\w* Dios \w me|strong="H4310"\w* concediera lo \w que|strong="H4310"\w* tanto deseo!   
\q1
\v 9 ¡\w Que|strong="H3027"\w* Dios se decidiera \w a|strong="H3068"\w* aplastarme de una vez,  
\q2 \w que|strong="H3027"\w* soltara su \w mano|strong="H3027"\w* y me quitara la vida!   
\q1
\v 10 Eso \w me|strong="H3588"\w* serviría \w de|strong="H3588"\w* consuelo;  
\q2 saltaría \w de|strong="H3588"\w* alegría \w en|strong="H3588"\w* medio \w de|strong="H3588"\w* \w mi|strong="H1961"\w* \w dolor|strong="H2427"\w* implacable,  
\q2 \w porque|strong="H3588"\w* \w jamás|strong="H5750"\w* he negado las palabras del \w Santo|strong="H6918"\w*.   
\q1
\v 11 ¿\w Qué|strong="H3588"\w* \w fuerzas|strong="H3581"\w* \w me|strong="H3588"\w* quedan \w para|strong="H3588"\w* seguir \w esperando|strong="H3176"\w*?  
\q2 ¿\w Qué|strong="H3588"\w* destino \w me|strong="H3588"\w* aguarda \w para|strong="H3588"\w* tener paciencia?   
\q1
\v 12 ¿Tengo acaso la \w fuerza|strong="H3581"\w* de las piedras?  
\q2 ¿Es mi \w carne|strong="H1320"\w* de \w bronce|strong="H5153"\w*?   
\q1
\v 13 ¿No ven \w que|strong="H4480"\w* ya no puedo valerme \w por|strong="H4480"\w* mí mismo  
\q2 y \w que|strong="H4480"\w* \w se|strong="H4480"\w* \w me|strong="H4480"\w* han acabado los recursos?   
\b  
\q1
\v 14 “Quien está desesperado merece la ayuda de sus \w amigos|strong="H7453"\w*,  
\q2 incluso si ha dejado de honrar al \w Todopoderoso|strong="H7706"\w*.   
\q1
\v 15 Pero ustedes, hermanos míos, son traicioneros \w como|strong="H3644"\w* un \w arroyo|strong="H5158"\w*,  
\q2 \w como|strong="H3644"\w* esos cauces que se quedan secos;   
\q1
\v 16 \w que|strong="H4480"\w* bajan turbios \w por|strong="H5921"\w* \w el|strong="H5921"\w* hielo  
\q2 \w y|strong="H5921"\w* \w se|strong="H4480"\w* llenan \w con|strong="H5921"\w* \w la|strong="H5921"\w* nieve \w que|strong="H4480"\w* \w se|strong="H4480"\w* derrite,   
\q1
\v 17 pero \w que|strong="H6256"\w* en \w tiempo|strong="H6256"\w* \w de|strong="H6256"\w* sequía se evaporan  
\q2 y \w desaparecen|strong="H1846"\w* en cuanto hace calor.   
\q1
\v 18 Las caravanas se desvían de su ruta buscándolos,  
\q2 se pierden en el desierto y mueren.   
\q1
\v 19 Las caravanas de Temán los buscan con la mirada,  
\q2 los mercaderes de Sabá confían en encontrarlos;   
\q1
\v 20 \w pero|strong="H3588"\w* se frustran \w por|strong="H3588"\w* haber estado tan seguros,  
\q2 \w pues|strong="H3588"\w* \w al|strong="H5704"\w* llegar allí, se quedan decepcionados.   
\q1
\v 21 \w Así|strong="H3588"\w* \w son|strong="H1961"\w* ustedes \w para|strong="H3588"\w* \w mí|strong="H1961"\w* \w ahora|strong="H6258"\w*: \w no|strong="H3808"\w* sirven \w para|strong="H3588"\w* \w nada|strong="H3808"\w*.  
\q2 \w Ven|strong="H7200"\w* \w mi|strong="H1961"\w* desgracia \w y|strong="H3588"\w* \w se|strong="H1961"\w* llenan \w de|strong="H3588"\w* \w miedo|strong="H3372"\w*.   
\q1
\v 22 ¿Acaso les he pedido \w que|strong="H3588"\w* \w me|strong="H3588"\w* den algo,  
\q2 \w o|strong="H3068"\w* \w que|strong="H3588"\w* paguen \w por|strong="H3588"\w* mí \w con|strong="H3588"\w* sus riquezas?   
\q1
\v 23 ¿Les pedí \w que|strong="H3027"\w* me libraran del \w enemigo|strong="H6862"\w*,  
\q2 \w o|strong="H3068"\w* \w que|strong="H3027"\w* me rescataran de \w manos|strong="H3027"\w* de los opresores?   
\b  
\q1
\v 24 “Enséñenme y me quedaré callado;  
\q2 háganme entender en \w qué|strong="H4100"\w* me he equivocado.   
\q1
\v 25 ¡\w Qué|strong="H4100"\w* poderosas son las palabras sinceras!  
\q2 Pero las críticas \w de|strong="H4480"\w* ustedes, ¿\w qué|strong="H4100"\w* demuestran?   
\q1
\v 26 ¿Pretenden \w censurar|strong="H2803"\w* \w lo|strong="H4405"\w* que digo,  
\q2 cuando las \w palabras|strong="H4405"\w* de un desesperado se las lleva el \w viento|strong="H7307"\w*?   
\q1
\v 27 ¡Ustedes serían capaces \w de|strong="H5921"\w* rifarse \w a|strong="H3068"\w* un \w huérfano|strong="H3490"\w*  
\q2 \w y|strong="H5921"\w* \w de|strong="H5921"\w* hacer negocio \w con|strong="H5921"\w* su propio \w amigo|strong="H7453"\w*!   
\q1
\v 28 Tengan \w la|strong="H5921"\w* bondad \w de|strong="H5921"\w* mirarme \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w cara|strong="H6440"\w*;  
\q2 \w les|strong="H5921"\w* aseguro \w que|strong="H6258"\w* \w no|strong="H5921"\w* \w les|strong="H5921"\w* voy \w a|strong="H3068"\w* mentir.   
\q1
\v 29 Recapaciten, \w por|strong="H5750"\w* favor; \w no|strong="H1961"\w* \w sean|strong="H1961"\w* injustos.  
\q2 Piénsenlo bien, \w que|strong="H4994"\w* \w en|strong="H5750"\w* esto me \w va|strong="H3068"\w* la \w justicia|strong="H6664"\w*.   
\q1
\v 30 ¿\w Hay|strong="H3426"\w* \w maldad|strong="H5766"\w* en mi \w lengua|strong="H3956"\w*?  
\q2 ¿Acaso mi paladar \w no|strong="H3808"\w* distingue la amargura?”   
\c 7  
\b  
\q1
\v 1 “¿\w No|strong="H3808"\w* tiene \w el|strong="H5921"\w* hombre \w que|strong="H3808"\w* luchar duramente \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra?  
\q2 ¿\w No|strong="H3808"\w* \w son|strong="H3808"\w* sus \w días|strong="H3117"\w* \w como|strong="H5921"\w* \w los|strong="H5921"\w* \w de|strong="H5921"\w* un trabajador \w que|strong="H3808"\w* vive \w al|strong="H5921"\w* \w día|strong="H3117"\w*?   
\q1
\v 2 Como el esclavo que \w anhela|strong="H7602"\w* la \w sombra|strong="H6738"\w*,  
\q2 como el obrero que \w espera|strong="H6960"\w* impaciente su salario,   
\q1
\v 3 \w así|strong="H3651"\w* me han tocado \w meses|strong="H3391"\w* de vacío,  
\q2 y me han asignado \w noches|strong="H3915"\w* de puro sufrimiento.   
\q1
\v 4 \w Al|strong="H5704"\w* acostarme, pienso:  
\q2 ‘¿Cuánto falta \w para|strong="H5704"\w* \w que|strong="H5704"\w* me levante?’. Pero \w la|strong="H7646"\w* noche se alarga,  
\q2 \w y|strong="H5704"\w* doy vueltas \w en|strong="H5704"\w* \w la|strong="H7646"\w* cama \w hasta|strong="H5704"\w* el amanecer.   
\q1
\v 5 Mi cuerpo está cubierto \w de|strong="H3847"\w* \w gusanos|strong="H7415"\w* y costras \w de|strong="H3847"\w* mugre;  
\q2 mi \w piel|strong="H5785"\w* se agrieta y vuelve \w a|strong="H3068"\w* brotar.   
\q1
\v 6 Mis \w días|strong="H3117"\w* pasan \w más|strong="H4480"\w* rápido \w que|strong="H4480"\w* la lanzadera \w de|strong="H4480"\w* un telar,  
\q2 y \w se|strong="H4480"\w* acaban sin dejar ninguna \w esperanza|strong="H8615"\w*.   
\q1
\v 7 Recuerda, Dios, \w que|strong="H3588"\w* mi \w vida|strong="H2416"\w* \w es|strong="H3588"\w* un suspiro;  
\q2 mis \w ojos|strong="H5869"\w* \w no|strong="H3808"\w* \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* \w ver|strong="H7200"\w* \w la|strong="H3588"\w* felicidad.   
\q1
\v 8 El \w que|strong="H3808"\w* ahora me ve, \w no|strong="H3808"\w* me verá \w más|strong="H3808"\w*;  
\q2 me buscarás con la mirada, pero ya habré desaparecido.   
\q1
\v 9 \w Como|strong="H3651"\w* la \w nube|strong="H6051"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* deshace y \w se|strong="H3808"\w* \w va|strong="H3068"\w*,  
\q2 \w así|strong="H3651"\w* el \w que|strong="H3808"\w* \w baja|strong="H3381"\w* al Seol \w jamás|strong="H3808"\w* vuelve \w a|strong="H3068"\w* \w subir|strong="H5927"\w*.   
\q1
\v 10 \w No|strong="H3808"\w* regresará \w nunca|strong="H3808"\w* \w a|strong="H3068"\w* su \w casa|strong="H1004"\w*,  
\q2 y \w en|strong="H5750"\w* su hogar \w nadie|strong="H3808"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* conocerlo.   
\b  
\q1
\v 11 “Por eso, \w no|strong="H3808"\w* me voy \w a|strong="H3068"\w* quedar callado;  
\q2 voy \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w con|strong="H1571"\w* \w la|strong="H1571"\w* \w angustia|strong="H6862"\w* de \w mi|strong="H5315"\w* \w espíritu|strong="H7307"\w*  
\q2 \w y|strong="H1571"\w* \w a|strong="H3068"\w* quejarme \w con|strong="H1571"\w* \w la|strong="H1571"\w* \w amargura|strong="H4751"\w* de \w mi|strong="H5315"\w* \w alma|strong="H5315"\w*.   
\q1
\v 12 ¿Acaso soy \w yo|strong="H3588"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w o|strong="H3068"\w* un monstruo \w del|strong="H5921"\w* océano,  
\q2 \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w me|strong="H5921"\w* tengas bajo vigilancia?   
\q1
\v 13 \w Cuando|strong="H3588"\w* pienso: ‘\w Mi|strong="H5375"\w* \w cama|strong="H4904"\w* \w me|strong="H3588"\w* dará \w consuelo|strong="H5162"\w*,  
\q2 \w mi|strong="H5375"\w* colchón \w aliviará|strong="H5162"\w* \w mis|strong="H5375"\w* lamentos’,   
\q1
\v 14 entonces me asustas con pesadillas  
\q2 y me aterras con \w visiones|strong="H2384"\w*.   
\q1
\v 15 ¡Prefiero que me estrangulen!  
\q2 ¡Prefiero la \w muerte|strong="H4194"\w* que seguir en este cuerpo!   
\q1
\v 16 Odio mi \w vida|strong="H2421"\w*, \w no|strong="H3808"\w* quiero \w vivir|strong="H2421"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*.  
\q2 \w Déjame|strong="H2308"\w* \w en|strong="H4480"\w* paz, \w que|strong="H3588"\w* mis \w días|strong="H3117"\w* \w no|strong="H3808"\w* tienen sentido.   
\q1
\v 17 ¿\w Qué|strong="H3588"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* ser humano \w para|strong="H3588"\w* \w que|strong="H3588"\w* le des tanta importancia,  
\q2 \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* fijes tanto \w en|strong="H3588"\w* \w él|strong="H3588"\w*,   
\q1
\v 18 para que lo examines cada \w mañana|strong="H1242"\w*  
\q2 y lo pongas \w a|strong="H3068"\w* prueba \w a|strong="H3068"\w* cada \w momento|strong="H7281"\w*?   
\q1
\v 19 ¿\w Cuándo|strong="H4100"\w* vas \w a|strong="H3068"\w* quitarme la vista \w de|strong="H4480"\w* encima?  
\q2 ¡\w Ni|strong="H3808"\w* siquiera \w me|strong="H4480"\w* dejas tragar saliva!   
\q1
\v 20 \w Si|strong="H1961"\w* he \w pecado|strong="H2398"\w*, ¿\w en|strong="H5921"\w* \w qué|strong="H4100"\w* \w te|strong="H5921"\w* afecta \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, Vigilante \w de|strong="H5921"\w* \w los|strong="H5921"\w* hombres?  
\q2 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* \w me|strong="H5921"\w* has tomado \w como|strong="H4100"\w* blanco \w de|strong="H5921"\w* tus ataques?  
\q2 ¿Acaso \w me|strong="H5921"\w* he convertido \w en|strong="H5921"\w* una \w carga|strong="H4853"\w* \w para|strong="H5921"\w* \w ti|strong="H5921"\w*?   
\q1
\v 21 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* perdonas \w mi|strong="H5375"\w* \w pecado|strong="H5771"\w* \w y|strong="H3588"\w* olvidas \w mi|strong="H5375"\w* \w maldad|strong="H5771"\w*?  
\q2 Muy pronto estaré \w acostado|strong="H7901"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w polvo|strong="H6083"\w*;  
\q2 \w por|strong="H3588"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* busques, \w ya|strong="H6258"\w* \w no|strong="H3808"\w* estaré”.   
\c 8  
\p
\v 1 Entonces \w Bildad|strong="H1085"\w* de Súaj \w respondió|strong="H6030"\w*:   
\q1
\v 2 “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H5704"\w* vas \w a|strong="H3068"\w* seguir hablando así?  
\q2 ¡Tus \w palabras|strong="H6310"\w* no \w son|strong="H6310"\w* \w más|strong="H5704"\w* \w que|strong="H5704"\w* un \w viento|strong="H7307"\w* fuerte!   
\q1
\v 3 ¿Acaso Dios tuerce el \w derecho|strong="H4941"\w*?  
\q2 ¿Acaso el \w Todopoderoso|strong="H7706"\w* tuerce la \w justicia|strong="H6664"\w*?   
\q1
\v 4 Si tus \w hijos|strong="H1121"\w* \w pecaron|strong="H2398"\w* contra \w él|strong="H1121"\w*,  
\q2 \w él|strong="H1121"\w* \w dejó|strong="H7971"\w* \w que|strong="H1121"\w* sufrieran las consecuencias \w de|strong="H1121"\w* su \w rebelión|strong="H6588"\w*.   
\q1
\v 5 Pero si tú buscas \w a|strong="H3068"\w* Dios con sinceridad  
\q2 y le ruegas al \w Todopoderoso|strong="H7706"\w*,   
\q1
\v 6 \w y|strong="H3588"\w* \w si|strong="H3588"\w* eres realmente \w puro|strong="H2134"\w* \w y|strong="H3588"\w* honesto,  
\q2 sin duda \w él|strong="H5921"\w* \w se|strong="H5921"\w* levantará \w en|strong="H5921"\w* tu favor  
\q1 \w y|strong="H3588"\w* \w te|strong="H5921"\w* devolverá \w el|strong="H5921"\w* hogar \w que|strong="H3588"\w* \w por|strong="H5921"\w* \w justicia|strong="H6664"\w* \w te|strong="H5921"\w* corresponde.   
\q2
\v 7 Aunque tu comienzo \w fue|strong="H1961"\w* humilde,  
\q1 tu futuro \w será|strong="H1961"\w* grandioso.   
\b  
\q1
\v 8 “Pregúntales \w a|strong="H3068"\w* las \w generaciones|strong="H1755"\w* pasadas;  
\q2 fíjate \w en|strong="H3588"\w* lo \w que|strong="H3588"\w* aprendieron sus antepasados.   
\q1
\v 9 \w Nosotros|strong="H5921"\w* nacimos \w ayer|strong="H8543"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w sabemos|strong="H3045"\w* \w nada|strong="H3808"\w*;  
\q2 nuestros \w días|strong="H3117"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w son|strong="H3588"\w* \w como|strong="H3588"\w* una \w sombra|strong="H6738"\w*.   
\q1
\v 10 ¿\w No|strong="H3808"\w* te enseñarán \w ellos|strong="H1992"\w* y te hablarán?  
\q2 ¿\w No|strong="H3808"\w* compartirán contigo \w su|strong="H1992"\w* sabiduría?   
\b  
\q1
\v 11 “¿Acaso \w crece|strong="H1342"\w* el papiro donde \w no|strong="H3808"\w* hay lodo?  
\q2 ¿Pueden los juncos crecer \w sin|strong="H3808"\w* \w agua|strong="H4325"\w*?   
\q1
\v 12 \w Aunque|strong="H3808"\w* estén verdes y \w nadie|strong="H3808"\w* \w los|strong="H3605"\w* corte,  
\q2 \w se|strong="H3808"\w* marchitan \w antes|strong="H6440"\w* \w que|strong="H3808"\w* \w cualquier|strong="H3605"\w* \w otra|strong="H5750"\w* \w hierba|strong="H2682"\w*.   
\q1
\v 13 \w Así|strong="H3651"\w* les pasa \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* \w se|strong="H3651"\w* olvidan \w de|strong="H7911"\w* Dios;  
\q2 \w así|strong="H3651"\w* \w se|strong="H3651"\w* apaga \w la|strong="H3605"\w* \w esperanza|strong="H8615"\w* \w de|strong="H7911"\w* \w los|strong="H3605"\w* malvados.   
\q1
\v 14 Su \w confianza|strong="H4009"\w* es apenas una hebra,  
\q2 su \w seguridad|strong="H4009"\w* es como una telaraña.   
\q1
\v 15 \w Si|strong="H3808"\w* \w se|strong="H5921"\w* apoyan \w en|strong="H5921"\w* su \w casa|strong="H1004"\w*, \w esta|strong="H5975"\w* \w se|strong="H5921"\w* cae;  
\q2 \w por|strong="H5921"\w* \w más|strong="H5921"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* aferren \w a|strong="H3068"\w* \w ella|strong="H5921"\w*, \w no|strong="H3808"\w* aguanta.   
\q1
\v 16 Son \w como|strong="H5921"\w* una planta \w que|strong="H1931"\w* crece bajo \w el|strong="H1931"\w* \w sol|strong="H8121"\w*  
\q2 \w y|strong="H5921"\w* extiende \w sus|strong="H1931"\w* ramas \w por|strong="H5921"\w* todo \w el|strong="H1931"\w* jardín;   
\q1
\v 17 sus \w raíces|strong="H8328"\w* \w se|strong="H5921"\w* enredan \w entre|strong="H5921"\w* \w las|strong="H5921"\w* rocas  
\q2 \w y|strong="H5921"\w* buscan lugar \w entre|strong="H5921"\w* \w las|strong="H5921"\w* piedras.   
\q1
\v 18 Pero \w si|strong="H3808"\w* la arrancan de su \w sitio|strong="H4725"\w*,  
\q2 el \w lugar|strong="H4725"\w* dirá: ‘\w Jamás|strong="H3808"\w* te he \w visto|strong="H7200"\w*’.   
\q1
\v 19 \w Así|strong="H1931"\w* de breve \w es|strong="H1931"\w* \w la|strong="H1931"\w* alegría de \w su|strong="H1931"\w* vida,  
\q2 y en \w su|strong="H1931"\w* lugar brotarán otras plantas del suelo.   
\b  
\q1
\v 20 “La verdad \w es|strong="H3027"\w* \w que|strong="H3808"\w* Dios \w no|strong="H3808"\w* rechaza \w a|strong="H3068"\w* quien \w es|strong="H3027"\w* \w íntegro|strong="H8535"\w*,  
\q2 \w ni|strong="H3808"\w* les da la \w mano|strong="H3027"\w* \w a|strong="H3068"\w* los malvados.   
\q1
\v 21 Él volverá \w a|strong="H3068"\w* llenar tu \w boca|strong="H6310"\w* \w de|strong="H5704"\w* risa  
\q2 \w y|strong="H5704"\w* tus \w labios|strong="H8193"\w* \w con|strong="H5704"\w* \w gritos|strong="H8643"\w* \w de|strong="H5704"\w* alegría.   
\q1
\v 22 Tus \w enemigos|strong="H8130"\w* se cubrirán \w de|strong="H3847"\w* vergüenza,  
\q2 y el hogar \w de|strong="H3847"\w* los malvados desaparecerá”.   
\c 9  
\p
\v 1 Entonces \w respondió|strong="H6030"\w* Job, y dijo:   
\q1
\v 2 “\w Ciertamente|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w así|strong="H3651"\w*;  
\q2 ¿\w pero|strong="H3588"\w* \w cómo|strong="H4100"\w* \w se|strong="H3045"\w* \w justificará|strong="H6663"\w* \w el|strong="H5973"\w* hombre \w con|strong="H5973"\w* Dios?   
\q1
\v 3 \w Si|strong="H3808"\w* \w se|strong="H3808"\w* complaciera \w en|strong="H4480"\w* \w contender|strong="H7378"\w* \w con|strong="H5973"\w* \w él|strong="H5973"\w*,  
\q2 \w no|strong="H3808"\w* podría \w responderle|strong="H6030"\w* \w a|strong="H3068"\w* una cosa \w entre|strong="H5973"\w* mil.   
\q1
\v 4 \w Él|strong="H4310"\w* es \w sabio|strong="H2450"\w* de \w corazón|strong="H3824"\w* y poderoso en \w fuerzas|strong="H3581"\w*;  
\q2 ¿\w quién|strong="H4310"\w* se endureció contra \w él|strong="H4310"\w* y tuvo \w paz|strong="H7999"\w*?   
\q1
\v 5 Él arranca los \w montes|strong="H2022"\w* con su furor,  
\q2 y ellos \w no|strong="H3808"\w* \w saben|strong="H3045"\w* quién los \w trastornó|strong="H2015"\w*.   
\q1
\v 6 Él sacude la tierra de su \w lugar|strong="H4725"\w*,  
\q2 y hace temblar sus \w columnas|strong="H5982"\w*.   
\q1
