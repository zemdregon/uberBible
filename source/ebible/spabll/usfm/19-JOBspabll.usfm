\q2 \w y|strong="H5921"\w* \w mi|strong="H5921"\w* bienestar \w se|strong="H5921"\w* deshace \w como|strong="H5921"\w* una \w nube|strong="H5645"\w*.   
\b  
\q1
\v 16 “\w Ahora|strong="H6258"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* escapa;  
\q2 \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* sufrimiento \w me|strong="H5921"\w* tienen atrapado.   
\q1
\v 17 \w Por|strong="H5921"\w* \w las|strong="H5921"\w* \w noches|strong="H3915"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* parten \w los|strong="H5921"\w* \w huesos|strong="H6106"\w*,  
\q2 \w el|strong="H5921"\w* dolor \w me|strong="H5921"\w* corroe \w sin|strong="H3808"\w* descanso.   
\q1
\v 18 Con \w mucha|strong="H7227"\w* \w fuerza|strong="H3581"\w* Dios me agarra de la ropa;  
\q2 me aprieta como el cuello de mi túnica.   
\q1
\v 19 Me ha arrojado al fango,  
\q2 y no soy más que \w polvo|strong="H6083"\w* y ceniza.   
\q1
\v 20 Te pido ayuda, Dios, pero \w no|strong="H3808"\w* me \w respondes|strong="H6030"\w*;  
\q2 me pongo de \w pie|strong="H5975"\w*, pero solo te quedas mirándome.   
\q1
\v 21 Te has vuelto cruel conmigo;  
\q2 usas todo tu \w poder|strong="H3027"\w* para perseguirme.   
\q1
\v 22 Me lanzas al \w viento|strong="H7307"\w* y dejas que me arrastre;  
\q2 me deshaces en medio de la tormenta.   
\q1
\v 23 \w Yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* llevas hacia \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*,  
\q2 \w a|strong="H3068"\w* ese lugar donde terminan \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w vivos|strong="H2416"\w*.   
\b  
\q1
\v 24 “¿Acaso \w no|strong="H3808"\w* ayuda uno al \w que|strong="H3808"\w* \w se|strong="H3808"\w* está hundiendo?  
\q2 ¿\w No|strong="H3808"\w* grita \w nadie|strong="H3808"\w* pidiendo auxilio en la desgracia?   
\q1
\v 25 ¿\w No|strong="H3808"\w* \w lloré|strong="H1058"\w* \w yo|strong="H5315"\w* por el \w que|strong="H3808"\w* sufría?  
\q2 ¿\w No|strong="H3808"\w* me dolió el \w corazón|strong="H5315"\w* por los pobres?   
\q1
\v 26 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w esperaba|strong="H6960"\w* \w el|strong="H3588"\w* \w bien|strong="H2896"\w*, llegó \w el|strong="H3588"\w* \w mal|strong="H7451"\w*;  
\q2 \w cuando|strong="H3588"\w* buscaba \w la|strong="H3588"\w* luz, llegó \w la|strong="H3588"\w* oscuridad.   
\q1
\v 27 Siento un nudo en el estómago \w que|strong="H3808"\w* \w no|strong="H3808"\w* me deja en paz;  
\q2 solo me esperan \w días|strong="H3117"\w* de \w aflicción|strong="H6040"\w*.   
\q1
\v 28 \w Camino|strong="H1980"\w* en la oscuridad, \w sin|strong="H3808"\w* \w que|strong="H3808"\w* salga el sol;  
\q2 me \w levanto|strong="H6965"\w* en público \w a|strong="H3068"\w* pedir ayuda.   
\q1
\v 29 Me he vuelto hermano de \w los|strong="H1961"\w* coyotes  
\q2 y \w compañero|strong="H7453"\w* de \w los|strong="H1961"\w* avestruces.   
\q1
\v 30 \w La|strong="H5921"\w* \w piel|strong="H5785"\w* \w se|strong="H5921"\w* \w me|strong="H4480"\w* pone negra \w y|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H4480"\w* cae;  
\q2 \w el|strong="H5921"\w* cuerpo \w me|strong="H4480"\w* arde \w por|strong="H5921"\w* \w la|strong="H5921"\w* fiebre.   
\q1
\v 31 \w Mi|strong="H1961"\w* \w arpa|strong="H3658"\w* solo toca música triste,  
\q2 y \w mi|strong="H1961"\w* flauta \w tiene|strong="H1961"\w* el tono de \w los|strong="H1961"\w* \w que|strong="H1961"\w* \w lloran|strong="H1058"\w*.   
\b  
\c 31  
\b  
\q1
\v 1 “Yo \w hice|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* mis \w ojos|strong="H5869"\w*:  
\q2 \w no|strong="H5921"\w* mirar \w con|strong="H5921"\w* deseo \w a|strong="H3068"\w* ninguna mujer.   
\q1
\v 2 \w Pues|strong="H4100"\w*, ¿\w qué|strong="H4100"\w* recibimos de Dios desde \w lo|strong="H4100"\w* \w alto|strong="H4605"\w*?  
\q2 ¿\w Qué|strong="H4100"\w* \w herencia|strong="H5159"\w* \w nos|strong="H4100"\w* manda el \w Todopoderoso|strong="H7706"\w* desde el cielo?   
\q1
\v 3 ¿Acaso \w no|strong="H3808"\w* hay desgracia para el malvado  
\q2 y desastre para los \w que|strong="H3808"\w* \w hacen|strong="H6466"\w* \w lo|strong="H3808"\w* malo?   
\q1
\v 4 ¿Acaso Dios \w no|strong="H3808"\w* \w ve|strong="H7200"\w* mis \w caminos|strong="H1870"\w*  
\q2 y \w cuenta|strong="H5608"\w* \w cada|strong="H3605"\w* uno de mis \w pasos|strong="H6806"\w*?   
\b  
\q1
\v 5 “\w Si|strong="H5921"\w* he caminado \w con|strong="H5973"\w* mentiras,  
\q2 \w o|strong="H3068"\w* \w si|strong="H5921"\w* mis \w pies|strong="H7272"\w* han corrido \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w engaño|strong="H4820"\w*,   
\q1
\v 6 ¡\w que|strong="H3045"\w* Dios me \w pese|strong="H8254"\w* en una balanza justa!  
\q2 Así \w sabrá|strong="H3045"\w* \w que|strong="H3045"\w* soy un hombre íntegro.   
\q1
\v 7 Si mis pasos \w se|strong="H4480"\w* apartaron \w del|strong="H4480"\w* \w camino|strong="H1870"\w*,  
\q2 si mi \w corazón|strong="H3820"\w* \w se|strong="H4480"\w* dejó llevar \w por|strong="H4480"\w* mis \w ojos|strong="H5869"\w*,  
\q2 \w o|strong="H3068"\w* si mis \w manos|strong="H3709"\w* \w se|strong="H4480"\w* mancharon \w con|strong="H4480"\w* alguna maldad,   
\q1
\v 8 ¡que otros se coman lo que yo \w siembre|strong="H2232"\w*  
\q2 y que mis cosechas sean arrancadas de raíz!   
\b  
\q1
\v 9 “\w Si|strong="H5921"\w* \w mi|strong="H5921"\w* \w corazón|strong="H3820"\w* \w se|strong="H5921"\w* dejó seducir \w por|strong="H5921"\w* una mujer,  
\q2 \w o|strong="H3068"\w* \w si|strong="H5921"\w* estuve acechando \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* vecino,   
\q1
\v 10 ¡\w que|strong="H5921"\w* \w mi|strong="H5921"\w* esposa trabaje moliendo \w el|strong="H5921"\w* grano \w para|strong="H5921"\w* otro,  
\q2 \w y|strong="H5921"\w* \w que|strong="H5921"\w* otros hombres \w se|strong="H5921"\w* acuesten \w con|strong="H5921"\w* \w ella|strong="H5921"\w*!   
\q1
\v 11 \w Porque|strong="H3588"\w* \w el|strong="H1931"\w* adulterio \w es|strong="H1931"\w* una infamia,  
\q2 un \w pecado|strong="H5771"\w* \w que|strong="H3588"\w* merece ser castigado \w por|strong="H3588"\w* \w los|strong="H3588"\w* \w jueces|strong="H6414"\w*.   
\q1
\v 12 \w Es|strong="H1931"\w* un fuego \w que|strong="H3588"\w* devora \w hasta|strong="H5704"\w* \w la|strong="H1931"\w* destrucción total;  
\q2 ¡acabaría \w con|strong="H3588"\w* \w todo|strong="H3605"\w* \w lo|strong="H1931"\w* \w que|strong="H3588"\w* he ganado \w en|strong="H5704"\w* mi vida!   
\q1
\v 13 “Si alguna vez fui injusto \w con|strong="H5978"\w* mi empleado  
\q2 \w o|strong="H3068"\w* \w con|strong="H5978"\w* mi empleada \w cuando|strong="H5650"\w* tenían quejas contra mí,   
\q1
\v 14 ¿\w qué|strong="H3588"\w* \w haré|strong="H6213"\w* \w cuando|strong="H3588"\w* Dios \w me|strong="H3588"\w* pida cuentas?  
\q2 \w Cuando|strong="H3588"\w* \w él|strong="H3588"\w* \w me|strong="H3588"\w* examine, ¿\w qué|strong="H3588"\w* le responderé?   
\q1
\v 15 \w El|strong="H6213"\w* mismo Dios \w que|strong="H3808"\w* me \w formó|strong="H6213"\w* \w a|strong="H3068"\w* mí, los \w formó|strong="H6213"\w* \w a|strong="H3068"\w* ellos;  
\q2 \w el|strong="H6213"\w* mismo Creador nos dio vida \w a|strong="H3068"\w* todos en \w el|strong="H6213"\w* vientre.   
\q1
\v 16 “Si les negué \w a|strong="H3068"\w* los \w pobres|strong="H1800"\w* lo que necesitaban,  
\q2 \w o|strong="H3068"\w* si dejé que las viudas se cansaran \w de|strong="H5869"\w* esperar;   
\q1
\v 17 \w si|strong="H3808"\w* \w me|strong="H4480"\w* comí mi pan \w yo|strong="H4480"\w* solo  
\q2 \w sin|strong="H3808"\w* compartirlo \w con|strong="H4480"\w* el \w huérfano|strong="H3490"\w*   
\q1
\v 18 (\w aunque|strong="H3588"\w* desde joven lo cuidé \w como|strong="H3588"\w* un padre,  
\q2 \w y|strong="H3588"\w* desde niño protegí \w a|strong="H3068"\w* las viudas);   
\q1
\v 19 si \w vi|strong="H7200"\w* \w a|strong="H3068"\w* alguien muriéndose de frío por falta de ropa,  
\q2 \w o|strong="H3068"\w* \w a|strong="H3068"\w* un necesitado que \w no|strong="H1097"\w* tenía con qué cubrirse;   
\q1
\v 20 \w si|strong="H3808"\w* él \w no|strong="H3808"\w* me \w bendijo|strong="H1288"\w* de todo corazón  
\q2 al calentarse con la lana de mis ovejas;   
\q1
\v 21 \w si|strong="H3588"\w* levanté \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w huérfano|strong="H3490"\w*  
\q2 sabiendo \w que|strong="H3588"\w* \w yo|strong="H3588"\w* tenía influencia \w en|strong="H5921"\w* \w el|strong="H5921"\w* tribunal;   
\q1
\v 22 ¡entonces que se me safe \w el|strong="H5307"\w* \w brazo|strong="H7070"\w* del \w hombro|strong="H3802"\w*  
\q2 y que se me rompa \w el|strong="H5307"\w* hueso desde \w el|strong="H5307"\w* codo!   
\q1
\v 23 \w Pues|strong="H3588"\w* siempre he temido \w el|strong="H3588"\w* castigo \w de|strong="H3588"\w* Dios;  
\q2 ¡ante \w su|strong="H3588"\w* majestad \w yo|strong="H3588"\w* \w no|strong="H3808"\w* soy \w nada|strong="H3808"\w*!   
\q1
\v 24 “Si \w puse|strong="H7760"\w* mi \w confianza|strong="H4009"\w* en el \w oro|strong="H2091"\w*,  
\q2 \w o|strong="H3068"\w* si le dije al \w oro|strong="H2091"\w* \w fino|strong="H3800"\w*: ‘Tú eres mi \w seguridad|strong="H4009"\w*’;   
\q1
\v 25 \w si|strong="H3588"\w* \w me|strong="H3588"\w* alegré \w de|strong="H3588"\w* tener \w muchas|strong="H7227"\w* \w riquezas|strong="H2428"\w*  
\q2 \w o|strong="H3068"\w* \w de|strong="H3588"\w* haber ganado \w una|strong="H4672"\w* fortuna \w con|strong="H3588"\w* mis \w manos|strong="H3027"\w*;   
\q1
\v 26 \w si|strong="H3588"\w* al \w ver|strong="H7200"\w* brillar \w el|strong="H3588"\w* sol  
\q2 \w o|strong="H3068"\w* \w la|strong="H3588"\w* \w luna|strong="H3394"\w* desplazarse \w con|strong="H3588"\w* esplendor,   
\q1
\v 27 mi \w corazón|strong="H3820"\w* se dejó seducir en secreto  
\q2 y les envié besos con la \w mano|strong="H3027"\w* en señal de adoración;   
\q1
\v 28 \w eso|strong="H1931"\w* \w también|strong="H1571"\w* sería un \w pecado|strong="H5771"\w* digno \w de|strong="H3588"\w* castigo,  
\q2 \w pues|strong="H3588"\w* habría traicionado al Dios del cielo.   
\q1
\v 29 “\w Si|strong="H3588"\w* \w me|strong="H3588"\w* alegré \w cuando|strong="H3588"\w* mi enemigo cayó \w en|strong="H3588"\w* \w la|strong="H3588"\w* ruina,  
\q2 \w o|strong="H3068"\w* \w si|strong="H3588"\w* celebré \w cuando|strong="H3588"\w* le pasó algo \w malo|strong="H7451"\w*   
\q1
\v 30 (\w aunque|strong="H3808"\w* \w nunca|strong="H3808"\w* permití \w que|strong="H3808"\w* \w mi|strong="H5315"\w* boca pecara  
\q2 \w pidiendo|strong="H7592"\w* \w que|strong="H3808"\w* muriera con una maldición);   
\q1
\v 31 \w si|strong="H3808"\w* \w la|strong="H7646"\w* gente \w de|strong="H5414"\w* mi casa \w no|strong="H3808"\w* decía:  
\q2 ‘¿\w Quién|strong="H4310"\w* \w no|strong="H3808"\w* \w ha|strong="H3808"\w* comido hasta saciarse en su mesa?’;   
\q1
\v 32 \w si|strong="H3808"\w* \w nunca|strong="H3808"\w* dejé \w que|strong="H3808"\w* un \w extranjero|strong="H1616"\w* durmiera en la calle,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w abrí|strong="H6605"\w* mis \w puertas|strong="H1817"\w* \w a|strong="H3068"\w* todos los viajeros;   
\q1
\v 33 si oculté mis \w pecados|strong="H6588"\w* \w como|strong="H2934"\w* hacen otros,  
\q2 escondiendo mi \w maldad|strong="H5771"\w* dentro de mi pecho,   
\q1
\v 34 \w por|strong="H3588"\w* miedo \w a|strong="H3068"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* dijera \w la|strong="H3588"\w* gente,  
\q2 \w o|strong="H3068"\w* \w por|strong="H3588"\w* temor al desprecio \w de|strong="H3588"\w* \w los|strong="H3588"\w* demás...  
\q2 ¡\w entonces|strong="H3588"\w* \w me|strong="H3588"\w* habría quedado callado \w en|strong="H3588"\w* mi casa!   
\q1
\v 35 “¡\w Ojalá|strong="H4310"\w* alguien \w me|strong="H4310"\w* \w escuchara|strong="H8085"\w*!  
\q2 ¡\w Aquí|strong="H2005"\w* \w pongo|strong="H5414"\w* \w mi|strong="H6030"\w* firma! ¡\w Que|strong="H4310"\w* \w el|strong="H4310"\w* \w Todopoderoso|strong="H7706"\w* \w me|strong="H4310"\w* \w responda|strong="H6030"\w*!  
\q2 ¡\w Que|strong="H4310"\w* \w mi|strong="H6030"\w* acusador \w escriba|strong="H5612"\w* sus cargos \w contra|strong="H3789"\w* \w mí|strong="H6030"\w*!   
\q1
\v 36 Yo cargaría ese documento \w sobre|strong="H5921"\w* \w mis|strong="H5375"\w* \w hombros|strong="H7926"\w*;  
\q2 ¡\w me|strong="H5921"\w* \w lo|strong="H3808"\w* pondría \w en|strong="H5921"\w* \w la|strong="H5921"\w* cabeza \w como|strong="H5921"\w* una \w corona|strong="H5850"\w*!   
\q1
\v 37 Yo le daría \w cuenta|strong="H4557"\w* \w de|strong="H5057"\w* cada uno \w de|strong="H5057"\w* mis \w pasos|strong="H6806"\w*;  
\q2 me presentaría ante él con la frente en alto, \w como|strong="H3644"\w* un \w príncipe|strong="H5057"\w*.   
\q1
\v 38 “\w Si|strong="H5921"\w* \w mi|strong="H5921"\w* tierra grita \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*  
\q2 \w y|strong="H5921"\w* \w todos|strong="H3162"\w* sus surcos \w lloran|strong="H1058"\w* \w de|strong="H5921"\w* dolor;   
\q1
\v 39 \w si|strong="H5315"\w* me comí sus frutos \w sin|strong="H1097"\w* pagar \w por|strong="H3581"\w* ellos,  
\q2 \w o|strong="H3068"\w* \w si|strong="H5315"\w* hice sufrir \w a|strong="H3068"\w* \w los|strong="H1167"\w* \w que|strong="H3581"\w* trabajaban la tierra;   
\q1
\v 40 ¡entonces \w que|strong="H1697"\w* crezcan \w espinas|strong="H2336"\w* \w en|strong="H3318"\w* vez \w de|strong="H8478"\w* \w trigo|strong="H2406"\w*  
\q2 y mala hierba \w en|strong="H3318"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w cebada|strong="H8184"\w*!”.  
\b  
\p Aquí terminan las \w palabras|strong="H1697"\w* \w de|strong="H8478"\w* Job.   
\c 32  
\p
\v 1 Esos \w tres|strong="H7969"\w* hombres dejaron \w de|strong="H3588"\w* \w responderle|strong="H6030"\w* \w a|strong="H3068"\w* Job, \w porque|strong="H3588"\w* \w él|strong="H1931"\w* insistía \w en|strong="H3588"\w* \w que|strong="H3588"\w* \w era|strong="H1931"\w* inocente.  
\v 2 Pero Eliú \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Baraquel, \w el|strong="H5921"\w* buzita \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H4940"\w* \w de|strong="H5921"\w* \w Ram|strong="H7410"\w*, \w se|strong="H5921"\w* encendió \w en|strong="H5921"\w* ira \w contra|strong="H5921"\w* Job. \w Se|strong="H5921"\w* enojó mucho \w porque|strong="H5921"\w* Job \w se|strong="H5921"\w* justificaba \w a|strong="H3068"\w* \w sí|strong="H5921"\w* mismo \w en|strong="H5921"\w* lugar \w de|strong="H5921"\w* \w justificar|strong="H6663"\w* \w a|strong="H3068"\w* Dios.  
\v 3 También \w se|strong="H5921"\w* enojó \w contra|strong="H5921"\w* sus \w tres|strong="H7969"\w* \w amigos|strong="H7453"\w*, \w porque|strong="H5921"\w* \w no|strong="H3808"\w* habían \w hallado|strong="H4672"\w* \w qué|strong="H3808"\w* responder, \w aunque|strong="H3808"\w* habían condenado \w a|strong="H3068"\w* Job.  
\v 4 Eliú \w había|strong="H3588"\w* esperado \w para|strong="H3588"\w* \w hablar|strong="H1697"\w* \w porque|strong="H3588"\w* \w los|strong="H1992"\w* otros eran mayores \w que|strong="H3588"\w* \w él|strong="H3588"\w*.  
\v 5 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* Eliú \w vio|strong="H7200"\w* \w que|strong="H3588"\w* esos \w tres|strong="H7969"\w* hombres ya \w no|strong="H3588"\w* tenían nada \w que|strong="H3588"\w* decir, se enfureció.   
\b  
\p
\v 6 \w Entonces|strong="H3117"\w* Eliú \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Baraquel, \w el|strong="H5921"\w* buzita, tomó \w la|strong="H5921"\w* palabra \w y|strong="H5921"\w* dijo:  
\q1 “Yo soy joven, \w y|strong="H5921"\w* ustedes son ya \w viejos|strong="H3453"\w*;  
\q2 \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w me|strong="H5921"\w* dio pena \w y|strong="H5921"\w* \w no|strong="H5921"\w* \w me|strong="H5921"\w* atreví \w a|strong="H3068"\w* decirles \w lo|strong="H5921"\w* \w que|strong="H5921"\w* pienso.   
\q1
\v 7 Yo me decía: ‘\w Que|strong="H3045"\w* \w hable|strong="H1696"\w* \w la|strong="H2451"\w* experiencia;  
\q2 \w que|strong="H3045"\w* los \w muchos|strong="H7230"\w* \w años|strong="H8141"\w* enseñen \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*’.   
\q1
\v 8 Pero en realidad, \w es|strong="H1931"\w* \w el|strong="H1931"\w* \w espíritu|strong="H7307"\w* en \w el|strong="H1931"\w* hombre,  
\q2 \w el|strong="H1931"\w* \w soplo|strong="H7307"\w*\f + \fr 32:8 \ft o, aliento\f* del \w Todopoderoso|strong="H7706"\w*, \w lo|strong="H1931"\w* \w que|strong="H1931"\w* da entendimiento.   
\q1
\v 9 \w No|strong="H3808"\w* siempre los \w que|strong="H3808"\w* tienen autoridad \w son|strong="H3808"\w* sabios,  
\q2 \w ni|strong="H3808"\w* los \w viejos|strong="H2205"\w* \w son|strong="H3808"\w* los únicos \w que|strong="H3808"\w* entienden la \w justicia|strong="H4941"\w*.   
\q1
\v 10 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w* les pido: ‘Escúchenme;  
\q2 yo \w también|strong="H3651"\w* les voy \w a|strong="H3068"\w* \w decir|strong="H8085"\w* lo que pienso’.   
\b  
\q1
\v 11 “Miren, yo he esperado \w a|strong="H3068"\w* \w que|strong="H5704"\w* ustedes hablaran,  
\q2 escuché sus \w argumentos|strong="H8394"\w*  
\q2 \w mientras|strong="H5704"\w* buscaban las \w palabras|strong="H1697"\w* adecuadas.   
\q1
\v 12 Les he prestado mucha atención,  
\q2 pero ninguno \w de|strong="H4480"\w* ustedes ha podido convencer \w a|strong="H3068"\w* Job,  
\q2 \w ni|strong="H5704"\w* han sabido \w responder|strong="H6030"\w* \w a|strong="H3068"\w* sus razones.   
\q1
\v 13 \w No|strong="H3808"\w* vengan ahora con \w que|strong="H3808"\w*: ‘Hemos \w hallado|strong="H4672"\w* \w la|strong="H2451"\w* \w sabiduría|strong="H2451"\w*;  
\q2 \w que|strong="H3808"\w* solo Dios \w lo|strong="H3808"\w* puede vencer, \w no|strong="H3808"\w* un hombre’.   
\q1
\v 14 Job \w no|strong="H3808"\w* dirigió sus \w palabras|strong="H4405"\w* contra mí,  
\q2 así \w que|strong="H3808"\w* \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* responderle con los mismos argumentos de ustedes.   
\b  
\q1
\v 15 “Aquí están \w ellos|strong="H1992"\w*, pasmados, \w sin|strong="H3808"\w* respuesta;  
\q2 \w se|strong="H3808"\w* han quedado \w sin|strong="H3808"\w* \w palabras|strong="H4405"\w*.   
\q1
\v 16 ¿\w Y|strong="H3068"\w* voy \w a|strong="H3068"\w* seguir \w esperando|strong="H3176"\w* ahora \w que|strong="H3588"\w* \w se|strong="H3808"\w* callan,  
\q2 ahora \w que|strong="H3588"\w* \w se|strong="H3808"\w* quedan ahí parados \w sin|strong="H3808"\w* decir \w nada|strong="H3808"\w*?   
\q1
\v 17 ¡Claro que no! Yo también voy \w a|strong="H3068"\w* dar \w mi|strong="H6030"\w* \w parte|strong="H2506"\w*;  
\q2 voy \w a|strong="H3068"\w* decir lo que pienso.   
\q1
\v 18 \w Porque|strong="H3588"\w* tengo tanto \w que|strong="H3588"\w* decir  
\q2 \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w espíritu|strong="H7307"\w* dentro \w de|strong="H3588"\w* mí \w me|strong="H3588"\w* obliga \w a|strong="H3068"\w* hablar.   
\q1
\v 19 Me siento como \w vino|strong="H3196"\w* encerrado \w que|strong="H3808"\w* \w no|strong="H3808"\w* tiene salida;  
\q2 ¡como cueros de \w vino|strong="H3196"\w* \w nuevos|strong="H2319"\w* \w que|strong="H3808"\w* \w están|strong="H2009"\w* por reventar!   
\q1
\v 20 \w Tengo|strong="H1696"\w* que \w hablar|strong="H1696"\w* para desahogarme;  
\q2 voy \w a|strong="H3068"\w* abrir mis \w labios|strong="H8193"\w* para \w responder|strong="H6030"\w*.   
\q1
\v 21 \w No|strong="H3808"\w* me voy \w a|strong="H3068"\w* poner del lado \w de|strong="H6440"\w* \w nadie|strong="H3808"\w*,  
\q2 \w ni|strong="H3808"\w* voy \w a|strong="H3068"\w* andar con adulaciones para con \w ningún|strong="H3808"\w* hombre.   
\q1
\v 22 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w no|strong="H3808"\w* \w sé|strong="H3045"\w* andar \w con|strong="H3588"\w* halagos;  
\q2 \w si|strong="H3588"\w* \w lo|strong="H3808"\w* hiciera, \w mi|strong="H5375"\w* Creador \w me|strong="H3588"\w* eliminaría pronto.   
\b  
\c 33  
\b  
\q1
\v 1 “Pero \w ahora|strong="H4994"\w*, Job, \w escucha|strong="H8085"\w* \w lo|strong="H1697"\w* \w que|strong="H4994"\w* digo;  
\q2 presta atención \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w mis|strong="H4405"\w* \w palabras|strong="H1697"\w*.   
\q1
\v 2 \w Mira|strong="H2009"\w*, \w ya|strong="H4994"\w* he \w abierto|strong="H6605"\w* la \w boca|strong="H6310"\w*;  
\q2 mis \w palabras|strong="H1696"\w* \w están|strong="H2009"\w* en la punta de la \w lengua|strong="H3956"\w*.   
\q1
\v 3 Lo que voy \w a|strong="H3068"\w* decir sale de un \w corazón|strong="H3820"\w* sincero;  
\q2 mis \w labios|strong="H8193"\w* dirán con claridad lo que saben.   
\q1
\v 4 \w El|strong="H6213"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5397"\w* Dios me \w hizo|strong="H6213"\w*;  
\q2 \w el|strong="H6213"\w* aliento del \w Todopoderoso|strong="H7706"\w* me mantiene con \w vida|strong="H2421"\w*.   
\q1
\v 5 \w Respóndeme|strong="H7725"\w*, \w si|strong="H6440"\w* \w puedes|strong="H3201"\w*;  
\q2 prepara tus argumentos y enfrentate \w a|strong="H3068"\w* mí.   
\q1
\v 6 \w Mira|strong="H2005"\w*, ante Dios yo soy igual \w que|strong="H1571"\w* tú;  
\q2 yo \w también|strong="H1571"\w* fui \w formado|strong="H7169"\w* del \w barro|strong="H2563"\w*.   
\q1
\v 7 \w No|strong="H3808"\w* tienes \w por|strong="H5921"\w* \w qué|strong="H3808"\w* tenerme miedo,  
\q2 \w ni|strong="H3808"\w* voy \w a|strong="H3068"\w* ser duro \w contigo|strong="H5921"\w*.   
\b  
\q1
\v 8 “Tú has dicho ante \w mis|strong="H4405"\w* propios \w oídos|strong="H8085"\w*,  
\q2 y yo \w escuché|strong="H8085"\w* claramente cuando afirmaste:   
\q1
\v 9 ‘Yo soy \w puro|strong="H2134"\w* y \w no|strong="H3808"\w* he \w pecado|strong="H5771"\w*;  
\q2 estoy \w limpio|strong="H2134"\w* y \w no|strong="H3808"\w* hay \w maldad|strong="H5771"\w* en mí.   
\q1
\v 10 Pero Dios \w busca|strong="H4672"\w* motivos \w para|strong="H5921"\w* atacarme;  
\q2 \w me|strong="H5921"\w* trata \w como|strong="H5921"\w* \w si|strong="H2005"\w* fuera su enemigo.   
\q1
\v 11 Me pone \w los|strong="H3605"\w* \w pies|strong="H7272"\w* en \w el|strong="H3605"\w* cepo  
\q2 y vigila \w todos|strong="H3605"\w* mis pasos’.   
\b  
\q1
\v 12 “\w Pero|strong="H3588"\w* déjame decirte \w que|strong="H3588"\w* \w en|strong="H3588"\w* \w esto|strong="H2063"\w* \w te|strong="H3588"\w* equivocas,  
\q2 \w porque|strong="H3588"\w* Dios \w es|strong="H3588"\w* \w mucho|strong="H7235"\w* \w más|strong="H3588"\w* importante \w que|strong="H3588"\w* cualquier mortal.   
\q1
\v 13 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* discutes \w con|strong="H3588"\w* \w él|strong="H3588"\w*?  
\q2 ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* \w te|strong="H3588"\w* quejas \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w responde|strong="H6030"\w*?   
\q1
\v 14 Dios \w habla|strong="H1696"\w* \w de|strong="H3588"\w* una manera,  
\q2 \w y|strong="H3588"\w* luego \w de|strong="H3588"\w* otra, \w aunque|strong="H3588"\w* \w no|strong="H3808"\w* nos demos cuenta.   
\q1
\v 15 Habla \w en|strong="H5921"\w* \w sueños|strong="H2472"\w*, \w en|strong="H5921"\w* \w visiones|strong="H2384"\w* \w nocturnas|strong="H3915"\w*,  
\q2 cuando \w el|strong="H5921"\w* \w sueño|strong="H2472"\w* profundo \w cae|strong="H5307"\w* \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* hombres  
\q2 mientras duermen \w en|strong="H5921"\w* su \w cama|strong="H4904"\w*.   
\q1
\v 16 Entonces les \w abre|strong="H1540"\w* el oído  
\q2 y les confirma su enseñanza,   
\q1
\v 17 \w para|strong="H5493"\w* que el \w hombre|strong="H1397"\w* deje de hacer lo malo  
\q2 y se \w aparte|strong="H5493"\w* del orgullo.   
\q1
\v 18 Así libra su \w alma|strong="H5315"\w* \w de|strong="H4480"\w* la tumba  
\q2 y evita \w que|strong="H4480"\w* su \w vida|strong="H5315"\w* muera \w a|strong="H3068"\w* espada.   
\b  
\q1
\v 19 “También usa \w el|strong="H5921"\w* \w dolor|strong="H4341"\w* \w para|strong="H5921"\w* corregir \w al|strong="H5921"\w* hombre \w en|strong="H5921"\w* su \w cama|strong="H4904"\w*,  
\q2 \w con|strong="H5921"\w* un sufrimiento constante \w en|strong="H5921"\w* sus \w huesos|strong="H6106"\w*,   
\q1
\v 20 al grado que el enfermo pierde el hambre  
\q2 y no quiere probar ni la \w comida|strong="H3978"\w* \w más|strong="H3899"\w* rica.   
\q1
\v 21 \w Se|strong="H3808"\w* pone tan flaco \w que|strong="H3808"\w* ya \w no|strong="H3808"\w* \w se|strong="H3808"\w* reconoce;  
\q2 \w se|strong="H3808"\w* le marcan los \w huesos|strong="H6106"\w* \w que|strong="H3808"\w* antes \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w veían|strong="H7200"\w*.   
\q1
\v 22 Su \w vida|strong="H5315"\w* se acerca \w a|strong="H3068"\w* la tumba,  
\q2 y su \w alma|strong="H5315"\w* \w a|strong="H3068"\w* los que causan la \w muerte|strong="H4191"\w*.   
\b  
\q1
\v 23 “Pero \w si|strong="H5921"\w* \w tiene|strong="H3426"\w* \w a|strong="H3068"\w* su lado un \w ángel|strong="H4397"\w*,  
\q2 un mediador, uno \w entre|strong="H5921"\w* mil,  
\q2 \w que|strong="H4480"\w* \w le|strong="H5921"\w* enseñe \w al|strong="H5921"\w* hombre \w lo|strong="H5921"\w* \w que|strong="H4480"\w* \w es|strong="H3426"\w* recto;   
\q1
\v 24 si Dios tiene \w compasión|strong="H2603"\w* de él y dice:  
\q2 ‘Líbralo de bajar \w a|strong="H3068"\w* la tumba,  
\q2 que ya he encontrado quien pague por su vida’,   
\q1
\v 25 \w entonces|strong="H3117"\w* su cuerpo se renovará como el de un niño  
\q2 y \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* tener el vigor de su juventud.   
\q1
\v 26 \w Orará|strong="H6279"\w* \w a|strong="H3068"\w* Dios y él lo escuchará;  
\q2 \w verá|strong="H7200"\w* el \w rostro|strong="H6440"\w* \w de|strong="H6440"\w* Dios con alegría,  
\q2 y Dios le devolverá su bienestar.   
\q1
\v 27 Entonces cantará ante \w la|strong="H5921"\w* gente \w y|strong="H5921"\w* dirá:  
\q2 ‘\w Pequé|strong="H2398"\w* \w y|strong="H5921"\w* torcí \w lo|strong="H3808"\w* \w que|strong="H3808"\w* era justo,  
\q2 pero Dios \w no|strong="H3808"\w* \w me|strong="H5921"\w* dio \w el|strong="H5921"\w* castigo \w que|strong="H3808"\w* merecía.   
\q1
\v 28 \w Él|strong="H5674"\w* me salvó de bajar \w a|strong="H3068"\w* la tumba;  
\q2 ¡\w mi|strong="H5315"\w* \w vida|strong="H5315"\w* volverá \w a|strong="H3068"\w* \w ver|strong="H7200"\w* la luz!’.   
\b  
\q1
\v 29 “Dios hace \w todo|strong="H3605"\w* esto por \w el|strong="H5973"\w* \w hombre|strong="H1397"\w*,  
\q2 \w dos|strong="H6471"\w* y hasta \w tres|strong="H7969"\w* \w veces|strong="H6471"\w*,   
\q1
\v 30 \w para|strong="H4480"\w* salvarlo \w de|strong="H4480"\w* la muerte  
\q2 y \w para|strong="H4480"\w* \w que|strong="H4480"\w* la luz \w de|strong="H4480"\w* la \w vida|strong="H5315"\w* lo ilumine.   
\q1
\v 31 \w Escucha|strong="H8085"\w*, Job, y ponme atención;  
\q2 guarda silencio, que yo voy \w a|strong="H3068"\w* \w hablar|strong="H1696"\w*.   
\q1
\v 32 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w tienes|strong="H3426"\w* algo \w que|strong="H3588"\w* decir, \w respóndeme|strong="H7725"\w*;  
\q2 \w habla|strong="H1696"\w*, \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w quiero|strong="H2654"\w* darte \w la|strong="H3588"\w* razón \w si|strong="H3588"\w* \w la|strong="H3588"\w* \w tienes|strong="H3426"\w*.   
\q1
\v 33 \w Y|strong="H3068"\w* si no, \w escúchame|strong="H8085"\w* tú \w a|strong="H3068"\w* mí;  
\q2 cállate y te enseñaré lo que es \w la|strong="H2451"\w* verdadera \w sabiduría|strong="H2451"\w*”.   
\c 34  
\p
\v 1 Eliú continuó su discurso y dijo:   
\q1
\v 2 “\w Escuchen|strong="H8085"\w* \w mis|strong="H4405"\w* \w palabras|strong="H4405"\w*, ustedes \w los|strong="H2450"\w* \w sabios|strong="H2450"\w*;  
\q2 presten atención, ustedes \w que|strong="H3045"\w* tanto \w saben|strong="H3045"\w*.   
\q1
\v 3 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* oído distingue las \w palabras|strong="H4405"\w*,  
\q2 \w así|strong="H3588"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* paladar saborea \w la|strong="H3588"\w* comida.   
\q1
\v 4 Escojamos juntos \w lo|strong="H4100"\w* \w que|strong="H4100"\w* es justo;  
\q2 decidamos entre nosotros \w lo|strong="H4100"\w* \w que|strong="H4100"\w* es \w bueno|strong="H2896"\w*.   
\q1
\v 5 \w Porque|strong="H3588"\w* Job ha dicho: ‘\w Yo|strong="H3588"\w* soy inocente,  
\q2 \w pero|strong="H3588"\w* Dios \w me|strong="H3588"\w* ha negado \w la|strong="H3588"\w* \w justicia|strong="H4941"\w*.   
\q1
\v 6 Aunque \w tengo|strong="H5921"\w* \w la|strong="H5921"\w* razón, paso \w por|strong="H5921"\w* mentiroso;  
\q2 \w mi|strong="H5921"\w* herida es incurable, aunque \w no|strong="H1097"\w* he \w pecado|strong="H6588"\w*’.   
\q1
\v 7 ¿\w Quién|strong="H4310"\w* se cree \w que|strong="H4310"\w* es Job,  
\q2 \w que|strong="H4310"\w* se \w bebe|strong="H8354"\w* los insultos como si fueran \w agua|strong="H4325"\w*?   
\q1
\v 8 ¡Ahora \w anda|strong="H3212"\w* \w en|strong="H5973"\w* compañía \w de|strong="H5973"\w* malvados  
\q2 y sigue \w el|strong="H5973"\w* camino \w de|strong="H5973"\w* \w los|strong="H5973"\w* pecadores!   
\q1
\v 9 \w Pues|strong="H3588"\w* \w ha|strong="H3808"\w* llegado \w a|strong="H3068"\w* decir: ‘\w De|strong="H3588"\w* \w nada|strong="H3808"\w* \w le|strong="H5973"\w* sirve al \w hombre|strong="H1397"\w*  
\q2 tratar \w de|strong="H3588"\w* agradar \w a|strong="H3068"\w* Dios’.   
\b  
\q1
\v 10 “\w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, escúchenme, ustedes que tienen juicio:  
\q2 ¡Es imposible que Dios haga lo malo!  
\q2 ¡El \w Todopoderoso|strong="H7706"\w* \w no|strong="H5766"\w* comete injusticias!   
\q1
\v 11 \w Él|strong="H3588"\w* le \w paga|strong="H7999"\w* \w a|strong="H3068"\w* cada uno según lo \w que|strong="H3588"\w* hace;  
\q2 hace \w que|strong="H3588"\w* todos reciban lo \w que|strong="H3588"\w* merecen sus actos.   
\q1
\v 12 La verdad es \w que|strong="H3808"\w* Dios \w no|strong="H3808"\w* actúa con maldad,  
\q2 el \w Todopoderoso|strong="H7706"\w* \w nunca|strong="H3808"\w* tuerce la \w justicia|strong="H4941"\w*.   
\q1
\v 13 ¿\w Quién|strong="H4310"\w* \w le|strong="H5921"\w* encargó \w a|strong="H3068"\w* \w él|strong="H5921"\w* cuidar \w la|strong="H5921"\w* tierra?  
\q2 ¿\w Quién|strong="H4310"\w* \w lo|strong="H5921"\w* \w puso|strong="H7760"\w* \w a|strong="H3068"\w* \w cargo|strong="H6485"\w* \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w mundo|strong="H8398"\w*?   
\q1
\v 14 Si él pensara solo en sí mismo  
\q2 y retirara \w de|strong="H5397"\w* nosotros su \w espíritu|strong="H7307"\w* y su aliento,   
\q1
\v 15 \w todos|strong="H3605"\w* \w los|strong="H3605"\w* seres vivos morirían \w al|strong="H5921"\w* \w mismo|strong="H3605"\w* tiempo  
\q2 \w y|strong="H5921"\w* \w la|strong="H5921"\w* humanidad volvería \w a|strong="H3068"\w* ser \w polvo|strong="H6083"\w*.   
\b  
\q1
\v 16 “Si de verdad eres inteligente, \w escucha|strong="H8085"\w* \w esto|strong="H2063"\w*;  
\q2 presta atención \w a|strong="H3068"\w* \w lo|strong="H4405"\w* que digo.   
\q1
\v 17 ¿Podría gobernar alguien que odia la \w justicia|strong="H4941"\w*?  
\q2 ¿Te atreves \w a|strong="H3068"\w* condenar al que es \w justo|strong="H6662"\w* y poderoso?   
\q1
\v 18 Él es quien le dice \w a|strong="H3068"\w* un \w rey|strong="H4428"\w*: ‘¡Eres un despreciable!’,  
\q2 y \w a|strong="H3068"\w* los nobles: ‘¡Ustedes son unos malvados!’.   
\q1
\v 19 Dios \w no|strong="H3808"\w* \w se|strong="H3808"\w* pone \w de|strong="H3588"\w* parte \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w príncipes|strong="H8269"\w*,  
\q2 \w ni|strong="H3808"\w* prefiere al rico sobre \w el|strong="H3588"\w* \w pobre|strong="H1800"\w*,  
\q2 \w porque|strong="H3588"\w* \w todos|strong="H3605"\w* han sido creados \w por|strong="H3588"\w* sus \w manos|strong="H3027"\w*.   
\q1
\v 20 \w Mueren|strong="H4191"\w* \w en|strong="H5493"\w* un instante, \w a|strong="H3068"\w* medianoche;  
\q2 la \w gente|strong="H5971"\w* \w se|strong="H3808"\w* estremece y desaparece;  
\q2 \w a|strong="H3068"\w* los poderosos los \w quitan|strong="H5493"\w* \w sin|strong="H3808"\w* esfuerzo humano.   
\b  
\q1
\v 21 “Dios vigila \w los|strong="H5921"\w* \w caminos|strong="H1870"\w* \w de|strong="H5921"\w* \w cada|strong="H3605"\w* hombre;  
\q2 \w él|strong="H5921"\w* observa \w cada|strong="H3605"\w* uno \w de|strong="H5921"\w* sus \w pasos|strong="H6806"\w*.   
\q1
\v 22 No hay sombra ni \w oscuridad|strong="H2822"\w* tan profunda  
\q2 \w donde|strong="H8033"\w* puedan esconderse los malvados.   
\q1
\v 23 Dios \w no|strong="H3808"\w* necesita citar \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* dos veces  
\q2 \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H3808"\w* presente ante \w él|strong="H5921"\w* \w a|strong="H3068"\w* \w juicio|strong="H4941"\w*.   
\q1
\v 24 Él destruye \w a|strong="H3068"\w* los poderosos \w sin|strong="H3808"\w* necesidad \w de|strong="H8478"\w* investigar \w nada|strong="H3808"\w*  
\q2 y pone \w a|strong="H3068"\w* otros \w en|strong="H8478"\w* su \w lugar|strong="H8478"\w*.   
\q1
\v 25 \w Como|strong="H3651"\w* él sabe \w bien|strong="H3651"\w* lo que hacen,  
\q2 los derriba \w por|strong="H3651"\w* la \w noche|strong="H3915"\w* y quedan aplastados.   
\q1
\v 26 Los castiga públicamente \w como|strong="H8478"\w* \w a|strong="H3068"\w* delincuentes,  
\q2 \w a|strong="H3068"\w* la vista \w de|strong="H8478"\w* todo el mundo,   
\q1
\v 27 \w porque|strong="H5921"\w* dejaron \w de|strong="H5921"\w* seguirlo  
\q2 \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* importaron sus \w caminos|strong="H1870"\w*.   
\q1
\v 28 \w Ellos|strong="H5921"\w* hicieron \w que|strong="H5921"\w* \w el|strong="H5921"\w* grito \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pobres|strong="H1800"\w* llegara \w a|strong="H3068"\w* Dios,  
\q2 \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w escuchó|strong="H8085"\w* \w el|strong="H5921"\w* \w clamor|strong="H6818"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* afligidos.   
\q1
\v 29 Pero \w si|strong="H1931"\w* Dios decide quedarse tranquilo, ¿\w quién|strong="H4310"\w* puede condenarlo?  
\q2 \w Si|strong="H1931"\w* \w esconde|strong="H5641"\w* \w su|strong="H1931"\w* \w rostro|strong="H6440"\w*, ¿\w quién|strong="H4310"\w* puede verlo?  
\q2 \w Él|strong="H1931"\w* vigila \w tanto|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w como|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* individuos,   
\q1
\v 30 \w para|strong="H5971"\w* \w que|strong="H5971"\w* no gobiernen los malvados  
\q2 ni pongan trampas al \w pueblo|strong="H5971"\w*.   
\b  
\q1
\v 31 “¿Acaso alguien le \w ha|strong="H3808"\w* dicho \w a|strong="H3068"\w* Dios:  
\q2 ‘He sido castigado, \w pero|strong="H3588"\w* ya \w no|strong="H3808"\w* pecaré \w más|strong="H3588"\w*;   
\q1
\v 32 \w enséñame|strong="H3384"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* alcanzo \w a|strong="H3068"\w* ver,  
\q2 y \w si|strong="H3808"\w* hice algo malo, \w no|strong="H3808"\w* \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* hacerlo’?   
\q1
\v 33 ¿Debería Dios recompensarte \w como|strong="H4100"\w* tú quieres, solo \w porque|strong="H3588"\w* \w lo|strong="H4100"\w* rechazas?  
\q2 Eres tú \w quien|strong="H4100"\w* debe decidir, \w no|strong="H3808"\w* \w yo|strong="H3588"\w*;  
\q2 dinos, \w pues|strong="H3588"\w*, \w lo|strong="H4100"\w* \w que|strong="H3588"\w* \w sepas|strong="H3045"\w*.   
\q1
\v 34 \w Los|strong="H2450"\w* que son inteligentes me dirán,  
\q2 y cualquier \w sabio|strong="H2450"\w* que me \w escuche|strong="H8085"\w*:   
\q1
\v 35 ‘Job \w habla|strong="H1696"\w* \w sin|strong="H3808"\w* saber \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w dice|strong="H1696"\w*;  
\q2 en sus \w palabras|strong="H1697"\w* \w no|strong="H3808"\w* hay \w sabiduría|strong="H1847"\w*’.   
\q1
\v 36 ¡Ojalá Job fuera examinado \w hasta|strong="H5704"\w* \w el|strong="H5921"\w* final,  
\q2 \w porque|strong="H5921"\w* responde \w como|strong="H5921"\w* \w los|strong="H5921"\w* malvados!   
\q1
\v 37 \w A|strong="H3068"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w* \w le|strong="H5921"\w* \w añade|strong="H3254"\w* \w la|strong="H5921"\w* rebeldía;  
\q2 \w se|strong="H5921"\w* burla \w de|strong="H5921"\w* \w nosotros|strong="H5921"\w* \w en|strong="H5921"\w* nuestra cara  
\q2 \w y|strong="H3588"\w* lanza \w más|strong="H3588"\w* \w y|strong="H3588"\w* \w más|strong="H3588"\w* palabras \w contra|strong="H5921"\w* Dios”.   
\c 35  
\p
\v 1 Eliú continuó su discurso y dijo:   
\q1
\v 2 “¿Acaso te parece que tienes razón  
\q2 cuando dices: ‘Soy más justo que Dios’?   
\q1
\v 3 \w Pues|strong="H3588"\w* tú le preguntas: ‘¿\w De|strong="H3588"\w* \w qué|strong="H3588"\w* \w me|strong="H3588"\w* \w sirve|strong="H3276"\w* ser bueno?  
\q2 ¿\w Qué|strong="H3588"\w* gano \w con|strong="H3588"\w* \w no|strong="H3588"\w* pecar?’.   
\q1
\v 4 Yo \w te|strong="H5973"\w* voy \w a|strong="H3068"\w* \w responder|strong="H7725"\w* \w a|strong="H3068"\w* \w ti|strong="H5973"\w*,  
\q2 y también \w a|strong="H3068"\w* tus \w amigos|strong="H7453"\w* que están \w con|strong="H5973"\w* ustedes.   
\q1
\v 5 \w Mira|strong="H7200"\w* \w hacia|strong="H4480"\w* el \w cielo|strong="H8064"\w* y observa;  
\q2 fíjate \w en|strong="H4480"\w* las nubes, ¡están mucho \w más|strong="H4480"\w* altas \w que|strong="H4480"\w* tú!   
\q1
\v 6 Si pecas, ¿en \w qué|strong="H4100"\w* afectas \w a|strong="H3068"\w* Dios?  
\q2 Si tus \w pecados|strong="H6588"\w* \w se|strong="H4100"\w* multiplican, ¿\w qué|strong="H4100"\w* daño le \w haces|strong="H6213"\w* \w a|strong="H3068"\w* \w él|strong="H6213"\w*?   
\q1
\v 7 Si eres justo, ¿\w qué|strong="H4100"\w* le \w das|strong="H5414"\w* \w a|strong="H3068"\w* él?  
\q2 ¿\w O|strong="H3068"\w* \w qué|strong="H4100"\w* \w recibe|strong="H3947"\w* él \w de|strong="H5414"\w* tus \w manos|strong="H3027"\w*?   
\q1
\v 8 Tu maldad solo afecta \w a|strong="H3068"\w* \w hombres|strong="H1121"\w* \w como|strong="H3644"\w* tú,  
\q2 y tu \w justicia|strong="H6666"\w* solo beneficia \w a|strong="H3068"\w* otros seres humanos.   
\b  
\q1
\v 9 “La gente grita cuando la oprimen;  
\q2 piden ayuda para librarse del \w poder|strong="H7230"\w* de los poderosos.   
\q1
\v 10 Pero \w nadie|strong="H3808"\w* pregunta: ‘¿Dónde está Dios, mi Creador,  
\q2 \w el|strong="H6213"\w* \w que|strong="H3808"\w* nos \w da|strong="H5414"\w* canciones \w de|strong="H5414"\w* alegría en medio \w de|strong="H5414"\w* la \w noche|strong="H3915"\w*,   
\q1
\v 11 el que nos enseña más que \w a|strong="H3068"\w* los animales de la tierra  
\q2 y nos hace más sabios que \w a|strong="H3068"\w* las \w aves|strong="H5775"\w* del \w cielo|strong="H8064"\w*?’.   
\q1
\v 12 Gritan, pero él \w no|strong="H3808"\w* les \w responde|strong="H6030"\w*  
\q2 \w a|strong="H3068"\w* \w causa|strong="H6440"\w* del orgullo \w de|strong="H6440"\w* los malvados.   
\q1
\v 13 Es verdad \w que|strong="H3808"\w* Dios \w no|strong="H3808"\w* \w escucha|strong="H8085"\w* quejas vacías;  
\q2 el \w Todopoderoso|strong="H7706"\w* \w no|strong="H3808"\w* les presta atención.   
\q1
\v 14 ¡Mucho \w menos|strong="H3588"\w* \w te|strong="H3588"\w* escuchará \w cuando|strong="H3588"\w* dices \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* ves,  
\q2 \w que|strong="H3588"\w* tu caso está \w ante|strong="H6440"\w* \w él|strong="H3588"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* sigues esperando \w su|strong="H3588"\w* respuesta!   
\q1
\v 15 \w Y|strong="H3068"\w* \w ahora|strong="H6258"\w*, \w porque|strong="H3588"\w* Dios \w no|strong="H3808"\w* \w ha|strong="H3808"\w* castigado \w con|strong="H3588"\w* \w su|strong="H3588"\w* enojo  
\q2 \w ni|strong="H3808"\w* parece tomar \w muy|strong="H3966"\w* \w en|strong="H3588"\w* \w cuenta|strong="H6485"\w* \w la|strong="H3588"\w* rebeldía,   
\q1
\v 16 Job \w abre|strong="H6475"\w* la \w boca|strong="H6310"\w* para decir tonterías  
\q2 y se cansa de hablar \w sin|strong="H1097"\w* saber \w lo|strong="H4405"\w* \w que|strong="H6310"\w* dice”.   
\b  
\c 36  
\p
\v 1 Eliú continuó su discurso y dijo:   
\q1
\v 2 “Ténganme un poco \w de|strong="H3588"\w* paciencia \w y|strong="H3588"\w* les mostraré \w la|strong="H3588"\w* verdad,  
\q2 \w porque|strong="H3588"\w* \w todavía|strong="H5750"\w* \w me|strong="H3588"\w* quedan \w razones|strong="H4405"\w* \w en|strong="H3588"\w* favor \w de|strong="H3588"\w* Dios.   
\q1
\v 3 Buscaré \w mis|strong="H5375"\w* argumentos en \w lo|strong="H7350"\w* más profundo  
\q2 \w para|strong="H5414"\w* demostrar que \w mi|strong="H5375"\w* Creador es justo.   
\q1
\v 4 \w Les|strong="H5973"\w* aseguro \w que|strong="H3588"\w* \w mis|strong="H4405"\w* \w palabras|strong="H4405"\w* \w no|strong="H3808"\w* \w son|strong="H3588"\w* \w mentira|strong="H8267"\w*;  
\q2 alguien \w con|strong="H5973"\w* \w conocimiento|strong="H1844"\w* \w perfecto|strong="H8549"\w* está aquí \w con|strong="H5973"\w* ustedes.   
\b  
\q1
\v 5 “Miren, Dios es poderoso, pero \w no|strong="H3808"\w* \w desprecia|strong="H3988"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*;  
\q2 su \w fuerza|strong="H3581"\w* radica en su gran inteligencia.   
\q1
\v 6 Él \w no|strong="H3808"\w* deja \w que|strong="H3808"\w* los malvados vivan \w para|strong="H5414"\w* siempre,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* les hace \w justicia|strong="H4941"\w* \w a|strong="H3068"\w* los afligidos.   
\q1
\v 7 \w No|strong="H3808"\w* quita sus \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* \w los|strong="H3427"\w* \w justos|strong="H6662"\w*;  
\q2 \w al|strong="H4428"\w* contrario, \w los|strong="H3427"\w* sienta en tronos con \w los|strong="H3427"\w* \w reyes|strong="H4428"\w*  
\q2 para \w que|strong="H3808"\w* sean honrados para siempre.   
\q1
\v 8 Pero si ellos caen en cadenas  
\q2 y quedan atrapados en las \w sogas|strong="H2256"\w* de la \w aflicción|strong="H6040"\w*,   
\q1
\v 9 \w entonces|strong="H3588"\w* Dios \w les|strong="H1992"\w* \w muestra|strong="H5046"\w* \w lo|strong="H1992"\w* \w que|strong="H3588"\w* han hecho:  
\q2 \w les|strong="H1992"\w* enseña \w que|strong="H3588"\w* han \w pecado|strong="H6588"\w* \w por|strong="H3588"\w* orgullo.   
\q1
\v 10 Les \w abre|strong="H1540"\w* \w los|strong="H3588"\w* oídos \w para|strong="H3588"\w* \w que|strong="H3588"\w* acepten \w la|strong="H3588"\w* \w corrección|strong="H4148"\w*  
\q2 \w y|strong="H3588"\w* les ordena \w que|strong="H3588"\w* se aparten \w de|strong="H3588"\w* \w la|strong="H3588"\w* maldad.   
\q1
\v 11 Si ellos \w escuchan|strong="H8085"\w* y le \w sirven|strong="H5647"\w*,  
\q2 pasan el resto de sus \w días|strong="H3117"\w* en prosperidad  
\q2 y sus \w años|strong="H8141"\w* con felicidad.   
\q1
\v 12 Pero \w si|strong="H3808"\w* \w no|strong="H3808"\w* \w escuchan|strong="H8085"\w*, morirán por la espada;  
\q2 morirán \w sin|strong="H3808"\w* \w haber|strong="H3808"\w* aprendido \w nada|strong="H3808"\w*.   
\b  
\q1
\v 13 “\w Los|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* conocen \w a|strong="H3068"\w* Dios guardan resentimiento;  
\q2 \w aunque|strong="H3588"\w* \w él|strong="H3588"\w* \w los|strong="H3588"\w* castigue, \w no|strong="H3808"\w* piden ayuda.   
\q1
\v 14 \w Mueren|strong="H4191"\w* cuando todavía son jóvenes;  
\q2 su \w vida|strong="H5315"\w* termina en medio de la impureza.   
\q1
\v 15 Pero Dios salva al \w afligido|strong="H6041"\w* por medio de su \w aflicción|strong="H6040"\w*,  
\q2 y usa el sufrimiento para abrirle los oídos.   
\q1
