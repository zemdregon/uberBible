\v 15 \w Pero|strong="G1161"\w* \w se|strong="G2532"\w* \w salvará|strong="G4982"\w* engendrando hijos, \w si|strong="G1437"\w* \w permanece|strong="G3306"\w* \w en|strong="G1722"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w*, \w el|strong="G3588"\w* amor \w y|strong="G2532"\w* \w la|strong="G3588"\w* santidad, \w con|strong="G3326"\w* \w modestia|strong="G4997"\w*.   
\c 3  
\p
