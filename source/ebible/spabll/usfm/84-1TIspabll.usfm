\v 3 \w Porque|strong="G2532"\w* \w esto|strong="G3778"\w* \w es|strong="G3778"\w* \w bueno|strong="G2570"\w* \w y|strong="G2532"\w* agradable \w delante|strong="G1799"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*,  
