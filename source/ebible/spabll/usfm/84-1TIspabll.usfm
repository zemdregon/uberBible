\c 2  
\p
\v 1 \w Exhorto|strong="G3870"\w*, \w pues|strong="G3767"\w*, \w ante|strong="G4412"\w* \w todo|strong="G3956"\w*, a \w que|strong="G3767"\w* se \w hagan|strong="G4160"\w* \w peticiones|strong="G1783"\w*, \w oraciones|strong="G4335"\w*, súplicas \w y|strong="G3767"\w* acciones \w de|strong="G5228"\w* gracias \w por|strong="G5228"\w* \w todos|strong="G3956"\w* los hombres;  
