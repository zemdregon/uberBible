\v 1 \w Pablo|strong="G3972"\w*, apóstol \w de|strong="G2596"\w* \w Jesucristo|strong="G2424"\w* \w por|strong="G2596"\w* mandato \w de|strong="G2596"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Salvador|strong="G4990"\w*, \w y|strong="G2532"\w* \w del|strong="G3588"\w* \w Señor|strong="G2316"\w* \w Jesucristo|strong="G2424"\w* \w nuestra|strong="G3588"\w* \w esperanza|strong="G1680"\w*,  
