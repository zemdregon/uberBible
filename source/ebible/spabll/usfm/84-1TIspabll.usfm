\v 2 \w Por|strong="G3588"\w* \w lo|strong="G3588"\w* tanto, \w el|strong="G3588"\w* \w obispo|strong="G1985"\w* \w debe|strong="G1163"\w* ser intachable, esposo \w de|strong="G3588"\w* \w una|strong="G1520"\w* sola \w mujer|strong="G1135"\w*, sobrio, prudente, respetable, hospitalario, apto para enseñar;  
