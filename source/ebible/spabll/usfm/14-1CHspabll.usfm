\v 32 y Miclot, \w que|strong="H1992"\w* fue padre \w de|strong="H5048"\w* Simea. También \w vivían|strong="H3427"\w* \w con|strong="H5973"\w* \w sus|strong="H1992"\w* familias \w en|strong="H5973"\w* Jerusalén, \w cerca|strong="H5973"\w* \w de|strong="H5048"\w* \w sus|strong="H1992"\w* parientes.  
\v 33 \w Ner|strong="H5369"\w* fue padre de \w Cis|strong="H7027"\w*. \w Cis|strong="H7027"\w* fue padre de \w Saúl|strong="H7586"\w*. \w Saúl|strong="H7586"\w* fue padre de Jonatán, Malquisúa, Abinadab y Esbaal.  
\v 34 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jonatán fue Merib-baal. Merib-baal fue padre \w de|strong="H1121"\w* Miqueas.  
\v 35 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Miqueas: Pitón, Melec, Tarea y Acaz.  
\v 36 Acaz fue padre de Joada. \w Y|strong="H3068"\w* Joada fue padre de Alemet, Azmavet y \w Zimri|strong="H2174"\w*. \w Zimri|strong="H2174"\w* fue padre de Moza.  
\v 37 Moza fue padre \w de|strong="H1121"\w* Binea. Rafa fue su \w hijo|strong="H1121"\w*, Elasa su \w hijo|strong="H1121"\w*, y Azel su \w hijo|strong="H1121"\w*.  
\v 38 Azel tuvo \w seis|strong="H8337"\w* \w hijos|strong="H1121"\w*, cuyos \w nombres|strong="H8034"\w* son \w estos|strong="H3605"\w*: \w Azricam|strong="H5840"\w*, Bocru, \w Ismael|strong="H3458"\w*, \w Searías|strong="H8187"\w*, \w Abdías|strong="H5662"\w* y \w Hanán|strong="H2605"\w*. \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* fueron \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Azel.  
\v 39 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* su hermano Esec: Ulam su \w primogénito|strong="H1060"\w*, \w Jeús|strong="H3266"\w* \w el|strong="H1121"\w* \w segundo|strong="H8145"\w* y Elifelet \w el|strong="H1121"\w* \w tercero|strong="H7992"\w*.  
\v 40 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Ulam \w fueron|strong="H1961"\w* guerreros \w valientes|strong="H1368"\w*, arqueros, y \w tuvieron|strong="H1961"\w* \w muchos|strong="H7235"\w* \w hijos|strong="H1121"\w* y \w nietos|strong="H1121"\w*, \w ciento|strong="H3967"\w* \w cincuenta|strong="H2572"\w* en total. \w Todos|strong="H3605"\w* \w ellos|strong="H3605"\w* \w eran|strong="H1961"\w* descendientes \w de|strong="H1121"\w* \w Benjamín|strong="H1144"\w*.   
\c 9  
\p
\v 1 Así \w que|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w fue|strong="H3063"\w* registrado \w por|strong="H5921"\w* sus genealogías; \w y|strong="H5921"\w* he \w aquí|strong="H2009"\w* \w que|strong="H5921"\w*\f + \fr 9:1 \ft “He aquí”, de “הִנֵּה”, significa mirar, fijarse, observar, ver o contemplar. Se utiliza a menudo como interjección.\f* \w están|strong="H2009"\w* \w escritas|strong="H3789"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Judá|strong="H3063"\w* \w fue|strong="H3063"\w* llevado cautivo \w a|strong="H3068"\w* Babilonia \w por|strong="H5921"\w* su desobediencia.  
\v 2 \w Los|strong="H3427"\w* \w primeros|strong="H7223"\w* \w habitantes|strong="H3427"\w* que \w vivían|strong="H3427"\w* en sus posesiones, en sus \w ciudades|strong="H5892"\w*, eran \w los|strong="H3427"\w* israelitas, \w los|strong="H3427"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H3427"\w* \w levitas|strong="H3881"\w* y \w los|strong="H3427"\w* sirvientes del templo.  
\v 3 \w En|strong="H4480"\w* Jerusalén \w vivían|strong="H3427"\w* \w de|strong="H4480"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H4480"\w* \w Judá|strong="H3063"\w*, \w de|strong="H4480"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w* y \w de|strong="H4480"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H4480"\w* Efraín y \w Manasés|strong="H4519"\w*:  
\v 4 \w Utai|strong="H5793"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amiud, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Omri|strong="H6018"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Imri, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Bani|strong="H1137"\w*, \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Fares \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Judá|strong="H3063"\w*.  
\v 5 \w De|strong="H4480"\w* \w los|strong="H1121"\w* silonitas: \w Asaías|strong="H6222"\w* \w el|strong="H1121"\w* \w primogénito|strong="H1060"\w* y sus \w hijos|strong="H1121"\w*.  
\v 6 \w De|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Zera|strong="H2226"\w*: Jeuel y sus hermanos, \w seiscientos|strong="H8337"\w* \w noventa|strong="H8673"\w*.  
\v 7 \w De|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Benjamín|strong="H1144"\w*: \w Salú|strong="H5543"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Hodavías, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Hasenúa;  
\v 8 \w e|strong="H3068"\w* Ibneías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeroham|strong="H3395"\w*, y Ela, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Uzi, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Micri; y Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sefatías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Reuel|strong="H7467"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ibnía;  
\v 9 y sus parientes, según sus generaciones, \w novecientos|strong="H8672"\w* \w cincuenta|strong="H2572"\w* y \w seis|strong="H8337"\w*. \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* hombres eran \w jefes|strong="H7218"\w* de \w familia|strong="H1004"\w* según las \w casas|strong="H1004"\w* de sus padres.   
\p
\v 10 \w De|strong="H4480"\w* los \w sacerdotes|strong="H3548"\w*: \w Jedaías|strong="H3048"\w*, \w Joiarib|strong="H3080"\w*, Jacín,  
\v 11 y \w Azarías|strong="H5838"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hilcías|strong="H2518"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Sadoc|strong="H6659"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Meraiot, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahitob, jefe \w de|strong="H1121"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* Dios;  
\v 12 y \w Adaías|strong="H5718"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jeroham|strong="H3395"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Pasur, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Malquías y Masai \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Adiel|strong="H5717"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jazera, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mesulam, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mesilemit, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Imer;  
\v 13 y sus parientes, \w jefes|strong="H7218"\w* de las \w casas|strong="H1004"\w* de sus padres, \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* \w sesenta|strong="H8346"\w*; eran \w hombres|strong="H1368"\w* muy capacitados para hacer el servicio del \w templo|strong="H1004"\w* de Dios.   
\p
\v 14 \w De|strong="H4480"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*: \w Semaías|strong="H8098"\w* \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Hasub, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Azricam|strong="H5840"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Hasabías|strong="H2811"\w*, \w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* \w Merari|strong="H4847"\w*;  
\v 15 y Bacbacar, \w Heres|strong="H2792"\w*, Galal y Matanías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mica, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zicri, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Asaf,  
\v 16 y \w Abdías|strong="H5662"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Semaías|strong="H8098"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Galal, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jedutún; y Berequías \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Asa, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Elcaná, \w que|strong="H1121"\w* \w vivían|strong="H3427"\w* en las \w aldeas|strong="H2691"\w* \w de|strong="H1121"\w* \w los|strong="H3427"\w* netofatitas.   
\p
\v 17 Los \w porteros|strong="H7778"\w*: Salum, Acub, \w Talmón|strong="H2929"\w*, Ahimán y sus parientes (Salum era el \w jefe|strong="H7218"\w*),  
\v 18 \w que|strong="H5704"\w* \w antes|strong="H5704"\w* servían \w en|strong="H5704"\w* la \w puerta|strong="H8179"\w* del \w rey|strong="H4428"\w* \w hacia|strong="H2008"\w* \w el|strong="H1121"\w* \w este|strong="H4217"\w*. Eran \w los|strong="H1992"\w* \w porteros|strong="H7778"\w* del \w campamento|strong="H4264"\w* \w de|strong="H5704"\w* \w los|strong="H1992"\w* levitas.  
\v 19 Salum \w era|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Coré|strong="H7141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ebiasaf, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Coré|strong="H7141"\w*, \w y|strong="H5921"\w* sus parientes, \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* su padre, \w los|strong="H1121"\w* coreítas, estaban \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* servicio \w como|strong="H5921"\w* guardianes \w de|strong="H5921"\w* \w las|strong="H5921"\w* entradas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tienda. Sus antepasados habían estado \w a|strong="H3068"\w* cargo \w del|strong="H5921"\w* \w campamento|strong="H4264"\w* \w de|strong="H5921"\w* Yahvé, \w como|strong="H5921"\w* guardianes \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w entrada|strong="H3996"\w*.  
\v 20 Finees, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Eleazar, \w había|strong="H1961"\w* \w sido|strong="H1961"\w* \w el|strong="H5921"\w* líder \w de|strong="H5921"\w* \w ellos|strong="H5921"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* pasado, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w estaba|strong="H1961"\w* \w con|strong="H5973"\w* \w él|strong="H5921"\w*.  
\v 21 \w Zacarías|strong="H2148"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Meselemías, \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w portero|strong="H7778"\w* \w de|strong="H1121"\w* la entrada \w a|strong="H3068"\w* la Tienda \w de|strong="H1121"\w* Reunión.  
\v 22 \w Todos|strong="H3605"\w* \w estos|strong="H1992"\w* \w que|strong="H2691"\w* \w fueron|strong="H1732"\w* elegidos para ser \w porteros|strong="H7778"\w* en \w las|strong="H1992"\w* entradas \w fueron|strong="H1732"\w* \w doscientos|strong="H3967"\w* \w doce|strong="H8147"\w*. \w Fueron|strong="H1732"\w* registrados por genealogía en \w sus|strong="H1992"\w* pueblos. \w David|strong="H1732"\w* y \w el|strong="H3605"\w* \w vidente|strong="H7200"\w* \w Samuel|strong="H8050"\w* \w los|strong="H1992"\w* habían puesto en \w sus|strong="H1992"\w* cargos de confianza.  
\v 23 \w Ellos|strong="H1992"\w* \w y|strong="H5921"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w* estaban \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* vigilar \w las|strong="H1992"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, es decir, \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tienda.  
\v 24 \w Los|strong="H1961"\w* \w porteros|strong="H7778"\w* \w estaban|strong="H1961"\w* en \w los|strong="H1961"\w* cuatro \w lados|strong="H7307"\w*: al \w este|strong="H1961"\w*, al oeste, al \w norte|strong="H6828"\w* y al sur.  
\v 25 Sus hermanos, \w que|strong="H3117"\w* estaban \w en|strong="H5973"\w* sus \w aldeas|strong="H2691"\w*, debían venir \w cada|strong="H3117"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w para|strong="H5973"\w* turnarse y estar \w con|strong="H5973"\w* ellos,  
\v 26 \w porque|strong="H3588"\w* \w los|strong="H1992"\w* cuatro \w porteros|strong="H7778"\w* \w principales|strong="H1368"\w*, \w que|strong="H3588"\w* \w eran|strong="H1961"\w* \w levitas|strong="H3881"\w*, \w tenían|strong="H1961"\w* un \w puesto|strong="H3588"\w* \w de|strong="H5921"\w* mucha confianza \w y|strong="H3588"\w* \w estaban|strong="H1961"\w* \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w los|strong="H1992"\w* cuartos \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w los|strong="H1992"\w* tesoros \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Dios.  
\v 27 Pasaban \w la|strong="H5921"\w* noche \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Dios, \w porque|strong="H3588"\w* ese era \w su|strong="H1992"\w* deber, \w y|strong="H3588"\w* \w les|strong="H1992"\w* correspondía abrir \w las|strong="H1992"\w* puertas cada \w mañana|strong="H1242"\w*.   
\p
\v 28 Algunos \w de|strong="H5921"\w* \w ellos|strong="H1992"\w* estaban \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w los|strong="H1992"\w* utensilios \w del|strong="H5921"\w* servicio; \w los|strong="H1992"\w* contaban \w cuando|strong="H3588"\w* \w los|strong="H1992"\w* metían \w y|strong="H3588"\w* \w cuando|strong="H3588"\w* \w los|strong="H1992"\w* \w sacaban|strong="H3318"\w*.  
\v 29 Otros estaban encargados \w de|strong="H5921"\w* \w los|strong="H1992"\w* muebles \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1992"\w* utensilios \w del|strong="H5921"\w* \w santuario|strong="H6944"\w*, \w así|strong="H1992"\w* \w como|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* harina fina, \w del|strong="H5921"\w* \w vino|strong="H3196"\w*, \w del|strong="H5921"\w* \w aceite|strong="H8081"\w*, \w del|strong="H5921"\w* \w incienso|strong="H3828"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H1992"\w* \w especias|strong="H1314"\w*.   
\p
\v 30 Algunos \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* preparaban la mezcla \w de|strong="H4480"\w* las \w especias|strong="H1314"\w*.  
\v 31 Matatías, uno \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w que|strong="H4480"\w* \w era|strong="H1931"\w* \w primogénito|strong="H1060"\w* \w de|strong="H4480"\w* Salum \w el|strong="H1931"\w* coreíta, estaba \w a|strong="H3068"\w* cargo \w de|strong="H4480"\w* hacer \w el|strong="H1931"\w* pan \w que|strong="H4480"\w* \w se|strong="H1931"\w* preparaba \w en|strong="H5921"\w* \w los|strong="H5921"\w* sartenes.  
\v 32 Algunos \w de|strong="H4480"\w* sus compañeros, \w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* \w los|strong="H1121"\w* coatitas, estaban encargados \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w panes|strong="H3899"\w* consagrados, \w para|strong="H5921"\w* prepararlos cada \w sábado|strong="H7676"\w*.   
\p
\v 33 Estos \w son|strong="H3588"\w* \w los|strong="H5921"\w* músicos, \w jefes|strong="H7218"\w* \w de|strong="H5921"\w* familia \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w*, \w que|strong="H3588"\w* vivían \w en|strong="H5921"\w* \w las|strong="H5921"\w* habitaciones \w del|strong="H5921"\w* templo \w y|strong="H3588"\w* \w estaban|strong="H7218"\w* libres \w de|strong="H5921"\w* cualquier otro servicio, \w pues|strong="H3588"\w* trabajaban \w en|strong="H5921"\w* \w lo|strong="H5921"\w* suyo \w de|strong="H5921"\w* \w día|strong="H3119"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w*.  
\v 34 Estos eran líderes de familia de \w los|strong="H3427"\w* \w levitas|strong="H3881"\w*, \w por|strong="H3881"\w* sus generaciones, hombres importantes que \w vivían|strong="H3427"\w* en Jerusalén.   
\p
\v 35 \w Jeiel|strong="H3273"\w*, padre de \w Gabaón|strong="H1391"\w*, \w vivía|strong="H3427"\w* en \w Gabaón|strong="H1391"\w*; su esposa se \w llamaba|strong="H8034"\w* Maaca.  
\v 36 Su \w hijo|strong="H1121"\w* mayor fue \w Abdón|strong="H5658"\w*, y luego tuvo \w a|strong="H3068"\w* Zur, \w Cis|strong="H7027"\w*, \w Baal|strong="H1168"\w*, \w Ner|strong="H5369"\w*, \w Nadab|strong="H5070"\w*,  
\v 37 \w Gedor|strong="H1446"\w*, Ahío, \w Zacarías|strong="H2148"\w* y Miclot.  
\v 38 Miclot fue padre \w de|strong="H5048"\w* Simeam. \w Ellos|strong="H1992"\w* también vivieron \w con|strong="H5973"\w* \w sus|strong="H1992"\w* parientes \w en|strong="H5973"\w* Jerusalén, \w cerca|strong="H5973"\w* \w de|strong="H5048"\w* \w su|strong="H1992"\w* familia.  
\v 39 \w Ner|strong="H5369"\w* fue padre de \w Cis|strong="H7027"\w*. \w Cis|strong="H7027"\w* fue padre de \w Saúl|strong="H7586"\w*. \w Saúl|strong="H7586"\w* fue padre de Jonatán, Malquisúa, Abinadab y Esbaal.  
\v 40 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jonatán fue Merib-baal. Merib-baal fue padre \w de|strong="H1121"\w* Miqueas.  
\v 41 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Miqueas: Pitón, Melec, Tarea y Acaz.  
\v 42 Acaz fue padre de Jara. Jara fue padre de Alemet, Azmavet y \w Zimri|strong="H2174"\w*. \w Zimri|strong="H2174"\w* fue padre de Moza.  
\v 43 Moza fue padre \w de|strong="H1121"\w* Binea, quien fue padre \w de|strong="H1121"\w* Refaías, quien fue padre \w de|strong="H1121"\w* Eleasá, quien fue padre \w de|strong="H1121"\w* Azel.  
\v 44 Azel tuvo \w seis|strong="H8337"\w* \w hijos|strong="H1121"\w*, y sus \w nombres|strong="H8034"\w* son \w Azricam|strong="H5840"\w*, Bocru, \w Ismael|strong="H3458"\w*, \w Searías|strong="H8187"\w*, \w Abdías|strong="H5662"\w* y \w Hanán|strong="H2605"\w*. Estos fueron \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Azel.   
\c 10  
\p
\v 1 Los \w filisteos|strong="H6430"\w* \w pelearon|strong="H3898"\w* \w contra|strong="H6440"\w* \w Israel|strong="H3478"\w*, y los israelitas \w huyeron|strong="H5127"\w* \w de|strong="H6440"\w* ellos y \w cayeron|strong="H5307"\w* \w muertos|strong="H2491"\w* en \w el|strong="H5307"\w* \w monte|strong="H2022"\w* Gilboa.  
\v 2 \w Los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w persiguieron|strong="H1692"\w* \w de|strong="H1121"\w* cerca \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*, y \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* Jonatán, \w a|strong="H3068"\w* Abinadab y \w a|strong="H3068"\w* Malquisúa, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Saúl|strong="H7586"\w*.  
\v 3 \w La|strong="H5921"\w* \w batalla|strong="H4421"\w* \w se|strong="H5921"\w* intensificó \w contra|strong="H5921"\w* \w Saúl|strong="H7586"\w*, \w y|strong="H5921"\w* \w los|strong="H5921"\w* arqueros \w lo|strong="H5921"\w* alcanzaron; \w él|strong="H5921"\w* quedó muy malherido \w por|strong="H5921"\w* \w los|strong="H5921"\w* arqueros.  
\v 4 \w Entonces|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w escudero|strong="H5375"\w*: “\w Saca|strong="H8025"\w* tu \w espada|strong="H2719"\w* \w y|strong="H3588"\w* mátame \w con|strong="H5921"\w* \w ella|strong="H5921"\w*, \w no|strong="H3808"\w* \w sea|strong="H6435"\w* \w que|strong="H3588"\w* vengan estos \w incircuncisos|strong="H6189"\w* \w y|strong="H3588"\w* abusen \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.”  
\p \w Pero|strong="H3588"\w* \w su|strong="H3588"\w* \w escudero|strong="H5375"\w* \w no|strong="H3808"\w* quiso hacerlo, \w porque|strong="H3588"\w* estaba aterrorizado. \w Entonces|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w tomó|strong="H3947"\w* \w su|strong="H3588"\w* propia \w espada|strong="H2719"\w* \w y|strong="H3588"\w* \w se|strong="H5921"\w* dejó \w caer|strong="H5307"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 5 \w Cuando|strong="H3588"\w* \w su|strong="H1931"\w* \w escudero|strong="H5375"\w* \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* estaba \w muerto|strong="H4191"\w*, \w él|strong="H1931"\w* \w también|strong="H1571"\w* \w se|strong="H1931"\w* dejó \w caer|strong="H5307"\w* \w sobre|strong="H5921"\w* \w su|strong="H1931"\w* \w espada|strong="H2719"\w* \w y|strong="H1571"\w* \w murió|strong="H4191"\w*.  
\v 6 Así \w murió|strong="H4191"\w* \w Saúl|strong="H7586"\w* con sus \w tres|strong="H7969"\w* \w hijos|strong="H1121"\w*; \w toda|strong="H3605"\w* su \w familia|strong="H1004"\w* \w murió|strong="H4191"\w* junta.  
\v 7 \w Cuando|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* israelitas \w que|strong="H3588"\w* \w estaban|strong="H3427"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w valle|strong="H6010"\w* \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* ejército \w había|strong="H3588"\w* huido \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w Saúl|strong="H7586"\w* \w y|strong="H3588"\w* sus \w hijos|strong="H1121"\w* \w estaban|strong="H3427"\w* \w muertos|strong="H4191"\w*, abandonaron sus \w ciudades|strong="H5892"\w* \w y|strong="H3588"\w* escaparon. Luego, \w los|strong="H3427"\w* \w filisteos|strong="H6430"\w* llegaron \w y|strong="H3588"\w* se quedaron \w a|strong="H3068"\w* vivir \w en|strong="H3588"\w* ellas.   
\p
\v 8 Al \w día|strong="H1121"\w* \w siguiente|strong="H4283"\w*, \w cuando|strong="H1961"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w fueron|strong="H1961"\w* \w a|strong="H3068"\w* despojar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w muertos|strong="H2491"\w*, encontraron \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w* y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* tirados en \w el|strong="H5307"\w* \w monte|strong="H2022"\w* Gilboa.  
\v 9 Le quitaron sus cosas, le cortaron la \w cabeza|strong="H7218"\w* y \w tomaron|strong="H5375"\w* su armadura, y \w enviaron|strong="H7971"\w* mensajeros por toda la tierra \w de|strong="H5971"\w* los \w filisteos|strong="H6430"\w* \w para|strong="H5971"\w* darles la noticia \w a|strong="H3068"\w* sus \w ídolos|strong="H6091"\w* y al \w pueblo|strong="H5971"\w*.  
\v 10 \w Pusieron|strong="H7760"\w* su armadura en el \w templo|strong="H1004"\w* de sus dioses, y colgaron su cabeza en el \w templo|strong="H1004"\w* de \w Dagón|strong="H1712"\w*.  
\v 11 Cuando \w todos|strong="H3605"\w* \w los|strong="H3605"\w* de \w Jabes|strong="H3003"\w* de \w Galaad|strong="H1568"\w* se enteraron de \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* le habían \w hecho|strong="H6213"\w* \w a|strong="H3068"\w* \w Saúl|strong="H7586"\w*,  
\v 12 \w todos|strong="H3605"\w* \w los|strong="H1121"\w* guerreros \w valientes|strong="H2428"\w* se \w levantaron|strong="H6965"\w* y se \w llevaron|strong="H5375"\w* \w el|strong="H3605"\w* cuerpo \w de|strong="H8478"\w* \w Saúl|strong="H7586"\w* y \w los|strong="H1121"\w* cuerpos \w de|strong="H8478"\w* sus \w hijos|strong="H1121"\w* \w hasta|strong="H3117"\w* \w Jabes|strong="H3003"\w*. Enterraron sus \w huesos|strong="H6106"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* \w la|strong="H3605"\w* encina \w en|strong="H6912"\w* \w Jabes|strong="H3003"\w*, y ayunaron durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.   
\p
\v 13 \w Saúl|strong="H7586"\w* \w murió|strong="H4191"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* desobediencia \w que|strong="H3808"\w* \w cometió|strong="H4604"\w* \w contra|strong="H5921"\w* Yahvé, \w ya|strong="H1571"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* cumplió \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé, \w y|strong="H1571"\w* \w además|strong="H5921"\w* \w porque|strong="H5921"\w* \w fue|strong="H3808"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* una médium \w para|strong="H5921"\w* pedirle \w consejo|strong="H1697"\w*,  
\v 14 en lugar \w de|strong="H1121"\w* consultar \w a|strong="H3068"\w* Yahvé. Por eso \w él|strong="H1121"\w* le \w quitó|strong="H4191"\w* la vida y le entregó \w el|strong="H1121"\w* \w reino|strong="H4410"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Isaí|strong="H3448"\w*.   
\c 11  
\p
\v 1 Entonces \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* se reunió con \w David|strong="H1732"\w* en \w Hebrón|strong="H2275"\w*, y le dijeron: “\w Mira|strong="H2009"\w*, \w nosotros|strong="H3605"\w* somos de tu misma sangre.  
\v 2 \w En|strong="H5921"\w* \w el|strong="H5921"\w* pasado, incluso \w cuando|strong="H1571"\w* \w Saúl|strong="H7586"\w* \w era|strong="H1961"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, \w eras|strong="H1961"\w* tú quien dirigía \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* batalla. Yahvé tu \w Dios|strong="H3068"\w* \w te|strong="H5921"\w* dijo: ‘Tú pastorearás \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*, \w y|strong="H1571"\w* \w serás|strong="H1961"\w* \w el|strong="H5921"\w* líder \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*’.”   
\p
\v 3 Así \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w fueron|strong="H1732"\w* \w a|strong="H3068"\w* ver \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w a|strong="H3068"\w* \w Hebrón|strong="H2275"\w*, \w y|strong="H5921"\w* \w David|strong="H1732"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5921"\w* \w ellos|strong="H3027"\w* \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w* \w ante|strong="H6440"\w* Yahvé. \w Lo|strong="H1697"\w* \w ungieron|strong="H4886"\w* \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w tal|strong="H1697"\w* \w como|strong="H5921"\w* Yahvé \w lo|strong="H1697"\w* había \w dicho|strong="H1697"\w* \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w Samuel|strong="H8050"\w*.   
\p
\v 4 \w David|strong="H1732"\w* y \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* marcharon \w hacia|strong="H8033"\w* Jerusalén (\w que|strong="H1931"\w* también \w se|strong="H1931"\w* llamaba \w Jebús|strong="H2983"\w*), \w donde|strong="H8033"\w* \w estaban|strong="H3427"\w* \w los|strong="H3427"\w* \w jebuseos|strong="H2983"\w*, \w que|strong="H1931"\w* \w vivían|strong="H3427"\w* \w en|strong="H3212"\w* \w esa|strong="H1931"\w* región.  
\v 5 \w Los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jebús \w le|strong="H1931"\w* dijeron \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “¡Tú \w no|strong="H3808"\w* vas \w a|strong="H3068"\w* entrar \w aquí|strong="H2008"\w*!” \w Sin|strong="H3808"\w* embargo, \w David|strong="H1732"\w* capturó \w la|strong="H1931"\w* fortaleza de \w Sión|strong="H6726"\w*, \w que|strong="H1931"\w* \w ahora|strong="H2008"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w Ciudad|strong="H5892"\w* de \w David|strong="H1732"\w*.  
\v 6 \w David|strong="H1732"\w* \w había|strong="H1961"\w* dicho: “\w El|strong="H3605"\w* \w primero|strong="H7223"\w* \w en|strong="H5221"\w* atacar \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jebuseos|strong="H2983"\w* \w será|strong="H1961"\w* \w el|strong="H3605"\w* \w jefe|strong="H7218"\w* y \w comandante|strong="H8269"\w*.” \w Joab|strong="H3097"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sarvia, \w subió|strong="H5927"\w* \w primero|strong="H7223"\w* y \w se|strong="H1961"\w* convirtió \w en|strong="H5221"\w* \w el|strong="H3605"\w* \w jefe|strong="H7218"\w*.  
\v 7 \w David|strong="H1732"\w* \w se|strong="H5921"\w* \w quedó|strong="H3427"\w* \w a|strong="H3068"\w* vivir \w en|strong="H5921"\w* \w la|strong="H5921"\w* fortaleza; \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w la|strong="H5921"\w* \w llamaron|strong="H7121"\w* \w la|strong="H5921"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*.  
\v 8 Él reconstruyó la \w ciudad|strong="H5892"\w* \w por|strong="H4480"\w* todos \w lados|strong="H5439"\w*, \w desde|strong="H4480"\w* el terraplén \w hasta|strong="H5704"\w* los \w alrededores|strong="H5439"\w*, \w mientras|strong="H5704"\w* \w Joab|strong="H3097"\w* \w reparó|strong="H2421"\w* el resto \w de|strong="H4480"\w* la \w ciudad|strong="H5892"\w*.  
\v 9 \w David|strong="H1732"\w* se hacía cada vez más poderoso, \w porque|strong="H1732"\w* \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w Ejércitos|strong="H6635"\w* estaba \w con|strong="H5973"\w* \w él|strong="H5973"\w*.   
\p
\v 10 \w Estos|strong="H3605"\w* son \w los|strong="H5921"\w* líderes \w de|strong="H5921"\w* \w los|strong="H5921"\w* guerreros \w valientes|strong="H1368"\w* \w que|strong="H5921"\w* tenía \w David|strong="H1732"\w*, \w los|strong="H5921"\w* cuales \w le|strong="H5921"\w* dieron un \w fuerte|strong="H1368"\w* apoyo \w en|strong="H5921"\w* su \w reino|strong="H4427"\w*, \w junto|strong="H5921"\w* \w con|strong="H5973"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w para|strong="H5921"\w* hacerlo \w rey|strong="H4427"\w*, cumpliendo \w así|strong="H2388"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 11 \w Esta|strong="H1931"\w* \w es|strong="H1931"\w* \w la|strong="H1931"\w* lista \w de|strong="H5921"\w* \w los|strong="H1121"\w* guerreros \w valientes|strong="H1368"\w* \w que|strong="H1931"\w* \w tenía|strong="H1931"\w* \w David|strong="H1732"\w*: Jasobeam, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* un hacmonita, \w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w Tres|strong="H7969"\w*; \w él|strong="H1931"\w* levantó \w su|strong="H1931"\w* \w lanza|strong="H2595"\w* \w contra|strong="H5921"\w* \w trescientos|strong="H7969"\w* \w hombres|strong="H1368"\w* \w y|strong="H5921"\w* \w los|strong="H1121"\w* mató \w en|strong="H5921"\w* un \w solo|strong="H1931"\w* combate.  
\v 12 Después \w de|strong="H1121"\w* \w él|strong="H1931"\w* estaba Eleazar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Dodo, \w el|strong="H1931"\w* ahohíta, \w que|strong="H1931"\w* \w era|strong="H1121"\w* uno \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Tres|strong="H7969"\w* \w Valientes|strong="H1368"\w*.  
\v 13 \w Él|strong="H1931"\w* \w estuvo|strong="H1961"\w* \w con|strong="H5973"\w* \w David|strong="H1732"\w* \w en|strong="H5973"\w* Pasdamim, \w donde|strong="H8033"\w* \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w* \w se|strong="H1961"\w* \w habían|strong="H1961"\w* reunido \w para|strong="H1961"\w* \w la|strong="H1931"\w* \w batalla|strong="H4421"\w*. \w Había|strong="H1961"\w* \w allí|strong="H8033"\w* un \w campo|strong="H7704"\w* \w lleno|strong="H4392"\w* \w de|strong="H6440"\w* \w cebada|strong="H8184"\w*, y \w los|strong="H5973"\w* soldados israelitas huían \w de|strong="H6440"\w* \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w*.  
\v 14 Pero ellos se pararon \w en|strong="H8432"\w* \w medio|strong="H8432"\w* del campo, lo defendieron y derrotaron \w a|strong="H3068"\w* los \w filisteos|strong="H6430"\w*. El \w Señor|strong="H3068"\w* los \w salvó|strong="H3467"\w* dándoles una \w gran|strong="H1419"\w* victoria.   
\p
\v 15 \w Tres|strong="H7969"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w treinta|strong="H7970"\w* \w jefes|strong="H7218"\w* \w bajaron|strong="H3381"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w roca|strong="H6697"\w* \w para|strong="H5921"\w* ver \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cueva|strong="H4631"\w* \w de|strong="H4480"\w* Adulam, mientras \w el|strong="H5921"\w* \w ejército|strong="H4264"\w* \w filisteo|strong="H6430"\w* acampaba \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w valle|strong="H6010"\w* \w de|strong="H4480"\w* Refaim.  
\v 16 \w David|strong="H1732"\w* estaba en el refugio fortificado, y en ese momento había un destacamento \w filisteo|strong="H6430"\w* en Belén.  
\v 17 \w A|strong="H3068"\w* \w David|strong="H1732"\w* se \w le|strong="H4310"\w* antojó y dijo: “¡\w Ojalá|strong="H4310"\w* alguien \w me|strong="H4310"\w* trajera \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w agua|strong="H4325"\w* del pozo \w que|strong="H4310"\w* está junto \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* \w de|strong="H4325"\w* Belén!”   
\p
\v 18 Los \w Tres|strong="H7969"\w* Valientes \w se|strong="H3808"\w* \w abrieron|strong="H1234"\w* paso \w por|strong="H7579"\w* \w el|strong="H4264"\w* \w campamento|strong="H4264"\w* \w filisteo|strong="H6430"\w*, \w sacaron|strong="H7579"\w* \w agua|strong="H4325"\w* \w del|strong="H8354"\w* pozo \w que|strong="H3808"\w* está junto \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* \w de|strong="H4325"\w* Belén, y \w se|strong="H3808"\w* la \w llevaron|strong="H5375"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w*. Pero \w él|strong="H4264"\w* \w no|strong="H3808"\w* quiso \w beberla|strong="H8354"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* la derramó como ofrenda \w a|strong="H3068"\w* Yahvé,  
\v 19 diciendo: “¡\w Que|strong="H3588"\w* \w mi|strong="H5315"\w* Dios \w me|strong="H3588"\w* libre \w de|strong="H3588"\w* \w hacer|strong="H6213"\w* algo \w así|strong="H2063"\w*! ¿Acaso voy \w a|strong="H3068"\w* \w beber|strong="H8354"\w* \w la|strong="H3588"\w* \w sangre|strong="H1818"\w* \w de|strong="H3588"\w* \w estos|strong="H2063"\w* \w hombres|strong="H1368"\w* \w que|strong="H3588"\w* arriesgaron sus \w vidas|strong="H5315"\w*?” \w Como|strong="H3588"\w* habían arriesgado \w la|strong="H3588"\w* \w vida|strong="H5315"\w* \w para|strong="H3588"\w* traerla, \w no|strong="H3808"\w* quiso \w beberla|strong="H8354"\w*. \w Estas|strong="H2063"\w* fueron las hazañas \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Tres|strong="H7969"\w* \w Valientes|strong="H1368"\w*.   
\p
\v 20 \w Abisai|strong="H7969"\w*, hermano \w de|strong="H5921"\w* \w Joab|strong="H3097"\w*, \w era|strong="H1961"\w* \w el|strong="H1931"\w* \w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Tres|strong="H7969"\w*. \w Él|strong="H1931"\w* levantó \w su|strong="H1931"\w* \w lanza|strong="H2595"\w* \w contra|strong="H5921"\w* \w trescientos|strong="H7969"\w* hombres \w y|strong="H5921"\w* \w los|strong="H5921"\w* mató, \w y|strong="H5921"\w* \w se|strong="H1961"\w* hizo famoso \w entre|strong="H5921"\w* \w los|strong="H5921"\w* \w Tres|strong="H7969"\w*.  
\v 21 \w Fue|strong="H1961"\w* el \w más|strong="H4480"\w* respetado \w de|strong="H4480"\w* \w los|strong="H1961"\w* \w Tres|strong="H7969"\w* \w y|strong="H5704"\w* \w llegó|strong="H5704"\w* \w a|strong="H3068"\w* ser su \w comandante|strong="H8269"\w*, \w aunque|strong="H5704"\w* \w no|strong="H3808"\w* \w fue|strong="H1961"\w* incluido \w entre|strong="H3808"\w* \w los|strong="H1961"\w* \w Tres|strong="H7969"\w* \w principales|strong="H8269"\w*.   
\p
\v 22 \w Benaía|strong="H1141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w Joiada|strong="H3077"\w*, \w era|strong="H1931"\w* un guerrero \w valiente|strong="H2428"\w* \w de|strong="H4480"\w* \w Cabseel|strong="H6909"\w* \w que|strong="H4480"\w* hizo \w grandes|strong="H7227"\w* hazañas. \w Él|strong="H1931"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w dos|strong="H8147"\w* mejores guerreros \w de|strong="H4480"\w* \w Moab|strong="H4124"\w*. También bajó \w a|strong="H3068"\w* un foso \w en|strong="H4480"\w* un \w día|strong="H3117"\w* nevado y \w mató|strong="H5221"\w* \w a|strong="H3068"\w* un león.  
\v 23 Además, \w mató|strong="H2026"\w* \w a|strong="H3068"\w* un \w egipcio|strong="H4713"\w* gigante \w que|strong="H1931"\w* medía unos \w cinco|strong="H2568"\w* codos\f + \fr 11:23 \ft Un codo es la longitud desde la punta del dedo medio hasta el codo del brazo de un hombre, o sea, unas 18 pulgadas o 46 centímetros. Por lo tanto, este egipcio medía alrededor de 7 pies y 6 pulgadas o 2.28 metros de altura.\f* \w de|strong="H2568"\w* alto. \w El|strong="H1931"\w* \w egipcio|strong="H4713"\w* \w tenía|strong="H1931"\w* \w en|strong="H5221"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* una \w lanza|strong="H2595"\w* \w tan|strong="H1931"\w* gruesa \w como|strong="H1931"\w* \w el|strong="H1931"\w* rodillo \w de|strong="H2568"\w* un telar, pero Benaía \w lo|strong="H1931"\w* enfrentó \w solo|strong="H1931"\w* con un bastón, \w le|strong="H1931"\w* arrebató \w la|strong="H1931"\w* \w lanza|strong="H2595"\w* al \w egipcio|strong="H4713"\w* y \w lo|strong="H1931"\w* \w mató|strong="H2026"\w* con \w su|strong="H1931"\w* propia arma.  
\v 24 \w Estas|strong="H6213"\w* cosas \w hizo|strong="H6213"\w* \w Benaía|strong="H1141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Joiada|strong="H3077"\w*, y se \w hizo|strong="H6213"\w* famoso entre \w los|strong="H1121"\w* \w Tres|strong="H7969"\w* \w Valientes|strong="H1368"\w*.  
\v 25 \w Fue|strong="H1931"\w* \w más|strong="H4480"\w* respetado \w que|strong="H4480"\w* \w los|strong="H5921"\w* \w Treinta|strong="H7970"\w*, pero \w no|strong="H3808"\w* llegó \w a|strong="H3068"\w* igualar \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w Tres|strong="H7969"\w* principales. \w Y|strong="H3068"\w* \w David|strong="H1732"\w* \w lo|strong="H1931"\w* \w puso|strong="H7760"\w* \w a|strong="H3068"\w* cargo \w de|strong="H4480"\w* \w su|strong="H1931"\w* guardia personal.   
\p
\v 26 Entre \w los|strong="H1121"\w* guerreros \w valientes|strong="H1368"\w* del \w ejército|strong="H2428"\w* también estaban \w Asael|strong="H6214"\w*, hermano \w de|strong="H1121"\w* \w Joab|strong="H3097"\w*; Elhanán, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Dodo, \w de|strong="H1121"\w* Belén;  
\v 27 Samot el harorita, \w Heles|strong="H2503"\w* el pelonita,  
\v 28 \w Ira|strong="H5896"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Iques \w el|strong="H1121"\w* \w tecoíta|strong="H8621"\w*, Abiezer \w el|strong="H1121"\w* anatotita,  
\v 29 Sibecai el \w husatita|strong="H2843"\w*, \w Ilai|strong="H5866"\w* el ahohíta,  
\v 30 \w Maharai|strong="H4121"\w* \w el|strong="H1121"\w* \w netofatita|strong="H5200"\w*, \w Heled|strong="H2466"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Baana|strong="H1196"\w* \w el|strong="H1121"\w* \w netofatita|strong="H5200"\w*,  
\v 31 Itai \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ribai, \w de|strong="H1121"\w* Guibeá \w de|strong="H1121"\w* \w los|strong="H1121"\w* benjaminitas; \w Benaía|strong="H1141"\w* \w el|strong="H1121"\w* \w piratonita|strong="H6553"\w*,  
\v 32 \w Hurai|strong="H2360"\w* de los \w arroyos|strong="H5158"\w* de \w Gaas|strong="H1608"\w*, Abiel el arbateo,  
\v 33 Azmavet el baharumita, Eliaba el \w saalbonita|strong="H8170"\w*,  
\v 34 \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Hasem \w el|strong="H1121"\w* \w gizonita|strong="H1493"\w*, Jonatán \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sage \w el|strong="H1121"\w* \w ararita|strong="H2043"\w*,  
\v 35 Ahíam \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sacar \w el|strong="H1121"\w* \w ararita|strong="H2043"\w*, Elifal \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ur,  
\v 36 Hefer el mequeratita, Ahías el pelonita,  
\v 37 Hezro \w el|strong="H1121"\w* \w carmelita|strong="H3761"\w*, Naarai \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ezbai,  
\v 38 \w Joel|strong="H3100"\w* hermano \w de|strong="H1121"\w* Natán, \w Mibhar|strong="H4006"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Hagri,  
\v 39 \w Selec|strong="H6768"\w* \w el|strong="H1121"\w* amonita, \w Naharai|strong="H5171"\w* \w el|strong="H1121"\w* berotita (\w el|strong="H1121"\w* \w escudero|strong="H5375"\w* \w de|strong="H1121"\w* \w Joab|strong="H3097"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sarvia),  
\v 40 \w Ira|strong="H5896"\w* el itrita, \w Gareb|strong="H1619"\w* el itrita,  
\v 41 Urías \w el|strong="H1121"\w* hitita, \w Zabad|strong="H2066"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahlai,  
\v 42 \w Adina|strong="H5721"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Siza \w el|strong="H5921"\w* \w rubenita|strong="H7206"\w* (\w jefe|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* rubenitas), \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w treinta|strong="H7970"\w* \w que|strong="H5921"\w* \w estaban|strong="H7218"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w*;  
\v 43 \w Hanán|strong="H2605"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maaca, Josafat \w el|strong="H1121"\w* mitnita,  
\v 44 Uzías \w el|strong="H1121"\w* asterita, Sama y \w Jeiel|strong="H3273"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Hotam \w el|strong="H1121"\w* aroerita,  
\v 45 \w Jediael|strong="H3043"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Simri|strong="H8113"\w*, y Joha su hermano, \w el|strong="H1121"\w* tizita,  
\v 46 Eliel \w el|strong="H1121"\w* mahavita, \w Jeribai|strong="H3403"\w* y Josavías \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Elnaam, \w e|strong="H3068"\w* Itma \w el|strong="H1121"\w* \w moabita|strong="H4125"\w*,  
\v 47 Eliel, \w Obed|strong="H5744"\w* y Jaasiel el mezobaíta.   
\c 12  
\p
\v 1 \w Estos|strong="H1992"\w* son \w los|strong="H1992"\w* \w hombres|strong="H1368"\w* \w que|strong="H1121"\w* \w se|strong="H1992"\w* unieron \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w en|strong="H5750"\w* \w Siclag|strong="H6860"\w*, cuando \w él|strong="H1121"\w* huía \w de|strong="H6440"\w* \w Saúl|strong="H7586"\w*, \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w Cis|strong="H7027"\w*. Eran guerreros \w valientes|strong="H1368"\w* \w que|strong="H1121"\w* \w lo|strong="H1992"\w* \w ayudaron|strong="H5826"\w* \w en|strong="H5750"\w* la \w guerra|strong="H4421"\w*.  
\v 2 Estaban \w armados|strong="H5401"\w* con \w arcos|strong="H7198"\w* y eran expertos en usar tanto la mano derecha como la izquierda para lanzar piedras con la honda \w o|strong="H3068"\w* disparar flechas con el \w arco|strong="H7198"\w*. Eran de la tribu de \w Benjamín|strong="H1144"\w*, familiares de \w Saúl|strong="H7586"\w*.  
\v 3 \w El|strong="H1121"\w* \w jefe|strong="H7218"\w* \w era|strong="H1121"\w* Ahiezer, seguido por \w Joás|strong="H3101"\w*, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Semaá \w el|strong="H1121"\w* gabaatita; también \w estaban|strong="H7218"\w* Jeziel y \w Pelet|strong="H6404"\w*, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Azmavet; Beraca; \w Jehú|strong="H3058"\w* \w el|strong="H1121"\w* anatotita;  
\v 4 \w Ismaías|strong="H3460"\w* \w el|strong="H5921"\w* \w gabaonita|strong="H1393"\w*, un guerrero \w valiente|strong="H1368"\w* \w entre|strong="H5921"\w* \w los|strong="H5921"\w* \w Treinta|strong="H7970"\w* \w y|strong="H5921"\w* líder \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*; Jeremías; Jahaziel; Johanán; Jozabad \w el|strong="H5921"\w* gederatita;  
\v 5 Eluzai; Jerimot; Bealías; Semarías; Sefatías el harufita;  
\v 6 Elcaná, Isías, Azarel, Joezer y Jasobeam, que eran coreítas;  
\v 7 y Joela y Zebadías, hijos de Jeroham de Gedor.   
\p
\v 8 \w De|strong="H4480"\w* la tribu \w de|strong="H4480"\w* Gad, algunos \w hombres|strong="H1121"\w* \w se|strong="H4480"\w* unieron \w a|strong="H3068"\w* David \w en|strong="H4480"\w* su refugio \w en|strong="H4480"\w* \w el|strong="H1121"\w* desierto. Eran guerreros \w valientes|strong="H1121"\w* y entrenados \w para|strong="H4480"\w* la batalla, expertos \w en|strong="H4480"\w* manejar \w el|strong="H1121"\w* escudo y la lanza. Sus caras parecían \w de|strong="H4480"\w* león y eran tan rápidos como gacelas \w en|strong="H4480"\w* las montañas:  
\v 9 Ezer era \w el|strong="H5921"\w* jefe; Abdías, \w el|strong="H5921"\w* segundo; Eliab, \w el|strong="H5921"\w* tercero;  
\v 10 Mismana, el cuarto; Jeremías, el quinto;  
\v 11 Atai, el sexto; Eliel, el séptimo;  
\v 12 Johanán, el octavo; Elzabad, el noveno;  
\v 13 Jeremías, el décimo; y Macbanai, el undécimo.  
\v 14 Estos descendientes de Gad eran capitanes del ejército. El de menor rango valía por cien hombres, y el mayor por mil.  
\v 15 Fueron ellos \w los|strong="H1121"\w* \w que|strong="H1121"\w* cruzaron \w el|strong="H1121"\w* río Jordán en \w el|strong="H1121"\w* \w primer|strong="H7218"\w* mes del año, cuando se desbordaba por sus orillas, \w e|strong="H3068"\w* hicieron huir \w a|strong="H3068"\w* todos \w los|strong="H1121"\w* \w que|strong="H1121"\w* vivían en \w los|strong="H1121"\w* valles, tanto al este como al oeste.   
\p
\v 16 También algunos hombres \w de|strong="H5921"\w* \w las|strong="H1992"\w* tribus \w de|strong="H5921"\w* Benjamín \w y|strong="H5921"\w* \w de|strong="H5921"\w* Judá fueron \w al|strong="H5921"\w* refugio \w de|strong="H5921"\w* David.  
\v 17 \w David|strong="H1732"\w* salió \w a|strong="H3068"\w* recibirlos \w y|strong="H5704"\w* les dijo: “Si ustedes han venido \w en|strong="H4480"\w* paz \w para|strong="H5704"\w* ayudarme, mi corazón \w se|strong="H4480"\w* unirá \w a|strong="H3068"\w* ustedes; pero si han venido \w para|strong="H5704"\w* entregarme \w a|strong="H3068"\w* mis enemigos, \w a|strong="H3068"\w* pesar \w de|strong="H4480"\w* \w que|strong="H4480"\w* no he hecho nada malo, \w que|strong="H4480"\w* \w el|strong="H1121"\w* Dios \w de|strong="H4480"\w* nuestros antepasados \w lo|strong="H5704"\w* vea \w y|strong="H5704"\w* \w los|strong="H1121"\w* juzgue.”  
\v 18 Entonces \w el|strong="H5921"\w* Espíritu \w vino|strong="H1961"\w* \w sobre|strong="H5921"\w* Amasai, jefe \w de|strong="H5921"\w* \w los|strong="H5921"\w* Treinta, \w y|strong="H5921"\w* \w él|strong="H5921"\w* exclamó: “¡\w Somos|strong="H1961"\w* tuyos, \w David|strong="H1732"\w*! ¡Estamos \w contigo|strong="H5921"\w*, hijo \w de|strong="H5921"\w* Isaí! ¡\w Que|strong="H3808"\w* tengas \w mucha|strong="H7965"\w* \w paz|strong="H7965"\w*, tú \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3808"\w* \w te|strong="H5921"\w* \w ayudan|strong="H5826"\w*, \w porque|strong="H5921"\w* tu Dios \w te|strong="H5921"\w* \w ayuda|strong="H5826"\w*!” Entonces \w David|strong="H1732"\w* \w los|strong="H5921"\w* recibió \w y|strong="H5921"\w* \w los|strong="H5921"\w* nombró capitanes \w de|strong="H5921"\w* sus tropas.   
\p
\v 19 Algunos \w hombres|strong="H1121"\w* \w de|strong="H3588"\w* Manasés también se pasaron al bando \w de|strong="H3588"\w* \w David|strong="H1732"\w* \w cuando|strong="H3588"\w* \w él|strong="H5973"\w* marchaba \w con|strong="H5973"\w* \w los|strong="H1121"\w* filisteos \w para|strong="H3588"\w* pelear \w contra|strong="H5973"\w* Saúl. Sin embargo, \w no|strong="H3588"\w* \w ayudaron|strong="H5826"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* filisteos \w porque|strong="H3588"\w*, después \w de|strong="H3588"\w* consultarlo, \w los|strong="H1121"\w* líderes filisteos despidieron \w a|strong="H3068"\w* \w David|strong="H1732"\w*, diciendo: “Nos costará \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w si|strong="H3588"\w* este \w hombre|strong="H1121"\w* se vuelve \w a|strong="H3068"\w* unir \w a|strong="H3068"\w* \w su|strong="H3588"\w* amo Saúl.”   
\p
\v 20 \w Cuando|strong="H3588"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* dirigía \w a|strong="H3068"\w* Siclag, \w se|strong="H5921"\w* \w le|strong="H5921"\w* unieron estos hombres \w de|strong="H4480"\w* \w Manasés|strong="H4519"\w*: Adnas, Jozabad, Jediael, Miguel, Jozabad, Eliú \w y|strong="H3588"\w* Ziletai, todos \w ellos|strong="H5921"\w* \w jefes|strong="H7218"\w* \w de|strong="H4480"\w* mil \w en|strong="H5921"\w* \w la|strong="H5921"\w* tribu \w de|strong="H4480"\w* \w Manasés|strong="H4519"\w*.  
\v 21 \w Ellos|strong="H5921"\w* ayudaron \w a|strong="H3068"\w* David \w a|strong="H3068"\w* combatir \w a|strong="H3068"\w* \w las|strong="H5921"\w* bandas \w de|strong="H5921"\w* saqueadores, pues todos eran guerreros valientes \w y|strong="H5921"\w* comandantes \w del|strong="H5921"\w* ejército.  
\v 22 \w Todos|strong="H3605"\w* \w los|strong="H1992"\w* días llegaban \w más|strong="H3588"\w* \w hombres|strong="H1368"\w* \w para|strong="H5921"\w* ayudar \w a|strong="H3068"\w* \w David|strong="H1732"\w*, \w hasta|strong="H5921"\w* \w que|strong="H3588"\w* formaron un \w ejército|strong="H2428"\w* inmenso, \w como|strong="H3588"\w* \w el|strong="H5921"\w* \w ejército|strong="H2428"\w* \w de|strong="H5921"\w* Dios.   
\p
\v 23 Estas \w son|strong="H3588"\w* \w las|strong="H5921"\w* cifras \w de|strong="H5921"\w* \w los|strong="H5921"\w* soldados equipados \w para|strong="H5704"\w* \w la|strong="H5921"\w* guerra \w que|strong="H3588"\w* \w se|strong="H5921"\w* unieron \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w en|strong="H5921"\w* Hebrón \w para|strong="H5704"\w* entregarle \w el|strong="H5921"\w* reino \w de|strong="H5921"\w* Saúl, tal \w como|strong="H3588"\w* Yahvé \w lo|strong="H5921"\w* \w había|strong="H3588"\w* prometido:  
\v 24 \w De|strong="H5921"\w* Judá: seis mil ochocientos hombres \w armados|strong="H2502"\w* \w con|strong="H5921"\w* escudo \w y|strong="H5921"\w* lanza, listos \w para|strong="H5921"\w* pelear.  
\v 25 \w De|strong="H1121"\w* Simeón: siete \w mil|strong="H3967"\w* \w cien|strong="H3967"\w* guerreros \w valientes|strong="H1121"\w*, listos para la \w guerra|strong="H6635"\w*.  
\v 26 \w De|strong="H4480"\w* Leví: cuatro \w mil|strong="H3967"\w* seiscientos \w hombres|strong="H1368"\w*.  
\v 27 Joiada \w era|strong="H1121"\w* \w el|strong="H1121"\w* líder \w de|strong="H4480"\w* la familia \w de|strong="H4480"\w* Aarón, y \w con|strong="H4480"\w* \w él|strong="H1121"\w* iban tres \w mil|strong="H3967"\w* setecientos guerreros,  
\v 28 \w junto|strong="H5973"\w* \w con|strong="H5973"\w* Sadoc, un joven y valiente guerrero, y veintidós capitanes \w de|strong="H5973"\w* su propia familia.  
\v 29 \w De|strong="H8269"\w* Benjamín (los familiares \w de|strong="H8269"\w* Saúl): tres mil \w hombres|strong="H1368"\w*, pues hasta ese momento la mayoría se había mantenido leal \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H8269"\w* Saúl.  
\v 30 \w De|strong="H4480"\w* Efraín: veinte mil ochocientos guerreros \w valientes|strong="H1121"\w*, \w hombres|strong="H1121"\w* famosos \w en|strong="H4480"\w* sus \w familias|strong="H1004"\w*.  
\v 31 \w De|strong="H4480"\w* la media tribu \w de|strong="H4480"\w* Manasés: \w dieciocho|strong="H8083"\w* \w mil|strong="H3967"\w* \w hombres|strong="H1368"\w* \w nombrados|strong="H8034"\w* uno \w por|strong="H4480"\w* uno \w para|strong="H4480"\w* ir y hacer rey \w a|strong="H3068"\w* David.  
\v 32 De Isacar: doscientos líderes que entendían bien los tiempos y sabían lo que Israel debía hacer. Todos sus parientes estaban bajo sus órdenes.  
\v 33 \w De|strong="H5921"\w* Zabulón: cincuenta \w mil|strong="H3967"\w* soldados experimentados, listos \w para|strong="H5921"\w* \w la|strong="H5921"\w* batalla, armados \w con|strong="H5921"\w* \w toda|strong="H3605"\w* clase \w de|strong="H5921"\w* armas, capaces \w de|strong="H5921"\w* mantener \w la|strong="H5921"\w* formación \w y|strong="H5921"\w* \w de|strong="H5921"\w* lealtad absoluta.  
\v 34 De Neftalí: mil capitanes, acompañados por treinta y siete mil hombres armados con escudo y lanza.  
\v 35 \w De|strong="H5973"\w* Dan: veintiocho mil seiscientos hombres preparados \w para|strong="H5973"\w* pelear.  
\v 36 \w De|strong="H4480"\w* Aser: cuarenta \w mil|strong="H3967"\w* soldados experimentados, listos \w para|strong="H4480"\w* la \w batalla|strong="H4421"\w*.  
\v 37 \w Y|strong="H3068"\w* del lado este del río Jordán, de las tribus de Rubén, Gad y la media tribu de Manasés: ciento veinte mil hombres armados con todo tipo de armas de \w guerra|strong="H4421"\w*.   
\p
\v 38 \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* soldados, entrenados \w para|strong="H4480"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*, fueron \w a|strong="H3068"\w* Hebrón \w con|strong="H4480"\w* un corazón totalmente decidido \w a|strong="H3068"\w* coronar \w a|strong="H3068"\w* David como rey \w de|strong="H4480"\w* \w todo|strong="H3605"\w* Israel. \w Además|strong="H4480"\w*, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* resto \w de|strong="H4480"\w* \w los|strong="H3605"\w* israelitas estaba unido \w en|strong="H4480"\w* \w el|strong="H3605"\w* \w mismo|strong="H3605"\w* propósito \w de|strong="H4480"\w* hacer rey \w a|strong="H3068"\w* David.  
\v 39 Estuvieron allí \w con|strong="H5921"\w* \w David|strong="H1732"\w* durante tres días, comiendo \w y|strong="H1571"\w* bebiendo \w lo|strong="H5921"\w* \w que|strong="H5921"\w* sus hermanos \w les|strong="H5921"\w* habían preparado.  
\v 40 También \w los|strong="H5973"\w* vecinos \w más|strong="H3588"\w* cercanos, \w e|strong="H3068"\w* incluso gente \w de|strong="H3588"\w* lugares tan lejanos \w como|strong="H3588"\w* Isacar, Zabulón \w y|strong="H3588"\w* Neftalí, llevaron comida \w en|strong="H5973"\w* burros, camellos, mulas \w y|strong="H3588"\w* bueyes. Trajeron grandes cantidades \w de|strong="H3588"\w* harina, tortas \w de|strong="H3588"\w* higo, racimos \w de|strong="H3588"\w* pasas, \w vino|strong="H1961"\w*, aceite, reses \w y|strong="H3588"\w* ovejas, \w porque|strong="H3588"\w* \w había|strong="H1961"\w* una gran alegría \w en|strong="H5973"\w* Israel.   
\c 13  
\p
\v 1 \w David|strong="H1732"\w* consultó \w con|strong="H5973"\w* \w los|strong="H3605"\w* \w capitanes|strong="H8269"\w* \w de|strong="H5973"\w* miles y \w de|strong="H5973"\w* cientos, y \w con|strong="H5973"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes.  
\v 2 \w David|strong="H1732"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* asamblea \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*: “\w Si|strong="H5921"\w* \w a|strong="H3068"\w* ustedes \w les|strong="H5973"\w* parece \w bien|strong="H2895"\w*, \w y|strong="H5921"\w* \w si|strong="H5921"\w* es \w la|strong="H5921"\w* voluntad \w de|strong="H4480"\w* Yahvé nuestro \w Dios|strong="H3068"\w*, mandemos \w a|strong="H3068"\w* decir \w a|strong="H3068"\w* nuestros hermanos \w que|strong="H4480"\w* \w se|strong="H5921"\w* han quedado \w en|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H4480"\w* están \w en|strong="H5921"\w* sus \w ciudades|strong="H5892"\w* \w y|strong="H5921"\w* campos, \w que|strong="H4480"\w* \w se|strong="H5921"\w* reúnan \w con|strong="H5973"\w* \w nosotros|strong="H3605"\w*.  
\v 3 \w Además|strong="H3588"\w*, traigamos \w de|strong="H3588"\w* regreso \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* nuestro Dios, \w pues|strong="H3588"\w* \w no|strong="H3808"\w* \w la|strong="H3588"\w* buscamos durante \w el|strong="H3588"\w* reinado \w de|strong="H3588"\w* \w Saúl|strong="H7586"\w*.”   
\p
\v 4 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea respondió \w que|strong="H3588"\w* \w lo|strong="H1697"\w* harían, \w porque|strong="H3588"\w* \w la|strong="H3605"\w* propuesta \w le|strong="H5869"\w* \w pareció|strong="H3474"\w* \w bien|strong="H3588"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 5 Entonces \w David|strong="H1732"\w* reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w desde|strong="H4480"\w* \w el|strong="H3605"\w* río \w Sihor|strong="H7883"\w* \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* \w hasta|strong="H5704"\w* \w la|strong="H3605"\w* entrada \w de|strong="H4480"\w* Hamat, \w para|strong="H5704"\w* traer \w el|strong="H3605"\w* arca \w de|strong="H4480"\w* Dios \w desde|strong="H4480"\w* Quiriat Jearim.   
\p
\v 6 \w David|strong="H1732"\w* y \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* \w Baalá|strong="H1173"\w*, es \w decir|strong="H7121"\w*, \w a|strong="H3068"\w* Quiriat Jearim, \w que|strong="H3605"\w* pertenecía \w a|strong="H3068"\w* \w Judá|strong="H3063"\w*, para trasladar desde \w allí|strong="H8033"\w* \w el|strong="H3605"\w* arca de \w Dios|strong="H3068"\w* \w que|strong="H3605"\w* descansa sobre \w los|strong="H3427"\w* \w querubines|strong="H3742"\w*, \w donde|strong="H8033"\w* se invoca su \w Nombre|strong="H8034"\w*.  
\v 7 Llevaron \w el|strong="H5921"\w* arca \w de|strong="H5921"\w* Dios \w en|strong="H5921"\w* una carreta \w nueva|strong="H2319"\w*, sacándola \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Abinadab; Uza \w y|strong="H5921"\w* Ahío \w guiaban|strong="H5090"\w* \w la|strong="H5921"\w* carreta.  
\v 8 \w David|strong="H1732"\w* \w y|strong="H5797"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* celebraban \w ante|strong="H6440"\w* Dios con \w todas|strong="H3605"\w* sus fuerzas, cantando \w y|strong="H5797"\w* tocando \w arpas|strong="H3658"\w*, liras, panderos, \w címbalos|strong="H4700"\w* \w y|strong="H5797"\w* \w trompetas|strong="H2689"\w*.   
\p
\v 9 \w Cuando|strong="H3588"\w* llegaron \w a|strong="H3068"\w* \w la|strong="H3588"\w* era \w de|strong="H3588"\w* Quidón, Uza \w extendió|strong="H7971"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w* \w para|strong="H5704"\w* sostener \w el|strong="H3588"\w* arca, \w porque|strong="H3588"\w* \w los|strong="H3588"\w* \w bueyes|strong="H1241"\w* tropezaron.  
\v 10 \w La|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* encendió \w contra|strong="H5921"\w* Uza, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w quitó|strong="H4191"\w* \w la|strong="H5921"\w* vida \w por|strong="H5921"\w* haber puesto su \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* arca; \w y|strong="H5921"\w* \w allí|strong="H8033"\w* mismo \w murió|strong="H4191"\w* \w ante|strong="H6440"\w* \w Dios|strong="H3068"\w*.  
\v 11 \w David|strong="H1732"\w* \w se|strong="H1931"\w* enojó \w porque|strong="H3588"\w* Yahvé \w había|strong="H3588"\w* castigado \w con|strong="H3588"\w* ira \w a|strong="H3068"\w* Uza. \w Por|strong="H3588"\w* \w eso|strong="H1931"\w*, \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* Pérez Uza, \w nombre|strong="H7121"\w* \w que|strong="H3588"\w* \w tiene|strong="H1931"\w* \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w hoy|strong="H3117"\w*.  
\v 12 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* \w David|strong="H1732"\w* \w tuvo|strong="H3372"\w* \w temor|strong="H3372"\w* \w de|strong="H3372"\w* Dios, y dijo: “¿\w Cómo|strong="H1963"\w* voy \w a|strong="H3068"\w* llevarme \w el|strong="H1931"\w* arca \w de|strong="H3372"\w* Dios \w a|strong="H3068"\w* mi casa?”  
\v 13 Así \w que|strong="H3808"\w* \w David|strong="H1732"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* llevó el arca \w a|strong="H3068"\w* la \w Ciudad|strong="H5892"\w* de \w David|strong="H1732"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* la desvió hacia la \w casa|strong="H1004"\w* de \w Obed-Edom|strong="H5654"\w*, el geteo.  
\v 14 \w El|strong="H5973"\w* arca \w de|strong="H5973"\w* \w Dios|strong="H3068"\w* se \w quedó|strong="H3427"\w* \w con|strong="H5973"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* \w de|strong="H5973"\w* \w Obed-Edom|strong="H5654"\w* \w en|strong="H5973"\w* su \w casa|strong="H1004"\w* durante \w tres|strong="H7969"\w* \w meses|strong="H2320"\w*; y \w el|strong="H5973"\w* \w Señor|strong="H3068"\w* \w bendijo|strong="H1288"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w familia|strong="H1004"\w* \w de|strong="H5973"\w* \w Obed-Edom|strong="H5654"\w* y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* tenía.   
\c 14  
\p
\v 1 \w Hiram|strong="H2438"\w*, \w rey|strong="H4428"\w* de \w Tiro|strong="H6865"\w*, le \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* con \w madera|strong="H6086"\w* de cedro, \w albañiles|strong="H2796"\w* y \w carpinteros|strong="H2796"\w* para que le construyeran un palacio.  
\v 2 \w David|strong="H1732"\w* comprendió \w que|strong="H3588"\w* Yahvé \w lo|strong="H5921"\w* \w había|strong="H3588"\w* \w establecido|strong="H3559"\w* \w como|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w pues|strong="H3588"\w* \w su|strong="H3588"\w* \w reino|strong="H4438"\w* \w se|strong="H3045"\w* \w había|strong="H3588"\w* engrandecido mucho, \w por|strong="H5921"\w* amor \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.   
\p
\v 3 \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* \w más|strong="H5750"\w* esposas \w en|strong="H5750"\w* Jerusalén, y fue padre \w de|strong="H5750"\w* \w más|strong="H5750"\w* \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*.  
\v 4 Estos \w son|strong="H1961"\w* \w los|strong="H1961"\w* \w nombres|strong="H8034"\w* de \w los|strong="H1961"\w* hijos \w que|strong="H1961"\w* \w tuvo|strong="H1961"\w* en Jerusalén: \w Samúa|strong="H8051"\w*, \w Sobab|strong="H7727"\w*, Natán, \w Salomón|strong="H8010"\w*,  
\v 5 \w Ibhar|strong="H2984"\w*, Elisúa, Elfelet,  
\v 6 \w Noga|strong="H5052"\w*, Néfeg, Jafía,  
\v 7 Elisama, Beeliada y Elifelet.   
\p
\v 8 \w Cuando|strong="H3588"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w* \w se|strong="H5921"\w* enteraron \w de|strong="H5921"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* sido \w ungido|strong="H4886"\w* \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w todos|strong="H3605"\w* \w ellos|strong="H5921"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* buscarlo; \w pero|strong="H3588"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* enteró \w y|strong="H3588"\w* \w salió|strong="H3318"\w* \w a|strong="H3068"\w* enfrentarlos.  
\v 9 Los \w filisteos|strong="H6430"\w* habían llegado y estaban saqueando el \w valle|strong="H6010"\w* de Refaim.  
\v 10 \w David|strong="H1732"\w* \w consultó|strong="H7592"\w* \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*, diciendo: “¿Debo atacar \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*? ¿\w Los|strong="H5921"\w* entregarás \w en|strong="H5921"\w* \w mis|strong="H5414"\w* \w manos|strong="H3027"\w*?”  
\p Yahvé \w le|strong="H5921"\w* respondió: “Atácalos, \w porque|strong="H5921"\w* yo \w los|strong="H5921"\w* \w entregaré|strong="H5414"\w* \w en|strong="H5921"\w* tus \w manos|strong="H3027"\w*.”   
\p
\v 11 \w Así|strong="H3651"\w* \w que|strong="H1931"\w* \w subieron|strong="H5927"\w* \w a|strong="H3068"\w* Baal Perazim, \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w David|strong="H1732"\w* \w los|strong="H5921"\w* derrotó. \w David|strong="H1732"\w* dijo: “Dios usó mis \w manos|strong="H3027"\w* \w para|strong="H5921"\w* abrir una brecha \w entre|strong="H5921"\w* mis enemigos, \w como|strong="H5921"\w* una corriente \w de|strong="H5921"\w* \w agua|strong="H4325"\w* \w que|strong="H1931"\w* \w se|strong="H1931"\w* desborda.” \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w llamaron|strong="H7121"\w* \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w lugar|strong="H4725"\w* Baal Perazim. \f + \fr 14:11 \ft “Baal Perazim” significa “El Señor que irrumpe”.\f*  
\v 12 Los filisteos \w dejaron|strong="H5800"\w* \w allí|strong="H8033"\w* sus ídolos, y por orden de \w David|strong="H1732"\w* \w fueron|strong="H1732"\w* quemados.   
\p
\v 13 Tiempo después, los \w filisteos|strong="H6430"\w* volvieron \w a|strong="H3068"\w* invadir el \w valle|strong="H6010"\w*.  
\v 14 \w David|strong="H1732"\w* \w volvió|strong="H5750"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Dios, \w y|strong="H5921"\w* Dios \w le|strong="H5921"\w* dijo: “\w No|strong="H3808"\w* \w los|strong="H1992"\w* ataques \w de|strong="H5921"\w* frente. Rodéalos \w y|strong="H5921"\w* acércate \w a|strong="H3068"\w* \w ellos|strong="H1992"\w* \w por|strong="H5921"\w* \w el|strong="H5921"\w* lado \w de|strong="H5921"\w* \w las|strong="H1992"\w* balsameras.  
\v 15 \w Cuando|strong="H3588"\w* escuches un \w sonido|strong="H6963"\w* \w como|strong="H3588"\w* \w de|strong="H3588"\w* pasos \w en|strong="H3588"\w* las copas \w de|strong="H3588"\w* las balsameras, \w sal|strong="H3318"\w* \w a|strong="H3068"\w* pelear, \w porque|strong="H3588"\w* Dios \w irá|strong="H3318"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* ti \w para|strong="H3588"\w* atacar al \w ejército|strong="H4264"\w* \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w*.”   
\p
\v 16 \w David|strong="H1732"\w* \w hizo|strong="H6213"\w* tal \w como|strong="H5704"\w* Dios le \w ordenó|strong="H6680"\w*, \w y|strong="H5704"\w* derrotaron \w al|strong="H5704"\w* \w ejército|strong="H4264"\w* \w filisteo|strong="H6430"\w* \w desde|strong="H5704"\w* \w Gabaón|strong="H1391"\w* \w hasta|strong="H5704"\w* \w Gezer|strong="H1507"\w*.  
\v 17 \w La|strong="H5921"\w* \w fama|strong="H8034"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* extendió \w por|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* países, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w hizo|strong="H5414"\w* \w que|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w le|strong="H5921"\w* tuvieran \w temor|strong="H6343"\w*.   
\c 15  
\p
\v 1 \w David|strong="H1732"\w* se construyó \w casas|strong="H1004"\w* en la \w Ciudad|strong="H5892"\w* de \w David|strong="H1732"\w*, \w preparó|strong="H3559"\w* un \w lugar|strong="H4725"\w* para \w el|strong="H6213"\w* arca de Dios y le armó una tienda.  
\v 2 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* dijo: “\w Nadie|strong="H3808"\w*, excepto \w los|strong="H3588"\w* \w levitas|strong="H3881"\w*, debe cargar \w el|strong="H3588"\w* arca \w de|strong="H3588"\w* \w Dios|strong="H3068"\w*. Yahvé \w los|strong="H3588"\w* eligió \w a|strong="H3068"\w* ellos \w para|strong="H5704"\w* llevar \w el|strong="H3588"\w* arca \w y|strong="H3588"\w* \w para|strong="H5704"\w* servirle \w siempre|strong="H5769"\w*.”   
\p
\v 3 \w David|strong="H1732"\w* reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* en Jerusalén para llevar \w el|strong="H3605"\w* arca de Yahvé al \w lugar|strong="H4725"\w* \w que|strong="H3605"\w* le había preparado.  
\v 4 \w David|strong="H1732"\w* reunió \w a|strong="H3068"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Aarón y \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*:  
\v 5 \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Coat, Uriel \w el|strong="H1121"\w* líder y \w ciento|strong="H3967"\w* \w veinte|strong="H6242"\w* \w de|strong="H1121"\w* sus parientes;  
\v 6 \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Merari|strong="H4847"\w*, \w Asaías|strong="H6222"\w* \w el|strong="H1121"\w* líder y \w doscientos|strong="H3967"\w* \w veinte|strong="H6242"\w* \w de|strong="H1121"\w* sus parientes;  
