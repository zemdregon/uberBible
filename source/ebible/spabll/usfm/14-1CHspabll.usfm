\v 27 Simei \w el|strong="H5921"\w* ramatita estaba \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w los|strong="H5921"\w* viñedos, \w y|strong="H5921"\w* \w Zabdi|strong="H2067"\w* \w el|strong="H5921"\w* sifmita administraba \w las|strong="H5921"\w* bodegas \w de|strong="H5921"\w* \w vino|strong="H3196"\w* producidas \w por|strong="H5921"\w* \w los|strong="H5921"\w* viñedos.  
\v 28 Baal Hanán \w el|strong="H5921"\w* \w gederita|strong="H1451"\w* cuidaba \w los|strong="H5921"\w* olivos \w y|strong="H5921"\w* \w los|strong="H5921"\w* árboles \w de|strong="H5921"\w* sicómoro \w en|strong="H5921"\w* \w la|strong="H5921"\w* región \w de|strong="H5921"\w* \w la|strong="H5921"\w* Sefela, \w y|strong="H5921"\w* \w Joás|strong="H3135"\w* administraba \w los|strong="H5921"\w* almacenes \w de|strong="H5921"\w* \w aceite|strong="H8081"\w* \w de|strong="H5921"\w* oliva.  
\v 29 \w Sitrai|strong="H7861"\w* \w el|strong="H5921"\w* \w saronita|strong="H8290"\w* cuidaba \w el|strong="H5921"\w* \w ganado|strong="H1121"\w* \w que|strong="H5921"\w* pastaba \w en|strong="H5921"\w* \w la|strong="H5921"\w* llanura \w de|strong="H5921"\w* \w Sarón|strong="H8289"\w*, \w y|strong="H5921"\w* Safat \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Adlai|strong="H5724"\w* cuidaba \w el|strong="H5921"\w* \w ganado|strong="H1121"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w valles|strong="H6010"\w*.  
\v 30 Obil \w el|strong="H5921"\w* \w ismaelita|strong="H3459"\w* era \w el|strong="H5921"\w* encargado \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w camellos|strong="H1581"\w*, \w y|strong="H5921"\w* Jehdeías \w el|strong="H5921"\w* meronita cuidaba \w los|strong="H5921"\w* burros. Jaziz \w el|strong="H5921"\w* agareno estaba \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* \w los|strong="H5921"\w* rebaños \w de|strong="H5921"\w* ovejas \w y|strong="H5921"\w* cabras.  
\v 31 \w Todos|strong="H3605"\w* \w ellos|strong="H5921"\w* eran \w los|strong="H5921"\w* administradores \w de|strong="H5921"\w* \w las|strong="H5921"\w* propiedades \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w*.   
\p
\v 32 Jonatán, \w tío|strong="H1730"\w* \w de|strong="H5973"\w* \w David|strong="H1732"\w*, \w era|strong="H1931"\w* un \w consejero|strong="H3289"\w* muy inteligente y un \w escriba|strong="H5608"\w* excelente. \w Jehiel|strong="H3171"\w* \w hijo|strong="H1121"\w* \w de|strong="H5973"\w* Hacmoni \w se|strong="H1931"\w* encargaba \w de|strong="H5973"\w* \w la|strong="H1931"\w* educación \w de|strong="H5973"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w del|strong="H5973"\w* \w rey|strong="H4428"\w*.  
\v 33 Ahitófel era el \w consejero|strong="H3289"\w* principal del \w rey|strong="H4428"\w*, y \w Husai|strong="H2365"\w* el arquita era su \w amigo|strong="H7453"\w* personal.  
\v 34 Más tarde, \w Joiada|strong="H3077"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Benaía|strong="H1141"\w*, y Abiatar, tomaron \w el|strong="H1121"\w* lugar \w de|strong="H1121"\w* Ahitófel como consejeros. \w El|strong="H1121"\w* \w comandante|strong="H8269"\w* del \w ejército|strong="H6635"\w* del \w rey|strong="H4428"\w* \w era|strong="H1121"\w* \w Joab|strong="H3097"\w*.   
\c 28  
\p
\v 1 \w David|strong="H1732"\w* mandó llamar \w a|strong="H3068"\w* Jerusalén \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* líderes \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*: \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H5973"\w* las \w tribus|strong="H7626"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* comandantes \w de|strong="H5973"\w* las divisiones \w que|strong="H1121"\w* estaban \w al|strong="H4428"\w* servicio \w del|strong="H5973"\w* \w rey|strong="H4428"\w*, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H5973"\w* miles y \w de|strong="H5973"\w* cientos, \w a|strong="H3068"\w* \w los|strong="H1121"\w* encargados \w de|strong="H5973"\w* \w todas|strong="H3605"\w* las propiedades y \w del|strong="H5973"\w* \w ganado|strong="H4735"\w* \w del|strong="H5973"\w* \w rey|strong="H4428"\w* y \w de|strong="H5973"\w* sus \w hijos|strong="H1121"\w*, y \w a|strong="H3068"\w* \w los|strong="H1121"\w* funcionarios \w del|strong="H5973"\w* palacio, \w a|strong="H3068"\w* \w los|strong="H1121"\w* héroes y \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* guerreros \w valientes|strong="H1368"\w*.  
\v 2 \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w se|strong="H5921"\w* puso \w de|strong="H5921"\w* \w pie|strong="H7272"\w* \w y|strong="H5921"\w* \w les|strong="H5973"\w* dijo: “¡Escúchenme, hermanos míos \w y|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w mío|strong="H5921"\w*! Yo tenía muchas ganas \w de|strong="H5921"\w* construir un \w templo|strong="H1004"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé tuviera un lugar \w de|strong="H5921"\w* \w descanso|strong="H4496"\w*, \w y|strong="H5921"\w* \w que|strong="H5921"\w* sirviera \w como|strong="H5973"\w* un \w estrado|strong="H1916"\w* \w para|strong="H5921"\w* \w los|strong="H5921"\w* \w pies|strong="H7272"\w* \w de|strong="H5921"\w* nuestro \w Dios|strong="H3068"\w*. \w Ya|strong="H3068"\w* había preparado todo \w para|strong="H5921"\w* \w la|strong="H5921"\w* construcción.  
\v 3 \w Pero|strong="H3588"\w* Dios \w me|strong="H3588"\w* dijo: ‘Tú \w no|strong="H3808"\w* le vas \w a|strong="H3068"\w* construir una \w casa|strong="H1004"\w* \w a|strong="H3068"\w* mi \w nombre|strong="H8034"\w*, \w porque|strong="H3588"\w* eres un hombre \w de|strong="H3588"\w* \w guerra|strong="H4421"\w* \w y|strong="H3588"\w* has \w derramado|strong="H8210"\w* mucha \w sangre|strong="H1818"\w*.’  
\v 4 \w A|strong="H3068"\w* pesar \w de|strong="H5921"\w* eso, Yahvé, \w el|strong="H5921"\w* \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w me|strong="H5921"\w* eligió \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w toda|strong="H3605"\w* \w mi|strong="H5921"\w* \w familia|strong="H1004"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w fuera|strong="H1961"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*. \w Porque|strong="H3588"\w* \w él|strong="H5921"\w* escogió \w a|strong="H3068"\w* \w la|strong="H5921"\w* tribu \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w para|strong="H5921"\w* liderar; \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tribu \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, escogió \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* padre; \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w entre|strong="H5921"\w* mis hermanos, \w le|strong="H5921"\w* agradó elegirme \w a|strong="H3068"\w* \w mí|strong="H5921"\w* \w para|strong="H5921"\w* hacerme \w rey|strong="H4428"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 5 \w Y|strong="H3068"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w que|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* ha \w dado|strong="H5414"\w* (\w que|strong="H3588"\w* \w son|strong="H3588"\w* \w muchos|strong="H7227"\w*), \w él|strong="H5921"\w* ha escogido \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w para|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* siente \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w del|strong="H5921"\w* \w reino|strong="H4438"\w* \w de|strong="H5921"\w* Yahvé \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 6 Dios \w me|strong="H3588"\w* dijo: ‘Tu \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w es|strong="H1931"\w* \w quien|strong="H1931"\w* construirá \w mi|strong="H1961"\w* \w templo|strong="H1004"\w* \w y|strong="H3588"\w* mis \w patios|strong="H2691"\w*, \w porque|strong="H3588"\w* \w lo|strong="H1931"\w* he elegido \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w sea|strong="H1961"\w* \w mi|strong="H1961"\w* \w hijo|strong="H1121"\w*, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w su|strong="H1931"\w* padre.  
\v 7 Si \w él|strong="H6213"\w* se mantiene obediente \w a|strong="H3068"\w* mis \w mandamientos|strong="H4687"\w* \w y|strong="H5704"\w* leyes, \w tal|strong="H2088"\w* \w como|strong="H5704"\w* \w lo|strong="H2088"\w* \w hace|strong="H6213"\w* \w hoy|strong="H3117"\w*, \w yo|strong="H6213"\w* afirmaré su \w reino|strong="H4438"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.’   
\p
\v 8 \w Así|strong="H6258"\w* \w que|strong="H6258"\w* \w ahora|strong="H6258"\w*, \w delante|strong="H5869"\w* \w de|strong="H5704"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* (\w que|strong="H6258"\w* es \w la|strong="H8104"\w* asamblea \w de|strong="H5704"\w* Yahvé), \w y|strong="H5704"\w* sabiendo \w que|strong="H6258"\w* \w Dios|strong="H3068"\w* nos escucha, les pido \w lo|strong="H5704"\w* siguiente: observen \w y|strong="H5704"\w* busquen \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w mandamientos|strong="H4687"\w* \w de|strong="H5704"\w* Yahvé su \w Dios|strong="H3068"\w*. \w Así|strong="H6258"\w* podrán ser dueños \w de|strong="H5704"\w* esta \w buena|strong="H2896"\w* tierra \w y|strong="H5704"\w* se \w la|strong="H8104"\w* podrán dejar \w como|strong="H5704"\w* herencia \w a|strong="H3068"\w* sus descendientes \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.   
\p
\v 9 \w Y|strong="H3068"\w* tú, \w Salomón|strong="H8010"\w*, \w hijo|strong="H1121"\w* mío, \w reconoce|strong="H3045"\w* al \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* tu padre \w y|strong="H3588"\w* sírvele \w con|strong="H3588"\w* un \w corazón|strong="H3820"\w* completamente dedicado \w y|strong="H3588"\w* \w con|strong="H3588"\w* \w la|strong="H3588"\w* mejor disposición. Yahvé examina \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w corazones|strong="H3824"\w* \w y|strong="H3588"\w* \w conoce|strong="H3045"\w* \w cualquier|strong="H3605"\w* intención \w o|strong="H3068"\w* \w pensamiento|strong="H3820"\w* \w que|strong="H3588"\w* tengamos. \w Si|strong="H3588"\w* \w lo|strong="H3605"\w* buscas, \w lo|strong="H3605"\w* vas \w a|strong="H3068"\w* encontrar; \w pero|strong="H3588"\w* \w si|strong="H3588"\w* \w lo|strong="H3605"\w* abandonas, \w él|strong="H3588"\w* \w te|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* rechazar \w para|strong="H3588"\w* \w siempre|strong="H3605"\w*.  
\v 10 Date cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé \w te|strong="H3588"\w* ha elegido \w a|strong="H3068"\w* ti \w para|strong="H3588"\w* \w que|strong="H3588"\w* construyas una \w casa|strong="H1004"\w* \w que|strong="H3588"\w* sirva \w como|strong="H3588"\w* \w su|strong="H3588"\w* \w santuario|strong="H4720"\w*. ¡Sé fuerte \w y|strong="H3588"\w* pon manos \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w obra|strong="H6213"\w*!”   
\p
\v 11 Luego, \w David|strong="H1732"\w* le \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w los|strong="H1121"\w* planos arquitectónicos \w para|strong="H5414"\w* \w el|strong="H1121"\w* pórtico del \w templo|strong="H1004"\w*, sus edificios, sus bodegas, \w los|strong="H1121"\w* cuartos del piso superior, las habitaciones \w interiores|strong="H6442"\w* y \w el|strong="H1121"\w* lugar santísimo, donde estaría \w el|strong="H1121"\w* arca del perdón.  
\v 12 También \w le|strong="H5973"\w* entregó \w los|strong="H3605"\w* planos \w de|strong="H5973"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1961"\w* \w el|strong="H5973"\w* \w Espíritu|strong="H7307"\w* \w le|strong="H5973"\w* \w había|strong="H1961"\w* revelado: \w el|strong="H5973"\w* diseño \w de|strong="H5973"\w* \w los|strong="H3605"\w* \w patios|strong="H2691"\w* \w del|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Yahvé, \w los|strong="H3605"\w* cuartos exteriores, \w los|strong="H3605"\w* tesoros \w del|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* \w Dios|strong="H3068"\w* y \w los|strong="H3605"\w* cuartos \w para|strong="H1961"\w* las ofrendas \w sagradas|strong="H6944"\w*.  
\v 13 Le dio las instrucciones sobre cómo organizar \w los|strong="H3605"\w* turnos de \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w*, y sobre cómo realizar \w todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo del \w templo|strong="H1004"\w* y \w el|strong="H3605"\w* uso de \w los|strong="H3605"\w* utensilios.  
\v 14 David le entregó \w el|strong="H3605"\w* \w peso|strong="H4948"\w* exacto del \w oro|strong="H2091"\w* \w que|strong="H3605"\w* debía usarse \w para|strong="H4948"\w* hacer \w los|strong="H3605"\w* diversos utensilios de \w oro|strong="H2091"\w* \w para|strong="H4948"\w* \w cada|strong="H3605"\w* servicio, así como \w el|strong="H3605"\w* \w peso|strong="H4948"\w* de \w la|strong="H3605"\w* \w plata|strong="H3701"\w* \w para|strong="H4948"\w* hacer \w los|strong="H3605"\w* utensilios de \w plata|strong="H3701"\w*.  
\v 15 También especificó el \w peso|strong="H4948"\w* del \w oro|strong="H2091"\w* \w para|strong="H4948"\w* los candelabros y sus \w lámparas|strong="H5216"\w*, indicando cuánto \w oro|strong="H2091"\w* se necesitaba \w para|strong="H4948"\w* cada uno; \w e|strong="H3068"\w* hizo lo mismo \w para|strong="H4948"\w* los candelabros de \w plata|strong="H3701"\w* y sus \w lámparas|strong="H5216"\w*, dependiendo de cómo se fuera \w a|strong="H3068"\w* usar cada candelabro.  
\v 16 Le dio la cantidad exacta de \w oro|strong="H2091"\w* \w para|strong="H4948"\w* cada una de las \w mesas|strong="H7979"\w* donde se pondrían los panes consagrados, y la \w plata|strong="H3701"\w* \w para|strong="H4948"\w* las \w mesas|strong="H7979"\w* de \w plata|strong="H3701"\w*.  
\v 17 También detalló el \w peso|strong="H4948"\w* del \w oro|strong="H2091"\w* \w puro|strong="H2889"\w* \w para|strong="H4948"\w* los tenedores, los \w tazones|strong="H4219"\w* y las jarras; el \w peso|strong="H4948"\w* del \w oro|strong="H2091"\w* \w para|strong="H4948"\w* cada tazón de \w oro|strong="H2091"\w*, y el \w peso|strong="H4948"\w* de la \w plata|strong="H3701"\w* \w para|strong="H4948"\w* cada tazón de \w plata|strong="H3701"\w*.  
\v 18 \w Le|strong="H5921"\w* indicó \w la|strong="H5921"\w* cantidad \w de|strong="H5921"\w* \w oro|strong="H2091"\w* refinado \w para|strong="H5921"\w* hacer \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w del|strong="H5921"\w* incienso, \w y|strong="H5921"\w* \w le|strong="H5921"\w* dio \w el|strong="H5921"\w* diseño \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w carro|strong="H4818"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* extenderían sus alas \w para|strong="H5921"\w* cubrir \w el|strong="H5921"\w* arca \w del|strong="H5921"\w* \w pacto|strong="H1285"\w* \w de|strong="H5921"\w* Yahvé.  
\v 19 David \w le|strong="H5921"\w* dijo: “\w Todo|strong="H3605"\w* esto \w está|strong="H5921"\w* \w por|strong="H5921"\w* escrito \w porque|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé estuvo \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*, \w para|strong="H5921"\w* ayudarme \w a|strong="H3068"\w* \w entender|strong="H7919"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* detalles \w de|strong="H5921"\w* este diseño.”   
\p
\v 20 \w Además|strong="H3588"\w*, \w David|strong="H1732"\w* \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*: “¡\w Sé|strong="H3808"\w* fuerte \w y|strong="H3588"\w* valiente, \w y|strong="H3588"\w* pon manos \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w obra|strong="H4399"\w*! \w No|strong="H3808"\w* tengas \w miedo|strong="H3372"\w* \w ni|strong="H3808"\w* \w te|strong="H3588"\w* desanimes, \w porque|strong="H3588"\w* Yahvé \w Dios|strong="H3068"\w*, \w que|strong="H3588"\w* \w es|strong="H3588"\w* mi \w Dios|strong="H3068"\w*, está \w contigo|strong="H5973"\w*. \w Él|strong="H5973"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* fallar \w ni|strong="H3808"\w* \w te|strong="H3588"\w* \w va|strong="H3068"\w* \w a|strong="H3068"\w* abandonar \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* termines \w todo|strong="H3605"\w* \w el|strong="H5973"\w* trabajo \w para|strong="H5704"\w* \w el|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé.  
\v 21 \w Aquí|strong="H2009"\w* tienes \w los|strong="H3605"\w* grupos \w de|strong="H5973"\w* \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w* listos \w para|strong="H5973"\w* hacer \w el|strong="H5973"\w* servicio \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w templo|strong="H1004"\w* \w de|strong="H5973"\w* Dios. Además, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* voluntarios \w que|strong="H5971"\w* son expertos \w en|strong="H5973"\w* \w cualquier|strong="H3605"\w* \w oficio|strong="H4399"\w* estarán dispuestos \w a|strong="H3068"\w* ayudarte. \w Los|strong="H3605"\w* líderes y \w todo|strong="H3605"\w* \w el|strong="H5973"\w* \w pueblo|strong="H5971"\w* estarán completamente \w a|strong="H3068"\w* tus órdenes.”   
\c 29  
\p
\v 1 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w se|strong="H3808"\w* dirigió \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* asamblea \w y|strong="H3588"\w* dijo: “Mi \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*, \w a|strong="H3068"\w* \w quien|strong="H3605"\w* \w Dios|strong="H3068"\w* \w mismo|strong="H3605"\w* \w ha|strong="H3808"\w* elegido, \w es|strong="H3588"\w* todavía joven \w e|strong="H3068"\w* inexperto, \w y|strong="H3588"\w* este proyecto \w es|strong="H3588"\w* inmenso. \w Al|strong="H4428"\w* fin \w y|strong="H3588"\w* \w al|strong="H4428"\w* cabo, este palacio \w no|strong="H3808"\w* \w es|strong="H3588"\w* \w para|strong="H3588"\w* \w ningún|strong="H3605"\w* ser humano, \w sino|strong="H3588"\w* \w para|strong="H3588"\w* Yahvé \w Dios|strong="H3068"\w*.  
\v 2 Yo he hecho \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* posible \w por|strong="H3581"\w* preparar materiales para \w el|strong="H3605"\w* \w templo|strong="H1004"\w* de mi Dios: \w oro|strong="H2091"\w* para \w los|strong="H3605"\w* objetos de \w oro|strong="H2091"\w*, \w plata|strong="H3701"\w* para \w los|strong="H3605"\w* de \w plata|strong="H3701"\w*, bronce para \w los|strong="H3605"\w* de bronce, \w hierro|strong="H1270"\w* para \w los|strong="H3605"\w* de \w hierro|strong="H1270"\w*, y \w madera|strong="H6086"\w* para \w los|strong="H3605"\w* de \w madera|strong="H6086"\w*. También he conseguido muchísimas piedras de ónice, piedras para engastar, piedras de adornos y de distintos colores, \w toda|strong="H3605"\w* clase de joyas \w preciosas|strong="H3368"\w* y muchísimo mármol.  
\v 3 Pero \w además|strong="H5750"\w* \w de|strong="H5750"\w* esto, \w por|strong="H5750"\w* \w el|strong="H3605"\w* gran amor \w que|strong="H3605"\w* le \w tengo|strong="H3426"\w* al \w templo|strong="H1004"\w* \w de|strong="H5750"\w* mi Dios, he decidido donar \w de|strong="H5750"\w* mi propia fortuna \w todo|strong="H3605"\w* mi \w oro|strong="H2091"\w* y \w plata|strong="H3701"\w* personal, aparte \w de|strong="H5750"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* ya \w había|strong="H3426"\w* juntado \w para|strong="H5414"\w* \w el|strong="H3605"\w* \w santuario|strong="H6944"\w* \w sagrado|strong="H6944"\w*.  
\v 4 Estoy donando más de cien toneladas\f + \fr 29:4 \ft Literalmente: tres mil talentos.\f* de \w oro|strong="H2091"\w* finísimo de Ofir, y más de doscientas treinta toneladas\f + \fr 29:4 \ft Literalmente: siete mil talentos.\f* de \w plata|strong="H3701"\w* refinada, para cubrir las paredes de los edificios;  
\v 5 \w el|strong="H3605"\w* \w oro|strong="H2091"\w* para \w los|strong="H3605"\w* objetos de \w oro|strong="H2091"\w*, \w la|strong="H3605"\w* \w plata|strong="H3701"\w* para \w los|strong="H3605"\w* de \w plata|strong="H3701"\w*, y para \w todo|strong="H3605"\w* \w el|strong="H3605"\w* trabajo \w que|strong="H4310"\w* van \w a|strong="H3068"\w* hacer \w los|strong="H3605"\w* artesanos. \w Y|strong="H3068"\w* \w ahora|strong="H3117"\w*, ¿\w quién|strong="H4310"\w* de ustedes se ofrece como \w voluntario|strong="H5068"\w* para darle \w hoy|strong="H3117"\w* sus ofrendas \w a|strong="H3068"\w* Yahvé?”   
\p
\v 6 \w Al|strong="H4428"\w* escuchar esto, los \w jefes|strong="H8269"\w* \w de|strong="H8269"\w* familia, los líderes \w de|strong="H8269"\w* las \w tribus|strong="H7626"\w* \w de|strong="H8269"\w* \w Israel|strong="H3478"\w*, los comandantes \w de|strong="H8269"\w* miles y \w de|strong="H8269"\w* cientos, y los encargados \w de|strong="H8269"\w* los proyectos del \w rey|strong="H4428"\w*, presentaron sus ofrendas voluntarias.  
\v 7 Donaron \w para|strong="H5414"\w* el \w templo|strong="H1004"\w* \w de|strong="H2568"\w* Dios casi \w ciento|strong="H3967"\w* setenta toneladas \w de|strong="H2568"\w* \w oro|strong="H2091"\w* y \w diez|strong="H6235"\w* \w mil|strong="H6235"\w* \w monedas|strong="H3701"\w* \w de|strong="H2568"\w* \w oro|strong="H2091"\w* puro\f + \fr 29:7 \ft Literalmente: cinco mil talentos de oro y diez mil dáricos (monedas persas).\f*, trescientas cuarenta toneladas \w de|strong="H2568"\w* \w plata|strong="H3701"\w*, seiscientas \w diez|strong="H6235"\w* toneladas \w de|strong="H2568"\w* bronce, y más \w de|strong="H2568"\w* tres \w mil|strong="H6235"\w* cuatrocientas toneladas \w de|strong="H2568"\w* \w hierro|strong="H1270"\w*.  
\v 8 \w Los|strong="H5921"\w* \w que|strong="H5921"\w* tenían piedras preciosas \w las|strong="H5921"\w* donaron \w al|strong="H5921"\w* tesoro \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w el|strong="H5921"\w* cual \w estaba|strong="H1004"\w* \w a|strong="H3068"\w* \w cargo|strong="H3027"\w* \w de|strong="H5921"\w* \w Jehiel|strong="H3171"\w* \w el|strong="H5921"\w* \w gersonita|strong="H1649"\w*.  
\v 9 Todo \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w se|strong="H5921"\w* puso muy feliz \w al|strong="H5921"\w* ver estas donaciones, \w porque|strong="H3588"\w* \w se|strong="H5921"\w* \w las|strong="H5921"\w* \w estaban|strong="H5971"\w* dando \w a|strong="H3068"\w* Yahvé \w de|strong="H5921"\w* todo \w corazón|strong="H3820"\w* \w y|strong="H1571"\w* \w con|strong="H5921"\w* mucha \w alegría|strong="H8057"\w*. \w El|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w también|strong="H1571"\w* \w se|strong="H5921"\w* alegró muchísimo.   
\p
\v 10 Entonces \w David|strong="H1732"\w* alabó \w a|strong="H3068"\w* Yahvé frente \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea, diciendo: “¡\w Bendito|strong="H1288"\w* seas \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, oh Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H5704"\w* nuestro antepasado \w Israel|strong="H3478"\w*!  
\v 11 Tuyos \w son|strong="H3588"\w*, oh Yahvé, \w la|strong="H3588"\w* grandeza, \w el|strong="H3588"\w* poder, \w la|strong="H3588"\w* \w gloria|strong="H8597"\w*, \w la|strong="H3588"\w* victoria \w y|strong="H3588"\w* \w la|strong="H3588"\w* majestad. \w Todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3588"\w* hay \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w te|strong="H3588"\w* pertenece. Tuyo \w es|strong="H3588"\w* \w el|strong="H3588"\w* \w reino|strong="H4467"\w*, oh Yahvé, \w y|strong="H3588"\w* tú estás \w por|strong="H3588"\w* \w encima|strong="H7218"\w* \w de|strong="H3588"\w* \w todas|strong="H3605"\w* las cosas.  
\v 12 ¡Las \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* \w el|strong="H3605"\w* honor vienen \w de|strong="H6440"\w* ti, \w y|strong="H3519"\w* tú eres \w el|strong="H3605"\w* rey \w de|strong="H6440"\w* \w todo|strong="H3605"\w*! En tus \w manos|strong="H3027"\w* están \w el|strong="H3605"\w* \w poder|strong="H3027"\w* \w y|strong="H3519"\w* \w la|strong="H3605"\w* \w fuerza|strong="H3581"\w*; tú tienes \w el|strong="H3605"\w* \w poder|strong="H3027"\w* \w de|strong="H6440"\w* engrandecer \w y|strong="H3519"\w* \w de|strong="H6440"\w* fortalecer \w a|strong="H3068"\w* \w todos|strong="H3605"\w*.  
\v 13 Por eso, Dios nuestro, hoy te damos gracias y alabamos tu \w nombre|strong="H8034"\w* \w glorioso|strong="H8597"\w*.  
\v 14 \w Pero|strong="H3588"\w*, ¿\w quién|strong="H4310"\w* soy \w yo|strong="H4480"\w*, \w y|strong="H3588"\w* \w qué|strong="H3588"\w* \w es|strong="H3027"\w* mi \w pueblo|strong="H5971"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* seamos capaces \w de|strong="H4480"\w* darte ofrendas tan generosas? \w En|strong="H4480"\w* realidad, \w todo|strong="H3605"\w* viene \w de|strong="H4480"\w* \w ti|strong="H4480"\w*, \w y|strong="H3588"\w* solo \w te|strong="H4480"\w* estamos devolviendo \w lo|strong="H3605"\w* \w que|strong="H3588"\w* tú \w mismo|strong="H3605"\w* \w nos|strong="H4480"\w* \w has|strong="H5414"\w* \w dado|strong="H5414"\w*.  
\v 15 \w Ante|strong="H6440"\w* \w ti|strong="H5921"\w*, \w nosotros|strong="H3605"\w* solo somos \w extranjeros|strong="H1616"\w* \w y|strong="H3588"\w* gente \w de|strong="H5921"\w* paso, \w al|strong="H5921"\w* igual \w que|strong="H3588"\w* nuestros antepasados. Nuestros \w días|strong="H3117"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w son|strong="H3588"\w* \w como|strong="H3588"\w* una \w sombra|strong="H6738"\w* \w que|strong="H3588"\w* pasa rápido, \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w nos|strong="H5921"\w* queda \w nada|strong="H3605"\w*.  
\v 16 Yahvé, \w Dios|strong="H3068"\w* nuestro, \w toda|strong="H3605"\w* \w esta|strong="H2088"\w* riqueza \w que|strong="H1931"\w* hemos juntado para construirte un \w templo|strong="H1004"\w* en honor \w a|strong="H3068"\w* tu \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*, viene de tus propias \w manos|strong="H3027"\w*; ¡\w todo|strong="H3605"\w* te pertenece!  
\v 17 Dios \w mío|strong="H5971"\w*, \w yo|strong="H3588"\w* \w sé|strong="H3045"\w* \w bien|strong="H3588"\w* \w que|strong="H3588"\w* tú examinas \w los|strong="H3605"\w* \w corazones|strong="H3824"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* agrada \w la|strong="H3588"\w* \w gente|strong="H5971"\w* honesta. \w Con|strong="H3588"\w* \w toda|strong="H3605"\w* sinceridad \w te|strong="H3588"\w* he dado \w todas|strong="H3605"\w* estas \w cosas|strong="H3045"\w* \w voluntariamente|strong="H5068"\w*, \w y|strong="H3588"\w* \w me|strong="H3588"\w* ha dado muchísima \w alegría|strong="H8057"\w* \w ver|strong="H7200"\w* \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*, \w que|strong="H3588"\w* está \w aquí|strong="H6311"\w* reunido, trayéndote sus ofrendas \w de|strong="H3588"\w* buena gana.  
\v 18 Oh Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H5971"\w* Abraham, \w Isaac|strong="H3327"\w* \w e|strong="H3068"\w* \w Israel|strong="H3478"\w* (nuestros antepasados), haz \w que|strong="H5971"\w* \w esta|strong="H2063"\w* buena actitud \w se|strong="H5971"\w* quede \w para|strong="H5971"\w* \w siempre|strong="H5769"\w* \w en|strong="H3336"\w* el \w corazón|strong="H3824"\w* \w de|strong="H5971"\w* tu \w pueblo|strong="H5971"\w*, y mantén sus \w corazones|strong="H3824"\w* leales \w a|strong="H3068"\w* ti.  
\v 19 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* mi \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*, dale un \w corazón|strong="H3824"\w* totalmente fiel \w para|strong="H5414"\w* \w que|strong="H1121"\w* obedezca tus \w mandamientos|strong="H4687"\w*, tus testimonios y tus leyes; \w para|strong="H5414"\w* \w que|strong="H1121"\w* \w haga|strong="H6213"\w* \w todo|strong="H3605"\w* \w esto|strong="H6213"\w* y logre construir este palacio \w para|strong="H5414"\w* \w el|strong="H3605"\w* cual he dejado \w todo|strong="H3605"\w* listo.”   
\p
\v 20 \w Luego|strong="H4994"\w* \w David|strong="H1732"\w* le dijo \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* asamblea: “¡Bendigan \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* Yahvé, su \w Dios|strong="H3068"\w*!”  
\p Entonces \w todos|strong="H3605"\w* \w los|strong="H3605"\w* presentes \w bendijeron|strong="H1288"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* de sus antepasados, y se inclinaron hasta \w el|strong="H3605"\w* suelo para adorar \w a|strong="H3068"\w* Yahvé y presentar sus respetos \w al|strong="H4428"\w* \w rey|strong="H4428"\w*.  
\v 21 \w Al|strong="H5930"\w* \w día|strong="H3117"\w* \w siguiente|strong="H4283"\w*, \w le|strong="H1931"\w* ofrecieron \w sacrificios|strong="H2077"\w* \w a|strong="H3068"\w* Yahvé y presentaron \w sacrificios|strong="H2077"\w* quemados: mil \w toros|strong="H6499"\w*, mil carneros y mil corderitos. También presentaron las ofrendas de vino y muchísimos otros \w sacrificios|strong="H2077"\w* en favor de \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 22 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w* comieron y \w bebieron|strong="H8354"\w* en \w la|strong="H1931"\w* \w presencia|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé con muchísima \w alegría|strong="H8057"\w*. \w Luego|strong="H1931"\w*, volvieron \w a|strong="H3068"\w* nombrar \w como|strong="H1931"\w* \w rey|strong="H4427"\w* \w a|strong="H3068"\w* \w Salomón|strong="H8010"\w*, \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w David|strong="H1732"\w*, y \w lo|strong="H1931"\w* \w ungieron|strong="H4886"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé \w como|strong="H1931"\w* \w su|strong="H1931"\w* líder, ungiendo también \w a|strong="H3068"\w* \w Sadoc|strong="H6659"\w* \w como|strong="H1931"\w* \w sumo|strong="H1419"\w* \w sacerdote|strong="H3548"\w*.   
\p
\v 23 \w De|strong="H5921"\w* \w esta|strong="H3427"\w* manera, \w Salomón|strong="H8010"\w* \w se|strong="H5921"\w* sentó \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* Yahvé \w como|strong="H5921"\w* \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w lugar|strong="H8478"\w* \w de|strong="H5921"\w* su padre \w David|strong="H1732"\w*. \w Le|strong="H5921"\w* fue muy bien, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w le|strong="H5921"\w* \w obedeció|strong="H8085"\w*.  
\v 24 \w Todos|strong="H3605"\w* \w los|strong="H1121"\w* líderes, \w los|strong="H1121"\w* guerreros \w valientes|strong="H1368"\w*, \w e|strong="H3068"\w* incluso \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w demás|strong="H1571"\w* \w hijos|strong="H1121"\w* del \w rey|strong="H4428"\w* \w David|strong="H1732"\w*, le juraron lealtad \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*.  
\v 25 Yahvé \w hizo|strong="H5414"\w* \w que|strong="H3808"\w* \w Salomón|strong="H8010"\w* \w fuera|strong="H1961"\w* \w muy|strong="H4605"\w* respetado \w por|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w le|strong="H5921"\w* \w dio|strong="H5414"\w* un \w reinado|strong="H4428"\w* tan glorioso \w que|strong="H3808"\w* \w ningún|strong="H3605"\w* otro \w rey|strong="H4428"\w* \w en|strong="H5921"\w* \w Israel|strong="H3478"\w* \w había|strong="H1961"\w* tenido \w antes|strong="H6440"\w*.   
\p
\v 26 Así fue \w como|strong="H5921"\w* \w David|strong="H1732"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Isaí|strong="H3448"\w*, \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*.  
\v 27 Gobernó \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* durante cuarenta \w años|strong="H8141"\w*: \w siete|strong="H7651"\w* \w años|strong="H8141"\w* \w en|strong="H5921"\w* \w Hebrón|strong="H2275"\w* \w y|strong="H5921"\w* \w treinta|strong="H7970"\w* \w y|strong="H5921"\w* \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w en|strong="H5921"\w* Jerusalén.  
\v 28 \w Murió|strong="H4191"\w* después \w de|strong="H8478"\w* vivir una \w vida|strong="H3117"\w* larga \w y|strong="H3519"\w* \w buena|strong="H2896"\w*, disfrutando \w de|strong="H8478"\w* abundantes \w riquezas|strong="H6239"\w* \w y|strong="H3519"\w* mucho honor. Su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* fue \w rey|strong="H4427"\w* \w en|strong="H8478"\w* su \w lugar|strong="H8478"\w*.  
