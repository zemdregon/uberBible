\v 24 Los \w sacerdotes|strong="H3548"\w* \w Sebanías|strong="H7645"\w*, Josafat, Natanael, \w Amasai|strong="H6022"\w*, \w Zacarías|strong="H2148"\w*, \w Benaía|strong="H1141"\w* y Eliezer \w tocaban|strong="H2690"\w* las \w trompetas|strong="H2689"\w* \w delante|strong="H6440"\w* del arca \w de|strong="H6440"\w* Dios. \w Obed-Edom|strong="H5654"\w* y Jehías también eran \w porteros|strong="H7778"\w* del arca.   
\p
\v 25 Así \w que|strong="H4480"\w* \w David|strong="H1732"\w*, \w los|strong="H1961"\w* \w ancianos|strong="H2205"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* y \w los|strong="H1961"\w* comandantes \w de|strong="H4480"\w* miles \w fueron|strong="H1961"\w* \w con|strong="H4480"\w* mucha \w alegría|strong="H8057"\w* \w a|strong="H3068"\w* sacar el arca \w del|strong="H4480"\w* \w pacto|strong="H1285"\w* \w de|strong="H4480"\w* Yahvé \w de|strong="H4480"\w* la \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w Obed-Edom|strong="H5654"\w*.  
\v 26 \w Como|strong="H1961"\w* \w Dios|strong="H3068"\w* ayudaba \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w levitas|strong="H3881"\w* \w que|strong="H1961"\w* cargaban el arca del \w pacto|strong="H1285"\w* de Yahvé, \w sacrificaron|strong="H2076"\w* \w siete|strong="H7651"\w* \w toros|strong="H6499"\w* y \w siete|strong="H7651"\w* carneros.  
\v 27 \w David|strong="H1732"\w* \w llevaba|strong="H5375"\w* puesto un \w manto|strong="H4598"\w* \w de|strong="H5921"\w* lino fino, \w al|strong="H5921"\w* igual \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w levitas|strong="H3881"\w* \w que|strong="H5921"\w* cargaban \w el|strong="H5921"\w* arca, \w los|strong="H5921"\w* músicos \w y|strong="H5921"\w* Quenanías, \w el|strong="H5921"\w* director \w del|strong="H5921"\w* coro. \w Además|strong="H5921"\w*, \w David|strong="H1732"\w* \w llevaba|strong="H5375"\w* puesto un efod \w de|strong="H5921"\w* lino.  
\v 28 \w De|strong="H5035"\w* esta manera, \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* llevó \w el|strong="H3605"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H5035"\w* Yahvé entre \w gritos|strong="H8643"\w* \w de|strong="H5035"\w* alegría y sonidos \w de|strong="H5035"\w* cuernos, \w trompetas|strong="H2689"\w*, \w címbalos|strong="H4700"\w*, liras y \w arpas|strong="H3658"\w*.  
\v 29 \w Cuando|strong="H5704"\w* el arca del \w pacto|strong="H1285"\w* \w de|strong="H5704"\w* Yahvé entraba \w a|strong="H3068"\w* \w la|strong="H4324"\w* \w Ciudad|strong="H5892"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w*, Mical, \w la|strong="H4324"\w* \w hija|strong="H1323"\w* \w de|strong="H5704"\w* \w Saúl|strong="H7586"\w*, \w se|strong="H1961"\w* asomó \w por|strong="H1157"\w* \w la|strong="H4324"\w* ventana. \w Y|strong="H3068"\w* \w al|strong="H5704"\w* \w ver|strong="H7200"\w* \w al|strong="H5704"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* saltando \w y|strong="H5704"\w* bailando, sintió un profundo desprecio \w por|strong="H1157"\w* él.   
\c 16  
\p
\v 1 \w Trajeron|strong="H7126"\w* el arca \w de|strong="H6440"\w* Dios y la colocaron \w en|strong="H8432"\w* el centro \w de|strong="H6440"\w* la tienda que \w David|strong="H1732"\w* había preparado para ella, y ofrecieron sacrificios quemados y ofrendas \w de|strong="H6440"\w* paz \w ante|strong="H6440"\w* Dios.  
\v 2 Cuando \w David|strong="H1732"\w* terminó \w de|strong="H5971"\w* ofrecer los sacrificios y las ofrendas, \w bendijo|strong="H1288"\w* \w al|strong="H5930"\w* \w pueblo|strong="H5971"\w* en el \w nombre|strong="H8034"\w* \w de|strong="H5971"\w* Yahvé.  
\v 3 \w Luego|strong="H5704"\w* le \w repartió|strong="H2505"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* \w israelita|strong="H3478"\w*, tanto \w a|strong="H3068"\w* hombres \w como|strong="H5704"\w* \w a|strong="H3068"\w* \w mujeres|strong="H5704"\w*, una hogaza \w de|strong="H5704"\w* \w pan|strong="H3899"\w*, una porción \w de|strong="H5704"\w* carne \w y|strong="H5704"\w* una \w torta|strong="H3603"\w* \w de|strong="H5704"\w* pasas.   
\p
\v 4 David asignó \w a|strong="H3068"\w* algunos \w levitas|strong="H3881"\w* \w para|strong="H4480"\w* \w que|strong="H4480"\w* \w ministraran|strong="H8334"\w* frente \w al|strong="H4480"\w* arca \w de|strong="H4480"\w* Yahvé, \w para|strong="H4480"\w* \w que|strong="H4480"\w* recordaran, dieran gracias y \w alabaran|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*:  
\v 5 Asaf era el líder, y \w Zacarías|strong="H2148"\w* su \w segundo|strong="H4932"\w*; luego \w estaban|strong="H7218"\w* \w Jeiel|strong="H3273"\w*, Semiramot, \w Jehiel|strong="H3171"\w*, Matatías, Eliab, \w Benaía|strong="H1141"\w*, \w Obed-Edom|strong="H5654"\w* y \w Jeiel|strong="H3273"\w*, quienes tocaban liras y \w arpas|strong="H3658"\w*. Asaf tocaba los \w címbalos|strong="H4700"\w*,  
\v 6 y los \w sacerdotes|strong="H3548"\w* \w Benaía|strong="H1141"\w* y \w Jahaziel|strong="H3166"\w* tocaban \w continuamente|strong="H8548"\w* las \w trompetas|strong="H2689"\w* frente al arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Dios.   
\p
\v 7 \w Ese|strong="H1931"\w* \w día|strong="H3117"\w*, \w David|strong="H1732"\w* ordenó \w por|strong="H3027"\w* primera vez \w que|strong="H1931"\w* \w se|strong="H1931"\w* \w le|strong="H1931"\w* dieran gracias \w a|strong="H3068"\w* Yahvé \w por|strong="H3027"\w* \w medio|strong="H3027"\w* \w de|strong="H5414"\w* Asaf y \w sus|strong="H1931"\w* compañeros:   
\q1
\v 8 Den gracias \w a|strong="H3068"\w* Yahvé.  
\q2 \w Invoquen|strong="H7121"\w* su \w nombre|strong="H8034"\w*.  
\q2 Den \w a|strong="H3068"\w* conocer sus \w obras|strong="H5949"\w* entre las naciones.   
\q1
\v 9 Cántale \w a|strong="H3068"\w* \w él|strong="H3605"\w*.  
\q2 Cántenle alabanzas.  
\q2 Hablen de \w todas|strong="H3605"\w* sus \w maravillas|strong="H6381"\w*.   
\q1
\v 10 Siéntanse orgullosos de su \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*.  
\q2 Que se alegre el \w corazón|strong="H3820"\w* de los que \w buscan|strong="H1245"\w* \w a|strong="H3068"\w* Yahvé.   
\q1
