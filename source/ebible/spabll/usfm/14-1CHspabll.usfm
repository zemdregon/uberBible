\v 18 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H4480"\w* \w Rubén|strong="H7205"\w*, \w los|strong="H1121"\w* \w gaditas|strong="H1425"\w* y la media \w tribu|strong="H7626"\w* \w de|strong="H4480"\w* \w Manasés|strong="H4519"\w*, \w de|strong="H4480"\w* \w hombres|strong="H1121"\w* \w valientes|strong="H2428"\w*, capaces \w de|strong="H4480"\w* llevar \w escudo|strong="H4043"\w* y \w espada|strong="H2719"\w*, \w de|strong="H4480"\w* disparar \w con|strong="H4480"\w* \w arco|strong="H7198"\w* y hábiles \w en|strong="H4480"\w* la \w guerra|strong="H4421"\w*, eran cuarenta y cuatro \w mil|strong="H3967"\w* \w setecientos|strong="H7651"\w* \w sesenta|strong="H8346"\w* \w que|strong="H4480"\w* podían \w salir|strong="H3318"\w* \w a|strong="H3068"\w* \w combatir|strong="H4421"\w*.  
\v 19 \w Le|strong="H5973"\w* \w hicieron|strong="H6213"\w* la \w guerra|strong="H4421"\w* \w a|strong="H3068"\w* \w los|strong="H5973"\w* agarenos, \w a|strong="H3068"\w* \w Jetur|strong="H3195"\w*, \w a|strong="H3068"\w* Nafis y \w a|strong="H3068"\w* Nodab.  
\v 20 Recibieron \w ayuda|strong="H5826"\w* \w contra|strong="H5921"\w* \w ellos|strong="H3027"\w*, \w y|strong="H3588"\w* \w los|strong="H5921"\w* agarenos fueron entregados \w en|strong="H5921"\w* sus \w manos|strong="H3027"\w*, \w junto|strong="H5921"\w* \w con|strong="H5973"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* estaban \w con|strong="H5973"\w* \w ellos|strong="H3027"\w*; \w porque|strong="H3588"\w* \w clamaron|strong="H2199"\w* \w a|strong="H3068"\w* Dios \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w*, \w y|strong="H3588"\w* \w él|strong="H5921"\w* \w les|strong="H5921"\w* respondió \w porque|strong="H3588"\w* \w pusieron|strong="H5414"\w* \w su|strong="H3588"\w* confianza \w en|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 21 Les quitaron el \w ganado|strong="H4735"\w*: \w cincuenta|strong="H2572"\w* \w mil|strong="H3967"\w* \w camellos|strong="H1581"\w*, \w doscientas|strong="H3967"\w* \w cincuenta|strong="H2572"\w* \w mil|strong="H3967"\w* \w ovejas|strong="H6629"\w*, dos \w mil|strong="H3967"\w* burros y \w a|strong="H3068"\w* \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* \w personas|strong="H5315"\w*.  
\v 22 \w Porque|strong="H3588"\w* \w muchos|strong="H7227"\w* \w cayeron|strong="H5307"\w* \w muertos|strong="H2491"\w*, ya \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w guerra|strong="H4421"\w* era \w de|strong="H3588"\w* Dios. Vivieron \w en|strong="H5704"\w* \w su|strong="H3588"\w* \w lugar|strong="H8478"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w cautiverio|strong="H1473"\w*.   
\p
\v 23 \w Los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* la media \w tribu|strong="H7626"\w* \w de|strong="H5704"\w* \w Manasés|strong="H4519"\w* \w vivían|strong="H3427"\w* \w en|strong="H5704"\w* la tierra. \w Se|strong="H1992"\w* \w multiplicaron|strong="H7235"\w* \w desde|strong="H5704"\w* \w Basán|strong="H1316"\w* \w hasta|strong="H5704"\w* Baal \w Hermón|strong="H2768"\w*, \w Senir|strong="H8149"\w* \w y|strong="H5704"\w* \w el|strong="H1121"\w* \w monte|strong="H2022"\w* \w Hermón|strong="H2768"\w*.  
\v 24 Estos eran los \w jefes|strong="H7218"\w* de las \w casas|strong="H1004"\w* de sus padres: Efer, \w Isi|strong="H3469"\w*, Eliel, \w Azriel|strong="H5837"\w*, \w Jeremías|strong="H3414"\w*, Hodavías y Jahdiel: guerreros \w valientes|strong="H1368"\w* y famosos, \w jefes|strong="H7218"\w* de sus \w casas|strong="H1004"\w* paternas.  
\v 25 Pero \w se|strong="H5971"\w* rebelaron \w contra|strong="H6440"\w* el Dios \w de|strong="H6440"\w* sus padres y \w se|strong="H5971"\w* prostituyeron tras los dioses \w de|strong="H6440"\w* los \w pueblos|strong="H5971"\w* \w de|strong="H6440"\w* la tierra \w que|strong="H5971"\w* Dios había destruido \w antes|strong="H6440"\w* \w que|strong="H5971"\w* ellos.  
\v 26 \w Entonces|strong="H3117"\w* el Dios \w de|strong="H5704"\w* \w Israel|strong="H3478"\w* \w despertó|strong="H5782"\w* el \w espíritu|strong="H7307"\w* \w de|strong="H5704"\w* Pul, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* Asiria, \w y|strong="H5704"\w* el \w espíritu|strong="H7307"\w* \w de|strong="H5704"\w* Tiglat Pileser, \w rey|strong="H4428"\w* \w de|strong="H5704"\w* Asiria, \w y|strong="H5704"\w* se llevó \w a|strong="H3068"\w* los rubenitas, \w a|strong="H3068"\w* los \w gaditas|strong="H1425"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* la media \w tribu|strong="H7626"\w* \w de|strong="H5704"\w* \w Manasés|strong="H4519"\w*, llevándolos \w a|strong="H3068"\w* Halah, Habor, Hara \w y|strong="H5704"\w* \w al|strong="H5704"\w* \w río|strong="H5104"\w* \w de|strong="H5704"\w* \w Gozán|strong="H1470"\w*, donde \w están|strong="H2088"\w* \w hasta|strong="H5704"\w* el \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*.   
\c 6  
\p
\v 1 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*: Gersón, Coat y \w Merari|strong="H4847"\w*.  
\v 2 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat: Amram, Izhar, Hebrón y Uziel.  
\v 3 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Amram|strong="H6019"\w*: Aarón, Moisés y Miriam. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón: Nadab, Abiú, Eleazar \w e|strong="H3068"\w* Itamar.  
\v 4 Eleazar fue padre \w de|strong="H1121"\w* Finees, Finees fue padre \w de|strong="H1121"\w* Abisúa,  
\v 5 Abisúa fue padre \w de|strong="H1121"\w* Buqui, Buqui fue padre \w de|strong="H1121"\w* Uzi.  
\v 6 Uzi fue padre \w de|strong="H1121"\w* Zeraías, Zeraías fue padre \w de|strong="H1121"\w* Meraiot.  
\v 7 Meraiot fue padre \w de|strong="H1121"\w* Amarías, Amarías fue padre \w de|strong="H1121"\w* Ahitob.  
\v 8 Ahitob fue padre \w de|strong="H1121"\w* Sadoc, Sadoc fue padre \w de|strong="H1121"\w* Ahimaas.  
\v 9 Ahimaas fue padre \w de|strong="H1121"\w* Azarías, Azarías fue padre \w de|strong="H1121"\w* Johanán.  
\v 10 Johanán fue padre \w de|strong="H1121"\w* Azarías, quien ofició como sacerdote en \w el|strong="H1121"\w* templo \w que|strong="H1121"\w* Salomón construyó en Jerusalén.  
\v 11 Azarías fue padre \w de|strong="H1121"\w* Amarías, Amarías fue padre \w de|strong="H1121"\w* Ahitob.  
\v 12 Ahitob fue padre \w de|strong="H1121"\w* Sadoc, Sadoc fue padre \w de|strong="H1121"\w* Salum.  
\v 13 Salum fue padre \w de|strong="H1121"\w* Hilcías, Hilcías fue padre \w de|strong="H1121"\w* Azarías.  
\v 14 Azarías fue padre \w de|strong="H1121"\w* Seraías, Seraías fue padre \w de|strong="H1121"\w* Josadac.  
\v 15 Josadac fue llevado al cautiverio cuando Yahvé exilió \w a|strong="H3068"\w* Judá y \w a|strong="H3068"\w* Jerusalén por medio \w de|strong="H1121"\w* Nabucodonosor.   
\p
\v 16 \w Los|strong="H5921"\w* hijos \w de|strong="H5921"\w* Leví: Gersón, Coat \w y|strong="H5921"\w* Merari.  
\v 17 Estos \w son|strong="H1961"\w* \w los|strong="H5921"\w* nombres \w de|strong="H5921"\w* \w los|strong="H5921"\w* hijos \w de|strong="H5921"\w* Gersón: Libni \w y|strong="H5921"\w* Simei.  
\v 18 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat fueron Amram, Izhar, Hebrón y Uziel.  
\v 19 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Merari: Mahli y Musi. Estas son las familias \w de|strong="H1121"\w* \w los|strong="H1121"\w* levitas según las familias \w de|strong="H1121"\w* sus padres.  
\v 20 \w De|strong="H1121"\w* Gersón: Libni su \w hijo|strong="H1121"\w*, Jahat su \w hijo|strong="H1121"\w*, Zima su \w hijo|strong="H1121"\w*,  
\v 21 Joah su \w hijo|strong="H1121"\w*, Iddo su \w hijo|strong="H1121"\w*, Zera su \w hijo|strong="H1121"\w* y Jeaterai su \w hijo|strong="H1121"\w*.  
\v 22 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat: Aminadab su \w hijo|strong="H1121"\w*, \w Coré|strong="H7141"\w* su \w hijo|strong="H1121"\w*, Asir su \w hijo|strong="H1121"\w*,  
\v 23 Elcaná su \w hijo|strong="H1121"\w*, Ebiasaf su \w hijo|strong="H1121"\w*, Asir su \w hijo|strong="H1121"\w*,  
\v 24 Tahat su \w hijo|strong="H1121"\w*, Uriel su \w hijo|strong="H1121"\w*, Uzías su \w hijo|strong="H1121"\w* \w y|strong="H5921"\w* Saúl su \w hijo|strong="H1121"\w*.  
\v 25 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Elcaná: Amasai y Ahimot.  
\v 26 En cuanto \w a|strong="H3068"\w* Elcaná, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Elcaná: Zofai su \w hijo|strong="H1121"\w*, Nahat su \w hijo|strong="H1121"\w*,  
\v 27 Eliab su \w hijo|strong="H1121"\w*, Jeroham su \w hijo|strong="H1121"\w*, y Elcaná su \w hijo|strong="H1121"\w*.  
\v 28 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Samuel: \w el|strong="H1121"\w* primogénito, Joel, y \w el|strong="H1121"\w* segundo, Abías.  
\v 29 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w Merari|strong="H4847"\w*: Mahli, Libni su \w hijo|strong="H1121"\w*, Simei su \w hijo|strong="H1121"\w*, Uza su \w hijo|strong="H1121"\w*,  
\v 30 Simea su \w hijo|strong="H1121"\w*, Haguía su \w hijo|strong="H1121"\w*, Asaías su \w hijo|strong="H1121"\w*.   
\p
\v 31 Estos son \w los|strong="H1121"\w* \w que|strong="H1121"\w* David puso \w a|strong="H3068"\w* cargo \w de|strong="H1121"\w* la música en la casa \w de|strong="H1121"\w* Yahvé, después \w de|strong="H1121"\w* \w que|strong="H1121"\w* \w el|strong="H1121"\w* arca descansó allí.  
\v 32 Ministraban con \w el|strong="H1121"\w* canto ante \w el|strong="H1121"\w* tabernáculo \w de|strong="H1121"\w* la Tienda \w de|strong="H1121"\w* Reunión hasta \w que|strong="H1121"\w* Salomón construyó \w el|strong="H1121"\w* templo \w de|strong="H1121"\w* Yahvé en Jerusalén. Cumplían con sus deberes según su orden.  
\v 33 \w Estos|strong="H3605"\w* son \w los|strong="H3605"\w* \w que|strong="H3605"\w* servían, junto con sus hijos. \w De|strong="H5414"\w* \w los|strong="H3605"\w* descendientes \w de|strong="H5414"\w* Coat: Hemán \w el|strong="H3605"\w* músico, hijo \w de|strong="H5414"\w* Joel, hijo \w de|strong="H5414"\w* Samuel,  
\v 34 \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Elcaná, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jeroham, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Eliel, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Toah,  
\v 35 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zuf, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Elcaná, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mahat, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amasai,  
\v 36 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Elcaná, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Joel, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Azarías, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sofonías,  
\v 37 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Tahat, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Asir, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ebiasaf, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Coré,  
\v 38 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Izhar, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Coat, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Leví, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Israel.  
\v 39 \w Su|strong="H1992"\w* hermano Asaf, \w que|strong="H3588"\w* \w estaba|strong="H1961"\w* \w a|strong="H3068"\w* \w su|strong="H1992"\w* derecha, Asaf \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Berequías, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Simea,  
\v 40 hijo \w de|strong="H5414"\w* Micael, hijo \w de|strong="H5414"\w* Baasías, hijo \w de|strong="H5414"\w* Malquías,  
\v 41 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Etni, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zera, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Adaías,  
\v 42 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Etán, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Zima, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Simei,  
\v 43 hijo de Jahat, hijo de Gersón, hijo de Leví.  
\v 44 \w A|strong="H3068"\w* la izquierda estaban sus hermanos, los hijos de Merari: Etán hijo de Quisi, hijo de Abdi, hijo de Maluc,  
\v 45 hijo de Hasabías, hijo de Amasías, hijo de Hilcías,  
\v 46 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amsi, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Bani, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Semer,  
\v 47 \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Mahli, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Musi, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Merari, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Leví.  
\v 48 Sus hermanos \w los|strong="H1121"\w* levitas fueron designados para todo \w el|strong="H1121"\w* servicio del tabernáculo \w de|strong="H1121"\w* la casa \w de|strong="H1121"\w* Dios.  
\v 49 Pero Aarón y sus descendientes presentaban ofrendas en \w el|strong="H1121"\w* altar \w de|strong="H1121"\w* \w los|strong="H1121"\w* holocaustos y en \w el|strong="H1121"\w* altar del incienso, \w para|strong="H5414"\w* toda la obra del lugar santísimo y \w para|strong="H5414"\w* hacer la expiación \w por|strong="H5414"\w* \w Israel|strong="H3478"\w*, conforme \w a|strong="H3068"\w* todo lo \w que|strong="H1121"\w* había mandado Moisés, siervo \w de|strong="H1121"\w* Dios.   
\p
\v 50 Estos son \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón: Eleazar su \w hijo|strong="H1121"\w*, Finees su \w hijo|strong="H1121"\w*, Abisúa su \w hijo|strong="H1121"\w*,  
\v 51 Buqui su \w hijo|strong="H1121"\w*, Uzi su \w hijo|strong="H1121"\w*, Zeraías su \w hijo|strong="H1121"\w*,  
\v 52 Meraiot su hijo, Amarías su hijo, Ahitob su hijo,  
\v 53 Sadoc su hijo, y Ahimaas su hijo.  
\v 54 Estos son sus lugares de residencia según sus campamentos en sus territorios: \w a|strong="H3068"\w* los descendientes de Aarón, de las familias de los coatitas (porque \w a|strong="H3068"\w* ellos les tocó la primera suerte),  
\v 55 les dieron Hebrón en la tierra \w de|strong="H1121"\w* Judá, con \w los|strong="H1121"\w* pastizales \w a|strong="H3068"\w* su alrededor;  
\v 56 pero \w los|strong="H1121"\w* campos \w de|strong="H1121"\w* la ciudad y sus aldeas, se \w los|strong="H1121"\w* dieron \w a|strong="H3068"\w* Caleb, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jefone.  
\v 57 \w A|strong="H3068"\w* los hijos de Aarón les dieron las ciudades de refugio: Hebrón, Libna con sus pastizales, Jatir, Estemoa con sus pastizales,  
\v 58 Hilén con sus pastizales, Debir con sus pastizales,  
\v 59 Asán con sus pastizales y Bet Semes con sus pastizales;  
\v 60 y de la tribu de Benjamín, Geba con sus pastizales, Alemet con sus pastizales y Anatot con sus pastizales. Todas las ciudades de sus familias sumaban trece ciudades.   
\p
\v 61 \w A|strong="H3068"\w* los demás hijos de Coat se les dio por sorteo, de la familia de la \w tribu|strong="H4294"\w*, de la media \w tribu|strong="H4294"\w*, la mitad de Manasés, diez ciudades.  
\v 62 \w A|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Gersón, según sus familias, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Isacar, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Aser, \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Neftalí y \w de|strong="H1121"\w* la \w tribu|strong="H4294"\w* \w de|strong="H1121"\w* Manasés en Basán, trece ciudades.  
\v 63 \w A|strong="H3068"\w* los hijos de Merari se les asignó por sorteo, según sus familias, de la \w tribu|strong="H4294"\w* de \w Rubén|strong="H7205"\w*, de la \w tribu|strong="H4294"\w* de Gad y de la \w tribu|strong="H4294"\w* de Zabulón, doce ciudades.  
\v 64 Los israelitas les dieron \w a|strong="H3068"\w* los levitas las ciudades con sus pastizales.  
\v 65 De la \w tribu|strong="H4294"\w* de los hijos de Judá, de la \w tribu|strong="H4294"\w* de los hijos de Simeón y de la \w tribu|strong="H4294"\w* de los hijos de Benjamín, entregaron por sorteo estas ciudades que se mencionan por su nombre.   
\p
\v 66 Algunas de las familias de los hijos de Coat recibieron ciudades para sus territorios de la tribu de Efraín.  
\v 67 Les dieron las ciudades de refugio: Siquem en la región montañosa de Efraín con sus pastizales y Gezer con sus pastizales,  
\v 68 Jocmeam con sus pastizales, Bet Horón con sus pastizales,  
\v 69 Ajalón con sus pastizales, Gat Rimón con sus pastizales;  
\v 70 y de la media tribu de Manasés, Aner con sus pastizales y Bileam con sus pastizales, para el resto de la familia de los hijos de Coat.   
\p
\v 71 \w A|strong="H3068"\w* los hijos de Gersón se les dio, de la familia de la media tribu de Manasés, Golán en Basán con sus pastizales, y Astarot con sus pastizales;  
\v 72 y de la tribu de Isacar, Cedes con sus pastizales, Daberat con sus pastizales,  
\v 73 Ramot con sus pastizales, y Anem con sus pastizales;  
\v 74 y de la tribu de Aser, Masal con sus pastizales, Abdón con sus pastizales,  
\v 75 Hucoc con sus pastizales, y Rehob con sus pastizales;  
\v 76 y de la tribu de Neftalí, Cedes en Galilea con sus pastizales, Hamón con sus pastizales, y Quiriatáim con sus pastizales.   
\p
\v 77 Al resto de los levitas, los descendientes de Merari, se les dio, de la tribu de Zabulón, Rimón con sus pastizales, y Tabor con sus pastizales;  
\v 78 y al otro lado del Jordán, \w a|strong="H3068"\w* la altura de Jericó, al lado este del Jordán, se les dio de la tribu de Rubén: Beser en el desierto con sus pastizales, Jahaza con sus pastizales,  
\v 79 Cedemot con sus pastizales y Mefaat con sus pastizales;  
\v 80 y de la tribu de Gad, Ramot en Galaad con sus pastizales, Mahanaim con sus pastizales,  
\v 81 Hesbón con sus pastizales y Jazer con sus pastizales.   
\c 7  
\p
\v 1 \w De|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Isacar: \w Tola|strong="H8439"\w*, Fúa, \w Jasub|strong="H3437"\w* y Simrón, cuatro.  
\v 2 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Tola|strong="H8439"\w*: Uzi, Refaías, \w Jeriel|strong="H3400"\w*, Jahmai, Ibsam y Semuel, \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w casas|strong="H1004"\w* paternas \w de|strong="H1121"\w* \w Tola|strong="H8439"\w*; guerreros \w valientes|strong="H1368"\w* en sus generaciones. En \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H1121"\w* \w David|strong="H1732"\w* su \w número|strong="H4557"\w* \w era|strong="H1121"\w* \w de|strong="H1121"\w* \w veintidós|strong="H6242"\w* \w mil|strong="H3967"\w* \w seiscientos|strong="H8337"\w*.  
\v 3 \w El|strong="H3605"\w* \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* Uzi: Izrahías. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H2568"\w* Izrahías: \w Miguel|strong="H4317"\w*, \w Obadías|strong="H5662"\w*, \w Joel|strong="H3100"\w* \w e|strong="H3068"\w* \w Isías|strong="H3449"\w*, \w cinco|strong="H2568"\w*; \w todos|strong="H3605"\w* \w ellos|strong="H3605"\w* eran \w jefes|strong="H7218"\w* \w principales|strong="H7218"\w*.  
\v 4 \w Con|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w por|strong="H5921"\w* sus generaciones, \w según|strong="H5921"\w* \w las|strong="H5921"\w* \w casas|strong="H1004"\w* \w de|strong="H5921"\w* sus padres, \w había|strong="H3588"\w* tropas \w del|strong="H5921"\w* \w ejército|strong="H6635"\w* listas \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*, \w treinta|strong="H7970"\w* \w y|strong="H3588"\w* \w seis|strong="H8337"\w* mil \w hombres|strong="H1121"\w*; \w porque|strong="H3588"\w* tenían \w muchas|strong="H7235"\w* esposas \w e|strong="H3068"\w* \w hijos|strong="H1121"\w*.  
\v 5 Sus parientes de \w todas|strong="H3605"\w* las \w familias|strong="H4940"\w* de Isacar, guerreros \w valientes|strong="H1368"\w*, registrados en su totalidad por genealogía, eran \w ochenta|strong="H8084"\w* y \w siete|strong="H7651"\w* mil.   
\p
\v 6 Los hijos de \w Benjamín|strong="H1144"\w*: \w Bela|strong="H1106"\w*, Bequer y \w Jediael|strong="H3043"\w*, \w tres|strong="H7969"\w*.  
\v 7 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H2568"\w* \w Bela|strong="H1106"\w*: Ezbón, Uzi, Uziel, Jerimot \w e|strong="H3068"\w* Iri, \w cinco|strong="H2568"\w*; \w jefes|strong="H7218"\w* \w de|strong="H2568"\w* \w familia|strong="H1004"\w*, guerreros \w valientes|strong="H1368"\w*; y fueron registrados por genealogía \w veintidós|strong="H6242"\w* mil \w treinta|strong="H7970"\w* y cuatro.  
\v 8 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Bequer: \w Zemira|strong="H2160"\w*, \w Joás|strong="H3135"\w*, Eliezer, Elioenai, \w Omri|strong="H6018"\w*, Jeremot, Abías, Anatot y Alemet. \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* fueron \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Bequer.  
\v 9 Fueron registrados por genealogía, según sus generaciones, como \w jefes|strong="H7218"\w* de las \w casas|strong="H1004"\w* de sus padres, guerreros \w valientes|strong="H1368"\w*, \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* \w doscientos|strong="H3967"\w*.  
\v 10 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Jediael|strong="H3043"\w*: \w Bilhán|strong="H1092"\w*. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Bilhán|strong="H1092"\w*: \w Jeús|strong="H3266"\w*, \w Benjamín|strong="H1144"\w*, Aod, Quenaaná, Zetán, \w Tarsis|strong="H8659"\w* y Ahisahar.  
\v 11 \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* fueron \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Jediael|strong="H3043"\w*, según \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* familia \w de|strong="H1121"\w* sus padres, guerreros \w valientes|strong="H1368"\w*, \w diecisiete|strong="H7651"\w* \w mil|strong="H3967"\w* \w doscientos|strong="H3967"\w*, capaces \w de|strong="H1121"\w* \w salir|strong="H3318"\w* con \w el|strong="H3605"\w* \w ejército|strong="H2428"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w guerra|strong="H4421"\w*.  
\v 12 También estaban Supim, Hupim, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Ir, \w Husim|strong="H2366"\w* y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aher.   
\p
\v 13 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Neftalí: \w Jahzeel|strong="H3185"\w*, \w Guni|strong="H3337"\w*, \w Jezer|strong="H7967"\w*, Salum y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Bilhá|strong="H1090"\w*.   
\p
\v 14 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*: Asriel, \w a|strong="H3068"\w* quien dio \w a|strong="H3068"\w* luz su \w concubina|strong="H6370"\w* aramea. Ella dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Maquir, padre \w de|strong="H1121"\w* \w Galaad|strong="H1568"\w*.  
\v 15 Maquir \w tomó|strong="H3947"\w* una esposa de Hupim y Supim, cuya hermana \w se|strong="H1961"\w* \w llamaba|strong="H8034"\w* Maaca. El \w nombre|strong="H8034"\w* de la \w segunda|strong="H8145"\w* \w era|strong="H1961"\w* Zelofehad; y Zelofehad solo \w tuvo|strong="H1961"\w* \w hijas|strong="H1323"\w*.  
\v 16 Maaca, la esposa \w de|strong="H1121"\w* Maquir, dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, al \w que|strong="H1121"\w* \w llamó|strong="H7121"\w* \w Peres|strong="H6570"\w*. \w El|strong="H1121"\w* \w nombre|strong="H8034"\w* \w de|strong="H1121"\w* su hermano fue Seres, y sus \w hijos|strong="H1121"\w* fueron Ulam y Requem.  
\v 17 \w El|strong="H1121"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ulam: Bedán. Estos fueron \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Galaad|strong="H1568"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Maquir, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Manasés|strong="H4519"\w*.  
\v 18 Su hermana Hamolequet dio \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* Isod, Abiezer y Mahala.  
\v 19 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Semida \w fueron|strong="H1961"\w* Ahián, Siquem, Likhi y Aniam.   
\p
\v 20 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Efraín: Sutela, \w Bered|strong="H1260"\w* su \w hijo|strong="H1121"\w*, Tahat su \w hijo|strong="H1121"\w*, Eleada su \w hijo|strong="H1121"\w*, Tahat su \w hijo|strong="H1121"\w*,  
\v 21 \w Zabad|strong="H2066"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*, Sutela \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*, \w Ezer|strong="H5827"\w* \w y|strong="H3588"\w* Elead, \w a|strong="H3068"\w* quienes \w mataron|strong="H2026"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w de|strong="H3588"\w* Gat \w que|strong="H3588"\w* habían \w nacido|strong="H3205"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* país, \w porque|strong="H3588"\w* \w bajaron|strong="H3381"\w* \w a|strong="H3068"\w* robarles \w el|strong="H3588"\w* \w ganado|strong="H4735"\w*.  
\v 22 Efraín, su padre, estuvo de luto \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*, y sus hermanos fueron \w a|strong="H3068"\w* consolarlo.  
\v 23 \w Se|strong="H1961"\w* unió \w a|strong="H3068"\w* \w su|strong="H3588"\w* esposa, \w y|strong="H3588"\w* ella \w concibió|strong="H2029"\w* \w y|strong="H3588"\w* dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, al \w que|strong="H3588"\w* le \w puso|strong="H3205"\w* \w el|strong="H3588"\w* \w nombre|strong="H8034"\w* \w de|strong="H3588"\w* \w Beriá|strong="H1283"\w*,\f + \fr 7:23 \ft “Beriá” es similar a la palabra hebrea para “desgracia”.\f* \w porque|strong="H3588"\w* \w había|strong="H1961"\w* desgracia \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w casa|strong="H1004"\w*.  
\v 24 Su \w hija|strong="H1323"\w* fue Seera, quien construyó Bet Horón la de abajo y la de arriba, y Uzen Seera.  
\v 25 Su \w hijo|strong="H1121"\w* fue Refa, su \w hijo|strong="H1121"\w* Resef, su \w hijo|strong="H1121"\w* Tela, su \w hijo|strong="H1121"\w* Tahán,  
\v 26 Su \w hijo|strong="H1121"\w* \w Ladán|strong="H3936"\w*, su \w hijo|strong="H1121"\w* Amiud, su \w hijo|strong="H1121"\w* Elisama,  
\v 27 Su \w hijo|strong="H1121"\w* \w Nun|strong="H5126"\w*, y su \w hijo|strong="H1121"\w* \w Josué|strong="H3091"\w*.  
\v 28 Sus posesiones \w y|strong="H5704"\w* asentamientos fueron Betel \w y|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*, \w al|strong="H5704"\w* \w este|strong="H4217"\w* \w Naarán|strong="H5295"\w*, \w y|strong="H5704"\w* \w al|strong="H5704"\w* oeste \w Gezer|strong="H1507"\w* \w con|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*; también Siquem \w y|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*, \w hasta|strong="H5704"\w* \w Gaza|strong="H5804"\w* \w y|strong="H5704"\w* sus \w aldeas|strong="H1323"\w*;  
\v 29 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w las|strong="H5921"\w* fronteras \w de|strong="H5921"\w* \w los|strong="H3427"\w* descendientes \w de|strong="H5921"\w* \w Manasés|strong="H4519"\w*, Bet Seán \w y|strong="H5921"\w* sus \w aldeas|strong="H1323"\w*, Taanac \w y|strong="H5921"\w* sus \w aldeas|strong="H1323"\w*, Meguido \w y|strong="H5921"\w* sus \w aldeas|strong="H1323"\w*, \w y|strong="H5921"\w* \w Dor|strong="H1756"\w* \w y|strong="H5921"\w* sus \w aldeas|strong="H1323"\w*. \w En|strong="H5921"\w* estas vivieron \w los|strong="H3427"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w José|strong="H3130"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 30 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aser: \w Imna|strong="H3232"\w*, \w Isúa|strong="H3438"\w*, \w Isúi|strong="H3440"\w* y \w Beriá|strong="H1283"\w*. \w Sera|strong="H8294"\w* \w era|strong="H1121"\w* su hermana.  
