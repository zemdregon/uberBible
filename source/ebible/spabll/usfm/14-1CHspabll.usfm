\q1
\v 24 Proclamen su \w gloria|strong="H3519"\w* entre las \w naciones|strong="H1471"\w*,  
\q2 \w y|strong="H3519"\w* sus \w maravillas|strong="H6381"\w* entre \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w*.   
\q1
\v 25 \w Porque|strong="H3588"\w* \w grande|strong="H1419"\w* \w es|strong="H1931"\w* Yahvé, \w y|strong="H3588"\w* digno \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w alabanza|strong="H1984"\w*.  
\q2 \w Es|strong="H1931"\w* \w más|strong="H3588"\w* temible \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* dioses.   
\q1
\v 26 \w Porque|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* dioses \w de|strong="H3588"\w* las naciones \w son|strong="H3588"\w* solo ídolos,  
\q2 \w pero|strong="H3588"\w* Yahvé \w hizo|strong="H6213"\w* \w los|strong="H3605"\w* \w cielos|strong="H8064"\w*.   
