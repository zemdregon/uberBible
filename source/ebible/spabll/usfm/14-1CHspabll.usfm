\q1
\v 12 Recuerden las \w maravillas|strong="H6381"\w* \w que|strong="H6310"\w* \w él|strong="H6213"\w* ha \w hecho|strong="H6213"\w*,  
\q2 sus milagros y las justicias \w que|strong="H6310"\w* ha dictado,   
\q1
\v 13 ustedes, \w descendencia|strong="H2233"\w*\f + \fr 16:13 \ft o, semilla\f* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, su \w siervo|strong="H5650"\w*,  
\q2 ustedes, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Jacob|strong="H3290"\w*, sus elegidos.   
\b  
\q1
\v 14 \w Él|strong="H1931"\w* \w es|strong="H1931"\w* Yahvé, nuestro \w Dios|strong="H3068"\w*.  
\q2 \w Su|strong="H1931"\w* \w justicia|strong="H4941"\w* gobierna en \w toda|strong="H3605"\w* \w la|strong="H1931"\w* tierra.   
\q1
\v 15 Recuerden su \w pacto|strong="H1285"\w* para \w siempre|strong="H5769"\w*,  
\q2 la promesa \w que|strong="H1697"\w* hizo para mil \w generaciones|strong="H1755"\w*,   
\q2
\v 16 el pacto que \w hizo|strong="H3772"\w* con Abraham,  
\q2 y su \w juramento|strong="H7621"\w* \w a|strong="H3068"\w* \w Isaac|strong="H3327"\w*.   
\q1
\v 17 Él se lo \w confirmó|strong="H5975"\w* \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* como un decreto,  
\q2 y \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* como un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*,   
