\q1
\v 30 Tiemble \w ante|strong="H6440"\w* \w él|strong="H3605"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra.  
\q2 \w El|strong="H3605"\w* \w mundo|strong="H8398"\w* está \w firme|strong="H3559"\w* y \w no|strong="H1077"\w* se moverá.   
\q1
\v 31 ¡Que se alegren los \w cielos|strong="H8064"\w*,  
\q2 y que la tierra se regocije!  
\q2 Que digan entre las \w naciones|strong="H1471"\w*: “¡Yahvé \w reina|strong="H4427"\w*!”   
\q1
\v 32 ¡\w Que|strong="H3605"\w* \w resuene|strong="H7481"\w* \w el|strong="H3605"\w* \w mar|strong="H3220"\w* y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* contiene!  
\q2 ¡\w Que|strong="H3605"\w* se alegre \w el|strong="H3605"\w* \w campo|strong="H7704"\w* y \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* hay en \w él|strong="H3605"\w*!   
\q1
\v 33 \w Entonces|strong="H3588"\w* \w los|strong="H3588"\w* \w árboles|strong="H6086"\w* del \w bosque|strong="H3293"\w* \w cantarán|strong="H7442"\w* \w de|strong="H3588"\w* alegría \w ante|strong="H6440"\w* Yahvé,  
\q2 \w porque|strong="H3588"\w* \w él|strong="H3588"\w* viene \w a|strong="H3068"\w* juzgar \w la|strong="H3588"\w* tierra.   
\q1
\v 34 Den gracias \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* \w él|strong="H3588"\w* \w es|strong="H3588"\w* \w bueno|strong="H2896"\w*,  
\q2 \w porque|strong="H3588"\w* \w su|strong="H3588"\w* gran amor dura \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*.   
\q1
\v 35 \w Y|strong="H3068"\w* digan: “¡\w Sálvanos|strong="H3467"\w*, oh Dios, \w Salvador|strong="H3467"\w* nuestro!  
\q2 Reúnenos y \w líbranos|strong="H5337"\w* \w de|strong="H4480"\w* las \w naciones|strong="H1471"\w*,  
\q2 \w para|strong="H4480"\w* \w que|strong="H4480"\w* alabemos tu \w santo|strong="H6944"\w* \w nombre|strong="H8034"\w*,  
\q2 y \w nos|strong="H4480"\w* sintamos orgullosos \w de|strong="H4480"\w* alabarte.”   
\q1
\v 36 \w Bendito|strong="H1288"\w* sea Yahvé, \w el|strong="H3605"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*,  
\q2 \w por|strong="H4480"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w eternidad|strong="H5769"\w*.  
\p \w Todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* respondió: “Amén”, \w y|strong="H5704"\w* alabó \w a|strong="H3068"\w* Yahvé.   
\p
\v 37 David \w dejó|strong="H5800"\w* \w a|strong="H3068"\w* Asaf y \w a|strong="H3068"\w* sus compañeros \w a|strong="H3068"\w* cargo del arca del \w pacto|strong="H1285"\w* \w de|strong="H6440"\w* Yahvé, para \w que|strong="H1697"\w* sirvieran \w allí|strong="H8033"\w* \w continuamente|strong="H8548"\w* todos los \w días|strong="H3117"\w*.  
\v 38 También dejó \w a|strong="H3068"\w* \w Obed-Edom|strong="H5654"\w* y \w a|strong="H3068"\w* sus \w sesenta|strong="H8346"\w* y \w ocho|strong="H8083"\w* parientes. \w Obed-Edom|strong="H5654"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jedutún, y Hosa fueron designados como \w porteros|strong="H7778"\w*.  
\v 39 Al \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w* y \w a|strong="H3068"\w* sus compañeros los \w sacerdotes|strong="H3548"\w*, los dejó frente \w a|strong="H3068"\w* la tienda sagrada \w de|strong="H6440"\w* Yahvé en el santuario que estaba en \w Gabaón|strong="H1391"\w*,  
\v 40 \w para|strong="H5921"\w* \w que|strong="H5921"\w* ofrecieran sacrificios quemados \w a|strong="H3068"\w* Yahvé \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w continuamente|strong="H8548"\w*, \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H1242"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w*, \w de|strong="H5921"\w* acuerdo \w con|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w escrito|strong="H3789"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w que|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* dio \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 41 \w Con|strong="H5973"\w* ellos estaban \w Hemán|strong="H1968"\w*, Jedutún \w y|strong="H3588"\w* \w los|strong="H5973"\w* demás músicos elegidos \w y|strong="H3588"\w* \w nombrados|strong="H5344"\w* \w para|strong="H3588"\w* dar gracias \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* gran amor dura \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*.  
\v 42 \w Hemán|strong="H1968"\w* y Jedutún tenían \w trompetas|strong="H2689"\w* y \w címbalos|strong="H4700"\w* \w para|strong="H5973"\w* \w que|strong="H1121"\w* \w los|strong="H1121"\w* tocaran, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* otros \w instrumentos|strong="H3627"\w* \w para|strong="H5973"\w* acompañar \w los|strong="H1121"\w* cantos \w a|strong="H3068"\w* Dios. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5973"\w* Jedutún estaban \w a|strong="H3068"\w* cargo \w de|strong="H5973"\w* las \w puertas|strong="H8179"\w*.  
\v 43 Después, \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H5971"\w* regresó \w a|strong="H3068"\w* sus \w casas|strong="H1004"\w*, y \w David|strong="H1732"\w* \w se|strong="H5971"\w* \w fue|strong="H3212"\w* \w a|strong="H3068"\w* bendecir \w a|strong="H3068"\w* su propia \w familia|strong="H1004"\w*.   
\c 17  
\p
\v 1 \w Cuando|strong="H1961"\w* \w David|strong="H1732"\w* ya \w vivía|strong="H3427"\w* \w en|strong="H8478"\w* su palacio, le dijo \w al|strong="H8478"\w* \w profeta|strong="H5030"\w* Natán: “\w Mira|strong="H2009"\w*, \w yo|strong="H2009"\w* vivo \w en|strong="H8478"\w* una \w casa|strong="H1004"\w* \w de|strong="H8478"\w* cedro, mientras \w que|strong="H1961"\w* \w el|strong="H5030"\w* arca del \w pacto|strong="H1285"\w* \w de|strong="H8478"\w* Yahvé \w está|strong="H1961"\w* \w bajo|strong="H8478"\w* una simple tienda.”   
\p
\v 2 Natán \w le|strong="H5973"\w* respondió \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Haz|strong="H6213"\w* \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* tengas \w en|strong="H5973"\w* mente, \w porque|strong="H3588"\w* Dios está \w contigo|strong="H5973"\w*.”   
\p
\v 3 Pero \w esa|strong="H1931"\w* \w misma|strong="H1931"\w* \w noche|strong="H3915"\w* Dios \w le|strong="H1931"\w* \w habló|strong="H1697"\w* \w a|strong="H3068"\w* Natán y \w le|strong="H1931"\w* dijo:  
\v 4 “\w Ve|strong="H3212"\w* \w y|strong="H3541"\w* dile \w a|strong="H3068"\w* mi \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* \w que|strong="H3808"\w* Yahvé dice: ‘Tú \w no|strong="H3808"\w* serás quien \w me|strong="H3541"\w* construya una \w casa|strong="H1004"\w* para \w que|strong="H3808"\w* yo la habite.  
\v 5 \w Desde|strong="H4480"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H3588"\w* \w saqué|strong="H5927"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w de|strong="H4480"\w* Egipto \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H4480"\w* \w hoy|strong="H3117"\w*, \w no|strong="H3808"\w* he vivido \w en|strong="H4480"\w* una \w casa|strong="H1004"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* he ido \w de|strong="H4480"\w* tienda \w en|strong="H4480"\w* tienda \w y|strong="H3588"\w* \w de|strong="H4480"\w* \w tabernáculo|strong="H4908"\w* \w en|strong="H4480"\w* \w tabernáculo|strong="H4908"\w*.  
\v 6 En \w todo|strong="H3605"\w* \w el|strong="H3605"\w* tiempo \w que|strong="H4100"\w* he \w andado|strong="H1980"\w* con \w los|strong="H3605"\w* israelitas, ¿acaso \w alguna|strong="H3605"\w* vez le reclamé \w a|strong="H3068"\w* \w alguno|strong="H3605"\w* \w de|strong="H5971"\w* sus líderes, \w a|strong="H3068"\w* quienes \w puse|strong="H6680"\w* \w para|strong="H5971"\w* pastorear \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*, diciéndole: ¿\w Por|strong="H1697"\w* \w qué|strong="H4100"\w* \w no|strong="H3808"\w* me han construido una \w casa|strong="H1004"\w* \w de|strong="H5971"\w* cedro?’”   
\p
\v 7 “\w Ahora|strong="H6258"\w*, dile \w esto|strong="H3541"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*: ‘\w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: \w Yo|strong="H4480"\w* \w te|strong="H5921"\w* saqué \w del|strong="H4480"\w* \w rebaño|strong="H6629"\w*, \w de|strong="H4480"\w* andar cuidando \w ovejas|strong="H6629"\w*, \w para|strong="H5921"\w* \w que|strong="H4480"\w* fueras \w el|strong="H5921"\w* líder \w de|strong="H4480"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.  
\v 8 He \w estado|strong="H1961"\w* \w contigo|strong="H5973"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H1961"\w* has ido, y he destruido \w a|strong="H3068"\w* \w todos|strong="H3605"\w* tus enemigos \w a|strong="H3068"\w* \w tu|strong="H6213"\w* paso. Ahora \w haré|strong="H6213"\w* \w que|strong="H1961"\w* \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w* \w sea|strong="H1961"\w* tan \w grande|strong="H1419"\w* \w como|strong="H5973"\w* \w el|strong="H5973"\w* \w de|strong="H6440"\w* \w los|strong="H3605"\w* hombres más importantes \w de|strong="H6440"\w* \w la|strong="H3605"\w* tierra.  
\v 9 \w Le|strong="H3254"\w* daré un \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w* y \w lo|strong="H3808"\w* \w plantaré|strong="H5193"\w* allí \w para|strong="H5971"\w* \w que|strong="H3808"\w* tenga su propia casa y \w nadie|strong="H3808"\w* \w más|strong="H5750"\w* \w lo|strong="H3808"\w* moleste. La \w gente|strong="H5971"\w* malvada \w no|strong="H3808"\w* \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* oprimirlos \w como|strong="H8478"\w* \w al|strong="H8478"\w* principio,  
\v 10 \w en|strong="H5921"\w* \w la|strong="H5921"\w* época \w en|strong="H5921"\w* \w que|strong="H5921"\w* nombré líderes \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*. Voy \w a|strong="H3068"\w* someter \w a|strong="H3068"\w* \w todos|strong="H3605"\w* tus enemigos. \w Además|strong="H5921"\w*, \w te|strong="H5921"\w* prometo \w que|strong="H5921"\w* Yahvé \w te|strong="H5921"\w* construirá una dinastía.  
\v 11 \w Cuando|strong="H3588"\w* llegues al final \w de|strong="H3588"\w* tu \w vida|strong="H3117"\w* \w y|strong="H3588"\w* \w vayas|strong="H3212"\w* \w a|strong="H3068"\w* descansar \w con|strong="H5973"\w* tus antepasados, \w yo|strong="H3588"\w* pondré \w en|strong="H5973"\w* \w el|strong="H5973"\w* trono \w a|strong="H3068"\w* uno \w de|strong="H3588"\w* tus propios \w hijos|strong="H1121"\w*, \w y|strong="H3588"\w* aseguraré \w su|strong="H3588"\w* \w reino|strong="H4438"\w*.  
\v 12 \w Él|strong="H1931"\w* \w será|strong="H1931"\w* \w quien|strong="H1931"\w* me construya una \w casa|strong="H1004"\w*, \w y|strong="H5704"\w* yo estableceré \w su|strong="H1931"\w* \w trono|strong="H3678"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 13 Yo \w seré|strong="H1961"\w* \w su|strong="H1931"\w* padre, y \w él|strong="H1931"\w* \w será|strong="H1961"\w* \w mi|strong="H1961"\w* \w hijo|strong="H1121"\w*. \w Jamás|strong="H3808"\w* \w le|strong="H1931"\w* \w quitaré|strong="H5493"\w* \w mi|strong="H1961"\w* amor, \w como|strong="H5973"\w* \w se|strong="H1961"\w* \w lo|strong="H1931"\w* \w quité|strong="H5493"\w* al rey \w que|strong="H1931"\w* \w estuvo|strong="H1961"\w* \w antes|strong="H6440"\w* \w de|strong="H6440"\w* \w ti|strong="H5973"\w*.  
\v 14 \w Al|strong="H5704"\w* contrario, \w lo|strong="H5704"\w* pondré \w a|strong="H3068"\w* cargo \w de|strong="H5704"\w* \w mi|strong="H1961"\w* \w casa|strong="H1004"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* \w mi|strong="H1961"\w* \w reino|strong="H4438"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, \w y|strong="H5704"\w* su \w trono|strong="H3678"\w* \w estará|strong="H1961"\w* \w firme|strong="H3559"\w* \w eternamente|strong="H5769"\w*.’”  
\v 15 Natán le comunicó \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Dios le había revelado en \w esta|strong="H2088"\w* \w visión|strong="H2377"\w*.   
\p
\v 16 \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* entró, se sentó \w delante|strong="H6440"\w* \w de|strong="H3588"\w* Yahvé, \w y|strong="H3588"\w* \w le|strong="H4310"\w* dijo: “Yahvé \w Dios|strong="H3068"\w*, ¿\w quién|strong="H4310"\w* soy \w yo|strong="H3588"\w* \w y|strong="H3588"\w* \w qué|strong="H3588"\w* importancia tiene mi \w familia|strong="H1004"\w* \w para|strong="H5704"\w* \w que|strong="H3588"\w* \w me|strong="H3588"\w* hayas hecho llegar tan lejos?  
\v 17 \w Y|strong="H3068"\w* \w como|strong="H5921"\w* \w si|strong="H5921"\w* \w esto|strong="H2063"\w* \w te|strong="H5869"\w* pareciera \w poco|strong="H6994"\w*, oh \w Dios|strong="H3068"\w*, ahora \w me|strong="H5921"\w* hablas \w del|strong="H5921"\w* futuro \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* tu \w siervo|strong="H5650"\w*, \w y|strong="H5921"\w* \w me|strong="H5921"\w* tratas \w como|strong="H5921"\w* \w a|strong="H3068"\w* alguien muy importante, Yahvé \w Dios|strong="H3068"\w*.  
\v 18 ¿\w Qué|strong="H4100"\w* \w más|strong="H5750"\w* te puedo decir \w por|strong="H4100"\w* el honor \w que|strong="H4100"\w* \w le|strong="H3254"\w* has dado \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w*? Tú me \w conoces|strong="H3045"\w* bien.  
\v 19 Yahvé, \w por|strong="H5668"\w* amor \w a|strong="H3068"\w* \w tu|strong="H6213"\w* \w siervo|strong="H5650"\w* y de acuerdo con \w tu|strong="H6213"\w* voluntad, has \w hecho|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H2063"\w* \w grandezas|strong="H1420"\w* para dar \w a|strong="H3068"\w* conocer tus \w maravillas|strong="H6213"\w*.  
\v 20 Yahvé, no hay \w nadie|strong="H3605"\w* \w como|strong="H3644"\w* tú, ni hay otro \w Dios|strong="H3068"\w* \w fuera|strong="H2108"\w* \w de|strong="H2108"\w* ti, \w de|strong="H2108"\w* acuerdo con \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* hemos escuchado.  
\v 21 ¿\w Y|strong="H3068"\w* \w qué|strong="H4310"\w* otra \w nación|strong="H1471"\w* en la tierra \w se|strong="H5971"\w* compara \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*? Eres \w el|strong="H4310"\w* único Dios \w que|strong="H4310"\w* salió \w a|strong="H3068"\w* rescatar \w a|strong="H3068"\w* un \w pueblo|strong="H5971"\w* \w para|strong="H5971"\w* hacerlo \w suyo|strong="H5971"\w*, haciéndote famoso con \w grandes|strong="H1420"\w* y asombrosos milagros, y expulsando \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* al paso \w de|strong="H6440"\w* tu \w pueblo|strong="H5971"\w*, al \w cual|strong="H4310"\w* rescataste \w de|strong="H6440"\w* \w Egipto|strong="H4714"\w*.  
\v 22 Tú hiciste \w que|strong="H5704"\w* \w Israel|strong="H3478"\w* \w fuera|strong="H1961"\w* tu \w pueblo|strong="H5971"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, \w y|strong="H5704"\w* tú, Yahvé, te convertiste \w en|strong="H5704"\w* su \w Dios|strong="H3068"\w*.  
\v 23 \w Ahora|strong="H6258"\w* \w pues|strong="H6258"\w*, Yahvé, \w que|strong="H6258"\w* \w la|strong="H5921"\w* promesa \w que|strong="H6258"\w* has \w hecho|strong="H6213"\w* \w sobre|strong="H5921"\w* \w tu|strong="H6213"\w* \w siervo|strong="H5650"\w* \w y|strong="H5921"\w* su dinastía \w se|strong="H5921"\w* mantenga firme \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*. Cumple \w tu|strong="H6213"\w* \w palabra|strong="H1697"\w*,  
\v 24 \w para|strong="H5704"\w* \w que|strong="H5704"\w* tu \w nombre|strong="H8034"\w* sea reconocido \w y|strong="H5704"\w* \w engrandecido|strong="H1431"\w* \w por|strong="H6440"\w* \w siempre|strong="H5769"\w*, \w y|strong="H5704"\w* todos digan: ‘El \w Señor|strong="H3068"\w* \w de|strong="H6440"\w* los \w Ejércitos|strong="H6635"\w*, el \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, es el \w Dios|strong="H3068"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w Y|strong="H3068"\w* la dinastía \w de|strong="H6440"\w* tu \w siervo|strong="H5650"\w* \w David|strong="H1732"\w* se mantendrá \w firme|strong="H3559"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti.’  
\v 25 Dios \w mío|strong="H5921"\w*, tú \w le|strong="H5921"\w* has revelado \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w* \w que|strong="H3588"\w* \w le|strong="H5921"\w* construirás \w una|strong="H4672"\w* dinastía, \w y|strong="H3588"\w* \w por|strong="H5921"\w* \w eso|strong="H3651"\w* tu \w siervo|strong="H5650"\w* \w se|strong="H5921"\w* ha atrevido \w a|strong="H3068"\w* orar \w en|strong="H5921"\w* tu \w presencia|strong="H6440"\w*.  
\v 26 Oh Yahvé, tú \w eres|strong="H1931"\w* \w Dios|strong="H3068"\w*, \w y|strong="H5921"\w* \w le|strong="H1931"\w* has prometido \w estas|strong="H2063"\w* cosas \w buenas|strong="H2896"\w* \w a|strong="H3068"\w* tu \w siervo|strong="H5650"\w*.  
\v 27 \w Te|strong="H3588"\w* ha parecido \w bien|strong="H3588"\w* bendecir \w la|strong="H3588"\w* dinastía \w de|strong="H3588"\w* tu \w siervo|strong="H5650"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* permanezca \w siempre|strong="H5769"\w* \w en|strong="H3588"\w* tu \w presencia|strong="H6440"\w*. \w Ya|strong="H3068"\w* \w que|strong="H3588"\w* tú, Yahvé, \w la|strong="H3588"\w* has bendecido, \w quedará|strong="H1961"\w* \w bendita|strong="H1288"\w* \w para|strong="H3588"\w* \w siempre|strong="H5769"\w*.”   
\c 18  
\p
\v 1 Tiempo \w después|strong="H1961"\w*, \w David|strong="H1732"\w* derrotó \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w filisteos|strong="H6430"\w* y \w los|strong="H1961"\w* sometió, quitándoles la ciudad de Gat y sus \w aldeas|strong="H1323"\w* cercanas.  
\v 2 También derrotó \w a|strong="H3068"\w* \w los|strong="H1961"\w* moabitas, y estos \w se|strong="H1961"\w* convirtieron \w en|strong="H5221"\w* \w siervos|strong="H5650"\w* de \w David|strong="H1732"\w* y le pagaron \w tributo|strong="H4503"\w*.   
\p
\v 3 \w David|strong="H1732"\w* también derrotó \w a|strong="H3068"\w* Hadadézer, \w rey|strong="H4428"\w* de Soba, cerca de Hamat, cuando este \w iba|strong="H3212"\w* \w en|strong="H3212"\w* camino \w a|strong="H3068"\w* establecer su control sobre el \w río|strong="H5104"\w* \w Éufrates|strong="H6578"\w*.  
\v 4 \w David|strong="H1732"\w* le capturó \w mil|strong="H3967"\w* \w carros|strong="H7393"\w*, \w siete|strong="H7651"\w* \w mil|strong="H3967"\w* \w jinetes|strong="H6571"\w* y \w veinte|strong="H6242"\w* \w mil|strong="H3967"\w* soldados \w de|strong="H4480"\w* \w a|strong="H3068"\w* pie. \w Además|strong="H4480"\w*, les cortó \w los|strong="H3605"\w* tendones \w a|strong="H3068"\w* \w los|strong="H3605"\w* caballos \w de|strong="H4480"\w* \w los|strong="H3605"\w* \w carros|strong="H7393"\w*, aunque dejó \w los|strong="H3605"\w* suficientes \w para|strong="H4480"\w* \w cien|strong="H3967"\w* \w carros|strong="H7393"\w*.  
\v 5 Cuando los sirios de \w Damasco|strong="H1834"\w* llegaron para ayudar \w a|strong="H3068"\w* Hadadézer, \w rey|strong="H4428"\w* de Soba, \w David|strong="H1732"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w veintidós|strong="H6242"\w* mil \w hombres|strong="H8147"\w* del ejército sirio.  
\v 6 Luego, \w David|strong="H1732"\w* instaló guarniciones militares en \w el|strong="H3605"\w* territorio sirio de \w Damasco|strong="H1834"\w*, y \w los|strong="H3605"\w* sirios \w se|strong="H1961"\w* convirtieron en sus \w siervos|strong="H5650"\w* y le pagaron \w tributo|strong="H4503"\w*. \w El|strong="H3605"\w* \w Señor|strong="H3068"\w* le daba \w la|strong="H3605"\w* victoria \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H1961"\w* \w iba|strong="H1980"\w*.  
\v 7 \w David|strong="H1732"\w* \w tomó|strong="H3947"\w* \w los|strong="H5921"\w* \w escudos|strong="H7982"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w* \w que|strong="H5921"\w* \w llevaban|strong="H1961"\w* \w los|strong="H5921"\w* oficiales \w de|strong="H5921"\w* Hadadézer \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w los|strong="H5921"\w* \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* Jerusalén.  
\v 8 También de Tibhat y de Cun, \w ciudades|strong="H5892"\w* que pertenecían \w a|strong="H3068"\w* Hadadézer, \w David|strong="H1732"\w* sacó \w grandes|strong="H7227"\w* cantidades de bronce. \w Más|strong="H7227"\w* tarde, \w Salomón|strong="H8010"\w* usaría ese bronce para \w hacer|strong="H6213"\w* \w el|strong="H6213"\w* \w gran|strong="H3966"\w* estanque, las \w columnas|strong="H5982"\w* y otros utensilios.   
\p
\v 9 \w Cuando|strong="H3588"\w* \w Tou|strong="H8583"\w*, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Hamat, se enteró \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* destruido \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w ejército|strong="H2426"\w* \w de|strong="H3588"\w* Hadadézer, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Soba,  
\v 10 \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w* Hadoram \w para|strong="H5921"\w* saludar \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* felicitarlo \w por|strong="H5921"\w* \w su|strong="H3588"\w* victoria \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w* \w contra|strong="H5921"\w* Hadadézer (ya \w que|strong="H3588"\w* \w Tou|strong="H8583"\w* también \w estaba|strong="H1961"\w* \w en|strong="H5921"\w* \w guerra|strong="H4421"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w*). Hadoram \w le|strong="H5921"\w* llevó artículos \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, \w plata|strong="H3701"\w* \w y|strong="H3588"\w* bronce.  
\v 11 \w El|strong="H5973"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* \w dedicó|strong="H6942"\w* \w estos|strong="H3605"\w* regalos \w a|strong="H3068"\w* Yahvé, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* \w la|strong="H1571"\w* \w plata|strong="H3701"\w* \w y|strong="H1571"\w* \w el|strong="H5973"\w* \w oro|strong="H2091"\w* \w que|strong="H1571"\w* \w había|strong="H6942"\w* tomado \w de|strong="H5973"\w* \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* \w que|strong="H1571"\w* sometió: Edom, \w Moab|strong="H4124"\w*, Amón, \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* \w y|strong="H1571"\w* \w Amalec|strong="H6002"\w*.   
\p
\v 12 Además, Abisai, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Sarvia, \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w dieciocho|strong="H8083"\w* mil edomitas \w en|strong="H5221"\w* \w el|strong="H1121"\w* \w Valle|strong="H1516"\w* \w de|strong="H1121"\w* la \w Sal|strong="H4417"\w*.  
\v 13 \w Puso|strong="H7760"\w* guarniciones militares en Edom, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* edomitas \w se|strong="H1961"\w* convirtieron en \w siervos|strong="H5650"\w* de \w David|strong="H1732"\w*. \w El|strong="H3605"\w* \w Señor|strong="H3068"\w* le daba \w el|strong="H3605"\w* triunfo \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* dondequiera \w que|strong="H1961"\w* \w iba|strong="H1980"\w*.   
\p
\v 14 \w David|strong="H1732"\w* \w reinó|strong="H4427"\w* \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* gobernaba \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* \w con|strong="H5921"\w* \w justicia|strong="H6666"\w* \w y|strong="H5921"\w* equidad.  
\v 15 \w Joab|strong="H3097"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Sarvia, \w era|strong="H1121"\w* \w el|strong="H5921"\w* comandante \w del|strong="H5921"\w* \w ejército|strong="H6635"\w*; Josafat, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Ahilud, \w era|strong="H1121"\w* \w el|strong="H5921"\w* historiador;  
\v 16 \w Sadoc|strong="H6659"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Ahitob, y Ahimelec, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Abiatar, eran \w sacerdotes|strong="H3548"\w*; Savsa \w era|strong="H1121"\w* \w el|strong="H1121"\w* \w secretario|strong="H5608"\w* del rey;  
\v 17 \w Benaía|strong="H1141"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Joiada|strong="H3077"\w*, estaba \w al|strong="H5921"\w* mando \w de|strong="H5921"\w* \w la|strong="H5921"\w* guardia personal \w de|strong="H5921"\w* cereteos \w y|strong="H5921"\w* peleteos; \w y|strong="H5921"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* eran \w los|strong="H1121"\w* altos funcionarios \w más|strong="H5921"\w* cercanos \w al|strong="H5921"\w* \w rey|strong="H4428"\w*.   
\c 19  
\p
\v 1 Algún tiempo \w después|strong="H1961"\w* \w murió|strong="H4191"\w* Nahas, \w rey|strong="H4428"\w* \w de|strong="H8478"\w* \w los|strong="H1121"\w* amonitas, y su \w hijo|strong="H1121"\w* le \w sucedió|strong="H1961"\w* \w en|strong="H8478"\w* \w el|strong="H1121"\w* trono.  
\v 2 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* pensó: “Voy \w a|strong="H3068"\w* ser leal \w con|strong="H5973"\w* \w Hanún|strong="H2586"\w*, tal \w como|strong="H3588"\w* \w su|strong="H3588"\w* padre Nahas fue leal \w conmigo|strong="H5973"\w*.” \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w envió|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w para|strong="H5921"\w* darle \w el|strong="H5921"\w* pésame \w por|strong="H5921"\w* \w la|strong="H5921"\w* muerte \w de|strong="H5921"\w* \w su|strong="H3588"\w* padre. \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w los|strong="H1121"\w* representantes \w de|strong="H5921"\w* \w David|strong="H1732"\w* llegaron \w al|strong="H5921"\w* territorio amonita \w para|strong="H5921"\w* consolar \w a|strong="H3068"\w* \w Hanún|strong="H2586"\w*,  
\v 3 \w los|strong="H1121"\w* líderes amonitas \w le|strong="H5869"\w* dijeron \w a|strong="H3068"\w* \w Hanún|strong="H2586"\w*: “¿\w De|strong="H3588"\w* verdad crees \w que|strong="H3588"\w* \w David|strong="H1732"\w* \w te|strong="H5869"\w* \w envió|strong="H7971"\w* estos mensajeros \w para|strong="H3588"\w* honrar \w a|strong="H3068"\w* tu padre? ¡Sus \w hombres|strong="H1121"\w* han venido \w como|strong="H3588"\w* \w espías|strong="H7270"\w* \w para|strong="H3588"\w* investigar \w y|strong="H3588"\w* destruir nuestra tierra!”  
\v 4 Entonces \w Hanún|strong="H2586"\w* agarró \w a|strong="H3068"\w* los \w siervos|strong="H5650"\w* \w de|strong="H5704"\w* \w David|strong="H1732"\w*, los rapó, les \w cortó|strong="H3772"\w* la ropa \w por|strong="H5704"\w* la mitad, dejándolos \w al|strong="H5704"\w* descubierto \w hasta|strong="H5704"\w* las nalgas, \w y|strong="H5704"\w* los \w echó|strong="H7971"\w* \w de|strong="H5704"\w* allí.  
\v 5 Alguien \w fue|strong="H1961"\w* \w a|strong="H3068"\w* contarle \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w lo|strong="H5921"\w* \w que|strong="H3588"\w* \w les|strong="H5921"\w* \w había|strong="H1961"\w* pasado \w a|strong="H3068"\w* sus hombres, \w y|strong="H3588"\w* \w como|strong="H3588"\w* \w estaban|strong="H1961"\w* pasando \w por|strong="H5921"\w* una terrible humillación, \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* otros \w a|strong="H3068"\w* recibirlos \w con|strong="H5921"\w* \w este|strong="H1961"\w* mensaje: “Quédense \w en|strong="H5921"\w* \w Jericó|strong="H3405"\w* \w hasta|strong="H5704"\w* \w que|strong="H3588"\w* \w les|strong="H5921"\w* crezca \w la|strong="H5921"\w* \w barba|strong="H2206"\w*, \w y|strong="H3588"\w* \w entonces|strong="H3588"\w* regresen.”   
\p
\v 6 \w Al|strong="H4480"\w* darse cuenta \w de|strong="H4480"\w* \w que|strong="H3588"\w* \w se|strong="H4480"\w* habían \w ganado|strong="H1121"\w* \w el|strong="H5973"\w* odio \w de|strong="H4480"\w* \w David|strong="H1732"\w*, \w Hanún|strong="H2586"\w* \w y|strong="H3588"\w* \w los|strong="H1121"\w* amonitas \w enviaron|strong="H7971"\w* treinta \w y|strong="H3588"\w* tres mil kilos\f + \fr 19:6 \ft Literalmente: mil talentos de plata.\f* \w de|strong="H4480"\w* \w plata|strong="H3701"\w* \w para|strong="H3588"\w* alquilar \w carros|strong="H7393"\w* \w y|strong="H3588"\w* \w jinetes|strong="H6571"\w* \w de|strong="H4480"\w* Mesopotamia, \w de|strong="H4480"\w* Aram-maacá \w y|strong="H3588"\w* \w de|strong="H4480"\w* Soba.  
\v 7 Contrataron \w treinta|strong="H7970"\w* y \w dos|strong="H8147"\w* mil \w carros|strong="H7393"\w*, y también \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Maaca con su ejército, \w los|strong="H1121"\w* cuales fueron y acamparon frente \w a|strong="H3068"\w* \w Medeba|strong="H4311"\w*. \w Al|strong="H4428"\w* mismo tiempo, \w los|strong="H1121"\w* amonitas salieron \w de|strong="H6440"\w* sus \w ciudades|strong="H5892"\w* y \w se|strong="H5971"\w* reunieron \w para|strong="H5971"\w* la \w batalla|strong="H4421"\w*.  
\v 8 Cuando \w David|strong="H1732"\w* se enteró, \w envió|strong="H7971"\w* \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* con \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w ejército|strong="H6635"\w* de guerreros \w valientes|strong="H1368"\w*.  
\v 9 \w Los|strong="H1121"\w* amonitas \w salieron|strong="H3318"\w* y se formaron para la \w batalla|strong="H4421"\w* \w a|strong="H3068"\w* la entrada \w de|strong="H1121"\w* la \w ciudad|strong="H5892"\w*, mientras \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w reyes|strong="H4428"\w* \w que|strong="H1121"\w* habían llegado para ayudarlos se quedaron aparte \w en|strong="H3318"\w* \w el|strong="H1121"\w* \w campo|strong="H7704"\w*.   
\p
\v 10 \w Joab|strong="H3097"\w* \w se|strong="H1961"\w* dio cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w lo|strong="H3605"\w* iban \w a|strong="H3068"\w* atacar \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w frente|strong="H7125"\w* \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* retaguardia, \w así|strong="H3588"\w* \w que|strong="H3588"\w* escogió \w a|strong="H3068"\w* las mejores tropas \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* las formó \w frente|strong="H7125"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* sirios.  
\v 11 \w El|strong="H1121"\w* \w resto|strong="H3499"\w* del ejército \w se|strong="H5971"\w* lo encargó \w a|strong="H3068"\w* su hermano Abisai, \w para|strong="H5414"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* formaran \w frente|strong="H7125"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* amonitas.  
\v 12 Joab le dijo: “\w Si|strong="H1961"\w* \w los|strong="H1121"\w* sirios \w son|strong="H1961"\w* \w más|strong="H4480"\w* \w fuertes|strong="H1121"\w* \w que|strong="H4480"\w* \w yo|strong="H4480"\w*, tú vendrás \w a|strong="H3068"\w* rescatarme; pero \w si|strong="H1961"\w* \w los|strong="H1121"\w* amonitas \w son|strong="H1961"\w* \w más|strong="H4480"\w* \w fuertes|strong="H1121"\w* \w que|strong="H4480"\w* tú, \w yo|strong="H4480"\w* iré \w a|strong="H3068"\w* ayudarte.  
\v 13 ¡\w Ánimo|strong="H2388"\w*! Luchemos con valor \w por|strong="H1157"\w* nuestro \w pueblo|strong="H5971"\w* y \w por|strong="H1157"\w* las \w ciudades|strong="H5892"\w* \w de|strong="H5971"\w* nuestro \w Dios|strong="H3068"\w*. ¡\w Y|strong="H3068"\w* \w que|strong="H5971"\w* Yahvé \w haga|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H5971"\w* \w le|strong="H1157"\w* parezca \w mejor|strong="H2896"\w*!”   
\p
\v 14 Entonces \w Joab|strong="H3097"\w* y sus tropas avanzaron \w para|strong="H5973"\w* pelear \w contra|strong="H5973"\w* \w los|strong="H5973"\w* sirios, pero ellos \w huyeron|strong="H5127"\w*.  
\v 15 Al \w ver|strong="H7200"\w* \w que|strong="H3588"\w* \w los|strong="H1992"\w* sirios huían, \w los|strong="H1992"\w* amonitas \w también|strong="H1571"\w* \w huyeron|strong="H5127"\w* \w de|strong="H3588"\w* Abisai \w y|strong="H1571"\w* \w se|strong="H1992"\w* refugiaron \w en|strong="H3588"\w* \w la|strong="H1571"\w* \w ciudad|strong="H5892"\w*. \w Entonces|strong="H3588"\w* \w Joab|strong="H3097"\w* regresó \w a|strong="H3068"\w* Jerusalén.   
\p
\v 16 \w Cuando|strong="H3588"\w* \w los|strong="H3588"\w* sirios se dieron cuenta \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w Israel|strong="H3478"\w* \w los|strong="H3588"\w* \w había|strong="H3588"\w* derrotado, \w enviaron|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w para|strong="H3588"\w* traer \w a|strong="H3068"\w* \w los|strong="H3588"\w* sirios \w que|strong="H3588"\w* vivían al otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w* Éufrates, liderados \w por|strong="H3588"\w* Sofac, \w comandante|strong="H8269"\w* del \w ejército|strong="H6635"\w* \w de|strong="H3588"\w* Hadadézer.  
\v 17 \w David|strong="H1732"\w* se enteró \w de|strong="H5973"\w* esto, reunió \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5973"\w* ejército \w de|strong="H5973"\w* \w Israel|strong="H3478"\w*, cruzó \w el|strong="H5973"\w* \w Jordán|strong="H3383"\w*, se acercó \w a|strong="H3068"\w* \w ellos|strong="H3605"\w* y se formó \w para|strong="H5973"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*. \w Los|strong="H3605"\w* sirios \w pelearon|strong="H3898"\w* \w contra|strong="H5973"\w* \w David|strong="H1732"\w*,  
\v 18 pero volvieron \w a|strong="H3068"\w* huir \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*. \w David|strong="H1732"\w* \w mató|strong="H2026"\w* \w a|strong="H3068"\w* \w siete|strong="H7651"\w* mil soldados \w de|strong="H6440"\w* los \w carros|strong="H7393"\w* y \w a|strong="H3068"\w* cuarenta mil soldados \w de|strong="H6440"\w* \w a|strong="H3068"\w* pie. También \w mató|strong="H2026"\w* \w a|strong="H3068"\w* Sofac, el \w comandante|strong="H8269"\w* del \w ejército|strong="H6635"\w* sirio.  
\v 19 \w Cuando|strong="H3588"\w* \w los|strong="H1121"\w* aliados \w de|strong="H3588"\w* Hadadézer \w vieron|strong="H7200"\w* \w que|strong="H3588"\w* \w Israel|strong="H3478"\w* \w los|strong="H1121"\w* \w había|strong="H3588"\w* derrotado, hicieron \w la|strong="H3588"\w* \w paz|strong="H7999"\w* \w con|strong="H5973"\w* \w David|strong="H1732"\w* \w y|strong="H3588"\w* \w se|strong="H3808"\w* sometieron \w a|strong="H3068"\w* \w él|strong="H5973"\w*. Después \w de|strong="H3588"\w* esto, \w los|strong="H1121"\w* sirios \w no|strong="H3808"\w* quisieron volver \w a|strong="H3068"\w* ayudar \w a|strong="H3068"\w* \w los|strong="H1121"\w* amonitas.   
\c 20  
\p
\v 1 \w En|strong="H3318"\w* la primavera, \w que|strong="H1121"\w* \w es|strong="H1961"\w* la época \w en|strong="H3318"\w* \w que|strong="H1121"\w* \w los|strong="H3427"\w* \w reyes|strong="H4428"\w* \w salen|strong="H3318"\w* \w a|strong="H3068"\w* la \w guerra|strong="H6635"\w*, \w Joab|strong="H3097"\w* lideró \w el|strong="H1121"\w* \w ejército|strong="H6635"\w* y arrasó con la tierra \w de|strong="H1121"\w* \w los|strong="H3427"\w* amonitas; \w luego|strong="H3318"\w* marchó y sitió la ciudad \w de|strong="H1121"\w* Rabá. Mientras tanto, \w David|strong="H1732"\w* \w se|strong="H1961"\w* \w había|strong="H1961"\w* quedado \w en|strong="H3318"\w* Jerusalén. \w Joab|strong="H3097"\w* atacó \w a|strong="H3068"\w* Rabá y la \w destruyó|strong="H2040"\w*.  
\v 2 \w David|strong="H1732"\w* \w le|strong="H5921"\w* \w quitó|strong="H3947"\w* \w la|strong="H5921"\w* \w corona|strong="H5850"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w y|strong="H5921"\w* \w descubrió|strong="H4672"\w* \w que|strong="H5921"\w* pesaba \w más|strong="H5921"\w* \w de|strong="H5921"\w* treinta kilos \w de|strong="H5921"\w* \w oro|strong="H2091"\w*\f + \fr 20:2 \ft Literalmente: un talento de oro.\f* \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* adornada \w con|strong="H5921"\w* piedras \w preciosas|strong="H3368"\w*. Entonces \w se|strong="H1961"\w* \w la|strong="H5921"\w* pusieron \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w*. \w Además|strong="H5921"\w*, \w David|strong="H1732"\w* \w sacó|strong="H3318"\w* un botín inmenso \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.  
\v 3 \w Sacó|strong="H3318"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* habitantes y \w los|strong="H1121"\w* puso \w a|strong="H3068"\w* \w trabajar|strong="H6213"\w* \w como|strong="H3651"\w* esclavos con sierras, picos \w de|strong="H1121"\w* \w hierro|strong="H1270"\w* y hachas. \w Lo|strong="H6213"\w* \w mismo|strong="H3605"\w* \w hizo|strong="H6213"\w* con \w todas|strong="H3605"\w* las demás \w ciudades|strong="H5892"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* amonitas. Después \w de|strong="H1121"\w* \w eso|strong="H3651"\w*, \w David|strong="H1732"\w* y \w todo|strong="H3605"\w* \w el|strong="H3605"\w* ejército regresaron \w a|strong="H3068"\w* Jerusalén.   
\p
\v 4 Tiempo \w después|strong="H1961"\w*, estalló una \w guerra|strong="H4421"\w* \w contra|strong="H5973"\w* \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w* \w en|strong="H5973"\w* \w Gezer|strong="H1507"\w*. Allí Sibecai \w el|strong="H5973"\w* \w husatita|strong="H2843"\w* \w mató|strong="H5221"\w* \w a|strong="H3068"\w* Sipai, \w que|strong="H1961"\w* \w era|strong="H1961"\w* descendiente \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w gigantes|strong="H7497"\w*, y \w los|strong="H5973"\w* \w filisteos|strong="H6430"\w* \w fueron|strong="H1961"\w* sometidos.   
\p
\v 5 \w Hubo|strong="H1961"\w* \w otra|strong="H5750"\w* \w batalla|strong="H4421"\w* \w contra|strong="H1961"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w*, y Elhanán, \w hijo|strong="H1121"\w* \w de|strong="H5750"\w* Jair, \w mató|strong="H5221"\w* \w a|strong="H3068"\w* Lahmi, hermano \w de|strong="H5750"\w* Goliat \w el|strong="H1121"\w* geteo. \w El|strong="H1121"\w* asta \w de|strong="H5750"\w* la \w lanza|strong="H2595"\w* \w de|strong="H5750"\w* Lahmi \w era|strong="H1961"\w* tan gruesa \w como|strong="H1961"\w* \w el|strong="H1121"\w* rodillo \w de|strong="H5750"\w* un telar.  
\v 6 \w En|strong="H5750"\w* \w otra|strong="H5750"\w* \w guerra|strong="H4421"\w* \w que|strong="H1931"\w* \w hubo|strong="H1961"\w* \w en|strong="H5750"\w* Gat, \w se|strong="H1961"\w* presentó un hombre gigantesco \w que|strong="H1931"\w* \w tenía|strong="H1961"\w* \w veinticuatro|strong="H6242"\w* dedos: \w seis|strong="H8337"\w* \w en|strong="H5750"\w* cada \w mano|strong="H1931"\w* \w y|strong="H1571"\w* \w seis|strong="H8337"\w* \w en|strong="H5750"\w* cada pie. \w Este|strong="H1931"\w* hombre \w también|strong="H1571"\w* \w era|strong="H1961"\w* descendiente \w de|strong="H5750"\w* \w los|strong="H1931"\w* \w gigantes|strong="H7497"\w*.  
\v 7 \w El|strong="H1121"\w* gigante empezó \w a|strong="H3068"\w* desafiar y burlarse \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, así \w que|strong="H1121"\w* Jonatán, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Simea y sobrino \w de|strong="H1121"\w* \w David|strong="H1732"\w*, lo \w mató|strong="H5221"\w*.  
\v 8 Estos hombres eran descendientes de los \w gigantes|strong="H7497"\w* de Gat, y todos \w cayeron|strong="H5307"\w* \w a|strong="H3068"\w* \w manos|strong="H3027"\w* de \w David|strong="H1732"\w* y de sus guerreros.   
\c 21  
\p
\v 1 Satanás \w se|strong="H5921"\w* levantó \w contra|strong="H5921"\w* \w Israel|strong="H3478"\w* \w e|strong="H3068"\w* incitó \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w a|strong="H3068"\w* hacer un censo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 2 \w David|strong="H1732"\w* les dijo \w a|strong="H3068"\w* \w Joab|strong="H3097"\w* \w y|strong="H5704"\w* \w a|strong="H3068"\w* los \w jefes|strong="H8269"\w* del \w pueblo|strong="H5971"\w*: “\w Vayan|strong="H3212"\w* \w y|strong="H5704"\w* \w cuenten|strong="H5608"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w desde|strong="H5704"\w* Beerseba \w hasta|strong="H5704"\w* \w Dan|strong="H1835"\w*, \w y|strong="H5704"\w* tráiganme el reporte \w para|strong="H5704"\w* \w que|strong="H5704"\w* yo \w sepa|strong="H3045"\w* cuántos son.”   
\p
\v 3 \w Joab|strong="H3097"\w* \w le|strong="H5921"\w* respondió: “¡\w Que|strong="H4100"\w* Yahvé multiplique \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w pueblo|strong="H5971"\w* \w cien|strong="H3967"\w* \w veces|strong="H6471"\w* \w más|strong="H3254"\w* \w de|strong="H5921"\w* \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w es|strong="H1961"\w*! Pero, \w mi|strong="H5921"\w* \w señor|strong="H3068"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w*, ¿\w no|strong="H3808"\w* \w son|strong="H1961"\w* \w todos|strong="H3605"\w* \w ellos|strong="H1992"\w* \w siervos|strong="H5650"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w señor|strong="H3068"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* exige \w esto|strong="H2063"\w* \w mi|strong="H5921"\w* \w señor|strong="H3068"\w*? ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* traerle culpa \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*?”   
\p
\v 4 Sin embargo, \w la|strong="H5921"\w* orden \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w prevaleció|strong="H2388"\w* \w sobre|strong="H5921"\w* \w Joab|strong="H3097"\w*. \w Por|strong="H5921"\w* eso \w Joab|strong="H3097"\w* \w salió|strong="H3318"\w* \w y|strong="H5921"\w* recorrió \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w luego|strong="H3318"\w* regresó \w a|strong="H3068"\w* Jerusalén.  
\v 5 \w Joab|strong="H3097"\w* le \w entregó|strong="H5414"\w* \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w los|strong="H3605"\w* resultados del censo del \w pueblo|strong="H5971"\w*. En \w todo|strong="H3605"\w* \w Israel|strong="H3478"\w* \w había|strong="H1961"\w* un millón \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* hombres aptos \w para|strong="H5414"\w* usar \w la|strong="H3605"\w* \w espada|strong="H2719"\w*; y en \w Judá|strong="H3063"\w* \w había|strong="H1961"\w* cuatrocientos \w setenta|strong="H7657"\w* \w mil|strong="H3967"\w* hombres aptos \w para|strong="H5414"\w* usar \w la|strong="H3605"\w* \w espada|strong="H2719"\w*.  
\v 6 \w Pero|strong="H3588"\w* \w no|strong="H3808"\w* incluyó \w a|strong="H3068"\w* las tribus \w de|strong="H3588"\w* \w Leví|strong="H3878"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w Benjamín|strong="H1144"\w* \w en|strong="H8432"\w* \w el|strong="H3588"\w* conteo, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* orden del \w rey|strong="H4428"\w* le parecía detestable.   
\p
\v 7 \w A|strong="H3068"\w* Dios \w le|strong="H5921"\w* desagradó mucho \w esto|strong="H2088"\w*, \w por|strong="H5921"\w* \w lo|strong="H1697"\w* \w que|strong="H5921"\w* castigó \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\v 8 \w Entonces|strong="H3588"\w* \w David|strong="H1732"\w* le dijo \w a|strong="H3068"\w* Dios: “He \w pecado|strong="H5771"\w* \w gravemente|strong="H3966"\w* al \w hacer|strong="H6213"\w* \w esto|strong="H2088"\w*. \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, \w te|strong="H3588"\w* \w ruego|strong="H4994"\w* \w que|strong="H3588"\w* perdones \w la|strong="H3588"\w* culpa \w de|strong="H3588"\w* \w tu|strong="H6213"\w* \w siervo|strong="H5650"\w*, \w porque|strong="H3588"\w* he actuado \w como|strong="H3588"\w* un necio.”   
\p
\v 9 Yahvé le \w habló|strong="H1696"\w* \w a|strong="H3068"\w* \w Gad|strong="H1410"\w*, el \w vidente|strong="H2374"\w* de \w David|strong="H1732"\w*, y le \w dijo|strong="H1696"\w*:  
\v 10 “\w Ve|strong="H3212"\w* \w y|strong="H5921"\w* dile \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H5921"\w* Yahvé \w dice|strong="H1696"\w*: ‘\w Te|strong="H5921"\w* ofrezco \w tres|strong="H7969"\w* castigos. Escoge uno \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w yo|strong="H6213"\w* \w te|strong="H5921"\w* \w lo|strong="H5921"\w* aplique.’”   
\p
\v 11 \w Gad|strong="H1410"\w* fue \w a|strong="H3068"\w* ver \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w y|strong="H3541"\w* le dijo: “\w Así|strong="H3541"\w* dice Yahvé: ‘Elige:  
\v 12 \w tres|strong="H7969"\w* \w años|strong="H8141"\w* \w de|strong="H6440"\w* \w hambre|strong="H7458"\w*; \w tres|strong="H7969"\w* \w meses|strong="H2320"\w* huyendo \w de|strong="H6440"\w* tus \w adversarios|strong="H6862"\w* y siendo alcanzado \w por|strong="H1697"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w* \w de|strong="H6440"\w* tus \w enemigos|strong="H6862"\w*; \w o|strong="H3068"\w* \w tres|strong="H7969"\w* \w días|strong="H3117"\w* \w de|strong="H6440"\w* \w la|strong="H3605"\w* \w espada|strong="H2719"\w* \w de|strong="H6440"\w* Yahvé, en \w los|strong="H3605"\w* \w que|strong="H4100"\w* \w habrá|strong="H3117"\w* una plaga en \w el|strong="H3605"\w* país y \w el|strong="H3605"\w* \w ángel|strong="H4397"\w* \w de|strong="H6440"\w* Yahvé traerá destrucción \w por|strong="H1697"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* territorio \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*.’ Piénsalo \w bien|strong="H7200"\w* y dime \w qué|strong="H4100"\w* debo responderle al \w que|strong="H4100"\w* me \w envió|strong="H7971"\w*.”   
\p
\v 13 \w David|strong="H1732"\w* le dijo \w a|strong="H3068"\w* \w Gad|strong="H1410"\w*: “\w Estoy|strong="H6862"\w* \w en|strong="H3588"\w* una \w angustia|strong="H6862"\w* terrible. Prefiero \w caer|strong="H5307"\w* \w en|strong="H3588"\w* las \w manos|strong="H3027"\w* \w de|strong="H3588"\w* Yahvé, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* misericordia \w es|strong="H3027"\w* \w muy|strong="H3966"\w* \w grande|strong="H7227"\w*, \w y|strong="H3588"\w* \w no|strong="H3588"\w* \w caer|strong="H5307"\w* \w en|strong="H3588"\w* \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* hombres.”   
\p
\v 14 Entonces Yahvé mandó una plaga sobre \w Israel|strong="H3478"\w*, y \w murieron|strong="H5307"\w* \w setenta|strong="H7657"\w* mil israelitas.  
\v 15 \w Además|strong="H5921"\w*, \w Dios|strong="H3068"\w* \w envió|strong="H7971"\w* un \w ángel|strong="H4397"\w* \w para|strong="H5921"\w* \w que|strong="H6258"\w* destruyera Jerusalén. Pero cuando \w estaba|strong="H5975"\w* \w a|strong="H3068"\w* punto \w de|strong="H5921"\w* destruirla, Yahvé \w lo|strong="H5921"\w* \w vio|strong="H7200"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* compadeció \w de|strong="H5921"\w* \w la|strong="H5921"\w* tragedia, \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo \w al|strong="H5921"\w* \w ángel|strong="H4397"\w* destructor: “¡\w Ya|strong="H3068"\w* \w es|strong="H3027"\w* suficiente! Retira tu \w mano|strong="H3027"\w*.” \w En|strong="H5921"\w* ese momento, \w el|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé \w estaba|strong="H5975"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* era \w de|strong="H5921"\w* Ornán \w el|strong="H5921"\w* \w jebuseo|strong="H2983"\w*.  
\v 16 \w David|strong="H1732"\w* \w levantó|strong="H5375"\w* \w la|strong="H5921"\w* vista \w y|strong="H5921"\w* \w vio|strong="H7200"\w* \w al|strong="H5921"\w* \w ángel|strong="H4397"\w* \w de|strong="H5921"\w* Yahvé parado \w entre|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w*, \w con|strong="H5921"\w* una \w espada|strong="H2719"\w* desenvainada \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, apuntando \w hacia|strong="H5921"\w* Jerusalén.  
\p Entonces \w David|strong="H1732"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* líderes \w del|strong="H5921"\w* pueblo, \w que|strong="H5921"\w* \w estaban|strong="H5975"\w* \w vestidos|strong="H3680"\w* \w con|strong="H5921"\w* ropas ásperas \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* dolor, \w se|strong="H5921"\w* postraron \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra.  
\v 17 \w Y|strong="H3068"\w* \w David|strong="H1732"\w* \w le|strong="H1931"\w* dijo \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*: “¿Acaso \w no|strong="H3808"\w* \w fui|strong="H1961"\w* \w yo|strong="H4994"\w* \w el|strong="H1931"\w* \w que|strong="H4100"\w* mandó \w hacer|strong="H6213"\w* \w el|strong="H1931"\w* censo del \w pueblo|strong="H5971"\w*? \w Fui|strong="H1961"\w* \w yo|strong="H4994"\w* \w el|strong="H1931"\w* \w que|strong="H4100"\w* \w pecó|strong="H2398"\w* y \w el|strong="H1931"\w* \w que|strong="H4100"\w* \w hizo|strong="H6213"\w* \w mal|strong="H7489"\w*; pero \w estas|strong="H6213"\w* \w ovejas|strong="H6629"\w*, ¿\w qué|strong="H4100"\w* han \w hecho|strong="H6213"\w*? \w Por|strong="H4100"\w* favor, \w oh|strong="H4100"\w* Yahvé \w mi|strong="H1961"\w* \w Dios|strong="H3068"\w*, \w que|strong="H4100"\w* \w tu|strong="H6213"\w* castigo caiga \w sobre|strong="H1961"\w* \w mí|strong="H1961"\w* y \w sobre|strong="H1961"\w* \w mi|strong="H1961"\w* \w familia|strong="H1004"\w*, pero \w no|strong="H3808"\w* mandes \w esta|strong="H1931"\w* \w plaga|strong="H4046"\w* \w contra|strong="H1961"\w* \w tu|strong="H6213"\w* \w pueblo|strong="H5971"\w*.”   
\p
\v 18 \w Entonces|strong="H3588"\w* \w el|strong="H3588"\w* \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* Yahvé le ordenó \w a|strong="H3068"\w* \w Gad|strong="H1410"\w* \w que|strong="H3588"\w* le dijera \w a|strong="H3068"\w* \w David|strong="H1732"\w* \w que|strong="H3588"\w* subiera \w y|strong="H3588"\w* construyera un \w altar|strong="H4196"\w* \w para|strong="H3588"\w* Yahvé \w en|strong="H3588"\w* \w la|strong="H3588"\w* era \w de|strong="H3588"\w* Ornán \w el|strong="H3588"\w* \w jebuseo|strong="H2983"\w*.  
\v 19 \w David|strong="H1732"\w* \w subió|strong="H5927"\w* para obedecer la \w palabra|strong="H1697"\w* \w que|strong="H1697"\w* \w Gad|strong="H1410"\w* le había \w dicho|strong="H1697"\w* en \w nombre|strong="H8034"\w* \w de|strong="H1697"\w* Yahvé.   
\p
\v 20 Mientras Ornán estaba trillando \w trigo|strong="H2406"\w*, volteó y \w vio|strong="H7200"\w* al \w ángel|strong="H4397"\w*, y sus cuatro \w hijos|strong="H1121"\w* \w que|strong="H1121"\w* estaban \w con|strong="H5973"\w* \w él|strong="H5973"\w* fueron \w a|strong="H3068"\w* esconderse.  
\v 21 \w Cuando|strong="H5704"\w* \w David|strong="H1732"\w* \w se|strong="H4480"\w* acercaba, Ornán \w lo|strong="H5704"\w* \w vio|strong="H7200"\w*, \w y|strong="H5704"\w* \w salió|strong="H3318"\w* \w de|strong="H4480"\w* la era \w para|strong="H5704"\w* inclinarse ante él \w con|strong="H4480"\w* el rostro \w en|strong="H4480"\w* tierra.   
\p
\v 22 Entonces \w David|strong="H1732"\w* \w le|strong="H5921"\w* dijo \w a|strong="H3068"\w* Ornán: “Véndeme \w el|strong="H5921"\w* terreno \w de|strong="H5921"\w* \w esta|strong="H5921"\w* era \w para|strong="H5921"\w* construir aquí un \w altar|strong="H4196"\w* \w a|strong="H3068"\w* Yahvé. Cóbrame \w el|strong="H5921"\w* \w precio|strong="H3701"\w* exacto, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* detenga \w la|strong="H5921"\w* \w plaga|strong="H4046"\w* \w que|strong="H5921"\w* \w está|strong="H5921"\w* sufriendo \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w*.”   
\p
\v 23 Ornán \w le|strong="H5869"\w* respondió \w a|strong="H3068"\w* \w David|strong="H1732"\w*: “\w Tómalo|strong="H3947"\w*; \w que|strong="H3605"\w* mi señor \w el|strong="H3605"\w* \w rey|strong="H4428"\w* \w haga|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w le|strong="H5869"\w* \w parezca|strong="H7200"\w* \w mejor|strong="H2896"\w*. \w Mira|strong="H7200"\w*, también \w te|strong="H5869"\w* regalo \w los|strong="H3605"\w* \w bueyes|strong="H1241"\w* \w para|strong="H5414"\w* \w los|strong="H3605"\w* sacrificios quemados, las tablas \w de|strong="H5414"\w* trillar \w para|strong="H5414"\w* usarlas como \w leña|strong="H6086"\w*, \w y|strong="H1241"\w* \w el|strong="H3605"\w* \w trigo|strong="H2406"\w* \w para|strong="H5414"\w* \w la|strong="H3605"\w* \w ofrenda|strong="H4503"\w* \w de|strong="H5414"\w* cereal. \w Te|strong="H5869"\w* \w lo|strong="H6213"\w* \w doy|strong="H5414"\w* \w todo|strong="H3605"\w*.”   
\p
\v 24 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w* le contestó: “\w No|strong="H3808"\w*, \w de|strong="H3588"\w* \w ninguna|strong="H3808"\w* manera. \w Te|strong="H3588"\w* \w lo|strong="H3808"\w* voy \w a|strong="H3068"\w* comprar \w por|strong="H3588"\w* \w su|strong="H3588"\w* \w precio|strong="H3701"\w* \w justo|strong="H4392"\w*. \w No|strong="H3808"\w* le voy \w a|strong="H3068"\w* ofrecer \w a|strong="H3068"\w* Yahvé \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* pertenece \w a|strong="H3068"\w* ti, \w ni|strong="H3808"\w* le presentaré un sacrificio \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* haya costado \w nada|strong="H3808"\w*.”   
\p
\v 25 Así que \w David|strong="H1732"\w* le \w pagó|strong="H5414"\w* \w a|strong="H3068"\w* Ornán \w seiscientos|strong="H8337"\w* \w siclos|strong="H8255"\w* \w de|strong="H5414"\w* \w oro|strong="H2091"\w* \w por|strong="H5414"\w* el terreno.  
\v 26 \w Luego|strong="H5927"\w*, \w David|strong="H1732"\w* construyó \w allí|strong="H8033"\w* un \w altar|strong="H4196"\w* \w para|strong="H5921"\w* Yahvé, \w y|strong="H5921"\w* presentó sacrificios quemados \w y|strong="H5921"\w* ofrendas \w de|strong="H4480"\w* paz. \w Al|strong="H5921"\w* invocar \w a|strong="H3068"\w* Yahvé, \w él|strong="H5921"\w* \w le|strong="H5921"\w* \w respondió|strong="H6030"\w* enviando fuego \w desde|strong="H4480"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w altar|strong="H4196"\w* \w del|strong="H4480"\w* sacrificio.   
\p
\v 27 \w Entonces|strong="H7725"\w* Yahvé le \w dio|strong="H7725"\w* la orden al \w ángel|strong="H4397"\w*, y este \w volvió|strong="H7725"\w* \w a|strong="H3068"\w* guardar su \w espada|strong="H2719"\w* en la funda.   
\p
\v 28 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w al|strong="H6256"\w* \w ver|strong="H7200"\w* \w David|strong="H1732"\w* \w que|strong="H3588"\w* Yahvé \w le|strong="H1931"\w* \w había|strong="H3588"\w* respondido \w en|strong="H3588"\w* \w la|strong="H1931"\w* \w era|strong="H1931"\w* \w de|strong="H3588"\w* Ornán \w el|strong="H1931"\w* \w jebuseo|strong="H2983"\w*, comenzó \w a|strong="H3068"\w* ofrecer \w sacrificios|strong="H2076"\w* \w allí|strong="H8033"\w*.  
\v 29 \w El|strong="H1931"\w* \w tabernáculo|strong="H4908"\w* \w de|strong="H6256"\w* Yahvé \w que|strong="H1931"\w* \w Moisés|strong="H4872"\w* \w había|strong="H6213"\w* \w hecho|strong="H6213"\w* en \w el|strong="H1931"\w* \w desierto|strong="H4057"\w*, junto con \w el|strong="H1931"\w* \w altar|strong="H4196"\w* \w de|strong="H6256"\w* \w los|strong="H1931"\w* sacrificios, estaban en \w ese|strong="H1931"\w* \w tiempo|strong="H6256"\w* en \w el|strong="H1931"\w* santuario \w de|strong="H6256"\w* \w Gabaón|strong="H1391"\w*.  
\v 30 \w Pero|strong="H3588"\w* \w David|strong="H1732"\w* \w no|strong="H3808"\w* \w podía|strong="H3201"\w* \w ir|strong="H3212"\w* hasta \w allá|strong="H6440"\w* \w para|strong="H3588"\w* consultar \w a|strong="H3068"\w* \w Dios|strong="H3068"\w*, \w porque|strong="H3588"\w* le aterraba \w la|strong="H3588"\w* \w espada|strong="H2719"\w* del \w ángel|strong="H4397"\w* \w de|strong="H3588"\w* Yahvé.   
\c 22  
\p
\v 1 Entonces \w David|strong="H1732"\w* dijo: “¡\w Aquí|strong="H2088"\w* estará \w la|strong="H1931"\w* \w casa|strong="H1004"\w* de Yahvé \w Dios|strong="H3068"\w*, y \w aquí|strong="H2088"\w* estará \w el|strong="H1931"\w* \w altar|strong="H4196"\w* de \w los|strong="H1931"\w* sacrificios quemados para \w Israel|strong="H3478"\w*!”   
\p
\v 2 \w David|strong="H1732"\w* \w ordenó|strong="H5975"\w* reunir \w a|strong="H3068"\w* los \w extranjeros|strong="H1616"\w* \w que|strong="H1616"\w* vivían \w en|strong="H5975"\w* la tierra de \w Israel|strong="H3478"\w*, y contrató \w canteros|strong="H2672"\w* para \w que|strong="H1616"\w* labraran las piedras con las \w que|strong="H1616"\w* se construiría la \w casa|strong="H1004"\w* de Dios.  
\v 3 Además, \w David|strong="H1732"\w* \w preparó|strong="H3559"\w* grandes cantidades de \w hierro|strong="H1270"\w* \w para|strong="H4948"\w* hacer los clavos de las \w puertas|strong="H1817"\w* y las uniones, y tanto bronce que ni siquiera se \w podía|strong="H3559"\w* pesar.  
\v 4 También preparó mucha \w madera|strong="H6086"\w* \w de|strong="H3588"\w* cedro, ya \w que|strong="H3588"\w* \w los|strong="H3588"\w* habitantes \w de|strong="H3588"\w* Sidón \w y|strong="H3588"\w* \w de|strong="H3588"\w* Tiro le trajeron \w a|strong="H3068"\w* \w David|strong="H1732"\w* grandes cantidades \w de|strong="H3588"\w* cedro.  
\v 5 \w David|strong="H1732"\w* pensaba: “\w Mi|strong="H1431"\w* \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* es joven \w e|strong="H3068"\w* inexperto, y \w el|strong="H3605"\w* \w templo|strong="H1004"\w* \w que|strong="H4994"\w* se le \w va|strong="H3068"\w* \w a|strong="H3068"\w* construir \w a|strong="H3068"\w* Yahvé debe ser majestuoso, para \w que|strong="H4994"\w* su \w fama|strong="H8034"\w* y su \w gloria|strong="H8597"\w* se conozcan en \w todas|strong="H3605"\w* las naciones. Así \w que|strong="H4994"\w* voy \w a|strong="H3068"\w* dejarle \w todo|strong="H3605"\w* preparado.” \w Por|strong="H6440"\w* eso \w David|strong="H1732"\w* \w hizo|strong="H1129"\w* \w grandes|strong="H1431"\w* preparativos \w antes|strong="H6440"\w* \w de|strong="H6440"\w* morir.  
\v 6 Luego \w llamó|strong="H7121"\w* \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* y le encargó \w que|strong="H1121"\w* le construyera una \w casa|strong="H1004"\w* \w a|strong="H3068"\w* Yahvé, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 7 \w David|strong="H1732"\w* \w le|strong="H5973"\w* dijo \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*: “\w Hijo|strong="H1121"\w* mío, yo \w tenía|strong="H1961"\w* \w el|strong="H5973"\w* deseo \w en|strong="H5973"\w* \w mi|strong="H1961"\w* \w corazón|strong="H3824"\w* \w de|strong="H5973"\w* construirle una \w casa|strong="H1004"\w* al \w nombre|strong="H8034"\w* \w de|strong="H5973"\w* Yahvé \w mi|strong="H1961"\w* \w Dios|strong="H3068"\w*.  
\v 8 \w Pero|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* \w habló|strong="H1697"\w* \w y|strong="H3588"\w* \w me|strong="H5921"\w* dijo: ‘\w Tú|strong="H6213"\w* has \w derramado|strong="H8210"\w* \w mucha|strong="H7227"\w* \w sangre|strong="H1818"\w* \w y|strong="H3588"\w* has peleado \w grandes|strong="H1419"\w* \w guerras|strong="H4421"\w*. \w No|strong="H3808"\w* \w serás|strong="H1961"\w* \w tú|strong="H6213"\w* \w quien|strong="H6213"\w* \w le|strong="H5921"\w* construya una \w casa|strong="H1004"\w* \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w nombre|strong="H8034"\w*, \w porque|strong="H3588"\w* has \w derramado|strong="H8210"\w* demasiada \w sangre|strong="H1818"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 9 Sin embargo, \w tendrás|strong="H1961"\w* un \w hijo|strong="H1121"\w* \w que|strong="H3588"\w* \w será|strong="H1961"\w* un \w hombre|strong="H1121"\w* pacífico, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w le|strong="H1931"\w* \w daré|strong="H5414"\w* \w paz|strong="H7965"\w* \w con|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* enemigos \w que|strong="H3588"\w* \w lo|strong="H1931"\w* rodeen. \w Su|strong="H1931"\w* \w nombre|strong="H8034"\w* \w será|strong="H1961"\w* \w Salomón|strong="H8010"\w*, \w y|strong="H3588"\w* durante \w su|strong="H1931"\w* reinado \w yo|strong="H3588"\w* \w le|strong="H1931"\w* \w daré|strong="H5414"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w paz|strong="H7965"\w* \w y|strong="H3588"\w* tranquilidad.  
\v 10 \w Él|strong="H1931"\w* \w será|strong="H1961"\w* \w quien|strong="H1931"\w* construya una \w casa|strong="H1004"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* honor. \w Él|strong="H1931"\w* \w será|strong="H1961"\w* \w mi|strong="H5921"\w* \w hijo|strong="H1121"\w* \w y|strong="H5921"\w* yo \w seré|strong="H1961"\w* \w su|strong="H1931"\w* padre, \w y|strong="H5921"\w* afirmaré \w el|strong="H1931"\w* \w trono|strong="H3678"\w* \w de|strong="H5921"\w* \w su|strong="H1931"\w* \w reino|strong="H4438"\w* \w sobre|strong="H5921"\w* \w Israel|strong="H3478"\w* \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.’  
\v 11 \w Ahora|strong="H6258"\w*, \w hijo|strong="H1121"\w* \w mío|strong="H5921"\w*, \w que|strong="H6258"\w* Yahvé \w te|strong="H5921"\w* acompañe \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w dé|strong="H5921"\w* éxito \w para|strong="H5921"\w* \w que|strong="H6258"\w* construyas \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé tu \w Dios|strong="H3068"\w*, tal \w como|strong="H5973"\w* \w él|strong="H5921"\w* \w lo|strong="H5921"\w* ha prometido.  
\v 12 \w Que|strong="H5921"\w* Yahvé \w te|strong="H5921"\w* \w dé|strong="H5921"\w* inteligencia \w y|strong="H5921"\w* sabiduría \w para|strong="H5921"\w* gobernar \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* obedezcas \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w de|strong="H5921"\w* Yahvé tu \w Dios|strong="H3068"\w*.  
\v 13 Tendrás éxito \w si|strong="H5921"\w* \w te|strong="H5921"\w* aseguras \w de|strong="H5921"\w* cumplir \w las|strong="H5921"\w* leyes \w y|strong="H5921"\w* \w las|strong="H5921"\w* normas \w que|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* dio \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w* \w para|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Sé|strong="H5921"\w* fuerte \w y|strong="H5921"\w* valiente. \w No|strong="H6213"\w* tengas \w miedo|strong="H3372"\w* ni \w te|strong="H5921"\w* desanimes.  
\v 14 \w Mira|strong="H2009"\w*, \w con|strong="H5921"\w* \w mucho|strong="H7230"\w* esfuerzo he logrado preparar \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé \w cien|strong="H3967"\w* \w mil|strong="H3967"\w* \w talentos|strong="H3603"\w* \w de|strong="H5921"\w* \w oro|strong="H2091"\w*, un millón \w de|strong="H5921"\w* \w talentos|strong="H3603"\w* \w de|strong="H5921"\w* \w plata|strong="H3701"\w*, \w y|strong="H3588"\w* \w tanto|strong="H5921"\w* bronce \w y|strong="H3588"\w* \w hierro|strong="H1270"\w* \w que|strong="H3588"\w* ni \w se|strong="H1961"\w* puede pesar. También he preparado \w madera|strong="H6086"\w* \w y|strong="H3588"\w* piedra, \w y|strong="H3588"\w* tú podrás conseguir \w más|strong="H3588"\w*.  
\v 15 Además, cuentas \w con|strong="H5973"\w* muchísimos trabajadores: \w canteros|strong="H2672"\w*, \w albañiles|strong="H2796"\w*, \w carpinteros|strong="H2796"\w* y expertos \w en|strong="H5973"\w* \w todo|strong="H3605"\w* tipo \w de|strong="H5973"\w* oficios,  
\v 16 \w para|strong="H1961"\w* \w trabajar|strong="H6213"\w* \w el|strong="H5973"\w* \w oro|strong="H2091"\w*, la \w plata|strong="H3701"\w*, \w el|strong="H5973"\w* bronce y \w el|strong="H5973"\w* \w hierro|strong="H1270"\w* \w que|strong="H1961"\w* tenemos \w en|strong="H5973"\w* abundancia. \w Levántate|strong="H6965"\w* y pon manos \w a|strong="H3068"\w* la \w obra|strong="H6213"\w*, y \w que|strong="H1961"\w* Yahvé \w esté|strong="H1961"\w* \w contigo|strong="H5973"\w*.”   
\p
\v 17 \w David|strong="H1732"\w* también \w les|strong="H6680"\w* \w ordenó|strong="H6680"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* líderes \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1121"\w* ayudaran \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w*, diciéndoles:  
\v 18 “¿Acaso \w no|strong="H3808"\w* \w está|strong="H3427"\w* \w con|strong="H5973"\w* ustedes Yahvé \w su|strong="H3588"\w* \w Dios|strong="H3068"\w*? \w Él|strong="H5973"\w* \w les|strong="H5973"\w* \w ha|strong="H3808"\w* \w dado|strong="H5414"\w* paz \w en|strong="H5973"\w* \w todas|strong="H5439"\w* nuestras fronteras, \w pues|strong="H3588"\w* \w ha|strong="H3808"\w* \w entregado|strong="H5414"\w* \w en|strong="H5973"\w* \w mis|strong="H5414"\w* \w manos|strong="H3027"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* estas tierras, \w y|strong="H3588"\w* \w el|strong="H5973"\w* país \w ha|strong="H3808"\w* quedado sometido \w a|strong="H3068"\w* Yahvé \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.  
\v 19 \w Ahora|strong="H6258"\w*, entreguen su mente y su \w corazón|strong="H3824"\w* \w a|strong="H3068"\w* buscar \w a|strong="H3068"\w* Yahvé su \w Dios|strong="H3068"\w*. \w Levántense|strong="H6965"\w* y construyan el \w santuario|strong="H4720"\w* \w de|strong="H5414"\w* Yahvé \w Dios|strong="H3068"\w*, \w para|strong="H5414"\w* \w que|strong="H6258"\w* puedan trasladar el arca del \w pacto|strong="H1285"\w* \w de|strong="H5414"\w* Yahvé y los utensilios \w sagrados|strong="H6944"\w* \w de|strong="H5414"\w* \w Dios|strong="H3068"\w* al \w templo|strong="H1004"\w* \w que|strong="H6258"\w* se \w va|strong="H3068"\w* \w a|strong="H3068"\w* construir en honor \w a|strong="H3068"\w* Yahvé.”   
\c 23  
\p
\v 1 \w Cuando|strong="H3117"\w* \w David|strong="H1732"\w* ya \w era|strong="H1121"\w* muy anciano, nombró \w a|strong="H3068"\w* su \w hijo|strong="H1121"\w* \w Salomón|strong="H8010"\w* \w como|strong="H5921"\w* \w rey|strong="H4427"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 2 Luego reunió \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* líderes \w de|strong="H8269"\w* \w Israel|strong="H3478"\w*, junto con \w los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* y \w los|strong="H3605"\w* \w levitas|strong="H3881"\w*.  
\v 3 \w Se|strong="H1961"\w* hizo un censo \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w levitas|strong="H3881"\w* \w de|strong="H1121"\w* \w treinta|strong="H7970"\w* \w años|strong="H8141"\w* en adelante, y \w el|strong="H1121"\w* total \w de|strong="H1121"\w* \w hombres|strong="H1121"\w* registrados \w fue|strong="H1961"\w* \w de|strong="H1121"\w* \w treinta|strong="H7970"\w* y \w ocho|strong="H8083"\w* mil.  
\v 4 \w De|strong="H5921"\w* este grupo, David dijo: “\w Veinticuatro|strong="H6242"\w* mil estarán \w a|strong="H3068"\w* cargo \w de|strong="H5921"\w* supervisar \w el|strong="H5921"\w* trabajo \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, \w seis|strong="H8337"\w* mil serán \w oficiales|strong="H7860"\w* \w y|strong="H5921"\w* \w jueces|strong="H8199"\w*,  
\v 5 cuatro mil serán \w porteros|strong="H7778"\w*, y cuatro mil \w alabarán|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé con los \w instrumentos|strong="H3627"\w* musicales que mandé \w hacer|strong="H6213"\w* para la \w alabanza|strong="H1984"\w*.”   
\p
\v 6 \w David|strong="H1732"\w* dividió \w a|strong="H3068"\w* \w los|strong="H1121"\w* levitas en grupos, según \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*: Gersón, Coat y \w Merari|strong="H4847"\w*.   
\p
\v 7 De los descendientes de \w Gersón|strong="H1649"\w* estaban \w Ladán|strong="H3936"\w* y Simei.  
\v 8 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Ladán|strong="H3936"\w* fueron \w tres|strong="H7969"\w*: \w Jehiel|strong="H3171"\w*, \w el|strong="H1121"\w* \w jefe|strong="H7218"\w*, Zetam y \w Joel|strong="H3100"\w*.  
\v 9 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Simei fueron \w tres|strong="H7969"\w*: Selomot, \w Haziel|strong="H2381"\w* y \w Harán|strong="H2039"\w*. Estos fueron \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las familias \w de|strong="H1121"\w* \w Ladán|strong="H3936"\w*.  
\v 10 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Simei fueron cuatro: Jahat, Zina, \w Jeús|strong="H3266"\w* y \w Beriá|strong="H1283"\w*.  
\v 11 Jahat \w era|strong="H1961"\w* \w el|strong="H1121"\w* \w jefe|strong="H7218"\w* y Zina \w el|strong="H1121"\w* \w segundo|strong="H8145"\w*; pero \w como|strong="H1961"\w* \w Jeús|strong="H3266"\w* y \w Beriá|strong="H1283"\w* \w no|strong="H3808"\w* \w tuvieron|strong="H1961"\w* \w muchos|strong="H7235"\w* \w hijos|strong="H1121"\w*, \w se|strong="H1961"\w* les contó \w a|strong="H3068"\w* \w los|strong="H1121"\w* dos \w como|strong="H1961"\w* una sola \w familia|strong="H1004"\w*.   
\p
\v 12 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Coat fueron cuatro: \w Amram|strong="H6019"\w*, Izhar, \w Hebrón|strong="H2275"\w* y Uziel.  
\v 13 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Amram|strong="H6019"\w* fueron Aarón \w y|strong="H5704"\w* \w Moisés|strong="H4872"\w*. Aarón \w fue|strong="H1931"\w* apartado, junto \w con|strong="H5704"\w* \w sus|strong="H1931"\w* descendientes \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*, \w para|strong="H5704"\w* consagrar \w los|strong="H1121"\w* objetos \w más|strong="H5704"\w* \w sagrados|strong="H6944"\w*, \w para|strong="H5704"\w* quemar incienso \w delante|strong="H6440"\w* \w de|strong="H6440"\w* Yahvé, \w para|strong="H5704"\w* servirle \w y|strong="H5704"\w* \w para|strong="H5704"\w* bendecir \w en|strong="H5704"\w* \w su|strong="H1931"\w* \w nombre|strong="H8034"\w* \w por|strong="H6440"\w* \w siempre|strong="H5769"\w*.  
\v 14 \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w Moisés|strong="H4872"\w*, \w el|strong="H5921"\w* \w hombre|strong="H1121"\w* \w de|strong="H5921"\w* Dios, sus \w hijos|strong="H1121"\w* fueron contados \w como|strong="H5921"\w* parte \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w tribu|strong="H7626"\w* \w de|strong="H5921"\w* \w Leví|strong="H3878"\w*.  
\v 15 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Moisés|strong="H4872"\w* \w fueron|strong="H1647"\w* Gersón y Eliezer.  
\v 16 \w El|strong="H1121"\w* \w jefe|strong="H7218"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Gersón fue \w Sebuel|strong="H7619"\w*.  
\v 17 \w El|strong="H1121"\w* \w jefe|strong="H7218"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Eliezer \w fue|strong="H1961"\w* Rehabías. Eliezer \w no|strong="H3808"\w* \w tuvo|strong="H1961"\w* \w más|strong="H7235"\w* \w hijos|strong="H1121"\w*, pero \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Rehabías \w fueron|strong="H1961"\w* muchísimos.  
\v 18 \w El|strong="H1121"\w* \w jefe|strong="H7218"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Izhar fue Selomit.  
\v 19 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Hebrón|strong="H2275"\w* fueron: \w Jerías|strong="H3404"\w*, \w el|strong="H1121"\w* \w jefe|strong="H7218"\w*; Amarías, \w el|strong="H1121"\w* \w segundo|strong="H8145"\w*; \w Jahaziel|strong="H3166"\w*, \w el|strong="H1121"\w* \w tercero|strong="H7992"\w*; y \w Jecamán|strong="H3360"\w*, \w el|strong="H1121"\w* \w cuarto|strong="H7243"\w*.  
\v 20 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Uziel fueron: Miqueas, \w el|strong="H1121"\w* \w jefe|strong="H7218"\w*; \w e|strong="H3068"\w* \w Isías|strong="H3449"\w*, \w el|strong="H1121"\w* \w segundo|strong="H8145"\w*.   
\p
\v 21 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w* fueron Mahli y Musi. \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Mahli fueron Eleazar y \w Cis|strong="H7027"\w*.  
\v 22 Eleazar \w murió|strong="H4191"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w tuvo|strong="H1961"\w* \w hijos|strong="H1121"\w*, \w sino|strong="H3588"\w* puras \w hijas|strong="H1323"\w*; \w así|strong="H3588"\w* \w que|strong="H3588"\w* sus primas \w se|strong="H1961"\w* casaron \w con|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w Cis|strong="H7027"\w*.  
\v 23 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Musi fueron \w tres|strong="H7969"\w*: Mahli, \w Eder|strong="H5740"\w* y Jeremot.   
\p
\v 24 Estos fueron \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*, según sus \w familias|strong="H1004"\w*. Se anotaron \w los|strong="H1121"\w* \w nombres|strong="H8034"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* \w familia|strong="H1004"\w* y se \w contó|strong="H6485"\w* uno por uno \w a|strong="H3068"\w* \w los|strong="H1121"\w* mayores \w de|strong="H1121"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* \w que|strong="H1121"\w* \w hacían|strong="H6213"\w* \w el|strong="H1121"\w* trabajo para \w el|strong="H1121"\w* servicio del \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé.  
\v 25 \w Porque|strong="H3588"\w* \w David|strong="H1732"\w* \w había|strong="H3588"\w* dicho: “Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, le ha dado paz \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w y|strong="H3588"\w* \w él|strong="H3588"\w* vivirá \w en|strong="H5704"\w* Jerusalén \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*.  
\v 26 \w Así|strong="H1571"\w* \w que|strong="H1571"\w* \w los|strong="H3605"\w* \w levitas|strong="H3881"\w* \w ya|strong="H1571"\w* no tendrán \w que|strong="H1571"\w* cargar \w el|strong="H3605"\w* \w tabernáculo|strong="H4908"\w* \w ni|strong="H1571"\w* \w ninguno|strong="H3605"\w* de \w los|strong="H3605"\w* utensilios para su servicio.”  
\v 27 \w De|strong="H3588"\w* acuerdo \w con|strong="H3588"\w* \w las|strong="H1992"\w* últimas instrucciones \w de|strong="H3588"\w* \w David|strong="H1732"\w*, \w se|strong="H1992"\w* hizo \w el|strong="H3588"\w* censo \w de|strong="H3588"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* \w de|strong="H3588"\w* \w veinte|strong="H6242"\w* \w años|strong="H8141"\w* \w en|strong="H3588"\w* adelante.  
\v 28 \w El|strong="H5921"\w* deber \w de|strong="H5921"\w* \w ellos|strong="H3027"\w* \w era|strong="H1121"\w* ayudar \w a|strong="H3068"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5921"\w* Aarón \w en|strong="H5921"\w* \w el|strong="H5921"\w* servicio \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé. \w Estaban|strong="H4612"\w* \w a|strong="H3068"\w* \w cargo|strong="H3027"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w patios|strong="H2691"\w*, \w de|strong="H5921"\w* \w los|strong="H1121"\w* cuartos, \w de|strong="H5921"\w* \w la|strong="H5921"\w* purificación \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* objetos \w sagrados|strong="H6944"\w* \w y|strong="H3588"\w* \w de|strong="H5921"\w* \w cualquier|strong="H3605"\w* otro trabajo \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*.  
\v 29 También se encargaban de \w los|strong="H3605"\w* \w panes|strong="H3899"\w* consagrados, de \w la|strong="H3605"\w* harina fina para \w la|strong="H3605"\w* \w ofrenda|strong="H4503"\w*, de las galletas sin levadura, de \w lo|strong="H3605"\w* \w que|strong="H3605"\w* se preparaba en \w el|strong="H3605"\w* \w sartén|strong="H4227"\w* y de \w la|strong="H3605"\w* masa mezclada. También debían controlar \w todas|strong="H3605"\w* las medidas de capacidad y longitud.  
\v 30 Tenían que presentarse todas las mañanas para dar gracias y \w alabar|strong="H3034"\w* \w a|strong="H3068"\w* Yahvé, y debían hacer lo mismo \w por|strong="H3651"\w* la \w tarde|strong="H6153"\w*.  
\v 31 También debían ofrecerle \w todos|strong="H3605"\w* \w los|strong="H5921"\w* sacrificios quemados \w a|strong="H3068"\w* Yahvé \w en|strong="H5921"\w* \w los|strong="H5921"\w* días \w de|strong="H5921"\w* descanso, \w en|strong="H5921"\w* \w las|strong="H5921"\w* lunas \w nuevas|strong="H2320"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* fiestas establecidas. Debían hacerlo \w siempre|strong="H8548"\w* \w delante|strong="H6440"\w* \w de|strong="H5921"\w* Yahvé, siguiendo \w las|strong="H5921"\w* reglas establecidas \w para|strong="H5921"\w* ello.  
\v 32 Por último, \w tenían|strong="H8104"\w* \w a|strong="H3068"\w* su cargo \w el|strong="H1121"\w* cuidado \w de|strong="H1121"\w* \w la|strong="H8104"\w* Tienda \w de|strong="H1121"\w* Reunión, \w el|strong="H1121"\w* cuidado del \w santuario|strong="H6944"\w* y \w la|strong="H8104"\w* responsabilidad \w de|strong="H1121"\w* ayudar \w a|strong="H3068"\w* sus hermanos, \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Aarón, en todo \w el|strong="H1121"\w* servicio del \w templo|strong="H1004"\w* \w de|strong="H1121"\w* Yahvé.   
\c 24  
\p
\v 1 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Aarón se organizaron \w de|strong="H1121"\w* esta manera: \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aarón fueron \w Nadab|strong="H5070"\w*, Abiú, Eleazar \w e|strong="H3068"\w* Itamar.  
\v 2 \w Sin|strong="H3808"\w* embargo, \w Nadab|strong="H5070"\w* y Abiú \w murieron|strong="H4191"\w* \w antes|strong="H6440"\w* \w que|strong="H3808"\w* \w su|strong="H1992"\w* padre y \w no|strong="H3808"\w* dejaron \w hijos|strong="H1121"\w*, \w así|strong="H1992"\w* \w que|strong="H3808"\w* Eleazar \w e|strong="H3068"\w* Itamar oficiaron \w como|strong="H1961"\w* sacerdotes.  
\v 3 \w David|strong="H1732"\w*, \w con|strong="H4480"\w* la ayuda \w de|strong="H4480"\w* \w Sadoc|strong="H6659"\w* (\w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Eleazar) y Ahimelec (\w de|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Itamar), \w los|strong="H1121"\w* organizó \w en|strong="H4480"\w* turnos \w para|strong="H4480"\w* \w que|strong="H4480"\w* cumplieran sus deberes.  
\v 4 Como \w había|strong="H4672"\w* \w más|strong="H4480"\w* \w jefes|strong="H7218"\w* \w de|strong="H4480"\w* \w familia|strong="H1004"\w* \w entre|strong="H4480"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H4480"\w* Eleazar \w que|strong="H4480"\w* \w entre|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Itamar, \w los|strong="H1121"\w* organizaron así: designaron \w dieciséis|strong="H8337"\w* \w jefes|strong="H7218"\w* \w de|strong="H4480"\w* \w familia|strong="H1004"\w* \w para|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Eleazar, y \w ocho|strong="H8083"\w* \w jefes|strong="H7218"\w* \w de|strong="H4480"\w* \w familia|strong="H1004"\w* \w para|strong="H4480"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Itamar.  
\v 5 \w Se|strong="H1961"\w* repartieron \w los|strong="H1121"\w* turnos \w de|strong="H3588"\w* manera imparcial echando \w suertes|strong="H1486"\w*, \w porque|strong="H3588"\w* tanto \w en|strong="H5973"\w* \w la|strong="H3588"\w* familia \w de|strong="H3588"\w* Eleazar \w como|strong="H3588"\w* \w en|strong="H5973"\w* \w la|strong="H3588"\w* \w de|strong="H3588"\w* Itamar \w había|strong="H1961"\w* oficiales \w del|strong="H5973"\w* \w santuario|strong="H6944"\w* \w y|strong="H3588"\w* oficiales \w de|strong="H3588"\w* Dios.  
\v 6 \w Semaías|strong="H8098"\w*, \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Natanael, \w que|strong="H4480"\w* \w era|strong="H1121"\w* un \w escriba|strong="H5608"\w* \w levita|strong="H3881"\w*, anotó \w los|strong="H1121"\w* nombres \w en|strong="H4480"\w* \w presencia|strong="H6440"\w* \w del|strong="H4480"\w* \w rey|strong="H4428"\w*, \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w príncipes|strong="H8269"\w*, \w del|strong="H4480"\w* \w sacerdote|strong="H3548"\w* \w Sadoc|strong="H6659"\w*, \w de|strong="H4480"\w* Ahimelec \w hijo|strong="H1121"\w* \w de|strong="H4480"\w* Abiatar, y \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w jefes|strong="H8269"\w* \w de|strong="H4480"\w* \w familia|strong="H1004"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w* y \w levitas|strong="H3881"\w*. \w Por|strong="H4480"\w* cada turno \w que|strong="H4480"\w* \w se|strong="H4480"\w* le daba \w a|strong="H3068"\w* un descendiente \w de|strong="H4480"\w* Itamar, \w se|strong="H4480"\w* les daban \w dos|strong="H6440"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w de|strong="H4480"\w* Eleazar.   
\p
\v 7 La \w primera|strong="H7223"\w* \w suerte|strong="H1486"\w* le tocó \w a|strong="H3068"\w* \w Joiarib|strong="H3080"\w*, la \w segunda|strong="H8145"\w* \w a|strong="H3068"\w* \w Jedaías|strong="H3048"\w*,  
\v 8 la \w tercera|strong="H7992"\w* \w a|strong="H3068"\w* \w Harim|strong="H2766"\w*, la cuarta \w a|strong="H3068"\w* Seorim,  
\v 9 la quinta \w a|strong="H3068"\w* Malquías, la sexta \w a|strong="H3068"\w* Mijamín,  
\v 10 la séptima \w a|strong="H3068"\w* \w Cos|strong="H6976"\w*, la octava \w a|strong="H3068"\w* Abías,  
\v 11 la novena \w a|strong="H3068"\w* \w Jesúa|strong="H3442"\w*, la décima \w a|strong="H3068"\w* Secanías,  
\v 12 la undécima \w a|strong="H3068"\w* Eliasib, la duodécima \w a|strong="H3068"\w* Jaquim,  
\v 13 la decimotercera \w a|strong="H3068"\w* Hupa, la decimocuarta \w a|strong="H3068"\w* Jesebeab,  
\v 14 la decimoquinta \w a|strong="H3068"\w* \w Bilga|strong="H1083"\w*, la decimosexta \w a|strong="H3068"\w* Imer,  
\v 15 la decimoséptima \w a|strong="H3068"\w* \w Hezir|strong="H2387"\w*, la decimoctava \w a|strong="H3068"\w* Afses,  
\v 16 la decimonovena \w a|strong="H3068"\w* Petaías, la vigésima \w a|strong="H3068"\w* Hezequiel,  
\v 17 la vigesimoprimera \w a|strong="H3068"\w* Jaquín, la vigesimosegunda \w a|strong="H3068"\w* Gamul,  
\v 18 la vigesimotercera \w a|strong="H3068"\w* Delaías, y la vigesimocuarta \w a|strong="H3068"\w* \w Maazías|strong="H4590"\w*.  
\v 19 Este fue el \w orden|strong="H6680"\w* en \w que|strong="H3027"\w* debían entrar al \w templo|strong="H1004"\w* de Yahvé para cumplir con su servicio, de acuerdo con el reglamento \w que|strong="H3027"\w* \w les|strong="H6680"\w* dio su antepasado Aarón, tal como se lo había \w ordenado|strong="H6680"\w* Yahvé, el \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*.   
\p
\v 20 En cuanto al resto \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Leví|strong="H3878"\w*: \w el|strong="H1121"\w* jefe \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Amram|strong="H6019"\w* fue \w Subael|strong="H7619"\w*; \w el|strong="H1121"\w* jefe \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Subael|strong="H7619"\w* fue Jehdeías.  
\v 21 \w El|strong="H1121"\w* \w jefe|strong="H7218"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Rehabías fue \w Isías|strong="H3449"\w*.  
\v 22 \w El|strong="H1121"\w* jefe \w de|strong="H1121"\w* la familia \w de|strong="H1121"\w* Izhar fue Selomot; \w el|strong="H1121"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Selomot fue Jahat.  
\v 23 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Hebrón fueron: \w Jerías|strong="H3404"\w*, \w el|strong="H1121"\w* jefe; Amarías, \w el|strong="H1121"\w* \w segundo|strong="H8145"\w*; \w Jahaziel|strong="H3166"\w*, \w el|strong="H1121"\w* \w tercero|strong="H7992"\w*; y \w Jecamán|strong="H3360"\w*, \w el|strong="H1121"\w* \w cuarto|strong="H7243"\w*.  
\v 24 \w El|strong="H1121"\w* jefe \w de|strong="H1121"\w* la familia \w de|strong="H1121"\w* Uziel fue Miqueas; \w el|strong="H1121"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Miqueas fue \w Samir|strong="H8053"\w*.  
\v 25 \w El|strong="H1121"\w* hermano \w de|strong="H1121"\w* Miqueas fue \w Isías|strong="H3449"\w*; \w el|strong="H1121"\w* jefe \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Isías|strong="H3449"\w* fue \w Zacarías|strong="H2148"\w*.  
\v 26 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Merari|strong="H4847"\w* fueron Mahli y Musi. \w El|strong="H1121"\w* descendiente \w de|strong="H1121"\w* Jaazías fue Beno.  
\v 27 \w Los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Merari|strong="H4847"\w* por la línea \w de|strong="H1121"\w* Jaazías fueron Beno, Soham, Zacur \w e|strong="H3068"\w* Ibri.  
\v 28 \w El|strong="H1121"\w* descendiente \w de|strong="H1121"\w* Mahli \w fue|strong="H1961"\w* Eleazar, pero \w él|strong="H1121"\w* \w no|strong="H3808"\w* \w tuvo|strong="H1961"\w* \w hijos|strong="H1121"\w* varones.  
\v 29 \w De|strong="H1121"\w* la línea \w de|strong="H1121"\w* \w Cis|strong="H7027"\w*, \w el|strong="H1121"\w* descendiente fue \w Jerameel|strong="H3396"\w*.  
\v 30 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Musi fueron Mahli, \w Eder|strong="H5740"\w* y Jerimot. Estos fueron \w los|strong="H1121"\w* \w levitas|strong="H3881"\w*, agrupados según sus \w familias|strong="H1004"\w*.  
\v 31 \w Ellos|strong="H1992"\w* \w también|strong="H1571"\w* \w echaron|strong="H5307"\w* \w suertes|strong="H1486"\w*, igual \w que|strong="H1571"\w* \w sus|strong="H1992"\w* parientes, \w los|strong="H1992"\w* descendientes \w de|strong="H6440"\w* Aarón, estando presentes \w el|strong="H5307"\w* \w rey|strong="H4428"\w* \w David|strong="H1732"\w*, \w Sadoc|strong="H6659"\w*, Ahimelec \w y|strong="H1571"\w* \w los|strong="H1992"\w* \w jefes|strong="H7218"\w* \w de|strong="H6440"\w* \w las|strong="H1992"\w* familias \w de|strong="H6440"\w* \w los|strong="H1992"\w* \w sacerdotes|strong="H3548"\w* \w y|strong="H1571"\w* \w de|strong="H6440"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w*. \w A|strong="H3068"\w* \w las|strong="H1992"\w* familias \w de|strong="H6440"\w* \w los|strong="H1992"\w* hermanos mayores \w se|strong="H1992"\w* \w les|strong="H1992"\w* trató igual \w que|strong="H1571"\w* \w a|strong="H3068"\w* \w las|strong="H1992"\w* familias \w de|strong="H6440"\w* \w los|strong="H1992"\w* hermanos \w menores|strong="H6996"\w*.   
\c 25  
\p
\v 1 Además, \w David|strong="H1732"\w* y \w los|strong="H1121"\w* comandantes del \w ejército|strong="H6635"\w* apartaron \w para|strong="H1961"\w* \w el|strong="H1121"\w* servicio \w a|strong="H3068"\w* algunos \w de|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Asaf, \w de|strong="H1121"\w* \w Hemán|strong="H1968"\w* y \w de|strong="H1121"\w* Jedutún, \w para|strong="H1961"\w* \w que|strong="H1121"\w* profetizaran acompañados \w de|strong="H1121"\w* \w arpas|strong="H3658"\w*, liras y \w címbalos|strong="H4700"\w*. \w Esta|strong="H1961"\w* \w es|strong="H1961"\w* la lista \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w que|strong="H1121"\w* cumplían con \w este|strong="H1961"\w* servicio:  
\v 2 \w De|strong="H5921"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H5921"\w* Asaf: Zacur, \w José|strong="H3130"\w*, Netanías \w y|strong="H5921"\w* Asarela. \w Ellos|strong="H3027"\w* estaban bajo \w la|strong="H5921"\w* dirección \w de|strong="H5921"\w* Asaf, quien profetizaba siguiendo \w las|strong="H5921"\w* órdenes \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 3 \w De|strong="H5921"\w* \w la|strong="H5921"\w* familia \w de|strong="H5921"\w* Jedutún, estos \w seis|strong="H8337"\w* \w hijos|strong="H1121"\w*: \w Gedalías|strong="H1436"\w*, Zeri, \w Jesaías|strong="H3470"\w*, Simei, \w Hasabías|strong="H2811"\w* \w y|strong="H5921"\w* Matatías. \w Ellos|strong="H3027"\w* estaban bajo \w la|strong="H5921"\w* dirección \w de|strong="H5921"\w* su padre Jedutún, quien profetizaba dando gracias \w y|strong="H5921"\w* \w alabando|strong="H1984"\w* \w a|strong="H3068"\w* Yahvé \w al|strong="H5921"\w* son \w del|strong="H5921"\w* \w arpa|strong="H3658"\w*.  
\v 4 \w De|strong="H1121"\w* \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* \w Hemán|strong="H1968"\w*: Buquías, Matanías, Uziel, \w Sebuel|strong="H7619"\w*, Jerimot, \w Hananías|strong="H2608"\w*, \w Hanani|strong="H2607"\w*, Eliata, Gidalti, \w Romamti-Ezer|strong="H7320"\w*, \w Josbecasa|strong="H3436"\w*, Maloti, Hotir y Mahaziot.  
\v 5 \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* fueron \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Hemán|strong="H1968"\w*, \w el|strong="H3605"\w* \w vidente|strong="H2374"\w* del \w rey|strong="H4428"\w*. Dios le había prometido \w a|strong="H3068"\w* \w Hemán|strong="H1968"\w* \w darle|strong="H5414"\w* mucho poder, y \w por|strong="H1697"\w* eso le \w dio|strong="H5414"\w* catorce \w hijos|strong="H1121"\w* y \w tres|strong="H7969"\w* \w hijas|strong="H1323"\w*.  
\v 6 \w Todos|strong="H3605"\w* \w ellos|strong="H3027"\w* estaban bajo \w la|strong="H5921"\w* dirección \w de|strong="H5921"\w* su padre \w para|strong="H5921"\w* cantar \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé, tocando \w címbalos|strong="H4700"\w*, liras \w y|strong="H5921"\w* \w arpas|strong="H3658"\w*, \w para|strong="H5921"\w* \w el|strong="H5921"\w* servicio \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Dios|strong="H3068"\w*. Asaf, Jedutún \w y|strong="H5921"\w* \w Hemán|strong="H1968"\w* estaban directamente bajo \w las|strong="H5921"\w* órdenes \w del|strong="H5921"\w* \w rey|strong="H4428"\w*.  
\v 7 \w El|strong="H5973"\w* \w número|strong="H4557"\w* \w de|strong="H5973"\w* \w ellos|strong="H3605"\w*, \w junto|strong="H5973"\w* \w con|strong="H5973"\w* sus parientes \w que|strong="H1961"\w* \w estaban|strong="H1961"\w* capacitados \w en|strong="H5973"\w* \w el|strong="H5973"\w* canto \w a|strong="H3068"\w* Yahvé, \w todos|strong="H3605"\w* \w los|strong="H3605"\w* cuales \w eran|strong="H1961"\w* expertos, sumaba \w doscientos|strong="H3967"\w* \w ochenta|strong="H8084"\w* y \w ocho|strong="H8083"\w*.  
\v 8 \w Echaron|strong="H5307"\w* \w suertes|strong="H1486"\w* \w para|strong="H5973"\w* asignarse \w los|strong="H5973"\w* \w turnos|strong="H4931"\w* \w de|strong="H5973"\w* servicio; todos participaron por igual: \w el|strong="H5973"\w* joven y \w el|strong="H5973"\w* anciano, \w el|strong="H5973"\w* maestro y \w el|strong="H5973"\w* aprendiz.   
\p
\v 9 \w El|strong="H1931"\w* \w primer|strong="H7223"\w* turno \w le|strong="H1931"\w* tocó \w a|strong="H3068"\w* Asaf, por medio \w de|strong="H1121"\w* \w José|strong="H3130"\w*; \w el|strong="H1931"\w* \w segundo|strong="H8145"\w* turno \w le|strong="H1931"\w* tocó \w a|strong="H3068"\w* \w Gedalías|strong="H1436"\w*, \w que|strong="H1931"\w* con \w sus|strong="H1931"\w* parientes y \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* sumaban \w doce|strong="H8147"\w*;  
