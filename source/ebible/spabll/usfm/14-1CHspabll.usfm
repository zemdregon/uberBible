\v 39 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Ula: Ara, \w Haniel|strong="H2592"\w* y Rizia.  
\v 40 \w Todos|strong="H3605"\w* \w estos|strong="H3605"\w* fueron \w los|strong="H1121"\w* descendientes \w de|strong="H1121"\w* Aser, \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* las \w casas|strong="H1004"\w* paternas, guerreros selectos y \w valientes|strong="H1368"\w*, \w jefes|strong="H7218"\w* \w principales|strong="H7218"\w*. \w El|strong="H3605"\w* \w número|strong="H4557"\w* \w de|strong="H1121"\w* \w ellos|strong="H3605"\w* registrados por genealogía para \w el|strong="H3605"\w* servicio militar \w era|strong="H1121"\w* \w de|strong="H1121"\w* \w veintiséis|strong="H6242"\w* mil \w hombres|strong="H1368"\w*.   
\c 8  
\p
\v 1 \w Benjamín|strong="H1144"\w* fue padre de \w Bela|strong="H1106"\w*, su \w primogénito|strong="H1060"\w*; Asbel, el \w segundo|strong="H8145"\w*; Ahara, el \w tercero|strong="H7992"\w*;  
\v 2 \w Noha|strong="H5119"\w*, el \w cuarto|strong="H7243"\w*, y Rafa, el \w quinto|strong="H2549"\w*.  
\v 3 \w Bela|strong="H1106"\w* \w tuvo|strong="H1961"\w* \w hijos|strong="H1121"\w*: Adar, \w Gera|strong="H1617"\w*, Abiud,  
\v 4 Abisúa, \w Naamán|strong="H5283"\w*, Ahoá,  
\v 5 \w Gera|strong="H1617"\w*, Sefufán y Huram.  
\v 6 \w Estos|strong="H1992"\w* son \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Aod. \w Estos|strong="H1992"\w* son \w los|strong="H1992"\w* \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* familia \w de|strong="H1121"\w* \w los|strong="H1992"\w* \w que|strong="H1121"\w* \w vivían|strong="H3427"\w* en Geba, \w que|strong="H1121"\w* fueron llevados \w cautivos|strong="H1540"\w* \w a|strong="H3068"\w* Manahat:  
\v 7 \w Naamán|strong="H5283"\w*, Ahías y \w Gera|strong="H1617"\w*, \w quien|strong="H1931"\w* \w los|strong="H1931"\w* llevó \w cautivos|strong="H1540"\w*; y \w él|strong="H1931"\w* \w fue|strong="H1931"\w* padre de Uza y Ahiud.   
\p
\v 8 Saharaim tuvo hijos \w en|strong="H4480"\w* el \w campo|strong="H7704"\w* \w de|strong="H4480"\w* \w Moab|strong="H4124"\w*, después \w de|strong="H4480"\w* haberse divorciado \w de|strong="H4480"\w* sus esposas. \w Husim|strong="H2366"\w* y Baara fueron sus esposas.  
\v 9 \w Con|strong="H4480"\w* Hodes, su esposa, fue padre \w de|strong="H4480"\w* \w Jobab|strong="H3103"\w*, Zibia, \w Mesa|strong="H4331"\w*, Malcam,  
\v 10 Jeúz, Saquía y Mirma. Estos fueron sus \w hijos|strong="H1121"\w*, \w jefes|strong="H7218"\w* \w de|strong="H1121"\w* familia \w de|strong="H1121"\w* sus padres.  
\v 11 Con \w Husim|strong="H2366"\w* fue padre de Abitub y de Elpaal.  
\v 12 \w Los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Elpaal: \w Heber|strong="H5677"\w*, \w Misam|strong="H4936"\w* y Semed, quienes construyeron Ono y \w Lod|strong="H3850"\w*, con \w sus|strong="H1931"\w* \w aldeas|strong="H1323"\w*;  
\v 13 y \w Beriá|strong="H1283"\w* y Sema, \w que|strong="H1992"\w* fueron \w jefes|strong="H7218"\w* de familia de \w los|strong="H1992"\w* \w que|strong="H1992"\w* \w vivían|strong="H3427"\w* en Ajalón, y quienes hicieron huir \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w habitantes|strong="H3427"\w* de Gat;  
\v 14 y Ahío, \w Sasac|strong="H8349"\w*, Jeremot,  
\v 15 \w Zebadías|strong="H2069"\w*, \w Arad|strong="H6166"\w*, Eder,  
\v 16 \w Miguel|strong="H4317"\w*, Ispa, Joha, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Beriá|strong="H1283"\w*,  
\v 17 \w Zebadías|strong="H2069"\w*, Mesulam, Hizqui, \w Heber|strong="H2268"\w*,  
\v 18 Ismerai, \w Izlía|strong="H3152"\w*, \w Jobab|strong="H3103"\w*, \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Elpaal,  
\v 19 Jaquim, Zicri, \w Zabdi|strong="H2067"\w*,  
\v 20 Elienai, Ziletai, Eliel,  
\v 21 \w Adaías|strong="H5718"\w*, Beraías, Simrat, \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* Simei,  
\v 22 Ispán, \w Heber|strong="H5677"\w*, Eliel,  
\v 23 \w Abdón|strong="H5658"\w*, Zicri, \w Hanán|strong="H2605"\w*,  
