\mt2 Primera carta del Apóstol San Pablo a los  
\mt1 Tesalonicenses  
\c 1  
\p
\v 1 \w Pablo|strong="G3972"\w*, \w Silvano|strong="G4610"\w* \w y|strong="G2532"\w* \w Timoteo|strong="G5095"\w*, \w a|strong="G1722"\w* \w la|strong="G3588"\w* \w iglesia|strong="G1577"\w* \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w tesalonicenses|strong="G2331"\w* \w en|strong="G1722"\w* \w Dios|strong="G2316"\w* \w Padre|strong="G3962"\w* \w y|strong="G2532"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*: \w Gracia|strong="G5485"\w* \w y|strong="G2532"\w* \w paz|strong="G1515"\w* \w a|strong="G1722"\w* ustedes \w de|strong="G1722"\w* parte \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w nuestro|strong="G3588"\w* \w Padre|strong="G3962"\w* \w y|strong="G2532"\w* \w del|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*.   
\p
\v 2 Damos \w siempre|strong="G3842"\w* \w gracias|strong="G2168"\w* \w a|strong="G1909"\w* \w Dios|strong="G2316"\w* \w por|strong="G4012"\w* \w todos|strong="G3956"\w* ustedes, mencionándolos \w en|strong="G1909"\w* nuestras \w oraciones|strong="G4335"\w*,  
\v 3 recordando \w sin|strong="G2532"\w* cesar \w su|strong="G3588"\w* \w obra|strong="G2041"\w* \w de|strong="G3588"\w* \w fe|strong="G4102"\w*, \w su|strong="G3588"\w* \w trabajo|strong="G2873"\w* \w de|strong="G3588"\w* amor \w y|strong="G2532"\w* \w su|strong="G3588"\w* perseverancia \w en|strong="G3588"\w* \w la|strong="G3588"\w* \w esperanza|strong="G1680"\w* \w en|strong="G3588"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*, \w delante|strong="G1715"\w* \w de|strong="G3588"\w* \w nuestro|strong="G2249"\w* \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* \w Padre|strong="G3962"\w*.  
\v 4 \w Sabemos|strong="G1492"\w*, hermanos amados \w por|strong="G5259"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* ustedes son elegidos,  
\v 5 \w porque|strong="G3754"\w* \w nuestro|strong="G2249"\w* \w evangelio|strong="G2098"\w* \w les|strong="G1519"\w* \w llegó|strong="G1096"\w* \w no|strong="G3756"\w* \w sólo|strong="G3441"\w* \w en|strong="G1722"\w* \w palabras|strong="G3056"\w*, sino \w también|strong="G2532"\w* \w con|strong="G1722"\w* \w poder|strong="G1411"\w*, \w con|strong="G1722"\w* \w el|strong="G3588"\w* \w Espíritu|strong="G4151"\w* Santo \w y|strong="G2532"\w* \w con|strong="G1722"\w* profunda convicción. Bien \w saben|strong="G1492"\w* \w cómo|strong="G2531"\w* nos portamos \w entre|strong="G1722"\w* ustedes buscando \w su|strong="G3588"\w* propio bien.  
\v 6 Ustedes llegaron \w a|strong="G1722"\w* \w ser|strong="G1096"\w* \w imitadores|strong="G3402"\w* \w de|strong="G1722"\w* \w nosotros|strong="G2249"\w* \w y|strong="G2532"\w* \w del|strong="G3588"\w* \w Señor|strong="G2962"\w*, \w habiendo|strong="G1096"\w* recibido \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w en|strong="G1722"\w* medio \w de|strong="G1722"\w* \w mucha|strong="G4183"\w* \w aflicción|strong="G2347"\w*, \w con|strong="G3326"\w* \w la|strong="G3588"\w* \w alegría|strong="G5479"\w* \w que|strong="G3588"\w* da \w el|strong="G3588"\w* \w Espíritu|strong="G4151"\w* Santo,  
\v 7 \w de|strong="G1722"\w* \w modo|strong="G5620"\w* \w que|strong="G3588"\w* llegaron \w a|strong="G1722"\w* \w ser|strong="G1096"\w* \w un|strong="G3588"\w* \w ejemplo|strong="G5179"\w* \w para|strong="G1722"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* \w creyentes|strong="G4100"\w* \w en|strong="G1722"\w* \w Macedonia|strong="G3109"\w* \w y|strong="G2532"\w* \w en|strong="G1722"\w* Acaya.  
\v 8 \w Porque|strong="G1063"\w* partiendo \w de|strong="G1722"\w* ustedes \w se|strong="G4314"\w* ha proclamado \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w del|strong="G3588"\w* \w Señor|strong="G2962"\w*, \w no|strong="G3756"\w* \w sólo|strong="G3441"\w* \w en|strong="G1722"\w* \w Macedonia|strong="G3109"\w* \w y|strong="G2532"\w* Acaya, \w sino|strong="G3361"\w* \w que|strong="G3588"\w* \w por|strong="G1722"\w* \w todas|strong="G3956"\w* partes \w se|strong="G4314"\w* ha extendido \w la|strong="G3588"\w* \w fe|strong="G4102"\w* \w que|strong="G3588"\w* \w tienen|strong="G2192"\w* \w hacia|strong="G4314"\w* \w Dios|strong="G2316"\w*, \w de|strong="G1722"\w* \w modo|strong="G5620"\w* \w que|strong="G3588"\w* \w no|strong="G3756"\w* \w tenemos|strong="G2192"\w* \w necesidad|strong="G5532"\w* \w de|strong="G1722"\w* \w decir|strong="G2980"\w* \w nada|strong="G5100"\w*.  
\v 9 \w Porque|strong="G1063"\w* \w ellos|strong="G3588"\w* mismos cuentan \w de|strong="G4012"\w* \w nosotros|strong="G2249"\w* \w cómo|strong="G4459"\w* \w nos|strong="G2316"\w* recibieron, \w y|strong="G2532"\w* \w cómo|strong="G4459"\w* ustedes \w se|strong="G4314"\w* apartaron \w de|strong="G4012"\w* \w los|strong="G3588"\w* \w ídolos|strong="G1497"\w* \w para|strong="G4314"\w* volver \w a|strong="G4314"\w* \w Dios|strong="G2316"\w*, \w para|strong="G4314"\w* \w servir|strong="G1398"\w* \w al|strong="G3588"\w* \w Dios|strong="G2316"\w* \w vivo|strong="G2198"\w* \w y|strong="G2532"\w* verdadero,  
\v 10 \w y|strong="G2532"\w* \w para|strong="G1537"\w* esperar \w del|strong="G3588"\w* \w cielo|strong="G3772"\w* \w a|strong="G1537"\w* \w su|strong="G3588"\w* \w Hijo|strong="G5207"\w*, \w al|strong="G3588"\w* \w cual|strong="G3739"\w* \w resucitó|strong="G1453"\w* \w de|strong="G1537"\w* \w entre|strong="G1537"\w* \w los|strong="G3588"\w* \w muertos|strong="G3498"\w*, \w es|strong="G3739"\w* decir, \w a|strong="G1537"\w* \w Jesús|strong="G2424"\w*, \w quien|strong="G3739"\w* nos \w libra|strong="G4506"\w* \w de|strong="G1537"\w* \w la|strong="G3588"\w* \w ira|strong="G3709"\w* venidera.   
\c 2  
\p
\v 1 \w Porque|strong="G1063"\w* ustedes mismos \w saben|strong="G1492"\w*, hermanos, \w que|strong="G3754"\w* \w nuestra|strong="G3588"\w* visita \w a|strong="G4314"\w* ustedes \w no|strong="G3756"\w* \w fue|strong="G1096"\w* \w en|strong="G4314"\w* \w vano|strong="G2756"\w*.  
\v 2 \w Al|strong="G3588"\w* contrario, \w aunque|strong="G2532"\w* \w antes|strong="G2532"\w* habíamos sufrido \w y|strong="G2532"\w* fuimos maltratados \w en|strong="G1722"\w* \w Filipos|strong="G5375"\w*, \w como|strong="G2531"\w* \w ya|strong="G2532"\w* \w saben|strong="G1492"\w*, tuvimos \w el|strong="G3588"\w* valor \w en|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Dios|strong="G2316"\w* \w para|strong="G4314"\w* anunciarles \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w en|strong="G1722"\w* medio \w de|strong="G1722"\w* \w mucha|strong="G4183"\w* oposición.  
\v 3 \w Porque|strong="G1063"\w* \w nuestra|strong="G3588"\w* \w exhortación|strong="G3874"\w* \w no|strong="G3756"\w* se basa \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w error|strong="G4106"\w*, \w ni|strong="G3761"\w* \w en|strong="G1722"\w* \w la|strong="G3588"\w* impureza, \w ni|strong="G3761"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w engaño|strong="G1388"\w*.  
\v 4 Sino \w que|strong="G3588"\w*, \w así|strong="G3779"\w* \w como|strong="G5613"\w* \w Dios|strong="G2316"\w* \w nos|strong="G2316"\w* ha aprobado \w para|strong="G2098"\w* confiarnos \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w*, \w así|strong="G3779"\w* \w hablamos|strong="G2980"\w*; \w no|strong="G3756"\w* \w para|strong="G2098"\w* agradar \w a|strong="G5613"\w* \w los|strong="G3588"\w* hombres, sino \w a|strong="G5613"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* pone \w a|strong="G5613"\w* prueba nuestros \w corazones|strong="G2588"\w*.  
\v 5 \w Porque|strong="G1063"\w*, \w como|strong="G2531"\w* \w saben|strong="G1492"\w*, \w nunca|strong="G3777"\w* usamos \w palabras|strong="G3056"\w* \w de|strong="G1722"\w* adulación, \w ni|strong="G3777"\w* \w nos|strong="G2316"\w* encubrimos \w con|strong="G1722"\w* \w avaricia|strong="G4124"\w* (\w Dios|strong="G2316"\w* \w es|strong="G1096"\w* \w testigo|strong="G3144"\w* \w de|strong="G1722"\w* ello),  
\v 6 \w ni|strong="G3777"\w* \w buscamos|strong="G2212"\w* \w la|strong="G1537"\w* \w gloria|strong="G1391"\w* \w de|strong="G1537"\w* los hombres (\w ni|strong="G3777"\w* \w de|strong="G1537"\w* ustedes \w ni|strong="G3777"\w* \w de|strong="G1537"\w* \w otros|strong="G1537"\w*), \w aunque|strong="G1722"\w* \w como|strong="G5613"\w* apóstoles \w de|strong="G1537"\w* \w Cristo|strong="G5547"\w* teníamos \w el|strong="G5613"\w* derecho \w de|strong="G1537"\w* imponer nuestra autoridad.  
\v 7 Más \w bien|strong="G1437"\w*, \w fuimos|strong="G1096"\w* tiernos \w entre|strong="G1722"\w* ustedes, \w como|strong="G5613"\w* \w una|strong="G3588"\w* madre \w que|strong="G3588"\w* cría \w y|strong="G1510"\w* cuida \w con|strong="G1722"\w* ternura \w a|strong="G1722"\w* \w sus|strong="G3588"\w* propios \w hijos|strong="G5043"\w*.   
\p
\v 8 Sintiendo tanto afecto \w por|strong="G3588"\w* ustedes, \w nos|strong="G1438"\w* \w agradó|strong="G2106"\w* compartirles \w no|strong="G3756"\w* \w sólo|strong="G3441"\w* \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w de|strong="G3588"\w* \w Dios|strong="G2316"\w*, sino \w también|strong="G2532"\w* nuestras propias \w vidas|strong="G5590"\w*, \w porque|strong="G1360"\w* ustedes habían \w llegado|strong="G1096"\w* a sernos muy queridos.  
\v 9 \w Porque|strong="G1063"\w* \w se|strong="G4314"\w* acuerdan, hermanos, \w de|strong="G1519"\w* nuestros \w trabajos|strong="G2873"\w* \w y|strong="G2532"\w* fatigas; \w de|strong="G1519"\w* \w cómo|strong="G2532"\w*, \w trabajando|strong="G2038"\w* \w de|strong="G1519"\w* \w día|strong="G2250"\w* \w y|strong="G2532"\w* \w de|strong="G1519"\w* \w noche|strong="G3571"\w* \w para|strong="G1519"\w* \w no|strong="G3361"\w* ser \w una|strong="G5100"\w* carga \w para|strong="G1519"\w* \w ninguno|strong="G3361"\w* \w de|strong="G1519"\w* ustedes, \w les|strong="G4314"\w* \w predicamos|strong="G2784"\w* \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w* \w de|strong="G1519"\w* \w Dios|strong="G2316"\w*.  
\v 10 Ustedes \w son|strong="G1096"\w* \w testigos|strong="G3144"\w*, \w y|strong="G2532"\w* \w Dios|strong="G2316"\w* \w también|strong="G2532"\w*, \w de|strong="G3588"\w* \w lo|strong="G3588"\w* \w santa|strong="G3743"\w*, \w justa|strong="G1346"\w* \w e|strong="G2532"\w* intachablemente \w que|strong="G3588"\w* \w nos|strong="G2316"\w* comportamos \w con|strong="G2532"\w* ustedes \w los|strong="G3588"\w* \w creyentes|strong="G4100"\w*.  
\v 11 \w Como|strong="G5613"\w* bien \w saben|strong="G1492"\w*, \w a|strong="G5613"\w* \w cada|strong="G1538"\w* \w uno|strong="G1520"\w* de ustedes lo \w exhortábamos|strong="G3870"\w*, lo \w consolábamos|strong="G3888"\w* \w y|strong="G2532"\w* \w le|strong="G1438"\w* rogábamos, \w como|strong="G5613"\w* hace \w un|strong="G1520"\w* \w padre|strong="G3962"\w* \w con|strong="G2532"\w* \w sus|strong="G1438"\w* propios \w hijos|strong="G5043"\w*,  
\v 12 \w para|strong="G1519"\w* \w que|strong="G3588"\w* vivieran \w de|strong="G1519"\w* \w una|strong="G3588"\w* manera digna \w de|strong="G1519"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3588"\w* \w los|strong="G3588"\w* \w llama|strong="G2564"\w* \w a|strong="G1519"\w* \w su|strong="G3588"\w* Reino \w y|strong="G2532"\w* \w a|strong="G1519"\w* \w su|strong="G3588"\w* \w gloria|strong="G1391"\w*.   
\p
\v 13 \w Por|strong="G1223"\w* \w esta|strong="G3778"\w* \w razón|strong="G3056"\w*, \w también|strong="G2532"\w* \w nosotros|strong="G2249"\w* damos \w gracias|strong="G2168"\w* \w a|strong="G1722"\w* \w Dios|strong="G2316"\w* \w sin|strong="G3756"\w* cesar, \w porque|strong="G3754"\w* \w cuando|strong="G1722"\w* \w recibieron|strong="G1209"\w* \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w del|strong="G3588"\w* mensaje \w de|strong="G3844"\w* \w Dios|strong="G2316"\w*, \w la|strong="G3588"\w* aceptaron \w no|strong="G3756"\w* \w como|strong="G2531"\w* \w palabra|strong="G3056"\w* \w de|strong="G3844"\w* hombres, sino \w como|strong="G2531"\w* \w lo|strong="G3588"\w* \w que|strong="G3754"\w* \w es|strong="G3756"\w* \w en|strong="G1722"\w* verdad, \w la|strong="G3588"\w* \w palabra|strong="G3056"\w* \w de|strong="G3844"\w* \w Dios|strong="G2316"\w*, \w que|strong="G3754"\w* \w también|strong="G2532"\w* actúa \w en|strong="G1722"\w* ustedes \w los|strong="G3588"\w* \w que|strong="G3754"\w* \w creen|strong="G4100"\w*.  
\v 14 \w Porque|strong="G1063"\w* ustedes, hermanos, llegaron \w a|strong="G1722"\w* \w ser|strong="G1096"\w* \w imitadores|strong="G3402"\w* \w de|strong="G1722"\w* \w las|strong="G3588"\w* \w iglesias|strong="G1577"\w* \w de|strong="G1722"\w* \w Dios|strong="G2316"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w* \w que|strong="G3754"\w* \w están|strong="G1096"\w* \w en|strong="G1722"\w* \w Judea|strong="G2449"\w*; \w pues|strong="G1063"\w* ustedes \w también|strong="G2532"\w* sufrieron \w a|strong="G1722"\w* manos \w de|strong="G1722"\w* \w sus|strong="G3588"\w* propios compatriotas \w las|strong="G3588"\w* mismas cosas \w que|strong="G3754"\w* \w ellos|strong="G3588"\w* padecieron \w de|strong="G1722"\w* parte \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w judíos|strong="G2453"\w*,  
\v 15 \w los|strong="G3588"\w* cuales mataron \w al|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w* \w y|strong="G2532"\w* a \w los|strong="G3588"\w* \w profetas|strong="G4396"\w*, \w y|strong="G2532"\w* a \w nosotros|strong="G2249"\w* \w nos|strong="G2316"\w* expulsaron. \w Ellos|strong="G3588"\w* \w no|strong="G3361"\w* agradan a \w Dios|strong="G2316"\w* \w y|strong="G2532"\w* están \w en|strong="G3588"\w* \w contra|strong="G1727"\w* \w de|strong="G3588"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* hombres,  
\v 16 impidiéndonos \w hablar|strong="G2980"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* gentiles \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w se|strong="G1438"\w* salven, colmando \w así|strong="G1161"\w* \w siempre|strong="G3842"\w* \w la|strong="G3588"\w* medida \w de|strong="G1909"\w* \w sus|strong="G3588"\w* pecados. \w Pero|strong="G1161"\w* \w la|strong="G3588"\w* \w ira|strong="G3709"\w* \w de|strong="G1909"\w* Dios ha venido \w sobre|strong="G1909"\w* \w ellos|strong="G3588"\w* \w hasta|strong="G1519"\w* \w el|strong="G3588"\w* extremo.   
\p
\v 17 \w Pero|strong="G1161"\w* \w nosotros|strong="G2249"\w*, hermanos, \w habiendo|strong="G4183"\w* estado separados \w de|strong="G1722"\w* ustedes \w por|strong="G1722"\w* \w un|strong="G3588"\w* corto \w tiempo|strong="G2540"\w* (\w en|strong="G1722"\w* \w persona|strong="G4383"\w*, \w pero|strong="G1161"\w* \w no|strong="G3756"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w corazón|strong="G2588"\w*), sentimos \w un|strong="G3588"\w* \w deseo|strong="G1939"\w* inmenso \w de|strong="G1722"\w* verlos, \w y|strong="G1161"\w* nos esforzamos \w mucho|strong="G4183"\w* \w por|strong="G1722"\w* hacerlo.  
\v 18 \w Porque|strong="G1360"\w* queríamos \w ir|strong="G2064"\w* \w a|strong="G4314"\w* verlos (\w de|strong="G4314"\w* hecho, \w yo|strong="G1473"\w*, \w Pablo|strong="G3972"\w*, \w lo|strong="G3588"\w* intenté \w una|strong="G3588"\w* \w y|strong="G2532"\w* \w otra|strong="G1364"\w* vez), \w pero|strong="G2532"\w* \w Satanás|strong="G4567"\w* nos \w lo|strong="G3588"\w* impidió.  
\v 19 \w Pues|strong="G1063"\w*, ¿\w cuál|strong="G5101"\w* es \w nuestra|strong="G3588"\w* \w esperanza|strong="G1680"\w*, \w o|strong="G2228"\w* \w alegría|strong="G5479"\w*, \w o|strong="G2228"\w* \w corona|strong="G4735"\w* \w de|strong="G1722"\w* \w la|strong="G3588"\w* \w cual|strong="G5101"\w* nos enorgullezcamos \w delante|strong="G1715"\w* \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w* \w en|strong="G1722"\w* \w su|strong="G3588"\w* \w venida|strong="G3952"\w*? ¿\w No|strong="G3780"\w* \w lo|strong="G3588"\w* son precisamente ustedes?  
\v 20 ¡Claro \w que|strong="G3588"\w* \w sí|strong="G2532"\w*! Ustedes \w son|strong="G1510"\w* \w nuestra|strong="G3588"\w* \w gloria|strong="G1391"\w* \w y|strong="G2532"\w* \w nuestra|strong="G3588"\w* \w alegría|strong="G5479"\w*.   
\c 3  
\p
\v 1 \w Por|strong="G1722"\w* eso, \w no|strong="G3371"\w* pudiendo soportar \w más|strong="G3371"\w*, nos pareció bien \w quedarnos|strong="G2641"\w* \w solos|strong="G3441"\w* \w en|strong="G1722"\w* Atenas,  
