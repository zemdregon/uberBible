\v 13 \w Saliste|strong="H3318"\w* \w a|strong="H3068"\w* salvar \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*,  
\q2 \w a|strong="H3068"\w* salvar \w a|strong="H3068"\w* tu \w ungido|strong="H4899"\w*.  
