\toc1 LAMENTACIONES DE JEREMÍAS 
\toc2 LAMENTACIONES 
\mt1 Lamentaciones  
\mt2 de Jeremías  
\c 1  
\p
\v 1 ¡\w Qué|strong="H5971"\w* sola \w se|strong="H1961"\w* ha quedado la \w ciudad|strong="H5892"\w* \w que|strong="H5971"\w* \w estaba|strong="H1961"\w* llena \w de|strong="H5971"\w* \w gente|strong="H1471"\w*!  
\q2 \w Se|strong="H1961"\w* ha quedado \w como|strong="H1961"\w* una viuda la \w que|strong="H5971"\w* \w era|strong="H1961"\w* \w grande|strong="H7227"\w* entre las \w naciones|strong="H1471"\w*.  
\q1 La \w que|strong="H5971"\w* \w fue|strong="H1961"\w* princesa entre las \w provincias|strong="H4082"\w*  
\q2 ¡\w se|strong="H1961"\w* ha convertido en una sierva!   
\b  
\q1
\v 2 \w Llora|strong="H1058"\w* \w amargamente|strong="H1058"\w* \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w noches|strong="H3915"\w*; \w las|strong="H5921"\w* \w lágrimas|strong="H1832"\w* corren \w por|strong="H5921"\w* sus mejillas.  
\q2 \w De|strong="H5921"\w* \w entre|strong="H5921"\w* \w todos|strong="H3605"\w* sus amantes, \w no|strong="H1961"\w* \w hay|strong="H1961"\w* \w nadie|strong="H3605"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* consuele.  
\q1 \w Todos|strong="H3605"\w* sus \w amigos|strong="H7453"\w* \w la|strong="H5921"\w* traicionaron;  
\q2 \w se|strong="H1961"\w* volvieron sus enemigos.   
\b  
\q1
\v 3 \w Judá|strong="H3063"\w* \w se|strong="H1931"\w* \w fue|strong="H1931"\w* al cautiverio por causa de \w la|strong="H1931"\w* \w aflicción|strong="H6040"\w*  
\q2 y por \w la|strong="H1931"\w* dura esclavitud.  
\q1 \w Ella|strong="H1931"\w* vive \w entre|strong="H3808"\w* las \w naciones|strong="H1471"\w*, pero \w no|strong="H3808"\w* \w halla|strong="H4672"\w* \w descanso|strong="H4494"\w*.  
\q2 \w Todos|strong="H3605"\w* \w sus|strong="H1931"\w* \w perseguidores|strong="H7291"\w* \w la|strong="H1931"\w* \w alcanzaron|strong="H5381"\w* en medio de \w su|strong="H1931"\w* angustia.   
\b  
\q1
\v 4 \w Los|strong="H3605"\w* \w caminos|strong="H1870"\w* de \w Sión|strong="H6726"\w* están de luto  
\q2 porque \w nadie|strong="H3605"\w* viene \w a|strong="H3068"\w* las fiestas solemnes.  
\q1 \w Todas|strong="H3605"\w* \w sus|strong="H1931"\w* \w puertas|strong="H8179"\w* están desoladas; \w sus|strong="H1931"\w* \w sacerdotes|strong="H3548"\w* suspiran.  
\q2 \w Sus|strong="H1931"\w* \w vírgenes|strong="H1330"\w* están \w afligidas|strong="H3013"\w* y \w ella|strong="H1931"\w* \w misma|strong="H1931"\w* \w está|strong="H1931"\w* llena de \w amargura|strong="H4751"\w*.   
\b  
\q1
\v 5 Sus \w adversarios|strong="H6862"\w* \w se|strong="H1961"\w* han vuelto sus amos \w y|strong="H3588"\w* sus \w enemigos|strong="H6862"\w* \w prosperan|strong="H7951"\w*,  
\q2 \w porque|strong="H3588"\w* Yahvé\f + \fr 1:5 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* \w la|strong="H5921"\w* ha afligido \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H7230"\w* \w de|strong="H5921"\w* sus \w pecados|strong="H6588"\w*.  
\q2 Sus hijos pequeños han ido \w al|strong="H5921"\w* \w cautiverio|strong="H7628"\w* \w delante|strong="H6440"\w* \w del|strong="H5921"\w* \w enemigo|strong="H6862"\w*.   
\b  
\q1
\v 6 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* \w gloria|strong="H3605"\w* \w se|strong="H1961"\w* \w ha|strong="H3808"\w* alejado \w de|strong="H4480"\w* \w la|strong="H3605"\w* \w hija|strong="H1323"\w* \w de|strong="H4480"\w* Sión.  
\q2 Sus \w príncipes|strong="H8269"\w* parecen ciervos \w que|strong="H4480"\w* \w no|strong="H3808"\w* encuentran \w pasto|strong="H4829"\w*;  
\q2 huyen \w sin|strong="H3808"\w* \w fuerzas|strong="H3581"\w* \w delante|strong="H6440"\w* \w del|strong="H4480"\w* perseguidor.   
\b  
\q1
\v 7 \w En|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* su \w aflicción|strong="H6040"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* sus miserias, Jerusalén recuerda  
\q2 \w todas|strong="H3605"\w* \w las|strong="H5921"\w* cosas valiosas \w que|strong="H5921"\w* \w tuvo|strong="H1961"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w tiempos|strong="H3117"\w* \w antiguos|strong="H6924"\w*.  
\q1 \w Cuando|strong="H3117"\w* su \w pueblo|strong="H5971"\w* \w cayó|strong="H5307"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w* \w del|strong="H5921"\w* \w enemigo|strong="H6862"\w* \w y|strong="H5921"\w* \w nadie|strong="H3605"\w* \w la|strong="H5921"\w* \w ayudó|strong="H5826"\w*,  
\q2 \w los|strong="H5921"\w* \w adversarios|strong="H6862"\w* \w la|strong="H5921"\w* \w miraron|strong="H7200"\w* \w y|strong="H5921"\w* \w se|strong="H1961"\w* burlaron \w de|strong="H5921"\w* su caída.   
\b  
\q1
\v 8 Jerusalén ha \w pecado|strong="H2399"\w* gravemente; \w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w se|strong="H1961"\w* ha \w vuelto|strong="H7725"\w* impura.  
\q2 \w Todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w la|strong="H1931"\w* \w honraban|strong="H3513"\w* ahora \w la|strong="H1931"\w* desprecian \w porque|strong="H3588"\w* \w vieron|strong="H7200"\w* \w su|strong="H1931"\w* \w desnudez|strong="H6172"\w*;  
\q2 \w ella|strong="H1931"\w* \w misma|strong="H1931"\w* suspira \w y|strong="H1571"\w* esconde \w el|strong="H1931"\w* rostro.   
\b  
\q1
\v 9 \w Su|strong="H3588"\w* \w inmundicia|strong="H2932"\w* \w se|strong="H3808"\w* \w ve|strong="H7200"\w* \w en|strong="H3588"\w* sus faldas; \w no|strong="H3808"\w* pensó \w en|strong="H3588"\w* \w su|strong="H3588"\w* final.  
\q2 \w Su|strong="H3588"\w* caída \w fue|strong="H3808"\w* asombrosa; \w no|strong="H3808"\w* tiene quien \w la|strong="H3588"\w* consuele.  
\q1 “\w Mira|strong="H7200"\w*, Yahvé, \w mi|strong="H1431"\w* \w aflicción|strong="H6040"\w*,  
\q2 \w porque|strong="H3588"\w* \w el|strong="H3588"\w* enemigo \w se|strong="H3808"\w* \w ha|strong="H3808"\w* \w engrandecido|strong="H1431"\w*”.   
\b  
\q1
\v 10 \w El|strong="H5921"\w* \w enemigo|strong="H6862"\w* \w extendió|strong="H6566"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w todos|strong="H3605"\w* sus tesoros;  
\q2 \w ella|strong="H5921"\w* \w ha|strong="H3808"\w* \w visto|strong="H7200"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* entrar \w en|strong="H5921"\w* \w su|strong="H3588"\w* \w santuario|strong="H4720"\w*,  
\q2 \w a|strong="H3068"\w* pesar \w de|strong="H5921"\w* \w que|strong="H3588"\w* tú \w ordenaste|strong="H6680"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* entraran \w en|strong="H5921"\w* \w su|strong="H3588"\w* asamblea.   
\b  
\q1
\v 11 \w Todo|strong="H3605"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w* gime \w y|strong="H3588"\w* \w busca|strong="H1245"\w* \w pan|strong="H3899"\w*;  
\q2 \w dieron|strong="H5414"\w* sus tesoros \w a|strong="H3068"\w* cambio \w de|strong="H3588"\w* \w comida|strong="H3899"\w* \w para|strong="H3588"\w* salvar \w la|strong="H3605"\w* \w vida|strong="H5315"\w*.  
\q1 “\w Mira|strong="H7200"\w*, Yahvé, \w y|strong="H3588"\w* date cuenta  
\q2 \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w soy|strong="H1961"\w* despreciada”.   
\b  
\q1
\v 12 “¿\w No|strong="H3808"\w* les importa \w nada|strong="H3808"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* ustedes \w que|strong="H3808"\w* \w pasan|strong="H5674"\w* \w por|strong="H1870"\w* \w el|strong="H3605"\w* \w camino|strong="H1870"\w*?  
\q2 \w Miren|strong="H5027"\w* y \w vean|strong="H7200"\w* \w si|strong="H3808"\w* \w hay|strong="H3426"\w* \w dolor|strong="H4341"\w* como \w el|strong="H3605"\w* mío,  
\q2 este \w dolor|strong="H4341"\w* \w que|strong="H3808"\w* me \w ha|strong="H3808"\w* sobrevenido,  
\q2 con \w el|strong="H3605"\w* \w que|strong="H3808"\w* Yahvé me \w ha|strong="H3808"\w* afligido en \w el|strong="H3605"\w* \w día|strong="H3117"\w* de su ardiente \w ira|strong="H2740"\w*.   
\b  
\q1
\v 13 “Desde \w lo|strong="H3605"\w* \w alto|strong="H4791"\w* \w envió|strong="H7971"\w* fuego \w a|strong="H3068"\w* \w mis|strong="H5414"\w* \w huesos|strong="H6106"\w* y este \w los|strong="H3605"\w* dominó.  
\q2 \w Puso|strong="H5414"\w* una \w red|strong="H7568"\w* \w a|strong="H3068"\w* \w mis|strong="H5414"\w* \w pies|strong="H7272"\w* y me \w hizo|strong="H5414"\w* retroceder.  
\q2 Me \w dejó|strong="H7971"\w* abandonada y desfallezco \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w*.   
\b  
\q1
\v 14 “\w Mis|strong="H5414"\w* \w pecados|strong="H6588"\w* han sido atados \w como|strong="H5921"\w* un \w yugo|strong="H5923"\w* \w por|strong="H5921"\w* su \w mano|strong="H3027"\w*;  
\q2 han sido entrelazados \w y|strong="H5921"\w* puestos \w sobre|strong="H5921"\w* \w mi|strong="H5921"\w* \w cuello|strong="H6677"\w*. \w Él|strong="H5921"\w* \w me|strong="H5921"\w* quitó \w las|strong="H5921"\w* \w fuerzas|strong="H3581"\w*.  
\q1 \w El|strong="H5921"\w* Señor\f + \fr 1:14 \ft La palabra traducida “Señor” es “Adonai”.\f* \w me|strong="H5921"\w* \w entregó|strong="H5414"\w* \w en|strong="H5921"\w* \w manos|strong="H3027"\w*  
\q2 \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w puedo|strong="H3201"\w* \w levantarme|strong="H6965"\w*.   
\b  
\q1
\v 15 “\w El|strong="H5921"\w* Señor ha rechazado \w a|strong="H3068"\w* \w todos|strong="H3605"\w* mis valientes \w en|strong="H5921"\w* \w medio|strong="H7130"\w* \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\q2 \w Convocó|strong="H7121"\w* \w a|strong="H3068"\w* un ejército \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w para|strong="H5921"\w* aplastar \w a|strong="H3068"\w* mis jóvenes.  
\q2 \w Como|strong="H5921"\w* \w en|strong="H5921"\w* un lagar, \w el|strong="H5921"\w* Señor pisoteó \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w virgen|strong="H1330"\w* \w hija|strong="H1323"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\b  
\q1
\v 16 “\w Por|strong="H5921"\w* todo esto \w lloro|strong="H1058"\w*; mis \w ojos|strong="H5869"\w* \w se|strong="H1961"\w* inundan \w de|strong="H4480"\w* lágrimas,  
\q2 \w porque|strong="H3588"\w* \w está|strong="H1961"\w* \w lejos|strong="H7368"\w* \w de|strong="H4480"\w* \w mí|strong="H5921"\w* \w el|strong="H5921"\w* \w consolador|strong="H5162"\w* \w que|strong="H3588"\w* reanimaría \w mi|strong="H5921"\w* \w vida|strong="H5315"\w*.  
\q1 Mis \w hijos|strong="H1121"\w* \w están|strong="H1961"\w* desolados  
\q2 \w porque|strong="H3588"\w* \w el|strong="H5921"\w* enemigo ha vencido”.   
\b  
\q1
\v 17 \w Sión|strong="H6726"\w* \w extiende|strong="H6566"\w* sus \w manos|strong="H3027"\w*, pero nadie la \w consuela|strong="H5162"\w*.  
\q2 Yahvé ha dado órdenes \w contra|strong="H1961"\w* \w Jacob|strong="H3290"\w*; sus vecinos \w son|strong="H1961"\w* ahora sus \w enemigos|strong="H6862"\w*.  
\q2 Jerusalén \w es|strong="H1961"\w* \w para|strong="H1961"\w* \w ellos|strong="H3027"\w* \w como|strong="H1961"\w* algo impuro.   
\b  
\q1
\v 18 “Yahvé \w es|strong="H1931"\w* \w justo|strong="H6662"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w me|strong="H3588"\w* rebelé contra \w su|strong="H1931"\w* \w palabra|strong="H6310"\w*.  
\q1 \w Escuchen|strong="H8085"\w*, \w por|strong="H3588"\w* favor, \w pueblos|strong="H5971"\w* \w todos|strong="H3605"\w*, \w y|strong="H3588"\w* \w vean|strong="H7200"\w* \w mi|strong="H4994"\w* \w dolor|strong="H4341"\w*;  
\q2 mis \w vírgenes|strong="H1330"\w* \w y|strong="H3588"\w* mis jóvenes \w se|strong="H1931"\w* \w fueron|strong="H1980"\w* al \w cautiverio|strong="H7628"\w*.   
\b  
\q1
\v 19 “\w Llamé|strong="H7121"\w* \w a|strong="H3068"\w* mis amantes, \w pero|strong="H3588"\w* \w me|strong="H3588"\w* engañaron.  
\q1 Mis \w sacerdotes|strong="H3548"\w* \w y|strong="H3588"\w* mis \w ancianos|strong="H2205"\w* murieron \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w*  
\q2 \w mientras|strong="H3588"\w* buscaban comida \w para|strong="H3588"\w* mantenerse \w con|strong="H3588"\w* \w vida|strong="H5315"\w*.   
\b  
\q1
\v 20 “\w Mira|strong="H7200"\w*, Yahvé, \w que|strong="H3588"\w* \w estoy|strong="H6862"\w* angustiada; mi \w corazón|strong="H3820"\w* se conmueve.  
\q1 Mi alma está trastornada \w dentro|strong="H7130"\w* \w de|strong="H3588"\w* mí \w porque|strong="H3588"\w* fui muy rebelde.  
\q2 \w Afuera|strong="H2351"\w*, \w la|strong="H3588"\w* \w espada|strong="H2719"\w* quita \w la|strong="H3588"\w* vida; \w adentro|strong="H1004"\w*, hay olor \w a|strong="H3068"\w* \w muerte|strong="H4194"\w*.   
\b  
\q1
\v 21 “Han \w oído|strong="H8085"\w* \w que|strong="H3588"\w* suspiro, \w pero|strong="H3588"\w* \w no|strong="H6213"\w* \w hay|strong="H1961"\w* \w quien|strong="H3605"\w* \w me|strong="H3588"\w* consuele.  
\q1 \w Todos|strong="H3605"\w* mis enemigos supieron \w de|strong="H3588"\w* \w mi|strong="H1961"\w* \w mal|strong="H7451"\w* \w y|strong="H3588"\w* \w se|strong="H1961"\w* alegran \w de|strong="H3588"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w hiciste|strong="H6213"\w*.  
\q2 ¡Trae ya \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w que|strong="H3588"\w* anunciaste \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w ellos|strong="H3605"\w* \w estén|strong="H1961"\w* \w como|strong="H3588"\w* \w yo|strong="H3588"\w*!   
\b  
\q1
\v 22 “\w Que|strong="H3588"\w* llegue \w ante|strong="H6440"\w* \w ti|strong="H5921"\w* \w toda|strong="H3605"\w* \w su|strong="H3588"\w* \w maldad|strong="H7451"\w*.  
\q2 Haz \w con|strong="H5921"\w* \w ellos|strong="H5921"\w* \w lo|strong="H5921"\w* \w mismo|strong="H3605"\w* \w que|strong="H3588"\w* hiciste conmigo \w por|strong="H5921"\w* \w todos|strong="H3605"\w* mis \w pecados|strong="H6588"\w*;  
\q1 \w porque|strong="H3588"\w* \w son|strong="H3588"\w* \w muchos|strong="H7227"\w* mis gemidos \w y|strong="H3588"\w* \w mi|strong="H5921"\w* \w corazón|strong="H3820"\w* \w desfallece|strong="H1742"\w*”.   
\c 2  
\p
\v 1 ¡\w Cómo|strong="H7272"\w* \w ha|strong="H3808"\w* oscurecido el Señor con una nube \w a|strong="H3068"\w* la \w hija|strong="H1323"\w* de \w Sión|strong="H6726"\w* en su furor!  
\q2 \w Derribó|strong="H7993"\w* del \w cielo|strong="H8064"\w* \w a|strong="H3068"\w* la tierra la hermosura de \w Israel|strong="H3478"\w*,  
\q2 y \w no|strong="H3808"\w* \w se|strong="H3808"\w* acordó del banquillo de sus \w pies|strong="H7272"\w* en el \w día|strong="H3117"\w* de su ira.   
\b  
\q1
\v 2 \w El|strong="H3605"\w* Señor \w destruyó|strong="H1104"\w* \w todas|strong="H3605"\w* las viviendas \w de|strong="H8269"\w* \w Jacob|strong="H3290"\w*  
\q2 \w sin|strong="H3808"\w* tener compasión.  
\q1 Derribó en su furor las fortalezas \w de|strong="H8269"\w* \w la|strong="H3605"\w* \w hija|strong="H1323"\w* \w de|strong="H8269"\w* \w Judá|strong="H3063"\w*;  
\q2 las \w echó|strong="H5060"\w* por tierra.  
\q2 Humilló al \w reino|strong="H4467"\w* y \w a|strong="H3068"\w* sus \w príncipes|strong="H8269"\w*.   
\b  
\q1
\v 3 Destrozó con \w el|strong="H3605"\w* ardor \w de|strong="H6440"\w* su ira \w todo|strong="H3605"\w* \w el|strong="H3605"\w* poder \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*.  
\q2 Retiró su mano \w derecha|strong="H3225"\w* frente al enemigo.  
\q1 Incendió \w a|strong="H3068"\w* \w Jacob|strong="H3290"\w* como un fuego \w ardiente|strong="H1197"\w*  
\q2 \w que|strong="H3605"\w* devora \w todo|strong="H3605"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*.   
\b  
\q1
\v 4 Tensó su \w arco|strong="H7198"\w* como un \w enemigo|strong="H6862"\w*;  
\q2 preparó su mano \w derecha|strong="H3225"\w* como un adversario.  
\q1 \w Mató|strong="H2026"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H1869"\w* era agradable \w a|strong="H3068"\w* \w la|strong="H3605"\w* vista;  
\q2 en \w la|strong="H3605"\w* tienda \w de|strong="H5869"\w* \w la|strong="H3605"\w* \w hija|strong="H1323"\w* \w de|strong="H5869"\w* \w Sión|strong="H6726"\w* \w derramó|strong="H8210"\w* su \w enojo|strong="H2534"\w* como fuego.   
\b  
\q1
\v 5 \w El|strong="H3605"\w* Señor \w se|strong="H1961"\w* portó \w como|strong="H1961"\w* un enemigo;  
\q2 \w destruyó|strong="H1104"\w* \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*.  
\q1 Derrumbó \w todos|strong="H3605"\w* sus palacios  
\q2 y dejó en ruinas sus fortalezas.  
\q2 \w Multiplicó|strong="H7235"\w* en \w la|strong="H3605"\w* \w hija|strong="H1323"\w* de \w Judá|strong="H3063"\w* \w el|strong="H3605"\w* luto y \w el|strong="H3605"\w* lamento.   
\b  
\q1
\v 6 Arrancó con violencia su santuario  
\q2 como si fuera un \w huerto|strong="H1588"\w*.  
\q1 \w Destruyó|strong="H7843"\w* su lugar \w de|strong="H7911"\w* reunión.  
