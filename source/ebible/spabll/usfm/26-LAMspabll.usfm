\q2 \w por|strong="H6440"\w* el calor febril del \w hambre|strong="H7458"\w*.   
\q1
\v 11 \w Violaron|strong="H6031"\w* \w a|strong="H3068"\w* las mujeres en \w Sión|strong="H6726"\w*,  
\q2 y \w a|strong="H3068"\w* las jóvenes en las \w ciudades|strong="H5892"\w* de \w Judá|strong="H3063"\w*.   
\q1
\v 12 \w Colgaron|strong="H8518"\w* \w a|strong="H3068"\w* los \w príncipes|strong="H8269"\w* \w de|strong="H6440"\w* las \w manos|strong="H3027"\w*;  
\q2 \w no|strong="H3808"\w* tuvieron respeto \w por|strong="H6440"\w* los \w ancianos|strong="H2205"\w*.   
\q1
\v 13 \w A|strong="H3068"\w* los jóvenes los pusieron \w a|strong="H3068"\w* moler trigo,  
\q2 y los \w niños|strong="H5288"\w* se caían bajo las cargas de \w leña|strong="H6086"\w*.   
\q1
\v 14 Los \w ancianos|strong="H2205"\w* ya no se reúnen \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w* de la ciudad,  
\q2 y los jóvenes dejaron de cantar.   
\q1
\v 15 La alegría se fue de nuestro \w corazón|strong="H3820"\w*;  
\q2 nuestro baile se cambió por luto.   
\q1
\v 16 Se nos \w cayó|strong="H5307"\w* \w la|strong="H3588"\w* \w corona|strong="H5850"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*.  
\q2 ¡Pobres \w de|strong="H3588"\w* nosotros, \w porque|strong="H3588"\w* \w pecamos|strong="H2398"\w*!   
\q1
\v 17 \w Por|strong="H5921"\w* eso nuestro \w corazón|strong="H3820"\w* \w está|strong="H2088"\w* enfermo,  
\q2 \w por|strong="H5921"\w* eso \w se|strong="H1961"\w* \w nos|strong="H5921"\w* nubla \w la|strong="H5921"\w* vista:   
\q1
\v 18 \w porque|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w* \w está|strong="H5921"\w* desierto,  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w él|strong="H5921"\w* \w andan|strong="H1980"\w* \w los|strong="H5921"\w* zorros.   
\b  
\q1
\v 19 Pero tú, Yahvé, reinas para \w siempre|strong="H5769"\w*;  
\q2 tu \w trono|strong="H3678"\w* \w permanece|strong="H3427"\w* de \w generación|strong="H1755"\w* en \w generación|strong="H1755"\w*.   
\q1
\v 20 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* vas \w a|strong="H3068"\w* olvidarnos para siempre?  
\q2 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* \w nos|strong="H4100"\w* abandonas \w por|strong="H4100"\w* tanto \w tiempo|strong="H3117"\w*?   
\q1
