\c 107  
\ms1 LIBRO 5  
\q1
\v 1 ¡Den gracias \w a|strong="H3068"\w* Yahvé,\f + \fr 107:1 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* \w porque|strong="H3588"\w* \w él|strong="H3588"\w* \w es|strong="H3588"\w* \w bueno|strong="H2896"\w*;  
