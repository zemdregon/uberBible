\q1
\v 16 \w Pero|strong="H3588"\w* \w en|strong="H5921"\w* \w cuanto|strong="H3588"\w* \w a|strong="H3068"\w* \w mí|strong="H5921"\w*, \w yo|strong="H3588"\w* clamaré \w a|strong="H3068"\w* Dios.  
\q2 \w Y|strong="H3068"\w* Yahvé \w me|strong="H5921"\w* salvará.   
\q1
