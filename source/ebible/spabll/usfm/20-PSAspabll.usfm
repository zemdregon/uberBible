\q1
\v 43 \w Me|strong="H5921"\w* libraste \w de|strong="H5921"\w* \w los|strong="H5921"\w* pleitos \w de|strong="H5921"\w* \w mi|strong="H5921"\w* pueblo;  
\q2 \w me|strong="H5921"\w* pusiste \w como|strong="H5921"\w* jefe \w de|strong="H5921"\w* \w las|strong="H5921"\w* naciones.  
