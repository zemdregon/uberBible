\v 37 Su \w corazón|strong="H3820"\w* \w no|strong="H3808"\w* era leal \w a|strong="H3068"\w* \w él|strong="H5973"\w*,  
\q2 \w ni|strong="H3808"\w* fueron fieles \w a|strong="H3068"\w* su \w pacto|strong="H1285"\w*.   
\q1
\v 38 \w Sin|strong="H3808"\w* embargo, \w él|strong="H1931"\w* \w fue|strong="H1931"\w* compasivo; les perdonó \w su|strong="H1931"\w* \w maldad|strong="H5771"\w* y \w no|strong="H3808"\w* \w los|strong="H3605"\w* \w destruyó|strong="H7843"\w*.  
\q2 \w Muchas|strong="H7235"\w* veces contuvo \w su|strong="H1931"\w* \w enojo|strong="H2534"\w*,  
\q2 y \w no|strong="H3808"\w* dejó \w que|strong="H1931"\w* \w toda|strong="H3605"\w* \w su|strong="H1931"\w* \w ira|strong="H2534"\w* estallara.   
\q1
\v 39 \w Se|strong="H1992"\w* acordó \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w eran|strong="H3808"\w* simples seres mortales,  
\q2 un \w viento|strong="H7307"\w* \w que|strong="H3588"\w* pasa \w y|strong="H3588"\w* ya \w no|strong="H3808"\w* \w vuelve|strong="H7725"\w*.   
\q1
\v 40 ¡\w Cuántas|strong="H4100"\w* veces \w se|strong="H4100"\w* rebelaron contra él en el \w desierto|strong="H4057"\w*,  
\q2 y \w lo|strong="H4100"\w* entristecieron en aquellos lugares áridos!   
\q1
\v 41 Una y otra vez ponían \w a|strong="H3068"\w* Dios \w a|strong="H3068"\w* \w prueba|strong="H5254"\w*,  
\q2 y provocaban al \w Santo|strong="H6918"\w* de \w Israel|strong="H3478"\w*.   
\q1
\v 42 \w No|strong="H3808"\w* \w se|strong="H4480"\w* acordaron \w de|strong="H4480"\w* su gran \w poder|strong="H3027"\w*,  
\q2 \w ni|strong="H3808"\w* \w del|strong="H4480"\w* \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* los rescató \w del|strong="H4480"\w* \w enemigo|strong="H6862"\w*;   
\q1
\v 43 de cómo mostró sus señales en \w Egipto|strong="H4714"\w*,  
\q2 y sus \w maravillas|strong="H4159"\w* en la región de Zoán.   
\q1
\v 44 Convirtió en \w sangre|strong="H1818"\w* sus \w ríos|strong="H2975"\w*  
\q2 y sus \w arroyos|strong="H2975"\w*, para que \w no|strong="H1077"\w* pudieran \w beber|strong="H8354"\w*.   
\q1
\v 45 \w Envió|strong="H7971"\w* contra ellos enjambres de moscas que se los comían vivos,  
\q2 y \w ranas|strong="H6854"\w* que todo lo destruían.   
\q1
\v 46 Le \w entregó|strong="H5414"\w* sus cosechas \w a|strong="H3068"\w* los saltamontes,  
\q2 y el fruto \w de|strong="H5414"\w* su \w trabajo|strong="H3018"\w* \w a|strong="H3068"\w* las langostas.   
\q1
\v 47 \w Destruyó|strong="H2026"\w* sus viñedos con \w granizo|strong="H1259"\w*,  
\q2 y sus higueras con fuertes heladas.   
\q1
\v 48 \w Entregó|strong="H5462"\w* también su \w ganado|strong="H4735"\w* al \w granizo|strong="H1259"\w*,  
\q2 y sus rebaños \w a|strong="H3068"\w* la caída de los rayos.   
