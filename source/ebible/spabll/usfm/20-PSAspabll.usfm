\q2 ¡Alábenlo en su majestuoso firmamento!   
\q1
\v 2 ¡Alábenlo por sus hechos poderosos!  
\q2 ¡Alábenlo por su inmensa \w grandeza|strong="H1433"\w*!   
\q1
\v 3 ¡Alábenlo al son \w de|strong="H5035"\w* la \w trompeta|strong="H7782"\w*!  
\q2 ¡Alábenlo con el \w arpa|strong="H3658"\w* y la lira!   
\q1
\v 4 ¡Alábenlo con panderetas y danzas!  
\q2 ¡Alábenlo con instrumentos de cuerda y flautas!   
\q1
\v 5 ¡Alábenlo con platillos sonoros!  
\q2 ¡Alábenlo con platillos \w resonantes|strong="H8088"\w*!   
\q1
\v 6 ¡\w Que|strong="H3605"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* respira \w alabe|strong="H1984"\w* \w a|strong="H3068"\w* \w Yah|strong="H3068"\w*!  
\q2 ¡Alabado sea \w Yah|strong="H3068"\w*!   