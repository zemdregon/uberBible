\v 52 Pero \w a|strong="H3068"\w* su \w pueblo|strong="H5971"\w* lo \w sacó|strong="H5090"\w* como \w a|strong="H3068"\w* un \w rebaño|strong="H6629"\w*;  
\q2 los guió por el \w desierto|strong="H4057"\w* como \w a|strong="H3068"\w* \w ovejas|strong="H6629"\w*.   
\q1
\v 53 Los guió \w a|strong="H3068"\w* salvo, para \w que|strong="H3808"\w* \w no|strong="H3808"\w* tuvieran \w miedo|strong="H6342"\w*,  
\q2 mientras \w que|strong="H3808"\w* el \w mar|strong="H3220"\w* \w cubrió|strong="H3680"\w* \w a|strong="H3068"\w* sus enemigos.   
\q1
\v 54 Los llevó \w hasta|strong="H2088"\w* \w la|strong="H1366"\w* frontera de su tierra \w santa|strong="H6944"\w*,  
\q2 \w a|strong="H3068"\w* \w esta|strong="H2088"\w* montaña \w que|strong="H2088"\w* conquistó con su propia mano.   
\q1
\v 55 Expulsó \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* que estaban \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellos,  
