\id SNG  
\h CANTARES 
\toc3 Cantares 
\toc1 CANTAR DE LOS CANTARES DE SALOMÓN 
\toc2 CANTARES 
\mt1 Cantar de los cantares  
\mt2 de Salomón  
\c 1  
\p
\v 1 Cantar de los Cantares de \w Salomón|strong="H8010"\w*.   
\sp Amado  
\q1
\v 2 ¡\w Que|strong="H3588"\w* \w me|strong="H3588"\w* bese \w con|strong="H3588"\w* \w los|strong="H3588"\w* besos \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w boca|strong="H6310"\w*!  
\q2 \w Porque|strong="H3588"\w* tus caricias \w son|strong="H3588"\w* \w mejores|strong="H2896"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w vino|strong="H3196"\w*.   
\q1
\v 3 ¡\w Qué|strong="H5921"\w* agradable es \w la|strong="H5921"\w* fragancia \w de|strong="H5921"\w* tus perfumes!  
\q2 Tu \w nombre|strong="H8034"\w* es \w como|strong="H5921"\w* perfume \w derramado|strong="H7324"\w*;  
\q2 ¡\w por|strong="H5921"\w* \w eso|strong="H3651"\w* \w las|strong="H5921"\w* jóvenes \w te|strong="H5921"\w* aman!   
\q1
\v 4 ¡\w Llévame|strong="H4900"\w* contigo!  
\q2 ¡Démonos prisa!  
\q2 El \w rey|strong="H4428"\w* me ha llevado \w a|strong="H3068"\w* sus habitaciones.  
\sp Amigos  
\q1 Nos \w alegraremos|strong="H8055"\w* y nos regocijaremos contigo;  
\q2 celebraremos tus caricias más que el \w vino|strong="H3196"\w*.  
\sp Amado  
\q1 ¡Con cuánta razón te aman!   
\q1
\v 5 Soy \w morena|strong="H7838"\w*, pero \w hermosa|strong="H5000"\w*,  
\q2 ustedes, jóvenes \w de|strong="H3407"\w* Jerusalén;  
\q2 soy como las carpas \w de|strong="H3407"\w* \w Cedar|strong="H6938"\w*,  
\q2 como las \w cortinas|strong="H3407"\w* \w de|strong="H3407"\w* \w Salomón|strong="H8010"\w*.   
\q1
\v 6 \w No|strong="H3808"\w* me miren así por ser morena,  
\q2 \w pues|strong="H7200"\w* \w el|strong="H1121"\w* \w sol|strong="H8121"\w* me bronceó.  
\q1 Mis hermanos \w se|strong="H3808"\w* enojaron conmigo  
\q2 y me \w pusieron|strong="H7760"\w* \w a|strong="H3068"\w* cuidar \w los|strong="H1121"\w* viñedos;  
\q2 ¡y mi propio viñedo \w no|strong="H3808"\w* \w lo|strong="H3808"\w* cuidé!   
\q1
\v 7 Dime, amor \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w*,  
\q2 ¿\w dónde|strong="H5921"\w* llevas \w a|strong="H3068"\w* pastar tu rebaño?  
\q2 ¿\w dónde|strong="H5921"\w* descansas \w al|strong="H5921"\w* mediodía?  
\q2 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* he \w de|strong="H5921"\w* andar \w como|strong="H4100"\w* una vagabunda  
\q2 \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w rebaños|strong="H5739"\w* \w de|strong="H5921"\w* tus amigos?   
\sp Amante  
\q1
\v 8 \w Si|strong="H3808"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sabes|strong="H3045"\w*, tú, \w la|strong="H5921"\w* \w más|strong="H5921"\w* bella \w de|strong="H5921"\w* \w las|strong="H5921"\w* mujeres,  
\q2 sigue \w las|strong="H5921"\w* huellas \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w ovejas|strong="H6629"\w*  
\q2 \w y|strong="H5921"\w* lleva \w a|strong="H3068"\w* pastar tus cabritos \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* carpas \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w pastores|strong="H7462"\w*.   
\b  
\q1
\v 9 Amada mía, yo te comparo  
\q2 con una yegua de los \w carros|strong="H7393"\w* de \w Faraón|strong="H6547"\w*.   
\q1
\v 10 ¡Qué \w hermosas|strong="H4998"\w* lucen tus mejillas con los pendientes,  
\q2 y tu \w cuello|strong="H6677"\w* con los collares!   
\sp Amigos  
\q1
\v 11 \w Te|strong="H5973"\w* \w haremos|strong="H6213"\w* pendientes \w de|strong="H5973"\w* \w oro|strong="H2091"\w*  
\q2 \w con|strong="H5973"\w* incrustaciones \w de|strong="H5973"\w* \w plata|strong="H3701"\w*.   
\sp Amado  
\q1
\v 12 \w Mientras|strong="H5704"\w* el \w rey|strong="H4428"\w* estaba \w a|strong="H3068"\w* la mesa,  
\q2 mi perfume esparció su fragancia.   
\q1
\v 13 Mi \w amado|strong="H1730"\w* es para mí un saquito de \w mirra|strong="H4753"\w*  
\q2 que descansa entre mis \w pechos|strong="H7699"\w*.   
\q1
\v 14 Mi \w amado|strong="H1730"\w* es para mí un racimo de flores de henna  
\q2 de los viñedos de En-gadi.   
\sp Amante  
\q1
\v 15 ¡Qué \w hermosa|strong="H3303"\w* eres, amada \w mía|strong="H3123"\w*!  
\q2 ¡Qué \w hermosa|strong="H3303"\w* eres!  
\q2 ¡Tus \w ojos|strong="H5869"\w* son dos palomas!   
\sp Amado  
\q1
\v 16 ¡Qué \w hermoso|strong="H3303"\w* eres, \w amado|strong="H1730"\w* mío! ¡Eres un encanto!  
\q2 Nuestro lecho es pura hierba fresca.   
\sp Amante  
\q1
\v 17 Las vigas de nuestra \w casa|strong="H1004"\w* son de cedro,  
\q2 y el techo es de abeto.   
\c 2  
\sp Amado  
\q1
\v 1 Yo soy una rosa de \w Sarón|strong="H8289"\w*,  
\q2 un lirio de los \w valles|strong="H6010"\w*.   
\sp Amante  
\q1
\v 2 \w Como|strong="H3651"\w* un lirio entre los espinos,  
\q2 \w así|strong="H3651"\w* es mi amada entre las \w mujeres|strong="H1323"\w*.   
\sp Amado  
\q1
\v 3 \w Como|strong="H3651"\w* un manzano entre \w los|strong="H3427"\w* \w árboles|strong="H6086"\w* del \w bosque|strong="H3293"\w*,  
\q2 \w así|strong="H3651"\w* es mi \w amado|strong="H1730"\w* entre \w los|strong="H3427"\w* \w hombres|strong="H1121"\w*.  
\q1 Me encanta \w sentarme|strong="H3427"\w* bajo su \w sombra|strong="H6738"\w*;  
\q2 ¡\w qué|strong="H1121"\w* \w dulce|strong="H4966"\w* es su \w fruto|strong="H6529"\w* \w a|strong="H3068"\w* mi paladar!   
\q1
\v 4 \w Me|strong="H5921"\w* llevó \w a|strong="H3068"\w* \w la|strong="H5921"\w* sala \w de|strong="H5921"\w* banquetes,  
\q2 \w y|strong="H5921"\w* su bandera \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* es \w el|strong="H5921"\w* amor.   
\q1
\v 5 ¡Denme fuerzas \w con|strong="H3588"\w* pasas,  
\q2 refrésquenme \w con|strong="H3588"\w* manzanas,  
\q2 \w porque|strong="H3588"\w* \w me|strong="H3588"\w* siento enferma \w de|strong="H3588"\w* amor!   
\q1
\v 6 Su brazo izquierdo \w bajo|strong="H8478"\w* mi \w cabeza|strong="H7218"\w*,  
\q2 y su brazo \w derecho|strong="H3225"\w* me abraza.   
\q1
\v 7 Yo les ruego, jóvenes \w de|strong="H5704"\w* Jerusalén,  
\q2 \w por|strong="H5704"\w* las gacelas \w y|strong="H5704"\w* los venados del \w campo|strong="H7704"\w*,  
\q2 \w que|strong="H5704"\w* no desvelen \w ni|strong="H5704"\w* despierten \w al|strong="H5704"\w* amor  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* sea el momento oportuno.   
\b  
\q1
\v 8 ¡Oigo \w la|strong="H5921"\w* \w voz|strong="H6963"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w amado|strong="H1730"\w*!  
\q2 ¡Mírenlo!, \w ya|strong="H2088"\w* viene,  
\q2 \w saltando|strong="H1801"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w*,  
\q2 \w brincando|strong="H7092"\w* \w por|strong="H5921"\w* \w las|strong="H5921"\w* colinas.   
\q1
\v 9 \w Mi|strong="H2009"\w* \w amado|strong="H1730"\w* \w es|strong="H2088"\w* como una gacela \w o|strong="H3068"\w* un venado joven.  
\q2 ¡Mírenlo!, allí \w está|strong="H2088"\w*, tras nuestro muro,  
\q1 \w mirando|strong="H7688"\w* \w por|strong="H4480"\w* las \w ventanas|strong="H2474"\w*,  
\q2 asomándose \w por|strong="H4480"\w* las rejas.   
\b  
\q1
\v 10 \w Mi|strong="H6030"\w* \w amado|strong="H1730"\w* me \w habló|strong="H6030"\w* y me dijo:  
\q2 “\w Levántate|strong="H6965"\w*, amada mía, \w hermosa|strong="H3303"\w* mía, y \w ven|strong="H3212"\w* conmigo.   
\q1
\v 11 ¡\w Mira|strong="H2009"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* invierno ya \w pasó|strong="H5674"\w*!,  
\q2 las \w lluvias|strong="H1653"\w* han cesado \w y|strong="H3588"\w* se han ido.   
\q1
\v 12 \w Ya|strong="H3068"\w* brotan las flores en el campo;  
\q2 ha \w llegado|strong="H5060"\w* el \w tiempo|strong="H6256"\w* \w de|strong="H6256"\w* cantar,  
\q2 y en nuestra tierra se \w escucha|strong="H8085"\w* el arrullo \w de|strong="H6256"\w* la tórtola.   
\q1
\v 13 \w En|strong="H3212"\w* la higuera ya maduran los \w higos|strong="H8384"\w*,  
\q2 y los viñedos \w en|strong="H3212"\w* flor esparcen su fragancia.  
\q1 \w Levántate|strong="H6965"\w*, amada mía, \w hermosa|strong="H3303"\w* mía,  
\q2 ¡\w ven|strong="H3212"\w* conmigo!”.   
\sp Amante  
\q1
\v 14 \w Paloma|strong="H3123"\w* \w mía|strong="H3123"\w*, \w que|strong="H3588"\w* \w te|strong="H3588"\w* escondes \w en|strong="H3588"\w* las grietas \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w roca|strong="H5553"\w*,  
\q2 \w en|strong="H3588"\w* \w los|strong="H3588"\w* rincones \w de|strong="H3588"\w* \w la|strong="H3588"\w* montaña,  
\q2 déjame \w ver|strong="H7200"\w* tu \w rostro|strong="H4758"\w*,  
\q2 déjame \w oír|strong="H8085"\w* tu \w voz|strong="H6963"\w*;  
\q2 \w porque|strong="H3588"\w* tu \w voz|strong="H6963"\w* \w es|strong="H3588"\w* \w dulce|strong="H6156"\w* \w y|strong="H3588"\w* tu \w rostro|strong="H4758"\w* \w es|strong="H3588"\w* hermoso.   
\q1
\v 15 Atrapemos \w a|strong="H3068"\w* las \w zorras|strong="H7776"\w*,  
\q2 \w a|strong="H3068"\w* esas \w zorras|strong="H7776"\w* \w pequeñas|strong="H6996"\w* que arruinan los viñedos,  
\q2 ahora que nuestros viñedos están en flor.   
\sp Amado  
\q1
\v 16 Mi \w amado|strong="H1730"\w* es mío y yo soy suya;  
\q2 él pastorea entre los \w lirios|strong="H7799"\w*.   
\q1
\v 17 \w Antes|strong="H5704"\w* \w de|strong="H5921"\w* \w que|strong="H5921"\w* sople \w la|strong="H5921"\w* brisa \w del|strong="H5921"\w* \w día|strong="H3117"\w* \w y|strong="H5921"\w* huyan \w las|strong="H5921"\w* sombras,  
\q2 ¡\w vuelve|strong="H5437"\w*, \w amado|strong="H1730"\w* \w mío|strong="H5921"\w*!,  
\q2 \w sé|strong="H5921"\w* \w como|strong="H5921"\w* una gacela \w o|strong="H3068"\w* un venado joven \w por|strong="H5921"\w* \w las|strong="H5921"\w* montañas \w de|strong="H5921"\w* Beter.   
\c 3  
\p
\v 1 Todas \w las|strong="H5921"\w* \w noches|strong="H3915"\w*, \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w cama|strong="H4904"\w*, \w busqué|strong="H1245"\w* \w al|strong="H5921"\w* amor \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w*;  
\q2 \w lo|strong="H5921"\w* \w busqué|strong="H1245"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H5921"\w* encontré.   
\q1
\v 2 Me dije: “Me \w levantaré|strong="H6965"\w* \w ahora|strong="H4994"\w* y recorreré la \w ciudad|strong="H5892"\w*;  
\q2 por las \w calles|strong="H7339"\w* y las \w plazas|strong="H7339"\w* \w buscaré|strong="H1245"\w* al \w que|strong="H3808"\w* \w mi|strong="H4994"\w* \w alma|strong="H5315"\w* ama”.  
\q2 \w Lo|strong="H3808"\w* \w busqué|strong="H1245"\w*, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontré.   
\q1
\v 3 Me encontraron los \w centinelas|strong="H8104"\w* que vigilan \w la|strong="H8104"\w* \w ciudad|strong="H5892"\w*, y les pregunté:  
\q2 “¿Han \w visto|strong="H7200"\w* ustedes al que ama \w mi|strong="H5315"\w* \w alma|strong="H5315"\w*?”   
\q1
\v 4 \w En|strong="H5704"\w* cuanto me alejé \w de|strong="H5704"\w* \w ellos|strong="H1992"\w*,  
\q2 encontré \w al|strong="H5704"\w* amor \w de|strong="H5704"\w* \w mi|strong="H5315"\w* \w vida|strong="H5315"\w*.  
\q1 \w Lo|strong="H3808"\w* abracé \w y|strong="H5704"\w* \w no|strong="H3808"\w* \w lo|strong="H3808"\w* solté  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* llevé \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H5704"\w* \w mi|strong="H5315"\w* madre,  
\q2 \w a|strong="H3068"\w* la habitación \w de|strong="H5704"\w* la \w que|strong="H3808"\w* me dio la \w vida|strong="H5315"\w*.   
\b  
\q1
\v 5 Yo les ruego, jóvenes \w de|strong="H5704"\w* Jerusalén,  
\q2 \w por|strong="H5704"\w* las gacelas \w y|strong="H5704"\w* los venados del \w campo|strong="H7704"\w*,  
\q2 \w que|strong="H5704"\w* no desvelen \w ni|strong="H5704"\w* despierten \w al|strong="H5704"\w* amor  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* sea el momento oportuno.   
\b  
\q1
\v 6 ¿\w Quién|strong="H4310"\w* \w es|strong="H2063"\w* esa \w que|strong="H4480"\w* \w sube|strong="H5927"\w* \w del|strong="H4480"\w* \w desierto|strong="H4057"\w* como una columna \w de|strong="H4480"\w* \w humo|strong="H6227"\w*,  
\q2 perfumada \w con|strong="H4480"\w* \w mirra|strong="H4753"\w* \w e|strong="H3068"\w* \w incienso|strong="H3828"\w*  
\q2 y \w con|strong="H4480"\w* \w todas|strong="H3605"\w* las esencias \w de|strong="H4480"\w* \w los|strong="H3605"\w* mercaderes?   
\q1
\v 7 ¡Miren!, es la carroza de \w Salomón|strong="H8010"\w*,  
\q2 escoltada por \w sesenta|strong="H8346"\w* guerreros,  
\q2 de los más \w valientes|strong="H1368"\w* de \w Israel|strong="H3478"\w*.   
\q1
\v 8 \w Todos|strong="H3605"\w* \w ellos|strong="H5921"\w* saben manejar \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w y|strong="H5921"\w* son expertos \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*;  
\q2 \w cada|strong="H3605"\w* uno lleva \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* cintura,  
\q2 listos \w para|strong="H5921"\w* enfrentar \w los|strong="H5921"\w* peligros \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w*.   
\b  
\q1
\v 9 \w El|strong="H6213"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w* se mandó \w hacer|strong="H6213"\w* una carroza  
\q2 con maderas finas del \w Líbano|strong="H3844"\w*.   
\q1
\v 10 \w Hizo|strong="H6213"\w* sus \w columnas|strong="H5982"\w* de \w plata|strong="H3701"\w*,  
\q2 su respaldo de \w oro|strong="H2091"\w* y su asiento de púrpura;  
\q2 su interior fue decorado con amor  
\q2 por las jóvenes de Jerusalén.   
\q1
\v 11 \w Salgan|strong="H3318"\w*, \w mujeres|strong="H1323"\w* de \w Sión|strong="H6726"\w*, y \w vean|strong="H7200"\w* \w al|strong="H4428"\w* \w rey|strong="H4428"\w* \w Salomón|strong="H8010"\w*;  
\q2 lleva la \w corona|strong="H5850"\w* \w que|strong="H3117"\w* su madre le puso el \w día|strong="H3117"\w* de su boda,  
\q2 el \w día|strong="H3117"\w* más feliz de su \w vida|strong="H3117"\w*.   
\c 4  
\sp Amante  
\p
\v 1 ¡\w Qué|strong="H1157"\w* \w hermosa|strong="H3303"\w* eres, amada \w mía|strong="H3123"\w*!  
\q2 ¡\w Qué|strong="H1157"\w* \w hermosa|strong="H3303"\w* eres!  
\q1 Tus \w ojos|strong="H5869"\w*, \w tras|strong="H1157"\w* el velo, son dos palomas;  
\q2 tu \w pelo|strong="H8181"\w* es como un rebaño \w de|strong="H5869"\w* \w cabras|strong="H5795"\w*  
\q2 \w que|strong="H1157"\w* bajan saltando \w por|strong="H1157"\w* los \w montes|strong="H2022"\w* \w de|strong="H5869"\w* \w Galaad|strong="H1568"\w*.   
\q1
\v 2 Tus \w dientes|strong="H8127"\w* son blancos como ovejas recién trasquiladas  
\q2 \w que|strong="H4480"\w* acaban \w de|strong="H4480"\w* salir \w del|strong="H4480"\w* río;  
\q2 \w todas|strong="H3605"\w* tienen su pareja,  
\q2 sin \w que|strong="H4480"\w* falte ni una sola.   
\q1
\v 3 Tus \w labios|strong="H8193"\w* son como un hilo de escarlata;  
\q2 ¡\w qué|strong="H1157"\w* encantadora es tu \w boca|strong="H8193"\w*!  
\q2 Tus mejillas, \w tras|strong="H1157"\w* el velo, parecen cortes de granada.   
\q1
\v 4 Tu \w cuello|strong="H6677"\w* es \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w torre|strong="H4026"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*, diseñada \w para|strong="H5921"\w* armería,  
\q2 \w donde|strong="H5921"\w* cuelgan mil \w escudos|strong="H4043"\w*,  
\q2 \w todos|strong="H3605"\w* \w ellos|strong="H5921"\w* \w escudos|strong="H4043"\w* \w de|strong="H5921"\w* guerreros \w valientes|strong="H1368"\w*.   
\q1
\v 5 Tus \w pechos|strong="H7699"\w* son como \w dos|strong="H8147"\w* gacelas,  
\q2 como crías gemelas  
\q2 que se alimentan entre los \w lirios|strong="H7799"\w*.   
\b  
\q1
\v 6 \w Mientras|strong="H5704"\w* sopla la brisa del \w día|strong="H3117"\w* \w y|strong="H5704"\w* huyan las sombras,  
\q2 me \w iré|strong="H3212"\w* \w al|strong="H5704"\w* \w monte|strong="H2022"\w* \w de|strong="H5704"\w* la \w mirra|strong="H4753"\w*  
\q2 \w y|strong="H5704"\w* \w a|strong="H3068"\w* la colina del \w incienso|strong="H3828"\w*.   
\b  
\q1
\v 7 \w Toda|strong="H3605"\w* tú eres \w hermosa|strong="H3303"\w*, amada mía;  
\q2 ¡no tienes ni un solo defecto!   
\q1
\v 8 Ven conmigo desde el \w Líbano|strong="H3844"\w*, novia mía;  
\q2 ven conmigo desde el \w Líbano|strong="H3844"\w*.  
\q2 Mira desde la \w cumbre|strong="H7218"\w* del Amaná,  
\q2 desde las cimas del \w Senir|strong="H8149"\w* y del \w Hermón|strong="H2768"\w*,  
\q2 desde las cuevas de los leones,  
\q2 desde los montes de los leopardos.   
\b  
\q1
\v 9 Me has cautivado el corazón, hermana mía, novia mía;  
\q2 me has cautivado el corazón con una sola \w de|strong="H5869"\w* tus miradas,  
\q2 con un solo hilo \w de|strong="H5869"\w* tu collar.   
\q1
\v 10 ¡\w Qué|strong="H4100"\w* \w hermoso|strong="H3302"\w* es tu amor, hermana mía, novia mía!  
\q2 Tu amor es mucho \w mejor|strong="H2895"\w* \w que|strong="H4100"\w* \w el|strong="H3605"\w* \w vino|strong="H3196"\w*,  
\q2 y \w la|strong="H3605"\w* fragancia de tus perfumes supera \w a|strong="H3068"\w* \w todas|strong="H3605"\w* las \w especias|strong="H1314"\w*.   
\q1
\v 11 Novia mía, tus \w labios|strong="H8193"\w* destilan \w miel|strong="H1706"\w* pura;  
\q2 \w leche|strong="H2461"\w* \w y|strong="H5317"\w* \w miel|strong="H1706"\w* hay \w bajo|strong="H8478"\w* tu \w lengua|strong="H3956"\w*.  
\q2 El aroma \w de|strong="H8478"\w* tu ropa es \w como|strong="H8478"\w* la fragancia del \w Líbano|strong="H3844"\w*.   
\q1
\v 12 Eres un jardín cercado, hermana mía, novia mía;  
\q2 ¡eres un manantial privado, una \w fuente|strong="H4599"\w* \w sellada|strong="H2856"\w*!   
\q1
\v 13 Tus brotes son un huerto \w de|strong="H5973"\w* \w granadas|strong="H7416"\w*, \w con|strong="H5973"\w* \w frutos|strong="H6529"\w* exquisitos;  
\q2 hay flores \w de|strong="H5973"\w* henna y nardos,   
\q2
\v 14 \w nardo|strong="H5373"\w* y azafrán,  
\q2 \w caña|strong="H7070"\w* \w aromática|strong="H1314"\w* y canela, y \w toda|strong="H3605"\w* clase \w de|strong="H5973"\w* \w árboles|strong="H6086"\w* \w de|strong="H5973"\w* \w incienso|strong="H3828"\w*;  
\q2 hay \w mirra|strong="H4753"\w* y \w áloes|strong="H4753"\w*, y las mejores \w especias|strong="H1314"\w*.   
\q1
\v 15 ¡Eres la \w fuente|strong="H4599"\w* \w de|strong="H4480"\w* los jardines!,  
\q2 un pozo \w de|strong="H4480"\w* \w agua|strong="H4325"\w* \w viva|strong="H2416"\w*,  
\q2 ¡un manantial \w que|strong="H4480"\w* fluye \w desde|strong="H4480"\w* el \w Líbano|strong="H3844"\w*!   
\sp Amado  
\q1
\v 16 ¡\w Despierta|strong="H5782"\w*, viento del \w norte|strong="H6828"\w*! ¡Ven, viento del sur!  
\q2 Soplen en mi jardín para que se esparza su fragancia.  
\q1 ¡Que entre mi \w amado|strong="H1730"\w* en su jardín  
\q2 y disfrute de sus \w frutos|strong="H6529"\w* exquisitos!   
\c 5  
\sp Amante  
\q1
\v 1 He entrado \w en|strong="H5973"\w* mi jardín, hermana mía, novia mía.  
\q2 He recogido mi \w mirra|strong="H4753"\w* y mis fragancias;  
\q2 he comido mi panal y mi \w miel|strong="H1706"\w*,  
\q2 y mi \w vino|strong="H3196"\w* y mi \w leche|strong="H2461"\w* he \w bebido|strong="H8354"\w*.  
\sp Amigos  
\q1 ¡Coman, \w amigos|strong="H7453"\w*!  
\q2 ¡\w Beban|strong="H8354"\w* y embriáguense \w de|strong="H5973"\w* amor, \w amados|strong="H1730"\w*!   
\sp Amado  
\q1
\v 2 Yo \w dormía|strong="H3462"\w*, pero mi \w corazón|strong="H3820"\w* estaba alerta.  
\q2 ¡Es la \w voz|strong="H6963"\w* de mi \w amado|strong="H1730"\w* que llama!:  
\q2 “\w Ábreme|strong="H6605"\w*, hermana \w mía|strong="H3123"\w*, amada \w mía|strong="H3123"\w*, \w paloma|strong="H3123"\w* \w mía|strong="H3123"\w*, mujer \w perfecta|strong="H8535"\w*;  
\q2 pues mi \w cabeza|strong="H7218"\w* está empapada de \w rocío|strong="H2919"\w*,  
\q2 y mi cabello con la humedad de la \w noche|strong="H3915"\w*”.   
\q1
\v 3 \w Ya|strong="H3068"\w* me he quitado la ropa, ¿\w cómo|strong="H7272"\w* volveré \w a|strong="H3068"\w* vestirme?  
\q2 \w Ya|strong="H3068"\w* me he lavado los \w pies|strong="H7272"\w*, ¿\w cómo|strong="H7272"\w* volveré \w a|strong="H3068"\w* ensuciarlos?   
\q1
\v 4 \w Mi|strong="H5921"\w* \w amado|strong="H1730"\w* \w metió|strong="H7971"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* abertura \w del|strong="H4480"\w* pestillo;  
\q2 entonces \w mi|strong="H5921"\w* corazón latió \w con|strong="H5921"\w* fuerza \w por|strong="H5921"\w* \w él|strong="H5921"\w*.   
\q1
\v 5 \w Me|strong="H5921"\w* levanté \w para|strong="H5921"\w* abrirle \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w amado|strong="H1730"\w*;  
\q2 mis \w manos|strong="H3027"\w* goteaban \w mirra|strong="H4753"\w*,  
\q2 \w de|strong="H5921"\w* mis dedos corría \w la|strong="H5921"\w* \w mirra|strong="H4753"\w*  
\q2 \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* manijas \w de|strong="H5921"\w* \w la|strong="H5921"\w* cerradura.   
\q1
\v 6 Le \w abrí|strong="H6605"\w* \w a|strong="H3068"\w* \w mi|strong="H6030"\w* \w amado|strong="H1730"\w*,  
\q2 pero \w mi|strong="H6030"\w* \w amado|strong="H1730"\w* ya \w se|strong="H3808"\w* \w había|strong="H4672"\w* ido, ¡ya \w se|strong="H3808"\w* \w había|strong="H4672"\w* marchado!  
\q1 \w Mi|strong="H6030"\w* \w alma|strong="H5315"\w* \w se|strong="H3808"\w* me \w fue|strong="H3808"\w* tras su voz.  
\q2 \w Lo|strong="H3808"\w* \w busqué|strong="H1245"\w* y \w no|strong="H3808"\w* \w lo|strong="H3808"\w* encontré;  
\q2 \w lo|strong="H3808"\w* \w llamé|strong="H7121"\w* y \w no|strong="H3808"\w* me \w respondió|strong="H6030"\w*.   
\q1
\v 7 \w Me|strong="H5921"\w* encontraron \w los|strong="H5921"\w* \w centinelas|strong="H8104"\w* \w que|strong="H5921"\w* rondan \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*;  
\q2 \w me|strong="H5921"\w* golpearon \w y|strong="H5921"\w* \w me|strong="H5921"\w* lastimaron;  
\q2 ¡\w los|strong="H5921"\w* guardias \w de|strong="H5921"\w* \w las|strong="H5921"\w* murallas \w me|strong="H5921"\w* quitaron \w el|strong="H5921"\w* manto!   
\b  
\q1
\v 8 Yo les ruego, jóvenes de Jerusalén,  
\q2 \w que|strong="H4100"\w* si encuentran \w a|strong="H3068"\w* \w mi|strong="H3389"\w* \w amado|strong="H1730"\w*,  
\q2 le digan \w que|strong="H4100"\w* me siento enferma de amor.   
\sp Amigos  
\q1
\v 9 ¿\w Qué|strong="H4100"\w* tiene tu \w amado|strong="H1730"\w* de especial sobre otros \w amados|strong="H1730"\w*,  
\q2 tú, la más bella de las mujeres?  
\q1 ¿\w Qué|strong="H4100"\w* tiene tu \w amado|strong="H1730"\w* de especial sobre otros \w amados|strong="H1730"\w*,  
\q1 para \w que|strong="H4100"\w* \w así|strong="H3602"\w* \w nos|strong="H4100"\w* ruegues?   
\sp Amado  
\q1
\v 10 Mi \w amado|strong="H1730"\w* es apuesto y de piel clara,  
\q2 el más distinguido entre diez \w mil|strong="H7233"\w*.   
\q1
\v 11 Su \w cabeza|strong="H7218"\w* es como el \w oro|strong="H3800"\w* más puro;  
\q2 su cabello es crespo y \w negro|strong="H7838"\w* como el \w cuervo|strong="H6158"\w*.   
\q1
\v 12 Sus \w ojos|strong="H5869"\w* parecen palomas \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* arroyos,  
\q2 bañadas \w en|strong="H5921"\w* \w leche|strong="H2461"\w*, posadas \w como|strong="H5921"\w* joyas.   
\q1
\v 13 Sus mejillas son como un huerto de \w especias|strong="H1314"\w*, como montes de perfumes;  
\q2 sus \w labios|strong="H8193"\w* son \w lirios|strong="H7799"\w* que destilan \w mirra|strong="H4753"\w* líquida.   
\q1
\v 14 Sus \w manos|strong="H3027"\w* son \w anillos|strong="H1550"\w* de \w oro|strong="H2091"\w* con incrustaciones de berilo;  
\q2 su cuerpo \w es|strong="H3027"\w* como \w marfil|strong="H8127"\w* pulido decorado con zafiros.   
\q1
\v 15 Sus piernas son \w columnas|strong="H5982"\w* \w de|strong="H5921"\w* mármol \w sobre|strong="H5921"\w* bases \w de|strong="H5921"\w* \w oro|strong="H6337"\w* \w fino|strong="H6337"\w*;  
\q2 su porte es \w como|strong="H5921"\w* \w el|strong="H5921"\w* \w del|strong="H5921"\w* \w Líbano|strong="H3844"\w*, majestuoso \w como|strong="H5921"\w* sus cedros.   
\q1
\v 16 Su boca \w es|strong="H2088"\w* \w la|strong="H3605"\w* dulzura misma;  
\q2 ¡\w él|strong="H3605"\w* \w es|strong="H2088"\w* \w todo|strong="H3605"\w* un encanto!  
\q1 \w Así|strong="H2088"\w* \w es|strong="H2088"\w* \w mi|strong="H3389"\w* \w amado|strong="H1730"\w*, \w así|strong="H2088"\w* \w es|strong="H2088"\w* \w mi|strong="H3389"\w* \w amigo|strong="H7453"\w*,  
\q2 jóvenes de Jerusalén.   
\c 6  
\sp Amigos  
\q1
\v 1 ¿\w A|strong="H3068"\w* dónde se ha ido tu \w amado|strong="H1730"\w*, la \w más|strong="H1245"\w* bella \w de|strong="H5973"\w* las mujeres?  
\q2 ¿\w A|strong="H3068"\w* dónde se \w fue|strong="H1980"\w* tu \w amado|strong="H1730"\w*? ¡\w Iremos|strong="H1980"\w* \w con|strong="H5973"\w* ustedes \w a|strong="H3068"\w* buscarlo!   
\sp Amante  
\q1
\v 2 Mi \w amado|strong="H1730"\w* ha bajado \w a|strong="H3068"\w* su jardín, \w a|strong="H3068"\w* los senderos de los perfumes,  
\q2 para pastorear su rebaño en los jardines y para recoger \w lirios|strong="H7799"\w*.   
\q1
\v 3 Yo soy de mi \w amado|strong="H1730"\w* y mi \w amado|strong="H1730"\w* es mío;  
\q2 él pastorea entre los \w lirios|strong="H7799"\w*.   
\b  
\sp Amado  
\q1
\v 4 Eres \w hermosa|strong="H3303"\w*, amada mía, como Tirsa;  
\q2 tan bella como Jerusalén,  
\q2 majestuosa como un ejército en formación.   
\q1
\v 5 ¡\w Aparta|strong="H5437"\w* \w de|strong="H4480"\w* mí tus \w ojos|strong="H5869"\w*,  
\q2 \w que|strong="H4480"\w* \w me|strong="H4480"\w* han conquistado!  
\q1 Tu \w pelo|strong="H8181"\w* es como un rebaño \w de|strong="H4480"\w* \w cabras|strong="H5795"\w*  
\q2 \w que|strong="H4480"\w* bajan saltando \w por|strong="H4480"\w* \w las|strong="H1992"\w* laderas \w de|strong="H4480"\w* \w Galaad|strong="H1568"\w*.   
\q1
\v 6 Tus \w dientes|strong="H8127"\w* son blancos como \w ovejas|strong="H7353"\w* recién lavadas;  
\q2 \w todas|strong="H3605"\w* tienen su pareja,  
\q2 sin \w que|strong="H4480"\w* falte \w ninguna|strong="H3605"\w* \w de|strong="H4480"\w* ellas.   
\q1
\v 7 Tus mejillas, \w tras|strong="H1157"\w* el velo, parecen cortes de granada.   
\b  
\q1
\v 8 \w Sesenta|strong="H8346"\w* son \w las|strong="H1992"\w* reinas y \w ochenta|strong="H8084"\w* \w las|strong="H1992"\w* \w concubinas|strong="H6370"\w*,  
\q2 y \w las|strong="H1992"\w* jóvenes son incontables;   
\q1
\v 9 pero mi \w paloma|strong="H3123"\w* \w es|strong="H1931"\w* única, ¡mi mujer \w perfecta|strong="H8535"\w*!  
\q2 \w Es|strong="H1931"\w* \w la|strong="H1931"\w* \w hija|strong="H1323"\w* única de \w su|strong="H1931"\w* madre;  
\q2 \w es|strong="H1931"\w* \w la|strong="H1931"\w* favorita de \w quien|strong="H1931"\w* \w le|strong="H1931"\w* dio \w la|strong="H1931"\w* vida.  
\q1 Las jóvenes \w la|strong="H1931"\w* \w ven|strong="H7200"\w* y \w la|strong="H1931"\w* llaman dichosa;  
\q2 las reinas y las \w concubinas|strong="H6370"\w* \w la|strong="H1931"\w* \w ven|strong="H7200"\w* y \w la|strong="H1931"\w* llenan de halagos.   
\b  
\q1
\v 10 ¿\w Quién|strong="H4310"\w* \w es|strong="H2063"\w* \w esta|strong="H2063"\w* \w que|strong="H4310"\w* surge \w como|strong="H3644"\w* \w la|strong="H2063"\w* aurora,  
\q2 \w hermosa|strong="H3303"\w* \w como|strong="H3644"\w* \w la|strong="H2063"\w* luna,  
\q2 radiante \w como|strong="H3644"\w* \w el|strong="H4310"\w* sol,  
\q2 majestuosa \w como|strong="H3644"\w* un ejército en formación?   
\b  
\q1
\v 11 Bajé al \w huerto|strong="H1594"\w* de los nogales  
\q2 para \w ver|strong="H7200"\w* los nuevos brotes del valle,  
\q2 para \w ver|strong="H7200"\w* si ya florecían las \w vides|strong="H1612"\w*  
\q2 y si ya maduraban los granados.   
\q1
\v 12 \w Sin|strong="H3808"\w* \w que|strong="H3808"\w* me diera cuenta,  
\q2 \w mi|strong="H5315"\w* deseo me \w puso|strong="H7760"\w* \w entre|strong="H3808"\w* las carrozas \w de|strong="H5971"\w* \w mi|strong="H5315"\w* noble \w pueblo|strong="H5971"\w*.   
\sp Amigos  
\q1
\v 13 ¡Vuelve, vuelve, sulamita!  
\q2 ¡Vuelve, vuelve, que queremos verte!  
\sp Amado  
\q1 ¿Por qué quieren ver \w a|strong="H3068"\w* la sulamita  
\q2 como en las danzas de Mahanaim?   
\c 7  
\p
\v 1 ¡\w Qué|strong="H4100"\w* bellos \w se|strong="H4100"\w* \w ven|strong="H2372"\w* tus pies en las sandalias, hija de gente noble!  
\q2 Las curvas de tus muslos son \w como|strong="H4100"\w* joyas,  
\q2 moldeadas \w por|strong="H4100"\w* las manos de un gran artista.   
\q1
\v 2 Tu ombligo \w es|strong="H3027"\w* \w una|strong="H6471"\w* copa redonda  
\q2 donde nunca falta el buen \w vino|strong="H4100"\w*.  
\q1 Tu cintura \w es|strong="H3027"\w* \w como|strong="H4100"\w* un manojo de trigo  
\q2 rodeado de lirios.   
\q1
\v 3 Tus pechos son como dos gacelas,  
\q2 como crías gemelas.   
\q1
\v 4 Tu cuello es blanco y firme como torre de marfil.  
\q2 Tus ojos son como los estanques de Hesbón, junto \w a|strong="H3068"\w* la puerta de Bat-rabim.  
\q2 Tu nariz es tan perfilada como la torre del Líbano que mira hacia Damasco.   
\q1
\v 5 Tu cabeza \w se|strong="H5921"\w* yergue \w como|strong="H5921"\w* \w el|strong="H5921"\w* monte Carmelo.  
\q2 Tu cabellera es \w como|strong="H5921"\w* \w la|strong="H5921"\w* púrpura;  
\q2 ¡\w el|strong="H5921"\w* rey queda cautivado \w entre|strong="H5921"\w* tus rizos!   
\q1
\v 6 ¡\w Qué|strong="H5921"\w* hermosa \w y|strong="H5921"\w* encantadora eres,  
\q2 amor \w mío|strong="H5921"\w*, llena \w de|strong="H5921"\w* delicias!   
\q1
\v 7 Tu talle es \w como|strong="H4100"\w* el de una palmera,  
\q2 y tus pechos parecen sus racimos.   
\q1
\v 8 Me dije: “Subiré \w a|strong="H3068"\w* \w la|strong="H2063"\w* palmera  
\q2 y me agarraré de sus ramas”.  
\q1 ¡Que sean tus \w pechos|strong="H7699"\w* como racimos de uvas,  
\q2 y el aroma de tu aliento como el de las manzanas!   
\q1
\v 9 Tu boca \w es|strong="H1961"\w* \w como|strong="H1961"\w* el mejor \w vino|strong="H1961"\w*,  
\q2 \w que|strong="H4994"\w* fluye suavemente hacia \w mi|strong="H1961"\w* amado  
\q2 y \w se|strong="H1961"\w* desliza por \w los|strong="H1961"\w* labios de \w los|strong="H1961"\w* \w que|strong="H4994"\w* duermen.   
\sp Amada  
\q1
\v 10 Yo soy de mi \w amado|strong="H1730"\w*,  
\q2 y él me busca con pasión.   
\q1
\v 11 ¡Ven, \w amado|strong="H1730"\w* \w mío|strong="H5921"\w*, salgamos \w al|strong="H5921"\w* campo!  
\q2 Pasemos \w la|strong="H5921"\w* noche \w en|strong="H5921"\w* \w las|strong="H5921"\w* aldeas.   
\q1
\v 12 \w Vayamos|strong="H3212"\w* temprano \w a|strong="H3068"\w* los viñedos  
\q2 para ver si las vides ya brotaron,  
\q2 si ya se abrieron las flores  
\q2 y si ya florecieron los granados.  
\q2 ¡Allí te entregaré todo mi amor!   
\q1
\v 13 \w Ya|strong="H3068"\w* se siente el aroma \w de|strong="H5414"\w* las mandrágoras;  
\q2 \w a|strong="H3068"\w* nuestra puerta hay toda clase \w de|strong="H5414"\w* frutas exquisitas, nuevas y viejas,  
\q2 que he guardado \w para|strong="H5414"\w* ti, \w amado|strong="H1730"\w* mío.   
\c 8  
\p
\v 1 ¡\w Ojalá|strong="H4310"\w* fueras mi hermano, \w el|strong="H4310"\w* \w que|strong="H4310"\w* mamó \w de|strong="H5414"\w* los \w pechos|strong="H7699"\w* \w de|strong="H5414"\w* mi madre!  
\q2 \w Si|strong="H1571"\w* te encontrara en \w la|strong="H1571"\w* calle, te besaría, \w y|strong="H1571"\w* \w nadie|strong="H3808"\w* \w me|strong="H4310"\w* \w lo|strong="H3808"\w* reprocharía.   
\q1
\v 2 Te tomaría de la mano y te llevaría \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de mi madre, y ella me enseñaría.  
\q2 Te daría \w a|strong="H3068"\w* \w beber|strong="H8248"\w* \w vino|strong="H3196"\w* con especias y el néctar de mis \w granadas|strong="H7416"\w*.   
\q1
\v 3 Tu brazo izquierdo estaría \w bajo|strong="H8478"\w* mi \w cabeza|strong="H7218"\w* y tu \w derecha|strong="H3225"\w* me abrazaría.   
\b  
\q1
\v 4 Yo les ruego, jóvenes \w de|strong="H5704"\w* Jerusalén, \w que|strong="H4100"\w* \w no|strong="H4100"\w* desvelen \w ni|strong="H5704"\w* despierten \w al|strong="H5704"\w* amor \w hasta|strong="H5704"\w* \w que|strong="H4100"\w* sea el momento oportuno.   
\sp Amigos  
\q1
\v 5 ¿\w Quién|strong="H4310"\w* \w es|strong="H2063"\w* esa \w que|strong="H4480"\w* \w sube|strong="H5927"\w* \w del|strong="H4480"\w* \w desierto|strong="H4057"\w*, apoyada \w en|strong="H5921"\w* \w el|strong="H5921"\w* brazo \w de|strong="H4480"\w* su \w amado|strong="H1730"\w*?  
\b  
\sp Amado  
\q1 \w Bajo|strong="H8478"\w* \w el|strong="H5921"\w* manzano \w te|strong="H5921"\w* \w desperté|strong="H5782"\w*; \w allí|strong="H8033"\w* tu madre tuvo \w los|strong="H5921"\w* \w dolores|strong="H2254"\w* \w de|strong="H4480"\w* parto, \w allí|strong="H8033"\w* \w te|strong="H5921"\w* dio \w a|strong="H3068"\w* luz \w la|strong="H5921"\w* \w que|strong="H4480"\w* \w te|strong="H5921"\w* \w engendró|strong="H3205"\w*.   
\b  
\q1
\v 6 Grábame \w como|strong="H3588"\w* un sello \w en|strong="H5921"\w* tu \w corazón|strong="H3820"\w*, llévame \w como|strong="H3588"\w* una marca \w en|strong="H5921"\w* tu \w brazo|strong="H2220"\w*;  
\q2 \w porque|strong="H3588"\w* \w el|strong="H5921"\w* amor \w es|strong="H3588"\w* tan \w fuerte|strong="H5794"\w* \w como|strong="H3588"\w* \w la|strong="H5921"\w* \w muerte|strong="H4194"\w*, \w y|strong="H3588"\w* \w los|strong="H5921"\w* celos tan crueles \w como|strong="H3588"\w* \w el|strong="H5921"\w* Seol. \f + \fr 8:6 \ft El Seol es el lugar de los muertos. \f*  
\q2 Sus centellas \w son|strong="H3588"\w* centellas \w de|strong="H5921"\w* fuego, ¡\w es|strong="H3588"\w* \w la|strong="H5921"\w* llama misma \w de|strong="H5921"\w* Yahvé! \f + \fr 8:6 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f*   
\q1
\v 7 Las \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w* \w no|strong="H3808"\w* \w pueden|strong="H3201"\w* apagar \w el|strong="H3605"\w* amor, \w ni|strong="H3808"\w* \w pueden|strong="H3201"\w* ahogarlo \w los|strong="H3605"\w* ríos.  
\q2 \w Si|strong="H3808"\w* alguien \w diera|strong="H5414"\w* \w todas|strong="H3605"\w* las \w riquezas|strong="H1952"\w* \w de|strong="H5414"\w* su \w casa|strong="H1004"\w* \w por|strong="H5414"\w* \w el|strong="H3605"\w* amor, solo recibiría \w el|strong="H3605"\w* desprecio \w de|strong="H5414"\w* \w los|strong="H3605"\w* demás.   
\sp Hermanos  
\q1
\v 8 Tenemos una hermana \w pequeña|strong="H6996"\w* \w que|strong="H4100"\w* todavía \w no|strong="H6213"\w* tiene \w pechos|strong="H7699"\w*;  
\q2 ¿\w qué|strong="H4100"\w* \w haremos|strong="H6213"\w* \w por|strong="H4100"\w* nuestra hermana \w el|strong="H6213"\w* \w día|strong="H3117"\w* \w que|strong="H4100"\w* vengan \w a|strong="H3068"\w* pedir su mano?   
\b  
\q1
\v 9 \w Si|strong="H1931"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* \w como|strong="H5921"\w* un \w muro|strong="H2346"\w*, construiremos \w sobre|strong="H5921"\w* \w ella|strong="H1931"\w* una torre \w de|strong="H5921"\w* \w plata|strong="H3701"\w*;  
\q2 \w si|strong="H1931"\w* \w ella|strong="H1931"\w* \w es|strong="H1931"\w* \w como|strong="H5921"\w* una \w puerta|strong="H1817"\w*, \w la|strong="H1931"\w* reforzaremos \w con|strong="H5921"\w* \w tablas|strong="H3871"\w* \w de|strong="H5921"\w* cedro.   
\sp Amada  
\q1
\v 10 Yo \w soy|strong="H1961"\w* un \w muro|strong="H2346"\w*, y mis \w pechos|strong="H7699"\w* \w son|strong="H1961"\w* \w como|strong="H1961"\w* \w torres|strong="H4026"\w*;  
\q2 por eso, \w a|strong="H3068"\w* sus \w ojos|strong="H5869"\w*, \w soy|strong="H1961"\w* quien ha encontrado la felicidad.   
\q1
\v 11 \w Salomón|strong="H8010"\w* \w tenía|strong="H1961"\w* un viñedo en Baal-hamón; lo \w dejó|strong="H5414"\w* al cuidado \w de|strong="H5414"\w* unos vigilantes,  
\q2 y cada uno debía entregar mil siclos \f + \fr 8:11 \ft Un siclo equivale a unos 10 gramos o a unas 0,35 onzas, por lo que 1000 siclos equivalen a unos 10 kilogramos o a unas 22 libras.\f* \w de|strong="H5414"\w* \w plata|strong="H3701"\w* \w por|strong="H5414"\w* su cosecha.   
\q1
\v 12 Mi propio viñedo está bajo mi cuidado;  
\q2 las \w mil|strong="H3967"\w* monedas son para ti, \w Salomón|strong="H8010"\w*, y \w doscientas|strong="H3967"\w* para los que cuidan la cosecha.   
\sp Amante  
\q1
\v 13 Tú, que \w habitas|strong="H3427"\w* en \w los|strong="H3427"\w* jardines, tus amigos esperan \w oír|strong="H8085"\w* tu \w voz|strong="H6963"\w*; ¡déjame oírla \w a|strong="H3068"\w* mí!   
\sp Amado  
\q1
\v 14 ¡Apresúrate, \w amado|strong="H1730"\w* \w mío|strong="H5921"\w*! ¡\w Sé|strong="H5921"\w* \w como|strong="H5921"\w* una gacela \w o|strong="H3068"\w* un venado joven \w por|strong="H5921"\w* \w las|strong="H5921"\w* montañas \w de|strong="H5921"\w* \w los|strong="H5921"\w* perfumes!   