\mt2 La carta del Apóstol San Pablo a  
\mt1 Filemón  
\c 1  
\p
\v 1 \w Pablo|strong="G3972"\w*, \w prisionero|strong="G1198"\w* \w de|strong="G3588"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*, \w y|strong="G2532"\w* \w el|strong="G3588"\w* hermano \w Timoteo|strong="G5095"\w*, a \w Filemón|strong="G5371"\w*, \w nuestro|strong="G2249"\w* amado compañero \w de|strong="G3588"\w* trabajo,  
\v 2 \w a|strong="G2596"\w* \w la|strong="G3588"\w* amada hermana Apia, \w a|strong="G2596"\w* Arquipo, \w nuestro|strong="G2249"\w* \w compañero|strong="G4961"\w* \w de|strong="G2596"\w* lucha, \w y|strong="G2532"\w* \w a|strong="G2596"\w* \w la|strong="G3588"\w* \w iglesia|strong="G1577"\w* \w que|strong="G3588"\w* \w se|strong="G2532"\w* reúne \w en|strong="G2596"\w* \w tu|strong="G4771"\w* \w casa|strong="G3624"\w*:  
\v 3 \w Gracia|strong="G5485"\w* \w y|strong="G2532"\w* \w paz|strong="G1515"\w* a ustedes de parte de \w Dios|strong="G2316"\w* \w nuestro|strong="G2249"\w* \w Padre|strong="G3962"\w* \w y|strong="G2532"\w* del \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w*.   
\p
\v 4 \w Siempre|strong="G3842"\w* doy \w gracias|strong="G2168"\w* \w a|strong="G1909"\w* \w mi|strong="G3588"\w* \w Dios|strong="G2316"\w* \w al|strong="G3588"\w* recordarte \w en|strong="G1909"\w* mis \w oraciones|strong="G4335"\w*,  
\v 5 \w porque|strong="G2532"\w* oigo \w del|strong="G3588"\w* amor \w y|strong="G2532"\w* \w de|strong="G1519"\w* \w la|strong="G3588"\w* \w fe|strong="G4102"\w* \w que|strong="G3588"\w* \w tienes|strong="G2192"\w* \w hacia|strong="G4314"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesús|strong="G2424"\w* \w y|strong="G2532"\w* \w hacia|strong="G4314"\w* \w todos|strong="G3956"\w* \w los|strong="G3588"\w* santos.  
\v 6 Oro \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w la|strong="G3588"\w* \w comunión|strong="G2842"\w* \w de|strong="G1722"\w* \w tu|strong="G4771"\w* \w fe|strong="G4102"\w* \w sea|strong="G1096"\w* \w eficaz|strong="G1756"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w conocimiento|strong="G1922"\w* \w de|strong="G1722"\w* \w todo|strong="G3956"\w* \w lo|strong="G3588"\w* bueno \w que|strong="G3588"\w* \w hay|strong="G3588"\w* \w en|strong="G1722"\w* \w nosotros|strong="G2249"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* Jesús.  
\v 7 \w Pues|strong="G1063"\w* \w tenemos|strong="G2192"\w* \w mucha|strong="G4183"\w* \w alegría|strong="G5479"\w* \w y|strong="G2532"\w* \w consuelo|strong="G3874"\w* \w por|strong="G1223"\w* \w tu|strong="G4771"\w* amor, hermano, \w ya|strong="G2532"\w* \w que|strong="G3754"\w* \w los|strong="G3588"\w* corazones \w de|strong="G1909"\w* \w los|strong="G3588"\w* santos han sido reconfortados \w por|strong="G1223"\w* \w medio|strong="G1223"\w* \w de|strong="G1909"\w* ti.   
\p
\v 8 \w Por|strong="G1722"\w* \w lo|strong="G3588"\w* tanto, \w aunque|strong="G1722"\w* \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w tengo|strong="G2192"\w* \w la|strong="G3588"\w* \w confianza|strong="G3954"\w* suficiente \w para|strong="G1722"\w* ordenarte \w lo|strong="G3588"\w* \w que|strong="G3588"\w* debes hacer,  
\v 9 prefiero rogártelo \w por|strong="G1223"\w* amor. Yo, \w Pablo|strong="G3972"\w*, \w siendo|strong="G1161"\w* \w ya|strong="G2532"\w* anciano \w y|strong="G2532"\w* \w ahora|strong="G3570"\w*, \w además|strong="G2532"\w*, \w prisionero|strong="G1198"\w* \w de|strong="G1223"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*,  
\v 10 \w te|strong="G4771"\w* \w ruego|strong="G3870"\w* \w por|strong="G1722"\w* \w mi|strong="G1699"\w* \w hijo|strong="G5043"\w* \w Onésimo|strong="G3682"\w*, \w a|strong="G1722"\w* \w quien|strong="G3739"\w* \w engendré|strong="G1080"\w* \w en|strong="G1722"\w* \w mis|strong="G1699"\w* \w prisiones|strong="G1199"\w*.  
\v 11 \w En|strong="G3588"\w* \w otro|strong="G3739"\w* tiempo \w él|strong="G3588"\w* \w te|strong="G4771"\w* fue inútil, \w pero|strong="G1161"\w* \w ahora|strong="G3570"\w* nos \w es|strong="G3739"\w* muy \w útil|strong="G2173"\w*, \w tanto|strong="G3739"\w* \w a|strong="G1161"\w* \w ti|strong="G3739"\w* \w como|strong="G2532"\w* \w a|strong="G1161"\w* \w mí|strong="G3588"\w*.  
\v 12 \w Te|strong="G4771"\w* \w lo|strong="G3588"\w* devuelvo; recíbelo, pues, como a \w mi|strong="G1699"\w* propio corazón.  
\v 13 \w Yo|strong="G1473"\w* hubiera querido retenerlo \w conmigo|strong="G1722"\w*, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w me|strong="G1683"\w* sirviera \w en|strong="G1722"\w* \w tu|strong="G4771"\w* lugar \w en|strong="G1722"\w* mis \w prisiones|strong="G1199"\w* \w por|strong="G1722"\w* \w el|strong="G3588"\w* \w evangelio|strong="G2098"\w*;  
\v 14 \w pero|strong="G1161"\w* \w no|strong="G3361"\w* \w quise|strong="G2309"\w* \w hacer|strong="G4160"\w* \w nada|strong="G3762"\w* \w sin|strong="G5565"\w* \w tu|strong="G4771"\w* consentimiento, \w para|strong="G2443"\w* \w que|strong="G3588"\w* \w tu|strong="G4771"\w* favor \w no|strong="G3361"\w* \w fuera|strong="G1510"\w* \w por|strong="G2596"\w* obligación, \w sino|strong="G1161"\w* \w por|strong="G2596"\w* \w tu|strong="G4771"\w* propia voluntad.  
\v 15 \w Porque|strong="G1063"\w* tal vez \w se|strong="G4314"\w* separó \w de|strong="G1223"\w* ti \w por|strong="G1223"\w* un \w tiempo|strong="G5610"\w* \w para|strong="G2443"\w* \w que|strong="G2443"\w* lo pudieras tener \w para|strong="G2443"\w* \w siempre|strong="G1223"\w*,  
\v 16 \w ya|strong="G2089"\w* \w no|strong="G3756"\w* \w como|strong="G5613"\w* esclavo, \w sino|strong="G1161"\w* \w como|strong="G5613"\w* algo \w mejor|strong="G3123"\w* \w que|strong="G2532"\w* \w un|strong="G1722"\w* esclavo, \w como|strong="G5613"\w* \w un|strong="G1722"\w* hermano amado. Lo \w es|strong="G3756"\w* especialmente \w para|strong="G1722"\w* mí, \w pero|strong="G1161"\w* \w cuánto|strong="G4214"\w* \w más|strong="G1161"\w* lo será \w para|strong="G1722"\w* ti, tanto \w en|strong="G1722"\w* lo humano \w como|strong="G5613"\w* \w en|strong="G1722"\w* \w el|strong="G1161"\w* \w Señor|strong="G2962"\w*.   
\p
\v 17 Así \w que|strong="G3767"\w*, \w si|strong="G1487"\w* \w me|strong="G1473"\w* consideras tu \w compañero|strong="G2844"\w*, recíbelo \w como|strong="G5613"\w* \w a|strong="G5613"\w* mí mismo.  
\v 18 \w Y|strong="G1161"\w* \w si|strong="G1487"\w* \w te|strong="G4771"\w* ha perjudicado en \w algo|strong="G5100"\w* \w o|strong="G2228"\w* \w te|strong="G4771"\w* \w debe|strong="G3784"\w* \w algo|strong="G5100"\w*, \w ponlo|strong="G1677"\w* \w a|strong="G1161"\w* mi cuenta.  
\v 19 \w Yo|strong="G1473"\w*, \w Pablo|strong="G3972"\w*, \w lo|strong="G3588"\w* \w escribo|strong="G1125"\w* \w con|strong="G2532"\w* \w mi|strong="G1699"\w* propia \w mano|strong="G5495"\w*: \w yo|strong="G1473"\w* \w te|strong="G4771"\w* \w lo|strong="G3588"\w* pagaré (\w por|strong="G3754"\w* \w no|strong="G3361"\w* mencionarte \w que|strong="G3754"\w* \w tú|strong="G4771"\w* mismo \w me|strong="G1473"\w* \w debes|strong="G4359"\w* \w la|strong="G3588"\w* vida).  
\v 20 \w Sí|strong="G3483"\w*, hermano, concédeme \w este|strong="G3588"\w* favor \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w Señor|strong="G2962"\w*; reconforta \w mi|strong="G3588"\w* corazón \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w*.   
\p
\v 21 \w Te|strong="G4771"\w* \w escribo|strong="G1125"\w* \w confiando|strong="G3982"\w* \w en|strong="G3588"\w* \w tu|strong="G4771"\w* \w obediencia|strong="G5218"\w*, \w sabiendo|strong="G1492"\w* \w que|strong="G3754"\w* \w harás|strong="G4160"\w* incluso \w más|strong="G2532"\w* \w de|strong="G5228"\w* \w lo|strong="G3588"\w* \w que|strong="G3754"\w* \w te|strong="G4771"\w* pido.   
\p
\v 22 \w Además|strong="G2532"\w*, \w prepárame|strong="G2090"\w* \w alojamiento|strong="G3578"\w*, \w porque|strong="G1063"\w* \w espero|strong="G1679"\w* \w que|strong="G3754"\w*, gracias \w a|strong="G1161"\w* \w las|strong="G3588"\w* \w oraciones|strong="G4335"\w* \w de|strong="G1223"\w* ustedes, \w se|strong="G2532"\w* \w me|strong="G1473"\w* concederá ir \w a|strong="G1161"\w* verlos.   
\p
\v 23 \w Te|strong="G4771"\w* saluda \w Epafras|strong="G1889"\w*, \w mi|strong="G3588"\w* compañero \w de|strong="G1722"\w* cárcel \w en|strong="G1722"\w* \w Cristo|strong="G5547"\w* \w Jesús|strong="G2424"\w*,  
\v 24 \w y|strong="G1473"\w* también \w Marcos|strong="G3138"\w*, Aristarco, \w Demas|strong="G1214"\w* \w y|strong="G1473"\w* \w Lucas|strong="G3065"\w*, mis compañeros \w de|strong="G3588"\w* trabajo.   
\p
\v 25 \w Que|strong="G3588"\w* \w la|strong="G3588"\w* \w gracia|strong="G5485"\w* \w de|strong="G3588"\w* \w nuestro|strong="G3588"\w* \w Señor|strong="G2962"\w* \w Jesucristo|strong="G2424"\w* \w sea|strong="G3588"\w* \w con|strong="G3326"\w* \w el|strong="G3588"\w* \w espíritu|strong="G4151"\w* \w de|strong="G3588"\w* ustedes. Amén.   