\v 3 Cuando ponemos \w frenos|strong="G5469"\w* \w en|strong="G1519"\w* \w la|strong="G3588"\w* \w boca|strong="G4750"\w* \w de|strong="G1519"\w* \w los|strong="G3588"\w* \w caballos|strong="G2462"\w* \w para|strong="G1519"\w* \w que|strong="G3588"\w* \w nos|strong="G1438"\w* \w obedezcan|strong="G3982"\w*, podemos controlar \w todo|strong="G3650"\w* \w su|strong="G3588"\w* \w cuerpo|strong="G4983"\w*.  
\v 4 Fíjense \w también|strong="G2532"\w* \w en|strong="G3588"\w* \w los|strong="G3588"\w* \w barcos|strong="G4143"\w*, \w aunque|strong="G2532"\w* \w son|strong="G1510"\w* tan grandes \w y|strong="G2532"\w* \w son|strong="G1510"\w* impulsados \w por|strong="G5259"\w* vientos fuertes, \w son|strong="G1510"\w* guiados \w por|strong="G5259"\w* \w un|strong="G3588"\w* \w timón|strong="G4079"\w* muy pequeño hacia \w donde|strong="G3699"\w* \w el|strong="G3588"\w* piloto \w quiere|strong="G1014"\w*.  
\v 5 \w Así|strong="G3779"\w* \w también|strong="G2532"\w* \w la|strong="G3588"\w* \w lengua|strong="G1100"\w* es \w un|strong="G3588"\w* \w miembro|strong="G3196"\w* \w pequeño|strong="G3398"\w*, \w y|strong="G2532"\w* \w se|strong="G3779"\w* jacta \w de|strong="G3588"\w* \w grandes|strong="G3173"\w* cosas. Miren \w cómo|strong="G2532"\w* \w un|strong="G3588"\w* \w pequeño|strong="G3398"\w* \w fuego|strong="G4442"\w* puede incendiar \w un|strong="G3588"\w* \w gran|strong="G3173"\w* \w bosque|strong="G5208"\w*.  
\v 6 \w Y|strong="G2532"\w* \w la|strong="G3588"\w* \w lengua|strong="G1100"\w* es \w un|strong="G3588"\w* \w fuego|strong="G4442"\w*, \w un|strong="G3588"\w* \w mundo|strong="G2889"\w* \w de|strong="G1722"\w* maldad. \w La|strong="G3588"\w* \w lengua|strong="G1100"\w* \w está|strong="G3588"\w* puesta \w entre|strong="G1722"\w* nuestros \w miembros|strong="G3196"\w*, contamina \w todo|strong="G3650"\w* \w el|strong="G3588"\w* \w cuerpo|strong="G4983"\w*, incendia \w el|strong="G3588"\w* curso \w de|strong="G1722"\w* \w nuestra|strong="G3588"\w* vida, \w y|strong="G2532"\w* es incendiada \w por|strong="G1722"\w* \w el|strong="G3588"\w* \w infierno|strong="G1067"\w*.  
\v 7 \w Porque|strong="G1063"\w* \w toda|strong="G3956"\w* clase \w de|strong="G3588"\w* animales, \w aves|strong="G4071"\w*, \w reptiles|strong="G2062"\w* \w y|strong="G2532"\w* criaturas marinas \w se|strong="G2532"\w* pueden \w domar|strong="G1150"\w*, \w y|strong="G2532"\w* han sido domados \w por|strong="G1063"\w* \w el|strong="G3588"\w* ser humano;  
