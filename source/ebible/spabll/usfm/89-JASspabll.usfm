\v 16 \w Porque|strong="G1063"\w* \w donde|strong="G3699"\w* hay \w celos|strong="G2205"\w* \w y|strong="G2532"\w* ambición egoísta, \w allí|strong="G1563"\w* hay confusión \w y|strong="G2532"\w* \w toda|strong="G3956"\w* clase de maldad.  
\v 17 \w Pero|strong="G1161"\w* \w la|strong="G3588"\w* \w sabiduría|strong="G4678"\w* \w que|strong="G3588"\w* viene \w de|strong="G3588"\w* arriba es, \w ante|strong="G4412"\w* todo, pura; \w y|strong="G2532"\w* \w además|strong="G2532"\w* \w pacífica|strong="G1516"\w*, amable, dócil, \w llena|strong="G3324"\w* \w de|strong="G3588"\w* compasión \w y|strong="G2532"\w* \w de|strong="G3588"\w* buenos \w frutos|strong="G2590"\w*, imparcial \w y|strong="G2532"\w* sincera.  
