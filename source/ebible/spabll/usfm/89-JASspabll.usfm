\v 18 Pero \w alguien|strong="G5100"\w* \w dirá|strong="G2046"\w*: “\w Tú|strong="G4771"\w* \w tienes|strong="G2192"\w* \w fe|strong="G4102"\w*, \w y|strong="G1473"\w* \w yo|strong="G1473"\w* \w tengo|strong="G2192"\w* \w obras|strong="G2041"\w*”. \w Muéstrame|strong="G1166"\w* \w tu|strong="G4771"\w* \w fe|strong="G4102"\w* \w sin|strong="G5565"\w* \w obras|strong="G2041"\w*, \w y|strong="G1473"\w* \w yo|strong="G1473"\w* \w te|strong="G4771"\w* \w mostraré|strong="G1166"\w* \w mi|strong="G3588"\w* \w fe|strong="G4102"\w* \w por|strong="G1537"\w* mis \w obras|strong="G2041"\w*.   
\p
