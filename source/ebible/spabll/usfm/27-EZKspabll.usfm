\v 17 \w Cuando|strong="H1961"\w* entren \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w del|strong="H5921"\w* \w atrio|strong="H2691"\w* \w interior|strong="H6442"\w*, deberán vestirse \w con|strong="H5921"\w* ropa \w de|strong="H5921"\w* \w lino|strong="H6593"\w*. \w No|strong="H3808"\w* deben usar \w lana|strong="H6785"\w* mientras sirven \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w del|strong="H5921"\w* \w atrio|strong="H2691"\w* \w interior|strong="H6442"\w* \w o|strong="H3068"\w* \w dentro|strong="H5921"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*.  
