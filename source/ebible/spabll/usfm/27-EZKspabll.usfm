\mt1 Ezequiel  
\c 1  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* \w treinta|strong="H7970"\w*, \w el|strong="H5921"\w* día \w cinco|strong="H2568"\w* \w del|strong="H5921"\w* \w cuarto|strong="H7243"\w* \w mes|strong="H2320"\w*, mientras yo \w estaba|strong="H1961"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* desterrados \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Quebar, \w los|strong="H5921"\w* \w cielos|strong="H8064"\w* \w se|strong="H1961"\w* abrieron \w y|strong="H5921"\w* \w tuve|strong="H1961"\w* \w visiones|strong="H4759"\w* \w de|strong="H5921"\w* Dios. \f + \fr 1:1 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f*   
\p
\v 2 \w El|strong="H1931"\w* \w cinco|strong="H2568"\w* del \w mes|strong="H2320"\w*, \w que|strong="H1931"\w* \w era|strong="H8141"\w* \w el|strong="H1931"\w* \w quinto|strong="H2549"\w* \w año|strong="H8141"\w* del exilio del \w rey|strong="H4428"\w* Joaquín,  
\v 3 \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w de|strong="H5921"\w* Yahvé\f + \fr 1:3 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* \w vino|strong="H1961"\w* \w al|strong="H5921"\w* \w sacerdote|strong="H3548"\w* \w Ezequiel|strong="H3168"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Buzi, \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w caldeos|strong="H3778"\w*, \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Quebar; \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H1961"\w* posó \w allí|strong="H8033"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*.   
\p
\v 4 \w Miré|strong="H7200"\w*, y \w vi|strong="H7200"\w* \w que|strong="H4480"\w* venía \w del|strong="H4480"\w* \w norte|strong="H6828"\w* un \w viento|strong="H7307"\w* huracanado: una \w gran|strong="H1419"\w* \w nube|strong="H6051"\w* \w con|strong="H4480"\w* relámpagos constantes y un \w resplandor|strong="H5051"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*. \w En|strong="H4480"\w* \w medio|strong="H8432"\w* \w del|strong="H4480"\w* fuego \w se|strong="H4480"\w* \w veía|strong="H7200"\w* algo como metal brillante.  
\v 5 \w En|strong="H8432"\w* el centro apareció la \w figura|strong="H1823"\w* de cuatro seres \w vivientes|strong="H2416"\w*. \w Esta|strong="H2088"\w* \w era|strong="H2088"\w* su \w apariencia|strong="H4758"\w*: tenían \w forma|strong="H1823"\w* humana.  
\v 6 Cada uno tenía cuatro caras y cuatro \w alas|strong="H3671"\w*.  
\v 7 Sus piernas eran rectas; la planta \w de|strong="H5869"\w* sus \w pies|strong="H7272"\w* era \w como|strong="H7272"\w* la \w de|strong="H5869"\w* un \w becerro|strong="H5695"\w* y brillaban \w como|strong="H7272"\w* bronce pulido.  
\v 8 \w Debajo|strong="H8478"\w* \w de|strong="H5921"\w* sus \w alas|strong="H3671"\w*, \w en|strong="H5921"\w* sus cuatro \w costados|strong="H7253"\w*, tenían \w manos|strong="H3027"\w* humanas. \w Los|strong="H5921"\w* cuatro tenían sus caras \w y|strong="H5921"\w* sus \w alas|strong="H3671"\w* \w de|strong="H5921"\w* \w esta|strong="H5921"\w* manera:  
\v 9 Sus \w alas|strong="H3671"\w* \w se|strong="H3808"\w* tocaban \w entre|strong="H3808"\w* \w sí|strong="H3808"\w*. \w No|strong="H3808"\w* \w se|strong="H3808"\w* daban \w vuelta|strong="H5437"\w* al caminar, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* cada uno avanzaba \w de|strong="H6440"\w* frente.   
\p
\v 10 En cuanto \w a|strong="H3068"\w* la \w forma|strong="H1823"\w* \w de|strong="H6440"\w* sus caras, los cuatro tenían \w cara|strong="H6440"\w* \w de|strong="H6440"\w* hombre; del lado \w derecho|strong="H3225"\w*, \w cara|strong="H6440"\w* \w de|strong="H6440"\w* león; del lado izquierdo, \w cara|strong="H6440"\w* \w de|strong="H6440"\w* toro; \w y|strong="H7794"\w* también los cuatro tenían \w cara|strong="H6440"\w* \w de|strong="H6440"\w* águila.  
\v 11 Así eran sus caras. Sus \w alas|strong="H3671"\w* estaban \w extendidas|strong="H6504"\w* \w hacia|strong="H6440"\w* \w arriba|strong="H4605"\w*; \w dos|strong="H8147"\w* \w de|strong="H6440"\w* ellas se tocaban entre \w sí|strong="H6440"\w* y las otras \w dos|strong="H8147"\w* \w cubrían|strong="H3680"\w* sus \w cuerpos|strong="H1472"\w*.  
\v 12 \w Cada|strong="H8033"\w* uno avanzaba \w de|strong="H6440"\w* frente. \w Iban|strong="H3212"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* el \w espíritu|strong="H7307"\w* \w los|strong="H1961"\w* impulsaba, y \w no|strong="H3808"\w* \w se|strong="H1961"\w* daban \w vuelta|strong="H5437"\w* al caminar.  
\v 13 \w En|strong="H4480"\w* cuanto \w a|strong="H3068"\w* \w la|strong="H1931"\w* \w apariencia|strong="H4758"\w* \w de|strong="H4480"\w* \w los|strong="H1931"\w* seres \w vivientes|strong="H2416"\w*, \w se|strong="H1931"\w* veían \w como|strong="H1823"\w* \w carbones|strong="H1513"\w* \w encendidos|strong="H1197"\w*, \w como|strong="H1823"\w* antorchas \w que|strong="H4480"\w* \w se|strong="H1931"\w* movían \w de|strong="H4480"\w* un lado \w a|strong="H3068"\w* otro \w entre|strong="H4480"\w* \w ellos|strong="H1931"\w*. \w El|strong="H1931"\w* fuego \w resplandecía|strong="H5051"\w* \w y|strong="H1197"\w* \w de|strong="H4480"\w* \w él|strong="H1931"\w* \w salían|strong="H3318"\w* \w relámpagos|strong="H1300"\w*.  
\v 14 Los seres \w vivientes|strong="H2416"\w* iban y venían con la rapidez de un rayo.   
\p
\v 15 Mientras \w miraba|strong="H7200"\w* \w a|strong="H3068"\w* los seres \w vivientes|strong="H2416"\w*, \w vi|strong="H7200"\w* que en el suelo, junto \w a|strong="H3068"\w* cada uno \w de|strong="H6440"\w* ellos, había una rueda \w por|strong="H6440"\w* cada una \w de|strong="H6440"\w* sus cuatro caras.  
\v 16 Las ruedas y su estructura brillaban \w como|strong="H1961"\w* el berilo. Las cuatro \w tenían|strong="H1961"\w* la misma \w forma|strong="H1823"\w* y \w parecían|strong="H5869"\w* estar hechas \w de|strong="H5869"\w* modo \w que|strong="H1961"\w* una rueda estuviera \w dentro|strong="H8432"\w* \w de|strong="H5869"\w* otra rueda.  
\v 17 Cuando avanzaban, podían \w ir|strong="H3212"\w* \w en|strong="H5921"\w* cualquiera \w de|strong="H5921"\w* sus cuatro direcciones \w sin|strong="H3808"\w* tener \w que|strong="H3808"\w* girar.  
\v 18 \w Sus|strong="H1992"\w* aros eran altos y aterradores, y \w los|strong="H1992"\w* cuatro aros estaban \w llenos|strong="H4392"\w* \w de|strong="H5869"\w* \w ojos|strong="H5869"\w* por \w todas|strong="H5439"\w* \w partes|strong="H5439"\w*.   
\p
\v 19 Cuando \w los|strong="H5921"\w* seres \w vivientes|strong="H2416"\w* avanzaban, \w las|strong="H5921"\w* ruedas avanzaban \w a|strong="H3068"\w* su lado; \w y|strong="H5921"\w* cuando \w se|strong="H5921"\w* elevaban \w del|strong="H5921"\w* suelo, también \w las|strong="H5921"\w* ruedas \w se|strong="H5921"\w* elevaban.  
\v 20 \w Iban|strong="H3212"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w los|strong="H5921"\w* impulsaba, \w y|strong="H3588"\w* \w las|strong="H5921"\w* ruedas \w se|strong="H1961"\w* elevaban \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* seres \w vivientes|strong="H2416"\w* \w estaba|strong="H1961"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* ruedas.  
\v 21 \w Si|strong="H3588"\w* \w ellos|strong="H5921"\w* caminaban, \w ellas|strong="H5921"\w* caminaban; \w si|strong="H3588"\w* \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* detenían, \w ellas|strong="H5921"\w* \w se|strong="H5921"\w* detenían; \w y|strong="H3588"\w* \w si|strong="H3588"\w* \w se|strong="H5921"\w* elevaban \w del|strong="H5921"\w* suelo, \w las|strong="H5921"\w* ruedas \w se|strong="H5921"\w* elevaban \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* seres \w vivientes|strong="H2416"\w* \w estaba|strong="H5975"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* ruedas.   
\p
\v 22 \w Sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w cabezas|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* seres \w vivientes|strong="H2416"\w* había una especie \w de|strong="H5921"\w* plataforma, \w como|strong="H5921"\w* un cristal deslumbrante, \w extendida|strong="H5186"\w* \w por|strong="H5921"\w* \w encima|strong="H4605"\w* \w de|strong="H5921"\w* sus \w cabezas|strong="H7218"\w*.  
\v 23 \w Debajo|strong="H8478"\w* \w de|strong="H8478"\w* esa plataforma, sus \w alas|strong="H3671"\w* estaban extendidas, una hacia la otra. Cada uno tenía \w dos|strong="H8147"\w* \w alas|strong="H3671"\w* que \w cubrían|strong="H3680"\w* su cuerpo \w por|strong="H8478"\w* un lado y otras \w dos|strong="H8147"\w* que \w lo|strong="H2007"\w* \w cubrían|strong="H3680"\w* \w por|strong="H8478"\w* el otro.  
\v 24 Cuando avanzaban, \w oí|strong="H8085"\w* \w el|strong="H4264"\w* \w estruendo|strong="H6963"\w* \w de|strong="H4325"\w* sus \w alas|strong="H3671"\w*; era como \w el|strong="H4264"\w* \w estruendo|strong="H6963"\w* \w de|strong="H4325"\w* \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w*, como la \w voz|strong="H6963"\w* del \w Todopoderoso|strong="H7706"\w*, como \w el|strong="H4264"\w* \w ruido|strong="H6963"\w* \w de|strong="H4325"\w* un \w ejército|strong="H4264"\w*. Cuando se detenían, bajaban sus \w alas|strong="H3671"\w*.   
\p
\v 25 \w Se|strong="H1961"\w* oía una \w voz|strong="H6963"\w* \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* plataforma \w que|strong="H5921"\w* \w estaba|strong="H1961"\w* \w sobre|strong="H5921"\w* sus \w cabezas|strong="H7218"\w*. \w Cuando|strong="H1961"\w* \w se|strong="H1961"\w* detenían, bajaban sus \w alas|strong="H3671"\w*.  
\v 26 \w Sobre|strong="H5921"\w* \w la|strong="H5921"\w* plataforma \w que|strong="H5921"\w* estaba \w sobre|strong="H5921"\w* sus \w cabezas|strong="H7218"\w* \w se|strong="H5921"\w* veía algo \w como|strong="H5921"\w* un \w trono|strong="H3678"\w* \w de|strong="H5921"\w* piedra \w de|strong="H5921"\w* zafiro;\f + \fr 1:26 \ft o, lapislázuli\f* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* esa especie \w de|strong="H5921"\w* \w trono|strong="H3678"\w* había una \w figura|strong="H1823"\w* \w que|strong="H5921"\w* tenía \w apariencia|strong="H4758"\w* \w de|strong="H5921"\w* hombre.  
\v 27 \w Vi|strong="H7200"\w* algo que brillaba como el metal, como si por dentro estuviera lleno \w de|strong="H5869"\w* fuego, \w desde|strong="H5439"\w* lo que \w parecía|strong="H5869"\w* ser su cintura hacia \w arriba|strong="H4605"\w*; y \w de|strong="H5869"\w* la cintura hacia \w abajo|strong="H4295"\w*, \w vi|strong="H7200"\w* algo como fuego, con un \w resplandor|strong="H5051"\w* \w a|strong="H3068"\w* su \w alrededor|strong="H5439"\w*.  
\v 28 \w Como|strong="H1961"\w* \w el|strong="H1931"\w* \w arco|strong="H7198"\w* iris \w que|strong="H1931"\w* aparece \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w nubes|strong="H6051"\w* un \w día|strong="H3117"\w* \w de|strong="H5921"\w* \w lluvia|strong="H1653"\w*, \w así|strong="H3651"\w* \w era|strong="H1961"\w* \w el|strong="H1931"\w* \w resplandor|strong="H5051"\w* \w que|strong="H1931"\w* \w lo|strong="H1931"\w* rodeaba.  
\p \w Esta|strong="H1931"\w* \w fue|strong="H1961"\w* \w la|strong="H1931"\w* \w visión|strong="H4758"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w apariencia|strong="H4758"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé. \w Al|strong="H5921"\w* verla, \w caí|strong="H5307"\w* \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w oí|strong="H8085"\w* \w la|strong="H1931"\w* \w voz|strong="H6963"\w* \w de|strong="H5921"\w* alguien \w que|strong="H1931"\w* \w hablaba|strong="H1696"\w*.   
\c 2  
\p
\v 1 \w Él|strong="H5921"\w* \w me|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, \w ponte|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H7272"\w*, \w que|strong="H5921"\w* voy \w a|strong="H3068"\w* \w hablar|strong="H1696"\w* \w contigo|strong="H5921"\w*”.  
\v 2 Mientras \w me|strong="H5921"\w* \w hablaba|strong="H1696"\w*, \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* entró \w en|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* \w puso|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H7272"\w*; \w y|strong="H5921"\w* \w escuché|strong="H8085"\w* \w al|strong="H5921"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* \w hablaba|strong="H1696"\w*.   
\p
\v 3 Me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H5704"\w* \w hombre|strong="H1121"\w*, te \w envío|strong="H7971"\w* \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w a|strong="H3068"\w* una \w nación|strong="H1471"\w* \w de|strong="H5704"\w* \w rebeldes|strong="H4775"\w* \w que|strong="H5704"\w* \w se|strong="H1992"\w* ha sublevado \w contra|strong="H3478"\w* mí. Tanto \w ellos|strong="H1992"\w* \w como|strong="H5704"\w* \w sus|strong="H1992"\w* antepasados han sido \w rebeldes|strong="H4775"\w* conmigo \w hasta|strong="H5704"\w* \w el|strong="H1121"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*.  
\v 4 Son \w hijos|strong="H1121"\w* tercos \w y|strong="H3541"\w* \w de|strong="H6440"\w* \w corazón|strong="H3820"\w* endurecido. Te \w envío|strong="H7971"\w* \w a|strong="H3068"\w* ellos para \w que|strong="H1121"\w* les digas: ‘\w Esto|strong="H3541"\w* dice \w el|strong="H1121"\w* Señor\f + \fr 2:4 \ft La palabra traducida “Señor” es “Adonai”.\f* Yahvé’.  
\v 5 \w Y|strong="H3068"\w* \w ellos|strong="H1992"\w*, ya \w sea|strong="H1961"\w* \w que|strong="H3588"\w* \w escuchen|strong="H8085"\w* \w o|strong="H3068"\w* \w que|strong="H3588"\w* \w se|strong="H3045"\w* nieguen \w a|strong="H3068"\w* hacerlo — \w porque|strong="H3588"\w* \w son|strong="H1961"\w* un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w* —, \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w hubo|strong="H1961"\w* un \w profeta|strong="H5030"\w* \w entre|strong="H8432"\w* \w ellos|strong="H1992"\w*.  
\v 6 \w Y|strong="H3068"\w* tú, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w hombre|strong="H1121"\w*, \w no|strong="H3588"\w* \w les|strong="H1992"\w* tengas \w miedo|strong="H3372"\w* ni \w te|strong="H3588"\w* asustes \w por|strong="H3588"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* digan, \w aunque|strong="H3588"\w* estés rodeado \w de|strong="H3588"\w* espinos \w y|strong="H3588"\w* matorrales, \w y|strong="H3588"\w* vivas \w entre|strong="H3588"\w* escorpiones. \w No|strong="H3588"\w* \w temas|strong="H3372"\w* \w a|strong="H3068"\w* \w sus|strong="H1992"\w* \w palabras|strong="H1697"\w* ni \w te|strong="H3588"\w* dejes intimidar \w por|strong="H3588"\w* \w ellos|strong="H1992"\w*, \w a|strong="H3068"\w* pesar \w de|strong="H3588"\w* ser un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*.  
\v 7 Tú \w les|strong="H1992"\w* \w dirás|strong="H1696"\w* mis \w palabras|strong="H1697"\w*, ya sea \w que|strong="H3588"\w* \w escuchen|strong="H8085"\w* \w o|strong="H3068"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* quieran \w oír|strong="H8085"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* muy \w rebeldes|strong="H4805"\w*.  
\v 8 Pero tú, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, atiende \w a|strong="H3068"\w* lo \w que|strong="H1121"\w* te digo. \w No|strong="H1961"\w* \w seas|strong="H1961"\w* \w rebelde|strong="H4805"\w* \w como|strong="H1961"\w* ese pueblo \w rebelde|strong="H4805"\w*. \w Abre|strong="H6475"\w* la \w boca|strong="H6310"\w* y come lo \w que|strong="H1121"\w* te voy \w a|strong="H3068"\w* \w dar|strong="H5414"\w*”.   
\p
\v 9 Entonces \w vi|strong="H7200"\w* \w que|strong="H3027"\w* una \w mano|strong="H3027"\w* se extendía hacia \w mí|strong="H2009"\w*, y en ella había un pergamino enrollado.  
\v 10 \w Lo|strong="H1931"\w* \w extendió|strong="H6566"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* mí, y estaba \w escrito|strong="H3789"\w* \w por|strong="H6440"\w* \w los|strong="H1931"\w* \w dos|strong="H6440"\w* lados; en \w él|strong="H1931"\w* estaban \w escritas|strong="H3789"\w* elegías, lamentos y ayes \w de|strong="H6440"\w* dolor.   
\c 3  
\p
\v 1 Me \w dijo|strong="H1696"\w*: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, come lo \w que|strong="H1121"\w* tienes delante. Cómete \w este|strong="H2063"\w* \w rollo|strong="H4039"\w*, y luego \w ve|strong="H3212"\w* y \w habla|strong="H1696"\w* \w a|strong="H3068"\w* \w la|strong="H2063"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 2 Entonces \w abrí|strong="H6605"\w* \w la|strong="H2063"\w* \w boca|strong="H6310"\w* y él me dio \w a|strong="H3068"\w* comer el \w rollo|strong="H4039"\w*.   
\p
\v 3 Me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, aliméntate y \w llena|strong="H4390"\w* tu estómago con \w este|strong="H2063"\w* \w rollo|strong="H4039"\w* \w que|strong="H1121"\w* te \w estoy|strong="H1961"\w* dando”.  
\p Me lo comí, y en \w mi|strong="H1961"\w* \w boca|strong="H6310"\w* sabía tan \w dulce|strong="H4966"\w* \w como|strong="H1961"\w* \w la|strong="H2063"\w* \w miel|strong="H1706"\w*.   
\p
\v 4 Luego me \w dijo|strong="H1696"\w*: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w anda|strong="H3212"\w*, \w ve|strong="H3212"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* y \w diles|strong="H1697"\w* mis \w palabras|strong="H1697"\w*.  
\v 5 \w Porque|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w envío|strong="H7971"\w* \w a|strong="H3068"\w* un \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w lenguaje|strong="H8193"\w* extraño \w o|strong="H3068"\w* \w de|strong="H3588"\w* \w lengua|strong="H3956"\w* \w difícil|strong="H3515"\w*, \w sino|strong="H3588"\w* al \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.  
\v 6 \w No|strong="H3808"\w* te \w envío|strong="H7971"\w* \w a|strong="H3068"\w* \w muchas|strong="H7227"\w* naciones \w de|strong="H5971"\w* idiomas complicados \w que|strong="H3808"\w* \w no|strong="H3808"\w* puedas entender. \w Si|strong="H3808"\w* \w a|strong="H3068"\w* \w ellos|strong="H1992"\w* te \w enviara|strong="H7971"\w*, ten \w por|strong="H1697"\w* seguro \w que|strong="H3808"\w* te escucharían.  
\v 7 \w Pero|strong="H3588"\w* \w el|strong="H3588"\w* \w pueblo|strong="H1992"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* querrá escucharte, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* quieren escucharme \w a|strong="H3068"\w* mí; \w pues|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* \w pueblo|strong="H1992"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w es|strong="H3588"\w* terco\f + \fr 3:7 \ft Literalmente, tener la frente dura\f* \w y|strong="H3588"\w* endurecido \w de|strong="H3588"\w* \w corazón|strong="H3820"\w*.  
\v 8 Pero \w mira|strong="H2009"\w*, \w yo|strong="H2009"\w* he hecho tu \w rostro|strong="H6440"\w* tan duro como el \w de|strong="H6440"\w* ellos, y tu \w frente|strong="H4696"\w* tan resistente como la suya.  
\v 9 He hecho tu \w frente|strong="H4696"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* diamante, \w más|strong="H3588"\w* dura \w que|strong="H3588"\w* \w la|strong="H3588"\w* piedra. \w No|strong="H3808"\w* \w les|strong="H1992"\w* \w tengas|strong="H5414"\w* \w miedo|strong="H3372"\w* \w ni|strong="H3808"\w* \w te|strong="H3588"\w* asustes \w por|strong="H3588"\w* \w su|strong="H1992"\w* aspecto, \w aunque|strong="H3588"\w* sean un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*”.   
\p
\v 10 También me \w dijo|strong="H1696"\w*: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, guarda en tu \w corazón|strong="H3824"\w* y \w escucha|strong="H8085"\w* \w atentamente|strong="H8085"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* te digo.  
\v 11 \w Ve|strong="H3212"\w* \w ahora|strong="H3541"\w* \w a|strong="H3068"\w* donde están \w los|strong="H1121"\w* exiliados, \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* tu \w pueblo|strong="H5971"\w*, \w y|strong="H3541"\w* \w diles|strong="H1696"\w*: ‘\w Esto|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H1121"\w* Señor Yahvé’, ya sea \w que|strong="H5971"\w* te \w escuchen|strong="H8085"\w* \w o|strong="H3068"\w* \w que|strong="H5971"\w* te ignoren”.   
\p
\v 12 Entonces el \w Espíritu|strong="H7307"\w* me \w levantó|strong="H5375"\w*, \w y|strong="H3519"\w* \w oí|strong="H8085"\w* detrás de \w mí|strong="H5375"\w* un \w estruendo|strong="H6963"\w* fuerte que decía: “¡\w Bendita|strong="H1288"\w* sea la \w gloria|strong="H3519"\w* de Yahvé en su santuario!”.  
\v 13 Oí el \w ruido|strong="H6963"\w* de las \w alas|strong="H3671"\w* de los seres \w vivientes|strong="H2416"\w* al rozarse unas con otras, el \w ruido|strong="H6963"\w* de las ruedas junto \w a|strong="H3068"\w* ellos y el \w sonido|strong="H6963"\w* de un \w gran|strong="H1419"\w* \w estruendo|strong="H6963"\w*.  
\v 14 \w El|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w me|strong="H5921"\w* \w levantó|strong="H5375"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* arrebató; \w y|strong="H5921"\w* yo \w iba|strong="H3212"\w* \w con|strong="H5921"\w* \w amargura|strong="H4751"\w* \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w espíritu|strong="H7307"\w* enardecido, pero \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé pesaba \w con|strong="H5921"\w* fuerza \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 15 \w Así|strong="H1992"\w* llegué \w a|strong="H3068"\w* Tel-Abib, \w donde|strong="H8033"\w* \w vivían|strong="H3427"\w* \w los|strong="H1992"\w* exiliados junto al \w río|strong="H5104"\w* Quebar; y me senté \w allí|strong="H8033"\w* \w entre|strong="H8432"\w* \w ellos|strong="H1992"\w*, agobiado, durante \w siete|strong="H7651"\w* \w días|strong="H3117"\w*.   
\p
\v 16 Al \w cabo|strong="H7097"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w*, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 17 “\w Hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w hombre|strong="H1121"\w*, \w te|strong="H4480"\w* he \w puesto|strong="H5414"\w* como vigilante \w de|strong="H4480"\w* la \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*. Cuando escuches una \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* mi \w boca|strong="H6310"\w*, adviérteles \w de|strong="H4480"\w* mi parte.  
\v 18 \w Si|strong="H3808"\w* yo \w le|strong="H1931"\w* digo al malvado: ‘Vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*’, y tú \w no|strong="H3808"\w* \w le|strong="H1931"\w* adviertes \w ni|strong="H3808"\w* \w le|strong="H1931"\w* hablas para \w que|strong="H1931"\w* deje \w su|strong="H1931"\w* \w mal|strong="H7563"\w* \w camino|strong="H1870"\w* y salve \w su|strong="H1931"\w* \w vida|strong="H2421"\w*, \w ese|strong="H1931"\w* malvado \w morirá|strong="H4191"\w* \w por|strong="H1870"\w* \w su|strong="H1931"\w* culpa, pero \w a|strong="H3068"\w* ti te pediré cuentas \w de|strong="H1818"\w* \w su|strong="H1931"\w* \w sangre|strong="H1818"\w*.  
\v 19 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* tú adviertes al malvado \w y|strong="H3588"\w* \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* arrepiente \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w maldad|strong="H5771"\w* \w ni|strong="H3808"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w mal|strong="H7563"\w* \w camino|strong="H1870"\w*, \w él|strong="H1931"\w* \w morirá|strong="H4191"\w* \w por|strong="H3588"\w* \w su|strong="H1931"\w* culpa, \w pero|strong="H3588"\w* tú habrás salvado tu \w vida|strong="H5315"\w*.”   
\p
\v 20 “Asimismo, \w si|strong="H3588"\w* un \w justo|strong="H6662"\w* \w se|strong="H1931"\w* aparta \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w justicia|strong="H6664"\w* \w y|strong="H3588"\w* \w hace|strong="H6213"\w* \w lo|strong="H1931"\w* malo, \w y|strong="H3588"\w* \w yo|strong="H3588"\w* \w pongo|strong="H5414"\w* un \w tropiezo|strong="H4383"\w* \w ante|strong="H6440"\w* \w él|strong="H1931"\w*, \w él|strong="H1931"\w* \w morirá|strong="H4191"\w*. \w Si|strong="H3588"\w* \w no|strong="H3808"\w* \w le|strong="H1931"\w* advertiste, \w morirá|strong="H4191"\w* \w por|strong="H3588"\w* \w su|strong="H1931"\w* \w pecado|strong="H2403"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* tomarán \w en|strong="H3588"\w* cuenta las cosas buenas \w que|strong="H3588"\w* \w hizo|strong="H6213"\w*, \w pero|strong="H3588"\w* \w a|strong="H3068"\w* ti \w te|strong="H3588"\w* pediré cuentas \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w sangre|strong="H1818"\w*.  
\v 21 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* adviertes al \w justo|strong="H6662"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w peque|strong="H2398"\w*, \w y|strong="H3588"\w* \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w peca|strong="H2398"\w*, ten \w por|strong="H3588"\w* seguro \w que|strong="H3588"\w* \w vivirá|strong="H2421"\w* \w por|strong="H3588"\w* \w haber|strong="H3808"\w* aceptado \w la|strong="H1931"\w* advertencia; \w y|strong="H3588"\w* tú habrás salvado tu \w vida|strong="H5315"\w*.”   
\p
\v 22 \w Allí|strong="H8033"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H1961"\w* posó \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*, \w y|strong="H5921"\w* \w él|strong="H5921"\w* \w me|strong="H5921"\w* \w dijo|strong="H1696"\w*: “\w Levántate|strong="H6965"\w* \w y|strong="H5921"\w* \w sal|strong="H3318"\w* \w al|strong="H5921"\w* valle; \w allí|strong="H8033"\w* \w hablaré|strong="H1696"\w* \w contigo|strong="H5921"\w*”.   
\p
\v 23 \w Me|strong="H5921"\w* levanté \w y|strong="H5921"\w* \w salí|strong="H3318"\w* \w al|strong="H5921"\w* valle; \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w estaba|strong="H5975"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé, tal \w como|strong="H5921"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w que|strong="H5921"\w* \w había|strong="H5975"\w* \w visto|strong="H7200"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Quebar. Entonces \w me|strong="H5921"\w* postré \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra.   
\p
\v 24 Pero \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* entró \w en|strong="H5921"\w* \w mí|strong="H5921"\w*, \w me|strong="H5921"\w* \w puso|strong="H5975"\w* \w de|strong="H5921"\w* \w pie|strong="H7272"\w* \w y|strong="H5921"\w* \w habló|strong="H1696"\w* conmigo \w diciendo|strong="H1696"\w*: “Ve \w y|strong="H5921"\w* enciérrate \w en|strong="H5921"\w* tu \w casa|strong="H1004"\w*.  
\v 25 \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, \w te|strong="H5921"\w* \w pondrán|strong="H5414"\w* \w cuerdas|strong="H5688"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* atarán \w con|strong="H5921"\w* \w ellas|strong="H2009"\w* \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w salgas|strong="H3318"\w* \w a|strong="H3068"\w* estar \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 26 Haré \w que|strong="H3588"\w* \w se|strong="H1961"\w* \w te|strong="H3588"\w* pegue \w la|strong="H3588"\w* \w lengua|strong="H3956"\w* al paladar \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* quedes mudo \w y|strong="H3588"\w* \w no|strong="H3808"\w* puedas reprenderlos, \w porque|strong="H3588"\w* \w son|strong="H1961"\w* un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*.  
\v 27 \w Pero|strong="H3588"\w* \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* \w hable|strong="H1696"\w* contigo, \w te|strong="H3588"\w* \w abriré|strong="H6605"\w* \w la|strong="H3588"\w* \w boca|strong="H6310"\w* \w y|strong="H3588"\w* \w les|strong="H1992"\w* \w dirás|strong="H1696"\w*: ‘\w Esto|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H3588"\w* Señor Yahvé’. \w El|strong="H3588"\w* \w que|strong="H3588"\w* quiera \w oír|strong="H8085"\w*, \w que|strong="H3588"\w* \w oiga|strong="H8085"\w*; \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w*, \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w oiga|strong="H8085"\w*; \w porque|strong="H3588"\w* \w son|strong="H3588"\w* un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*”.   
\c 4  
\p
\v 1 “\w Y|strong="H3068"\w* tú, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, \w toma|strong="H3947"\w* un \w ladrillo|strong="H3843"\w* \w de|strong="H5921"\w* barro, ponlo \w delante|strong="H6440"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* dibuja \w en|strong="H5921"\w* \w él|strong="H5921"\w* una \w ciudad|strong="H5892"\w*: Jerusalén.  
\v 2 Ponle sitio, construye torres \w de|strong="H5921"\w* asalto \w y|strong="H5921"\w* levanta \w contra|strong="H5921"\w* \w ella|strong="H5921"\w* una rampa. Instala también \w campamentos|strong="H4264"\w* \w y|strong="H5921"\w* coloca \w arietes|strong="H5550"\w* \w por|strong="H5921"\w* todos \w lados|strong="H5439"\w*.  
\v 3 Consigue una plancha \w de|strong="H5921"\w* \w hierro|strong="H1270"\w* \w y|strong="H5921"\w* ponla \w como|strong="H1961"\w* un muro \w de|strong="H5921"\w* \w hierro|strong="H1270"\w* \w entre|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w la|strong="H1931"\w* \w ciudad|strong="H5892"\w*. Quédate mirando \w hacia|strong="H5921"\w* \w ella|strong="H1931"\w*; \w quedará|strong="H1961"\w* bajo asedio \w y|strong="H5921"\w* tú \w la|strong="H1931"\w* sitiarás. \w Esta|strong="H1931"\w* \w será|strong="H1961"\w* una señal \w para|strong="H5921"\w* \w el|strong="H1931"\w* pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.   
\p
\v 4 “\w Después|strong="H5921"\w*, \w acuéstate|strong="H7901"\w* \w sobre|strong="H5921"\w* tu \w lado|strong="H6654"\w* \w izquierdo|strong="H8042"\w* \w y|strong="H5921"\w* \w carga|strong="H7760"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w del|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Llevarás|strong="H5375"\w* su \w pecado|strong="H5771"\w* durante todo \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w* \w que|strong="H5921"\w* estés \w acostado|strong="H7901"\w* \w sobre|strong="H5921"\w* ese \w lado|strong="H6654"\w*.  
\v 5 Yo te he fijado el \w número|strong="H4557"\w* \w de|strong="H5414"\w* \w días|strong="H3117"\w* según los \w años|strong="H8141"\w* \w de|strong="H5414"\w* su \w maldad|strong="H5771"\w*: \w trescientos|strong="H7969"\w* \w noventa|strong="H8673"\w* \w días|strong="H3117"\w*. Así cargarás con la culpa del pueblo \w de|strong="H5414"\w* \w Israel|strong="H3478"\w*.   
\p
\v 6 “\w Cuando|strong="H3117"\w* termines ese \w tiempo|strong="H3117"\w*, \w te|strong="H5921"\w* acostarás \w sobre|strong="H5921"\w* tu \w lado|strong="H6654"\w* derecho \w y|strong="H5921"\w* cargarás \w con|strong="H5921"\w* \w la|strong="H5921"\w* culpa \w del|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* durante cuarenta \w días|strong="H3117"\w*; \w te|strong="H5921"\w* he fijado un \w día|strong="H3117"\w* \w por|strong="H5921"\w* \w cada|strong="H3117"\w* \w año|strong="H8141"\w*.  
\v 7 Mantendrás \w la|strong="H5921"\w* mirada fija \w en|strong="H5921"\w* \w el|strong="H5921"\w* asedio \w de|strong="H5921"\w* Jerusalén \w y|strong="H5921"\w*, \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w brazo|strong="H2220"\w* descubierto, \w profetizarás|strong="H5012"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 8 \w Mira|strong="H2009"\w*, \w te|strong="H5921"\w* voy \w a|strong="H3068"\w* atar \w con|strong="H5921"\w* \w cuerdas|strong="H5688"\w* \w para|strong="H5704"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* puedas darte \w vuelta|strong="H2015"\w* \w de|strong="H5921"\w* un \w lado|strong="H6654"\w* \w a|strong="H3068"\w* otro \w hasta|strong="H5704"\w* \w que|strong="H3808"\w* hayas cumplido \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* tu asedio.   
\p
\v 9 “\w Toma|strong="H3947"\w* también \w trigo|strong="H2406"\w*, \w cebada|strong="H8184"\w*, frijoles, \w lentejas|strong="H5742"\w*, mijo \w y|strong="H5921"\w* avena; ponlos \w en|strong="H5921"\w* un recipiente \w y|strong="H5921"\w* prepárate \w pan|strong="H3899"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*. \w Lo|strong="H5921"\w* comerás durante \w los|strong="H5921"\w* \w trescientos|strong="H7969"\w* \w noventa|strong="H8673"\w* \w días|strong="H3117"\w* \w que|strong="H5921"\w* estés \w acostado|strong="H7901"\w* \w de|strong="H5921"\w* \w lado|strong="H6654"\w*.  
\v 10 La \w comida|strong="H3978"\w* \w que|strong="H5704"\w* comas será pesada: doscientos gramos\f + \fr 4:10 \ft “Bamah” significa “Lugar Alto”.\f* \w al|strong="H5704"\w* \w día|strong="H3117"\w*, \w y|strong="H5704"\w* la comerás \w a|strong="H3068"\w* horas fijas.  
\v 11 También medirás el \w agua|strong="H4325"\w* \w que|strong="H5704"\w* \w bebas|strong="H8354"\w*: un litro \w al|strong="H5704"\w* \w día|strong="H6256"\w*, \w y|strong="H5704"\w* la \w beberás|strong="H8354"\w* \w a|strong="H3068"\w* horas fijas.  
\v 12 Comerás \w el|strong="H1931"\w* \w pan|strong="H5692"\w* \w como|strong="H1931"\w* \w si|strong="H1931"\w* fueran tortillas \w de|strong="H5869"\w* \w cebada|strong="H8184"\w*, y \w lo|strong="H1931"\w* cocerás frente \w a|strong="H3068"\w* todos usando excremento humano \w como|strong="H1931"\w* combustible”.  
\v 13 Yahvé añadió: “\w De|strong="H1121"\w* la misma manera comerán \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* su \w pan|strong="H3899"\w* impuro \w entre|strong="H8033"\w* las \w naciones|strong="H1471"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* yo \w los|strong="H1121"\w* expulsaré”.   
\p
\v 14 Entonces exclamé: “¡Ay, Señor Yahvé! \w Mi|strong="H2009"\w* \w vida|strong="H5315"\w* \w nunca|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* \w contaminado|strong="H2930"\w*. \w Desde|strong="H5704"\w* \w mi|strong="H2009"\w* niñez \w hasta|strong="H5704"\w* \w ahora|strong="H6258"\w* \w jamás|strong="H3808"\w* he comido \w carne|strong="H1320"\w* \w de|strong="H5704"\w* un \w animal|strong="H5315"\w* muerto \w o|strong="H3068"\w* despedazado \w por|strong="H5704"\w* fieras, \w ni|strong="H3808"\w* \w ha|strong="H3808"\w* pasado \w por|strong="H5704"\w* \w mi|strong="H2009"\w* \w boca|strong="H6310"\w* \w ninguna|strong="H3808"\w* \w carne|strong="H1320"\w* impura”.   
\p
\v 15 \w Él|strong="H5921"\w* \w me|strong="H5921"\w* respondió: “\w Está|strong="H5921"\w* \w bien|strong="H7200"\w*, \w te|strong="H5921"\w* dejaré usar estiércol \w de|strong="H5921"\w* vaca \w en|strong="H5921"\w* \w lugar|strong="H8478"\w* \w de|strong="H5921"\w* excremento humano \w para|strong="H5921"\w* \w que|strong="H5921"\w* prepares \w tu|strong="H6213"\w* \w pan|strong="H3899"\w*”.   
\p
\v 16 Luego me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, voy \w a|strong="H3068"\w* hacer \w que|strong="H4325"\w* escasee \w el|strong="H1121"\w* alimento en Jerusalén. Comerán \w el|strong="H1121"\w* \w pan|strong="H3899"\w* racionado y con angustia, y \w beberán|strong="H8354"\w* \w el|strong="H1121"\w* \w agua|strong="H4325"\w* \w medida|strong="H4884"\w* y con desesperación.  
\v 17 Al faltarles el \w pan|strong="H3899"\w* y el \w agua|strong="H4325"\w*, se horrorizarán unos \w a|strong="H3068"\w* otros y se pudrirán \w a|strong="H3068"\w* causa \w de|strong="H4325"\w* su \w maldad|strong="H5771"\w*.   
\c 5  
\p
\v 1 “Tú, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, \w toma|strong="H3947"\w* una \w espada|strong="H2719"\w* filosa. Úsala \w como|strong="H5921"\w* \w navaja|strong="H8593"\w* \w de|strong="H5921"\w* afeitar \w y|strong="H5921"\w* pásala \w sobre|strong="H5921"\w* tu \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* tu \w barba|strong="H2206"\w*. \w Luego|strong="H5674"\w* \w toma|strong="H3947"\w* una balanza \w para|strong="H5921"\w* pesar \w y|strong="H5921"\w* divide \w el|strong="H5921"\w* cabello.  
\v 2 Quemarás una \w tercera|strong="H7992"\w* parte \w en|strong="H8432"\w* el fuego \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de \w la|strong="H1197"\w* \w ciudad|strong="H5892"\w*, \w cuando|strong="H3117"\w* se cumplan los \w días|strong="H3117"\w* del asedio. \w Tomarás|strong="H3947"\w* otra \w tercera|strong="H7992"\w* parte \w y|strong="H1197"\w* \w la|strong="H1197"\w* \w cortarás|strong="H4390"\w* con \w la|strong="H1197"\w* \w espada|strong="H2719"\w* \w alrededor|strong="H5439"\w* de \w la|strong="H1197"\w* \w ciudad|strong="H5892"\w*. \w La|strong="H1197"\w* otra \w tercera|strong="H7992"\w* parte \w la|strong="H1197"\w* esparcirás al \w viento|strong="H7307"\w*, \w y|strong="H1197"\w* yo \w sacaré|strong="H7324"\w* \w la|strong="H1197"\w* \w espada|strong="H2719"\w* para perseguirlos.  
\v 3 \w Toma|strong="H3947"\w* de \w allí|strong="H8033"\w* unos \w pocos|strong="H4592"\w* pelos y átalos en los pliegues de tu ropa.  
\v 4 \w De|strong="H4480"\w* \w estos|strong="H1992"\w*, vuelve \w a|strong="H3068"\w* \w tomar|strong="H3947"\w* algunos, échalos \w en|strong="H4480"\w* \w medio|strong="H8432"\w* \w del|strong="H4480"\w* fuego y quémalos. \w De|strong="H4480"\w* ahí \w saldrá|strong="H3318"\w* un fuego \w contra|strong="H4480"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H1992"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*.   
\p
\v 5 “\w Así|strong="H3541"\w* dice el Señor Yahvé: ‘\w Esta|strong="H2063"\w* \w es|strong="H2063"\w* Jerusalén. Yo \w la|strong="H2063"\w* \w puse|strong="H7760"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de las \w naciones|strong="H1471"\w*, rodeada de otros países.  
\v 6 \w Pero|strong="H3588"\w* \w ella|strong="H4480"\w* \w se|strong="H4480"\w* \w ha|strong="H3808"\w* rebelado \w contra|strong="H4480"\w* mis leyes haciendo \w más|strong="H3588"\w* \w maldad|strong="H7564"\w* \w que|strong="H3588"\w* las \w naciones|strong="H1471"\w*, \w y|strong="H3588"\w* \w contra|strong="H4480"\w* mis mandatos \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* países \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w rodean|strong="H5439"\w*; \w pues|strong="H3588"\w* han rechazado mis leyes \w y|strong="H3588"\w* \w no|strong="H3808"\w* han obedecido mis mandatos’.   
\p
\v 7 “\w Por|strong="H3282"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H6213"\w* Señor Yahvé: ‘\w Porque|strong="H3282"\w* ustedes han sido \w más|strong="H4480"\w* rebeldes \w que|strong="H4480"\w* las \w naciones|strong="H1471"\w* \w que|strong="H4480"\w* los \w rodean|strong="H5439"\w*, \w y|strong="H3541"\w* \w no|strong="H3808"\w* han seguido mis mandatos \w ni|strong="H3808"\w* guardado mis leyes, \w y|strong="H3541"\w* \w ni|strong="H3808"\w* siquiera han actuado según las leyes \w de|strong="H4480"\w* las \w naciones|strong="H1471"\w* \w que|strong="H4480"\w* los \w rodean|strong="H5439"\w*;  
\v 8 \w por|strong="H5921"\w* \w eso|strong="H3651"\w* dice \w el|strong="H5921"\w* Señor Yahvé: Miren, \w yo|strong="H6213"\w*, \w yo|strong="H6213"\w* \w mismo|strong="H1571"\w*, estoy \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, Jerusalén; \w y|strong="H1571"\w* \w ejecutaré|strong="H6213"\w* \w juicios|strong="H4941"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* vista \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.  
\v 9 \w Haré|strong="H6213"\w* contigo \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* he \w hecho|strong="H6213"\w* y \w lo|strong="H3808"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* volveré \w a|strong="H3068"\w* \w hacer|strong="H6213"\w*, \w a|strong="H3068"\w* causa \w de|strong="H5750"\w* \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w*.  
\v 10 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w los|strong="H1121"\w* padres \w se|strong="H3651"\w* comerán \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* ti, y \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w se|strong="H3651"\w* comerán \w a|strong="H3068"\w* sus padres. \w Ejecutaré|strong="H6213"\w* \w juicios|strong="H8201"\w* contra ti y \w esparciré|strong="H2219"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* cuatro \w vientos|strong="H7307"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w que|strong="H1121"\w* sobrevivan.  
\v 11 \w Por|strong="H3282"\w* \w tanto|strong="H3651"\w*, tan \w cierto|strong="H3651"\w* \w como|strong="H1571"\w* \w que|strong="H3808"\w* yo \w vivo|strong="H2416"\w* — \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé —, \w por|strong="H3282"\w* \w haber|strong="H3808"\w* profanado mi \w santuario|strong="H4720"\w* \w con|strong="H1571"\w* \w todos|strong="H3605"\w* tus ídolos detestables \w y|strong="H1571"\w* \w con|strong="H1571"\w* \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w*, yo \w también|strong="H1571"\w* \w te|strong="H5869"\w* reduciré; mi \w ojo|strong="H5869"\w* \w no|strong="H3808"\w* \w perdonará|strong="H2550"\w* \w y|strong="H1571"\w* \w no|strong="H3808"\w* tendré compasión.  
\v 12 Una \w tercera|strong="H7992"\w* parte de tu gente \w morirá|strong="H4191"\w* de peste y será consumida por \w el|strong="H3605"\w* \w hambre|strong="H7458"\w* \w dentro|strong="H8432"\w* de tus muros; una \w tercera|strong="H7992"\w* parte \w caerá|strong="H5307"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w* \w a|strong="H3068"\w* tu \w alrededor|strong="H5439"\w*; y \w a|strong="H3068"\w* \w la|strong="H3605"\w* otra \w tercera|strong="H7992"\w* parte \w la|strong="H3605"\w* \w esparciré|strong="H2219"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w vientos|strong="H7307"\w*, y desenvainaré \w la|strong="H3605"\w* \w espada|strong="H2719"\w* tras \w ellos|strong="H3605"\w*.   
\p
\v 13 “‘\w Así|strong="H3588"\w* \w se|strong="H3045"\w* cumplirá mi \w enojo|strong="H2534"\w*, descargaré mi \w ira|strong="H2534"\w* contra ellos \w y|strong="H3588"\w* quedaré satisfecho. \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* haya desatado mi \w ira|strong="H2534"\w* contra ellos, \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, he \w hablado|strong="H1696"\w* \w con|strong="H3588"\w* \w celo|strong="H7068"\w*.   
\p
\v 14 “‘\w Te|strong="H5869"\w* convertiré en ruinas y en vergüenza entre las \w naciones|strong="H1471"\w* \w que|strong="H3605"\w* \w te|strong="H5869"\w* \w rodean|strong="H5439"\w*, ante \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* \w de|strong="H5414"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* pasen.  
\v 15 \w Serás|strong="H1961"\w* motivo de vergüenza y de burla, de escarmiento y de espanto \w para|strong="H1961"\w* las \w naciones|strong="H1471"\w* \w que|strong="H1961"\w* te \w rodean|strong="H5439"\w*, \w cuando|strong="H1961"\w* \w yo|strong="H6213"\w* ejecute \w juicios|strong="H8201"\w* \w contra|strong="H1961"\w* ti con \w ira|strong="H2534"\w*, con \w furor|strong="H2534"\w* y con terribles castigos. \w Yo|strong="H6213"\w*, Yahvé, \w lo|strong="H6213"\w* he \w dicho|strong="H1696"\w*.  
\v 16 \w Cuando|strong="H1961"\w* dispare \w contra|strong="H5921"\w* ustedes \w las|strong="H5921"\w* flechas mortales \w del|strong="H5921"\w* \w hambre|strong="H7458"\w* \w para|strong="H5921"\w* \w destruirlos|strong="H7843"\w*, aumentaré \w el|strong="H5921"\w* \w hambre|strong="H7458"\w* \w entre|strong="H5921"\w* ustedes \w y|strong="H5921"\w* \w les|strong="H5921"\w* cortaré \w la|strong="H5921"\w* provisión \w de|strong="H5921"\w* \w pan|strong="H3899"\w*.  
\v 17 \w Enviaré|strong="H7971"\w* \w sobre|strong="H5921"\w* ustedes \w hambre|strong="H7458"\w* \w y|strong="H5921"\w* fieras salvajes \w que|strong="H5921"\w* \w los|strong="H5921"\w* \w dejarán|strong="H7971"\w* sin hijos. \w La|strong="H5921"\w* peste \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w pasarán|strong="H5674"\w* \w por|strong="H5921"\w* \w ti|strong="H5921"\w*, \w y|strong="H5921"\w* traeré \w la|strong="H5921"\w* \w espada|strong="H2719"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*. Yo, Yahvé, \w lo|strong="H5921"\w* he \w dicho|strong="H1696"\w*’”.   
\c 6  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H6440"\w* \w hombre|strong="H1121"\w*, \w ponte|strong="H7760"\w* \w de|strong="H6440"\w* \w cara|strong="H6440"\w* \w hacia|strong="H6440"\w* \w los|strong="H1121"\w* \w montes|strong="H2022"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* y \w profetiza|strong="H5012"\w* \w contra|strong="H6440"\w* ellos.  
\v 3 \w Diles|strong="H1697"\w*: ‘¡\w Montes|strong="H2022"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w escuchen|strong="H8085"\w* \w la|strong="H5921"\w* \w palabra|strong="H1697"\w* \w del|strong="H5921"\w* Señor Yahvé! \w Esto|strong="H1697"\w* \w les|strong="H5921"\w* \w dice|strong="H1697"\w* \w el|strong="H5921"\w* Señor Yahvé \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* colinas, \w a|strong="H3068"\w* \w las|strong="H5921"\w* quebradas \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* valles: Miren, \w yo|strong="H2009"\w* mismo traeré una \w espada|strong="H2719"\w* \w contra|strong="H5921"\w* ustedes \w y|strong="H5921"\w* destruiré sus santuarios \w en|strong="H5921"\w* \w los|strong="H5921"\w* lugares \w altos|strong="H1116"\w*.  
\v 4 Sus \w altares|strong="H4196"\w* quedarán en ruinas y sus \w altares|strong="H4196"\w* \w de|strong="H6440"\w* incienso serán destrozados. Arrojaré \w a|strong="H3068"\w* sus \w muertos|strong="H2491"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* sus \w ídolos|strong="H1544"\w*.  
\v 5 \w Pondré|strong="H5414"\w* \w los|strong="H1121"\w* cadáveres \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* frente \w a|strong="H3068"\w* sus \w ídolos|strong="H1544"\w* y \w esparciré|strong="H2219"\w* sus \w huesos|strong="H6106"\w* \w alrededor|strong="H5439"\w* \w de|strong="H6440"\w* sus \w altares|strong="H4196"\w*.  
\v 6 Dondequiera \w que|strong="H4616"\w* ustedes vivan, las \w ciudades|strong="H5892"\w* quedarán en ruinas y \w los|strong="H3605"\w* \w lugares|strong="H5892"\w* \w altos|strong="H1116"\w* serán devastados; así sus \w altares|strong="H4196"\w* quedarán desolados y rotos, sus \w ídolos|strong="H1544"\w* serán \w hechos|strong="H4639"\w* pedazos y desaparecerán, sus \w altares|strong="H4196"\w* de incienso serán derribados y sus \w obras|strong="H4639"\w* borradas.  
\v 7 \w La|strong="H3588"\w* gente \w caerá|strong="H5307"\w* muerta \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3588"\w* ustedes, \w y|strong="H3588"\w* \w entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.   
\p
\v 8 “‘Sin embargo, dejaré \w que|strong="H1961"\w* queden \w algunos|strong="H3498"\w*, \w pues|strong="H1961"\w* \w tendrán|strong="H1961"\w* sobrevivientes \w que|strong="H1961"\w* escapen de la \w espada|strong="H2719"\w* entre las \w naciones|strong="H1471"\w*, \w cuando|strong="H1961"\w* \w sean|strong="H1961"\w* dispersados por \w los|strong="H1961"\w* países.  
\v 9 \w Aquellos|strong="H3605"\w* \w que|strong="H5921"\w* escapen \w se|strong="H5921"\w* acordarán \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w donde|strong="H8033"\w* sean llevados cautivos; recordarán \w cómo|strong="H5921"\w* \w me|strong="H5921"\w* sentí herido \w por|strong="H5921"\w* su \w corazón|strong="H3820"\w* infiel \w que|strong="H5921"\w* \w se|strong="H5921"\w* apartó \w de|strong="H5921"\w* \w mí|strong="H5921"\w*, \w y|strong="H5921"\w* \w por|strong="H5921"\w* sus \w ojos|strong="H5869"\w* \w que|strong="H5921"\w* codiciaron \w a|strong="H3068"\w* sus \w ídolos|strong="H1544"\w*. \w Entonces|strong="H5493"\w* sentirán asco \w de|strong="H5921"\w* \w sí|strong="H6440"\w* mismos \w por|strong="H5921"\w* \w los|strong="H5921"\w* \w males|strong="H7451"\w* \w que|strong="H5921"\w* \w cometieron|strong="H6213"\w* \w con|strong="H5921"\w* \w todas|strong="H3605"\w* sus \w abominaciones|strong="H8441"\w*.  
\v 10 \w Y|strong="H3068"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé. \w No|strong="H3808"\w* \w dije|strong="H1696"\w* \w en|strong="H3588"\w* \w vano|strong="H2600"\w* \w que|strong="H3588"\w* les causaría \w esta|strong="H2063"\w* desgracia’.   
\p
\v 11 “\w Así|strong="H3541"\w* dice \w el|strong="H3605"\w* Señor Yahvé: ‘¡Aplaude con tus \w manos|strong="H3709"\w*, patea \w el|strong="H3605"\w* suelo \w y|strong="H3541"\w* grita: “¡Ay!”, por \w todas|strong="H3605"\w* las terribles \w abominaciones|strong="H8441"\w* \w de|strong="H7451"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H7451"\w* \w Israel|strong="H3478"\w*! Porque \w caerán|strong="H5307"\w* por \w la|strong="H3605"\w* \w espada|strong="H2719"\w*, \w el|strong="H3605"\w* \w hambre|strong="H7458"\w* \w y|strong="H3541"\w* \w la|strong="H3605"\w* peste.  
\v 12 \w El|strong="H5307"\w* que esté \w lejos|strong="H7350"\w* \w morirá|strong="H4191"\w* de peste; \w el|strong="H5307"\w* que esté \w cerca|strong="H7138"\w* \w caerá|strong="H5307"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*; y \w el|strong="H5307"\w* que sobreviva y sea asediado \w morirá|strong="H4191"\w* de \w hambre|strong="H7458"\w*. Así descargaré mi furia sobre ellos.  
\v 13 Ustedes \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé \w cuando|strong="H3588"\w* sus \w muertos|strong="H2491"\w* \w estén|strong="H1961"\w* tendidos \w entre|strong="H8432"\w* sus \w ídolos|strong="H1544"\w*, \w alrededor|strong="H5439"\w* \w de|strong="H3588"\w* sus \w altares|strong="H4196"\w*, \w en|strong="H8432"\w* \w toda|strong="H3605"\w* colina elevada \w y|strong="H3588"\w* \w en|strong="H8432"\w* \w todas|strong="H3605"\w* las cimas \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w montes|strong="H2022"\w*, \w bajo|strong="H8478"\w* \w todo|strong="H3605"\w* \w árbol|strong="H6086"\w* \w verde|strong="H7488"\w* \w y|strong="H3588"\w* \w bajo|strong="H8478"\w* \w todo|strong="H3605"\w* roble \w frondoso|strong="H7488"\w*; \w en|strong="H8432"\w* \w los|strong="H3605"\w* \w lugares|strong="H4725"\w* \w donde|strong="H8033"\w* ofrecían aromas agradables \w a|strong="H3068"\w* \w todos|strong="H3605"\w* sus \w ídolos|strong="H1544"\w*.  
\v 14 \w Extenderé|strong="H5186"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ellos|strong="H3027"\w* \w y|strong="H3588"\w* dejaré \w la|strong="H5921"\w* tierra \w más|strong="H3588"\w* \w desolada|strong="H8077"\w* \w y|strong="H3588"\w* vacía \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w desierto|strong="H4057"\w* \w de|strong="H5921"\w* Dibla, dondequiera \w que|strong="H3588"\w* habiten. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé’”.   
\b  
\c 7  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “Tú, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, dile \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w que|strong="H5921"\w* \w así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: ‘¡\w El|strong="H5921"\w* \w fin|strong="H7093"\w*! \w El|strong="H5921"\w* \w fin|strong="H7093"\w* \w ha|strong="H3541"\w* llegado \w a|strong="H3068"\w* \w los|strong="H1121"\w* cuatro rincones \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\v 3 \w Ahora|strong="H6258"\w* \w el|strong="H5921"\w* \w fin|strong="H7093"\w* \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w*; \w enviaré|strong="H7971"\w* \w mi|strong="H5921"\w* ira \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, \w te|strong="H5921"\w* \w juzgaré|strong="H8199"\w* \w según|strong="H5921"\w* \w tu|strong="H8199"\w* conducta \w y|strong="H5921"\w* \w te|strong="H5921"\w* pediré cuentas \w de|strong="H5921"\w* \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w*.  
\v 4 \w No|strong="H3808"\w* \w te|strong="H5869"\w* miraré \w con|strong="H5921"\w* piedad \w ni|strong="H3808"\w* \w te|strong="H5869"\w* \w tendré|strong="H1961"\w* compasión; \w al|strong="H5921"\w* contrario, \w haré|strong="H5414"\w* caer \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* tu propia conducta, \w y|strong="H3588"\w* tus \w abominaciones|strong="H8441"\w* \w quedarán|strong="H5414"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w*. \w Entonces|strong="H3588"\w* \w sabrás|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé’.   
\p
\v 5 “\w Así|strong="H3541"\w* dice el Señor Yahvé: ‘¡Un desastre! ¡Viene un desastre único! ¡Miren, ya llega!  
\v 6 El \w fin|strong="H7093"\w* ha llegado. ¡El \w fin|strong="H7093"\w* ha llegado! Se ha despertado contra ti. ¡Miren, ya viene!  
\v 7 Tu turno \w ha|strong="H3808"\w* llegado, habitante \w de|strong="H6256"\w* la tierra. \w El|strong="H3427"\w* \w tiempo|strong="H6256"\w* \w se|strong="H3808"\w* cumple, \w el|strong="H3427"\w* \w día|strong="H3117"\w* \w está|strong="H3427"\w* \w cerca|strong="H7138"\w*; hay pánico y \w no|strong="H3808"\w* alegría en \w los|strong="H3427"\w* \w montes|strong="H2022"\w*.  
\v 8 Muy pronto \w derramaré|strong="H8210"\w* \w mi|strong="H5921"\w* furia \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* descargaré \w mi|strong="H5921"\w* \w ira|strong="H2534"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*; \w te|strong="H5921"\w* \w juzgaré|strong="H8199"\w* \w según|strong="H5921"\w* tus \w caminos|strong="H1870"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* devolveré \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w*.  
\v 9 \w Mi|strong="H5921"\w* \w ojo|strong="H5869"\w* \w no|strong="H3808"\w* \w perdonará|strong="H2550"\w* \w ni|strong="H3808"\w* \w tendré|strong="H1961"\w* piedad. \w Te|strong="H5869"\w* castigaré \w conforme|strong="H5921"\w* \w a|strong="H3068"\w* tus \w caminos|strong="H1870"\w*, \w y|strong="H3588"\w* tus \w abominaciones|strong="H8441"\w* \w estarán|strong="H1961"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* ustedes. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w soy|strong="H1961"\w* \w yo|strong="H3588"\w*, Yahvé, quien golpea.   
\p
\v 10 “‘¡\w Aquí|strong="H2009"\w* está el \w día|strong="H3117"\w*! ¡Miren, ya llega! Tu condena ha \w salido|strong="H3318"\w*. La \w vara|strong="H4294"\w* del castigo ha \w florecido|strong="H6692"\w*, la soberbia ha brotado.  
\v 11 La \w violencia|strong="H2555"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* convertido en una \w vara|strong="H4294"\w* de maldad. \w No|strong="H3808"\w* \w quedará|strong="H6965"\w* \w nada|strong="H3808"\w* de \w ellos|strong="H1992"\w*, \w ni|strong="H3808"\w* de \w su|strong="H1992"\w* \w multitud|strong="H1995"\w*, \w ni|strong="H3808"\w* de \w su|strong="H1992"\w* riqueza; \w nada|strong="H3808"\w* de valor habrá \w entre|strong="H3808"\w* \w ellos|strong="H1992"\w*.  
\v 12 ¡Ha \w llegado|strong="H5060"\w* \w el|strong="H3588"\w* momento! \w El|strong="H3588"\w* \w día|strong="H3117"\w* se acerca. \w Que|strong="H3588"\w* \w no|strong="H3588"\w* se alegre \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w compra|strong="H7069"\w* ni llore \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w vende|strong="H4376"\w*, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w ira|strong="H2740"\w* cae sobre \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w multitud|strong="H1995"\w*.  
\v 13 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* vendedor \w no|strong="H3808"\w* recuperará \w lo|strong="H3808"\w* vendido \w mientras|strong="H3588"\w* siga \w vivo|strong="H2416"\w*; \w pues|strong="H3588"\w* \w la|strong="H3588"\w* \w visión|strong="H2377"\w* \w es|strong="H3588"\w* contra \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w multitud|strong="H1995"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w será|strong="H3808"\w* revocada. \w Nadie|strong="H3808"\w* \w podrá|strong="H4376"\w* aferrarse \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w vida|strong="H2416"\w* \w a|strong="H3068"\w* causa \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H5771"\w*.  
\v 14 Han tocado \w la|strong="H3605"\w* \w trompeta|strong="H8628"\w* \w y|strong="H3588"\w* han preparado \w todo|strong="H3605"\w*, \w pero|strong="H3588"\w* \w nadie|strong="H3605"\w* sale \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w batalla|strong="H4421"\w*, \w porque|strong="H3588"\w* mi \w ira|strong="H1980"\w* está sobre \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w multitud|strong="H1995"\w*.   
\p
\v 15 “‘\w Afuera|strong="H2351"\w* está la \w espada|strong="H2719"\w*, y \w adentro|strong="H1004"\w* la peste y el \w hambre|strong="H7458"\w*. El que esté en el \w campo|strong="H7704"\w* \w morirá|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*; y al que esté en la \w ciudad|strong="H5892"\w* lo devorarán el \w hambre|strong="H7458"\w* y la peste.  
\v 16 \w Los|strong="H3605"\w* \w que|strong="H1961"\w* escapen \w huirán|strong="H6403"\w* y \w estarán|strong="H1961"\w* en \w los|strong="H3605"\w* \w montes|strong="H2022"\w* \w gimiendo|strong="H1993"\w* \w como|strong="H1961"\w* palomas de \w los|strong="H3605"\w* valles, \w cada|strong="H3605"\w* uno por su propio \w pecado|strong="H5771"\w*.  
\v 17 \w Todas|strong="H3605"\w* las \w manos|strong="H3027"\w* se debilitarán y \w todas|strong="H3605"\w* las \w rodillas|strong="H1290"\w* flaquearán como \w el|strong="H3605"\w* \w agua|strong="H4325"\w*.  
\v 18 Se vestirán \w de|strong="H6440"\w* luto y \w el|strong="H3605"\w* terror \w los|strong="H3605"\w* \w cubrirá|strong="H3680"\w*. Habrá vergüenza en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w rostros|strong="H6440"\w* y se raparán \w todas|strong="H3605"\w* las \w cabezas|strong="H7218"\w*.  
\v 19 \w Arrojarán|strong="H7993"\w* \w su|strong="H3588"\w* \w plata|strong="H3701"\w* \w a|strong="H3068"\w* las \w calles|strong="H2351"\w* \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w oro|strong="H2091"\w* \w será|strong="H1961"\w* \w como|strong="H3588"\w* basura. \w Ni|strong="H3808"\w* \w su|strong="H3588"\w* \w plata|strong="H3701"\w* \w ni|strong="H3808"\w* \w su|strong="H3588"\w* \w oro|strong="H2091"\w* \w podrán|strong="H3201"\w* librarlos \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* ira \w de|strong="H3588"\w* Yahvé. \w No|strong="H3808"\w* \w saciarán|strong="H7646"\w* \w su|strong="H3588"\w* hambre \w ni|strong="H3808"\w* llenarán sus estómagos, \w porque|strong="H3588"\w* eso \w fue|strong="H1961"\w* \w la|strong="H3588"\w* causa \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H5771"\w*.  
\v 20 Estaban orgullosos \w de|strong="H5921"\w* sus hermosas joyas, pero \w con|strong="H5921"\w* \w ellas|strong="H5921"\w* \w hicieron|strong="H6213"\w* \w las|strong="H5921"\w* \w imágenes|strong="H6754"\w* \w de|strong="H5921"\w* sus \w abominaciones|strong="H8441"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* sus \w ídolos|strong="H6754"\w* detestables. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w haré|strong="H6213"\w* \w que|strong="H5921"\w* \w las|strong="H5921"\w* miren \w como|strong="H5921"\w* algo asqueroso.  
\v 21 \w Entregaré|strong="H5414"\w* sus riquezas como botín en \w manos|strong="H3027"\w* \w de|strong="H5414"\w* extranjeros y como saqueo \w a|strong="H3068"\w* los malvados \w de|strong="H5414"\w* la tierra, y \w ellos|strong="H3027"\w* las \w profanarán|strong="H2490"\w*.  
\v 22 Apartaré \w de|strong="H6440"\w* \w ellos|strong="H1992"\w* \w mi|strong="H2490"\w* \w rostro|strong="H6440"\w*, y \w profanarán|strong="H2490"\w* \w mi|strong="H2490"\w* lugar \w secreto|strong="H6845"\w*; entrarán ladrones y \w lo|strong="H1992"\w* \w profanarán|strong="H2490"\w*.   
\p
\v 23 “‘Prepara cadenas, \w porque|strong="H3588"\w* \w la|strong="H3588"\w* tierra está \w llena|strong="H4390"\w* \w de|strong="H3588"\w* crímenes \w de|strong="H3588"\w* \w sangre|strong="H1818"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* cargada \w de|strong="H3588"\w* \w violencia|strong="H2555"\w*.  
\v 24 Por eso traeré \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* \w más|strong="H1471"\w* crueles para que se adueñen \w de|strong="H7451"\w* sus \w casas|strong="H1004"\w*. Pondré fin al orgullo \w de|strong="H7451"\w* los fuertes y sus santuarios serán profanados.  
\v 25 ¡Viene la \w destrucción|strong="H7089"\w*! \w Buscarán|strong="H1245"\w* la \w paz|strong="H7965"\w*, pero no la encontrarán.  
\v 26 \w Vendrá|strong="H1961"\w* desastre tras desastre \w y|strong="H5921"\w* noticia tras noticia. \w Buscarán|strong="H1245"\w* una \w visión|strong="H2377"\w* \w del|strong="H5921"\w* \w profeta|strong="H5030"\w*, pero \w la|strong="H5921"\w* \w ley|strong="H8451"\w* \w del|strong="H5921"\w* \w sacerdote|strong="H3548"\w* desaparecerá, igual \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w consejo|strong="H6098"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w*.  
\v 27 \w El|strong="H3588"\w* \w rey|strong="H4428"\w* \w hará|strong="H6213"\w* duelo, \w el|strong="H3588"\w* \w príncipe|strong="H5387"\w* \w se|strong="H3045"\w* \w vestirá|strong="H3847"\w* \w de|strong="H3588"\w* desolación \w y|strong="H3588"\w* las \w manos|strong="H3027"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w gente|strong="H5971"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra temblarán \w de|strong="H3588"\w* miedo. \w Los|strong="H3588"\w* trataré según \w su|strong="H3588"\w* conducta \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w juzgaré|strong="H8199"\w* \w con|strong="H3588"\w* sus propios \w juicios|strong="H4941"\w*. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé’”.   
\c 8  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w sexto|strong="H8345"\w* \w año|strong="H8141"\w*, \w el|strong="H5921"\w* día \w cinco|strong="H2568"\w* \w del|strong="H5921"\w* \w sexto|strong="H8345"\w* \w mes|strong="H2320"\w*, mientras yo \w estaba|strong="H1961"\w* \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* \w mi|strong="H5921"\w* \w casa|strong="H1004"\w* \w con|strong="H5921"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* frente \w a|strong="H3068"\w* \w mí|strong="H5921"\w*, \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w del|strong="H5921"\w* Señor Yahvé \w descendió|strong="H1961"\w* \w allí|strong="H8033"\w* \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 2 Entonces \w miré|strong="H7200"\w*, y \w vi|strong="H7200"\w* una \w figura|strong="H1823"\w* que \w parecía|strong="H5869"\w* \w de|strong="H5869"\w* fuego: \w de|strong="H5869"\w* la cintura para \w abajo|strong="H4295"\w* era fuego, y \w de|strong="H5869"\w* la cintura para \w arriba|strong="H4605"\w* \w parecía|strong="H5869"\w* un resplandor, \w como|strong="H1823"\w* el brillo \w de|strong="H5869"\w* un metal reluciente.  
\v 3 \w Extendió|strong="H7971"\w* algo \w que|strong="H3027"\w* parecía una \w mano|strong="H3027"\w* y me \w tomó|strong="H3947"\w* \w por|strong="H3027"\w* un mechón de cabello. El \w Espíritu|strong="H7307"\w* me elevó \w entre|strong="H8033"\w* la tierra y el \w cielo|strong="H8064"\w*, y en \w visiones|strong="H4759"\w* divinas me \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* Jerusalén, \w a|strong="H3068"\w* la entrada de la \w puerta|strong="H6607"\w* del atrio \w interior|strong="H6442"\w* \w que|strong="H3027"\w* \w mira|strong="H6437"\w* \w hacia|strong="H8033"\w* el \w norte|strong="H6828"\w*, \w donde|strong="H8033"\w* estaba colocada la imagen de los celos, la \w que|strong="H3027"\w* provoca los celos de Dios.  
\v 4 \w Y|strong="H3068"\w* \w allí|strong="H8033"\w* \w estaba|strong="H2009"\w* la \w gloria|strong="H3519"\w* del Dios de \w Israel|strong="H3478"\w*, igual \w a|strong="H3068"\w* la \w visión|strong="H4758"\w* que \w yo|strong="H2009"\w* había \w visto|strong="H7200"\w* en el valle.   
\p
\v 5 Entonces me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w levanta|strong="H5375"\w* \w ahora|strong="H4994"\w* tus \w ojos|strong="H5869"\w* \w hacia|strong="H1870"\w* \w el|strong="H1121"\w* \w norte|strong="H6828"\w*”. Levanté \w mis|strong="H5375"\w* \w ojos|strong="H5869"\w* \w hacia|strong="H1870"\w* \w el|strong="H1121"\w* \w norte|strong="H6828"\w*, y vi \w que|strong="H4994"\w* al \w norte|strong="H6828"\w* \w de|strong="H1121"\w* la \w puerta|strong="H8179"\w* \w del|strong="H4196"\w* \w altar|strong="H4196"\w*, en la entrada, \w estaba|strong="H2009"\w* aquella imagen \w de|strong="H1121"\w* \w los|strong="H1121"\w* celos.   
\p
\v 6 \w Me|strong="H5921"\w* dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, ¿\w ves|strong="H7200"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w hacen|strong="H6213"\w*? ¡Son \w grandes|strong="H1419"\w* \w las|strong="H1992"\w* \w abominaciones|strong="H8441"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* comete \w aquí|strong="H6311"\w* \w para|strong="H5921"\w* alejarme \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w santuario|strong="H4720"\w*! Pero \w verás|strong="H7200"\w* \w abominaciones|strong="H8441"\w* \w todavía|strong="H5750"\w* \w mayores|strong="H1419"\w*”.   
\p
\v 7 Me llevó \w a|strong="H3068"\w* la entrada del \w atrio|strong="H2691"\w*, y cuando \w miré|strong="H7200"\w*, \w vi|strong="H7200"\w* un \w agujero|strong="H2356"\w* en la \w pared|strong="H7023"\w*.  
\v 8 Entonces me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w cava|strong="H2864"\w* \w ahora|strong="H4994"\w* en la \w pared|strong="H7023"\w*”. Cuando cavé en la \w pared|strong="H7023"\w*, encontré una \w puerta|strong="H6607"\w*.   
\p
\v 9 Me dijo: “Entra y \w mira|strong="H7200"\w* \w las|strong="H1992"\w* perversas \w abominaciones|strong="H8441"\w* \w que|strong="H1992"\w* cometen \w aquí|strong="H6311"\w*”.   
\p
\v 10 \w Entré|strong="H5921"\w* \w y|strong="H5921"\w* \w miré|strong="H7200"\w*, \w y|strong="H5921"\w* \w vi|strong="H7200"\w* \w toda|strong="H3605"\w* clase \w de|strong="H5921"\w* \w reptiles|strong="H7431"\w*, animales repugnantes \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w ídolos|strong="H1544"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, grabados \w por|strong="H5921"\w* \w todas|strong="H3605"\w* \w partes|strong="H5439"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w pared|strong="H7023"\w*.  
\v 11 Frente \w a|strong="H3068"\w* \w ellos|strong="H3027"\w* \w estaban|strong="H5975"\w* \w setenta|strong="H7657"\w* \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*, y \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H6440"\w* \w ellos|strong="H3027"\w* se encontraba Jaazanías, \w hijo|strong="H1121"\w* \w de|strong="H6440"\w* Safán. Cada uno tenía su incensario \w en|strong="H8432"\w* la \w mano|strong="H3027"\w*, y \w subía|strong="H5927"\w* \w el|strong="H1121"\w* aroma \w de|strong="H6440"\w* una \w nube|strong="H6051"\w* \w de|strong="H6440"\w* incienso.  
\v 12 \w Entonces|strong="H3588"\w* \w me|strong="H3588"\w* dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w hombre|strong="H1121"\w*, ¿has \w visto|strong="H7200"\w* \w lo|strong="H6213"\w* \w que|strong="H3588"\w* \w hacen|strong="H6213"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w oscuridad|strong="H2822"\w*, cada uno \w en|strong="H3588"\w* \w la|strong="H3588"\w* habitación \w de|strong="H3588"\w* sus ídolos? \w Porque|strong="H3588"\w* dicen: ‘Yahvé \w no|strong="H6213"\w* nos \w ve|strong="H7200"\w*. Yahvé ha abandonado \w la|strong="H3588"\w* tierra’”.  
\v 13 \w También|strong="H5750"\w* me dijo: “\w Todavía|strong="H5750"\w* \w verás|strong="H7200"\w* \w que|strong="H1992"\w* cometen \w abominaciones|strong="H8441"\w* \w mayores|strong="H1419"\w* \w que|strong="H1992"\w* \w estas|strong="H1992"\w*”.   
\p
\v 14 Me llevó \w a|strong="H3068"\w* la entrada de la \w puerta|strong="H6607"\w* de la \w casa|strong="H1004"\w* de Yahvé que da al \w norte|strong="H6828"\w*, y vi \w allí|strong="H8033"\w* \w a|strong="H3068"\w* unas mujeres \w sentadas|strong="H3427"\w*, \w llorando|strong="H1058"\w* por \w el|strong="H3427"\w* \w dios|strong="H3068"\w* Tamuz.  
\v 15 \w Y|strong="H3068"\w* me dijo: “¿Has \w visto|strong="H7200"\w* esto, \w hijo|strong="H1121"\w* \w de|strong="H5750"\w* \w hombre|strong="H1121"\w*? \w Aún|strong="H5750"\w* \w verás|strong="H7200"\w* \w abominaciones|strong="H8441"\w* \w mayores|strong="H1419"\w* \w que|strong="H1121"\w* estas”.   
\p
\v 16 Luego me llevó al \w atrio|strong="H2691"\w* \w interior|strong="H6442"\w* \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé. \w Y|strong="H3068"\w* allí, \w a|strong="H3068"\w* la entrada \w del|strong="H4196"\w* \w templo|strong="H1964"\w* \w de|strong="H6440"\w* Yahvé, entre \w el|strong="H1992"\w* pórtico y \w el|strong="H1992"\w* \w altar|strong="H4196"\w*, había \w unos|strong="H1992"\w* \w veinticinco|strong="H6242"\w* hombres con la espalda \w hacia|strong="H6440"\w* \w el|strong="H1992"\w* \w templo|strong="H1964"\w* \w de|strong="H6440"\w* Yahvé y \w el|strong="H1992"\w* \w rostro|strong="H6440"\w* \w hacia|strong="H6440"\w* \w el|strong="H1992"\w* \w oriente|strong="H6924"\w*; y \w se|strong="H1992"\w* postraban \w hacia|strong="H6440"\w* \w el|strong="H1992"\w* \w oriente|strong="H6924"\w* para adorar al \w sol|strong="H8121"\w*.  
\v 17 \w Entonces|strong="H3588"\w* \w me|strong="H3588"\w* dijo: “¿Has \w visto|strong="H7200"\w* \w esto|strong="H6213"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w hombre|strong="H1121"\w*? ¿Le parece \w poco|strong="H7043"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* cometer las \w abominaciones|strong="H8441"\w* \w que|strong="H3588"\w* \w hacen|strong="H6213"\w* \w aquí|strong="H6311"\w*? \w No|strong="H6213"\w* solo han llenado \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w violencia|strong="H2555"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w vuelven|strong="H7725"\w* \w a|strong="H3068"\w* provocar mi ira. ¡Míralos \w cómo|strong="H3588"\w* se llevan \w la|strong="H3588"\w* rama \w a|strong="H3068"\w* \w la|strong="H3588"\w* nariz!  
\v 18 Por eso \w yo|strong="H6213"\w* \w también|strong="H1571"\w* actuaré \w con|strong="H1571"\w* furia. Mi \w ojo|strong="H5869"\w* \w no|strong="H3808"\w* \w perdonará|strong="H2550"\w* \w ni|strong="H3808"\w* tendré compasión. \w Aunque|strong="H1571"\w* griten \w a|strong="H3068"\w* mis \w oídos|strong="H8085"\w* \w con|strong="H1571"\w* \w gran|strong="H1419"\w* \w voz|strong="H6963"\w*, \w no|strong="H3808"\w* los \w escucharé|strong="H8085"\w*”.   
\c 9  
\p
\v 1 Entonces \w gritó|strong="H7121"\w* \w a|strong="H3068"\w* mis oídos con \w gran|strong="H1419"\w* \w voz|strong="H6963"\w*: “¡\w Que|strong="H3027"\w* se acerquen los verdugos de la \w ciudad|strong="H5892"\w*, cada uno con su arma de destrucción en la \w mano|strong="H3027"\w*!”.  
\v 2 \w Y|strong="H3068"\w* vi \w que|strong="H3027"\w* \w seis|strong="H8337"\w* hombres venían \w del|strong="H4196"\w* \w camino|strong="H1870"\w* \w de|strong="H3847"\w* la \w puerta|strong="H8179"\w* superior \w que|strong="H3027"\w* da al \w norte|strong="H6828"\w*, cada uno con su arma mortal \w en|strong="H8432"\w* la \w mano|strong="H3027"\w*. \w En|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3847"\w* \w ellos|strong="H3027"\w* \w había|strong="H5975"\w* un hombre \w vestido|strong="H3847"\w* \w de|strong="H3847"\w* lino, \w que|strong="H3027"\w* traía \w a|strong="H3068"\w* su \w lado|strong="H3027"\w* un estuche \w de|strong="H3847"\w* escribano. Entraron y se pararon \w junto|strong="H3027"\w* al \w altar|strong="H4196"\w* \w de|strong="H3847"\w* bronce.   
\p
\v 3 \w La|strong="H5921"\w* \w gloria|strong="H3519"\w* \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w se|strong="H1961"\w* elevó \w de|strong="H5921"\w* \w encima|strong="H5921"\w* \w del|strong="H5921"\w* \w querubín|strong="H3742"\w*, \w donde|strong="H5921"\w* \w había|strong="H1961"\w* \w estado|strong="H1961"\w*, \w y|strong="H5921"\w* \w se|strong="H1961"\w* movió \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w umbral|strong="H4670"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*. Entonces \w llamó|strong="H7121"\w* \w al|strong="H5921"\w* hombre \w vestido|strong="H3847"\w* \w de|strong="H5921"\w* lino \w que|strong="H5921"\w* \w llevaba|strong="H1961"\w* \w el|strong="H5921"\w* estuche \w de|strong="H5921"\w* escribano \w a|strong="H3068"\w* su lado,  
\v 4 \w y|strong="H5921"\w* Yahvé \w le|strong="H5921"\w* dijo: “\w Pasa|strong="H5674"\w* \w por|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*, \w por|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* Jerusalén, \w y|strong="H5921"\w* pon una marca \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w frente|strong="H4696"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* hombres \w que|strong="H5921"\w* gimen \w y|strong="H5921"\w* lloran \w por|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w abominaciones|strong="H8441"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* cometen \w en|strong="H5921"\w* \w ella|strong="H5921"\w*”.   
\p
\v 5 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* otros \w les|strong="H5921"\w* dijo, \w de|strong="H5921"\w* modo \w que|strong="H5921"\w* yo \w lo|strong="H5921"\w* oí: “Pasen \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* detrás \w de|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* maten; \w no|strong="H5921"\w* tengan piedad ni compasión.  
\v 6 \w Maten|strong="H2026"\w* \w a|strong="H3068"\w* \w viejos|strong="H2205"\w*, jóvenes \w y|strong="H5921"\w* \w vírgenes|strong="H1330"\w*, \w a|strong="H3068"\w* \w niños|strong="H2945"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* mujeres, \w hasta|strong="H5921"\w* acabar \w con|strong="H5921"\w* \w todos|strong="H3605"\w*; pero \w no|strong="H5921"\w* toquen \w a|strong="H3068"\w* \w nadie|strong="H3605"\w* \w que|strong="H5921"\w* tenga \w la|strong="H5921"\w* marca. Empiecen \w por|strong="H5921"\w* \w mi|strong="H5921"\w* \w santuario|strong="H4720"\w*”. Así \w que|strong="H5921"\w* \w comenzaron|strong="H2490"\w* \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w ancianos|strong="H2205"\w* \w que|strong="H5921"\w* estaban frente \w al|strong="H5921"\w* \w templo|strong="H1004"\w*.   
\p
\v 7 \w Y|strong="H3068"\w* les dijo: “Profanen el \w templo|strong="H1004"\w* y llenen los \w atrios|strong="H2691"\w* de cadáveres. ¡\w Salgan|strong="H3318"\w*!”. Ellos \w salieron|strong="H3318"\w* y \w comenzaron|strong="H2491"\w* \w a|strong="H3068"\w* matar por la \w ciudad|strong="H5892"\w*.   
\p
\v 8 \w Mientras|strong="H3605"\w* \w ellos|strong="H5921"\w* mataban, yo \w me|strong="H5921"\w* \w quedé|strong="H7604"\w* solo; \w me|strong="H5921"\w* postré \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra \w y|strong="H5921"\w* grité: “¡Ay, Señor Yahvé! ¿Vas \w a|strong="H3068"\w* \w destruir|strong="H7843"\w* \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* remanente \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w al|strong="H5921"\w* derramar tu \w ira|strong="H2534"\w* \w sobre|strong="H5921"\w* Jerusalén?”.   
\p
\v 9 \w Él|strong="H3588"\w* \w me|strong="H3588"\w* respondió: “\w La|strong="H3588"\w* \w maldad|strong="H5771"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w es|strong="H3588"\w* enorme; \w la|strong="H3588"\w* tierra está \w llena|strong="H4390"\w* \w de|strong="H3588"\w* \w sangre|strong="H1818"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w llena|strong="H4390"\w* \w de|strong="H3588"\w* injusticia. \w Porque|strong="H3588"\w* dicen: ‘Yahvé ha abandonado \w la|strong="H3588"\w* tierra; Yahvé \w no|strong="H3588"\w* \w ve|strong="H7200"\w* nada’.  
\v 10 \w Por|strong="H1870"\w* eso, \w tampoco|strong="H1571"\w* yo tendré piedad \w ni|strong="H3808"\w* \w perdonaré|strong="H2550"\w*; \w haré|strong="H5414"\w* recaer su propia conducta sobre su \w cabeza|strong="H7218"\w*”.   
\p
\v 11 En ese momento, \w el|strong="H6213"\w* hombre \w vestido|strong="H3830"\w* \w de|strong="H1697"\w* lino \w que|strong="H1697"\w* traía \w el|strong="H6213"\w* tintero \w a|strong="H3068"\w* su lado regresó con \w el|strong="H6213"\w* informe: “He \w hecho|strong="H6213"\w* exactamente \w lo|strong="H1697"\w* \w que|strong="H1697"\w* me \w mandaste|strong="H6680"\w*”.   
\c 10  
\p
\v 1 Entonces \w miré|strong="H7200"\w*, \w y|strong="H5921"\w* \w vi|strong="H7200"\w* \w que|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* bóveda \w que|strong="H5921"\w* \w estaba|strong="H2009"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w querubines|strong="H3742"\w* había algo parecido \w a|strong="H3068"\w* una piedra \w de|strong="H5921"\w* zafiro, \w que|strong="H5921"\w* tenía \w la|strong="H5921"\w* \w apariencia|strong="H4758"\w* \w de|strong="H5921"\w* un \w trono|strong="H3678"\w*.  
\v 2 Yahvé \w le|strong="H5921"\w* habló \w al|strong="H5921"\w* hombre \w vestido|strong="H3847"\w* \w de|strong="H5921"\w* lino \w y|strong="H5921"\w* \w le|strong="H5921"\w* dijo: “Entra \w entre|strong="H5921"\w* \w las|strong="H5921"\w* ruedas \w que|strong="H5921"\w* giran, \w debajo|strong="H8478"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w querubines|strong="H3742"\w*; \w llena|strong="H4390"\w* tus manos \w con|strong="H5921"\w* \w brasas|strong="H1513"\w* encendidas \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w y|strong="H5921"\w* espárcelas \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*”. \w Y|strong="H3068"\w* \w él|strong="H5921"\w* entró mientras yo \w miraba|strong="H5869"\w*.  
\v 3 Los \w querubines|strong="H3742"\w* \w estaban|strong="H5975"\w* al lado \w derecho|strong="H3225"\w* del \w templo|strong="H1004"\w* cuando el hombre entró, y la \w nube|strong="H6051"\w* llenaba el \w atrio|strong="H2691"\w* \w interior|strong="H6442"\w*.  
\v 4 \w La|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* levantó \w de|strong="H5921"\w* \w encima|strong="H5921"\w* \w del|strong="H5921"\w* \w querubín|strong="H3742"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* movió \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w umbral|strong="H4670"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w*; entonces \w el|strong="H5921"\w* \w templo|strong="H1004"\w* \w se|strong="H5921"\w* \w llenó|strong="H4390"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w nube|strong="H6051"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w atrio|strong="H2691"\w* \w se|strong="H5921"\w* \w llenó|strong="H4390"\w* \w del|strong="H5921"\w* \w resplandor|strong="H5051"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé.  
\v 5 El \w sonido|strong="H6963"\w* \w de|strong="H5704"\w* las \w alas|strong="H3671"\w* \w de|strong="H5704"\w* los \w querubines|strong="H3742"\w* se \w oía|strong="H8085"\w* \w hasta|strong="H5704"\w* \w en|strong="H5704"\w* el \w atrio|strong="H2691"\w* \w exterior|strong="H2435"\w*, \w como|strong="H5704"\w* la \w voz|strong="H6963"\w* del Dios \w Todopoderoso|strong="H7706"\w* \w cuando|strong="H5704"\w* \w habla|strong="H1696"\w*.   
\p
\v 6 \w Cuando|strong="H1961"\w* le \w ordenó|strong="H6680"\w* al hombre \w vestido|strong="H3847"\w* \w de|strong="H3847"\w* lino: “\w Toma|strong="H3947"\w* fuego \w de|strong="H3847"\w* entre las ruedas, \w de|strong="H3847"\w* entre \w los|strong="H1961"\w* \w querubines|strong="H3742"\w*”, él entró y \w se|strong="H1961"\w* paró junto \w a|strong="H3068"\w* una \w rueda|strong="H1534"\w*.  
\v 7 Entonces uno \w de|strong="H3847"\w* los \w querubines|strong="H3742"\w* \w extendió|strong="H7971"\w* la \w mano|strong="H3027"\w* hacia el fuego \w que|strong="H3027"\w* estaba entre \w ellos|strong="H3027"\w*, \w tomó|strong="H3947"\w* un poco y lo \w puso|strong="H5414"\w* \w en|strong="H3318"\w* las \w manos|strong="H3027"\w* del hombre \w vestido|strong="H3847"\w* \w de|strong="H3847"\w* lino, quien lo \w tomó|strong="H3947"\w* y \w salió|strong="H3318"\w*.  
\v 8 \w Debajo|strong="H8478"\w* \w de|strong="H8478"\w* las \w alas|strong="H3671"\w* \w de|strong="H8478"\w* los \w querubines|strong="H3742"\w* \w apareció|strong="H7200"\w* algo \w que|strong="H3027"\w* tenía la forma \w de|strong="H8478"\w* una \w mano|strong="H3027"\w* humana.   
\p
\v 9 \w Miré|strong="H7200"\w*, y \w vi|strong="H7200"\w* cuatro ruedas junto \w a|strong="H3068"\w* los \w querubines|strong="H3742"\w*, una rueda junto \w a|strong="H3068"\w* cada \w querubín|strong="H3742"\w*. El \w aspecto|strong="H4758"\w* \w de|strong="H5869"\w* las ruedas era como el brillo del berilo.  
\v 10 \w En|strong="H8432"\w* cuanto \w a|strong="H3068"\w* su \w apariencia|strong="H4758"\w*, las cuatro \w eran|strong="H1961"\w* iguales, \w como|strong="H1961"\w* \w si|strong="H1961"\w* una rueda estuviera \w dentro|strong="H8432"\w* de otra rueda.  
\v 11 \w Cuando|strong="H3588"\w* avanzaban, \w lo|strong="H3808"\w* hacían \w en|strong="H3588"\w* cualquiera \w de|strong="H3588"\w* las cuatro direcciones. \w No|strong="H3808"\w* giraban al avanzar, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w iban|strong="H3212"\w* hacia \w donde|strong="H4725"\w* apuntaba \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w*; \w no|strong="H3808"\w* giraban \w mientras|strong="H3588"\w* \w iban|strong="H3212"\w*.  
\v 12 \w Todo|strong="H3605"\w* su cuerpo, sus espaldas, sus \w manos|strong="H3027"\w*, sus \w alas|strong="H3671"\w* y las ruedas estaban \w llenos|strong="H4392"\w* \w de|strong="H5869"\w* \w ojos|strong="H5869"\w* \w por|strong="H3027"\w* \w todas|strong="H3605"\w* \w partes|strong="H3027"\w*; así eran las ruedas \w de|strong="H5869"\w* \w los|strong="H3605"\w* cuatro.  
\v 13 En cuanto \w a|strong="H3068"\w* las ruedas, oí que las \w llamaban|strong="H7121"\w* “ruedas giratorias”.  
\v 14 Cada uno tenía cuatro caras. La primera \w cara|strong="H6440"\w* era \w de|strong="H6440"\w* \w querubín|strong="H3742"\w*; la \w segunda|strong="H8145"\w*, \w cara|strong="H6440"\w* \w de|strong="H6440"\w* hombre; la \w tercera|strong="H7992"\w*, \w cara|strong="H6440"\w* \w de|strong="H6440"\w* león; y la cuarta, \w cara|strong="H6440"\w* \w de|strong="H6440"\w* águila.   
\p
\v 15 Entonces \w los|strong="H1931"\w* \w querubines|strong="H3742"\w* \w se|strong="H1931"\w* elevaron. Eran \w los|strong="H1931"\w* mismos seres \w vivientes|strong="H2416"\w* \w que|strong="H1931"\w* \w vi|strong="H7200"\w* junto al \w río|strong="H5104"\w* Quebar.  
\v 16 \w Cuando|strong="H1571"\w* \w los|strong="H1992"\w* \w querubines|strong="H3742"\w* avanzaban, \w las|strong="H1992"\w* ruedas avanzaban \w a|strong="H3068"\w* \w su|strong="H1992"\w* lado; \w y|strong="H1571"\w* \w cuando|strong="H1571"\w* \w los|strong="H1992"\w* \w querubines|strong="H3742"\w* \w alzaban|strong="H5375"\w* \w sus|strong="H1992"\w* \w alas|strong="H3671"\w* \w para|strong="H5921"\w* elevarse \w del|strong="H5921"\w* suelo, \w las|strong="H1992"\w* ruedas \w no|strong="H3808"\w* \w se|strong="H5921"\w* apartaban \w de|strong="H5921"\w* \w su|strong="H1992"\w* lado.  
\v 17 \w Si|strong="H3588"\w* ellos se detenían, ellas se detenían; \w si|strong="H3588"\w* ellos se elevaban, ellas se elevaban \w con|strong="H3588"\w* ellos, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w espíritu|strong="H7307"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* seres \w vivientes|strong="H2416"\w* \w estaba|strong="H5975"\w* \w en|strong="H3588"\w* ellas.   
\p
\v 18 \w La|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w salió|strong="H3318"\w* \w del|strong="H5921"\w* \w umbral|strong="H4670"\w* \w del|strong="H5921"\w* \w templo|strong="H1004"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* colocó \w sobre|strong="H5921"\w* \w los|strong="H5921"\w* \w querubines|strong="H3742"\w*.  
\v 19 Mientras \w yo|strong="H4480"\w* \w miraba|strong="H5869"\w*, \w los|strong="H5921"\w* \w querubines|strong="H3742"\w* desplegaron sus \w alas|strong="H3671"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* elevaron \w del|strong="H4480"\w* suelo \w para|strong="H5921"\w* \w salir|strong="H3318"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* ruedas \w se|strong="H5921"\w* \w fueron|strong="H5869"\w* \w con|strong="H5921"\w* \w ellos|strong="H5921"\w*. \w Se|strong="H5921"\w* detuvieron \w a|strong="H3068"\w* \w la|strong="H5921"\w* entrada \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w puerta|strong="H6607"\w* oriental \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H4480"\w* Yahvé, \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w del|strong="H4480"\w* \w Dios|strong="H3068"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w* \w estaba|strong="H5975"\w* \w por|strong="H5921"\w* \w encima|strong="H4605"\w* \w de|strong="H4480"\w* \w ellos|strong="H5921"\w*.   
\p
\v 20 \w Estos|strong="H1992"\w* eran \w los|strong="H1992"\w* seres \w vivientes|strong="H2416"\w* \w que|strong="H3588"\w* \w vi|strong="H7200"\w* \w debajo|strong="H8478"\w* del Dios \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* junto \w al|strong="H8478"\w* \w río|strong="H5104"\w* Quebar; \w y|strong="H3588"\w* \w supe|strong="H3045"\w* \w que|strong="H3588"\w* eran \w querubines|strong="H3742"\w*.  
\v 21 Cada uno tenía cuatro caras y cuatro \w alas|strong="H3671"\w*, y \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* sus \w alas|strong="H3671"\w* había algo semejante \w a|strong="H3068"\w* \w manos|strong="H3027"\w* humanas.  
\v 22 \w En|strong="H5921"\w* \w cuanto|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w forma|strong="H1823"\w* \w de|strong="H5921"\w* \w sus|strong="H1992"\w* caras, eran \w las|strong="H1992"\w* mismas \w que|strong="H5921"\w* \w vi|strong="H7200"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w río|strong="H5104"\w* Quebar; tenían \w la|strong="H5921"\w* misma \w apariencia|strong="H4758"\w* \w y|strong="H5921"\w* eran \w los|strong="H1992"\w* \w mismos|strong="H1992"\w* seres. Cada uno avanzaba \w de|strong="H5921"\w* frente.   
\c 11  
\p
\v 1 \w El|strong="H1121"\w* \w Espíritu|strong="H7307"\w* me elevó y me \w llevó|strong="H5375"\w* \w a|strong="H3068"\w* la \w puerta|strong="H6607"\w* \w oriental|strong="H6921"\w* \w de|strong="H2568"\w* la \w casa|strong="H1004"\w* \w de|strong="H2568"\w* Yahvé, la \w que|strong="H5971"\w* \w mira|strong="H7200"\w* hacia \w el|strong="H1121"\w* oriente. Allí, \w a|strong="H3068"\w* la entrada \w de|strong="H2568"\w* la \w puerta|strong="H6607"\w*, había \w veinticinco|strong="H6242"\w* \w hombres|strong="H1121"\w*, y \w vi|strong="H7200"\w* \w entre|strong="H8432"\w* ellos \w a|strong="H3068"\w* Jaazanías, \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Azur|strong="H5809"\w*, y \w a|strong="H3068"\w* \w Pelatías|strong="H6410"\w*, \w hijo|strong="H1121"\w* \w de|strong="H2568"\w* \w Benaía|strong="H1141"\w*, líderes del \w pueblo|strong="H5971"\w*.  
\v 2 \w Y|strong="H3068"\w* me dijo: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w estos|strong="H2063"\w* son \w los|strong="H1121"\w* \w hombres|strong="H1121"\w* \w que|strong="H1121"\w* traman \w maldad|strong="H7451"\w* y dan \w perversos|strong="H1121"\w* \w consejos|strong="H6098"\w* en \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*.  
\v 3 \w Son|strong="H3808"\w* \w los|strong="H1931"\w* \w que|strong="H1931"\w* dicen: ‘\w No|strong="H3808"\w* \w es|strong="H1931"\w* \w el|strong="H1931"\w* momento de \w edificar|strong="H1129"\w* \w casas|strong="H1004"\w*. \w Esta|strong="H1931"\w* ciudad \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w olla|strong="H5518"\w*, y \w nosotros|strong="H1931"\w* somos \w la|strong="H1931"\w* \w carne|strong="H1320"\w*’.  
\v 4 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w profetiza|strong="H5012"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*; ¡\w profetiza|strong="H5012"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*!”.   
\p
\v 5 \w Entonces|strong="H3651"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Yahvé \w vino|strong="H5307"\w* \w sobre|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w me|strong="H5921"\w* ordenó: “Diles: \w Así|strong="H3541"\w* dice Yahvé: ‘Ustedes han hablado \w de|strong="H5921"\w* \w esa|strong="H3651"\w* manera, \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w y|strong="H5921"\w* yo \w sé|strong="H3045"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* pasa \w por|strong="H5921"\w* \w la|strong="H5921"\w* mente.  
\v 6 Han multiplicado sus \w muertos|strong="H2491"\w* en \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* y han llenado sus \w calles|strong="H2351"\w* de cadáveres’”.   
\p
\v 7 “\w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H1931"\w* Señor Yahvé: ‘\w Los|strong="H1992"\w* \w muertos|strong="H2491"\w* \w que|strong="H1931"\w* ustedes han puesto \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de \w la|strong="H1931"\w* ciudad, \w ellos|strong="H1992"\w* son \w la|strong="H1931"\w* \w carne|strong="H1320"\w*, \w y|strong="H3541"\w* \w la|strong="H1931"\w* ciudad \w es|strong="H1931"\w* \w la|strong="H1931"\w* \w olla|strong="H5518"\w*; pero \w a|strong="H3068"\w* ustedes \w los|strong="H1992"\w* sacaré de ahí.  
\v 8 Ustedes \w temen|strong="H3372"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w espada|strong="H2719"\w*, pues traeré \w espada|strong="H2719"\w* \w contra|strong="H5921"\w* ustedes’, \w dice|strong="H5002"\w* \w el|strong="H5921"\w* Señor Yahvé.  
\v 9 ‘Los sacaré \w de|strong="H5414"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H5414"\w* la ciudad, los \w entregaré|strong="H5414"\w* \w en|strong="H8432"\w* \w manos|strong="H3027"\w* \w de|strong="H5414"\w* extranjeros y \w ejecutaré|strong="H6213"\w* \w juicios|strong="H8201"\w* contra ustedes.  
\v 10 \w Caerán|strong="H5307"\w* \w a|strong="H3068"\w* filo \w de|strong="H5921"\w* \w espada|strong="H2719"\w*; \w en|strong="H5921"\w* \w la|strong="H5921"\w* frontera \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w los|strong="H5921"\w* \w juzgaré|strong="H8199"\w*, \w y|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.  
\v 11 \w Esta|strong="H1931"\w* ciudad \w no|strong="H3808"\w* \w será|strong="H1961"\w* \w su|strong="H1931"\w* \w olla|strong="H5518"\w*, \w ni|strong="H3808"\w* ustedes \w serán|strong="H1961"\w* \w la|strong="H1931"\w* \w carne|strong="H1320"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de \w ella|strong="H1931"\w*; \w en|strong="H8432"\w* \w la|strong="H1931"\w* frontera de \w Israel|strong="H3478"\w* \w los|strong="H1931"\w* \w juzgaré|strong="H8199"\w*.  
\v 12 \w Y|strong="H3068"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* han seguido mis leyes \w ni|strong="H3808"\w* han \w cumplido|strong="H6213"\w* mis mandatos, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* han actuado según las costumbres \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* \w los|strong="H3588"\w* \w rodean|strong="H5439"\w*’”.   
\p
\v 13 Mientras \w yo|strong="H6213"\w* profetizaba, \w murió|strong="H4191"\w* \w Pelatías|strong="H6410"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w Benaía|strong="H1141"\w*. Entonces \w me|strong="H5921"\w* postré \w rostro|strong="H6440"\w* \w en|strong="H5921"\w* tierra \w y|strong="H5921"\w* grité \w con|strong="H5921"\w* \w gran|strong="H1419"\w* \w voz|strong="H6963"\w*: “¡Ay, Señor Yahvé! ¿Vas \w a|strong="H3068"\w* exterminar \w a|strong="H3068"\w* todo \w el|strong="H5921"\w* \w resto|strong="H7611"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*?”.   
\p
\v 14 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 15 “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, tus hermanos, tus parientes, \w los|strong="H3427"\w* \w hombres|strong="H1121"\w* \w de|strong="H5921"\w* tu propia \w familia|strong="H1004"\w* \w y|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w todos|strong="H3605"\w* \w ellos|strong="H1931"\w*, son \w aquellos|strong="H3605"\w* \w a|strong="H3068"\w* quienes \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* Jerusalén han dicho: ‘Aléjense \w de|strong="H5921"\w* Yahvé; \w esta|strong="H1931"\w* tierra \w se|strong="H1931"\w* \w nos|strong="H5921"\w* ha \w dado|strong="H5414"\w* \w a|strong="H3068"\w* \w nosotros|strong="H3605"\w* \w en|strong="H5921"\w* \w posesión|strong="H4181"\w*’.   
\p
\v 16 “\w Por|strong="H3588"\w* \w tanto|strong="H3651"\w*, diles: \w Así|strong="H3541"\w* dice \w el|strong="H3588"\w* Señor Yahvé: ‘\w Aunque|strong="H3588"\w* \w los|strong="H1961"\w* he alejado \w entre|strong="H3588"\w* las \w naciones|strong="H1471"\w* \w y|strong="H3588"\w* \w los|strong="H1961"\w* he dispersado \w por|strong="H3588"\w* otros países, \w yo|strong="H3588"\w* \w seré|strong="H1961"\w* \w para|strong="H3588"\w* ellos un \w santuario|strong="H4720"\w* \w por|strong="H3588"\w* un tiempo \w en|strong="H3588"\w* \w los|strong="H1961"\w* lugares \w a|strong="H3068"\w* \w donde|strong="H8033"\w* han ido’.   
\p
\v 17 “\w Por|strong="H4480"\w* \w tanto|strong="H3651"\w*, diles: \w Así|strong="H3541"\w* dice el Señor Yahvé: ‘\w Yo|strong="H4480"\w* los reuniré \w de|strong="H4480"\w* \w entre|strong="H4480"\w* los \w pueblos|strong="H5971"\w*, los \w juntaré|strong="H6908"\w* \w de|strong="H4480"\w* los países donde están dispersos \w y|strong="H3541"\w* les \w daré|strong="H5414"\w* la tierra \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*’.   
\p
\v 18 “\w Ellos|strong="H4480"\w* volverán \w allá|strong="H8033"\w* y quitarán \w de|strong="H4480"\w* \w ella|strong="H8033"\w* \w todas|strong="H3605"\w* sus cosas detestables y \w todas|strong="H3605"\w* sus \w abominaciones|strong="H8441"\w*.  
\v 19 Les \w daré|strong="H5414"\w* un \w corazón|strong="H3820"\w* íntegro y \w pondré|strong="H5414"\w* un \w espíritu|strong="H7307"\w* \w nuevo|strong="H2319"\w* \w dentro|strong="H7130"\w* \w de|strong="H5414"\w* ellos. \w Quitaré|strong="H5493"\w* \w de|strong="H5414"\w* su \w carne|strong="H1320"\w* el \w corazón|strong="H3820"\w* \w de|strong="H5414"\w* piedra y les \w daré|strong="H5414"\w* un \w corazón|strong="H3820"\w* \w de|strong="H5414"\w* \w carne|strong="H1320"\w*,  
\v 20 \w para|strong="H4616"\w* \w que|strong="H5971"\w* caminen según mis leyes y \w guarden|strong="H8104"\w* mis decretos y \w los|strong="H1961"\w* cumplan. \w Ellos|strong="H2708"\w* \w serán|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* y \w yo|strong="H6213"\w* \w seré|strong="H1961"\w* su Dios.  
\v 21 Pero en cuanto \w a|strong="H3068"\w* aquellos cuyo \w corazón|strong="H3820"\w* se \w va|strong="H3068"\w* tras sus cosas detestables y sus \w abominaciones|strong="H8441"\w*, \w haré|strong="H5414"\w* recaer su propia conducta sobre sus \w cabezas|strong="H7218"\w*”, \w dice|strong="H5002"\w* el Señor Yahvé.   
\p
\v 22 Entonces \w los|strong="H5921"\w* \w querubines|strong="H3742"\w* \w alzaron|strong="H5375"\w* sus \w alas|strong="H3671"\w*, \w con|strong="H5921"\w* \w las|strong="H5921"\w* ruedas \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ellos|strong="H5921"\w*; \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* estaba \w por|strong="H5921"\w* \w encima|strong="H4605"\w* \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 23 \w La|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* Yahvé \w se|strong="H5921"\w* elevó \w de|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* detuvo \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w que|strong="H5921"\w* \w está|strong="H5975"\w* \w al|strong="H5921"\w* \w oriente|strong="H6924"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w ciudad|strong="H5892"\w*.  
\v 24 \w Luego|strong="H5927"\w* \w el|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w me|strong="H5921"\w* \w levantó|strong="H5375"\w* \w y|strong="H5921"\w*, \w en|strong="H5921"\w* una \w visión|strong="H4758"\w* \w del|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Dios, \w me|strong="H5921"\w* \w llevó|strong="H5375"\w* \w a|strong="H3068"\w* Caldea, \w a|strong="H3068"\w* \w donde|strong="H5921"\w* estaban \w los|strong="H5921"\w* exiliados. \w Y|strong="H3068"\w* \w la|strong="H5921"\w* \w visión|strong="H4758"\w* \w que|strong="H5921"\w* había \w visto|strong="H7200"\w* \w se|strong="H5921"\w* alejó \w de|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 25 Entonces conté \w a|strong="H3068"\w* \w los|strong="H3605"\w* exiliados \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé me había mostrado.   
\c 12  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w hombre|strong="H1121"\w*, tú vives \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3588"\w* un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*, \w que|strong="H3588"\w* tiene \w ojos|strong="H5869"\w* \w para|strong="H3588"\w* \w ver|strong="H7200"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w ve|strong="H7200"\w*, \w y|strong="H3588"\w* \w oídos|strong="H8085"\w* \w para|strong="H3588"\w* \w oír|strong="H8085"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w oye|strong="H8085"\w*, \w porque|strong="H3588"\w* \w son|strong="H3588"\w* un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*.   
\p
\v 3 “\w Por|strong="H3588"\w* eso \w tú|strong="H6213"\w*, \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* \w hombre|strong="H1121"\w*, prepara \w tu|strong="H6213"\w* equipaje \w como|strong="H3588"\w* \w si|strong="H3588"\w* fueras al exilio \w y|strong="H3588"\w* sal \w de|strong="H3588"\w* \w día|strong="H3119"\w*, \w a|strong="H3068"\w* \w la|strong="H3588"\w* vista \w de|strong="H3588"\w* \w ellos|strong="H1992"\w*. Múdate \w de|strong="H3588"\w* \w tu|strong="H6213"\w* \w lugar|strong="H4725"\w* \w a|strong="H3068"\w* otro frente \w a|strong="H3068"\w* \w sus|strong="H1992"\w* propios \w ojos|strong="H5869"\w*. Tal vez \w se|strong="H1992"\w* den cuenta, \w aunque|strong="H3588"\w* sean un \w pueblo|strong="H1992"\w* \w rebelde|strong="H4805"\w*.  
\v 4 \w Saca|strong="H3318"\w* tu equipaje \w de|strong="H5869"\w* \w día|strong="H3119"\w* \w a|strong="H3068"\w* la vista \w de|strong="H5869"\w* ellos, como equipaje \w de|strong="H5869"\w* exiliado. \w Y|strong="H3068"\w* tú \w saldrás|strong="H3318"\w* por la \w tarde|strong="H6153"\w*, ante sus \w ojos|strong="H5869"\w*, como quienes van al \w cautiverio|strong="H1473"\w*.  
\v 5 Haz un agujero \w en|strong="H3318"\w* el muro \w a|strong="H3068"\w* la vista \w de|strong="H5869"\w* ellos y \w sal|strong="H3318"\w* por ahí.  
\v 6 Carga tus cosas \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w hombro|strong="H3802"\w* frente \w a|strong="H3068"\w* \w ellos|strong="H5921"\w* \w y|strong="H3588"\w* sácalas \w en|strong="H5921"\w* \w la|strong="H5921"\w* oscuridad. Cúbrete \w el|strong="H5921"\w* \w rostro|strong="H6440"\w* \w para|strong="H5921"\w* \w no|strong="H3808"\w* \w ver|strong="H7200"\w* \w la|strong="H5921"\w* tierra, \w porque|strong="H3588"\w* \w te|strong="H5869"\w* he \w puesto|strong="H3588"\w* \w como|strong="H3588"\w* una señal \w para|strong="H5921"\w* \w el|strong="H5921"\w* pueblo \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*”.   
\p
\v 7 \w Hice|strong="H6213"\w* exactamente \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* \w ordenó|strong="H6680"\w*. \w Saqué|strong="H3318"\w* \w mi|strong="H5921"\w* equipaje \w de|strong="H5921"\w* \w día|strong="H3119"\w*, \w como|strong="H5921"\w* equipaje \w de|strong="H5921"\w* exiliado, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w tarde|strong="H6153"\w* \w hice|strong="H6213"\w* un agujero \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w pared|strong="H7023"\w* \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w*. \w Salí|strong="H3318"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* oscuridad \w y|strong="H5921"\w* \w llevé|strong="H5375"\w* \w mis|strong="H5375"\w* cosas \w al|strong="H5921"\w* \w hombro|strong="H3802"\w*, \w a|strong="H3068"\w* \w la|strong="H5921"\w* vista \w de|strong="H5921"\w* \w ellos|strong="H3027"\w*.   
\p
\v 8 \w A|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente, \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé y me dijo:  
\v 9 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, ¿\w no|strong="H3808"\w* te \w ha|strong="H3808"\w* preguntado la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, ese pueblo \w rebelde|strong="H4805"\w*: ‘¿\w Qué|strong="H4100"\w* \w estás|strong="H6213"\w* \w haciendo|strong="H6213"\w*?’.   
\p
\v 10 “Diles: \w Así|strong="H3541"\w* dice \w el|strong="H3605"\w* Señor Yahvé: ‘\w Este|strong="H2088"\w* mensaje profético tiene \w que|strong="H2088"\w* ver con \w el|strong="H3605"\w* \w príncipe|strong="H5387"\w* \w en|strong="H8432"\w* Jerusalén \w y|strong="H3541"\w* con \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w pueblo|strong="H1992"\w* de \w Israel|strong="H3478"\w* \w que|strong="H2088"\w* vive \w allí|strong="H3541"\w*’.   
\p
\v 11 “Diles: ‘\w Yo|strong="H6213"\w* soy una señal para ustedes’. \w Lo|strong="H6213"\w* mismo que \w yo|strong="H6213"\w* he \w hecho|strong="H6213"\w* \w se|strong="H3651"\w* \w hará|strong="H6213"\w* con ellos: \w irán|strong="H3212"\w* al destierro, al \w cautiverio|strong="H1473"\w*.   
\p
\v 12 “‘\w El|strong="H1931"\w* \w príncipe|strong="H5387"\w* \w que|strong="H1931"\w* \w está|strong="H1931"\w* \w entre|strong="H8432"\w* \w ellos|strong="H1931"\w* cargará \w sus|strong="H1931"\w* cosas al \w hombro|strong="H3802"\w* \w en|strong="H8432"\w* \w la|strong="H1931"\w* oscuridad y \w saldrá|strong="H3318"\w*. Harán un agujero \w en|strong="H8432"\w* \w la|strong="H1931"\w* \w pared|strong="H7023"\w* \w para|strong="H3282"\w* sacarlo \w por|strong="H3282"\w* ahí. \w Él|strong="H1931"\w* \w se|strong="H1931"\w* \w cubrirá|strong="H3680"\w* \w el|strong="H1931"\w* \w rostro|strong="H6440"\w* \w para|strong="H3282"\w* \w no|strong="H3808"\w* \w ver|strong="H7200"\w* \w la|strong="H1931"\w* tierra con \w sus|strong="H1931"\w* \w ojos|strong="H5869"\w*.  
\v 13 Pero yo tenderé \w mi|strong="H5921"\w* \w red|strong="H7568"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* quedará atrapado \w en|strong="H5921"\w* \w mi|strong="H5921"\w* trampa. \w Lo|strong="H3808"\w* llevaré \w a|strong="H3068"\w* Babilonia, \w a|strong="H3068"\w* tierra \w de|strong="H5921"\w* \w caldeos|strong="H3778"\w*, pero \w no|strong="H3808"\w* \w la|strong="H5921"\w* \w verá|strong="H7200"\w*, \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w morirá|strong="H4191"\w*.  
\v 14 \w Esparciré|strong="H2219"\w* \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w vientos|strong="H7307"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H5828"\w* \w lo|strong="H3605"\w* \w rodean|strong="H5439"\w* para ayudarlo y \w a|strong="H3068"\w* \w todas|strong="H3605"\w* sus tropas; y desenvainaré \w la|strong="H3605"\w* \w espada|strong="H2719"\w* para perseguirlos.   
\p
\v 15 “‘\w Y|strong="H3068"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé \w cuando|strong="H3588"\w* \w los|strong="H3588"\w* disperse \w entre|strong="H3588"\w* las \w naciones|strong="H1471"\w* \w y|strong="H3588"\w* \w los|strong="H3588"\w* esparza \w por|strong="H3588"\w* \w los|strong="H3588"\w* países.  
\v 16 \w Pero|strong="H3588"\w* dejaré \w que|strong="H3588"\w* \w unos|strong="H1992"\w* \w pocos|strong="H4557"\w* \w de|strong="H3588"\w* \w ellos|strong="H1992"\w* escapen \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*, del \w hambre|strong="H7458"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* peste, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w cuenten|strong="H5608"\w* \w todas|strong="H3605"\w* \w sus|strong="H1992"\w* \w abominaciones|strong="H8441"\w* \w entre|strong="H3588"\w* \w las|strong="H1992"\w* \w naciones|strong="H1471"\w* \w a|strong="H3068"\w* \w donde|strong="H8033"\w* vayan. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé’”.   
\p
\v 17 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 18 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, come tu \w pan|strong="H3899"\w* con \w temblor|strong="H7494"\w*, y \w bebe|strong="H8354"\w* tu \w agua|strong="H4325"\w* con estremecimiento y ansiedad.  
\v 19 Dile \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w gente|strong="H5971"\w* \w de|strong="H5971"\w* \w la|strong="H3605"\w* tierra: \w Así|strong="H3541"\w* dice \w el|strong="H3605"\w* Señor Yahvé acerca \w de|strong="H5971"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5971"\w* Jerusalén \w y|strong="H3541"\w* \w de|strong="H5971"\w* \w la|strong="H3605"\w* tierra \w de|strong="H5971"\w* \w Israel|strong="H3478"\w*: ‘Comerán su \w pan|strong="H3899"\w* con angustia \w y|strong="H3541"\w* \w beberán|strong="H8354"\w* su \w agua|strong="H4325"\w* con terror, \w porque|strong="H4616"\w* su tierra quedará desolada, despojada \w de|strong="H5971"\w* \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H5971"\w* hay en \w ella|strong="H3605"\w*, \w por|strong="H4616"\w* culpa \w de|strong="H5971"\w* \w la|strong="H3605"\w* \w violencia|strong="H2555"\w* \w de|strong="H5971"\w* \w todos|strong="H3605"\w* sus \w habitantes|strong="H3427"\w*.  
\v 20 Las \w ciudades|strong="H5892"\w* \w habitadas|strong="H3427"\w* \w quedarán|strong="H3427"\w* \w en|strong="H3588"\w* ruinas \w y|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w se|strong="H3045"\w* convertirá \w en|strong="H3588"\w* un desierto. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé’”.   
\p
\v 21 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 22 “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, ¿\w qué|strong="H4100"\w* significa \w ese|strong="H2088"\w* dicho \w que|strong="H4100"\w* tienen ustedes \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: ‘Pasa \w el|strong="H5921"\w* \w tiempo|strong="H3117"\w*, \w y|strong="H5921"\w* \w ninguna|strong="H3605"\w* \w visión|strong="H2377"\w* \w se|strong="H5921"\w* cumple’?  
\v 23 \w Por|strong="H3588"\w* \w tanto|strong="H3651"\w*, \w diles|strong="H1697"\w* \w que|strong="H3588"\w* \w así|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H3588"\w* Señor Yahvé: ‘Voy \w a|strong="H3068"\w* poner fin \w a|strong="H3068"\w* \w ese|strong="H2088"\w* \w dicho|strong="H1697"\w*, \w y|strong="H3588"\w* \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w lo|strong="H1697"\w* usarán \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*’. \w Diles|strong="H1697"\w* \w más|strong="H5750"\w* \w bien|strong="H3588"\w*: ‘\w Ya|strong="H3068"\w* \w se|strong="H3808"\w* acercan \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* cumplimiento \w de|strong="H3588"\w* \w toda|strong="H3605"\w* \w visión|strong="H2377"\w*.  
\v 24 \w Porque|strong="H3588"\w* ya \w no|strong="H3808"\w* \w habrá|strong="H1961"\w* \w más|strong="H5750"\w* visiones falsas \w ni|strong="H3808"\w* adivinaciones lisonjeras \w dentro|strong="H8432"\w* del pueblo \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.  
\v 25 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé. \w Yo|strong="H3588"\w* \w hablaré|strong="H1696"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w diga|strong="H1696"\w* \w se|strong="H3808"\w* \w cumplirá|strong="H6213"\w*. \w No|strong="H3808"\w* \w se|strong="H3808"\w* retrasará \w más|strong="H5750"\w*; \w porque|strong="H3588"\w* \w en|strong="H3588"\w* sus propios \w días|strong="H3117"\w*, pueblo \w rebelde|strong="H4805"\w*, pronunciaré \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* cumpliré’, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* \w Señor|strong="H3068"\w* Yahvé”.   
\p
\v 26 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* otra vez y me dijo:  
\v 27 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w mira|strong="H2009"\w* \w que|strong="H1931"\w* \w los|strong="H1121"\w* \w de|strong="H1121"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* andan diciendo: ‘\w La|strong="H1931"\w* \w visión|strong="H2377"\w* \w que|strong="H1931"\w* \w este|strong="H1931"\w* \w ve|strong="H2372"\w* \w es|strong="H1931"\w* para dentro \w de|strong="H1121"\w* \w muchos|strong="H7227"\w* \w días|strong="H3117"\w*; \w profetiza|strong="H5012"\w* para \w tiempos|strong="H3117"\w* muy \w lejanos|strong="H7350"\w*’.   
\p
\v 28 “\w Por|strong="H1697"\w* \w tanto|strong="H3651"\w*, \w diles|strong="H1697"\w* \w que|strong="H3808"\w* \w así|strong="H3541"\w* \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé: ‘\w Ninguna|strong="H3605"\w* \w de|strong="H5750"\w* mis \w palabras|strong="H1697"\w* \w se|strong="H3808"\w* retrasará \w más|strong="H5750"\w*; \w la|strong="H3605"\w* \w palabra|strong="H1697"\w* \w que|strong="H3808"\w* \w yo|strong="H6213"\w* \w diga|strong="H1696"\w* \w se|strong="H3808"\w* \w cumplirá|strong="H6213"\w*’, \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé”.   
\c 13  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w profetiza|strong="H5012"\w* \w contra|strong="H3478"\w* \w los|strong="H1121"\w* \w profetas|strong="H5030"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w que|strong="H1697"\w* están \w profetizando|strong="H5012"\w*, y \w diles|strong="H1697"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w que|strong="H1697"\w* \w profetizan|strong="H5012"\w* según su propia imaginación: ‘\w Escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1121"\w* Yahvé.  
\v 3 \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* necios \w que|strong="H5921"\w* \w siguen|strong="H1980"\w* su propio \w espíritu|strong="H7307"\w* \w y|strong="H5921"\w* \w no|strong="H5921"\w* han \w visto|strong="H7200"\w* nada!  
\v 4 Tus \w profetas|strong="H5030"\w*, \w Israel|strong="H3478"\w*, han \w sido|strong="H1961"\w* \w como|strong="H1961"\w* \w zorras|strong="H7776"\w* entre las ruinas.  
\v 5 Ustedes \w no|strong="H3808"\w* han \w subido|strong="H5927"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* brechas \w ni|strong="H3808"\w* han reparado \w el|strong="H5921"\w* muro \w para|strong="H5921"\w* defender \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w batalla|strong="H4421"\w* \w del|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* Yahvé.  
\v 6 Han visto falsedad y \w adivinación|strong="H7081"\w* \w mentirosa|strong="H3577"\w* los \w que|strong="H3808"\w* dicen: “Yahvé \w lo|strong="H1697"\w* \w ha|strong="H3808"\w* \w dicho|strong="H5002"\w*”, \w aunque|strong="H3808"\w* Yahvé \w no|strong="H3808"\w* los \w ha|strong="H3808"\w* \w enviado|strong="H7971"\w*; ¡y todavía esperan \w que|strong="H3808"\w* \w se|strong="H3808"\w* \w cumpla|strong="H6965"\w* su \w palabra|strong="H1697"\w*!  
\v 7 ¿Acaso \w no|strong="H3808"\w* han visto una \w visión|strong="H4236"\w* falsa y han \w hablado|strong="H1696"\w* una \w adivinación|strong="H4738"\w* \w mentirosa|strong="H3577"\w*, cuando \w dicen|strong="H1696"\w*: “Yahvé \w dice|strong="H5002"\w*”, y yo \w no|strong="H3808"\w* he \w hablado|strong="H1696"\w*?’.   
\p
\v 8 “\w Por|strong="H3282"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* \w dice|strong="H5002"\w* el Señor Yahvé: ‘\w Por|strong="H3282"\w* haber \w hablado|strong="H1696"\w* falsedades \w y|strong="H3541"\w* haber visto \w mentiras|strong="H3577"\w*, \w por|strong="H3282"\w* \w eso|strong="H3651"\w* yo estoy contra ustedes, \w dice|strong="H5002"\w* el Señor Yahvé.  
\v 9 \w Mi|strong="H1961"\w* \w mano|strong="H3027"\w* \w estará|strong="H1961"\w* \w contra|strong="H3478"\w* \w los|strong="H1961"\w* \w profetas|strong="H5030"\w* \w que|strong="H3588"\w* \w tienen|strong="H1961"\w* visiones falsas \w y|strong="H3588"\w* \w adivinan|strong="H7080"\w* \w mentiras|strong="H3577"\w*. \w No|strong="H3808"\w* \w estarán|strong="H1961"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w consejo|strong="H5475"\w* \w de|strong="H3588"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*, \w ni|strong="H3808"\w* \w serán|strong="H1961"\w* inscritos \w en|strong="H3588"\w* \w el|strong="H3588"\w* registro \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w ni|strong="H3808"\w* entrarán \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* \w el|strong="H3588"\w* Señor Yahvé.   
\p
\v 10 “‘\w Porque|strong="H3282"\w* engañan \w a|strong="H3068"\w* \w mi|strong="H2009"\w* \w pueblo|strong="H5971"\w* diciendo: “\w Paz|strong="H7965"\w*”, cuando no hay \w paz|strong="H7965"\w*. Cuando alguien levanta una pared, \w ellos|strong="H1931"\w* \w la|strong="H1931"\w* recubren con cal.  
\v 11 Diles \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w que|strong="H1961"\w* la recubren con cal \w que|strong="H1961"\w* la pared \w se|strong="H1961"\w* \w caerá|strong="H5307"\w*. \w Vendrá|strong="H1961"\w* una \w lluvia|strong="H1653"\w* torrencial; y ustedes, grandes piedras de granizo, \w caerán|strong="H5307"\w*, y un \w viento|strong="H7307"\w* \w tempestuoso|strong="H5591"\w* la derribará.  
\v 12 \w Y|strong="H3068"\w* cuando la \w pared|strong="H7023"\w* \w se|strong="H3808"\w* haya \w caído|strong="H5307"\w*, ¿\w no|strong="H3808"\w* les preguntarán: “¿Dónde está la cal con \w que|strong="H3808"\w* la recubrieron?”.   
\p
\v 13 “‘\w Por|strong="H3651"\w* \w eso|strong="H3651"\w* dice el Señor Yahvé: En \w mi|strong="H1961"\w* \w furor|strong="H2534"\w* haré \w que|strong="H1961"\w* \w se|strong="H1961"\w* desate un \w viento|strong="H7307"\w* \w tempestuoso|strong="H5591"\w*; en \w mi|strong="H1961"\w* \w ira|strong="H2534"\w* \w vendrá|strong="H1961"\w* una \w lluvia|strong="H1653"\w* torrencial, \w y|strong="H3541"\w* en \w mi|strong="H1961"\w* \w enojo|strong="H2534"\w* caerán piedras de granizo \w para|strong="H1961"\w* destruirla.  
\v 14 Derribaré \w la|strong="H3588"\w* \w pared|strong="H7023"\w* \w que|strong="H3588"\w* ustedes recubrieron \w con|strong="H3588"\w* cal \w y|strong="H3588"\w* \w la|strong="H3588"\w* echaré \w por|strong="H3588"\w* tierra, \w de|strong="H3588"\w* modo \w que|strong="H3588"\w* sus cimientos queden al descubierto. \w Caerá|strong="H5307"\w*, \w y|strong="H3588"\w* ustedes serán \w destruidos|strong="H2040"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3588"\w* ella. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.  
\v 15 Así descargaré mi \w ira|strong="H2534"\w* sobre la \w pared|strong="H7023"\w* y sobre los que la recubrieron con cal, y les diré: “\w Ya|strong="H3068"\w* no existe la \w pared|strong="H7023"\w*, ni los que la recubrieron:  
\v 16 los \w profetas|strong="H5030"\w* de \w Israel|strong="H3478"\w* que \w profetizan|strong="H5012"\w* sobre Jerusalén y ven para ella visiones de \w paz|strong="H7965"\w*, cuando no hay \w paz|strong="H7965"\w*”, \w dice|strong="H5002"\w* \w el|strong="H5030"\w* Señor Yahvé’.   
\p
\v 17 “\w Y|strong="H3068"\w* tú, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, encara \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* \w de|strong="H5921"\w* tu \w pueblo|strong="H5971"\w* \w que|strong="H5921"\w* \w profetizan|strong="H5012"\w* \w según|strong="H5921"\w* sus propios caprichos, \w y|strong="H5921"\w* \w profetiza|strong="H5012"\w* \w contra|strong="H5921"\w* \w ellas|strong="H5921"\w*.  
\v 18 Diles: ‘\w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* cosen cintas mágicas \w en|strong="H5921"\w* \w las|strong="H5921"\w* muñecas \w y|strong="H5921"\w* \w hacen|strong="H6213"\w* velos \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w gente|strong="H5971"\w* \w de|strong="H5921"\w* \w toda|strong="H3605"\w* estatura, \w para|strong="H5921"\w* atrapar \w vidas|strong="H5315"\w*! ¿Acaso pretenden atrapar \w la|strong="H5921"\w* \w vida|strong="H5315"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w para|strong="H5921"\w* salvar \w la|strong="H5921"\w* suya propia?  
\v 19 Me \w han|strong="H4191"\w* \w profanado|strong="H2490"\w* ante \w mi|strong="H2490"\w* \w pueblo|strong="H5971"\w* por unos puñados \w de|strong="H5971"\w* \w cebada|strong="H8184"\w* y unos pedazos \w de|strong="H5971"\w* \w pan|strong="H3899"\w*, \w matando|strong="H4191"\w* \w a|strong="H3068"\w* quienes \w no|strong="H3808"\w* deberían \w morir|strong="H4191"\w* y dejando con \w vida|strong="H5315"\w* \w a|strong="H3068"\w* quienes \w no|strong="H3808"\w* deberían \w vivir|strong="H2421"\w*, mintiéndole \w a|strong="H3068"\w* \w mi|strong="H2490"\w* \w pueblo|strong="H5971"\w*, \w que|strong="H3808"\w* \w escucha|strong="H8085"\w* sus \w mentiras|strong="H3576"\w*.   
\p
\v 20 “‘\w Por|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: \w Yo|strong="H5315"\w* estoy \w contra|strong="H5921"\w* sus cintas mágicas \w con|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* atrapan \w las|strong="H5921"\w* \w vidas|strong="H5315"\w* \w como|strong="H5921"\w* \w si|strong="H2005"\w* fueran pájaros. \w Las|strong="H5921"\w* arrancaré \w de|strong="H5921"\w* sus \w brazos|strong="H2220"\w* \w y|strong="H5921"\w* \w dejaré|strong="H7971"\w* libres \w las|strong="H5921"\w* \w vidas|strong="H5315"\w*, \w las|strong="H5921"\w* \w vidas|strong="H5315"\w* \w que|strong="H5921"\w* ustedes cazan \w como|strong="H5921"\w* aves.  
\v 21 \w También|strong="H5750"\w* \w romperé|strong="H7167"\w* sus velos \w y|strong="H3588"\w* \w libraré|strong="H5337"\w* \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* sus \w manos|strong="H3027"\w*, \w y|strong="H3588"\w* ya \w no|strong="H3808"\w* \w serán|strong="H1961"\w* presa \w de|strong="H3588"\w* ustedes. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1961"\w* Yahvé.  
\v 22 \w Porque|strong="H3282"\w* con sus \w mentiras|strong="H8267"\w* han desanimado al \w justo|strong="H6662"\w*, \w a|strong="H3068"\w* quien yo \w no|strong="H3808"\w* quería entristecer, y han fortalecido al \w malvado|strong="H7451"\w* \w para|strong="H3282"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* aparte \w de|strong="H6662"\w* su \w mal|strong="H7451"\w* \w camino|strong="H1870"\w* y salve su \w vida|strong="H2421"\w*.  
\v 23 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, ya \w no|strong="H3808"\w* \w verán|strong="H2372"\w* visiones falsas \w ni|strong="H3808"\w* practicarán \w más|strong="H5750"\w* \w la|strong="H3588"\w* \w adivinación|strong="H7081"\w*. \w Libraré|strong="H5337"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* sus \w manos|strong="H3027"\w*, \w y|strong="H3588"\w* ustedes \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé’”.   
\c 14  
\p
\v 1 Entonces vinieron \w a|strong="H3068"\w* verme algunos \w de|strong="H6440"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* y se \w sentaron|strong="H3427"\w* frente \w a|strong="H3068"\w* mí.  
\v 2 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 3 “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, estos \w hombres|strong="H1121"\w* han \w puesto|strong="H5927"\w* sus \w ídolos|strong="H1544"\w* \w en|strong="H5921"\w* su \w corazón|strong="H3820"\w* \w y|strong="H5921"\w* han colocado \w la|strong="H5921"\w* piedra \w de|strong="H5921"\w* \w tropiezo|strong="H4383"\w* \w de|strong="H5921"\w* su \w maldad|strong="H5771"\w* frente \w a|strong="H3068"\w* sus \w rostros|strong="H6440"\w*. ¿Acaso debo \w dejar|strong="H5414"\w* \w que|strong="H5921"\w* \w ellos|strong="H5921"\w* \w me|strong="H5921"\w* consulten?  
\v 4 \w Háblales|strong="H1696"\w*, \w pues|strong="H3651"\w*, \w y|strong="H3541"\w* \w diles|strong="H1696"\w*: ‘\w Así|strong="H3541"\w* \w dice|strong="H1696"\w* \w el|strong="H5030"\w* \w Señor|strong="H3068"\w* Yahvé: \w A|strong="H3068"\w* cualquier hombre \w de|strong="H6440"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w que|strong="H3541"\w* \w ponga|strong="H7760"\w* sus \w ídolos|strong="H1544"\w* en su \w corazón|strong="H3820"\w*, \w que|strong="H3541"\w* coloque la piedra \w de|strong="H6440"\w* \w tropiezo|strong="H4383"\w* \w de|strong="H6440"\w* su \w maldad|strong="H5771"\w* frente \w a|strong="H3068"\w* su \w rostro|strong="H6440"\w*, \w y|strong="H3541"\w* \w que|strong="H3541"\w* \w luego|strong="H5927"\w* \w venga|strong="H5927"\w* al \w profeta|strong="H5030"\w*, yo, Yahvé, le \w responderé|strong="H6030"\w* según la \w multitud|strong="H7230"\w* \w de|strong="H6440"\w* sus \w ídolos|strong="H1544"\w*.  
\v 5 \w Lo|strong="H5921"\w* haré \w para|strong="H4616"\w* atrapar \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w en|strong="H5921"\w* su propio \w corazón|strong="H3820"\w*, ya \w que|strong="H5921"\w* \w todos|strong="H3605"\w* \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* han alejado \w de|strong="H5921"\w* \w mí|strong="H5921"\w* \w por|strong="H5921"\w* causa \w de|strong="H5921"\w* sus \w ídolos|strong="H1544"\w*’.   
\p
\v 6 “\w Por|strong="H5921"\w* \w lo|strong="H5921"\w* \w tanto|strong="H3651"\w*, dile \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*: \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: ‘¡Arrepiéntanse \w y|strong="H5921"\w* apártense \w de|strong="H5921"\w* sus \w ídolos|strong="H1544"\w*! Aparten sus \w rostros|strong="H6440"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* sus \w abominaciones|strong="H8441"\w*.   
\p
\v 7 “‘\w Porque|strong="H3588"\w* \w a|strong="H3068"\w* cualquiera \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w o|strong="H3068"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H3588"\w* viven \w en|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w que|strong="H3588"\w* se aparte \w de|strong="H3588"\w* \w mí|strong="H6030"\w*, \w ponga|strong="H7760"\w* sus \w ídolos|strong="H1544"\w* \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w corazón|strong="H3820"\w* \w y|strong="H3588"\w* coloque \w la|strong="H3588"\w* piedra \w de|strong="H3588"\w* \w tropiezo|strong="H4383"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w maldad|strong="H5771"\w* frente \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w rostro|strong="H6440"\w*, \w y|strong="H3588"\w* \w venga|strong="H5927"\w* al \w profeta|strong="H5030"\w* \w para|strong="H3588"\w* consultarme, \w yo|strong="H3588"\w* mismo, Yahvé, le \w responderé|strong="H6030"\w*.  
\v 8 \w Me|strong="H3588"\w* \w pondré|strong="H5414"\w* \w en|strong="H8432"\w* \w contra|strong="H6440"\w* \w de|strong="H3588"\w* \w ese|strong="H1931"\w* hombre, \w lo|strong="H1931"\w* convertiré \w en|strong="H8432"\w* una señal \w y|strong="H3588"\w* \w en|strong="H8432"\w* un refrán, \w y|strong="H3588"\w* \w lo|strong="H1931"\w* eliminaré \w de|strong="H3588"\w* mi \w pueblo|strong="H5971"\w*. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w soy|strong="H1931"\w* Yahvé.   
\p
\v 9 “‘\w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w el|strong="H1931"\w* \w profeta|strong="H5030"\w* \w se|strong="H1931"\w* deja engañar \w y|strong="H3588"\w* \w habla|strong="H1696"\w* una \w palabra|strong="H1697"\w*, \w yo|strong="H3588"\w*, Yahvé, he permitido \w que|strong="H3588"\w* \w ese|strong="H1931"\w* \w profeta|strong="H5030"\w* sea \w engañado|strong="H6601"\w*; \w extenderé|strong="H5186"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w él|strong="H1931"\w* \w y|strong="H3588"\w* \w lo|strong="H1931"\w* \w destruiré|strong="H8045"\w* \w de|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w Israel|strong="H3478"\w*.  
\v 10 Ambos cargarán con su castigo; \w el|strong="H5030"\w* castigo del \w profeta|strong="H5030"\w* \w será|strong="H1961"\w* igual al castigo del \w que|strong="H1961"\w* lo consulta,  
\v 11 \w para|strong="H4616"\w* \w que|strong="H3808"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w se|strong="H1961"\w* desvíe \w más|strong="H5750"\w* \w de|strong="H5750"\w* \w mí|strong="H1961"\w* \w ni|strong="H3808"\w* \w se|strong="H1961"\w* contamine \w más|strong="H5750"\w* con \w todas|strong="H3605"\w* sus \w rebeliones|strong="H6588"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w sean|strong="H1961"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w* y yo \w sea|strong="H1961"\w* su \w Dios|strong="H3069"\w*, \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé’”.   
\p
\v 12 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 13 “\w Hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w hombre|strong="H1121"\w*, \w si|strong="H3588"\w* un país \w peca|strong="H2398"\w* \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* siendo infiel, \w y|strong="H3588"\w* \w yo|strong="H4480"\w* extiendo \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w él|strong="H5921"\w*, \w corto|strong="H3772"\w* \w su|strong="H3588"\w* provisión \w de|strong="H4480"\w* \w pan|strong="H3899"\w*, \w envío|strong="H7971"\w* \w hambre|strong="H7458"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H3588"\w* elimino \w de|strong="H4480"\w* allí \w a|strong="H3068"\w* \w hombres|strong="H1121"\w* \w y|strong="H3588"\w* \w animales|strong="H1121"\w*;  
\v 14 aunque estuvieran allí \w estos|strong="H1992"\w* \w tres|strong="H7969"\w* hombres: \w Noé|strong="H5146"\w*, \w Daniel|strong="H1840"\w* y Job, \w ellos|strong="H1992"\w* solo salvarían \w su|strong="H1992"\w* propia \w vida|strong="H5315"\w* gracias \w a|strong="H3068"\w* \w su|strong="H1992"\w* \w justicia|strong="H6666"\w*, \w dice|strong="H5002"\w* \w el|strong="H1992"\w* Señor Yahvé.   
\p
\v 15 “\w Si|strong="H3863"\w* yo hago \w pasar|strong="H5674"\w* fieras salvajes \w por|strong="H6440"\w* \w el|strong="H5674"\w* país y lo despueblan, dejándolo tan desolado \w que|strong="H1961"\w* nadie pueda \w pasar|strong="H5674"\w* \w por|strong="H6440"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* las fieras,  
\v 16 y \w estos|strong="H1992"\w* \w tres|strong="H7969"\w* \w hombres|strong="H1121"\w* estuvieran allí, tan cierto \w como|strong="H1961"\w* \w que|strong="H1121"\w* yo \w vivo|strong="H2416"\w* —\w dice|strong="H5002"\w* \w el|strong="H1121"\w* Señor Yahvé—, \w no|strong="H1961"\w* salvarían \w ni|strong="H8432"\w* \w a|strong="H3068"\w* \w hijos|strong="H1121"\w* \w ni|strong="H8432"\w* \w a|strong="H3068"\w* \w hijas|strong="H1323"\w*. Solo \w ellos|strong="H1992"\w* \w se|strong="H1961"\w* salvarían, pero la tierra quedaría \w desolada|strong="H8077"\w*.   
\p
\v 17 “\w O|strong="H3068"\w* \w si|strong="H1931"\w* \w yo|strong="H4480"\w* traigo \w la|strong="H1931"\w* \w espada|strong="H2719"\w* \w sobre|strong="H5921"\w* \w esa|strong="H1931"\w* tierra \w y|strong="H5921"\w* digo: ‘¡\w Espada|strong="H2719"\w*, recorre \w el|strong="H1931"\w* país!’, \w y|strong="H5921"\w* elimino \w de|strong="H4480"\w* allí \w a|strong="H3068"\w* hombres \w y|strong="H5921"\w* animales,  
\v 18 \w y|strong="H3588"\w* \w estos|strong="H1992"\w* \w tres|strong="H7969"\w* \w hombres|strong="H1121"\w* estuvieran allí, tan \w cierto|strong="H3588"\w* \w como|strong="H3588"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w vivo|strong="H2416"\w* —\w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor Yahvé—, \w no|strong="H3808"\w* salvarían \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w hijos|strong="H1121"\w* \w ni|strong="H3808"\w* \w a|strong="H3068"\w* \w hijas|strong="H1323"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* solo \w ellos|strong="H1992"\w* \w se|strong="H3808"\w* salvarían.   
\p
\v 19 “\w O|strong="H3068"\w* \w si|strong="H1931"\w* \w envío|strong="H7971"\w* una peste \w sobre|strong="H5921"\w* \w esa|strong="H1931"\w* tierra \w y|strong="H5921"\w* \w derramo|strong="H8210"\w* \w mi|strong="H5921"\w* \w ira|strong="H2534"\w* \w en|strong="H5921"\w* \w sangre|strong="H1818"\w* \w sobre|strong="H5921"\w* \w ella|strong="H1931"\w* \w para|strong="H5921"\w* eliminar \w a|strong="H3068"\w* hombres \w y|strong="H5921"\w* animales,  
\v 20 y estuvieran allí \w Noé|strong="H5146"\w*, \w Daniel|strong="H1840"\w* y Job, tan cierto como \w que|strong="H1121"\w* \w yo|strong="H5315"\w* \w vivo|strong="H2416"\w* —\w dice|strong="H5002"\w* \w el|strong="H1121"\w* Señor Yahvé—, no salvarían \w ni|strong="H8432"\w* \w a|strong="H3068"\w* \w hijo|strong="H1121"\w* \w ni|strong="H8432"\w* \w a|strong="H3068"\w* \w hija|strong="H1323"\w*; \w ellos|strong="H1992"\w* solo salvarían \w su|strong="H1992"\w* propia \w vida|strong="H5315"\w* por \w su|strong="H1992"\w* \w justicia|strong="H6666"\w*”.   
\p
\v 21 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice \w el|strong="H3588"\w* Señor Yahvé: “¡\w Cuánto|strong="H3588"\w* \w más|strong="H3588"\w* \w cuando|strong="H3588"\w* \w envíe|strong="H7971"\w* mis cuatro \w juicios|strong="H8201"\w* terribles \w sobre|strong="H4480"\w* Jerusalén —\w la|strong="H3588"\w* \w espada|strong="H2719"\w*, \w el|strong="H3588"\w* \w hambre|strong="H7458"\w*, las fieras \w y|strong="H3588"\w* \w la|strong="H3588"\w* peste— \w para|strong="H3588"\w* eliminar \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w a|strong="H3068"\w* hombres \w y|strong="H3588"\w* \w animales|strong="H2416"\w*!  
\v 22 Sin embargo, \w quedará|strong="H3498"\w* \w en|strong="H5921"\w* \w ella|strong="H5921"\w* un remanente \w que|strong="H5921"\w* sobrevivirá, \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w* \w que|strong="H5921"\w* serán sacados. Miren, \w ellos|strong="H5921"\w* vendrán \w a|strong="H3068"\w* ustedes, \w y|strong="H5921"\w* cuando \w vean|strong="H7200"\w* su conducta \w y|strong="H5921"\w* sus acciones, \w se|strong="H5921"\w* sentirán consolados \w del|strong="H5921"\w* \w mal|strong="H7451"\w* \w que|strong="H5921"\w* he traído \w sobre|strong="H5921"\w* Jerusalén, \w de|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* envié \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*.  
\v 23 \w Ellos|strong="H3605"\w* \w los|strong="H3605"\w* consolarán \w cuando|strong="H3588"\w* \w vean|strong="H7200"\w* \w su|strong="H3588"\w* conducta \w y|strong="H3588"\w* sus acciones; \w entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w hice|strong="H6213"\w* \w sin|strong="H3808"\w* motivo \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3588"\w* \w hice|strong="H6213"\w* \w en|strong="H3588"\w* \w ella|strong="H3605"\w*, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor Yahvé”.   
\c 15  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, ¿\w qué|strong="H4100"\w* \w tiene|strong="H1961"\w* \w de|strong="H1121"\w* especial \w la|strong="H3605"\w* \w madera|strong="H6086"\w* \w de|strong="H1121"\w* \w la|strong="H3605"\w* \w vid|strong="H1612"\w* comparada con \w la|strong="H3605"\w* \w de|strong="H1121"\w* \w cualquier|strong="H3605"\w* otro \w árbol|strong="H6086"\w*? ¿En \w qué|strong="H4100"\w* \w es|strong="H1961"\w* mejor esa rama \w que|strong="H4100"\w* las demás ramas del \w bosque|strong="H3293"\w*?  
\v 3 ¿Acaso \w se|strong="H5921"\w* saca \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w madera|strong="H6086"\w* \w para|strong="H5921"\w* \w hacer|strong="H6213"\w* algo útil? ¿\w Sirve|strong="H6213"\w* siquiera \w para|strong="H5921"\w* \w hacer|strong="H6213"\w* una estaca \w y|strong="H5921"\w* colgar \w en|strong="H5921"\w* \w ella|strong="H4480"\w* algún utensilio?  
\v 4 ¡\w Mira|strong="H2009"\w*! Se echa al fuego como leña; el fuego consume sus \w dos|strong="H8147"\w* extremos y el centro queda carbonizado. ¿Sirve entonces \w para|strong="H5414"\w* algún trabajo?  
\v 5 \w Si|strong="H3588"\w* \w cuando|strong="H3588"\w* \w estaba|strong="H1961"\w* \w entera|strong="H8549"\w* \w no|strong="H3808"\w* \w servía|strong="H1961"\w* \w para|strong="H3588"\w* \w nada|strong="H3808"\w*, ¡\w cuánto|strong="H3588"\w* \w menos|strong="H3588"\w* \w servirá|strong="H1961"\w* \w para|strong="H3588"\w* algo \w cuando|strong="H3588"\w* \w el|strong="H3588"\w* fuego \w la|strong="H3588"\w* \w haya|strong="H1961"\w* consumido \w y|strong="H3588"\w* \w esté|strong="H1961"\w* quemada!”.   
\p
\v 6 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H3427"\w* Señor Yahvé: “\w Tal|strong="H3651"\w* \w como|strong="H3651"\w* \w se|strong="H3651"\w* hace con la \w madera|strong="H6086"\w* \w de|strong="H5414"\w* la \w vid|strong="H1612"\w* entre \w los|strong="H3427"\w* \w árboles|strong="H6086"\w* del \w bosque|strong="H3293"\w*, \w que|strong="H3541"\w* la he \w entregado|strong="H5414"\w* al fuego \w como|strong="H3651"\w* \w leña|strong="H6086"\w*, \w así|strong="H3541"\w* \w haré|strong="H5414"\w* con \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5414"\w* Jerusalén.  
\v 7 \w Me|strong="H3588"\w* \w pondré|strong="H5414"\w* \w en|strong="H3588"\w* \w contra|strong="H6440"\w* \w de|strong="H3588"\w* ellos. \w Aunque|strong="H3588"\w* hayan escapado del fuego, \w el|strong="H3588"\w* fuego \w los|strong="H3588"\w* consumirá. \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w yo|strong="H3588"\w* \w me|strong="H3588"\w* \w enfrente|strong="H6440"\w* \w a|strong="H3068"\w* ellos, ustedes \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.  
\v 8 Convertiré la tierra en un desierto, \w porque|strong="H3282"\w* han sido infieles”, \w dice|strong="H5002"\w* el Señor Yahvé.   
\c 16  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, dale \w a|strong="H3068"\w* conocer \w a|strong="H3068"\w* Jerusalén sus \w abominaciones|strong="H8441"\w*,  
\v 3 \w y|strong="H3541"\w* diles: \w Así|strong="H3541"\w* dice el Señor Yahvé \w a|strong="H3068"\w* Jerusalén: ‘Tu origen \w y|strong="H3541"\w* tu \w nacimiento|strong="H4138"\w* son de la tierra de los \w cananeos|strong="H3669"\w*. Tu padre era amorreo \w y|strong="H3541"\w* tu madre, hitita.  
\v 4 En cuanto \w a|strong="H3068"\w* tu \w nacimiento|strong="H4138"\w*, el \w día|strong="H3117"\w* \w que|strong="H3808"\w* \w naciste|strong="H3205"\w* \w no|strong="H3808"\w* te \w cortaron|strong="H3772"\w* el cordón umbilical, \w ni|strong="H3808"\w* te lavaron con \w agua|strong="H4325"\w* para limpiarte; \w no|strong="H3808"\w* fuiste frotada con \w sal|strong="H4414"\w* \w ni|strong="H3808"\w* envuelta en pañales.  
\v 5 \w Nadie|strong="H3808"\w* \w se|strong="H5921"\w* compadeció \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w para|strong="H5921"\w* hacerte \w nada|strong="H3808"\w* \w de|strong="H5921"\w* \w esto|strong="H6213"\w*, \w ni|strong="H3808"\w* \w te|strong="H5869"\w* tuvieron lástima; \w al|strong="H5921"\w* contrario, \w te|strong="H5869"\w* arrojaron \w a|strong="H3068"\w* \w campo|strong="H7704"\w* abierto, \w con|strong="H5921"\w* desprecio \w por|strong="H5921"\w* \w tu|strong="H6213"\w* \w vida|strong="H5315"\w*, \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w en|strong="H5921"\w* \w que|strong="H3808"\w* \w naciste|strong="H3205"\w*.   
\p
\v 6 “‘\w Pasé|strong="H5674"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w vi|strong="H7200"\w* revolcándote \w en|strong="H5921"\w* tu propia \w sangre|strong="H1818"\w*, \w y|strong="H5921"\w* \w te|strong="H5921"\w* dije: “¡Aunque estés sangrando, \w vive|strong="H2421"\w*!”. \w Sí|strong="H5921"\w*, \w te|strong="H5921"\w* dije: “¡Aunque estés sangrando, \w vive|strong="H2421"\w*!”.  
\v 7 Te hice crecer como la hierba del \w campo|strong="H7704"\w*; creciste, te desarrollaste y llegaste \w a|strong="H3068"\w* ser muy hermosa. Se te formaron los senos y te \w creció|strong="H1431"\w* el cabello, pero estabas \w desnuda|strong="H5903"\w* y expuesta.   
\p
\v 8 “‘\w Pasé|strong="H5674"\w* otra \w vez|strong="H6256"\w* \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w miré|strong="H7200"\w*, \w y|strong="H5921"\w* \w vi|strong="H7200"\w* \w que|strong="H5921"\w* habías llegado \w a|strong="H3068"\w* \w la|strong="H5921"\w* edad \w del|strong="H5921"\w* amor. \w Extendí|strong="H6566"\w* \w mi|strong="H5921"\w* manto \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w cubrí|strong="H3680"\w* tu \w desnudez|strong="H6172"\w*. \w Me|strong="H5921"\w* comprometí \w contigo|strong="H5921"\w* \w e|strong="H3068"\w* \w hice|strong="H7650"\w* un \w pacto|strong="H1285"\w* \w contigo|strong="H5921"\w* —\w dice|strong="H5002"\w* \w el|strong="H5921"\w* Señor Yahvé—, \w y|strong="H5921"\w* \w fuiste|strong="H1961"\w* mía.   
\p
\v 9 “‘\w Te|strong="H5921"\w* lavé \w con|strong="H5921"\w* \w agua|strong="H4325"\w*, \w te|strong="H5921"\w* limpié \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w y|strong="H5921"\w* \w te|strong="H5921"\w* ungí \w con|strong="H5921"\w* \w aceite|strong="H8081"\w*.  
\v 10 Te vestí con ropa bordada y te puse sandalias \w de|strong="H3847"\w* piel fina; te vestí \w de|strong="H3847"\w* lino y te \w cubrí|strong="H3680"\w* \w de|strong="H3847"\w* seda.  
\v 11 \w Te|strong="H5921"\w* adorné \w con|strong="H5921"\w* joyas: \w puse|strong="H5414"\w* \w brazaletes|strong="H6781"\w* \w en|strong="H5921"\w* tus muñecas \w y|strong="H5921"\w* un collar \w en|strong="H5921"\w* tu cuello.  
\v 12 \w Puse|strong="H5414"\w* un anillo \w en|strong="H5921"\w* tu nariz, aretes \w en|strong="H5921"\w* tus orejas \w y|strong="H5921"\w* una hermosa \w corona|strong="H5850"\w* \w en|strong="H5921"\w* tu \w cabeza|strong="H7218"\w*.  
\v 13 Así quedaste adornada con \w oro|strong="H2091"\w* y \w plata|strong="H3701"\w*; tu ropa era de lino fino, seda y bordado. Comías harina fina, \w miel|strong="H1706"\w* y \w aceite|strong="H8081"\w*. Eras \w muy|strong="H3966"\w* \w hermosa|strong="H3302"\w* y llegaste \w a|strong="H3068"\w* ser una reina.  
\v 14 Tu \w fama|strong="H8034"\w* \w se|strong="H1931"\w* extendió \w entre|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w por|strong="H5921"\w* tu belleza, \w que|strong="H3588"\w* \w era|strong="H1931"\w* perfecta gracias \w al|strong="H5921"\w* esplendor \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w había|strong="H3588"\w* \w puesto|strong="H3588"\w* \w en|strong="H5921"\w* \w ti|strong="H5921"\w*, \w dice|strong="H5002"\w* \w el|strong="H1931"\w* Señor Yahvé.   
\p
\v 15 “‘Pero tú confiaste \w en|strong="H5921"\w* tu belleza \w y|strong="H5921"\w* aprovechaste tu \w fama|strong="H8034"\w* \w para|strong="H5921"\w* prostituirte; \w te|strong="H5921"\w* entregaste \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w pasaba|strong="H5674"\w*, \w y|strong="H5921"\w* \w fuiste|strong="H1961"\w* suya.  
\v 16 \w Tomaste|strong="H3947"\w* \w de|strong="H5921"\w* tus vestidos \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w hiciste|strong="H6213"\w* santuarios paganos \w de|strong="H5921"\w* colores, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w ellos|strong="H5921"\w* \w te|strong="H5921"\w* prostituiste. ¡Cosas así \w no|strong="H3808"\w* deberían suceder \w jamás|strong="H3808"\w*!  
\v 17 \w Tomaste|strong="H3947"\w* las hermosas joyas \w de|strong="H5414"\w* \w oro|strong="H2091"\w* y \w plata|strong="H3701"\w* que \w yo|strong="H6213"\w* te \w había|strong="H6213"\w* \w dado|strong="H5414"\w*, te \w hiciste|strong="H6213"\w* \w imágenes|strong="H6754"\w* \w de|strong="H5414"\w* hombres y te prostituiste con ellas.  
\v 18 \w Tomaste|strong="H3947"\w* tus \w vestidos|strong="H3680"\w* \w bordados|strong="H7553"\w* y las \w cubriste|strong="H3680"\w*, y ofreciste mi \w aceite|strong="H8081"\w* y mi incienso \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ellas.  
\v 19 El \w pan|strong="H3899"\w* \w que|strong="H1961"\w* yo te \w di|strong="H5414"\w*, la harina fina, el \w aceite|strong="H8081"\w* y la \w miel|strong="H1706"\w* con \w que|strong="H1961"\w* te alimentaba, lo \w pusiste|strong="H5414"\w* \w ante|strong="H6440"\w* ellas \w como|strong="H1961"\w* ofrenda \w de|strong="H6440"\w* aroma agradable. ¡\w Y|strong="H3068"\w* así \w fue|strong="H1961"\w*!, \w dice|strong="H5002"\w* el Señor Yahvé.   
\p
\v 20 “‘Además, \w tomaste|strong="H3947"\w* \w a|strong="H3068"\w* tus \w hijos|strong="H1121"\w* y \w a|strong="H3068"\w* tus \w hijas|strong="H1323"\w*, \w los|strong="H1121"\w* \w que|strong="H1121"\w* me habías dado \w a|strong="H3068"\w* luz, y \w los|strong="H1121"\w* sacrificaste \w a|strong="H3068"\w* esos ídolos para \w que|strong="H1121"\w* se \w los|strong="H1121"\w* devoraran. ¿Te parece \w poco|strong="H4592"\w* tu prostitución,  
\v 21 \w que|strong="H1121"\w* mataste \w a|strong="H3068"\w* \w mis|strong="H5414"\w* \w hijos|strong="H1121"\w* y \w los|strong="H1121"\w* \w entregaste|strong="H5414"\w* \w para|strong="H5414"\w* \w que|strong="H1121"\w* \w los|strong="H1121"\w* \w pasaran|strong="H5674"\w* \w por|strong="H5414"\w* \w el|strong="H1121"\w* fuego?  
\v 22 En \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w* y prostituciones \w no|strong="H3808"\w* te acordaste \w de|strong="H1818"\w* \w los|strong="H3605"\w* \w días|strong="H3117"\w* \w de|strong="H1818"\w* tu \w juventud|strong="H5271"\w*, \w cuando|strong="H3117"\w* \w estabas|strong="H1961"\w* \w desnuda|strong="H5903"\w* y expuesta, revolcándote en tu \w sangre|strong="H1818"\w*.   
\p
\v 23 “‘\w Y|strong="H3068"\w* \w después|strong="H1961"\w* \w de|strong="H7451"\w* \w toda|strong="H3605"\w* tu \w maldad|strong="H7451"\w* —¡ay, ay \w de|strong="H7451"\w* ti!, \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé—,  
\v 24 te construiste un prostíbulo y te \w hiciste|strong="H6213"\w* un \w altar|strong="H7413"\w* en \w cada|strong="H3605"\w* plaza.  
\v 25 En \w cada|strong="H3605"\w* esquina construiste tu \w altar|strong="H7413"\w*, y convertiste tu belleza en algo \w abominable|strong="H8581"\w*; te ofreciste \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w que|strong="H3605"\w* \w pasaba|strong="H5674"\w* y \w multiplicaste|strong="H7235"\w* tu prostitución.  
\v 26 Te prostituiste con \w los|strong="H1121"\w* \w egipcios|strong="H4714"\w*, tus \w vecinos|strong="H7934"\w* \w de|strong="H1121"\w* miembros grandes, y aumentaste tu prostitución para provocar mi ira.  
\v 27 \w Por|strong="H5921"\w* eso \w extendí|strong="H5186"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* reduje tu ración; \w te|strong="H5921"\w* \w entregué|strong="H5414"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w voluntad|strong="H5315"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* odian, \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w filisteos|strong="H6430"\w*, \w que|strong="H5921"\w* \w se|strong="H5921"\w* avergüenzan \w de|strong="H5921"\w* tu conducta descarada.  
\v 28 \w También|strong="H1571"\w* te prostituiste \w con|strong="H1571"\w* \w los|strong="H1121"\w* asirios, \w porque|strong="H3808"\w* eras insaciable; te prostituiste \w con|strong="H1571"\w* \w ellos|strong="H1571"\w* \w y|strong="H1571"\w* \w ni|strong="H3808"\w* \w así|strong="H1571"\w* quedaste satisfecha.  
\v 29 \w Multiplicaste|strong="H7235"\w* tu prostitución en \w la|strong="H1571"\w* tierra \w de|strong="H7646"\w* los comerciantes, en Caldea, \w y|strong="H1571"\w* \w ni|strong="H3808"\w* \w con|strong="H1571"\w* \w eso|strong="H2063"\w* te saciaste.   
\p
\v 30 “‘¡\w Qué|strong="H4100"\w* débil es \w tu|strong="H6213"\w* \w corazón|strong="H3826"\w* —\w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé— al \w hacer|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas, propias de una prostituta desvergonzada!  
\v 31 Construyes \w tu|strong="H6213"\w* prostíbulo en \w cada|strong="H3605"\w* esquina y \w haces|strong="H6213"\w* \w tu|strong="H6213"\w* \w altar|strong="H7413"\w* en \w cada|strong="H3605"\w* plaza, pero \w ni|strong="H3808"\w* siquiera \w eres|strong="H1961"\w* \w como|strong="H1961"\w* una prostituta común, \w porque|strong="H3808"\w* desprecias \w la|strong="H3605"\w* paga.   
\p
\v 32 “‘¡Eres una esposa \w adúltera|strong="H5003"\w*, que \w recibe|strong="H3947"\w* \w a|strong="H3068"\w* extraños \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* \w a|strong="H3068"\w* su marido!  
\v 33 \w A|strong="H3068"\w* \w todas|strong="H3605"\w* las prostitutas les \w dan|strong="H5414"\w* regalos; pero tú \w das|strong="H5414"\w* tus regalos \w a|strong="H3068"\w* \w todos|strong="H3605"\w* tus amantes y \w los|strong="H3605"\w* sobornas \w para|strong="H5414"\w* \w que|strong="H3605"\w* vengan \w a|strong="H3068"\w* ti \w de|strong="H5414"\w* \w todas|strong="H3605"\w* \w partes|strong="H5439"\w* \w a|strong="H3068"\w* cometer \w fornicación|strong="H8457"\w*.  
\v 34 \w En|strong="H4480"\w* tu prostitución \w eres|strong="H1961"\w* diferente \w a|strong="H3068"\w* las demás mujeres: \w nadie|strong="H3808"\w* \w te|strong="H4480"\w* busca \w para|strong="H4480"\w* prostituirte, y tú pagas \w en|strong="H4480"\w* lugar \w de|strong="H4480"\w* cobrar; \w por|strong="H4480"\w* eso \w eres|strong="H1961"\w* diferente’.   
\p
\v 35 “\w Por|strong="H1697"\w* \w tanto|strong="H3651"\w*, prostituta, \w escucha|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé:  
\v 36 \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: ‘\w Por|strong="H5921"\w* haber \w derramado|strong="H8210"\w* tu lujuria \w y|strong="H5921"\w* haber descubierto tu \w desnudez|strong="H6172"\w* \w en|strong="H5921"\w* tus prostituciones \w con|strong="H5921"\w* tus amantes \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w todos|strong="H3605"\w* tus \w ídolos|strong="H1544"\w* abominables, \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* \w de|strong="H5921"\w* tus \w hijos|strong="H1121"\w* \w que|strong="H5921"\w* \w les|strong="H5921"\w* \w entregaste|strong="H5414"\w*;  
\v 37 \w por|strong="H5921"\w* \w eso|strong="H3651"\w*, voy \w a|strong="H3068"\w* reunir \w a|strong="H3068"\w* \w todos|strong="H3605"\w* tus amantes \w con|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w te|strong="H5921"\w* complaciste, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* amaste \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* odiaste. \w Los|strong="H5921"\w* reuniré \w alrededor|strong="H5439"\w* \w de|strong="H5921"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w descubriré|strong="H1540"\w* tu \w desnudez|strong="H6172"\w* ante \w ellos|strong="H5921"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w vean|strong="H7200"\w* \w toda|strong="H3605"\w* tu \w vergüenza|strong="H6172"\w*.  
\v 38 Te \w juzgaré|strong="H8199"\w* con las leyes \w de|strong="H5414"\w* las \w adúlteras|strong="H5003"\w* y \w de|strong="H5414"\w* las que derraman \w sangre|strong="H1818"\w*, y \w derramaré|strong="H8210"\w* sobre ti mi \w ira|strong="H2534"\w* y \w mis|strong="H5414"\w* celos.  
\v 39 Te \w entregaré|strong="H5414"\w* en sus \w manos|strong="H3027"\w*, y \w ellos|strong="H3027"\w* \w destruirán|strong="H5422"\w* tus prostíbulos y derribarán tus altares; te quitarán la ropa, se llevarán tus hermosas joyas y te dejarán \w desnuda|strong="H5903"\w* y expuesta.  
\v 40 Traerán una \w multitud|strong="H6951"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, \w te|strong="H5921"\w* apedrearán \w y|strong="H5921"\w* \w te|strong="H5921"\w* \w atravesarán|strong="H1333"\w* \w con|strong="H5921"\w* sus \w espadas|strong="H2719"\w*.  
\v 41 \w Quemarán|strong="H8313"\w* tus \w casas|strong="H1004"\w* \w y|strong="H1571"\w* ejecutarán \w juicios|strong="H8201"\w* contra ti \w a|strong="H3068"\w* \w la|strong="H1571"\w* vista \w de|strong="H5750"\w* \w muchas|strong="H7227"\w* mujeres. \w Haré|strong="H6213"\w* \w que|strong="H3808"\w* dejes \w de|strong="H5750"\w* ser prostituta \w y|strong="H1571"\w* \w que|strong="H3808"\w* \w ya|strong="H1571"\w* \w no|strong="H3808"\w* pagues \w a|strong="H3068"\w* tus amantes.  
\v 42 Así desahogaré mi \w ira|strong="H2534"\w* \w contra|strong="H4480"\w* \w ti|strong="H4480"\w* y \w se|strong="H4480"\w* apartarán \w de|strong="H4480"\w* \w ti|strong="H4480"\w* mis celos; \w me|strong="H4480"\w* calmaré y \w no|strong="H3808"\w* \w me|strong="H4480"\w* enojaré \w más|strong="H5750"\w*.   
\p
\v 43 “‘\w Por|strong="H5921"\w* \w cuanto|strong="H3282"\w* \w no|strong="H3808"\w* \w te|strong="H5921"\w* acordaste \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* \w tu|strong="H6213"\w* \w juventud|strong="H5271"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* \w me|strong="H5921"\w* provocaste \w con|strong="H5921"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas, \w yo|strong="H6213"\w* \w también|strong="H1571"\w* \w haré|strong="H6213"\w* recaer \w tu|strong="H6213"\w* conducta \w sobre|strong="H5921"\w* \w tu|strong="H6213"\w* \w cabeza|strong="H7218"\w* —\w dice|strong="H5002"\w* \w el|strong="H5921"\w* Señor Yahvé—, \w para|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* cometas \w más|strong="H1571"\w* depravación \w además|strong="H5921"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* tus \w abominaciones|strong="H8441"\w*.   
\p
\v 44 “‘\w Todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* usa refranes \w te|strong="H5921"\w* aplicará este dicho: “\w De|strong="H5921"\w* tal madre, tal \w hija|strong="H1323"\w*”.  
\v 45 Tú eres \w hija|strong="H1323"\w* \w de|strong="H1121"\w* tu madre, \w que|strong="H1121"\w* despreció \w a|strong="H3068"\w* su marido y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*; y eres hermana \w de|strong="H1121"\w* tus hermanas, \w que|strong="H1121"\w* despreciaron \w a|strong="H3068"\w* sus maridos y \w a|strong="H3068"\w* sus \w hijos|strong="H1121"\w*. La madre \w de|strong="H1121"\w* ustedes fue hitita, y su padre, amorreo.  
\v 46 Tu hermana \w mayor|strong="H1419"\w* \w es|strong="H1931"\w* \w Samaria|strong="H8111"\w*, \w que|strong="H4480"\w* vive \w al|strong="H5921"\w* norte \w con|strong="H5921"\w* \w sus|strong="H1931"\w* \w hijas|strong="H1323"\w*; \w y|strong="H5921"\w* tu hermana \w menor|strong="H6996"\w*, \w que|strong="H4480"\w* vive \w al|strong="H5921"\w* sur \w con|strong="H5921"\w* \w sus|strong="H1931"\w* \w hijas|strong="H1323"\w*, \w es|strong="H1931"\w* \w Sodoma|strong="H5467"\w*.  
\v 47 \w No|strong="H3808"\w* solo seguiste sus \w caminos|strong="H1870"\w* \w e|strong="H3068"\w* \w hiciste|strong="H6213"\w* sus \w abominaciones|strong="H8441"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* en muy \w poco|strong="H4592"\w* tiempo te \w corrompiste|strong="H7843"\w* \w más|strong="H3808"\w* \w que|strong="H3808"\w* ellas en \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* hacías.  
\v 48 \w Tan|strong="H1931"\w* cierto \w como|strong="H1931"\w* \w que|strong="H1931"\w* \w yo|strong="H6213"\w* \w vivo|strong="H2416"\w* —\w dice|strong="H5002"\w* \w el|strong="H1931"\w* Señor Yahvé—, \w tu|strong="H6213"\w* hermana \w Sodoma|strong="H5467"\w* y \w sus|strong="H1931"\w* \w hijas|strong="H1323"\w* \w no|strong="H6213"\w* han \w hecho|strong="H6213"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w tú|strong="H6213"\w* y tus \w hijas|strong="H1323"\w* han \w hecho|strong="H6213"\w*.   
\p
\v 49 “‘\w Esta|strong="H2088"\w* \w fue|strong="H1961"\w* la \w maldad|strong="H5771"\w* de tu hermana \w Sodoma|strong="H5467"\w*: ella y sus \w hijas|strong="H1323"\w* \w eran|strong="H1961"\w* orgullosas, \w tenían|strong="H1961"\w* exceso de \w comida|strong="H3899"\w* y gozaban de una tranquilidad despreocupada, pero \w no|strong="H3808"\w* \w ayudaron|strong="H2388"\w* al \w pobre|strong="H6041"\w* \w ni|strong="H3808"\w* al necesitado.  
\v 50 Se volvieron arrogantes \w e|strong="H3068"\w* \w hicieron|strong="H6213"\w* cosas abominables \w delante|strong="H6440"\w* \w de|strong="H6440"\w* mí; \w por|strong="H6440"\w* eso las \w quité|strong="H5493"\w* \w de|strong="H6440"\w* \w en|strong="H5493"\w* medio, como has \w visto|strong="H7200"\w*.  
\v 51 \w Samaria|strong="H8111"\w* \w no|strong="H3808"\w* \w cometió|strong="H2398"\w* \w ni|strong="H3808"\w* \w la|strong="H3605"\w* mitad de tus \w pecados|strong="H2403"\w*; \w tú|strong="H6213"\w* has multiplicado tus \w abominaciones|strong="H8441"\w* \w más|strong="H7235"\w* \w que|strong="H3808"\w* \w ellas|strong="H2007"\w*, y con \w todas|strong="H3605"\w* las \w abominaciones|strong="H8441"\w* \w que|strong="H3808"\w* has \w hecho|strong="H6213"\w*, has \w hecho|strong="H6213"\w* parecer justas \w a|strong="H3068"\w* tus hermanas.  
\v 52 Carga tú \w también|strong="H1571"\w* \w con|strong="H4480"\w* tu \w vergüenza|strong="H3639"\w*, \w ya|strong="H1571"\w* \w que|strong="H4480"\w* has servido \w de|strong="H4480"\w* justificación \w para|strong="H4480"\w* tus hermanas. \w Como|strong="H1571"\w* tus \w pecados|strong="H2403"\w* son \w más|strong="H4480"\w* \w abominables|strong="H8581"\w* \w que|strong="H4480"\w* los \w de|strong="H4480"\w* ellas, ellas resultan \w más|strong="H4480"\w* justas \w que|strong="H4480"\w* tú. Avergüénzate, \w pues|strong="H4480"\w*, \w y|strong="H1571"\w* \w lleva|strong="H5375"\w* tu deshonra, porque has hecho \w que|strong="H4480"\w* tus hermanas parezcan justas.   
\p
\v 53 “‘Yo restauraré su bienestar, el bienestar de \w Sodoma|strong="H5467"\w* y de sus \w hijas|strong="H1323"\w*, y el bienestar de \w Samaria|strong="H8111"\w* y de sus \w hijas|strong="H1323"\w*; y también restauraré tu bienestar \w entre|strong="H8432"\w* ellas,  
\v 54 \w para|strong="H4616"\w* \w que|strong="H4616"\w* cargues con \w tu|strong="H6213"\w* deshonra y te avergüences de \w todo|strong="H3605"\w* \w lo|strong="H6213"\w* \w que|strong="H4616"\w* has \w hecho|strong="H6213"\w*, sirviéndoles de \w consuelo|strong="H5162"\w* \w a|strong="H3068"\w* ellas.  
\v 55 Tus hermanas, \w Sodoma|strong="H5467"\w* y sus \w hijas|strong="H1323"\w*, \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* su estado anterior; \w Samaria|strong="H8111"\w* y sus \w hijas|strong="H1323"\w* \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* su estado anterior; y tú y tus \w hijas|strong="H1323"\w* también \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* su estado anterior.  
\v 56 ¿Acaso \w no|strong="H3808"\w* mencionabas \w a|strong="H3068"\w* tu hermana \w Sodoma|strong="H5467"\w* en \w los|strong="H1961"\w* \w días|strong="H3117"\w* de tu orgullo,  
\v 57 \w antes|strong="H2962"\w* \w de|strong="H7451"\w* \w que|strong="H6256"\w* se descubriera tu \w maldad|strong="H7451"\w*? Ahora eres, \w como|strong="H3644"\w* \w ella|strong="H3605"\w*, objeto \w de|strong="H7451"\w* burla \w de|strong="H7451"\w* las \w hijas|strong="H1323"\w* \w de|strong="H7451"\w* \w los|strong="H3605"\w* arameos y \w de|strong="H7451"\w* \w todas|strong="H3605"\w* las \w que|strong="H6256"\w* las \w rodean|strong="H5439"\w*, y \w de|strong="H7451"\w* las \w hijas|strong="H1323"\w* \w de|strong="H7451"\w* \w los|strong="H3605"\w* \w filisteos|strong="H6430"\w* \w que|strong="H6256"\w* te desprecian por \w todos|strong="H3605"\w* \w lados|strong="H5439"\w*.  
\v 58 Tú cargarás con el castigo de tu lujuria y de tus \w abominaciones|strong="H8441"\w*, \w dice|strong="H5002"\w* Yahvé.   
\p
\v 59 “‘\w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice \w el|strong="H3588"\w* Señor Yahvé: ¿\w Haré|strong="H6213"\w* contigo \w como|strong="H3588"\w* \w tú|strong="H6213"\w* \w hiciste|strong="H6213"\w*, \w que|strong="H3588"\w* menospreciaste \w el|strong="H3588"\w* juramento rompiendo \w el|strong="H3588"\w* \w pacto|strong="H1285"\w*?  
\v 60 Sin embargo, yo recordaré mi \w pacto|strong="H1285"\w* contigo en los \w días|strong="H3117"\w* de tu \w juventud|strong="H5271"\w*, y \w estableceré|strong="H6965"\w* contigo un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*.  
\v 61 Entonces \w te|strong="H4480"\w* acordarás \w de|strong="H4480"\w* tus \w caminos|strong="H1870"\w* y \w te|strong="H4480"\w* avergonzarás cuando \w recibas|strong="H3947"\w* \w a|strong="H3068"\w* tus hermanas, las \w mayores|strong="H1419"\w* y las \w menores|strong="H6996"\w* \w que|strong="H4480"\w* tú; \w yo|strong="H4480"\w* \w te|strong="H4480"\w* las \w daré|strong="H5414"\w* \w por|strong="H4480"\w* \w hijas|strong="H1323"\w*, pero \w no|strong="H3808"\w* \w por|strong="H4480"\w* el \w pacto|strong="H1285"\w* contigo,  
\v 62 \w sino|strong="H3588"\w* \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w estableceré|strong="H6965"\w* mi \w pacto|strong="H1285"\w* contigo; \w y|strong="H3588"\w* \w sabrás|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé.  
\v 63 \w Esto|strong="H6213"\w* \w es|strong="H1961"\w* \w para|strong="H4616"\w* \w que|strong="H3808"\w* \w recuerdes|strong="H2142"\w* y te avergüences, y \w nunca|strong="H3808"\w* \w más|strong="H5750"\w* \w abras|strong="H6610"\w* \w la|strong="H3605"\w* \w boca|strong="H6310"\w* \w por|strong="H4616"\w* \w causa|strong="H6440"\w* \w de|strong="H6440"\w* \w tu|strong="H6213"\w* \w vergüenza|strong="H3639"\w*, \w cuando|strong="H1961"\w* \w yo|strong="H6213"\w* te \w haya|strong="H1961"\w* perdonado \w todo|strong="H3605"\w* \w lo|strong="H3808"\w* \w que|strong="H3808"\w* has \w hecho|strong="H6213"\w*, \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé’”.   
\c 17  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, propón un acertijo y cuenta una \w parábola|strong="H4912"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 3 Diles: \w Así|strong="H3541"\w* dice el Señor Yahvé: ‘Una \w gran|strong="H1419"\w* águila, de \w alas|strong="H3671"\w* gigantescas \w y|strong="H3541"\w* plumaje largo, \w llena|strong="H4392"\w* de \w plumas|strong="H5133"\w* de muchos colores, vino al \w Líbano|strong="H3844"\w* \w y|strong="H3541"\w* agarró la copa del cedro.  
\v 4 \w Arrancó|strong="H6998"\w* la punta de sus ramas más jóvenes y se la llevó \w a|strong="H3068"\w* un país de comerciantes; la \w puso|strong="H7760"\w* en una \w ciudad|strong="H5892"\w* de mercaderes.   
\p
\v 5 “‘\w Tomó|strong="H3947"\w* también semilla \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w la|strong="H5921"\w* sembró \w en|strong="H5921"\w* un \w campo|strong="H7704"\w* fértil; \w la|strong="H5921"\w* colocó \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w aguas|strong="H4325"\w* abundantes \w y|strong="H5921"\w* \w la|strong="H5921"\w* plantó \w como|strong="H5921"\w* un sauce.  
\v 6 \w Brotó|strong="H6779"\w* y \w se|strong="H1961"\w* convirtió \w en|strong="H8478"\w* una \w vid|strong="H1612"\w* \w de|strong="H8478"\w* poca \w altura|strong="H6967"\w* pero muy extendida, \w de|strong="H8478"\w* modo \w que|strong="H1961"\w* sus ramas \w se|strong="H1961"\w* volvían \w hacia|strong="H6213"\w* \w el|strong="H6213"\w* águila y sus \w raíces|strong="H8328"\w* \w estaban|strong="H1961"\w* \w debajo|strong="H8478"\w* \w de|strong="H8478"\w* ella. Así \w se|strong="H1961"\w* convirtió \w en|strong="H8478"\w* una \w vid|strong="H1612"\w*, \w echó|strong="H7971"\w* ramas y produjo retoños.   
\p
\v 7 “‘Pero \w había|strong="H1961"\w* otra \w gran|strong="H1419"\w* águila, \w de|strong="H5921"\w* \w alas|strong="H3671"\w* \w grandes|strong="H1419"\w* \w y|strong="H5921"\w* abundante plumaje. \w Y|strong="H3068"\w* miren, \w esta|strong="H2063"\w* \w vid|strong="H1612"\w* \w extendió|strong="H7971"\w* sus \w raíces|strong="H8328"\w* \w hacia|strong="H5921"\w* \w ella|strong="H5921"\w* \w y|strong="H5921"\w* dirigió sus ramas \w hacia|strong="H5921"\w* \w ella|strong="H5921"\w* \w desde|strong="H5921"\w* \w el|strong="H5921"\w* surco \w donde|strong="H5921"\w* \w estaba|strong="H1961"\w* plantada, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* regara.  
\v 8 \w Había|strong="H1961"\w* \w sido|strong="H1961"\w* \w plantada|strong="H8362"\w* en \w buena|strong="H2896"\w* tierra, junto \w a|strong="H3068"\w* \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w*, \w para|strong="H1961"\w* \w que|strong="H1931"\w* echara ramas, diera \w fruto|strong="H6529"\w* y \w se|strong="H1961"\w* convirtiera en una \w vid|strong="H1612"\w* espléndida’.   
\p
\v 9 “Diles: \w Así|strong="H3541"\w* dice \w el|strong="H3605"\w* Señor Yahvé: ‘¿Acaso tendrá éxito? ¿\w No|strong="H3808"\w* \w arrancará|strong="H5423"\w* \w el|strong="H3605"\w* águila sus \w raíces|strong="H8328"\w* \w y|strong="H3541"\w* cortará su \w fruto|strong="H6529"\w* \w para|strong="H5971"\w* \w que|strong="H3808"\w* \w se|strong="H3808"\w* seque? \w Todas|strong="H3605"\w* sus hojas tiernas \w se|strong="H3808"\w* marchitarán. \w No|strong="H3808"\w* hará falta un \w brazo|strong="H2220"\w* fuerte \w ni|strong="H3808"\w* \w mucha|strong="H7227"\w* \w gente|strong="H5971"\w* \w para|strong="H5971"\w* arrancarla \w de|strong="H5971"\w* raíz.  
\v 10 \w Aunque|strong="H3808"\w* esté \w plantada|strong="H8362"\w*, ¿\w prosperará|strong="H6743"\w*? ¿\w No|strong="H3808"\w* \w se|strong="H5921"\w* \w secará|strong="H3001"\w* \w por|strong="H5921"\w* completo cuando \w la|strong="H5921"\w* toque \w el|strong="H5921"\w* \w viento|strong="H7307"\w* \w del|strong="H5921"\w* este? \w Se|strong="H5921"\w* \w secará|strong="H3001"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* mismo surco \w donde|strong="H5921"\w* brotó’”.   
\p
\v 11 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 12 “Dile \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* esa \w casa|strong="H1004"\w* \w rebelde|strong="H4805"\w*: ‘¿\w No|strong="H3808"\w* \w saben|strong="H3045"\w* \w qué|strong="H4100"\w* \w significan|strong="H3808"\w* estas \w cosas|strong="H3045"\w*?’. Díganles: ‘Miren, el \w rey|strong="H4428"\w* \w de|strong="H8269"\w* Babilonia \w vino|strong="H4100"\w* \w a|strong="H3068"\w* Jerusalén, \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* su \w rey|strong="H4428"\w* y \w a|strong="H3068"\w* sus \w príncipes|strong="H8269"\w* y \w se|strong="H3045"\w* los \w llevó|strong="H3947"\w* con él \w a|strong="H3068"\w* Babilonia.  
\v 13 \w Tomó|strong="H3947"\w* también \w a|strong="H3068"\w* un miembro de la realeza \w e|strong="H3068"\w* \w hizo|strong="H3772"\w* un \w pacto|strong="H1285"\w* con él, poniéndolo bajo juramento. Se \w llevó|strong="H3947"\w* \w a|strong="H3068"\w* los hombres poderosos del país,  
\v 14 \w para|strong="H1961"\w* \w que|strong="H1115"\w* el \w reino|strong="H4467"\w* \w fuera|strong="H1961"\w* humillado y \w no|strong="H1961"\w* pudiera levantarse, y \w para|strong="H1961"\w* \w que|strong="H1115"\w*, \w guardando|strong="H8104"\w* el \w pacto|strong="H1285"\w*, pudiera subsistir.  
\v 15 Pero \w el|strong="H6213"\w* \w rey|strong="H6213"\w* \w se|strong="H5971"\w* rebeló contra \w él|strong="H6213"\w* enviando \w embajadores|strong="H4397"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5414"\w* conseguir \w caballos|strong="H5483"\w* y un \w gran|strong="H7227"\w* ejército. ¿Podrá tener éxito? ¿\w Escapará|strong="H4422"\w* \w el|strong="H6213"\w* \w que|strong="H5971"\w* \w hace|strong="H6213"\w* tales \w cosas|strong="H7227"\w*? ¿Podrá romper \w el|strong="H6213"\w* \w pacto|strong="H1285"\w* y aun así salir \w librado|strong="H4422"\w*?   
\p
\v 16 “‘Tan \w cierto|strong="H3808"\w* como \w que|strong="H3808"\w* yo \w vivo|strong="H2416"\w*, \w dice|strong="H5002"\w* el Señor Yahvé, \w que|strong="H3808"\w* \w morirá|strong="H4191"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de Babilonia, \w en|strong="H8432"\w* el \w lugar|strong="H4725"\w* \w donde|strong="H4725"\w* \w vive|strong="H2416"\w* el \w rey|strong="H4428"\w* \w que|strong="H3808"\w* \w lo|strong="H3808"\w* puso \w en|strong="H8432"\w* el trono, cuyo juramento despreció y cuyo \w pacto|strong="H1285"\w* rompió.  
\v 17 \w El|strong="H6213"\w* \w faraón|strong="H6547"\w*, con su \w gran|strong="H1419"\w* \w ejército|strong="H2428"\w* y sus \w muchas|strong="H7227"\w* tropas, \w no|strong="H3808"\w* \w lo|strong="H3808"\w* ayudará en la \w guerra|strong="H4421"\w* cuando levanten rampas y construyan torres de asedio para destruir \w muchas|strong="H7227"\w* \w vidas|strong="H5315"\w*.  
\v 18 \w Por|strong="H3027"\w* \w haber|strong="H3808"\w* despreciado \w el|strong="H3605"\w* juramento y \w haber|strong="H3808"\w* roto \w el|strong="H3605"\w* \w pacto|strong="H1285"\w* —pues miren, \w había|strong="H6213"\w* \w dado|strong="H5414"\w* su \w mano|strong="H3027"\w* y \w aun|strong="H3808"\w* así \w hizo|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* cosas—, \w no|strong="H3808"\w* \w escapará|strong="H4422"\w*.   
\p
\v 19 “‘\w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice el Señor Yahvé: Tan \w cierto|strong="H3651"\w* \w como|strong="H3651"\w* \w que|strong="H3808"\w* yo \w vivo|strong="H2416"\w*, \w haré|strong="H5414"\w* recaer sobre su propia \w cabeza|strong="H7218"\w* mi juramento \w que|strong="H3808"\w* despreció \w y|strong="H3541"\w* mi \w pacto|strong="H1285"\w* \w que|strong="H3808"\w* rompió.  
\v 20 \w Extenderé|strong="H6566"\w* \w mi|strong="H5921"\w* \w red|strong="H7568"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* caerá \w en|strong="H5921"\w* \w mi|strong="H5921"\w* trampa; \w lo|strong="H5921"\w* llevaré \w a|strong="H3068"\w* Babilonia \w y|strong="H5921"\w* \w allí|strong="H8033"\w* \w lo|strong="H5921"\w* \w juzgaré|strong="H8199"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* traición \w que|strong="H5921"\w* \w cometió|strong="H4604"\w* \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*.  
\v 21 \w Todos|strong="H3605"\w* sus fugitivos, \w con|strong="H3588"\w* \w todas|strong="H3605"\w* sus tropas, \w caerán|strong="H5307"\w* \w a|strong="H3068"\w* filo \w de|strong="H3588"\w* \w espada|strong="H2719"\w*, \w y|strong="H3588"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* sobrevivan serán esparcidos \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w vientos|strong="H7307"\w*. \w Entonces|strong="H3588"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, he \w hablado|strong="H1696"\w*.   
\p
\v 22 “‘\w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor Yahvé: Yo mismo \w tomaré|strong="H3947"\w* un retoño \w de|strong="H5921"\w* \w la|strong="H5921"\w* copa \w de|strong="H5921"\w* aquel \w alto|strong="H1364"\w* cedro \w y|strong="H5921"\w* \w lo|strong="H5921"\w* plantaré; \w de|strong="H5921"\w* \w la|strong="H5921"\w* punta \w de|strong="H5921"\w* sus ramas jóvenes \w cortaré|strong="H6998"\w* un tallo \w tierno|strong="H7390"\w* \w y|strong="H5921"\w* \w lo|strong="H5921"\w* plantaré \w en|strong="H5921"\w* un \w monte|strong="H2022"\w* \w alto|strong="H1364"\w* \w y|strong="H5921"\w* elevado.  
\v 23 \w Lo|strong="H6213"\w* plantaré \w en|strong="H8478"\w* \w el|strong="H3605"\w* \w monte|strong="H2022"\w* \w alto|strong="H4791"\w* \w de|strong="H8478"\w* \w Israel|strong="H3478"\w*; echará ramas, dará \w fruto|strong="H6529"\w* y \w se|strong="H1961"\w* convertirá \w en|strong="H8478"\w* un cedro magnífico. \w A|strong="H3068"\w* \w la|strong="H3605"\w* \w sombra|strong="H6738"\w* \w de|strong="H8478"\w* sus ramas anidarán aves \w de|strong="H8478"\w* \w toda|strong="H3605"\w* clase.  
\v 24 \w Y|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* del \w campo|strong="H7704"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w*, Yahvé, derribé \w el|strong="H3588"\w* \w árbol|strong="H6086"\w* \w alto|strong="H1364"\w* \w y|strong="H3588"\w* \w levanté|strong="H1364"\w* \w el|strong="H3588"\w* \w árbol|strong="H6086"\w* \w bajo|strong="H8213"\w*; \w que|strong="H3588"\w* \w hice|strong="H6213"\w* secar \w el|strong="H3588"\w* \w árbol|strong="H6086"\w* \w verde|strong="H3892"\w* \w e|strong="H3068"\w* \w hice|strong="H6213"\w* florecer \w el|strong="H3588"\w* \w árbol|strong="H6086"\w* \w seco|strong="H3001"\w*. \w Yo|strong="H3588"\w*, Yahvé, \w lo|strong="H6213"\w* he \w dicho|strong="H1696"\w* \w y|strong="H3588"\w* \w lo|strong="H6213"\w* cumpliré’”.   
\c 18  
\p
\v 1 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 2 “¿\w Qué|strong="H4100"\w* quieren decir ustedes \w al|strong="H5921"\w* usar \w este|strong="H2088"\w* refrán \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*:  
\q1 ‘\w Los|strong="H1121"\w* padres \w se|strong="H5921"\w* comen \w las|strong="H5921"\w* uvas agrias,  
\q2 \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w se|strong="H5921"\w* \w les|strong="H5921"\w* destemplan \w los|strong="H1121"\w* \w dientes|strong="H8127"\w*’?   
\p
\v 3 “Tan cierto \w como|strong="H1961"\w* \w que|strong="H1961"\w* yo \w vivo|strong="H2416"\w* —\w dice|strong="H5002"\w* el Señor Yahvé— \w que|strong="H1961"\w* nunca \w más|strong="H5750"\w* usarán \w este|strong="H2088"\w* refrán \w en|strong="H5750"\w* \w Israel|strong="H3478"\w*.  
\v 4 Miren, \w todas|strong="H3605"\w* las \w vidas|strong="H5315"\w* son mías; tanto \w la|strong="H1931"\w* \w vida|strong="H5315"\w* del padre \w como|strong="H1931"\w* \w la|strong="H1931"\w* \w vida|strong="H5315"\w* del \w hijo|strong="H1121"\w* me pertenecen. \w El|strong="H1931"\w* \w que|strong="H1931"\w* \w peque|strong="H2398"\w* \w es|strong="H1931"\w* \w quien|strong="H3605"\w* \w morirá|strong="H4191"\w*.   
\b  
\q1
\v 5 “Supongamos \w que|strong="H3588"\w* un hombre \w es|strong="H1961"\w* \w justo|strong="H6662"\w*  
\q2 \w y|strong="H3588"\w* practica \w el|strong="H3588"\w* \w derecho|strong="H4941"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w justicia|strong="H6666"\w*.   
\q1
\v 6 \w No|strong="H3808"\w* come en los santuarios \w de|strong="H5869"\w* los \w montes|strong="H2022"\w*,  
\q2 \w ni|strong="H3808"\w* \w levanta|strong="H5375"\w* la vista hacia los \w ídolos|strong="H1544"\w* \w de|strong="H5869"\w* la \w casa|strong="H1004"\w* \w de|strong="H5869"\w* \w Israel|strong="H3478"\w*;  
\q1 \w no|strong="H3808"\w* deshonra \w a|strong="H3068"\w* la mujer \w de|strong="H5869"\w* su \w prójimo|strong="H7453"\w*,  
\q2 \w ni|strong="H3808"\w* \w se|strong="H3808"\w* acerca \w a|strong="H3068"\w* una mujer durante su menstruación.   
\q1
\v 7 \w No|strong="H3808"\w* oprime \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* devuelve la prenda al deudor;  
\q1 \w no|strong="H3808"\w* comete \w robo|strong="H1497"\w*,  
\q2 comparte su \w pan|strong="H3899"\w* con el hambriento  
\q2 y \w cubre|strong="H3680"\w* con ropa al desnudo.   
\q1
\v 8 \w No|strong="H3808"\w* presta dinero con \w usura|strong="H5392"\w*  
\q2 \w ni|strong="H3808"\w* exige intereses excesivos;  
\q1 retrae su \w mano|strong="H3027"\w* \w de|strong="H5414"\w* la \w maldad|strong="H5766"\w*  
\q2 y juzga con verdad \w entre|strong="H3808"\w* hombre y hombre.   
\q1
\v 9 \w Camina|strong="H1980"\w* según mis \w estatutos|strong="H2708"\w*  
\q2 y obedece mis leyes  
\q2 actuando con fidelidad.  
\q1 \w Ese|strong="H1931"\w* hombre \w es|strong="H1931"\w* \w justo|strong="H6662"\w*;  
\q2 \w ciertamente|strong="H2421"\w* \w vivirá|strong="H2421"\w*”, \w dice|strong="H5002"\w* \w el|strong="H1931"\w* Señor Yahvé.   
\b  
\p
\v 10 “Pero si engendra un \w hijo|strong="H1121"\w* violento y asesino, \w que|strong="H1121"\w* \w hace|strong="H6213"\w* cualquiera \w de|strong="H1121"\w* \w estas|strong="H6213"\w* cosas,  
\v 11 \w aunque|strong="H3588"\w* \w el|strong="H1931"\w* padre \w no|strong="H3808"\w* haya \w hecho|strong="H6213"\w* \w nada|strong="H3808"\w* \w de|strong="H3588"\w* \w esto|strong="H1931"\w*;  
\q1 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H1931"\w* hijo come \w en|strong="H3588"\w* \w los|strong="H3605"\w* santuarios \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w montes|strong="H2022"\w*,  
\q2 deshonra \w a|strong="H3068"\w* \w la|strong="H1931"\w* mujer \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w prójimo|strong="H7453"\w*,   
\q1
\v 12 oprime al \w pobre|strong="H6041"\w* y al necesitado,  
\q2 comete \w robos|strong="H1497"\w*,  
\q1 \w no|strong="H3808"\w* devuelve la prenda empeñada,  
\q2 \w levanta|strong="H5375"\w* la vista \w hacia|strong="H6213"\w* los \w ídolos|strong="H1544"\w*  
\q2 y comete \w abominaciones|strong="H8441"\w*,   
\q1
\v 13 presta dinero con \w usura|strong="H5392"\w*  
\q2 y cobra intereses excesivos,  
\m ¿acaso \w vivirá|strong="H2421"\w*? ¡\w No|strong="H3808"\w* \w vivirá|strong="H2421"\w*! \w Por|strong="H5414"\w* \w haber|strong="H1961"\w* \w hecho|strong="H6213"\w* \w todas|strong="H3605"\w* \w estas|strong="H6213"\w* \w abominaciones|strong="H8441"\w*, \w ciertamente|strong="H4191"\w* \w morirá|strong="H4191"\w*; su \w sangre|strong="H1818"\w* caerá \w sobre|strong="H1961"\w* \w él|strong="H3605"\w*.   
\p
\v 14 “Pero \w si|strong="H3808"\w* este tiene un \w hijo|strong="H1121"\w* \w que|strong="H3808"\w* \w ve|strong="H7200"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* \w pecados|strong="H2403"\w* \w que|strong="H3808"\w* su padre \w cometió|strong="H6213"\w*, y al verlos, \w no|strong="H3808"\w* sigue su ejemplo;   
\q1
\v 15 \w que|strong="H3808"\w* \w no|strong="H3808"\w* come \w en|strong="H5921"\w* \w los|strong="H5921"\w* santuarios \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w*,  
\q2 \w ni|strong="H3808"\w* \w levanta|strong="H5375"\w* \w la|strong="H5921"\w* vista \w hacia|strong="H5921"\w* \w los|strong="H5921"\w* \w ídolos|strong="H1544"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*,  
\q2 \w ni|strong="H3808"\w* deshonra \w a|strong="H3068"\w* \w la|strong="H5921"\w* mujer \w de|strong="H5921"\w* su \w prójimo|strong="H7453"\w*,   
\q1
\v 16 \w que|strong="H3808"\w* \w no|strong="H3808"\w* oprime \w a|strong="H3068"\w* \w nadie|strong="H3808"\w*,  
\q2 \w ni|strong="H3808"\w* retiene la prenda empeñada,  
\q1 \w ni|strong="H3808"\w* comete \w robo|strong="H1497"\w*,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* comparte su \w pan|strong="H3899"\w* con el hambriento,  
\q2 y \w cubre|strong="H3680"\w* con ropa al desnudo;   
\q1
\v 17 \w que|strong="H1931"\w* aparta \w su|strong="H1931"\w* \w mano|strong="H3027"\w* de \w la|strong="H1931"\w* \w maldad|strong="H5771"\w*,  
\q2 y \w no|strong="H3808"\w* cobra \w usura|strong="H5392"\w* \w ni|strong="H3808"\w* intereses;  
\q1 \w que|strong="H1931"\w* cumple mis leyes  
\q2 y \w camina|strong="H1980"\w* según mis \w estatutos|strong="H2708"\w*;  
\m \w este|strong="H1931"\w* \w no|strong="H3808"\w* \w morirá|strong="H4191"\w* \w por|strong="H3027"\w* \w la|strong="H1931"\w* \w maldad|strong="H5771"\w* de \w su|strong="H1931"\w* padre. \w Ciertamente|strong="H4191"\w* \w vivirá|strong="H2421"\w*.  
\v 18 \w Pero|strong="H3588"\w* \w su|strong="H3588"\w* padre, \w por|strong="H3588"\w* \w cuanto|strong="H3588"\w* \w fue|strong="H3808"\w* un opresor cruel, \w robó|strong="H1497"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* hermano \w e|strong="H3068"\w* \w hizo|strong="H6213"\w* \w lo|strong="H3808"\w* \w malo|strong="H5771"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w morirá|strong="H4191"\w* \w por|strong="H3588"\w* \w su|strong="H3588"\w* propia \w maldad|strong="H5771"\w*.   
\p
\v 19 “\w Sin|strong="H3808"\w* embargo, ustedes preguntan: ‘¿\w Por|strong="H4069"\w* \w qué|strong="H3808"\w* \w el|strong="H3605"\w* \w hijo|strong="H1121"\w* \w no|strong="H3808"\w* carga con \w la|strong="H8104"\w* culpa \w de|strong="H1121"\w* su padre?’. \w Porque|strong="H3808"\w* \w el|strong="H3605"\w* \w hijo|strong="H1121"\w* actuó con rectitud y \w justicia|strong="H6666"\w*, \w guardó|strong="H8104"\w* \w todos|strong="H3605"\w* \w mis|strong="H5375"\w* \w estatutos|strong="H2708"\w* y \w los|strong="H1121"\w* cumplió; \w por|strong="H4069"\w* eso \w ciertamente|strong="H2421"\w* \w vivirá|strong="H2421"\w*.  
\v 20 \w El|strong="H1931"\w* \w que|strong="H1931"\w* \w peque|strong="H2398"\w* \w es|strong="H1931"\w* \w quien|strong="H1931"\w* \w morirá|strong="H4191"\w*. \w El|strong="H1931"\w* \w hijo|strong="H1121"\w* \w no|strong="H3808"\w* \w cargará|strong="H1961"\w* \w con|strong="H5921"\w* \w la|strong="H1931"\w* culpa \w del|strong="H5921"\w* padre, \w ni|strong="H3808"\w* \w el|strong="H1931"\w* padre \w cargará|strong="H1961"\w* \w con|strong="H5921"\w* \w la|strong="H1931"\w* culpa \w del|strong="H5921"\w* \w hijo|strong="H1121"\w*. \w La|strong="H1931"\w* \w justicia|strong="H6666"\w* \w del|strong="H5921"\w* \w justo|strong="H6662"\w* \w será|strong="H1961"\w* \w sobre|strong="H5921"\w* \w él|strong="H1931"\w*, \w y|strong="H5921"\w* \w la|strong="H1931"\w* \w maldad|strong="H5771"\w* \w del|strong="H5921"\w* malvado \w será|strong="H1961"\w* \w sobre|strong="H5921"\w* \w él|strong="H1931"\w*.   
\p
\v 21 “\w Pero|strong="H3588"\w* \w si|strong="H3588"\w* \w el|strong="H3588"\w* malvado \w se|strong="H3808"\w* aparta \w de|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pecados|strong="H2403"\w* \w que|strong="H3588"\w* \w cometió|strong="H6213"\w*, \w guarda|strong="H8104"\w* \w todos|strong="H3605"\w* mis \w estatutos|strong="H2708"\w* \w y|strong="H3588"\w* practica \w el|strong="H3588"\w* \w derecho|strong="H4941"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w justicia|strong="H6666"\w*, \w ciertamente|strong="H3588"\w* \w vivirá|strong="H2421"\w*; \w no|strong="H3808"\w* \w morirá|strong="H4191"\w*.  
\v 22 \w Ninguna|strong="H3605"\w* de las transgresiones \w que|strong="H3808"\w* \w cometió|strong="H6213"\w* le \w será|strong="H6213"\w* recordada. Por \w la|strong="H3605"\w* \w justicia|strong="H6666"\w* \w que|strong="H3808"\w* \w ha|strong="H3808"\w* practicado, \w vivirá|strong="H2421"\w*.  
\v 23 ¿Acaso me complace la \w muerte|strong="H4194"\w* del malvado?”, \w dice|strong="H5002"\w* el Señor Yahvé. “¿\w No|strong="H3808"\w* prefiero \w más|strong="H2421"\w* bien \w que|strong="H3808"\w* \w se|strong="H3808"\w* aparte de su \w mal|strong="H7563"\w* \w camino|strong="H1870"\w* y \w viva|strong="H2421"\w*?   
\p
\v 24 “Pero \w si|strong="H3808"\w* \w el|strong="H3605"\w* \w justo|strong="H6662"\w* \w se|strong="H3808"\w* aparta \w de|strong="H6662"\w* su \w justicia|strong="H6666"\w*, comete \w maldad|strong="H5766"\w* \w e|strong="H3068"\w* imita \w todas|strong="H3605"\w* las \w abominaciones|strong="H8441"\w* \w que|strong="H3808"\w* \w hace|strong="H6213"\w* \w el|strong="H3605"\w* malvado, ¿acaso \w vivirá|strong="H2425"\w*? \w Ninguna|strong="H3605"\w* \w de|strong="H6662"\w* las obras justas \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* \w será|strong="H3808"\w* recordada. Por \w la|strong="H3605"\w* infidelidad y \w el|strong="H3605"\w* \w pecado|strong="H2403"\w* \w que|strong="H3808"\w* \w cometió|strong="H2398"\w*, \w morirá|strong="H4191"\w*.   
\p
\v 25 “\w Sin|strong="H3808"\w* embargo, ustedes dicen: ‘El proceder del Señor \w no|strong="H3808"\w* es justo’. \w Escuchen|strong="H8085"\w* \w ahora|strong="H4994"\w*, \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*: ¿\w No|strong="H3808"\w* es justo \w mi|strong="H4994"\w* proceder? ¿\w No|strong="H3808"\w* \w son|strong="H3808"\w*, \w más|strong="H3808"\w* bien, los \w caminos|strong="H1870"\w* de ustedes los \w que|strong="H3808"\w* \w son|strong="H3808"\w* injustos?  
\v 26 \w Si|strong="H5921"\w* \w el|strong="H5921"\w* \w justo|strong="H6662"\w* \w se|strong="H5921"\w* aparta \w de|strong="H5921"\w* su \w justicia|strong="H6666"\w* \w y|strong="H5921"\w* comete \w maldad|strong="H5766"\w*, \w y|strong="H5921"\w* muere \w por|strong="H5921"\w* ello, muere \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w maldad|strong="H5766"\w* \w que|strong="H5921"\w* \w cometió|strong="H6213"\w*.  
\v 27 \w Y|strong="H3068"\w* \w si|strong="H1931"\w* \w el|strong="H1931"\w* malvado \w se|strong="H1931"\w* aparta de \w la|strong="H1931"\w* \w maldad|strong="H7564"\w* \w que|strong="H1931"\w* \w cometió|strong="H6213"\w* y practica \w el|strong="H1931"\w* \w derecho|strong="H4941"\w* y \w la|strong="H1931"\w* \w justicia|strong="H6666"\w*, salvará \w su|strong="H1931"\w* \w vida|strong="H5315"\w*.  
\v 28 \w Porque|strong="H3808"\w* recapacitó y \w se|strong="H3808"\w* apartó de \w todas|strong="H3605"\w* sus transgresiones, \w ciertamente|strong="H4191"\w* \w vivirá|strong="H2421"\w*; \w no|strong="H3808"\w* \w morirá|strong="H4191"\w*.  
\v 29 Pero la \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w* dice: ‘El proceder del Señor \w no|strong="H3808"\w* es justo’. \w Casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*, ¿\w no|strong="H3808"\w* \w son|strong="H3808"\w* justos mis \w caminos|strong="H1870"\w*? ¿\w No|strong="H3808"\w* \w son|strong="H3808"\w*, \w más|strong="H3808"\w* bien, injustos los \w caminos|strong="H1870"\w* de ustedes?   
\p
\v 30 “\w Por|strong="H1870"\w* \w tanto|strong="H3651"\w*, \w casa|strong="H1004"\w* de \w Israel|strong="H3478"\w*, yo \w juzgaré|strong="H8199"\w* \w a|strong="H3068"\w* \w cada|strong="H3605"\w* uno de ustedes según sus propios \w caminos|strong="H1870"\w*”, \w dice|strong="H5002"\w* \w el|strong="H3605"\w* Señor Yahvé. “Arrepiéntanse y apártense de \w todas|strong="H3605"\w* sus transgresiones, \w para|strong="H1961"\w* \w que|strong="H3808"\w* \w la|strong="H3605"\w* \w maldad|strong="H5771"\w* \w no|strong="H3808"\w* \w sea|strong="H1961"\w* su ruina.  
\v 31 Arrojen \w de|strong="H5921"\w* ustedes \w todas|strong="H3605"\w* \w las|strong="H5921"\w* transgresiones \w que|strong="H4100"\w* \w han|strong="H4191"\w* cometido \w y|strong="H5921"\w* háganse un \w corazón|strong="H3820"\w* \w nuevo|strong="H2319"\w* \w y|strong="H5921"\w* un \w espíritu|strong="H7307"\w* \w nuevo|strong="H2319"\w*. ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* habrían \w de|strong="H5921"\w* \w morir|strong="H4191"\w*, \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*?  
\v 32 \w Porque|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* complace \w la|strong="H3588"\w* \w muerte|strong="H4194"\w* \w de|strong="H3588"\w* \w nadie|strong="H3808"\w*”, \w dice|strong="H5002"\w* \w el|strong="H3588"\w* Señor Yahvé. “¡Arrepiéntanse \w y|strong="H3588"\w* vivan!   
\c 19  
\p
\v 1 “Además, entona un lamento por los \w príncipes|strong="H5387"\w* de \w Israel|strong="H3478"\w*,  
\v 2 y di:  
\q1 ‘¿\w Qué|strong="H4100"\w* era tu madre?  
\q2 Una leona.  
\q1 \w Se|strong="H4100"\w* echó \w entre|strong="H8432"\w* los \w leones|strong="H3833"\w*,  
\q2 y \w entre|strong="H8432"\w* los leoncillos \w crió|strong="H7235"\w* \w a|strong="H3068"\w* sus cachorros.   
\q1
\v 3 Crió \w a|strong="H3068"\w* uno de sus cachorros,  
\q2 \w que|strong="H1961"\w* \w llegó|strong="H5927"\w* \w a|strong="H3068"\w* ser un león joven.  
\q1 \w Aprendió|strong="H3925"\w* \w a|strong="H3068"\w* atrapar su presa  
\q2 y devoró \w a|strong="H3068"\w* \w los|strong="H1961"\w* hombres.   
\q1
\v 4 Las \w naciones|strong="H1471"\w* \w oyeron|strong="H8085"\w* hablar de él.  
\q2 Cayó atrapado en su fosa,  
\q2 y lo llevaron con ganchos \w a|strong="H3068"\w* la tierra de \w Egipto|strong="H4714"\w*.   
\b  
\q1
\v 5 “‘\w Cuando|strong="H3588"\w* ella \w vio|strong="H7200"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w espera|strong="H3176"\w* era \w en|strong="H3588"\w* vano,  
\q2 \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w esperanza|strong="H8615"\w* se \w había|strong="H3588"\w* perdido,  
\q1 \w tomó|strong="H3947"\w* \w a|strong="H3068"\w* otro \w de|strong="H3588"\w* sus cachorros  
\q2 \w y|strong="H3588"\w* lo convirtió \w en|strong="H3588"\w* un león joven.   
\q1
\v 6 \w Iba|strong="H1980"\w* y venía \w entre|strong="H8432"\w* \w los|strong="H1961"\w* leones;  
\q2 \w se|strong="H1961"\w* convirtió \w en|strong="H8432"\w* un león joven.  
\q1 \w Aprendió|strong="H3925"\w* \w a|strong="H3068"\w* atrapar su presa  
\q2 y devoró \w a|strong="H3068"\w* \w los|strong="H1961"\w* hombres.   
\q1
\v 7 Destruyó sus palacios  
\q2 y asoló sus \w ciudades|strong="H5892"\w*.  
\q1 La tierra y todo lo \w que|strong="H3045"\w* había en ella quedaron desolados  
\q2 por el \w estruendo|strong="H6963"\w* de sus rugidos.   
\q1
\v 8 Entonces \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w lo|strong="H5921"\w* atacaron \w desde|strong="H5921"\w* \w las|strong="H5921"\w* \w provincias|strong="H4082"\w* \w de|strong="H5921"\w* \w alrededor|strong="H5439"\w*.  
\q2 Extendieron su \w red|strong="H7568"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*  
\q2 \w y|strong="H5921"\w* cayó atrapado \w en|strong="H5921"\w* su fosa.   
\q1
\v 9 \w Lo|strong="H3808"\w* \w pusieron|strong="H5414"\w* \w en|strong="H5750"\w* una jaula con ganchos  
\q2 y \w lo|strong="H3808"\w* llevaron ante el \w rey|strong="H4428"\w* \w de|strong="H5750"\w* Babilonia.  
\q1 \w Lo|strong="H3808"\w* metieron \w en|strong="H5750"\w* las fortalezas,  
\q2 \w para|strong="H4616"\w* \w que|strong="H3808"\w* su \w voz|strong="H6963"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* oyera \w más|strong="H5750"\w* \w en|strong="H5750"\w* los \w montes|strong="H2022"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*.   
\b  
\q1
\v 10 “‘Tu madre \w era|strong="H1961"\w* \w como|strong="H1961"\w* una \w vid|strong="H1612"\w* \w en|strong="H5921"\w* tu \w sangre|strong="H1818"\w*, \w plantada|strong="H8362"\w* \w junto|strong="H5921"\w* \w al|strong="H5921"\w* \w agua|strong="H4325"\w*.  
\q2 \w Era|strong="H1961"\w* \w fértil|strong="H6509"\w* \w y|strong="H5921"\w* frondosa gracias \w a|strong="H3068"\w* \w la|strong="H5921"\w* abundancia \w de|strong="H5921"\w* \w agua|strong="H4325"\w*.   
\q1
\v 11 \w Tenía|strong="H1961"\w* ramas \w fuertes|strong="H5797"\w* \w para|strong="H5921"\w* ser \w cetros|strong="H7626"\w* \w de|strong="H5921"\w* gobernantes.  
\q2 Su estatura \w se|strong="H1961"\w* elevó \w por|strong="H5921"\w* \w encima|strong="H5921"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* ramas espesas.  
\q1 \w Se|strong="H1961"\w* destacaba \w por|strong="H5921"\w* su \w altura|strong="H6967"\w*  
\q2 \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H7230"\w* \w de|strong="H5921"\w* sus ramas.   
\q1
\v 12 Pero fue arrancada con furia  
\q2 \w y|strong="H5797"\w* arrojada al suelo.  
\q1 El \w viento|strong="H7307"\w* del este \w secó|strong="H3001"\w* sus \w frutos|strong="H6529"\w*.  
\q2 Sus ramas \w fuertes|strong="H5797"\w* se rompieron \w y|strong="H5797"\w* se marchitaron;  
\q2 el fuego las consumió.   
\q1
\v 13 \w Ahora|strong="H6258"\w* está \w plantada|strong="H8362"\w* en el \w desierto|strong="H4057"\w*,  
\q2 en una tierra \w seca|strong="H6723"\w* y sedienta.   
\q1
\v 14 \w Ha|strong="H3808"\w* \w salido|strong="H3318"\w* fuego de \w sus|strong="H1931"\w* ramas  
\q2 \w que|strong="H1931"\w* \w ha|strong="H3808"\w* devorado \w su|strong="H1931"\w* \w fruto|strong="H6529"\w*,  
\q2 \w para|strong="H1961"\w* \w que|strong="H1931"\w* \w no|strong="H3808"\w* \w quede|strong="H1961"\w* \w en|strong="H3318"\w* \w ella|strong="H1931"\w* \w ninguna|strong="H3808"\w* rama \w fuerte|strong="H5797"\w* \w que|strong="H1931"\w* sirva de \w cetro|strong="H7626"\w* \w para|strong="H1961"\w* gobernar’”.  
\m \w Este|strong="H1931"\w* \w es|strong="H1931"\w* un lamento, \w y|strong="H5797"\w* \w servirá|strong="H1961"\w* de lamento.   
\c 20  
\p
\v 1 En \w el|strong="H3427"\w* \w séptimo|strong="H7637"\w* \w año|strong="H8141"\w*, \w el|strong="H3427"\w* día diez del \w quinto|strong="H2549"\w* \w mes|strong="H2320"\w*, vinieron algunos \w de|strong="H6440"\w* \w los|strong="H3427"\w* \w ancianos|strong="H2205"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w* \w a|strong="H3068"\w* consultar \w a|strong="H3068"\w* Yahvé y \w se|strong="H1961"\w* \w sentaron|strong="H3427"\w* frente \w a|strong="H3068"\w* \w mí|strong="H1961"\w*.   
\p
\v 2 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* y me dijo:  
\v 3 “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, \w habla|strong="H1696"\w* con \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w* \w y|strong="H3541"\w* \w diles|strong="H1696"\w*: \w Así|strong="H3541"\w* \w dice|strong="H5002"\w* \w el|strong="H1121"\w* Señor Yahvé: ‘¿Vienen ustedes \w a|strong="H3068"\w* consultarme? Tan cierto como \w que|strong="H1121"\w* yo \w vivo|strong="H2416"\w*, \w dice|strong="H5002"\w* \w el|strong="H1121"\w* Señor Yahvé, \w que|strong="H1121"\w* no dejaré \w que|strong="H1121"\w* \w me|strong="H3541"\w* consulten’.   
\p
\v 4 “¿\w Los|strong="H1121"\w* \w juzgarás|strong="H8199"\w* \w tú|strong="H8199"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*? ¿\w Los|strong="H1121"\w* \w juzgarás|strong="H8199"\w*? Hazles \w saber|strong="H3045"\w* las \w abominaciones|strong="H8441"\w* \w de|strong="H1121"\w* sus padres.  
\v 5 Diles: \w Así|strong="H3541"\w* dice el \w Señor|strong="H3068"\w* Yahvé: ‘El \w día|strong="H3117"\w* \w que|strong="H3045"\w* escogí \w a|strong="H3068"\w* \w Israel|strong="H3478"\w* \w y|strong="H3541"\w* juré \w a|strong="H3068"\w* la \w descendencia|strong="H2233"\w* de la \w casa|strong="H1004"\w* de \w Jacob|strong="H3290"\w*, \w cuando|strong="H3117"\w* \w me|strong="H3541"\w* di \w a|strong="H3068"\w* conocer \w a|strong="H3068"\w* \w ellos|strong="H3027"\w* en la tierra de \w Egipto|strong="H4714"\w*, \w cuando|strong="H3117"\w* levanté \w mi|strong="H5375"\w* \w mano|strong="H3027"\w* \w y|strong="H3541"\w* les juré: Yo soy Yahvé, su \w Dios|strong="H3069"\w*;  
\v 6 \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* les juré \w que|strong="H1931"\w* \w los|strong="H3605"\w* sacaría de \w la|strong="H1931"\w* tierra de \w Egipto|strong="H4714"\w* para llevarlos \w a|strong="H3068"\w* una tierra \w que|strong="H1931"\w* yo había buscado para \w ellos|strong="H3027"\w*, una tierra \w donde|strong="H1931"\w* \w fluye|strong="H2100"\w* \w leche|strong="H2461"\w* y \w miel|strong="H1706"\w*, \w la|strong="H1931"\w* más hermosa de \w todas|strong="H3605"\w* las tierras.  
\v 7 Entonces les dije: Deshágase cada uno \w de|strong="H5869"\w* las \w abominaciones|strong="H8251"\w* que atraen sus \w ojos|strong="H5869"\w*, y no se contaminen con los \w ídolos|strong="H1544"\w* \w de|strong="H5869"\w* \w Egipto|strong="H4714"\w*. Yo soy Yahvé, su \w Dios|strong="H3068"\w*.   
\p
\v 8 “‘Pero \w ellos|strong="H5921"\w* \w se|strong="H5921"\w* rebelaron \w contra|strong="H5921"\w* \w mí|strong="H5921"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* quisieron escucharme. \w Nadie|strong="H3808"\w* \w se|strong="H5921"\w* deshizo \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w abominaciones|strong="H8251"\w* \w que|strong="H3808"\w* atraían sus \w ojos|strong="H5869"\w* \w ni|strong="H3808"\w* abandonaron \w los|strong="H5921"\w* \w ídolos|strong="H1544"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*. Entonces dije \w que|strong="H3808"\w* derramaría \w mi|strong="H5921"\w* \w ira|strong="H2534"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w para|strong="H5921"\w* desahogar \w mi|strong="H5921"\w* \w enojo|strong="H2534"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
