\p
\v 11 “En las fiestas y en las celebraciones solemnes, la \w ofrenda|strong="H4503"\w* de grano \w será|strong="H1961"\w* de un efa\f + \fr 46:11 \ft 1 efa equivale a unos 22 litros.\f* \w por|strong="H3027"\w* cada \w novillo|strong="H6499"\w* y un efa \w por|strong="H3027"\w* cada carnero, y \w por|strong="H3027"\w* \w los|strong="H1961"\w* \w corderos|strong="H3532"\w* lo \w que|strong="H1961"\w* él quiera dar, más cuatro litros de \w aceite|strong="H8081"\w* \w por|strong="H3027"\w* cada efa.  
\v 12 \w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w el|strong="H3588"\w* \w príncipe|strong="H5387"\w* prepare una ofrenda \w voluntaria|strong="H5071"\w* \w a|strong="H3068"\w* Yahvé, ya sea un \w holocausto|strong="H5930"\w* \w o|strong="H3068"\w* una ofrenda \w de|strong="H3588"\w* paz, se le \w abrirá|strong="H6605"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* \w que|strong="H3588"\w* da \w hacia|strong="H6213"\w* \w el|strong="H3588"\w* oriente. Preparará \w su|strong="H3588"\w* \w holocausto|strong="H5930"\w* \w y|strong="H3588"\w* sus ofrendas \w de|strong="H3588"\w* paz tal \w como|strong="H3588"\w* \w lo|strong="H6213"\w* \w hace|strong="H6213"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* descanso. \w Luego|strong="H3318"\w* \w saldrá|strong="H3318"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w puerta|strong="H8179"\w* se \w cerrará|strong="H5462"\w* después \w de|strong="H3588"\w* \w que|strong="H3588"\w* haya \w salido|strong="H3318"\w*.   
\p
\v 13 “\w Todos|strong="H8141"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* prepararás un \w cordero|strong="H3532"\w* \w de|strong="H1121"\w* un \w año|strong="H8141"\w*, sin defecto, como \w holocausto|strong="H5930"\w* \w a|strong="H3068"\w* Yahvé; \w lo|strong="H6213"\w* prepararás \w cada|strong="H3117"\w* \w mañana|strong="H1242"\w*.  
\v 14 \w Y|strong="H3068"\w* \w junto|strong="H5921"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* cordero, prepararás cada \w mañana|strong="H1242"\w* una \w ofrenda|strong="H4503"\w* \w de|strong="H5921"\w* grano: \w la|strong="H5921"\w* sexta \w parte|strong="H8345"\w* \w de|strong="H5921"\w* un efa,\f + \fr 46:14 \ft 1 efa equivale a unos 22 litros.\f* \w y|strong="H5921"\w* un litro \w y|strong="H5921"\w* medio \w de|strong="H5921"\w* \w aceite|strong="H8081"\w* \w para|strong="H5921"\w* amasar \w la|strong="H5921"\w* harina fina. \w Esta|strong="H5921"\w* es una \w ofrenda|strong="H4503"\w* \w continua|strong="H8548"\w* \w a|strong="H3068"\w* Yahvé, una ley \w para|strong="H5921"\w* \w siempre|strong="H5769"\w*.  
\v 15 Así prepararán \w el|strong="H6213"\w* \w cordero|strong="H3532"\w*, la \w ofrenda|strong="H4503"\w* de grano y \w el|strong="H6213"\w* \w aceite|strong="H8081"\w* cada \w mañana|strong="H1242"\w*, como un \w holocausto|strong="H5930"\w* permanente.   
\p
\v 16 “\w Así|strong="H3541"\w* dice \w el|strong="H1931"\w* Señor Yahvé: \w Si|strong="H3588"\w* \w el|strong="H1931"\w* \w príncipe|strong="H5387"\w* \w le|strong="H1931"\w* regala una parte \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w herencia|strong="H5159"\w* \w a|strong="H3068"\w* alguno \w de|strong="H3588"\w* \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w*, \w esta|strong="H1931"\w* \w será|strong="H1961"\w* \w de|strong="H3588"\w* \w ellos|strong="H1931"\w*; \w es|strong="H1931"\w* \w su|strong="H1931"\w* propiedad \w por|strong="H3588"\w* \w herencia|strong="H5159"\w*.  
\v 17 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* le regala una parte \w de|strong="H3588"\w* \w su|strong="H1992"\w* \w herencia|strong="H5159"\w* \w a|strong="H3068"\w* uno \w de|strong="H3588"\w* \w sus|strong="H1992"\w* \w siervos|strong="H5650"\w*, \w será|strong="H1961"\w* \w de|strong="H3588"\w* \w este|strong="H1961"\w* solo \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w año|strong="H8141"\w* del jubileo; \w después|strong="H1961"\w* \w de|strong="H3588"\w* eso, \w volverá|strong="H7725"\w* \w al|strong="H5704"\w* \w príncipe|strong="H5387"\w*. \w Su|strong="H1992"\w* \w herencia|strong="H5159"\w* debe \w quedar|strong="H1961"\w* exclusivamente \w para|strong="H5704"\w* \w sus|strong="H1992"\w* \w hijos|strong="H1121"\w*.  
\v 18 Además, \w el|strong="H1121"\w* \w príncipe|strong="H5387"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* apropiará \w de|strong="H1121"\w* la \w herencia|strong="H5159"\w* del \w pueblo|strong="H5971"\w* \w para|strong="H4616"\w* despojarlos \w de|strong="H1121"\w* sus tierras. \w A|strong="H3068"\w* sus \w hijos|strong="H1121"\w* les dará \w herencia|strong="H5159"\w* \w de|strong="H1121"\w* sus propias tierras, \w para|strong="H4616"\w* \w que|strong="H3808"\w* \w nadie|strong="H3808"\w* \w de|strong="H1121"\w* mi \w pueblo|strong="H5971"\w* sea expulsado \w de|strong="H1121"\w* su propiedad”.   
\p
\v 19 Luego, \w el|strong="H5921"\w* hombre \w me|strong="H5921"\w* llevó \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w entrada|strong="H3996"\w* \w que|strong="H5921"\w* \w estaba|strong="H2009"\w* \w a|strong="H3068"\w* un \w lado|strong="H3802"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w puerta|strong="H8179"\w*, \w hacia|strong="H5921"\w* \w los|strong="H5921"\w* cuartos \w sagrados|strong="H6944"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H5921"\w* cuales daban \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* \w norte|strong="H6828"\w*, \w y|strong="H5921"\w* vi \w que|strong="H5921"\w* \w al|strong="H5921"\w* fondo, \w hacia|strong="H5921"\w* \w el|strong="H5921"\w* occidente, había un espacio.  
\v 20 \w Y|strong="H3068"\w* me dijo: “\w Este|strong="H2088"\w* \w es|strong="H2088"\w* \w el|strong="H1310"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* los \w sacerdotes|strong="H3548"\w* cocinarán la \w ofrenda|strong="H4503"\w* \w por|strong="H2088"\w* la culpa y la \w ofrenda|strong="H4503"\w* \w por|strong="H2088"\w* \w el|strong="H1310"\w* \w pecado|strong="H2403"\w*, y \w donde|strong="H8033"\w* hornearán la \w ofrenda|strong="H4503"\w* \w de|strong="H5971"\w* grano, \w para|strong="H5971"\w* \w no|strong="H1115"\w* tener \w que|strong="H5971"\w* sacarlas al \w patio|strong="H2691"\w* \w exterior|strong="H2435"\w* y evitar \w así|strong="H2088"\w* transmitir santidad al \w pueblo|strong="H5971"\w*”.   
\p
\v 21 Entonces me \w sacó|strong="H3318"\w* al \w patio|strong="H2691"\w* \w exterior|strong="H2435"\w* y me hizo \w pasar|strong="H5674"\w* por las cuatro \w esquinas|strong="H4740"\w* del \w patio|strong="H2691"\w*, y vi \w que|strong="H2691"\w* \w en|strong="H3318"\w* cada esquina había un \w patio|strong="H2691"\w* más pequeño.  
\v 22 \f + \fr 46:22 \ft Un codo es la longitud desde la punta del dedo medio hasta el codo del brazo de un hombre, es decir, unos 46 centímetros.\f* En las cuatro \w esquinas|strong="H4740"\w* del \w patio|strong="H2691"\w* mayor había \w patios|strong="H2691"\w* cerrados, de cuarenta codos de largo por \w treinta|strong="H7970"\w* de ancho; los cuatro tenían la misma \w medida|strong="H4060"\w*.  
\v 23 \w Había|strong="H6213"\w* un muro \w de|strong="H8478"\w* piedra \w alrededor|strong="H5439"\w* \w de|strong="H8478"\w* estos cuatro patios, y se habían construido fogones \w en|strong="H8478"\w* la parte inferior \w de|strong="H8478"\w* los muros, \w por|strong="H8478"\w* \w todo|strong="H5439"\w* su \w alrededor|strong="H5439"\w*.  
\v 24 \w Y|strong="H3068"\w* me dijo: “Estas son las cocinas \w donde|strong="H8033"\w* los ayudantes del \w templo|strong="H1004"\w* cocinarán los \w sacrificios|strong="H2077"\w* \w que|strong="H5971"\w* ofrezca \w el|strong="H1310"\w* \w pueblo|strong="H5971"\w*”.   
\c 47  
\p
\v 1 \w El|strong="H3588"\w* hombre \w me|strong="H3588"\w* llevó \w de|strong="H3588"\w* vuelta \w a|strong="H3068"\w* \w la|strong="H3588"\w* entrada \w del|strong="H4196"\w* \w templo|strong="H1004"\w*, \w y|strong="H3588"\w* vi \w que|strong="H3588"\w* \w salía|strong="H3318"\w* \w agua|strong="H4325"\w* \w por|strong="H3588"\w* \w debajo|strong="H8478"\w* \w del|strong="H4196"\w* \w umbral|strong="H4670"\w*, \w en|strong="H3588"\w* dirección \w al|strong="H8478"\w* oriente, \w pues|strong="H3588"\w* \w la|strong="H3588"\w* fachada \w del|strong="H4196"\w* \w templo|strong="H1004"\w* daba \w hacia|strong="H6440"\w* \w el|strong="H3588"\w* oriente. \w El|strong="H3588"\w* \w agua|strong="H4325"\w* bajaba \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w* \w del|strong="H4196"\w* \w templo|strong="H1004"\w*, \w al|strong="H8478"\w* sur \w del|strong="H4196"\w* \w altar|strong="H4196"\w*.  
\v 2 \w Luego|strong="H3318"\w* \w me|strong="H4480"\w* \w sacó|strong="H3318"\w* \w por|strong="H4480"\w* la \w puerta|strong="H8179"\w* \w del|strong="H4480"\w* \w norte|strong="H6828"\w* y \w me|strong="H4480"\w* hizo dar la \w vuelta|strong="H5437"\w* \w por|strong="H4480"\w* el \w camino|strong="H1870"\w* exterior hasta la \w puerta|strong="H8179"\w* \w que|strong="H4480"\w* da \w hacia|strong="H1870"\w* el oriente. \w Y|strong="H3068"\w* vi \w que|strong="H4480"\w* el \w agua|strong="H4325"\w* fluía \w por|strong="H4480"\w* el \w lado|strong="H3802"\w* \w derecho|strong="H3233"\w*.   
\p
\v 3 \w El|strong="H5674"\w* hombre \w salió|strong="H3318"\w* hacia \w el|strong="H5674"\w* este con una cuerda para medir \w en|strong="H3318"\w* la \w mano|strong="H3027"\w*; \w midió|strong="H4058"\w* mil codos\f + \fr 47:3 \ft Un codo es la longitud desde la punta del dedo medio hasta el codo del brazo de un hombre, unos 46 centímetros.\f* y me hizo cruzar \w el|strong="H5674"\w* \w agua|strong="H4325"\w*, la cual me llegaba \w a|strong="H3068"\w* los tobillos.  
\v 4 \w Midió|strong="H4058"\w* otros mil codos y me hizo cruzar \w el|strong="H5674"\w* \w agua|strong="H4325"\w*, \w que|strong="H4325"\w* ahora me llegaba \w a|strong="H3068"\w* las \w rodillas|strong="H1290"\w*. Volvió \w a|strong="H3068"\w* medir otros mil, y me hizo cruzar \w el|strong="H5674"\w* \w agua|strong="H4325"\w*, \w que|strong="H4325"\w* ya me llegaba \w a|strong="H3068"\w* la cintura.  
\v 5 \w Midió|strong="H4058"\w* otros mil, \w y|strong="H3588"\w* ya era un río \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w pude|strong="H3201"\w* cruzar caminando, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w agua|strong="H4325"\w* \w había|strong="H3588"\w* crecido tanto \w que|strong="H3588"\w* solo \w se|strong="H3808"\w* \w podía|strong="H3201"\w* cruzar \w a|strong="H3068"\w* nado; era un río hondo \w y|strong="H3588"\w* caudaloso.   
\p
\v 6 \w Y|strong="H3068"\w* me preguntó: “\w Hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w hombre|strong="H1121"\w*, ¿te has fijado \w en|strong="H3212"\w* esto?”.  
\p \w Entonces|strong="H7725"\w* me llevó \w de|strong="H1121"\w* regreso por la orilla del río.  
\v 7 Al \w volver|strong="H7725"\w*, vi \w que|strong="H2088"\w* en la orilla del río había muchísimos \w árboles|strong="H6086"\w* de un lado y del \w otro|strong="H2088"\w*.  
\v 8 \w Me|strong="H5921"\w* dijo: “Estas \w aguas|strong="H4325"\w* \w fluyen|strong="H3381"\w* \w hacia|strong="H5921"\w* \w la|strong="H5921"\w* región \w oriental|strong="H6930"\w* \w y|strong="H5921"\w* bajan \w al|strong="H5921"\w* Arabá. \w Al|strong="H5921"\w* desembocar \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, sus \w aguas|strong="H4325"\w* saladas \w se|strong="H5921"\w* volverán dulces \w y|strong="H5921"\w* sanas.  
\v 9 \w Todo|strong="H3605"\w* \w ser|strong="H5315"\w* \w viviente|strong="H2416"\w* \w que|strong="H3588"\w* nade \w o|strong="H3068"\w* \w se|strong="H1961"\w* mueva \w por|strong="H3588"\w* \w donde|strong="H8033"\w* pase \w este|strong="H1961"\w* río, \w vivirá|strong="H2421"\w*. \w Habrá|strong="H1961"\w* una inmensa cantidad \w de|strong="H3588"\w* \w peces|strong="H1710"\w*, \w porque|strong="H3588"\w* estas \w aguas|strong="H4325"\w* han llegado \w allá|strong="H8033"\w* \w para|strong="H3588"\w* sanar \w el|strong="H3588"\w* mar salado; ¡\w todo|strong="H3605"\w* \w vivirá|strong="H2421"\w* \w por|strong="H3588"\w* \w donde|strong="H8033"\w* pase \w el|strong="H3588"\w* río!  
\v 10 \w Habrá|strong="H1961"\w* \w pescadores|strong="H7227"\w* \w a|strong="H3068"\w* \w lo|strong="H5921"\w* largo \w de|strong="H5921"\w* sus orillas; \w desde|strong="H5704"\w* En-gadi \w hasta|strong="H5704"\w* \w En-eglaim|strong="H5882"\w* \w será|strong="H1961"\w* un lugar \w para|strong="H5704"\w* tender \w las|strong="H5921"\w* redes. \w Habrá|strong="H1961"\w* \w peces|strong="H1710"\w* \w de|strong="H5921"\w* diversas especies \w y|strong="H5921"\w* \w tan|strong="H3966"\w* abundantes \w como|strong="H1961"\w* \w los|strong="H5921"\w* \w peces|strong="H1710"\w* \w del|strong="H5921"\w* \w mar|strong="H3220"\w* \w Grande|strong="H1419"\w*.  
\v 11 Pero sus pantanos y ciénagas \w no|strong="H3808"\w* \w se|strong="H3808"\w* volverán dulces; \w quedarán|strong="H5414"\w* como salinas.  
\v 12 \w A|strong="H3068"\w* orillas \w del|strong="H4480"\w* río, \w a|strong="H3068"\w* ambos lados, \w crecerá|strong="H5927"\w* \w toda|strong="H3605"\w* clase \w de|strong="H4480"\w* \w árboles|strong="H6086"\w* frutales. \w Sus|strong="H1992"\w* \w hojas|strong="H5929"\w* \w nunca|strong="H3808"\w* \w se|strong="H1961"\w* marchitarán, \w ni|strong="H3808"\w* \w jamás|strong="H3808"\w* \w les|strong="H1992"\w* \w faltará|strong="H8552"\w* \w su|strong="H1992"\w* \w fruto|strong="H6529"\w*. \w Cada|strong="H3605"\w* \w mes|strong="H2320"\w* darán una nueva cosecha, \w porque|strong="H3588"\w* \w el|strong="H5921"\w* \w agua|strong="H4325"\w* \w que|strong="H3588"\w* \w los|strong="H1992"\w* riega \w sale|strong="H3318"\w* \w del|strong="H4480"\w* \w santuario|strong="H4720"\w*. \w Sus|strong="H1992"\w* \w frutos|strong="H6529"\w* \w servirán|strong="H1961"\w* \w de|strong="H4480"\w* alimento, \w y|strong="H3588"\w* \w sus|strong="H1992"\w* \w hojas|strong="H5929"\w*, \w como|strong="H3588"\w* medicina”.   
\p
\v 13 \w Así|strong="H3541"\w* dice el Señor Yahvé: “Estas son las fronteras por las \w que|strong="H3541"\w* repartirán \w la|strong="H1366"\w* tierra como herencia entre las \w doce|strong="H8147"\w* \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w*. \w A|strong="H3068"\w* \w José|strong="H3130"\w* le tocarán \w dos|strong="H8147"\w* \w partes|strong="H2256"\w*.  
\v 14 \w La|strong="H2063"\w* repartirán \w por|strong="H3027"\w* \w partes|strong="H3027"\w* iguales. Yo juré con \w la|strong="H2063"\w* \w mano|strong="H3027"\w* en alto \w que|strong="H3027"\w* le \w daría|strong="H5414"\w* \w esta|strong="H2063"\w* tierra \w a|strong="H3068"\w* sus antepasados, y ahora les tocará \w a|strong="H3068"\w* ustedes como \w herencia|strong="H5159"\w*.   
\p
\v 15 “\w Esta|strong="H2088"\w* será \w la|strong="H1366"\w* frontera \w del|strong="H4480"\w* país:  
\p “\w Por|strong="H4480"\w* el \w lado|strong="H6285"\w* \w norte|strong="H6828"\w*, \w desde|strong="H4480"\w* el \w mar|strong="H3220"\w* \w Grande|strong="H1419"\w*, \w por|strong="H4480"\w* el \w camino|strong="H1870"\w* \w de|strong="H4480"\w* Hetlón \w hasta|strong="H2088"\w* \w la|strong="H1366"\w* entrada \w de|strong="H4480"\w* Zedad;  
\v 16 Hamat, Berotá y Sibraim (que está entre \w la|strong="H1366"\w* frontera de \w Damasco|strong="H1834"\w* y \w la|strong="H1366"\w* frontera de Hamat), hasta Hazar-haticón, que limita con Haurán.  
\v 17 Así \w la|strong="H1366"\w* frontera irá \w desde|strong="H4480"\w* el \w mar|strong="H3220"\w* hasta Hazar-enón, \w en|strong="H4480"\w* el límite \w de|strong="H4480"\w* \w Damasco|strong="H1834"\w*, \w con|strong="H4480"\w* el territorio \w de|strong="H4480"\w* Hamat \w hacia|strong="H4480"\w* el \w norte|strong="H6828"\w*. \w Esta|strong="H1961"\w* \w será|strong="H1961"\w* \w la|strong="H1366"\w* frontera \w norte|strong="H6828"\w*.   
\p
\v 18 “\w Por|strong="H5921"\w* \w el|strong="H5921"\w* \w lado|strong="H6285"\w* oriente, \w el|strong="H5921"\w* límite será \w el|strong="H5921"\w* río \w Jordán|strong="H3383"\w*, \w entre|strong="H5921"\w* Haurán \w y|strong="H5921"\w* \w Damasco|strong="H1834"\w*, \w y|strong="H5921"\w* \w entre|strong="H5921"\w* \w Galaad|strong="H1568"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*; medirán \w desde|strong="H5921"\w* \w la|strong="H5921"\w* frontera norte \w hasta|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w oriental|strong="H6921"\w*. \w Esta|strong="H5921"\w* será \w la|strong="H5921"\w* frontera \w oriental|strong="H6921"\w*.   
\p
\v 19 “\w Por|strong="H5704"\w* el \w lado|strong="H6285"\w* sur, la frontera irá \w desde|strong="H5704"\w* Tamar \w hasta|strong="H5704"\w* las \w aguas|strong="H4325"\w* \w de|strong="H5704"\w* Meribá-cades, \w y|strong="H5704"\w* seguirá \w por|strong="H5704"\w* el \w arroyo|strong="H5158"\w* \w de|strong="H5704"\w* Egipto \w hasta|strong="H5704"\w* el \w mar|strong="H3220"\w* \w Grande|strong="H1419"\w*. Esta será la frontera sur.   
\p
\v 20 “\w Por|strong="H5704"\w* el \w lado|strong="H6285"\w* occidente, \w la|strong="H1366"\w* frontera será el \w mar|strong="H3220"\w* \w Grande|strong="H1419"\w*, \w desde|strong="H5704"\w* \w la|strong="H1366"\w* frontera sur \w hasta|strong="H5704"\w* quedar frente \w a|strong="H3068"\w* \w la|strong="H1366"\w* entrada \w de|strong="H5704"\w* Hamat. \w Esta|strong="H2063"\w* será \w la|strong="H1366"\w* frontera \w occidental|strong="H3220"\w*.   
\p
\v 21 “Se repartirán \w esta|strong="H2063"\w* tierra entre ustedes, según las \w tribus|strong="H7626"\w* de \w Israel|strong="H3478"\w*.  
\v 22 La repartirán por sorteo \w como|strong="H1961"\w* propiedad \w para|strong="H1961"\w* ustedes y \w para|strong="H1961"\w* \w los|strong="H1121"\w* \w extranjeros|strong="H1616"\w* \w que|strong="H1616"\w* vivan y tengan \w hijos|strong="H1121"\w* \w entre|strong="H8432"\w* ustedes. Deberán tratarlos \w como|strong="H1961"\w* \w si|strong="H1961"\w* fueran nativos \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*. \w Tendrán|strong="H1961"\w* derecho \w a|strong="H3068"\w* recibir una \w herencia|strong="H5159"\w* junto con ustedes \w entre|strong="H8432"\w* las \w tribus|strong="H7626"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*.  
\v 23 Le \w darán|strong="H5414"\w* su propiedad al \w extranjero|strong="H1616"\w* en el territorio \w de|strong="H5414"\w* la \w tribu|strong="H7626"\w* \w donde|strong="H8033"\w* viva, afirma el Señor Yahvé”.   
\c 48  
\p
\v 1 “Estos \w son|strong="H1961"\w* \w los|strong="H1961"\w* \w nombres|strong="H8034"\w* de las \w tribus|strong="H7626"\w*: En el \w extremo|strong="H7097"\w* \w norte|strong="H6828"\w*, \w a|strong="H3068"\w* lo largo del \w camino|strong="H1870"\w* de Hetlón hasta \w la|strong="H1366"\w* entrada de Hamat y Hazar-enán, en \w la|strong="H1366"\w* frontera \w norte|strong="H6828"\w* de \w Damasco|strong="H1834"\w*, \w junto|strong="H3027"\w* \w a|strong="H3068"\w* Hamat, extendiéndose de \w este|strong="H1961"\w* \w a|strong="H3068"\w* oeste, \w la|strong="H1366"\w* \w tribu|strong="H7626"\w* de \w Dan|strong="H1835"\w* \w tendrá|strong="H1961"\w* una porción.   
\p
\v 2 “Limitando \w con|strong="H5921"\w* \w Dan|strong="H1835"\w*, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, Aser tendrá una porción.   
\p
\v 3 “Limitando \w con|strong="H5921"\w* Aser, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, Neftalí tendrá una porción.   
\p
\v 4 “Limitando \w con|strong="H5921"\w* Neftalí, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, \w Manasés|strong="H4519"\w* tendrá una porción.   
\p
\v 5 “Limitando \w con|strong="H5921"\w* \w Manasés|strong="H4519"\w*, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, Efraín tendrá una porción.   
\p
\v 6 “Limitando \w con|strong="H5921"\w* Efraín, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, \w Rubén|strong="H7205"\w* tendrá una porción.   
\p
\v 7 “Limitando \w con|strong="H5921"\w* \w Rubén|strong="H7205"\w*, \w de|strong="H5921"\w* este \w a|strong="H3068"\w* oeste, \w Judá|strong="H3063"\w* tendrá una porción.   
\p
