\v 31 \w Los|strong="H3605"\w* \w sacerdotes|strong="H3548"\w* \w no|strong="H3808"\w* comerán carne \w de|strong="H4480"\w* \w ningún|strong="H3605"\w* \w ave|strong="H5775"\w* \w ni|strong="H3808"\w* animal \w que|strong="H4480"\w* haya muerto naturalmente \w o|strong="H3068"\w* haya sido despedazado \w por|strong="H4480"\w* las fieras”.   
\c 45  
\p
\v 1 Cuando repartan \w por|strong="H4480"\w* sorteo \w la|strong="H1931"\w* tierra \w como|strong="H1931"\w* \w herencia|strong="H5159"\w*, apartarán una porción sagrada \w de|strong="H4480"\w* \w la|strong="H1931"\w* tierra \w como|strong="H1931"\w* \w ofrenda|strong="H8641"\w* \w para|strong="H4480"\w* Yahvé. \w Esta|strong="H1931"\w* porción medirá doce kilómetros y medio \w de|strong="H4480"\w* largo \w por|strong="H4480"\w* \w cinco|strong="H2568"\w* kilómetros \w de|strong="H4480"\w* ancho; \w todo|strong="H3605"\w* \w este|strong="H1931"\w* territorio \w será|strong="H1931"\w* \w sagrado|strong="H6944"\w*.  
\v 2 \w De|strong="H2568"\w* \w esta|strong="H2088"\w* zona \w se|strong="H1961"\w* apartará \w para|strong="H1961"\w* el \w santuario|strong="H6944"\w* un cuadro \w de|strong="H2568"\w* \w doscientos|strong="H3967"\w* \w cincuenta|strong="H2572"\w* metros \w por|strong="H2088"\w* lado, con una franja \w de|strong="H2568"\w* veinticinco metros\f + \fr 45:2 \ft Un codo es la longitud desde la punta del dedo medio hasta el codo del brazo de un hombre, unos 46 centímetros.\f* \w alrededor|strong="H5439"\w* \w para|strong="H1961"\w* pastizales.  
\v 3 \w En|strong="H4480"\w* el área ya \w medida|strong="H4060"\w*, marcarán una sección \w de|strong="H4480"\w* doce kilómetros y medio \w de|strong="H4480"\w* largo \w por|strong="H4480"\w* \w cinco|strong="H2568"\w* \w de|strong="H4480"\w* ancho, y allí \w estará|strong="H1961"\w* el \w santuario|strong="H4720"\w*, el lugar \w más|strong="H4480"\w* \w sagrado|strong="H6944"\w* \w de|strong="H4480"\w* todos.  
\v 4 \w Esta|strong="H1931"\w* \w será|strong="H1961"\w* \w la|strong="H1931"\w* \w parte|strong="H4725"\w* sagrada \w de|strong="H4480"\w* \w la|strong="H1931"\w* tierra \w para|strong="H4480"\w* \w los|strong="H1931"\w* \w sacerdotes|strong="H3548"\w*, \w los|strong="H1931"\w* \w ministros|strong="H8334"\w* \w del|strong="H4480"\w* \w santuario|strong="H4720"\w* \w que|strong="H4480"\w* \w se|strong="H1961"\w* acercan \w para|strong="H4480"\w* servir \w a|strong="H3068"\w* Yahvé. Allí \w tendrán|strong="H1961"\w* \w lugar|strong="H4725"\w* \w para|strong="H4480"\w* \w sus|strong="H1931"\w* \w casas|strong="H1004"\w* y un \w sitio|strong="H4725"\w* \w sagrado|strong="H6944"\w* \w para|strong="H4480"\w* \w el|strong="H1931"\w* \w santuario|strong="H4720"\w*.  
\v 5 Otra sección \w de|strong="H2568"\w* doce kilómetros y medio \w de|strong="H2568"\w* largo \w por|strong="H3881"\w* \w cinco|strong="H2568"\w* \w de|strong="H2568"\w* ancho \w será|strong="H1961"\w* \w para|strong="H1961"\w* \w los|strong="H1992"\w* \w levitas|strong="H3881"\w* \w que|strong="H1961"\w* sirven en \w el|strong="H1992"\w* \w templo|strong="H1004"\w*; \w será|strong="H1961"\w* \w su|strong="H1992"\w* propiedad y allí \w tendrán|strong="H1961"\w* \w sus|strong="H1992"\w* ciudades \w para|strong="H1961"\w* vivir.   
\p
\v 6 Al lado \w de|strong="H2568"\w* \w la|strong="H3605"\w* porción sagrada, asignarán \w para|strong="H5414"\w* \w la|strong="H3605"\w* \w ciudad|strong="H5892"\w* un área \w de|strong="H2568"\w* dos kilómetros y medio \w de|strong="H2568"\w* ancho \w por|strong="H5414"\w* doce y medio \w de|strong="H2568"\w* largo; \w esta|strong="H1961"\w* \w será|strong="H1961"\w* \w para|strong="H5414"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* \w casa|strong="H1004"\w* \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*.   
\p
\v 7 El \w príncipe|strong="H5387"\w* recibirá las tierras \w a|strong="H3068"\w* ambos lados \w de|strong="H6440"\w* \w la|strong="H1366"\w* porción sagrada y \w de|strong="H6440"\w* \w la|strong="H1366"\w* propiedad \w de|strong="H6440"\w* \w la|strong="H1366"\w* \w ciudad|strong="H5892"\w*. Su territorio se extenderá \w hacia|strong="H6440"\w* el oeste y \w hacia|strong="H6440"\w* el \w este|strong="H2088"\w*, y su longitud será igual \w a|strong="H3068"\w* \w la|strong="H1366"\w* \w de|strong="H6440"\w* cada una \w de|strong="H6440"\w* las porciones tribales, \w desde|strong="H6440"\w* \w la|strong="H1366"\w* frontera \w occidental|strong="H3220"\w* \w hasta|strong="H2088"\w* \w la|strong="H1366"\w* \w oriental|strong="H6921"\w*.  
\v 8 \w Esta|strong="H1961"\w* tierra \w será|strong="H1961"\w* su propiedad \w en|strong="H5750"\w* \w Israel|strong="H3478"\w*. Así \w mis|strong="H5414"\w* \w príncipes|strong="H5387"\w* \w no|strong="H3808"\w* volverán \w a|strong="H3068"\w* oprimir \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*, \w sino|strong="H3808"\w* \w que|strong="H3808"\w* dejarán el resto \w de|strong="H5750"\w* la tierra \w para|strong="H5414"\w* las \w tribus|strong="H7626"\w* \w de|strong="H5750"\w* la \w casa|strong="H1004"\w* \w de|strong="H5750"\w* \w Israel|strong="H3478"\w*.   
\p
