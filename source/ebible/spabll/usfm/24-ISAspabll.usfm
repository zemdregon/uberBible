\q1
\v 9 \w Los|strong="H1992"\w* \w que|strong="H3045"\w* fabrican ídolos \w no|strong="H1077"\w* valen \w nada|strong="H3605"\w*;  
\q2 \w sus|strong="H1992"\w* obras más queridas \w no|strong="H1077"\w* sirven \w para|strong="H4616"\w* \w nada|strong="H3605"\w*.  
