\q2 \w para|strong="H3588"\w* \w dar|strong="H5414"\w* \w de|strong="H3588"\w* \w beber|strong="H8248"\w* \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w* elegido.   
\q1
\v 21 \w Este|strong="H2098"\w* es el \w pueblo|strong="H5971"\w* \w que|strong="H2098"\w* \w formé|strong="H3335"\w* \w para|strong="H5971"\w* mí,  
\q2 \w para|strong="H5971"\w* \w que|strong="H2098"\w* proclame mi \w alabanza|strong="H8416"\w*.   
\b  
\q1
\v 22 “\w Pero|strong="H3588"\w* tú, \w Jacob|strong="H3290"\w*, \w no|strong="H3808"\w* \w me|strong="H3588"\w* has \w invocado|strong="H7121"\w*;  
