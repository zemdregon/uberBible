\c 54  
\q1
\v 1 “¡\w Canta|strong="H7442"\w*, mujer estéril, tú \w que|strong="H3588"\w* \w nunca|strong="H3808"\w* diste \w a|strong="H3068"\w* luz!  
\q2 ¡Lanza gritos \w de|strong="H3588"\w* alegría, tú \w que|strong="H3588"\w* \w nunca|strong="H3808"\w* tuviste dolores \w de|strong="H3588"\w* parto!  
\q2 \w Porque|strong="H3588"\w* \w más|strong="H3588"\w* \w son|strong="H3588"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* mujer abandonada \w que|strong="H3588"\w* \w los|strong="H1121"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* mujer casada”, dice Yahvé.   
\q1
\v 2 “\w Ensancha|strong="H7337"\w* el espacio \w de|strong="H3407"\w* tu tienda  
\q2 y despliega las \w cortinas|strong="H3407"\w* \w de|strong="H3407"\w* tu morada. ¡No te limites!  
\q2 Alarga tus cuerdas y refuerza tus estacas.   
\q1
\v 3 \w Porque|strong="H3588"\w* \w te|strong="H3588"\w* extenderás \w a|strong="H3068"\w* \w derecha|strong="H3225"\w* \w e|strong="H3068"\w* \w izquierda|strong="H8040"\w*;  
\q2 tus descendientes conquistarán \w naciones|strong="H1471"\w*  
\q2 \w y|strong="H3588"\w* \w habitarán|strong="H3427"\w* las \w ciudades|strong="H5892"\w* \w que|strong="H3588"\w* ahora \w están|strong="H3427"\w* desiertas.   
\b  
\q1
\v 4 \w No|strong="H3808"\w* tengas \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* serás avergonzada;  
\q2 \w no|strong="H3808"\w* \w te|strong="H3588"\w* dejes confundir, \w porque|strong="H3588"\w* \w no|strong="H3808"\w* serás humillada.  
\q1 Olvidarás \w la|strong="H3588"\w* \w vergüenza|strong="H3637"\w* \w de|strong="H3588"\w* tu juventud  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* recordarás \w más|strong="H5750"\w* \w la|strong="H3588"\w* \w deshonra|strong="H2781"\w* \w de|strong="H3588"\w* tu viudez.   
\q1
\v 5 \w Porque|strong="H3588"\w* \w tu|strong="H6213"\w* Creador \w es|strong="H3588"\w* \w tu|strong="H6213"\w* esposo; \w su|strong="H3588"\w* \w nombre|strong="H8034"\w* \w es|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*.  
\q2 \w Tu|strong="H6213"\w* \w Redentor|strong="H1350"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, al \w que|strong="H3588"\w* \w llaman|strong="H7121"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra.   
\q1
\v 6 Yahvé \w te|strong="H3588"\w* ha vuelto \w a|strong="H3068"\w* \w llamar|strong="H7121"\w* \w como|strong="H3588"\w* \w a|strong="H3068"\w* una esposa \w abandonada|strong="H5800"\w* \w y|strong="H3588"\w* angustiada,  
\q2 \w como|strong="H3588"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* esposa joven \w que|strong="H3588"\w* un día fue rechazada”, dice tu \w Dios|strong="H3068"\w*.   
\b  
\q1
\v 7 “Por un corto \w momento|strong="H7281"\w* te abandoné,  
\q2 pero con inmensa ternura te volveré \w a|strong="H3068"\w* recoger.   
\q1
\v 8 \w En|strong="H4480"\w* un arrebato \w de|strong="H4480"\w* \w enojo|strong="H7110"\w* \w escondí|strong="H5641"\w* mi \w rostro|strong="H6440"\w* \w de|strong="H4480"\w* \w ti|strong="H4480"\w* \w por|strong="H4480"\w* un instante,  
\q2 pero \w con|strong="H4480"\w* amor \w eterno|strong="H5769"\w* \w te|strong="H4480"\w* tendré compasión”, dice Yahvé, tu \w Redentor|strong="H1350"\w*.   
\b  
\q1
\v 9 “\w Para|strong="H5921"\w* \w mí|strong="H5921"\w* \w esto|strong="H2063"\w* \w es|strong="H3588"\w* \w como|strong="H3588"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* días \w de|strong="H5921"\w* \w Noé|strong="H5146"\w*:  
\q2 \w así|strong="H3651"\w* \w como|strong="H3588"\w* \w juré|strong="H7650"\w* \w que|strong="H3588"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w del|strong="H5921"\w* diluvio \w no|strong="H3588"\w* volverían \w a|strong="H3068"\w* cubrir \w la|strong="H5921"\w* tierra,  
\q2 \w así|strong="H3651"\w* he \w jurado|strong="H7650"\w* \w que|strong="H3588"\w* \w no|strong="H3588"\w* \w me|strong="H5921"\w* enojaré \w con|strong="H5921"\w* ustedes ni \w los|strong="H5921"\w* reprenderé.   
\q1
\v 10 \w Aunque|strong="H3588"\w* las montañas \w se|strong="H3808"\w* muevan \w y|strong="H3588"\w* las colinas desaparezcan,  
\q2 mi amor \w por|strong="H3588"\w* ti \w no|strong="H3808"\w* cambiará \w ni|strong="H3808"\w* \w se|strong="H3808"\w* romperá mi \w pacto|strong="H1285"\w* \w de|strong="H3588"\w* \w paz|strong="H7965"\w*”, dice Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* tiene compasión.   
\b  
\q1
\v 11 “¡Pueblo \w afligido|strong="H6041"\w*, azotado por la tempestad y \w sin|strong="H3808"\w* \w consuelo|strong="H5162"\w*!  
\q2 \w Mira|strong="H2009"\w*, \w yo|strong="H2009"\w* mismo pondré tus piedras sobre azabache  
\q2 y tus \w cimientos|strong="H3245"\w* sobre zafiros.   
\q1
\v 12 \w Haré|strong="H7760"\w* tus torres de rubíes,  
\q2 tus \w puertas|strong="H8179"\w* de joyas brillantes  
\q2 y \w todas|strong="H3605"\w* tus murallas de piedras preciosas.   
\q1
\v 13 \w Todos|strong="H3605"\w* tus \w hijos|strong="H1121"\w* serán instruidos por Yahvé,  
\q2 y \w grande|strong="H7227"\w* será \w la|strong="H3605"\w* \w paz|strong="H7965"\w* \w de|strong="H1121"\w* tus \w hijos|strong="H1121"\w*.   
\q1
\v 14 Serás establecida \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w justicia|strong="H6666"\w*;  
\q2 estarás \w lejos|strong="H7368"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* opresión \w y|strong="H3588"\w* \w no|strong="H3808"\w* tendrás \w nada|strong="H3808"\w* \w que|strong="H3588"\w* temer;  
\q2 \w el|strong="H3588"\w* terror \w no|strong="H3808"\w* \w se|strong="H3808"\w* acercará \w a|strong="H3068"\w* ti.   
\q1
\v 15 \w Si|strong="H2005"\w* alguien \w te|strong="H5921"\w* ataca, \w no|strong="H5921"\w* será \w de|strong="H5921"\w* parte mía;  
\q2 \w quien|strong="H4310"\w* \w se|strong="H5921"\w* atreva \w a|strong="H3068"\w* atacarte, \w caerá|strong="H5307"\w* ante \w ti|strong="H5921"\w*.   
\b  
\q1
\v 16 \w Mira|strong="H2005"\w*, yo he creado al \w herrero|strong="H2796"\w* que aviva las brasas  
\q2 y fabrica \w armas|strong="H3627"\w* para la guerra;  
\q2 yo \w también|strong="H7843"\w* he creado al destructor para que cause ruina.   
\q1
\v 17 Pero \w ningún|strong="H3605"\w* arma fabricada \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w prosperará|strong="H6743"\w*,  
\q2 \w y|strong="H5921"\w* tú misma condenarás \w a|strong="H3068"\w* \w toda|strong="H3605"\w* \w lengua|strong="H3956"\w* \w que|strong="H3808"\w* \w se|strong="H5921"\w* levante \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w en|strong="H5921"\w* \w juicio|strong="H4941"\w*.  
\q1 \w Esta|strong="H2063"\w* \w es|strong="H2063"\w* \w la|strong="H5921"\w* \w herencia|strong="H5159"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w siervos|strong="H5650"\w* \w de|strong="H5921"\w* Yahvé;  
\q2 su victoria viene \w de|strong="H5921"\w* \w mí|strong="H5921"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\c 55  
\q1
\v 1 “¡Vengan! ¡\w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3808"\w* tengan sed, vengan \w a|strong="H3068"\w* las \w aguas|strong="H4325"\w*!  
\q2 \w Y|strong="H3068"\w* \w los|strong="H3605"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* tengan \w dinero|strong="H3701"\w*, ¡vengan, compren y coman!  
\q1 Vengan, compren \w vino|strong="H3196"\w* y \w leche|strong="H2461"\w*  
\q2 \w sin|strong="H3808"\w* \w dinero|strong="H3701"\w* y \w sin|strong="H3808"\w* costo \w alguno|strong="H3605"\w*.   
\q1
\v 2 ¿\w Por|strong="H4100"\w* \w qué|strong="H4100"\w* gastan \w dinero|strong="H3701"\w* en \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* es \w pan|strong="H3899"\w*,  
\q2 y su salario en \w lo|strong="H4100"\w* \w que|strong="H4100"\w* \w no|strong="H3808"\w* satisface?  
\q1 Escúchenme con atención y coman \w lo|strong="H4100"\w* \w que|strong="H4100"\w* es \w bueno|strong="H2896"\w*,  
\q2 y su \w alma|strong="H5315"\w* \w se|strong="H3808"\w* deleitará con los \w mejores|strong="H2896"\w* manjares.   
\q1
\v 3 Presten atención y vengan \w a|strong="H3068"\w* \w mí|strong="H5315"\w*;  
\q2 \w escuchen|strong="H8085"\w*, y su \w alma|strong="H5315"\w* \w vivirá|strong="H2421"\w*.  
\q1 \w Haré|strong="H3772"\w* con ustedes un \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*,  
\q2 basado \w en|strong="H3212"\w* las fieles promesas hechas \w a|strong="H3068"\w* \w David|strong="H1732"\w*.   
\q1
\v 4 Miren, \w yo|strong="H6680"\w* lo \w puse|strong="H5414"\w* como \w testigo|strong="H5707"\w* ante los \w pueblos|strong="H3816"\w*,  
\q2 como jefe y soberano \w de|strong="H5057"\w* las naciones.   
\q1
\v 5 Tú mismo \w llamarás|strong="H7121"\w* \w a|strong="H3068"\w* \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w conocías|strong="H3045"\w*,  
\q2 \w y|strong="H3588"\w* \w naciones|strong="H1471"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w te|strong="H3588"\w* \w conocían|strong="H3045"\w* \w correrán|strong="H7323"\w* hacia ti,  
\q1 \w por|strong="H3588"\w* causa \w de|strong="H3588"\w* Yahvé tu \w Dios|strong="H3068"\w*,  
\q2 \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w ha|strong="H3808"\w* llenado \w de|strong="H3588"\w* gloria”.   
\b  
\q1
\v 6 Busquen \w a|strong="H3068"\w* Yahvé mientras pueda ser \w hallado|strong="H4672"\w*;  
\q2 llámenlo mientras \w esté|strong="H1961"\w* \w cerca|strong="H7138"\w*.   
\q1
\v 7 \w Que|strong="H3588"\w* \w el|strong="H3588"\w* malvado \w deje|strong="H5800"\w* \w su|strong="H3588"\w* \w camino|strong="H1870"\w*  
\q2 \w y|strong="H3588"\w* \w el|strong="H3588"\w* hombre perverso sus \w pensamientos|strong="H4284"\w*.  
\q1 \w Que|strong="H3588"\w* se \w vuelva|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé, quien tendrá compasión \w de|strong="H3588"\w* \w él|strong="H3588"\w*;  
\q2 \w que|strong="H3588"\w* se \w vuelva|strong="H7725"\w* \w a|strong="H3068"\w* nuestro \w Dios|strong="H3068"\w*, quien \w es|strong="H3588"\w* generoso \w en|strong="H3588"\w* \w perdonar|strong="H5545"\w*.   
\b  
\q1
\v 8 “\w Porque|strong="H3588"\w* mis \w pensamientos|strong="H4284"\w* \w no|strong="H3808"\w* \w son|strong="H3588"\w* \w los|strong="H3588"\w* \w pensamientos|strong="H4284"\w* \w de|strong="H3588"\w* ustedes,  
\q2 \w ni|strong="H3808"\w* sus \w caminos|strong="H1870"\w* \w son|strong="H3588"\w* mis \w caminos|strong="H1870"\w*”, \w dice|strong="H5002"\w* Yahvé.   
\q1
\v 9 “\w Como|strong="H3588"\w* \w los|strong="H3588"\w* \w cielos|strong="H8064"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* altos \w que|strong="H3588"\w* \w la|strong="H3588"\w* tierra,  
\q2 \w así|strong="H3651"\w* mis \w caminos|strong="H1870"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* altos \w que|strong="H3588"\w* sus \w caminos|strong="H1870"\w*,  
\q2 \w y|strong="H3588"\w* mis \w pensamientos|strong="H4284"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* sus \w pensamientos|strong="H4284"\w*.   
\b  
\q1
\v 10 \w Porque|strong="H3588"\w* \w así|strong="H3588"\w* \w como|strong="H3588"\w* \w la|strong="H3588"\w* \w lluvia|strong="H1653"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* nieve bajan \w del|strong="H4480"\w* \w cielo|strong="H8064"\w*,  
\q2 \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w vuelven|strong="H7725"\w* \w allá|strong="H8033"\w*, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* riegan \w la|strong="H3588"\w* tierra,  
\q1 \w y|strong="H3588"\w* \w la|strong="H3588"\w* hacen germinar \w y|strong="H3588"\w* \w producir|strong="H6779"\w*,  
\q2 \w para|strong="H3588"\w* \w dar|strong="H5414"\w* semilla \w al|strong="H4480"\w* \w sembrador|strong="H2232"\w* \w y|strong="H3588"\w* \w pan|strong="H3899"\w* \w al|strong="H4480"\w* \w que|strong="H3588"\w* come,   
\q1
\v 11 \w así|strong="H3651"\w* \w es|strong="H1961"\w* \w mi|strong="H1961"\w* \w palabra|strong="H1697"\w* \w que|strong="H3588"\w* \w sale|strong="H3318"\w* \w de|strong="H3588"\w* \w mi|strong="H1961"\w* \w boca|strong="H6310"\w*:  
\q2 \w no|strong="H3808"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w vacía|strong="H7387"\w*,  
\q1 \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w hará|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* \w deseo|strong="H2654"\w*  
\q2 \w y|strong="H3588"\w* \w cumplirá|strong="H6213"\w* \w con|strong="H3588"\w* éxito \w el|strong="H3588"\w* propósito \w para|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w la|strong="H3588"\w* \w envié|strong="H7971"\w*.   
\q1
\v 12 Ustedes \w saldrán|strong="H3318"\w* \w con|strong="H3588"\w* \w alegría|strong="H8057"\w*  
\q2 \w y|strong="H3588"\w* serán guiados \w en|strong="H3588"\w* \w paz|strong="H7965"\w*;  
\q1 las montañas \w y|strong="H3588"\w* las colinas romperán \w en|strong="H3588"\w* cantos \w ante|strong="H6440"\w* ustedes,  
\q2 \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w árboles|strong="H6086"\w* del \w campo|strong="H7704"\w* aplaudirán.   
\q1
\v 13 \w En|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* espinos \w crecerán|strong="H5927"\w* cipreses,  
\q2 y \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* ortigas \w crecerán|strong="H5927"\w* mirtos.  
\q1 Esto \w servirá|strong="H1961"\w* \w de|strong="H8478"\w* memorial \w a|strong="H3068"\w* Yahvé,  
\q2 una señal \w eterna|strong="H5769"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w será|strong="H1961"\w* borrada”.   
\c 56  
\p
\v 1 \w Así|strong="H3541"\w* dice Yahvé:  
\q1 “Mantengan \w el|strong="H3588"\w* \w derecho|strong="H4941"\w*  
\q2 \w y|strong="H3588"\w* practiquen \w la|strong="H8104"\w* \w justicia|strong="H6666"\w*,  
\q1 \w porque|strong="H3588"\w* mi salvación está \w por|strong="H3588"\w* llegar  
\q2 \w y|strong="H3588"\w* mi \w justicia|strong="H6666"\w* pronto se manifestará.   
\q1
\v 2 Dichoso \w el|strong="H3605"\w* \w hombre|strong="H1121"\w* \w que|strong="H1121"\w* \w hace|strong="H6213"\w* \w esto|strong="H2063"\w*,  
\q2 y \w el|strong="H3605"\w* mortal \w que|strong="H1121"\w* se mantiene firme:  
\q1 \w que|strong="H1121"\w* \w guarda|strong="H8104"\w* \w el|strong="H3605"\w* \w sábado|strong="H7676"\w* sin profanarlo  
\q2 y evita \w que|strong="H1121"\w* su \w mano|strong="H3027"\w* \w haga|strong="H6213"\w* \w lo|strong="H6213"\w* \w malo|strong="H7451"\w*”.   
\b  
\q1
\v 3 \w Que|strong="H5921"\w* \w el|strong="H5921"\w* \w extranjero|strong="H5236"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* ha unido \w a|strong="H3068"\w* Yahvé \w no|strong="H5921"\w* diga:  
\q2 “Seguramente Yahvé \w me|strong="H5921"\w* excluirá \w de|strong="H5921"\w* su \w pueblo|strong="H5971"\w*”.  
\q2 Ni diga \w el|strong="H5921"\w* \w eunuco|strong="H5631"\w*: “\w No|strong="H5921"\w* soy \w más|strong="H5921"\w* \w que|strong="H5921"\w* un \w árbol|strong="H6086"\w* \w seco|strong="H3002"\w*”.   
\b  
\q1
\v 4 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* dice Yahvé: “\w A|strong="H3068"\w* \w los|strong="H3588"\w* \w eunucos|strong="H5631"\w* \w que|strong="H3588"\w* \w guardan|strong="H8104"\w* mis \w sábados|strong="H7676"\w*,  
\q2 \w que|strong="H3588"\w* eligen lo \w que|strong="H3588"\w* \w me|strong="H3588"\w* agrada  
\q2 \w y|strong="H3588"\w* se mantienen firmes \w en|strong="H3588"\w* mi \w pacto|strong="H1285"\w*,   
\q1
\v 5 yo les \w daré|strong="H5414"\w* en mi \w templo|strong="H1004"\w* y dentro \w de|strong="H1121"\w* \w mis|strong="H5414"\w* \w muros|strong="H2346"\w* un monumento y un \w nombre|strong="H8034"\w* \w mejor|strong="H2896"\w* \w que|strong="H3808"\w* \w el|strong="H1121"\w* \w de|strong="H1121"\w* \w hijos|strong="H1121"\w* \w e|strong="H3068"\w* \w hijas|strong="H1323"\w*;  
\q2 les \w daré|strong="H5414"\w* un \w nombre|strong="H8034"\w* \w eterno|strong="H5769"\w* \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* \w será|strong="H3808"\w* borrado.   
\b  
\q1
\v 6 \w Y|strong="H3068"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w extranjeros|strong="H1121"\w* \w que|strong="H5921"\w* \w se|strong="H1961"\w* unan \w a|strong="H3068"\w* Yahvé  
\q2 \w para|strong="H5921"\w* servirle,  
\q1 \w para|strong="H5921"\w* amar \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé  
