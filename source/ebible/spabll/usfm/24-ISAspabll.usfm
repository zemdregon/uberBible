\toc2 ISAÍAS 
\mt2 El libro del profeta  
\mt1 Isaías  
\c 1  
\p
\v 1 \w Visión|strong="H2377"\w* \w de|strong="H5921"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz, \w la|strong="H5921"\w* cual \w vio|strong="H2372"\w* \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* Jerusalén \w en|strong="H5921"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Uzías, Jotam, Acaz \w y|strong="H5921"\w* Ezequías, \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*.   
\q1
\v 2 ¡\w Oigan|strong="H8085"\w*, \w cielos|strong="H8064"\w*,  
\q2 \w y|strong="H3588"\w* \w escucha|strong="H8085"\w* tú, tierra! \w Porque|strong="H3588"\w* Yahvé\f + \fr 1:2 \ft “Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.\f* ha \w hablado|strong="H1696"\w*:  
\q1 “\w Crié|strong="H1431"\w* \w hijos|strong="H1121"\w* \w y|strong="H3588"\w* \w los|strong="H1992"\w* hice crecer,  
\q2 \w pero|strong="H3588"\w* \w ellos|strong="H1992"\w* \w se|strong="H1992"\w* rebelaron contra \w mí|strong="H1431"\w*.   
\q1
\v 3 El \w buey|strong="H7794"\w* \w conoce|strong="H3045"\w* \w a|strong="H3068"\w* su \w dueño|strong="H1167"\w*,  
\q2 \w y|strong="H7794"\w* el burro el pesebre \w de|strong="H5971"\w* su señor;  
\q1 pero \w Israel|strong="H3478"\w* \w no|strong="H3808"\w* \w conoce|strong="H3045"\w*,  
\q2 mi \w pueblo|strong="H5971"\w* \w no|strong="H3808"\w* \w entiende|strong="H3045"\w*”.   
\q1
\v 4 ¡\w Ay|strong="H1945"\w*, \w nación|strong="H1471"\w* \w pecadora|strong="H2398"\w*,  
\q2 \w pueblo|strong="H5971"\w* \w cargado|strong="H3515"\w* \w de|strong="H1121"\w* \w maldad|strong="H5771"\w*,  
\q1 \w generación|strong="H2233"\w*\f + \fr 1:4 \ft o, semilla\f* \w de|strong="H1121"\w* malhechores,  
\q2 \w hijos|strong="H1121"\w* \w depravados|strong="H7843"\w*!  
\q1 Han abandonado \w a|strong="H3068"\w* Yahvé,  
\q2 han despreciado al \w Santo|strong="H6918"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*,  
\q2 \w se|strong="H5971"\w* han vuelto atrás.   
\q1
\v 5 ¿\w Para|strong="H5921"\w* \w qué|strong="H4100"\w* seguir siendo golpeados?  
\q2 ¿\w Por|strong="H5921"\w* \w qué|strong="H4100"\w* persistir \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w rebelión|strong="H5627"\w*?  
\q1 \w Toda|strong="H3605"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w está|strong="H5921"\w* enferma,  
\q2 \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w corazón|strong="H3824"\w* \w desfallece|strong="H1742"\w*.   
\q1
\v 6 \w Desde|strong="H5704"\w* la planta del \w pie|strong="H7272"\w* \w hasta|strong="H5704"\w* la \w cabeza|strong="H7218"\w* \w no|strong="H3808"\w* hay \w en|strong="H5704"\w* él \w nada|strong="H3808"\w* sano,  
\q2 \w sino|strong="H3808"\w* \w heridas|strong="H4347"\w*, golpes \w y|strong="H5704"\w* llagas recientes;  
\q1 \w no|strong="H3808"\w* han sido curadas \w ni|strong="H3808"\w* \w vendadas|strong="H2280"\w*,  
\q2 \w ni|strong="H3808"\w* \w suavizadas|strong="H7401"\w* \w con|strong="H5704"\w* \w aceite|strong="H8081"\w*.   
\q1
\v 7 Su tierra está destruida,  
\q2 sus \w ciudades|strong="H5892"\w* quemadas con fuego;  
\q1 su suelo, ante sus propios ojos, es devorado por extranjeros,  
\q2 y quedó desolado como tras el paso \w de|strong="H5048"\w* extraños.   
\q1
\v 8 La \w hija|strong="H1323"\w* de \w Sión|strong="H6726"\w* ha quedado como una choza en un viñedo,  
\q2 como una cabaña en un melonar, como una \w ciudad|strong="H5892"\w* sitiada.   
\q1
\v 9 \w Si|strong="H3884"\w* Yahvé de \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w no|strong="H3884"\w* nos hubiera dejado un pequeño resto,  
\q2 seríamos \w como|strong="H1961"\w* \w Sodoma|strong="H5467"\w*, nos pareceríamos \w a|strong="H3068"\w* \w Gomorra|strong="H6017"\w*.   
\p
\v 10 ¡\w Oigan|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé, gobernantes \w de|strong="H5971"\w* \w Sodoma|strong="H5467"\w*!  
\v 11 ¡Escuchen \w la|strong="H7646"\w* enseñanza \w de|strong="H1818"\w* nuestro \w Dios|strong="H3068"\w*,\f + \fr 1:11 \ft La palabra hebrea traducida como “Dios” es “אֱלֹהִ֑ים” (Elohim).\f* pueblo \w de|strong="H1818"\w* Gomorra!  
\q1 “¿Para \w qué|strong="H4100"\w* me sirve \w la|strong="H7646"\w* \w multitud|strong="H7230"\w* \w de|strong="H1818"\w* sus \w sacrificios|strong="H2077"\w*?”, dice Yahvé.  
\q2 “Estoy harto \w de|strong="H1818"\w* \w holocaustos|strong="H5930"\w* \w de|strong="H1818"\w* carneros y \w de|strong="H1818"\w* grasa \w de|strong="H1818"\w* animales engordados;  
\q1 \w no|strong="H3808"\w* me agrada \w la|strong="H7646"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* \w novillos|strong="H6499"\w*,  
\q2 \w ni|strong="H3808"\w* \w de|strong="H1818"\w* ovejas \w ni|strong="H3808"\w* \w de|strong="H1818"\w* machos cabríos.  
\v 12 \w Cuando|strong="H3588"\w* vienen \w a|strong="H3068"\w* presentarse \w ante|strong="H6440"\w* \w mí|strong="H1245"\w*,  
\q2 ¿\w quién|strong="H4310"\w* les \w pidió|strong="H1245"\w* \w esto|strong="H2063"\w*, \w que|strong="H3588"\w* pisoteen mis \w atrios|strong="H2691"\w*?  
\v 13 \w No|strong="H3808"\w* me traigan \w más|strong="H3254"\w* ofrendas \w inútiles|strong="H3808"\w*;  
\q2 \w el|strong="H1931"\w* incienso me \w es|strong="H1931"\w* asqueroso.  
\q1 Luna nueva, \w sábado|strong="H7676"\w* y \w el|strong="H1931"\w* convocar \w asambleas|strong="H4744"\w*...  
\q2 ¡\w no|strong="H3808"\w* soporto \w que|strong="H1931"\w* \w sus|strong="H1931"\w* fiestas solemnes \w se|strong="H1931"\w* mezclen con \w la|strong="H1931"\w* iniquidad!  
\v 14 \w Mi|strong="H5921"\w* \w alma|strong="H5315"\w* \w aborrece|strong="H8130"\w* sus lunas \w nuevas|strong="H2320"\w* \w y|strong="H5921"\w* sus festividades;  
\q2 \w se|strong="H1961"\w* han vuelto una carga \w para|strong="H5921"\w* \w mí|strong="H5921"\w*, \w estoy|strong="H1961"\w* \w cansado|strong="H3811"\w* \w de|strong="H5921"\w* soportarlas.  
\v 15 \w Cuando|strong="H3588"\w* extiendan sus \w manos|strong="H3027"\w*, \w yo|strong="H4480"\w* cerraré mis \w ojos|strong="H5869"\w* \w para|strong="H3588"\w* \w no|strong="H3588"\w* verlos;  
\q2 \w aunque|strong="H3588"\w* multipliquen sus oraciones, \w no|strong="H3588"\w* las \w escucharé|strong="H8085"\w*;  
\q1 sus \w manos|strong="H3027"\w* están \w llenas|strong="H4390"\w* \w de|strong="H4480"\w* \w sangre|strong="H1818"\w*.  
\v 16 Lávense, límpiense;  
\q2 quiten la \w maldad|strong="H7455"\w* \w de|strong="H5048"\w* sus acciones \w de|strong="H5048"\w* \w delante|strong="H5048"\w* \w de|strong="H5048"\w* mis \w ojos|strong="H5869"\w*;  
\q1 \w dejen|strong="H2308"\w* \w de|strong="H5048"\w* hacer lo malo.  
\v 17 Aprendan \w a|strong="H3068"\w* hacer el \w bien|strong="H3190"\w*,  
\q2 busquen la \w justicia|strong="H4941"\w*, reprendan al opresor,  
\q1 defiendan al \w huérfano|strong="H3490"\w*,  
\q2 aboguen por la viuda”.   
\p
\v 18 “Vengan \w ahora|strong="H4994"\w* y razonemos”, dice Yahvé:  
\q1 “Aunque sus \w pecados|strong="H2399"\w* \w sean|strong="H1961"\w* \w como|strong="H1961"\w* la grana, \w como|strong="H1961"\w* la nieve \w serán|strong="H1961"\w* emblanquecidos;  
\q2 aunque \w sean|strong="H1961"\w* rojos \w como|strong="H1961"\w* el carmesí, vendrán \w a|strong="H3068"\w* ser \w como|strong="H1961"\w* blanca \w lana|strong="H6785"\w*.  
\v 19 Si están dispuestos y \w obedecen|strong="H8085"\w*,  
\q2 comerán de lo mejor de la tierra;  
\v 20 \w pero|strong="H3588"\w* \w si|strong="H3588"\w* se niegan \w y|strong="H3588"\w* se rebelan, \w serán|strong="H6310"\w* devorados \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*”;  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3588"\w* \w boca|strong="H6310"\w* \w de|strong="H3588"\w* Yahvé lo ha \w dicho|strong="H6310"\w*.   
\p
\v 21 ¡\w Cómo|strong="H1961"\w* \w se|strong="H1961"\w* ha vuelto \w ramera|strong="H2181"\w* la \w ciudad|strong="H7151"\w* fiel!  
\q1 \w Estaba|strong="H1961"\w* llena de \w justicia|strong="H6664"\w*, en ella habitaba la rectitud,  
\q2 ¡pero \w ahora|strong="H6258"\w* solo \w hay|strong="H1961"\w* asesinos!  
\v 22 Tu \w plata|strong="H3701"\w* \w se|strong="H1961"\w* ha vuelto impurezas,  
\q2 tu \w vino|strong="H1961"\w* \w está|strong="H1961"\w* \w mezclado|strong="H4107"\w* con \w agua|strong="H4325"\w*.  
\v 23 Tus gobernantes \w son|strong="H3808"\w* rebeldes y compañeros \w de|strong="H8269"\w* \w ladrones|strong="H1590"\w*;  
\q1 \w todos|strong="H3605"\w* aman \w el|strong="H3605"\w* \w soborno|strong="H7810"\w* y corren tras las recompensas;  
\q2 \w no|strong="H3808"\w* le hacen justicia al \w huérfano|strong="H3490"\w*, \w ni|strong="H3808"\w* les importa \w la|strong="H3605"\w* \w causa|strong="H7379"\w* \w de|strong="H8269"\w* \w la|strong="H3605"\w* viuda.   
\p
\v 24 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w dice|strong="H5002"\w* el \w Señor|strong="H3068"\w*,\f + \fr 1:24 \ft La palabra traducida “Señor” es “Adonai”.\f* Yahvé de los \w Ejércitos|strong="H6635"\w*, el Fuerte de \w Israel|strong="H3478"\w*:  
\q1 “¡Basta! Me desquitaré de mis \w adversarios|strong="H6862"\w*  
\q2 y me vengaré de mi \w enemigos|strong="H6862"\w*.  
\v 25 \w Volveré|strong="H7725"\w* \w mi|strong="H5921"\w* \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*,  
\q1 limpiaré \w a|strong="H3068"\w* fondo tus impurezas  
\q2 \w y|strong="H5921"\w* \w quitaré|strong="H5493"\w* \w todos|strong="H3605"\w* tus desechos;\f + \fr 1:25 \ft El estaño es un metal que se separa de la plata durante el proceso de refinado y purificación.\f*  
\v 26 restauraré tus \w jueces|strong="H8199"\w* \w como|strong="H3651"\w* al principio,  
\q1 y tus \w consejeros|strong="H3289"\w* \w como|strong="H3651"\w* \w en|strong="H8462"\w* el comienzo;  
\q2 después de \w esto|strong="H3651"\w* te \w llamarán|strong="H7121"\w* ‘\w Ciudad|strong="H5892"\w* de \w justicia|strong="H6664"\w*’, ‘\w Ciudad|strong="H5892"\w* fiel’”.  
\v 27 \w Sión|strong="H6726"\w* será rescatada con \w justicia|strong="H6666"\w*,  
\q2 y los que se arrepientan, con rectitud.  
\v 28 Pero los rebeldes y \w pecadores|strong="H2400"\w* serán destrozados \w a|strong="H3068"\w* una,  
\q2 y los que \w abandonan|strong="H5800"\w* \w a|strong="H3068"\w* Yahvé serán consumidos.  
\v 29 \w Entonces|strong="H3588"\w* se avergonzarán \w de|strong="H3588"\w* \w los|strong="H3588"\w* robles \w que|strong="H3588"\w* tanto amaron,  
\q2 \w y|strong="H3588"\w* se decepcionarán \w de|strong="H3588"\w* \w los|strong="H3588"\w* jardines \w que|strong="H3588"\w* eligieron.  
\v 30 \w Porque|strong="H3588"\w* \w serán|strong="H1961"\w* \w como|strong="H3588"\w* un roble cuyas \w hojas|strong="H5929"\w* \w se|strong="H1961"\w* marchitan,  
\q2 \w y|strong="H3588"\w* \w como|strong="H3588"\w* un jardín al \w que|strong="H3588"\w* le falta \w el|strong="H3588"\w* \w agua|strong="H4325"\w*.  
\v 31 El hombre fuerte \w se|strong="H1961"\w* volverá \w como|strong="H1961"\w* estopa,  
\q1 \w y|strong="H1197"\w* su trabajo \w como|strong="H1961"\w* una chispa;  
\q2 \w ambos|strong="H8147"\w* arderán \w juntos|strong="H3162"\w* \w y|strong="H1197"\w* \w no|strong="H1961"\w* \w habrá|strong="H1961"\w* quien \w los|strong="H1961"\w* apague”.   
\c 2  
\p
\v 1 Visión \w de|strong="H5921"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz, \w acerca|strong="H5921"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* Jerusalén.   
\q1
\v 2 \w Sucederá|strong="H1961"\w* en \w los|strong="H3605"\w* últimos \w días|strong="H3117"\w*, \w que|strong="H3117"\w* \w el|strong="H3605"\w* \w monte|strong="H2022"\w* de \w la|strong="H3605"\w* \w casa|strong="H1004"\w* de Yahvé \w será|strong="H1961"\w* \w establecido|strong="H3559"\w* \w como|strong="H1961"\w* \w el|strong="H3605"\w* \w principal|strong="H7218"\w* de \w los|strong="H3605"\w* \w montes|strong="H2022"\w*;  
\q2 \w será|strong="H1961"\w* elevado por \w encima|strong="H7218"\w* de las colinas, y \w todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* correrán hacia \w él|strong="H3605"\w*.   
\q1
\v 3 \w Muchos|strong="H7227"\w* \w pueblos|strong="H5971"\w* vendrán \w y|strong="H3588"\w* dirán:  
\q2 “\w Vengan|strong="H5927"\w*, \w subamos|strong="H5927"\w* al \w monte|strong="H2022"\w* \w de|strong="H3588"\w* Yahvé, \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* del \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w*.  
\q2 \w Él|strong="H3588"\w* nos \w enseñará|strong="H3384"\w* sus \w caminos|strong="H1870"\w*, \w y|strong="H3588"\w* caminaremos \w por|strong="H3588"\w* sus sendas”.  
\q1 \w Porque|strong="H3588"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w* \w saldrá|strong="H3318"\w* \w la|strong="H3588"\w* enseñanza,  
\q2 \w y|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén \w la|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé.   
\q1
\v 4 Él \w juzgará|strong="H8199"\w* \w entre|strong="H3808"\w* las \w naciones|strong="H1471"\w* y decidirá \w por|strong="H5750"\w* \w muchos|strong="H7227"\w* \w pueblos|strong="H5971"\w*.  
\q2 Convertirán sus \w espadas|strong="H2719"\w* \w en|strong="H5750"\w* arados y sus lanzas \w en|strong="H5750"\w* podaderas.  
\q1 \w No|strong="H3808"\w* \w alzará|strong="H5375"\w* \w espada|strong="H2719"\w* \w nación|strong="H1471"\w* contra \w nación|strong="H1471"\w*,  
\q2 \w ni|strong="H3808"\w* \w se|strong="H3808"\w* entrenarán \w más|strong="H5750"\w* \w para|strong="H5971"\w* la \w guerra|strong="H4421"\w*.   
\b  
\q1
\v 5 ¡Vengan, \w casa|strong="H1004"\w* de \w Jacob|strong="H3290"\w*, y caminemos \w a|strong="H3068"\w* la luz de Yahvé!   
\q1
\v 6 \w Ciertamente|strong="H3588"\w* has abandonado \w a|strong="H3068"\w* tu \w pueblo|strong="H5971"\w*, \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w*, \w porque|strong="H3588"\w* están \w llenos|strong="H4390"\w* \w de|strong="H3588"\w* costumbres del \w oriente|strong="H6924"\w*;  
\q2 practican \w la|strong="H3588"\w* adivinación \w como|strong="H3588"\w* \w los|strong="H3588"\w* \w filisteos|strong="H6430"\w* \w y|strong="H3588"\w* hacen tratos \w con|strong="H3588"\w* extranjeros.   
\q1
\v 7 Su tierra está \w llena|strong="H4390"\w* de \w plata|strong="H3701"\w* y \w oro|strong="H2091"\w*, y sus tesoros no tienen fin.  
\q1 Su tierra está \w llena|strong="H4390"\w* de \w caballos|strong="H5483"\w*, y sus \w carros|strong="H4818"\w* son incontables.   
\q1
\v 8 Su tierra también está \w llena|strong="H4390"\w* de ídolos;  
\q2 \w adoran|strong="H7812"\w* la \w obra|strong="H4639"\w* de sus \w manos|strong="H3027"\w*, \w lo|strong="H6213"\w* \w que|strong="H3027"\w* sus propios dedos \w fabricaron|strong="H6213"\w*.   
\q1
\v 9 Así el hombre ha sido doblegado y la humanidad humillada;  
\q2 ¡no los \w perdones|strong="H5375"\w*!   
\q1
\v 10 Métanse en las rocas, escóndanse en el \w polvo|strong="H6083"\w*,  
\q2 \w ante|strong="H6440"\w* el \w terror|strong="H6343"\w* \w de|strong="H6440"\w* Yahvé y el resplandor \w de|strong="H6440"\w* su majestad.   
\q1
\v 11 \w La|strong="H1931"\w* mirada altiva del hombre \w será|strong="H1931"\w* humillada y \w el|strong="H1931"\w* orgullo humano \w será|strong="H1931"\w* abatido;  
\q2 \w solo|strong="H1931"\w* Yahvé \w será|strong="H1931"\w* exaltado en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*.   
\b  
\q1
\v 12 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* vendrá \w contra|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w es|strong="H3588"\w* orgulloso \w y|strong="H3588"\w* altivo,  
\q2 \w contra|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* cree importante, \w para|strong="H5921"\w* abatirlo.  
\v 13 Vendrá \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* cedros \w del|strong="H5921"\w* \w Líbano|strong="H3844"\w*, \w altos|strong="H7311"\w* \w y|strong="H5921"\w* elevados,  
\q2 \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* robles \w de|strong="H5921"\w* \w Basán|strong="H1316"\w*;  
\v 14 \w contra|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w altos|strong="H7311"\w*,  
\q2 \w y|strong="H5921"\w* \w contra|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* colinas \w elevadas|strong="H7311"\w*;  
\v 15 \w contra|strong="H5921"\w* \w toda|strong="H3605"\w* \w torre|strong="H4026"\w* \w alta|strong="H1364"\w*,  
