\b  
\q1
\v 8 ¡Yo \w soy|strong="H1931"\w* Yahvé! \w Ese|strong="H1931"\w* \w es|strong="H1931"\w* mi \w nombre|strong="H8034"\w*.  
\q2 \w No|strong="H3808"\w* \w entregaré|strong="H5414"\w* mi \w gloria|strong="H3519"\w* \w a|strong="H3068"\w* \w ningún|strong="H3808"\w* otro,  
\q2 \w ni|strong="H3808"\w* mi \w alabanza|strong="H8416"\w* \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w ídolos|strong="H6456"\w*.   
\q1
\v 9 Miren, las profecías \w antiguas|strong="H7223"\w* ya se han cumplido,  
\q2 y \w ahora|strong="H2009"\w* \w anuncio|strong="H5046"\w* cosas \w nuevas|strong="H2319"\w*;  
\q2 \w antes|strong="H2962"\w* de que sucedan, \w yo|strong="H2009"\w* se las doy \w a|strong="H3068"\w* conocer”.   
\b  
\q1
\v 10 ¡Canten \w a|strong="H3068"\w* Yahvé un \w cántico|strong="H7892"\w* \w nuevo|strong="H2319"\w*!  
\q2 ¡Alábenlo desde \w los|strong="H3427"\w* confines de la tierra!  
\q2 Que lo alabe \w el|strong="H3427"\w* \w mar|strong="H3220"\w* y todo lo que hay en \w él|strong="H3427"\w*,  
\q2 las costas y sus \w habitantes|strong="H3427"\w*.   
\q1
\v 11 \w Que|strong="H2691"\w* \w alce|strong="H5375"\w* la voz \w el|strong="H3427"\w* \w desierto|strong="H4057"\w* y sus \w ciudades|strong="H5892"\w*,  
\q2 y las \w aldeas|strong="H2691"\w* donde vive la gente de Kedar.  
\q2 \w Que|strong="H2691"\w* \w canten|strong="H7442"\w* de alegría \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Sela,  
\q2 y griten de júbilo desde las cumbres de \w los|strong="H3427"\w* \w montes|strong="H2022"\w*.   
