\q2 \w y|strong="H1197"\w* su \w tierra|strong="H6083"\w* en brea \w ardiente|strong="H1197"\w*.   
\q1
\v 10 \w No|strong="H3808"\w* \w se|strong="H3808"\w* \w apagará|strong="H3518"\w* \w ni|strong="H3808"\w* de \w día|strong="H3119"\w* \w ni|strong="H3808"\w* de \w noche|strong="H3915"\w*;  
\q2 su \w humo|strong="H6227"\w* \w subirá|strong="H5927"\w* \w por|strong="H5769"\w* \w siempre|strong="H5769"\w*.  
