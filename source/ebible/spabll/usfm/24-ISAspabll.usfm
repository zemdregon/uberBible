\q2 \w el|strong="H5973"\w* botín \w que|strong="H5971"\w* \w les|strong="H5973"\w* robaron \w a|strong="H3068"\w* \w los|strong="H5973"\w* pobres está \w en|strong="H5973"\w* sus \w casas|strong="H1004"\w*.  
\v 15 ¿Con \w qué|strong="H5971"\w* derecho aplastan \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*  
\q2 y humillan \w a|strong="H3068"\w* los pobres?”, \w dice|strong="H5002"\w* el Señor, Yahvé \w de|strong="H6440"\w* los \w Ejércitos|strong="H6635"\w*.   
\b  
\q1
\v 16 Yahvé también dijo: “\w Por|strong="H3588"\w* \w cuanto|strong="H3588"\w* las \w hijas|strong="H1323"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w* \w son|strong="H3588"\w* orgullosas,  
\q2 \w y|strong="H3588"\w* \w caminan|strong="H1980"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* cuello erguido \w y|strong="H3588"\w* miradas provocativas,  
\q2 \w caminando|strong="H1980"\w* \w con|strong="H3588"\w* pasos cortos \w y|strong="H3588"\w* elegantes,  
\q2 haciendo tintinear \w los|strong="H3588"\w* adornos \w de|strong="H3588"\w* sus \w pies|strong="H7272"\w*;   
\q1
\v 17 por eso el \w Señor|strong="H3068"\w* cubrirá de sarna la cabeza de las \w hijas|strong="H1323"\w* de \w Sión|strong="H6726"\w*,  
\q2 y Yahvé las dejará calvas”.   
\p
\v 18 \w En|strong="H5493"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w el|strong="H1931"\w* Señor les \w quitará|strong="H5493"\w* \w los|strong="H1931"\w* adornos: las tobilleras, las diademas, \w los|strong="H1931"\w* collares de media luna,  
\v 19 los pendientes, los brazaletes, los velos,  
\v 20 los tocados, las cadenillas de los pies, las fajas, los frascos de perfume y los amuletos,  
\v 21 los \w anillos|strong="H2885"\w*, los adornos de la nariz,  
\v 22 las ropas de \w gala|strong="H4254"\w*, los mantos, los chales, los bolsos,  
\v 23 los espejos, las \w telas|strong="H5466"\w* de lino fino, los turbantes y las mantillas.   
\q1
\v 24 \w Y|strong="H3068"\w* \w sucederá|strong="H1961"\w* \w que|strong="H1961"\w* \w en|strong="H8478"\w* vez \w de|strong="H8478"\w* perfume \w habrá|strong="H1961"\w* pestilencia;  
\q2 \w en|strong="H8478"\w* \w lugar|strong="H8478"\w* \w de|strong="H8478"\w* cinturón, una soga;  
