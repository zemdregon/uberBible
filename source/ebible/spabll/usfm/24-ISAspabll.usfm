\b  
\q1
\v 24 \w Así|strong="H3541"\w* dice Yahvé, \w tu|strong="H6213"\w* \w Redentor|strong="H1350"\w*,  
\q2 \w el|strong="H3605"\w* \w que|strong="H4325"\w* te \w formó|strong="H3335"\w* desde \w el|strong="H3605"\w* vientre:  
\q1 “\w Yo|strong="H6213"\w* soy Yahvé, \w el|strong="H3605"\w* Creador \w de|strong="H4325"\w* \w todas|strong="H3605"\w* las cosas,  
\q2 \w que|strong="H4325"\w* solo desplegó \w los|strong="H3605"\w* \w cielos|strong="H8064"\w*  
