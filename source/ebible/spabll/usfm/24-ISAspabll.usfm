\q1
\v 10 Digan al \w justo|strong="H6662"\w* \w que|strong="H3588"\w* le irá \w bien|strong="H2896"\w*,  
\q2 \w porque|strong="H3588"\w* disfrutará del \w fruto|strong="H6529"\w* \w de|strong="H3588"\w* sus acciones.   
\q1
\v 11 ¡Ay del \w malvado|strong="H7451"\w*! Le irá \w mal|strong="H7451"\w*,  
\q2 \w porque|strong="H3588"\w* se le pagará según \w la|strong="H3588"\w* \w obra|strong="H6213"\w* \w de|strong="H3588"\w* sus \w manos|strong="H3027"\w*.   
\q1
\v 12 ¡\w Pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*! Tus opresores son muchachos,  
\q2 y mujeres gobiernan sobre ti.  
\q1 ¡\w Pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*! Tus guías te \w engañan|strong="H8582"\w*  
\q2 y confunden \w el|strong="H5065"\w* rumbo \w de|strong="H5971"\w* tus \w caminos|strong="H1870"\w*.   
\b  
\q1
\v 13 Yahvé \w se|strong="H5971"\w* levanta \w para|strong="H5971"\w* presentar su caso,  
\q2 \w está|strong="H5324"\w* \w en|strong="H5975"\w* \w pie|strong="H5975"\w* \w para|strong="H5971"\w* juzgar \w a|strong="H3068"\w* los \w pueblos|strong="H5971"\w*.   
