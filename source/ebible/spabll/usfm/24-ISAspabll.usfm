\v 8 \w Porque|strong="H3588"\w* Yahvé tiene un \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w venganza|strong="H5359"\w*,  
\q2 un \w año|strong="H8141"\w* \w de|strong="H3588"\w* desquite \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w causa|strong="H7379"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w*.   
\q1
\v 9 \w Los|strong="H1961"\w* \w arroyos|strong="H5158"\w* de Edom \w se|strong="H1961"\w* convertirán en brea,  
