\c 42  
\q1
\v 1 “Miren \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w*, \w a|strong="H3068"\w* quien \w yo|strong="H5315"\w* sostengo;  
