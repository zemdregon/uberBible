\q1 ¡\w No|strong="H3808"\w*, \w no|strong="H3808"\w* \w hay|strong="H3426"\w* otra \w Roca|strong="H6697"\w*!  
\q2 \w No|strong="H3808"\w* \w conozco|strong="H3045"\w* \w ninguna|strong="H3808"\w*”.   
