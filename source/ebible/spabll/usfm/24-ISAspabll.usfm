\q2 \w y|strong="H5921"\w* \w se|strong="H5921"\w* alejarán \w la|strong="H5921"\w* \w tristeza|strong="H3015"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* llanto.   
\c 36  
\p
\v 1 \w En|strong="H5921"\w* \w el|strong="H5921"\w* \w año|strong="H8141"\w* catorce \w del|strong="H5921"\w* \w reinado|strong="H4428"\w* \w de|strong="H5921"\w* Ezequías, Senaquerib, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, atacó \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w y|strong="H5921"\w* \w las|strong="H5921"\w* conquistó.  
\v 2 El \w rey|strong="H4428"\w* de Asiria \w envió|strong="H7971"\w* desde Laquis \w a|strong="H3068"\w* Jerusalén \w al|strong="H4428"\w* oficial \w Rabsaces|strong="H7262"\w*, con un gran \w ejército|strong="H2426"\w*, para enfrentarse \w al|strong="H4428"\w* \w rey|strong="H4428"\w* Ezequías. El oficial se detuvo junto \w al|strong="H4428"\w* acueducto del \w estanque|strong="H1295"\w* superior, \w en|strong="H5975"\w* el \w camino|strong="H4546"\w* que lleva \w al|strong="H4428"\w* \w Campo|strong="H7704"\w* del Lavandero.  
\v 3 \w Salieron|strong="H3318"\w* \w a|strong="H3068"\w* recibirlo Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jilquías, administrador \w del|strong="H5921"\w* palacio, \w el|strong="H5921"\w* \w escriba|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* cronista Joa \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Asaf.   
\p
\v 4 El \w Rabsaces|strong="H7262"\w* les dijo: “Digan \w ahora|strong="H4994"\w* \w a|strong="H3068"\w* Ezequías: “\w Así|strong="H3541"\w* dice el \w gran|strong="H1419"\w* \w rey|strong="H4428"\w*, el \w rey|strong="H4428"\w* de Asiria: ¿En \w qué|strong="H4100"\w* basas esa confianza \w que|strong="H4100"\w* tienes?  
\v 5 \w Yo|strong="H3588"\w* digo \w que|strong="H3588"\w* tus planes \w y|strong="H3588"\w* tu fuerza \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w* \w no|strong="H3588"\w* \w son|strong="H3588"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* \w palabras|strong="H1697"\w* vacías. ¿\w En|strong="H5921"\w* \w quién|strong="H4310"\w* confías \w ahora|strong="H6258"\w* \w para|strong="H5921"\w* haberte rebelado \w contra|strong="H5921"\w* \w mí|strong="H5921"\w*?  
\v 6 Miren, ustedes \w confían|strong="H5564"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* apoyo \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w ese|strong="H2088"\w* bastón \w de|strong="H5921"\w* \w caña|strong="H7070"\w* quebrada \w que|strong="H5921"\w*, \w si|strong="H2009"\w* alguien \w se|strong="H5921"\w* apoya \w en|strong="H5921"\w* \w él|strong="H5921"\w*, \w se|strong="H5921"\w* \w le|strong="H5921"\w* clava \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3709"\w* \w y|strong="H5921"\w* \w la|strong="H5921"\w* atraviesa. \w Así|strong="H3651"\w* \w es|strong="H2088"\w* \w el|strong="H5921"\w* \w faraón|strong="H6547"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w para|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w confían|strong="H5564"\w* \w en|strong="H5921"\w* \w él|strong="H5921"\w*.  
\v 7 \w Y|strong="H3068"\w* \w si|strong="H3588"\w* \w me|strong="H3588"\w* dicen: Confiamos \w en|strong="H3588"\w* Yahvé nuestro \w Dios|strong="H3068"\w*; ¿acaso \w no|strong="H3808"\w* \w es|strong="H1931"\w* \w él|strong="H1931"\w* \w aquel|strong="H1931"\w* \w cuyos|strong="H1931"\w* \w altares|strong="H4196"\w* \w y|strong="H3588"\w* santuarios Ezequías \w quitó|strong="H5493"\w*, diciendo \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* Jerusalén: \w Solo|strong="H1931"\w* \w ante|strong="H6440"\w* \w este|strong="H2088"\w* \w altar|strong="H4196"\w* deben adorar?”.  
\v 8 \w Por|strong="H5921"\w* \w tanto|strong="H5921"\w*, hagan \w ahora|strong="H6258"\w* un \w trato|strong="H5414"\w* \w con|strong="H5921"\w* \w mi|strong="H5921"\w* señor \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria: \w yo|strong="H4994"\w* \w les|strong="H5921"\w* \w daré|strong="H5414"\w* dos mil \w caballos|strong="H5483"\w* \w si|strong="H4994"\w* ustedes son capaces \w de|strong="H5921"\w* \w poner|strong="H5414"\w* jinetes \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w*.  
\v 9 ¿\w Cómo|strong="H5921"\w* podrán rechazar \w a|strong="H3068"\w* un solo \w capitán|strong="H6346"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* oficiales \w más|strong="H5921"\w* humildes \w de|strong="H5921"\w* \w mi|strong="H5921"\w* señor, confiando \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w para|strong="H5921"\w* conseguir \w carros|strong="H7393"\w* \w y|strong="H5921"\w* \w jinetes|strong="H6571"\w*?  
\v 10 \w Además|strong="H5921"\w*, ¿acaso he venido \w a|strong="H3068"\w* atacar \w y|strong="H5921"\w* \w destruir|strong="H7843"\w* \w esta|strong="H2063"\w* tierra \w sin|strong="H1107"\w* \w el|strong="H5921"\w* permiso \w de|strong="H5921"\w* Yahvé? Yahvé mismo \w me|strong="H5921"\w* dijo: \w Sube|strong="H5927"\w* \w contra|strong="H5921"\w* \w esta|strong="H2063"\w* tierra \w y|strong="H5921"\w* destrúyela””.   
\p
\v 11 \w Entonces|strong="H3588"\w* Eliaquim, \w Sebna|strong="H7644"\w* \w y|strong="H3588"\w* Joa \w le|strong="H5921"\w* \w dijeron|strong="H1696"\w* \w al|strong="H5921"\w* \w Rabsaces|strong="H7262"\w*: “\w Por|strong="H5921"\w* favor, \w hable|strong="H1696"\w* \w a|strong="H3068"\w* sus \w siervos|strong="H5650"\w* \w en|strong="H5921"\w* arameo, \w porque|strong="H3588"\w* \w nosotros|strong="H5921"\w* \w lo|strong="H5921"\w* entendemos. \w No|strong="H3588"\w* \w nos|strong="H5921"\w* \w hable|strong="H1696"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* lengua \w de|strong="H5921"\w* Judá frente \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w gente|strong="H5971"\w* \w que|strong="H3588"\w* \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* muralla”.   
\p
\v 12 Pero \w el|strong="H5921"\w* \w Rabsaces|strong="H7262"\w* respondió: “¿Acaso \w mi|strong="H5921"\w* señor \w me|strong="H5921"\w* \w envió|strong="H7971"\w* \w a|strong="H3068"\w* decir estas \w cosas|strong="H1697"\w* solo \w a|strong="H3068"\w* tu señor \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w ti|strong="H5921"\w*? ¿\w No|strong="H3808"\w* \w me|strong="H5921"\w* \w envió|strong="H7971"\w* también \w a|strong="H3068"\w* \w los|strong="H3427"\w* hombres \w que|strong="H3808"\w* \w están|strong="H3427"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* muralla, quienes \w junto|strong="H5921"\w* \w con|strong="H5973"\w* ustedes tendrán \w que|strong="H3808"\w* comerse sus propios excrementos \w y|strong="H5921"\w* beberse su propia orina?”.  
\v 13 Entonces el \w Rabsaces|strong="H7262"\w* se \w puso|strong="H5975"\w* \w en|strong="H5975"\w* \w pie|strong="H5975"\w* y \w gritó|strong="H7121"\w* con toda su fuerza \w en|strong="H5975"\w* la lengua \w de|strong="H1697"\w* Judá: “¡\w Escuchen|strong="H8085"\w* las \w palabras|strong="H1697"\w* del \w gran|strong="H1419"\w* \w rey|strong="H4428"\w*, el \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Asiria!  
\v 14 \w Así|strong="H3541"\w* dice \w el|strong="H3588"\w* \w rey|strong="H4428"\w*: “\w No|strong="H3808"\w* dejen \w que|strong="H3588"\w* Ezequías \w los|strong="H3588"\w* \w engañe|strong="H5377"\w*, \w porque|strong="H3588"\w* \w él|strong="H3588"\w* \w no|strong="H3808"\w* \w podrá|strong="H3201"\w* librarlos.  
\v 15 \w No|strong="H3808"\w* permitan \w que|strong="H3808"\w* Ezequías los convenza \w de|strong="H5414"\w* confiar en Yahvé, diciendo: \w Ciertamente|strong="H5414"\w* Yahvé nos \w librará|strong="H5337"\w*; \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w no|strong="H3808"\w* caerá en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria”.  
\v 16 \w No|strong="H6213"\w* le \w hagan|strong="H6213"\w* caso \w a|strong="H3068"\w* Ezequías, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria dice: “\w Hagan|strong="H6213"\w* las paces \w conmigo|strong="H6213"\w* \w y|strong="H3588"\w* ríndanse. \w Así|strong="H3541"\w* cada uno \w de|strong="H3588"\w* ustedes podrá comer \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia \w vid|strong="H1612"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia higuera, \w y|strong="H3588"\w* \w beber|strong="H8354"\w* \w el|strong="H3588"\w* \w agua|strong="H4325"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* propia cisterna;  
\v 17 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* yo venga \w y|strong="H5704"\w* los lleve \w a|strong="H3068"\w* una tierra \w como|strong="H5704"\w* la suya, tierra \w de|strong="H5704"\w* \w grano|strong="H1715"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* \w vino|strong="H8492"\w* nuevo, tierra \w de|strong="H5704"\w* \w pan|strong="H3899"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* viñedos.  
\v 18 \w Cuidado|strong="H3027"\w* con dejar \w que|strong="H6435"\w* Ezequías los engañe \w diciendo|strong="H5496"\w*: Yahvé nos \w librará|strong="H5337"\w*. ¿Acaso los dioses de las \w naciones|strong="H1471"\w* han \w librado|strong="H5337"\w* sus tierras de \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* de Asiria?  
\v 19 ¿Dónde están \w los|strong="H3588"\w* dioses \w de|strong="H3588"\w* Hamat \w y|strong="H3588"\w* \w de|strong="H3588"\w* Arpad? ¿Dónde están \w los|strong="H3588"\w* dioses \w de|strong="H3588"\w* Sefarvaim? ¿Acaso \w libraron|strong="H5337"\w* \w ellos|strong="H3027"\w* \w a|strong="H3068"\w* \w Samaria|strong="H8111"\w* \w de|strong="H3588"\w* mi \w poder|strong="H3027"\w*?  
\v 20 ¿\w Cuál|strong="H4310"\w* \w de|strong="H3588"\w* \w entre|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* dioses \w de|strong="H3588"\w* estas tierras ha podido salvar \w a|strong="H3068"\w* \w su|strong="H3588"\w* país \w de|strong="H3588"\w* \w mi|strong="H3389"\w* \w mano|strong="H3027"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* Yahvé pueda salvar \w a|strong="H3068"\w* Jerusalén \w de|strong="H3588"\w* \w mi|strong="H3389"\w* \w poder|strong="H3027"\w*?””.   
\p
\v 21 \w Pero|strong="H3588"\w* \w el|strong="H1931"\w* pueblo \w se|strong="H1931"\w* quedó callado \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w respondió|strong="H6030"\w* \w ni|strong="H3808"\w* una \w palabra|strong="H1697"\w*, \w porque|strong="H3588"\w* \w la|strong="H1931"\w* orden del \w rey|strong="H4428"\w* \w era|strong="H1931"\w*: “\w No|strong="H3808"\w* \w le|strong="H1931"\w* respondan \w nada|strong="H3808"\w*”.   
\p
\v 22 Entonces Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jilquías, administrador \w del|strong="H5921"\w* palacio, \w el|strong="H5921"\w* \w escriba|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w el|strong="H5921"\w* cronista Joa \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Asaf, regresaron ante Ezequías \w con|strong="H5921"\w* \w la|strong="H5921"\w* ropa rasgada \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* duelo \w y|strong="H5921"\w* \w le|strong="H5921"\w* informaron \w de|strong="H5921"\w* todo \w lo|strong="H1697"\w* \w que|strong="H5921"\w* había \w dicho|strong="H1697"\w* \w el|strong="H5921"\w* \w Rabsaces|strong="H7262"\w*.   
\c 37  
\p
\v 1 \w Cuando|strong="H1961"\w* el \w rey|strong="H4428"\w* Ezequías \w oyó|strong="H8085"\w* esto, \w se|strong="H1961"\w* \w rasgó|strong="H7167"\w* las vestiduras, \w se|strong="H1961"\w* vistió de cilicio y \w fue|strong="H1961"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* de Yahvé.  
\v 2 Luego \w envió|strong="H7971"\w* \w a|strong="H3068"\w* Eliaquim, administrador \w del|strong="H5921"\w* palacio, \w al|strong="H5921"\w* \w escriba|strong="H5608"\w* \w Sebna|strong="H7644"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w ancianos|strong="H2205"\w* \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w sacerdotes|strong="H3548"\w*, todos \w vestidos|strong="H3680"\w* \w de|strong="H5921"\w* cilicio, \w para|strong="H5921"\w* ver \w al|strong="H5921"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz.  
\v 3 Ellos le dijeron: “\w Así|strong="H3541"\w* dice Ezequías: “\w Hoy|strong="H3117"\w* \w es|strong="H2088"\w* un \w día|strong="H3117"\w* \w de|strong="H3588"\w* \w angustia|strong="H6869"\w*, \w de|strong="H3588"\w* castigo \w y|strong="H3588"\w* \w de|strong="H3588"\w* deshonra. Somos \w como|strong="H3588"\w* una mujer \w que|strong="H3588"\w* \w está|strong="H2088"\w* \w de|strong="H3588"\w* parto, \w pero|strong="H3588"\w* \w no|strong="H3588"\w* tiene \w fuerzas|strong="H3581"\w* \w para|strong="H5704"\w* dar \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hijo|strong="H1121"\w*.  
\v 4 \w Tal|strong="H1697"\w* vez Yahvé su \w Dios|strong="H3068"\w* \w escuche|strong="H8085"\w* las \w palabras|strong="H1697"\w* del oficial \w Rabsaces|strong="H7262"\w*, \w a|strong="H3068"\w* quien su \w señor|strong="H3068"\w*, el \w rey|strong="H4428"\w* \w de|strong="H1697"\w* Asiria, \w envió|strong="H7971"\w* para insultar \w al|strong="H4428"\w* \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*. ¡\w Que|strong="H1697"\w* Yahvé su \w Dios|strong="H3068"\w* \w lo|strong="H1697"\w* castigue \w por|strong="H1157"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* ha \w oído|strong="H8085"\w*! \w Por|strong="H1157"\w* tanto, eleve usted \w una|strong="H4672"\w* \w oración|strong="H8605"\w* \w por|strong="H1157"\w* el pequeño \w resto|strong="H7611"\w* \w de|strong="H1697"\w* pueblo \w que|strong="H1697"\w* aún queda””.   
\p
\v 5 \w Cuando|strong="H5650"\w* los servidores del \w rey|strong="H4428"\w* Ezequías llegaron ante \w Isaías|strong="H3470"\w*,   
\p
\v 6 él les respondió: “Digan \w a|strong="H3068"\w* su \w señor|strong="H3068"\w*: “\w Así|strong="H3541"\w* \w dice|strong="H1697"\w* Yahvé: \w No|strong="H6440"\w* tengas \w miedo|strong="H3372"\w* \w por|strong="H1697"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* has \w oído|strong="H8085"\w*, con las \w que|strong="H1697"\w* los sirvientes del \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Asiria \w me|strong="H3541"\w* han insultado.  
\v 7 Yo voy \w a|strong="H3068"\w* \w poner|strong="H5414"\w* un \w espíritu|strong="H7307"\w* en \w él|strong="H5307"\w*; \w oirá|strong="H8085"\w* un \w rumor|strong="H8052"\w*, regresará \w a|strong="H3068"\w* su país y allí \w haré|strong="H5414"\w* que muera \w a|strong="H3068"\w* \w espada|strong="H2719"\w*””.   
\p
\v 8 \w El|strong="H5921"\w* oficial \w Rabsaces|strong="H7262"\w* regresó \w y|strong="H3588"\w* encontró \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria atacando \w la|strong="H5921"\w* ciudad \w de|strong="H5921"\w* \w Libna|strong="H3841"\w*, \w pues|strong="H3588"\w* \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w se|strong="H5921"\w* \w había|strong="H4672"\w* ido \w de|strong="H5921"\w* Laquis.  
\v 9 Entonces \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria recibió noticias \w de|strong="H5921"\w* \w que|strong="H5921"\w* Tirhaca, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Etiopía|strong="H3568"\w*, venía \w para|strong="H5921"\w* pelear \w contra|strong="H5921"\w* \w él|strong="H5921"\w*. \w Al|strong="H5921"\w* oírlo, \w envió|strong="H7971"\w* \w de|strong="H5921"\w* nuevo \w mensajeros|strong="H4397"\w* \w a|strong="H3068"\w* Ezequías \w con|strong="H5921"\w* este mensaje:  
\v 10 “Digan \w a|strong="H3068"\w* Ezequías, \w rey|strong="H4428"\w* \w de|strong="H5414"\w* \w Judá|strong="H3063"\w*: “\w No|strong="H3808"\w* dejes \w que|strong="H3808"\w* tu Dios, en quien confías, te \w engañe|strong="H5377"\w* diciendo \w que|strong="H3808"\w* Jerusalén \w no|strong="H3808"\w* caerá en \w manos|strong="H3027"\w* del \w rey|strong="H4428"\w* \w de|strong="H5414"\w* Asiria.  
\v 11 \w Tú|strong="H6213"\w* bien sabes \w lo|strong="H6213"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de Asiria han \w hecho|strong="H6213"\w* en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* países: \w los|strong="H3605"\w* han destruido \w por|strong="H4428"\w* completo. ¿\w Y|strong="H3068"\w* crees \w que|strong="H3605"\w* \w tú|strong="H6213"\w* te vas \w a|strong="H3068"\w* salvar?  
\v 12 ¿Acaso \w los|strong="H1121"\w* dioses \w de|strong="H1121"\w* las \w naciones|strong="H1471"\w* \w que|strong="H1121"\w* mis antepasados \w destruyeron|strong="H7843"\w* pudieron salvar \w a|strong="H3068"\w* \w Gozán|strong="H1470"\w*, \w Harán|strong="H2771"\w*, Rezef y \w a|strong="H3068"\w* la \w gente|strong="H1471"\w* \w de|strong="H1121"\w* Edén \w que|strong="H1121"\w* vivía en Telasar?  
\v 13 ¿Dónde están el \w rey|strong="H4428"\w* de Hamat, el de Arpad, y los \w reyes|strong="H4428"\w* de Sefarvaim, de Hena y de Ivá?””.   
\p
\v 14 Ezequías \w recibió|strong="H3947"\w* la \w carta|strong="H5612"\w* \w de|strong="H6440"\w* \w manos|strong="H3027"\w* \w de|strong="H6440"\w* los \w mensajeros|strong="H4397"\w* y la \w leyó|strong="H7121"\w*. \w Luego|strong="H5927"\w* \w subió|strong="H5927"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H6440"\w* Yahvé, la \w extendió|strong="H6566"\w* \w delante|strong="H6440"\w* \w de|strong="H6440"\w* él  
\v 15 y \w oró|strong="H6419"\w* de esta manera:  
\v 16 “Yahvé de \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*, \w Dios|strong="H3068"\w* de \w Israel|strong="H3478"\w*, \w que|strong="H1931"\w* reinas sobre \w los|strong="H3427"\w* \w querubines|strong="H3742"\w*: \w solo|strong="H1931"\w* \w tú|strong="H6213"\w* \w eres|strong="H1931"\w* \w el|strong="H1931"\w* \w Dios|strong="H3068"\w* de \w todos|strong="H3605"\w* \w los|strong="H3427"\w* \w reinos|strong="H4467"\w* de \w la|strong="H1931"\w* tierra; \w tú|strong="H6213"\w* \w hiciste|strong="H6213"\w* \w el|strong="H1931"\w* \w cielo|strong="H8064"\w* y \w la|strong="H1931"\w* tierra.  
\v 17 Presta atención, Yahvé, y \w escucha|strong="H8085"\w*; \w abre|strong="H6491"\w* tus \w ojos|strong="H5869"\w*, Yahvé, y \w mira|strong="H7200"\w*. \w Escucha|strong="H8085"\w* \w todas|strong="H3605"\w* las \w palabras|strong="H1697"\w* \w que|strong="H1697"\w* Senaquerib ha \w enviado|strong="H7971"\w* para insultar al \w Dios|strong="H3068"\w* \w vivo|strong="H2416"\w*.  
\v 18 Es verdad, Yahvé, \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de Asiria han destruido \w todas|strong="H3605"\w* las naciones y sus tierras,  
\v 19 \w y|strong="H3588"\w* \w que|strong="H3588"\w* han echado \w sus|strong="H1992"\w* dioses al fuego. \w Pero|strong="H3588"\w* \w ellos|strong="H1992"\w* \w no|strong="H3808"\w* \w eran|strong="H3808"\w* dioses, \w sino|strong="H3588"\w* objetos \w de|strong="H3588"\w* \w madera|strong="H6086"\w* \w y|strong="H3588"\w* piedra \w hechos|strong="H4639"\w* \w por|strong="H3588"\w* \w manos|strong="H3027"\w* humanas; \w por|strong="H3588"\w* eso pudieron destruirlos.  
\v 20 \w Ahora|strong="H6258"\w*, Yahvé \w Dios|strong="H3068"\w* nuestro, \w sálvanos|strong="H3467"\w* \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w mano|strong="H3027"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reinos|strong="H4467"\w* \w de|strong="H3588"\w* \w la|strong="H3605"\w* tierra \w sepan|strong="H3045"\w* \w que|strong="H3588"\w* solo tú eres Yahvé”.   
\p
\v 21 Entonces \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amoz \w envió|strong="H7971"\w* este mensaje \w a|strong="H3068"\w* Ezequías: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*: “\w Ya|strong="H3068"\w* \w que|strong="H1121"\w* \w me|strong="H3541"\w* has rogado acerca \w de|strong="H1121"\w* Senaquerib, \w rey|strong="H4428"\w* \w de|strong="H1121"\w* Asiria,  
\v 22 \w esta|strong="H2088"\w* \w es|strong="H2088"\w* \w la|strong="H5921"\w* \w respuesta|strong="H1697"\w* \w que|strong="H5921"\w* Yahvé da \w contra|strong="H5921"\w* \w él|strong="H5921"\w*: \w La|strong="H5921"\w* \w virgen|strong="H1330"\w* \w hija|strong="H1323"\w* \w de|strong="H5921"\w* \w Sión|strong="H6726"\w* \w te|strong="H5921"\w* desprecia \w y|strong="H5921"\w* \w se|strong="H5921"\w* burla \w de|strong="H5921"\w* \w ti|strong="H5921"\w*; \w la|strong="H5921"\w* \w hija|strong="H1323"\w* \w de|strong="H5921"\w* Jerusalén menea \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* mientras \w te|strong="H5921"\w* vas.  
\v 23 ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* has insultado \w y|strong="H5921"\w* ofendido? ¿\w Contra|strong="H5921"\w* \w quién|strong="H4310"\w* has levantado \w la|strong="H5921"\w* \w voz|strong="H6963"\w* \w y|strong="H5921"\w* mirado \w con|strong="H5921"\w* arrogancia? ¡\w Contra|strong="H5921"\w* \w el|strong="H5921"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*!  
\v 24 \w Por|strong="H3027"\w* \w medio|strong="H3027"\w* de tus \w siervos|strong="H5650"\w* has insultado al Señor. Dijiste: ‘Con mis \w muchos|strong="H7230"\w* \w carros|strong="H7393"\w* de guerra he \w subido|strong="H5927"\w* \w a|strong="H3068"\w* las cumbres de los \w montes|strong="H2022"\w*, \w a|strong="H3068"\w* lo más profundo del \w Líbano|strong="H3844"\w*. Corté sus cedros más altos y sus pinos más bellos; llegué \w a|strong="H3068"\w* su cumbre más lejana, \w a|strong="H3068"\w* su \w bosque|strong="H3293"\w* más tupido.  
\v 25 \w Cavé|strong="H6979"\w* pozos y \w bebí|strong="H8354"\w* \w agua|strong="H4325"\w* en tierras extrañas; ¡con \w la|strong="H3605"\w* planta \w de|strong="H4325"\w* mis \w pies|strong="H6471"\w* sequé \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w ríos|strong="H2975"\w* \w de|strong="H4325"\w* Egipto!’”.   
\p
\v 26 “¿Acaso \w no|strong="H3808"\w* has \w oído|strong="H8085"\w* \w que|strong="H3808"\w* \w yo|strong="H6213"\w* \w lo|strong="H3808"\w* planeé \w hace|strong="H6213"\w* mucho \w tiempo|strong="H3117"\w*? Desde \w tiempos|strong="H3117"\w* \w antiguos|strong="H6924"\w* \w lo|strong="H3808"\w* \w había|strong="H1961"\w* preparado, y \w ahora|strong="H6258"\w* \w lo|strong="H3808"\w* he llevado \w a|strong="H3068"\w* cabo: \w que|strong="H3808"\w* \w tú|strong="H6213"\w* conviertas \w ciudades|strong="H5892"\w* \w fortificadas|strong="H1219"\w* en montones de ruinas.  
\v 27 Sus \w habitantes|strong="H3427"\w*, sin fuerzas, \w quedaron|strong="H1961"\w* aterrados y confundidos; \w fueron|strong="H1961"\w* \w como|strong="H1961"\w* la \w hierba|strong="H6212"\w* del \w campo|strong="H7704"\w*, \w como|strong="H1961"\w* \w el|strong="H3427"\w* pasto \w verde|strong="H3419"\w* \w o|strong="H3068"\w* \w como|strong="H1961"\w* la \w hierba|strong="H6212"\w* \w que|strong="H1961"\w* crece en \w los|strong="H3427"\w* techos y \w se|strong="H1961"\w* seca \w antes|strong="H6440"\w* \w de|strong="H6440"\w* madurar.  
\v 28 Yo \w sé|strong="H3045"\w* bien cuándo te sientas, cuándo \w sales|strong="H3318"\w* y cuándo entras, y cómo te enfureces contra mí.  
\v 29 \w Porque|strong="H3282"\w* tu furia y tu arrogancia han llegado \w a|strong="H3068"\w* mis oídos, \w pondré|strong="H7760"\w* mi garfio en tu nariz y mi freno en tus \w labios|strong="H8193"\w*, y te \w haré|strong="H7760"\w* \w volver|strong="H7725"\w* \w por|strong="H3282"\w* el mismo \w camino|strong="H1870"\w* \w por|strong="H3282"\w* donde viniste.   
\p
\v 30 “\w Y|strong="H3068"\w* \w esta|strong="H2088"\w* será la señal para ti, Ezequías: \w Este|strong="H2088"\w* \w año|strong="H8141"\w* comerán \w lo|strong="H2088"\w* \w que|strong="H2088"\w* crezca \w por|strong="H2088"\w* sí solo, y el \w año|strong="H8141"\w* \w que|strong="H2088"\w* viene \w lo|strong="H2088"\w* \w que|strong="H2088"\w* brote de ello; pero al tercer \w año|strong="H8141"\w* sembrarán y cosecharán, \w plantarán|strong="H5193"\w* viñedos y comerán su \w fruto|strong="H6529"\w*.  
\v 31 Los sobrevivientes de la \w casa|strong="H1004"\w* de \w Judá|strong="H3063"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* echar \w raíces|strong="H8328"\w* y \w a|strong="H3068"\w* dar \w fruto|strong="H6529"\w*.  
\v 32 \w Porque|strong="H3588"\w* \w de|strong="H3588"\w* Jerusalén \w saldrá|strong="H3318"\w* un \w resto|strong="H7611"\w* \w de|strong="H3588"\w* pueblo, \w y|strong="H3588"\w* del \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w* \w saldrán|strong="H3318"\w* \w los|strong="H3588"\w* sobrevivientes. \w El|strong="H3588"\w* \w celo|strong="H7068"\w* \w de|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* \w lo|strong="H6213"\w* llevará \w a|strong="H3068"\w* cabo.   
\p
\v 33 “\w Por|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice Yahvé \w acerca|strong="H5921"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria: “\w Él|strong="H5921"\w* \w no|strong="H3808"\w* entrará \w en|strong="H5921"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w ni|strong="H3808"\w* disparará una sola flecha \w contra|strong="H5921"\w* \w ella|strong="H8033"\w*; \w no|strong="H3808"\w* \w se|strong="H5921"\w* acercará \w con|strong="H5921"\w* \w escudos|strong="H4043"\w* \w ni|strong="H3808"\w* levantará rampas \w de|strong="H5921"\w* asalto.  
\v 34 \w Por|strong="H1870"\w* el mismo \w camino|strong="H1870"\w* \w que|strong="H3808"\w* \w vino|strong="H1870"\w*, \w se|strong="H3808"\w* \w volverá|strong="H7725"\w*; \w no|strong="H3808"\w* entrará en \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*. Yo, Yahvé, \w lo|strong="H3808"\w* afirmo.  
\v 35 Yo protegeré \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w* \w para|strong="H4616"\w* salvarla, \w por|strong="H5921"\w* amor \w a|strong="H3068"\w* \w mí|strong="H5921"\w* mismo \w y|strong="H5921"\w* \w por|strong="H5921"\w* amor \w a|strong="H3068"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w David|strong="H1732"\w*””.   
\p
\v 36 Entonces \w el|strong="H3605"\w* \w ángel|strong="H4397"\w* \w de|strong="H2568"\w* Yahvé \w salió|strong="H3318"\w* y \w mató|strong="H5221"\w* \w a|strong="H3068"\w* \w ciento|strong="H3967"\w* \w ochenta|strong="H8084"\w* y \w cinco|strong="H2568"\w* \w mil|strong="H3967"\w* hombres \w en|strong="H3318"\w* \w el|strong="H3605"\w* \w campamento|strong="H4264"\w* asirio. Al despertar por \w la|strong="H3605"\w* \w mañana|strong="H1242"\w*, ¡\w todo|strong="H3605"\w* \w estaba|strong="H2009"\w* lleno \w de|strong="H2568"\w* cadáveres!  
\v 37 Así que Senaquerib, \w rey|strong="H4428"\w* de Asiria, levantó \w el|strong="H3427"\w* campamento y regresó \w a|strong="H3068"\w* \w Nínive|strong="H5210"\w*, donde se \w quedó|strong="H3427"\w*.  
\v 38 Tiempo \w después|strong="H1961"\w*, mientras \w él|strong="H1931"\w* \w adoraba|strong="H7812"\w* \w en|strong="H8478"\w* \w el|strong="H1931"\w* \w templo|strong="H1004"\w* \w de|strong="H8478"\w* \w su|strong="H1931"\w* dios Nisroc, \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* Adramelec y Sarezer \w lo|strong="H1931"\w* \w mataron|strong="H5221"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w* y huyeron \w a|strong="H3068"\w* \w la|strong="H1931"\w* tierra \w de|strong="H8478"\w* Ararat. \w En|strong="H8478"\w* \w su|strong="H1931"\w* \w lugar|strong="H8478"\w* \w reinó|strong="H4427"\w* \w su|strong="H1931"\w* \w hijo|strong="H1121"\w* Esar-hadón.   
\c 38  
\p
\v 1 \w Por|strong="H3588"\w* aquel \w tiempo|strong="H3117"\w* Ezequías \w enfermó|strong="H2470"\w* \w de|strong="H3588"\w* \w muerte|strong="H4191"\w*. \w El|strong="H3588"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Amoz \w fue|strong="H3808"\w* \w a|strong="H3068"\w* verlo \w y|strong="H3588"\w* le dijo: “\w Así|strong="H3541"\w* dice Yahvé: “Pon tus asuntos \w en|strong="H3588"\w* \w orden|strong="H6680"\w*, \w porque|strong="H3588"\w* vas \w a|strong="H3068"\w* \w morir|strong="H4191"\w*; \w no|strong="H3808"\w* \w te|strong="H3588"\w* recuperarás””.   
\p
\v 2 Entonces Ezequías volvió el \w rostro|strong="H6440"\w* \w hacia|strong="H6440"\w* la \w pared|strong="H7023"\w* y \w oró|strong="H6419"\w* \w a|strong="H3068"\w* Yahvé:  
\v 3 “\w Te|strong="H5869"\w* \w ruego|strong="H4994"\w*, Yahvé, \w que|strong="H4994"\w* \w te|strong="H5869"\w* acuerdes \w de|strong="H6440"\w* \w que|strong="H4994"\w* he caminado \w delante|strong="H6440"\w* \w de|strong="H6440"\w* ti con fidelidad y \w de|strong="H6440"\w* todo \w corazón|strong="H3820"\w*, y \w que|strong="H4994"\w* he \w hecho|strong="H6213"\w* \w lo|strong="H6213"\w* \w que|strong="H4994"\w* \w te|strong="H5869"\w* \w agrada|strong="H2896"\w*”. \w Y|strong="H3068"\w* Ezequías \w lloró|strong="H1058"\w* \w amargamente|strong="H1058"\w*.   
\p
\v 4 Entonces la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w Isaías|strong="H3470"\w*:  
\v 5 “\w Ve|strong="H1980"\w* \w y|strong="H5921"\w* dile \w a|strong="H3068"\w* Ezequías: “\w Así|strong="H3541"\w* dice Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* tu antepasado \w David|strong="H1732"\w*: He escuchado tu \w oración|strong="H8605"\w* \w y|strong="H5921"\w* he \w visto|strong="H7200"\w* tus \w lágrimas|strong="H1832"\w*; \w voy|strong="H1980"\w* \w a|strong="H3068"\w* darte \w quince|strong="H2568"\w* \w años|strong="H8141"\w* \w más|strong="H3254"\w* \w de|strong="H5921"\w* \w vida|strong="H3117"\w*.  
\v 6 \w Te|strong="H5921"\w* \w libraré|strong="H5337"\w* \w de|strong="H5921"\w* \w manos|strong="H3709"\w* \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria, \w a|strong="H3068"\w* \w ti|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w esta|strong="H2063"\w* \w ciudad|strong="H5892"\w*, \w y|strong="H5921"\w* \w la|strong="H5921"\w* protegeré.  
\v 7 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* la señal \w de|strong="H1697"\w* Yahvé para confirmar \w que|strong="H1697"\w* \w cumplirá|strong="H6213"\w* \w lo|strong="H1697"\w* \w que|strong="H1697"\w* ha prometido:  
\v 8 Haré que en el reloj de \w sol|strong="H8121"\w* de Acaz la \w sombra|strong="H6738"\w* retroceda los \w diez|strong="H6235"\w* pasos que ya ha bajado””. \w Y|strong="H3068"\w* la luz del \w sol|strong="H8121"\w* retrocedió los \w diez|strong="H6235"\w* pasos que ya había avanzado.   
\p
\v 9 Poema de Ezequías, \w rey|strong="H4428"\w* de \w Judá|strong="H3063"\w*, después de haber enfermado y de haberse recuperado:   
\q1
\v 10 Yo dije: “\w En|strong="H3212"\w* lo mejor de mi \w vida|strong="H3117"\w* me voy \w a|strong="H3068"\w* las \w puertas|strong="H8179"\w* del Seol\f + \fr 38:10 \ft El Seol es el lugar de los muertos.\f*;  
\q2 se me quita el \w resto|strong="H3499"\w* de mis \w años|strong="H8141"\w*”.   
\q1
\v 11 Dije: “\w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w veré|strong="H7200"\w* \w más|strong="H5750"\w* \w a|strong="H3068"\w* \w Yah|strong="H3068"\w*,  
\q2 \w a|strong="H3068"\w* \w Yah|strong="H3068"\w* \w en|strong="H5973"\w* la tierra \w de|strong="H5973"\w* \w los|strong="H3427"\w* \w vivientes|strong="H2416"\w*;  
\q2 ya \w no|strong="H3808"\w* \w veré|strong="H7200"\w* \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w entre|strong="H5973"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5973"\w* este mundo.   
\q1
\v 12 \w Me|strong="H4480"\w* han quitado mi hogar,  
\q2 \w me|strong="H4480"\w* \w lo|strong="H5704"\w* han arrebatado \w como|strong="H5704"\w* tienda \w de|strong="H4480"\w* pastor.  
\q1 \w Como|strong="H5704"\w* un tejedor, he enrollado mi \w vida|strong="H2416"\w*;  
\q2 Dios \w me|strong="H4480"\w* corta el hilo \w del|strong="H4480"\w* telar.  
\q2 ¡\w De|strong="H4480"\w* la mañana \w a|strong="H3068"\w* la \w noche|strong="H3915"\w* acabas conmigo!   
\q1
\v 13 Esperé \w con|strong="H5704"\w* paciencia \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* amanecer,  
\q2 pero \w como|strong="H5704"\w* un león, \w él|strong="H3605"\w* rompió \w todos|strong="H3605"\w* mis \w huesos|strong="H6106"\w*.  
\q2 ¡\w De|strong="H5704"\w* \w la|strong="H3605"\w* \w mañana|strong="H1242"\w* \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w noche|strong="H3915"\w* acabas conmigo!   
\q1
\v 14 Chillaba yo \w como|strong="H3651"\w* una golondrina \w o|strong="H3068"\w* una grulla;  
\q2 gemía \w como|strong="H3651"\w* una \w paloma|strong="H3123"\w*.  
\q2 Mis \w ojos|strong="H5869"\w* \w se|strong="H3651"\w* cansaron \w de|strong="H5869"\w* mirar al cielo:  
\q2 “¡Señor, estoy angustiado! ¡Ven en mi ayuda!”.   
\q1
\v 15 ¿Pero \w qué|strong="H4100"\w* puedo decir?  
\q2 \w Él|strong="H1931"\w* \w mismo|strong="H1931"\w* \w me|strong="H5921"\w* \w habló|strong="H1696"\w* \w y|strong="H5921"\w* \w él|strong="H1931"\w* \w mismo|strong="H1931"\w* \w lo|strong="H1931"\w* ha \w hecho|strong="H6213"\w*.  
\q2 Caminaré \w con|strong="H5921"\w* humildad \w toda|strong="H3605"\w* \w mi|strong="H5921"\w* \w vida|strong="H5315"\w* \w a|strong="H3068"\w* causa \w de|strong="H5921"\w* \w mi|strong="H5921"\w* \w amargura|strong="H4751"\w*.   
\q1
\v 16 Señor, \w por|strong="H5921"\w* tus palabras \w viven|strong="H2416"\w* \w los|strong="H5921"\w* hombres,  
\q2 \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w ellas|strong="H5921"\w* \w vive|strong="H2416"\w* también \w mi|strong="H5921"\w* \w espíritu|strong="H7307"\w*.  
\q2 ¡Tú \w me|strong="H5921"\w* devolviste \w la|strong="H5921"\w* salud \w y|strong="H5921"\w* \w me|strong="H5921"\w* diste \w vida|strong="H2416"\w*!   
\q1
\v 17 \w Es|strong="H3588"\w* verdad \w que|strong="H3588"\w* pasé \w por|strong="H3588"\w* una gran \w amargura|strong="H4843"\w*,  
\q2 \w pero|strong="H3588"\w* tú, \w por|strong="H3588"\w* amor, \w me|strong="H3588"\w* libraste del hoyo \w de|strong="H3588"\w* \w la|strong="H3588"\w* muerte;  
\q2 ¡\w echaste|strong="H7993"\w* \w todos|strong="H3605"\w* mis \w pecados|strong="H2399"\w* tras tus \w espaldas|strong="H1460"\w*!   
\q1
\v 18 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* Seol \w no|strong="H3808"\w* puede alabarte,  
\q2 \w ni|strong="H3808"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w* puede darte gloria;  
\q1 \w los|strong="H3588"\w* \w que|strong="H3588"\w* bajan al \w sepulcro|strong="H7585"\w* ya \w no|strong="H3808"\w* \w esperan|strong="H7663"\w* tu fidelidad.   
\q1
\v 19 \w Los|strong="H1121"\w* \w que|strong="H1931"\w* \w viven|strong="H2416"\w* son \w los|strong="H1121"\w* \w que|strong="H1931"\w* te alaban, \w como|strong="H3644"\w* \w lo|strong="H1931"\w* hago yo \w hoy|strong="H3117"\w*;  
\q2 \w cada|strong="H3117"\w* padre les hablará \w a|strong="H3068"\w* \w sus|strong="H1931"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* tu verdad.   
\q1
\v 20 ¡Yahvé \w me|strong="H5921"\w* \w salvará|strong="H3467"\w*!  
\q2 \w Por|strong="H5921"\w* eso cantaremos \w con|strong="H5921"\w* instrumentos \w de|strong="H5921"\w* cuerda \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* nuestra \w vida|strong="H2416"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé”.   
\p
\v 21 \w Isaías|strong="H3470"\w* había dicho: “Preparen un emplasto \w de|strong="H5921"\w* \w higos|strong="H8384"\w* \w y|strong="H5921"\w* pónganlo \w en|strong="H5921"\w* \w la|strong="H5921"\w* llaga \w para|strong="H5921"\w* \w que|strong="H5921"\w* sane”.  
\v 22 \w Y|strong="H3068"\w* Ezequías \w había|strong="H3588"\w* preguntado: “¿\w Qué|strong="H3588"\w* señal tendré \w de|strong="H3588"\w* \w que|strong="H3588"\w* podré volver \w a|strong="H3068"\w* \w subir|strong="H5927"\w* \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* Yahvé?”.   
\c 39  
\p
\v 1 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, Merodac-baladán \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Baladán, \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Babilonia, \w le|strong="H1931"\w* \w envió|strong="H7971"\w* \w cartas|strong="H5612"\w* \w y|strong="H3588"\w* un regalo \w a|strong="H3068"\w* Ezequías, \w pues|strong="H3588"\w* \w supo|strong="H8085"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* estado \w enfermo|strong="H2470"\w* \w y|strong="H3588"\w* \w que|strong="H3588"\w* ya \w se|strong="H1931"\w* \w había|strong="H3588"\w* recuperado.  
\v 2 Ezequías recibió \w con|strong="H5921"\w* alegría \w a|strong="H3068"\w* \w los|strong="H5921"\w* mensajeros \w y|strong="H5921"\w* \w les|strong="H5921"\w* \w mostró|strong="H7200"\w* \w todos|strong="H3605"\w* sus tesoros: \w la|strong="H5921"\w* \w plata|strong="H3701"\w*, \w el|strong="H5921"\w* \w oro|strong="H2091"\w*, \w las|strong="H5921"\w* \w especias|strong="H1314"\w*, \w los|strong="H5921"\w* aceites finos, \w todo|strong="H3605"\w* su arsenal \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* guardaba \w en|strong="H5921"\w* sus depósitos. \w No|strong="H3808"\w* \w hubo|strong="H1961"\w* \w nada|strong="H3808"\w* \w en|strong="H5921"\w* su palacio \w ni|strong="H3808"\w* \w en|strong="H5921"\w* \w todo|strong="H3605"\w* su \w reino|strong="H1961"\w* \w que|strong="H3808"\w* Ezequías \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w mostrara|strong="H7200"\w*.  
\v 3 Entonces \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w Isaías|strong="H3470"\w* fue \w a|strong="H3068"\w* ver \w al|strong="H4428"\w* \w rey|strong="H4428"\w* Ezequías y le preguntó: “¿\w Qué|strong="H4100"\w* dijo esa gente y de dónde vinieron?”.  
\p Ezequías respondió: “Vinieron de un país muy lejano, de Babilonia”.   
\p
\v 4 Isaías volvió \w a|strong="H3068"\w* preguntar: “¿\w Y|strong="H3068"\w* \w qué|strong="H4100"\w* \w vieron|strong="H7200"\w* en tu palacio?”.  
\p Ezequías contestó: “\w Vieron|strong="H7200"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H4100"\w* \w hay|strong="H1961"\w* en \w mi|strong="H1961"\w* \w casa|strong="H1004"\w*; \w no|strong="H3808"\w* \w hay|strong="H1961"\w* \w nada|strong="H3808"\w* en mis tesoros \w que|strong="H4100"\w* \w no|strong="H3808"\w* les \w haya|strong="H1961"\w* mostrado”.   
\p
\v 5 Entonces \w Isaías|strong="H3470"\w* le dijo \w a|strong="H3068"\w* Ezequías: “\w Escucha|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* los \w Ejércitos|strong="H6635"\w*:  
\v 6 “Vienen \w días|strong="H3117"\w* \w en|strong="H5704"\w* \w que|strong="H3808"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* hay \w en|strong="H5704"\w* tu palacio, \w y|strong="H5704"\w* \w todo|strong="H3605"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* tus antepasados han acumulado \w hasta|strong="H5704"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* \w de|strong="H5704"\w* \w hoy|strong="H3117"\w*, \w será|strong="H3808"\w* \w llevado|strong="H5375"\w* \w a|strong="H3068"\w* Babilonia. \w No|strong="H3808"\w* \w quedará|strong="H3498"\w* \w nada|strong="H3808"\w*”, \w dice|strong="H1697"\w* Yahvé.  
\v 7 “Aun \w a|strong="H3068"\w* algunos \w de|strong="H4480"\w* tus propios \w hijos|strong="H1121"\w* y descendientes \w se|strong="H1961"\w* \w los|strong="H1121"\w* llevarán \w para|strong="H4480"\w* \w que|strong="H4480"\w* sirvan \w como|strong="H1961"\w* \w eunucos|strong="H5631"\w* \w en|strong="H4480"\w* \w el|strong="H1121"\w* palacio \w del|strong="H4480"\w* \w rey|strong="H4428"\w* \w de|strong="H4480"\w* Babilonia””.   
\p
\v 8 Ezequías le respondió \w a|strong="H3068"\w* \w Isaías|strong="H3470"\w*: “\w La|strong="H3588"\w* \w palabra|strong="H1697"\w* \w de|strong="H3588"\w* Yahvé \w que|strong="H3588"\w* \w me|strong="H3588"\w* has dado \w es|strong="H1961"\w* \w buena|strong="H2896"\w*”. \w Pues|strong="H3588"\w* pensaba: “Al \w menos|strong="H3588"\w* \w habrá|strong="H1961"\w* \w paz|strong="H7965"\w* \w y|strong="H3588"\w* seguridad \w mientras|strong="H3588"\w* \w yo|strong="H3588"\w* viva”.   
\c 40  
\p
\v 1 “Consuelen, consuelen \w a|strong="H3068"\w* mi \w pueblo|strong="H5971"\w*”, dice su Dios.  
\v 2 “\w Hablen|strong="H1696"\w* \w al|strong="H5921"\w* \w corazón|strong="H3820"\w* \w de|strong="H5921"\w* Jerusalén \w y|strong="H3588"\w* anúncienle \w que|strong="H3588"\w* \w su|strong="H3588"\w* tiempo \w de|strong="H5921"\w* angustia ha terminado, \w que|strong="H3588"\w* \w su|strong="H3588"\w* \w pecado|strong="H2403"\w* ha sido perdonado, \w y|strong="H3588"\w* \w que|strong="H3588"\w* ya ha recibido \w de|strong="H5921"\w* \w manos|strong="H3027"\w* \w de|strong="H5921"\w* Yahvé \w el|strong="H5921"\w* \w doble|strong="H3718"\w* \w por|strong="H5921"\w* \w todos|strong="H3605"\w* sus \w pecados|strong="H2403"\w*”.   
\q1
\v 3 Una \w voz|strong="H6963"\w* \w clama|strong="H7121"\w*:  
\q2 “¡Preparen en el \w desierto|strong="H4057"\w* el \w camino|strong="H1870"\w* para Yahvé!  
\q2 ¡Hagan una \w calzada|strong="H4546"\w* recta en la estepa para nuestro \w Dios|strong="H3068"\w*!   
\q1
\v 4 \w Todo|strong="H3605"\w* \w valle|strong="H1516"\w* \w será|strong="H1961"\w* rellenado,  
\q2 y \w todo|strong="H3605"\w* \w monte|strong="H2022"\w* y colina \w será|strong="H1961"\w* nivelado.  
\q2 \w El|strong="H3605"\w* terreno escabroso \w se|strong="H1961"\w* volverá plano,  
\q2 y las laderas \w se|strong="H1961"\w* harán llanura.   
\q1
\v 5 \w Entonces|strong="H3588"\w* se revelará \w la|strong="H3605"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* Yahvé,  
\q2 \w y|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* humanidad \w la|strong="H3605"\w* \w verá|strong="H7200"\w* junta;  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3605"\w* \w boca|strong="H6310"\w* \w de|strong="H3588"\w* Yahvé \w lo|strong="H3605"\w* ha \w dicho|strong="H6310"\w*”.   
\b  
\q1
\v 6 Una \w voz|strong="H6963"\w* dice: “¡Proclama!”.  
\q2 \w Y|strong="H3068"\w* yo pregunté: “¿\w Qué|strong="H4100"\w* debo proclamar?”.  
\q1 “\w Que|strong="H4100"\w* \w todo|strong="H3605"\w* hombre es \w como|strong="H4100"\w* \w la|strong="H3605"\w* \w hierba|strong="H2682"\w*,  
\q2 y \w toda|strong="H3605"\w* su \w gloria|strong="H3605"\w* \w como|strong="H4100"\w* \w la|strong="H3605"\w* flor del \w campo|strong="H7704"\w*.   
\q1
\v 7 \w La|strong="H3588"\w* \w hierba|strong="H2682"\w* \w se|strong="H5971"\w* \w seca|strong="H3001"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* flor \w se|strong="H5971"\w* marchita  
\q2 \w cuando|strong="H3588"\w* \w el|strong="H3588"\w* aliento \w de|strong="H3588"\w* Yahvé sopla sobre ellas.  
\q2 \w Ciertamente|strong="H3588"\w*, \w la|strong="H3588"\w* \w gente|strong="H5971"\w* \w es|strong="H3588"\w* \w como|strong="H3588"\w* \w la|strong="H3588"\w* \w hierba|strong="H2682"\w*.   
\q1
\v 8 La \w hierba|strong="H2682"\w* se \w seca|strong="H3001"\w* y la flor se marchita,  
\q2 pero la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* nuestro Dios \w permanece|strong="H6965"\w* para \w siempre|strong="H5769"\w*”.   
\b  
\q1
\v 9 Tú \w que|strong="H5921"\w* traes buenas noticias \w a|strong="H3068"\w* \w Sión|strong="H6726"\w*, \w sube|strong="H5927"\w* \w a|strong="H3068"\w* una montaña \w alta|strong="H7311"\w*.  
\q2 Tú \w que|strong="H5921"\w* traes buenas noticias \w a|strong="H3068"\w* Jerusalén, \w levanta|strong="H7311"\w* \w con|strong="H5921"\w* \w fuerza|strong="H3581"\w* \w la|strong="H5921"\w* \w voz|strong="H6963"\w*.  
\q2 ¡Levántala, \w no|strong="H5921"\w* tengas \w miedo|strong="H3372"\w*!  
\q2 Di \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w ciudades|strong="H5892"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*: “¡\w Aquí|strong="H2009"\w* \w está|strong="H5921"\w* su Dios!”.   
\q1
\v 10 Miren, el Señor Yahvé viene con poder,  
\q2 y su \w brazo|strong="H2220"\w* gobierna \w por|strong="H6440"\w* él.  
\q2 Miren, trae con él su \w recompensa|strong="H6468"\w*,  
\q2 y su \w paga|strong="H7939"\w* lo precede.   
\q1
\v 11 Como un \w pastor|strong="H7462"\w*, cuidará su rebaño:  
\q2 en sus \w brazos|strong="H2220"\w* recogerá \w a|strong="H3068"\w* los corderos  
\q2 y los \w llevará|strong="H5375"\w* \w junto|strong="H6908"\w* \w a|strong="H3068"\w* su pecho;  
\q2 guiará con ternura \w a|strong="H3068"\w* las ovejas que acaban de tener cría.   
\b  
\q1
\v 12 ¿\w Quién|strong="H4310"\w* \w midió|strong="H4058"\w* las \w aguas|strong="H4325"\w* en \w el|strong="H4310"\w* cuenco \w de|strong="H4325"\w* su mano,  
\q2 \w o|strong="H3068"\w* los \w cielos|strong="H8064"\w* con la palma \w de|strong="H4325"\w* su mano?  
\q2 ¿\w Quién|strong="H4310"\w* recogió en una medida \w el|strong="H4310"\w* \w polvo|strong="H6083"\w* \w de|strong="H4325"\w* la \w tierra|strong="H6083"\w*,  
\q2 \w o|strong="H3068"\w* \w pesó|strong="H6425"\w* las montañas y las colinas en la balanza?   
\q1
\v 13 ¿\w Quién|strong="H4310"\w* puede guiar al \w Espíritu|strong="H7307"\w* de Yahvé,  
\q2 \w o|strong="H3068"\w* \w quién|strong="H4310"\w* ha sido su consejero y maestro?   
\q1
\v 14 ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* consultó Dios para iluminarse?  
\q2 ¿\w Quién|strong="H4310"\w* \w le|strong="H4310"\w* \w enseñó|strong="H3925"\w* \w el|strong="H4310"\w* \w camino|strong="H1870"\w* de la \w justicia|strong="H4941"\w*?  
\q2 ¿\w Quién|strong="H4310"\w* \w le|strong="H4310"\w* dio \w conocimiento|strong="H1847"\w*  
\q2 \w o|strong="H3068"\w* \w le|strong="H4310"\w* mostró la senda de la \w inteligencia|strong="H8394"\w*?   
\q1
\v 15 Para él, las \w naciones|strong="H1471"\w* son como una gota de agua en un balde;  
\q2 son como polvillo en una balanza.  
\q2 Él levanta las islas como \w si|strong="H2005"\w* fueran polvo fino.   
\q1
\v 16 El \w Líbano|strong="H3844"\w* no basta para el fuego de su altar,  
\q2 ni sus \w animales|strong="H2416"\w* para un sacrificio que le sea digno.   
\q1
\v 17 \w Todas|strong="H3605"\w* las \w naciones|strong="H1471"\w* no son \w nada|strong="H3605"\w* ante \w él|strong="H3605"\w*;  
\q2 para \w él|strong="H3605"\w* valen menos \w que|strong="H3605"\w* \w nada|strong="H3605"\w*, son pura \w vanidad|strong="H8414"\w*.   
\b  
\q1
\v 18 ¿Con \w quién|strong="H4310"\w* compararán \w a|strong="H3068"\w* Dios?  
\q2 ¿\w Qué|strong="H4100"\w* \w imagen|strong="H1823"\w* usarán para representarlo?   
\q1
\v 19 Un escultor funde una estatua,  
\q2 un platero la recubre de \w oro|strong="H2091"\w*  
\q2 y le prepara \w cadenas|strong="H7577"\w* de \w plata|strong="H3701"\w*.   
\q1
\v 20 El \w que|strong="H3808"\w* es demasiado pobre para tal \w ofrenda|strong="H8641"\w*, \w busca|strong="H1245"\w* \w madera|strong="H6086"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* pudra  
\q2 y \w busca|strong="H1245"\w* \w a|strong="H3068"\w* un artesano experto para \w que|strong="H3808"\w* le talle un ídolo \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* caiga.   
\b  
\q1
\v 21 ¿Acaso \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sabían|strong="H3045"\w*? ¿\w No|strong="H3808"\w* \w lo|strong="H3808"\w* habían \w oído|strong="H8085"\w*?  
\q2 ¿\w No|strong="H3808"\w* \w se|strong="H3045"\w* les \w dijo|strong="H5046"\w* desde el principio?  
\q2 ¿\w No|strong="H3808"\w* han \w entendido|strong="H3045"\w* cómo \w se|strong="H3045"\w* fundó la tierra?   
\q1
\v 22 Dios \w se|strong="H5921"\w* sienta \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* círculo \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra,  
\q2 \w y|strong="H5921"\w* sus \w habitantes|strong="H3427"\w* parecen saltamontes.  
\q2 \w Él|strong="H5921"\w* despliega \w los|strong="H3427"\w* \w cielos|strong="H8064"\w* \w como|strong="H5921"\w* un velo  
\q2 \w y|strong="H5921"\w* \w los|strong="H3427"\w* \w extiende|strong="H5186"\w* \w como|strong="H5921"\w* una tienda \w para|strong="H5921"\w* vivir.   
\q1
\v 23 \w Él|strong="H6213"\w* reduce \w a|strong="H3068"\w* nada \w a|strong="H3068"\w* los poderosos  
\q2 y \w hace|strong="H6213"\w* desaparecer \w a|strong="H3068"\w* los gobernantes \w de|strong="H5414"\w* este mundo.   
\q1
\v 24 Apenas son \w plantados|strong="H5193"\w* \w o|strong="H3068"\w* sembrados,  
\q2 apenas echan raíces en \w la|strong="H1571"\w* tierra,  
\q2 Dios sopla sobre \w ellos|strong="H1571"\w* \w y|strong="H1571"\w* se marchitan;  
\q2 ¡\w el|strong="H1571"\w* torbellino se los \w lleva|strong="H5375"\w* \w como|strong="H1571"\w* \w si|strong="H1571"\w* fueran paja!   
\b  
\q1
\v 25 “¿Con \w quién|strong="H4310"\w* \w me|strong="H4310"\w* van \w a|strong="H3068"\w* comparar?  
\q2 ¿\w Quién|strong="H4310"\w* es igual \w a|strong="H3068"\w* mí?”, dice \w el|strong="H4310"\w* \w Santo|strong="H6918"\w*.   
\q1
\v 26 Levanten \w los|strong="H3605"\w* \w ojos|strong="H5869"\w* al cielo:  
\q2 ¿\w Quién|strong="H4310"\w* creó \w todo|strong="H3605"\w* eso?  
\q2 \w El|strong="H3605"\w* \w que|strong="H4310"\w* hace \w salir|strong="H3318"\w* \w a|strong="H3068"\w* las estrellas una \w por|strong="H3581"\w* una  
\q2 y las \w llama|strong="H7121"\w* \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w por|strong="H3581"\w* su \w nombre|strong="H8034"\w*.  
\q2 ¡Es tan \w grande|strong="H7230"\w* su \w poder|strong="H3581"\w* y tan fuerte su \w potencia|strong="H3581"\w*,  
\q2 \w que|strong="H4310"\w* \w no|strong="H3808"\w* falta \w ninguna|strong="H3605"\w* \w de|strong="H5869"\w* ellas!   
\b  
\q1
\v 27 ¿\w Por|strong="H1870"\w* \w qué|strong="H4100"\w* te quejas, \w Jacob|strong="H3290"\w*?  
\q2 ¿\w Por|strong="H1870"\w* \w qué|strong="H4100"\w* \w dices|strong="H1696"\w*, \w Israel|strong="H3478"\w*:  
\q2 “Yahvé \w no|strong="H1870"\w* \w se|strong="H4100"\w* fija en mi \w camino|strong="H1870"\w*;  
\q2 mi \w Dios|strong="H3068"\w* ignora mi \w derecho|strong="H4941"\w*”?   
\q1
\v 28 ¿Acaso \w no|strong="H3808"\w* \w lo|strong="H3808"\w* \w sabes|strong="H3045"\w*? ¿\w No|strong="H3808"\w* \w lo|strong="H3808"\w* has \w oído|strong="H8085"\w*?  
\q2 Yahvé es el \w Dios|strong="H3068"\w* \w eterno|strong="H5769"\w*,  
\q2 el Creador de los confines de la tierra.  
\q2 Él \w no|strong="H3808"\w* \w se|strong="H3045"\w* cansa \w ni|strong="H3808"\w* \w se|strong="H3045"\w* fatiga,  
\q2 y su \w inteligencia|strong="H8394"\w* es insondable.   
\q1
\v 29 Él \w da|strong="H5414"\w* \w fuerzas|strong="H3581"\w* al cansado  
\q2 y \w vigor|strong="H3581"\w* al \w que|strong="H3581"\w* no tiene energías.   
\q1
\v 30 Aun los jóvenes se cansan y se fatigan,  
\q2 y los muchachos \w flaquean|strong="H3782"\w* y caen;   
\q1
\v 31 pero los \w que|strong="H3808"\w* confían \w en|strong="H3212"\w* Yahvé renovarán sus \w fuerzas|strong="H3581"\w*;  
\q2 volarán como las águilas,  
\q2 \w correrán|strong="H7323"\w* y \w no|strong="H3808"\w* \w se|strong="H3808"\w* fatigarán,  
\q2 \w caminarán|strong="H3212"\w* y \w no|strong="H3808"\w* \w se|strong="H3808"\w* cansarán.   
\c 41  
\q1
\v 1 “Guarden silencio ante mí, naciones de las costas,  
\q2 y \w que|strong="H3581"\w* los \w pueblos|strong="H3816"\w* recobren sus \w fuerzas|strong="H3581"\w*;  
\q1 \w que|strong="H3581"\w* se acerquen y entonces \w hablen|strong="H1696"\w*;  
\q2 reunámonos para \w el|strong="H5066"\w* \w juicio|strong="H4941"\w*.   
\q1
\v 2 ¿\w Quién|strong="H4310"\w* \w despertó|strong="H5782"\w* \w a|strong="H3068"\w* aquel \w que|strong="H4310"\w* viene del \w oriente|strong="H4217"\w*,  
\q2 \w a|strong="H3068"\w* \w quien|strong="H4310"\w* la victoria sale \w a|strong="H3068"\w* recibir \w a|strong="H3068"\w* cada paso?  
\q2 Dios \w entrega|strong="H5414"\w* \w naciones|strong="H1471"\w* \w ante|strong="H6440"\w* \w él|strong="H4310"\w* y humilla \w a|strong="H3068"\w* los \w reyes|strong="H4428"\w*;  
\q2 con su \w espada|strong="H2719"\w* los vuelve \w polvo|strong="H6083"\w*,  
\q2 y con su \w arco|strong="H7198"\w* los dispersa \w como|strong="H7272"\w* paja \w al|strong="H4428"\w* viento.   
\q1
\v 3 \w Los|strong="H7291"\w* \w persigue|strong="H7291"\w* y \w pasa|strong="H5674"\w* \w sin|strong="H3808"\w* peligro  
\q2 por caminos donde sus \w pies|strong="H7272"\w* \w nunca|strong="H3808"\w* habían pisado.   
\q1
\v 4 ¿\w Quién|strong="H4310"\w* \w hizo|strong="H6213"\w* \w esto|strong="H1931"\w* y \w lo|strong="H1931"\w* llevó \w a|strong="H3068"\w* cabo?  
\q2 \w El|strong="H1931"\w* \w que|strong="H4310"\w* \w llama|strong="H7121"\w* \w a|strong="H3068"\w* las \w generaciones|strong="H1755"\w* desde \w el|strong="H1931"\w* principio.  
\q2 \w Yo|strong="H6213"\w*, Yahvé, \w el|strong="H1931"\w* \w primero|strong="H7223"\w*, y \w yo|strong="H6213"\w* \w mismo|strong="H1931"\w* estaré con \w los|strong="H1931"\w* últimos”.   
\b  
\q1
\v 5 Las islas lo \w vieron|strong="H7200"\w* y tuvieron \w miedo|strong="H3372"\w*;  
\q2 los confines \w de|strong="H3372"\w* la tierra \w temblaron|strong="H2729"\w*; todos se acercaron y vinieron.   
\q1
\v 6 Cada uno \w ayuda|strong="H5826"\w* \w a|strong="H3068"\w* su \w compañero|strong="H7453"\w*  
\q2 y le dice \w a|strong="H3068"\w* su hermano: “¡Sé fuerte!”.   
\q1
\v 7 \w El|strong="H1931"\w* artesano anima al joyero,  
\q2 y \w el|strong="H1931"\w* \w que|strong="H1931"\w* aplana con \w el|strong="H1931"\w* martillo anima al \w que|strong="H1931"\w* golpea \w el|strong="H1931"\w* yunque,  
\q2 diciendo de \w la|strong="H1931"\w* soldadura: “\w Está|strong="H1931"\w* \w bien|strong="H2896"\w* hecha”;  
\q2 y asegura \w el|strong="H1931"\w* ídolo con clavos para \w que|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* mueva.   
\b  
\q1
\v 8 “Pero tú, \w Israel|strong="H3478"\w*, \w siervo|strong="H5650"\w* mío,  
\q2 tú, \w Jacob|strong="H3290"\w*, \w a|strong="H3068"\w* quien yo elegí, \w descendencia|strong="H2233"\w* de mi amigo Abraham:   
\q1
\v 9 Te \w tomé|strong="H2388"\w* de los confines de la tierra,  
\q2 de sus rincones \w más|strong="H3808"\w* lejanos te \w llamé|strong="H7121"\w*  
\q2 y te dije: “Tú eres mi \w siervo|strong="H5650"\w*; te he elegido y \w no|strong="H3808"\w* te he rechazado”.   
\q1
\v 10 \w No|strong="H3588"\w* \w temas|strong="H3372"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* estoy \w contigo|strong="H5973"\w*;  
\q2 \w no|strong="H3588"\w* \w te|strong="H3588"\w* angusties, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy tu Dios.  
\q2 \w Te|strong="H3588"\w* fortaleceré \w y|strong="H3588"\w* \w te|strong="H3588"\w* ayudaré;  
\q2 \w te|strong="H3588"\w* sostendré \w con|strong="H5973"\w* \w la|strong="H3588"\w* \w diestra|strong="H3225"\w* \w de|strong="H3588"\w* mi \w justicia|strong="H6664"\w*.   
\q1
\v 11 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* \w se|strong="H1961"\w* enfurecen \w contra|strong="H1961"\w* ti quedarán \w avergonzados|strong="H3637"\w* y humillados;  
\q2 \w los|strong="H3605"\w* \w que|strong="H1961"\w* te faltan al respeto \w serán|strong="H1961"\w* \w como|strong="H1961"\w* \w nada|strong="H3605"\w* y perecerán.   
\q1
\v 12 \w Buscarás|strong="H1245"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w que|strong="H3808"\w* te atacan y \w no|strong="H3808"\w* \w los|strong="H1961"\w* \w hallarás|strong="H4672"\w*;  
\q2 \w los|strong="H1961"\w* \w que|strong="H3808"\w* te hacen la \w guerra|strong="H4421"\w* \w serán|strong="H1961"\w* \w como|strong="H1961"\w* \w nada|strong="H3808"\w*, \w como|strong="H1961"\w* \w si|strong="H3808"\w* \w no|strong="H3808"\w* existieran.   
\q1
\v 13 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, tu \w Dios|strong="H3068"\w*, \w que|strong="H3588"\w* \w te|strong="H3588"\w* toma \w de|strong="H3588"\w* \w la|strong="H3588"\w* mano \w derecha|strong="H3225"\w*  
\q2 \w y|strong="H3588"\w* \w te|strong="H3588"\w* dice: “\w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*, \w yo|strong="H3588"\w* \w te|strong="H3588"\w* \w ayudo|strong="H5826"\w*”.   
\q1
\v 14 No \w temas|strong="H3372"\w*, pobre \w Jacob|strong="H3290"\w*,  
\q2 pequeño resto \w de|strong="H3372"\w* \w Israel|strong="H3478"\w*;  
\q2 yo mismo te \w ayudo|strong="H5826"\w*”, \w dice|strong="H5002"\w* Yahvé;  
\q2 “tu \w Redentor|strong="H1350"\w* es el \w Santo|strong="H6918"\w* \w de|strong="H3372"\w* \w Israel|strong="H3478"\w*.   
\q1
\v 15 Miren, \w yo|strong="H2009"\w* \w los|strong="H1167"\w* he convertido en un \w trillo|strong="H2742"\w* \w nuevo|strong="H2319"\w*,  
\q2 afilado y con muchos dientes;  
\q2 triturarán \w los|strong="H1167"\w* \w montes|strong="H2022"\w* y \w los|strong="H1167"\w* \w harán|strong="H7760"\w* polvo,  
\q2 y convertirán las colinas en paja.   
\q1
\v 16 Los lanzarán al aire y el \w viento|strong="H7307"\w* se los \w llevará|strong="H5375"\w*;  
\q2 el torbellino los dispersará.  
\q1 Pero tú te alegrarás en Yahvé  
\q2 y te sentirás orgulloso del \w Santo|strong="H6918"\w* de \w Israel|strong="H3478"\w*.   
\b  
\q1
\v 17 Los pobres y los necesitados \w buscan|strong="H1245"\w* \w agua|strong="H4325"\w* y \w no|strong="H3808"\w* la encuentran;  
