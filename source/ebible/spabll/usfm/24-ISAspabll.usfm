\q1
\v 3 \w Porque|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé, tu \w Dios|strong="H3068"\w*,  
\q2 \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, tu \w Salvador|strong="H3467"\w*.  
\q1 \w Yo|strong="H3588"\w* \w entrego|strong="H5414"\w* \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w para|strong="H3588"\w* rescatarte,  
\q2 \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w Etiopía|strong="H3568"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w Seba|strong="H5434"\w* \w en|strong="H3588"\w* tu \w lugar|strong="H8478"\w*.   
\q1
\v 4 Porque \w te|strong="H5869"\w* aprecio mucho,  
\q2 porque eres digno \w de|strong="H8478"\w* \w honra|strong="H3513"\w* y \w yo|strong="H5315"\w* \w te|strong="H5869"\w* amo,  
\q2 \w entregaré|strong="H5414"\w* hombres \w a|strong="H3068"\w* cambio \w de|strong="H8478"\w* ti,  
