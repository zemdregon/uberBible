\q2 y tus valientes en la \w batalla|strong="H4421"\w*.   
\q1
\v 26 Las \w puertas|strong="H6607"\w* de la ciudad gemirán y llorarán;  
\q2 y ella, desolada, se sentará en \w el|strong="H3427"\w* suelo.   
\c 4  
\p
\v 1 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w siete|strong="H7651"\w* mujeres \w se|strong="H1931"\w* agarrarán \w de|strong="H5921"\w* un \w solo|strong="H1931"\w* hombre \w y|strong="H5921"\w* \w le|strong="H1931"\w* dirán: “Nosotras \w nos|strong="H5921"\w* mantendremos \w con|strong="H5921"\w* nuestra propia \w comida|strong="H3899"\w* \w y|strong="H5921"\w* \w nos|strong="H5921"\w* vestiremos \w con|strong="H5921"\w* nuestra propia \w ropa|strong="H8071"\w*; \w solo|strong="H1931"\w* deja \w que|strong="H1931"\w* llevemos tu \w nombre|strong="H8034"\w*. ¡Quítanos nuestra \w deshonra|strong="H2781"\w*!”.   
\p
\v 2 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* brote de Yahvé \w será|strong="H1961"\w* bello \w y|strong="H3519"\w* \w glorioso|strong="H3519"\w*, \w y|strong="H3519"\w* \w el|strong="H1931"\w* \w fruto|strong="H6529"\w* de \w la|strong="H1931"\w* tierra \w será|strong="H1961"\w* \w el|strong="H1931"\w* orgullo \w y|strong="H3519"\w* \w el|strong="H1931"\w* esplendor de \w los|strong="H1931"\w* sobrevivientes de \w Israel|strong="H3478"\w*.  
\v 3 Entonces, \w el|strong="H3605"\w* \w que|strong="H1961"\w* \w quede|strong="H7604"\w* en \w Sión|strong="H6726"\w* y \w el|strong="H3605"\w* \w que|strong="H1961"\w* permanezca en Jerusalén \w será|strong="H1961"\w* llamado \w santo|strong="H6918"\w*: \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H1961"\w* \w estén|strong="H1961"\w* anotados en \w la|strong="H3605"\w* lista de \w los|strong="H3605"\w* \w vivos|strong="H2416"\w* en Jerusalén.  
\v 4 Esto sucederá cuando el Señor haya lavado \w la|strong="H1197"\w* suciedad \w de|strong="H1818"\w* las \w hijas|strong="H1323"\w* \w de|strong="H1818"\w* \w Sión|strong="H6726"\w* \w y|strong="H1197"\w* haya limpiado las manchas \w de|strong="H1818"\w* \w sangre|strong="H1818"\w* \w de|strong="H1818"\w* Jerusalén, por \w medio|strong="H7130"\w* \w de|strong="H1818"\w* un \w espíritu|strong="H7307"\w* \w de|strong="H1818"\w* \w justicia|strong="H4941"\w* \w y|strong="H1197"\w* \w de|strong="H1818"\w* un fuego purificador.  
\v 5 \w Entonces|strong="H3588"\w* Yahvé creará \w sobre|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* lugar \w del|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w* \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* sus \w asambleas|strong="H4744"\w* una \w nube|strong="H6051"\w* \w de|strong="H5921"\w* \w humo|strong="H6227"\w* durante \w el|strong="H5921"\w* \w día|strong="H3119"\w*, \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w resplandor|strong="H5051"\w* \w de|strong="H5921"\w* un fuego flameante \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w noche|strong="H3915"\w*. \w Pues|strong="H3588"\w* \w sobre|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* habrá una cubierta protectora.  
\v 6 \w Habrá|strong="H1961"\w* un refugio \w que|strong="H1961"\w* dará \w sombra|strong="H6738"\w* \w contra|strong="H1961"\w* el calor del \w día|strong="H3119"\w*, y \w que|strong="H1961"\w* \w servirá|strong="H1961"\w* de resguardo y protección \w contra|strong="H1961"\w* la tormenta y la \w lluvia|strong="H4306"\w*.   
\c 5  
\q1
\v 1 Permítanme cantar \w ahora|strong="H4994"\w* por \w mi|strong="H1961"\w* \w amado|strong="H1730"\w*, \w el|strong="H1121"\w* \w canto|strong="H7891"\w* \w de|strong="H1121"\w* \w mi|strong="H1961"\w* \w amado|strong="H1730"\w* acerca \w de|strong="H1121"\w* su viñedo.  
\q2 \w Mi|strong="H1961"\w* \w amado|strong="H1730"\w* \w tenía|strong="H1961"\w* un viñedo en una colina muy \w fértil|strong="H8081"\w*.   
\q1
\v 2 \w Lo|strong="H6213"\w* cercó, le quitó las piedras  
\q2 \w y|strong="H1571"\w* \w lo|strong="H6213"\w* \w plantó|strong="H5193"\w* \w con|strong="H1571"\w* las vides \w más|strong="H1571"\w* finas.  
\q2 Construyó una \w torre|strong="H4026"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de \w él|strong="H6213"\w*  
\q2 \w y|strong="H1571"\w* \w también|strong="H1571"\w* excavó un \w lagar|strong="H3342"\w*.  
\q1 \w Esperaba|strong="H6960"\w* \w que|strong="H1571"\w* diera \w uvas|strong="H6025"\w* buenas,  
\q2 pero dio \w uvas|strong="H6025"\w* silvestres.   
\b  
\q1
\v 3 “\w Ahora|strong="H6258"\w* \w pues|strong="H4994"\w*, \w habitantes|strong="H3427"\w* de Jerusalén y hombres de \w Judá|strong="H3063"\w*,  
\q2 juzguen, por favor, entre \w mi|strong="H3389"\w* viñedo y \w yo|strong="H4994"\w*.   
\q1
\v 4 ¿\w Qué|strong="H4100"\w* \w más|strong="H5750"\w* \w se|strong="H3808"\w* \w podía|strong="H3808"\w* \w hacer|strong="H6213"\w* \w por|strong="H4069"\w* mi viñedo \w que|strong="H4100"\w* \w yo|strong="H6213"\w* \w no|strong="H3808"\w* haya \w hecho|strong="H6213"\w* ya?  
\q2 ¿\w Cómo|strong="H4100"\w* es \w que|strong="H4100"\w*, \w esperando|strong="H6960"\w* \w yo|strong="H6213"\w* \w uvas|strong="H6025"\w* buenas, acabó dando \w uvas|strong="H6025"\w* silvestres?   
\q1
\v 5 \w Ahora|strong="H6258"\w* les diré \w lo|strong="H6213"\w* \w que|strong="H6258"\w* voy \w a|strong="H3068"\w* \w hacer|strong="H6213"\w* con \w mi|strong="H1961"\w* viñedo:  
\q2 Le \w quitaré|strong="H5493"\w* su cerca, \w y|strong="H1197"\w* \w será|strong="H1961"\w* consumido;  
\q2 derribaré su muro, \w y|strong="H1197"\w* \w será|strong="H1961"\w* pisoteado.   
\q1
\v 6 Haré \w que|strong="H3808"\w* quede desierto;  
\q2 \w no|strong="H3808"\w* \w será|strong="H3808"\w* podado \w ni|strong="H3808"\w* cultivado,  
\q2 \w y|strong="H5921"\w* \w crecerán|strong="H5927"\w* \w los|strong="H5921"\w* \w espinos|strong="H8068"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w cardos|strong="H8068"\w*.  
\q2 También ordenaré \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w nubes|strong="H5645"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* lluevan \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*”.   
\q1
\v 7 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* viñedo \w de|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* \w es|strong="H3588"\w* \w la|strong="H3588"\w* \w casa|strong="H1004"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*,  
\q2 \w y|strong="H3588"\w* \w los|strong="H3588"\w* hombres \w de|strong="H3588"\w* \w Judá|strong="H3063"\w* \w son|strong="H3588"\w* \w su|strong="H3588"\w* \w planta|strong="H5194"\w* predilecta.  
\q2 \w Él|strong="H3588"\w* \w esperaba|strong="H6960"\w* \w justicia|strong="H6666"\w*, \w pero|strong="H3588"\w* \w hubo|strong="H2009"\w* opresión;  
\q2 \w esperaba|strong="H6960"\w* rectitud, \w pero|strong="H3588"\w* \w hubo|strong="H2009"\w* \w clamor|strong="H6818"\w* \w de|strong="H3588"\w* angustia.   
\b  
\q1
\v 8 ¡\w Ay|strong="H1945"\w* \w de|strong="H5704"\w* \w los|strong="H3427"\w* \w que|strong="H5704"\w* juntan \w casa|strong="H1004"\w* tras \w casa|strong="H1004"\w*,  
\q2 \w y|strong="H5704"\w* añaden \w campo|strong="H7704"\w* tras \w campo|strong="H7704"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* no queda espacio,  
\q2 \w y|strong="H5704"\w* se les deja habitando solos \w en|strong="H5704"\w* \w medio|strong="H7130"\w* \w de|strong="H5704"\w* la tierra!   
\q1
\v 9 Yahvé de \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w* \w ha|strong="H3808"\w* dicho \w a|strong="H3068"\w* mis oídos: “Ciertamente \w muchas|strong="H7227"\w* \w casas|strong="H1004"\w* \w quedarán|strong="H3427"\w* desoladas;  
\q2 \w aun|strong="H3808"\w* las \w grandes|strong="H1419"\w* y \w hermosas|strong="H2896"\w* \w quedarán|strong="H3427"\w* vacías.   
\q1
\v 10 \w Porque|strong="H3588"\w* \w diez|strong="H6235"\w* \w yuntas|strong="H6776"\w*\f + \fr 5:10 \ft literalmente, diez yuntas, o la cantidad de tierra que diez yuntas de bueyes pueden arar en un día, lo que equivale a unos 10 acres o 4 hectáreas.\f* \w de|strong="H3588"\w* viñedo \w producirán|strong="H6213"\w* solo un baño,\f + \fr 5:10 \ft 1 baño equivale a unos 22 litros o 5,8 galones americanos.\f*  
\q2 \w y|strong="H3588"\w* un homer\f + \fr 5:10 \ft 1 homer es aproximadamente 220 litros o 6 bushels.\f* \w de|strong="H3588"\w* semilla dará solo un efa”.\f + \fr 5:10 \ft 1 efa equivale a unos 22 litros o 0,6 fanegas, o sea, a unos 2 picotazos: sólo una décima parte de lo que se sembró.\f*   
\q1
\v 11 ¡\w Ay|strong="H1945"\w* de \w los|strong="H7291"\w* que se levantan temprano para correr tras la \w bebida|strong="H7941"\w*,  
\q2 y se quedan hasta tarde por la noche hasta que el \w vino|strong="H3196"\w* \w los|strong="H7291"\w* enciende!   
\q1
\v 12 En sus parrandas \w hay|strong="H1961"\w* \w arpas|strong="H3658"\w*, liras, panderos, \w flautas|strong="H2485"\w* y \w vino|strong="H3196"\w*;  
\q2 pero \w no|strong="H3808"\w* prestan atención \w a|strong="H3068"\w* \w los|strong="H1961"\w* actos \w de|strong="H5035"\w* Yahvé,  
\q2 \w ni|strong="H3808"\w* \w consideran|strong="H7200"\w* la \w obra|strong="H4639"\w* \w de|strong="H5035"\w* sus \w manos|strong="H3027"\w*.   
\b  
\q1
\v 13 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w* mi \w pueblo|strong="H5971"\w* \w va|strong="H3068"\w* al cautiverio \w por|strong="H3651"\w* falta \w de|strong="H5971"\w* \w conocimiento|strong="H1847"\w*;  
\q2 sus \w hombres|strong="H4962"\w* honorables mueren \w de|strong="H5971"\w* \w hambre|strong="H7458"\w*  
\q2 \w y|strong="H3519"\w* la \w multitud|strong="H1995"\w* \w se|strong="H3651"\w* seca \w de|strong="H5971"\w* \w sed|strong="H6772"\w*.   
\q1
\v 14 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, el Seol\f + \fr 5:14 \ft El Seol es el lugar de los muertos.\f* ha ensanchado su garganta  
\q2 y ha abierto su \w boca|strong="H6310"\w* \w sin|strong="H1097"\w* medida;  
\q2 allá bajará su esplendor y su \w multitud|strong="H1995"\w*, su lujo y el \w que|strong="H6310"\w* en él \w se|strong="H3651"\w* divertía.   
\q1
\v 15 Así el hombre será humillado,  
\q2 cada uno será abatido  
\q2 y los \w ojos|strong="H5869"\w* \w de|strong="H5869"\w* los orgullosos serán humillados.   
\q1
\v 16 Pero Yahvé de los \w Ejércitos|strong="H6635"\w* será exaltado en \w justicia|strong="H6666"\w*,  
\q2 y el \w Dios|strong="H3068"\w* \w Santo|strong="H6918"\w* será santificado con rectitud.   
\q1
\v 17 Entonces los \w corderos|strong="H3532"\w* pastarán como en sus propios pastos,  
\q2 y los extraños devorarán las ruinas de los ricos.   
\b  
\q1
\v 18 ¡\w Ay|strong="H1945"\w* de los que arrastran la \w maldad|strong="H5771"\w* con \w cuerdas|strong="H5688"\w* de \w mentira|strong="H7723"\w*,  
\q2 y el \w pecado|strong="H2403"\w* \w como|strong="H5771"\w* con \w sogas|strong="H2256"\w* de carreta!   
\q1
\v 19 De esos \w que|strong="H3045"\w* dicen: “\w Que|strong="H3045"\w* \w se|strong="H3045"\w* apresure, \w que|strong="H3045"\w* adelante su \w obra|strong="H4639"\w* \w para|strong="H4616"\w* \w que|strong="H3045"\w* la \w veamos|strong="H7200"\w*;  
\q2 \w que|strong="H3045"\w* \w se|strong="H3045"\w* acerque y \w se|strong="H3045"\w* cumpla el plan del \w Santo|strong="H6918"\w* de \w Israel|strong="H3478"\w*,  
\q2 \w para|strong="H4616"\w* \w que|strong="H3045"\w* lo \w conozcamos|strong="H3045"\w*”.   
\q1
\v 20 ¡\w Ay|strong="H1945"\w* \w de|strong="H7451"\w* los que \w a|strong="H3068"\w* lo \w malo|strong="H7451"\w* llaman \w bueno|strong="H2896"\w* y \w a|strong="H3068"\w* lo \w bueno|strong="H2896"\w* \w malo|strong="H7451"\w*;  
\q2 que presentan la \w oscuridad|strong="H2822"\w* como luz  
\q2 y la luz como \w oscuridad|strong="H2822"\w*;  
\q1 que presentan lo \w amargo|strong="H4751"\w* como \w dulce|strong="H4966"\w*  
\q2 y lo \w dulce|strong="H4966"\w* como \w amargo|strong="H4751"\w*!   
\q1
\v 21 ¡\w Ay|strong="H1945"\w* \w de|strong="H6440"\w* \w los|strong="H2450"\w* que se creen \w sabios|strong="H2450"\w*  
\q2 y se consideran inteligentes!   
\q1
\v 22 ¡\w Ay|strong="H1945"\w* de los que son \w valientes|strong="H1368"\w* para \w beber|strong="H8354"\w* \w vino|strong="H3196"\w*  
\q2 y campeones para mezclar bebidas \w fuertes|strong="H2428"\w*;   
\q1
\v 23 \w que|strong="H4480"\w* \w por|strong="H4480"\w* \w soborno|strong="H7810"\w* declaran inocente \w al|strong="H4480"\w* culpable,  
\q2 y le roban sus derechos \w al|strong="H4480"\w* \w que|strong="H4480"\w* es \w justo|strong="H6662"\w*!   
\b  
\q1
\v 24 \w Por|strong="H3588"\w* \w eso|strong="H3651"\w*, \w como|strong="H3588"\w* \w la|strong="H3588"\w* \w lengua|strong="H3956"\w* \w de|strong="H3588"\w* fuego \w devora|strong="H7503"\w* \w el|strong="H3588"\w* \w rastrojo|strong="H7179"\w*  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* hierba seca \w se|strong="H1961"\w* consume \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w llama|strong="H3852"\w*,  
\q2 \w así|strong="H3651"\w* \w su|strong="H3588"\w* raíz \w será|strong="H1961"\w* \w como|strong="H3588"\w* podredumbre  
\q2 \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w flor|strong="H6525"\w* \w se|strong="H1961"\w* desvanecerá \w como|strong="H3588"\w* \w el|strong="H3588"\w* polvo;  
\q1 \w porque|strong="H3588"\w* rechazaron \w la|strong="H3588"\w* \w ley|strong="H8451"\w* \w de|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w*  
\q2 \w y|strong="H3588"\w* despreciaron \w la|strong="H3588"\w* palabra del \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.   
\q1
\v 25 \w Por|strong="H5921"\w* \w esta|strong="H2063"\w* razón \w se|strong="H1961"\w* encendió \w la|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé \w contra|strong="H5921"\w* su \w pueblo|strong="H5971"\w*;  
\q2 \w extendió|strong="H5186"\w* su \w mano|strong="H3027"\w* \w contra|strong="H5921"\w* \w ellos|strong="H3027"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* golpeó.  
\q1 \w Las|strong="H5921"\w* montañas \w temblaron|strong="H7264"\w*  
\q2 \w y|strong="H5921"\w* sus cadáveres \w quedaron|strong="H1961"\w* \w como|strong="H1961"\w* basura \w en|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w calles|strong="H2351"\w*.  
\q1 \w Con|strong="H5921"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, su ira \w no|strong="H3808"\w* \w se|strong="H1961"\w* \w ha|strong="H3808"\w* aplacado,  
\q2 \w sino|strong="H3808"\w* \w que|strong="H3808"\w* su \w mano|strong="H3027"\w* sigue \w extendida|strong="H5186"\w*.   
\b  
\q1
\v 26 Él \w levantará|strong="H5251"\w* una \w bandera|strong="H5251"\w* para las \w naciones|strong="H1471"\w* lejanas;  
\q2 les \w silbará|strong="H8319"\w* desde los confines de la tierra,  
\q2 y miren, \w ellas|strong="H2009"\w* vendrán \w pronto|strong="H4120"\w* y velozmente.   
\q1
\v 27 \w Nadie|strong="H3808"\w* \w entre|strong="H3808"\w* ellos \w se|strong="H3808"\w* cansa \w ni|strong="H3808"\w* tropieza,  
\q2 \w nadie|strong="H3808"\w* \w se|strong="H3808"\w* adormece \w ni|strong="H3808"\w* \w se|strong="H3808"\w* \w duerme|strong="H3462"\w*;  
\q2 \w a|strong="H3068"\w* \w nadie|strong="H3808"\w* \w se|strong="H3808"\w* le desata el cinturón  
\q2 \w ni|strong="H3808"\w* \w se|strong="H3808"\w* le rompe la correa de sus sandalias.   
\q1
\v 28 Sus flechas están afiladas  
\q2 y \w todos|strong="H3605"\w* sus \w arcos|strong="H7198"\w* tensados;  
\q1 \w los|strong="H3605"\w* cascos de sus \w caballos|strong="H5483"\w* parecen de pedernal  
\q2 y las ruedas de sus carros, un \w torbellino|strong="H5492"\w*.   
\q1
\v 29 Su rugido es \w como|strong="H3715"\w* el de una leona;  
\q2 rugen \w como|strong="H3715"\w* cachorros de león.  
\q1 Gruñen y atrapan la presa;  
\q2 se la llevan y no hay quien se la quite.   
\q1
\v 30 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* rugirán \w contra|strong="H5921"\w* \w ellos|strong="H1931"\w* \w como|strong="H5921"\w* \w el|strong="H1931"\w* rugido \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\q2 \w Si|strong="H1931"\w* alguien \w mira|strong="H5027"\w* \w hacia|strong="H5921"\w* \w la|strong="H1931"\w* tierra, \w solo|strong="H1931"\w* \w verá|strong="H5027"\w* \w tinieblas|strong="H2822"\w* \w y|strong="H5921"\w* \w angustia|strong="H6862"\w*;  
\q2 \w la|strong="H1931"\w* luz \w se|strong="H1931"\w* oscurecerá \w por|strong="H5921"\w* \w las|strong="H5921"\w* nubes.   
\c 6  
\p
\v 1 \w El|strong="H5921"\w* \w año|strong="H8141"\w* \w en|strong="H5921"\w* \w que|strong="H5921"\w* murió \w el|strong="H5921"\w* \w rey|strong="H4428"\w* Uzías, \w vi|strong="H7200"\w* \w al|strong="H5921"\w* Señor \w sentado|strong="H3427"\w* \w en|strong="H5921"\w* un \w trono|strong="H3678"\w* \w alto|strong="H7311"\w* \w y|strong="H5921"\w* sublime, \w y|strong="H5921"\w* \w el|strong="H5921"\w* borde \w de|strong="H5921"\w* su manto llenaba \w el|strong="H5921"\w* \w templo|strong="H1964"\w*.  
\v 2 \w Por|strong="H6440"\w* \w encima|strong="H4605"\w* \w de|strong="H6440"\w* él \w había|strong="H5975"\w* \w serafines|strong="H8314"\w*. Cada uno tenía \w seis|strong="H8337"\w* \w alas|strong="H3671"\w*: con \w dos|strong="H8147"\w* se \w cubrían|strong="H3680"\w* el \w rostro|strong="H6440"\w*, con \w dos|strong="H8147"\w* se \w cubrían|strong="H3680"\w* los \w pies|strong="H7272"\w* y con \w dos|strong="H8147"\w* \w volaban|strong="H5774"\w*.  
\v 3 \w Y|strong="H3068"\w* se gritaban \w el|strong="H3605"\w* uno al \w otro|strong="H2088"\w*:  
\q1 “¡\w Santo|strong="H6918"\w*, \w santo|strong="H6918"\w*, \w santo|strong="H6918"\w* \w es|strong="H2088"\w* Yahvé de \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*!  
\q2 ¡\w Toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra \w está|strong="H2088"\w* \w llena|strong="H4393"\w* de su \w gloria|strong="H3519"\w*!”.   
\p
\v 4 Los cimientos de los umbrales \w temblaron|strong="H5128"\w* por la \w voz|strong="H6963"\w* del que clamaba, y el \w templo|strong="H1004"\w* se \w llenó|strong="H4390"\w* de \w humo|strong="H6227"\w*.  
\v 5 \w Entonces|strong="H3588"\w* dije: “¡Ay \w de|strong="H3588"\w* mí! ¡Estoy perdido! \w Porque|strong="H3588"\w* soy un hombre \w de|strong="H3588"\w* \w labios|strong="H8193"\w* impuros \w y|strong="H3588"\w* vivo \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H3588"\w* un \w pueblo|strong="H5971"\w* \w de|strong="H3588"\w* \w labios|strong="H8193"\w* impuros, ¡\w y|strong="H3588"\w* mis \w ojos|strong="H5869"\w* han \w visto|strong="H7200"\w* \w al|strong="H4428"\w* \w Rey|strong="H4428"\w*, Yahvé \w de|strong="H3588"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*!”.   
\p
\v 6 Entonces uno \w de|strong="H4480"\w* \w los|strong="H5921"\w* \w serafines|strong="H8314"\w* voló \w hacia|strong="H5921"\w* \w mí|strong="H5921"\w*, \w con|strong="H5921"\w* un carbón encendido \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w que|strong="H4480"\w* había \w tomado|strong="H3947"\w* \w del|strong="H4480"\w* \w altar|strong="H4196"\w* \w con|strong="H5921"\w* unas tenazas.  
\v 7 \w Tocó|strong="H5060"\w* \w mi|strong="H5921"\w* \w boca|strong="H6310"\w* \w con|strong="H5921"\w* \w él|strong="H5921"\w* \w y|strong="H5921"\w* dijo: “\w Mira|strong="H2009"\w*, \w esto|strong="H2088"\w* ha tocado tus \w labios|strong="H8193"\w*; tu \w maldad|strong="H5771"\w* ha sido quitada \w y|strong="H5921"\w* tu \w pecado|strong="H2403"\w* ha sido perdonado”.   
\p
\v 8 Después \w oí|strong="H8085"\w* la \w voz|strong="H6963"\w* del Señor, \w que|strong="H4310"\w* decía: “¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* \w enviaré|strong="H7971"\w*? ¿\w Quién|strong="H4310"\w* \w irá|strong="H3212"\w* de nuestra parte?”.  
\p Entonces respondí: “\w Aquí|strong="H2005"\w* estoy yo. \w Envíame|strong="H7971"\w* \w a|strong="H3068"\w* mí”.   
\p
\v 9 Él dijo: “\w Ve|strong="H3212"\w* y dile \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*:  
\q1 ‘\w Escuchen|strong="H8085"\w* \w bien|strong="H7200"\w*, pero no \w entiendan|strong="H3045"\w*;  
\q2 miren con cuidado, pero no perciban’.   
\q1
\v 10 \w Vuelve|strong="H7725"\w* insensible el \w corazón|strong="H3820"\w* \w de|strong="H5971"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*,  
\q2 embota sus \w oídos|strong="H8085"\w* y cierra sus \w ojos|strong="H5869"\w*;  
\q1 \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H6435"\w* \w vean|strong="H7200"\w* con sus \w ojos|strong="H5869"\w*, \w oigan|strong="H8085"\w* con sus \w oídos|strong="H8085"\w*,  
\q2 entiendan con el \w corazón|strong="H3820"\w*, \w se|strong="H5971"\w* arrepientan y sean sanados”.   
\p
\v 11 Entonces pregunté: “¿\w Hasta|strong="H5704"\w* \w cuándo|strong="H4970"\w*, Señor?”.  
\p \w Y|strong="H3068"\w* \w él|strong="H3427"\w* respondió:  
\q1 “\w Hasta|strong="H5704"\w* \w que|strong="H5704"\w* las \w ciudades|strong="H5892"\w* queden \w en|strong="H5704"\w* ruinas \w y|strong="H5704"\w* sin \w habitantes|strong="H3427"\w*,  
\q2 las \w casas|strong="H1004"\w* estén vacías  
\q2 \w y|strong="H5704"\w* la tierra \w quede|strong="H3427"\w* totalmente \w desolada|strong="H8077"\w*;  
\v 12 hasta que Yahvé haya expulsado \w lejos|strong="H7368"\w* \w a|strong="H3068"\w* la gente,  
\q2 y el abandono sea total en \w medio|strong="H7130"\w* de la tierra.   
\q1
\v 13 \w Y|strong="H3068"\w* aunque \w quede|strong="H1961"\w* \w en|strong="H5750"\w* ella una décima parte,  
\q2 \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* ser destruida;  
\q1 pero \w como|strong="H1961"\w* el terebinto \w y|strong="H1197"\w* el roble, \w que|strong="H1961"\w* al ser cortados dejan un tronco,  
\q2 así el tronco \w será|strong="H1961"\w* \w la|strong="H1197"\w* semilla \w santa|strong="H6944"\w*”.   
\c 7  
\p
\v 1 \w En|strong="H5921"\w* \w los|strong="H1121"\w* \w días|strong="H3117"\w* \w de|strong="H5921"\w* Acaz \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Jotam, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Uzías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*, \w sucedió|strong="H1961"\w* \w que|strong="H3808"\w* \w Rezín|strong="H7526"\w*, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Siria, \w y|strong="H5921"\w* \w Peka|strong="H6492"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Remalías, \w rey|strong="H4428"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w subieron|strong="H5927"\w* \w contra|strong="H5921"\w* Jerusalén \w para|strong="H5921"\w* atacarla, pero \w no|strong="H3808"\w* \w pudieron|strong="H3201"\w* conquistarla.  
\v 2 \w Y|strong="H3068"\w* \w le|strong="H5921"\w* dieron \w aviso|strong="H5046"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w*: “Siria \w se|strong="H5921"\w* ha aliado \w con|strong="H5921"\w* Efraín”. Entonces \w el|strong="H5921"\w* \w corazón|strong="H3824"\w* \w de|strong="H5921"\w* Acaz \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w de|strong="H5921"\w* su \w pueblo|strong="H5971"\w* \w temblaron|strong="H5128"\w* \w como|strong="H5921"\w* tiemblan \w los|strong="H5921"\w* \w árboles|strong="H6086"\w* \w del|strong="H5921"\w* \w bosque|strong="H3293"\w* \w ante|strong="H6440"\w* \w el|strong="H5921"\w* \w viento|strong="H7307"\w*.   
\p
\v 3 Entonces Yahvé le dijo \w a|strong="H3068"\w* \w Isaías|strong="H3470"\w*: “\w Sal|strong="H3318"\w* \w ahora|strong="H4994"\w* al encuentro \w de|strong="H1121"\w* Acaz, tú y tu \w hijo|strong="H1121"\w* Sear-jasub, al final del acueducto del \w estanque|strong="H1295"\w* superior, \w en|strong="H3318"\w* \w el|strong="H1121"\w* \w camino|strong="H4546"\w* \w que|strong="H4994"\w* \w va|strong="H3068"\w* al \w Campo|strong="H7704"\w* del Lavandero.  
\v 4 Dile: ‘Ten cuidado y mantén \w la|strong="H8104"\w* calma. No tengas \w miedo|strong="H3372"\w* ni te desanimes por esos \w dos|strong="H8147"\w* restos \w de|strong="H1121"\w* antorchas \w que|strong="H1121"\w* solo humean, por \w el|strong="H1121"\w* ardor \w de|strong="H1121"\w* \w la|strong="H8104"\w* ira \w de|strong="H1121"\w* \w Rezín|strong="H7526"\w* y \w de|strong="H1121"\w* Siria, y del \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Remalías.  
\v 5 Siria, Efraín \w y|strong="H3588"\w* \w el|strong="H5921"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Remalías han tramado \w mal|strong="H7451"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, diciendo:  
\v 6 “\w Subamos|strong="H5927"\w* contra \w Judá|strong="H3063"\w* y aterroricémosla; repartámosla \w entre|strong="H8432"\w* nosotros y pongamos como \w rey|strong="H4428"\w* \w en|strong="H8432"\w* \w medio|strong="H8432"\w* \w de|strong="H1121"\w* ella \w al|strong="H4428"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Tabeel|strong="H2870"\w*”’.  
\v 7 \w Así|strong="H3541"\w* dice el Señor Yahvé: “Eso \w no|strong="H3808"\w* \w se|strong="H1961"\w* mantendrá en pie \w ni|strong="H3808"\w* \w sucederá|strong="H1961"\w*.  
\v 8 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w de|strong="H3588"\w* Siria \w es|strong="H3588"\w* \w Damasco|strong="H1834"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w de|strong="H3588"\w* \w Damasco|strong="H1834"\w* \w es|strong="H3588"\w* \w Rezín|strong="H7526"\w*; \w y|strong="H3588"\w* dentro \w de|strong="H3588"\w* \w sesenta|strong="H8346"\w* \w y|strong="H3588"\w* \w cinco|strong="H2568"\w* \w años|strong="H8141"\w* Efraín será destrozado hasta dejar \w de|strong="H3588"\w* ser \w pueblo|strong="H5971"\w*.  
\v 9 \w La|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w de|strong="H3588"\w* Efraín \w es|strong="H3588"\w* \w Samaria|strong="H8111"\w*, \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w cabeza|strong="H7218"\w* \w de|strong="H3588"\w* \w Samaria|strong="H8111"\w* \w es|strong="H3588"\w* \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Remalías. \w Si|strong="H3588"\w* ustedes \w no|strong="H3808"\w* creen, \w de|strong="H3588"\w* \w ninguna|strong="H3808"\w* manera permanecerán firmes’”.   
\p
\v 10 Yahvé \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* \w hablarle|strong="H1696"\w* \w a|strong="H3068"\w* Acaz y \w le|strong="H3254"\w* \w dijo|strong="H1696"\w*:  
\v 11 “\w Pide|strong="H7592"\w* \w para|strong="H5973"\w* \w ti|strong="H5973"\w* una señal \w de|strong="H5973"\w* parte \w de|strong="H5973"\w* Yahvé tu \w Dios|strong="H3068"\w*; pídela ya sea \w de|strong="H5973"\w* lo más profundo \w o|strong="H3068"\w* \w de|strong="H5973"\w* lo más \w alto|strong="H1361"\w*”.   
\p
\v 12 Pero Acaz respondió: “\w No|strong="H3808"\w* \w pediré|strong="H7592"\w* \w nada|strong="H3808"\w*; \w no|strong="H3808"\w* voy \w a|strong="H3068"\w* poner \w a|strong="H3068"\w* \w prueba|strong="H5254"\w* \w a|strong="H3068"\w* Yahvé”.   
\p
\v 13 \w Entonces|strong="H3588"\w* Isaías dijo: “\w Escuchen|strong="H8085"\w* \w ahora|strong="H4994"\w*, \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w David|strong="H1732"\w*: ¿Les parece \w poco|strong="H4592"\w* \w el|strong="H3588"\w* cansar \w a|strong="H3068"\w* \w los|strong="H3588"\w* hombres, \w que|strong="H3588"\w* quieren \w también|strong="H1571"\w* cansar \w a|strong="H3068"\w* \w mi|strong="H4994"\w* Dios?  
\v 14 \w Por|strong="H3651"\w* \w tanto|strong="H3651"\w*, \w el|strong="H1931"\w* Señor \w mismo|strong="H1931"\w* les \w dará|strong="H5414"\w* una señal: miren, \w la|strong="H1931"\w* virgen \w concebirá|strong="H2030"\w* y \w dará|strong="H5414"\w* \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*, y \w le|strong="H1931"\w* \w pondrá|strong="H5414"\w* \w por|strong="H3651"\w* \w nombre|strong="H8034"\w* Emanuel. \f + \fr 7:14 \ft “Emanuel” significa “Dios con nosotros”.\f*  
\v 15 Él comerá cuajada y \w miel|strong="H1706"\w* cuando \w sepa|strong="H3045"\w* distinguir entre lo \w malo|strong="H7451"\w* y lo \w bueno|strong="H2896"\w*.  
\v 16 \w Porque|strong="H3588"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w niño|strong="H5288"\w* \w sepa|strong="H3045"\w* rechazar lo \w malo|strong="H7451"\w* \w y|strong="H3588"\w* elegir lo \w bueno|strong="H2896"\w*, \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w dos|strong="H8147"\w* \w reyes|strong="H4428"\w* \w que|strong="H3588"\w* tú temes quedará \w abandonada|strong="H5800"\w*.  
\v 17 Yahvé traerá \w sobre|strong="H5921"\w* \w ti|strong="H5921"\w*, \w sobre|strong="H5921"\w* tu \w pueblo|strong="H5971"\w* \w y|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* tu padre, \w días|strong="H3117"\w* \w como|strong="H5921"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* han visto \w desde|strong="H5921"\w* \w que|strong="H3808"\w* Efraín \w se|strong="H5921"\w* separó \w de|strong="H5921"\w* \w Judá|strong="H3063"\w*; traerá \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria”.   
\p
\v 18 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w sucederá|strong="H1961"\w* \w que|strong="H1931"\w* Yahvé les \w silbará|strong="H8319"\w* \w a|strong="H3068"\w* las moscas \w que|strong="H1931"\w* \w están|strong="H1961"\w* en \w los|strong="H1931"\w* bordes de \w los|strong="H1931"\w* \w ríos|strong="H2975"\w* de \w Egipto|strong="H4714"\w*, y \w a|strong="H3068"\w* las abejas \w que|strong="H1931"\w* \w están|strong="H1961"\w* en \w la|strong="H1931"\w* tierra de Asiria.  
\v 19 Ellas vendrán y se posarán \w todas|strong="H3605"\w* en \w los|strong="H3605"\w* valles desolados, en las grietas de las rocas, en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* matorrales de espinas y en \w todos|strong="H3605"\w* \w los|strong="H3605"\w* pastos.   
\p
\v 20 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* Señor usará \w al|strong="H4428"\w* \w rey|strong="H4428"\w* de Asiria \w como|strong="H1571"\w* una \w navaja|strong="H8593"\w* alquilada \w al|strong="H4428"\w* otro \w lado|strong="H5676"\w* del \w río|strong="H5104"\w* Éufrates, para afeitarles \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* \w y|strong="H1571"\w* \w el|strong="H1931"\w* vello de las piernas, \w y|strong="H1571"\w* \w hasta|strong="H3117"\w* para quitarles \w la|strong="H1931"\w* \w barba|strong="H2206"\w*.   
\p
\v 21 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, un hombre criará una vaca joven \w y|strong="H1241"\w* \w dos|strong="H8147"\w* \w ovejas|strong="H6629"\w*;  
\v 22 \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* \w abundancia|strong="H7230"\w* \w de|strong="H3588"\w* \w leche|strong="H2461"\w* \w que|strong="H3588"\w* den, comerá cuajada. \w Así|strong="H3588"\w* \w que|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* queden \w en|strong="H3588"\w* \w el|strong="H3588"\w* país comerán cuajada \w y|strong="H3588"\w* \w miel|strong="H1706"\w*.   
\p
\v 23 También \w sucederá|strong="H1961"\w* en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w que|strong="H1931"\w* \w todo|strong="H3605"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8033"\w* \w había|strong="H1961"\w* mil \w vides|strong="H1612"\w* \w que|strong="H1931"\w* valían mil \w monedas|strong="H3701"\w* de \w plata|strong="H3701"\w*,\f + \fr 7:23 \ft Un siclo equivale a unos 10 gramos o unas 0,35 onzas, por lo que 1000 siclos equivalen a unos 10 kilogramos o 22 libras.\f* \w se|strong="H1961"\w* llenará de \w espinos|strong="H8068"\w* y \w cardos|strong="H8068"\w*.  
\v 24 \w La|strong="H3588"\w* gente \w tendrá|strong="H1961"\w* \w que|strong="H3588"\w* ir \w allá|strong="H8033"\w* \w con|strong="H3588"\w* \w arco|strong="H7198"\w* \w y|strong="H3588"\w* flecha, \w porque|strong="H3588"\w* \w todo|strong="H3605"\w* \w el|strong="H3588"\w* país \w será|strong="H1961"\w* un matorral \w de|strong="H3588"\w* \w espinos|strong="H8068"\w* \w y|strong="H3588"\w* \w cardos|strong="H8068"\w*.  
\v 25 \w Y|strong="H3068"\w* por miedo \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w espinos|strong="H8068"\w* \w y|strong="H7794"\w* \w cardos|strong="H8068"\w*, ustedes ya \w no|strong="H3808"\w* irán \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w montes|strong="H2022"\w* \w que|strong="H3808"\w* antes \w se|strong="H1961"\w* cultivaban con azadón; esos lugares \w se|strong="H1961"\w* volverán pasto \w para|strong="H1961"\w* \w los|strong="H3605"\w* \w bueyes|strong="H7794"\w* \w y|strong="H7794"\w* \w para|strong="H1961"\w* \w que|strong="H3808"\w* \w los|strong="H3605"\w* pisen las ovejas”.   
\c 8  
\p
\v 1 Yahvé \w me|strong="H5921"\w* dijo: “\w Toma|strong="H3947"\w* una tabla \w grande|strong="H1419"\w* \w y|strong="H5921"\w* \w escribe|strong="H3789"\w* \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w con|strong="H5921"\w* caracteres comunes: ‘\w Para|strong="H5921"\w* Maher-salal-has-baz’”; \f + \fr 8:1 \ft “Maher-salal-has-baz” significa “rápido al saqueo, veloz al botín”.\f*  
\v 2 y busqué como \w testigos|strong="H5707"\w* confiables al \w sacerdote|strong="H3548"\w* Urías y \w a|strong="H3068"\w* \w Zacarías|strong="H2148"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Jeberequías.   
\p
\v 3 Luego me uní \w a|strong="H3068"\w* la \w profetisa|strong="H5031"\w*, y ella \w concibió|strong="H2029"\w* y dio \w a|strong="H3068"\w* luz un \w hijo|strong="H1121"\w*. Entonces Yahvé me dijo: “\w Ponle|strong="H7121"\w* por \w nombre|strong="H8034"\w* Maher-salal-has-baz.  
\v 4 \w Porque|strong="H3588"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w niño|strong="H5288"\w* \w sepa|strong="H3045"\w* \w decir|strong="H7121"\w* ‘papá’ \w o|strong="H3068"\w* ‘mamá’, las \w riquezas|strong="H2428"\w* \w de|strong="H3588"\w* \w Damasco|strong="H1834"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* botín \w de|strong="H3588"\w* \w Samaria|strong="H8111"\w* serán llevados \w ante|strong="H6440"\w* \w el|strong="H3588"\w* \w rey|strong="H4428"\w* \w de|strong="H3588"\w* Asiria”.   
\p
\v 5 Yahvé \w volvió|strong="H3254"\w* \w a|strong="H3068"\w* hablarme, \w diciendo|strong="H1696"\w*:  
\v 6 “\w Como|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* rechazó las \w aguas|strong="H4325"\w* \w de|strong="H3588"\w* Siloé, \w que|strong="H3588"\w* fluyen suavemente, \w y|strong="H3588"\w* \w se|strong="H5971"\w* alegró \w con|strong="H3588"\w* \w Rezín|strong="H7526"\w* \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w hijo|strong="H1121"\w* \w de|strong="H3588"\w* Remalías,  
\v 7 \w por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w el|strong="H5921"\w* Señor \w está|strong="H3651"\w* \w por|strong="H5921"\w* traer \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w* caudalosas \w y|strong="H5921"\w* poderosas \w del|strong="H5921"\w* \w río|strong="H5104"\w* Éufrates: \w al|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria \w con|strong="H5921"\w* \w todo|strong="H3605"\w* su poder. \w Se|strong="H5921"\w* desbordará \w por|strong="H5921"\w* \w todos|strong="H3605"\w* sus canales \w y|strong="H5921"\w* cubrirá \w todas|strong="H3605"\w* sus orillas.  
\v 8 \w Pasará|strong="H5674"\w* \w por|strong="H5704"\w* \w Judá|strong="H3063"\w*, la \w inundará|strong="H7857"\w* \w y|strong="H5704"\w* seguirá \w adelante|strong="H5704"\w* \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w el|strong="H5674"\w* agua le llegue \w al|strong="H5704"\w* \w cuello|strong="H6677"\w*. \w El|strong="H5674"\w* despliegue \w de|strong="H5704"\w* sus \w alas|strong="H3671"\w* cubrirá toda tu tierra, oh Emanuel.   
\p
\v 9 ¡Júntense, \w pueblos|strong="H5971"\w*, y serán destrozados! Escuchen, naciones lejanas: ¡prepárense \w para|strong="H5971"\w* \w la|strong="H3605"\w* batalla y sean destrozadas! ¡Ármense \w para|strong="H5971"\w* \w la|strong="H3605"\w* pelea y sean destruidas!  
\v 10 Tracen sus planes, \w pero|strong="H3588"\w* fracasarán; digan \w lo|strong="H1697"\w* \w que|strong="H3588"\w* quieran, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* cumplirá, \w porque|strong="H3588"\w* Dios \w está|strong="H6965"\w* \w con|strong="H5973"\w* \w nosotros|strong="H5973"\w*”.   
\p
\v 11 \w Porque|strong="H3588"\w* Yahvé \w me|strong="H3588"\w* habló \w con|strong="H3588"\w* \w mano|strong="H3027"\w* fuerte \w y|strong="H3588"\w* \w me|strong="H3588"\w* advirtió \w que|strong="H3588"\w* \w no|strong="H3588"\w* siguiera \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*. \w Me|strong="H3588"\w* dijo:  
\v 12 “\w No|strong="H3808"\w* llamen conspiración \w a|strong="H3068"\w* \w todo|strong="H3605"\w* \w lo|strong="H2088"\w* \w que|strong="H3808"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* llama conspiración. \w No|strong="H3808"\w* \w teman|strong="H3372"\w* \w a|strong="H3068"\w* \w lo|strong="H2088"\w* \w que|strong="H3808"\w* \w ellos|strong="H3605"\w* \w temen|strong="H3372"\w*, \w ni|strong="H3808"\w* \w se|strong="H3808"\w* asusten.  
\v 13 \w A|strong="H3068"\w* Yahvé de \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w* \w es|strong="H1931"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* deben santificar; \w a|strong="H3068"\w* \w él|strong="H1931"\w* \w es|strong="H1931"\w* \w a|strong="H3068"\w* \w quien|strong="H1931"\w* deben temer, ante \w él|strong="H1931"\w* deben temblar.  
\v 14 \w Él|strong="H3427"\w* \w será|strong="H1961"\w* un \w santuario|strong="H4720"\w*, pero \w para|strong="H1961"\w* las \w dos|strong="H8147"\w* \w casas|strong="H1004"\w* de \w Israel|strong="H3478"\w* \w será|strong="H1961"\w* una piedra de \w tropiezo|strong="H4383"\w* y una \w roca|strong="H6697"\w* de caída; \w para|strong="H1961"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Jerusalén \w será|strong="H1961"\w* una trampa y una red.  
\v 15 \w Muchos|strong="H7227"\w* de ellos \w tropezarán|strong="H3782"\w*, \w caerán|strong="H5307"\w* y serán quebrantados; quedarán atrapados y serán capturados”.   
\p
\v 16 \w Ata|strong="H6887"\w* el testimonio y \w sella|strong="H2856"\w* la \w ley|strong="H8451"\w* entre mis discípulos.  
\v 17 \w Esperaré|strong="H2442"\w* en Yahvé, quien ahora \w esconde|strong="H5641"\w* su \w rostro|strong="H6440"\w* \w de|strong="H6440"\w* la \w familia|strong="H1004"\w* \w de|strong="H6440"\w* \w Jacob|strong="H3290"\w*; en él pondré mi esperanza.  
\v 18 \w Aquí|strong="H2009"\w* estamos, \w yo|strong="H2009"\w* y \w los|strong="H5973"\w* \w hijos|strong="H3206"\w* que Yahvé \w me|strong="H5973"\w* \w dio|strong="H5414"\w*; somos señales y \w prodigios|strong="H4159"\w* \w en|strong="H5973"\w* \w Israel|strong="H3478"\w* \w de|strong="H5973"\w* parte \w de|strong="H5973"\w* Yahvé \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w Ejércitos|strong="H6635"\w*, que \w habita|strong="H7931"\w* \w en|strong="H5973"\w* \w el|strong="H5973"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w*.   
\p
\v 19 \w Si|strong="H3588"\w* les dicen: “Consulten \w a|strong="H3068"\w* \w los|strong="H3588"\w* médiums \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w adivinos|strong="H3049"\w* \w que|strong="H3588"\w* susurran \w y|strong="H3588"\w* hablan \w entre|strong="H3808"\w* dientes”, respondan: ¿Acaso \w no|strong="H3808"\w* debe un \w pueblo|strong="H5971"\w* consultar \w a|strong="H3068"\w* \w su|strong="H3588"\w* Dios? ¿\w Por|strong="H3588"\w* \w qué|strong="H3588"\w* consultar \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w muertos|strong="H4191"\w* \w por|strong="H3588"\w* \w los|strong="H3588"\w* \w vivos|strong="H2416"\w*?  
\v 20 ¡Vuelvan \w a|strong="H3068"\w* la \w ley|strong="H8451"\w* y al testimonio! \w Si|strong="H3808"\w* \w no|strong="H3808"\w* dicen \w esto|strong="H2088"\w*, \w es|strong="H2088"\w* \w porque|strong="H3808"\w* para ellos \w no|strong="H3808"\w* \w ha|strong="H3808"\w* amanecido.  
\v 21 \w Pasarán|strong="H5674"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* tierra angustiados \w y|strong="H3588"\w* \w con|strong="H3588"\w* \w hambre|strong="H7456"\w*; \w y|strong="H3588"\w* \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w hambre|strong="H7456"\w* \w se|strong="H1961"\w* enfurecerán \w y|strong="H3588"\w* maldecirán \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w rey|strong="H4428"\w* \w y|strong="H3588"\w* \w a|strong="H3068"\w* \w su|strong="H3588"\w* Dios, \w mirando|strong="H6437"\w* hacia \w arriba|strong="H4605"\w*.  
\v 22 Después mirarán hacia la tierra y solo verán \w tribulación|strong="H6869"\w*, tinieblas y \w oscuridad|strong="H4588"\w* angustiosa; y serán arrojados \w a|strong="H3068"\w* las tinieblas más densas.   
\c 9  
\p
\v 1 Pero \w no|strong="H5921"\w* habrá \w más|strong="H5921"\w* \w oscuridad|strong="H2822"\w* \w para|strong="H5921"\w* \w la|strong="H5921"\w* \w que|strong="H5921"\w* \w estaba|strong="H3427"\w* angustiada. \w En|strong="H5921"\w* \w el|strong="H5921"\w* pasado, \w él|strong="H5921"\w* humilló \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Zabulón \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Neftalí; pero \w en|strong="H5921"\w* \w el|strong="H5921"\w* futuro llenará \w de|strong="H5921"\w* gloria \w el|strong="H5921"\w* \w camino|strong="H1980"\w* \w del|strong="H5921"\w* mar, \w al|strong="H5921"\w* otro lado \w del|strong="H5921"\w* Jordán, \w en|strong="H5921"\w* \w la|strong="H5921"\w* Galilea \w de|strong="H5921"\w* \w las|strong="H5921"\w* naciones.   
\p
\v 2 El pueblo \w que|strong="H3808"\w* caminaba en la oscuridad vio una \w gran|strong="H7235"\w* luz;  
\q2 la luz resplandeció sobre los \w que|strong="H3808"\w* vivían en la tierra \w de|strong="H6440"\w* sombras \w de|strong="H6440"\w* muerte.   
\q1
\v 3 Multiplicaste \w la|strong="H3588"\w* nación  
\q2 \w y|strong="H3588"\w* aumentaste \w su|strong="H3588"\w* alegría.  
\p Se alegran \w en|strong="H3588"\w* tu presencia \w como|strong="H3588"\w* se alegran \w en|strong="H3588"\w* \w la|strong="H3588"\w* cosecha, \w como|strong="H3588"\w* se regocijan \w los|strong="H3588"\w* hombres \w cuando|strong="H3588"\w* se reparten \w el|strong="H3588"\w* botín.  
\v 4 \w Porque|strong="H3588"\w* tú rompiste \w el|strong="H3588"\w* pesado yugo \w que|strong="H3588"\w* \w los|strong="H3605"\w* oprimía, \w la|strong="H3588"\w* vara \w que|strong="H3588"\w* castigaba sus hombros \w y|strong="H3588"\w* \w el|strong="H3588"\w* látigo del opresor, \w como|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* día \w de|strong="H3588"\w* \w la|strong="H3588"\w* derrota \w de|strong="H3588"\w* Madián.  
\v 5 \w Porque|strong="H3588"\w* todas \w las|strong="H5921"\w* botas \w de|strong="H5921"\w* \w los|strong="H1121"\w* guerreros \w que|strong="H3588"\w* marchan \w con|strong="H5921"\w* estrépito, \w y|strong="H3588"\w* \w la|strong="H5921"\w* ropa revolcada \w en|strong="H5921"\w* sangre, \w serán|strong="H1961"\w* quemadas \w en|strong="H5921"\w* \w el|strong="H5921"\w* fuego.  
\v 6 \w Porque|strong="H5921"\w* \w nos|strong="H5921"\w* ha nacido un niño, \w se|strong="H5921"\w* \w nos|strong="H5921"\w* ha dado un hijo, \w y|strong="H5921"\w* \w él|strong="H5921"\w* tendrá \w el|strong="H5921"\w* gobierno \w sobre|strong="H5921"\w* sus hombros. \w Se|strong="H5921"\w* \w le|strong="H5921"\w* \w darán|strong="H6213"\w* \w estos|strong="H2063"\w* nombres: Admirable Consejero, \w Dios|strong="H3068"\w* Poderoso, Padre \w Eterno|strong="H5769"\w*, Príncipe \w de|strong="H5921"\w* \w Paz|strong="H7965"\w*.  
\v 7 Su soberanía y su paz aumentarán \w de|strong="H1697"\w* continuo y no tendrán fin. Reinará sobre \w el|strong="H5307"\w* trono \w de|strong="H1697"\w* David y sobre su reino, para establecerlo y sostenerlo con justicia y rectitud desde ahora y para siempre. \w El|strong="H5307"\w* celo \w de|strong="H1697"\w* Yahvé \w de|strong="H1697"\w* los Ejércitos \w lo|strong="H1697"\w* llevará \w a|strong="H3068"\w* cabo.   
\p
\v 8 \w El|strong="H3605"\w* Señor envió una palabra contra Jacob,  
\q2 y \w la|strong="H3605"\w* palabra alcanzó \w a|strong="H3068"\w* Israel.   
\q1
\v 9 Todo \w el|strong="H5307"\w* pueblo lo sabrá,  
\q2 incluso Efraín y los habitantes de Samaria, que dicen con orgullo y arrogancia de corazón:   
\q1
\v 10 “\w Los|strong="H5921"\w* ladrillos \w se|strong="H5921"\w* cayeron,  
\q2 pero reconstruiremos \w con|strong="H5921"\w* piedras talladas;  
\q1 cortaron \w las|strong="H5921"\w* higueras silvestres,  
\q2 pero \w en|strong="H5921"\w* su lugar pondremos cedros”.   
\q1
\v 11 \w Por|strong="H3027"\w* \w eso|strong="H2063"\w* Yahvé fortaleció \w a|strong="H3068"\w* \w los|strong="H3605"\w* adversarios \w de|strong="H5750"\w* Rezín \w contra|strong="H3478"\w* \w Israel|strong="H3478"\w*,  
\q2 \w e|strong="H3068"\w* incitó \w a|strong="H3068"\w* sus enemigos:   
\q2
\v 12 los sirios \w por|strong="H5704"\w* el este  
\q2 \w y|strong="H5704"\w* los filisteos \w por|strong="H5704"\w* el oeste,  
\q2 \w que|strong="H3808"\w* devoraron \w a|strong="H3068"\w* Israel \w a|strong="H3068"\w* boca llena.  
\q1 \w A|strong="H3068"\w* pesar \w de|strong="H5704"\w* todo esto, su ira \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* calmado;  
\q2 su mano sigue extendida \w para|strong="H5704"\w* castigar.   
\b  
\q1
\v 13 Pero el pueblo no se volvió al \w que|strong="H3117"\w* lo castigaba,  
\q2 ni buscaron \w a|strong="H3068"\w* Yahvé de los Ejércitos.   
\q1
\v 14 \w Por|strong="H6440"\w* \w eso|strong="H1931"\w* Yahvé \w le|strong="H1931"\w* cortará \w a|strong="H3068"\w* Israel \w la|strong="H1931"\w* \w cabeza|strong="H7218"\w* y \w la|strong="H1931"\w* \w cola|strong="H2180"\w*,  
\q2 \w la|strong="H1931"\w* palma y \w el|strong="H1931"\w* junco en un \w solo|strong="H1931"\w* día.   
\q1
\v 15 El anciano y el hombre respetable \w son|strong="H1961"\w* la cabeza,  
\q2 y el profeta \w que|strong="H5971"\w* enseña mentiras \w es|strong="H1961"\w* la cola.   
\q1
\v 16 \w Porque|strong="H3588"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* guían \w a|strong="H3068"\w* \w este|strong="H2063"\w* pueblo \w lo|strong="H3808"\w* extravían,  
\q2 \w y|strong="H3588"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* \w se|strong="H5921"\w* dejan guiar \w son|strong="H3588"\w* destruidos.   
\q1
\v 17 \w Por|strong="H3588"\w* tanto, \w el|strong="H3588"\w* Señor \w no|strong="H3588"\w* se complacerá \w en|strong="H3588"\w* sus jóvenes,  
\q2 ni tendrá compasión \w de|strong="H3588"\w* sus huérfanos \w y|strong="H3588"\w* viudas;  
\q1 \w porque|strong="H3588"\w* todos \w son|strong="H3588"\w* impíos \w y|strong="H3588"\w* malhechores,  
\q2 \w y|strong="H3588"\w* toda boca habla necedades.  
\q1 \w A|strong="H3068"\w* pesar \w de|strong="H3588"\w* todo esto, \w su|strong="H3588"\w* ira \w no|strong="H3588"\w* se ha calmado;  
\q2 \w su|strong="H3588"\w* mano sigue extendida \w para|strong="H3588"\w* castigar.   
\b  
\q1
\v 18 \w Porque|strong="H3808"\w* la maldad arde \w como|strong="H1961"\w* el fuego:  
\q2 devora espinos y cardos,  
\q2 incendia la espesura del bosque,  
\q2 y todo \w se|strong="H1961"\w* alza en columnas \w de|strong="H5971"\w* humo.   
\q1
\v 19 \w Por|strong="H5921"\w* \w la|strong="H5921"\w* ira \w de|strong="H5921"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* Ejércitos, \w la|strong="H5921"\w* tierra quedó quemada  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* pueblo \w se|strong="H5921"\w* volvió combustible \w para|strong="H5921"\w* \w el|strong="H5921"\w* fuego;  
\q2 \w nadie|strong="H3808"\w* tiene piedad \w de|strong="H5921"\w* su propio hermano.   
\q1
\v 20 Muerden \w a|strong="H3068"\w* \w la|strong="H5921"\w* derecha \w y|strong="H5921"\w* siguen \w con|strong="H5921"\w* hambre;  
\q2 comen \w a|strong="H3068"\w* \w la|strong="H5921"\w* izquierda \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* quedan satisfechos.  
\q1 \w Cada|strong="H3605"\w* uno come \w la|strong="H5921"\w* carne \w de|strong="H5921"\w* \w su|strong="H1992"\w* propio brazo:   
\q2
\v 21 Manasés devora \w a|strong="H3068"\w* Efraín, Efraín \w a|strong="H3068"\w* Manasés, y ambos se vuelven contra Judá.  
\q1 \w A|strong="H3068"\w* pesar de todo esto, su ira no se ha calmado;  
\q2 su mano sigue extendida para castigar.   
\c 10  
\p
\v 1 ¡\w Ay|strong="H1945"\w* de los que dictan leyes injustas y de los que registran decretos opresivos!  
\v 2 Lo hacen \w para|strong="H1961"\w* negarles \w justicia|strong="H4941"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* necesitados y \w para|strong="H1961"\w* robarles sus \w derechos|strong="H4941"\w* \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w pobres|strong="H1800"\w* \w de|strong="H5971"\w* \w mi|strong="H1961"\w* \w pueblo|strong="H5971"\w*; \w para|strong="H1961"\w* hacer \w de|strong="H5971"\w* las viudas su botín y despojar \w a|strong="H3068"\w* \w los|strong="H1961"\w* \w huérfanos|strong="H3490"\w*.  
\v 3 ¿\w Qué|strong="H4100"\w* \w harán|strong="H6213"\w* ustedes \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w del|strong="H5921"\w* castigo, \w cuando|strong="H3117"\w* \w la|strong="H5921"\w* destrucción venga \w de|strong="H5921"\w* lejos? ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* acudirán \w en|strong="H5921"\w* busca \w de|strong="H5921"\w* \w ayuda|strong="H5833"\w*? ¿\w Dónde|strong="H5921"\w* dejarán sus tesoros?   
\p
\v 4 \w No|strong="H3808"\w* les quedará \w más|strong="H5750"\w* \w que|strong="H3808"\w* encorvarse \w entre|strong="H3808"\w* \w los|strong="H3605"\w* presos  
\q2 \w o|strong="H3068"\w* \w caer|strong="H5307"\w* \w entre|strong="H3808"\w* \w los|strong="H3605"\w* muertos.  
\q1 \w A|strong="H3068"\w* pesar \w de|strong="H8478"\w* \w todo|strong="H3605"\w* \w esto|strong="H2063"\w*, su ira \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w ha|strong="H3808"\w* calmado;  
\q2 su \w mano|strong="H3027"\w* sigue \w extendida|strong="H5186"\w* para castigar.   
\b  
\p
\v 5 “¡\w Ay|strong="H1945"\w* de Asiria, \w vara|strong="H4294"\w* de mi ira! \w El|strong="H1931"\w* palo \w que|strong="H1931"\w* lleva en \w su|strong="H1931"\w* \w mano|strong="H3027"\w* \w es|strong="H1931"\w* mi indignación.  
\v 6 \w Yo|strong="H6680"\w* \w la|strong="H5921"\w* \w envío|strong="H7971"\w* \w contra|strong="H5921"\w* una \w nación|strong="H1471"\w* impía; \w la|strong="H5921"\w* \w mando|strong="H6680"\w* \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w que|strong="H5921"\w* \w me|strong="H5921"\w* enfurece, \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* saquee \w y|strong="H5921"\w* \w le|strong="H5921"\w* arrebate \w el|strong="H5921"\w* botín, \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* \w lo|strong="H5921"\w* pisotee \w como|strong="H5921"\w* \w al|strong="H5921"\w* lodo \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w calles|strong="H2351"\w*.  
\v 7 \w Pero|strong="H3588"\w* \w ella|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* propone \w esto|strong="H3651"\w*, \w ni|strong="H3808"\w* \w su|strong="H1931"\w* \w corazón|strong="H3824"\w* \w lo|strong="H1931"\w* \w piensa|strong="H2803"\w* \w así|strong="H3651"\w*; \w su|strong="H1931"\w* intención \w es|strong="H1931"\w* \w destruir|strong="H8045"\w* \w y|strong="H3588"\w* exterminar \w a|strong="H3068"\w* muchas \w naciones|strong="H1471"\w*.  
\v 8 \w Pues|strong="H3588"\w* dice: ‘¿Acaso mis \w jefes|strong="H8269"\w* \w no|strong="H3808"\w* \w son|strong="H3588"\w* \w todos|strong="H3162"\w* \w reyes|strong="H4428"\w*?  
\v 9 ¿\w No|strong="H3808"\w* es Calno como Carquemis? ¿\w No|strong="H3808"\w* es Hamat como Arpad? ¿\w No|strong="H3808"\w* es \w Samaria|strong="H8111"\w* como \w Damasco|strong="H1834"\w*?  
\v 10 Así como \w mi|strong="H3389"\w* \w mano|strong="H3027"\w* alcanzó los \w reinos|strong="H4467"\w* de los \w ídolos|strong="H6456"\w*, cuyas imágenes eran más numerosas \w que|strong="H3027"\w* las de Jerusalén y \w Samaria|strong="H8111"\w*,  
\v 11 ¿acaso \w no|strong="H3808"\w* \w haré|strong="H6213"\w* con Jerusalén y sus imágenes \w lo|strong="H3808"\w* mismo \w que|strong="H3808"\w* \w hice|strong="H6213"\w* con \w Samaria|strong="H8111"\w* y sus \w ídolos|strong="H6091"\w*?’”.   
\p
\v 12 \w Por|strong="H5921"\w* \w tanto|strong="H5921"\w*, \w sucederá|strong="H1961"\w* \w que|strong="H3588"\w* \w cuando|strong="H3588"\w* \w el|strong="H5921"\w* Señor \w haya|strong="H1961"\w* terminado \w toda|strong="H3605"\w* \w su|strong="H3588"\w* \w obra|strong="H4639"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w* \w y|strong="H3588"\w* \w en|strong="H5921"\w* Jerusalén, castigará \w el|strong="H5921"\w* \w fruto|strong="H6529"\w* \w del|strong="H5921"\w* orgullo \w del|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Asiria \w y|strong="H3588"\w* \w la|strong="H5921"\w* arrogancia \w de|strong="H5921"\w* \w su|strong="H3588"\w* mirada.  
\v 13 \w Porque|strong="H3588"\w* \w él|strong="H3588"\w* ha dicho: “\w Lo|strong="H6213"\w* \w hice|strong="H6213"\w* \w con|strong="H3588"\w* \w el|strong="H3588"\w* \w poder|strong="H3581"\w* \w de|strong="H3588"\w* mi \w mano|strong="H3027"\w* \w y|strong="H3588"\w* \w con|strong="H3588"\w* mi \w sabiduría|strong="H2451"\w*, \w porque|strong="H3588"\w* soy inteligente. Cambié las fronteras \w de|strong="H3588"\w* \w los|strong="H3427"\w* \w pueblos|strong="H5971"\w*, les robé sus tesoros \w y|strong="H3588"\w*, \w como|strong="H3588"\w* un valiente, derribé \w a|strong="H3068"\w* sus gobernantes.  
\v 14 \w Como|strong="H1961"\w* \w quien|strong="H3605"\w* mete \w la|strong="H3605"\w* \w mano|strong="H3027"\w* en un \w nido|strong="H7064"\w*, así alcancé las \w riquezas|strong="H2428"\w* \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w*; \w como|strong="H1961"\w* \w quien|strong="H3605"\w* recoge huevos abandonados, así me apoderé \w de|strong="H5971"\w* \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra. \w No|strong="H3808"\w* \w hubo|strong="H1961"\w* \w nadie|strong="H3808"\w* \w que|strong="H3808"\w* moviera un \w ala|strong="H3671"\w*, \w ni|strong="H3808"\w* \w que|strong="H3808"\w* abriera \w el|strong="H3605"\w* pico, \w ni|strong="H3808"\w* \w que|strong="H3808"\w* chillara”.   
\p
\v 15 ¿Acaso \w el|strong="H5921"\w* hacha \w se|strong="H5921"\w* jacta \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H3808"\w* corta \w con|strong="H5921"\w* \w ella|strong="H5921"\w*? ¿\w O|strong="H3068"\w* \w la|strong="H5921"\w* sierra \w se|strong="H5921"\w* cree \w más|strong="H5921"\w* \w que|strong="H3808"\w* \w el|strong="H5921"\w* \w que|strong="H3808"\w* \w la|strong="H5921"\w* mueve? ¡\w Como|strong="H5921"\w* \w si|strong="H3808"\w* \w la|strong="H5921"\w* \w vara|strong="H4294"\w* pudiera mover \w al|strong="H5921"\w* \w que|strong="H3808"\w* \w la|strong="H5921"\w* \w levanta|strong="H7311"\w*, \w o|strong="H3068"\w* \w el|strong="H5921"\w* bastón levantar \w al|strong="H5921"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* es \w de|strong="H5921"\w* \w madera|strong="H6086"\w*!  
\v 16 \w Por|strong="H8478"\w* \w eso|strong="H3651"\w* el \w Señor|strong="H3068"\w*, Yahvé \w de|strong="H8478"\w* los \w Ejércitos|strong="H6635"\w*, \w enviará|strong="H7971"\w* una enfermedad que consumirá \w a|strong="H3068"\w* sus guerreros fuertes; \w y|strong="H3519"\w* \w bajo|strong="H8478"\w* su esplendor \w encenderá|strong="H3344"\w* un fuego \w como|strong="H3651"\w* una hoguera.  
\v 17 \w La|strong="H1197"\w* luz de \w Israel|strong="H3478"\w* \w se|strong="H1961"\w* convertirá en fuego, \w y|strong="H1197"\w* su \w Santo|strong="H6918"\w* en \w llama|strong="H3852"\w*, \w que|strong="H3117"\w* en un solo \w día|strong="H3117"\w* quemará \w y|strong="H1197"\w* devorará sus \w cardos|strong="H8068"\w* \w y|strong="H1197"\w* \w espinos|strong="H8068"\w*.  
\v 18 Él \w consumirá|strong="H3615"\w* \w por|strong="H5704"\w* completo la \w gloria|strong="H3519"\w* \w de|strong="H5704"\w* su \w bosque|strong="H3293"\w* \w y|strong="H5704"\w* \w de|strong="H5704"\w* su campo fértil, tanto el \w alma|strong="H5315"\w* \w como|strong="H1961"\w* el cuerpo; \w será|strong="H1961"\w* \w como|strong="H1961"\w* \w cuando|strong="H5704"\w* un enfermo \w se|strong="H1961"\w* \w va|strong="H3068"\w* debilitando.  
\v 19 \w Los|strong="H1961"\w* \w árboles|strong="H6086"\w* \w que|strong="H1961"\w* queden en su \w bosque|strong="H3293"\w* \w serán|strong="H1961"\w* tan \w pocos|strong="H4557"\w* \w que|strong="H1961"\w* hasta un \w niño|strong="H5288"\w* podrá contarlos.   
\p
\v 20 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* resto \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H1931"\w* hayan escapado \w de|strong="H5921"\w* \w la|strong="H1931"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Jacob|strong="H3290"\w* \w ya|strong="H3254"\w* \w no|strong="H3808"\w* \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* apoyarse \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w que|strong="H1931"\w* \w los|strong="H5921"\w* golpeó, \w sino|strong="H3808"\w* \w que|strong="H1931"\w* \w se|strong="H1961"\w* apoyarán \w con|strong="H5921"\w* verdad \w en|strong="H5921"\w* Yahvé, \w el|strong="H1931"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 21 Un resto \w volverá|strong="H7725"\w*; el resto de \w Jacob|strong="H3290"\w* \w volverá|strong="H7725"\w* al Dios \w fuerte|strong="H1368"\w*.  
\v 22 \w Israel|strong="H3478"\w*, \w aunque|strong="H3588"\w* tu \w pueblo|strong="H5971"\w* \w sea|strong="H1961"\w* \w como|strong="H3588"\w* \w la|strong="H3588"\w* arena del \w mar|strong="H3220"\w*, solo un resto \w de|strong="H3588"\w* \w él|strong="H3588"\w* \w volverá|strong="H7725"\w*. \w Se|strong="H1961"\w* ha decretado una destrucción \w que|strong="H3588"\w* rebosa \w justicia|strong="H6666"\w*.  
\v 23 \w Pues|strong="H3588"\w* \w el|strong="H3588"\w* Señor, Yahvé \w de|strong="H3588"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w*, \w ejecutará|strong="H6213"\w* \w la|strong="H3588"\w* destrucción decretada \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra.   
\p
\v 24 \w Por|strong="H5921"\w* \w tanto|strong="H3651"\w*, \w así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor, Yahvé \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w Ejércitos|strong="H6635"\w*: “\w Pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*, \w que|strong="H5921"\w* vives \w en|strong="H5921"\w* \w Sión|strong="H6726"\w*, \w no|strong="H5921"\w* \w le|strong="H5921"\w* tengas \w miedo|strong="H3372"\w* \w a|strong="H3068"\w* Asiria. \w Ella|strong="H5921"\w* \w te|strong="H5921"\w* golpeará \w con|strong="H5921"\w* su \w vara|strong="H4294"\w* \w y|strong="H5921"\w* \w alzará|strong="H5375"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* su bastón, \w como|strong="H5921"\w* \w lo|strong="H5921"\w* hizo \w Egipto|strong="H4714"\w*.  
\v 25 \w Porque|strong="H3588"\w* \w dentro|strong="H5750"\w* \w de|strong="H5921"\w* muy \w poco|strong="H4592"\w* \w tiempo|strong="H4213"\w* \w mi|strong="H5921"\w* indignación \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* cesará, \w y|strong="H3588"\w* \w mi|strong="H5921"\w* ira \w se|strong="H5921"\w* dirigirá \w a|strong="H3068"\w* \w la|strong="H5921"\w* destrucción \w de|strong="H5921"\w* \w ellos|strong="H5921"\w*”.  
\v 26 Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* agitará su látigo \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w*, \w como|strong="H5921"\w* cuando hirió \w a|strong="H3068"\w* \w Madián|strong="H4080"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* \w roca|strong="H6697"\w* \w de|strong="H5921"\w* \w Oreb|strong="H6159"\w*; \w y|strong="H5921"\w* \w alzará|strong="H5375"\w* su \w vara|strong="H4294"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w*, \w como|strong="H5921"\w* \w lo|strong="H5921"\w* hizo \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\v 27 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w la|strong="H1931"\w* \w carga|strong="H5448"\w* \w de|strong="H5921"\w* \w ellos|strong="H1931"\w* \w será|strong="H1961"\w* quitada \w de|strong="H5921"\w* tus \w hombros|strong="H7926"\w* \w y|strong="H5921"\w* \w su|strong="H1931"\w* \w yugo|strong="H5923"\w* \w de|strong="H5921"\w* tu \w cuello|strong="H6677"\w*; \w el|strong="H1931"\w* \w yugo|strong="H5923"\w* \w se|strong="H1961"\w* romperá \w por|strong="H5921"\w* \w causa|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* bendición.   
\p
\v 28 \w El|strong="H5921"\w* enemigo llegó \w a|strong="H3068"\w* Ajat, \w pasó|strong="H5674"\w* \w por|strong="H5921"\w* \w Migrón|strong="H4051"\w* \w y|strong="H5921"\w* \w en|strong="H5921"\w* Micmas dejó su equipaje.  
\v 29 \w Atravesaron|strong="H5674"\w* \w el|strong="H5674"\w* desfiladero, acamparon en Geba. \w Ramá|strong="H7414"\w* tiembla; \w Gabaa|strong="H1390"\w* de \w Saúl|strong="H7586"\w* \w huyó|strong="H5127"\w*.  
\v 30 ¡\w Grita|strong="H6670"\w* con todas tus fuerzas, \w hija|strong="H1323"\w* de Galim! ¡\w Escucha|strong="H7181"\w*, \w Lais|strong="H3919"\w*! ¡\w Pobre|strong="H6041"\w* de ti, Anatot!  
\v 31 \w Madmena|strong="H4088"\w* huye; \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* de Gebim buscan refugio.  
\v 32 \w Hoy|strong="H3117"\w* mismo se detendrá \w en|strong="H5750"\w* \w Nob|strong="H5011"\w* y amenazará con su puño al \w monte|strong="H2022"\w* \w de|strong="H5750"\w* la \w hija|strong="H1323"\w* \w de|strong="H5750"\w* Sión, \w a|strong="H3068"\w* la colina \w de|strong="H5750"\w* Jerusalén.   
\p
\v 33 Miren, el \w Señor|strong="H3068"\w*, Yahvé de los \w Ejércitos|strong="H6635"\w*, \w desgajará|strong="H5586"\w* las ramas con fuerza terrible. Los árboles más \w altos|strong="H1364"\w* serán talados y los orgullosos serán humillados.  
\v 34 \w Él|strong="H5307"\w* cortará con hacha la espesura del \w bosque|strong="H3293"\w*, y \w el|strong="H5307"\w* \w Líbano|strong="H3844"\w* \w caerá|strong="H5307"\w* ante \w el|strong="H5307"\w* Poderoso.   
\c 11  
\q1
\v 1 Un retoño brotará del tronco de \w Isaí|strong="H3448"\w*,  
\q2 y un vástago de sus \w raíces|strong="H8328"\w* dará fruto.   
\q1
\v 2 \w El|strong="H5921"\w* \w Espíritu|strong="H7307"\w* \w de|strong="H5921"\w* Yahvé \w reposará|strong="H5117"\w* \w sobre|strong="H5921"\w* \w él|strong="H5921"\w*:  
\q2 \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w sabiduría|strong="H2451"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* entendimiento,  
\q2 \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w consejo|strong="H6098"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* poder,  
\q2 \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w conocimiento|strong="H1847"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w temor|strong="H3374"\w* \w de|strong="H5921"\w* Yahvé.   
\q1
\v 3 Su deleite \w será|strong="H3808"\w* el \w temor|strong="H3374"\w* \w de|strong="H5869"\w* Yahvé.  
\q1 \w No|strong="H3808"\w* \w juzgará|strong="H8199"\w* por las apariencias,  
\q2 \w ni|strong="H3808"\w* decidirá por \w lo|strong="H3808"\w* \w que|strong="H3808"\w* oiga decir;   
\q1
\v 4 sino \w que|strong="H6310"\w* \w juzgará|strong="H8199"\w* \w a|strong="H3068"\w* los \w pobres|strong="H1800"\w* con \w justicia|strong="H6664"\w*,  
\q2 y decidirá con equidad \w a|strong="H3068"\w* favor de los humildes de la tierra.  
\q1 \w Herirá|strong="H5221"\w* la tierra con la \w vara|strong="H7626"\w* de su \w boca|strong="H6310"\w*,  
\q2 y con el aliento de sus \w labios|strong="H8193"\w* \w matará|strong="H4191"\w* al malvado.   
\q1
\v 5 La \w justicia|strong="H6664"\w* \w será|strong="H1961"\w* el cinturón de su cintura,  
\q2 y la fidelidad el cinturón de sus \w lomos|strong="H4975"\w*.   
\b  
\q1
\v 6 \w El|strong="H5973"\w* \w lobo|strong="H2061"\w* vivirá \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w cordero|strong="H3532"\w*,  
\q2 y \w el|strong="H5973"\w* leopardo se echará \w con|strong="H5973"\w* \w el|strong="H5973"\w* \w cabrito|strong="H1423"\w*;  
\q2 \w el|strong="H5973"\w* ternero, \w el|strong="H5973"\w* león joven y \w el|strong="H5973"\w* animal engordado andarán \w juntos|strong="H3162"\w*,  
\q2 y \w un|strong="H3162"\w* \w niño|strong="H5288"\w* \w pequeño|strong="H6996"\w* \w los|strong="H5973"\w* guiará.   
\q1
\v 7 La vaca \w y|strong="H1241"\w* la osa pastarán \w juntas|strong="H3162"\w*,  
\q2 sus crías se recostarán \w juntas|strong="H3162"\w*,  
\q2 \w y|strong="H1241"\w* el león comerá \w paja|strong="H8401"\w* como el buey.   
\q1
\v 8 \w El|strong="H5921"\w* niño \w de|strong="H5921"\w* pecho jugará \w cerca|strong="H5921"\w* \w del|strong="H5921"\w* agujero \w de|strong="H5921"\w* \w la|strong="H5921"\w* cobra,  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* recién destetado pondrá su \w mano|strong="H3027"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* nido \w de|strong="H5921"\w* \w la|strong="H5921"\w* víbora.   
\q1
\v 9 \w No|strong="H3808"\w* harán daño \w ni|strong="H3808"\w* destruirán \w en|strong="H3588"\w* \w todo|strong="H3605"\w* mi \w santo|strong="H6944"\w* \w monte|strong="H2022"\w*,  
\q2 \w porque|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w estará|strong="H3605"\w* \w llena|strong="H4390"\w* del \w conocimiento|strong="H1844"\w* \w de|strong="H3588"\w* Yahvé,  
\q2 \w así|strong="H3588"\w* \w como|strong="H3588"\w* las \w aguas|strong="H4325"\w* \w cubren|strong="H3680"\w* \w el|strong="H3588"\w* \w mar|strong="H3220"\w*.   
\b  
\p
\v 10 \w En|strong="H5975"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, las \w naciones|strong="H1471"\w* buscarán \w a|strong="H3068"\w* \w la|strong="H1931"\w* raíz \w de|strong="H5971"\w* \w Isaí|strong="H3448"\w*, \w la|strong="H1931"\w* \w cual|strong="H1931"\w* \w se|strong="H1961"\w* \w levantará|strong="H5251"\w* \w como|strong="H1961"\w* una \w bandera|strong="H5251"\w* \w para|strong="H1961"\w* \w los|strong="H1931"\w* \w pueblos|strong="H5971"\w*; \w y|strong="H3519"\w* \w su|strong="H1931"\w* lugar \w de|strong="H5971"\w* \w descanso|strong="H4496"\w* \w será|strong="H1961"\w* \w glorioso|strong="H3519"\w*.   
\p
\v 11 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w el|strong="H1931"\w* Señor \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* extender \w su|strong="H1931"\w* \w mano|strong="H3027"\w* \w por|strong="H3027"\w* \w segunda|strong="H8145"\w* vez \w para|strong="H1961"\w* rescatar al resto \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w que|strong="H1931"\w* \w haya|strong="H1961"\w* quedado en Asiria, \w Egipto|strong="H4714"\w*, Patros, Cus, \w Elam|strong="H5867"\w*, Sinar, Hamat y en las costas del \w mar|strong="H3220"\w*.  
\v 12 Él \w levantará|strong="H5251"\w* una \w bandera|strong="H5251"\w* para las \w naciones|strong="H1471"\w*, y reunirá \w a|strong="H3068"\w* los desterrados de \w Israel|strong="H3478"\w*; juntará \w a|strong="H3068"\w* los dispersos de \w Judá|strong="H3063"\w* de los cuatro rincones de la tierra.  
\v 13 \w Entonces|strong="H5493"\w* \w se|strong="H3808"\w* acabarán los \w celos|strong="H7065"\w* de Efraín, y los \w que|strong="H3808"\w* persiguen \w a|strong="H3068"\w* \w Judá|strong="H3063"\w* serán exterminados. Efraín \w no|strong="H3808"\w* tendrá \w celos|strong="H7065"\w* de \w Judá|strong="H3063"\w*, \w ni|strong="H3808"\w* \w Judá|strong="H3063"\w* hostigará \w a|strong="H3068"\w* Efraín.  
\v 14 Se lanzarán sobre \w los|strong="H1121"\w* \w hombros|strong="H3802"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w filisteos|strong="H6430"\w* al occidente, y \w juntos|strong="H3162"\w* saquearán \w a|strong="H3068"\w* \w los|strong="H1121"\w* pueblos del \w oriente|strong="H6924"\w*. Edom y \w Moab|strong="H4124"\w* quedarán bajo su \w poder|strong="H3027"\w*, y \w los|strong="H1121"\w* amonitas les obedecerán.  
\v 15 Yahvé secará \w por|strong="H5921"\w* completo \w el|strong="H5921"\w* golfo \w del|strong="H5921"\w* \w mar|strong="H3220"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*; agitará su \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w río|strong="H5104"\w* Éufrates \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w poder|strong="H3027"\w* \w de|strong="H5921"\w* su \w viento|strong="H7307"\w* abrasador, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* dividirá \w en|strong="H5921"\w* \w siete|strong="H7651"\w* \w arroyos|strong="H5158"\w* \w para|strong="H5921"\w* \w que|strong="H5921"\w* puedan cruzarlo \w con|strong="H5921"\w* sus sandalias puestas.  
\v 16 \w Habrá|strong="H1961"\w* un \w camino|strong="H4546"\w* \w para|strong="H1961"\w* el resto \w de|strong="H5971"\w* su \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* \w quedó|strong="H7604"\w* en Asiria, así \w como|strong="H1961"\w* lo \w hubo|strong="H1961"\w* \w para|strong="H1961"\w* \w Israel|strong="H3478"\w* el \w día|strong="H3117"\w* \w que|strong="H5971"\w* \w salió|strong="H5927"\w* \w de|strong="H5971"\w* la tierra \w de|strong="H5971"\w* \w Egipto|strong="H4714"\w*.   
\c 12  
\p
\v 1 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* dirás: “\w Te|strong="H3588"\w* doy gracias, Yahvé; \w porque|strong="H3588"\w* \w aunque|strong="H3588"\w* \w te|strong="H3588"\w* enojaste conmigo, tu ira \w se|strong="H1931"\w* ha calmado \w y|strong="H3588"\w* \w me|strong="H3588"\w* has consolado.  
\v 2 Miren, \w Dios|strong="H3068"\w* \w es|strong="H1961"\w* \w mi|strong="H2009"\w* salvación. Confiaré \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w tendré|strong="H1961"\w* \w miedo|strong="H6342"\w*; \w porque|strong="H3588"\w* \w Yah|strong="H3068"\w*, Yahvé, \w es|strong="H1961"\w* \w mi|strong="H2009"\w* fuerza \w y|strong="H3588"\w* \w mi|strong="H2009"\w* canto; \w él|strong="H3588"\w* \w es|strong="H1961"\w* \w mi|strong="H2009"\w* salvación”.  
\v 3 Con alegría sacarán ustedes \w agua|strong="H4325"\w* \w de|strong="H4325"\w* los manantiales \w de|strong="H4325"\w* la salvación.  
\v 4 \w En|strong="H3588"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* dirán: “¡Den gracias \w a|strong="H3068"\w* Yahvé! ¡\w Invoquen|strong="H7121"\w* \w su|strong="H1931"\w* \w nombre|strong="H8034"\w*! ¡Anuncien \w sus|strong="H1931"\w* \w obras|strong="H5949"\w* \w entre|strong="H3588"\w* \w los|strong="H1931"\w* \w pueblos|strong="H5971"\w*! Proclamen \w que|strong="H3588"\w* \w su|strong="H1931"\w* \w nombre|strong="H8034"\w* \w es|strong="H1931"\w* sublime.  
\v 5 ¡Canten \w a|strong="H3068"\w* Yahvé, \w porque|strong="H3588"\w* ha \w hecho|strong="H6213"\w* \w cosas|strong="H3045"\w* maravillosas! ¡\w Que|strong="H3588"\w* \w esto|strong="H2063"\w* \w se|strong="H3045"\w* \w sepa|strong="H3045"\w* \w en|strong="H3588"\w* \w toda|strong="H3605"\w* \w la|strong="H3588"\w* tierra!  
\v 6 ¡Griten \w y|strong="H3588"\w* \w canten|strong="H7442"\w* \w de|strong="H3588"\w* alegría, \w habitantes|strong="H3427"\w* \w de|strong="H3588"\w* \w Sión|strong="H6726"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w* \w es|strong="H3588"\w* \w grande|strong="H1419"\w* \w en|strong="H3588"\w* \w medio|strong="H7130"\w* \w de|strong="H3588"\w* ustedes!”.   
\c 13  
\p
\v 1 Profecía sobre Babilonia, \w que|strong="H1121"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* Amoz recibió en visión.   
\p
\v 2 ¡Levanten una \w bandera|strong="H5251"\w* \w sobre|strong="H5921"\w* un cerro desierto! ¡Griten \w con|strong="H5921"\w* fuerza \w hacia|strong="H5921"\w* \w ellos|strong="H3027"\w*! Denles una señal \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*, \w para|strong="H5921"\w* \w que|strong="H5921"\w* entren \w por|strong="H5921"\w* \w las|strong="H5921"\w* \w puertas|strong="H6607"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* nobles.  
\v 3 \w Yo|strong="H6680"\w* \w mismo|strong="H1571"\w* he dado órdenes \w a|strong="H3068"\w* mis guerreros consagrados; he \w llamado|strong="H7121"\w* \w a|strong="H3068"\w* mis \w valientes|strong="H1368"\w*, \w a|strong="H3068"\w* los \w que|strong="H1571"\w* se alegran de mi triunfo, para \w que|strong="H1571"\w* ejecuten mi ira.  
\v 4 ¡Escuchen el \w estruendo|strong="H6963"\w* en las montañas, \w como|strong="H1823"\w* el \w de|strong="H5971"\w* una inmensa \w multitud|strong="H1995"\w*! ¡Escuchen el \w alboroto|strong="H1995"\w* \w de|strong="H5971"\w* los \w reinos|strong="H4467"\w* y \w de|strong="H5971"\w* las \w naciones|strong="H1471"\w* \w que|strong="H5971"\w* \w se|strong="H5971"\w* reúnen! Yahvé \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w* pasa revista al \w ejército|strong="H6635"\w* \w para|strong="H5971"\w* la \w batalla|strong="H4421"\w*.  
\v 5 Vienen de tierras lejanas, de \w los|strong="H3605"\w* confines del horizonte; viene Yahvé con las \w armas|strong="H3627"\w* de su justicia para destruir \w toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra.   
\p
\v 6 ¡Aúllen, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w día|strong="H3117"\w* \w de|strong="H3588"\w* Yahvé está \w cerca|strong="H7138"\w*! Vendrá \w como|strong="H3588"\w* una \w destrucción|strong="H7701"\w* \w de|strong="H3588"\w* parte del \w Todopoderoso|strong="H7706"\w*.  
\v 7 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w manos|strong="H3027"\w* \w se|strong="H5921"\w* quedarán sin fuerzas \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w corazón|strong="H3824"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w se|strong="H5921"\w* desanimará.  
\v 8 El pánico se apoderará \w de|strong="H6440"\w* ellos; sufrirán \w dolores|strong="H2256"\w* y \w angustias|strong="H6735"\w*, y se retorcerán como mujer \w de|strong="H6440"\w* parto. Se mirarán unos \w a|strong="H3068"\w* otros con asombro; sus \w rostros|strong="H6440"\w* estarán encendidos \w de|strong="H6440"\w* terror.  
\v 9 ¡Miren! \w Ya|strong="H3068"\w* viene el \w día|strong="H3117"\w* \w de|strong="H4480"\w* Yahvé, \w día|strong="H3117"\w* cruel, \w de|strong="H4480"\w* \w furor|strong="H2740"\w* y \w de|strong="H4480"\w* ardiente \w ira|strong="H2740"\w*, \w para|strong="H4480"\w* dejar la tierra desolada y exterminar \w de|strong="H4480"\w* \w ella|strong="H4480"\w* \w a|strong="H3068"\w* los \w pecadores|strong="H2400"\w*.  
\v 10 Las \w estrellas|strong="H3556"\w* del \w cielo|strong="H8064"\w* \w y|strong="H3588"\w* sus constelaciones dejarán \w de|strong="H3588"\w* brillar; \w el|strong="H3588"\w* \w sol|strong="H8121"\w* \w se|strong="H3808"\w* oscurecerá apenas \w salga|strong="H3318"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w luna|strong="H3394"\w* \w no|strong="H3808"\w* dará \w su|strong="H3588"\w* luz.  
\v 11 “Castigaré \w al|strong="H5921"\w* \w mundo|strong="H8398"\w* \w por|strong="H5921"\w* su \w maldad|strong="H5771"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* malvados \w por|strong="H5921"\w* su \w pecado|strong="H5771"\w*. Pondré fin \w al|strong="H5921"\w* orgullo \w de|strong="H5921"\w* \w los|strong="H5921"\w* arrogantes \w y|strong="H5921"\w* humillaré \w la|strong="H5921"\w* \w soberbia|strong="H1347"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* tiranos.  
\v 12 Haré que los seres humanos sean más escasos que el \w oro|strong="H6337"\w* \w fino|strong="H6337"\w*, más raros que el \w oro|strong="H6337"\w* puro de Ofir.  
\v 13 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* haré \w que|strong="H5921"\w* \w el|strong="H5921"\w* \w cielo|strong="H8064"\w* tiemble \w y|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w se|strong="H5921"\w* mueva \w de|strong="H5921"\w* su \w lugar|strong="H4725"\w*, \w por|strong="H5921"\w* \w la|strong="H5921"\w* indignación \w de|strong="H5921"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* \w día|strong="H3117"\w* \w de|strong="H5921"\w* su ardiente \w ira|strong="H2740"\w*”.  
\v 14 \w Como|strong="H1961"\w* gacela perseguida \w o|strong="H3068"\w* \w como|strong="H1961"\w* oveja sin \w pastor|strong="H6908"\w*, cada uno \w volverá|strong="H6437"\w* \w a|strong="H3068"\w* su propio \w pueblo|strong="H5971"\w*, cada uno \w huirá|strong="H5127"\w* \w a|strong="H3068"\w* su propia tierra.  
\v 15 Al \w que|strong="H3605"\w* encuentren \w lo|strong="H3605"\w* atravesarán, y \w el|strong="H3605"\w* \w que|strong="H3605"\w* sea capturado \w caerá|strong="H5307"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*.  
\v 16 Estrellarán \w a|strong="H3068"\w* sus \w niños|strong="H5768"\w* ante sus propios \w ojos|strong="H5869"\w*, saquearán sus \w casas|strong="H1004"\w* y violarán \w a|strong="H3068"\w* sus esposas.   
\p
\v 17 “Miren, yo incito \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* medos, \w a|strong="H3068"\w* quienes \w no|strong="H3808"\w* \w les|strong="H5921"\w* interesa \w la|strong="H5921"\w* \w plata|strong="H3701"\w* \w ni|strong="H3808"\w* codician \w el|strong="H5921"\w* \w oro|strong="H2091"\w*.  
\v 18 \w Con|strong="H5921"\w* sus \w arcos|strong="H7198"\w* derribarán \w a|strong="H3068"\w* \w los|strong="H1121"\w* jóvenes; \w no|strong="H3808"\w* tendrán compasión \w de|strong="H5921"\w* \w los|strong="H1121"\w* recién nacidos \w ni|strong="H3808"\w* perdonarán \w a|strong="H3068"\w* \w los|strong="H1121"\w* \w niños|strong="H5288"\w*”.  
\v 19 \w Y|strong="H3068"\w* Babilonia, la perla de \w los|strong="H1961"\w* \w reinos|strong="H4467"\w*, la joya del orgullo de \w los|strong="H1961"\w* \w caldeos|strong="H3778"\w*, \w quedará|strong="H1961"\w* \w como|strong="H1961"\w* \w Sodoma|strong="H5467"\w* y \w Gomorra|strong="H6017"\w* \w cuando|strong="H1961"\w* Dios las destruyó.  
\v 20 \w Nunca|strong="H3808"\w* \w más|strong="H5704"\w* volverá \w a|strong="H3068"\w* ser \w habitada|strong="H3427"\w* \w ni|strong="H3808"\w* \w poblada|strong="H3427"\w* \w de|strong="H5704"\w* \w generación|strong="H1755"\w* \w en|strong="H5704"\w* \w generación|strong="H1755"\w*. \w El|strong="H3427"\w* árabe \w no|strong="H3808"\w* levantará \w allí|strong="H8033"\w* su tienda, \w ni|strong="H3808"\w* \w los|strong="H3427"\w* \w pastores|strong="H7462"\w* harán descansar \w allí|strong="H8033"\w* sus rebaños.  
\v 21 \w Allí|strong="H8033"\w* se echarán las fieras del desierto y sus \w casas|strong="H1004"\w* se llenarán de búhos; \w allí|strong="H8033"\w* vivirán los avestruces y retozarán las cabras salvajes.  
\v 22 Las hienas aullarán en sus torres y los chacales en sus lujosos palacios. Su \w hora|strong="H6256"\w* está por llegar; sus \w días|strong="H3117"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* prolongarán \w más|strong="H6030"\w*.   
\c 14  
\p
\v 1 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* \w Señor|strong="H3068"\w* tendrá compasión \w de|strong="H5921"\w* \w Jacob|strong="H3290"\w* \w y|strong="H3588"\w* volverá \w a|strong="H3068"\w* elegir \w a|strong="H3068"\w* \w Israel|strong="H3478"\w*, \w y|strong="H3588"\w* \w los|strong="H5921"\w* establecerá \w en|strong="H5921"\w* \w su|strong="H3588"\w* propia tierra. \w Los|strong="H5921"\w* \w extranjeros|strong="H1616"\w* \w se|strong="H5921"\w* unirán \w a|strong="H3068"\w* \w ellos|strong="H5921"\w* \w y|strong="H3588"\w* \w se|strong="H5921"\w* integrarán \w a|strong="H3068"\w* \w la|strong="H5921"\w* \w familia|strong="H1004"\w* \w de|strong="H5921"\w* \w Jacob|strong="H3290"\w*.  
\v 2 \w Los|strong="H5921"\w* \w pueblos|strong="H5971"\w* \w los|strong="H5921"\w* \w tomarán|strong="H3947"\w* \w y|strong="H5921"\w* \w los|strong="H5921"\w* llevarán \w a|strong="H3068"\w* su \w lugar|strong="H4725"\w*; \w y|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w los|strong="H5921"\w* \w poseerá|strong="H5157"\w* \w como|strong="H1961"\w* \w siervos|strong="H5650"\w* \w y|strong="H5921"\w* \w siervas|strong="H8198"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra \w de|strong="H5921"\w* Yahvé. Capturarán \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w los|strong="H5921"\w* cautivaron \w y|strong="H5921"\w* dominarán \w a|strong="H3068"\w* sus opresores.   
\p
\v 3 El \w día|strong="H3117"\w* \w en|strong="H4480"\w* \w que|strong="H4480"\w* Yahvé \w te|strong="H4480"\w* \w dé|strong="H4480"\w* descanso \w de|strong="H4480"\w* tu dolor, \w de|strong="H4480"\w* tu angustia y \w del|strong="H4480"\w* \w duro|strong="H7186"\w* trabajo \w al|strong="H4480"\w* \w que|strong="H4480"\w* \w fuiste|strong="H1961"\w* sometido,  
\v 4 entonarás \w este|strong="H2088"\w* poema \w de|strong="H5921"\w* burla \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w rey|strong="H4428"\w* \w de|strong="H5921"\w* Babilonia: “¡\w Cómo|strong="H5921"\w* ha terminado \w el|strong="H5921"\w* opresor! ¡\w Cómo|strong="H5921"\w* ha cesado su insolencia!”  
\v 5 Yahvé ha roto el bastón de los malvados, el \w cetro|strong="H7626"\w* de los tiranos,  
\v 6 el \w que|strong="H5971"\w* \w hería|strong="H5221"\w* \w a|strong="H3068"\w* los \w pueblos|strong="H5971"\w* con furia, con golpes incesantes; el \w que|strong="H5971"\w* gobernaba \w a|strong="H3068"\w* las \w naciones|strong="H1471"\w* con ira, persiguiéndolas \w sin|strong="H1097"\w* descanso.  
\v 7 \w Toda|strong="H3605"\w* \w la|strong="H3605"\w* tierra descansa y está en paz; \w todos|strong="H3605"\w* rompen en cantos de alegría.  
\v 8 \w Hasta|strong="H5921"\w* \w los|strong="H5921"\w* cipreses \w y|strong="H1571"\w* \w los|strong="H5921"\w* cedros \w del|strong="H5921"\w* \w Líbano|strong="H3844"\w* \w se|strong="H3808"\w* burlan \w de|strong="H5921"\w* \w ti|strong="H5921"\w*, diciendo: “\w Desde|strong="H5921"\w* \w que|strong="H3808"\w* caíste, \w nadie|strong="H3808"\w* \w ha|strong="H3808"\w* \w subido|strong="H5927"\w* \w a|strong="H3068"\w* talarnos”.  
\v 9 \w Abajo|strong="H8478"\w*, \w el|strong="H3605"\w* Seol\f + \fr 14:9 \ft El Seol es el lugar de los muertos.\f* se estremece \w al|strong="H4428"\w* esperarte; \w por|strong="H8478"\w* ti \w despierta|strong="H5782"\w* \w a|strong="H3068"\w* \w los|strong="H3605"\w* \w muertos|strong="H7496"\w*, \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* fueron líderes \w en|strong="H8478"\w* \w la|strong="H3605"\w* tierra. Hace \w levantar|strong="H6965"\w* \w de|strong="H8478"\w* sus tronos \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* \w de|strong="H8478"\w* las \w naciones|strong="H1471"\w*.  
\v 10 \w Todos|strong="H3605"\w* \w ellos|strong="H3605"\w* \w responderán|strong="H6030"\w* \w y|strong="H1571"\w* te dirán: “¿\w También|strong="H1571"\w* tú te has debilitado \w como|strong="H1571"\w* \w nosotros|strong="H3605"\w*? ¿Te has vuelto igual \w que|strong="H1571"\w* \w nosotros|strong="H3605"\w*?”  
\v 11 Tu orgullo ha caído \w al|strong="H8478"\w* Seol\f + \fr 14:11 \ft El Seol es el lugar de los muertos.\f*, junto con el sonido \w de|strong="H8478"\w* tus arpas. Los \w gusanos|strong="H8438"\w* son tu cama y las larvas tu manta.   
\p
\v 12 ¡\w Cómo|strong="H5921"\w* has \w caído|strong="H5307"\w* \w del|strong="H5921"\w* \w cielo|strong="H8064"\w*, lucero \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w mañana|strong="H7837"\w*, \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* aurora! Has sido derribado \w por|strong="H5921"\w* tierra, tú \w que|strong="H5921"\w* pisoteabas \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.  
\v 13 Tú, que decías en tu \w corazón|strong="H3824"\w*: “\w Subiré|strong="H5927"\w* al \w cielo|strong="H8064"\w*; \w levantaré|strong="H7311"\w* mi \w trono|strong="H3678"\w* por \w encima|strong="H4605"\w* de las \w estrellas|strong="H3556"\w* de Dios. Me sentaré en \w el|strong="H3427"\w* \w monte|strong="H2022"\w* de la asamblea, en lo más remoto del \w norte|strong="H6828"\w*.  
\v 14 \w Subiré|strong="H5927"\w* \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* altas \w nubes|strong="H5645"\w* \w y|strong="H5921"\w* seré igual \w al|strong="H5921"\w* \w Altísimo|strong="H5945"\w*”.  
\v 15 Pero has sido derribado al Seol\f + \fr 14:15 \ft El Seol es el lugar de los muertos.\f*, \w a|strong="H3068"\w* lo más profundo de la fosa.  
\v 16 Los \w que|strong="H2088"\w* te \w ven|strong="H7200"\w* se quedan mirándote fijamente y reflexionan: “¿\w Es|strong="H2088"\w* \w este|strong="H2088"\w* el hombre \w que|strong="H2088"\w* hacía \w temblar|strong="H7493"\w* la tierra, \w que|strong="H2088"\w* sacudía los \w reinos|strong="H4467"\w*,  
\v 17 \w que|strong="H3808"\w* dejó el \w mundo|strong="H8398"\w* como un \w desierto|strong="H4057"\w*, \w que|strong="H3808"\w* \w destruyó|strong="H2040"\w* sus \w ciudades|strong="H5892"\w* y \w que|strong="H3808"\w* \w nunca|strong="H3808"\w* dejó libres \w a|strong="H3068"\w* sus presos?”   
\p
\v 18 \w Todos|strong="H3605"\w* \w los|strong="H3605"\w* \w reyes|strong="H4428"\w* de las \w naciones|strong="H1471"\w* descansan con honor, \w cada|strong="H3605"\w* uno en su propia tumba.  
\v 19 Pero \w a|strong="H3068"\w* ti te arrojan de tu \w sepulcro|strong="H6913"\w* como \w a|strong="H3068"\w* una rama despreciable; estás cubierto de \w muertos|strong="H6297"\w* atravesados por la \w espada|strong="H2719"\w*, que bajan \w a|strong="H3068"\w* las piedras de la fosa; ¡eres como un cadáver pisoteado!  
\v 20 \w No|strong="H3808"\w* \w te|strong="H3588"\w* enterrarán \w con|strong="H3588"\w* \w los|strong="H3588"\w* demás reyes, \w porque|strong="H3588"\w* destruiste tu propia tierra \w y|strong="H3588"\w* \w mataste|strong="H2026"\w* \w a|strong="H3068"\w* tu propio \w pueblo|strong="H5971"\w*. ¡\w Que|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* mencione \w nunca|strong="H3808"\w* \w más|strong="H3588"\w* \w la|strong="H3588"\w* \w descendencia|strong="H2233"\w* \w de|strong="H3588"\w* \w los|strong="H3588"\w* malvados!   
\p
\v 21 Preparen \w el|strong="H1121"\w* matadero para sus \w hijos|strong="H1121"\w* \w por|strong="H6440"\w* la \w maldad|strong="H5771"\w* \w de|strong="H6440"\w* sus antepasados; \w que|strong="H1121"\w* \w no|strong="H1077"\w* se levanten para adueñarse \w de|strong="H6440"\w* la tierra \w ni|strong="H1077"\w* llenen \w de|strong="H6440"\w* \w ciudades|strong="H5892"\w* \w el|strong="H1121"\w* \w mundo|strong="H8398"\w*.  
\v 22 “Yo \w me|strong="H5921"\w* \w levantaré|strong="H6965"\w* \w contra|strong="H5921"\w* \w ellos|strong="H5921"\w* — \w dice|strong="H5002"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* — \w y|strong="H5921"\w* borraré \w de|strong="H5921"\w* Babilonia \w el|strong="H5921"\w* \w nombre|strong="H8034"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* sobrevivientes, \w al|strong="H5921"\w* \w hijo|strong="H5209"\w* \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w nieto|strong="H5220"\w* — \w dice|strong="H5002"\w* Yahvé —.  
\v 23 La convertiré en nido \w de|strong="H4325"\w* erizos y en pantanos; la barreré con la escoba \w de|strong="H4325"\w* la destrucción”, \w dice|strong="H5002"\w* Yahvé \w de|strong="H4325"\w* los \w Ejércitos|strong="H6635"\w*.   
\p
\v 24 Yahvé de \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w* \w ha|strong="H3808"\w* \w jurado|strong="H7650"\w*: “Ciertamente, \w tal|strong="H3651"\w* \w como|strong="H1961"\w* \w lo|strong="H1931"\w* planeé, \w así|strong="H3651"\w* \w sucederá|strong="H1961"\w*; \w tal|strong="H3651"\w* \w como|strong="H1961"\w* \w lo|strong="H1931"\w* decidí, \w así|strong="H3651"\w* \w se|strong="H1961"\w* cumplirá:  
\v 25 romperé \w al|strong="H5921"\w* asirio \w en|strong="H5921"\w* \w mi|strong="H5921"\w* tierra \w y|strong="H5921"\w* \w lo|strong="H5921"\w* pisotearé \w en|strong="H5921"\w* mis montañas. Su \w yugo|strong="H5923"\w* \w les|strong="H5921"\w* \w será|strong="H7665"\w* quitado \w y|strong="H5921"\w* su \w carga|strong="H5448"\w* \w será|strong="H7665"\w* retirada \w de|strong="H5921"\w* sus \w hombros|strong="H7926"\w*”.  
\v 26 \w Este|strong="H2063"\w* \w es|strong="H3027"\w* \w el|strong="H5921"\w* plan decidido \w para|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra; \w esta|strong="H2063"\w* \w es|strong="H3027"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w* \w extendida|strong="H5186"\w* \w sobre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.  
\v 27 \w Porque|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* lo ha planeado, ¿\w y|strong="H3588"\w* \w quién|strong="H4310"\w* podrá impedirlo? \w Su|strong="H3588"\w* \w mano|strong="H3027"\w* está \w extendida|strong="H5186"\w*, ¿\w y|strong="H3588"\w* \w quién|strong="H4310"\w* \w la|strong="H3588"\w* hará retroceder?   
\p
\v 28 En el \w año|strong="H8141"\w* \w que|strong="H1961"\w* murió el \w rey|strong="H4428"\w* Acaz, \w se|strong="H1961"\w* dio \w esta|strong="H2088"\w* profecía:   
\p
\v 29 \w No|strong="H3588"\w* se alegren ustedes, filisteos, \w porque|strong="H3588"\w* se haya roto \w la|strong="H3605"\w* \w vara|strong="H7626"\w* \w que|strong="H3588"\w* \w los|strong="H3605"\w* golpeaba; \w porque|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3605"\w* raíz \w de|strong="H3588"\w* \w la|strong="H3605"\w* \w serpiente|strong="H5175"\w* \w saldrá|strong="H3318"\w* una víbora, \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w fruto|strong="H6529"\w* \w será|strong="H7665"\w* una \w serpiente|strong="H5175"\w* voladora.  
\v 30 Los \w más|strong="H4191"\w* \w pobres|strong="H1800"\w* tendrán qué comer y los necesitados descansarán seguros; pero \w a|strong="H3068"\w* tu raíz la \w mataré|strong="H4191"\w* de \w hambre|strong="H7458"\w* y lo poco que te quede \w morirá|strong="H4191"\w*.   
\p
\v 31 ¡\w Aúlla|strong="H3213"\w*, \w puerta|strong="H8179"\w*! ¡Grita, \w ciudad|strong="H5892"\w*! ¡Derrítanse \w de|strong="H3588"\w* miedo, \w todos|strong="H3605"\w* ustedes, filisteos! \w Porque|strong="H3588"\w* del \w norte|strong="H6828"\w* viene una nube \w de|strong="H3588"\w* \w humo|strong="H6227"\w*, \w y|strong="H3588"\w* \w nadie|strong="H3605"\w* se queda atrás \w en|strong="H3588"\w* sus filas.   
\p
\v 32 ¿\w Qué|strong="H3588"\w* \w se|strong="H4100"\w* les \w responderá|strong="H6030"\w* \w a|strong="H3068"\w* \w los|strong="H3588"\w* \w mensajeros|strong="H4397"\w* \w de|strong="H3588"\w* esa \w nación|strong="H1471"\w*? \w Que|strong="H3588"\w* Yahvé \w fundó|strong="H3245"\w* \w a|strong="H3068"\w* \w Sión|strong="H6726"\w*, \w y|strong="H3588"\w* \w que|strong="H3588"\w* \w en|strong="H3588"\w* ella buscarán refugio \w los|strong="H3588"\w* pobres \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*.   
\c 15  
\p
\v 1 Profecía sobre \w Moab|strong="H4124"\w*.  
\p \w En|strong="H3588"\w* una sola \w noche|strong="H3915"\w*, \w Ar|strong="H6144"\w* \w de|strong="H3588"\w* \w Moab|strong="H4124"\w* fue \w destruida|strong="H7703"\w* \w y|strong="H3588"\w* quedó \w en|strong="H3588"\w* silencio; \w en|strong="H3588"\w* una sola \w noche|strong="H3915"\w*, Kir \w de|strong="H3588"\w* \w Moab|strong="H4124"\w* fue devastada \w y|strong="H3588"\w* quedó \w en|strong="H3588"\w* silencio.  
\v 2 \w La|strong="H5921"\w* gente \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w sube|strong="H5927"\w* \w al|strong="H5921"\w* templo \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w Dibón|strong="H1769"\w*, \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w altares|strong="H1116"\w* paganos, \w para|strong="H5921"\w* llorar. \w Moab|strong="H4124"\w* gime \w de|strong="H5921"\w* dolor \w por|strong="H5921"\w* \w Nebo|strong="H5015"\w* \w y|strong="H5921"\w* \w por|strong="H5921"\w* \w Medeba|strong="H4311"\w*. \w Todos|strong="H3605"\w* \w se|strong="H5921"\w* han rapado \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w y|strong="H5921"\w* \w se|strong="H5921"\w* han cortado \w la|strong="H5921"\w* \w barba|strong="H2206"\w* \w en|strong="H5921"\w* señal \w de|strong="H5921"\w* duelo.  
\v 3 \w En|strong="H5921"\w* \w las|strong="H5921"\w* \w calles|strong="H2351"\w* \w se|strong="H5921"\w* visten \w de|strong="H5921"\w* luto; \w en|strong="H5921"\w* \w las|strong="H5921"\w* azoteas \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w plazas|strong="H7339"\w* \w todos|strong="H3605"\w* \w se|strong="H5921"\w* lamentan \w y|strong="H5921"\w* \w se|strong="H5921"\w* deshacen \w en|strong="H5921"\w* lágrimas.  
\v 4 \w Hesbón|strong="H2809"\w* \w y|strong="H5921"\w* Eleale gritan pidiendo ayuda; sus gritos \w se|strong="H5921"\w* \w oyen|strong="H8085"\w* \w hasta|strong="H5704"\w* Jahaza. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w los|strong="H5921"\w* guerreros \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* tiemblan \w de|strong="H5921"\w* miedo; ¡\w se|strong="H5921"\w* han quedado sin \w ánimo|strong="H5315"\w*!  
\v 5 Mi \w corazón|strong="H3820"\w* llora \w por|strong="H3588"\w* \w Moab|strong="H4124"\w*. Sus fugitivos escapan \w hacia|strong="H1870"\w* \w Zoar|strong="H6820"\w* \w y|strong="H3588"\w* \w hasta|strong="H5704"\w* Eglat Selisiyá. \w Suben|strong="H5927"\w* \w llorando|strong="H1065"\w* \w por|strong="H3588"\w* \w la|strong="H3588"\w* cuesta \w de|strong="H3588"\w* Luhit; \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w camino|strong="H1870"\w* \w de|strong="H3588"\w* \w Horonaim|strong="H2773"\w* lanzan \w gritos|strong="H2201"\w* \w de|strong="H3588"\w* dolor \w por|strong="H3588"\w* \w la|strong="H3588"\w* destrucción.  
\v 6 Las \w aguas|strong="H4325"\w* \w de|strong="H3588"\w* Nimrim \w se|strong="H1961"\w* han secado; \w el|strong="H3588"\w* pasto \w se|strong="H1961"\w* marchitó, \w la|strong="H3588"\w* \w hierba|strong="H2682"\w* \w se|strong="H1961"\w* \w secó|strong="H3001"\w* \w y|strong="H3588"\w* \w no|strong="H3808"\w* queda \w nada|strong="H3808"\w* \w verde|strong="H3418"\w*.  
\v 7 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w las|strong="H5921"\w* riquezas \w que|strong="H5921"\w* han ganado \w y|strong="H5921"\w* todo \w lo|strong="H5921"\w* \w que|strong="H5921"\w* han ahorrado, \w lo|strong="H5921"\w* cruzan ahora \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w Arroyo|strong="H5158"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* Sauces.  
\v 8 \w El|strong="H3588"\w* \w grito|strong="H2201"\w* \w de|strong="H3588"\w* dolor recorre todas las fronteras \w de|strong="H3588"\w* \w Moab|strong="H4124"\w*; sus lamentos llegan \w hasta|strong="H5704"\w* Eglaim \w y|strong="H3588"\w* \w su|strong="H3588"\w* llanto \w hasta|strong="H5704"\w* Beer-elim.  
\v 9 \w Las|strong="H5921"\w* \w aguas|strong="H4325"\w* \w de|strong="H5921"\w* \w Dimón|strong="H1775"\w* están teñidas \w de|strong="H5921"\w* \w sangre|strong="H1818"\w*, \w pero|strong="H3588"\w* todavía traeré \w más|strong="H3588"\w* males \w sobre|strong="H5921"\w* \w Dimón|strong="H1775"\w*: enviaré un león \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* escapen \w de|strong="H5921"\w* \w Moab|strong="H4124"\w* \w y|strong="H3588"\w* \w contra|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H3588"\w* queden \w en|strong="H5921"\w* \w la|strong="H5921"\w* tierra.   
\c 16  
\p
\v 1 Envíen \w corderos|strong="H3733"\w* como tributo al gobernante del país, desde Sela, por el \w desierto|strong="H4057"\w*, hasta el \w monte|strong="H2022"\w* de la \w hija|strong="H1323"\w* de \w Sión|strong="H6726"\w*.  
\v 2 \w Como|strong="H1961"\w* \w aves|strong="H5775"\w* \w que|strong="H1961"\w* huyen espantadas de su \w nido|strong="H7064"\w*, así \w están|strong="H1961"\w* las \w mujeres|strong="H1323"\w* de \w Moab|strong="H4124"\w* en \w los|strong="H1961"\w* vados del río Arnón.  
\v 3 “¡Den \w consejo|strong="H6098"\w*! ¡\w Hagan|strong="H6213"\w* justicia! Que su \w sombra|strong="H6738"\w* sea como la \w noche|strong="H3915"\w* \w en|strong="H8432"\w* pleno mediodía. Escondan \w a|strong="H3068"\w* los desterrados, \w no|strong="H6213"\w* traicionen al que huye.  
\v 4 Permitan \w que|strong="H3588"\w* mis desterrados \w de|strong="H4480"\w* \w Moab|strong="H4124"\w* vivan \w con|strong="H4480"\w* ustedes; sirvan \w de|strong="H4480"\w* refugio \w ante|strong="H6440"\w* \w el|strong="H3588"\w* destructor. \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* opresor llegará \w a|strong="H3068"\w* \w su|strong="H1933"\w* fin, \w la|strong="H3588"\w* \w destrucción|strong="H7701"\w* cesará \w y|strong="H3588"\w* \w los|strong="H3588"\w* \w que|strong="H3588"\w* pisotean \w la|strong="H3588"\w* tierra serán exterminados.  
\v 5 Entonces \w se|strong="H5921"\w* establecerá un \w trono|strong="H3678"\w* \w en|strong="H5921"\w* gran amor; \w y|strong="H5921"\w* alguien \w se|strong="H5921"\w* sentará \w en|strong="H5921"\w* \w él|strong="H5921"\w* \w con|strong="H5921"\w* fidelidad, \w en|strong="H5921"\w* \w la|strong="H5921"\w* tienda \w de|strong="H5921"\w* \w David|strong="H1732"\w*. Será un \w juez|strong="H8199"\w* \w que|strong="H5921"\w* \w busque|strong="H1875"\w* \w la|strong="H5921"\w* \w justicia|strong="H6664"\w* \w y|strong="H5921"\w* sea rápido \w para|strong="H5921"\w* hacer \w lo|strong="H5921"\w* \w que|strong="H5921"\w* es \w recto|strong="H3559"\w*”.   
\p
\v 6 Hemos \w oído|strong="H8085"\w* hablar del orgullo de \w Moab|strong="H4124"\w*; es un orgullo exagerado. Conocemos su arrogancia, su \w soberbia|strong="H1347"\w* y su furia, pero sus jactancias \w no|strong="H3808"\w* valen \w nada|strong="H3808"\w*.  
\v 7 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w* \w Moab|strong="H4124"\w* gemirá \w por|strong="H3651"\w* \w Moab|strong="H4124"\w*; \w todos|strong="H3605"\w* \w se|strong="H3651"\w* lamentarán. Llorarán \w por|strong="H3651"\w* las tortas de pasas de Quir-hareset, totalmente afligidos.  
\v 8 \w Porque|strong="H3588"\w* \w los|strong="H1167"\w* campos \w de|strong="H3588"\w* \w Hesbón|strong="H2809"\w* se han secado, \w y|strong="H3588"\w* también las \w vides|strong="H1612"\w* \w de|strong="H3588"\w* Sibma. \w Los|strong="H1167"\w* jefes \w de|strong="H3588"\w* las \w naciones|strong="H1471"\w* destrozaron \w sus|strong="H1986"\w* mejores viñedos, \w que|strong="H3588"\w* llegaban \w hasta|strong="H5704"\w* \w Jazer|strong="H3270"\w* \w y|strong="H3588"\w* se extendían \w por|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*; \w sus|strong="H1986"\w* \w sarmientos|strong="H8291"\w* se expandían \w y|strong="H3588"\w* cruzaban \w el|strong="H3588"\w* \w mar|strong="H3220"\w*.  
\v 9 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w lloro|strong="H1058"\w* \w con|strong="H5921"\w* \w el|strong="H5921"\w* \w llanto|strong="H1065"\w* \w de|strong="H5921"\w* \w Jazer|strong="H3270"\w* \w por|strong="H5921"\w* \w los|strong="H5921"\w* viñedos \w de|strong="H5921"\w* Sibma; \w los|strong="H5921"\w* empapo \w con|strong="H5921"\w* mis \w lágrimas|strong="H1832"\w*, \w Hesbón|strong="H2809"\w* \w y|strong="H3588"\w* Eleale, \w porque|strong="H3588"\w* \w sobre|strong="H5921"\w* sus \w frutos|strong="H7019"\w* \w de|strong="H5921"\w* \w verano|strong="H7019"\w* \w y|strong="H3588"\w* \w sobre|strong="H5921"\w* \w su|strong="H3588"\w* cosecha ha \w caído|strong="H5307"\w* \w el|strong="H5921"\w* grito \w de|strong="H5921"\w* guerra.  
\v 10 La \w alegría|strong="H8057"\w* y el júbilo \w se|strong="H4480"\w* han retirado \w de|strong="H4480"\w* los huertos; \w en|strong="H4480"\w* las \w viñas|strong="H3754"\w* ya \w no|strong="H3808"\w* hay cantos \w ni|strong="H3808"\w* gritos \w de|strong="H4480"\w* \w alegría|strong="H8057"\w*. \w Nadie|strong="H3808"\w* pisa uvas \w en|strong="H4480"\w* los lagares \w para|strong="H4480"\w* sacar \w vino|strong="H3196"\w*; \w yo|strong="H4480"\w* hice \w que|strong="H4480"\w* \w cesaran|strong="H7673"\w* los gritos \w de|strong="H4480"\w* la cosecha.  
\v 11 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w mi|strong="H5921"\w* corazón gime \w como|strong="H5921"\w* un \w arpa|strong="H3658"\w* \w por|strong="H5921"\w* \w Moab|strong="H4124"\w*, \w y|strong="H5921"\w* todo \w mi|strong="H5921"\w* ser \w por|strong="H5921"\w* Quir-heres.  
\v 12 \w Y|strong="H3068"\w* \w sucederá|strong="H1961"\w* \w que|strong="H3588"\w* \w cuando|strong="H3588"\w* \w Moab|strong="H4124"\w* \w se|strong="H1961"\w* presente \w y|strong="H3588"\w* \w se|strong="H1961"\w* canse \w en|strong="H5921"\w* sus \w altares|strong="H1116"\w* paganos, \w y|strong="H3588"\w* vaya \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w santuario|strong="H4720"\w* \w a|strong="H3068"\w* orar, \w nada|strong="H3808"\w* logrará.   
\p
\v 13 \w Esta|strong="H2088"\w* \w es|strong="H2088"\w* la \w palabra|strong="H1697"\w* \w que|strong="H1697"\w* Yahvé \w pronunció|strong="H1696"\w* sobre \w Moab|strong="H4124"\w* en el pasado.  
\v 14 Pero \w ahora|strong="H6258"\w* Yahvé \w ha|strong="H3808"\w* \w dicho|strong="H1696"\w*: “Dentro de \w tres|strong="H7969"\w* \w años|strong="H8141"\w*, contados como \w los|strong="H3605"\w* de un jornalero, \w la|strong="H3605"\w* \w gloria|strong="H3519"\w* de \w Moab|strong="H4124"\w* \w será|strong="H3808"\w* humillada \w a|strong="H3068"\w* pesar de su \w gran|strong="H7227"\w* \w multitud|strong="H1995"\w*; \w lo|strong="H3808"\w* \w que|strong="H3808"\w* quede \w será|strong="H3808"\w* muy \w poco|strong="H4592"\w*, pequeño \w y|strong="H3519"\w* \w sin|strong="H3808"\w* fuerza”.   
\c 17  
\p
\v 1 Profecía \w sobre|strong="H1961"\w* \w Damasco|strong="H1834"\w*.  
\p “Miren, \w Damasco|strong="H1834"\w* dejará de ser \w ciudad|strong="H5892"\w* y \w se|strong="H1961"\w* convertirá \w en|strong="H5493"\w* un \w montón|strong="H4596"\w* de ruinas.  
\v 2 Las \w ciudades|strong="H5892"\w* de \w Aroer|strong="H6177"\w* quedarán desiertas; \w serán|strong="H1961"\w* \w para|strong="H1961"\w* \w los|strong="H1961"\w* \w rebaños|strong="H5739"\w*, \w que|strong="H1961"\w* \w se|strong="H1961"\w* echarán allí sin \w que|strong="H1961"\w* nadie \w los|strong="H1961"\w* asuste.  
\v 3 Desaparecerá la fortificación \w de|strong="H1121"\w* Efraín \w y|strong="H3519"\w* \w el|strong="H1121"\w* \w reino|strong="H4467"\w* \w de|strong="H1121"\w* \w Damasco|strong="H1834"\w*; \w y|strong="H3519"\w* lo \w que|strong="H1121"\w* \w quede|strong="H1961"\w* \w de|strong="H1121"\w* Siria \w será|strong="H1961"\w* \w como|strong="H1961"\w* la \w gloria|strong="H3519"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*”, \w dice|strong="H5002"\w* Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*.   
\p
\v 4 “En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w la|strong="H1931"\w* \w gloria|strong="H3519"\w* de \w Jacob|strong="H3290"\w* \w se|strong="H1961"\w* desvanecerá \w y|strong="H3519"\w* \w su|strong="H1931"\w* cuerpo robusto \w se|strong="H1961"\w* volverá flaco.  
\v 5 \w Será|strong="H1961"\w* \w como|strong="H1961"\w* \w cuando|strong="H1961"\w* el \w segador|strong="H7114"\w* recoge el trigo y con su \w brazo|strong="H2220"\w* \w siega|strong="H7114"\w* las \w espigas|strong="H7641"\w*; \w sí|strong="H1961"\w*, \w será|strong="H1961"\w* \w como|strong="H1961"\w* el \w que|strong="H7105"\w* recoge \w espigas|strong="H7641"\w* en el \w valle|strong="H6010"\w* de Refaim.  
\v 6 Solo quedarán rebuscos, como cuando se sacude el olivo: \w dos|strong="H8147"\w* \w o|strong="H3068"\w* \w tres|strong="H7969"\w* \w aceitunas|strong="H2132"\w* en la punta \w de|strong="H2568"\w* la rama más alta, \w o|strong="H3068"\w* cuatro \w o|strong="H3068"\w* \w cinco|strong="H2568"\w* en las ramas exteriores del árbol frutal”, \w dice|strong="H5002"\w* Yahvé, el \w Dios|strong="H3068"\w* \w de|strong="H2568"\w* \w Israel|strong="H3478"\w*.  
\v 7 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w la|strong="H1931"\w* gente volverá \w la|strong="H1931"\w* mirada \w a|strong="H3068"\w* \w su|strong="H1931"\w* Creador, \w y|strong="H5921"\w* \w sus|strong="H1931"\w* \w ojos|strong="H5869"\w* buscarán \w al|strong="H5921"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*.  
\v 8 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w mirarán|strong="H7200"\w* \w a|strong="H3068"\w* los \w altares|strong="H4196"\w* \w que|strong="H3808"\w* sus \w manos|strong="H3027"\w* \w fabricaron|strong="H6213"\w*, \w ni|strong="H3808"\w* apreciarán \w lo|strong="H3808"\w* \w que|strong="H3808"\w* sus propios dedos \w hicieron|strong="H6213"\w*: las imágenes de Asera y los \w altares|strong="H4196"\w* de incienso.  
\v 9 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w sus|strong="H1931"\w* \w ciudades|strong="H5892"\w* fortificadas \w serán|strong="H1961"\w* \w como|strong="H1961"\w* \w los|strong="H1121"\w* \w lugares|strong="H5892"\w* abandonados en \w los|strong="H1121"\w* bosques y en las cumbres, \w que|strong="H1931"\w* \w fueron|strong="H1961"\w* dejados \w ante|strong="H6440"\w* \w el|strong="H1931"\w* avance \w de|strong="H6440"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* \w de|strong="H6440"\w* \w Israel|strong="H3478"\w*; y todo \w será|strong="H1961"\w* desolación.  
\v 10 \w Porque|strong="H3588"\w* ustedes \w se|strong="H5921"\w* han olvidado \w del|strong="H5921"\w* Dios \w de|strong="H5921"\w* \w su|strong="H3588"\w* salvación \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H5921"\w* han acordado \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w roca|strong="H6697"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* refugio. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w aunque|strong="H3588"\w* siembren \w plantas|strong="H5193"\w* \w hermosas|strong="H5282"\w* \w y|strong="H3588"\w* pongan injertos extraños,  
\v 11 y aunque el \w día|strong="H3117"\w* \w que|strong="H3117"\w* las siembren las hagan crecer y \w a|strong="H3068"\w* la \w mañana|strong="H1242"\w* siguiente las hagan florecer, la cosecha se perderá en el \w día|strong="H3117"\w* del sufrimiento y del dolor incurable.   
\p
\v 12 ¡\w Qué|strong="H5971"\w* estruendo \w de|strong="H5971"\w* tantos \w pueblos|strong="H5971"\w*! Rugen \w como|strong="H1993"\w* el rugido del \w mar|strong="H3220"\w*. ¡\w Qué|strong="H5971"\w* estrépito \w de|strong="H5971"\w* naciones! Resuenan \w como|strong="H1993"\w* el estruendo \w de|strong="H5971"\w* \w aguas|strong="H4325"\w* impetuosas.  
\v 13 Las naciones hacen ruido como el estruendo \w de|strong="H6440"\w* \w muchas|strong="H7227"\w* \w aguas|strong="H4325"\w*, pero Dios las reprenderá y huirán lejos; serán perseguidas como la paja \w de|strong="H6440"\w* \w los|strong="H7291"\w* \w montes|strong="H2022"\w* \w ante|strong="H6440"\w* el \w viento|strong="H7307"\w*, como el polvo \w que|strong="H4325"\w* arrastra la tempestad.  
\v 14 \w Al|strong="H6256"\w* caer la \w tarde|strong="H6153"\w*, llega el terror; pero \w antes|strong="H2962"\w* \w de|strong="H6256"\w* la \w mañana|strong="H1242"\w*, el enemigo \w ya|strong="H2088"\w* ha desaparecido. \w Este|strong="H2088"\w* \w es|strong="H2088"\w* el destino \w de|strong="H6256"\w* los \w que|strong="H2088"\w* nos saquean \w y|strong="H1091"\w* la \w suerte|strong="H1486"\w* \w de|strong="H6256"\w* los \w que|strong="H2088"\w* nos roban.   
\c 18  
\p
\v 1 ¡\w Ay|strong="H1945"\w* de la tierra donde zumban las \w alas|strong="H3671"\w*, que está más allá de los ríos de \w Etiopía|strong="H3568"\w*!  
\v 2 \w Esa|strong="H1931"\w* tierra \w envía|strong="H7971"\w* \w mensajeros|strong="H4397"\w* \w por|strong="H5921"\w* \w el|strong="H1931"\w* \w mar|strong="H3220"\w*, \w en|strong="H5921"\w* barcos \w de|strong="H4480"\w* papiro \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*. ¡\w Vayan|strong="H3212"\w*, \w mensajeros|strong="H4397"\w* veloces, \w a|strong="H3068"\w* \w esa|strong="H1931"\w* \w nación|strong="H1471"\w* \w de|strong="H4480"\w* \w gente|strong="H1471"\w* alta \w y|strong="H5921"\w* piel bronceada, \w a|strong="H3068"\w* \w ese|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w temido|strong="H3372"\w* \w por|strong="H5921"\w* todas partes, \w nación|strong="H1471"\w* conquistadora \w y|strong="H5921"\w* dominante, \w cuya|strong="H1931"\w* tierra \w está|strong="H1931"\w* dividida \w por|strong="H5921"\w* ríos!  
\v 3 \w Todos|strong="H3605"\w* ustedes, \w habitantes|strong="H3427"\w* del \w mundo|strong="H8398"\w* y gente de \w la|strong="H3605"\w* tierra: cuando se levante \w la|strong="H3605"\w* \w bandera|strong="H5251"\w* en las montañas, ¡miren!; y cuando suene \w la|strong="H3605"\w* \w trompeta|strong="H7782"\w*, ¡\w escuchen|strong="H8085"\w*!   
\p
\v 4 \w Porque|strong="H3588"\w* Yahvé \w me|strong="H5921"\w* \w ha|strong="H3541"\w* dicho \w esto|strong="H3541"\w*: “\w Me|strong="H5921"\w* quedaré tranquilo, observando \w desde|strong="H5921"\w* \w mi|strong="H5921"\w* morada, \w como|strong="H3588"\w* \w el|strong="H5921"\w* calor radiante bajo \w el|strong="H5921"\w* sol, \w como|strong="H3588"\w* una \w nube|strong="H5645"\w* \w de|strong="H5921"\w* \w rocío|strong="H2919"\w* \w en|strong="H5921"\w* \w el|strong="H5921"\w* calor \w de|strong="H5921"\w* \w la|strong="H5921"\w* cosecha”.  
\v 5 \w Porque|strong="H3588"\w* \w antes|strong="H6440"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* cosecha, \w cuando|strong="H3588"\w* termine \w la|strong="H3588"\w* floración \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w flor|strong="H6525"\w* \w se|strong="H1961"\w* convierta \w en|strong="H3588"\w* uva madura, \w él|strong="H3588"\w* \w cortará|strong="H3772"\w* \w los|strong="H1961"\w* brotes \w con|strong="H3588"\w* podaderas, \w y|strong="H3588"\w* arrancará \w y|strong="H3588"\w* \w quitará|strong="H5493"\w* las \w ramas|strong="H7105"\w*.  
\v 6 \w Todo|strong="H3605"\w* será dejado \w para|strong="H5921"\w* \w las|strong="H5921"\w* \w aves|strong="H5861"\w* \w de|strong="H5921"\w* rapiña \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w montes|strong="H2022"\w* \w y|strong="H5921"\w* \w para|strong="H5921"\w* \w los|strong="H5921"\w* animales salvajes; \w las|strong="H5921"\w* \w aves|strong="H5861"\w* \w se|strong="H5921"\w* alimentarán \w de|strong="H5921"\w* eso \w en|strong="H5921"\w* \w el|strong="H5921"\w* verano, \w y|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* animales \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra pasarán allí \w el|strong="H5921"\w* invierno.  
\v 7 \w En|strong="H4480"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w*, \w se|strong="H1931"\w* \w le|strong="H1931"\w* traerá un tributo \w a|strong="H3068"\w* Yahvé \w de|strong="H4480"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w* \w de|strong="H4480"\w* \w parte|strong="H4725"\w* \w de|strong="H4480"\w* \w ese|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w de|strong="H4480"\w* \w gente|strong="H1471"\w* alta y piel bronceada, \w de|strong="H4480"\w* \w ese|strong="H1931"\w* \w pueblo|strong="H5971"\w* \w temido|strong="H3372"\w* \w por|strong="H4480"\w* todas partes, \w nación|strong="H1471"\w* conquistadora y dominante, \w cuya|strong="H1931"\w* tierra \w está|strong="H1931"\w* dividida \w por|strong="H4480"\w* ríos. Traerán \w la|strong="H1931"\w* ofrenda \w al|strong="H4480"\w* \w lugar|strong="H4725"\w* \w donde|strong="H8034"\w* reside \w el|strong="H1931"\w* \w nombre|strong="H8034"\w* \w de|strong="H4480"\w* Yahvé \w de|strong="H4480"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*: \w el|strong="H1931"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w*.   
\c 19  
\p
\v 1 Profecía \w sobre|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\p “Miren, Yahvé \w cabalga|strong="H7392"\w* \w sobre|strong="H5921"\w* una \w nube|strong="H5645"\w* veloz \w y|strong="H5921"\w* entra \w en|strong="H5921"\w* \w Egipto|strong="H4714"\w*. \w Los|strong="H5921"\w* ídolos \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w* tiemblan \w ante|strong="H6440"\w* su \w presencia|strong="H6440"\w*, \w y|strong="H5921"\w* \w el|strong="H5921"\w* ánimo \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w* \w se|strong="H5921"\w* desmorona \w en|strong="H5921"\w* su interior.  
\v 2 Yo incitaré \w a|strong="H3068"\w* \w egipcios|strong="H4714"\w* contra \w egipcios|strong="H4714"\w*; luchará cada uno contra su hermano y cada cual contra su \w prójimo|strong="H7453"\w*; \w ciudad|strong="H5892"\w* contra \w ciudad|strong="H5892"\w* y \w reino|strong="H4467"\w* contra \w reino|strong="H4467"\w*.  
\v 3 El \w espíritu|strong="H7307"\w* de los \w egipcios|strong="H4714"\w* se turbará \w dentro|strong="H7130"\w* de ellos y yo frustraré sus planes. Entonces consultarán \w a|strong="H3068"\w* los ídolos y \w a|strong="H3068"\w* los hechiceros, \w a|strong="H3068"\w* los médiums y \w a|strong="H3068"\w* los \w adivinos|strong="H3049"\w*.  
\v 4 Entregaré \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* en \w manos|strong="H3027"\w* de un amo cruel, y un \w rey|strong="H4428"\w* feroz los gobernará”, \w dice|strong="H5002"\w* el \w Señor|strong="H3068"\w*, Yahvé de los \w Ejércitos|strong="H6635"\w*.   
\p
\v 5 Las \w aguas|strong="H4325"\w* del \w mar|strong="H3220"\w* se agotarán y el \w río|strong="H5104"\w* se \w secará|strong="H3001"\w* por completo.  
\v 6 Los \w ríos|strong="H2975"\w* apestarán, los canales de Egipto perderán su caudal y se secarán; las \w cañas|strong="H7070"\w* y los cañaverales se marchitarán.  
\v 7 \w Las|strong="H5921"\w* praderas \w junto|strong="H5921"\w* \w al|strong="H5921"\w* Nilo, \w en|strong="H5921"\w* \w la|strong="H5921"\w* orilla \w del|strong="H5921"\w* \w río|strong="H2975"\w*, \w y|strong="H5921"\w* \w todo|strong="H3605"\w* \w lo|strong="H5921"\w* sembrado \w junto|strong="H5921"\w* \w a|strong="H3068"\w* \w él|strong="H5921"\w* \w se|strong="H5921"\w* \w secará|strong="H3001"\w*, \w se|strong="H5921"\w* dispersará \w con|strong="H5921"\w* \w el|strong="H5921"\w* viento \w y|strong="H5921"\w* desaparecerá.  
\v 8 \w Los|strong="H5921"\w* pescadores \w se|strong="H5921"\w* lamentarán; gemirán \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* echan \w el|strong="H5921"\w* anzuelo \w en|strong="H5921"\w* \w el|strong="H5921"\w* Nilo \w y|strong="H5921"\w* \w se|strong="H5921"\w* desanimarán \w los|strong="H5921"\w* \w que|strong="H5921"\w* lanzan redes \w en|strong="H5921"\w* \w las|strong="H5921"\w* \w aguas|strong="H4325"\w*.  
\v 9 Los que trabajan el \w lino|strong="H6593"\w* \w fino|strong="H8305"\w* y los que tejen telas blancas se quedarán desconcertados.  
\v 10 Sus cimientos \w serán|strong="H1961"\w* destruidos y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* trabajadores asalariados \w se|strong="H1961"\w* llenarán de angustia.   
\p
\v 11 Ciertamente son necios \w los|strong="H1121"\w* \w príncipes|strong="H8269"\w* \w de|strong="H1121"\w* Zoán; \w el|strong="H1121"\w* \w consejo|strong="H6098"\w* \w de|strong="H1121"\w* \w los|strong="H1121"\w* más \w sabios|strong="H2450"\w* \w consejeros|strong="H6098"\w* del \w faraón|strong="H6547"\w* se ha vuelto una tontería. ¿Cómo se atreven \w a|strong="H3068"\w* decirle \w al|strong="H4428"\w* \w faraón|strong="H6547"\w*: ‘Yo soy \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w sabios|strong="H2450"\w*, \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w reyes|strong="H4428"\w* \w antiguos|strong="H6924"\w*’?  
\v 12 ¿\w Dónde|strong="H5921"\w* están \w ahora|strong="H4994"\w* sus \w sabios|strong="H2450"\w*? \w Que|strong="H4100"\w* \w les|strong="H5921"\w* digan \w ahora|strong="H4994"\w*, \w si|strong="H4994"\w* es \w que|strong="H4100"\w* \w lo|strong="H4100"\w* \w saben|strong="H3045"\w*, \w lo|strong="H4100"\w* \w que|strong="H4100"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* ha planeado \w contra|strong="H5921"\w* \w Egipto|strong="H4714"\w*.  
\v 13 Los \w príncipes|strong="H8269"\w* \w de|strong="H8269"\w* Zoán se han vuelto tontos, los \w príncipes|strong="H8269"\w* \w de|strong="H8269"\w* Menfis se han dejado engañar; han hecho que \w Egipto|strong="H4714"\w* se pierda, ellos que son la base \w de|strong="H8269"\w* sus \w tribus|strong="H7626"\w*.  
\v 14 Yahvé ha enviado en \w medio|strong="H7130"\w* de \w ellos|strong="H3605"\w* un \w espíritu|strong="H7307"\w* de confusión; han \w hecho|strong="H4639"\w* \w que|strong="H3605"\w* \w Egipto|strong="H4714"\w* se tambalee en \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3605"\w* hace, como un borracho \w que|strong="H3605"\w* se revuelca en su propio \w vómito|strong="H6892"\w*.  
\v 15 \w No|strong="H3808"\w* \w habrá|strong="H1961"\w* \w para|strong="H1961"\w* \w Egipto|strong="H4714"\w* \w nada|strong="H3808"\w* \w que|strong="H3808"\w* puedan \w hacer|strong="H6213"\w*, \w ni|strong="H3808"\w* la \w cabeza|strong="H7218"\w* \w ni|strong="H3808"\w* la \w cola|strong="H2180"\w*, \w ni|strong="H3808"\w* la palma \w ni|strong="H3808"\w* \w el|strong="H6213"\w* junco.  
\v 16 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w los|strong="H5921"\w* \w egipcios|strong="H4714"\w* parecerán mujeres; temblarán \w de|strong="H5921"\w* \w miedo|strong="H6342"\w* \w ante|strong="H6440"\w* \w la|strong="H1931"\w* \w mano|strong="H3027"\w* amenazante \w de|strong="H5921"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w que|strong="H1931"\w* \w él|strong="H1931"\w* levantará \w contra|strong="H5921"\w* \w ellos|strong="H3027"\w*.  
\v 17 \w La|strong="H1931"\w* tierra \w de|strong="H5921"\w* \w Judá|strong="H3063"\w* \w será|strong="H1961"\w* \w el|strong="H1931"\w* terror \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*. \w Cualquiera|strong="H3605"\w* \w que|strong="H1931"\w* oiga mencionarla \w tendrá|strong="H1961"\w* \w miedo|strong="H6342"\w*, \w a|strong="H3068"\w* \w causa|strong="H6440"\w* \w del|strong="H5921"\w* plan \w que|strong="H1931"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* ha decidido \w contra|strong="H5921"\w* \w ellos|strong="H1931"\w*.  
\v 18 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w habrá|strong="H1961"\w* \w cinco|strong="H2568"\w* \w ciudades|strong="H5892"\w* en \w la|strong="H1931"\w* tierra \w de|strong="H2568"\w* \w Egipto|strong="H4714"\w* \w que|strong="H1931"\w* \w hablen|strong="H1696"\w* \w la|strong="H1931"\w* \w lengua|strong="H8193"\w* \w de|strong="H2568"\w* \w Canaán|strong="H3667"\w* y \w que|strong="H1931"\w* juren lealtad \w a|strong="H3068"\w* Yahvé \w de|strong="H2568"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*. Una \w de|strong="H2568"\w* \w ellas|strong="H1931"\w* \w se|strong="H1961"\w* llamará “\w Ciudad|strong="H5892"\w* \w de|strong="H2568"\w* \w la|strong="H1931"\w* Destrucción”.   
\p
\v 19 \w En|strong="H8432"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w habrá|strong="H1961"\w* un \w altar|strong="H4196"\w* \w para|strong="H1961"\w* Yahvé \w en|strong="H8432"\w* \w medio|strong="H8432"\w* de \w Egipto|strong="H4714"\w*, y un monumento \w a|strong="H3068"\w* Yahvé cerca de \w su|strong="H1931"\w* frontera.  
\v 20 Esto \w servirá|strong="H1961"\w* \w de|strong="H3588"\w* señal \w y|strong="H3588"\w* \w testimonio|strong="H5707"\w* \w de|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H1961"\w* \w Ejércitos|strong="H6635"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* \w Egipto|strong="H4714"\w*. \w Cuando|strong="H3588"\w* clamen \w a|strong="H3068"\w* Yahvé \w por|strong="H3588"\w* culpa \w de|strong="H3588"\w* sus opresores, \w él|strong="H3588"\w* les \w enviará|strong="H7971"\w* un \w salvador|strong="H3467"\w* \w y|strong="H3588"\w* defensor \w que|strong="H3588"\w* \w los|strong="H1961"\w* \w libre|strong="H5337"\w*.  
\v 21 Yahvé \w se|strong="H3045"\w* \w dará|strong="H7999"\w* \w a|strong="H3068"\w* conocer \w a|strong="H3068"\w* \w los|strong="H1931"\w* \w egipcios|strong="H4714"\w*, y en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w ellos|strong="H1931"\w* reconocerán \w a|strong="H3068"\w* Yahvé. \w Lo|strong="H1931"\w* adorarán con \w sacrificios|strong="H2077"\w* y ofrendas; \w le|strong="H1931"\w* \w harán|strong="H5647"\w* promesas y las \w cumplirán|strong="H7999"\w*.  
\v 22 Yahvé castigará \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*; \w lo|strong="H5704"\w* castigará, pero también \w lo|strong="H5704"\w* sanará. Ellos se \w volverán|strong="H7725"\w* \w a|strong="H3068"\w* Yahvé; él escuchará sus súplicas \w y|strong="H5704"\w* los sanará.   
\p
\v 23 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w habrá|strong="H1961"\w* un gran \w camino|strong="H4546"\w* desde \w Egipto|strong="H4714"\w* \w hasta|strong="H3117"\w* Asiria. \w Los|strong="H1931"\w* asirios entrarán en \w Egipto|strong="H4714"\w* y \w los|strong="H1931"\w* \w egipcios|strong="H4714"\w* en Asiria; y \w los|strong="H1931"\w* \w egipcios|strong="H4714"\w* adorarán \w a|strong="H3068"\w* Yahvé junto con \w los|strong="H1931"\w* asirios.   
\p
\v 24 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w Israel|strong="H3478"\w* \w será|strong="H1961"\w* \w el|strong="H1931"\w* \w tercero|strong="H7992"\w* junto con \w Egipto|strong="H4714"\w* y Asiria, y \w será|strong="H1961"\w* una \w bendición|strong="H1293"\w* en \w medio|strong="H7130"\w* de \w la|strong="H1931"\w* tierra.  
\v 25 Porque Yahvé \w de|strong="H5971"\w* los \w Ejércitos|strong="H6635"\w* los \w bendecirá|strong="H1288"\w* diciendo: “\w Bendito|strong="H1288"\w* sea \w Egipto|strong="H4714"\w*, mi \w pueblo|strong="H5971"\w*; y Asiria, \w obra|strong="H4639"\w* \w de|strong="H5971"\w* mis \w manos|strong="H3027"\w*; \w e|strong="H3068"\w* \w Israel|strong="H3478"\w*, mi \w herencia|strong="H5159"\w*”.   
\c 20  
\p
\v 1 El \w año|strong="H8141"\w* en que el comandante en jefe, \w enviado|strong="H7971"\w* \w por|strong="H4428"\w* \w Sargón|strong="H5623"\w*, \w rey|strong="H4428"\w* \w de|strong="H3898"\w* Asiria, llegó \w a|strong="H3068"\w* Asdod, la atacó y la conquistó;  
\v 2 \w en|strong="H5921"\w* \w aquel|strong="H1931"\w* \w tiempo|strong="H6256"\w* Yahvé \w habló|strong="H1696"\w* \w por|strong="H5921"\w* \w medio|strong="H3027"\w* \w de|strong="H5921"\w* \w Isaías|strong="H3470"\w* \w hijo|strong="H1121"\w* \w de|strong="H5921"\w* Amoz, \w y|strong="H5921"\w* \w le|strong="H1931"\w* \w dijo|strong="H1696"\w*: “\w Ve|strong="H3212"\w*, quítate \w la|strong="H1931"\w* ropa \w de|strong="H5921"\w* luto \w de|strong="H5921"\w* \w la|strong="H1931"\w* cintura \w y|strong="H5921"\w* quítate \w las|strong="H5921"\w* sandalias \w de|strong="H5921"\w* \w los|strong="H1121"\w* \w pies|strong="H7272"\w*”. \w Isaías|strong="H3470"\w* \w lo|strong="H1931"\w* \w hizo|strong="H6213"\w* \w así|strong="H3651"\w*, \w y|strong="H5921"\w* \w anduvo|strong="H1980"\w* \w desnudo|strong="H6174"\w* \w y|strong="H5921"\w* descalzo.  
\v 3 Entonces Yahvé dijo: “Así \w como|strong="H5921"\w* \w mi|strong="H5921"\w* \w siervo|strong="H5650"\w* \w Isaías|strong="H3470"\w* ha \w andado|strong="H1980"\w* \w desnudo|strong="H6174"\w* \w y|strong="H5921"\w* descalzo durante \w tres|strong="H7969"\w* \w años|strong="H8141"\w*, \w como|strong="H5921"\w* una señal \w y|strong="H5921"\w* una advertencia \w contra|strong="H5921"\w* \w Egipto|strong="H4714"\w* \w y|strong="H5921"\w* \w Etiopía|strong="H3568"\w*,  
\v 4 \w así|strong="H3651"\w* el \w rey|strong="H4428"\w* de Asiria \w se|strong="H3651"\w* \w llevará|strong="H5090"\w* \w a|strong="H3068"\w* los \w cautivos|strong="H7628"\w* de \w Egipto|strong="H4714"\w* y \w a|strong="H3068"\w* los desterrados de \w Etiopía|strong="H3568"\w*. \w Se|strong="H3651"\w* los \w llevará|strong="H5090"\w* jóvenes y \w ancianos|strong="H2205"\w*, \w desnudos|strong="H6174"\w* y descalzos, y con las nalgas descubiertas, para \w vergüenza|strong="H6172"\w* de \w Egipto|strong="H4714"\w*.  
\v 5 Los \w que|strong="H4480"\w* confiaban \w en|strong="H4480"\w* \w Etiopía|strong="H3568"\w* y \w se|strong="H4480"\w* sentían orgullosos \w de|strong="H4480"\w* \w Egipto|strong="H4714"\w* quedarán aterrados y confundidos.  
\v 6 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w los|strong="H3427"\w* \w que|strong="H1931"\w* viven en \w esta|strong="H2088"\w* costa dirán: ‘¡Miren \w lo|strong="H1931"\w* \w que|strong="H1931"\w* \w le|strong="H1931"\w* pasó \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H1931"\w* eran nuestra \w esperanza|strong="H4007"\w*! Corrimos \w hacia|strong="H6440"\w* \w ellos|strong="H1931"\w* en busca \w de|strong="H6440"\w* \w ayuda|strong="H5833"\w* para \w que|strong="H1931"\w* nos libraran del \w rey|strong="H4428"\w* \w de|strong="H6440"\w* Asiria. \w Y|strong="H3068"\w* \w ahora|strong="H3117"\w*, ¿\w cómo|strong="H1931"\w* podremos \w escapar|strong="H4422"\w* \w nosotros|strong="H1931"\w*?’”   
\c 21  
\p
\v 1 Profecía sobre el \w desierto|strong="H4057"\w* del \w mar|strong="H3220"\w*.  
\p Como los torbellinos que barren el sur, así viene del \w desierto|strong="H4057"\w*, \w de|strong="H3372"\w* una tierra aterradora.  
\v 2 Se me ha \w revelado|strong="H5046"\w* una \w visión|strong="H2380"\w* angustiante: \w el|strong="H3605"\w* traidor traiciona y \w el|strong="H3605"\w* destructor \w destruye|strong="H7703"\w*. ¡Ataca, \w Elam|strong="H5867"\w*! ¡Sitia, \w Media|strong="H4074"\w*! He \w puesto|strong="H5927"\w* fin \w a|strong="H3068"\w* \w todo|strong="H3605"\w* lamento.  
\v 3 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w me|strong="H5921"\w* duele todo \w el|strong="H5921"\w* cuerpo; \w me|strong="H5921"\w* han dado dolores \w como|strong="H5921"\w* \w de|strong="H5921"\w* mujer \w de|strong="H5921"\w* parto. Estoy tan confundido \w que|strong="H5921"\w* \w no|strong="H5921"\w* puedo \w oír|strong="H8085"\w*, tan asustado \w que|strong="H5921"\w* \w no|strong="H5921"\w* puedo \w ver|strong="H7200"\w*.  
\v 4 Mi \w corazón|strong="H3824"\w* se agita, el terror me domina; la noche que tanto esperaba se ha vuelto un espanto para mí.  
\v 5 Preparan la \w mesa|strong="H7979"\w*, ponen las alfombras, comen y \w beben|strong="H8354"\w*. ¡\w Levántense|strong="H6965"\w*, \w jefes|strong="H8269"\w*, y engrasen sus \w escudos|strong="H4043"\w*!  
\v 6 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* Señor \w me|strong="H3588"\w* \w dijo|strong="H5046"\w*: “\w Ve|strong="H3212"\w* \w y|strong="H3588"\w* \w pon|strong="H5975"\w* un vigilante, \w para|strong="H3588"\w* \w que|strong="H3588"\w* informe \w de|strong="H3588"\w* todo lo \w que|strong="H3588"\w* \w vea|strong="H7200"\w*”.  
\v 7 Si \w ve|strong="H7200"\w* \w carros|strong="H7393"\w* de guerra con parejas de caballos, \w o|strong="H3068"\w* gente montada en burros \w o|strong="H3068"\w* en \w camellos|strong="H1581"\w*, que preste \w mucha|strong="H7227"\w* atención.  
\v 8 Entonces \w el|strong="H5921"\w* vigilante \w gritó|strong="H7121"\w* \w como|strong="H5921"\w* un león: “Señor, \w todo|strong="H3605"\w* \w el|strong="H5921"\w* \w día|strong="H3119"\w* \w estoy|strong="H5975"\w* firme \w en|strong="H5921"\w* \w mi|strong="H5921"\w* puesto \w de|strong="H5921"\w* vigilancia, \w y|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w noches|strong="H3915"\w* permanezco \w en|strong="H5921"\w* \w mi|strong="H5921"\w* lugar \w de|strong="H5921"\w* guardia.  
\v 9 ¡Miren, ahí viene un \w carro|strong="H7393"\w* de guerra con una pareja de caballos!”. \w Luego|strong="H2088"\w* \w él|strong="H3605"\w* anunció: “¡\w Cayó|strong="H5307"\w*, \w cayó|strong="H5307"\w* Babilonia! \w Todas|strong="H3605"\w* las imágenes de sus dioses quedaron \w rotas|strong="H7665"\w* en \w el|strong="H3605"\w* suelo”.   
\p
\v 10 ¡Pueblo mío, \w que|strong="H1121"\w* has sido trillado en mi \w era|strong="H1121"\w*! Lo \w que|strong="H1121"\w* \w escuché|strong="H8085"\w* \w de|strong="H1121"\w* parte \w de|strong="H1121"\w* Yahvé \w de|strong="H1121"\w* \w los|strong="H1121"\w* \w Ejércitos|strong="H6635"\w*, \w el|strong="H1121"\w* \w Dios|strong="H3068"\w* \w de|strong="H1121"\w* \w Israel|strong="H3478"\w*, es lo \w que|strong="H1121"\w* les he anunciado.   
\p
\v 11 Profecía sobre \w Dumá|strong="H1746"\w*.  
\p Alguien me grita desde \w Seir|strong="H8165"\w*: “Vigilante, ¿\w cuánto|strong="H4100"\w* falta para \w que|strong="H4100"\w* acabe \w la|strong="H8104"\w* \w noche|strong="H3915"\w*? Vigilante, ¿\w qué|strong="H4100"\w* ves en \w la|strong="H8104"\w* \w noche|strong="H3915"\w*?”.  
\v 12 \w El|strong="H1571"\w* vigilante \w respondió|strong="H7725"\w*: “\w Ya|strong="H3068"\w* viene \w la|strong="H1571"\w* \w mañana|strong="H1242"\w*, pero después \w volverá|strong="H7725"\w* \w la|strong="H1571"\w* \w noche|strong="H3915"\w*. \w Si|strong="H1571"\w* quieren preguntar, pregunten; pero \w vuelvan|strong="H7725"\w* otra vez”.   
\p
\v 13 Profecía sobre \w Arabia|strong="H6152"\w*.  
\p Ustedes, caravanas de los dedanitas, que se alojan en los matorrales de \w Arabia|strong="H6152"\w*:  
\v 14 salgan al encuentro del sediento y denle \w agua|strong="H4325"\w*; \w habitantes|strong="H3427"\w* \w de|strong="H4325"\w* la tierra \w de|strong="H4325"\w* Tema, lleven \w pan|strong="H3899"\w* \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H4325"\w* huyen.  
\v 15 \w Porque|strong="H3588"\w* vienen huyendo \w de|strong="H3588"\w* las \w espadas|strong="H2719"\w*, \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w* desenvainada, del \w arco|strong="H7198"\w* listo \w para|strong="H3588"\w* disparar \w y|strong="H3588"\w* del furor \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w batalla|strong="H4421"\w*.  
\v 16 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* Señor \w me|strong="H3588"\w* dijo: “\w Dentro|strong="H5750"\w* \w de|strong="H3588"\w* un \w año|strong="H8141"\w*, contado \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w de|strong="H3588"\w* un trabajador contratado, \w toda|strong="H3605"\w* \w la|strong="H3588"\w* \w gloria|strong="H3519"\w* \w de|strong="H3588"\w* \w Cedar|strong="H6938"\w* se terminará.  
\v 17 Serán muy \w pocos|strong="H4557"\w* \w los|strong="H1121"\w* arqueros \w que|strong="H3588"\w* queden \w de|strong="H3588"\w* \w los|strong="H1121"\w* \w valientes|strong="H1368"\w* \w de|strong="H3588"\w* \w Cedar|strong="H6938"\w*”. Yahvé, \w el|strong="H3588"\w* \w Dios|strong="H3068"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*, lo ha \w dicho|strong="H1696"\w*.   
\c 22  
\p
\v 1 Profecía sobre \w el|strong="H3588"\w* \w Valle|strong="H1516"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Visión|strong="H2384"\w*. ¿\w Qué|strong="H3588"\w* les pasa ahora, \w que|strong="H3588"\w* \w todos|strong="H3605"\w* han \w subido|strong="H5927"\w* \w a|strong="H3068"\w* las azoteas?  
\v 2 Tú, \w ciudad|strong="H5892"\w* llena de bullicio, \w ciudad|strong="H5892"\w* estrepitosa, pueblo \w alegre|strong="H5947"\w*; tus \w muertos|strong="H2491"\w* \w no|strong="H3808"\w* \w murieron|strong="H4191"\w* \w a|strong="H3068"\w* \w espada|strong="H2719"\w*, \w ni|strong="H3808"\w* \w murieron|strong="H4191"\w* en \w batalla|strong="H4421"\w*.  
\v 3 \w Todos|strong="H3605"\w* tus jefes \w huyeron|strong="H5074"\w* \w juntos|strong="H3162"\w*, sin usar \w el|strong="H3605"\w* \w arco|strong="H7198"\w* fueron capturados; \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* en ti se \w hallaron|strong="H4672"\w* fueron hechos prisioneros, aunque habían huido \w lejos|strong="H7350"\w*.  
\v 4 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* dije: “Apártense \w de|strong="H4480"\w* \w mí|strong="H5921"\w*, déjenme llorar amargamente; \w no|strong="H5921"\w* traten \w de|strong="H4480"\w* \w consolarme|strong="H5162"\w* \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w destrucción|strong="H7701"\w* \w de|strong="H4480"\w* \w la|strong="H5921"\w* \w hija|strong="H1323"\w* \w de|strong="H4480"\w* \w mi|strong="H5921"\w* \w pueblo|strong="H5971"\w*”.   
\p
\v 5 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* Señor, Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w*, tiene un \w día|strong="H3117"\w* \w de|strong="H3588"\w* confusión, \w de|strong="H3588"\w* pisoteo \w y|strong="H3588"\w* \w de|strong="H3588"\w* angustia \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w Valle|strong="H1516"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w Visión|strong="H2384"\w*; un \w día|strong="H3117"\w* \w de|strong="H3588"\w* derribar muros \w y|strong="H3588"\w* \w de|strong="H3588"\w* gritos \w de|strong="H3588"\w* auxilio hacia \w los|strong="H3588"\w* \w montes|strong="H2022"\w*.  
\v 6 \w Elam|strong="H5867"\w* \w tomó|strong="H5375"\w* su aljaba, con \w carros|strong="H7393"\w* de guerra y \w jinetes|strong="H6571"\w*, y Kir sacó el \w escudo|strong="H4043"\w* de su funda.  
\v 7 Tus \w valles|strong="H6010"\w* más hermosos \w se|strong="H1961"\w* \w llenaron|strong="H4390"\w* de \w carros|strong="H7393"\w*, y la caballería \w se|strong="H1961"\w* \w puso|strong="H7896"\w* en formación frente \w a|strong="H3068"\w* la \w puerta|strong="H8179"\w*.  
\v 8 \w Judá|strong="H3063"\w* \w se|strong="H1931"\w* quedó sin defensa; y en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* ustedes buscaron las \w armas|strong="H5402"\w* en \w la|strong="H1931"\w* \w Casa|strong="H1004"\w* del \w Bosque|strong="H3293"\w*.  
\v 9 \w Vieron|strong="H7200"\w* \w que|strong="H3588"\w* las brechas \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w de|strong="H3588"\w* \w David|strong="H1732"\w* eran \w muchas|strong="H7235"\w*, \w y|strong="H3588"\w* almacenaron \w el|strong="H3588"\w* \w agua|strong="H4325"\w* del \w estanque|strong="H1295"\w* inferior.  
\v 10 \w Contaron|strong="H5608"\w* las \w casas|strong="H1004"\w* de Jerusalén y derribaron algunas para reforzar la muralla.  
\v 11 También \w hicieron|strong="H6213"\w* un depósito \w entre|strong="H3808"\w* los dos \w muros|strong="H2346"\w* para \w el|strong="H6213"\w* \w agua|strong="H4325"\w* del \w estanque|strong="H1295"\w* viejo; pero \w no|strong="H3808"\w* \w se|strong="H3808"\w* fijaron en \w el|strong="H6213"\w* \w que|strong="H3808"\w* \w hizo|strong="H6213"\w* todo \w esto|strong="H6213"\w*, \w ni|strong="H3808"\w* respetaron al \w que|strong="H3808"\w* \w lo|strong="H3808"\w* planeó \w hace|strong="H6213"\w* mucho tiempo.   
\p
\v 12 Por \w eso|strong="H1931"\w* \w el|strong="H1931"\w* Señor, Yahvé de \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w*, \w llamó|strong="H7121"\w* en \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* al \w llanto|strong="H1065"\w* y al luto, \w a|strong="H3068"\w* raparse \w la|strong="H1931"\w* cabeza y \w a|strong="H3068"\w* vestirse de ropa de luto;  
\v 13 \w pero|strong="H3588"\w* lo \w que|strong="H3588"\w* \w hubo|strong="H2009"\w* fue \w gozo|strong="H8057"\w* \w y|strong="H3588"\w* \w alegría|strong="H8057"\w*, \w matando|strong="H4191"\w* \w vacas|strong="H1241"\w* \w y|strong="H3588"\w* degollando \w ovejas|strong="H6629"\w*, comiendo \w carne|strong="H1320"\w* \w y|strong="H3588"\w* \w bebiendo|strong="H8354"\w* \w vino|strong="H3196"\w*: “Comamos \w y|strong="H3588"\w* bebamos, \w que|strong="H3588"\w* \w mañana|strong="H4279"\w* \w moriremos|strong="H4191"\w*”.  
\v 14 Yahvé \w de|strong="H5704"\w* los \w Ejércitos|strong="H6635"\w* me reveló \w al|strong="H5704"\w* oído: “\w Ciertamente|strong="H4191"\w* \w este|strong="H2088"\w* \w pecado|strong="H5771"\w* no les será perdonado \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w mueran|strong="H4191"\w*”, dice el \w Señor|strong="H3068"\w*, Yahvé \w de|strong="H5704"\w* los \w Ejércitos|strong="H6635"\w*.   
\p
\v 15 \w Así|strong="H3541"\w* dice \w el|strong="H5921"\w* Señor, Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*: “\w Vayan|strong="H3212"\w* \w y|strong="H5921"\w* preséntense ante \w ese|strong="H2088"\w* administrador, ante \w Sebna|strong="H7644"\w*, \w el|strong="H5921"\w* encargado \w del|strong="H5921"\w* palacio, \w y|strong="H5921"\w* díganle:  
\v 16 ‘¿\w Qué|strong="H3588"\w* derecho tienes \w aquí|strong="H6311"\w*, \w o|strong="H3068"\w* \w a|strong="H3068"\w* \w quién|strong="H4310"\w* tienes tú \w aquí|strong="H6311"\w*, \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* labres \w aquí|strong="H6311"\w* un \w sepulcro|strong="H6913"\w*?’. ¡\w Te|strong="H3588"\w* labras una tumba \w en|strong="H3588"\w* las \w alturas|strong="H4791"\w* \w y|strong="H3588"\w* tallas \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w roca|strong="H5553"\w* un lugar \w de|strong="H3588"\w* descanso \w para|strong="H3588"\w* ti mismo!  
\v 17 Miren, Yahvé los lanzará con fuerza, los agarrará firmemente.  
\v 18 Los hará rodar como una pelota \w y|strong="H3519"\w* los arrojará \w a|strong="H3068"\w* un país inmenso. \w Allá|strong="H8033"\w* \w morirás|strong="H4191"\w*, Sebna, \w y|strong="H3519"\w* \w allá|strong="H8033"\w* quedarán tus \w carros|strong="H4818"\w* de lujo, tú, \w que|strong="H3027"\w* eres la vergüenza del palacio de tu señor.  
\v 19 Te quitaré de tu cargo y serás derribado de tu puesto.   
\p
\v 20 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w llamaré|strong="H7121"\w* \w a|strong="H3068"\w* \w mi|strong="H1961"\w* \w siervo|strong="H5650"\w* Eliaquim \w hijo|strong="H1121"\w* \w de|strong="H1121"\w* \w Hilcías|strong="H2518"\w*.  
\v 21 Lo \w vestiré|strong="H3847"\w* con tu túnica, lo ceñiré con tu banda y le \w entregaré|strong="H5414"\w* tu autoridad; y \w él|strong="H3427"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* un padre \w para|strong="H5414"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H3847"\w* Jerusalén y \w para|strong="H5414"\w* la \w casa|strong="H1004"\w* \w de|strong="H3847"\w* \w Judá|strong="H3063"\w*.  
\v 22 \w Pondré|strong="H5414"\w* \w la|strong="H5921"\w* llave \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* \w David|strong="H1732"\w* \w sobre|strong="H5921"\w* su \w hombro|strong="H7926"\w*; \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* abra, nadie \w lo|strong="H5921"\w* \w cerrará|strong="H5462"\w*, \w y|strong="H5921"\w* \w lo|strong="H5921"\w* \w que|strong="H5921"\w* \w él|strong="H5921"\w* cierre, nadie \w lo|strong="H5921"\w* \w abrirá|strong="H6605"\w*.  
\v 23 Lo hincaré \w como|strong="H1961"\w* un clavo en un \w lugar|strong="H4725"\w* firme, \w y|strong="H3519"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* un \w trono|strong="H3678"\w* de honor \w para|strong="H1961"\w* la \w familia|strong="H1004"\w* de su padre.  
\v 24 \w De|strong="H5921"\w* \w él|strong="H5921"\w* colgará \w toda|strong="H3605"\w* \w la|strong="H5921"\w* \w gloria|strong="H3519"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w casa|strong="H1004"\w* \w de|strong="H5921"\w* su padre: su descendencia \w y|strong="H5921"\w* su prole, \w toda|strong="H3605"\w* \w la|strong="H5921"\w* vajilla, \w desde|strong="H5704"\w* \w las|strong="H5921"\w* tazas \w hasta|strong="H5704"\w* \w los|strong="H5921"\w* cántaros.  
\v 25 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* — \w dice|strong="H5002"\w* Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w* — \w el|strong="H1931"\w* clavo \w hincado|strong="H8628"\w* \w en|strong="H5921"\w* \w lugar|strong="H4725"\w* firme cederá, \w se|strong="H1931"\w* quebrará \w y|strong="H3588"\w* \w caerá|strong="H5307"\w*; \w y|strong="H3588"\w* \w toda|strong="H5921"\w* \w la|strong="H1931"\w* \w carga|strong="H4853"\w* \w que|strong="H3588"\w* estaba colgada \w de|strong="H5921"\w* \w él|strong="H1931"\w* \w se|strong="H1931"\w* \w echará|strong="H5307"\w* \w a|strong="H3068"\w* perder, \w porque|strong="H3588"\w* Yahvé ha \w hablado|strong="H1696"\w*”.   
\c 23  
\p
\v 1 Profecía sobre \w Tiro|strong="H6865"\w*.  
\p ¡Aúllen, barcos \w de|strong="H3588"\w* \w Tarsis|strong="H8659"\w*! \w Porque|strong="H3588"\w* \w Tiro|strong="H6865"\w* ha sido \w destruida|strong="H7703"\w*; \w no|strong="H3588"\w* queda \w casa|strong="H1004"\w* \w en|strong="H3588"\w* pie ni puerto \w a|strong="H3068"\w* donde entrar. Desde \w la|strong="H3588"\w* tierra \w de|strong="H3588"\w* Quitim les ha llegado \w la|strong="H3588"\w* noticia.  
\v 2 Guarden silencio, \w habitantes|strong="H3427"\w* de la costa; ustedes, \w a|strong="H3068"\w* quienes enriquecieron \w los|strong="H3427"\w* comerciantes de \w Sidón|strong="H6721"\w* que cruzan \w el|strong="H5674"\w* \w mar|strong="H3220"\w*.  
\v 3 Por las \w grandes|strong="H7227"\w* \w aguas|strong="H4325"\w* llegaba \w el|strong="H2975"\w* grano \w de|strong="H4325"\w* Sijor; la cosecha del Nilo \w era|strong="H1961"\w* su fuente \w de|strong="H4325"\w* ingresos, y Tiro \w era|strong="H1961"\w* \w el|strong="H2975"\w* mercado \w de|strong="H4325"\w* las \w naciones|strong="H1471"\w*.  
\v 4 Avergüénzate, \w Sidón|strong="H6721"\w*, \w porque|strong="H3588"\w* \w el|strong="H3588"\w* \w mar|strong="H3220"\w*, \w la|strong="H3588"\w* \w fortaleza|strong="H4581"\w* del \w mar|strong="H3220"\w*, \w ha|strong="H3808"\w* dicho: “\w Nunca|strong="H3808"\w* tuve dolores \w de|strong="H3588"\w* parto, \w ni|strong="H3808"\w* di \w a|strong="H3068"\w* luz; \w no|strong="H3808"\w* \w crié|strong="H1431"\w* jóvenes \w ni|strong="H3808"\w* eduqué \w a|strong="H3068"\w* muchachas”.  
\v 5 Cuando la noticia llegue \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w*, se angustiarán al saber lo que le pasó \w a|strong="H3068"\w* \w Tiro|strong="H6865"\w*.  
\v 6 ¡Crucen hacia \w Tarsis|strong="H8659"\w*! ¡Aúllen de dolor, \w habitantes|strong="H3427"\w* de la costa!  
\v 7 ¿\w Es|strong="H2063"\w* \w esta|strong="H2063"\w* su ciudad \w alegre|strong="H5947"\w*, \w que|strong="H3117"\w* tiene tantos \w años|strong="H3117"\w* de antigüedad y \w que|strong="H3117"\w* viajó tan \w lejos|strong="H7350"\w* para establecerse?   
\p
\v 8 ¿\w Quién|strong="H4310"\w* planeó \w esto|strong="H2063"\w* \w contra|strong="H5921"\w* \w Tiro|strong="H6865"\w*, \w la|strong="H5921"\w* \w que|strong="H4310"\w* coronaba reyes, \w cuyos|strong="H5921"\w* comerciantes eran \w príncipes|strong="H8269"\w* \w y|strong="H5921"\w* \w cuyos|strong="H5921"\w* \w mercaderes|strong="H5503"\w* eran \w los|strong="H5921"\w* nobles \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra?  
\v 9 Yahvé de \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w* \w lo|strong="H3605"\w* planeó, para humillar \w el|strong="H3605"\w* orgullo de \w toda|strong="H3605"\w* grandeza y para rebajar \w a|strong="H3068"\w* \w los|strong="H3605"\w* nobles de \w la|strong="H3605"\w* tierra.  
\v 10 Recorre tu tierra \w como|strong="H5750"\w* \w el|strong="H2975"\w* Nilo, \w hija|strong="H1323"\w* \w de|strong="H5750"\w* \w Tarsis|strong="H8659"\w*, porque ya no \w tienes|strong="H5750"\w* quien te ponga límites.  
\v 11 \w Él|strong="H5921"\w* \w extendió|strong="H5186"\w* su \w mano|strong="H3027"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w mar|strong="H3220"\w* \w e|strong="H3068"\w* hizo temblar \w los|strong="H5921"\w* \w reinos|strong="H4467"\w*; Yahvé ha dado \w la|strong="H5921"\w* \w orden|strong="H6680"\w* \w de|strong="H5921"\w* \w destruir|strong="H8045"\w* \w las|strong="H5921"\w* fortalezas \w de|strong="H5921"\w* \w Canaán|strong="H3667"\w*.  
\v 12 \w Él|strong="H5674"\w* \w ha|strong="H3808"\w* dicho: “\w No|strong="H3808"\w* volverás \w a|strong="H3068"\w* alegrarte, \w virgen|strong="H1330"\w* \w oprimida|strong="H6231"\w*, \w hija|strong="H1323"\w* \w de|strong="H5750"\w* \w Sidón|strong="H6721"\w*. \w Levántate|strong="H6965"\w* \w y|strong="H1571"\w* cruza \w hacia|strong="H8033"\w* Quitim, \w aunque|strong="H8033"\w* \w ni|strong="H3808"\w* siquiera \w allí|strong="H8033"\w* tendrás descanso”.   
\p
\v 13 Miren la tierra \w de|strong="H5971"\w* \w los|strong="H1961"\w* \w caldeos|strong="H3778"\w*. \w Ese|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w ya|strong="H2088"\w* \w no|strong="H3808"\w* existe; \w los|strong="H1961"\w* asirios la convirtieron en guarida \w de|strong="H5971"\w* animales del desierto. \w Levantaron|strong="H6965"\w* sus torres \w de|strong="H5971"\w* asalto, derribaron sus palacios y la dejaron en ruinas.  
\v 14 ¡Aúllen, barcos \w de|strong="H3588"\w* \w Tarsis|strong="H8659"\w*, \w porque|strong="H3588"\w* \w su|strong="H3588"\w* defensa ha sido \w destruida|strong="H7703"\w*!  
\v 15 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w Tiro|strong="H6865"\w* \w será|strong="H1961"\w* \w olvidada|strong="H7911"\w* durante \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*, \w lo|strong="H1931"\w* \w que|strong="H1931"\w* dura \w la|strong="H1931"\w* \w vida|strong="H3117"\w* \w de|strong="H7911"\w* un \w rey|strong="H4428"\w*. \w Al|strong="H4428"\w* final \w de|strong="H7911"\w* \w los|strong="H1931"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*, \w le|strong="H1931"\w* pasará \w a|strong="H3068"\w* \w Tiro|strong="H6865"\w* \w lo|strong="H1931"\w* \w que|strong="H1931"\w* dice \w la|strong="H1931"\w* \w canción|strong="H7892"\w* \w de|strong="H7911"\w* \w la|strong="H1931"\w* prostituta:  
\v 16 “\w Toma|strong="H3947"\w* el \w arpa|strong="H3658"\w*, recorre la \w ciudad|strong="H5892"\w*, prostituta \w olvidada|strong="H7911"\w*; toca \w bien|strong="H3190"\w*, canta \w muchas|strong="H7235"\w* \w canciones|strong="H7892"\w*, \w para|strong="H4616"\w* \w que|strong="H4616"\w* vuelvan \w a|strong="H3068"\w* recordarte”.  
\v 17 \w Al|strong="H5921"\w* cabo \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w setenta|strong="H7657"\w* \w años|strong="H8141"\w*, Yahvé \w visitará|strong="H6485"\w* \w a|strong="H3068"\w* \w Tiro|strong="H6865"\w*. \w Ella|strong="H5921"\w* \w volverá|strong="H7725"\w* \w a|strong="H3068"\w* su oficio \w y|strong="H5921"\w* \w se|strong="H1961"\w* alquilará \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w reinos|strong="H4467"\w* \w del|strong="H5921"\w* mundo \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w faz|strong="H6440"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\v 18 \w Pero|strong="H3588"\w* sus ganancias \w y|strong="H3588"\w* \w su|strong="H3588"\w* salario \w serán|strong="H1961"\w* consagrados \w a|strong="H3068"\w* Yahvé. \w No|strong="H3808"\w* \w se|strong="H1961"\w* guardarán \w ni|strong="H3808"\w* \w se|strong="H1961"\w* almacenarán, \w sino|strong="H3588"\w* \w que|strong="H3588"\w* sus ingresos \w serán|strong="H1961"\w* \w para|strong="H3588"\w* \w los|strong="H3427"\w* \w que|strong="H3588"\w* viven \w en|strong="H3588"\w* \w la|strong="H3588"\w* \w presencia|strong="H6440"\w* \w de|strong="H3588"\w* Yahvé, \w para|strong="H3588"\w* \w que|strong="H3588"\w* tengan comida abundante \w y|strong="H3588"\w* ropas finas.   
\c 24  
\p
\v 1 Miren, Yahvé \w vacía|strong="H1238"\w* la tierra y la deja desierta; trastorna su superficie y dispersa \w a|strong="H3068"\w* sus \w habitantes|strong="H3427"\w*.  
\v 2 Lo mismo le pasará al \w pueblo|strong="H5971"\w* \w que|strong="H5971"\w* al \w sacerdote|strong="H3548"\w*, al \w siervo|strong="H5650"\w* \w que|strong="H5971"\w* \w a|strong="H3068"\w* su amo, \w a|strong="H3068"\w* la criada \w que|strong="H5971"\w* \w a|strong="H3068"\w* su \w señora|strong="H1404"\w*, al comprador \w que|strong="H5971"\w* al vendedor, al acreedor \w que|strong="H5971"\w* al deudor, y al \w que|strong="H5971"\w* cobra intereses \w que|strong="H5971"\w* al \w que|strong="H5971"\w* \w los|strong="H1961"\w* paga.  
\v 3 \w La|strong="H3588"\w* tierra será totalmente vaciada \w y|strong="H3588"\w* saqueada, \w porque|strong="H3588"\w* Yahvé ha \w dicho|strong="H1696"\w* \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w*.  
\v 4 La tierra \w se|strong="H5971"\w* marchita y \w se|strong="H5971"\w* marchita; el \w mundo|strong="H8398"\w* languidece y \w se|strong="H5971"\w* desvanece; los hombres más importantes \w de|strong="H5971"\w* la tierra desfallecen.  
\v 5 \w La|strong="H3588"\w* tierra ha sido profanada \w por|strong="H3588"\w* sus \w habitantes|strong="H3427"\w*, \w porque|strong="H3588"\w* desobedecieron las \w leyes|strong="H8451"\w*, violaron \w los|strong="H3427"\w* \w mandamientos|strong="H2706"\w* \w y|strong="H3588"\w* \w rompieron|strong="H6565"\w* \w el|strong="H3588"\w* \w pacto|strong="H1285"\w* \w eterno|strong="H5769"\w*.  
\v 6 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, una maldición devora \w la|strong="H5921"\w* tierra \w y|strong="H5921"\w* sus \w habitantes|strong="H3427"\w* sufren \w las|strong="H5921"\w* consecuencias; \w por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra han sido consumidos \w y|strong="H5921"\w* quedan muy pocos seres humanos.  
\v 7 \w El|strong="H3605"\w* \w vino|strong="H8492"\w* nuevo está de luto, \w la|strong="H3605"\w* \w vid|strong="H1612"\w* languidece, y \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3605"\w* eran felices ahora suspiran de dolor.  
\v 8 \w Cesó|strong="H7673"\w* el júbilo de los panderos, se acabó el ruido de los que se divierten, se terminó la alegría del \w arpa|strong="H3658"\w*.  
\v 9 \w Ya|strong="H3068"\w* \w no|strong="H3808"\w* \w beben|strong="H8354"\w* \w vino|strong="H3196"\w* \w entre|strong="H3808"\w* \w canciones|strong="H7892"\w*; la \w bebida|strong="H7941"\w* fuerte les resulta amarga \w a|strong="H3068"\w* los \w que|strong="H3808"\w* la prueban.  
\v 10 \w La|strong="H3605"\w* \w ciudad|strong="H7151"\w* del caos está en ruinas; \w todas|strong="H3605"\w* las \w casas|strong="H1004"\w* se cierran para \w que|strong="H3605"\w* \w nadie|strong="H3605"\w* pueda entrar.  
\v 11 \w En|strong="H5921"\w* \w las|strong="H5921"\w* \w calles|strong="H2351"\w* \w se|strong="H5921"\w* grita \w por|strong="H5921"\w* falta \w de|strong="H5921"\w* \w vino|strong="H3196"\w*; \w toda|strong="H3605"\w* \w alegría|strong="H8057"\w* \w se|strong="H5921"\w* ha apagado, \w la|strong="H5921"\w* felicidad \w se|strong="H5921"\w* ha ido \w del|strong="H5921"\w* país.  
\v 12 La \w ciudad|strong="H5892"\w* ha quedado desolada y sus \w puertas|strong="H8179"\w* han sido hechas pedazos.  
\v 13 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* \w sucederá|strong="H1961"\w* \w en|strong="H8432"\w* toda \w la|strong="H3588"\w* tierra \w y|strong="H3588"\w* \w entre|strong="H8432"\w* todos \w los|strong="H1961"\w* \w pueblos|strong="H5971"\w*: \w será|strong="H1961"\w* \w como|strong="H3588"\w* \w cuando|strong="H3588"\w* \w se|strong="H1961"\w* sacude un olivo, \w o|strong="H3068"\w* \w como|strong="H3588"\w* \w cuando|strong="H3588"\w* \w se|strong="H1961"\w* recogen las sobras \w después|strong="H1961"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* cosecha.   
\p
\v 14 Pero \w ellos|strong="H1992"\w* \w alzarán|strong="H5375"\w* \w su|strong="H1992"\w* \w voz|strong="H6963"\w* y \w cantarán|strong="H7442"\w* con júbilo; desde \w el|strong="H1992"\w* occidente aclamarán la majestad de Yahvé.  
\v 15 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, den gloria \w a|strong="H3068"\w* Yahvé \w en|strong="H5921"\w* \w las|strong="H5921"\w* tierras \w del|strong="H5921"\w* oriente, \w y|strong="H5921"\w* \w al|strong="H5921"\w* \w nombre|strong="H8034"\w* \w de|strong="H5921"\w* Yahvé, \w Dios|strong="H3068"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w en|strong="H5921"\w* \w las|strong="H5921"\w* costas \w del|strong="H5921"\w* \w mar|strong="H3220"\w*.  
\v 16 Desde los confines \w de|strong="H6662"\w* la tierra \w oímos|strong="H8085"\w* \w cánticos|strong="H2158"\w*: “¡\w Gloria|strong="H6643"\w* al \w justo|strong="H6662"\w*!”.  
\p Pero yo dije: “¡Ay \w de|strong="H6662"\w* mí, que me consumo! ¡Qué desdicha la mía!”. Los traidores han traicionado; han actuado con total traición.  
\v 17 ¡\w Terror|strong="H6343"\w*, fosa \w y|strong="H5921"\w* trampa \w les|strong="H5921"\w* esperan \w a|strong="H3068"\w* ustedes, \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra!  
\v 18 \w El|strong="H3588"\w* \w que|strong="H3588"\w* huya \w de|strong="H3588"\w* \w los|strong="H1961"\w* gritos \w de|strong="H3588"\w* \w terror|strong="H6343"\w* \w caerá|strong="H5307"\w* \w en|strong="H8432"\w* \w la|strong="H3588"\w* fosa, \w y|strong="H3588"\w* \w el|strong="H3588"\w* \w que|strong="H3588"\w* salga \w de|strong="H3588"\w* \w la|strong="H3588"\w* fosa \w quedará|strong="H1961"\w* atrapado \w en|strong="H8432"\w* \w la|strong="H3588"\w* trampa. \w Porque|strong="H3588"\w* las ventanas \w de|strong="H3588"\w* lo \w alto|strong="H4791"\w* \w se|strong="H1961"\w* han \w abierto|strong="H6605"\w* \w y|strong="H3588"\w* \w los|strong="H1961"\w* cimientos \w de|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w tiemblan|strong="H7493"\w*.  
\v 19 La tierra se quiebra por completo, se despedaza y se sacude violentamente.  
\v 20 \w La|strong="H5921"\w* tierra \w se|strong="H5921"\w* tambalea \w como|strong="H5921"\w* un borracho; \w se|strong="H5921"\w* mece \w de|strong="H5921"\w* un lado \w a|strong="H3068"\w* otro \w como|strong="H5921"\w* una choza \w en|strong="H5921"\w* medio \w de|strong="H5921"\w* \w la|strong="H5921"\w* tormenta. Su \w pecado|strong="H6588"\w* pesa \w tanto|strong="H5921"\w* \w sobre|strong="H5921"\w* \w ella|strong="H5921"\w*, \w que|strong="H3808"\w* \w caerá|strong="H5307"\w* \w y|strong="H5921"\w* \w no|strong="H3808"\w* \w volverá|strong="H3254"\w* \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*.   
\p
\v 21 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* Yahvé castigará \w en|strong="H5921"\w* \w lo|strong="H1931"\w* \w alto|strong="H4791"\w* \w a|strong="H3068"\w* \w los|strong="H5921"\w* poderes celestiales, \w y|strong="H5921"\w* \w en|strong="H5921"\w* \w la|strong="H1931"\w* tierra \w a|strong="H3068"\w* \w los|strong="H5921"\w* \w reyes|strong="H4428"\w* \w de|strong="H5921"\w* \w la|strong="H1931"\w* tierra.  
\v 22 Serán amontonados \w como|strong="H5921"\w* prisioneros \w en|strong="H5921"\w* una fosa \w y|strong="H5921"\w* quedarán encerrados \w en|strong="H5921"\w* \w la|strong="H5921"\w* cárcel; \w después|strong="H5921"\w* \w de|strong="H5921"\w* \w mucho|strong="H7230"\w* \w tiempo|strong="H3117"\w* serán castigados.  
\v 23 \w La|strong="H3588"\w* luna se confundirá \w y|strong="H3588"\w* \w el|strong="H3588"\w* sol se avergonzará, \w porque|strong="H3588"\w* Yahvé \w de|strong="H3588"\w* \w los|strong="H3588"\w* \w Ejércitos|strong="H6635"\w* \w reinará|strong="H4427"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w* \w y|strong="H3588"\w* \w en|strong="H3588"\w* Jerusalén, \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w gloria|strong="H3519"\w* resplandecerá ante sus \w ancianos|strong="H2205"\w*.   
\c 25  
\p
\v 1 Yahvé, \w tú|strong="H6213"\w* eres mi \w Dios|strong="H3068"\w*. \w Te|strong="H3588"\w* exaltaré \w y|strong="H3588"\w* \w alabaré|strong="H3034"\w* \w tu|strong="H6213"\w* \w nombre|strong="H8034"\w*, \w porque|strong="H3588"\w* has \w hecho|strong="H6213"\w* cosas asombrosas; tus planes \w de|strong="H3588"\w* \w hace|strong="H6213"\w* mucho tiempo \w son|strong="H3588"\w* fieles \w y|strong="H3588"\w* verdaderos.  
\v 2 Has convertido \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* \w en|strong="H3588"\w* un \w montón|strong="H1530"\w* \w de|strong="H3588"\w* ruinas, \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* amurallada \w en|strong="H3588"\w* escombros; \w el|strong="H3588"\w* palacio \w de|strong="H3588"\w* \w los|strong="H3588"\w* extranjeros \w ha|strong="H3808"\w* dejado \w de|strong="H3588"\w* ser \w ciudad|strong="H5892"\w* \w y|strong="H3588"\w* \w nunca|strong="H3808"\w* \w más|strong="H3588"\w* \w será|strong="H3808"\w* reconstruido.  
\v 3 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w* \w te|strong="H5921"\w* glorificará \w el|strong="H5921"\w* \w pueblo|strong="H5971"\w* \w fuerte|strong="H5794"\w*, \w y|strong="H5921"\w* \w las|strong="H5921"\w* ciudades \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* poderosas \w te|strong="H5921"\w* \w temerán|strong="H3372"\w*.  
\v 4 \w Porque|strong="H3588"\w* has \w sido|strong="H1961"\w* un refugio \w para|strong="H3588"\w* \w el|strong="H3588"\w* \w pobre|strong="H1800"\w*, un \w amparo|strong="H6738"\w* \w para|strong="H3588"\w* \w el|strong="H3588"\w* necesitado \w en|strong="H3588"\w* \w su|strong="H3588"\w* \w angustia|strong="H6862"\w*, refugio \w contra|strong="H1961"\w* \w la|strong="H3588"\w* tormenta \w y|strong="H3588"\w* \w sombra|strong="H6738"\w* \w contra|strong="H1961"\w* \w el|strong="H3588"\w* calor. \w Pues|strong="H3588"\w* \w el|strong="H3588"\w* aliento \w de|strong="H3588"\w* \w los|strong="H1961"\w* tiranos \w es|strong="H1961"\w* \w como|strong="H3588"\w* una tormenta \w contra|strong="H1961"\w* \w el|strong="H3588"\w* muro.  
\v 5 \w Como|strong="H5645"\w* el calor en tierra \w seca|strong="H2721"\w*, así calmas tú el estruendo de los extranjeros; \w como|strong="H5645"\w* el calor bajo la \w sombra|strong="H6738"\w* de una \w nube|strong="H5645"\w*, así apagas el canto de los crueles.   
\p
\v 6 En \w este|strong="H2088"\w* \w monte|strong="H2022"\w*, Yahvé \w de|strong="H5971"\w* \w los|strong="H3605"\w* \w Ejércitos|strong="H6635"\w* preparará \w para|strong="H5971"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w pueblos|strong="H5971"\w* un \w banquete|strong="H4960"\w* \w de|strong="H5971"\w* platillos exquisitos,\f + \fr 25:6 \ft literalmente, cosas gordas\f* un \w banquete|strong="H4960"\w* \w de|strong="H5971"\w* vinos refinados, \w de|strong="H5971"\w* carnes suculentas y \w de|strong="H5971"\w* \w los|strong="H3605"\w* mejores vinos.  
\v 7 \w En|strong="H5921"\w* \w este|strong="H2088"\w* \w monte|strong="H2022"\w* \w destruirá|strong="H1104"\w* \w el|strong="H5921"\w* velo \w que|strong="H5921"\w* cubre \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w pueblos|strong="H5971"\w*, \w la|strong="H5921"\w* venda \w que|strong="H5921"\w* envuelve \w a|strong="H3068"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*.  
\v 8 ¡\w Él|strong="H5921"\w* eliminará \w la|strong="H5921"\w* \w muerte|strong="H4194"\w* \w para|strong="H5921"\w* \w siempre|strong="H3605"\w*! \w El|strong="H5921"\w* \w Señor|strong="H3068"\w* Yahvé secará \w las|strong="H5921"\w* \w lágrimas|strong="H1832"\w* \w de|strong="H5921"\w* \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w rostros|strong="H6440"\w* \w y|strong="H3588"\w* \w quitará|strong="H5493"\w* \w de|strong="H5921"\w* \w toda|strong="H3605"\w* \w la|strong="H5921"\w* tierra \w la|strong="H5921"\w* \w deshonra|strong="H2781"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w pueblo|strong="H5971"\w*, \w porque|strong="H3588"\w* Yahvé ha \w hablado|strong="H1696"\w*.   
\p
\v 9 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w se|strong="H1931"\w* dirá: “¡Miren, \w este|strong="H2088"\w* \w es|strong="H1931"\w* nuestro \w Dios|strong="H3068"\w*! En \w él|strong="H1931"\w* confiamos y \w él|strong="H1931"\w* nos \w salvó|strong="H3467"\w*. ¡\w Este|strong="H2088"\w* \w es|strong="H1931"\w* Yahvé! \w Lo|strong="H1931"\w* hemos esperado; alegrémonos y regocijémonos en \w su|strong="H1931"\w* salvación”.  
\v 10 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w mano|strong="H3027"\w* \w de|strong="H3588"\w* Yahvé se posará \w en|strong="H3588"\w* \w este|strong="H2088"\w* \w monte|strong="H2022"\w*.  
\p \w Moab|strong="H4124"\w* será pisoteado \w en|strong="H3588"\w* \w su|strong="H3588"\w* propio \w lugar|strong="H8478"\w*, \w como|strong="H3588"\w* se pisotea \w la|strong="H3588"\w* paja \w en|strong="H3588"\w* un foso \w de|strong="H3588"\w* estiércol.  
\v 11 Yahvé extenderá sus \w manos|strong="H3027"\w* \w en|strong="H5973"\w* \w medio|strong="H3027"\w* \w de|strong="H5973"\w* \w él|strong="H5973"\w*, \w como|strong="H5973"\w* \w el|strong="H5973"\w* nadador \w que|strong="H3027"\w* \w extiende|strong="H6566"\w* las \w manos|strong="H3027"\w* \w para|strong="H5973"\w* nadar, y humillará su orgullo \w a|strong="H3068"\w* pesar \w de|strong="H5973"\w* todas sus mañas.  
\v 12 Él derribará las altas fortificaciones \w de|strong="H5704"\w* tus murallas; las rebajará \w hasta|strong="H5704"\w* el suelo, \w hasta|strong="H5704"\w* dejarlas \w en|strong="H5704"\w* el \w polvo|strong="H6083"\w*.   
\c 26  
\p
\v 1 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w* \w se|strong="H1931"\w* \w cantará|strong="H7891"\w* \w este|strong="H2088"\w* \w canto|strong="H7891"\w* en \w la|strong="H1931"\w* tierra de \w Judá|strong="H3063"\w*:  
\q1 “Tenemos una \w ciudad|strong="H5892"\w* \w fuerte|strong="H5794"\w*;  
\q2 Dios ha puesto \w la|strong="H1931"\w* salvación \w por|strong="H2088"\w* \w muros|strong="H2346"\w* y baluartes.   
\q1
\v 2 Abran las \w puertas|strong="H8179"\w* para que entre \w la|strong="H8104"\w* \w nación|strong="H1471"\w* \w justa|strong="H6662"\w*,  
\q2 \w la|strong="H8104"\w* que se mantiene fiel.   
\q1
\v 3 Al \w de|strong="H3588"\w* carácter firme lo \w guardarás|strong="H5341"\w* \w en|strong="H3588"\w* perfecta \w paz|strong="H7965"\w*,  
\q2 \w porque|strong="H3588"\w* \w en|strong="H3588"\w* ti confía.   
\q1
\v 4 Confíen \w en|strong="H5704"\w* Yahvé \w para|strong="H5704"\w* \w siempre|strong="H5769"\w*,  
\q2 \w porque|strong="H3588"\w* \w en|strong="H5704"\w* \w Yah|strong="H3068"\w*, Yahvé, tenemos una \w Roca|strong="H6697"\w* \w eterna|strong="H5769"\w*.   
\q1
\v 5 \w Porque|strong="H3588"\w* \w él|strong="H3588"\w* humilló \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H3588"\w* \w vivían|strong="H3427"\w* \w en|strong="H5704"\w* las \w alturas|strong="H4791"\w*, \w a|strong="H3068"\w* \w la|strong="H3588"\w* \w ciudad|strong="H7151"\w* orgullosa;  
\q2 \w la|strong="H3588"\w* abatió \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* suelo,  
\q2 \w la|strong="H3588"\w* \w derribó|strong="H7817"\w* \w hasta|strong="H5704"\w* \w el|strong="H3588"\w* \w polvo|strong="H6083"\w*.   
\q1
\v 6 La pisotearán los \w pies|strong="H7272"\w*,  
\q2 los \w pies|strong="H7272"\w* de los afligidos,  
\q2 los pasos de los necesitados”.   
\q1
\v 7 El \w camino|strong="H4570"\w* del \w justo|strong="H6662"\w* es la rectitud;  
\q2 tú, que eres \w recto|strong="H3477"\w*, haces llana la senda del \w justo|strong="H6662"\w*.   
\b  
\q1
\v 8 \w Sí|strong="H5315"\w*, Yahvé, en el camino de tus \w juicios|strong="H4941"\w* \w te|strong="H5315"\w* hemos esperado;  
\q2 tu \w nombre|strong="H8034"\w* y tu \w fama|strong="H8034"\w* son el \w deseo|strong="H8378"\w* de nuestra \w alma|strong="H5315"\w*.   
\q1
\v 9 \w Con|strong="H3588"\w* toda \w mi|strong="H5315"\w* \w alma|strong="H5315"\w* \w te|strong="H3588"\w* deseo \w en|strong="H3588"\w* las \w noches|strong="H3915"\w*;  
\q2 \w mientras|strong="H3588"\w* haya \w espíritu|strong="H7307"\w* \w en|strong="H3588"\w* \w mí|strong="H5315"\w*, \w te|strong="H3588"\w* buscaré \w con|strong="H3588"\w* ansia.  
\q2 \w Porque|strong="H3588"\w* \w cuando|strong="H3588"\w* tus \w juicios|strong="H4941"\w* llegan \w a|strong="H3068"\w* \w la|strong="H3588"\w* tierra, \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* del \w mundo|strong="H8398"\w* \w aprenden|strong="H3925"\w* lo \w que|strong="H3588"\w* \w es|strong="H3588"\w* \w justicia|strong="H6664"\w*.   
\q1
\v 10 Aunque se le tenga \w compasión|strong="H2603"\w* al malvado,  
\q2 \w no|strong="H1077"\w* \w aprenderá|strong="H3925"\w* \w justicia|strong="H6664"\w*;  
\q1 en tierra de rectitud actuará con perversidad  
\q2 y \w no|strong="H1077"\w* \w verá|strong="H7200"\w* la majestad de Yahvé.   
\b  
\q1
\v 11 Yahvé, tu \w mano|strong="H3027"\w* está levantada, pero \w ellos|strong="H3027"\w* \w no|strong="H1077"\w* la \w ven|strong="H2372"\w*.  
\q2 ¡\w Que|strong="H5971"\w* \w vean|strong="H2372"\w* tu \w celo|strong="H7068"\w* \w por|strong="H3027"\w* el \w pueblo|strong="H5971"\w* y \w se|strong="H5971"\w* avergüencen!  
\q2 ¡\w Que|strong="H5971"\w* el fuego consuma \w a|strong="H3068"\w* tus \w enemigos|strong="H6862"\w*!   
\q1
\v 12 Yahvé, tú establecerás \w la|strong="H1571"\w* \w paz|strong="H7965"\w* \w para|strong="H3588"\w* \w nosotros|strong="H3605"\w*,  
\q2 \w pues|strong="H3588"\w* tú has realizado \w todo|strong="H3605"\w* \w lo|strong="H3605"\w* \w que|strong="H3588"\w* hemos logrado.   
\q1
\v 13 Yahvé, \w Dios|strong="H3068"\w* nuestro, otros señores han querido dominarnos,  
\q2 pero solo invocaremos tu \w nombre|strong="H8034"\w*.   
\q1
\v 14 \w Ellos|strong="H3605"\w* ya \w han|strong="H4191"\w* \w muerto|strong="H4191"\w*, \w no|strong="H1077"\w* \w vivirán|strong="H2421"\w*;  
\q2 son sombras \w que|strong="H3605"\w* \w no|strong="H1077"\w* \w se|strong="H3651"\w* levantarán.  
\q1 Porque tú \w los|strong="H3605"\w* castigaste y \w los|strong="H3605"\w* destruiste,  
\q2 y borraste \w todo|strong="H3605"\w* recuerdo de \w ellos|strong="H3605"\w*.   
\q1
\v 15 Tú has engrandecido \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w nación|strong="H1471"\w*, oh Yahvé;  
\q2 ¡has engrandecido \w a|strong="H3068"\w* \w la|strong="H3605"\w* \w nación|strong="H1471"\w*!  
\q1 ¡Te has glorificado!  
\q2 Has ensanchado \w todas|strong="H3605"\w* las fronteras del país.   
\b  
\q1
\v 16 Yahvé, en la \w angustia|strong="H6862"\w* te buscaron;  
\q2 susurraron una oración cuando tu castigo cayó sobre ellos.   
\q1
\v 17 \w Como|strong="H3644"\w* una mujer embarazada \w que|strong="H1961"\w*, al acercarse el parto,  
\q2 \w se|strong="H1961"\w* retuerce y grita \w por|strong="H6440"\w* sus \w dolores|strong="H2256"\w*,  
\q2 \w así|strong="H3651"\w* hemos \w estado|strong="H1961"\w* \w ante|strong="H6440"\w* ti, Yahvé.   
\q1
\v 18 Estuvimos de parto y sufrimos,  
\q2 pero solo dimos \w a|strong="H3068"\w* luz \w viento|strong="H7307"\w*.  
\q1 \w No|strong="H1077"\w* trajimos salvación \w a|strong="H3068"\w* la tierra,  
\q2 \w ni|strong="H1077"\w* \w nacieron|strong="H3205"\w* nuevos \w habitantes|strong="H3427"\w* para \w el|strong="H5307"\w* \w mundo|strong="H8398"\w*.   
\q1
\v 19 \w Pero|strong="H3588"\w* tus \w muertos|strong="H4191"\w* \w vivirán|strong="H2421"\w*;  
\q2 sus cadáveres \w resucitarán|strong="H6965"\w*.  
\q1 ¡Despierten \w y|strong="H3588"\w* \w canten|strong="H7442"\w*, ustedes \w que|strong="H3588"\w* viven \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w polvo|strong="H6083"\w*!  
\q2 \w Porque|strong="H3588"\w* tu \w rocío|strong="H2919"\w* \w es|strong="H3588"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w rocío|strong="H2919"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* mañana,  
\q2 \w y|strong="H3588"\w* \w la|strong="H3588"\w* \w tierra|strong="H6083"\w* dará \w a|strong="H3068"\w* luz \w a|strong="H3068"\w* sus \w muertos|strong="H4191"\w*.   
\b  
\q1
\v 20 Vengan, \w pueblo|strong="H5971"\w* \w mío|strong="H5971"\w*, entren \w en|strong="H5704"\w* sus habitaciones  
\q2 \w y|strong="H5704"\w* cierren las \w puertas|strong="H1817"\w* \w tras|strong="H1157"\w* \w de|strong="H5704"\w* ustedes.  
\q1 Escóndanse \w por|strong="H1157"\w* un \w momento|strong="H7281"\w*,  
\q2 \w hasta|strong="H5704"\w* \w que|strong="H5704"\w* \w pase|strong="H5674"\w* la \w ira|strong="H3212"\w* \w de|strong="H5704"\w* Dios.   
\q1
\v 21 \w Porque|strong="H3588"\w* miren, Yahvé \w sale|strong="H3318"\w* \w de|strong="H5921"\w* \w su|strong="H3588"\w* \w morada|strong="H3427"\w* \w para|strong="H5921"\w* castigar \w la|strong="H5921"\w* \w maldad|strong="H5771"\w* \w de|strong="H5921"\w* \w los|strong="H3427"\w* \w habitantes|strong="H3427"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra.  
\q2 \w La|strong="H5921"\w* tierra dejará ver \w la|strong="H5921"\w* \w sangre|strong="H1818"\w* derramada \w en|strong="H5921"\w* \w ella|strong="H5921"\w* \w y|strong="H3588"\w* ya \w no|strong="H3808"\w* ocultará \w a|strong="H3068"\w* sus muertos.   
\c 27  
\p
\v 1 \w En|strong="H5921"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, Yahvé castigará \w con|strong="H5921"\w* \w su|strong="H1931"\w* \w espada|strong="H2719"\w* \w dura|strong="H7186"\w*, \w grande|strong="H1419"\w* \w y|strong="H5921"\w* \w poderosa|strong="H2389"\w* \w al|strong="H5921"\w* leviatán, \w la|strong="H1931"\w* \w serpiente|strong="H5175"\w* veloz, \w al|strong="H5921"\w* leviatán, \w la|strong="H1931"\w* \w serpiente|strong="H5175"\w* serpenteante; \w y|strong="H5921"\w* \w matará|strong="H2026"\w* \w al|strong="H5921"\w* \w dragón|strong="H8577"\w* \w que|strong="H1931"\w* vive \w en|strong="H5921"\w* \w el|strong="H1931"\w* \w mar|strong="H3220"\w*.   
\p
\v 2 En \w ese|strong="H1931"\w* \w día|strong="H3117"\w*, cántenle: “¡Un viñedo hermoso!  
\v 3 Yo, Yahvé, soy su guardián \w y|strong="H5921"\w* \w lo|strong="H5921"\w* riego \w a|strong="H3068"\w* \w cada|strong="H3117"\w* \w momento|strong="H7281"\w*. \w Para|strong="H5921"\w* \w que|strong="H5921"\w* nadie \w lo|strong="H5921"\w* dañe, \w lo|strong="H5921"\w* cuido \w de|strong="H5921"\w* \w día|strong="H3117"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* \w noche|strong="H3915"\w*.  
\v 4 No estoy \w enojado|strong="H2534"\w*, pero si alguien \w me|strong="H4310"\w* \w pusiera|strong="H5414"\w* \w espinas|strong="H8068"\w* y matorrales, yo les haría la \w guerra|strong="H4421"\w*; ¡marcharía sobre ellos y los quemaría \w a|strong="H3068"\w* \w todos|strong="H3162"\w*!  
\v 5 \w A|strong="H3068"\w* menos que busquen refugio en mí y \w hagan|strong="H6213"\w* las paces \w conmigo|strong="H6213"\w*. ¡Sí, que \w hagan|strong="H6213"\w* las paces \w conmigo|strong="H6213"\w*!”.   
\p
\v 6 En los días \w por|strong="H6440"\w* venir, \w Jacob|strong="H3290"\w* echará raíces; \w Israel|strong="H3478"\w* \w florecerá|strong="H6524"\w* y dará renuevos, y llenarán \w de|strong="H6440"\w* frutos la \w faz|strong="H6440"\w* del \w mundo|strong="H8398"\w*.  
\v 7 ¿Acaso Yahvé los ha golpeado como golpeó \w a|strong="H3068"\w* los que los atacaban \w a|strong="H3068"\w* ellos? ¿\w O|strong="H3068"\w* los ha matado como \w mató|strong="H2026"\w* \w a|strong="H3068"\w* los que los asesinaban?  
\v 8 Al expulsarlos, tú los castigaste con medida; los eliminaste con tu \w viento|strong="H7307"\w* fuerte en el \w día|strong="H3117"\w* del \w viento|strong="H7307"\w* del este.  
\v 9 \w Por|strong="H2088"\w* \w eso|strong="H3651"\w*, con \w esto|strong="H2063"\w* \w se|strong="H3808"\w* perdonará \w la|strong="H2063"\w* \w maldad|strong="H5771"\w* de \w Jacob|strong="H3290"\w*, y \w este|strong="H2088"\w* \w será|strong="H3808"\w* \w el|strong="H3605"\w* resultado de \w quitar|strong="H5493"\w* su \w pecado|strong="H2403"\w*: \w que|strong="H3808"\w* \w él|strong="H3605"\w* convierta \w todas|strong="H3605"\w* las piedras \w del|strong="H4196"\w* \w altar|strong="H4196"\w* \w en|strong="H5493"\w* trozos de tiza pulverizada, de modo \w que|strong="H3808"\w* \w los|strong="H3605"\w* postes de Asera y \w los|strong="H3605"\w* \w altares|strong="H4196"\w* de incienso \w no|strong="H3808"\w* vuelvan \w a|strong="H3068"\w* \w levantarse|strong="H6965"\w*.  
\v 10 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* \w ciudad|strong="H5892"\w* fortificada ha quedado sola, \w es|strong="H3588"\w* una \w morada|strong="H5116"\w* desierta \w y|strong="H3588"\w* \w abandonada|strong="H5800"\w* \w como|strong="H3588"\w* \w el|strong="H3588"\w* \w desierto|strong="H4057"\w*; \w allí|strong="H8033"\w* pastará \w el|strong="H3588"\w* \w becerro|strong="H5695"\w*, \w allí|strong="H8033"\w* se \w echará|strong="H7971"\w* \w y|strong="H3588"\w* se comerá las ramas.  
\v 11 \w Cuando|strong="H3588"\w* \w las|strong="H5921"\w* \w ramas|strong="H7105"\w* \w se|strong="H1931"\w* marchiten, \w se|strong="H1931"\w* \w quebrarán|strong="H7665"\w*; vendrán mujeres \w y|strong="H3588"\w* \w las|strong="H5921"\w* usarán \w para|strong="H5921"\w* \w el|strong="H1931"\w* fuego, \w porque|strong="H3588"\w* \w este|strong="H1931"\w* \w es|strong="H1931"\w* un \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* entiende. \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w su|strong="H1931"\w* Creador \w no|strong="H3808"\w* \w les|strong="H5921"\w* tendrá \w compasión|strong="H2603"\w*, \w y|strong="H3588"\w* \w el|strong="H1931"\w* \w que|strong="H3588"\w* \w los|strong="H5921"\w* \w formó|strong="H3335"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* mostrará \w ningún|strong="H3808"\w* favor.   
\p
\v 12 \w En|strong="H5704"\w* \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, Yahvé trillará \w el|strong="H1931"\w* grano \w desde|strong="H5704"\w* \w la|strong="H1931"\w* corriente del Éufrates \w hasta|strong="H5704"\w* \w el|strong="H1931"\w* \w arroyo|strong="H5158"\w* \w de|strong="H5704"\w* \w Egipto|strong="H4714"\w*; \w y|strong="H5704"\w* ustedes, \w hijos|strong="H1121"\w* \w de|strong="H5704"\w* \w Israel|strong="H3478"\w*, \w serán|strong="H1961"\w* reunidos uno \w por|strong="H5704"\w* uno.   
\p
\v 13 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w se|strong="H1961"\w* \w tocará|strong="H8628"\w* una \w gran|strong="H1419"\w* \w trompeta|strong="H7782"\w*; y vendrán \w los|strong="H1931"\w* \w que|strong="H1931"\w* \w estaban|strong="H1961"\w* \w a|strong="H3068"\w* punto de morir en \w la|strong="H1931"\w* tierra de Asiria y \w los|strong="H1931"\w* \w que|strong="H1931"\w* \w estaban|strong="H1961"\w* desterrados en \w Egipto|strong="H4714"\w*, y adorarán \w a|strong="H3068"\w* Yahvé en \w el|strong="H1931"\w* \w monte|strong="H2022"\w* \w santo|strong="H6944"\w*, en Jerusalén.   
\c 28  
\p
\v 1 ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w corona|strong="H5850"\w* \w de|strong="H5921"\w* orgullo \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w borrachos|strong="H7910"\w* \w de|strong="H5921"\w* Efraín! ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* flor marchita \w de|strong="H5921"\w* su gloriosa belleza, \w que|strong="H5921"\w* \w está|strong="H5921"\w* \w sobre|strong="H5921"\w* \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w del|strong="H5921"\w* \w fértil|strong="H8081"\w* \w valle|strong="H1516"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* dejan vencer \w por|strong="H5921"\w* \w el|strong="H5921"\w* \w vino|strong="H3196"\w*!  
\v 2 Miren, el Señor tiene \w a|strong="H3068"\w* uno \w que|strong="H4325"\w* \w es|strong="H3027"\w* poderoso y \w fuerte|strong="H2389"\w*. Como una tormenta \w de|strong="H4325"\w* \w granizo|strong="H1259"\w*, como una tempestad destructora y como una inundación \w de|strong="H4325"\w* \w aguas|strong="H4325"\w* caudalosas, los arrojará \w a|strong="H3068"\w* tierra con el \w poder|strong="H3027"\w* \w de|strong="H4325"\w* su \w mano|strong="H3027"\w*.  
\v 3 La \w corona|strong="H5850"\w* de orgullo de los \w borrachos|strong="H7910"\w* de Efraín será pisoteada.  
\v 4 \w La|strong="H5921"\w* flor marchita \w de|strong="H5921"\w* su gloriosa belleza, situada \w en|strong="H5921"\w* \w la|strong="H5921"\w* cabecera \w del|strong="H5921"\w* \w valle|strong="H1516"\w* \w fértil|strong="H8081"\w*, \w será|strong="H1961"\w* \w como|strong="H1961"\w* un higo maduro \w antes|strong="H2962"\w* \w del|strong="H5921"\w* \w verano|strong="H7019"\w*: \w en|strong="H5921"\w* \w cuanto|strong="H5921"\w* alguien \w lo|strong="H5921"\w* \w ve|strong="H7200"\w*, \w lo|strong="H5921"\w* arranca \w y|strong="H5921"\w* \w se|strong="H1961"\w* \w lo|strong="H5921"\w* come.  
\v 5 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, Yahvé \w de|strong="H5971"\w* \w los|strong="H1931"\w* \w Ejércitos|strong="H6635"\w* \w se|strong="H1961"\w* convertirá en una \w corona|strong="H5850"\w* \w de|strong="H5971"\w* \w gloria|strong="H6643"\w* y en una diadema \w de|strong="H5971"\w* \w hermosura|strong="H6643"\w* \w para|strong="H1961"\w* \w el|strong="H1931"\w* resto \w de|strong="H5971"\w* \w su|strong="H1931"\w* \w pueblo|strong="H5971"\w*.  
\v 6 \w Él|strong="H5921"\w* será un \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* \w justicia|strong="H4941"\w* \w para|strong="H5921"\w* \w el|strong="H5921"\w* \w que|strong="H5921"\w* \w se|strong="H5921"\w* sienta \w a|strong="H3068"\w* juzgar, \w y|strong="H5921"\w* \w dará|strong="H7725"\w* fuerzas \w a|strong="H3068"\w* \w los|strong="H3427"\w* \w que|strong="H5921"\w* rechazan \w el|strong="H5921"\w* ataque enemigo \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w puertas|strong="H8179"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* ciudad.   
\p
\v 7 Pero \w también|strong="H1571"\w* \w estos|strong="H1571"\w* \w se|strong="H4480"\w* tambalean \w por|strong="H4480"\w* \w el|strong="H5030"\w* \w vino|strong="H3196"\w* \w y|strong="H1571"\w* pierden \w el|strong="H5030"\w* equilibrio \w por|strong="H4480"\w* las bebidas fuertes. \w El|strong="H5030"\w* \w sacerdote|strong="H3548"\w* \w y|strong="H1571"\w* \w el|strong="H5030"\w* \w profeta|strong="H5030"\w* \w se|strong="H4480"\w* tambalean \w por|strong="H4480"\w* \w el|strong="H5030"\w* alcohol; \w el|strong="H5030"\w* \w vino|strong="H3196"\w* \w se|strong="H4480"\w* los tragó. Están aturdidos \w por|strong="H4480"\w* \w la|strong="H1571"\w* \w bebida|strong="H7941"\w*, \w se|strong="H4480"\w* equivocan \w en|strong="H4480"\w* sus visiones \w y|strong="H1571"\w* tropiezan \w al|strong="H4480"\w* dictar sentencia.  
\v 8 \w Todas|strong="H3605"\w* las \w mesas|strong="H7979"\w* están cubiertas \w de|strong="H3588"\w* \w vómito|strong="H6892"\w* \w y|strong="H3588"\w* suciedad; \w no|strong="H1097"\w* queda \w ni|strong="H1097"\w* un solo \w lugar|strong="H4725"\w* limpio.   
\p
\v 9 ¿\w A|strong="H3068"\w* \w quién|strong="H4310"\w* quiere \w enseñar|strong="H3384"\w* Dios? ¿\w A|strong="H3068"\w* \w quiénes|strong="H4310"\w* les explicará su mensaje? ¿\w A|strong="H3068"\w* niños recién destetados \w que|strong="H4310"\w* acaban de dejar \w el|strong="H4310"\w* pecho?  
\v 10 \w Porque|strong="H3588"\w* ellos dicen: “Regla tras regla, regla sobre regla; \w línea|strong="H6957"\w* tras \w línea|strong="H6957"\w*, \w línea|strong="H6957"\w* sobre \w línea|strong="H6957"\w*; un \w poquito|strong="H2191"\w* \w aquí|strong="H8033"\w*, otro \w poquito|strong="H2191"\w* \w allá|strong="H8033"\w*”.   
\p
\v 11 \w Por|strong="H3588"\w* eso, Dios \w hablará|strong="H1696"\w* \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w con|strong="H3588"\w* \w labios|strong="H8193"\w* tartamudos \w y|strong="H3588"\w* \w en|strong="H3588"\w* una \w lengua|strong="H3956"\w* extraña.  
\v 12 \w A|strong="H3068"\w* ellos les dijo: “\w Este|strong="H2063"\w* \w es|strong="H2063"\w* el lugar de \w descanso|strong="H4496"\w*, den \w descanso|strong="H4496"\w* al \w cansado|strong="H5889"\w*; \w este|strong="H2063"\w* \w es|strong="H2063"\w* el lugar de alivio”; pero ustedes \w no|strong="H3808"\w* quisieron \w escuchar|strong="H8085"\w*.  
\v 13 \w Por|strong="H4616"\w* \w lo|strong="H1697"\w* tanto, la \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w para|strong="H4616"\w* \w ellos|strong="H1992"\w* \w será|strong="H1961"\w*: “Regla tras regla, regla \w sobre|strong="H1961"\w* regla; \w línea|strong="H6957"\w* tras \w línea|strong="H6957"\w*, \w línea|strong="H6957"\w* \w sobre|strong="H1961"\w* \w línea|strong="H6957"\w*; un \w poquito|strong="H2191"\w* \w aquí|strong="H8033"\w*, \w otro|strong="H4616"\w* \w poquito|strong="H2191"\w* \w allá|strong="H8033"\w*”; \w para|strong="H4616"\w* \w que|strong="H1697"\w* \w cuando|strong="H1961"\w* caminen, caigan \w de|strong="H1697"\w* espaldas y acaben heridos, atrapados y prisioneros.   
\p
\v 14 \w Por|strong="H1697"\w* \w eso|strong="H3651"\w*, \w escuchen|strong="H8085"\w* la \w palabra|strong="H1697"\w* \w de|strong="H5971"\w* Yahvé, ustedes burlones \w que|strong="H5971"\w* gobiernan \w a|strong="H3068"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* en Jerusalén.  
\v 15 Ustedes dicen: “Hemos \w hecho|strong="H6213"\w* un \w pacto|strong="H1285"\w* \w con|strong="H5973"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w*, hemos llegado \w a|strong="H3068"\w* un \w acuerdo|strong="H2374"\w* \w con|strong="H5973"\w* \w el|strong="H5973"\w* Seol.\f + \fr 28:15 \ft El Seol es el lugar de los muertos.\f* \w Cuando|strong="H3588"\w* \w pase|strong="H5674"\w* \w la|strong="H3588"\w* inundación \w del|strong="H5973"\w* castigo, \w no|strong="H3808"\w* nos alcanzará, \w porque|strong="H3588"\w* hemos \w hecho|strong="H6213"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w mentira|strong="H8267"\w* nuestro refugio \w y|strong="H3588"\w* nos hemos \w escondido|strong="H5641"\w* \w en|strong="H5973"\w* \w la|strong="H3588"\w* falsedad”.  
\v 16 \w Por|strong="H3651"\w* \w eso|strong="H3651"\w*, \w así|strong="H3541"\w* dice el Señor Yahvé: “Miren, yo pongo en \w Sión|strong="H6726"\w* una piedra fundamental, una piedra probada, una piedra \w angular|strong="H6438"\w* \w preciosa|strong="H3368"\w* para un \w cimiento|strong="H3245"\w* firme; el \w que|strong="H3808"\w* confíe en ella \w no|strong="H3808"\w* tendrá \w que|strong="H3808"\w* salir huyendo.  
\v 17 Usaré la \w justicia|strong="H6666"\w* como cordel \w de|strong="H4325"\w* medida y la rectitud como plomada. El \w granizo|strong="H1259"\w* destruirá su refugio \w de|strong="H4325"\w* \w mentiras|strong="H3577"\w* y el \w agua|strong="H4325"\w* \w inundará|strong="H7857"\w* su escondite.  
\v 18 \w El|strong="H3588"\w* \w pacto|strong="H1285"\w* \w que|strong="H3588"\w* hicieron \w con|strong="H3588"\w* \w la|strong="H3588"\w* \w muerte|strong="H4194"\w* \w será|strong="H1961"\w* anulado, \w y|strong="H3588"\w* \w su|strong="H3588"\w* acuerdo \w con|strong="H3588"\w* \w el|strong="H3588"\w* Seol \w no|strong="H3808"\w* \w se|strong="H1961"\w* mantendrá. \w Cuando|strong="H3588"\w* \w pase|strong="H5674"\w* \w la|strong="H3588"\w* inundación del castigo, ustedes \w serán|strong="H1961"\w* pisoteados \w por|strong="H3588"\w* ella.  
\v 19 \w Cada|strong="H3117"\w* vez \w que|strong="H3588"\w* \w pase|strong="H5674"\w*, \w los|strong="H1961"\w* atrapará; \w pasará|strong="H5674"\w* \w mañana|strong="H1242"\w* tras \w mañana|strong="H1242"\w*, \w de|strong="H3588"\w* \w día|strong="H3117"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w noche|strong="H3915"\w*. Entender \w este|strong="H1961"\w* mensaje les provocará puro terror”.  
\v 20 \w Porque|strong="H3588"\w* \w la|strong="H3588"\w* cama \w es|strong="H3588"\w* demasiado corta \w para|strong="H3588"\w* estirarse, \w y|strong="H3588"\w* \w la|strong="H3588"\w* cobija \w es|strong="H3588"\w* muy estrecha \w para|strong="H3588"\w* envolverse \w en|strong="H3588"\w* ella.  
\v 21 \w Porque|strong="H3588"\w* Yahvé se \w levantará|strong="H6965"\w* \w como|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w monte|strong="H2022"\w* Perazim \w y|strong="H3588"\w* se enfurecerá \w como|strong="H3588"\w* \w en|strong="H3588"\w* \w el|strong="H3588"\w* \w valle|strong="H6010"\w* \w de|strong="H3588"\w* \w Gabaón|strong="H1391"\w*, \w para|strong="H3588"\w* realizar \w su|strong="H3588"\w* \w obra|strong="H4639"\w*, \w su|strong="H3588"\w* \w extraña|strong="H5237"\w* \w obra|strong="H4639"\w*, \w y|strong="H3588"\w* llevar \w a|strong="H3068"\w* cabo \w su|strong="H3588"\w* \w tarea|strong="H5656"\w*, \w su|strong="H3588"\w* asombrosa \w tarea|strong="H5656"\w*.  
\v 22 \w Así|strong="H3588"\w* \w que|strong="H3588"\w*, dejen \w de|strong="H5921"\w* burlarse, \w no|strong="H6435"\w* \w sea|strong="H6435"\w* \w que|strong="H3588"\w* sus cadenas \w se|strong="H5921"\w* aprieten \w más|strong="H3588"\w*; \w porque|strong="H3588"\w* he \w oído|strong="H8085"\w* un decreto \w de|strong="H5921"\w* destrucción \w de|strong="H5921"\w* parte \w del|strong="H5921"\w* Señor, Yahvé \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w Ejércitos|strong="H6635"\w*, \w contra|strong="H5921"\w* \w todo|strong="H3605"\w* \w el|strong="H5921"\w* país.   
\p
\v 23 ¡Presten atención y \w oigan|strong="H8085"\w* mi \w voz|strong="H6963"\w*! ¡\w Escuchen|strong="H8085"\w* bien lo que voy \w a|strong="H3068"\w* \w decir|strong="H8085"\w*!  
\v 24 \w El|strong="H3605"\w* \w que|strong="H3117"\w* \w ara|strong="H2790"\w* para sembrar, ¿se pasa \w todo|strong="H3605"\w* \w el|strong="H3605"\w* \w día|strong="H3117"\w* arando? ¿Se \w la|strong="H3605"\w* pasa \w siempre|strong="H3605"\w* abriendo surcos y rompiendo \w los|strong="H3605"\w* terrones?  
\v 25 Cuando ya \w ha|strong="H3808"\w* nivelado el suelo, ¿\w no|strong="H3808"\w* siembra el eneldo y \w esparce|strong="H6327"\w* el comino? ¿\w No|strong="H3808"\w* planta el \w trigo|strong="H2406"\w* en hileras, la \w cebada|strong="H8184"\w* en su lugar y la espelta en los bordes?  
\v 26 Su Dios lo instruye y le \w enseña|strong="H3384"\w* cómo hacerlo correctamente.  
\v 27 \w Porque|strong="H3588"\w* \w el|strong="H5921"\w* eneldo \w no|strong="H3808"\w* \w se|strong="H5921"\w* trilla \w con|strong="H5921"\w* una pesada máquina, \w ni|strong="H3808"\w* \w se|strong="H5921"\w* \w pasa|strong="H5437"\w* una rueda \w de|strong="H5921"\w* \w carro|strong="H5699"\w* \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* comino; \w sino|strong="H3588"\w* \w que|strong="H3588"\w* \w el|strong="H5921"\w* eneldo \w se|strong="H5921"\w* golpea \w con|strong="H5921"\w* un palo \w y|strong="H3588"\w* \w el|strong="H5921"\w* comino \w con|strong="H5921"\w* una \w vara|strong="H4294"\w*.  
\v 28 \w El|strong="H3588"\w* grano \w para|strong="H3588"\w* \w el|strong="H3588"\w* \w pan|strong="H3899"\w* tiene \w que|strong="H3588"\w* ser molido, \w pero|strong="H3588"\w* \w no|strong="H3808"\w* \w se|strong="H3808"\w* trilla \w para|strong="H3588"\w* \w siempre|strong="H3899"\w*. \w Aunque|strong="H3588"\w* \w el|strong="H3588"\w* agricultor pase las ruedas \w de|strong="H3588"\w* \w su|strong="H3588"\w* \w carro|strong="H5699"\w* sobre \w el|strong="H3588"\w* grano, sus caballos \w no|strong="H3808"\w* \w lo|strong="H3808"\w* trituran.  
\v 29 \w Esto|strong="H2063"\w* \w también|strong="H1571"\w* viene \w de|strong="H5973"\w* Yahvé \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w Ejércitos|strong="H6635"\w*, \w que|strong="H1571"\w* \w es|strong="H2063"\w* maravilloso \w en|strong="H5973"\w* sus \w consejos|strong="H6098"\w* \w y|strong="H1571"\w* \w grande|strong="H1431"\w* \w en|strong="H5973"\w* su \w sabiduría|strong="H8454"\w*.   
\c 29  
\p
\v 1 ¡\w Ay|strong="H1945"\w* \w de|strong="H5921"\w* Ariel! Ariel, \w la|strong="H5921"\w* \w ciudad|strong="H7151"\w* \w donde|strong="H5921"\w* acampó \w David|strong="H1732"\w*. Dejen \w que|strong="H5921"\w* pasen \w los|strong="H5921"\w* \w años|strong="H8141"\w* \w y|strong="H5921"\w* \w que|strong="H5921"\w* sigan \w las|strong="H5921"\w* fiestas \w en|strong="H5921"\w* su ciclo;  
\v 2 entonces yo angustiaré \w a|strong="H3068"\w* Ariel, y \w habrá|strong="H1961"\w* luto y tristeza. Ella \w será|strong="H1961"\w* \w para|strong="H1961"\w* \w mí|strong="H1961"\w* \w como|strong="H1961"\w* el fogón del altar.  
\v 3 Acamparé \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* \w a|strong="H3068"\w* tu \w alrededor|strong="H5921"\w*, \w te|strong="H5921"\w* sitiaré \w con|strong="H5921"\w* torres \w de|strong="H5921"\w* asalto \w y|strong="H5921"\w* \w levantaré|strong="H6965"\w* \w contra|strong="H5921"\w* \w ti|strong="H5921"\w* muros \w de|strong="H5921"\w* asedio.  
\v 4 \w Serás|strong="H1961"\w* humillada y \w hablarás|strong="H1696"\w* desde el suelo; tus \w palabras|strong="H1696"\w* \w serán|strong="H1961"\w* \w como|strong="H1961"\w* un susurro \w que|strong="H1961"\w* sale del \w polvo|strong="H6083"\w*. Tu \w voz|strong="H6963"\w* \w vendrá|strong="H1961"\w* de la \w tierra|strong="H6083"\w* \w como|strong="H1961"\w* la de un fantasma, y tus \w palabras|strong="H1696"\w* saldrán del \w polvo|strong="H6083"\w* \w como|strong="H1961"\w* un \w murmullo|strong="H6963"\w*.   
\p
\v 5 Pero la \w multitud|strong="H1995"\w* de tus enemigos \w será|strong="H1961"\w* \w como|strong="H1961"\w* polvo fino, y la \w multitud|strong="H1995"\w* de \w los|strong="H1961"\w* crueles \w como|strong="H1961"\w* paja \w que|strong="H1961"\w* \w se|strong="H1961"\w* lleva \w el|strong="H5674"\w* viento. \w Sucederá|strong="H1961"\w* de repente, en un instante.  
\v 6 Yahvé \w de|strong="H5973"\w* \w los|strong="H5973"\w* \w Ejércitos|strong="H6635"\w* \w te|strong="H5973"\w* \w visitará|strong="H6485"\w* \w con|strong="H5973"\w* \w truenos|strong="H6963"\w*, terremotos y un \w gran|strong="H1419"\w* \w estruendo|strong="H6963"\w*, \w con|strong="H5973"\w* torbellinos, tempestades y llamas \w de|strong="H5973"\w* fuego devorador.  
\v 7 \w Y|strong="H3068"\w* \w será|strong="H1961"\w* \w como|strong="H1961"\w* un \w sueño|strong="H2472"\w*, \w como|strong="H1961"\w* una \w visión|strong="H2377"\w* \w nocturna|strong="H3915"\w*, \w la|strong="H5921"\w* \w multitud|strong="H1995"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H5921"\w* pelean \w contra|strong="H5921"\w* Ariel, \w todos|strong="H3605"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* atacan \w a|strong="H3068"\w* \w ella|strong="H3605"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* su fortaleza, \w y|strong="H5921"\w* \w los|strong="H5921"\w* \w que|strong="H5921"\w* \w la|strong="H5921"\w* angustian.  
\v 8 \w Será|strong="H1961"\w* \w como|strong="H1961"\w* \w cuando|strong="H1961"\w* un \w hambriento|strong="H8264"\w* sueña \w que|strong="H5921"\w* \w está|strong="H1961"\w* comiendo, pero \w al|strong="H5921"\w* despertar su estómago sigue vacío; \w o|strong="H3068"\w* \w como|strong="H1961"\w* \w cuando|strong="H1961"\w* un sediento sueña \w que|strong="H5921"\w* \w está|strong="H1961"\w* \w bebiendo|strong="H8354"\w*, pero \w al|strong="H5921"\w* despertar \w se|strong="H1961"\w* siente agotado \w y|strong="H5921"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* garganta seca. \w Así|strong="H3651"\w* \w será|strong="H1961"\w* \w la|strong="H5921"\w* \w multitud|strong="H1995"\w* \w de|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* \w que|strong="H5921"\w* pelean \w contra|strong="H5921"\w* \w el|strong="H5921"\w* \w monte|strong="H2022"\w* \w Sión|strong="H6726"\w*.   
\p
\v 9 ¡Deténganse y asómbrense! ¡Ciéguense y queden ciegos! Están borrachos, pero \w no|strong="H3808"\w* de \w vino|strong="H3196"\w*; \w se|strong="H3808"\w* tambalean, pero \w no|strong="H3808"\w* por la \w bebida|strong="H7941"\w*.  
\v 10 \w Porque|strong="H3588"\w* Yahvé ha derramado \w sobre|strong="H5921"\w* ustedes un \w espíritu|strong="H7307"\w* \w de|strong="H5921"\w* sueño profundo; ha cerrado \w los|strong="H5921"\w* \w ojos|strong="H5869"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w profetas|strong="H5030"\w* \w y|strong="H3588"\w* ha cubierto \w la|strong="H5921"\w* \w cabeza|strong="H7218"\w* \w de|strong="H5921"\w* \w los|strong="H5921"\w* \w videntes|strong="H2374"\w*.  
\v 11 \w Para|strong="H3588"\w* ustedes, \w toda|strong="H3605"\w* \w visión|strong="H2380"\w* \w se|strong="H3045"\w* \w ha|strong="H3808"\w* vuelto \w como|strong="H3588"\w* las \w palabras|strong="H1697"\w* \w de|strong="H3588"\w* un \w libro|strong="H5612"\w* \w sellado|strong="H2856"\w*. \w Si|strong="H3588"\w* \w se|strong="H3045"\w* \w lo|strong="H1931"\w* \w dan|strong="H5414"\w* \w a|strong="H3068"\w* alguien \w que|strong="H3588"\w* \w sabe|strong="H3045"\w* \w leer|strong="H5612"\w* \w y|strong="H3588"\w* \w le|strong="H1931"\w* dicen: “\w Lee|strong="H7121"\w* \w esto|strong="H2088"\w*, \w por|strong="H3588"\w* favor”, \w él|strong="H1931"\w* responderá: “\w No|strong="H3808"\w* \w puedo|strong="H3201"\w*, \w porque|strong="H3588"\w* \w está|strong="H2088"\w* \w sellado|strong="H2856"\w*”.  
\v 12 \w Y|strong="H3068"\w* \w si|strong="H3808"\w* \w le|strong="H5921"\w* \w dan|strong="H5414"\w* \w el|strong="H5921"\w* \w libro|strong="H5612"\w* \w a|strong="H3068"\w* alguien \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w sabe|strong="H3045"\w* \w leer|strong="H5612"\w*, diciéndole: “\w Lee|strong="H7121"\w* \w esto|strong="H2088"\w*, \w por|strong="H5921"\w* favor”, \w él|strong="H5921"\w* dirá: “\w No|strong="H3808"\w* \w sé|strong="H3045"\w* \w leer|strong="H5612"\w*”.   
\p
\v 13 \w El|strong="H3588"\w* Señor dice: “\w Porque|strong="H3588"\w* \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w* \w se|strong="H1961"\w* \w acerca|strong="H5066"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* solo \w de|strong="H4480"\w* \w palabra|strong="H6310"\w* \w y|strong="H3588"\w* \w me|strong="H4480"\w* \w honra|strong="H3513"\w* \w con|strong="H4480"\w* \w los|strong="H1961"\w* \w labios|strong="H8193"\w*, \w pero|strong="H3588"\w* \w su|strong="H3588"\w* \w corazón|strong="H3820"\w* \w está|strong="H2088"\w* \w lejos|strong="H7368"\w* \w de|strong="H4480"\w* \w mí|strong="H1961"\w*, \w y|strong="H3588"\w* \w el|strong="H3588"\w* temor \w que|strong="H3588"\w* \w me|strong="H4480"\w* \w tienen|strong="H1961"\w* \w no|strong="H3588"\w* \w es|strong="H1961"\w* \w más|strong="H3588"\w* \w que|strong="H3588"\w* un \w mandamiento|strong="H6310"\w* humano \w que|strong="H3588"\w* les ha \w sido|strong="H1961"\w* enseñado;  
\v 14 \w por|strong="H2088"\w* \w eso|strong="H3651"\w*, miren, \w volveré|strong="H3254"\w* \w a|strong="H3068"\w* hacer \w maravillas|strong="H6381"\w* con \w este|strong="H2088"\w* \w pueblo|strong="H5971"\w*, una obra asombrosa y prodigiosa. \w La|strong="H2451"\w* \w sabiduría|strong="H2451"\w* \w de|strong="H5971"\w* sus \w sabios|strong="H2450"\w* fracasará y el entendimiento \w de|strong="H5971"\w* sus inteligentes \w se|strong="H3651"\w* nublará”.   
\p
\v 15 ¡\w Ay|strong="H1945"\w* de \w los|strong="H1961"\w* \w que|strong="H4310"\w* \w se|strong="H3045"\w* esconden de Yahvé \w para|strong="H1961"\w* \w ocultar|strong="H5641"\w* sus planes, \w que|strong="H4310"\w* hacen sus \w obras|strong="H4639"\w* en la oscuridad y dicen: “¿\w Quién|strong="H4310"\w* nos \w ve|strong="H7200"\w*?” y “¿\w Quién|strong="H4310"\w* nos \w conoce|strong="H3045"\w*?”.  
\v 16 ¡Ustedes \w lo|strong="H3808"\w* ponen todo al revés! ¿Acaso \w se|strong="H3808"\w* puede pensar \w que|strong="H3588"\w* \w el|strong="H3588"\w* alfarero \w es|strong="H3588"\w* igual al \w barro|strong="H2563"\w*? ¿Puede \w la|strong="H3588"\w* \w obra|strong="H4639"\w* decirle \w a|strong="H3068"\w* \w su|strong="H3588"\w* \w hacedor|strong="H6213"\w*: “\w Él|strong="H3588"\w* \w no|strong="H3808"\w* \w me|strong="H3588"\w* \w hizo|strong="H6213"\w*”? ¿\w O|strong="H3068"\w* puede \w el|strong="H3588"\w* objeto decir del \w que|strong="H3588"\w* \w lo|strong="H3808"\w* modeló: “\w Él|strong="H3588"\w* \w no|strong="H3808"\w* entiende \w nada|strong="H3808"\w*”?   
\p
\v 17 ¿\w No|strong="H3808"\w* falta ya muy \w poco|strong="H4592"\w* para \w que|strong="H3808"\w* el \w Líbano|strong="H3844"\w* \w se|strong="H3808"\w* convierta \w en|strong="H5750"\w* un campo fértil, y el campo fértil sea considerado un \w bosque|strong="H3293"\w*?  
\v 18 En \w aquel|strong="H1931"\w* \w día|strong="H3117"\w*, \w los|strong="H1931"\w* \w sordos|strong="H2795"\w* \w oirán|strong="H8085"\w* las \w palabras|strong="H1697"\w* del \w libro|strong="H5612"\w*, y \w los|strong="H1931"\w* \w ojos|strong="H5869"\w* \w de|strong="H1697"\w* \w los|strong="H1931"\w* \w ciegos|strong="H5787"\w* \w verán|strong="H7200"\w* aun en medio \w de|strong="H1697"\w* \w la|strong="H1931"\w* \w oscuridad|strong="H2822"\w* y las \w tinieblas|strong="H2822"\w*.  
\v 19 Los humildes \w volverán|strong="H3254"\w* \w a|strong="H3068"\w* alegrarse en Yahvé, y los \w más|strong="H3254"\w* pobres se regocijarán en el \w Santo|strong="H6918"\w* de \w Israel|strong="H3478"\w*.  
\v 20 \w Porque|strong="H3588"\w* \w el|strong="H3588"\w* cruel desaparecerá, \w el|strong="H3588"\w* burlón será aniquilado \w y|strong="H3588"\w* \w todos|strong="H3605"\w* \w los|strong="H3605"\w* \w que|strong="H3588"\w* buscan \w hacer|strong="H3772"\w* \w el|strong="H3588"\w* mal serán eliminados.  
\v 21 Esos \w que|strong="H1697"\w* con una \w palabra|strong="H1697"\w* condenan \w a|strong="H3068"\w* otros, \w que|strong="H1697"\w* ponen trampas al \w que|strong="H1697"\w* juzga en el tribunal y \w que|strong="H1697"\w* con mentiras le niegan la \w justicia|strong="H6662"\w* al inocente.   
\p
\v 22 \w Por|strong="H6440"\w* \w eso|strong="H3651"\w* Yahvé, el \w que|strong="H3808"\w* rescató \w a|strong="H3068"\w* Abraham, dice \w esto|strong="H3651"\w* \w a|strong="H3068"\w* la \w familia|strong="H1004"\w* \w de|strong="H6440"\w* \w Jacob|strong="H3290"\w*: “\w Jacob|strong="H3290"\w* \w ya|strong="H6258"\w* \w no|strong="H3808"\w* \w será|strong="H3808"\w* avergonzado, \w ni|strong="H3808"\w* su \w rostro|strong="H6440"\w* volverá \w a|strong="H3068"\w* palidecer.  
\v 23 \w Porque|strong="H3588"\w* \w cuando|strong="H3588"\w* \w vea|strong="H7200"\w* \w a|strong="H3068"\w* sus \w hijos|strong="H3206"\w*, \w la|strong="H3588"\w* \w obra|strong="H4639"\w* \w de|strong="H3588"\w* mis \w manos|strong="H3027"\w* \w en|strong="H3588"\w* \w medio|strong="H3027"\w* \w de|strong="H3588"\w* \w él|strong="H3588"\w*, \w ellos|strong="H3027"\w* \w santificarán|strong="H6942"\w* mi \w nombre|strong="H8034"\w*. \w Santificarán|strong="H6942"\w* \w al|strong="H7130"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Jacob|strong="H3290"\w* \w y|strong="H3588"\w* temerán \w al|strong="H7130"\w* Dios \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*.  
\v 24 Los \w que|strong="H3045"\w* estaban confundidos de \w espíritu|strong="H7307"\w* alcanzarán entendimiento, y los \w que|strong="H3045"\w* \w se|strong="H3045"\w* quejaban aceptarán la instrucción”.   
\c 30  
\p
\v 1 “¡\w Ay|strong="H1945"\w* \w de|strong="H4480"\w* \w los|strong="H1121"\w* \w hijos|strong="H1121"\w* rebeldes — \w dice|strong="H5002"\w* Yahvé — \w que|strong="H4480"\w* \w hacen|strong="H6213"\w* planes \w sin|strong="H3808"\w* contar \w conmigo|strong="H6213"\w*, \w que|strong="H4480"\w* buscan alianzas \w sin|strong="H3808"\w* \w mi|strong="H5921"\w* \w Espíritu|strong="H7307"\w*, \w añadiendo|strong="H5595"\w* \w pecado|strong="H2403"\w* tras \w pecado|strong="H2403"\w*!  
\v 2 \w Se|strong="H3808"\w* ponen en \w camino|strong="H1980"\w* para bajar \w a|strong="H3068"\w* \w Egipto|strong="H4714"\w* \w sin|strong="H3808"\w* consultarme, buscando la protección de \w Faraón|strong="H6547"\w* y refugiándose \w a|strong="H3068"\w* la \w sombra|strong="H6738"\w* de \w Egipto|strong="H4714"\w*.  
\v 3 Pero la protección de \w Faraón|strong="H6547"\w* les resultará una \w vergüenza|strong="H3639"\w*, y el refugio \w a|strong="H3068"\w* la \w sombra|strong="H6738"\w* de \w Egipto|strong="H4714"\w* una deshonra.  
\v 4 \w Aunque|strong="H3588"\w* sus \w jefes|strong="H8269"\w* ya \w están|strong="H1961"\w* \w en|strong="H3588"\w* Zoán \w y|strong="H3588"\w* sus \w embajadores|strong="H4397"\w* han \w llegado|strong="H5060"\w* \w a|strong="H3068"\w* Hanes,  
\v 5 \w todos|strong="H3605"\w* \w se|strong="H5921"\w* avergonzarán \w de|strong="H5921"\w* ese \w pueblo|strong="H5971"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* \w sirve|strong="H3276"\w* \w de|strong="H5921"\w* \w nada|strong="H3808"\w*, \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w les|strong="H5921"\w* trae \w ayuda|strong="H5828"\w* \w ni|strong="H3808"\w* \w provecho|strong="H3276"\w*, \w sino|strong="H3588"\w* solo vergüenza \w y|strong="H1571"\w* \w deshonra|strong="H2781"\w*”.   
\p
\v 6 Profecía \w sobre|strong="H5921"\w* \w los|strong="H1992"\w* animales \w del|strong="H5921"\w* Neguev.  
\p \w Por|strong="H5921"\w* tierra \w de|strong="H5921"\w* \w angustia|strong="H6869"\w* \w y|strong="H5921"\w* \w de|strong="H5921"\w* sufrimiento, \w donde|strong="H5921"\w* habitan \w la|strong="H5921"\w* leona \w y|strong="H5921"\w* \w el|strong="H5921"\w* león, \w la|strong="H5921"\w* víbora \w y|strong="H5921"\w* \w la|strong="H5921"\w* serpiente voladora, \w llevan|strong="H5375"\w* \w sus|strong="H1992"\w* \w riquezas|strong="H2428"\w* \w sobre|strong="H5921"\w* \w los|strong="H1992"\w* lomos \w de|strong="H5921"\w* burros \w y|strong="H5921"\w* \w sus|strong="H1992"\w* tesoros \w sobre|strong="H5921"\w* \w las|strong="H1992"\w* jorobas \w de|strong="H5921"\w* \w los|strong="H1992"\w* \w camellos|strong="H1581"\w*, \w para|strong="H5921"\w* dárselos \w a|strong="H3068"\w* un \w pueblo|strong="H5971"\w* \w que|strong="H3808"\w* \w no|strong="H3808"\w* \w les|strong="H1992"\w* \w sirve|strong="H3276"\w* \w de|strong="H5921"\w* \w nada|strong="H3808"\w*.  
\v 7 Porque \w la|strong="H2063"\w* \w ayuda|strong="H5826"\w* de \w Egipto|strong="H4714"\w* \w es|strong="H2063"\w* vana \w e|strong="H3068"\w* inútil; \w por|strong="H3651"\w* \w eso|strong="H3651"\w* \w la|strong="H2063"\w* \w llamé|strong="H7121"\w*: “Rahab, \w la|strong="H2063"\w* \w que|strong="H1992"\w* \w se|strong="H1992"\w* queda sentada”.  
\v 8 Ve \w ahora|strong="H6258"\w*, escríbelo \w en|strong="H5921"\w* una tabla ante \w ellos|strong="H5921"\w* \w y|strong="H5921"\w* regístralo \w en|strong="H5921"\w* un \w libro|strong="H5612"\w*, \w para|strong="H5704"\w* \w que|strong="H6258"\w* \w quede|strong="H1961"\w* \w como|strong="H1961"\w* \w testimonio|strong="H5707"\w* \w eterno|strong="H5769"\w* \w en|strong="H5921"\w* \w los|strong="H5921"\w* \w días|strong="H3117"\w* \w por|strong="H5921"\w* venir.  
\v 9 \w Porque|strong="H3588"\w* \w este|strong="H1931"\w* \w es|strong="H1931"\w* un \w pueblo|strong="H5971"\w* \w rebelde|strong="H4805"\w*, \w hijos|strong="H1121"\w* \w mentirosos|strong="H3586"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* quieren \w escuchar|strong="H8085"\w* \w la|strong="H1931"\w* enseñanza \w de|strong="H3588"\w* Yahvé.  
\v 10 Ellos \w dicen|strong="H1696"\w* \w a|strong="H3068"\w* los \w videntes|strong="H2374"\w*: “\w No|strong="H3808"\w* tengan visiones”; y \w a|strong="H3068"\w* los profetas: “\w No|strong="H3808"\w* nos anuncien la verdad; dígannos cosas \w que|strong="H3808"\w* nos gusten, profeticen ilusiones.  
\v 11 Apártense \w del|strong="H4480"\w* \w camino|strong="H1870"\w*, dejen la senda recta, quiten \w de|strong="H4480"\w* nuestra vista \w al|strong="H4480"\w* \w Santo|strong="H6918"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*”.  
\v 12 \w Por|strong="H5921"\w* \w eso|strong="H3651"\w*, \w el|strong="H5921"\w* \w Santo|strong="H6918"\w* \w de|strong="H5921"\w* \w Israel|strong="H3478"\w* \w dice|strong="H1697"\w*: “\w Como|strong="H5921"\w* ustedes rechazan \w esta|strong="H2088"\w* \w palabra|strong="H1697"\w* \w y|strong="H5921"\w* confían \w en|strong="H5921"\w* \w la|strong="H5921"\w* opresión \w y|strong="H5921"\w* \w el|strong="H5921"\w* engaño, \w y|strong="H5921"\w* \w se|strong="H5921"\w* apoyan \w en|strong="H5921"\w* \w ellos|strong="H5921"\w*,  
\v 13 \w este|strong="H2088"\w* \w pecado|strong="H5771"\w* \w será|strong="H1961"\w* \w para|strong="H1961"\w* ustedes \w como|strong="H1961"\w* una grieta en un \w muro|strong="H2346"\w* \w alto|strong="H7682"\w* \w que|strong="H1961"\w* empieza \w a|strong="H3068"\w* abultarse y, de repente, en un instante, \w se|strong="H1961"\w* desploma.  
\v 14 \w Se|strong="H3808"\w* romperá como \w se|strong="H3808"\w* rompe \w una|strong="H4672"\w* vasija \w de|strong="H4325"\w* barro, \w que|strong="H3808"\w* \w se|strong="H3808"\w* hace pedazos \w sin|strong="H3808"\w* piedad, hasta \w que|strong="H3808"\w* \w entre|strong="H3808"\w* los escombros \w no|strong="H3808"\w* \w se|strong="H3808"\w* \w halla|strong="H4672"\w* \w ni|strong="H3808"\w* un trozo para sacar brasas del fogón \w o|strong="H3068"\w* para tomar \w agua|strong="H4325"\w* \w de|strong="H4325"\w* la cisterna”.   
\p
\v 15 \w Porque|strong="H3588"\w* \w así|strong="H3541"\w* \w ha|strong="H3541"\w* dicho \w el|strong="H3588"\w* Señor Yahvé, \w el|strong="H3588"\w* \w Santo|strong="H6918"\w* \w de|strong="H3588"\w* \w Israel|strong="H3478"\w*: “\w Su|strong="H3588"\w* salvación depende \w de|strong="H3588"\w* \w que|strong="H3588"\w* vuelvan \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w y|strong="H3588"\w* descansen; \w su|strong="H3588"\w* fuerza \w está|strong="H1961"\w* \w en|strong="H3588"\w* \w la|strong="H3588"\w* paz \w y|strong="H3588"\w* \w la|strong="H3588"\w* confianza”. \w Pero|strong="H3588"\w* ustedes \w no|strong="H3808"\w* quisieron,  
