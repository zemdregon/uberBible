\q2 Ustedes serán amamantados, llevados \w en|strong="H5921"\w* \w brazos|strong="H5158"\w*  
\q2 \w y|strong="H3588"\w* acariciados \w sobre|strong="H5921"\w* \w las|strong="H5921"\w* \w rodillas|strong="H1290"\w*.   
\q1
\v 13 \w Como|strong="H3651"\w* una madre \w consuela|strong="H5162"\w* \w a|strong="H3068"\w* su hijo, \w así|strong="H3651"\w* los consolaré yo \w a|strong="H3068"\w* ustedes;  
\q2 en Jerusalén hallarán \w consuelo|strong="H5162"\w*”.   
\b  
\q1
\v 14 \w Cuando|strong="H5650"\w* \w vean|strong="H7200"\w* esto, su \w corazón|strong="H3820"\w* \w se|strong="H3045"\w* alegrará y sus \w huesos|strong="H6106"\w* \w florecerán|strong="H6524"\w* como la \w hierba|strong="H1877"\w*;  
\q2 Yahvé \w mostrará|strong="H3045"\w* su \w poder|strong="H3027"\w* \w a|strong="H3068"\w* sus \w siervos|strong="H5650"\w*  
\q2 y su enojo \w a|strong="H3068"\w* sus enemigos.   
\b  
\q1
\v 15 \w Porque|strong="H3588"\w* miren, Yahvé viene \w con|strong="H3588"\w* fuego, \w y|strong="H3588"\w* sus \w carros|strong="H4818"\w* \w son|strong="H3588"\w* \w como|strong="H3588"\w* un \w torbellino|strong="H5492"\w*,  
