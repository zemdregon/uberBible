\q2 y \w haré|strong="H6213"\w* llanos los \w caminos|strong="H1870"\w* escabrosos.  
\q2 \w Esto|strong="H1697"\w* \w es|strong="H1697"\w* \w lo|strong="H1697"\w* \w que|strong="H3808"\w* \w haré|strong="H6213"\w*,  
\q2 y \w no|strong="H3808"\w* los \w abandonaré|strong="H5800"\w*.   
\b  
\q1
\v 17 Pero los que confían en ídolos,  
\q2 los que dicen \w a|strong="H3068"\w* las \w estatuas|strong="H4541"\w*: “Ustedes son nuestros dioses”,  
\q2 serán puestos en vergüenza y retrocederán humillados.   
\b  
\q1
\v 18 “¡\w Escuchen|strong="H8085"\w*, \w sordos|strong="H2795"\w*!  
\q2 ¡\w Miren|strong="H5027"\w*, \w ciegos|strong="H5787"\w*, y \w vean|strong="H7200"\w*!   
\q1
\v 19 ¿\w Quién|strong="H4310"\w* \w es|strong="H3588"\w* \w más|strong="H3588"\w* \w ciego|strong="H5787"\w* \w que|strong="H3588"\w* mi propio \w siervo|strong="H5650"\w*?  
\q2 ¿\w Quién|strong="H4310"\w* \w es|strong="H3588"\w* \w más|strong="H3588"\w* \w sordo|strong="H2795"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w mensajero|strong="H4397"\w* \w que|strong="H3588"\w* \w envío|strong="H7971"\w*?  
\q1 ¿\w Quién|strong="H4310"\w* \w es|strong="H3588"\w* \w más|strong="H3588"\w* \w ciego|strong="H5787"\w* \w que|strong="H3588"\w* mi \w enviado|strong="H7971"\w*,  
\q2 \w más|strong="H3588"\w* \w ciego|strong="H5787"\w* \w que|strong="H3588"\w* \w el|strong="H3588"\w* \w siervo|strong="H5650"\w* \w de|strong="H3588"\w* Yahvé?   
\q1
\v 20 Ustedes han \w visto|strong="H7200"\w* \w mucho|strong="H7227"\w*, pero \w no|strong="H3808"\w* han hecho caso;  
\q2 \w tienen|strong="H8104"\w* los \w oídos|strong="H8085"\w* abiertos, pero \w no|strong="H3808"\w* \w escuchan|strong="H8085"\w* \w nada|strong="H3808"\w*”.   
\q1
\v 21 Yahvé, \w por|strong="H4616"\w* amor \w a|strong="H3068"\w* su \w justicia|strong="H6664"\w*,  
\q2 \w quiso|strong="H2654"\w* engrandecer y dar honor \w a|strong="H3068"\w* su \w ley|strong="H8451"\w*.   
\q1
\v 22 Pero \w este|strong="H1931"\w* \w es|strong="H1931"\w* un \w pueblo|strong="H5971"\w* robado y saqueado;  
\q2 \w todos|strong="H3605"\w* \w están|strong="H1961"\w* atrapados en cuevas  
