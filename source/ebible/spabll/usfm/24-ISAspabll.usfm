\v 20 Traerán \w a|strong="H3068"\w* \w todos|strong="H3605"\w* \w los|strong="H1121"\w* hermanos \w de|strong="H5921"\w* ustedes \w de|strong="H5921"\w* \w entre|strong="H5921"\w* \w todas|strong="H3605"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w*, \w como|strong="H5921"\w* una \w ofrenda|strong="H4503"\w* \w para|strong="H5921"\w* Yahvé. \w Los|strong="H1121"\w* traerán \w en|strong="H5921"\w* \w caballos|strong="H5483"\w*, \w en|strong="H5921"\w* \w carros|strong="H7393"\w*, \w en|strong="H5921"\w* literas, \w en|strong="H5921"\w* mulos \w y|strong="H5921"\w* \w en|strong="H5921"\w* camellos, \w hasta|strong="H5921"\w* \w mi|strong="H5921"\w* \w monte|strong="H2022"\w* \w santo|strong="H6944"\w* \w en|strong="H5921"\w* Jerusalén”, dice Yahvé, “así \w como|strong="H5921"\w* \w los|strong="H1121"\w* israelitas traen sus ofrendas \w en|strong="H5921"\w* \w vasijas|strong="H3605"\w* \w limpias|strong="H2889"\w* \w al|strong="H5921"\w* \w templo|strong="H1004"\w* \w de|strong="H5921"\w* Yahvé.  
\v 21 \w Y|strong="H3068"\w* de entre \w ellos|strong="H1992"\w* \w mismos|strong="H1992"\w* \w tomaré|strong="H3947"\w* \w a|strong="H3068"\w* algunos para \w que|strong="H1571"\w* sean \w sacerdotes|strong="H3548"\w* \w y|strong="H1571"\w* \w levitas|strong="H3881"\w*”, dice Yahvé.   
\p
\v 22 “\w Porque|strong="H3588"\w* \w así|strong="H3651"\w* \w como|strong="H3588"\w* \w los|strong="H3588"\w* \w cielos|strong="H8064"\w* \w nuevos|strong="H2319"\w* \w y|strong="H3588"\w* \w la|strong="H3588"\w* tierra \w nueva|strong="H2319"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* voy \w a|strong="H3068"\w* crear permanecerán \w ante|strong="H6440"\w* mí”, \w dice|strong="H5002"\w* Yahvé, “\w así|strong="H3651"\w* \w también|strong="H3651"\w* permanecerán sus descendientes \w y|strong="H3588"\w* \w su|strong="H3588"\w* \w nombre|strong="H8034"\w*.  
