\q2 \w ni|strong="H3808"\w* \w obedecieron|strong="H8085"\w* su enseñanza.   
\q1
\v 25 \w Por|strong="H5921"\w* eso Dios \w derramó|strong="H8210"\w* \w sobre|strong="H5921"\w* \w ellos|strong="H5921"\w* su \w ira|strong="H2534"\w* \w ardiente|strong="H1197"\w*  
\q2 \w y|strong="H5921"\w* \w el|strong="H5921"\w* \w furor|strong="H2534"\w* \w de|strong="H5921"\w* \w la|strong="H5921"\w* \w guerra|strong="H4421"\w*.  
\q1 \w Los|strong="H5921"\w* envolvió \w en|strong="H5921"\w* llamas, pero \w no|strong="H3808"\w* \w entendieron|strong="H3045"\w*;  
\q2 \w los|strong="H5921"\w* consumió, pero \w no|strong="H3808"\w* \w lo|strong="H3808"\w* tomaron \w en|strong="H5921"\w* serio.   
\c 43  
\q1
\v 1 \w Pero|strong="H3588"\w* \w ahora|strong="H6258"\w*, \w así|strong="H3541"\w* dice Yahvé, \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* creó, \w Jacob|strong="H3290"\w*,  
\q2 \w el|strong="H3588"\w* \w que|strong="H3588"\w* \w te|strong="H3588"\w* \w formó|strong="H3335"\w*, \w Israel|strong="H3478"\w*:  
\q1 “\w No|strong="H3588"\w* tengas \w miedo|strong="H3372"\w*, \w porque|strong="H3588"\w* \w yo|strong="H3588"\w* \w te|strong="H3588"\w* he rescatado;  
\q2 \w te|strong="H3588"\w* he \w llamado|strong="H8034"\w* \w por|strong="H3588"\w* tu \w nombre|strong="H8034"\w*; tú eres mío.   
\q1
\v 2 \w Cuando|strong="H3588"\w* \w pases|strong="H5674"\w* \w por|strong="H3588"\w* las \w aguas|strong="H4325"\w*, \w yo|strong="H3588"\w* estaré contigo;  
\q2 \w cuando|strong="H3588"\w* cruces \w los|strong="H3588"\w* ríos, \w no|strong="H3808"\w* \w te|strong="H3588"\w* ahogarás.  
\q1 \w Cuando|strong="H3588"\w* camines \w por|strong="H3588"\w* \w el|strong="H3588"\w* fuego, \w no|strong="H3808"\w* \w te|strong="H3588"\w* quemarás,  
