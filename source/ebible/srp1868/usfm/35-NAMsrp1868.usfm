\id NAM  
\h Књига пророка Наума 
\toc1 Књига пророка Наума 
\toc2 Наум 
\toc3 Нм 
\mt1 Књига пророка Наума  
\c 1  
\s1 Божије величанство против Асирије.  
\p
\v 1 Бреме Ниневији;  
\p књига од утваре Наума Елкошанина.   
\b  
\q1
\v 2 Бог је ревнитељ и Господ је осветник;  
\q2 осветник је Господ и гневи се;  
\q1 Господ се свети противницима својим,  
\q2 и држи гнев према непријатељима својим.   
\q1
\v 3 Господ је спор на гнев и велике је моћи;  
\q2 али никако не правда кривца;  
\q1 пут је Господњи у вихору и бури,  
\q2 и облаци су прах од ногу Његових.   
\q1
\v 4 Запрећује мору и исушује га,  
\q2 и све реке исушује,  
\q1 вене Васан и Кармил,  
\q2 и цвет васански вене.   
\q1
\v 5 Горе се тресу од Њега,  
\q2 и хумови се растапају,  
\q1 а земља гори пред Њим  
\q2 и васиљена и све што живи у њој.   
\b  
\q1
\v 6 Пред гневом Његовим ко ће се одржати?  
\q2 И ко ће се опрети јарости гнева Његовог?  
\q1 Јарост се Његова излива као огањ,  
\q2 и стене се распадају пред Њим.   
\q1
\v 7 Добар је Господ,  
\q2 град је у невољи,  
\q2 и познаје оне који се уздају у Њ.   
\q1
\v 8 Али ће силном поплавом учинити крај месту њеном,  
\q2 и тама ће гонити непријатеље Његове.   
\q1
\v 9 Шта смишљате Господу?  
\q2 Он ће учинити крај;  
\q2 неће се два пута подигнути погибао.   
\q1
\v 10 Јер као трње сплетени  
\q2 и као од вина пијани  
\q2 прождреће се као сува слама.   
\q1
\v 11 Из тебе је изашао који смишља зло Господу,  
\q2 саветник неваљао.   
\b  
\q1
\v 12 Овако вели Господ:  
\q1 Ако и јесу у сили и много их има,  
\q2 опет ће се исећи и проћи.  
\q1 Мучио сам те,  
\q2 нећу те више мучити.   
\q1
\v 13 Него ћу сада сломити јарам његов с тебе,  
\q2 и покидаћу твоје окове.   
\b  
\q1
\v 14 Али за тебе заповеди Господ да се не сеје више име твоје;  
\q2 из дома богова твојих истребићу ликове резане и ливене;  
\q2 начинићу ти од њега гроб кад будеш презрен.   
\b  
\q1
\v 15 Ето, на горама ноге оног који носи добре гласе,  
\q2 који оглашује мир.  
\q1 Празнуј, Јуда, своје празнике,  
\q2 испуњај завете своје,  
\q1 јер зликовац неће више пролазити по теби;  
\q2 сасвим се затро.   
\c 2  
\s1 Прорицање о разорењу града Ниневије.  
\q1
\v 1 Изађе затирач на те,  
\q2 чувај град, пази на пут,  
\q2 утврди бедра, укрепи се добро.   
\b  
\q1
\v 2 Јер Господ поврати славу Јаковљеву  
\q2 као славу Израиљеву,  
\q1 јер их пустошници опустошише  
\q2 и лозе им потрше.   
\b  
\q1
\v 3 Штит је јунака његових црвен,  
\q2 војници су у скерлету;  
\q1 кола ће му бити као запаљени лучеви  
\q2 на дан кад се уврста,  
\q2 и јеле ће се љуљати страшно.   
\q1
\v 4 Кола ће праскати по улицама  
\q2 и ударати једна о друга по путевима,  
\q1 биће као лучеви,  
\q2 и трчаће као муње.   
\q1
\v 5 Помињаће јунаке своје,  
\q2 а они ће падати идући,  
\q1 похитаће к зидовима његовим,  
\q2 и заклон ће бити готов.   
\q1
\v 6 Врата ће се рекама отворити,  
\q2 и двор ће се развалити.   
\q1
\v 7 И која стоји, заробиће се и одвешће се,  
\q2 девојке њене пратиће је  
\q2 уздишући као голубице, бијући се у прси.   
\q1
\v 8 Ниневија беше као језеро водено откако јесте;  
\q2 али беже.  
\q1 Станите, станите.  
\q2 Али се нико не обзире.   
\q1
\v 9 Грабите сребро, грабите злато;  
\q2 благу нема краја,  
\q2 мноштво је свакојаких драгих заклада.   
\b  
\q1
\v 10 Испразни се, и оголе, и опусте;  
\q2 и срце се растопи,  
\q2 колена ударају једна о друго,  
\q1 и бол је у свим бедрима,  
\q2 и лица су свима поцрнела.   
\q1
\v 11 Где је ложа лавовима и пасиште лавићима,  
\q2 куда иђаше лав и лавица и лавић,  
\q2 и никога не беше да плаши.   
\q1
\v 12 Лав ловљаше својим лавићима доста,  
\q2 и дављаше лавицама својим,  
\q1 и пуњаше пећине своје лова  
\q2 и ложе своје грабежа.   
\b  
\p
\v 13 Ево ме на те, говори Господ над војскама, и попалићу кола твоја у дим, и мач ће прождрети лавиће твоје, и истребићу са земље грабеж твој, и неће се чути глас посланика твојих.   
\c 3  
\s1 Грехови су града Ниневије узрок казни која иде на њу.  
\q1
\v 1 Тешко граду крвничком,  
\q2 сав је пун лажи и отимања,  
\q2 грабеж не избива из њега.   
\q1
\v 2 Пуцају бичеви, и точкови праште,  
\q2 и коњи топоћу, и кола скачу.   
\q1
\v 3 Коњаници поскакују,  
\q2 и мачеви се сјају,  
\q2 и копља севају,  
\q1 и мноштво је побијених  
\q2 и сила мртвих телеса,  
\q1 нема броја мртвацима,  
\q2 и пада се преко мртваца.   
\q1
\v 4 За мноштво курварства љупке курве,  
\q2 веште бајачице,  
\q1 која продаје народе својим курвањем  
\q2 и племена врачањем својим.   
\b  
\q1
\v 5 Ево ме на те,  
\q2 говори Господ над војскама,  
\q1 и узгрнућу ти скуте твоје на лице,  
\q2 и показаћу народима голотињу твоју  
\q2 и царствима срамоту твоју.   
\q1
\v 6 И бацићу на тебе гадове и наружићу те,  
\q2 и начинићу од тебе углед.   
\q1
\v 7 И ко те год види, бежаће од тебе,  
\q2 и говориће:  
\q1 Опусте Ниневија;  
\q2 ко ће је жалити?  
\q2 Где ћу тражити оне који би те тешили?   
\b  
\q1
\v 8 Јеси ли боља од Но-Амона,  
\q2 који лежаше међу рекама,  
\q2 опточен водом,  
\q1 коме предња кула беше море  
\q2 и зидови му беху море?   
\q1
\v 9 Јачина му беше хуска земља и Мисир и народи без броја;  
\q2 Футеји и Ливеји беху ти помоћници.   
\b  
\q1
\v 10 И он би пресељен, отиде у ропство,  
\q2 и деца његова бише размрскана по угловима свих улица;  
\q1 и за главаре његове бацаше жреб,  
\q2 и сви властељи његови бише оковани у пута.   
\q1
\v 11 И ти ћеш се опити и крићеш се,  
\q2 и ти ћеш тражити заклон од непријатеља.   
\q1
\v 12 Сви ће градови твоји бити као смокве с раним родом;  
\q2 кад се тресну, падају у уста ономе ко хоће да једе.   
\q1
\v 13 Ето, народ су ти жене усред тебе;  
\q2 непријатељима ће твојим бити широм отворена врата од земље твоје,  
\q2 огањ ће прождрети преворнице твоје.   
\b  
\q1
\v 14 Нахватај себи воде за опсаду,  
\q2 утврди ограде своје;  
\q1 уђи у као и угази блато,  
\q2 оправи пећ за опеке.   
\q1
\v 15 Онде ће те прождрети огањ,  
\q2 мач ће те исећи,  
\q2 изјешће те као хрушт;  
\q1 нека вас је много као хруштева,  
\q2 нека вас је много као скакаваца.   
\q1
\v 16 Имаш трговаца више него што је звезда на небу;  
\q2 хруштеви падоше, па одлетеше.   
\b  
\q1
\v 17 Главари су твоји као скакавци  
\q2 и војводе твоје као велики скакавци,  
\q1 који падају по плотовима кад је студено,  
\q2 а кад сунце гране, одлећу,  
\q2 и место им се не познаје где беху.   
\b  
\q1
\v 18 Задремаше твоји пастири, царе асирски,  
\q2 полегаше јунаци твоји,  
\q1 народ се твој распрша по горама,  
\q2 и нема никога да их збере.   
\q1
\v 19 Нема лека полому твом,  
\q2 љута је рана твоја;  
\q1 ко год чује глас о теби,  
\q2 пљескаће рукама над тобом,  
\q2 јер кога није стизала злоћа твоја једнако?   