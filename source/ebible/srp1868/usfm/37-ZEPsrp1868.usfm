\id ZEP  
\h Књига пророка Софоније 
\toc1 Књига пророка Софоније 
\toc2 Софонија 
\toc3 Соф 
\mt1 Књига пророка Софоније  
\c 1  
\s1 Дан гнева.  
\p
\v 1 Реч Господња која дође Софонији, сину Хусија сина Годолије сина Амарије сина Језекијиног, за времена Јосије, сина Амоновог, цара Јудиног.   
\b  
\q1
\v 2 Све ћу узети са земље,  
\q2 говори Господ;   
\q1
\v 3 Узећу људе и стоку,  
\q2 узећу птице небеске и рибе морске  
\q2 и саблазни с безбожницима,  
\q1 и истребићу људе са земље,  
\q2 говори Господ.   
\q1
\v 4 Јер ћу махнути руком својом на Јуду  
\q2 и на све становнике јерусалимске,  
\q1 и истребићу из места овог остатак Валов  
\q2 и име свештеника идолских с другим свештеницима,   
\q1
\v 5 И оне који се клањају на крововима војсци небеској  
\q2 и који се клањају и куну се Господом  
\q2 и који се куну Мелхомом.   
\q1
\v 6 И оне који се одвраћају од Господа  
\q2 и који не траже Господа нити питају за Њ.   
\b  
\q1
\v 7 Ћути пред Господом Господом,  
\q2 јер је близу дан Господњи,  
\q1 јер је Господ приготовио жртву  
\q2 и позвао своје званице.   
\q1
\v 8 И у дан жртве Господње  
\q2 походићу кнезове и царске синове и све који носе туђинско одело.   
\q1
\v 9 И походићу у тај дан све који скачу преко прага,  
\q2 који пуне кућу господара својих грабежом и преваром.   
\b  
\q1
\v 10 И у тај ће дан, вели Господ,  
\q2 бити вика од рибљих врата,  
\q1 и јаук с друге стране,  
\q2 и полом велик с хумова.   
\q1
\v 11 Ридајте који живите у Мактесу,  
\q2 јер изгибе сав народ трговачки,  
\q2 истребише се сви који носе сребро.   
\q1
\v 12 И у то ћу време разгледати Јерусалим са жишцима,  
\q2 и походићу људе који леже на својој дрождини,  
\q1 који говоре у срцу свом:  
\q2 Господ не чини ни добро ни зло.   
\q1
\v 13 И благо ће се њихово разграбити  
\q2 и куће њихове опустошити;  
\q1 граде куће, али неће седети у њима;  
\q2 и саде винограде, али неће пити вино из њих.   
\b  
\q1
\v 14 Близу је велики дан Господњи,  
\q2 близу је и иде врло брзо;  
\q1 глас ће бити дана Господњег,  
\q2 горко ће тада викати јунак.   
\q1
\v 15 Тај је дан, дан када ће бити гнев,  
\q2 дан, када ће бити туга и мука,  
\q1 дан, када ће бити пустошење и затирање,  
\q2 дан, када ће бити мрак и тама,  
\q2 дан, када ће бити облак и магла.   
\q1
\v 16 Дан, када ће бити трубљење  
\q2 и поклич на тврде градове и на високе углове.   
\b  
\q1
\v 17 И притеснићу људе,  
\q2 те ће ићи као слепи,  
\q2 јер згрешише Господу;  
\q1 и крв ће се њихова просути као прах  
\q2 и телеса њихова као гној.   
\q1
\v 18 Ни сребро њихово ни злато њихово неће их моћи избавити  
\q2 у дан гнева Господњег;  
\q1 и сву ће земљу прождрети огањ ревности Његове;  
\q2 јер ће брзо учинити крај свима становницима земаљским.   
\c 2  
\s1 Опомена народу да се покаје. Казна над народом.  
\q1
\v 1 Саберите се,  
\q2 саберите се, народе немили.   
\q1
\v 2 Док није изашао суд,  
\q2 и дан прошао као плева,  
\q1 док није дошао на вас љути гнев Господњи,  
\q2 док није дошао на вас дан гнева Господњег.   
\q1
\v 3 Тражите Господа сви који сте кротки у земљи,  
\q2 који чините шта је наредио;  
\q1 тражите правду,  
\q2 тражите кротост,  
\q2 еда бисте се сакрили на дан гнева Господњег.   
\q1
\v 4 Јер ће се Газа оставити  
\q2 и Аскалон ће опустети;  
\q1 Азот ће се одагнати у подне  
\q2 и Акарон ће се искоренити.   
\b  
\q1
\v 5 Тешко онима који живе по бреговима морским,  
\q2 народу херетејском:  
\q1 реч је Господња на вас,  
\q2 Ханане, земљо филистејска,  
\q1 ја ћу те затрти  
\q2 да не буде становника у теби.   
\q1
\v 6 И брегови ће морски бити станови и јаме пастирске и торови за стада.   
\q1
\v 7 И тај ће крај бити остатку дома Јудиног;  
\q1 онде ће пасти;  
\q2 у домовима ће аскалонским легати увече;  
\q1 јер ће их походити Господ Бог њихов  
\q2 и повратити робље њихово.   
\b  
\q1
\v 8 Чуо сам руг Моавов  
\q2 и укоре синова Амонових  
\q1 којима ружише мој народ,  
\q2 и раширише се преко међа њихових.   
\q1
\v 9 Зато, тако ја био жив,  
\q2 говори Господ над војскама,  
\q2 Бог Израиљев,  
\q1 Моав ће бити као Содом  
\q2 и синови Амонови као Гомор,  
\q1 место копривама,  
\q2 и сланица и вечна пустош;  
\q1 остатак народа мог оплениће их,  
\q2 и који остану од народа мог наследиће их.   
\q1
\v 10 То ће им бити за поноситост њихову;  
\q2 јер ружише народ Господа над војскама  
\q2 и подизаше се на Њ.   
\q1
\v 11 Страшан ће им бити Господ,  
\q2 јер ће истребити све богове земаљске,  
\q1 и Њему ће се клањати сваки из свог места,  
\q2 сва острва народна.   
\b  
\q1
\v 12 И ви, Етиопљани,  
\q2 бићете побијени мачем мојим.   
\b  
\q1
\v 13 И дигнуће руку своју на север,  
\q2 и затрће Асирску,  
\q1 и Ниневију ће опустети  
\q2 да буде сува као пустиња.   
\q1
\v 14 И у њој ће лежати стада,  
\q2 свакојако зверје између народа,  
\q2 и гем и ћук ноћиваће на довратницима њеним;  
\q1 гласом ће певати на прозорима;  
\q2 пустош ће бити на праговима,  
\q2 јер ће се поскидати кедровина.   
\q1
\v 15 Такав ће бити весели град,  
\q2 који седи без бриге,  
\q1 који говори у срцу свом:  
\q2 Ја сам, и осим мене нема другог.  
\q1 Како опусте!  
\q2 Поста ложа зверју!  
\q1 Ко год прође мимо њ  
\q2 звиждаће и махати руком.   
\c 3  
\s1 Претња Јерусалиму. Утешно обрицање Месијскога времена.  
\q1
\v 1 Тешко граду одметничком и оскврњеном,  
\q2 насилничком!   
\q1
\v 2 Не слуша глас,  
\q2 не прима наук,  
\q1 не узда се у Господа,  
\q2 не приступа к Богу свом.   
\b  
\q1
\v 3 Кнезови су му у њему лавови који ричу;  
\q2 судије су му вуци вечерњи,  
\q2 који не глођу кости до јутра.   
\q1
\v 4 Пророци су му хвалише, варалице;  
\q2 свештеници његови скврне светињу,  
\q2 изврћу закон.   
\q1
\v 5 Господ је праведан усред њега,  
\q2 не чини неправде,  
\q1 свако јутро износи суд свој на видело,  
\q2 не изостаје,  
\q1 али безбожник не зна за стид.   
\b  
\q1
\v 6 Истребих народе,  
\q2 куле им се разорише,  
\q1 улице им опустех,  
\q2 те нико не пролази;  
\q1 градови им се раскопаше,  
\q2 да нема никога, нема становника.   
\q1
\v 7 Рекох: Побојаћеш ме се,  
\q2 примићеш наук;  
\q1 неће му се затрти стан ничим  
\q2 са чим бих га походио;  
\q1 али они уранише  
\q2 те покварише сва дела своја.   
\b  
\q1
\v 8 Зато чекајте ме, говори Господ,  
\q2 до дана кад ћу се подигнути на плен;  
\q1 јер је суд мој да саберем народе  
\q2 и покупим царства,  
\q1 да излијем на њих гнев свој,  
\q2 сву жестину јарости своје,  
\q1 јер ће огањ ревности моје прождрети сву земљу.   
\b  
\q1
\v 9 Јер ћу тада променити народима усне,  
\q2 те ће бити чисте,  
\q1 да би сви призивали име Господње  
\q2 и служили Му сложним раменима.   
\q1
\v 10 Испреко река хуских који се мени моле,  
\q2 расејани моји,  
\q2 донеће ми даре.   
\b  
\q1
\v 11 Тада се нећеш више стидети ни једног од својих дела,  
\q2 којима си ми згрешио;  
\q1 јер ћу онда узети из тебе оне који се хвале славом твојом,  
\q2 и нећеш се више величати на светој гори мојој.   
\q1
\v 12 И оставићу у теби народ невољан и сиромашан,  
\q2 и они ће се уздати у име Господње.   
\q1
\v 13 Остатак Израиљев неће чинити безакоња  
\q2 нити ће говорити лажи,  
\q2 нити ће се наћи у устима њиховим језик преваран;  
\q1 него ће пасти и лежати  
\q2 и неће бити никога да их плаши.   
\b  
\q1
\v 14 Певај, кћери сионска;  
\q2 кликуј, Израиљу;  
\q1 радуј се и весели се из свега срца,  
\q2 кћери јерусалимска!   
\q1
\v 15 Уклони Господ судове твоје,  
\q2 одврати непријатеље твоје;  
\q1 цар Израиљев Господ усред тебе је,  
\q2 нећеш се више бојати зла.   
\q1
\v 16 У онај дан рећи ће се граду Јерусалиму: Не бој се;  
\q2 Сиону: Немој да ти клону руке.   
\q1
\v 17 Господ Бог твој, који је усред тебе,  
\q2 силни, спашће те;  
\q1 радоваће ти се веома,  
\q2 умириће се у љубави својој,  
\q2 веселиће се тебе ради певајући.   
\q1
\v 18 Који туже за празницима,  
\q2 сабраћу их,  
\q1 који су из тебе,  
\q2 ради тешке срамоте која је на теби.   
\q1
\v 19 Гле, уништићу у оно време све који те муче,  
\q2 и избавићу хроме и сабрати одагнане,  
\q1 и добавићу им хвалу и славу по свој земљи,  
\q2 где су били под срамотом.   
\q1
\v 20 У оно време довешћу вас,  
\q2 у оно време сабраћу вас;  
\q1 јер ћу вам добавити славу и хвалу по свим народима на земљи,  
\q2 кад повратим робље ваше пред вашим очима,  
\q2 говори Господ.   