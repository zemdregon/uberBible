\id SNG  
\h Песма над песмама 
\toc1 Песма над песмама 
\toc2 Песма над песмама 
\toc3 Пес 
\mt1 Песма над песмама  
\c 1  
\s1 Пријатељева и пријатељичина љубав.  
\p
\v 1 Соломунова песма над песмама.   
\b  
\q1
\v 2 Да ме хоће пољубити пољупцем уста својих!  
\q2 Јер је твоја љубав боља од вина.   
\q1
\v 3 Мирисом су твоја уља прекрасна;  
\q2 име ти је уље разлито;  
\q2 зато те љубе девојке.   
\q1
\v 4 Вуци ме, за тобом ћемо трчати;  
\q2 уведе ме цар у ложницу своју;  
\b  
\q1 радоваћемо се и веселићемо се тобом,  
\q2 спомињаћемо љубав твоју више него вино;  
\q2 прави љубе те.   
\b  
\q1
\v 5 Црна сам, али сам лепа,  
\q2 кћери јерусалимске,  
\q2 као шатори кидарски, као завеси Соломунови.   
\q1
\v 6 Не гледајте ме што сам црна,  
\q2 јер ме је сунце опалило;  
\q1 синови матере моје расрдивши се на ме  
\q2 поставише ме да чувам винограде,  
\q2 и не чувах свој виноград, који ја имам.   
\q1
\v 7 Кажи ми ти, ког љуби душа моја,  
\q2 где пасеш, где пландујеш?  
\q2 Јер зашто бих лутала међу стадима другова твојих?   
\b  
\q1
\v 8 Ако не знаш, најлепша између жена,  
\q2 пођи трагом за стадом,  
\q2 и паси јариће своје покрај станова пастирских.   
\b  
\q1
\v 9 Ти си ми, драга моја,  
\q2 као коњи у колима Фараоновим.   
\q1
\v 10 Образи су твоји окићени гривнама,  
\q2 и грло твоје низовима.   
\b  
\q1
\v 11 Начинићемо ти златне гривне  
\q2 са шарама сребрним.   
\b  
\q1
\v 12 Док је цар за столом,  
\q2 нард мој пушта свој мирис.   
\q1
\v 13 Драги ми је мој кита смирне,  
\q2 која међу дојкама мојим почива.   
\q1
\v 14 Драги ми је мој грозд кипров  
\q2 из винограда енгадских.   
\b  
\q1
\v 15 Лепа ти си, драга моја,  
\q2 лепа ти си!  
\q2 Очи су ти као у голубице.   
\b  
\q1
\v 16 Леп ти си, драги мој, и љубак!  
\q2 И постеља наша зелени се.   
\q1
\v 17 Греде су нам у кућама кедрове,  
\q2 даске су нам јелове.   
\c 2  
\s1 Чежња пријатељице за пријатељем.  
\q1
\v 1 Ја сам ружа саронска,  
\q2 љиљан у долу.   
\b  
\q1
\v 2 Шта је љиљан међу трњем,  
\q2 то је драга моја међу девојкама.   
\b  
\q1
\v 3 Шта је јабука међу дрветима шумским,  
\q2 то је драги мој међу момцима;  
\q1 желех хлад њен, и седох,  
\q2 и род је њен сладак грлу мом.   
\q1
\v 4 Уведе ме у кућу где је гозба,  
\q2 а застава му је љубав к мени.   
\q1
\v 5 Поткрепите ме жбановима,  
\q2 придржите ме јабукама,  
\q2 јер сам болна од љубави.   
\q1
\v 6 Лева је рука његова мени под главом,  
\q2 а десном ме грли.   
\q1
\v 7 Заклињем вас, кћери јерусалимске,  
\q2 срнама и кошутама пољским,  
\q1 не будите љубави моје, не будите је,  
\q2 док јој не буде воља.   
\b  
\q1
\v 8 Глас драгог мог;  
\q2 ево га, иде скачући преко гора,  
\q2 поскакујући преко хумова.   
\q1
\v 9 Драги је мој као срна или као јеленче;  
\q2 ево га, стоји иза нашег зида,  
\q2 гледа кроз прозор, вири кроз решетку.   
\q1
\v 10 Проговори драги мој и рече ми:  
\q2 Устани, драга моја, лепотице моја, и ходи.   
\q1
\v 11 Јер гле, зима прође,  
\q2 минуше дажди, отидоше.   
\q1
\v 12 Цвеће се види по земљи,  
\q2 дође време певању,  
\q2 и глас грличин чује се у нашој земљи.   
\q1
\v 13 Смоква је пустила заметке своје,  
\q2 и лоза винова уцвала мирише.  
\q2 Устани, драга моја, лепотице моја, и ходи.   
\q1
\v 14 Голубице моја у раселинама каменим,  
\q2 у заклону врлетном!  
\q1 Дај да видим лице твоје,  
\q2 дај да чујем глас твој;  
\q1 јер је глас твој сладак  
\q2 и лице твоје красно.   
\q1
\v 15 Похватајте нам лисице,  
\q2 мале лисице, што кваре винограде,  
\q2 јер наши виногради цвату.   
\b  
\q1
\v 16 Мој је драги мој, и ја сам његова,  
\q2 он пасе међу љиљанима.   
\q1
\v 17 Док захлади дан и сенке отиду,  
\q2 врати се, буди као срна, драги мој,  
\q2 или као јеленче по горама раздељеним.   
\c 3  
\s1 Верност пријатељичина. Слава пријатељева.  
\q1
\v 1 На постељи својој ноћу тражих  
\q2 оног кога љуби душа моја,  
\q2 тражих га, али га не нађох.   
\q1
\v 2 Сада ћу устати, па идем по граду,  
\q2 по трговима и по улицама тражићу  
\q1 оног кога љуби душа моја.  
\q2 Тражих га, али га не нађох.   
\q1
\v 3 Нађоше ме стражари, који обилазе по граду.  
\q2 Видесте ли оног кога љуби душа моја?   
\q1
\v 4 Мало их заминух,  
\q2 и нађох оног кога љуби душа моја;  
\q1 и ухватих га, и нећу га пустити  
\q2 докле га не одведем у кућу матере своје  
\q2 и у ложницу родитељке своје.   
\q1
\v 5 Заклињем вас, кћери јерусалимске,  
\q2 срнама и кошутама пољским,  
\q1 не будите љубави моје, не будите је,  
\q2 док јој не буде воља.   
\b  
\q1
\v 6 Ко је она што иде горе из пустиње  
\q2 као ступови од дима, поткађена смирном и тамјаном  
\q2 и свакојаким прашком апотекарским?   
\q1
\v 7 Гле, одар Соломунов,  
\q2 а око њега шездесет јунака  
\q2 између јунака Израиљевих:   
\q1
\v 8 Сви имају мачеве, вешти су боју,  
\q2 у сваког је мач о бедру ради страха ноћног.   
\q1
\v 9 Одар је начинио себи цар Соломун  
\q2 од дрвета ливанског;   
\q1
\v 10 Ступце му је начинио од сребра,  
\q2 узглавље од злата, небо од скерлета,  
\q2 а изнутра настрт љубављу за кћери јерусалимске.   
\q1
\v 11 Изиђите, кћери сионске,  
\q2 и гледајте цара Соломуна  
\q2 под венцем којим га мати његова окити  
\q1 на дан свадбе његове  
\q2 и на дан весеља срца његовог.   
\c 4  
\s1 Милине пријатељичине.  
\q1
\v 1 Лепа ти си, драга моја, лепа ти си,  
\q2 очи су ти као у голубице  
\q2 између витица твојих;  
\q1 коса ти је као стадо коза  
\q2 које се виде на гори Галаду;   
\q1
\v 2 Зуби су ти као стадо оваца једнаких,  
\q2 кад излазе из купала,  
\q2 које се све близне, а ниједне нема јалове.   
\q1
\v 3 Усне су ти као конац скерлета,  
\q2 а говор ти је љубак;  
\q1 као кришка шипка јагодице су твоје  
\q2 између витица твојих;   
\q1
\v 4 Врат ти је као кула Давидова  
\q2 сазидана за оружје,  
\q1 где висе хиљадама штитови  
\q2 и свакојако оружје јуначко;   
\q1
\v 5 Две су ти дојке као два ланета близанца,  
\q2 који пасу међу љиљанима.   
\q1
\v 6 Док дан захлади и сенке отиду,  
\q2 ићи ћу ка гори смирновој и ка хуму тамјановом.   
\q1
\v 7 Сва си лепа драга моја,  
\q2 и нема недостатака на теби.   
\q1
\v 8 Ходи са мном с Ливана, невесто,  
\q2 ходи са мном с Ливана,  
\q1 да гледаш с врха аманског,  
\q2 с врха сенирског и ермонског,  
\q2 из пећина лавовских, с гора рисовских.   
\b  
\q1
\v 9 Отела си ми срце, сестро моја невесто,  
\q2 отела си ми срце једним оком својим  
\q2 и једним ланчићем с грла свог.   
\q1
\v 10 Лепа ли је љубав твоја, сестро моја невесто,  
\q2 боља је од вина љубав твоја,  
\q2 и мирис уља твојих од свих мирисних ствари.   
\q1
\v 11 С усана твојих капље саће, невесто,  
\q2 под језиком ти је мед и млеко,  
\q2 и мирис је хаљина твојих као мирис ливански.   
\q1
\v 12 Ти си као врт затворен, сестро моја невесто,  
\q2 извор затворен, студенац запечаћен.   
\q1
\v 13 Биље је твоје воћњак од шипака  
\q2 с воћем красним,  
\q2 од кипра и нарда.   
\q1
\v 14 Од нарда и шафрана,  
\q2 од иђирота и цимета  
\q1 са свакојаким дрвљем за кад,  
\q2 од смирне и алоја  
\q2 и са сваким прекрасним мирисима.   
\q1
\v 15 Изворе вртовима,  
\q2 студенче воде живе  
\q2 и која тече с Ливана!   
\b  
\q1
\v 16 Устани севере, и ходи јуже,  
\q2 и дуни по врту мом да капљу мириси његови;  
\b  
\q1 нека дође драги мој у врт свој,  
\q2 и једе красно воће своје.   
\c 5  
\s1 Пријатељица слуша глас пријатељев, тугује због растанка с њим и слави његову лепоту.  
\q1
\v 1 Дођох у врт свој, сестро моја невесто,  
\q2 берем смирну своју и мирисе своје,  
\q1 једем саће своје и мед свој,  
\q2 пијем вино своје и млеко своје;  
\b  
\q1 једите, пријатељи, пијте,  
\q2 и опијте се, мили моји!   
\b  
\q1
\v 2 Ја спавам, а срце је моје будно;  
\q1 ето гласа драгог мог,  
\q2 који куца: Отвори ми, сестро моја,  
\q2 драга моја, голубице моја, безазлена моја;  
\q1 јер је глава моја пуна росе  
\q2 и коса моја ноћних капи.   
\q1
\v 3 Свукла сам хаљину своју,  
\q2 како ћу је обући?  
\q1 Опрала сам ноге своје,  
\q2 како ћу их каљати?   
\q1
\v 4 Драги мој промоли руку своју кроз рупу,  
\q2 а шта је у мени устрепта од њега.   
\q1
\v 5 Ја устах да отворим драгом свом,  
\q2 а с руку мојих прокапа смирна,  
\q2 и низ прсте моје потече смирна на држак од браве.   
\q1
\v 6 Отворих драгом свом,  
\q2 али драгог мог не беше, отиде.  
\q1 Бејах изван себе кад он проговори.  
\q1 Тражих га, али га не нађох;  
\q2 виках га, али ми се не одазва.   
\q1
\v 7 Нађоше ме стражари, који обилазе по граду,  
\q2 бише ме, ранише ме,  
\q2 узеше превес мој с мене стражари по зидовима.   
\q1
\v 8 Заклињем вас, кћери јерусалимске,  
\q2 ако нађете драгог мог, шта ћете му казати?  
\q2 Да сам болна од љубави.   
\b  
\q1
\v 9 Шта је твој драги бољи од других драгих,  
\q2 о најлепша међу женама?  
\q1 Шта је твој драги бољи од других драгих,  
\q2 те нас тако заклињеш?   
\b  
\q1
\v 10 Драги је мој бео и румен,  
\q2 заставник између десет хиљада;   
\q1
\v 11 Глава му је најбоље злато,  
\q2 коса му је кудрава,  
\q2 црна као гавран;   
\q1
\v 12 Очи су му као у голуба на потоцима воденим,  
\q2 млеком умивене, и стоје у обиљу;   
\q1
\v 13 Образи су му као лехе мирисног биља,  
\q2 као цвеће мирисно;  
\q1 усне су му као љиљан,  
\q2 с њих капље смирна житка;   
\q1
\v 14 На рукама су му златни прстени,  
\q2 на којима су уковани вирили;  
\q1 трбух му је као светла слонова кост  
\q2 обложена сафирима.   
\q1
\v 15 Гњати су му као ступови од мрамора,  
\q2 углављени на златном подножју;  
\q1 стас му је Ливан,  
\q2 красан као кедри.   
\q1
\v 16 Уста су му слатка и сав је љубак.  
\q1 Такав је мој драги, такав је мој мили,  
\q2 кћери јерусалимске.   
\b  
\q1
\v 17 Куда отиде драги твој,  
\q2 најлепша међу женама?  
\q1 Куда замаче драги твој,  
\q2 да га тражимо с тобом?   
\c 6  
\s1 Радовање повратку пријатељичину.  
\q1
\v 1 Драги мој сиђе у врт свој,  
\q2 к лехама мирисног биља,  
\q1 да пасе по вртовима  
\q2 и да бере љиљане.   
\q1
\v 2 Ја сам драгог свог,  
\q2 и мој је драги мој,  
\q2 који пасе међу љиљанима.   
\b  
\q1
\v 3 Лепа си, драга моја, као Терса,  
\q2 красна си као Јерусалим,  
\q2 страшна као војска са заставама.   
\q1
\v 4 Одврати очи своје од мене,  
\q2 јер ме распаљују.  
\q1 Коса ти је као стадо коза  
\q2 које се виде на Галаду.   
\q1
\v 5 Зуби су ти као стадо оваца кад излазе из купала,  
\q2 које се све близне, а ниједне нема јалове.   
\q1
\v 6 Јагодице су твоје између витица твојих  
\q2 као кришка шипка.   
\q1
\v 7 Шездесет има царица  
\q2 и осамдесет иноча,  
\q2 и девојака без броја;   
\q1
\v 8 Али је једна голубица моја,  
\q2 безазлена моја, јединица у матере своје,  
\q2 изабрана у родитељке своје.  
\q1 Видеше је девојке и назваше је блаженом;  
\q2 и царице и иноче хвалише је.   
\b  
\q1
\v 9 Ко је она што се види као зора,  
\q2 лепа као месец, чиста као сунце,  
\q2 страшна као војска са заставама?   
\b  
\q1
\v 10 Сиђох у орашје  
\q2 да видим воће у долу,  
\q1 да видим цвате ли винова лоза,  
\q2 пупе ли шипци.   
\q1
\v 11 Не дознах ништа,  
\q2 а душа ме моја посади на кола Аминадавова.   
\b  
\q1
\v 12 Врати се, врати се Суламко,  
\q2 врати се, врати се, да те гледамо.  
\b  
\q1 Шта ћете гледати на Суламци?  
\q2 Као чете војничке.   
\c 7  
\s1 Разговор између пријатеља и пријатељице.  
\q1
\v 1 Како су лепе ноге твоје у обући,  
\q2 кћери кнежевска;  
\q1 саставци су бедара твојих као гривне,  
\q2 дело руку уметничких.   
\q1
\v 2 Пупак ти је као чаша округла,  
\q2 који није никад без пића;  
\q1 трбух ти је као стог пшенице  
\q2 ограђен љиљанима;   
\q1
\v 3 Две дојке твоје  
\q2 као два близанца срнчета;   
\q1
\v 4 Врат ти је као кула од слонове кости;  
\q1 очи су ти као језера у Есевону  
\q2 на вратима ватравимским;  
\q1 нос ти је као кула ливанска  
\q2 која гледа према Дамаску;   
\q1
\v 5 Глава је твоја на теби као Кармил,  
\q2 и коса на глави твојој као царска порфира  
\q2 у боре набрана.   
\b  
\q1
\v 6 Како си лепа и како си љупка,  
\q2 о љубави у милинама!   
\q1
\v 7 Узраст ти је као палма,  
\q2 и дојке као гроздови.   
\q1
\v 8 Рекох: Попећу се на палму,  
\q2 дохватићу гране њене;  
\q1 и биће дојке твоје као гроздови на виновој лози,  
\q2 и мирис носа твог као јабуке;   
\q1
\v 9 И грло твоје као добро вино,  
\q2 које иде право драгом мом  
\q2 и чини да говоре усне оних који спавају.   
\b  
\q1
\v 10 Ја сам драгог свог,  
\q2 и њега је жеља за мном.   
\b  
\q1
\v 11 Ходи, драги мој, да идемо у поље,  
\q2 да ноћујемо у селима.   
\q1
\v 12 Ранићемо у винограде  
\q2 да видимо цвате ли винова лоза,  
\q1 замеће ли се грожђе,  
\q2 цвату ли шипци;  
\q1 онде ћу ти дати љубав своју.   
\q1
\v 13 Мандрагоре пуштају мирис,  
\q2 и на вратима је нашим свакојако красно воће,  
\q1 ново и старо,  
\q2 које за те дохраних, драги мој.   
\c 8  
\s1 Верност вечно сједињених.  
\q1
\v 1 О да би ми брат био,  
\q2 да би сао сисе матере моје!  
\q1 Нашавши те на пољу  
\q2 пољубила бих те,  
\q2 и не бих била прекорна.   
\q1
\v 2 Повела бих те  
\q2 и довела бих те у кућу матере своје;  
\q1 ти би ме учио,  
\q2 а ја бих те појила вином мирисавим,  
\q2 соком од шипака.   
\q1
\v 3 Лева је рука његова мени под главом,  
\q2 а десном ме грли.   
\q1
\v 4 Заклињем вас, кћери јерусалимске,  
\q2 не будите љубави моје,  
\q2 не будите је, докле јој не буде воља.   
\b  
\q1
\v 5 Ко је она што иде горе од пустиње  
\q2 наслањајући се на драгог свог?  
\b  
\q1 Под јабуком пробудих те,  
\q2 где те роди мати твоја,  
\q2 где те роди родитељка твоја.   
\b  
\q1
\v 6 Метни ме као печат на срце своје,  
\q2 као печат на мишицу своју.  
\q1 Јер је љубав јака као смрт,  
\q2 и љубавна сумња тврда као гроб;  
\q2 жар је њен као жар огњен, пламен Божји.   
\q1
\v 7 Многа вода не може угасити љубави,  
\q2 нити је реке потопити.  
\q1 Да ко даје све имање дома свог за ту љубав,  
\q2 осрамотио би се.   
\b  
\q1
\v 8 Имамо сестру малену, која још нема дојака.  
\q1 Шта ћемо чинити са сестром својом  
\q2 кад буде реч о њој?   
\q1
\v 9 Ако је зид, заградићемо на њему двор од сребра;  
\q2 ако ли врата, утврдићемо их даскама кедровим.   
\b  
\q1
\v 10 Ја сам зид и дојке су моје као куле.  
\q1 Тада постах у очима његовим као она која нађе мир.   
\b  
\q1
\v 11 Виноград имаше Соломун у Валамону;  
\q2 даде виноград чуварима  
\q1 да сваки доноси за род његов  
\q2 по хиљаду сребрника.   
\q1
\v 12 Мој виноград који ја имам, преда мном је.  
\q1 Нека теби, Соломуне, хиљада,  
\q2 и две стотине онима који чувају род његов.   
\b  
\q1
\v 13 Која наставаш у вртовима!  
\q1 Другови слушају глас твој,  
\q2 дај ми да га чујем.   
\b  
\q1
\v 14 Брже, драги мој!  
\q2 И буди као срна или као јеленче  
\q2 на горама мирисним.   