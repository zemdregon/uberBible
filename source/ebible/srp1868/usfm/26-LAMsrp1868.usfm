\id LAM  
\h Плач Јеремијин 
\toc1 Плач Јеремијин 
\toc2 Плач Јеремијин 
\toc3 Плач 
\mt1 Плач Јеремијин  
\c 1  
\s1 Јерусалим опустошен и осрамоћен тужи и моли за помоћ.  
\q1
\v 1 Како седи сам, поста као удовица,  
\q2 град који беше пун народа!  
\q1 Велик међу народима,  
\q2 глава међу земљама потпаде под данак!   
\b  
\q1
\v 2 Једнако плаче ноћу, и сузе су му на образима,  
\q2 нема никога од свих који га љубљаху да га потеши;  
\q1 сви га пријатељи његови изневерише,  
\q2 посташе му непријатељи.   
\b  
\q1
\v 3 Исели се Јуда од муке и љутог ропства;  
\q2 седи међу народима,  
\q1 не налази мир;  
\q2 сви који га гонише стигоше га у теснацу.   
\b  
\q1
\v 4 Путеви сионски туже,  
\q2 јер нико не иде на празник;  
\q1 сва су врата његова пуста,  
\q2 свештеници његови уздишу,  
\q1 девојке су његове жалосне,  
\q2 и сам је јадан.   
\b  
\q1
\v 5 Противници његови посташе глава,  
\q2 непријатељима је његовим добро;  
\q1 јер га Господ уцвели за мноштво безакоња његовог;  
\q2 деца његова иду у ропство пред непријатељем.   
\b  
\q1
\v 6 И отиде од кћери сионске сва слава њена;  
\q2 кнезови су њени као јелени који не налазе паше;  
\q1 иду немоћни пред оним који их гони.   
\b  
\q1
\v 7 Опомиње се Јерусалим у муци својој и у јаду свом  
\q2 свих милина што је имао од старине,  
\q1 кад пада народ његов од руке непријатељеве,  
\q2 а никога нема да му помогне;  
\q1 непријатељи гледају га  
\q2 и смеју се престанку његовом.   
\b  
\q1
\v 8 Тешко сагреши Јерусалим,  
\q2 зато поста као нечиста жена;  
\q1 сви који су га поштовали презиру га,  
\q2 јер видеше голотињу његову;  
\q1 а он уздише,  
\q2 и окреће се натраг.   
\b  
\q1
\v 9 Нечистота му беше на скутовима;  
\q2 није мислио на крај свој;  
\q1 пао је за чудо,  
\q2 а нема никога да га потеши.  
\q1 Погледај, Господе, муку моју,  
\q2 јер се непријатељ понео.   
\b  
\q1
\v 10 Непријатељ посеже руком на све драге ствари његове,  
\q2 и он гледа како народи улазе у светињу његову,  
\q2 за које си заповедио да не долазе на сабор Твој.   
\b  
\q1
\v 11 Сав народ његов уздише тражећи хлеба,  
\q2 дају драгоцене ствари своје за јело да окрепе душу.  
\q1 Погледај, Господе,  
\q2 и види како сам поништен.   
\b  
\q1
\v 12 Зар вам није стало,  
\q2 сви који пролазите овуда?  
\q1 Погледајте и видите,  
\q2 има ли бола какав је мој,  
\q1 који је мени допао,  
\q2 којим ме уцвели Господ у дан жестоког гнева свог.   
\b  
\q1
\v 13 С висине пусти огањ у кости моје,  
\q2 који их освоји;  
\q1 разапе мрежу ногама мојим,  
\q2 обори ме наузнако,  
\q1 пустоши ме,  
\q2 те по вас дан тужим.   
\b  
\q1
\v 14 Свезан је руком његовом јарам од греха мојих,  
\q2 усукани су и дођоше ми на врат;  
\q1 обори силу моју;  
\q1 предаде ме Господ у руке,  
\q2 из којих се не могу подигнути.   
\b  
\q1
\v 15 Полази Господ све јунаке моје усред мене,  
\q2 сазва на ме сабор да потре младиће моје;  
\q1 као грожђе у каци изгази Господ девојку,  
\q2 кћер Јудину.   
\b  
\q1
\v 16 Зато ја плачем, очи моје,  
\q2 очи моје лију сузе,  
\q1 јер је далеко од мене утешитељ,  
\q2 који би укрепио душу моју;  
\q1 синови моји пропадоше,  
\q2 јер надвлада непријатељ.   
\b  
\q1
\v 17 Сион шири руке своје,  
\q2 нема никога да га теши;  
\q1 Господ заповеди за Јакова,  
\q2 те га опколише непријатељи;  
\q1 Јерусалим поста међу њима као нечиста жена.   
\b  
\q1
\v 18 Праведан је Господ,  
\q2 јер се супротих заповести Његовој;  
\q1 чујте, сви народи,  
\q2 и видите бол мој;  
\q1 девојке моје и младићи моји отидоше у ропство.   
\b  
\q1
\v 19 Звах пријатеље своје,  
\q2 они ме преварише;  
\q1 свештеници моји и старешине моје помреше у граду  
\q2 тражећи хране да окрепе душу своју.   
\b  
\q1
\v 20 Погледај, Господе, јер ми је туга,  
\q2 утроба ми се усколебала,  
\q1 срце се моје преврће у мени,  
\q2 јер се много супротих;  
\q1 напољу учини ме сиротим мач,  
\q2 а код куће сама смрт.   
\b  
\q1
\v 21 Чују где уздишем,  
\q2 али нема никога да ме потеши;  
\q1 сви непријатељи моји чуше за несрећу моју  
\q2 и радују се што си то учинио;  
\q1 довешћеш дан који си огласио,  
\q2 те ће они бити као ја.   
\b  
\q1
\v 22 Нека изађе преда те сва злоћа њихова,  
\q2 и учини као што си учинио мени за све грехе моје;  
\q1 јер је много уздаха мојих  
\q2 и срце је моје жалосно.   
\c 2  
\s1 Тужњава због пропасти Јуде и Јерусалима.  
\q1
\v 1 Како обастре Господ облаком у гневу свом кћер сионску!  
\q2 Сврже с неба на земљу славу Израиљеву,  
\q1 и не опомену се подножја ногу својих у дан гнева свог!   
\b  
\q1
\v 2 Господ потре немилице све станове Јаковљеве,  
\q2 развали у гневу свом градове кћери Јудине,  
\q1 и на земљу обори,  
\q2 оскврни царство и кнезове његове.   
\b  
\q1
\v 3 Одби у жестоком гневу сав рог Израиљу,  
\q2 обрати натраг десницу своју од непријатеља,  
\q1 и распали се на Јакова као огањ пламени,  
\q2 који прождире све око себе.   
\b  
\q1
\v 4 Натеже лук свој као непријатељ,  
\q2 подиже десницу своју као противник,  
\q1 и поби све што беше драго очима;  
\q2 на шатор кћери сионске просу као огањ гнев свој.   
\b  
\q1
\v 5 Господ поста као непријатељ;  
\q2 потре Израиља, потре све дворе његове,  
\q1 раскопа све градове његове,  
\q2 и умножи кћери Јудиној жалост и јад.   
\b  
\q1
\v 6 Развали му ограду као врту;  
\q2 потре место састанцима његовим;  
\q1 Господ врже у заборав на Сиону празнике и суботу,  
\q2 и у жестини гнева свог одбаци цара и свештеника.   
\b  
\q1
\v 7 Одбаци Господ олтар свој,  
\q2 омрзе на светињу своју,  
\q1 предаде у руке непријатељима зидове двора сионских;  
\q2 стаде их вика у дому Господњем као на празник.   
\b  
\q1
\v 8 Господ науми да раскопа зид кћери сионске,  
\q2 растеже уже,  
\q1 и не одврати руке своје да не затре,  
\q2 и ојади опкоп и зид, изнемогоше скупа.   
\b  
\q1
\v 9 Утонуше у земљу врата њена,  
\q2 поломи и потре преворнице њене;  
\q1 цар њен и кнезови њени међу народима су;  
\q2 закона нема, и пророци њени не добијају утваре од Господа.   
\b  
\q1
\v 10 Старешине кћери сионске седе на земљи и ћуте,  
\q2 посуле су прахом главу и припасале кострет;  
\q1 обориле су к земљи главе своје девојке јерусалимске.   
\b  
\q1
\v 11 Ишчилеше ми очи од суза,  
\q2 утроба се моја усколебала,  
\q1 просипа се на земљу јетра моја од погибли кћери народа мог,  
\q2 јер деца и која сисају обамиру на улицама градским.   
\b  
\q1
\v 12 Говоре матерама својим:  
\q2 Где је жито и вино?  
\q1 Обамиру као рањеници на улицама градским,  
\q2 и испуштају душу своју у наручју матера својих.   
\b  
\q1
\v 13 Кога ћу ти узети за сведока?  
\q2 С чим ћу те изједначити, кћери јерусалимска?  
\q1 Какву ћу ти прилику наћи, да те утешим,  
\q2 девојко, кћери сионска?  
\q1 Јер је несрећа твоја велика као море,  
\q2 ко ће те исцелити?   
\b  
\q1
\v 14 Пророци твоји пророковаше ти лаж и безумље,  
\q2 и не откриваше безакоња твог  
\q2 да би одвратили ропство твоје;  
\q1 него ти казиваше утваре лажне  
\q2 и које ће те прогнати.   
\b  
\q1
\v 15 Пљескају рукама над тобом сви који пролазе,  
\q2 звижде и машу главом за кћерју јерусалимском:  
\q1 То ли је град, за који говораху да је права лепота,  
\q2 радост свој земљи?   
\b  
\q1
\v 16 Разваљују уста на те сви непријатељи твоји,  
\q2 звижде и шкргућу зубима говорећи:  
\q1 Прождресмо; ово је доиста дан који чекасмо;  
\q2 дочекасмо, видесмо.   
\b  
\q1
\v 17 Учини Господ шта науми,  
\q2 испуни реч своју, коју каза одавна;  
\q1 разори немилице и развесели тобом непријатеља,  
\q2 подиже рог противницима твојим.   
\b  
\q1
\v 18 Виче срце њихово ка Господу:  
\q1 Зиде кћери сионске,  
\q2 проливај потоком сузе дан и ноћ,  
\q1 не дај себи мира,  
\q2 и зеница ока твог да не стаје.   
\b  
\q1
\v 19 Устани, вичи обноћ, у почетку страже,  
\q2 проливај срце своје као воду пред Господом,  
\q1 подижи к Њему руке своје за душу деце своје  
\q2 која обамиру од глади на угловима својих улица.   
\b  
\q1
\v 20 Погледај, Господе, и види,  
\q2 коме си овако учинио.  
\q1 Еда ли жене једу пород свој,  
\q2 децу коју носе у наручју?  
\q1 Еда ли се убија у светињи Господњој свештеник и пророк?   
\b  
\q1
\v 21 Леже на земљи по улицама деца и старци,  
\q2 девојке моје и младићи моји падоше од мача,  
\q1 побио си их у дан гнева свог  
\q2 и поклао не жалећи.   
\b  
\q1
\v 22 Сазвао си као на празник страхоте моје од свуда,  
\q2 и у дан гнева Господњег нико не утече нити оста.  
\q1 Које на руку носих и отхраних,  
\q2 њих ми непријатељ мој поби.   
\c 3  
\s1 Јеремијин плач и утеха.  
\q1
\v 1 Ја сам човек који видех муку  
\q2 од прута гнева Његовог.   
\q1
\v 2 Одведе ме и оправи ме у таму,  
\q2 а не на видело.   
\q1
\v 3 Само се на ме обраћа,  
\q2 обраћа руку своју по вас дан.   
\b  
\q1
\v 4 Учини, те ми остаре тело и кожа,  
\q2 потре кости моје.   
\q1
\v 5 Зазида ме,  
\q2 и опточи ме жучју и муком.   
\q1
\v 6 Посади ме у таму  
\q2 као умрле одавна.   
\b  
\q1
\v 7 Огради ме да не изађем,  
\q2 и метну на ме тешке окове.   
\q1
\v 8 Кад вичем и вапим,  
\q2 одбија молитву моју.   
\q1
\v 9 Загради путеве моје тесаним каменом,  
\q2 и преврати стазе моје.   
\b  
\q1
\v 10 Поста ми као медвед у заседи,  
\q2 као лав у потаји.   
\q1
\v 11 Помете путеве моје,  
\q2 и раздре ме, и уништи ме.   
\q1
\v 12 Натеже лук свој,  
\q2 и метну ме стрели за белегу.   
\b  
\q1
\v 13 Устрели ме у бубреге  
\q2 стрелама из тула свог.   
\q1
\v 14 Постах подсмех свему народу свом  
\q2 и песма њихова по вас дан.   
\q1
\v 15 Насити ме горчином,  
\q2 опоји ме пеленом.   
\b  
\q1
\v 16 Поломи ми зубе камењем,  
\q2 ували ме у пепео.   
\q1
\v 17 Удаљио си душу моју од мира,  
\q2 заборавих добро.   
\q1
\v 18 И рекох:  
\q2 Пропаде сила моја и надање моје од Господа.   
\b  
\q1
\v 19 Опомени се муке моје и јада мог,  
\q2 пелена и жучи.   
\q1
\v 20 Душа се моја опомиње без престанка,  
\q2 и поништила се у мени.   
\q1
\v 21 Али ово напомињем срцу свом,  
\q2 те се надам:   
\b  
\q1
\v 22 Милост је Господња што не изгибосмо сасвим,  
\q2 јер милосрђа Његовог није нестало.   
\q1
\v 23 Понавља се свако јутро;  
\q2 велика је вера твоја.   
\q1
\v 24 Господ је део мој, говори душа моја;  
\q2 зато ћу се у Њега уздати.   
\b  
\q1
\v 25 Добар је Господ онима који га чекају,  
\q2 души, која га тражи.   
\q1
\v 26 Добро је мирно чекати спасење Господње.   
\q1
\v 27 Добро је човеку носити јарам за младости своје.   
\b  
\q1
\v 28 Сам ће седети и ћутати,  
\q2 јер Бог метну бреме на њ.   
\q1
\v 29 Метнуће уста своја у прах,  
\q2 еда би било надања.   
\q1
\v 30 Подметнуће образ свој ономе који га бије,  
\q2 биће сит срамоте.   
\b  
\q1
\v 31 Јер Господ не одбацује за свагда.   
\q1
\v 32 Јер ако и уцвели, опет ће се и смиловати  
\q2 ради мноштва милости своје.   
\q1
\v 33 Јер не мучи из срца свог  
\q2 ни цвели синове човечје.   
\b  
\q1
\v 34 Кад газе ногама све сужње на земљи,   
\q1
\v 35 Кад изврћу правицу човеку пред Вишњим,   
\q1
\v 36 Кад чине криво човеку у парници његовој,  
\q2 не види ли Господ?   
\b  
\q1
\v 37 Ко је рекао што и збило се,  
\q2 а Господ да није заповедио?   
\q1
\v 38 Не долазе ли и зла и добра из уста Вишњег?   
\q1
\v 39 Зашто се тужи човек жив,  
\q2 човек на кар за грехе своје?   
\b  
\q1
\v 40 Претражимо и разгледајмо путе своје,  
\q2 и повратимо се ка Господу.   
\q1
\v 41 Подигнимо срце своје и руке к Богу на небесима.   
\q1
\v 42 Згрешисмо и непокорни бисмо;  
\q2 Ти не прашташ.   
\b  
\q1
\v 43 Обастро си се гневом, и гониш нас,  
\q2 убијаш и не жалиш.   
\q1
\v 44 Обастро си си се облаком  
\q2 да не продре молитва.   
\q1
\v 45 Начинио си од нас сметлиште  
\q2 и одмет усред тих народа.   
\b  
\q1
\v 46 Разваљују уста своја на нас  
\q2 сви непријатељи наши.   
\q1
\v 47 Страх и јама задеси нас,  
\q2 пустошење и затирање.   
\q1
\v 48 Потоци теку из очију мојих  
\q2 ради погибли кћери народа мог.   
\b  
\q1
\v 49 Очи моје лију сузе без престанка,  
\q2 јер нема одмора,   
\q1
\v 50 Докле Господ не погледа  
\q2 и не види с неба.   
\q1
\v 51 Око моје мучи ми душу  
\q2 ради свих кћери града мог.   
\b  
\q1
\v 52 Терају ме једнако као птицу непријатељи моји низашта.   
\q1
\v 53 Свалише у јаму живот мој  
\q2 и набацаше камење на ме.   
\q1
\v 54 Дође ми вода сврх главе;  
\q2 рекох: Погибох!   
\b  
\q1
\v 55 Призивах име Твоје, Господе,  
\q2 из јаме најдубље.   
\q1
\v 56 Ти чу глас мој;  
\q2 не затискуј уха свог од уздисања мог, од вике моје.   
\q1
\v 57 Приступао си кад Те призивах,  
\q2 и говорио си: Не бој се.   
\b  
\q1
\v 58 Расправљао си, Господе, парбу душе моје,  
\q2 и избављао си живот мој.   
\q1
\v 59 Видиш, Господе, неправду која ми се чини;  
\q2 расправи парбу моју.   
\q1
\v 60 Видиш сву освету њихову,  
\q2 све што ми мисле.   
\b  
\q1
\v 61 Чујеш руг њихов, Господе,  
\q2 све што ми мисле,   
\q1
\v 62 Шта говоре они који устају на ме  
\q2 и шта намишљају против мене по вас дан.   
\q1
\v 63 Види, кад седају и кад устају,  
\q2 ја сам им песма.   
\b  
\q1
\v 64 Плати им, Господе,  
\q2 по делима руку њихових.   
\q1
\v 65 Подај им упорно срце,  
\q2 проклетство своје.   
\q1
\v 66 Гони их гневом,  
\q2 и истреби их испод небеса Господњих.   
\c 4  
\s1 Беда и срамота Јудина.  
\q1
\v 1 Како потамне злато,  
\q2 промени се чисто злато?  
\q1 Камење је од светиње разметнуто по угловима свих улица.   
\b  
\q1
\v 2 Драги синови сионски,  
\q2 цењени као најчистије злато,  
\q1 како се цене земљани судови,  
\q2 као дело руку лончаревих!   
\b  
\q1
\v 3 И звери истичу сисе своје и доје млад своју,  
\q2 а кћи народа мог поста немилостива као ној у пустињи.   
\b  
\q1
\v 4 Језик детету које сиса приону за грло од жеђи;  
\q2 деца ишту хлеба, а нема никога да им ломи.   
\b  
\q1
\v 5 Који јеђаху посластице,  
\q2 гину на улицама;  
\q1 који одрастоше у скерлету,  
\q2 ваљају се по буњишту.   
\b  
\q1
\v 6 И кар који допаде кћери народа мог већи је од пропасти која допаде Содому,  
\q2 који се затре у часу  
\q2 и руке се не забавише око њега.   
\b  
\q1
\v 7 Назиреји њени беху чистији од снега,  
\q2 бељи од млека;  
\q1 тело им беше црвеније од драгог камења,  
\q2 глатки као сафир.   
\b  
\q1
\v 8 А сада им је лице црње од угља,  
\q2 не познају се на улицама;  
\q1 кожа им се прилепила за кости,  
\q2 осушила се као дрво.   
\b  
\q1
\v 9 Боље би онима који су побијени мачем него онима који мру од глади,  
\q2 који издишу убијени од несташице рода земаљског.   
\b  
\q1
\v 10 Својим рукама жене жалостиве куваше децу своју,  
\q2 она им бише храна у погибли кћери народа мог.   
\b  
\q1
\v 11 Наврши Господ гнев свој,  
\q2 изли жестоки гнев свој,  
\q1 и распали огањ на Сиону,  
\q2 који му прождре темеље.   
\b  
\q1
\v 12 Не би веровали цареви земаљски и сви становници по васиљеној  
\q2 да ће непријатељ и противник ући на врата јерусалимска.   
\b  
\q1
\v 13 Али би за грехе пророка његових и за безакоња свештеника његових,  
\q2 који проливаху крв праведничку усред њега.   
\b  
\q1
\v 14 Лутаху као слепци по улицама,  
\q2 каљаху се крвљу,  
\q2 које не могаху да се не дотичу хаљинама својим.   
\b  
\q1
\v 15 Одступите, нечисти, вичу им,  
\q2 одступите, одступите, не додевајте се ничега.  
\q1 И одлазе и скитају се;  
\q2 и међу народима се говори: Неће се више станити.   
\b  
\q1
\v 16 Гнев Господњи расеја их,  
\q2 неће више погледати на њих;  
\q1 не поштују свештеника,  
\q2 нису жалостиви на старце.   
\b  
\q1
\v 17 Већ нам очи ишчилеше изгледајући помоћ залудну;  
\q2 чекасмо народ који не може избавити.   
\b  
\q1
\v 18 Вребају нам кораке,  
\q2 да не можемо ходити по улицама својим,  
\q1 приближи се крај наш,  
\q2 навршише се дани наши, дође крај наш.   
\b  
\q1
\v 19 Који нас гонише,  
\q2 беху лакши од орлова небеских,  
\q1 по горама нас гонише,  
\q2 у пустињи нам заседаше.   
\b  
\q1
\v 20 Дисање ноздрва наших, помазаник Господњи,  
\q2 за ког говорасмо да ћемо живети под сеном његовим међу народима,  
\q2 ухвати се у јаме њихове.   
\b  
\q1
\v 21 Радуј се и весели се, кћери едомска,  
\q2 која живиш у земљи Узу!  
\q1 Доћи ће до тебе чаша, опићеш се,  
\q2 и открићеш се.   
\b  
\q1
\v 22 Сврши се кар за безакоње твоје, кћери сионска;  
\q2 неће те више водити у ропство;  
\q1 походиће твоје безакоње, кћери едомска,  
\q2 откриће грехе твоје.   
\c 5  
\s1 Молитве угњетеног народа за милост и помоћ.  
\q1
\v 1 Опомени се, Господе, шта нас задеси;  
\q2 погледај и види срамоту нашу.   
\q1
\v 2 Наследство наше привали се туђинцима,  
\q2 домови наши иностранцима.   
\q1
\v 3 Постасмо сироте, без оца,  
\q2 матере наше као удовице.   
\q1
\v 4 Своју воду пијемо за новце,  
\q2 своја дрва купујемо.   
\q1
\v 5 На врату нам је јарам, и гоне нас;  
\q2 уморени немамо одмора.   
\q1
\v 6 Пружамо руку к Мисирцима и Асирцима,  
\q2 да се наситимо хлеба.   
\q1
\v 7 Оци наши згрешише, и нема их,  
\q2 а ми носимо безакоња њихова.   
\q1
\v 8 Робови нам господаре,  
\q2 нема никога да избави из руку њихових.   
\q1
\v 9 Са страхом за живот свој од мача  
\q2 у пустињи доносимо себи хлеб.   
\q1
\v 10 Кожа нам поцрне као пећ од љуте глади.   
\q1
\v 11 Срамоте жене на Сиону  
\q2 и девојке по градовима Јудиним.   
\q1
\v 12 Кнезове вешају својим рукама,  
\q2 не поштују лице старачко.   
\q1
\v 13 Младиће узимају под жрвње,  
\q2 и деца падају под дрвима.   
\q1
\v 14 Стараца нема више на вратима,  
\q2 ни младића на певању.   
\q1
\v 15 Неста радости срцу нашем,  
\q2 игра наша претвори се у жалост.   
\q1
\v 16 Паде венац с главе наше;  
\q2 тешко нама, што згрешисмо!   
\q1
\v 17 Стога је срце наше жалосно,  
\q2 стога очи наше потамнеше,   
\q1
\v 18 Са горе Сиона, што опусте,  
\q2 и лисице иду по њој.   
\q1
\v 19 Ти, Господе, остајеш довека,  
\q2 престо Твој од колена до колена.   
\q1
\v 20 Зашто хоћеш да нас заборавиш довека,  
\q2 да нас оставиш задуго?   
\q1
\v 21 Обрати нас, Господе, к себи, и обратићемо се;  
\q2 понови дане наше како беху пре.   
\q1
\v 22 Јер еда ли ћеш нас сасвим одбацити  
\q2 и гневити се на нас веома?   