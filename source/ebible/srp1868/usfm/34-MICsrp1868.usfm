\id MIC  
\h Књига пророка Михеја 
\toc1 Књига пророка Михеја 
\toc2 Михеј 
\toc3 Мих 
\mt1 Књига пророка Михеја  
\c 1  
\s1 Опустошење Јуде и Израиља због идолопоклонства.  
\p
\v 1 Реч Господња која дође Михеју Моресећанину за времена Јоатама, Ахаза и Језекије, царева Јудиних, што виде за Самарију и за Јерусалим.   
\b  
\q1
\v 2 Чујте, сви народи,  
\q2 слушај, земљо и шта је на њој,  
\q1 и Господ Бог да вам је сведок,  
\q2 Господ из свете цркве своје.   
\q1
\v 3 Јер, гле, Господ излази из места свог,  
\q2 и сићи ће, и ходиће по висинама земаљским.   
\q1
\v 4 И горе ће се растопити пред Њим,  
\q2 и долине ће се расести,  
\q1 као восак од огња  
\q2 и као вода што тече низ стрмен.   
\q1
\v 5 Све је то за злочинство Јаковљево  
\q2 и за грехе дома Израиљевог.  
\q1 Које је злочинство Јаковљево?  
\q2 Није ли Самарија?  
\q1 Које су висине Јудине?  
\q2 Није ли Јерусалим?   
\q1
\v 6 Зато ћу учинити од Самарије гомилу у пољу  
\q2 да се саде виногради,  
\q1 и побацаћу камење њено у долину  
\q2 и открићу јој темеље.   
\q1
\v 7 И сви резани ликови њени разбиће се,  
\q2 и сви ће се дарови њени сажећи огњем,  
\q2 и све ћу идоле њене потрти,  
\q1 јер од плате курварске накупи,  
\q2 и опет ће бити плата курварска.   
\b  
\q1
\v 8 Зато ћу плакати и ридати;  
\q2 ходићу свучен и го,  
\q1 плакаћу као змајеви  
\q2 и тужићу као сове.   
\q1
\v 9 Јер јој се ране не могу исцелити,  
\q2 дођоше до Јуде,  
\q1 допреше до врата мог народа,  
\q2 до Јерусалима.   
\b  
\q1
\v 10 Не јављајте у Гату, не плачите;  
\q2 у Вит-Афри ваљај се по праху.   
\q1
\v 11 Изађи, становнице сафирска, с голом срамотом;  
\q2 становница сананска неће изаћи;  
\q2 жалост вет-езилска неће вам дати станка.   
\q1
\v 12 Јер становница маротска тужи за својим добром.  
\q2 Јер сиђе зло од Господа до врата јерусалимских.   
\q1
\v 13 Упрегни брзе коње у кола, становнице лахиска,  
\q2 која си почетак греху кћери сионској,  
\q2 јер се у теби нађоше злочинства Израиљева.   
\q1
\v 14 Зато пошаљи дарове Моресету гатском;  
\q2 домови ахсивски превариће цареве Израиљеве.   
\q1
\v 15 Још ћу ти довести наследника, становнице мариска;  
\q2 доћи ће до Одолама, славе Израиљеве.   
\q1
\v 16 Начини се ћелава и острижи се за милом децом својом;  
\q2 рашири ћелу своју као орао,  
\q2 јер се воде од тебе у ропство.   
\c 2  
\s1 Бол због безбожника који у лажи налази радост. Обрицање времена милости.  
\q1
\v 1 Тешко онима који смишљају безакоње  
\q2 и о злу се труде на постељама својим,  
\q1 и кад сване извршују,  
\q2 јер им је сила у руци.   
\q1
\v 2 Желе њиве, и отимају их;  
\q2 желе куће, и узимају;  
\q1 чине силу човеку и кући његовој,  
\q2 човеку и наследству његовом.   
\q1
\v 3 Зато овако вели Господ:  
\q1 Ево, ја мислим зло том роду,  
\q2 из ког нећете извући вратове своје,  
\q1 нити ћете ходити поносито,  
\q2 јер ће бити зло време.   
\q1
\v 4 У оно време говориће се прича о вама,  
\q2 и нарицаће се жалосно говорећи:  
\q1 Пропадосмо;  
\q2 промени део народа мог.  
\q1 Како ми узе!  
\q2 Узевши њиве наше раздели.   
\q1
\v 5 Зато нећеш имати никога  
\q2 ко би ти повукао уже за жреб у збору Господњем.   
\b  
\q1
\v 6 Немојте пророковати,  
\q2 нека они пророкују;  
\q1 ако им не пророкују,  
\q2 неће одступити срамота.   
\q1
\v 7 О ти, који се зовеш дом Јаковљев,  
\q2 је ли се умалио Дух Господњи?  
\q1 Јесу ли то дела Његова?  
\q2 Еда ли моје речи нису добре ономе који ходи право?   
\q1
\v 8 А народ се мој пре подиже као непријатељ;  
\q2 преко хаљине скидате плашт с оних који пролазе не бојећи се,  
\q2 који се враћају из боја.   
\q1
\v 9 Жене народа мог изгоните из милих кућа њихових,  
\q2 од деце њихове отимате славу моју навек.   
\q1
\v 10 Устаните и идите,  
\q2 јер ово није почивалиште;  
\q1 што се оскврни,  
\q2 погубиће вас погибљу великом.   
\q1
\v 11 Ако ко ходи за ветром и казује лажи говорећи:  
\q2 Пророковаћу ти за вино и за силовито пиће,  
\q2 тај ће бити пророк овом народу.   
\q1
\v 12 Доиста ћу те сабрати свог, Јакове,  
\q2 доиста ћу скупити остатак Израиљев;  
\q1 поставићу их заједно као овце восорске,  
\q2 као стадо усред тора њиховог,  
\q2 биће врева од људства.   
\q1
\v 13 Пред њима ће ићи који разбија;  
\q2 они ће разбити и проћи кроз врата,  
\q2 и изаћи ће;  
\q1 и цар ће њихов ићи пред њима,  
\q2 и Господ ће бити пред њима.   
\c 3  
\s1 Кажњавање поглавица световних и духовних. Прорицање о разорењу Јерусалима.  
\q1
\v 1 Зато рекох:  
\q2 Чујте, поглавице Јаковљеве  
\q2 и кнезови дома Израиљевог,  
\q1 не треба ли вам знати шта је право?   
\q2
\v 2 Који мрзите на добро, а љубите зло,  
\q1 садирете кожу с њих и месо с кости њихових;   
\q2
\v 3 И једете месо народа мог  
\q1 и садирете кожу с њих и кости им пребијате,  
\q2 и сасецате као у лонац и као месо у котао.   
\b  
\q1
\v 4 Тада ће викати ка Господу,  
\q2 али их неће услишити,  
\q1 него ће сакрити лице своје од њих у оно време,  
\q2 како они зло радише.   
\b  
\q1
\v 5 Овако вели Господ за пророке који заводе мој народ,  
\q2 који гризу зубима својим и вичу: Мир;  
\q2 и ако им ко не да ништа у уста, дижу рат на њ.   
\q1
\v 6 Зато ће вам утвара бити ноћ  
\q2 и прорицање ваше тама;  
\q1 и сунце ће заћи тим пророцима  
\q2 и дан ће им се смрачити.   
\q1
\v 7 Тада ће се постидети видеоци,  
\q2 и врачари ће се посрамити,  
\q1 и сви ће застрти усне своје,  
\q2 јер неће бити одговора Божјег.   
\q1
\v 8 Али ја сам пун силе од Духа Господњег,  
\q2 и суда и храбрости  
\q1 да кажем Јакову злочинство његово  
\q2 и Израиљу грех његов.   
\b  
\q1
\v 9 Чујте ово,  
\q2 поглавице дома Јаковљевог  
\q2 и кнезови дома Израиљевог,  
\q1 који се гадите на правду,  
\q2 и све што је право изврћете;   
\q1
\v 10 Који градите Сион крвљу  
\q2 и Јерусалим безакоњем.   
\q1
\v 11 Поглавари његови суде по миту,  
\q2 и свештеници његови уче за плату,  
\q2 и пророци његови гатају за новце,  
\q1 а на Господа се ослањају говорећи:  
\q2 Није ли Господ усред нас?  
\q2 Неће доћи зло на нас.   
\q1
\v 12 Зато ће се с вас Сион преорати као њива,  
\q2 и Јерусалим ће постати гомила,  
\q2 и гора од дома висока шума.   
\c 4  
\s1 О царству Месијином, повратак и избављење Израиља после велике патње.  
\q1
\v 1 Али ће у последња времена бити утврђена гора дома Господњег наврх гора  
\q2 и узвишена изнад хумова,  
\q2 и народи ће се стицати к њој.   
\q1
\v 2 И ићи ће многи народи говорећи:  
\q1 Ходите, да идемо на гору Господњу  
\q2 и у дом Бога Јаковљевог,  
\q1 и учиће нас својим путевима  
\q2 и ходићемо Његовим стазама;  
\q1 јер ће из Сиона изаћи закон  
\q2 и реч Господња из Јерусалима.   
\q1
\v 3 И судиће међу многим народима,  
\q2 и покараће јаке народе надалеко,  
\q1 и они ће расковати мачеве своје на раонике,  
\q2 и копља своја на српове;  
\q1 неће дизати мача народ на народ,  
\q2 нити ће се више учити рату.   
\q1
\v 4 Него ће седети сваки под својом виновом лозом и под смоквом,  
\q2 и неће бити никога да их плаши;  
\q2 јер уста Господа над војскама рекоше.   
\q1
\v 5 Јер ће сви народи ходити сваки у име бога свог;  
\q2 а ми ћемо ходити у име Господа Бога свог  
\q2 увек и довека.   
\b  
\q1
\v 6 У то време, говори Господ, сабраћу хроме,  
\q2 и скупићу одагнане и којима зло учиних.   
\q1
\v 7 И учинићу од хромих остатак  
\q2 и од одагнаних силан народ;  
\q1 и Господ ће царовати над њима на гори Сиону  
\q2 одсада и довека.   
\b  
\q1
\v 8 И ти, куло стаду, стено кћери сионској,  
\q2 теби ће доћи,  
\q1 доћи ће прва власт,  
\q2 царство кћери јерусалимске.   
\b  
\q1
\v 9 Зашто вичеш тако јако?  
\q2 Нема ли цара у теби?  
\q1 Еда ли изгибоше твоји саветници,  
\q2 те те обузеше болови као породиљу?   
\q1
\v 10 Мучи се и вичи, кћери сионска,  
\q2 као породиља,  
\q1 јер ћеш изаћи из града и становаћеш у пољу,  
\q2 и отићи ћеш у Вавилон;  
\q1 онде ћеш се ослободити,  
\q2 онде ће те искупити Господ из руку непријатеља твојих.   
\b  
\q1
\v 11 А сада се сабраше на те многи народи говорећи:  
\q2 Да се оскврни,  
\q2 и да се очи наше нагледају Сиона.   
\q1
\v 12 Али не знају мисли Господње,  
\q2 нити разумеју намере Његове,  
\q2 јер их је скупио као снопље на гумно.   
\q1
\v 13 Устани и врши, кћери сионска,  
\q2 јер ћу ти начинити рог гвозден,  
\q2 и копита ћу ти начинити бронзана,  
\q1 те ћеш сатрти многе народе,  
\q2 и посветићу Господу благо њихово  
\q2 и имање њихово Господу све земље.   
\c 5  
\s1 О Христовом месту рођења и царству милости. Слава Израиљева и обраћање.  
\q1
\v 1 Сабери се сада у чете, четнице,  
\q2 опседни нас,  
\q2 нека бију прутом по образу судију Израиљевог.   
\q1
\v 2 А ти, Витлејеме Ефрато,  
\q2 ако и јеси најмањи међу хиљадама Јудиним,  
\q2 из тебе ће ми изаћи који ће бити Господар у Израиљу,  
\q1 коме су изласци од почетка,  
\q2 од вечних времена.   
\q1
\v 3 Зато ће их оставити докле не роди она која ће родити;  
\q2 тада ће се остатак браће Његове вратити са синовима Израиљевим.   
\q1
\v 4 И стајаће и пашће их силом Господњом,  
\q2 величанством имена Господа Бога свог;  
\q1 и они ће наставати,  
\q2 јер ће Он тада бити велик до крајева земље.   
\q1
\v 5 И Он ће бити мир;  
\q2 кад дође Асирац у нашу земљу,  
\q2 и кад ступи у дворе наше,  
\q1 тада ћемо подигнути на њ  
\q2 седам пастира и осам кнезова из народа.   
\b  
\q1
\v 6 И они ће опасти земљу асирску мачем  
\q2 и земљу Невродову на вратима његовим;  
\q1 и Он ће нас избавити од Асирца  
\q2 кад дође у нашу земљу  
\q2 и кад ступи на међу нашу.   
\b  
\q1
\v 7 И остатак ће Јаковљев бити усред многих народа  
\q2 као роса од Господа и као ситан дажд по трави,  
\q2 која не чека човека нити се узда у синове човечје.   
\q1
\v 8 И остатак ће Јаковљев бити међу народима,  
\q2 усред многих народа,  
\q1 као лав међу зверима шумским,  
\q2 као лавић међу стадима оваца,  
\q1 који кад иде тлачи и растрже,  
\q2 и нема никога да избави.   
\q1
\v 9 Рука ће ти се узвисити над противницима твојим  
\q2 и сви ће се непријатељи твоји истребити.   
\b  
\q1
\v 10 И у оно ћу време, говори Господ,  
\q2 истребити коње исред тебе и потрћу кола твоја.   
\q1
\v 11 И затрћу градове у твојој земљи,  
\q2 и развалићу сва тврда места твоја;   
\q1
\v 12 И истребићу врачање из руку твојих,  
\q2 и нећеш имати гатаре;   
\q1
\v 13 И истребићу ликове твоје резане  
\q2 и ступове твоје исред тебе,  
\q2 и нећеш се више клањати делу руку својих;   
\q1
\v 14 И искоренићу гајеве твоје исред тебе,  
\q2 и раскопаћу градове твоје,   
\q1
\v 15 И извршићу освету с гневом и љутином  
\q2 на народима који не слушаше.   
\c 6  
\s1 Народна незахвалност. Жртва која се свиди Господу. Жетва зле сетве.  
\q1
\v 1 Слушајте шта говори Господ:  
\q2 Устани, суди се с горама,  
\q2 и нека чују хумови глас твој.   
\q1
\v 2 Слушајте, горе и тврди темељи земаљски,  
\q2 парбу Господњу,  
\q1 јер Господ има парбу с народом својим,  
\q2 и с Израиљем се суди.   
\b  
\q1
\v 3 Народе мој, шта сам ти учинио?  
\q2 И чим сам ти досадио?  
\q2 Одговори ми.   
\q1
\v 4 Јер те изведох из земље мисирске  
\q2 и искупих из куће ропске  
\q2 и послах пред тобом Мојсија, Арона и Марију.   
\q1
\v 5 Народе мој, опомени се шта науми Валак цар моавски  
\q2 и шта му одговори Валам, син Веоров,  
\q1 од Ситима до Галгала шта би,  
\q2 да познаш правду Господњу.   
\b  
\q1
\v 6 Са чим ћу доћи пред Господа  
\q2 да се поклоним Богу Вишњем?  
\q1 Хоћу ли доћи преда Њ са жртвама паљеницама?  
\q2 С теоцима од године?   
\q1
\v 7 Хоће ли Господу бити миле хиљаде овнова?  
\q2 Десетине хиљада потока уља?  
\q1 Хоћу ли дати првенца свог за преступ свој?  
\q2 Плод утробе своје за грех душе своје?   
\q1
\v 8 Показао ти је, човече, шта је добро;  
\q2 и шта Господ иште од тебе  
\q1 осим да чиниш што је право  
\q2 и да љубиш милост  
\q2 и да ходиш смерно с Богом својим?   
\b  
\q1
\v 9 Глас Господњи виче граду,  
\q2 и ко је мудар види име твоје;  
\q1 слушајте прут и Оног који га је одредио.   
\q1
\v 10 Није ли јоште у кући безбожниковој благо неправо?  
\q2 И ефа крња, гадна?   
\q1
\v 11 Хоће ли ми бити чист у кога су мерила лажна  
\q2 и у тобоцу преварно камење?   
\q1
\v 12 Јер су богатуни његови пуни неправде,  
\q2 и становници говоре лаж,  
\q2 и у устима им је језик преваран.   
\q1
\v 13 Зато ћу те и ја бити да оболиш,  
\q2 пустошићу те за грехе твоје.   
\q1
\v 14 Ти ћеш јести, али се нећеш наситити,  
\q2 и падање твоје биће усред тебе;  
\q1 и склањаћеш, али нећеш избавити,  
\q2 и што избавиш предаћу мачу.   
\q1
\v 15 Ти ћеш сејати, али нећеш жети;  
\q2 ти ћеш цедити маслине, али се нећеш намазати уљем,  
\q2 и маст, али нећеш пити вино.   
\q1
\v 16 Јер се држе уредбе Амријеве  
\q2 и сва дела дома Ахавовог,  
\q2 и ходите по саветима њиховим,  
\q1 да те предам у погибао,  
\q2 и становнике његове у подсмех,  
\q2 и носићете срамоту народа мог.   
\c 7  
\s1 Мало је побожних. Обрицање богате божанске милости после казне.  
\q1
\v 1 Тешко мени!  
\q2 Јер сам као кад се обере летина,  
\q2 као кад се пабирчи после брања виноградског;  
\q1 нема грозда за јело,  
\q2 раног воћа жели душа моја.   
\q1
\v 2 Неста побожног са земље  
\q2 и нема правог међу људима,  
\q1 сви вребају крв,  
\q2 сваки лови брата свог мрежом.   
\q1
\v 3 Да чине зло обема рукама што више могу,  
\q2 иште кнез;  
\q1 и судија суди за плату,  
\q2 и ко је велик говори опачину душе своје,  
\q2 и сплећу је.   
\q1
\v 4 Најбољи је између њих као трн,  
\q2 најправији је гори од трњака;  
\q1 дан стражара твојих,  
\q2 похођење твоје дође,  
\q2 сада ће се смести.   
\q1
\v 5 Не верујте пријатељу,  
\q2 не ослањајте се на вођу;  
\q1 од оне која ти на крилу лежи,  
\q2 чувај врата уста својих.   
\q1
\v 6 Јер син грди оца,  
\q2 кћи устаје на матер своју,  
\q1 снаха на свекрву своју,  
\q2 непријатељи су човеку домаћи његови.   
\q1
\v 7 Али ја ћу Господа погледати,  
\q2 чекаћу Бога спасења свог;  
\q2 услишиће ме Бог мој.   
\b  
\q1
\v 8 Немој ми се радовати, непријатељице моја;  
\q2 ако падох, устаћу;  
\q1 ако седим у мраку,  
\q2 Господ ће ми бити видело.   
\q1
\v 9 Подносићу гнев Господњи,  
\q2 јер Му згреших,  
\q1 док не расправи парбу моју  
\q2 и да ми правицу;  
\q1 извешће ме на видело,  
\q2 видећу правду Његову.   
\q1
\v 10 Непријатељица ће моја видети,  
\q2 и срам ће је покрити,  
\q1 која ми говори:  
\q2 Где је Господ Бог твој?  
\q1 Очи ће је моје видети;  
\q2 сада ће се она погазити као блато на улицама.   
\b  
\q1
\v 11 У које се време сазидају зидови твоји,  
\q2 у то ће време отићи заповест надалеко;   
\q1
\v 12 У то ће време долазити к теби  
\q2 од асирске до тврдих градова,  
\q1 и од тврдих градова до реке,  
\q2 и од мора до мора,  
\q2 и од горе до горе.   
\q1
\v 13 А земља ће бити пуста са становника својих,  
\q2 за плод дела њихових.   
\b  
\q1
\v 14 Паси народ свој с палицом својом,  
\q2 стадо наследства свог,  
\q1 које живи осамљено у шуми,  
\q2 усред Кармила;  
\q1 нека пасу по Васану и по Галаду,  
\q2 као у старо време.   
\q1
\v 15 Као у време кад си изашао из земље мисирске  
\q2 показаћу му чудеса.   
\q1
\v 16 Народи ће видети  
\q2 и постидеће се од све силе своје;  
\q1 метнуће руку на уста,  
\q2 уши ће им заглушити.   
\q1
\v 17 Лизаће прах као змија;  
\q2 као бубине земаљске дрхћући излазиће из рупа својих;  
\q1 притрчаће уплашени ка Господу Богу нашем,  
\q2 и Тебе ће се бојати.   
\b  
\q1
\v 18 Ко је Бог као Ти?  
\q2 Који прашта безакоње  
\q2 и пролази преступе остатку од наследства свог,  
\q1 не држи до века гнев свој,  
\q2 јер Му је мила милост.   
\q1
\v 19 Опет ће се смиловати на нас;  
\q2 погазиће наша безакоња;  
\q2 бацићеш у дубине морске све грехе њихове.   
\q1
\v 20 Показаћеш истину Јакову, милост Авраму,  
\q2 како си се заклео оцима нашим у старо време.   