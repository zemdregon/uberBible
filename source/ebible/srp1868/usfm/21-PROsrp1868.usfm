\id PRO  
\h Приче Соломунове 
\toc1 Приче Соломунове 
\toc2 Приче Соломунове 
\toc3 При 
\mt1 Приче Соломунове  
\c 1  
\s1 Да се позна мудрост! Треба се чувати мамца грешника. Казна за непослушност.  
\p
\v 1 Приче Соломуна сина Давидовог, цара Израиљевог.   
\b  
\q1
\v 2 Да се познаје мудрост и настава,  
\q2 да се разумеју речи разумне,   
\q1
\v 3 Да се прима настава  
\q2 у разуму, у правди, у суду и у свему што је право,   
\q1
\v 4 Да се даје лудима разборитост,  
\q2 младићима знање и помњивост.   
\q1
\v 5 Мудар ће слушати и више ће знати,  
\q2 и разуман ће стећи мудрост,   
\q1
\v 6 Да разуме приче и значење,  
\q2 речи мудрих људи и загонетке њихове.   
\b  
\q1
\v 7 Почетак је мудрости страх Господњи;  
\q2 луди презиру мудрост и наставу.   
\b  
\q1
\v 8 Слушај, сине, наставу оца свог,  
\q2 и не остављај науке матере своје.   
\q1
\v 9 Јер ће бити венац од милина око главе твоје,  
\q2 и гривна на грлу твом.   
\q1
\v 10 Сине мој, ако би те мамили грешници, не пристај;   
\q1
\v 11 Ако би рекли: Ходи с нама  
\q2 да вребамо крв,  
\q2 да заседамо правоме низашта;   
\q1
\v 12 Прождрећемо их као гроб живе,  
\q2 и свеколике као оне који силазе у јаму;   
\q1
\v 13 Свакојаког блага добићемо,  
\q2 напунићемо куће своје плена;   
\q1
\v 14 Бацаћеш жреб свој с нама;  
\q2 један ће нам тоболац бити свима;   
\q1
\v 15 Сине мој, не иди на пут с њима,  
\q2 чувај ногу своју од стазе њихове.   
\q1
\v 16 Јер ногама својим трче на зло  
\q2 и хите да проливају крв.   
\q1
\v 17 Јер се узалуд разапиње мрежа на очи свакој птици;   
\q1
\v 18 А они вребају своју крв  
\q2 и заседају својој души.   
\q1
\v 19 Такви су путеви свих лакомих на добитак,  
\q2 који узима душу својим господарима.   
\b  
\q1
\v 20 Премудрост виче на пољу,  
\q2 на улицама пушта глас свој;   
\q1
\v 21 У највећој вреви виче,  
\q2 на вратима, у граду говори своје беседе;   
\q1
\v 22 Луди, докле ћете љубити лудост?  
\q2 И подсмевачима докле ће бити мио подсмех?  
\q2 И безумни, докле ће мрзети на знање?   
\q1
\v 23 Обратите се на карање моје;  
\q2 ево, изасућу вам дух свој,  
\q2 казаћу вам речи своје.   
\q1
\v 24 Што звах, али не хтесте,  
\q2 пружах руку своју, али нико не мари,   
\q1
\v 25 Него одбацисте сваки савет мој,  
\q2 и карање моје не хтесте примити;   
\q1
\v 26 Зато ћу се и ја смејати вашој невољи,  
\q2 ругаћу се кад дође чега се бојите;   
\q1
\v 27 Кад као пустош дође чега се бојите,  
\q2 и погибао ваша као олуја кад дође,  
\q2 кад навали на вас невоља и мука.   
\q1
\v 28 Тада ће ме звати, али се нећу одазвати;  
\q2 рано ће тражити, али ме неће наћи.   
\q1
\v 29 Јер мрзише на знање,  
\q2 и страх Господњи не изабраше;   
\q1
\v 30 Не присташе на мој савет,  
\q2 и презираше сва карања моја.   
\q1
\v 31 Зато ће јести плод од путева својих,  
\q2 и наситиће се савета својих.   
\q1
\v 32 Јер ће луде убити мир њихов,  
\q2 и безумне ће погубити срећа њихова.   
\q1
\v 33 Али ко ме слуша боравиће безбрижно,  
\q2 и биће на миру не бојећи се зла.   
\c 2  
\s1 Опомена да озбиљно тражимо мудрост да бисмо се сачували од искушења.  
\q1
\v 1 Сине мој, ако примиш речи моје,  
\q2 и заповести моје сахраниш код себе,   
\q1
\v 2 Да пази ухо твоје на мудрост,  
\q2 и пригнеш срце своје к разуму,   
\q1
\v 3 Ако призовеш мудрост,  
\q2 и к разуму подигнеш глас свој,   
\q1
\v 4 Ако га устражиш као сребро,  
\q2 и као сакривено благо ако добро устражиш;   
\q1
\v 5 Тада ћеш разумети страх Господњи,  
\q2 и познање Божије наћи ћеш.   
\q1
\v 6 Јер Господ даје мудрост,  
\q2 из Његових уста долази знање и разум.   
\q1
\v 7 Чува правима шта доиста јесте,  
\q2 штит је онима који ходе у безазлености,   
\q1
\v 8 Да би се држали стаза правих,  
\q2 а Он чува пут светаца својих.   
\q1
\v 9 Тада ћеш разумети  
\q2 правду и суд и шта је право, и сваки добри пут.   
\q1
\v 10 Кад дође мудрост у срце твоје,  
\q2 и знање омили души твојој,   
\q1
\v 11 Помњивост ће пазити на те,  
\q2 разум ће те чувати,   
\q1
\v 12 Избављајући те од зла пута,  
\q2 од људи који говоре опаке ствари,   
\q1
\v 13 Који остављају праве путе  
\q2 да иду путевима мрачним,   
\q1
\v 14 Који се радују зло чинећи,  
\q2 и играју у злим опачинама;   
\q1
\v 15 Којих су путеви криви,  
\q2 и сами су опаки на стазама својим;   
\b  
\q1
\v 16 Избављајући те од жене туђе,  
\q2 од туђинке, која ласка својим речима,   
\q1
\v 17 Која оставља вођу младости своје,  
\q2 и заборавља завет Бога свог.   
\q1
\v 18 Јер к смрти води дом њен,  
\q2 и к мртвима стазе њене.   
\q1
\v 19 Ко год уђе к њој не враћа се,  
\q2 нити излази на пут животни.   
\b  
\q1
\v 20 Зато ходи путем добрих,  
\q2 и држи се стаза праведничких.   
\q1
\v 21 Јер ће праведници наставати на земљи,  
\q2 и безазлени ће остати на њој.   
\q1
\v 22 А безбожни ће се истребити са земље,  
\q2 и безаконици ће се ишчупати из ње.   
\c 3  
\s1 Благословен је страх Господњи и мудрост.  
\q1
\v 1 Сине мој, не заборављај науке моје,  
\q2 и заповести моје нека хране срце твоје.   
\q1
\v 2 Јер ће ти донети дуг живот,  
\q2 добре године и мир.   
\b  
\q1
\v 3 Милост и истина нека те не оставља;  
\q2 привежи их себи на грло,  
\q2 упиши их на плочи срца свог.   
\q1
\v 4 Те ћеш наћи милост и добру мисао  
\q2 пред Богом и пред људима.   
\b  
\q1
\v 5 Уздај се у Господа свим срцем својим,  
\q2 а на свој разум не ослањај се.   
\q1
\v 6 На свим путевима својим имај Га на уму,  
\q2 и Он ће управљати стазе твоје.   
\q1
\v 7 Не мисли сам о себи да си мудар;  
\q2 бој се Господа и уклањај се ода зла.   
\q1
\v 8 То ће бити здравље пупку твом  
\q2 и заливање костима твојим.   
\b  
\q1
\v 9 Поштуј Господа имањем својим  
\q2 и првинама од свега дохотка свог;   
\q1
\v 10 И биће пуне житнице твоје обиља,  
\q2 и пресипаће се вино из каца твојих.   
\b  
\q1
\v 11 Сине мој, не одбацуј наставе Господње,  
\q2 и немој да ти досади карање Његово.   
\q1
\v 12 Јер кога љуби Господ оног кара,  
\q2 и као отац сина који му је мио.   
\b  
\q1
\v 13 Благо човеку који нађе мудрост,  
\q2 и човеку који добије разум.   
\q1
\v 14 Јер је боље њом трговати него трговати сребром,  
\q2 и добитак на њој бољи је од злата.   
\q1
\v 15 Скупља је од драгог камења,  
\q2 и шта је год најмилијих ствари твојих не могу се изједначити с њом.   
\q1
\v 16 Дуг живот у десници јој је,  
\q2 а у левици богатство и слава.   
\q1
\v 17 Путеви су њени мили путеви  
\q2 и све стазе њене мирне.   
\q1
\v 18 Дрво је животно онима који се хватају за њу,  
\q2 и ко је год држи срећан је.   
\b  
\q1
\v 19 Господ је мудрошћу основао земљу,  
\q2 утврдио небеса разумом.   
\q1
\v 20 Његовом мудрошћу развалише се бездане  
\q2 и облаци капљу росом.   
\b  
\q1
\v 21 Сине мој, да ти то не одлази из очију;  
\q2 чувај праву мудрост и разборитост;   
\q1
\v 22 И биће живот души твојој  
\q2 и накит грлу твом.   
\q1
\v 23 Тада ћеш ићи без бриге путем својим,  
\q2 и нога твоја неће се спотаћи.   
\q1
\v 24 Кад лежеш, нећеш се плашити,  
\q2 и кад почиваш, сладак ће ти бити сан.   
\q1
\v 25 Нећеш се плашити од нагле страхоте  
\q2 ни од погибли безбожничке кад дође.   
\q1
\v 26 Јер ће ти Господ бити узданица  
\q2 и чуваће ти ногу да се не ухвати.   
\q1
\v 27 Не одреци добра онима којима треба,  
\q2 кад можеш учинити.   
\b  
\q1
\v 28 Не говори ближњему свом:  
\q2 Иди, и дођи други пут, и сутра ћу ти дати,  
\q2 кад имаш.   
\q1
\v 29 Не куј зло ближњему свом  
\q2 који живи с тобом без бриге.   
\q1
\v 30 Не свађај се ни с ким без узрока,  
\q2 ако ти није учинио зло.   
\q1
\v 31 Немој завидети насилнику,  
\q2 ни изабрати који пут његов.   
\q1
\v 32 Јер је мрзак Господу зликовац,  
\q2 а у праведних је тајна његова.   
\q1
\v 33 Проклетство је Господње у кући безбожниковој,  
\q2 а стан праведнички благосиља.   
\q1
\v 34 Јер подсмевачима Он се подсмева,  
\q2 а кроткима даје милост.   
\q1
\v 35 Мудри ће наследити славу,  
\q2 а безумнике ће однети срамота.   
\c 4  
\s1 Настава очина како да се иде путем мудрости.  
\q1
\v 1 Слушајте, децо, наставу очеву,  
\q2 и пазите да бисте познали мудрост.   
\q1
\v 2 Јер вам добру науку дајем,  
\q2 не остављајте закон мој.   
\q1
\v 3 Кад бејах син у оца свог млад,  
\q2 и јединац у матере своје,   
\q1
\v 4 Он ме учаше и говораше ми:  
\q2 Нека прими срце твоје речи моје,  
\q2 држи заповести моје и бићеш жив.   
\q1
\v 5 Прибави мудрост, прибави разум;  
\q2 не заборављај и не одступај од речи уста мојих.   
\q1
\v 6 Немој је оставити, и чуваће те,  
\q2 љуби је, и храниће те.   
\q1
\v 7 Мудрост је главно; прибави мудрост,  
\q2 и за све имање своје прибави разум.   
\q1
\v 8 Подижи је и она ће те узвисити,  
\q2 прославиће те кад је загрлиш.   
\q1
\v 9 Метнуће ти на главу венац од милина,  
\q2 красну круну даће ти.   
\b  
\q1
\v 10 Слушај, сине мој, и прими речи моје,  
\q2 и умножиће ти се године животу.   
\q1
\v 11 Учим те путу мудрости,  
\q2 водим те стазама правим.   
\q1
\v 12 Кад усходиш, неће се стезати кораци твоји,  
\q2 и ако потрчиш нећеш се спотакнути.   
\q1
\v 13 Држи се наставе и не пуштај,  
\q2 чувај је, јер ти је живот.   
\q1
\v 14 Не иди на стазу безбожничку  
\q2 и путем неваљалих људи не ступај.   
\q1
\v 15 Остави га, не ходи по њему,  
\q2 уклони се од њега и мини га.   
\q1
\v 16 Јер не спавају ако не учине зла,  
\q2 и не долази им сан ако кога не оборе.   
\q1
\v 17 Јер једу хлеб безбожности  
\q2 и пију вино насиља.   
\q1
\v 18 А пут је праведнички као светло видело,  
\q2 које све већма светли док не буде прави дан.   
\q1
\v 19 А пут је безбожнички као мрак,  
\q2 не знају на шта ће се спотакнути.   
\b  
\q1
\v 20 Сине мој, слушај речи моје,  
\q2 пригни ухо своје беседи мојој.   
\q1
\v 21 Да ти не одлазе из очију;  
\q2 чувај их усред срца свог.   
\q1
\v 22 Јер су живот онима који их налазе  
\q2 и здравље свему телу њиховом.   
\q1
\v 23 Сврх свега што се чува чувај срце своје,  
\q2 јер из њега излази живот.   
\q1
\v 24 Уклони од уста својих опачину  
\q2 и од усана својих неваљалство удаљи.   
\q1
\v 25 Очи твоје нека гледају управо  
\q2 и веђе твоје нека се управљају право пред тобом.   
\q1
\v 26 Мери стазу ногама својим,  
\q2 и сви путеви твоји нека су поравњени.   
\q1
\v 27 Не сврћи ни надесно ни налево,  
\q2 одвраћај ногу своју ода зла.   
\c 5  
\s1 Треба се чувати разврата.  
\q1
\v 1 Сине мој, слушај мудрост моју,  
\q2 к разуму мом пригни ухо своје,   
\q1
\v 2 Да се држиш разборитости,  
\q2 и усне твоје да хране знање.   
\q1
\v 3 Јер с усана туђе жене капље мед,  
\q2 и грло јој је мекше од уља;   
\q1
\v 4 Али јој је последак горак као пелен,  
\q2 оштар као мач с обе стране оштар.   
\q1
\v 5 Ноге јој силазе к смрти,  
\q2 до пакла допиру кораци њени.   
\q1
\v 6 Да не би мерио пут животни,  
\q2 савијају се стазе њене да не знаш.   
\b  
\q1
\v 7 Зато, децо, послушајте мене,  
\q2 и не одступајте од речи уста мојих.   
\q1
\v 8 Нека је далеко од ње пут твој,  
\q2 и не приближуј се к вратима куће њене,   
\q1
\v 9 Да не би дао другима славе своје  
\q2 и година својих немилостивоме,   
\q1
\v 10 Да се не би туђинци наситили твог блага  
\q2 и труд твој да не би био у туђој кући,   
\q1
\v 11 И да не ридаш на послетку,  
\q2 кад се строши месо твоје и тело твоје,   
\q1
\v 12 И кажеш: Како мрзих на наставу,  
\q2 и како срце моје презира карање!   
\q1
\v 13 И не послушах глас учитеља својих,  
\q2 и не пригнух уха свог к онима који ме учаху!   
\q1
\v 14 Умало не западох у свако зло  
\q2 усред збора и скупштине.   
\b  
\q1
\v 15 Пиј воду из свог студенца  
\q2 и што тече из твог извора.   
\q1
\v 16 Нека се разливају твоји извори на поље,  
\q2 и потоци по улицама.   
\q1
\v 17 Имај их сам за се,  
\q2 а не туђин с тобом.   
\q1
\v 18 Благословен да је извор твој,  
\q2 и весели се женом младости своје;   
\q1
\v 19 Нека ти је као кошута мила и као срна љупка;  
\q2 дојке њене нека те опијају у свако доба,  
\q2 у љубави њеној посрћи једнако.   
\q1
\v 20 А зашто би, сине, посртао за туђинком  
\q2 и голио недра туђој,   
\q1
\v 21 Кад су пред очима Господу путеви свачији,  
\q2 и мери све стазе његове?   
\q1
\v 22 Безбожника ће ухватити његова безакоња,  
\q2 и у ужа греха својих заплешће се;   
\q1
\v 23 Умреће без наставе,  
\q2 и од мноштва лудости своје лутаће.   
\c 6  
\s1 Треба се чувати јемства, лењости, злобе и прељубе.  
\q1
\v 1 Сине мој, кад се подјемчиш за пријатеља свог,  
\q2 и даш руку своју туђинцу,   
\q1
\v 2 Везао си се речима уста својих,  
\q2 ухватио си се речима уста својих.   
\q1
\v 3 Зато учини тако, сине мој, и опрости се,  
\q2 јер си допао у руке ближњему свом;  
\q2 иди, припадни, и навали на ближњег свог.   
\q1
\v 4 Не дај сна очима својим,  
\q2 ни веђама својим дрема.   
\q1
\v 5 Отми се као срна из руке ловцу,  
\q2 и као птица из руке птичару.   
\b  
\q1
\v 6 Иди к мраву, лењивче,  
\q2 гледај путеве његове, и омудрај.   
\q1
\v 7 Нема вођу ни управитеља ни господара;   
\q1
\v 8 И опет приправља лети себи храну,  
\q2 збира уз жетву пићу своју.   
\q1
\v 9 Докле ћеш, лењивче, лежати?  
\q2 Кад ћеш устати од сна свог?   
\q1
\v 10 Док мало проспаваш, док мало продремљеш,  
\q2 док мало склопиш руке да прилегнеш,   
\q1
\v 11 У том ће доћи сиромаштво твоје као путник  
\q2 и оскудица твоја као оружан човек.   
\b  
\q1
\v 12 Човек неваљао и нитков  
\q2 ходи са злим устима;   
\q1
\v 13 Намигује очима, говори ногама, показује прстима;   
\q1
\v 14 Свака му је опачина у срцу,  
\q2 кује зло свагда, замеће свађу.   
\q1
\v 15 Зато ће уједанпут доћи погибао његова,  
\q2 часом ће се сатрти и неће бити лека.   
\b  
\q1
\v 16 На ово шесторо мрзи Господ,  
\q2 и седмо је гад души његовој:   
\q1
\v 17 Очи поносите,  
\q1 језик лажљив  
\q1 и руке које проливају крв праву,   
\q1
\v 18 Срце које кује зле мисли,  
\q1 ноге које брзо трче на зло,   
\q1
\v 19 Лажан сведок који говори лаж,  
\q1 и ко замеће свађу међу браћом.   
\b  
\q1
\v 20 Чувај, сине мој, заповест оца свог,  
\q2 и не остављај науке матере своје.   
\q1
\v 21 Привежи их себи на срце засвагда,  
\q2 и свежи их себи око грла.   
\q1
\v 22 Куда год пођеш, водиће те;  
\q2 кад заспиш, чуваће те;  
\q2 кад се пробудиш, разговараће те;   
\q1
\v 23 Јер је заповест жижак, и наука је видело,  
\q2 и пут је животни карање које поучава;   
\q1
\v 24 Да те чувају од зле жене,  
\q2 од језика којим ласка жена туђа.   
\q1
\v 25 Не зажели у срцу свом лепоту њену,  
\q2 и немој да те ухвати веђама својим.   
\q1
\v 26 Јер са жене курве спада човек на комад хлеба,  
\q2 и жена пуста лови драгоцену душу.   
\q1
\v 27 Хоће ли ко узети огња у недра,  
\q2 а хаљине да му се не упале?   
\q1
\v 28 Хоће ли ко ходити по живом угљевљу,  
\q2 а ногу да не ожеже?   
\q1
\v 29 Тако бива ономе који иде к жени ближњег свог;  
\q2 неће бити без кривице ко је се год дотакне.   
\q1
\v 30 Не срамоте лупежа који украде да насити душу своју,  
\q2 будући гладан;   
\q1
\v 31 Него кад га ухвате плати самоседмо,  
\q2 да све имање дома свог.   
\q1
\v 32 Али ко учини прељубу са женом, безуман је,  
\q2 душу своју губи ко тако чини;   
\q1
\v 33 Муке и руга допада,  
\q2 и срамота се његова не може избрисати.   
\q1
\v 34 Јер је љубавна сумња жестока у мужа  
\q2 и не штеди на дан освете;   
\q1
\v 35 Не мари ни за какав откуп,  
\q2 и не прима ако ћеш и много дарова давати.   
\c 7  
\s1 Описивање завођења на разврат. Жалосне последице тог завођења.  
\q1
\v 1 Сине, чувај речи моје,  
\q2 и заповести моје сахрани код себе.   
\q1
\v 2 Чувај заповести моје и бићеш жив,  
\q2 и науку моју као зеницу очију својих.   
\q1
\v 3 Привежи их себи на прсте,  
\q2 напиши их на плочи срца свог.   
\q1
\v 4 Реци мудрости: Сестра си ми;  
\q2 и пријатељицом зови разборитост,   
\q1
\v 5 Да би те чувала од жене туђе,  
\q2 од туђинке, која ласка речима.   
\b  
\q1
\v 6 Јер с прозора дома свог кроз решетку гледах,   
\q1
\v 7 И видех међу лудима,  
\q2 опазих међу децом безумног младића,   
\q1
\v 8 Који иђаше улицом покрај угла њеног,  
\q2 и корачаше путем ка кући њеној,   
\q1
\v 9 У сумрак, увече, кад се уноћа и смрче;   
\b  
\q1
\v 10 А гле, срете га жена  
\q2 у оделу курвинском и лукавог срца,   
\q1
\v 11 Плаха и пуста,  
\q2 којој ноге не могу стајати код куће,   
\q1
\v 12 Сад на пољу, сад на улици,  
\q2 код сваког угла вребаше.   
\q1
\v 13 И ухвати га, и пољуби га,  
\q2 и безобразно рече му:   
\q1
\v 14 Имам жртве захвалне,  
\q2 данас изврших завете своје;   
\q1
\v 15 Зато ти изиђох на сусрет да те тражим,  
\q2 и нађох те.   
\q1
\v 16 Настрла сам одар свој покривачем везеним  
\q2 и простиркама мисирским.   
\q1
\v 17 Окадила сам постељу своју смирном, алојом и циметом.   
\q1
\v 18 Хајде да се опијамо љубављу до зоре,  
\q2 да се веселимо миловањем.   
\q1
\v 19 Јер ми муж није код куће,  
\q2 отишао је на пут далеки,   
\q1
\v 20 Узео је са собом тоболац новчани,  
\q2 вратиће се кући у одређени дан.   
\b  
\q1
\v 21 Наврати га многим речима,  
\q2 глатким уснама одвуче га.   
\q1
\v 22 Отиде за њом одмах  
\q2 као што во иде на клање  
\q2 и као безумник у путо да буде каран,   
\q1
\v 23 Докле му стрела не пробије јетру,  
\q2 као што птица лети у замку  
\q2 не знајући да јој је о живот.   
\b  
\q1
\v 24 Зато дакле, децо, послушајте ме,  
\q2 и пазите на речи уста мојих.   
\q1
\v 25 Немој да застрањује срце твоје не путеве њене,  
\q2 немој лутати по стазама њеним.   
\q1
\v 26 Јер је многе ранила и оборила,  
\q2 и много је оних које је све побила.   
\q1
\v 27 Кућа је њена пут паклени  
\q2 који води у клети смртне.   
\c 8  
\s1 Позив и обрицање мудрости која је вечно у Бога.  
\q1
\v 1 Не виче ли мудрост?  
\q2 И разум не пушта ли глас свој?   
\q1
\v 2 Наврх висина, на путу, на распутицама стоји,   
\q1
\v 3 Код врата, на уласку у град, где се отварају врата, виче:   
\q1
\v 4 Вас вичем, о људи,  
\q2 и глас свој обраћам к синовима људским.   
\q1
\v 5 Научите се луди мудрости,  
\q2 и безумни оразумите се.   
\q1
\v 6 Слушајте, јер ћу говорити велике ствари,  
\q2 и усне моје отварајући се казиваће шта је право.   
\q1
\v 7 Јер уста моја говоре истину,  
\q2 и мрска је уснама мојим безбожност.   
\q1
\v 8 Праве су све речи уста мојих,  
\q2 ништа нема у њима криво ни изопачено.   
\q1
\v 9 Све су обичне разумном  
\q2 и праве су онима који налазе знање.   
\q1
\v 10 Примите наставу моју, а не сребро,  
\q2 и знање радије него најбоље злато.   
\q1
\v 11 Јер је боља мудрост од драгог камења,  
\q2 и шта је год најмилијих ствари не могу се изједначити с њом.   
\b  
\q1
\v 12 Ја мудрост боравим с разборитошћу,  
\q2 и разумно знање налазим.   
\q1
\v 13 Страх је Господњи мржња на зло;  
\q2 ја мрзим на поноситост и на охолост  
\q2 и на зли пут и на уста опака.   
\q1
\v 14 Мој је савет и шта год јесте;  
\q2 ја сам разум и моја је сила.   
\q1
\v 15 Мном цареви царују,  
\q2 и владаоци постављају правду.   
\q1
\v 16 Мном владају кнезови и поглавари и све судије земаљске.   
\q1
\v 17 Ја љубим оне који мене љубе,  
\q2 и који ме добро траже налазе ме.   
\q1
\v 18 У мене је богатство и слава,  
\q2 постојано добро и правда.   
\q1
\v 19 Плод је мој бољи од злата и од најбољег злата,  
\q2 и добитак је мој бољи и од најбољег сребра.   
\q1
\v 20 Путем праведним ходим,  
\q2 посред стаза правице,   
\q1
\v 21 Да онима који ме љубе дам оно што јесте,  
\q2 и ризнице њихове да напуним.   
\b  
\q1
\v 22 Господ ме је имао у почетку пута свог,  
\q2 пре дела својих, пре сваког времена.   
\q1
\v 23 Пре векова постављена сам,  
\q2 пре почетка, пре постања земље.   
\q1
\v 24 Кад још не беше бездана, родила сам се,  
\q2 кад још не беше извора обилатих водом.   
\q1
\v 25 Пре него се горе основаше,  
\q2 пре хумова ја сам се родила;   
\q1
\v 26 Још не беше начинио земље ни поља  
\q2 ни почетка праху васиљенском;   
\q1
\v 27 Кад је уређивао небеса, онде бејах;  
\q2 кад је размеравао круг над безданом.   
\q1
\v 28 Кад је утврђивао облаке горе  
\q2 и крепио изворе бездану;   
\q1
\v 29 Кад је постављао мору међу  
\q2 и водама да не преступају заповести Његове,  
\q2 кад је постављао темеље земљи;   
\q1
\v 30 Тада бејах код Њега храњеница,  
\q2 бејах Му милина сваки дан,  
\q2 и весељах се пред Њим свагда;   
\q1
\v 31 Весељах се на васиљени Његовој,  
\q2 и милина ми је са синовима људским.   
\b  
\q1
\v 32 Тако, дакле, синови, послушајте ме,  
\q2 јер благо онима који се држе путева мојих.   
\q1
\v 33 Слушајте наставу, и будите мудри,  
\q2 и немојте је одбацити.   
\q1
\v 34 Благо човеку који ме слуша  
\q2 стражећи на вратима мојим сваки дан  
\q2 и чувајући прагове врата мојих.   
\q1
\v 35 Јер ко мене налази, налази живот  
\q2 и добија љубав од Господа.   
\q1
\v 36 А ко о мене греши, чини криво души својој;  
\q2 сви који мрзе на ме, љубе смрт.   
\c 9  
\s1 Пријатељски позив мудрости.  
\q1
\v 1 Премудрост сазида себи кућу,  
\q2 и отеса седам ступова;   
\q1
\v 2 Покла стоку своју,  
\q2 раствори вино своје,  
\q2 и постави сто свој.   
\q1
\v 3 Посла девојке своје,  
\q2 те зове сврх висина градских:   
\q1
\v 4 Ко је луд, нека се уврати овамо.  
\q2 И безумнима вели:   
\q1
\v 5 Ходите, једите хлеба мог,  
\q2 и пијте вино које сам растворила.   
\q1
\v 6 Оставите лудост и бићете живи,  
\q2 и идите путем разума.   
\b  
\q1
\v 7 Ко учи подсмевача, прима срамоту;  
\q2 и ко кори безбожника, прима руг.   
\q1
\v 8 Не карај подсмевача да не омрзне на те;  
\q2 карај мудра, и љубиће те.   
\q1
\v 9 Кажи мудроме, и биће још мудрији;  
\q2 поучи праведног, и знаће више.   
\q1
\v 10 Почетак је мудрости страх Господњи,  
\q2 и знање је светих ствари разум.   
\q1
\v 11 Јер ће се мном умножити дани твоји  
\q2 и додаће ти се године животу.   
\q1
\v 12 Ако будеш мудар, себи ћеш бити мудар;  
\q2 ако ли будеш подсмевач, сам ћеш теглити.   
\b  
\q1
\v 13 Жена безумна плаха је,  
\q2 луда и ништа не зна;   
\q1
\v 14 И седи на вратима од куће своје  
\q2 на столици, на висинама градским,   
\q1
\v 15 Те виче оне који пролазе,  
\q2 који иду право својим путем:   
\q1
\v 16 Ко је луд? Нека се уврати овамо.  
\q2 И безумном говори:   
\q1
\v 17 Вода је крадена слатка,  
\q2 и хлеб је сакривен угодан.   
\q1
\v 18 А он не зна да су онде мртваци  
\q2 и у дубоком гробу да су званице њене.   
\c 10  
\s1 Правичност се благосиља, грех се проклиње.  
\d Приче Соломунове.  
\q1
\v 1 Мудар је син радост оцу свом,  
\q2 а луд је син жалост матери својој.   
\q1
\v 2 Не помаже неправедно благо,  
\q2 него правда избавља од смрти.   
\q1
\v 3 Не да Господ да гладује душа праведникова,  
\q2 а имање безбожничко размеће.   
\q1
\v 4 Немарна рука осиромашава,  
\q2 а вредна рука обогаћава.   
\q1
\v 5 Ко збира у лето, син је разуман;  
\q2 ко спава о жетви, син је срамотан.   
\q1
\v 6 Благослови су над главом праведнику,  
\q2 а уста безбожничка покрива насиље.   
\q1
\v 7 Спомен праведников остаје благословен,  
\q2 а име безбожничко труне.   
\q1
\v 8 Ко је мудра срца, прима заповести;  
\q2 а ко је лудих усана, пашће.   
\q1
\v 9 Ко ходи безазлено, ходи поуздано;  
\q2 а ко је опак на путевима својим, познаће се.   
\q1
\v 10 Ко намигује оком, даје муку;  
\q2 и ко је лудих усана, пашће.   
\q1
\v 11 Уста су праведникова извор животу,  
\q2 а уста безбожничка покрива насиље.   
\q1
\v 12 Мрзост замеће свађе,  
\q2 а љубав прикрива све преступе.   
\q1
\v 13 На уснама разумног налази се мудрост,  
\q2 а за леђа је безумног батина.   
\q1
\v 14 Мудри склањају знање,  
\q2 а уста лудога близу су погибли.   
\q1
\v 15 Богатство је богатима тврд град,  
\q2 сиромаштво је сиромасима погибао.   
\q1
\v 16 Рад је праведников на живот,  
\q2 добитак безбожников на грех.   
\q1
\v 17 Ко прима наставу, на путу је к животу;  
\q2 а ко одбацује кар, лута.   
\q1
\v 18 Ко покрива мржњу, лажљивих је усана;  
\q2 и ко износи срамоту безуман је.   
\q1
\v 19 У многим речима не бива без греха;  
\q2 али ко задржава усне своје, разуман је.   
\q1
\v 20 Језик је праведников сребро одабрано;  
\q2 срце безбожничко не вреди ништа.   
\q1
\v 21 Усне праведникове пасу многе,  
\q2 а безумни умиру с безумља.   
\q1
\v 22 Благослов Господњи обогаћава а без муке.   
\q1
\v 23 Безумнику је шала чинити зло,  
\q2 а разуман човек држи се мудрости.   
\q1
\v 24 Чега се боји безбожник, оно ће га снаћи;  
\q2 а шта праведници желе Бог ће им дати.   
\q1
\v 25 Као што пролази олуја, тако безбожника нестаје;  
\q2 а праведник је на вечитом темељу.   
\q1
\v 26 Какав је оцат зубима и дим очима,  
\q2 такав је лењивац онима који га шаљу.   
\q1
\v 27 Страх Господњи додаје дане,  
\q2 а безбожницима се године прекраћују.   
\q1
\v 28 Чекање праведних радост је,  
\q2 а надање безбожних пропада.   
\q1
\v 29 Пут је Господњи крепост безазленом,  
\q2 а страх онима који чине безакоње.   
\q1
\v 30 Праведник се неће никада поколебати,  
\q2 а безбожници неће наставати на земљи.   
\q1
\v 31 Уста праведникова износе мудрост,  
\q2 а језик опаки истребиће се.   
\q1
\v 32 Усне праведникове знају шта је мило,  
\q2 а безбожничка су уста опачина.   
\c 11  
\s1 Срећа побожних, несрећа безаконика.  
\q1
\v 1 Лажна су мерила мрска Господу,  
\q2 а права мера угодна Му је.   
\q1
\v 2 Кад дође охолост, дође и срамота;  
\q2 а у смерних је мудрост   
\q1
\v 3 Праведне води безазленост њихова,  
\q2 а безаконике сатире злоћа њихова.   
\q1
\v 4 Неће помоћи богатство у дан гнева,  
\q2 а правда избавља од смрти.   
\q1
\v 5 Правда безазленога управља пут његов,  
\q2 а безбожник пада од своје безбожности.   
\q1
\v 6 Праведне избавља правда њихова,  
\q2 а безаконици хватају се у својој злоћи.   
\q1
\v 7 Кад умире безбожник, пропада надање,  
\q2 и најјаче уздање пропада.   
\q1
\v 8 Праведник се избавља из невоље,  
\q2 а безбожник долази на његово место.   
\q1
\v 9 Лицемер квари устима ближњег свог;  
\q2 али се праведници избављају знањем.   
\q1
\v 10 Добру праведних радује се град;  
\q2 а кад пропадају безбожници, бива певање.   
\q1
\v 11 Благословима праведних људи подиже се град,  
\q2 а с уста безбожничких раскопава се.   
\q1
\v 12 Безумник се руга ближњему свом,  
\q2 а разуман човек ћути.   
\q1
\v 13 Опадач тумарајући издаје тајну;  
\q2 а ко је верна срца, таји ствар.   
\q1
\v 14 Где нема савета, пропада народ,  
\q2 а помоћ је у мноштву саветника.   
\q1
\v 15 Зло пролази ко се јамчи за туђина;  
\q2 а ко мрзи на јамство, без бриге је.   
\q1
\v 16 Жена мила добија част,  
\q2 а силни добијају богатство.   
\q1
\v 17 Милостив човек чини добро души својој,  
\q2 а немилостив уди свом телу.   
\q1
\v 18 Безбожни ради посао преваран;  
\q2 а ко сеје правду, поуздана му је плата.   
\q1
\v 19 Ко се држи правде, на живот му је;  
\q2 а ко иде за злом, на смрт му је.   
\q1
\v 20 Мрски су Господу који су опаког срца;  
\q2 а мили су Му који су безазлени на свом путу.   
\q1
\v 21 Зао човек неће остати без кара ако и друге узме у помоћ;  
\q2 а семе праведних избавиће се.   
\q1
\v 22 Жена лепа а без разума  
\q2 златна је брњица у губици свињи.   
\q1
\v 23 Жеља је праведних само добро,  
\q2 а очекивање безбожних гнев.   
\q1
\v 24 Један просипа, и све више има;  
\q2 а други тврдује сувише, и све је сиромашнији.   
\q1
\v 25 Подашна рука бива богатија,  
\q2 и ко напаја, сам ће бити напојен.   
\q1
\v 26 Ко не да жита, проклиње га народ,  
\q2 а ко продаје, благослов му је над главом.   
\q1
\v 27 Ко тражи добро, добија љубав;  
\q2 а ко тражи зло, задесиће га.   
\q1
\v 28 Ко се узда у богатство своје, пропашће;  
\q2 а праведници ће се као грана зеленети.   
\q1
\v 29 Ко затире кућу своју, наследиће ветар;  
\q2 и безумник ће служити мудром.   
\q1
\v 30 Плод је праведников дрво животно,  
\q2 и мудри обучава душе.   
\q1
\v 31 Гле, праведнику се на земљи плаћа,  
\q2 а камоли безбожнику и грешнику?   
\c 12  
\s1 Владање мудрих и безумних.  
\q1
\v 1 Ко љуби наставу, љуби знање;  
\q2 а ко мрзи на укор, остаје луд.   
\q1
\v 2 Добар човек добија љубав од Господа,  
\q2 а човека зликовца осуђује.   
\q1
\v 3 Неће се човек утврдити безбожношћу,  
\q2 а корен праведних неће се помаћи.   
\q1
\v 4 Вредна је жена венац мужу свом;  
\q2 а која га срамоти, она му је као трулеж у костима.   
\q1
\v 5 Мисли су праведних праве,  
\q2 а савети безбожних превара.   
\q1
\v 6 Речи безбожних вребају крв,  
\q2 а праведне избављају уста њихова.   
\q1
\v 7 Обарају се безбожни да их нема,  
\q2 а дом праведних остаје.   
\q1
\v 8 Према разуму свом хвали се човек;  
\q2 а ко је опака срца, презреће се.   
\q1
\v 9 Ко се снебива, а има слугу, бољи је  
\q2 од оног који се велича а хлеба нема.   
\q1
\v 10 Праведник се брине за живот свог живинчета,  
\q2 а у безбожника је срце немилостиво.   
\q1
\v 11 Ко ради своју земљу, биће сит хлеба;  
\q2 а ко иде за беспослицама, безуман је.   
\q1
\v 12 Безбожник жели обрану ода зла,  
\q2 али корен праведних даје је.   
\q1
\v 13 Зломе је замка у греху усана његових,  
\q2 а праведник излази из тескобе.   
\q1
\v 14 Од плода уста својих сити се човек добра,  
\q2 и плату за дела своја прима човек.   
\q1
\v 15 Безумнику се чини прав пут његов;  
\q2 али ко слуша савет, мудар је.   
\q1
\v 16 Гнев безумников одмах се позна,  
\q2 али паметни покрива срамоту.   
\q1
\v 17 Ко говори истину, јавља шта је право,  
\q2 а лажни сведок превару.   
\q1
\v 18 Има ко говори као да мач пробада,  
\q2 а језик је мудрих лек.   
\q1
\v 19 Истинита уста стоје тврдо довека,  
\q2 а језик лажљиви за час.   
\q1
\v 20 Који зло мисле, превара им је у срцу,  
\q2 а радост је онима који саветују на мир.   
\q1
\v 21 Никаква несрећа неће задесити праведника,  
\q2 а безбожници ће се напунити зла.   
\q1
\v 22 Мрске су Господу лажљиве усне;  
\q2 а који раде верно, мили су Му.   
\q1
\v 23 Паметан човек покрива знање,  
\q2 а срце безумних разглашује безумље.   
\q1
\v 24 Рука радљива господариће,  
\q2 а лена ће давати данак.   
\q1
\v 25 Брига у срцу човечијем обара;  
\q2 а добра реч развесељава.   
\q1
\v 26 Праведнику је боље него ближњему његовом;  
\q2 а безбожнике заводи пут њихов.   
\q1
\v 27 Лењивац неће пећи лов свој,  
\q2 а у вредног је човека добро драгоцено.   
\q1
\v 28 На путу правде живот је,  
\q2 и куда иде стаза њена нема смрти.   
\c 13  
\s1 Наставак описивања мудрог и безумног живота.  
\q1
\v 1 Мудар син слуша наставу оца свог;  
\q2 а подсмевач не слуша укоре.   
\q1
\v 2 Од плода уста својих сваки ће јести добро,  
\q2 а душа неваљалих људи насиље.   
\q1
\v 3 Ко чува уста своја, чува своју душу;  
\q2 ко разваљује усне, пропада.   
\q1
\v 4 Жељна је душа лењивчева, али нема ништа;  
\q2 а душа вредних људи обогатиће се.   
\q1
\v 5 На лажну реч мрзи праведник;  
\q2 а безбожник се мрази и срамоти.   
\q1
\v 6 Правда чува оног који ходи безазлено;  
\q2 а безбожност обара грешника.   
\q1
\v 7 Има ко се гради богат а нема ништа,  
\q2 и ко се гради сиромах а има велико благо.   
\q1
\v 8 Откуп је за живот човеку богатство његово,  
\q2 а сиромах не слуша претње.   
\q1
\v 9 Видело праведничко светли се,  
\q2 а жижак безбожнички угасиће се.   
\q1
\v 10 Од охолости бива само свађа,  
\q2 а који примају савет, у њих је мудрост.   
\q1
\v 11 Благо које се таштином тече умањује се,  
\q2 а ко сабира руком, умножава.   
\q1
\v 12 Дуго надање мори срце,  
\q2 и жеља је испуњена дрво животно.   
\q1
\v 13 Ко презире реч сам себи уди;  
\q2 а ко се боји заповести, платиће му се.   
\q1
\v 14 Наука је мудрога извор животни  
\q2 да се сачува пругала смртних.   
\q1
\v 15 Добар разум даје љубав,  
\q2 а пут је безаконички храпав.   
\q1
\v 16 Сваки паметан човек ради с разумом,  
\q2 а безуман разноси безумље.   
\q1
\v 17 Гласник безбожан пада у зло,  
\q2 а веран је посланик лек.   
\q1
\v 18 Сиромаштво и срамота доћи ће на оног који одбацује наставу;  
\q2 а ко чува карање, прославиће се.   
\q1
\v 19 Испуњена је жеља сласт души,  
\q2 а безумнима је мрско одступити ода зла.   
\q1
\v 20 Ко ходи с мудрима постаје мудар,  
\q2 а ко се држи с безумницима постаје гори.   
\q1
\v 21 Грешнике гони зло,  
\q2 а праведницима се враћа добро.   
\q1
\v 22 Добар човек оставља наследство синовима синова својих,  
\q2 а грешниково имање чува се праведнику.   
\q1
\v 23 Изобила хране има на њиви сиромашкој,  
\q2 а има ко пропада са зле управе.   
\q1
\v 24 Ко жали прут, мрзи на сина свог;  
\q2 а ко га љуби, кара га за времена.   
\q1
\v 25 Праведник једе, и сита му је душа;  
\q2 а трбух безбожницима нема доста.   
\c 14  
\s1 Похвала правој мудрости у човечијем животу.  
\q1
\v 1 Мудра жена зида кућу своју,  
\q2 а луда својим рукама раскопава.   
\q1
\v 2 Ко ходи право, боји се Господа;  
\q2 а ко је опак на својим путевима, презире Га.   
\q1
\v 3 У устима је безбожниковим прут охолости,  
\q2 а мудре чувају уста њихова.   
\q1
\v 4 Где нема волова, чисте су јасле;  
\q2 а обилата је летина од силе воловске.   
\q1
\v 5 Истинит сведок не лаже,  
\q2 а лажан сведок говори лаж.   
\q1
\v 6 Подсмевач тражи мудрост, и не находи је;  
\q2 а разумном је знање лако наћи.   
\q1
\v 7 Иди од човека безумног,  
\q2 јер нећеш чути паметне речи.   
\q1
\v 8 Мудрост је паметног да пази на пут свој,  
\q2 а безумље је безумних превара.   
\q1
\v 9 Безумнима је шала грех,  
\q2 а међу праведнима је добра воља.   
\q1
\v 10 Срце свачије зна јад душе своје;  
\q2 и у весеље његово не меша се други.   
\q1
\v 11 Дом безбожнички раскопаће се,  
\q2 а колиба праведних цветаће.   
\q1
\v 12 Неки се пут чини човеку прав,  
\q2 а крај му је пут к смрти.   
\q1
\v 13 И од смеха боли срце,  
\q2 и весељу крај бива жалост.   
\q1
\v 14 Путева својих наситиће се ко је изопаченог срца,  
\q2 али га се клони човек добар.   
\q1
\v 15 Луд верује свашта,  
\q2 а паметан пази на своје кораке.   
\q1
\v 16 Мудар се боји и уклања се од зла,  
\q2 а безуман навире и слободан је.   
\q1
\v 17 Нагао човек чини безумље,  
\q2 а пакостан је човек мрзак.   
\q1
\v 18 Луди наслеђује безумље,  
\q2 а разборити венчава се знањем.   
\q1
\v 19 Клањају се зли пред добрима  
\q2 и безбожни на вратима праведног.   
\q1
\v 20 Убоги је мрзак и пријатељу свом,  
\q2 а богати имају много пријатеља.   
\q1
\v 21 Ко презире ближњег свог греши;  
\q2 а ко је милостив убогима, благо њему.   
\q1
\v 22 Који смишљају зло, не лутају ли?  
\q2 А милост и вера биће онима који смишљају добро.   
\q1
\v 23 У сваком труду има добитка,  
\q2 а говор уснама само је сиромаштво.   
\q1
\v 24 Мудрима је венац богатство њихово,  
\q2 а безумље безумних остаје безумље.   
\q1
\v 25 Истинит сведок избавља душе,  
\q2 а лажан говори превару.   
\q1
\v 26 У страху је Господњем јако поуздање,  
\q2 и синовима је уточиште.   
\q1
\v 27 Страх је Господњи извор животу  
\q2 да се човек сачува од пругала смртних.   
\q1
\v 28 У мноштву је народа слава цару;  
\q2 а кад нестаје народа, пропаст је владаоцу.   
\q1
\v 29 Ко је спор на гнев, велика је разума;  
\q2 а ко је нагао показује лудост.   
\q1
\v 30 Живот је телу срце здраво,  
\q2 а завист је трулеж у костима.   
\q1
\v 31 Ко чини криво убогоме, срамоти Створитеља његовог;  
\q2 а поштује Га ко је милостив сиромаху.   
\q1
\v 32 За зло своје повргнуће се безбожник,  
\q2 а праведник нада се и на самрти.   
\q1
\v 33 Мудрост почива у срцу разумног човека,  
\q2 а шта је у безумнима познаје се.   
\q1
\v 34 Правда подиже народ,  
\q2 а грех је срамота народима.   
\q1
\v 35 Мио је цару разуман слуга,  
\q2 али на срамотног гневи се.   
\c 15  
\s1 Мудрост доноси спасење, а безумље и грехови пропаст.  
\q1
\v 1 Одговор благ утишава гнев,  
\q2 а реч прека подиже срдњу.   
\q1
\v 2 Језик мудрих људи украшава знање,  
\q2 а уста безумних просипају безумље.   
\q1
\v 3 Очи су Господње на сваком месту  
\q2 гледајући зле и добре.   
\q1
\v 4 Здрав је језик дрво животно,  
\q2 а опачина с њега кршење од ветра.   
\q1
\v 5 Луд се руга наставом оца свог;  
\q2 а ко прима укор бива паметан.   
\q1
\v 6 У кући праведниковој има много блага;  
\q2 а у дохотку је безбожниковом расап.   
\q1
\v 7 Усне мудрих људи сеју знање,  
\q2 а срце безумничко не чини тако.   
\q1
\v 8 Жртва је безбожничка гад Господу,  
\q2 а молитва праведних угодна Му је.   
\q1
\v 9 Гад је Господу пут безбожников;  
\q2 а ко иде за правдом, њега љуби.   
\q1
\v 10 Карање је зло ономе ко оставља пут;  
\q2 који мрзи на укор, умреће.   
\q1
\v 11 Пакао је и погибао пред Господом,  
\q2 а камоли срца синова човечијих.   
\q1
\v 12 Подсмевач не љуби оног ко га кори,  
\q2 нити иде к мудрима.   
\q1
\v 13 Весело срце весели лице,  
\q2 а жалост у срцу обара дух.   
\q1
\v 14 Срце разумно тражи знање,  
\q2 а уста безумних људи наслађују се безумљем.   
\q1
\v 15 Сви су дани невољникови зли;  
\q2 а ко је веселог срца, на гозби је једнако.   
\q1
\v 16 Боље је мало са страхом Господњим  
\q2 него велико благо с немиром.   
\q1
\v 17 Боље је јело од зеља где је љубав  
\q2 него од вола угојена где је мржња.   
\q1
\v 18 Човек гневљив замеће распру;  
\q2 а ко је спор на гнев, утишава свађу.   
\q1
\v 19 Пут је лењога као ограда од трња,  
\q2 а стаза је праведних насута.   
\q1
\v 20 Мудар је син радост оцу,  
\q2 а човек безуман презире матер своју.   
\q1
\v 21 Безумље је радост безумнику,  
\q2 а разуман човек ходи право.   
\q1
\v 22 Намере се расипају кад нема савета,  
\q2 а тврдо стоје где је много саветника.   
\q1
\v 23 Радује се човек одговором уста својих,  
\q2 и реч у време како је добра!   
\q1
\v 24 Пут к животу иде горе разумноме  
\q2 да се сачува од пакла одоздо.   
\q1
\v 25 Господ раскопава кућу поноситима,  
\q2 а међу удовици утврђује.   
\q1
\v 26 Мрске су Господу мисли зле,  
\q2 а беседе чистих миле су.   
\q1
\v 27 Лакомац затире своју кућу,  
\q2 а ко мрзи на поклоне жив ће бити.   
\q1
\v 28 Срце праведниково премишља шта ће говорити,  
\q2 а уста безбожничка ригају зло.   
\q1
\v 29 Далеко је Господ од безбожних,  
\q2 а молитву праведних чује.   
\q1
\v 30 Вид очни весели срце,  
\q2 добар глас гоји кости.   
\q1
\v 31 Ухо које слуша карање животно  
\q2 наставаће међу мудрима.   
\q1
\v 32 Ко одбацује наставу, не мари за душу своју;  
\q2 а ко слуша карање, бива разуман.   
\q1
\v 33 Страх је Господњи настава к мудрости,  
\q2 и пре славе иде смерност.   
\c 16  
\s1 Бог види човечија дела.  
\q1
\v 1 Човек спрема срце,  
\q2 али је од Господа шта ће језик говорити.   
\q1
\v 2 Човеку се сви путеви његови чине чисти,  
\q2 али Господ испитује духове.   
\q1
\v 3 Остави на Господа дела своја,  
\q2 и биће тврде намере твоје.   
\q1
\v 4 Господ је створио све сам за се,  
\q2 и безбожника за зли дан.   
\q1
\v 5 Мрзак је Господу ко је год поноситог срца,  
\q2 и неће остати без кара ако ће и друге узети у помоћ.   
\q1
\v 6 Милошћу и истином очишћа се безакоње,  
\q2 и страхом Господњим уклања се човек ода зла.   
\q1
\v 7 Кад су чији путеви мили Господу,  
\q2 мири с њим и непријатеље његове.   
\q1
\v 8 Боље је мало с правдом  
\q2 него много доходака с неправдом.   
\q1
\v 9 Срце човечије измишља себи пут,  
\q2 али Господ управља кораке његове.   
\q1
\v 10 Пророштво је на уснама царевим,  
\q2 у суду неће погрешити уста његова.   
\q1
\v 11 Мерила и потези прави од Господа су,  
\q2 и све камење у тобоцу његово је дело.   
\q1
\v 12 Гадно је царевима чинити неправду,  
\q2 јер се правдом утврђује престо.   
\q1
\v 13 Миле су царевима усне праведне,  
\q2 и они љубе оног који говори право.   
\q1
\v 14 Гнев је царев гласник,  
\q2 али мудар човек ублажиће га.   
\q1
\v 15 У веселу је лицу царевом живот,  
\q2 и љубав је његова као облак с позним даждем.   
\q1
\v 16 Колико је боље тећи мудрост него злато!  
\q2 И тећи разум колико је лепше него сребро!   
\q1
\v 17 Пут је праведних уклањање ода зла;  
\q2 чува душу своју ко пази на пут свој.   
\q1
\v 18 Охолост долази пред погибао,  
\q2 и поносит дух пред пропаст.   
\q1
\v 19 Боље је бити понизног духа с кроткима  
\q2 него делити плен с охолима.   
\q1
\v 20 Ко пази на реч, налази добро,  
\q2 и ко се узда у Господа, благо њему.   
\q1
\v 21 Ко је мудрог срца, зове се разуман,  
\q2 а сласт на уснама умножава науку.   
\q1
\v 22 Извор је животу разум онима који га имају,  
\q2 а наука безумних безумље је.   
\q1
\v 23 Срце мудрога разумно управља устима његовим,  
\q2 и додаје науку уснама његовим.   
\q1
\v 24 Љубазне су речи саће меда,  
\q2 сласт души и здравље костима.   
\q1
\v 25 Неки се пут чини човеку прав,  
\q2 а крај му је пут к смрти.   
\q1
\v 26 Ко се труди себи се труди,  
\q2 јер га нагоне уста његова.   
\q1
\v 27 Човек неваљао копа зло,  
\q2 и на уснама му је као огањ који пали.   
\q1
\v 28 Опак човек замеће свађу,  
\q2 и опадач раставља главне пријатеље.   
\q1
\v 29 Насилник мами друга свог  
\q2 и заводи га на пут који није добар;   
\q1
\v 30 Намигује очима, кад мисли наопако;  
\q2 кад миче уснама, чини зло.   
\q1
\v 31 Седа је коса славна круна,  
\q2 налази се на путу праведном.   
\q1
\v 32 Бољи је спор на гнев него јунак,  
\q2 и господар од свог срца бољи је него онај који узме град.   
\q1
\v 33 Ждреб се баца у крило,  
\q2 али је од Господа све што излази.   
\c 17  
\s1 Мудрост и безумље особито у говору.  
\q1
\v 1 Бољи је залогај сувог хлеба с миром  
\q2 него кућа пуна поклане стоке са свађом.   
\q1
\v 2 Разуман слуга биће господар над сином срамотним  
\q2 и с браћом ће делити наследство.   
\q1
\v 3 Топионица је за сребро и пећ за злато,  
\q2 а срца искушава Господ.   
\q1
\v 4 Зао човек пази на усне зле,  
\q2 а лажљивац слуша језик пакостан.   
\q1
\v 5 Ко се руга сиромаху, срамоти Створитеља његовог;  
\q2 ко се радује несрећи, неће остати без кара.   
\q1
\v 6 Венац су старцима унуци,  
\q2 а слава синовима оци њихови.   
\q1
\v 7 Не приличи безумном висока беседа,  
\q2 а камоли кнезу лажљива беседа.   
\q1
\v 8 Поклон је драги камен ономе који га прима,  
\q2 куда се год окрене напредује.   
\q1
\v 9 Ко покрива преступ, тражи љубав;  
\q2 а ко понавља ствар, раставља главне пријатеље.   
\q1
\v 10 Укор тишти разумног  
\q2 већма него лудог сто удараца.   
\q1
\v 11 Зао човек тражи само одмет,  
\q2 али ће се љут гласник послати на њ.   
\q1
\v 12 Боље је да човека срете медведица којој су отети медведићи,  
\q2 него безумник у свом безумљу.   
\q1
\v 13 Ко враћа зло за добро,  
\q2 неће се зло одмаћи од куће његове.   
\q1
\v 14 Ко почне свађу, отвори уставу води;  
\q2 зато пре него се заметне, прођи се распре.   
\q1
\v 15 Ко оправда кривога и ко осуди правога,  
\q2 обојица су гад Господу.   
\q1
\v 16 На шта је благо безумном у руци  
\q2 кад нема разума да прибави мудрост?   
\q1
\v 17 У свако доба љуби пријатељ,  
\q2 и брат постаје у невољи.   
\q1
\v 18 Човек безуман даје руку  
\q2 и јамчи се за пријатеља свог.   
\q1
\v 19 Ко милује свађу, милује грех;  
\q2 ко подиже увис врата своја, тражи погибао.   
\q1
\v 20 Ко је опаког срца, неће наћи добра;  
\q2 и ко дволичи језиком, пашће у зло.   
\q1
\v 21 Ко роди безумна, на жалост му је,  
\q2 нити ће се радовати отац лудога.   
\q1
\v 22 Срце весело помаже као лек,  
\q2 а дух жалостан суши кости.   
\q1
\v 23 Безбожник прима поклон из недара  
\q2 да преврати путеве правди.   
\q1
\v 24 Разумном је на лицу мудрост,  
\q2 а очи безумнику врљају накрај земље.   
\q1
\v 25 Жалост је оцу свом син безуман,  
\q2 и јад родитељци својој.   
\q1
\v 26 Није добро глобити праведника,  
\q2 ни да кнезови бију кога што је радио право.   
\q1
\v 27 Устеже речи своје човек који зна,  
\q2 и тиха је духа човек разуман.   
\q1
\v 28 И безуман кад ћути, мисли се да је мудар,  
\q2 и разуман, кад стискује усне своје.   
\c 18  
\s1 Пријатељство и мирољубивост.  
\q1
\v 1 Човек самовољан тражи шта је њему мило  
\q2 и меша се у свашта.   
\q1
\v 2 Безумнику није мио разум  
\q2 него да се јавља срце његово.   
\q1
\v 3 Кад дође безбожник, дође и руг,  
\q2 и прекор са срамотом.   
\q1
\v 4 Речи су из уста човечијих дубока вода,  
\q2 извор је мудрости поток који се разлива.   
\q1
\v 5 Није добро гледати безбожнику ко је,  
\q2 да се учини криво правом на суду.   
\q1
\v 6 Усне безумникове пристају у свађу,  
\q2 и уста његова дозивају бој.   
\q1
\v 7 Безумнику су уста његова погибао,  
\q2 и усне његове пругло души његовој.   
\q1
\v 8 Речи су опадачеве као избијених,  
\q2 али силазе унутра у трбух.   
\q1
\v 9 И ко је немаран у послу свом  
\q2 брат је распикући.   
\q1
\v 10 Тврда је кула име Господње.  
\q2 К Њему ће побећи праведник, и биће у високом заклону.   
\q1
\v 11 Богатство је богатом јак град  
\q2 и као висок зид у његовој мисли.   
\q1
\v 12 Пред пропаст подиже се срце човека,  
\q2 а пре славе иде смерност.   
\q1
\v 13 Ко одговара пре него чује,  
\q2 томе је лудост и срамота.   
\q1
\v 14 Дух човечији сноси бол свој;  
\q2 а дух оборен ко ће подигнути?   
\q1
\v 15 Срце разумног човека добавља знање,  
\q2 и ухо мудрих тражи знање.   
\q1
\v 16 Дар човеку шири место  
\q2 и води га пред властеље.   
\q1
\v 17 Праведан се чини ко је први у својој распри,  
\q2 али кад дође ближњи његов, испитује се.   
\q1
\v 18 Распре прекида жреб,  
\q2 и између силних расуђује.   
\q1
\v 19 Увређен је брат као тврд град,  
\q2 и свађа је као преворница на двору.   
\q1
\v 20 Сваком се трбух сити плодом уста његових,  
\q2 дохотком од усна својих сити се.   
\q1
\v 21 Смрт је и живот у власти језику,  
\q2 и ко га милује, јешће плод његов.   
\q1
\v 22 Ко је нашао жену, нашао је добро  
\q2 и добио љубав од Господа.   
\q1
\v 23 Сиромах говори молећи,  
\q2 а богат одговара оштро.   
\q1
\v 24 Ко има пријатеља, ваља да поступа пријатељски,  
\q2 јер има пријатеља вернијих од брата.   
\c 19  
\s1 Побожно сиромаштво, штета од безумља, од лењости и од потсмевања.  
\q1
\v 1 Сиромах који ходи у безазлености својој бољи је  
\q2 него опаки уснама својим, који је безуман.   
\q1
\v 2 Кад је душа без знања, није добро;  
\q2 и ко је брзих ногу, спотиче се.   
\q1
\v 3 Лудост човечија превраћа пут његов,  
\q2 а срце се његово гневи на Господа.   
\q1
\v 4 Богатство прибавља много пријатеља,  
\q2 а сиромаха оставља пријатељ његов.   
\q1
\v 5 Лажан сведок неће остати без кара,  
\q2 и ко говори лаж, неће побећи.   
\q1
\v 6 Многи угађају кнезу,  
\q2 и свак је пријатељ човеку податљивом.   
\q1
\v 7 На сиромаха мрзе сва браћа његова,  
\q2 још више се пријатељи његови удаљују од њега;  
\q2 виче за њима, али их нема.   
\q1
\v 8 Ко прибавља разум, љуби душу своју;  
\q2 и ко пази на мудрост, наћи ће добро.   
\q1
\v 9 Сведок лажан неће остати без кара,  
\q2 и ко говори лаж, погинуће.   
\q1
\v 10 Не доликују безумном милине,  
\q2 ни слузи да влада кнезовима.   
\q1
\v 11 Разум задржава човека од гнева,  
\q2 и част му је мимоићи кривицу.   
\q1
\v 12 Царева је срдња као рика младог лава,  
\q2 и љубав је његова као роса трави.   
\q1
\v 13 Безуман је син мука оцу свом,  
\q2 и свадљивост женина непрестано прокисивање.   
\q1
\v 14 Кућа и имање наслеђује се од отаца;  
\q2 а од Господа је разумна жена.   
\q1
\v 15 Леност наводи тврд сан,  
\q2 и немарљива душа гладоваће.   
\q1
\v 16 Ко држи заповести, чува душу своју;  
\q2 а ко не мари за путеве своје, погинуће.   
\q1
\v 17 Господу позаима ко поклања сиромаху,  
\q2 и платиће му за добро његово.   
\q1
\v 18 Карај сина свог докле има надања  
\q2 и на погибао његову да не прашта душа твоја.   
\q1
\v 19 Велик гнев показуј кад прашташ кар,  
\q2 и кад опростиш, после већма покарај.   
\q1
\v 20 Слушај савет и примај наставу,  
\q2 да после будеш мудар.   
\q1
\v 21 Много има мисли у срцу човечијем,  
\q2 али шта Господ науми оно ће остати.   
\q1
\v 22 Жеља човеку треба да је да чини милост,  
\q2 а бољи је сиромах него лажа.   
\q1
\v 23 Страх је Господњи на живот;  
\q2 у кога је он, борави сит, нити га походи зло.   
\q1
\v 24 Лењивац крије руку своју у недра,  
\q2 ни к устима својим не приноси је.   
\q1
\v 25 Удри подсмевача да луди омудра,  
\q2 и разумног накарај да разуме науку.   
\q1
\v 26 Син срамотан и прекоран  
\q2 упропашћује оца и одгони матер.   
\q1
\v 27 Немој, сине, слушати науке која одводи од речи разумних.   
\q1
\v 28 Неваљао сведок подсмева се правди,  
\q2 и уста безбожника прождиру на неправду.   
\q1
\v 29 Готови су подсмевачима судови  
\q2 и безумницима бој на леђа.   
\c 20  
\s1 Опомена због неумерности у јелу и пићу, и због необузданости.  
\q1
\v 1 Вино је подсмевач и силовито пиће немирник,  
\q2 и ко год за њим лута неће бити мудар.   
\q1
\v 2 Страх је царев као рика младог лава;  
\q2 ко га дражи, греши својој души.   
\q1
\v 3 Слава је човеку да се окани свађе;  
\q2 а ко је год безуман, уплеће се.   
\q1
\v 4 Ради зиме ленивац не оре;  
\q2 проси о жетви, и ништа не добија.   
\q1
\v 5 Савет је у срцу човечијем дубока вода,  
\q2 али човек разуман црпе га.   
\q1
\v 6 Највише људи хвали се својом добротом;  
\q2 али ко ће наћи човека истинитог?   
\q1
\v 7 Праведник једнако ходи у безазлености својој;  
\q2 благо синовима његовим после њега!   
\q1
\v 8 Цар седећи на престолу судском  
\q2 расипа очима својим свако зло.   
\q1
\v 9 Ко може рећи:  
\q2 Очистио сам срце своје, чист сам од греха свог?   
\q1
\v 10 Двојак потег и двојака мера,  
\q2 обоје је мрско Господу.   
\q1
\v 11 По делима својим познаје се и дете  
\q2 хоће ли бити чисто и хоће ли бити право дело његово.   
\q1
\v 12 Ухо које чује, и око које види,  
\q2 обоје је Господ начинио.   
\q1
\v 13 Не љуби сна, да не осиромашиш;  
\q2 отварај очи своје, и бићеш сит хлеба.   
\q1
\v 14 Не ваља, не ваља, говори ко купује,  
\q2 а кад отиде онда се хвали.   
\q1
\v 15 Има злата и много бисера,  
\q2 али су мудре усне најдрагоценији накит.   
\q1
\v 16 Узми хаљину ономе који се подјемчи за туђина,  
\q2 узми залог од њега за туђинку.   
\q1
\v 17 Сладак је човеку хлеб од преваре,  
\q2 али му се после напуне уста песка.   
\q1
\v 18 Мисли се утврђују саветом;  
\q2 зато разумно ратуј.   
\q1
\v 19 Ко открива тајну, поступа неверно;  
\q2 зато се не мешај с оним који разваљује уста.   
\q1
\v 20 Ко псује оца свог или матер своју,  
\q2 његов ће се жижак угасити у црном мраку.   
\q1
\v 21 Наследство које се из почетка брзо добија,  
\q2 не бива на послетку благословено.   
\q1
\v 22 Не говори: Вратићу зло.  
\q2 Чекај Господа, и сачуваће те.   
\q1
\v 23 Мрзак је Господу двојак потег,  
\q2 мерила лажна нису добра.   
\q1
\v 24 Од Господа су кораци човечји,  
\q2 а човек како ће разумети пут његов?   
\q1
\v 25 Замка је човеку да прождре светињу,  
\q2 и после завета опет да тражи.   
\q1
\v 26 Мудар цар расипа безбожнике  
\q2 и пушта на њих коло.   
\q1
\v 27 Видело је Господње душа човечија,  
\q2 истражује све што је у срцу.   
\q1
\v 28 Милост и истина чувају цара,  
\q2 и милошћу подупире свој престо.   
\q1
\v 29 Слава је младићима сила њихова,  
\q2 а старцима част седа коса.   
\q1
\v 30 Модрице од боја и ударци који продиру до срца јесу лек зломе.   
\c 21  
\s1 Божији промисао управља срцима и путевима људским.  
\q1
\v 1 Срце је царево у руци Господу као потоци водени;  
\q2 куда год хоће, савија га.   
\q1
\v 2 Сваки се пут човеку чини прав,  
\q2 али Господ испитује срца.   
\q1
\v 3 Да се чини правда и суд,  
\q2 милије је Господу него жртва.   
\q1
\v 4 Поносите очи и надуто срце и орање безбожничко грех је.   
\q1
\v 5 Мисли вредног човека доносе обиље,  
\q2 а сваког нагла сиромаштво.   
\q1
\v 6 Благо сабрано језиком лажљивим таштина је  
\q2 која пролази међу оне који траже смрт.   
\q1
\v 7 Грабеж безбожних однеће их,  
\q2 јер не хтеше чинити што је право.   
\q1
\v 8 Чији је пут крив, он је туђ;  
\q2 а ко је чист, његово је дело право.   
\q1
\v 9 Боље је седети у углу од крова  
\q2 него са женом свадљивом у кући заједничкој.   
\q1
\v 10 Душа безбожникова жели зло,  
\q2 ни пријатељ његов не налази милости у њега.   
\q1
\v 11 Кад подсмевач бива каран, луди мудра;  
\q2 и кад се мудри поучава, прима знање.   
\q1
\v 12 Учи се праведник од куће безбожникове,  
\q2 кад се безбожници обарају у зло.   
\q1
\v 13 Ко затискује ухо своје од вике убогог, викаће и сам,  
\q2 али неће бити услишен.   
\q1
\v 14 Дар у тајности утишава гнев  
\q2 и поклон у недрима жестоку срдњу.   
\q1
\v 15 Радост је праведнику чинити што је право,  
\q2 а страх онима који чине безакоње.   
\q1
\v 16 Човек који зађе с пута мудрости  
\q2 починуће у збору мртвих.   
\q1
\v 17 Ко љуби весеље, биће сиромах;  
\q2 ко љуби вино и уље, неће се обогатити.   
\q1
\v 18 Откуп за праведнике биће безбожник  
\q2 и за добре безаконик.   
\q1
\v 19 Боље је живети у земљи пустој  
\q2 него са женом свадљивом и гневљивом.   
\q1
\v 20 Драгоцено је благо и уље у стану мудрога,  
\q2 а човек безуман прождире га.   
\q1
\v 21 Ко иде за правдом и милошћу,  
\q2 наћи ће живот, правду и славу.   
\q1
\v 22 У град јаких улази мудри,  
\q2 и обара силу у коју се уздају.   
\q1
\v 23 Ко чува уста своја и језик свој,  
\q2 чува душу своју од невоља.   
\q1
\v 24 Поноситом и обесном име је подсмевач,  
\q2 који све ради бесно и охоло.   
\q1
\v 25 Лењивца убија жеља,  
\q2 јер руке његове неће да раде;   
\q1
\v 26 Сваки дан жели;  
\q2 а праведник даје и не штеди.   
\q1
\v 27 Жртва је безбожничка гад,  
\q2 а камоли кад је приносе у греху?   
\q1
\v 28 Лажни сведок погинуће,  
\q2 а човек који слуша говориће свагда.   
\q1
\v 29 Безбожник је безобразан,  
\q2 а праведник удешава своје путе.   
\q1
\v 30 Нема мудрости ни разума ни савета насупрот Богу.   
\q1
\v 31 Коњ се опрема за дан боја,  
\q2 али је у Господа спасење.   
\c 22  
\s1 О добром имену – како се стиче и губи.  
\q1
\v 1 Боље је име него велико богатство,  
\q2 и милост је боља него сребро и злато.   
\q1
\v 2 Богат и сиромах сретају се;  
\q2 обојицу је Господ створио.   
\q1
\v 3 Паметан човек види зло и склони се,  
\q2 а луди иду даље и плаћају.   
\q1
\v 4 Смерности и страху Господњем  
\q2 плата је богатство и слава и живот.   
\q1
\v 5 Трње и замке су на путу опакога;  
\q2 ко чува душу своју, биће далеко од тога.   
\q1
\v 6 Учи дете према путу којим ће ићи,  
\q2 па неће одступити од њега ни кад остари.   
\q1
\v 7 Богат господари над сиромасима,  
\q2 и ко узима у зајам бива слуга ономе који даје.   
\q1
\v 8 Ко сеје безакоње жеће муку,  
\q2 и прут гнева његовог нестаће.   
\q1
\v 9 Благо око биће благословено,  
\q2 јер даје хлеба свог убогом.   
\q1
\v 10 Отерај подсмевача, и отићи ће распра  
\q2 и престаће свађа и срамота.   
\q1
\v 11 Ко љуби чисто срце, и чије су усне љубазне,  
\q2 њему је цар пријатељ.   
\q1
\v 12 Очи Господње чувају знање,  
\q2 а послове безаконикове обара.   
\q1
\v 13 Ленивац говори:  
\q2 Лав је напољу; насред улице погинуо бих.   
\q1
\v 14 Уста су туђих жена јама дубока;  
\q2 на кога се гневи Господ онамо ће пасти.   
\q1
\v 15 Безумље је привезано детету на срце;  
\q2 прут којим се кара уклониће га од њега.   
\q1
\v 16 Ко чини криво сиромаху да умножи своје, и ко даје богатоме,  
\q2 зацело ће осиромашити.   
\b  
\q1
\v 17 Пригни ухо своје и слушај речи мудрих људи,  
\q2 и срце своје привиј к науци мојој.   
\q1
\v 18 Јер ће ти бити милина ако их сложиш у срце своје,  
\q2 ако све буду поређане на уснама твојим.   
\q1
\v 19 Да би ти уздање било у Господа, казујем ти ово данас,  
\q2 а ти тако чини.   
\q1
\v 20 Нисам ли ти написао знамените ствари за савете и знање,   
\q1
\v 21 Да бих ти показао тврђу истинитих речи  
\q2 да би могао истинитим речима одговарати онима који пошаљу к теби?   
\b  
\q1
\v 22 Не отимај сиромаху зато што је сиромах,  
\q2 и не затири невољнога на вратима.   
\q1
\v 23 Јер ће Господ бранити њихову ствар,  
\q2 и отеће душу онима који њима отимају.   
\q1
\v 24 Не дружи се с човеком гневљивим  
\q2 и не иди са жестоким,   
\q1
\v 25 Да се не би навикао на путеве његове  
\q2 и метнуо замке на душу своју.   
\q1
\v 26 Не буди од оних који руку дају,  
\q2 који се јамче за дугове.   
\q1
\v 27 Ако немаш чим платити,  
\q2 зашто да се однесе постеља испод тебе?   
\q1
\v 28 Не помичи старе међе,  
\q2 коју су поставили оци твоји.   
\q1
\v 29 Јеси ли видео човека устаоца на послу?  
\q2 Такви ће пред царевима стајати,  
\q2 а неће стајати пред простацима.   
\c 23  
\s1 Поуке о мудрости у животу и о побожности.  
\q1
\v 1 Кад седнеш да једеш с господином,  
\q2 пази добро шта је пред тобом.   
\q1
\v 2 Иначе би сатерао себи нож у грло,  
\q2 ако би био лаком.   
\q1
\v 3 Не жели преслачке његове,  
\q2 јер су лажна храна.   
\q1
\v 4 Не мучи се да се обогатиш,  
\q2 и прођи се своје мудрости.   
\q1
\v 5 Хоћеш ли бацити очи своје на оно чега брзо нестаје?  
\q2 Јер начини себи крила и као орао одлети у небо.   
\q1
\v 6 Не једи хлеба у завидљивца,  
\q2 и не жели преслачака његових.   
\q1
\v 7 Јер како он тебе цени у души својој тако ти јело његово.  
\q2 Говориће ти: Једи и пиј; али срце његово није с тобом.   
\q1
\v 8 Залогај што поједеш избљуваћеш,  
\q2 и изгубићеш љубазне речи своје.   
\q1
\v 9 Пред безумним не говори,  
\q2 јер неће марити за мудрост беседе твоје.   
\q1
\v 10 Не помичи старе међе,  
\q2 и не ступај на њиву сирочади.   
\q1
\v 11 Јер је јак осветник њихов;  
\q2 браниће ствар њихову од тебе.   
\q1
\v 12 Обрати к науци срце своје  
\q2 и уши своје к речима мудрим.   
\q1
\v 13 Не ускраћуј кар детету;  
\q2 кад га бијеш прутом, неће умрети.   
\q1
\v 14 Ти га биј прутом,  
\q2 и душу ћеш му избавити из пакла.   
\q1
\v 15 Сине мој, ако буде мудро срце твоје,  
\q2 веселиће се срце моје у мени;   
\q1
\v 16 И играће бубрези моји  
\q2 кад усне твоје стану говорити што је право.   
\q1
\v 17 Срце твоје нека не завиди грешницима,  
\q2 него буди у страху Господњем увек.   
\q1
\v 18 Јер има плата,  
\q2 и надање твоје неће се затрти.   
\b  
\q1
\v 19 Слушај, сине мој, и буди мудар  
\q2 и управи путем срце своје.   
\q1
\v 20 Не буди међу пијаницама ни међу изјелицама.   
\q1
\v 21 Јер пијаница и изјелица осиромашиће,  
\q2 и спавач ходиће у ритама.   
\b  
\q1
\v 22 Слушај оца свог који те је родио,  
\q2 и не презири матере своје кад остари.   
\q1
\v 23 Купуј истину и не продаји је;  
\q2 купуј мудрост, знање и разум.   
\q1
\v 24 Веома се радује отац праведников,  
\q2 и родитељ мудрога весели се с њега.   
\q1
\v 25 Нека се, дакле, весели отац твој и мати твоја,  
\q2 и нека се радује родитељка твоја.   
\b  
\q1
\v 26 Сине мој, дај ми срце своје,  
\q2 и очи твоје нека пазе на моје путе.   
\q1
\v 27 Јер је курва дубока јама,  
\q2 а тесан студенац туђа жена.   
\q1
\v 28 Она и заседа као лупеж  
\q2 и умножава злочинце међу људима.   
\b  
\q1
\v 29 Коме: Јаох? Коме: Куку?  
\q2 Коме свађа? Коме вика?  
\q1 Коме ране низашта?  
\q2 Коме црвен у очима?   
\q1
\v 30 Који седе код вина,  
\q2 који иду те траже растворено вино.   
\q1
\v 31 Не гледај на вино кад се румени,  
\q2 кад у чаши показује лице своје и управо искаче.   
\q1
\v 32 На последак ће као змија ујести  
\q2 и као аспида упећи.   
\q1
\v 33 Очи ће твоје гледати на туђе жене,  
\q2 и срце ће твоје говорити опачине.   
\q1
\v 34 И бићеш као онај који лежи усред мора  
\q2 и као онај који спава поврх једра.   
\q1
\v 35 Рећи ћеш: Избише ме, али ме не заболе;  
\q2 тукоше ме, али не осетих;  
\q1 кад се пробудим, ићи ћу опет да тражим то.   
\c 24  
\s1 Опомене да будемо стрпљиви и помирљиви.  
\q1
\v 1 Не завиди злим људима  
\q2 нити жели да си с њима.   
\q1
\v 2 Јер о погибли мисли срце њихово  
\q2 и усне њихове говоре о муци.   
\b  
\q1
\v 3 Мудрошћу се зида кућа  
\q2 и разумом утврђује се.   
\q1
\v 4 И знањем се пуне клети сваког блага и драгоцена и мила.   
\q1
\v 5 Мудар је човек јак,  
\q2 и разуман је човек силан снагом.   
\q1
\v 6 Јер мудрим саветом ратоваћеш,  
\q2 и избављење је у мноштву саветника.   
\q1
\v 7 Високе су безумноме мудрости;  
\q2 неће отворити уста својих на вратима.   
\b  
\q1
\v 8 Ко мисли зло чинити  
\q2 зваће се зликовац.   
\q1
\v 9 Мисао безумникова грех је,  
\q2 и подсмевач је гад људски.   
\b  
\q1
\v 10 Ако клонеш у невољи,  
\q2 скратиће ти се сила.   
\q1
\v 11 Избављај похватане на смрт;  
\q2 и које хоће да погубе,  
\q2 немој се устегнути од њих.   
\q1
\v 12 Ако ли кажеш: Гле, нисмо знали за то;  
\q2 неће ли разумети Онај који испитује срца,  
\q1 и који чува душу твоју неће ли дознати  
\q2 и платити свакоме по делима његовим?   
\b  
\q1
\v 13 Сине мој, једи мед, јер је добар,  
\q2 и саће, јер је слатко грлу твом.   
\q1
\v 14 Тако ће бити познање мудрости души твојој, кад је нађеш;  
\q2 и биће плата, и надање твоје неће се затрти.   
\b  
\q1
\v 15 Безбожниче, не вребај око стана праведниковог,  
\q2 и не квари му почивање.   
\q1
\v 16 Јер ако и седам пута падне праведник, опет устане,  
\q2 а безбожници пропадају у злу.   
\b  
\q1
\v 17 Кад падне непријатељ твој, немој се радовати,  
\q2 и кад пропадне, нека не игра срце твоје.   
\q1
\v 18 Јер би видео Господ и не би Му било мило,  
\q2 и обратио би гнев свој од њега на тебе.   
\b  
\q1
\v 19 Немој се жестити ради неваљалаца,  
\q2 немој завидети безбожницима.   
\q1
\v 20 Јер нема плате неваљалцу,  
\q2 жижак ће се безбожницима угасити.   
\b  
\q1
\v 21 Бој се Господа, сине мој, и цара,  
\q2 и не мешај се с немирницима.   
\q1
\v 22 Јер ће се уједанпут подигнути погибао њихова,  
\q2 а ко зна пропаст која иде од обојице?   
\b  
\p
\v 23 И ово је за мудраце:  
\b  
\q1 Гледати ко је ко на суду није добро.   
\q1
\v 24 Ко говори безбожнику: Праведан си,  
\q2 њега ће проклињати људи и мрзиће на њ народи.   
\q1
\v 25 А који га карају, они ће бити мили,  
\q2 и доћи ће на њих благослов добрих.   
\q1
\v 26 Ко говори речи истините,  
\q2 у уста љуби.   
\b  
\q1
\v 27 Уреди свој посао на пољу,  
\q2 и сврши своје на њиви,  
\q2 потом и кућу своју зидај.   
\b  
\q1
\v 28 Не буди сведок на ближњег свог без разлога,  
\q2 и не варај уснама својим.   
\q1
\v 29 Не говори: Како је он мени учинио тако ћу ја њему учинити;  
\q2 платићу овом човеку по делу његовом.   
\b  
\q1
\v 30 Иђах мимо њиве човека лењог  
\q2 и мимо винограда човека безумног;   
\q1
\v 31 И гле, беше све зарасло у трње и све покрио чкаљ,  
\q2 и ограда им камена разваљена.   
\q1
\v 32 И видевши узех на ум,  
\q2 и гледах и поучих се.   
\q1
\v 33 Док мало проспаваш, док мало продремљеш,  
\q2 док мало склопиш руке да починеш,   
\q1
\v 34 У том ће доћи сиромаштво твоје као путник,  
\q2 и оскудица твоја као оружан човек.   
\c 25  
\s1 Права је слава бити награђен мудрошћу.  
\p
\v 1 И ово су приче Соломунове које сабраше људи Језекије цара Јудиног.   
\b  
\q1
\v 2 Слава је Божија скривати ствар,  
\q2 а слава је царска истраживати ствар.   
\q1
\v 3 Висина небу и дубина земљи и срце царевима  
\q2 не може се досегнути.   
\q1
\v 4 Узми од сребра троску,  
\q2 и изаћи ће ливцу заклад.   
\q1
\v 5 Узми безбожника испред цара,  
\q2 и утврдиће се правдом престо његов.   
\q1
\v 6 Не величај се пред царем  
\q2 и не стај на место где стоје властељи.   
\q1
\v 7 Јер је боље да ти се каже: Ходи горе,  
\q2 него да те понизе пред кнезом да видиш својим очима.   
\b  
\q1
\v 8 Не иди одмах да се преш,  
\q2 гледај шта би чинио напослетку ако би те осрамотио ближњи твој.   
\q1
\v 9 Расправи ствар своју с ближњим својим,  
\q2 али туђе тајне не откривај,   
\q1
\v 10 Да те не би псовао ко чује,  
\q2 и срамота твоја да не би остала на теби.   
\b  
\q1
\v 11 Златне јабуке у сребрним судима  
\q2 јесу згодне речи.   
\q1
\v 12 Златна је гривна и накит од најбољег злата  
\q2 мудри карач ономе који слуша.   
\q1
\v 13 Веран је посланик као студен снежна о жетви онима који га пошаљу,  
\q2 и расхлађује душу својим господарима.   
\q1
\v 14 Ко се хвали даром лажним,  
\q2 он је као облаци и ветар без дажда.   
\b  
\q1
\v 15 Стрпљењем се ублажава кнез,  
\q2 и мек језик ломи кости.   
\q1
\v 16 Кад нађеш мед, једи колико ти је доста,  
\q2 да не би наједавши га се избљувао га.   
\q1
\v 17 Ретко нека ти нога ступа у кућу ближњег твог,  
\q2 да не би наситивши се тебе омрзао на те.   
\q1
\v 18 Ко год говори лажно сведочанство на ближњег свог,  
\q2 он је као маљ и мач и оштра стрела.   
\q1
\v 19 Уздање је у неверника у невољи  
\q2 зуб сломљен и нога уганута.   
\q1
\v 20 Ко пева песме жалосном срцу,  
\q2 он је као онај који свлачи хаљину на зими,  
\q2 и као оцат на салитру.   
\q1
\v 21 Ако је гладан ненавидник твој, нахрани га хлеба,  
\q2 и ако је жедан напој га воде.   
\q1
\v 22 Јер ћеш живо угљевље згрнути на главу његову,  
\q2 и Господ ће ти платити.   
\q1
\v 23 Северни ветар носи дажд,  
\q2 а потајни језик лице срдито.   
\q1
\v 24 Боље је седети у углу од крова  
\q2 него са женом свадљивом у кући заједничкој.   
\q1
\v 25 Добар је глас из далеке земље  
\q2 као студена вода жедној души.   
\q1
\v 26 Праведник који пада пред безбожником  
\q2 јесте као извор ногама замућен  
\q2 и као студенац покварен.   
\q1
\v 27 Јести много меда није добро,  
\q2 и истраживати славу није славно.   
\q1
\v 28 Ко нема власти над духом својим,  
\q2 он је град разваљен без зидова.   
\c 26  
\s1 Безумни, лењи и лажљиви људи нису вредни никакве части.  
\q1
\v 1 Као снег у лето и дажд о жетви,  
\q2 тако не доликује безумноме част.   
\q1
\v 2 Као врабац кад прхне и ласта кад одлети,  
\q2 тако клетва незаслужена неће доћи.   
\q1
\v 3 Бич коњу, узда магарцу,  
\q2 а батина безумницима на леђа.   
\q1
\v 4 Не одговарај безумнику по безумљу његовом,  
\q2 да не будеш и ти као он.   
\q1
\v 5 Одговори безумнику према безумљу његовом,  
\q2 да не мисли да је мудар.   
\q1
\v 6 Ко шаље безумника да му шта сврши,  
\q2 он одсеца себи ноге и пије неправду.   
\q1
\v 7 Како хроми храмље ногама својим,  
\q2 таква је беседа у устима безумних.   
\q1
\v 8 Као да баца драги камен у гомилу камења,  
\q2 тако ради ко чини част безумноме.   
\q1
\v 9 Као трн кад дође у руку пијаноме,  
\q2 таква је беседа у устима безумних.   
\q1
\v 10 Много муке задаје свима  
\q2 ко плаћа безумнику  
\q2 и ко плаћа преступницима.   
\q1
\v 11 Као што се пас повраћа на своју бљувотину,  
\q2 тако безумник понавља своје безумље.   
\q1
\v 12 Јеси ли видео човека који мисли да је мудар?  
\q2 Више има надања од безумнога него од њега.   
\q1
\v 13 Лењивац говори:  
\q2 Љути је лав на путу, лав је на улицама.   
\q1
\v 14 Као што се врата обрћу на чеповима својим,  
\q2 тако ленивац на постељи својој.   
\q1
\v 15 Ленивац крије руку своју у недра,  
\q2 тешко му је принети је к устима.   
\q1
\v 16 Ленивац мисли да је мудрији од седморице који одговарају разумно.   
\q1
\v 17 Пса за уши хвата  
\q2 ко се пролазећи жести за туђу распру.   
\q1
\v 18 Какав је безумник који баца искре и стреле смртне,   
\q1
\v 19 Такав је сваки који превари ближњег свог  
\q2 па онда вели: Шалио сам се.   
\q1
\v 20 Кад нестане дрва, угаси се огањ;  
\q2 тако кад нема опадача, престаје распра.   
\q1
\v 21 Угаљ је за жеравицу, дрва за огањ,  
\q2 а човек свадљивац да распаљује свађу.   
\q1
\v 22 Речи су опадачеве као речи избијених,  
\q2 али силазе унутра у трбух.   
\q1
\v 23 Као сребрна пена којом се обложи цреп,  
\q2 такве су усне непријатељске и зло срце.   
\q1
\v 24 Ненавидник се претвара устима својим,  
\q2 а у срцу слаже превару.   
\q1
\v 25 Кад говори умиљатим гласом, не веруј му,  
\q2 јер му је у срцу седам гадова.   
\q1
\v 26 Мржња се покрива лукавством,  
\q2 али се злоћа њена открива на збору.   
\q1
\v 27 Ко јаму копа, у њу ће пасти;  
\q2 и ко камен ваља, на њега ће се превалити.   
\q1
\v 28 Језик лажан мрзи на оне које сатире,  
\q2 и уста која ласкају граде погибао.   
\c 27  
\s1 Не треба се хвалити и бити осион.  
\q1
\v 1 Не хвали се сутрашњим даном,  
\q2 јер не знаш шта ће дан донети.   
\q1
\v 2 Нека те хвали други, а не твоја уста,  
\q2 туђин, а не твоје усне.   
\q1
\v 3 Тежак је камен, и песак је тежак;  
\q2 али је гнев безумников тежи од обога.   
\q1
\v 4 Јарост је немилостива, и гнев је плах;  
\q2 али ко ће одолети зависти?   
\q1
\v 5 Бољи је јавни укор него тајна љубав.   
\q1
\v 6 Ударци од пријатеља истинити су,  
\q2 а целиви ненавидникови лажни.   
\q1
\v 7 Душа сита гази саће,  
\q2 а гладној души слатко је све што је горко.   
\q1
\v 8 Каква је птица која одлети из свог гнезда,  
\q2 такав је човек који отиде из свог места.   
\q1
\v 9 Уље и кад весели срце,  
\q2 тако је пријатељ сладак саветом срдачним.   
\q1
\v 10 Не остављај пријатеља свог ни пријатеља оца свог,  
\q2 и у кућу брата свог не улази у несрећи својој:  
\q2 бољи је сусед близу него брат далеко.   
\q1
\v 11 Сине мој, буди мудар и обрадуј срце моје,  
\q2 да имам шта одговорити ономе ко ме ружи.   
\q1
\v 12 Паметан човек види зло и склони се,  
\q2 а луди иду даље и плаћају.   
\q1
\v 13 Узми хаљину ономе који се подјемчи за туђина,  
\q2 и узми залог од њега за туђинку.   
\q1
\v 14 Ко благосиља пријатеља свог на глас рано устајући,  
\q2 примиће му се за клетву.   
\q1
\v 15 Непрестано капање кад је велик дажд,  
\q2 и жена свадљива,  
\q2 једно су;   
\q1
\v 16 Ко је уставља, уставља ветар,  
\q2 и она се одаје као мирисаво уље у десници.   
\q1
\v 17 Гвожђе се гвожђем оштри,  
\q2 тако човек оштри лице пријатеља свог.   
\q1
\v 18 Ко чува смокву, јешће род њен;  
\q2 тако ко чува господара свог, биће поштован.   
\q1
\v 19 Како је у води лице према лицу,  
\q2 тако је срце човечије према човеку.   
\q1
\v 20 Гроб и пропаст никада се не могу заситити,  
\q2 тако очи човечије никада нису сите.   
\q1
\v 21 Сребро у топионици и злато у пећи  
\q2 а човек у устима оног који га хвали  
\q2 познаје се.   
\q1
\v 22 Да безумнога туцаш у ступи с тучком с прекрупом,  
\q2 не би отишло од њега безумље његово.   
\b  
\q1
\v 23 Добро гледај стоку своју  
\q2 и старај се за стада своја.   
\q1
\v 24 Јер богатство не траје довека  
\q2 нити круна од колена до колена.   
\q1
\v 25 Кад трава нарасте и покаже се зелен,  
\q2 купи се трава по планинама.   
\q1
\v 26 Јагањци су ти за одело,  
\q2 и јарићи цена за њиву.   
\q1
\v 27 И доста има млека козјег теби за јело,  
\q2 и за јело твом дому  
\q2 и за храну твојим девојкама.   
\c 28  
\s1 Благословена је побожност и поштење, проклета безбожност.  
\q1
\v 1 Беже безбожници кад их нико не гони,  
\q2 а праведници су као лавићи без страха.   
\q1
\v 2 Кад се у земљи зла чине, настају јој многи кнезови;  
\q2 али кад се нађе човек разуман и вешт, остаје дуго.   
\q1
\v 3 Човек сиромах који чини криво убогима  
\q2 јесте као силан дажд иза ког нестаје хлеба.   
\q1
\v 4 Који остављају закон, хвале безбожнике;  
\q2 а који држе закон, противе им се.   
\q1
\v 5 Зли људи не разумеју шта је право;  
\q2 а који траже Господа, разумеју све.   
\q1
\v 6 Бољи је сиромах који ходи у безазлености својој  
\q2 него ко иде кривим путевима ако је и богат.   
\q1
\v 7 Ко чува закон, син је разуман;  
\q2 а ко се дружи с изјелицама, срамоти оца свог.   
\q1
\v 8 Ко умножава добро своје ујмом и придавком,  
\q2 сабира ономе који ће раздавати сиромасима.   
\q1
\v 9 Ко одвраћа ухо своје да не чује закон,  
\q2 и молитва је његова мрска.   
\q1
\v 10 Ко заводи праве на зао пут, пашће у јаму своју,  
\q2 а безазлени наследиће добро.   
\q1
\v 11 Богат човек мисли да је мудар,  
\q2 али разуман сиромах испитује га.   
\q1
\v 12 Кад се радују праведни, велика је слава;  
\q2 а кад се подижу безбожници, тражи се човек.   
\q1
\v 13 Ко крије преступе своје, неће бити срећан;  
\q2 а ко признаје и оставља, добиће милост.   
\q1
\v 14 Благо човеку који се свагда боји;  
\q2 а ко је тврдоглав, упада у зло.   
\q1
\v 15 Безбожник који влада народом сиромашним,  
\q2 лав је који риче и медвед гладан.   
\q1
\v 16 Кнез без разума чини много неправде,  
\q2 а који мрзи на лакомство, живеће дуго.   
\q1
\v 17 Човек који чини насиље крви људској,  
\q2 бежаће до гроба, а нико га неће задржати.   
\q1
\v 18 Ко ходи у безазлености, спашће се;  
\q2 а ко је опак на путевима, пашће у један мах.   
\q1
\v 19 Ко ради своју земљу, биће сит хлеба;  
\q2 а ко иде за беспослицама, наситиће се сиротиње.   
\q1
\v 20 Човек веран обилује благословима;  
\q2 а ко нагли да се обогати, неће бити без кривице.   
\q1
\v 21 Није добро гледати ко је ко,  
\q2 јер за залогај хлеба човек ће учинити зло.   
\q1
\v 22 Нагли да се обогати човек завидљив,  
\q2 а не зна да ће му доћи сиромаштво.   
\q1
\v 23 Ко укорава човека наћи ће после већу милост  
\q2 него који ласка језиком.   
\q1
\v 24 Ко краде оца свог и матер своју,  
\q2 и говори: Није грех,  
\q2 он је друг крвнику.   
\q1
\v 25 Охоли замеће свађу;  
\q2 а ко се узда у Господа, изобиловаће.   
\q1
\v 26 Ко се узда у своје срце, безуман је;  
\q2 а ко ходи мудро, избавиће се.   
\q1
\v 27 Ко даје сиромаху, неће му недостајати;  
\q2 а ко одвраћа очи своје, биће му много клетава.   
\q1
\v 28 Кад се подижу безбожници, сакрива се човек;  
\q2 а кад гину, умножавају се праведни.   
\c 29  
\s1 Мудрост доноси благослов, а безумље и грехови пропаст.  
\q1
\v 1 Човек који по карању остаје тврдоглав,  
\q2 уједанпут ће пропасти, да неће бити лека.   
\q1
\v 2 Кад се умножавају праведници, весели се народ;  
\q2 а кад влада безбожник, уздише народ.   
\q1
\v 3 Ко љуби мудрост, весели оца свог;  
\q2 а ко се дружи с курвама, расипа своје добро.   
\q1
\v 4 Цар правдом подиже земљу;  
\q2 а ко узима мито, сатире је.   
\q1
\v 5 Ко ласка пријатељу свом,  
\q2 разапиње мрежу ногама његовим.   
\q1
\v 6 У греху је злог човека замка,  
\q2 а праведник пева и весели се.   
\q1
\v 7 Праведник разуме парбу невољних,  
\q2 а безбожник не мари да зна.   
\q1
\v 8 Подсмевачи распаљују град,  
\q2 а мудри утишавају гнев.   
\q1
\v 9 Мудар човек кад се пре с лудим,  
\q2 или се срдио или смејао,  
\q2 нема мира.   
\q1
\v 10 Крвопије мрзе на безазленога,  
\q2 а прави се брину за душу његову.   
\q1
\v 11 Сав гнев свој излива безумник,  
\q2 а мудри уставља га натраг.   
\q1
\v 12 Који кнез слуша лажне речи,  
\q2 све су му слуге безбожне.   
\q1
\v 13 Сиромах и који даје на добит сретају се;  
\q2 обојици Господ просветљује очи.   
\q1
\v 14 Који цар право суди сиромасима,  
\q2 његов ће престо стајати довека.   
\q1
\v 15 Прут и кар дају мудрост,  
\q2 а дете пусто срамоти матер своју.   
\q1
\v 16 Кад се умножавају безбожници, умножавају се греси,  
\q2 а праведници ће видети пропаст њихову.   
\q1
\v 17 Карај сина свог, и смириће те,  
\q2 и учиниће милину души твојој.   
\q1
\v 18 Кад нема утваре, расипа се народ;  
\q2 а ко држи закон, благо њему!   
\q1
\v 19 Речима се не поправља слуга,  
\q2 јер ако и разуме, опет не слуша.   
\q1
\v 20 Јеси ли видео човека наглог у беседи својој?  
\q2 Више има надања од безумног него од њега.   
\q1
\v 21 Ако ко мази слугу од малена,  
\q2 он ће најпосле бити син.   
\q1
\v 22 Гневљив човек замеће свађу,  
\q2 и ко је напрасит, много греши.   
\q1
\v 23 Охолост понижује човека,  
\q2 а ко је смеран духом, добија славу.   
\q1
\v 24 Ко дели с лупежем, мрзи на своју душу,  
\q2 чује проклетство и не проказује.   
\q1
\v 25 Страшљив човек меће себи замку;  
\q2 а ко се у Господа узда, биће у високом заклону.   
\q1
\v 26 Многи траже лице владаочево,  
\q2 али је од Господа суд свакоме.   
\q1
\v 27 Праведнима је мрзак неправедник,  
\q2 а безбожнику је мрзак ко право ходи.   
\c 30  
\s1 Агурова исповест.  
\p
\v 1 Речи Агура сина Јакејевог; сабране речи тог човека Итилу, Итилу и Укалу.   
\b  
\q1
\v 2 Ја сам луђи од сваког,  
\q2 и разума човечијег нема у мене.   
\q1
\v 3 Нити сам учио мудрост  
\q2 нити знам свете ствари.   
\q1
\v 4 Ко је изашао на небо и опет сишао?  
\q2 Ко је скупио ветар у прегршти своје?  
\q1 Ко је свезао воде у плашт свој?  
\q2 Ко је утврдио све крајеве земљи?  
\q1 Како Му је име? И како је име Сину Његовом?  
\q2 Знаш ли?   
\b  
\q1
\v 5 Све су речи Божије чисте;  
\q2 Он је штит онима који се уздају у Њ.   
\q1
\v 6 Ништа не додај к речима Његовим,  
\q2 да те не укори и не нађеш се лажа.   
\b  
\q1
\v 7 За двоје молим Те;  
\q2 немој ме се оглушити док сам жив:   
\q1
\v 8 Таштину и реч лажну удаљи од мене;  
\q2 сиромаштва ни богатства не дај ми,  
\q2 храни ме хлебом по оброку мом,   
\q1
\v 9 Да не бих наједавши се одрекао се Тебе  
\q2 и рекао: Ко је Господ?  
\q1 Или осиромашивши да не бих крао  
\q2 и узалуд узимао име Бога свог.   
\b  
\q1
\v 10 Не опадај слуге господару његовом,  
\q2 да те не би клео и ти био крив.   
\b  
\q1
\v 11 Има род који псује оца свог  
\q2 и не благосиља матере своје.   
\q1
\v 12 Има род који мисли да је чист,  
\q2 а од свог кала није опран.   
\q1
\v 13 Има род који држи високо очи своје,  
\q2 и веђе му се дижу увис.   
\q1
\v 14 Има род коме су зуби мачеви  
\q2 и кутњаци ножеви,  
\q1 да прождире сиромахе са земље  
\q2 и убоге између људи.   
\b  
\q1
\v 15 Пијавица има две кћери, које говоре: Дај, дај.  
\q2 Има троје несито, и четврто никад не каже: Доста:   
\q1
\v 16 Гроб,  
\q1 материца јалова,  
\q1 земља која не бива сита воде,  
\q1 и огањ, који не говори: Доста.   
\b  
\q1
\v 17 Око које се руга оцу и неће да слуша матере,  
\q2 кљуваће га гаврани с потока и јести орлићи.   
\b  
\q1
\v 18 Троје ми је чудесно, и четвртог не разумем:   
\q1
\v 19 Пут орлов у небо,  
\q1 пут змијин по стени,  
\q1 пут лађин посред мора,  
\q1 и пут човечији к девојци.   
\b  
\q1
\v 20 Такав је пут курвин: једе, и убрише уста,  
\q2 па вели: Нисам учинила зла.   
\b  
\q1
\v 21 Од трога се потреса земља,  
\q2 и четвртог не може поднети:   
\q1
\v 22 Од слуге, кад постане цар,  
\q1 од безумника, кад се наједе хлеба.   
\q1
\v 23 Од пуштенице, кад се уда,  
\q1 од слушкиње кад наследи госпођу своју.   
\b  
\q1
\v 24 Четворо има малено на земљи,  
\q2 али мудрије од мудраца:   
\q1
\v 25 Мрави, који су слаб народ,  
\q2 али опет приправљају у лето себи храну;   
\q1
\v 26 Питоми зечеви, који су нејак народ,  
\q2 али опет у камену граде себи кућу;   
\q1
\v 27 Скакавци, који немају цара,  
\q2 али опет иду сви јатом;   
\q1
\v 28 Паук, који рукама ради  
\q2 и у царским је дворима.   
\b  
\q1
\v 29 Троје лепо корача,  
\q2 и четврто лепо ходи:   
\q1
\v 30 Лав, најјачи између зверова,  
\q2 који не узмиче ни пред ким,   
\q1
\v 31 Коњ опасан по бедрима  
\q1 или јарац,  
\q1 и цар на кога нико не устаје.   
\b  
\q1
\v 32 Ако си лудовао понесавши се или си зло мислио,  
\q2 метни руку на уста.   
\q1
\v 33 Кад се разбија млеко, излази масло;  
\q2 и ко јако нос утире, изгони крв;  
\q2 тако ко дражи на гнев, замеће свађу.   
\c 31  
\s1 Материне поуке једноме цару. Похвала врсној жени.  
\p
\v 1 Речи цара Лемуила; сабране речи, којима га је учила мати његова.   
\b  
\q1
\v 2 Шта, сине мој,  
\q2 шта, сине утробе моје,  
\q2 и шта, сине завета мојих?   
\q1
\v 3 Не дај крепост своју женама,  
\q2 ни путеве своје онима што сатиру цареве.   
\q1
\v 4 Није за цареве, Лемуило, није за цареве да пију вино,  
\q2 ни за кнезове да пију силовито пиће,   
\q1
\v 5 Да не би пијући заборавио уредбе,  
\q2 и изменио правицу коме невољнику.   
\q1
\v 6 Подајте силовито пиће ономе који хоће да пропадне,  
\q2 и вино онима који су тужног срца;   
\q1
\v 7 Нека се напије и заборави своје сиромаштво,  
\q2 и да се више не сећа своје муке.   
\q1
\v 8 Отварај уста своја за немога,  
\q2 за ствар свих намењених смрти.   
\q1
\v 9 Отварај уста своја, суди право,  
\q2 дај правицу невољноме и убогоме.   
\b  
\q1
\v 10 Ко ће наћи врсну жену?  
\q2 Јер вреди више него бисер.   
\q1
\v 11 Ослања се на њу срце мужа њеног,  
\q2 и добитка неће недостајати.   
\q1
\v 12 Чини му добро, а не зло,  
\q2 свега века свог.   
\q1
\v 13 Тражи вуне и лана,  
\q2 и ради по вољи рукама својим.   
\q1
\v 14 Она је као лађа трговачка,  
\q2 из далека доноси храну своју.   
\q1
\v 15 Устаје док је још ноћ,  
\q2 даје храну чељади својој  
\q2 и посао девојкама својим.   
\q1
\v 16 Мисли о њиви, и узме је,  
\q2 од рада руку својих сади виноград.   
\q1
\v 17 Опасује снагом бедра своја  
\q2 и крепи мишице своје.   
\q1
\v 18 Види како јој је добра радња,  
\q2 не гаси јој се ноћу жижак.   
\q1
\v 19 Рукама својим маша се преслице,  
\q2 и прстима својим држи вретено.   
\q1
\v 20 Руку своју отвара сиромаху,  
\q2 и пружа руке убогоме.   
\q1
\v 21 Не боји се снега за своју чељад,  
\q2 јер сва чељад њена има по двоје хаљине.   
\q1
\v 22 Покриваче сама себи гради,  
\q2 танко платно и скерлет одело јој је   
\q1
\v 23 Зна се муж њен на вратима  
\q2 кад седи са старешинама земаљским.   
\q1
\v 24 Кошуље гради и продаје,  
\q2 и појасе даје трговцу.   
\q1
\v 25 Одело јој је крепост и лепота,  
\q2 и осмева се на време које иде.   
\q1
\v 26 Уста своја отвара мудро  
\q2 и на језику јој је наука блага.   
\q1
\v 27 Пази на владање чељади своје,  
\q2 и хлеба у лењости не једе.   
\q1
\v 28 Синови њени подижу се и благосиљају је;  
\q2 муж њен такође хвали је;   
\q1
\v 29 Многе су жене биле врсне,  
\q2 али ти их надвишујеш све.   
\q1
\v 30 Љупкост је преварна и лепота ташта;  
\q2 жена која се боји Господа, она заслужује похвалу.   
\q1
\v 31 Подајте јој од плода руку њених,  
\q2 и нека је хвале на вратима дела њена.   